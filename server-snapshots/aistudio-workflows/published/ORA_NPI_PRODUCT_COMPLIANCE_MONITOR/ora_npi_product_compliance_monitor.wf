          "inputs": [
            {
              "id": "1762446260571_1",
              "name": "itemIds",
              "type": "string",
              "value": "{{$context.$nodes.GETDECLARATIONREQUIREDSUPPLIERS.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"TradingPartnerItemNumber\": { \"type\": \"string\" },\n          \"TradingPartnerItemId\": { \"type\": \"string\" },\n          \"TradingPartnerId\": { \"type\": \"string\" },\n          \"TradingPartnerName\": { \"type\": \"string\" },\n          \"Attachments\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"FileName\":          { \"type\": \"string\" },\n                    \"CategoryName\":      { \"type\": \"string\" },\n                    \"Title\":             { \"type\": \"string\" },\n                    \"Description\":       { \"type\": \"string\" },\n                    \"DocumentPreviewURL\":{ \"type\": \"string\" },\n                    \"@context\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"key\": { \"type\": \"string\" }\n                      },\n                      \"required\": [\"key\"]\n                    }\n                  },\n                  \"required\": [\n                    \"FileName\", \"CategoryName\", \"Title\", \"Description\", \"DocumentPreviewURL\", \"@context\"\n                  ]\n                }\n              },\n              \"count\": { \"type\": \"integer\" },\n              \"hasMore\": { \"type\": \"boolean\" },\n              \"limit\": { \"type\": \"integer\" },\n              \"offset\": { \"type\": \"integer\" },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"rel\": { \"type\": \"string\" },\n                    \"href\": { \"type\": \"string\" },\n                    \"name\": { \"type\": \"string\" },\n                    \"kind\": { \"type\": \"string\" }\n                  },\n                  \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n                }\n              }\n            },\n            \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": { \"type\": \"string\" },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": { \"type\": \"string\" }\n                },\n                \"required\": [\"ETag\"]\n              }\n            },\n            \"required\": [\"key\", \"headers\"]\n          }\n        },\n        \"required\": [\n          \"TradingPartnerItemNumber\", \"TradingPartnerItemId\", \"TradingPartnerId\", \"TradingPartnerName\",\n          \"Attachments\", \"@context\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1760954519105",
            "name": "GetDeclarationRequiredSuppliers",
            "returnType": "string",
            "sourceCode": "const payload= $context.$nodes.GETITEMANDCOMPLIANCEINFO.$output;\n let result = [];\n  if (payload && payload.hits && Array.isArray(payload.hits.hits) ) {\n    for (const hit of payload.hits.hits) {\n      const src = hit && hit._source;\n      if ( Array.isArray(src.ManufacturerItemRelation)) {\n        for (const mirEntry of src.ManufacturerItemRelation) {\n          if (mirEntry && mirEntry.MfgRelationshipStatus==='ORA_PREFERRED' && \"ManufacturerItemId\" in mirEntry) {\n            result.push(mirEntry.ManufacturerItemId);\n          }\n        }\n      }\n    }\n  }\n\n  return result.join(',');"
          },
          "outcomes": {
            "success": "1762446220475"
          },
          "code": "GETDECLARATIONREQUIREDSUPPLIERS",
          "convergenceTargetId": "1771110693236",
          "id": "1762444843443",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
