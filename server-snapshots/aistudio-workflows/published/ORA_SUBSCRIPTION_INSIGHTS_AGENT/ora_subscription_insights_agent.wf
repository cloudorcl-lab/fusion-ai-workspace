t supportRiskLevel = payload.SupportRiskLevel || null;\n\nconst sentimentRiskScore =\n  customerSentimentScoreFinal !== null\n    ? customerSentimentScoreFinal\n    : isFiniteNumber(payload.SentimentRiskScore)\n      ? payload.SentimentRiskScore\n      : null;\n\nconst sentimentRiskLevel = payload.SentimentRiskLevel || null;\n\nlet churnRiskScore = null;\nlet churnWeights = { usage: 0, sentiment: 0 };\n\nif (usageRiskScore !== null && sentimentRiskScore !== null) {\n  churnWeights = DEFAULT_CHURN_WEIGHTS || { usage: 0.5, sentiment: 0.5 };\n  churnRiskScore = (usageRiskScore * churnWeights.usage) + (sentimentRiskScore * churnWeights.sentiment);\n} else if (usageRiskScore !== null) {\n  churnWeights = { usage: 1.0, sentiment: 0.0 };\n  churnRiskScore = usageRiskScore;\n} else if (sentimentRiskScore !== null) {\n  churnWeights = { usage: 0.0, sentiment: 1.0 };\n  churnRiskScore = sentimentRiskScore;\n}\n\nif (churnRiskScore !== null) {\n  churnRiskScore = Number(churnRiskScore.toFixed(3));\n}\n\nconst churnRiskLevelResult = riskLevelFromScore(churnRiskScore);\n\nconst runtimeMetricDetailPuidByUnit = {};\nif (runtimeMetricResult && Array.isArray(runtimeMetricResult.items)) {\n  for (const item of runtimeMetricResult.items) {\n    const unit = item?.MetricUnit;\n    const puid = item?.RuntimeMetricDetailPuid;\n    if (unit && puid) {\n      runtimeMetricDetailPuidByUnit[unit] = puid;\n    }\n  }\n}\n\nconst getOperationAndPath = metricUnit =>\n  runtimeMetricDetailPuidByUnit[metricUnit]\n    ? {\n        operation: \"update\",\n        path: `/subscriptionMetricInsights/${runtimeMetricDetailPuidByUnit[metricUnit]}`\n      }\n    : {\n        operation: \"create\",\n        path: \"/subscriptionMetricInsights\"\n      };\n\nconst parts = [];\n\nconst metricErrorField = () => (metricError ? { MetricError: metricError } : {});\n\nif (marginEmissionAllowed && marginRiskScore !== null) {\n  const { operation, path } = getOperationAndPath(\"Margin Risk Score\");\n  parts.push({\n    id: `${runtimeMetricId}-Margin Risk Score`,\n    operation,\n    path,\n    payload: Object.assign(\n      {\n        RuntimeMetricId: runtimeMetricId,\n        MetricUnit: \"Margin Risk Score\",\n        MetricTypeCode: \"ORA_MARGIN\",\n        MetricScore: marginRiskScore,\n        MetricExplainability: JSON.stringify(marginExplainability)\n      },\n      metricErrorField()\n    )\n  });\n}\n\nif (discountInput !== null && discountRiskScore !== null) {\n  const { operation, path } = getOperationAndPath(\"Discount Risk Score\");\n  parts.push({\n    id: `${runtimeMetricId}-Discount Risk Score`,\n    operation,\n    path,\n    payload: Object.assign(\n      {\n        RuntimeMetricId: runtimeMetricId,\n        MetricUnit: \"Discount Risk Score\",\n        MetricTypeCode: \"ORA_DISCOUNT\",\n        MetricScore: discountRiskScore,\n        MetricExplainability: JSON.stringify(discountExplainability)\n      },\n      metricErrorField()\n    )\n  });\n}\n\nif (financialRiskScore !== null) {\n  const { operation, path } = getOperationAndPath(\"Financial Risk Score\");\n\n  const financialFormulaTemplate =\n    computedFrom === \"both\"\n      ? explainabilityTemplates.formulas.financial.both\n      : computedFrom === \"marginOnly\"\n        ? explainabilityTemplates.formulas.financial.marginOnly\n        : explainabilityTemplates.formulas.financial.discountOnly;\n\n  const financialExplainabilityObj = {\n    formula: formatTemplate(financialFormulaTemplate, {\n      marginWeight: financialWeightsUsed?.margin,\n      discountWeight: financialWeightsUsed?.discount\n    }),\n    marginRiskScore,\n    discountRiskScore,\n    financialRiskScore,\n    financialWeightsUsed,\n    computedFrom\n  };\n\n  parts.push({\n    id: `${runtimeMetricId}-Financial Risk Score`,\n    operation,\n    path,\n    payload: Object.assign(\n      {\n        RuntimeMetricId: runtimeMetricId,\n        MetricUnit: \"Financial Risk Score\",\n        MetricTypeCode: \"ORA_FINANCIAL\",\n        MetricScore: financialRiskScore,\n        MetricExplainability: JSON.stringify(financialExplainabilityObj)\n      },\n      metricErrorField()\n    )\n  });\n\n  const { operation: finLvlOp, path: finLvlPath } = getOperationAndPath(\"Financial Risk Level\");\n  const financialLevelExplainabilityObj = {\n    financialRiskScore,\n    financialRiskLevel: financialRiskLevelResult.level,\n    classificationBandsUsed: bands,\n    selectedBand: financialRiskLevelResult.selectedBand,\n    margin: marginExplainability,\n    discount: discountExplainability\n  };\n\n  parts.push({\n    id: `${runtimeMetricId}-Financial Risk Level`,\n    operation: finLvlOp,\n    path: finLvlPath,\n    payload: Object.assign(\n      {\n        RuntimeMetricId: runtimeMetricId,\n        MetricUnit: \"Financial Risk Level\",\n        MetricTypeCode: \"ORA_FINANCIAL\",\n        MetricClassification: financialRiskLevelResult.level,\n        MetricExplainability: JSON.stringify(financialLevelExplainabilityObj)\n      },\n      metricErrorField()\n    )\n  });\n}\n\nif (hasUsage) {\n  if (hasTrendData && trendRiskResult.trendRiskScore !== null) {\n    const trendRiskExplainability = {\n      usageChangePct: usageChangePercent,\n      usageTrend: usageTrend,\n      usageDataSource,\n      currentPeriodAverageUtilizationPercent,\n      previousPeriodAverageUtilizationPercent,\n      usageTrendFormula,\n      usageTrendSource,\n      usageTrendCalculatedPercent: usageChangePercent,\n      comparisonPeriodLengthEach: comparisonPeriodLengthEachFromRag,\n      usageTrendLabel: usageTrendFromRag,\n      TrendRiskCategory: trendRiskResult.category,\n      TrendRiskLevel: trendRiskLevelResult.level,\n      trendRiskScore: trendRiskResult.trendRiskScore,\n      classification: trendRiskClassification\n    };\n\n    const { operation: trendOp, path: trendPath } = getOperationAndPath(\"Trend Risk Score\");\n    parts.push({\n      id: `${runtimeMetricId}-Trend Risk Score`,\n      operation: trendOp,\n      path: trendPath,\n      payload: Object.assign(\n        {\n          RuntimeMetricId: runtimeMetricId,\n          MetricUnit: \"Trend Risk Score\",\n          MetricTypeCode: \"ORA_USAGE\",\n          MetricScore: trendRiskResult.trendRiskScore,\n          MetricClassification: trendRiskLevelResult.level,\n          MetricExplainability: JSON.stringify(trendRiskExplainability)\n        },\n        metricErrorField()\n      )\n    });\n  }\n\n  if ((averageUtilizationPercentFinal !== null || hasUtilizationRiskScoreInput) && utilizationRiskScore !== null) {\n    const utilizationExplainability = {\n      UtilizationPct: averageUtilizationPercentFinal !== null ? averageUtilizationPercentFinal : null,\n      UtilizationSource: averageUtilizationSource,\n      EntitlementUsage: entitlementUsageFromRag,\n      CurrentPeriodAverageUtilizationPercent: currentPeriodAverageUtilizationPercent,\n      PreviousPeriodAverageUtilizationPercent: previousPeriodAverageUtilizationPercent,\n      ComparisonPeriodLengthEach: comparisonPeriodLengthEachFromRag,\n      UtilizationLevel: utilizationRiskLevelResult.category,\n      UtilizationRiskScore: utilizationRiskScore,\n      classification: utilizationClassification\n    };\n\n    const { operation: utilOp, path: utilPath } = getOperationAndPath(\"Utilization Risk Score\");\n    parts.push({\n      id: `${runtimeMetricId}-Utilization Risk Score`,\n      operation: utilOp,\n      path: utilPath,\n      payload: Object.assign(\n        {\n          RuntimeMetricId: runtimeMetricId,\n          MetricUnit: \"Utilization Risk Score\",\n          MetricTypeCode: \"ORA_USAGE\",\n          MetricScore: utilizationRiskScore,\n          MetricClassification: utilizationRiskLevelResult.category,\n          MetricExplainability: JSON.stringify(utilizationExplainability)\n        },\n        metricErrorField()\n      )\n    });\n  }\n\n  if (usageRiskScore !== null) {\n    const { operation: usageOp, path: usagePath } = getOperationAndPath(\"Usage Risk Score\");\n    parts.push({\n      id: `${runtimeMetricId}-Usage Risk Score`,\n      operation: usageOp,\n      path: usagePath,\n      payload: Object.assign(\n        {\n          RuntimeMetricId: runtimeMetricId,\n          MetricUnit: \"Usage Risk Score\",\n          MetricTypeCode: \"ORA_USAGE\",\n          MetricScore: usageRiskScore,\n          MetricExplainability: JSON.stringify(usageExplainability)\n        },\n        metricErrorField()\n      )\n    });\n\n    const usageRiskLevelExplainability = {\n      UsageRiskScore: usageRiskScore,\n      UsageRiskLevel: usageRiskLevelResult.level,\n      usageDataSource,\n      averageUtilizationPercent: averageUtilizationPercentFinal,\n      averageUtilizationSource,\n      usageTrendCalculatedPercent: usageChangePercent,\n      classification: bands\n    };\n\n    const { operation: usageLevelOp, path: usageLevelPath } = getOperationAndPath(\"Usage Risk Level\");\n    parts.push({\n      id: `${runtimeMetricId}-Usage Risk Level`,\n      operation: usageLevelOp,\n      path: usageLevelPath,\n      payload: Object.assign(\n        {\n          RuntimeMetricId: runtimeMetricId,\n          MetricUnit: \"Usage Risk Level\",\n          MetricTypeCode: \"ORA_USAGE\",\n          MetricClassification: usageRiskLevelResult.level,\n          MetricExplainability: JSON.stringify(usageRiskLevelExplainability)\n        },\n        metricErrorField()\n      )\n    });\n  }\n\n  if (customerSentimentScoreFinal !== null || isFiniteNumber(payload.SentimentRiskScore)) {\n    const sentimentExplainabilityFormula = formatTemplate(explainabilityTemplates.formulas.sentiment, {\n      supportWeight: explainabilityTemplates.sentimentWeights.support,\n      relationshipWeight: explainabilityTemplates.sentimentWeights.relationship\n    });\n\n    const { operation: sentimentOp, path: sentimentPath } = getOperationAndPath(\"Sentiment Risk Score\");\n    parts.push({\n      id: `${runtimeMetricId}-Sentiment Risk Score`,\n      operation: