            "sourceCode": "const out = $context?.$nodes?.INSIGHT_DOCUMENT?.$output;\n\nlet hasRagOutput = false;\n\nif (out != null) {\n  const hasCitations =\n    Array.isArray(out.citations) && out.citations.length > 0;\n\n  const hasVectorResults =\n    out.vectorSearchResults !== false && out.vectorSearchResults != null;\n\n  hasRagOutput = hasCitations || hasVectorResults;\n}\n\nreturn hasRagOutput;"
          },
          "outcomes": {
            "success": "1774336840717"
          },
