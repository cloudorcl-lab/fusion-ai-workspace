        {
          "metadata": {
            "name": "Check Risk Score Presence",
            "returnType": "boolean",
            "sourceCode": "const p = $context.$triggers.REST.$input.payload ?? {};\n\nconst values = [\n  p[\"Margin\"]?.[\"Margin Risk Score\"] ?? null,\n  p[\"Discount\"]?.[\"Discount Risk Score\"] ?? null,\n  p[\"Financial\"]?.[\"Financial Risk Score\"] ?? null,\n  p[\"Financial\"]?.[\"Financial Risk Level\"] ?? null,\n  p[\"Usage\"]?.[\"Trend Risk Score\"] ?? null,\n  p[\"Usage\"]?.[\"Utilization Risk Score\"] ?? null,\n  p[\"Usage\"]?.[\"Usage Risk Score\"] ?? null,\n  p[\"Churn\"]?.[\"Churn Risk Score\"] ?? null,\n  p[\"Churn\"]?.[\"Churn Risk Level\"] ?? null\n];\n\nconst isMeaningfulRiskValue = value => {\n  if (value === null || value === undefined) return false;\n\n  if (typeof value === \"number\") {\n    return Number.isFinite(value);\n  }\n\n  if (typeof value === \"string\") {\n    const normalized = value.trim().toLowerCase();\n    return (\n      normalized !== \"\" &&\n      normalized !== \"unknown\" &&\n      normalized !== \"null\" &&\n      normalized !== \"undefined\" &&\n      normalized !== \"n/a\" &&\n      normalized !== \"na\"\n    );\n  }\n\n  return true;\n};\n\nconst result = values.some(isMeaningfulRiskValue);\nreturn result;"
          },
          "outcomes": {
            "success": "1774255262222"
          },
          "code": "CHECKRISKSCOREPRESENCE",
          "id": "1774023622252",
