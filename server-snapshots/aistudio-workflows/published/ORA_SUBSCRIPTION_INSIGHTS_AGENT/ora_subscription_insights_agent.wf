              "id": "1774341911980",
              "name": "utilizationLevelBands",
              "scope": "JOB",
              "type": "string",
              "value": "[\n  { \"range\": \">= 80%\",      \"category\": \"High Utilization\",     \"riskScore\": 0.1 },\n  { \"range\": \"60% to 79%\",  \"category\": \"Moderate Utilization\", \"riskScore\": 0.4 },\n  { \"range\": \"40% to 59%\",  \"category\": \"Low Utilization\",      \"riskScore\": 0.7 },\n  { \"range\": \"< 40%\",       \"category\": \"Very Low Utilization\", \"riskScore\": 1.0 }\n]"
            },
            {
              "id": "1774341894230",
              "name": "trendLevelBands",
              "scope": "JOB",
              "type": "string",
              "value": "[\n  { \"min\": 10, \"category\": \"Growing\", \"trendRiskScore\": 0.0 },\n  { \"min\": -10, \"category\": \"Stable\", \"trendRiskScore\": 0.1 },\n  { \"min\": -25,\"category\": \"Slight Decline\", \"trendRiskScore\": 0.4 },\n  { \"min\": -50, \"category\": \"Clear Decline\", \"trendRiskScore\": 0.7 },\n  { \"min\": -999999, \"category\": \"Sharp Sustained Decline\",\"trendRiskScore\": 1.0 }\n]"
            },
            {
              "id": "1774341562214",
              "name": "churnWeights",
              "scope": "JOB",
              "type": "string",
              "value": "{ \"usage\": 0.4, \"sentiment\": 0.6 }"
            },
            {
              "id": "1774341512558",
              "name": "usageWeights",
              "scope": "JOB",
              "type": "string",
              "value": "{ \"utilization\": 0.8, \"trend\": 0.2 }"
            },
            {
              "id": "1774341470317",
              "name": "financialWeights",
              "scope": "JOB",
              "type": "string",
              "value": "{ \"margin\": 0.7, \"discount\": 0.3 }"
            },
            {
              "id": "1774341410342",
              "name": "riskLevelBands",
              "scope": "JOB",
              "type": "string",
              "value": "[\n  { \"min\": 0.0,  \"max\": 0.3,  \"label\": \"Low\" },\n  { \"min\": 0.31, \"max\": 0.6,  \"label\": \"Medium\" },\n  { \"min\": 0.61, \"max\": 1.0,  \"label\": \"High\" }\n]"
            },
            {
              "id": "1774341302515",
              "name": "discountPolicyBands",
              "scope": "JOB",
              "type": "string",
              "value": "[\n  { \"minExclusive\": null, \"maxInclusive\": 20, \"label\": \"Within standard policy (e.g., \\\"20%\\\")\", \"riskScore\": 0.1 },\n  { \"minExclusive\": 20,   \"maxInclusive\": 25, \"label\": \"Minor exception (\\\"20% but ≤25%\\\")\",      \"riskScore\": 0.4 },\n  { \"minExclusive\": 25,   \"maxInclusive\": 30, \"label\": \"Large exception (\\\"25% but ≤30%\\\")\", \"riskScore\": 0.7 },\n  { \"minExclusive\": 30,   \"maxInclusive\": null, \"label\": \"Deep Discount (>30%)\", \"riskScore\": 1.0 }\n]"
            },
            {
              "id": "1774341192975",
              "name": "marginPolicyBands",
              "scope": "JOB",
              "type": "string",
              "value": "[\n  { \"deltaMinExclusive\": null, \"deltaMaxInclusive\": 0,  \"label\": \"At or above target\",\"riskScore\": 0.1 },\n  { \"deltaMinExclusive\": 0, \"deltaMaxInclusive\": 5,  \"label\": \"Below target by ≤ 5 percentage points\", \"riskScore\": 0.4 },\n  { \"deltaMinExclusive\": 5, \"deltaMaxInclusive\": 10, \"label\": \"Below target by >5 and ≤10 percentage points\",\"riskScore\": 0.7 },\n  { \"deltaMinExclusive\": 10,\"deltaMaxInclusive\": null,\"label\": \"Below target by >10 points\", \"riskScore\": 1.0 }\n]"
            },
            {
              "id": "1774340998930",
