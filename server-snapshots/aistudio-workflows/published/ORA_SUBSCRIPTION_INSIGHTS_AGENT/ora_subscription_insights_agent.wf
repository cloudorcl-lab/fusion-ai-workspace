          "code": "INSIGHT_DOCUMENT",
          "id": "1774096802804",
          "inputs": [
            {
              "id": "1774096802805_1",
              "name": "question",
              "type": "string",
              "value": "Return ALL extracted text from the spreadsheet (all sheets). Do not summarize. Output verbatim rows and tables exactly as extracted, including all columns and headers."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "name": "Renewal Risk Assessment Engine",
            "returnType": "object",
            "sourceCode": "const payload = $context.$triggers.REST.$input.payload || {};\nconst keyMetricsRaw = $context.$nodes.EXTRACT_KEY_METRICS_FROM_INSIGHT_DOCUMENT?.$output || {};\nconst runtimeMetricResult = $context.$nodes.GET_RUNTIME_METRIC_DETAILS?.$output || null;\n\nconst safeParseJson = value => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch (e) {\n    return null;\n  }\n};\n\nconst normalizeNodeOutput = raw => {\n  let value = safeParseJson(raw) ?? raw;\n\n  if (Array.isArray(value)) value = value[0] ?? {};\n\n  if (value && typeof value === \"object\") {\n    const candidates = [\n      value.output,\n      value.result,\n      value.response,\n      value.text,\n      value.content,\n      value.value\n    ];\n\n    for (const candidate of candidates) {\n      const parsed = safeParseJson(candidate) ?? candidate;\n      if (parsed && typeof parsed === \"object\") {\n        return Array.isArray(parsed) ? parsed[0] ?? {} : parsed;\n      }\n    }\n\n    return value;\n  }\n\n  return {};\n};\n\nconst toFiniteNumber = value => {\n  if (typeof value === \"number\" && Number.isFinite(value)) return value;\n\n  if (typeof value === \"string\") {\n    const n = Number(value.replace(\"%\", \"\").trim());\n    return Number.isFinite(n) ? n : null;\n  }\n\n  return null;\n};\n\nconst toCleanString = value =>\n  value !== null && value !== undefined && String(value).trim() !== \"\"\n    ? String(value).trim()\n    : null;\n\nconst keyMetrics = normalizeNodeOutput(keyMetricsRaw);\n\nconst expectedMarginFromRag = toFiniteNumber(keyMetrics.expectedMargin);\nconst expectedDiscountFromRag = toFiniteNumber(keyMetrics.expectedDiscount);\n\nconst averageUtilizationPercentFromRag = toFiniteNumber(keyMetrics.overallAverageUtilizationPercent);\nconst currentPeriodAverageUtilizationPercentFromRag = toFiniteNumber(keyMetrics.currentPeriodAverageUtilizationPercent);\nconst previousPeriodAverageUtilizationPercentFromRag = toFiniteNumber(keyMetrics.previousPeriodAverageUtilizationPercent);\n\nconst entitlementUsageFromRag = toCleanString(keyMetrics.entitlementUsage);\nconst comparisonPeriodLengthEachFromRag = toCleanString(keyMetrics.comparisonPeriodLengthEach);\nconst usageTrendFromRag = toCleanString(keyMetrics.usageTrend);\n\nconst hasRagUsageData =\n  averageUtilizationPercentFromRag !== null ||\n  currentPeriodAverageUtilizationPercentFromRag !== null ||\n  previousPeriodAverageUtilizationPercentFromRag !== null ||\n  entitlementUsageFromRag !== null ||\n  comparisonPeriodLengthEachFromRag !== null ||\n  usageTrendFromRag !== null;\n\nconst customerSentimentScore = null;\n\nconst isFiniteNumber = value => typeof value === \"number\" && isFinite(value);\n\nconst approxEqual = (a, b, epsilon = 0.0001) =>\n  isFiniteNumber(a) && isFiniteNumber(b) && Math.abs(a - b) <= epsilon;\n\nconst normalizeString = str =>\n  typeof str === \"string\"\n    ? str.trim().toLowerCase().replace(/[\\W_]+/g, \"\")\n    : null;\n\nconst safeParseJsonArray = value => {\n  if (Array.isArray(value)) return value;\n  if (typeof value !== \"string\" || value.trim() === \"\") return null;\n\n  try {\n    const parsed = JSON.parse(value);\n    return Array.isArray(parsed) ? parsed : null;\n  } catch (e) {\n    return null;\n  }\n};\n\nconst safeParseJsonObject = value => {\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n  if (typeof value !== \"string\" || value.trim() === \"\") return null;\n\n  try {\n    const parsed = JSON.parse(value);\n    return parsed && typeof parsed === \"object\" && !Array.isArray(parsed)\n      ? parsed\n      : null;\n  } catch (e) {\n    return null;\n  }\n};\n\nconst formatPct = value =>\n  isFiniteNumber(value) ? `${Number(value).toFixed(2)}%` : null;\n\nconst formatScore = (value, decimals = 2) =>\n  isFiniteNumber(value) ? Number(value).toFixed(decimals) : null;\n\nconst parseUtilRange = rangeStr =>\n  typeof rangeStr !== \"string\"\n    ? null\n    : ((s) =>\n        ((m1, m2, m3, m4) =>\n          m1\n            ? { min: Number(m1[1]), max: Infinity, includeMin: true, includeMax: true }\n            : m2\n              ? { min: -Infinity, max: Number(m2[1]), includeMin: true, includeMax: false }\n              : m3\n                ? { min: Number(m3[1]), max: Number(m3[2]), includeMin: true, includeMax: true }\n                : m4\n                  ? { min: Number(m4[1]), max: Number(m4[2]), includeMin: true, includeMax: true }\n                  : null)(\n          s.match(/^>=([0-9.]+)%$/),\n          s.match(/^<([0-9.]+)%$/),\n          s.match(/^([0-9.]+)%to([0-9.]+)%$/),\n          s.match(/^([0-9.]+)%-([0-9.]+)%$/)\n        ))(rangeStr.trim().toLowerCase().replace(/\\s+/g, \"\"));\n\nconst inRange = (x, r) =>\n  !!r &&\n  (r.includeMin ? x >= r.min : x > r.min) &&\n  (r.includeMax ? x <= r.max : x < r.max);\n\nconst classifyUtilizationFromPct = (utilPct, bandsArr) => {\n  if (!isFiniteNumber(utilPct) || !Array.isArray(bandsArr) || bandsArr.length === 0) {\n    return { riskScore: null, category: \"Unknown\", matchedBand: null };\n  }\n\n  const parsedBands = bandsArr\n    .map(b => ({\n      band: b,\n      range: parseUtilRange(b.range ?? b.utilization_range),\n      score: b.riskScore ?? b.risk_score\n    }))\n    .filter(x => x.range && isFiniteNumber(x.score))\n    .sort((a, b) => a.range.min - b.range.min);\n\n  const normalizedBands = parsedBands.map((item, index) => {\n    const next = parsedBands[index + 1];\n\n    if (\n      next &&\n      isFiniteNumber(item.range.max) &&\n      isFiniteNumber(next.range.min) &&\n      next.range.min > item.range.max &&\n      next.range.min - item.range.max <= 1\n    ) {\n      return {\n        ...item,\n        range: {\n          ...item.range,\n          max: next.range.min,\n          includeMax: false\n        }\n      };\n    }\n\n    return item;\n  });\n\n  const match = normalizedBands.find(x => inRange(utilPct, x.range));\n\n  return match\n    ? {\n        riskScore: Number(match.score),\n        category: typeof match.band.category === \"string\" ? match.band.category : \"Unknown\",\n        matchedBand: match.band\n      }\n    : { riskScore: null, category: \"Unknown\", matchedBand: null };\n};\n\nconst pickMarginBandByDelta = (delta, bandList) =>\n  !isFiniteNumber(delta) || !Array.isArray(bandList)\n    ? null\n    : bandList.find(\n        b =>\n          (b.deltaMinExclusive === null || delta > b.deltaMinExclusive) &&\n          (b.deltaMaxInclusive === null || delta <= b.deltaMaxInclusive)\n      ) || null;\n\nconst formatTemplate = (template, values) =>\n  typeof template === \"string\"\n    ? template.replace(/\\{(\\w+)\\}/g, (_, k) =>\n        values && values[k] !== undefined ? String(values[k]) : `{${k}}`\n      )\n    : null;\n\nconst bandsToRangeMap = bandsArr =>\n  Object.fromEntries(\n    (Array.isArray(bandsArr) ? bandsArr : [])\n      .filter(b => b && isFiniteNumber(b.min) && isFiniteNumber(b.max) && typeof b.label === \"string\")\n      .map(b => [`${Number(b.min).toFixed(2)} – ${Number(b.max).toFixed(2)}`, b.label])\n  );\n\nconst missingOrZero = x => x === null || x === undefined || x === 0;\n\nconst productName = normalizeString(payload[\"Product Name\"]) || null;\nconst customerName = normalizeString(payload[\"Customer Name\"]) || null;\n\nconst DEFAULT_MARGIN_TARGET_PERCENT = Number.isFinite($context?.$variables?.marginTargetPercent)\n  ? $context.$variables.marginTargetPercent\n  : 0;\n\nlet DEFAULT_MARGIN_POLICY_BANDS = [];\n{\n  const arr = safeParseJsonArray($context?.$variables?.marginPolicyBands);\n  DEFAULT_MARGIN_POLICY_BANDS = arr || [];\n}\n\nlet DEFAULT_FINANCIAL_WEIGHTS = null;\n{\n  const obj = safeParseJsonObject($context?.$variables?.financialWeights);\n  DEFAULT_FINANCIAL_WEIGHTS =\n    obj && Number.isFinite(obj.margin) && Number.isFinite(obj.discount)\n      ? { margin: obj.margin, discount: obj.discount }\n      : null;\n}\n\nlet DEFAULT_USAGE_WEIGHTS = null;\n{\n  const obj = safeParseJsonObject($context?.$variables?.usageWeights);\n  DEFAULT_USAGE_WEIGHTS =\n    obj && Number.isFinite(obj.utilization) && Number.isFinite(obj.trend)\n      ? { utilization: obj.utilization, trend: obj.trend }\n      : null;\n}\n\nlet DEFAULT_CHURN_WEIGHTS = null;\n{\n  const obj = safeParseJsonObject($context?.$variables?.churnWeights);\n  DEFAULT_CHURN_WEIGHTS =\n    obj && Number.isFinite(obj.usage) && Number.isFinite(obj.sentiment)\n      ? { usage: obj.usage, sentiment: obj.sentiment }\n      : null;\n}\n\nlet DEFAULT_DISCOUNT_POLICY_TIERS = null;\n{\n  const arr = safeParseJsonArray($context?.$variables?.discountPolicyBands);\n  const ok =\n    Array.isArray(arr) &&\n    arr.every(\n      t =>\n        t &&\n        \"label\" in t &&\n        \"riskScore\" in t &&\n        Number.isFinite(t.riskScore) &&\n        \"minExclusive\" in t &&\n        \"maxInclusive\" in t\n    );\n  DEFAULT_DISCOUNT_POLICY_TIERS = ok ? arr : null;\n}\n\nlet DEFAULT_BANDS = [];\n{\n  const arr = safeParseJsonArray($context?.$variables?.riskLevelBands);\n  DEFAULT_BANDS = Array.isArray(arr) ? arr : [];\n}\n\nlet DEFAULT_TREND_RISK_CLASSIFICATION = null;\n{\n  const arr = safeParseJsonArray($context?.$variables?.trendLevelBands);\n  const ok =\n    Array.isArray(arr) &&\n    arr.every(x => x && Number.isFinite(x.min) && typeof x.category === \"string\" && Number.isFinite(x.trendRiskScore));\n  DEFAULT_TREND_RISK_CLASSIFICATION = ok ? arr : null;\n}\n\nlet DEFAULT_UTILIZATION_CLASSIFICATION = null;\n{\n  const arr = safeParseJsonArray($context?.$variables?.utilizationLevelBands);\n  const ok =\n    Array.isArray(arr) &&\n    arr.every(\n      x =>\n        x &&\n        (typeof x.range === \"string\" || typeof x.utilization_range === \"string\") &&\n        typeof x.category === \"string\" &&\n        Number.isFinite(x.riskScore)\n    );\n  DEFAULT_UTILIZATION_CLASSIFICATION = ok ? arr : null;\n}\n\nconst DEFAULT_EXPLAINABILITY_TEMPLATES = {\n  formulas: {\n    financial: {\n      both: \"Financial Risk = (Margin Risk × {marginWeight}) + (Discount Risk × {discountWeight})\",\n      marginOnly: \"Financial Risk = (Margin Risk × 1)\",\n      discountOnly: \"Financial Risk = (Discount Risk × 1)\"\n    },\n    usage: \"Usage Risk = (Utilization Risk × {utilizationWeight}) + (Trend Risk × {trendWeight})\",\n    churn: \"Churn Risk = (Usage Risk × {usageWeight}) + (Sentiment Risk × {sentimentWeight})\",\n    sentiment: \"(Support Risk × {supportWeight}) + (Relationship Risk × {relationshipWeight})\"\n  },\n  sentimentWeights: { support: 0.8, relationship: 0.2 }\n};\n\nconst formatPolicyPct = value =>\n  Number.isInteger(value) ? String(value) : Number(value).toFixed(2).replace(/\\.?0+$/, \"\");\n\nconst replacePolicyLabelPercents = (label, thresholdMap) =>\n  typeof label === \"string\"\n    ? label.replace(/([0-9]+(?:\\.[0-9]+)?)%/g, (match, rawNumber) => {\n        const original = Number(rawNumber);\n        const mapped = thresholdMap.find(x => approxEqual(x.original, original));\n        return mapped ? `${formatPolicyPct(mapped.shifted)}%` : match;\n      })\n    : label;\n\nconst buildDiscountPolicyTiers = (defaultTiers, expectedDiscount) => {\n  if (!Array.isArray(defaultTiers) || defaultTiers.length === 0) return [];\n  if (!isFiniteNumber(expectedDiscount)) return defaultTiers;\n\n  const firstFiniteMaxTier = defaultTiers.find(t => isFiniteNumber(t?.maxInclusive));\n  const baseExpectedDiscount = firstFiniteMaxTier?.maxInclusive;\n\n  if (!isFiniteNumber(baseExpectedDiscount)) return defaultTiers;\n\n  const shiftThreshold = value =>\n    isFiniteNumber(value) ? Number((expectedDiscount + (value - baseExpectedDiscount)).toFixed(6)) : value;\n\n  const thresholdMap = [];\n\n  for (const tier of defaultTiers) {\n    if (isFiniteNumber(tier?.minExclusive)) {\n      thresholdMap.push({\n        original: tier.minExclusive,\n        shifted: shiftThreshold(tier.minExclusive)\n      });\n    }\n\n    if (isFiniteNumber(tier?.maxInclusive)) {\n      thresholdMap.push({\n        original: tier.maxInclusive,\n        shifted: shiftThreshold(tier.maxInclusive)\n      });\n    }\n  }\n\n  return defaultTiers.map(tier => {\n    const minExclusive = shiftThreshold(tier.minExclusive);\n    const maxInclusive = shiftThreshold(tier.maxInclusive);\n\n    return {\n      ...tier,\n      minExclusive,\n      maxInclusive,\n      label: replacePolicyLabelPercents(tier.label, thresholdMap),\n      baseExpectedDiscount,\n      effectiveExpectedDiscount: expectedDiscount,\n      source: \"RAG Expected Discount\"\n    };\n  });\n};\n\nconst normalizeRiskBands = bandList => {\n  if (!Array.isArray(bandList)) return [];\n\n  const parsedBands = bandList\n    .map(b => {\n      const min = toFiniteNumber(b?.min);\n      const max = toFiniteNumber(b?.max);\n      const label = toCleanString(b?.label);\n\n      return min !== null && max !== null && label\n        ? { ...b, min, max, label }\n        : null;\n    })\n    .filter(Boolean)\n    .sort((a, b) => a.min - b.min);\n\n  return parsedBands.map((band, index, arr) => {\n    const next = arr[index + 1];\n\n    if (\n      next &&\n      next.min > band.max &&\n      next.min - band.max <= 0.010001\n    ) {\n      return {\n        ...band,\n        max: next.min,\n        includeMax: false\n      };\n    }\n\n    return {\n      ...band,\n      includeMax: true\n    };\n  });\n};\n\nconst marginTargetPercent = expectedMarginFromRag !== null ? expectedMarginFromRag : DEFAULT_MARGIN_TARGET_PERCENT;\nconst marginPolicyBands = DEFAULT_MARGIN_POLICY_BANDS;\nconst discountPolicyTiers = buildDiscountPolicyTiers(DEFAULT_DISCOUNT_POLICY_TIERS || [], expectedDiscountFromRag);\nconst bands = normalizeRiskBands(DEFAULT_BANDS);\nconst trendRiskClassification = DEFAULT_TREND_RISK_CLASSIFICATION || [];\nconst utilizationClassification = DEFAULT_UTILIZATION_CLASSIFICATION || [];\nconst explainabilityTemplates = DEFAULT_EXPLAINABILITY_TEMPLATES;\n\nconst riskLevelFromScore = score => {\n  const numericScore = toFiniteNumber(score);\n\n  if (numericScore === null || !Array.isArray(bands) || bands.length === 0) {\n    return { level: \"Unknown\", selectedBand: null };\n  }\n\n  const selectedBand = bands.find(band =>\n    numericScore >= band.min &&\n    (band.includeMax === false ? numericScore < band.max : numericScore <= band.max)\n  );\n\n  return {\n    level: selectedBand ? selectedBand.label : \"Unknown\",\n    selectedBand: selectedBand || null\n  };\n};\n\nlet runtimeMetricId = 0;\nlet runtimeMetricIdValid = false;\nif (isFiniteNumber(payload[\"Runtime Metric Id\"])) {\n  runtimeMetricId = payload[\"Runtime Metric Id\"];\n  runtimeMetricIdValid = true;\n}\n\nlet requestId = 0;\nif (isFiniteNumber(payload[\"Request Id\"])) {\n  requestId = payload[\"Request Id\"];\n}\n\nconst metricErrorMsgs = [];\nif (!runtimeMetricIdValid) {\n  metricErrorMsgs.push(`invalid Runtime Metric Id: ${payload[\"Runtime Metric Id\"]}`);\n}\nconst metricError = metricErrorMsgs.length > 0 ? metricErrorMsgs.join(\"; \") : null;\n\nconst marginInput = payload.Margin || {};\nconst tcv = isFiniteNumber(marginInput[\"TCV Net Price\"]) ? marginInput[\"TCV Net Price\"] : null;\nconst debrief = isFiniteNumber(marginInput[\"Debrief Charges\"]) ? marginInput[\"Debrief Charges\"] : 0;\n\nconst serviceCost = isFiniteNumber(marginInput[\"Service Cost\"]) ? marginInput[\"Service Cost\"] : null;\n\nconst marginProvided = isFiniteNumber(marginInput[\"Margin \"]) && marginInput[\"Margin \"] !== 0 ? marginInput[\"Margin \"] : null;\nconst marginPercentProvided =\n  isFiniteNumber(marginInput[\"Margin Percent\"]) && marginInput[\"Margin Percent\"] !== 0 ? marginInput[\"Margin Percent\"] : null;\n\nlet derivationMethod = \"unknown\";\nlet marginUsedForPercent = null;\nlet marginPercent = null;\nlet marginEmissionAllowed = false;\n\nif (marginPercentProvided !== null) {\n  marginPercent = marginPercentProvided;\n  derivationMethod = \"provided\";\n  marginUsedForPercent = marginProvided !== null ? marginProvided : null;\n} else if (tcv !== null && tcv > 0 && serviceCost !== null) {\n  const marginDerived = tcv + debrief - serviceCost;\n  marginUsedForPercent = marginDerived;\n  marginPercent = (marginDerived / tcv) * 100;\n  derivationMethod = \"computedFromTCVDebriefServiceCost\";\n} else if (tcv !== null && tcv > 0 && marginProvided !== null) {\n  marginUsedForPercent = marginProvided;\n  marginPercent = (marginProvided / tcv) * 100;\n  derivationMethod = \"computedFromMarginAndTCV\";\n} else {\n  marginPercent = null;\n  marginUsedForPercent = null;\n  derivationMethod = \"unknown\";\n}\n\nif (derivationMethod === \"unknown\") {\n  marginPercent = null;\n  marginUsedForPercent = null;\n  marginEmissionAllowed = false;\n} else {\n  marginEmissionAllowed = isFiniteNumber(marginPercent);\n}\n\nconst placeholderCostBasis = missingOrZero(serviceCost) && missingOrZero(debrief);\nconst marginEqualsTCV = isFiniteNumber(marginProvided) && isFiniteNumber(tcv) && approxEqual(marginProvided, tcv);\n\nif (placeholderCostBasis && ((marginPercent !== null && approxEqual(marginPercent, 100)) || marginEqualsTCV)) {\n  marginEmissionAllowed = false;\n  marginPercent = null;\n  marginUsedForPercent = null;\n  derivationMethod = \"unknown\";\n}\n\nlet marginRiskScore = null;\nlet marginStatus = null;\n\nif (marginEmissionAllowed && isFiniteNumber(marginPercent)) {\n  const delta = marginTargetPercent - marginPercent;\n  const selectedBand = pickMarginBandByDelta(delta, marginPolicyBands);\n  if (selectedBand) {\n    marginRiskScore = selectedBand.riskScore;\n    marginStatus = selectedBand.label;\n  }\n}\n\nconst marginExplainability =\n  marginEmissionAllowed && isFiniteNumber(marginPercent)\n    ? {\n        marginExpected: marginTargetPercent,\n        marginExpectedSource: expectedMarginFromRag !== null ? \"RAG Expected Margin\" : \"workflow variable marginTargetPercent\",\n        marginActual: marginPercent,\n        marginDelta: marginTargetPercent - marginPercent,\n        marginStatus,\n        marginRiskScore,\n        marginPolicyBandsUsed: marginPolicyBands\n      }\n    : {\n        marginExpected: marginTargetPercent,\n        marginExpectedSource: expectedMarginFromRag !== null ? \"RAG Expected Margin\" : \"workflow variable marginTargetPercent\",\n        marginActual: marginPercent,\n        marginDelta: isFiniteNumber(marginPercent) ? marginTargetPercent - marginPercent : null,\n        marginStatus,\n        marginRiskScore,\n        marginPolicyBandsUsed: marginPolicyBands\n      };\n\nconst discountInput = payload.Discount || null;\nlet discountPercent = null;\nlet discountDerivationMethod = \"unknown\";\n\nif (discountInput !== null) {\n  const discountPercentProvided =\n    isFiniteNumber(discountInput[\"Discount Percent\"]) && discountInput[\"Discount Percent\"] !== 0\n      ? discountInput[\"Discount Percent\"]\n      : null;\n\n  const tcvListPrice = isFiniteNumber(discountInput[\"TCV List Price\"]) ? discountInput[\"TCV List Price\"] : null;\n  const tcvNetPrice = isFiniteNumber(discountInput[\"TCV Net Price\"]) ? discountInput[\"TCV Net Price\"] : null;\n\n  if (discountPercentProvided !== null) {\n    discountPercent = discountPercentProvided;\n    discountDerivationMethod = \"provided\";\n  } else if (tcvListPrice !== null && tcvListPrice > 0 && tcvNetPrice !== null) {\n    discountPercent = ((tcvListPrice - tcvNetPrice) / tcvListPrice) * 100;\n    discountDerivationMethod = \"computedFromListAndNet\";\n  } else {\n    discountPercent = null;\n    discountDerivationMethod = \"unknown\";\n  }\n}\n\nlet discountRiskScore = null;\nlet discountLevel = null;\n\nif (discountInput !== null && discountPercent !== null) {\n  for (const tier of discountPolicyTiers) {\n    const minCheck = tier.minExclusive === null ? true : discountPercent > tier.minExclusive;\n    const maxCheck = tier.maxInclusive === null ? true : discountPercent <= tier.maxInclusive;\n    if (minCheck && maxCheck) {\n      discountRiskScore = tier.riskScore;\n      discountLevel = tier.label;\n      break;\n    }\n  }\n}\n\nconst discountExplainability = {\n  expectedDiscount: expectedDiscountFromRag,\n  expectedDiscountSource: expectedDiscountFromRag !== null ? \"RAG Expected Discount\" : \"workflow variable discountPolicyBands baseline\",\n  discountPercent,\n  discountDerivationMethod,\n  discountRiskScore,\n  discountLevel,\n  discountPolicyTiers,\n  baseDiscountPolicyTiers: DEFAULT_DISCOUNT_POLICY_TIERS || []\n};\n\nlet financialRiskScore = null;\nlet financialWeightsUsed = null;\nlet computedFrom = null;\n\nconst marginScoreExists = marginRiskScore !== null && isFiniteNumber(marginRiskScore) && marginRiskScore !== 0;\nconst discountScoreExists = discountRiskScore !== null && isFiniteNumber(discountRiskScore) && discountRiskScore !== 0;\n\nif (marginScoreExists && discountScoreExists) {\n  financialWeightsUsed = DEFAULT_FINANCIAL_WEIGHTS || { margin: 0.5, discount: 0.5 };\n  financialRiskScore = (marginRiskScore * financialWeightsUsed.margin) + (discountRiskScore * financialWeightsUsed.discount);\n  financialRiskScore = Number(financialRiskScore.toFixed(2));\n  computedFrom = \"both\";\n} else if (marginScoreExists) {\n  financialWeightsUsed = { margin: 1.0, discount: 0.0 };\n  financialRiskScore = Number(marginRiskScore.toFixed(2));\n  computedFrom = \"marginOnly\";\n} else if (discountScoreExists) {\n  financialWeightsUsed = { margin: 0.0, discount: 1.0 };\n  financialRiskScore = Number(discountRiskScore.toFixed(2));\n  computedFrom = \"discountOnly\";\n}\n\nconst financialRiskLevelResult = riskLevelFromScore(financialRiskScore);\n\nconst hasUsage = (payload.Usage !== undefined && payload.Usage !== null) || hasRagUsageData;\n\nconst averageUtilizationPercentFinal =\n  averageUtilizationPercentFromRag !== null\n    ? averageUtilizationPercentFromRag\n    : isFiniteNumber(payload[\"Average Utilization %\"])\n      ? payload[\"Average Utilization %\"]\n      : null;\n\nconst customerSentimentScoreFinal = isFiniteNumber(payload[\"Customer Sentiment Score\"]) ? payload[\"Customer Sentiment Score\"] : null;\n\nconst usageInput = payload.Usage && typeof payload.Usage === \"object\" ? payload.Usage : {};\nconst usageTrend = Array.isArray(usageInput[\"Usage Trend\"]) ? usageInput[\"Usage Trend\"] : [];\n\nconst currentPeriodAverageUtilizationPercent =\n  currentPeriodAverageUtilizationPercentFromRag !== null\n    ? currentPeriodAverageUtilizationPercentFromRag\n    : toFiniteNumber(usageInput[\"Current Period Average Utilization %\"]);\n\nconst previousPeriodAverageUtilizationPercent =\n  previousPeriodAverageUtilizationPercentFromRag !== null\n    ? previousPeriodAverageUtilizationPercentFromRag\n    : toFiniteNumber(usageInput[\"Previous Period Average Utilization %\"]);\n\nconst usageChangePercentFromCurrentPrevious =\n  currentPeriodAverageUtilizationPercent !== null &&\n  previousPeriodAverageUtilizationPercent !== null &&\n  previousPeriodAverageUtilizationPercent !== 0\n    ? Number((((currentPeriodAverageUtilizationPercent / previousPeriodAverageUtilizationPercent) - 1) * 100).toFixed(2))\n    : null;\n\nconst usageChangePercent =\n  usageChangePercentFromCurrentPrevious !== null\n    ? usageChangePercentFromCurrentPrevious\n    : isFiniteNumber(usageInput[\"Usage Change Percent\"])\n      ? usageInput[\"Usage Change Percent\"]\n      : null;\n\nconst usageDataSource = hasRagUsageData ? \"RAG\" : \"payload\";\nconst averageUtilizationSource = averageUtilizationPercentFromRag !== null ? \"RAG Overall Average Utilization %\" : \"payload Average Utilization %\";\nconst usageTrendSource = usageChangePercentFromCurrentPrevious !== null ? \"RAG current/previous period utilization\" : \"payload Usage Change Percent\";\nconst usageTrendFormula = \"((Current Period Average Utilization % / Previous Period Average Utilization %) - 1) * 100\";\n\nconst hasTrendData = isFiniteNumber(usageChangePercent);\n\nconst classifyTrendRisk = changePct =>\n  changePct === null || !Array.isArray(trendRiskClassification) || trendRiskClassification.length === 0\n    ? { trendRiskScore: null, category: \"Unknown\" }\n    : ((cls) => ({\n        trendRiskScore: cls ? cls.trendRiskScore : null,\n        category: cls ? cls.category : \"Unknown\"\n      }))(trendRiskClassification.find(cls => changePct >= cls.min));\n\nconst trendRiskResult = classifyTrendRisk(usageChangePercent);\nconst trendRiskLevelResult = riskLevelFromScore(trendRiskResult.trendRiskScore);\n\nconst utilizationFromBands = classifyUtilizationFromPct(averageUtilizationPercentFinal, utilizationClassification);\nconst utilizationRiskScoreFromUsageInput = toFiniteNumber(usageInput[\"Utilization Risk Score\"]);\nconst utilizationRiskScoreFromRoot = toFiniteNumber(payload.UtilizationRiskScore);\nconst hasUtilizationRiskScoreInput =\n  utilizationRiskScoreFromUsageInput !== null || utilizationRiskScoreFromRoot !== null;\n\nconst utilizationRiskScore =\n  utilizationFromBands.riskScore !== null\n    ? utilizationFromBands.riskScore\n    : utilizationRiskScoreFromUsageInput !== null\n      ? utilizationRiskScoreFromUsageInput\n      : utilizationRiskScoreFromRoot !== null\n        ? utilizationRiskScoreFromRoot\n        : null;\n\nconst utilizationRiskLevelResult = {\n  category: utilizationFromBands.riskScore !== null\n    ? utilizationFromBands.category\n    : riskLevelFromScore(utilizationRiskScore).level\n};\n\nconst LOW_UTILIZATION_THRESHOLD_PCT = 40;\nconst lowUtilizationOverrideApplied =\n  isFiniteNumber(averageUtilizationPercentFinal) && averageUtilizationPercentFinal < LOW_UTILIZATION_THRESHOLD_PCT;\n\nlet usageRiskScore = null;\nlet usageRiskScoreWeights = { utilization: 0, trend: 0 };\n\nif (lowUtilizationOverrideApplied) {\n  usageRiskScore = 1;\n  usageRiskScoreWeights = { utilization: 1.0, trend: 0.0 };\n} else if (ut