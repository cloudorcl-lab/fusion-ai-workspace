            "type": "object",
            "typeSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"type\": \"object\",\n  \"additionalProperties\": true,\n  \"properties\": {\n    \"Subscription Product Puid\": { \"type\": [\"string\", \"null\"] },\n    \"Product Name\": { \"type\": [\"string\", \"null\"] },\n    \"Customer Name\": { \"type\": [\"string\", \"null\"] },\n    \"Runtime Metric Id\": { \"type\": [\"integer\", \"null\"] },\n    \"Request Id\": { \"type\": [\"integer\", \"null\"] },\n\n    \"Margin\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": true,\n      \"properties\": {\n        \"TCV Net Price\": { \"type\": [\"number\", \"null\"] },\n        \"Debrief Charges\": { \"type\": [\"number\", \"null\"] },\n        \"Service Cost\": { \"type\": [\"number\", \"null\"] },\n        \"Margin \": { \"type\": [\"number\", \"null\"] },\n        \"Margin Percent\": { \"type\": [\"number\", \"null\"] },\n        \"Margin Risk Score\": { \"type\": [\"number\", \"null\"] }\n      }\n    },\n\n    \"Discount\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": true,\n      \"properties\": {\n        \"TCV List Price\": { \"type\": [\"number\", \"null\"] },\n        \"TCV Net Price\": { \"type\": [\"number\", \"null\"] },\n        \"Discount\": { \"type\": [\"number\", \"null\"] },\n        \"Discount Percent\": { \"type\": [\"number\", \"null\"] },\n        \"Discount Risk Score\": { \"type\": [\"number\", \"null\"] }\n      }\n    },\n\n    \"Financial\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": true,\n      \"properties\": {\n        \"Financial Risk Score\": { \"type\": [\"number\", \"null\"] },\n        \"Financial Risk Level\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n\n    \"Usage\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": true,\n      \"properties\": {\n        \"Usage Trend\": {\n          \"type\": [\"array\", \"null\"],\n          \"items\": { \"type\": [\"number\", \"null\"] }\n        },\n        \"Usage Change Percent\": { \"type\": [\"number\", \"null\"] },\n        \"Trend Risk Score\": { \"type\": [\"number\", \"null\"] },\n        \"Utilization Risk Score\": { \"type\": [\"number\", \"null\"] },\n        \"Usage Risk Score\": { \"type\": [\"number\", \"null\"] },\n        \"Usage Risk Level\": { \"type\": [\"string\", \"null\"] }\n      }\n    },\n\n    \"Churn\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": true,\n      \"properties\": {\n        \"Churn Risk Score\": { \"type\": [\"number\", \"null\"] },\n        \"Churn Risk Level\": { \"type\": [\"string\", \"null\"] }\n      }\n    }\n  }\n}\n"
          }
