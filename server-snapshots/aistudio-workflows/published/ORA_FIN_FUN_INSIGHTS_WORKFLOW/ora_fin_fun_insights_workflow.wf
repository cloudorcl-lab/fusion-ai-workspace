        {
          "metadata": {
            "name": "Consolidate Batched Summaries",
            "returnType": "object",
            "sourceCode": "const batchedSummaries = $context.$nodes.PROCESS_SUMMARY_BATCHES_GENERIC.$output;\nconst contextAttribute = $context.$triggers.REST.$input.insightContext;\n\nlet resultArray = [];\n\nfor (const item of batchedSummaries) {\n  try {\n    const itemJson = JSON.parse(item);\n\n    if (\n      itemJson.hasOwnProperty(\"datawithsummary\") &&\n      Array.isArray(itemJson.datawithsummary)\n    ) {\n      for (const elem of itemJson.datawithsummary) {\n        if (\n          elem &&\n          typeof elem === \"object\" &&\n          elem.hasOwnProperty(contextAttribute) &&\n          elem.hasOwnProperty(\"summary\")\n        ) {\n          resultArray.push(elem);\n        }\n      }\n    }\n  } catch (err) {\n    continue;\n  }\n}\n\nlet result = {};\nresult.datawithsummary = resultArray;\n\nreturn result;"
          },
