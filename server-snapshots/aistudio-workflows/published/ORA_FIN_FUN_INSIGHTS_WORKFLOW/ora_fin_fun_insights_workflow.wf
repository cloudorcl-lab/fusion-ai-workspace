              "name": "returnValue",
              "type": "string",
              "value": "{\n  \"accountingPeriod\": {\"expression\":{\"method\":\"dateToFiscalMonthName\",\"parameters\":[{\"method\":\"today\",\"parameters\":[]}]},\"format\":\"JSON\"},\n  \"reasons\": \"ERROR\",\n  \"resolved\": \"ERROR\",\n  \"error\": true\n}"
