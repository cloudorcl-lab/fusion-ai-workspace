        {
          "metadata": {
            "name": "Construct Individual Summaries Result",
            "returnType": "object",
            "sourceCode": "const consolidatedSummary = $context.$variables.consolidatedSummary;\nconst individualSummaryResult = $context.$variables.individualSummaryResult;\nconst skipConsolidatedSummary = $context.$triggers.REST.$input.skipConsolidatedSummary;\n\nconst contextAttribute = $context.$triggers.REST.$input.insightContext;\n\nconst inputArray = individualSummaryResult.datawithsummary || [];\nconst seen = new Map();\nconst resultArray = [];\n\nlet consolidatedSummaryItem = null;\n\nfor (const item of inputArray) {\n  if (\n    item &&\n    typeof item === \"object\" &&\n    Object.keys(item).length === 1 &&\n    Object.prototype.hasOwnProperty.call(item, \"consolidatedSummary\")\n  ) {\n    consolidatedSummaryItem = item; // retain existing one, but do not dedupe it\n    continue;\n  }\n\n  if (!item || typeof item !== \"object\") {\n    resultArray.push(item);\n    continue;\n  }\n\n  // If the dedupe key is missing, keep the item rather than dropping it\n  if (!Object.prototype.hasOwnProperty.call(item, contextAttribute)) {\n    resultArray.push(item);\n    continue;\n  }\n\n  const key = item[contextAttribute];\n\n  if (!seen.has(key)) {\n    seen.set(key, true);\n    resultArray.push(item);\n  }\n}\n\nif (!skipConsolidatedSummary && consolidatedSummaryItem) {\n  resultArray.push(consolidatedSummaryItem);\n} else if (!skipConsolidatedSummary) {\n  resultArray.push({\n    consolidatedSummary: consolidatedSummary.consolidatedSummary\n  });\n}\n\nindividualSummaryResult.datawithsummary = resultArray;\n\nreturn individualSummaryResult;"
          },
          "outcomes": {
            "success": "1775703808339"
          },
          "code": "CONSTRUCT_INDIVIDUAL_SUMMARIES_RESULT",
          "id": "1775703634471",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Return Individual Summaries"
          },
          "outcomes": {},
          "code": "RETURN_INDIVIDUAL_SUMMARIES",
          "convergenceTargetId": "end",
          "id": "1775703808339",
          "inputs": [
            {
              "id": "1775703808339_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.CONSTRUCT_INDIVIDUAL_SUMMARIES_RESULT.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Produce Batches for Summarization",
            "returnType": "array",
            "sourceCode": "const data = $context.$triggers.REST.$input.data;\nconst contextAttribute = $context.$triggers.REST.$input.insightContext;\nconst softRecordMaximum = 25;\nconst totalRecordMaximum = 1000;\n\n// Only consider the first totalRecordMaximum records.\nconst limitedData = data.slice(0, totalRecordMaximum);\n\n// Group by key.\nconst groupsByKey = new Map();\nfor (const item of limitedData) {\n  const key = item?.[contextAttribute];\n  const group = groupsByKey.get(key);\n  if (group) {\n    group.push(item);\n  } else {\n    groupsByKey.set(key, [item]);\n  }\n}\n\n// Build fixed buckets and movable groups.\n// Fixed buckets are truncated to the first softRecordMaximum records.\nconst fixedBuckets = [];\nconst groups = [];\n\nfor (const items of groupsByKey.values()) {\n  const truncatedItems = items.slice(0, softRecordMaximum);\n\n  if (truncatedItems.length >= softRecordMaximum) {\n    fixedBuckets.push(truncatedItems);\n  } else if (truncatedItems.length > 0) {\n    groups.push({\n      size: truncatedItems.length,\n      items: truncatedItems\n    });\n  }\n}\n\n// Largest groups first.\ngroups.sort((a, b) => b.size - a.size);\n\n// Best-fit decreasing using remaining-capacity buckets.\n// binsByRemaining[r] holds bins with exactly r slots remaining.\nconst binsByRemaining = Array.from(\n  { length: softRecordMaximum + 1 },\n  () => []\n);\n\nconst openBuckets = [];\n\nfor (const group of groups) {\n  let targetBin = null;\n\n  // Best fit: find the smallest remaining capacity that can still fit the group.\n  for (let remaining = group.size; remaining <= softRecordMaximum; remaining++) {\n    const pool = binsByRemaining[remaining];\n    if (pool.length > 0) {\n      targetBin = pool.pop();\n      break;\n    }\n  }\n\n  if (!targetBin) {\n    targetBin = {\n      remaining: softRecordMaximum,\n      items: []\n    };\n    openBuckets.push(targetBin);\n  }\n\n  targetBin.items.push(...group.items);\n  targetBin.remaining -= group.size;\n  binsByRemaining[targetBin.remaining].push(targetBin);\n}\n\nreturn fixedBuckets.concat(openBuckets.map((bucket) => bucket.items));"
          },
          "outcomes": {
            "success": "1778236930083"
          },
          "code": "PRODUCE_BATCHES_FOR_SUMMARIZATION",
          "id": "1775707936539",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
