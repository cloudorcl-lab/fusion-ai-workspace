            "sourceCode": "const currPeriodDetails = $context.$nodes.GET_CURRENT_PERIOD.$output;\n\nlet item = $context.$nodes.GET_CURRENT_PERIOD.$output.items[0];\n\nconst getDayFromDateString = (dateString) => {\n  const day = dateString.split(\"-\")[2];\n  return day.startsWith(\"0\") ? day.slice(1) : day;\n};\n\nlet arr = [getDayFromDateString(item.startDate), item.periodName];\n\nreturn arr;"
