          "metadata": {
            "errorNodeId": "1770078128018",
            "name": "Sanitize Agent Response",
            "returnType": "string",
            "sourceCode": "let agentResponse = $context.$nodes.FIN_FUN_ACCOUNTING_PERIOD_DERIVATION.$output;\nlet newlinesRemovedStr = \"\";\n\n\nif( typeof agentResponse === 'string'){\n    newlinesRemovedStr = $context.$nodes.FIN_FUN_ACCOUNTING_PERIOD_DERIVATION.$output.replace(/[\\r\\n]+/gm, \"\");\n    const agentResJson = JSON.parse(newlinesRemovedStr);\n    let reasons = agentResJson.reasons.replace(/\"/g, \"'\");\n    agentResJson.reasons = reasons;\n    newlinesRemovedStr = JSON.stringify(agentResJson);\n}\nelse if (typeof agentResponse === 'object'){\n    let reasons = agentResponse.reasons.replace(/\"/g, \"'\");\n    agentResponse.reasons = reasons;\n    newlinesRemovedStr = JSON.stringify(agentResponse);\n}\n\nreturn newlinesRemovedStr;"
          },
