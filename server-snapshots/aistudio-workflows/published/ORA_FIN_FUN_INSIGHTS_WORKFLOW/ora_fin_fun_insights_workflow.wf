          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"reasons\": {\n            \"type\": \"string\"\n        },\n        \"accountingPeriod\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
          "type": "LLM"
