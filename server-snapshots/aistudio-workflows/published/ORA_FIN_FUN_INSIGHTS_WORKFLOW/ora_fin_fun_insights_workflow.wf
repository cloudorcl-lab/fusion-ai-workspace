        {
          "metadata": {
            "errorNodeId": "1775707936539",
            "name": "Detect AV Data Retrieval Error",
            "returnType": "boolean",
            "sourceCode": "let obj = $context.$nodes.FIN_FUN_DATA_RETRIEVAL_FUNCTION.$output;\nif (obj == null || typeof obj !== 'object') {\n  return true;\n}\nif (\n  Object.prototype.hasOwnProperty.call(obj, 'errorCode') ||\n  Object.prototype.hasOwnProperty.call(obj, 'errorMessage') ||\n  Object.prototype.hasOwnProperty.call(obj, 'childLevelBalancesData_error') ||\n  Object.prototype.hasOwnProperty.call(obj, 'balancesData_error')\n) {\n  return true;\n}\n\nconst av = obj.avExtractResult;\nif (av && Array.isArray(av.ledgerLevelAvData)) {\n  for (const item of av.ledgerLevelAvData) {\n    const current = item && item.currentLevelAvData;\n    if (current && current.error) {\n      return true;\n    }\n  }\n}\n\nreturn false;"
          },
          "outcomes": {
            "success": "1769045555368"
          },
          "code": "DETECT_AV_DATA_RETRIEVAL_ERROR",
          "id": "1769044116392",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
