            "false": "1775733301615"
          },
          "code": "CHECK_REQUIRED_TEMPORARY_CARDS",
          "convergenceTargetId": "1773646389473",
          "id": "1775727165914",
          "inputs": [
            {
              "id": "1775727165915_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.NUMBER_OF_REQUIRED_TEMPORARY_CARDS.$output.result == 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Build Batch Payload",
            "returnType": "object",
            "sourceCode": "const requiredTemporaryCards = $context.$nodes.NUMBER_OF_REQUIRED_TEMPORARY_CARDS.$output.result;\nconst pullSequenceId = $context.$nodes.GET_PULL_SEQUENCE_ID.$output.result.PullSequenceId;\nconst supplierDetails = $context.$nodes.GET_PULL_SEQUENCE_SUPPLIER.$output.items || [];\n\nconst pullSequenceSummaries = $context.$nodes.GET_ALL_PULL_SEQUENCE_SUMMARIES_BY_ID.$output.items[0] || [];\n\n\n// Determine SupplierId from supplierDetails\nlet supplierId = null;\nlet supplierSiteId = null;\nif (supplierDetails && supplierDetails.length > 0) {\n  supplierId = supplierDetails[0].SupplierId;\n  supplierSiteId = supplierDetails[0].SupplierSiteId;\n}\n\nconst parts = [];\nfor (let i = 0; i < requiredTemporaryCards; i++) {\n  const payload = {\n    MaximumReplenishments: 1,\n    PullSequenceId: pullSequenceId\n  };\n\n  if (pullSequenceSummaries && String(pullSequenceSummaries.SourceType) === \"2\" && supplierId != null && supplierSiteId != null) {\n    payload.SupplierId = supplierId;\n    payload.SupplierSiteId = supplierSiteId;\n  }\n\n  parts.push({\n    id: String(i + 1),\n    path: \"/kanbanCards?onlyData=true\",\n    operation: \"create\",\n    payload\n  });\n}\n\nconst payload = { parts };\nreturn payload;"
          },
          "outcomes": {
            "success": "1775727237743"
          },
          "code": "BUILD_BATCH_PAYLOAD",
          "id": "1775727204440",
          "inputs": [],
