        {
          "metadata": {
            "name": "Number of required temporary cards",
            "returnType": "number",
            "sourceCode": "const record = $context.$nodes.GET_ALL_PULL_SEQUENCE_SUMMARIES_BY_ID.$output.items[0] ;\nconst pullSequenceId = $context.$nodes.GET_PULL_SEQUENCE_ID.$output.PullSequenceId;\n\n\n// Default values if not found or missing\nconst numberOfCards = record && record.NumberOfCards != null ? parseFloat(record.NumberOfCards) : 0;\nconst fullCards = record && record.FullCards != null ? parseFloat(record.FullCards) : 0;\nconst temporaryCards = record && record.TemporaryCards != null ? parseFloat(record.TemporaryCards) : 0;\n\n// Handle NaN cases\nconst nCards = isNaN(numberOfCards) ? 0 : numberOfCards;\nconst fCards = isNaN(fullCards) ? 0 : fullCards;\nconst tCards = isNaN(temporaryCards) ? 0 : temporaryCards;\n\n// Calculate required temporary cards\nlet requiredTemporaryCards = (0.8 * nCards) - (fCards + tCards);\n\nrequiredTemporaryCards = Math.max(0, Math.ceil(requiredTemporaryCards));\n\nreturn requiredTemporaryCards;\n"
          },
          "outcomes": {
            "success": "1775727165914"
          },
          "code": "NUMBER_OF_REQUIRED_TEMPORARY_CARDS",
          "id": "1775727058217",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Required Temporary Cards"
          },
          "outcomes": {
