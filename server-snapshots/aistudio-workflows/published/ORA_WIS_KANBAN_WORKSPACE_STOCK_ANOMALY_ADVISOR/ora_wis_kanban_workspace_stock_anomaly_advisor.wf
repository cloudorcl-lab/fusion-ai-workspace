            "replenishKanbanCards": "add_replenishKanbanCards_1773645985307"
          },
          "code": "RUN_ACTIONS",
          "convergenceTargetId": "end",
          "id": "1773645985307",
          "inputs": [
            {
              "id": "1773645985309_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.GET_PULL_SEQUENCE_ID.$output.result.Action}}"
            }
          ],
          "type": "SWITCH"
        },
