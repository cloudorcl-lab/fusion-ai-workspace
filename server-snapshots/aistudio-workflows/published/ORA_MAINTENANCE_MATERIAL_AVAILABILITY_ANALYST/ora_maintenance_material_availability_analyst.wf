                  "metadata": {
                    "name": "Append Additional Information",
                    "returnType": "object",
                    "sourceCode": "let retValue = {};\n\nlet InventoryItemId =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.InventoryItemId;\nlet OrganizationId = $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.OrganizationId;\nlet ItemNumber =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.Material;\nlet ItemDescription =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.MaterialDescription;\nlet UOM =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.UnitOfMeasure;\nlet RequiredQuantity =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.RequiredQuantity;\nlet OpenQuantity =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.OpenQuantity;\nlet ShortageQuantity =   $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.$currentItem.ShortageQuantity;\nlet OrgsWithStock = ( $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.GET_ON_HAND?.$output?.items ?? []).filter(r => (Number(r?.OnhandQuantity ?? 0) || 0) > 0).length;\nlet LeadTime = $context.$nodes.GET_ITEM_SHORTAGE_ADDITIONAL_DATA.GET_LEAD_TIME.$output?.items?.[0]?.FixedLeadTime ?? null;\n\nretValue = {InventoryItemId, OrganizationId, ItemNumber, ItemDescription, UOM, RequiredQuantity, OpenQuantity, ShortageQuantity, OrgsWithStock, LeadTime};\n\nreturn retValue;"
                  },
                  "outcomes": {
                    "success": "end_1771497094468"
                  },
