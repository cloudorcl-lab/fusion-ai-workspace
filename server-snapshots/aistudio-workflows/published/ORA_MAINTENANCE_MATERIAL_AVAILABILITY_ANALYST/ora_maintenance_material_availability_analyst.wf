        {
          "metadata": {
            "name": "Form Material Shortage Data for Work Orders",
            "returnType": "array",
            "sourceCode": "// result => [{ WorkOrderId, WorkOrderNumber, AssetNumber, WoStatusName, WorkCenter, DistinctItemShortages, TotalShortageQuantity,MaterialAssignment[] }, ...]\n \nconst raw = $context.$nodes.GET_WORK_ORDER_MATERIAL_SHORTAGES.$output?? [];\n\nconst items = (Array.isArray(raw) ? raw : [])\n.map(s => { try { return JSON.parse(String(s)); } catch { return null; } })\n.filter(o => o && Array.isArray(o.items) && o.items.length > 0)\n.flatMap(o => o.items);\n\n\nconst byWorkOrderId = new Map();\n\nfor (const it of items) {\n  const woId = it?.WorkOrderId;\n  const woNum = it?.WorkOrderNumber;\n  const assetNum = it?.AssetNumber;\n  const woStatus = it?.WoStatusName;\n  const workCenter = it?.WorkCenter;\n  const materialAssignmentItems = it?.MaterialAssignment?.items ?? [];\n  if (!woId) continue;\n\n  const rec = byWorkOrderId.get(woId) || { WorkOrderId: woId, WorkOrderNumber: woNum, AssetNumber: assetNum, WoStatusName: woStatus, WorkCenter: workCenter, DistinctItemShortages : 0, TotalShortageQuantity:0, MaterialAssignment: materialAssignmentItems };\n\n rec.TotalShortageQuantity = materialAssignmentItems.reduce((sum, item) => sum + Number(item.ShortageQuantity || 0), 0);\n\nconst result = materialAssignmentItems.reduce(\n  (acc, item) => {\n    const qty = Number(item.ShortageQuantity || 0);\n    if (qty > 0) {\n      acc.distinctInventoryItemIds.add(item.InventoryItemId);\n    }\n    acc.sum += qty;\n    return acc;\n  },\n  { sum: 0, distinctInventoryItemIds: new Set() }\n);\n\nrec.TotalShortageQuantity = result.sum;\nrec.DistinctItemShortages = result.distinctInventoryItemIds.size;\n\n  byWorkOrderId.set(woId, rec);\n}\n\nreturn Array.from(byWorkOrderId.values());\n\n"
          },
          "outcomes": {
            "success": "1771392566787"
          },
          "code": "FORM_MATERIAL_SHORTAGE_DATA_FOR_WORK_ORDERS",
          "convergenceTargetId": "1772518846684",
          "id": "1771392392365",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
