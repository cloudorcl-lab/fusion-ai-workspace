        {
          "metadata": {
            "name": "Get Context Data",
            "returnType": "object",
            "sourceCode": "//Get Org Context\nconst appContext = $context.$app.$OraAppContext ?? $context.$triggers.REST.$input.OraAppContext;\nlet OrganizationId;\n\n// Check for all empty cases: undefined, null, empty string, and whitespace only\nif (appContext && String(appContext).trim() !== '') {\n    try {\n        // Try parsing as JSON\n        const contextObj = JSON.parse(appContext);\n        OrganizationId = contextObj.OrganizationId;\n    } catch (e) {\n        // Fallback: comma-separated string\n       OrganizationId= String(appContext).trim();\n    }\n}\n\n// Get current date (may be string or Date depending on platform)\nconst today = $context.$system.$currentDate ;\n\n// StartDate = today - 30 days\nconst startDateObj = new Date(today);\nstartDateObj.setDate(startDateObj.getDate() - 30);\n\n// EndDate = today + 7 days\nconst endDateObj = new Date(today);\nendDateObj.setDate(endDateObj.getDate() + 7);\n\nconst StartDate = startDateObj.toISOString().split('T')[0];\nconst EndDate = endDateObj.toISOString().split('T')[0];\n\nreturn {OrganizationId,StartDate,EndDate};"
          },
          "outcomes": {
            "success": "1767832181309"
          },
          "code": "GET_CONTEXT_DATA",
          "id": "1769778260670",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
