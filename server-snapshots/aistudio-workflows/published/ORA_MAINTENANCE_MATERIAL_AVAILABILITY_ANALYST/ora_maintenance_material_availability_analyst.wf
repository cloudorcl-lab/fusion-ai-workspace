{
  "workflowId": "300000327004242",
  "workflowCode": "ORA_MAINTENANCE_MATERIAL_AVAILABILITY_ANALYST",
  "name": "Maintenance Material Availability Analyst",
  "description": "Identify item shortages at the organization and work order level for maintenance supervisors in a unified workspace. Recommend substitute items when available and sufficient to resolve the shortage. Suggest inventory transfers if the original item is available in another organization. Advise creating part requisitions when neither substitutes nor inventory transfers are possible. Streamline the resolution process by surfacing actionable recommendations to ensure timely completion of maintenance activities.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
