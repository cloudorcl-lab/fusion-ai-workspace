          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"learningItemId\",\n          \"learningItemTitle\",\n          \"learningItemTypeMeaning\",\n          \"learningItemNumber\",\n          \"learningItemSkillv2\",\n          \"badgeText\",\n          \"badgeStatus\",\n          \"longMetaText1\",\n          \"learningItemVisibilityStartDate\",\n          \"learningItemType\",\n          \"learningItemDisplayType\",\n          \"learningItemDisplayTypeMeaning\",\n          \"liShortDescription\",\n          \"learningItemDescription\",\n          \"learningItemMinimumPrice\",\n          \"learningItemMaximumPrice\",\n          \"learningItemPriceCurrency\",\n          \"learningItemPublishedDate\",\n          \"learningItemCreationDate\",\n          \"learningItemExpectedEffortInHours\",\n          \"learningItemRatingAverage\",\n          \"learningItemRatingCount\",\n          \"learningItemViewCount\",\n          \"learningItemThumbnailLink\",\n          \"learningItemCoverArtLink\",\n          \"learningItemDetailsDeepLink\",\n          \"enableGetStarted\",\n          \"learnSSDetailVbcsEnabled\",\n          \"learningItemCoordDisplayName\",\n          \"learningOutcomes\",\n          \"isFollowing\",\n          \"canUnfollow\",\n          \"learningItemTypeMeaningv2\",\n          \"learningFormatMeaning\",\n          \"learningItemTypev2\"\n        ],\n        \"properties\": {\n          \"learningItemId\": {\n            \"type\": \"number\"\n          },\n          \"learningItemTitle\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemTypeMeaning\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemNumber\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemSkillv2\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"badgeText\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"badgeStatus\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"longMetaText1\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemVisibilityStartDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemDisplayType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemDisplayTypeMeaning\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"liShortDescription\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemDescription\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemMinimumPrice\": {\n            \"type\": \"number\"\n          },\n          \"learningItemMaximumPrice\": {\n            \"type\": \"number\"\n          },\n          \"learningItemPriceCurrency\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemPublishedDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemCreationDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemExpectedEffortInHours\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemRatingAverage\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemRatingCount\": {\n            \"type\": \"number\"\n          },\n          \"learningItemViewCount\": {\n            \"type\": \"number\"\n          },\n          \"learningItemThumbnailLink\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemCoverArtLink\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemDetailsDeepLink\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"enableGetStarted\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learnSSDetailVbcsEnabled\": {\n            \"type\": \"boolean\"\n          },\n          \"learningItemCoordDisplayName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningOutcomes\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"isFollowing\": {\n            \"type\": \"boolean\"\n          },\n          \"canUnfollow\": {\n            \"type\": \"boolean\"\n          },\n          \"learningItemSkills\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"skillName\",\n                \"skillLevel\",\n                \"skillLevelName\"\n              ],\n              \"properties\": {\n                \"skillName\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"skillLevel\": {\n                  \"type\": \"number\"\n                },\n                \"skillLevelName\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          },\n          \"publicSkills\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"name\",\n                \"numericRating\",\n                \"ratingDescription\"\n              ],\n              \"properties\": {\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"numericRating\": {\n                  \"type\": \"number\"\n                },\n                \"ratingDescription\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          },\n          \"competencies\": {\n            \"type\": \"array\",\n            \"uniqueItems\": true,\n            \"minItems\": 1,\n            \"items\": {\n              \"required\": [\n                \"name\",\n                \"numericRating\",\n                \"ratingDescription\"\n              ],\n              \"properties\": {\n                \"name\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                },\n                \"numericRating\": {\n                  \"type\": \"number\"\n                },\n                \"ratingDescription\": {\n                  \"type\": \"string\",\n                  \"minLength\": 1\n                }\n              }\n            }\n          },\n          \"learningItemTypeMeaningv2\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningFormatMeaning\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"learningItemTypev2\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"totalResults\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\",\n    \"totalResults\"\n  ]\n}",
