                {
                  "metadata": {
                    "name": "Return Enrollment Status",
                    "returnType": "object",
                    "sourceCode": "const learningItem = $context.$nodes.CHECK_LEARNING_ITEM_ENROLLMENT_STATUS.GET_LEARNING_ITEM_ENROLLMENT_STATUS.$output.learningAssignmentHints ; \n\nlet currentItem = $context.$nodes.CHECK_LEARNING_ITEM_ENROLLMENT_STATUS.$currentItem ;\n\nconst hasEnrolled = learningItem.count != 0 ;\n\ncurrentItem.hasEnrolled = hasEnrolled\n\nif (currentItem.hasEnrolled == true){\n    currentItem = {};\n}\n\nreturn currentItem;"
                  },
                  "outcomes": {
                    "success": "end_1770016596074"
                  },
                  "code": "RETURN_ENROLLMENT_STATUS",
                  "id": "1770016934068",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
