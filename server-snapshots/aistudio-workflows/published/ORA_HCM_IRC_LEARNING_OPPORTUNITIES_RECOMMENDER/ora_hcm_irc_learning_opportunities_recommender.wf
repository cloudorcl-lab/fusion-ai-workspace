          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"OpportunityId\",\n          \"OpportunityType\",\n          \"OpportunityNumber\",\n          \"Title\",\n          \"Description\"\n        ],\n        \"properties\": {\n          \"OpportunityId\": {\n            \"type\": \"number\"\n          },\n          \"OpportunityType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OpportunityNumber\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Title\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Description\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"totalResults\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\",\n    \"totalResults\"\n  ]\n}",
          "type": "BO_FUNCTION"
