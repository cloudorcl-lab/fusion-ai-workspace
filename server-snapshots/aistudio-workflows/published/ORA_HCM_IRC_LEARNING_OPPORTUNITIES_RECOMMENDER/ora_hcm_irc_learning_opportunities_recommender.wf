                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"GigId\": {\n      \"type\": \"number\"\n    },\n    \"GigNumber\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"CreatorPersonId\": {\n      \"type\": \"number\"\n    },\n    \"GeographyNodeId\": {\n      \"type\": \"number\"\n    },\n    \"StartDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"EndDate\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"PublishDate\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"TimeCommitment\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"RemoteOpportunityFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"StatusCode\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"OrganizationId\": {\n      \"type\": \"number\"\n    },\n    \"Title\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"DescriptionStr\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"Location\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"CreatorName\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"CreatorEmail\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"CreatorPhoneNumber\": {\n      \"type\": \"object\",\n      \"properties\": {},\n      \"required\": []\n    },\n    \"CreatorPosition\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"BookmarkFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"HasAppliedFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"GigValidFlag\": {\n      \"type\": \"boolean\"\n    },\n    \"ProfileId\": {\n      \"type\": \"number\"\n    },\n    \"FilledCount\": {\n      \"type\": \"objec