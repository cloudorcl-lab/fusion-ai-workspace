{
  "workflowId": "100002355227051",
  "workflowCode": "ORA_RMC_TRANSACTION_VIOLATIONS_GENERATOR",
  "name": "RMC Transaction Violations Generator",
  "description": "Combines precomputed access-violation and transaction-incident data to identify correlated transaction risk.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "GET_FOUND_USERS_WITH_VIOLATIONS"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_DESCRIPTIONCLOB",
            "functionName": "get_announcements-DescriptionClob",
            "name": "Get Found Users With Violations"
          },
          "outcomes": {
            "success": "EXTRACT_FOUND_USERS_WITH_VIOLATIONS"
          },
          "code": "GET_FOUND_USERS_WITH_VIOLATIONS",
          "id": "GET_FOUND_USERS_WITH_VIOLATIONS",
          "inputs": [
            {
              "id": "GET_FOUND_USERS_WITH_VIOLATIONS_1",
              "name": "announcements_Id",
              "type": "string",
              "value": "894871897531003"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Found Users With Violations",
            "returnType": "object",
            "sourceCode": "var data = $context.$nodes.GET_FOUND_USERS_WITH_VIOLATIONS.$output;\n\nif (data && data.length > 2 && data.charAt(0) === '\"') { data = data.slice(1, -1); }\n\nvar userData = [];\ntry { userData = JSON.parse(data || '[]'); } catch(e) { userData = []; }\n\nvar usernames = userData.map(function(item){ return item.UserName; }).filter(function(username){ return username !== null && username !== undefined; });\nvar userNameArray = usernames.filter(function(value, index, self){ return self.indexOf(value) === index; });\n\nvar userControlMap = {};\nfor (var i = 0; i < userData.length; i++) {\n  var item = userData[i];\n  var username = item.UserName;\n  var control = item.ControlName;\n  if (!username || !control) { continue; }\n  if (!userControlMap[username]) { userControlMap[username] = []; }\n  if (userControlMap[username].indexOf(control) === -1) { userControlMap[username].push(control); }\n}\n\nreturn { usernames: userNameArray, userControlMap: userControlMap, _debug: { step: 1, accessViolationRecords: userData.length, uniqueUsers: userNameArray.length } };"
          },
          "outcomes": {
            "success": "SET_ACCESS_USER_NAMES"
          },
          "code": "EXTRACT_FOUND_USERS_WITH_VIOLATIONS",
          "id": "EXTRACT_FOUND_USERS_WITH_VIOLATIONS",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Access User Names"
          },
          "outcomes": {
            "success": "GET_TRANSACTION_CONTROLS"
          },
          "code": "SET_ACCESS_USER_NAMES",
          "id": "SET_ACCESS_USER_NAMES",
          "inputs": [
            {
              "id": "SET_ACCESS_USER_NAMES_1",
              "name": "AccessUserNames",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.EXTRACT_FOUND_USERS_WITH_VIOLATIONS.$output.result.usernames}}"
            },
            {
              "id": "SET_ACCESS_USER_NAMES_2",
              "name": "AccessUserControlMap",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.EXTRACT_FOUND_USERS_WITH_VIOLATIONS.$output.result.userControlMap}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_GETALLACTIVECONTROLS",
            "functionName": "getall_advancedControls",
            "name": "Get Transaction Controls"
          },
          "outcomes": {
            "success": "EXTRACT_CONTROLS"
          },
          "code": "GET_TRANSACTION_CONTROLS",
          "id": "GET_TRANSACTION_CONTROLS",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Controls",
            "returnType": "array",
            "sourceCode": "var items = $context.$nodes.GET_TRANSACTION_CONTROLS.$output.items || [];\n  \nvar filteredItems = items\n  .filter(function(item) {\n    var name = item.Name || '';\n    var desc = item.Description || '';\n    return name.indexOf('Same User') !== -1 || desc.indexOf('same user') !== -1;\n  })\n  .map(function(item) {\n    return {\n      ControlId: item.Id,\n      Name: item.Name,\n      Description: item.Description\n    };\n  });\n\nvar controlNames = filteredItems.map(function(c) { return c.Name; });\nvar result = {\n  controls: filteredItems,\n  _debug: {\n    step: 2,\n    totalControlsFromAPI: items.length,\n    filteredControlCount: filteredItems.length,\n    controlNames: controlNames\n  }\n};\nreturn result;"
          },
          "outcomes": {
            "success": "FOR_EACH_CONTROL"
          },
          "code": "EXTRACT_CONTROLS",
          "id": "EXTRACT_CONTROLS",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of control loop"
                  },
                  "outcomes": {
                    "success": "CALL_SUB_WORKFLOW"
                  },
                  "id": "start_control_loop",
                  "code": "START_CONTROL_LOOP",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
                    "description": "End of control loop"
                  },
                  "id": "end_control_loop",
                  "code": "END_CONTROL_LOOP",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "Call Process Control Incidents",
                    "workflowCode": "ORA_RMC_TRANSACTION_INCIDENTS_ASSISTANT"
                  },
                  "outcomes": {
                    "success": "end_control_loop"
                  },
                  "code": "CALL_SUB_WORKFLOW",
                  "id": "CALL_SUB_WORKFLOW",
                  "inputs": [
                    {
                      "id": "CALL_SUB_WORKFLOW_1",
                      "name": "controlId",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_CONTROL.$currentItem.ControlId}}"
                    },
                    {
                      "id": "CALL_SUB_WORKFLOW_2",
                      "name": "controlName",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_CONTROL.$currentItem.Name}}"
                    },
                    {
                      "id": "CALL_SUB_WORKFLOW_3",
                      "name": "controlDesc",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_CONTROL.$currentItem.Description}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "WORKFLOW"
                }
              ],
              "rootNode": "start_control_loop"
            },
            "loopType": "PARALLEL",
            "name": "For Each Control"
          },
          "outcomes": {
            "success": "AGGREGATE_USERS"
          },
          "code": "FOR_EACH_CONTROL",
          "id": "FOR_EACH_CONTROL",
          "inputs": [
            {
              "id": "FOR_EACH_CONTROL_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_CONTROLS.$output.result.controls}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Aggregate Users",
            "returnType": "array",
            "sourceCode": "var loopOutput = $context.$nodes.FOR_EACH_CONTROL.$output || {};\nvar users = {};\nvar keys = Object.keys(loopOutput);\nvar completedCount = 0;\nvar failedCount = 0;\nvar controlStats = [];\n\nfor (var i = 0; i < keys.length; i++) {\n  var item = loopOutput[keys[i]];\n  if (!item) { failedCount++; continue; }\n  var parsed = null;\n  try {\n    if (typeof item === 'string') { parsed = JSON.parse(item); }\n    else { parsed = item; }\n  } catch(e) { failedCount++; continue; }\n  if (!parsed || parsed.status !== 'COMPLETE') { failedCount++; continue; }\n  completedCount++;\n  var outputStr = parsed.output;\n  if (!outputStr) continue;\n  var outputObj = null;\n  try {\n    if (typeof outputStr === 'string') { outputObj = JSON.parse(outputStr); }\n    else { outputObj = outputStr; }\n  } catch(e) { continue; }\n  if (!outputObj || !outputObj.result || !outputObj.result.users) continue;\n  var ctrlUsers = outputObj.result.users;\n  var ctrlUserCount = Object.keys(ctrlUsers).length;\n  controlStats.push({ control: outputObj.result.controlName || 'unknown', users: ctrlUserCount });\n  for (var uname in ctrlUsers) {\n    var normalizedName = uname;\n    if (!users[normalizedName]) { users[normalizedName] = ctrlUsers[uname]; }\n    else {\n      users[normalizedName].controls = users[normalizedName].controls.concat(ctrlUsers[uname].controls);\n      users[normalizedName].totalAmount += ctrlUsers[uname].totalAmount;\n    }\n  }\n}\n\nvar accessUserControlMap = $context.$variables.AccessUserControlMap || {};\nvar arr = [];\n\nfor (var u in users) {\n  var ud = users[u];\n  var controlNames = ud.controls.map(function(c){ return c.name; });\n  var uniqueControlNames = controlNames.filter(function(name, index){ return controlNames.indexOf(name) === index; });\n  var attrs = [];\n  for (var j = 0; j < ud.controls.length; j++) { attrs = attrs.concat(ud.controls[j].foundInAttrs || []); }\n  var uniqueAttrs = attrs.filter(function(a, index){ return attrs.indexOf(a) === index; });\n  var risk = ud.totalAmount > 1000 ? 'High' : (ud.totalAmount > 500 ? 'Medium' : 'Low');\n  var accessControls = accessUserControlMap[u] || [];\n  arr.push({\n    Username: u,\n    TransactionControls: uniqueControlNames.join(', '),\n    FoundInAttrs: uniqueAttrs.join(', '),\n    TotalAmount: ud.totalAmount,\n    RiskLevel: risk,\n    ControlCount: ud.controls.length,\n    UniqueControlCount: uniqueControlNames.length,\n    TransactionIncidentCount: ud.TransactionIncidentCount || 0,\n    AccessControlViolations: accessControls,\n    HasAccessViolation: accessControls.length > 0,\n    AccessViolationCount: accessControls.length\n  });\n}\n\narr.sort(function(a, b){ return b.TotalAmount - a.TotalAmount; });\n\nvar result = {\n  users: arr,\n  _debug: {\n    step: 4,\n    subWorkflowResults: keys.length,\n    completed: completedCount,\n    failed: failedCount,\n    aggregatedUsers: arr.length,\n    controlStats: controlStats\n  }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "WRITE_TO_ANNOUNCEMENT"
          },
          "code": "AGGREGATE_USERS",
          "id": "AGGREGATE_USERS",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_DESCRIPTIONCLOB",
            "functionName": "replace_announcements-DescriptionClob",
            "processJson": true,
            "name": "Write To Announcement"
          },
          "outcomes": {
            "success": "OUTPUT_COMPLETED"
          },
          "code": "WRITE_TO_ANNOUNCEMENT",
          "id": "WRITE_TO_ANNOUNCEMENT",
          "inputs": [
            {
              "id": "WRITE_TO_ANNOUNCEMENT_1",
              "name": "announcements_Id",
              "type": "string",
              "value": "894871897531007"
            },
            {
              "id": "WRITE_TO_ANNOUNCEMENT_2",
              "name": "pContent",
              "type": "string",
              "value": "{{$context.$nodes.AGGREGATE_USERS.$output.result.users}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Output Completed",
            "returnType": "string",
            "sourceCode": "var aggResult = $context.$nodes.AGGREGATE_USERS.$output.result || {};\nvar aggregatedData = aggResult.users || [];\nvar debugInfo = aggResult._debug || {};\nvar highRisk = aggregatedData.filter(function(u){ return u.RiskLevel === 'High'; }).length;\nvar medRisk = aggregatedData.filter(function(u){ return u.RiskLevel === 'Medium'; }).length;\nvar lowRisk = aggregatedData.filter(function(u){ return u.RiskLevel === 'Low'; }).length;\nvar withAccessViolations = aggregatedData.filter(function(u){ return u.HasAccessViolation; }).length;\nvar step1Debug = $context.$nodes.EXTRACT_FOUND_USERS_WITH_VIOLATIONS.$output.result._debug || {};\nvar step2Debug = $context.$nodes.EXTRACT_CONTROLS.$output.result._debug || {};\nvar summary = 'Transaction data generation completed.\\n';\nsummary += 'Step 1: ' + (step1Debug.accessViolationRecords || 0) + ' access violation records, ' + (step1Debug.uniqueUsers || 0) + ' unique users\\n';\nsummary += 'Step 2: ' + (step2Debug.totalControlsFromAPI || 0) + ' total controls, ' + (step2Debug.filteredControlCount || 0) + ' filtered controls\\n';\nsummary += 'Step 4: ' + (debugInfo.completed || 0) + '/' + (debugInfo.subWorkflowResults || 0) + ' sub-workflows completed\\n';\nsummary += 'Result: ' + aggregatedData.length + ' users written to Announcement 1007\\n';\nsummary += 'Risk: High=' + highRisk + ', Medium=' + medRisk + ', Low=' + lowRisk + '\\n';\nsummary += 'Users with access violations: ' + withAccessViolations;\nvar result = summary;\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "OUTPUT_COMPLETED",
          "id": "OUTPUT_COMPLETED",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"string\"\n    }\n  }\n}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
      "variables": [
        {
          "id": "var_access_user_names",
          "name": "AccessUserNames",
          "scope": "JOB",
          "type": "object"
        },
        {
          "id": "var_access_user_control_map",
          "name": "AccessUserControlMap",
          "scope": "JOB",
          "type": "object"
        }
      ],
      "errorHandlers": []
    },
    "modelConfiguration": null,
    "humanApprovalFlag": false,
