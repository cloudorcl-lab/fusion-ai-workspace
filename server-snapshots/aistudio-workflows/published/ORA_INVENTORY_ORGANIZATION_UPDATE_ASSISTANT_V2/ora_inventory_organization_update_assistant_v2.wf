          "metadata": {
            "name": "Resolve Search Pagination State",
            "returnType": "object",
            "sourceCode": "function toNumber(value, fallbackValue) {\n  const numericValue = Number(value);\n  return Number.isFinite(numericValue) ? numericValue : fallbackValue;\n}\n\nfunction toPositiveInteger(value, fallbackValue) {\n  const numericValue = Number(value);\n  return Number.isInteger(numericValue) && numericValue > 0 ? numericValue : fallbackValue;\n}\n\nfunction advanceOffset(offsetValue, limitValue) {\n  return offsetValue + limitValue;\n}\n\nfunction unwrapNodeOutput(value) {\n  if (!value || typeof value !== 'object') {\n    return value || {};\n  }\n\n  if (\n    Object.prototype.hasOwnProperty.call(value, 'result') &&\n    (Object.prototype.hasOwnProperty.call(value, 'console') || Object.prototype.hasOwnProperty.call(value, 'timedOut'))\n  ) {\n    return value.result || {};\n  }\n\n  return value;\n}\n\nconst defaultOffset = 0;\nconst defaultLimit = 25;\nconst previousState = $context?.$variables?.searchPaginationState || {};\nconst paginationRequest = unwrapNodeOutput($context?.$nodes?.DETECT_SEARCH_PAGINATION_REQUEST?.$output);\nconst searchState = unwrapNodeOutput($context?.$nodes?.EXTRACT_SEARCH_DETAILS?.$output);\nconst hasLocCriteria = Array.isArray(searchState.extractedLocationDetails) && searchState.extractedLocationDetails.length > 0;\nconst requestedFetchLimit = toPositiveInteger(searchState.fetchLimit, defaultLimit);\nconst previousInventoryOffset = toNumber(previousState.inventoryOffset, defaultOffset);\nconst previousInventoryLimit = toPositiveInteger(previousState.inventoryLimit, defaultLimit);\nconst previousLocOffset = toNumber(previousState.locationOffset, defaultOffset);\nconst previousLocLimit = toPositiveInteger(previousState.locationLimit, defaultLimit);\n\nconst result = {\n  inventoryOffset: defaultOffset,\n  inventoryLimit: requestedFetchLimit,\n  locationOffset: defaultOffset,\n  locationLimit: requestedFetchLimit,\n  inventoryHasMore: previousState.inventoryHasMore === true,\n  locationHasMore: previousState.locationHasMore === true,\n  isPaginationRequest: paginationRequest.isPaginationRequest === true,\n  paginationTarget: typeof paginationRequest.target === 'string' ? paginationRequest.target : '',\n  paginationBlocked: false,\n  blockedMessage: ''\n};\n\nif (result.isPaginationRequest) {\n  if (result.paginationTarget === 'LOC') {\n    if (!hasLocCriteria) {\n      result.paginationBlocked = true;\n      result.blockedMessage = 'Pagination requires stored search criteria for the requested page set.';\n    } else if (previousState.locationHasMore === true) {\n      result.locationOffset = advanceOffset(previousLocOffset, previousLocLimit);\n      result.locationLimit = previousLocLimit;\n      result.inventoryOffset = defaultOffset;\n      result.inventoryLimit = previousInventoryLimit;\n    } else {\n      result.paginationBlocked = true;\n      result.blockedMessage = 'No more pages are available for the requested result set.';\n    }\n  } else if (previousState.inventoryHasMore === true) {\n    result.inventoryOffset = advanceOffset(previousInventoryOffset, previousInventoryLimit);\n    result.inventoryLimit = previousInventoryLimit;\n    result.locationOffset = previousLocOffset;\n    result.locationLimit = previousLocLimit;\n  } else {\n    result.paginationBlocked = true;\n    result.blockedMessage = 'No more pages are available for the requested result set.';\n  }\n}\n\nreturn result;"
          },
