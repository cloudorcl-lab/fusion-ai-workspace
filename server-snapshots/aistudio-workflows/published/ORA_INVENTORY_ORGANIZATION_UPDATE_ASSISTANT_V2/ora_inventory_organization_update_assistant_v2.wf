        {
          "metadata": {
            "name": "Dynamic Business Unit Search",
            "returnType": "object",
            "sourceCode": "let finalValue = {};\nconst businessUnitCodeList = $context.$nodes.CREATELIST?.$output?.result?.buCodeList || '';\nconst businessUnitNameList = $context.$nodes.CREATELIST?.$output?.result?.buNameList || '';\nconst fields = 'BusinessUnitName,BusinessUnitId';\n\n\nif (businessUnitNameList) {\n  finalValue = {\n    dynamicFilter: `BusinessUnitName IN (${businessUnitNameList}) AND ActiveFlag=true&fields=${fields}&onlyData=true`\n  };\n } \n/**else if (businessUnitCodeList) {\n  finalValue = {\n    dynamicFilter: `BusinessUnitCode IN (${businessUnitCodeList}) AND ActiveFlag=true&fields=${fields}&onlyData=true`\n  };\n} else if (businessUnitCodeList && businessUnitNameList) {\n  finalValue = {\n    dynamicFilter: `((BusinessUnitCode IN (${businessUnitCodeList})) OR (BusinessUnitName IN (${businessUnitNameList}))) AND ActiveFlag=true&fields=${fields}&onlyData=true`\n  };\n}  else {\n  throw new Error('Both buCodeList and buNameList are empty.');\n}**/\n\nreturn finalValue;"
          },
          "outcomes": {
            "success": "1775558795942"
          },
          "code": "DYNAMIC_BUSINESS_UNIT_SEARCH",
          "id": "1776444000001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Dynamic Location Search",
            "returnType": "object",
            "sourceCode": "let finalValue = {};\nconst locationCodeList = $context.$nodes.CREATELIST?.$output?.result?.locationCodeList || '';\nconst locationNameList = $context.$nodes.CREATELIST?.$output?.result?.locationNameList || '';\nconst fields = 'LocationCode,LocationName,LocationId';\n\nif (locationCodeList && locationNameList) {\n  finalValue = {\n    locationVal: `((LocationCode IN (${locationCodeList})) OR (LocationName IN (${locationNameList})))&fields=${fields}&onlyData=true`\n  };\n} else if (locationCodeList) {\n  finalValue = {\n    locationVal: `LocationCode IN (${locationCodeList})&fields=${fields}&onlyData=true`\n  };\n} else if (locationNameList) {\n  finalValue = {\n    locationVal: `LocationName IN (${locationNameList})&fields=${fields}&onlyData=true`\n  };\n} else {\n  throw new Error('Both locationCodeList and locationNameList are empty.');\n}\n\nreturn finalValue;\n"
          },
          "outcomes": {
            "success": "1775558802779"
          },
