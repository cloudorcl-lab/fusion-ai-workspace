        {
          "metadata": {
            "name": "DS Set Role Code",
            "returnType": "object",
            "sourceCode": "let result = {\n  dsRoleCode: '',\n  errorMessage: ''\n};\n\ntry {\n  const roleLookup = $context.$nodes.GETROLECODEBYNAME.$output || {};\n  const resources = Array.isArray(roleLookup.Resources) ? roleLookup.Resources : [];\n  const requestedRoleName = $context.$variables.dsRoleName || 'the provided role name';\n\n  if (resources.length === 0) {\n    result.errorMessage = `No role was found for role name \\\"${requestedRoleName}\\\". Please provide a valid role name or role code.`;\n  } else {\n    const firstResource = resources[0] || {};\n    const roleCode = firstResource.name || firstResource.displayName || '';\n\n    if (!roleCode) {\n      result.errorMessage = `Role lookup for \\\"${requestedRoleName}\\\" returned no role code. Please provide a valid role name or role code.`;\n    } else {\n      result.dsRoleCode = roleCode;\n    }\n  }\n} catch (error) {\n  result.errorMessage = error && error.message ? error.message : 'Failed to resolve role code from role name.';\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776440000001"
          },
