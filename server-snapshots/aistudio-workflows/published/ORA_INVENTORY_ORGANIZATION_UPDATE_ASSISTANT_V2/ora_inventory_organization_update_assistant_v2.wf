{
  "workflowId": "300000331068273",
  "workflowCode": "ORA_INVENTORY_ORGANIZATION_UPDATE_ASSISTANT_V2",
  "name": "Inventory Organization Update Assistant V2",
  "description": "Use the Inventory Organization Update Assistant to apply mass updates and modify end-user access for selected organizations. You can filter your selection using a wide range of criteria. You can also upload a spreadsheet to create organizations.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
