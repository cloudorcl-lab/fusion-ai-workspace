        {
          "id": "1776447000005",
          "code": "COMPUTE_ATTACHMENT_PRESENCE",
          "type": "CODE",
          "metadata": {
            "name": "Compute Attachment Presence",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const obj = $context.$nodes.READCSV?.$output || {};\n  const attachmentKeys = Object.keys(obj).filter(key => key !== \"ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT\");\n  result = {\n    hasAttachment: attachmentKeys.length > 0,\n    attachmentKey: attachmentKeys[0] || \"\"\n  };\n} catch (error) {\n  result = {\n    hasAttachment: false,\n    attachmentKey: \"\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775430246355"
          },
          "inputs": [],
