        {
          "metadata": {
            "name": "Check Inv Org Copy Required Attributes",
            "returnType": "object",
            "sourceCode": "var result = {\n  overallStatus: 'FAIL',\n  missingAttributes: [],\n  attributeResults: []\n};\n\nfunction hasValue(value) {\n  return value !== undefined && value !== null && String(value).trim() !== '';\n}\n\nfunction getValueReason(value) {\n  if (value === undefined) {\n    return 'missing';\n  }\n\n  if (value === null) {\n    return 'null';\n  }\n\n  if (String(value).trim() === '') {\n    return 'blank';\n  }\n\n  return 'present';\n}\n\nfunction getPayloadRoot() {\n  var workflowPayload = {};\n\n  if ($context && $context.$variables && $context.$variables.invOrgPayload) {\n    workflowPayload = $context.$variables.invOrgPayload;\n  }\n\n  if (\n    workflowPayload &&\n    typeof workflowPayload === 'object' &&\n    workflowPayload.CreateCopyOrganization &&\n    typeof workflowPayload.CreateCopyOrganization === 'object'\n  ) {\n    return workflowPayload.CreateCopyOrganization;\n  }\n\n  if (workflowPayload && typeof workflowPayload === 'object') {\n    return workflowPayload;\n  }\n\n  return {};\n}\n\ntry {\n  var root = getPayloadRoot();\n  var requiredAttributes = [\n    'NewOrganizationName',\n    'NewOrganizationCode',\n    'SourceOrganizationName'\n  ];\n  var attributeResults = [];\n  var missingAttributes = [];\n  var i;\n\n  for (i = 0; i < requiredAttributes.length; i++) {\n    var attributeName = requiredAttributes[i];\n    var attributeValue = root[attributeName];\n    var reason = getValueReason(attributeValue);\n    var status = reason === 'present' ? 'PASS' : 'FAIL';\n\n    if (status === 'FAIL') {\n      missingAttributes.push(attributeName);\n    }\n\n    attributeResults.push({\n      attributeName: attributeName,\n      status: status,\n      reason: reason,\n      value: attributeValue === undefined ? null : attributeValue\n    });\n  }\n\n  var locationFields = ['LocationName', 'LocationCode'];\n  var locationFieldValues = {};\n  var populatedLocationFields = [];\n  var j;\n\n  for (j = 0; j < locationFields.length; j++) {\n    var fieldName = locationFields[j];\n    var fieldValue = root[fieldName];\n    locationFieldValues[fieldName] = fieldValue === undefined ? null : fieldValue;\n\n    if (hasValue(fieldValue)) {\n      populatedLocationFields.push(fieldName);\n    }\n  }\n\n  var locationStatus = populatedLocationFields.length > 0 ? 'PASS' : 'FAIL';\n  if (locationStatus === 'FAIL') {\n    missingAttributes.push('Location');\n  }\n\n  attributeResults.push({\n    attributeName: 'Location',\n    status: locationStatus,\n    reason: locationStatus === 'PASS' ? 'present' : 'missing_all',\n    fields: locationFields,\n    populatedFields: populatedLocationFields,\n    fieldValues: locationFieldValues\n  });\n\n  result = {\n    overallStatus: missingAttributes.length === 0 ? 'PASS' : 'FAIL',\n    missingAttributes: missingAttributes,\n    attributeResults: attributeResults\n  };\n} catch (error) {\n  result = {\n    overallStatus: 'FAIL',\n    missingAttributes: [],\n    attributeResults: [],\n    errorMessage: error && error.message ? error.message : 'Failed to evaluate required copy attributes.'\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773377296573"
          },
          "code": "CHECK_INV_ORG_COPY_REQUIRED_ATTRIBUTES",
          "id": "1776447000003",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
