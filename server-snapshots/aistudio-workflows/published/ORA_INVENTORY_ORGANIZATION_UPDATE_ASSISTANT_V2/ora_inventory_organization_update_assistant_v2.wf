          "code": "SUMMARIZE_COPY_INV_ORG",
          "id": "1776444000006",
          "inputs": [
            {
              "id": "1776444000006_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are preparing the final user-facing summary for the business function result of: copy inventory organization.\n\nBUSINESS_FUNCTION_OUTPUT_JSON: {{$context.$nodes.COPY_INV_ORG.$output}}\n\nInstructions:\n- Treat BUSINESS_FUNCTION_OUTPUT_JSON as the complete business function output.\n- Start with a clear user-friendly summary of the outcome.\n- Then provide a separate section that shows all returned records from BUSINESS_FUNCTION_OUTPUT_JSON.\n- Never show only a subset, sample, preview, or truncated selection of records.\n- If records are present in an array or nested collection, include every returned record.\n- For each returned record, include all fields that are present in that record in readable text.\n- If the response indicates success, say what was completed.\n- If the response indicates partial success or failure, clearly explain the failure reason, error message, or blocking issue using only details present in BUSINESS_FUNCTION_OUTPUT_JSON.\n- If no records were returned, state that clearly and include the complete non-record result details that were returned.\n- Present the result in readable text, not raw JSON.\n- Do not invent details beyond BUSINESS_FUNCTION_OUTPUT_JSON."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "CreateList",
            "returnType": "object",
            "sourceCode": "let payload = $context.$nodes.CREATE_PAYLOAD.$output.result;\nconst result = {\n  buNameList: '',\n  buCodeList: '',\n  locationCodeList: '',\n  locationNameList: '',\n  legalEntityNameList: '',\n  scheduleNameList: '',\n  errorList: []\n};\n\nconst buNames = new Set();\nconst buCodes = new Set();\nconst locationCodes = new Set();\nconst locationNames = new Set();\nconst legalEntityNames = new Set();\nconst scheduleNames = new Set();\n\nconst hasValue = function (value) {\n  return value !== undefined && value !== null && String(value).trim() !== '';\n};\n\nconst quoteJoin = function (set) {\n  return Array.from(set).map(function (v) {\n    return '\\'' + String(v).trim() + '\\'';\n  }).join(',');\n};\n\nconst items = payload && Array.isArray(payload.items) ? payload.items : [];\n\nitems.forEach(function (item, index) {\n  const organizationType = item && item.OrganizationType === 'Item' ? 'Item' : 'Inventory';\n  const invOrgParams = Array.isArray(item.invOrgParameters) && item.invOrgParameters.length > 0 ? item.invOrgParameters[0] : {};\n  const missingKeys = [];\n\n  if (organizationType === 'Item') {\n    if (!hasValue(item.ItemDefinitionOrganizationName) && !hasValue(item.ItemDefinitionOrganizationCode) && !hasValue(item.ItemDefinitionOrganizationId)) {\n      missingKeys.push('ItemDefinitionOrganizationName or ItemDefinitionOrganizationCode or ItemDefinitionOrganizationId not available');\n    }\n\n    if (!hasValue(item.MasterOrganizationName) && !hasValue(item.MasterOrganizationCode) && !hasValue(item.MasterOrganizationId)) {\n      missingKeys.push('MasterOrganizationName or MasterOrganizationCode or MasterOrganizationId not available');\n    }\n\n   if (!hasValue(item.LocationId) && !hasValue(item.LocationCode) && !hasValue(item.LocationName)) {\n      missingKeys.push('LocationId or LocationCode or LocationName not available');\n    }\n  } else {\n    if (!hasValue(item.OrganizationCode) && !hasValue(item.OrganizationName)) {\n      missingKeys.push('OrganizationCode or OrganizationName');\n    }\n\n    if (!hasValue(item.MasterOrganizationId) && !hasValue(item.MasterOrganizationCode) && !hasValue(item.MasterOrganizationName)) {\n      missingKeys.push('MasterOrganizationId or MasterOrganizationCode or MasterOrganizationName not available');\n    }\n\n    if (!hasValue(item.LocationId) && !hasValue(item.LocationCode) && !hasValue(item.LocationName)) {\n      missingKeys.push('LocationId or LocationCode or LocationName not available');\n    }\n\n    if (!hasValue(item.LegalEntityId) && !hasValue(item.LegalEntityName)) {\n      missingKeys.push('LegalEntityId or LegalEntityName not available');\n    }\n\n    if (!hasValue(item.ManagementBusinessUnitId) && !hasValue(item.ManagementBusinessUnitName) && !hasValue(item.ManagementBusinessUnitCode)) {\n      missingKeys.push('ManagementBusinessUnitId or ManagementBusinessUnitName or ManagementBusinessUnitCode');\n    }\n\n    if (!hasValue(item.ProfitCenterBusinessUnitId) && !hasValue(item.ProfitCenterBusinessUnitName) && !hasValue(item.ProfitCenterBusinessUnitCode)) {\n      missingKeys.push('ProfitCenterBusinessUnitId or ProfitCenterBusinessUnitName or ProfitCenterBusinessUnitCode');\n    }\n\n    if (!hasValue(invOrgParams.ScheduleId) && !hasValue(invOrgParams.ScheduleName)) {\n      missingKeys.push('invOrgParameters[0].ScheduleId or invOrgParameters[0].ScheduleName');\n    }\n  }\n\n  if (missingKeys.length > 0) {\n    result.errorList.push({\n      itemIndex: index,\n      missingRequiredAttributes: missingKeys\n    });\n    return;\n  }\n\n  if (!hasValue(item.ManagementBusinessUnitId) && hasValue(item.ManagementBusinessUnitName)) {\n    buNames.add(item.ManagementBusinessUnitName);\n  }\n\n  if (!hasValue(item.ManagementBusinessUnitId) && hasValue(item.ManagementBusinessUnitCode)) {\n    buCodes.add(item.ManagementBusinessUnitCode);\n  }\n\n  if (!hasValue(item.ProfitCenterBusinessUnitId) && hasValue(item.ProfitCenterBusinessUnitName)) {\n    buNames.add(item.ProfitCenterBusinessUnitName);\n  }\n\n  if (!hasValue(item.ProfitCenterBusinessUnitId) && hasValue(item.ProfitCenterBusinessUnitCode)) {\n    buCodes.add(item.ProfitCenterBusinessUnitCode);\n  }\n\n  if (!hasValue(item.MasterOrganizationId) && !hasValue(item.MasterOrganizationCode) && hasValue(item.MasterOrganizationName)) {\n    buNames.add(item.MasterOrganizationName);\n  }\n\n  if (!hasValue(item.MasterOrganizationId) && hasValue(item.MasterOrganizationCode)) {\n    buCodes.add(item.MasterOrganizationCode);\n  }\n\n  if (!hasValue(item.LocationId) && hasValue(item.LocationCode)) {\n    locationCodes.add(item.LocationCode);\n  }\n\n  if (!hasValue(item.LocationId) && hasValue(item.LocationName)) {\n    locationNames.add(item.LocationName);\n  }\n\n  if (!hasValue(item.LegalEntityId) && hasValue(item.LegalEntityName)) {\n    legalEntityNames.add(item.LegalEntityName);\n  }\n\n  if (!hasValue(invOrgParams.ScheduleId) && hasValue(invOrgParams.ScheduleName)) {\n    scheduleNames.add(invOrgParams.ScheduleName);\n  }\n});\n\nresult.buNameList = quoteJoin(buNames);\nresult.buCodeList = quoteJoin(buCodes);\nresult.locationCodeList = quoteJoin(locationCodes);\nresult.locationNameList = quoteJoin(locationNames);\nresult.legalEntityNameList = quoteJoin(legalEntityNames);\nresult.scheduleNameList = quoteJoin(scheduleNames);\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775411161257"
          },
          "code": "CREATELIST",
          "id": "1775390851845",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
