            "sourceCode": "let finalValue = {};\n  const createCopyOrg = $context.$variables.invOrgPayload?.CreateCopyOrganization || {};\n  const locationCode = createCopyOrg.LocationCode;\n  const locationName = createCopyOrg.LocationName;\n\n  if (!locationCode && !locationName) {\n    throw new Error(\"Both LocationCode and LocationName are null or undefined\");\n  }\n\n  if (locationCode) {\n    finalValue = { locationVal: `LocationCode='${locationCode}'&fields=LocationCode,LocationName,LocationId&onlyData=true` };\n  } else if (locationName) {\n    finalValue = { locationVal: `LocationName='${locationName}'&fields=LocationCode,LocationName,LocationId&onlyData=true` };\n  } else {\n     throw new Error(\"Both LocationCode and LocationName are null or undefined\");\n  }\n\nreturn finalValue;"
