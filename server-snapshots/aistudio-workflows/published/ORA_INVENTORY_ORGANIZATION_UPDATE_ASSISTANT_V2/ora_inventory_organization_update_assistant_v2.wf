        {
          "metadata": {
            "name": "Combine Query Filter",
            "returnType": "string",
            "sourceCode": "let result = \"\";\nlet locationFilter = $context.$nodes.CREATE_INVENTORY_ORG_LOCATION_FILTER.$output.result || \"\";\n  let invSetupFilter = $context.$nodes.CREATEQUERYFILTER.$output.result.setup?.filterExpression || \"\";\n\n  // Combine filters with AND if both are non-empty\n  if (locationFilter && invSetupFilter) {\n    result = `(${locationFilter}) AND (${invSetupFilter})`;\n  } else if (locationFilter) {\n    result = locationFilter;\n  } else if (invSetupFilter) {\n    result = invSetupFilter;\n  } else {\n    result = \"\";\n  }\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776446000011"
          },
          "code": "COMBINE_QUERY_FILTER",
          "id": "1773245058870",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
