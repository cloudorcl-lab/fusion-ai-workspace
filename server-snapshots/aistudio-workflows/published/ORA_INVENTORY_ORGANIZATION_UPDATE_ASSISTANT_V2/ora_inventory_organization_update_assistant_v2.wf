            "sourceCode": "let result = { OrgType: 'Inventory' };\ntry {\n  const orgType = $context.$nodes?.INTENT_FINDER?.$output?.context?.orgtype;\n  result = {\n    OrgType: orgType === 'Unknown' ? 'Inventory' : orgType\n  };\n} catch (error) {\n  result = { OrgType: 'Inventory' };\n}\n\nreturn result;"
          },
