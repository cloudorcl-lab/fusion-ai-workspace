          "metadata": {
            "name": "Build Inventory With Location Pagination State",
            "returnType": "object",
            "sourceCode": "function toNumber(value, fallbackValue) {\n  const numericValue = Number(value);\n  return Number.isFinite(numericValue) ? numericValue : fallbackValue;\n}\n\nconst previousState = $context?.$variables?.searchPaginationState || {};\nconst resolvedState = $context?.$nodes?.RESOLVE_SEARCH_PAGINATION_STATE?.$output?.result || {};\n\nconst result = {\n  inventoryOffset: toNumber(resolvedState.inventoryOffset, 0),\n  inventoryLimit: toNumber(resolvedState.inventoryLimit, 25),\n  locationOffset: toNumber(resolvedState.locationOffset, 0),\n  locationLimit: toNumber(resolvedState.locationLimit, 25),\n  inventoryHasMore: $context?.$nodes?.QUERY_INVENTORY_SETUP_WITH_LOCATION?.$output?.hasMore === true,\n  locationHasMore: previousState.locationHasMore === true,\n  lastPaginatedTarget: 'inventory',\n  lastSearchMode: 'inventory_with_location'\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776446000022"
          },
