            "returnType": "object",
            "sourceCode": "let result = {\n  keyValues: [],\n  keyValuesPayload: '[]',\n  updateResourceName: '',\n  attNameToUpdate: '',\n  attValueToUpdate: ''\n};\n\ntry {\n  const payload = $context.$nodes.BULK_UPDATE.$output || {};\n  const params = payload && payload.params ? payload.params : {};\n  const rawKeyValues = params.keyValues;\n\n  function normalizeAttributeValue(attributeName, value) {\n    if (attributeName && /flag/i.test(String(attributeName)) && value !== undefined && value !== null && String(value).trim() !== '') {\n      const normalizedValue = String(value).trim().toUpperCase();\n      if (normalizedValue === 'TRUE') {\n        return true;\n      }\n      if (normalizedValue === 'FALSE') {\n        return false;\n      }\n    }\n\n    return value == null ? '' : String(value);\n  }\n\n  if (Array.isArray(rawKeyValues)) {\n    result.keyValues = rawKeyValues.filter(function (value) {\n      return value !== undefined && value !== null && value !== '';\n    });\n  } else if (rawKeyValues !== undefined && rawKeyValues !== null && rawKeyValues !== '') {\n    result.keyValues = [rawKeyValues];\n  }\n\n  result.keyValuesPayload = '[' + result.keyValues.map(function (value) {\n    return String(value);\n  }).join(',') + ']';\n  result.updateResourceName = params.updateResourceName == null ? '' : String(params.updateResourceName);\n  result.attNameToUpdate = params.attNameToUpdate == null ? '' : String(params.attNameToUpdate);\n  result.attValueToUpdate = normalizeAttributeValue(result.attNameToUpdate, params.attValueToUpdate);\n} catch (error) {\n  result = {\n    keyValues: [],\n    keyValuesPayload: '[]',\n    updateResourceName: '',\n    attNameToUpdate: '',\n    attValueToUpdate: ''\n  };\n}\n\nreturn result;"
