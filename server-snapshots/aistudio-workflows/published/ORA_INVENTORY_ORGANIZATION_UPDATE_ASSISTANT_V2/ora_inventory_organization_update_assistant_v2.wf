                  "metadata": {
                    "name": "GetIdsForCreate",
                    "sourceCode": "let result = {};\ntry {\n  const currentItem = $context.$nodes?.FOR_EACH_ENTRY?.$currentItem || {};\n\n  const buList = $context.$variables.BUNameToIdList?.items || [];\n  const legalEntityList = $context.$variables.LegalEntityNameToIdList?.items || [];\n  const locationList = $context.$variables.LocationCodeToIdList?.items || [];\n  const scheduleList = $context.$variables.ScheduleNameToIdList?.items || [];\n\n  function hasValue(value) {\n    return value !== undefined && value !== null && String(value).trim() !== '';\n  }\n\n  function findIdByName(list, nameProp, idProp, matchValue) {\n    if (!list || !matchValue) return null;\n    const found = list.find(item => item?.[nameProp] === matchValue);\n    return found ? found[idProp] : null;\n  }\n\n  function normalizeItemGroupingCode(itemGroupingCode, itemDefinitionOrganizationName, organizationName) {\n    const normalizedValue = itemGroupingCode == null ? '' : String(itemGroupingCode).trim();\n    const upperValue = normalizedValue.toUpperCase();\n\n    if (upperValue === 'DEFINITION') {\n      return 'ORA_RCS_IGB_DFTN';\n    }\n\n    if (upperValue === 'REFERENCE') {\n      return 'ORA_RCS_IGB_RFRC';\n    }\n\n    if (normalizedValue) {\n      return normalizedValue;\n    }\n\n    if (itemDefinitionOrganizationName && organizationName && String(itemDefinitionOrganizationName).trim().toUpperCase() === String(organizationName).trim().toUpperCase()) {\n      return 'ORA_RCS_IGB_DFTN';\n    }\n\n    return 'ORA_RCS_IGB_RFRC';\n  }\n\n  const nonUpdatableAttributes = {\n    inventoryOrganizations: [\n      'ManagementBusinessUnitName',\n      'LegalEntityName',\n      'ProfitCenterBusinessUnitName',\n      'LocationCode',\n      'CreatedBy',\n      'CreationDate',\n      'LastUpdatedBy',\n      'LastUpdateDate'\n    ],\n    invOrgParameters: [\n      'InternalCustomerName',\n      'CreatedBy',\n      'CreationDate',\n      'LastUpdatedBy',\n      'LastUpdateDate',\n      'ExpiredLotQuarantineSubinventoryName'\n    ]\n  };\n\n  function stripAttributes(target, keysToRemove) {\n    if (!target || typeof target !== 'object' || !Array.isArray(keysToRemove)) {\n      return target;\n    }\n\n    keysToRemove.forEach(function (key) {\n      delete target[key];\n    });\n\n    return target;\n  }\n\n  result = {\n    ...currentItem,\n    invOrgParameters: Array.isArray(currentItem.invOrgParameters)\n      ? currentItem.invOrgParameters.map(function (item) { return { ...item }; })\n      : []\n  };\n\n  if (result.OrganizationCode !== undefined && result.OrganizationCode !== null) {\n    result.OrganizationCode = String(result.OrganizationCode).toUpperCase();\n  }\n\n  if (!result.OrganizationType) {\n    result.OrganizationType = 'Inventory';\n  }\n\n  if (!Array.isArray(result.invOrgParameters) || result.invOrgParameters.length === 0) {\n    result.invOrgParameters = [{}];\n  }\n\n  if (!result.MasterOrganizationName && !result.MasterOrganizationCode && !result.MasterOrganizationId) {\n    result.MasterOrganizationName = result.OrganizationName || null;\n  }\n\n  if (!result.ItemDefinitionOrganizationName && !result.ItemDefinitionOrganizationCode && !result.ItemDefinitionOrganizationId) {\n    result.ItemDefinitionOrganizationName = result.OrganizationName || null;\n  }\n\n  result.ItemGroupingCode = normalizeItemGroupingCode(\n    currentItem.ItemGroupingCode,\n    result.ItemDefinitionOrganizationName,\n    result.OrganizationName\n  );\n\n  if (Array.isArray(result.invOrgParameters) && result.invOrgParameters[0]) {\n    result.invOrgParameters[0].ItemGroupingCode = result.ItemGroupingCode;\n  }\n\n  if (!result.MasterOrganizationId) {\n    if (result.MasterOrganizationName) {\n      result.MasterOrganizationId = findIdByName(buList, 'BusinessUnitName', 'BusinessUnitId', result.MasterOrganizationName);\n    } else {\n      result.MasterOrganizationId = result.MasterOrganizationId || null;\n    }\n  }\n\n  if (!result.ManagementBusinessUnitId) {\n    if (result.ManagementBusinessUnitName) {\n      result.ManagementBusinessUnitId = findIdByName(\n        buList,\n        'BusinessUnitName',\n        'BusinessUnitId',\n        result.ManagementBusinessUnitName\n      );\n    } else {\n      result.ManagementBusinessUnitId = result.ManagementBusinessUnitId || null;\n    }\n  }\n\n  if (!result.ProfitCenterBusinessUnitId) {\n    if (result.ProfitCenterBusinessUnitName) {\n      result.ProfitCenterBusinessUnitId = findIdByName(\n        buList,\n        'BusinessUnitName',\n        'BusinessUnitId',\n        result.ProfitCenterBusinessUnitName\n      );\n    } else {\n      result.ProfitCenterBusinessUnitId = result.ProfitCenterBusinessUnitId || null;\n    }\n  }\n\n  if (!result.ItemDefinitionOrganizationId) {\n    if (result.ItemDefinitionOrganizationName) {\n      result.ItemDefinitionOrganizationId = findIdByName(\n        buList,\n        'BusinessUnitName',\n        'BusinessUnitId',\n        result.ItemDefinitionOrganizationName\n      );\n    } else {\n      result.ItemDefinitionOrganizationId = result.ItemDefinitionOrganizationId || null;\n    }\n  }\n\n  if (!result.LegalEntityId) {\n    if (result.LegalEntityName) {\n      result.LegalEntityId = findIdByName(legalEntityList, 'Name', 'LegalEntityId', result.LegalEntityName);\n    } else {\n      result.LegalEntityId = result.LegalEntityId || null;\n    }\n  }\n\n  if (!result.LocationId) {\n    if (result.LocationCode) {\n      result.LocationId = findIdByName(locationList, 'LocationCode', 'LocationId', result.LocationCode);\n    }\n\n    if (!result.LocationId && result.LocationName) {\n      result.LocationId = findIdByName(locationList, 'LocationName', 'LocationId', result.LocationName);\n    }\n\n    if (!result.LocationId) {\n      result.LocationId = result.LocationId || null;\n    }\n  }\n\n  if (!result.invOrgParameters[0].ScheduleId) {\n    if (result.invOrgParameters[0].ScheduleName) {\n      result.invOrgParameters[0].ScheduleId = findIdByName(scheduleList, 'Name', 'ScheduleId', result.invOrgParameters[0].ScheduleName);\n    } else {\n      result.invOrgParameters[0].ScheduleId = result.invOrgParameters[0].ScheduleId || null;\n    }\n  }\n\n  if (Array.isArray(result.invOrgParameters)) {\n    result.invOrgParameters = result.invOrgParameters.map(function (item) {\n      if (!item || typeof item !== 'object') {\n        return item;\n      }\n\n      const nextItem = { ...item };\n      delete nextItem.ScheduleName;\n      return stripAttributes(nextItem, nonUpdatableAttributes.invOrgParameters);\n    });\n  }\n\n  stripAttributes(result, nonUpdatableAttributes.inventoryOrganizations);\n\n} catch (error) {\n  result = {};\n}\n\nreturn result;",
                    "returnType": "object"
                  },
