        {
          "metadata": {
            "name": "Detect Plant Parameters File",
            "returnType": "object",
            "sourceCode": "let result = {\n  isPlantParametersFile: false\n};\n\ntry {\n  const items = $context.$nodes?.CONVERT?.$output?.result?.items || [];\n\n  const updatablePlantFields = new Set([\n    'ManufacturingCalendarId',\n    'DefaultSupplySubinventory',\n    'DefaultSupplyLocator',\n    'DefaultCompletionSubinventory',\n    'DefaultCompletionLocator',\n    'StartingOperationSequence',\n    'OperationSequenceIncrement',\n    'PhantomOperationInherit',\n    'WorkOrderPrefix',\n    'WorkOrderStartingNumber',\n    'DefaultOvercompletionTolerance',\n    'DefaultTransactionMode',\n    'DefaultTransactionQuantity',\n    'QuantityChangeBackflush',\n    'DefaultWorkOrderTravelerTemplate',\n    'DefaultLabelTemplate',\n    'IncludeComponentYieldFlag',\n    'AutoAssociateSerialNumberWorkOrderImportFlag',\n    'BackflushLotSelection',\n    'StartStopCaptureLevel',\n    'PurchaseRequisitionCreationTime',\n    'MaterialReportingLevel',\n    'ForecastHorizon',\n    'GenerateWorkOrdersHorizon',\n    'DefaultPickSlipGroupingRule',\n    'PrintPickSlipsFlag',\n    'IncludePullComponentsFlag',\n    'IssuePushComponentsFlag',\n    'PrintLabelExternallyFlag',\n    'AllowDirectPurchasesForWorkOrdersFlag',\n    'EnableProcessManufacturingFlag',\n    'DefaultWorkMethod',\n    'ManufacturingCalendarName',\n    'EnableIotFlag',\n    'ManuallyIssueAssemblyToReworkWorkOrderFlag',\n    'AllowNegativeIssueWithoutSerialNumberEntryFlag',\n    'AllowReservationsOnWorkOrdersFlag',\n    'MaximumSchedulingDurationInMonths',\n    'DefaultLotNumberBehavior',\n    'RestrictLotsDuringReturnsFlag',\n    'DefaultUndercompletionTolerance',\n    'InspectionPlanType',\n    'DefaultIncludeInPlanningForBulkSupplyTypeFlag',\n    'DefaultIncludeInPlanningForSupplierSupplyTypeFlag',\n    'EnableRoboticsFlag',\n    'DefaultMaterialReviewBoardSubinventory',\n    'DefaultMaterialReviewBoardLocator',\n    'IncludeOperationYieldFlag',\n    'HCMSchedulerEnabledFlag',\n    'IncludeOperationYieldForProcessFlag',\n    'ProcessWorkOrderOperationCompletionFlag',\n    'ProcessWithEnhancedBatchQuantityFlag',\n    'AllowRepeatingIngredientsFlag',\n    'ManuallyCompleteWorkOrdersFlag',\n    'PreventIssueOfExpiredLotsFlag',\n    'AllowOperationCompletionBeforeInspectionFlag',\n    'DefaultManufacturingScrapSubinventory',\n    'DefaultManufacturingScrapLocator',\n    'AllowMultipleConsumptionOfMaterialFlag',\n    'SplitWorkOrdersForExecutionRunsFlag',\n    'DefaultLotFromMaterialReservationForMaterialIssueFlag',\n    'EnableAdvancedSchedulingAndAssignmentsFlag',\n    'UseProcessManufacturingTermsFlag',\n    'AllowAutoDetailReservationsForWorkOrdersFlag',\n    'AllowDispensingFlag',\n    'DispensingPrefix',\n    'DispensingStartNumber',\n    'DispensingDocumentSequenceId',\n    'DispensingDocumentSequenceCatalogCode',\n    'UseReferenceDesignatorsFlag'\n  ]);\n\n  const allowedRootFields = new Set([\n    'OrganizationId'\n  ]);\n\n  let hasPlantField = false;\n  let invalidFieldFound = false;\n\n  if (Array.isArray(items) && items.length > 0) {\n    for (let i = 0; i < items.length; i++) {\n      const currentItem = items[i];\n      if (!currentItem || typeof currentItem !== 'object') {\n        continue;\n      }\n\n      const keys = Object.keys(currentItem);\n      for (let j = 0; j < keys.length; j++) {\n        const currentKey = keys[j];\n        if (allowedRootFields.has(currentKey)) {\n          continue;\n        }\n\n        if (updatablePlantFields.has(currentKey)) {\n          hasPlantField = true;\n          continue;\n        }\n\n        invalidFieldFound = true;\n        break;\n      }\n\n      if (invalidFieldFound) {\n        break;\n      }\n    }\n  }\n\n  result.isPlantParametersFile = Array.isArray(items) && items.length > 0 && hasPlantField && !invalidFieldFound;\n} catch (error) {\n  result.isPlantParametersFile = false;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776444000014"
          },
          "code": "DETECT_PLANT_PARAMETERS_FILE",
          "id": "1776444000013",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
