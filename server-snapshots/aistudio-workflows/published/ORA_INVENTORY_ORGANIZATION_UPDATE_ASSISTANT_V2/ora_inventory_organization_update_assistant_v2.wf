          "code": "COPY_INV_ORG",
          "id": "1773670467054",
          "inputs": [
            {
              "id": "1773670467054_newOrganizationCode",
              "name": "newOrganizationCode",
              "type": "string",
              "value": "{{$context.$variables.invOrgPayload.CreateCopyOrganization.NewOrganizationCode!=null?$context.$variables.invOrgPayload.CreateCopyOrganization.NewOrganizationCode:$context.$variables.invOrgPayload.CreateCopyOrganization.NewOrganizationName}}"
            },
            {
              "id": "1773670467054_newOrganizationLocationCode",
