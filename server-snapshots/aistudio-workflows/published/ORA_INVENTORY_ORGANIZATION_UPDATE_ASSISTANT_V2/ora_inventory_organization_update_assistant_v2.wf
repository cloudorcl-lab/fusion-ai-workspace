          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "ValidateFileRowLimit",
            "returnType": "object",
            "sourceCode": "let result = {\n  rowCount: 0,\n  maxAllowedRows: 50,\n  rowLimitExceeded: false,\n  message: ''\n};\n\ntry {\n  const items = $context.$nodes?.CONVERT?.$output?.result?.items;\n  const rowCount = Array.isArray(items) ? items.length : 0;\n  const maxAllowedRows = 50;\n  const rowLimitExceeded = rowCount > maxAllowedRows;\n\n  result = {\n    rowCount,\n    maxAllowedRows,\n    rowLimitExceeded,\n    message: rowLimitExceeded\n      ? `File-based inventory organization and plant parameter creation supports a maximum of ${maxAllowedRows} data rows per file. The uploaded file contains ${rowCount} data rows.`\n      : ''\n  };\n} catch (error) {\n  result = {\n    rowCount: 0,\n    maxAllowedRows: 50,\n    rowLimitExceeded: false,\n    message: ''\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776446000007"
          },
          "code": "VALIDATE_FILE_ROW_LIMIT",
          "id": "1776446000006",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
