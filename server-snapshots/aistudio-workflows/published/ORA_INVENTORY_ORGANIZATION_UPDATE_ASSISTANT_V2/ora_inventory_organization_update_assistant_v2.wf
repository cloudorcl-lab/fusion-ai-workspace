            "sourceCode": "var result = {\n  overallStatus: 'FAIL',\n  missingGroups: [],\n  groupResults: []\n};\n\nfunction hasValue(value) {\n  return value !== undefined && value !== null && String(value).trim() !== '';\n}\n\nfunction getPayloadRoot() {\n  var workflowPayload = {};\n\n  if ($context && $context.$variables && $context.$variables.invOrgPayload) {\n    workflowPayload = $context.$variables.invOrgPayload;\n  }\n\n  if (\n    workflowPayload &&\n    typeof workflowPayload === 'object' &&\n    workflowPayload.CreateInventoryOrganization &&\n    typeof workflowPayload.CreateInventoryOrganization === 'object'\n  ) {\n    return workflowPayload.CreateInventoryOrganization;\n  }\n\n  if (workflowPayload && typeof workflowPayload === 'object') {\n    return workflowPayload;\n  }\n\n  return {};\n}\n\ntry {\n  var root = getPayloadRoot();\n  var groups = [\n    {\n      groupName: 'New Organization',\n      fields: ['NewOrganizationCode', 'NewOrganizationName']\n    },\n    {\n      groupName: 'Master Organization',\n      fields: ['MasterOrganizationId', 'MasterOrganizationCode', 'MasterOrganizationName']\n    },\n    {\n      groupName: 'Location',\n      fields: ['LocationId', 'LocationCode', 'LocationName']\n    },\n    {\n      groupName: 'Legal Entity',\n      fields: ['LegalEntityId', 'LegalEntityName']\n    },\n    {\n      groupName: 'Management Business Unit',\n      fields: ['ManagementBusinessUnitId', 'ManagementBusinessUnitName', 'ManagementBusinessUnitCode']\n    },\n    {\n      groupName: 'Profit Center Business Unit',\n      fields: ['ProfitCenterBusinessUnitId', 'ProfitCenterBusinessUnitName', 'ProfitCenterBusinessUnitCode']\n    },\n    {\n      groupName: 'Schedule',\n      fields: ['ScheduleId', 'ScheduleName']\n    }\n  ];\n\n  var groupResults = [];\n  var missingGroups = [];\n  var i;\n  var j;\n\n  for (i = 0; i < groups.length; i++) {\n    var group = groups[i];\n    var populatedFields = [];\n    var fieldValues = {};\n\n    for (j = 0; j < group.fields.length; j++) {\n      var fieldName = group.fields[j];\n      var fieldValue = root[fieldName];\n\n      fieldValues[fieldName] = fieldValue === undefined ? null : fieldValue;\n\n      if (hasValue(fieldValue)) {\n        populatedFields.push(fieldName);\n      }\n    }\n\n    if (populatedFields.length === 0) {\n      missingGroups.push(group.groupName);\n    }\n\n    groupResults.push({\n      groupName: group.groupName,\n      status: populatedFields.length > 0 ? 'PASS' : 'FAIL',\n      fields: group.fields,\n      populatedFields: populatedFields,\n      fieldValues: fieldValues\n    });\n  }\n\n  result = {\n    overallStatus: missingGroups.length === 0 ? 'PASS' : 'FAIL',\n    missingGroups: missingGroups,\n    groupResults: groupResults\n  };\n} catch (error) {\n  result = {\n    overallStatus: 'FAIL',\n    missingGroups: [],\n    groupResults: [],\n    errorMessage: error && error.message ? error.message : 'Failed to evaluate required attribute groups.'\n  };\n}\n\nreturn result;"
