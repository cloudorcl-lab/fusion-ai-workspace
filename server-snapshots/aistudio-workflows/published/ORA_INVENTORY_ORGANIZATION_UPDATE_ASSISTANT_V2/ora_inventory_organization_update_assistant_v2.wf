     },\n        \"required\": [\n          \"LocationId\",\n          \"EffectiveStartDate\",\n          \"EffectiveEndDate\",\n          \"LocationCode\",\n          \"LocationName\",\n          \"ActiveStatus\",\n          \"CountryCode\",\n          \"CountryName\",\n          \"Region1\",\n          \"Region2\",\n          \"TownOrCity\",\n          \"PostalCode\",\n          \"SetId\",\n          \"SetCode\",\n          \"SetName\",\n          \"InventoryOrganizationId\",\n          \"SingleLineAddress\",\n          \"InventoryOrganizationName\",\n          \"TimezoneCode\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ]\n}",
