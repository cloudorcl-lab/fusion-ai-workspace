                {
                  "metadata": {
                    "name": "Capture Bulk Create Inventory Org Result",
                    "sourceCode": "let result = {\n  OrganizationCode: 'Unknown Code',\n  OrganizationName: 'Unknown Name',\n  Status: 'PASSED',\n  FailureReason: ''\n};\n\nfunction hasValue(value) {\n  return value !== undefined && value !== null && String(value).trim() !== '';\n}\n\nfunction normalizeDisplayValue(value, fallbackValue) {\n  return hasValue(value) ? String(value).trim() : fallbackValue;\n}\n\nfunction pushUnique(target, value) {\n  if (!hasValue(value)) {\n    return;\n  }\n\n  const normalized = String(value).trim();\n  if (target.indexOf(normalized) === -1) {\n    target.push(normalized);\n  }\n}\n\nfunction tryParseJsonText(value) {\n  if (!hasValue(value) || typeof value !== 'string') {\n    return null;\n  }\n\n  const text = value.trim();\n  const candidates = [text];\n  const marker = 'failed with error:';\n  const markerIndex = text.toLowerCase().indexOf(marker);\n  if (markerIndex >= 0) {\n    candidates.push(text.substring(markerIndex + marker.length).trim());\n  }\n\n  const firstBrace = text.indexOf('{');\n  const lastBrace = text.lastIndexOf('}');\n  if (firstBrace >= 0 && lastBrace > firstBrace) {\n    candidates.push(text.substring(firstBrace, lastBrace + 1).trim());\n  }\n\n  for (let i = 0; i < candidates.length; i++) {\n    const candidate = candidates[i];\n    if (!candidate) {\n      continue;\n    }\n\n    try {\n      return JSON.parse(candidate);\n    } catch (error) {\n    }\n  }\n\n  return null;\n}\n\nfunction looksLikeOracleErrorObject(value) {\n  if (!value || typeof value !== 'object') {\n    return false;\n  }\n\n  if (Array.isArray(value['o:errorDetails']) && value['o:errorDetails'].length > 0) {\n    return true;\n  }\n\n  const title = hasValue(value.title) ? String(value.title).toUpperCase() : '';\n  const statusText = hasValue(value.status) ? String(value.status).trim() : '';\n\n  if (title.indexOf('BAD REQUEST') >= 0) {\n    return true;\n  }\n\n  if (/^\\d+$/.test(statusText) && Number(statusText) >= 400) {\n    return true;\n  }\n\n  return false;\n}\n\nfunction extractPayloadObjects(value, results, visited, depth) {\n  if (depth > 8 || value === undefined || value === null) {\n    return;\n  }\n\n  if (typeof value === 'string') {\n    const parsed = tryParseJsonText(value);\n    if (parsed) {\n      extractPayloadObjects(parsed, results, visited, depth + 1);\n    }\n    return;\n  }\n\n  if (typeof value !== 'object') {\n    return;\n  }\n\n  if (visited.indexOf(value) >= 0) {\n    return;\n  }\n  visited.push(value);\n\n  if (Array.isArray(value)) {\n    for (let i = 0; i < value.length; i++) {\n      extractPayloadObjects(value[i], results, visited, depth + 1);\n    }\n    return;\n  }\n\n  if (looksLikeOracleErrorObject(value) || hasValue(value.detail) || hasValue(value.message) || hasValue(value.error)) {\n    results.push(value);\n  }\n\n  const keys = Object.keys(value);\n  for (let i = 0; i < keys.length; i++) {\n    extractPayloadObjects(value[keys[i]], results, visited, depth + 1);\n  }\n}\n\nfunction getCandidatePayloads() {\n  const rawCandidates = [\n    $context?.$nodes?.BULK_CREATE_INVENTORY_ORG?.$output,\n    $context?.$nodes?.BULK_CREATE_INVENTORY_ORG?.$error\n  ];\n\n  const payloads = [];\n  const visited = [];\n  for (let i = 0; i < rawCandidates.length; i++) {\n    extractPayloadObjects(rawCandidates[i], payloads, visited, 0);\n  }\n\n  return payloads;\n}\n\nfunction getErrorDetails(payloads) {\n  const details = [];\n\n  for (let i = 0; i < payloads.length; i++) {\n    const payload = payloads[i];\n    if (!payload || typeof payload !== 'object') {\n      continue;\n    }\n\n    if (Array.isArray(payload['o:errorDetails'])) {\n      for (let j = 0; j < payload['o:errorDetails'].length; j++) {\n        const detailItem = payload['o:errorDetails'][j];\n        if (detailItem && typeof detailItem === 'object') {\n          pushUnique(details, detailItem.detail);\n        }\n      }\n    }\n\n    pushUnique(details, payload.detail);\n    pushUnique(details, payload.message);\n    pushUnique(details, payload.error);\n  }\n\n  return details;\n}\n\nfunction hasExplicitFailure(payloads) {\n  for (let i = 0; i < payloads.length; i++) {\n    const payload = payloads[i];\n    if (!payload || typeof payload !== 'object') {\n      continue;\n    }\n\n    if (looksLikeOracleErrorObject(payload)) {\n      return true;\n    }\n\n    if (hasValue(payload.error) || hasValue(payload.detail) || hasValue(payload.message)) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction getFailureReason(payloads) {\n  const details = getErrorDetails(payloads);\n  if (details.length > 0) {\n    return details.join(' | ');\n  }\n\n  for (let i = 0; i < payloads.length; i++) {\n    const payload = payloads[i];\n    if (!payload || typeof payload !== 'object') {\n      continue;\n    }\n\n    if (hasValue(payload.title) && hasValue(payload.status)) {\n      return String(payload.title).trim() + ' (' + String(payload.status).trim() + ')';\n    }\n\n    if (hasValue(payload.title)) {\n      return String(payload.title).trim();\n    }\n  }\n\n  return '';\n}\n\ntry {\n  const currentRecord = $context?.$nodes?.GETIDSFORCREATE?.$output?.result || $context?.$nodes?.FOR_EACH_ENTRY?.$currentItem || {};\n  const candidatePayloads = getCandidatePayloads();\n  const failureReason = getFailureReason(candidatePayloads);\n\n  result.OrganizationCode = normalizeDisplayValue(currentRecord.OrganizationCode, 'Unknown Code');\n  result.OrganizationName = normalizeDisplayValue(currentRecord.OrganizationName, 'Unknown Name');\n\n  if (hasExplicitFailure(candidatePayloads)) {\n    result.Status = 'FAILED';\n    result.FailureReason = normalizeDisplayValue(failureReason, 'No failure reason returned.');\n  } else if (!($context?.$nodes?.BULK_CREATE_INVENTORY_ORG?.$output)) {\n    result.Status = 'FAILED';\n    result.FailureReason = 'No success output returned from Bulk Create Inventory Org.';\n  }\n} catch (error) {\n  result.Status = 'FAILED';\n  result.FailureReason = error && error.message ? error.message : 'Failed to capture creation result.';\n}\n\nreturn result;",
                    "returnType": "object"
                  },
