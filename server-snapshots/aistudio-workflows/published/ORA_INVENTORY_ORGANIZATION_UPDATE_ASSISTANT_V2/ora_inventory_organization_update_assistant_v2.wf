        {
          "metadata": {
            "name": "Create Payload",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const convertPayload = $context.$nodes?.CONVERT?.$output?.result || {};\n  const invOrgPayload = $context.$variables.invOrgPayload || {};\n\n  function isObject(value) {\n    return value && typeof value === 'object' && !Array.isArray(value);\n  }\n\n  function hasKeys(value) {\n    return isObject(value) && Object.keys(value).length > 0;\n  }\n\n  function cloneValue(value) {\n    return JSON.parse(JSON.stringify(value));\n  }\n\n  function hasValue(value) {\n    return value !== undefined && value !== null && String(value).trim() !== '';\n  }\n\n  function normalizeFlagValue(keyName, value) {\n    if (!hasValue(value) || !/flag/i.test(String(keyName))) {\n      return value;\n    }\n\n    const normalizedValue = String(value).trim().toUpperCase();\n    if (normalizedValue === 'TRUE') {\n      return true;\n    }\n    if (normalizedValue === 'FALSE') {\n      return false;\n    }\n\n    return value;\n  }\n\n  function pruneEmpty(value) {\n    if (Array.isArray(value)) {\n      const nextArray = value\n        .map(pruneEmpty)\n        .filter(function (item) { return item !== undefined; });\n      return nextArray.length ? nextArray : undefined;\n    }\n\n    if (value && typeof value === 'object') {\n      const nextObject = {};\n      const keys = Object.keys(value);\n      for (let i = 0; i < keys.length; i++) {\n        const key = keys[i];\n        const nextValue = pruneEmpty(value[key]);\n        if (nextValue !== undefined) {\n          nextObject[key] = nextValue;\n        }\n      }\n      return Object.keys(nextObject).length ? nextObject : undefined;\n    }\n\n    if (value === '' || value === null) {\n      return undefined;\n    }\n\n    return value;\n  }\n\n  function ensureObjectArray(value) {\n    if (Array.isArray(value) && value.length > 0 && isObject(value[0])) {\n      return value;\n    }\n    return [{}];\n  }\n\n  function mergeTemplateArray(targetArray, sourceArray) {\n    if (!Array.isArray(targetArray) || !Array.isArray(sourceArray)) {\n      return;\n    }\n\n    for (let i = 0; i < sourceArray.length; i++) {\n      const sourceItem = sourceArray[i];\n      if (!isObject(sourceItem)) {\n        continue;\n      }\n\n      if (!isObject(targetArray[i])) {\n        targetArray[i] = {};\n      }\n\n      const sourceKeys = Object.keys(sourceItem);\n      for (let j = 0; j < sourceKeys.length; j++) {\n        const sourceKey = sourceKeys[j];\n        const sourceValue = sourceItem[sourceKey];\n\n        if (isObject(sourceValue)) {\n          if (!isObject(targetArray[i][sourceKey])) {\n            targetArray[i][sourceKey] = {};\n          }\n          Object.assign(targetArray[i][sourceKey], cloneValue(sourceValue));\n          continue;\n        }\n\n        if (Array.isArray(sourceValue)) {\n          targetArray[i][sourceKey] = cloneValue(sourceValue);\n          continue;\n        }\n\n        targetArray[i][sourceKey] = normalizeFlagValue(sourceKey, sourceValue);\n      }\n    }\n  }\n\n  function normalizeSourceItem(source, defaultType) {\n    const normalized = isObject(source) ? cloneValue(source) : {};\n\n    if (!hasValue(normalized.OrganizationType)) {\n      normalized.OrganizationType = defaultType || 'Inventory';\n    }\n\n    if (!hasValue(normalized.OrganizationCode) && hasValue(normalized.NewOrganizationCode)) {\n      normalized.OrganizationCode = normalized.NewOrganizationCode;\n    }\n\n    if (!hasValue(normalized.OrganizationName) && hasValue(normalized.NewOrganizationName)) {\n      normalized.OrganizationName = normalized.NewOrganizationName;\n    }\n\n    const shouldSeedInvOrgParameters =\n      hasValue(normalized.ScheduleId) ||\n      hasValue(normalized.ScheduleName) ||\n      hasValue(normalized.ItemGroupingCode) ||\n      (Array.isArray(normalized.invOrgParameters) && normalized.invOrgParameters.length > 0);\n\n    if (shouldSeedInvOrgParameters) {\n      normalized.invOrgParameters = ensureObjectArray(normalized.invOrgParameters);\n\n      if (!hasValue(normalized.invOrgParameters[0].ScheduleId) && hasValue(normalized.ScheduleId)) {\n        normalized.invOrgParameters[0].ScheduleId = normalized.ScheduleId;\n      }\n\n      if (!hasValue(normalized.invOrgParameters[0].ScheduleName) && hasValue(normalized.ScheduleName)) {\n        normalized.invOrgParameters[0].ScheduleName = normalized.ScheduleName;\n      }\n\n      if (!hasValue(normalized.invOrgParameters[0].ItemGroupingCode) && hasValue(normalized.ItemGroupingCode)) {\n        normalized.invOrgParameters[0].ItemGroupingCode = normalized.ItemGroupingCode;\n      }\n    }\n\n    return normalized;\n  }\n\n  const template = {\n    OrganizationType: 'Inventory',\n    OrganizationCode: '',\n    OrganizationName: '',\n    ManagementBusinessUnitId: '',\n    ManagementBusinessUnitName: '',\n    ManagementBusinessUnitCode: '',\n    LegalEntityId: '',\n    LegalEntityName: '',\n    ProfitCenterBusinessUnitId: '',\n    ProfitCenterBusinessUnitName: '',\n    ProfitCenterBusinessUnitCode: '',\n    Status: '',\n    LocationId: '',\n    LocationCode: '',\n    LocationName: '',\n    InventoryFlag: '',\n    MasterOrganizationId: '',\n    MasterOrganizationCode: '',\n    MasterOrganizationName: '',\n    IntegratedSystemType: '',\n    ItemGroupingCode: '',\n    ItemDefinitionOrganizationId: '',\n    ItemDefinitionOrganizationCode: '',\n    ItemDefinitionOrganizationName: '',\n    ManufacturingParametersExistFlag: '',\n    ManufacturingPlantFlag: '',\n    ContractManufacturingFlag: '',\n    MaintenanceEnabledFlag: '',\n    MaintenanceTechnicianWorkbenchEnabledFlag: '',\n    FixedAssetCorporateBookTypeCode: '',\n    IntegratedSystemName: '',\n    ItemGroupingName: '',\n    invOrgParameters: [\n      {\n        ScheduleId: '',\n        DefaultPickingRuleId: '',\n        DefaultLocatorOrderValue: '',\n        DefaultSubinventoryOrderValue: '',\n        NegativeInvReceiptFlag: '',\n        StockLocatorControl: '',\n        SourceType: '',\n        SourceOrganizationId: '',\n        SourceOrganizationCode: '',\n        SourceOrganizationName: '',\n        SourceSubinventory: '',\n        SerialNumberType: '',\n        AutoSerialAlphaPrefix: '',\n        StartAutoSerialNumber: '',\n        AutoLotAlphaPrefix: '',\n        LotNumberUniqueness: '',\n        LotNumberGeneration: '',\n        LotNumberZeroPaddingFlag: '',\n        LotNumberLength: '',\n        StartingRevision: '',\n        PackingUnitPrefix: '',\n        PackingUnitSuffix: '',\n        PackingUnitStartingNumber: '',\n        PackingUnitTotalLength: '',\n        GS1128Flag: '',\n        SerialNumberGeneration: '',\n        PickConfirmationRequiredFlag: '',\n        OverpickTransferOrdersFlag: '',\n        DistributedOrganizationFlag: '',\n        AllowDifferentLotStatus: '',\n        ChildLotControlPrefix: '',\n        ChildLotControlTotalLength: '',\n        ChildLotControlFormatValidationFlag: '',\n        ChildLotControlZeroPaddingFlag: '',\n        CopyLotAttributeFlag: '',\n        AutomaticallyCreateLotUOMConversion: '',\n        ParentChildGeneration: '',\n        AutomaticallyDeleteAllocationsFlag: '',\n        EnforceLocatorAliasUniquenessFlag: '',\n        PreFillPickedQuantityFlag: '',\n        CapturePickingExceptionsFlag: '',\n        PickQuantityDefaultReasonId: '',\n        AllowNegativeOnhandTransactionsFlag: '',\n        UseOriginalReceiptDateFlag: '',\n        RoundReorderQuantityFlag: '',\n        PickSlipBatchSize: '',\n        ReplenishmentMovementRequestGrouping: '',\n        FillKillMoveOrderFlag: '',\n        SupplierId: '',\n        SupplierSiteId: '',\n        SystemSelectsSerialNumberFlag: '',\n        PurchasingByRevisionFlag: '',\n        FillKillTransferOrdersFlag: '',\n        ItemGroupingCode: '',\n        TrackByProjectFlag: '',\n        TrackByCountryOfOriginFlag: '',\n        InternalCustomerFlag: '',\n        InternalCustomerId: '',\n        InternalCustomerAccountNumber: '',\n        ScheduleName: '',\n        UseCurrentItemCostFlag: '',\n        OverpickForSpecialHandlingFlag: '',\n        AcceptSubstituteItemsFlag: '',\n        IntegrateWmsWithManufacturingAndMaintenanceFlag: '',\n        FillKillSalesOrderFlag: '',\n        KanbanCardPrefix: '',\n        KanbanCardStartNumber: '',\n        ExpiredLotQuarantineSubinventory: '',\n        ExpiredLotQuarantineLocator: '',\n        LotConversionEnabledFlag: '',\n        AutocreateLotUOMConversionFlag: '',\n        OverpickingForWorkOrdersFlag: ''\n      }\n    ]\n  };\n\n  const templateKeyLookup = {};\n  const templateKeys = Object.keys(template);\n  for (let i = 0; i < templateKeys.length; i++) {\n    templateKeyLookup[templateKeys[i]] = true;\n  }\n\n  const invOrgParameterTemplate =\n    Array.isArray(template.invOrgParameters) &&\n    template.invOrgParameters.length > 0 &&\n    isObject(template.invOrgParameters[0])\n      ? template.invOrgParameters[0]\n      : {};\n\n  const invOrgParameterKeyLookup = {};\n  const invOrgParameterKeys = Object.keys(invOrgParameterTemplate);\n  for (let i = 0; i < invOrgParameterKeys.length; i++) {\n    invOrgParameterKeyLookup[invOrgParameterKeys[i]] = true;\n  }\n\n  function applyValue(target, keyName, keyValue) {\n    if (!target || typeof target !== 'object') {\n      return 0;\n    }\n\n    const normalizedValue = normalizeFlagValue(keyName, keyValue);\n    let matchCount = 0;\n\n    if (Object.prototype.hasOwnProperty.call(templateKeyLookup, keyName)) {\n      target[keyName] = normalizedValue;\n      matchCount += 1;\n    }\n\n    if (\n      Object.prototype.hasOwnProperty.call(invOrgParameterKeyLookup, keyName) &&\n      Array.isArray(target.invOrgParameters) &&\n      target.invOrgParameters.length > 0\n    ) {\n      if (!isObject(target.invOrgParameters[0])) {\n        target.invOrgParameters[0] = {};\n      }\n      target.invOrgParameters[0][keyName] = normalizedValue;\n      matchCount += 1;\n    }\n\n    return matchCount;\n  }\n\n  let sourceItems = [];\n\n  if (Array.isArray(convertPayload.items) && convertPayload.items.length > 0) {\n    sourceItems = convertPayload.items.map(function (item) {\n      return normalizeSourceItem(item, item && item.OrganizationType ? item.OrganizationType : 'Inventory');\n    });\n  } else if (hasKeys(invOrgPayload.CreateInventoryOrganization)) {\n    sourceItems = [normalizeSourceItem(invOrgPayload.CreateInventoryOrganization, 'Inventory')];\n  } else if (hasKeys(invOrgPayload.CreateItemOrganization)) {\n    sourceItems = [normalizeSourceItem(invOrgPayload.CreateItemOrganization, 'Item')];\n  }\n\n  const mappedItems = sourceItems.map(function (item) {\n    const nextPayload = cloneValue(template);\n    const entries = item && typeof item === 'object' ? Object.entries(item) : [];\n\n    entries.forEach(function (entry) {\n      const keyName = entry[0];\n      if (keyName === 'invOrgParameters' || keyName === 'plantParameters') {\n        return;\n      }\n      applyValue(nextPayload, keyName, entry[1]);\n    });\n\n    mergeTemplateArray(nextPayload.invOrgParameters, item.invOrgParameters);\n\n    return pruneEmpty(nextPayload) || {};\n  });\n\n  result = {\n    items: mappedItems\n  };\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775390851845"
          },
          "code": "CREATE_PAYLOAD",
          "id": "1775561347230",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
