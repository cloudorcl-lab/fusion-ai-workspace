              "value": "{{$context.$triggers.REST.$input.promptCode == 'SR_Problem_Summarization' || $context.$triggers.REST.$input.promptCode == 'SR_Solution_Summarization' ? $context.$triggers.REST.$input.promptCode : \"default\"}}"
