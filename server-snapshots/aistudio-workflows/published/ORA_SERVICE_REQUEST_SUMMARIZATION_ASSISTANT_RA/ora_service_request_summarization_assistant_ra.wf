            "name": "truncateSummary",
            "returnType": "string",
            "sourceCode": "const summary =\n  $context.$nodes.SRSUMMARIZATION_SUMMARIZATION_MODEL?.$output ??\n  $context.$nodes.SRPROBLEMSUMMARIZATION_MODEL?.$output ??\n  $context.$nodes.SRSOLUTIONSUMMARIZATION_MODEL?.$output ??\n  $context.$nodes.SUMMARISE_CONTENT_ONLY?.$output ??\n  \"Not enough relevant conversational data available to generate a meaningful summary.\";\n\nconst maxLen = Number($context.$triggers.REST?.$input?.summaryLength) || 1000;\n\nreturn String(summary).slice(0, maxLen-1);"
          },
          "outcomes": {
            "success": "1772706828113"
          },
          "code": "TRUNCATESUMMARY",
          "id": "1772706317299",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
