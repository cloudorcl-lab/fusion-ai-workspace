        {
          "metadata": {
            "name": "Collect Contract Lines Defaults",
            "returnType": "object",
            "sourceCode": "let allContractLines = $context.$variables.prjPjeVarUqContractLines;\n\nlet lineTypeId = null;\nlet billPlanId = null;\nlet revenuePlanId = null;\n\nlet lineTypeConflict = false;\nlet billPlanConflict = false;\nlet revenuePlanConflict = false;\n\nconst conflictChecker = (id, value, conflictFlag) => {\n  if (id === null) {\n    id = value;\n  } else if (id !== value) {\n    conflictFlag = true;\n  }\n  return { id, conflictFlag };\n};\n\nfor (let key in allContractLines) {\n  if (allContractLines.hasOwnProperty(key)) {\n    let item = allContractLines[key];\n\n    ({ id: lineTypeId, conflictFlag: lineTypeConflict } = conflictChecker(lineTypeId, item.LineTypeId, lineTypeConflict));\n    ({ id: billPlanId, conflictFlag: billPlanConflict } = conflictChecker(billPlanId, item.BillPlanId, billPlanConflict));\n    ({ id: revenuePlanId, conflictFlag: revenuePlanConflict } = conflictChecker(revenuePlanId, item.RevenuePlanId, revenuePlanConflict));\n  }\n}\n\nif (lineTypeConflict) lineTypeId = -1;\nif (billPlanConflict) billPlanId = -1;\nif (revenuePlanConflict) revenuePlanId = -1;\n\nconst result = {};\n\nresult.lineTypeId = lineTypeId;\nresult.billPlanId = billPlanId;\nresult.revenuePlanId = revenuePlanId;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772199094555"
          },
