        {
          "metadata": {
            "name": "Capture Implementation Status",
            "returnType": "object",
            "sourceCode": "let implementationStatus = {};\n\nlet policyOptions = $context.$variables.prjPjeVarUqPolicyOptions;\n\n// Normalize implementation status: Implemented/Completed => Completed\nconst normalizeImplementationStatus = (value) => {\n  const text = String(value || '').trim();\n  if (!text) {\n    return 'NA';\n  }\n\n  const normalized = text.toLowerCase();\n  if (normalized === 'implemented' || normalized === 'completed') {\n    return 'Completed';\n  }\n\n  return text;\n};\n\nimplementationStatus.ImplementProjectPlanPolicy = policyOptions.ImplementProjectPlan;\nimplementationStatus.ImplementProjectPlanStatus = 'NA';\nimplementationStatus.ImplementBudgetsPolicy = policyOptions.ImplementBudget;\nimplementationStatus.ImplementBudgetStatus = 'NA';\nimplementationStatus.ImplementBudgetsStatus = 'NA';\nimplementationStatus.BaselineProjectPlanPolicy = policyOptions.BaselineProjectPlan;\nimplementationStatus.BaselineProjectPlanStatus = 'NA';\nimplementationStatus.Status = 'NA';\n\n\n// Update Implementation Details\nif(policyOptions.ImplementProjectPlan && $context.$variables.prjPjeVarUqHasProjectPlanImpacts){\n    implementationStatus.ImplementProjectPlanPolicy = true;\n    implementationStatus.ImplementBudgetsPolicy = false;\n\n    const normalizedProjPlanStatus = normalizeImplementationStatus($context.$variables.prjPjeVarUqProjPlanImplementationStatus);\n    implementationStatus.ImplementProjectPlanStatus = normalizedProjPlanStatus;\n    implementationStatus.Status = normalizedProjPlanStatus;\n\n    if(policyOptions.BaselineProjectPlan){\n       implementationStatus.BaselineProjectPlanPolicy = true;\n       implementationStatus.BaselineProjectPlanStatus = $context.$variables.prjPjeVarUqProjPlanBaselineStatus;\n    }\n}else if(policyOptions.ImplementBudget && $context.$variables.prjPjeVarUqHasBudgetImpacts){\n    implementationStatus.ImplementBudgetsPolicy = true;\n    implementationStatus.ImplementProjectPlanPolicy = false;\n\n    const normalizedBudgetStatus = normalizeImplementationStatus($context.$variables.prjPjeVarUqBudgetsImplementationStatus);\n    implementationStatus.ImplementBudgetStatus = normalizedBudgetStatus;\n    implementationStatus.ImplementBudgetsStatus = normalizedBudgetStatus;\n    implementationStatus.Status = normalizedBudgetStatus;\n};\n\n\nreturn implementationStatus;"
          },
