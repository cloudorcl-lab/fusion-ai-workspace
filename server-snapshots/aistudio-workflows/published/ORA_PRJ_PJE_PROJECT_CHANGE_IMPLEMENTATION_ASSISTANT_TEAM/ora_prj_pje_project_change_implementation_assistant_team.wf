        {
          "metadata": {
            "name": "Build User Message for Invalid Contract Status",
            "returnType": "object",
            "sourceCode": "var v = $context.$variables || {};\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return {};\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return {};\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction htmlEscape(value) {\n  return normalizeString(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction isTrueValue(value) {\n  if (value === true) {\n    return true;\n  }\n  var text = normalizeString(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === 'completed';\n}\n\nfunction isCompletedStatus(value) {\n  return normalizeString(value).toLowerCase() === 'completed';\n}\n\nfunction statusOrNA(value) {\n  return normalizeString(value) || 'NA';\n}\n\nfunction captureContractOutput() {\n  try {\n    return (($context.$nodes.PRJ_PJE_CODE_CAPTURE_CONTRACT || {}).$output || {}).result || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction buildImplementationMessages(status) {\n  var messages = [];\n  var projectPlanPolicy = status.ImplementProjectPlanPolicy;\n  var projectPlanStatus = status.ImplementProjectPlanStatus;\n  var baselinePolicy = status.BaselineProjectPlanPolicy;\n  var baselineStatus = status.BaselineProjectPlanStatus;\n  var budgetPolicy = status.ImplementBudgetsPolicy;\n  var budgetStatus = firstNonEmpty([status.ImplementBudgetsStatus, status.ImplementBudgetStatus]);\n\n  if (isTrueValue(projectPlanPolicy) && isCompletedStatus(projectPlanStatus)) {\n    var projectPlanMessage = 'Project plan changes have been implemented successfully.';\n    if (isTrueValue(baselinePolicy) && isTrueValue(baselineStatus)) {\n      projectPlanMessage = 'Project plan changes have been implemented successfully and the project plan has been baselined.';\n    }\n    messages.push(projectPlanMessage);\n  }\n\n  if (isTrueValue(budgetPolicy) && isCompletedStatus(budgetStatus)) {\n    messages.push('Budget and Forecast changes have been implemented.');\n  }\n\n  if (!messages.length) {\n    if (isTrueValue(projectPlanPolicy)) {\n      messages.push('Project plan changes implementation status: ' + statusOrNA(projectPlanStatus) + '.');\n    } else if (isTrueValue(budgetPolicy)) {\n      messages.push('Budget and Forecast changes implementation status: ' + statusOrNA(budgetStatus) + '.');\n    } else {\n      messages.push('Change order implementation status: ' + statusOrNA(status.Status) + '.');\n    }\n  }\n\n  return messages;\n}\n\nfunction buildLegacyHtml(implementationMessages, contractErrorMessage) {\n  var html = '<div class=\"bubble\">';\n  html += '<div><strong>Here is the summary of the implemented changes</strong></div>';\n  html += '<br>';\n  for (var i = 0; i < implementationMessages.length; i++) {\n    html += '<div class=\"caption\"> • ' + htmlEscape(implementationMessages[i]) + '</div><br>';\n  }\n  html += '<div class=\"caption\"> • ' + htmlEscape(contractErrorMessage) + '. Not proceeding with Contract Changes. </div><br>';\n  html += '<br>';\n  html += '</div>';\n  return html;\n}\n\nvar processedStatus = parseMaybe(v.prjPjeVarUqChangeOrderProcessedStatus);\nvar contractOutput = captureContractOutput();\nvar contractErrorMessage = normalizeString(contractOutput.message);\nvar implementationMessages = buildImplementationMessages(processedStatus);\nvar closingMessage = contractErrorMessage\n  ? contractErrorMessage + '. Not proceeding with Contract Changes.'\n  : '. Not proceeding with Contract Changes.';\nvar messages = ['Here is the summary of the implemented changes'];\nfor (var i = 0; i < implementationMessages.length; i++) {\n  messages.push(implementationMessages[i]);\n}\nmessages.push(closingMessage);\n\nreturn {\n  kind: 'invalidContractStatus',\n  intent: 'IMPLEMENT_CHANGE_ORDER',\n  title: 'Contract changes not processed',\n  description: closingMessage,\n  message: closingMessage,\n  implementationMessages: implementationMessages,\n  contractErrorMessage: contractErrorMessage,\n  messages: messages,\n  legacyHtmlKey: 'invalidContractStatus',\n  legacyHtml: buildLegacyHtml(implementationMessages, contractErrorMessage)\n};"
          },
          "outcomes": {
            "success": "1783000000303"
          },
          "code": "PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_INVALID_CONTRACT_STATUS",
