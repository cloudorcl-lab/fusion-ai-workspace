            "y": 15082
          }
        },
        {
          "metadata": {
            "name": "Build User Message for No Revenue Impact",
            "returnType": "object",
            "sourceCode": "function variable(name) {\n  try {\n    return $context.$variables ? $context.$variables[name] : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction normalizeString(value) {\n  return asString(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return {};\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return {};\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction htmlEscape(value) {\n  return normalizeString(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction isTrueValue(value) {\n  if (value === true) {\n    return true;\n  }\n  var text = normalizeString(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === 'completed';\n}\n\nfunction isCompletedStatus(value) {\n  return normalizeString(value).toLowerCase() === 'completed';\n}\n\nfunction statusOrNA(value) {\n  return normalizeString(value) || 'NA';\n}\n\nfunction caption(message) {\n  return '<div class=\"caption\"> ' + htmlEscape(message) + '</div><br>';\n}\n\nvar status = parseMaybe(variable('prjPjeVarUqChangeOrderProcessedStatus'));\nvar implementationMessages = [];\n\nvar projectPlanStatus = firstNonEmpty([\n  status.ImplementProjectPlanStatus,\n  variable('prjPjeVarUqProjPlanImplementationStatus')\n]);\nvar baselineStatus = firstNonEmpty([\n  status.BaselineProjectPlanStatus,\n  variable('prjPjeVarUqProjPlanBaselineStatus')\n]);\nvar budgetStatus = firstNonEmpty([\n  status.ImplementBudgetsStatus,\n  status.ImplementBudgetStatus,\n  variable('prjPjeVarUqBudgetsImplementationStatus')\n]);\nvar changeOrderStatus = firstNonEmpty([\n  status.Status,\n  variable('prjPjeVarUqChangeOrderProcessedStatus'),\n  variable('prjPjeVarUqChangeOrderStatus')\n]);\n\nif (isTrueValue(status.ImplementProjectPlanPolicy) && isCompletedStatus(projectPlanStatus)) {\n  var projectPlanMessage = 'Project plan changes have been implemented successfully.';\n  if (isTrueValue(status.BaselineProjectPlanPolicy) && isTrueValue(baselineStatus)) {\n    projectPlanMessage = 'Project plan changes have been implemented successfully and the project plan has been baselined.';\n  }\n  implementationMessages.push(projectPlanMessage);\n}\n\nif (isTrueValue(status.ImplementBudgetsPolicy) && isCompletedStatus(budgetStatus)) {\n  implementationMessages.push('Budget and Forecast changes have been implemented.');\n}\n\nif (!implementationMessages.length) {\n  if (isTrueValue(status.ImplementProjectPlanPolicy)) {\n    implementationMessages.push('Project plan changes implementation status: ' + statusOrNA(projectPlanStatus) + '.');\n  } else if (isTrueValue(status.ImplementBudgetsPolicy)) {\n    implementationMessages.push('Budget and Forecast changes implementation status: ' + statusOrNA(budgetStatus) + '.');\n  } else {\n    implementationMessages.push('Change order implementation status: ' + statusOrNA(changeOrderStatus) + '.');\n  }\n}\n\nvar headerMessage = 'Here is the summary of the implemented changes';\nvar contractMessage = 'Contract updates are not needed since there is no revenue impact.';\nvar messages = [headerMessage];\nfor (var i = 0; i < implementationMessages.length; i++) {\n  messages.push(implementationMessages[i]);\n}\nmessages.push(contractMessage);\n\nvar htmlParts = [\n  '<div class=\"bubble\">',\n  '<div><strong>' + headerMessage + '</strong></div>',\n  '<br>'\n];\nfor (var j = 0; j < implementationMessages.length; j++) {\n  htmlParts.push(caption('• ' + implementationMessages[j]));\n}\nhtmlParts.push(caption('• ' + contractMessage));\nhtmlParts.push('<br>');\nhtmlParts.push('</div>');\n\nreturn {\n  kind: 'noRevenueImpact',\n  intent: 'IMPLEMENT_CHANGE_ORDER',\n  title: 'Contract updates not needed',\n  description: contractMessage,\n  message: contractMessage,\n  implementationMessages: implementationMessages,\n  contractMessage: contractMessage,\n  messages: messages,\n  legacyHtmlKey: 'noRevenueImpact',\n  legacyHtml: htmlParts.join('\\n')\n};"
          },
          "outcomes": {
            "success": "1783000000303"
          },
          "code": "PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_NO_REVENUE_IMPACT",
          "id": "1777000000003",
