                },
                {
                  "metadata": {
                    "name": "Sync Contract Line and Linkages Changes",
                    "returnType": "array",
                    "sourceCode": "let currentCLChange = $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.$currentItem || {};\nlet impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges || {};\nlet clChanges = impactDetailsChanges.ContractLineChanges || [];\nlet cllChanges = impactDetailsChanges.ContractLineLinkChanges || [];\n\nlet amendedOutput = $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.PRJ_PJE_BO_FUNCTION_FETCH_AMENDED_CONTRACT_LINES.$output || {};\nlet amendedItems = amendedOutput.items || [];\nlet amendedContractLineWrapper = amendedItems[0] && amendedItems[0].ContractLine;\nlet amendedContractLines = amendedContractLineWrapper && amendedContractLineWrapper.items ? amendedContractLineWrapper.items : [];\n\nlet aCL = null;\nfor (let line of amendedContractLines) {\n  if (String(line.Id) === String(currentCLChange.Id)) {\n    aCL = line;\n    break;\n  }\n}\nif (aCL == null && amendedContractLines.length === 1) {\n  aCL = amendedContractLines[0];\n}\n\nlet currentCLLineId = currentCLChange.LineId;\nlet aCLLs = [];\nif (aCL != null) {\n  currentCLLineId = aCL.LineId || currentCLLineId;\n  aCLLs = aCL.AssociatedProject && aCL.AssociatedProject.items ? aCL.AssociatedProject.items : [];\n\n  for (let uCLChange of clChanges) {\n    if (String(uCLChange.Id) === String(currentCLChange.Id)) {\n      uCLChange.OldLineId = uCLChange.LineId;\n      uCLChange.LineId = currentCLLineId;\n      break;\n    }\n  }\n\n  for (let uCLLChange of cllChanges) {\n    for (let aCLLChange of aCLLs) {\n      if (String(uCLLChange.LinkId) === String(aCLLChange.LinkId)) {\n        uCLLChange.OldKey = uCLLChange.Key;\n        uCLLChange.Key = aCLLChange[\"@context\"].key;\n      }\n    }\n  }\n}\n\nlet data = {};\ndata.amendedContractLines = amendedContractLines;\ndata.ImpactDetailsChanges = impactDetailsChanges;\ndata.currentCLLineId = currentCLLineId;\nreturn data;"
                  },
