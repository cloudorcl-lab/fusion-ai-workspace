            "returnType": "object",
            "sourceCode": "var v = $context.$variables || {};\nvar names = [\"prjPjeVarUqcontextProjectId\", \"prjPjeVarUqcontextValue\", \"prjPjeVarUqcontextType\", \"prjPjeVarUqProjectBusinessUnit\", \"prjPjeVarUqChangeOrderReason\", \"prjPjeVarUqChangeOrderName\", \"prjPjeVarUqIsProjectLinkageContract\", \"prjPjeVarUqChangeOrderProcessedStatus\", \"prjPjeVarUqChangeOrderNumber\", \"prjPjeVarUqProjPlanBaselineStatus\", \"prjPjeVarUqBudgetsImplementationStatus\", \"prjPjeVarUqProjPlanImplementationStatus\", \"prjPjeVarUqContractCurrencyCode\", \"prjPjeVarUqErrorMessage\", \"prjPjeVarUqanyNewContractLines\", \"prjPjeVarUqlineTypeId\", \"prjPjeVarUqbillPlanId\", \"prjPjeVarUqrevenuePlanId\", \"prjPjeVarUqContractNumber\", \"prjPjeVarUqAmendedImpactDetailsChanges\", \"prjPjeVarUqImpactDetailsSavedChanges\", \"prjPjeVarUqTempObject\", \"prjPjeVarUqAnyErrorInImpactDetailsChanges\", \"prjPjeVarUqImpactDetailsChanges\", \"prjPjeVarUqImpactDetails\", \"prjPjeVarUqContractLineLinkages\", \"prjPjeVarUqNewTasksData\", \"prjPjeVarUqloopVariable\", \"prjPjeVarUqTempImpactedTasksIds\", \"prjPjeVarUqTasksDetailsMap\", \"prjPjeVarUqisTaskDetailsRequired\", \"prjPjeVarUqImpactedTasks\", \"prjPjeVarUqImpacts\", \"prjPjeVarUqContractLines\", \"prjPjeVarUqNewContractLineAmount\", \"prjPjeVarUqContractLineAmount\", \"prjPjeVarUqContractAmendDate\", \"prjPjeVarUqContractUniqueId\", \"prjPjeVarUqTemp\", \"prjPjeVarUqParticipantEmail\", \"prjPjeVarUqPolicyOptions\", \"prjPjeVarUqParticipantStatus\", \"prjPjeVarUqChangeOrderStage\", \"prjPjeVarUqContractLineId\", \"prjPjeVarUqParticipantResourceId\", \"prjPjeVarUqParticipantId\", \"prjPjeVarUqHasBudgetImpacts\", \"prjPjeVarUqHasProjectPlanImpacts\", \"prjPjeVarUqAmendmentEffectiveDate\", \"prjPjeVarUqChangeOrderId\", \"prjPjeVarUqContractId\", \"prjPjeVarUqProjectId\"];\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return 0;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? 0 : value;\n  }\n  var parsed = Number(String(value).replace(/,/g, ''));\n  return isNaN(parsed) ? 0 : parsed;\n}\n\nfunction formatNumber(value) {\n  var numberValue = toNumber(value);\n  if (Math.round(numberValue) === numberValue) {\n    return String(numberValue);\n  }\n  return String(Math.round(numberValue * 100) / 100);\n}\n\nfunction formatMonetaryValue(value, currency) {\n  var amount = formatNumber(toNumber(value));\n  var currencyText = normalizeString(currency);\n  return currencyText ? '{amount:' + amount + ',currency:' + currencyText + '}' : '{amount:' + amount + '}';\n}\n\nfunction formatAction(value) {\n  var text = normalizeString(value).toUpperCase();\n  if (text === 'CREATE' || text === 'NEW') {\n    return 'New Contract Line';\n  }\n  return 'Update Existing Contract Line';\n}\n\nfunction taskDetailsFor(taskMap, taskId) {\n  if (taskId === null || taskId === undefined || taskId === '') {\n    return {};\n  }\n  return taskMap[taskId] || taskMap[String(taskId)] || {};\n}\n\nfunction associationForLine(lineChange, linkChanges, taskMap) {\n  var values = [];\n  var lineId = lineChange && lineChange.LineId;\n  for (var i = 0; i < linkChanges.length; i++) {\n    var link = linkChanges[i] || {};\n    if (lineId && link.LineId && String(link.LineId) !== String(lineId)) {\n      continue;\n    }\n    var taskId = firstNonEmpty([link.RequiredLinkTaskId, link.CLProjElementId, link.ProjElementId, link.LineTaskTopTaskId]);\n    var taskDetails = taskDetailsFor(taskMap, taskId);\n    var taskNumber = normalizeString(firstNonEmpty([link.TaskNumber, link.CLTaskNumber, link.ProjectOrTaskNumber, taskDetails.TaskNumber, taskId]));\n    var taskName = normalizeString(firstNonEmpty([link.TaskName, link.ProjectOrTaskName, link.ProjElementName, taskDetails.TaskName]));\n    var text = taskNumber && taskName && taskNumber !== taskName ? taskNumber + ' ' + taskName : taskNumber || taskName;\n    if (text && values.indexOf(text) === -1) {\n      values.push(text);\n    }\n  }\n  return values.join(', ');\n}\n\nfunction buildContractReviewRows(impactDetailsChanges) {\n  var data = impactDetailsChanges || {};\n  var lineChanges = asArray(data.ContractLineChanges);\n  var linkChanges = asArray(data.ContractLineLinkChanges);\n  var taskMap = v.prjPjeVarUqTasksDetailsMap || {};\n  var currency = firstNonEmpty([v.prjPjeVarUqContractCurrencyCode, v.prjPjeVarUqCurrencyCode]);\n  var rows = [];\n  for (var i = 0; i < lineChanges.length; i++) {\n    var change = lineChanges[i] || {};\n    var oldAmount = toNumber(change.OldLineAmount);\n    var newAmount = toNumber(change.LineAmount);\n    rows.push({\n      type: formatAction(firstNonEmpty([change.Action, change.Status, 'Update'])),\n      line: normalizeString(firstNonEmpty([change.LineNumber, change.LineId, String(i + 1)])),\n      name: normalizeString(firstNonEmpty([change.LineName, change.ItemNameTxt, change.LineId, String(i + 1)])),\n      from: formatMonetaryValue(oldAmount, currency),\n      to: formatMonetaryValue(newAmount, currency),\n      change: formatMonetaryValue(newAmount - oldAmount, currency),\n      projectAssociation: normalizeString(associationForLine(change, linkChanges, taskMap))\n    });\n  }\n  return rows;\n}\n\nvar ctx = {};\nfor (var i = 0; i < names.length; i++) {\n  var name = names[i];\n  ctx[name] = Object.prototype.hasOwnProperty.call(v, name) ? v[name] : null;\n}\nvar contractReviewRows = buildContractReviewRows(v.prjPjeVarUqImpactDetailsChanges || {});\nctx.contractReviewRows = contractReviewRows;\nctx.contractReviewRowCount = contractReviewRows.length;\nctx.contractReviewDataSource = contractReviewRows.length ? 'prjPjeVarUqImpactDetailsChanges' : 'none';\nctx.contractReviewSkippedReason = contractReviewRows.length ? '' : 'no_contract_line_changes';\nctx.prjPjeVarConvWorkflowStage = 'WAIT_CONTRACT_APPROVAL_DECISION';\nctx.prjPjeVarConvLatestUserIntent = 'IMPLEMENT_CHANGE_ORDER';\nctx.prjPjeVarConvLatestUserMessage = v.prjPjeVarConvLatestUserMessage || '';\nvar generatedReviewPayload = (($context.$nodes.PRJ_PJE_CODE_BUILD_USER_MESSAGE_WITH_CHANGES || {}).$output || {}).result || {};\nctx.generatedReviewHtml = generatedReviewPayload.legacyHtml || '';\nctx.pendingApprovalNodeCode = 'PRJ_PJE_CODE_BUILD_USER_MESSAGE_WITH_CHANGES';\nctx.changeOrderApprovalContextVersion = '2';\nreturn ctx;"
