          "metadata": {
            "name": "Resolve Strategic Context Details",
            "returnType": "object",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction hasOwn(objectValue, fieldName) {\n  return objectValue && typeof objectValue === 'object' && Object.prototype.hasOwnProperty.call(objectValue, fieldName);\n}\n\nfunction workflowVar(fieldName) {\n  try {\n    if ($context.$variables && Object.prototype.hasOwnProperty.call($context.$variables, fieldName)) {\n      var value = $context.$variables[fieldName];\n      return value === undefined ? null : value;\n    }\n  } catch (e) {}\n  return null;\n}\n\nfunction restInput() {\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      return $context.$triggers.REST.$input;\n    }\n  } catch (e) {}\n  return {};\n}\n\nfunction firstPresent(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== '') {\n      return values[i];\n    }\n  }\n  return null;\n}\n\nfunction currentInputMessage() {\n  try {\n    return $context.$system.$inputMessage || '';\n  } catch (e) {\n    return '';\n  }\n}\n\nvar input = restInput();\nvar passedAtomicDetails = asObject(firstPresent([\n  hasOwn(input, 'prjPjeActiveAtomicAgentDetails') ? input.prjPjeActiveAtomicAgentDetails : null,\n  hasOwn(input, 'prjPjfActiveAtomicAgentDetails') ? input.prjPjfActiveAtomicAgentDetails : null,\n  workflowVar('prjPjeVarConvActiveAtomicAgentDetails'),\n  workflowVar('prjPjfActiveAtomicAgentDetails')\n]));\nvar contextDetails = asObject(passedAtomicDetails.contextDetails);\nvar approvalContext = asObject(firstPresent([\n  contextDetails.prjPjeVarConvApprovalContext,\n  contextDetails.approvalContext,\n  workflowVar('prjPjeVarConvApprovalContext')\n]));\nvar uqNames = [\"prjPjeVarUqcontextProjectId\", \"prjPjeVarUqcontextValue\", \"prjPjeVarUqcontextType\", \"prjPjeVarUqProjectBusinessUnit\", \"prjPjeVarUqChangeOrderReason\", \"prjPjeVarUqChangeOrderName\", \"prjPjeVarUqIsProjectLinkageContract\", \"prjPjeVarUqChangeOrderProcessedStatus\", \"prjPjeVarUqChangeOrderNumber\", \"prjPjeVarUqProjPlanBaselineStatus\", \"prjPjeVarUqBudgetsImplementationStatus\", \"prjPjeVarUqProjPlanImplementationStatus\", \"prjPjeVarUqContractCurrencyCode\", \"prjPjeVarUqErrorMessage\", \"prjPjeVarUqanyNewContractLines\", \"prjPjeVarUqlineTypeId\", \"prjPjeVarUqbillPlanId\", \"prjPjeVarUqrevenuePlanId\", \"prjPjeVarUqContractNumber\", \"prjPjeVarUqAmendedImpactDetailsChanges\", \"prjPjeVarUqImpactDetailsSavedChanges\", \"prjPjeVarUqTempObject\", \"prjPjeVarUqAnyErrorInImpactDetailsChanges\", \"prjPjeVarUqImpactDetailsChanges\", \"prjPjeVarUqImpactDetails\", \"prjPjeVarUqContractLineLinkages\", \"prjPjeVarUqNewTasksData\", \"prjPjeVarUqloopVariable\", \"prjPjeVarUqTempImpactedTasksIds\", \"prjPjeVarUqTasksDetailsMap\", \"prjPjeVarUqisTaskDetailsRequired\", \"prjPjeVarUqImpactedTasks\", \"prjPjeVarUqImpacts\", \"prjPjeVarUqContractLines\", \"prjPjeVarUqNewContractLineAmount\", \"prjPjeVarUqContractLineAmount\", \"prjPjeVarUqContractAmendDate\", \"prjPjeVarUqContractUniqueId\", \"prjPjeVarUqTemp\", \"prjPjeVarUqParticipantEmail\", \"prjPjeVarUqPolicyOptions\", \"prjPjeVarUqParticipantStatus\", \"prjPjeVarUqChangeOrderStage\", \"prjPjeVarUqContractLineId\", \"prjPjeVarUqParticipantResourceId\", \"prjPjeVarUqParticipantId\", \"prjPjeVarUqHasBudgetImpacts\", \"prjPjeVarUqHasProjectPlanImpacts\", \"prjPjeVarUqAmendmentEffectiveDate\", \"prjPjeVarUqChangeOrderId\", \"prjPjeVarUqContractId\", \"prjPjeVarUqProjectId\"];\nfor (var i = 0; i < uqNames.length; i++) {\n  var name = uqNames[i];\n  if (hasOwn(contextDetails, name) && !hasOwn(approvalContext, name)) {\n    approvalContext[name] = contextDetails[name];\n  }\n}\n\nvar latestMessage = currentInputMessage();\nif (!latestMessage) {\n  latestMessage = firstPresent([contextDetails.prjPjeVarConvLatestUserMessage, contextDetails.EffectiveInputMessage, workflowVar('prjPjeVarConvLatestUserMessage')]) || '';\n}\n\nvar routingContext = firstPresent([\n  contextDetails.prjPjeVarConvRoutingContext,\n  contextDetails.prjPjeRoutingContext,\n  contextDetails.prjPjfRoutingContext,\n  input.prjPjeRoutingContext,\n  input.prjPjfRoutingContext,\n  input.source,\n  workflowVar('prjPjeVarConvRoutingContext'),\n  workflowVar('prjPjfRoutingContext'),\n  workflowVar('source')\n]);\n\nvar inheritedReturnEnvelopeFlag = firstPresent([\n  contextDetails.prjPjeVarConvReturnEnvelopeFlag,\n  input.prjPjeVarConvReturnEnvelopeFlag,\n  workflowVar('prjPjeVarConvReturnEnvelopeFlag')\n]);\n\nreturn {\n  prjPjeVarConvRoutingContext: routingContext,\n  prjPjeVarConvStrategicAgentChatHistory: firstPresent([contextDetails.prjPjeVarConvStrategicAgentChatHistory, contextDetails.prjPjfStrategicAgentChatHistory, input.prjPjeStrategicAgentChatHistory, input.prjPjfStrategicAgentChatHistory, workflowVar('prjPjeVarConvStrategicAgentChatHistory')]),\n  prjPjeVarConvActiveAtomicAgentDetails: passedAtomicDetails,\n  prjPjeVarConvStrategicAttachContent: firstPresent([contextDetails.prjPjeVarConvStrategicAttachContent, contextDetails.prjPjfStrategicAttachContent, input.prjPjeStrategicAttachContent, input.prjPjfStrategicAttachContent, workflowVar('prjPjeVarConvStrategicAttachContent')]),\n  prjPjeVarConvWorkflowStage: firstPresent([contextDetails.prjPjeVarConvWorkflowStage, approvalContext.prjPjeVarConvWorkflowStage, workflowVar('prjPjeVarConvWorkflowStage'), 'NEW_REQUEST']),\n  prjPjeVarConvLatestUserIntent: firstPresent([contextDetails.prjPjeVarConvLatestUserIntent, workflowVar('prjPjeVarConvLatestUserIntent')]),\n  prjPjeVarConvLatestIntentConfidence: firstPresent([contextDetails.prjPjeVarConvLatestIntentConfidence, workflowVar('prjPjeVarConvLatestIntentConfidence')]),\n  prjPjeVarConvLatestUserMessage: latestMessage,\n  prjPjeVarConvApprovalContext: approvalContext,\n  prjPjeVarConvReturnEnvelopeFlag: inheritedReturnEnvelopeFlag ? String(inheritedReturnEnvelopeFlag).toUpperCase() : (String(routingContext || '').toLowerCase() === 'redwoodui' ? 'Y' : 'N')\n};"
