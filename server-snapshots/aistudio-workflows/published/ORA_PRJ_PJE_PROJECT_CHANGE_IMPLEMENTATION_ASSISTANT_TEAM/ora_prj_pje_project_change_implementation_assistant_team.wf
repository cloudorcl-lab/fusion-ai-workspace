                    "sourceCode": "let data = {};\n\nlet cllChanges = $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.$currentItem;\n\ndata.LineTypeId = $context.$variables.prjPjeVarUqlineTypeId;\ndata.LineNumber = cllChanges.LineNumber;\ndata.ItemNameTxt = cllChanges.LineName;\ndata.LineAmount = cllChanges.LineAmount;\ndata.BillPlanId = $context.$variables.prjPjeVarUqbillPlanId;\ndata.RevenuePlanId = $context.$variables.prjPjeVarUqrevenuePlanId;\n\n\nlet name = $context.$variables.prjPjeVarUqChangeOrderName;\nlet number = $context.$variables.prjPjeVarUqChangeOrderNumber ;\nlet reason = $context.$variables.prjPjeVarUqChangeOrderReason ;\nlet deltaAmount = $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.$currentItem.LineAmountDelta;\ndata.Comments = `Change Order Name: ${name}; Number: ${number}; Reason: ${reason}; Change Amount: ${deltaAmount};`\n\n\n\nreturn data;"
