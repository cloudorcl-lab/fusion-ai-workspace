          }
        },
        {
          "metadata": {
            "name": "Collect Task Details",
            "returnType": "object",
            "sourceCode": "const taskDetails = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_TASK_DETAILS.$output;\n\nlet taskMap = $context.$variables.prjPjeVarUqTasksDetailsMap || {};\n\nfor (const item of taskDetails.items) {\n  taskMap[item.id] = taskMap[item.id] || {};\n  var entry = taskMap[item.id];\n  entry.TaskName = entry.TaskName || item.name;\n  entry.ParentTaskId = entry.ParentTaskId || item.parentTask?.id;\n  entry.TaskNumber = entry.TaskNumber || item.taskNumber;\n  entry.TopTaskId = entry.TopTaskId || item.topTask?.id;\n  entry.TaskLevel = entry.TaskLevel || item.taskLevel;\n\n  // Add parent if missing\n  const parentId = item.parentTask?.id;\n  if (parentId && !taskMap[parentId]) {\n    const parentLevel = item.taskLevel - 1;\n    if (parentLevel >= 0) {\n      taskMap[parentId] = {\n        TaskName: item.parentTask.name,\n        TaskNumber: item.parentTask.taskNumber,\n        TaskLevel: parentLevel,\n        TopTaskId: parentLevel === 0 ? parentId : item.topTask.id\n      };\n    }\n  }\n\n  // Add top if missing\n  const topId = item.topTask?.id;\n  if (topId && !taskMap[topId]) {\n    taskMap[topId] = {\n      TaskName: item.topTask.name,\n      TaskNumber: item.topTask.taskNumber,\n      TaskLevel: 1,\n      TopTaskId: topId\n    };\n  }\n}\n\nlet optimizedTaskMap = {};\n\nfor (const taskId in taskMap) {\n  var entry = taskMap[taskId];\n\n  optimizedTaskMap[taskId] = entry;\n\n  let parentTaskId = entry.ParentTaskId;\n  let topTaskId = entry.TopTaskId;\n  let taskLevel = entry.TaskLevel;\n  \n  if(parentTaskId && !optimizedTaskMap[parentTaskId]){\n    optimizedTaskMap[parentTaskId] = {\n      'TopTaskId': topTaskId,\n      'TaskLevel': taskLevel - 1\n    };\n  }\n\n\n  if(topTaskId && !optimizedTaskMap[topTaskId]){\n    optimizedTaskMap[topTaskId] = {\n      'TopTaskId': topTaskId,\n      'TaskLevel': 1\n    };\n  }\n}\n\n\nreturn optimizedTaskMap;"
          },
          "outcomes": {
            "success": "1772457093281"
          },
          "code": "PRJ_PJE_CODE_COLLECT_TASK_DETAILS",
          "id": "1771394207153",
