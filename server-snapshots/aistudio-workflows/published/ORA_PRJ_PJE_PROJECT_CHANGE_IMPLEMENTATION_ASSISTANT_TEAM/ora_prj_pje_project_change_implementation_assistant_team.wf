                      "value": "{{\"q=StsCode='UNDER_AMENDMENT' and ContractLine.Id=\" + $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.$currentItem.Id + \"&fields=ContractLine:Id,LineNumber,LineId,LineTypeId,LineTypeName,BillPlanId,RevenuePlanId,LineAmount,ItemNameTxt;ContractLine.AssociatedProject:LinkId,ProjectId,ProjElementId,FundingAmount,TaskNumber\"}}",
