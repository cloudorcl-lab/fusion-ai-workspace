        {
          "metadata": {
            "name": "Extract Contract Lines",
            "returnType": "object",
            "sourceCode": "//const contractLines = $context.$nodes.PRJ_PJE_CODE_CAPTURE_CONTRACT.$output.result.contractLines;\n//const contractLinesData = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_CONTRACT_LINES.$output;\nconst contractLinesData = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_CONTRACT_LINES.$output.items[0].ContractLine;\nconst rootTask = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_ROOT_TASK_DETAILS.$output.items[0];\nlet isProjectLinkageContract = false;\n\nvar result = {};\n\nlet contractLines = {};\nlet contractLineLinkages = {};\n\nfor (var i = 0; i < contractLinesData.items.length; i++) {\n  var contractLine = contractLinesData.items[i];\n  var projects = contractLine.AssociatedProject.items;\n  \n  let lineId = contractLine.LineId;\n  contractLines[lineId] = {};\n  contractLines[lineId].LineId = lineId;\n  contractLines[lineId].Id = contractLine.Id;\n  contractLines[lineId].LineNumber = contractLine.LineNumber;\n  contractLines[lineId].LineTypeId = contractLine.LineTypeId;\n  contractLines[lineId].LineTypeName = contractLine.LineTypeName;\n  contractLines[lineId].BillPlanId = contractLine.BillPlanId;\n  contractLines[lineId].RevenuePlanId = contractLine.RevenuePlanId;\n  contractLines[lineId].LineAmount = contractLine.LineAmount;\n  contractLines[lineId].LineName = contractLine.ItemNameTxt;\n  contractLines[lineId].Comments = contractLine.Comments;\n  contractLines[lineId].Linkages = [];\n\n  for (var j = 0; j < projects.length; j++) {\n    var project = projects[j];\n    var ctxKey = project[\"@context\"].key;\n    var linkId = project.LinkId;\n\n    isProjectLinkageContract = isProjectLinkageContract ||  project.ProjElementId == null;\n    contractLineLinkages[linkId] = {};\n    contractLineLinkages[linkId].LinkId = linkId;\n    contractLineLinkages[linkId].key = ctxKey;\n    contractLineLinkages[linkId].ProjectId = project.ProjectId;\n    contractLineLinkages[linkId].ProjElementId = project.ProjElementId || rootTask.id;\n    contractLineLinkages[linkId].FundingAmount = project.FundingAmount;\n    contractLineLinkages[linkId].TaskNumber = project.TaskNumber || rootTask.taskNumber;\n    contractLineLinkages[linkId].contractLine = {\n      Id: contractLine.Id,\n      LineId: contractLine.LineId,\n      LineAmount: contractLine.LineAmount,\n      LineNumber: contractLine.LineNumber,\n      LineName: contractLine.ItemNameTxt, \n      Comments: contractLine.Comments, \n    };\n\t\n\t// Create Linkage for Contract line\t\n\tlet cll = {\n\t  LinkId: project.LinkId,\n\t  key: project[\"@context\"].key,\n          ProjectId: project.ProjectId,\n          ProjElementId: project.ProjElementId || rootTask.id,\n          FundingAmount: project.FundingAmount,\n          TaskNumber: project.TaskNumber || rootTask.taskNumber,\n    };\n\t\n    contractLines[lineId].Linkages.push(cll);\n  }\n}\n\nresult.ContractLines = contractLines;\nresult.ContractLineLinkages = contractLineLinkages;\nresult.IsProjectLinkageContract = isProjectLinkageContract;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771343120814"
          },
