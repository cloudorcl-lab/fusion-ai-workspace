          "id": "1771348423476",
          "inputs": [
            {
              "id": "1771494960268",
              "name": "prjPjeVarUqAnyErrorInImpactDetailsChanges",
              "scope": "JOB",
              "type": "boolean",
              "value": "false"
            },
            {
              "id": "1771395364320",
              "name": "prjPjeVarUqContractLineLinkages",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PRJ_PJE_CODE_UPDATE_LINK_LEVEL_FOR_CONTRACT_LINES.$output.result}}"
            },
            {
              "id": "1771349229172",
              "name": "prjPjeVarUqNewTasksData",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_TASK_DETAILS.$output}}"
            },
            {
              "id": "1783100000001",
              "name": "prjPjeVarUqImpactDetailsChanges",
              "scope": "JOB",
              "type": "object",
              "value": {
                "ContractLineChanges": [],
                "ContractLineLinkChanges": [],
                "Error": {},
                "TotalNetChange": 0
              }
            },
            {
              "id": "1783100000002",
              "name": "prjPjeVarUqanyNewContractLines",
              "scope": "JOB",
              "type": "boolean",
              "value": "false"
            }
          ],
          "type": "SET_FIELDS",
          "diagram": {
            "x": 6291,
            "y": 18244
          }
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1771416660722"
                  },
                  "diagram": {
                    "x": 6518.5,
                    "y": 19222
                  },
                  "id": "start_1771416307172",
                  "code": "START_1771416307172",
                  "type": "START",
                  "inputs": []
                },
                {
                  "metadata": {
                    "name": "Compute Impact Details Changes",
                    "returnType": "object",
                    "sourceCode": "let impactDetail = $context.$nodes.PRJ_PJE_LOOP_PROCESS_IMPACT_DETAILS.$currentItem;\n\nlet impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges || {};\n\nimpactDetailsChanges.ContractLineChanges = impactDetailsChanges.ContractLineChanges || [];\nimpactDetailsChanges.ContractLineLinkChanges = impactDetailsChanges.ContractLineLinkChanges || [];\nimpactDetailsChanges.Error = impactDetailsChanges.Error || {};\nimpactDetailsChanges.TotalNetChange = impactDetailsChanges.TotalNetChange || 0;\n\nlet anyErrorInCurrentChange = false;\nlet currentChangeErrorMessage = false;\nlet anyNewContractLines = $context.$variables.prjPjeVarUqanyNewContractLines == true;\nlet contractNumber = $context.$variables.prjPjeVarUqContractNumber;\n\n\nlet contractChoice = $context.$variables.prjPjeVarUqPolicyOptions.ContractChoice;\nlet isNewContractLineAllowed =  contractChoice == 'CREATE' || contractChoice == 'UPSERT';\nlet isUpdateContractLineAllowed = contractChoice == 'UPDATE' || contractChoice == 'UPSERT';\n//isNewContractLineAllowed =  false;\n\n\nlet lineTypeId = $context.$variables.prjPjeVarUqlineTypeId;\nlet billPlanId = $context.$variables.prjPjeVarUqbillPlanId;\nlet revenuePlanId = $context.$variables.prjPjeVarUqrevenuePlanId;\n\n\nlet anyErrorsInProcessing = $context.$variables.prjPjeVarUqAnyErrorInImpactDetailsChanges;\nlet errorMessage = $context.$variables.prjPjeVarUqErrorMessage;\n\nlet response = {};\nresponse.AnyErrorInImpactDetailsChanges = response.AnyErrorInImpactDetailsChanges || false;\nif( anyErrorsInProcessing == true){\n\tresponse.impactDetailsChanges = impactDetailsChanges;\n\tresponse.AnyErrorInImpactDetailsChanges = true;\n\tresponse.ErrorMessage = errorMessage;\n   \treturn response;\n}\n\nlet allContractLineLinkages = $context.$variables.prjPjeVarUqContractLineLinkages;\nlet allContractLines = $context.$variables.prjPjeVarUqContractLines;\n\nlet taskDetailsMap = $context.$variables.prjPjeVarUqTasksDetailsMap;\n\n\nconst generateUniqueId = (prefix = \"1001\") => {\n    const timestamp = Date.now().toString().slice(-8);\n    const randomNum = Math.floor(Math.random() * 1000000).toString().padStart(6, \"0\");\n    return \"-\" + prefix + timestamp + randomNum;\n}\n\n// Replace Code Here - Start\n    // variable Details\n    // cl  - Contract Line\n    // cll - Contract Line Linkage\n    // clChange - Change in Contract Line\n    // cllChange - Change in Contract Line Linkage\n\n    // Replace Code Here - Start\n    // Replace Code Here - Start\n  // variable Details\n  // cl  - Contract Line\n  // cll - Contract Line Linkage\n  // clChange - Change in Contract Line\n  // cllChange - Change in Contract Line Linkage\n\n  // Replace Code Here - Start\n\nlet rootTaskId = null;\n  let rootTaskDetail = null;\n  for (let taskKey in taskDetailsMap) {\n    const candidateTaskDetail = taskDetailsMap[taskKey];\n    if (Number(candidateTaskDetail?.TaskLevel) === 0) {\n      rootTaskId = candidateTaskDetail?.ProjElementId || taskKey;\n      rootTaskDetail = candidateTaskDetail;\n      break;\n    }\n  }\n\nlet taskId = impactDetail.ProjElementId;\n\n  let cll = null;\n  let taskDetail = taskDetailsMap[taskId];\n\n  if (rootTaskId != null) {\n    for (let key in allContractLineLinkages) {\n      if (allContractLineLinkages[key].ProjElementId === rootTaskId) {\n        cll = allContractLineLinkages[key];\n        break;\n      }\n    }\n  }\n\n  if (cll == null && taskDetail != null) {\n    for (let key in allContractLineLinkages) {\n      let cllTaskId = allContractLineLinkages[key].ProjElementId;\n\n      if (cllTaskId === impactDetail.ProjElementId\n        || cllTaskId === taskDetail.ParentTaskId\n        || cllTaskId === taskDetail.TopTaskId\n        || cllTaskId === taskDetail.TopTaskId) {\n\n        cll = allContractLineLinkages[key];\n        break;\n      }\n    }\n  }\n\n\n  let impactDetailChange = null;\n  // Identified a Contract Line Linkage for the Impact Detail.\n  if (cll) {\n\n    if (!isUpdateContractLineAllowed) {\n      console.log(cll);\n      anyErrorInCurrentChange = true;\n      currentChangeErrorMessage = `Task ${taskDetail ? taskDetail.TaskNumber : impactDetail.ProjectOrTaskName} has impacts and Contract line ${cll.contractLine?.LineNumber} is already associated to the task. Policy prohibits updating contract lines.`;\n    } else {\n      //Process ContractLineLinkChange\n      let cllChange = null;\n\n      for (let change of impactDetailsChanges.ContractLineLinkChanges) {\n        if (change.Key == cll.key) {\n          cllChange = change;\n          break;\n        }\n      }\n\n      let cllTaskDetail = taskDetailsMap[cll.ProjElementId];\n\n      // Update Contract Line Linkage Task Level\n      if (cllTaskDetail) {\n        cll.CLTaskLevel = cllTaskDetail.TaskLevel;\n        cll.CLProjElementId = cllTaskDetail.ProjElementId;\n        cll.CLTaskNumber = cllTaskDetail.TaskNumber;\n      }\n\n      // CLL not found in previous iteration. Create a new CLL change\n      if (cllChange == null) {\n        cllChange = {};\n        cllChange.Status = 'FOUND';\n        cllChange.FundingAmount = cll.FundingAmount;\n        cllChange.OldFundingAmount = cll.FundingAmount;\n        cllChange.ProjElementId = impactDetail.ProjElementId;\n        cllChange.CLProjElementId = cll.ProjElementId;\n        cllChange.Key = cll.key;\n        cllChange.TaskNumber = cll.TaskNumber;\n        cllChange.LinkId = cll.LinkId;\n        cllChange.LineId = cll.contractLine.LineId;\n        cllChange.Id = cll.contractLine.Id;\n        cllChange.LineNumber = cll.contractLine.LineNumber;\n        impactDetailsChanges.ContractLineLinkChanges.push(cllChange);\n\n      }\n\n      cllChange.FundingAmount = Number(cllChange.FundingAmount || 0) + Number(impactDetail.PCRevenue || 0);\n      //cllChange.Action = 'UPDATE';\n      cllChange.Action = allContractLines[cllChange.LineId] ? 'UPDATE' : 'CREATE';\n\n      //Process corresponding ContractLineChange\n      let clChange = null;\n\n      for (let change of impactDetailsChanges.ContractLineChanges) {\n        if (change.LineId == cll.contractLine.LineId) {\n          clChange = change;\n          break;\n        }\n      }\n\n      if (clChange == null) {\n        clChange = {};\n        clChange.Status = 'FOUND';\n        clChange.LineAmount = cll.contractLine.LineAmount;\n        clChange.OldLineAmount = cll.contractLine.LineAmount;\n        clChange.LineAmountDelta = 0;\n        clChange.LineNumber = cll.contractLine.LineNumber;\n        clChange.LineName = cll.contractLine.LineName;\n        clChange.LineId = cll.contractLine.LineId;\n        clChange.Id = cll.contractLine.Id;\n        clChange.Comments = cll.contractLine.Comments; \n        clChange.Action = allContractLines[clChange.LineId] ? 'UPDATE' : 'CREATE';\n        impactDetailsChanges.ContractLineChanges.push(clChange);\n      }\n\n      let lineRevenueImpact = Number(impactDetail.PCRevenue || 0);\n      clChange.LineAmountDelta = Number(clChange.LineAmountDelta || 0) + lineRevenueImpact;\n      clChange.LineAmount = Number(clChange.OldLineAmount || 0) + Number(clChange.LineAmountDelta || 0);\n      impactDetailsChanges.TotalNetChange = Number(impactDetailsChanges.TotalNetChange) + lineRevenueImpact;\n    }\n\n  } else {\n    // Create new contract line linkage since not found\n    const newLinkId = generateUniqueId(\"3001\");\n    const newLineId = generateUniqueId(\"1001\");\n    const newId = generateUniqueId(\"1001\");\n\n    let cllChange = {};\n    if (!isNewContractLineAllowed) {\n      anyErrorInCurrentChange = true;\n      currentChangeErrorMessage = `Task ${taskDetail ? taskDetail.TaskNumber : impactDetail.ProjectOrTaskName} has impacts and Contract line association is missing for the task. Policy prohibits creating new contract lines.`;\n    } else {\n      cllChange.Status = \"NEW\";\n      cllChange.ProjElementId = impactDetail.ProjElementId;\n      cllChange.TaskNumber = taskDetail ? taskDetail.TaskNumber : impactDetail.ProjectOrTaskName;\n      cllChange.TaskLevel = taskDetail?.TaskLevel ?? 0;\n      cllChange.LinkId = newLinkId;\n      cllChange.LineId = newLineId;\n      cllChange.LineTaskTopTaskId = taskDetail?.TopTaskId || rootTaskId || impactDetail.ProjElementId;\n      cllChange.Id = newId;\n      cllChange.LineNumber = \"1\";\n      impactDetailsChanges.ContractLineLinkChanges.push(cllChange);\n\n      cllChange.FundingAmount = Number(impactDetail.PCRevenue || 0);\n      cllChange.Action = allContractLines[cllChange.LineId] ? \"UPDATE\" : \"CREATE\";\n\n      // Process corresponding contract line change\n      let clChange = null;\n\n      for (let change of impactDetailsChanges.ContractLineChanges) {\n        if (change.LineId == newLineId) {\n          clChange = change;\n          break;\n        }\n      }\n\n      if (clChange == null) {\n        clChange = {};\n        clChange.Status = 'NEW';\n        clChange.OldLineAmount = 0;\n        clChange.LineAmountDelta = 0;\n        clChange.LineId = newLineId;\n        clChange.LineName = newLineId;\n        clChange.Id = newId;\n        clChange.LineTypeId = lineTypeId;\n        clChange.BillPlanId = billPlanId;\n        clChange.RevenuePlanId = revenuePlanId;\n\n        anyNewContractLines = true;\n\n        impactDetailsChanges.ContractLineChanges.push(clChange);\n      }\n\n      let newLineRevenueImpact = Number(impactDetail.PCRevenue || 0);\n      clChange.LineAmountDelta = Number(clChange.LineAmountDelta || 0) + newLineRevenueImpact;\n      clChange.LineAmount = Number(clChange.OldLineAmount || 0) + Number(clChange.LineAmountDelta || 0);\n      clChange.Action = allContractLines[clChange.LineId] ? \"UPDATE\" : \"CREATE\";\n      impactDetailsChanges.TotalNetChange = Number(impactDetailsChanges.TotalNetChange || 0) + newLineRevenueImpact;\n    }\n\n  }\n\n    // Replace Code Here - End\n\n\nresponse.impactDetailsChanges = impactDetailsChanges;\nresponse.ContractLineLinkages = allContractLineLinkages;\nif(anyErrorInCurrentChange){\n\tresponse.AnyErrorInImpactDetailsChanges = true;\n\tresponse.ErrorMessage = currentChangeErrorMessage;\n}\nresponse.anyNewContractLines = anyNewContractLines;\n\n\nreturn response;"
                  },
