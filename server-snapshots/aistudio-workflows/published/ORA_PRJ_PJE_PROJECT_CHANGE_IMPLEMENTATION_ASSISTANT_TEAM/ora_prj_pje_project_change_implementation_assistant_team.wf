            "name": "Resolve Contract Approval Decision",
            "returnType": "object",
            "sourceCode": "function normalize(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).toLowerCase().replace(/[\\s\\u00a0]+/g, ' ').trim();\n}\n\nvar message = normalize($context.$system.$inputMessage);\nvar rejectTerms = ['request changes', 'do not proceed', 'dont proceed', \"don't proceed\", 'reject', 'rejected', 'revise', 'revision', 'cancel', 'stop', 'no'];\nvar approveTerms = ['go ahead', 'looks good', 'accepted', 'accept', 'approved', 'approve', 'proceed', 'submit', 'continue', 'yes'];\n\nfor (var i = 0; i < rejectTerms.length; i++) {\n  if (message.indexOf(rejectTerms[i]) >= 0) {\n    return { decision: 'REJECTED' };\n  }\n}\n\nfor (var j = 0; j < approveTerms.length; j++) {\n  if (message.indexOf(approveTerms[j]) >= 0) {\n    return { decision: 'APPROVED' };\n  }\n}\n\nreturn { decision: 'REJECTED' };"
          },
          "outcomes": {
            "success": "1783000000009"
          },
