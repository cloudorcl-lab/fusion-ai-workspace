        {
          "metadata": {
            "name": "Populate Missing Tasks Details",
            "returnType": "object",
            "sourceCode": "let newTasks = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_MISSING_TASKS_DETAILS.$output.items;\n\nlet impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges;\n\nfor (let change of impactDetailsChanges.ContractLineChanges) {\n  if (change.TaskLinkages) {\n    for (let linkage of change.TaskLinkages) {\n      if (!linkage.TaskName || !linkage.TaskNumber) {\n        const matchingTask = newTasks.find(task => task.id === linkage.CLProjElementId);\n        if (matchingTask) {\n          linkage.TaskName = matchingTask.name;\n          linkage.TaskNumber = matchingTask.taskNumber;\n        }\n      }\n    }\n  }\n}\n\n\nlet data = {};\n\n//data.newTasks = newTasks;\ndata.ImpactDetailsChanges = impactDetailsChanges;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1772891763189"
          },
          "code": "PRJ_PJE_CODE_POPULATE_MISSING_TASKS_DETAILS",
          "id": "1772879985152",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5581.5,
            "y": 22738
          }
        },
        {
          "metadata": {
            "name": "Consolidate Changes",
            "returnType": "array",
            "sourceCode": "let impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges || {};\n\nlet clChanges = Array.isArray(impactDetailsChanges.ContractLineChanges) ? impactDetailsChanges.ContractLineChanges : [];\nlet cllChanges = Array.isArray(impactDetailsChanges.ContractLineLinkChanges) ? impactDetailsChanges.ContractLineLinkChanges : [];\nlet tasksDetailsMap = $context.$variables.prjPjeVarUqTasksDetailsMap || {};\nlet missingTasks = [];\n\n\nconst linksByLineId = {};\n\nfor (let link of cllChanges) {\n  if (!linksByLineId[link.LineId]) {\n    linksByLineId[link.LineId] = [];\n  }\n  linksByLineId[link.LineId].push(link);\n}\n\nfor (let line of clChanges) {\n  if (line.LineAmountDelta === undefined || line.LineAmountDelta === null || line.LineAmountDelta === '') {\n    line.LineAmountDelta = Number(line.LineAmount || 0) - Number(line.OldLineAmount || 0);\n  }\n  if (line.Action === 'UPDATE') {\n    line.LineAmount = Number(line.OldLineAmount || 0) + Number(line.LineAmountDelta || 0);\n  }\n  line.TaskLinkages = [];\n  const links = linksByLineId[line.LineId] || [];\n\n  for (let link of links) {\n    const clProjElementId = link.CLProjElementId || link.RequiredLinkTaskId;\n    if (clProjElementId) {\n      const task = tasksDetailsMap[clProjElementId];\n      const taskName = task?.TaskName;\n      const taskNumber = task?.TaskNumber;\n      if (!task || !taskName || !taskNumber) {\n        missingTasks.push(clProjElementId);\n      }\n\n\n      const taskLinkage = {\n        CLProjElementId: clProjElementId,\n        TaskName: taskName,\n        TaskNumber: taskNumber\n      };\n\n      line.TaskLinkages.push(taskLinkage);\n    }\n  }\n}\n\nimpactDetailsChanges.currencyCode = $context.$variables.prjPjeVarUqContractCurrencyCode;\n\nlet policyOptions = $context.$variables.prjPjeVarUqPolicyOptions;\n\nimpactDetailsChanges.ContractNumber = $context.$variables.prjPjeVarUqContractNumber; \n\n//impactDetailsChanges.ImplementProjectPlanPolicy = true;\n//impactDetailsChanges.ImplementBudgetsPolicy = false;\n//impactDetailsChanges.ImplementProjectPlanStatus = 'COMPLETED';\n//impactDetailsChanges.BaselineProjectPlanPolicy = true;\n//impactDetailsChanges.BaselineProjectPlanStatus = true;\n\n\n// Update Implementation Details\nif(policyOptions.ImplementProjectPlan && $context.$variables.prjPjeVarUqHasProjectPlanImpacts){\n    impactDetailsChanges.ImplementProjectPlanPolicy = true;\n    impactDetailsChanges.ImplementBudgetsPolicy = false;\n    impactDetailsChanges.ImplementProjectPlanStatus = $context.$variables.prjPjeVarUqProjPlanImplementationStatus;\n\n    if(policyOptions.BaselineProjectPlan){\n       impactDetailsChanges.BaselineProjectPlanPolicy = true;\n       impactDetailsChanges.BaselineProjectPlanStatus = $context.$variables.prjPjeVarUqProjPlanBaselineStatus;\n    }\n}else if(policyOptions.ImplementBudget && $context.$variables.prjPjeVarUqHasBudgetImpacts){\n    impactDetailsChanges.ImplementBudgetsPolicy = true;\n    impactDetailsChanges.ImplementProjectPlanPolicy = false;\n    impactDetailsChanges.ImplementBudgetStatus = $context.$variables.prjPjeVarUqBudgetsImplementationStatus;\n};\n\n\nlet data = {};\ndata.ImpactDetailsChanges = impactDetailsChanges;\ndata.tasksDetailsMap = tasksDetailsMap;\ndata.missingTasks = missingTasks\ndata.missingTasksURLParam = `$filter=id in (${missingTasks.join(\",\")})&fields=name,parentTask,id,taskNumber,taskLevel,topTask`;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1772891520568"
          },
          "code": "PRJ_PJE_CODE_CONSOLIDATE_CHANGES",
          "id": "1772888192223",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
