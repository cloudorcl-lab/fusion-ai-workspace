        {
          "metadata": {
            "name": "Initialize Task Ids",
            "returnType": "string",
            "sourceCode": "let linkages = $context.$variables.prjPjeVarUqContractLineLinkages;\n\n\nvar projElementIds = [];\n\nfor (var id in linkages) {\n  if (linkages.hasOwnProperty(id) && linkages[id].ProjElementId != undefined) {\n    projElementIds.push(linkages[id].ProjElementId);\n  }\n}\n\nlet impactedTasks = $context.$variables.prjPjeVarUqImpactedTasks;\nprojElementIds.push(...impactedTasks);\n\n\n\nreturn `$filter=id in (${projElementIds.join(\",\")})&fields=name,parentTask,id,taskNumber,taskLevel,topTask`;\n//return `$filter=taskLevel = 0&fields=name,parentTask,id,taskNumber,taskLevel,topTask`;\n//return `$filter=taskLevel = 0 or id in (${projElementIds.join(\",\")})&fields=name,parentTask,id,taskNumber,taskLevel,topTask`;"
          },
          "outcomes": {
            "success": "1771348312986"
          },
          "code": "PRJ_PJE_CODE_INITIALIZE_TASK_IDS",
          "id": "1771348129651",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
