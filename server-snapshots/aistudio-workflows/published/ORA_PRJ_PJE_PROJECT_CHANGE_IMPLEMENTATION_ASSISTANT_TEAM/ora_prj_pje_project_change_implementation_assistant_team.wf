        {
          "metadata": {
            "name": "Capture details to Create New Lines",
            "returnType": "object",
            "sourceCode": "let result = {};\n\nlet impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges;\nlet contractLines = $context.$variables.prjPjeVarUqContractLines;\nlet contractLineLinkages = $context.$variables.prjPjeVarUqContractLineLinkages;\nlet tasksDetailsMap = $context.$variables.prjPjeVarUqTasksDetailsMap;\n\n\nlet newImpactDetailsChanges = {\n    ContractLineLinkChanges: impactDetailsChanges.ContractLineLinkChanges.filter(item => item.Action === 'CREATE'),\n    ContractLineChanges: impactDetailsChanges.ContractLineChanges.filter(item => item.Action === 'CREATE'),\n};\n\nlet contractLineLinkagesForLLM = Object.fromEntries(\n  Object.entries(contractLineLinkages).map(([linkId, linkage]) => [\n    linkId,\n    {\n      LinkId: linkId,\n      ProjElementId: linkage.ProjElementId,\n      LinkTaskLevel: linkage.LinkTaskLevel\n    }\n  ])\n);\n\n\n\nresult.ImpactDetailsChanges = impactDetailsChanges;\nresult.ContractLines = contractLines;\nresult.ContractLineLinkages = contractLineLinkages;\nresult.TasksDetailsMap = tasksDetailsMap;\nresult.contractLineLinkagesForLLM = contractLineLinkagesForLLM;\nresult.newImpactDetailsChanges = newImpactDetailsChanges;\n\n\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772518842560"
          },
          "code": "PRJ_PJE_CODE_CAPTURE_DETAILS_TO_CREATE_NEW_LINES",
          "id": "1772203742325",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
