        {
          "metadata": {
            "name": "Build User Message with Changes",
            "returnType": "object",
            "sourceCode": "var v = $context.$variables || {};\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return {};\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return {};\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction htmlEscape(value) {\n  return normalizeString(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return 0;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? 0 : value;\n  }\n  var parsed = Number(String(value).replace(/,/g, ''));\n  return isNaN(parsed) ? 0 : parsed;\n}\n\nfunction formatNumber(value) {\n  var numberValue = toNumber(value);\n  if (Math.round(numberValue) === numberValue) {\n    return String(numberValue);\n  }\n  return String(Math.round(numberValue * 100) / 100);\n}\n\nfunction formatPlainAmount(value, currency, includeSign) {\n  var numberValue = toNumber(value);\n  var sign = '';\n  if (includeSign && numberValue > 0) {\n    sign = '+';\n  } else if (numberValue < 0) {\n    sign = '-';\n  }\n  var text = sign + formatNumber(Math.abs(numberValue));\n  var currencyText = normalizeString(currency);\n  return currencyText ? text + ' ' + currencyText : text;\n}\n\nfunction monetaryValue(value, currency) {\n  var currencyText = normalizeString(currency);\n  return {\n    amount: toNumber(value),\n    currency: currencyText,\n    displayValue: formatPlainAmount(value, currencyText, false)\n  };\n}\n\nfunction amountBadge(value, currency, includeSign, forceClass) {\n  var numberValue = toNumber(value);\n  var badgeClass = forceClass || (numberValue < 0 ? 'oj-badge-danger' : 'oj-badge-success');\n  return '<span class=\"oj-badge ' + badgeClass + ' oj-badge-subtle\">' + htmlEscape(formatPlainAmount(numberValue, currency, includeSign)) + '</span>';\n}\n\nfunction isTrueValue(value) {\n  if (value === true) {\n    return true;\n  }\n  var text = normalizeString(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === 'completed';\n}\n\nfunction isCompletedStatus(value) {\n  return normalizeString(value).toLowerCase() === 'completed';\n}\n\nfunction buildImplementationMessages(data) {\n  var messages = [];\n  if (isTrueValue(data.ImplementProjectPlanPolicy) && isCompletedStatus(data.ImplementProjectPlanStatus)) {\n    var projectPlanMessage = 'Project plan changes have been implemented successfully.';\n    if (isTrueValue(data.BaselineProjectPlanPolicy) && isTrueValue(data.BaselineProjectPlanStatus)) {\n      projectPlanMessage = 'Project plan changes have been implemented successfully and the project plan has been baselined.';\n    }\n    messages.push(projectPlanMessage);\n  }\n  if (isTrueValue(data.ImplementBudgetsPolicy) && isCompletedStatus(data.ImplementBudgetsStatus)) {\n    messages.push('Budget and Forecast changes have been implemented.');\n  }\n  return messages;\n}\n\nfunction linkLineId(link) {\n  return firstNonEmpty([link && link.LineId, link && link.ContractLineId, link && link.SourceLineId]);\n}\n\nfunction taskAssociationValues(lineChange, data) {\n  var lineId = firstNonEmpty([lineChange && lineChange.LineId, lineChange && lineChange.ContractLineId]);\n  var linkChanges = asArray(firstNonEmpty([data.ContractLineLinkChanges, data.TaskLinkages, data.ContractLineLinkages]));\n  var taskMap = v.prjPjeVarUqTasksDetailsMap || {};\n  var values = [];\n\n  function taskDetailsFor(taskId) {\n    if (taskId === null || taskId === undefined || taskId === '') {\n      return {};\n    }\n    return taskMap[taskId] || taskMap[String(taskId)] || {};\n  }\n\n  function pushTask(link) {\n    var taskId = firstNonEmpty([link.RequiredLinkTaskId, link.CLProjElementId, link.ProjElementId, link.LineTaskTopTaskId]);\n    var details = taskDetailsFor(taskId);\n    var taskNumber = normalizeString(firstNonEmpty([link.TaskNumber, link.CLTaskNumber, link.ProjectOrTaskNumber, details.TaskNumber, taskId]));\n    var taskName = normalizeString(firstNonEmpty([link.TaskName, link.ProjectOrTaskName, link.ProjElementName, details.TaskName]));\n    if (!taskNumber && !taskName) {\n      return;\n    }\n    var key = taskNumber + '|' + taskName;\n    for (var i = 0; i < values.length; i++) {\n      if (values[i].key === key) {\n        return;\n      }\n    }\n    values.push({ key: key, taskNumber: taskNumber, taskName: taskName });\n  }\n\n  for (var i = 0; i < linkChanges.length; i++) {\n    var link = linkChanges[i] || {};\n    var linkedLineId = linkLineId(link);\n    if (lineId && linkedLineId && String(lineId) !== String(linkedLineId)) {\n      continue;\n    }\n    pushTask(link);\n  }\n\n  return values;\n}\n\nfunction associationText(tasks) {\n  if (!tasks.length) {\n    return 'Line-level Update';\n  }\n  var parts = [];\n  for (var i = 0; i < tasks.length; i++) {\n    var task = tasks[i];\n    if (task.taskNumber && task.taskName && task.taskNumber !== task.taskName) {\n      parts.push(task.taskNumber + ' ' + task.taskName);\n    } else {\n      parts.push(task.taskNumber || task.taskName);\n    }\n  }\n  return parts.join(', ');\n}\n\nfunction associationHtml(tasks) {\n  if (!tasks.length) {\n    return 'Line-level Update';\n  }\n  var html = '<ul style=\"padding-left:20px;padding-right:20px;\">';\n  for (var i = 0; i < tasks.length; i++) {\n    var task = tasks[i];\n    html += '<li><strong>' + htmlEscape(task.taskNumber) + '</strong>';\n    if (task.taskName) {\n      html += ' ' + htmlEscape(task.taskName);\n    }\n    html += '</li>';\n  }\n  html += '</ul>';\n  return html;\n}\n\nfunction changeType(action) {\n  var text = normalizeString(action).toUpperCase();\n  return text === 'CREATE' || text === 'NEW' ? 'CREATE' : 'UPDATE';\n}\n\nfunction displayType(type) {\n  return type === 'CREATE' ? 'New Contract Line' : 'Update Existing Contract Line';\n}\n\nfunction typeBadge(type) {\n  if (type === 'CREATE') {\n    return '<span class=\"oj-badge oj-badge-warning oj-badge-subtle\">New</span>';\n  }\n  return '<span class=\"oj-badge oj-badge-info oj-badge-subtle\">Update</span>';\n}\n\nfunction buildRows(data, currency) {\n  var lineChanges = asArray(data.ContractLineChanges);\n  var rows = [];\n  for (var i = 0; i < lineChanges.length; i++) {\n    var change = lineChanges[i] || {};\n    var type = changeType(firstNonEmpty([change.Action, change.Status, 'UPDATE']));\n    var oldAmount = toNumber(change.OldLineAmount);\n    var newAmount = toNumber(change.LineAmount);\n    var delta = type === 'CREATE' ? newAmount : newAmount - oldAmount;\n    var tasks = taskAssociationValues(change, data);\n    rows.push({\n      type: displayType(type),\n      action: type,\n      line: normalizeString(firstNonEmpty([change.LineNumber, change.LineId, String(i + 1)])),\n      name: normalizeString(firstNonEmpty([change.LineName, change.ItemNameTxt, change.LineId, String(i + 1)])),\n      from: type === 'CREATE' ? null : monetaryValue(oldAmount, currency),\n      to: monetaryValue(newAmount, currency),\n      change: monetaryValue(delta, currency),\n      projectAssociation: associationText(tasks),\n      projectAssociationTasks: tasks\n    });\n  }\n  return rows;\n}\n\nfunction buildTableHtml(rows, currency) {\n  if (!rows.length) {\n    return '';\n  }\n  var tableStyle = 'width:100%;border:1px solid #ccced1;border-radius:8px;border-collapse:separate;border-spacing:0;overflow:hidden';\n  var headerStyle = 'padding:6px;text-align:left;background-color:#ededed;border-bottom:1px solid #ccced1';\n  var cellStyle = 'padding:6px;text-align:left;border-bottom:1px solid #ccced1';\n  var html = '<table style=\"' + tableStyle + '\"><thead><tr>';\n  var headers = ['Type', 'Line', 'Name', 'From', 'To', 'Change', 'Project Association'];\n  for (var h = 0; h < headers.length; h++) {\n    html += '<th style=\"' + headerStyle + '\">' + headers[h] + '</th>';\n  }\n  html += '</tr></thead><tbody>';\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n    html += '<tr>';\n    html += '<td style=\"' + cellStyle + '\">' + typeBadge(row.action) + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + htmlEscape(row.line) + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + htmlEscape(row.name) + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + (row.action === 'CREATE' ? '-' : htmlEscape(formatPlainAmount(row.from.amount, currency, false))) + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + htmlEscape(formatPlainAmount(row.to.amount, currency, false)) + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + amountBadge(row.change.amount, currency, row.action !== 'CREATE', row.action === 'CREATE' ? 'oj-badge-success' : '') + '</td>';\n    html += '<td style=\"' + cellStyle + '\">' + associationHtml(row.projectAssociationTasks) + '</td>';\n    html += '</tr>';\n  }\n  html += '</tbody></table>';\n  return html;\n}\n\nfunction buildLegacyHtml(data, implementationMessages, rows, currency, contractNumber, totalNetChange) {\n  var html = '<div class=\"bubble\">';\n  html += '<div><strong>Here is the summary of the implemented changes along with proposed contract changes</strong></div>';\n  html += '<br>';\n  for (var i = 0; i < implementationMessages.length; i++) {\n    html += '<div class=\"caption\"> • ' + htmlEscape(implementationMessages[i]) + '</div><br>';\n  }\n  html += '<div class=\"caption\"> • Proposed contract lines changes for Contract → ' + htmlEscape(contractNumber) + ' :</div><br>';\n  html += buildTableHtml(rows, currency);\n  if (toNumber(totalNetChange) !== 0) {\n    var netClass = toNumber(totalNetChange) > 0 ? 'oj-badge-success' : 'oj-badge-danger';\n    var netLabel = toNumber(totalNetChange) > 0 ? 'Total net increase: ' : 'Total net decrease: ';\n    html += '<br><div class=\"caption\"><strong>• ' + netLabel + '</strong>' + amountBadge(totalNetChange, currency, true, netClass) + '</div>';\n  }\n  html += '<br>';\n  html += '<div>Review the proposed changes and reply Accept to proceed or Reject to cancel.</div>';\n  html += '</div>';\n  return html;\n}\n\nvar data = parseMaybe(v.prjPjeVarUqImpactDetailsChanges);\nvar currencyCode = normalizeString(firstNonEmpty([data.currencyCode, data.CurrencyCode, v.prjPjeVarUqContractCurrencyCode, v.prjPjeVarUqCurrencyCode]));\nvar contractNumber = normalizeString(firstNonEmpty([data.ContractNumber, v.prjPjeVarUqContractNumber]));\nvar totalNetChange = toNumber(firstNonEmpty([data.TotalNetChange, data.totalNetChange, 0]));\nvar implementationMessages = buildImplementationMessages(data);\nvar rows = buildRows(data, currencyCode);\nvar closingMessage = 'Review the proposed changes and reply Accept to proceed or Reject to cancel.';\nvar legacyHtml = buildLegacyHtml(data, implementationMessages, rows, currencyCode, contractNumber, totalNetChange);\nvar messages = ['Here is the summary of the implemented changes along with proposed contract changes'];\nfor (var m = 0; m < implementationMessages.length; m++) {\n  messages.push(implementationMessages[m]);\n}\nmessages.push('Proposed contract lines changes for Contract → ' + contractNumber + '.');\nmessages.push(closingMessage);\n\nreturn {\n  kind: 'contractReviewWithChanges',\n  intent: 'IMPLEMENT_CHANGE_ORDER',\n  title: 'Change Order Implementation Review',\n  description: closingMessage,\n  message: closingMessage,\n  contractNumber: contractNumber,\n  currencyCode: currencyCode,\n  totalNetChange: totalNetChange,\n  implementationMessages: implementationMessages,\n  contractLineRows: rows,\n  count: rows.length,\n  messages: messages,\n  legacyHtmlKey: 'contractReviewWithChanges',\n  legacyHtml: legacyHtml\n};"
          },
