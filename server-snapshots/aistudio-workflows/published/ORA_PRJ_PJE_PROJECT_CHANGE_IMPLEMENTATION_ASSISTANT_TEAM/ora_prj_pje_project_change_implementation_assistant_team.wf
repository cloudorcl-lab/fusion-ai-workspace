            "y": 20296
          }
        },
        {
          "metadata": {
            "name": "Update Link Level For Contract Lines",
            "returnType": "object",
            "sourceCode": "const allContractLineLinkages =  $context.$variables.prjPjeVarUqContractLineLinkages;\n\nconst taskDetailsMap = $context.$variables.prjPjeVarUqTasksDetailsMap;\n\n  // Process allContractLineLinkages to add LinkTopTaskId and TaskLevel\n  for (let key in allContractLineLinkages) {\n    let linkage = allContractLineLinkages[key];\n    let projElementId = linkage.ProjElementId;\n    if (taskDetailsMap[projElementId]) {\n      let details = taskDetailsMap[projElementId];\n      linkage.LinkTaskTopTaskId = details.TopTaskId;\n      linkage.LinkTaskLevel = details.TaskLevel;\n    }\n  }\n\nreturn allContractLineLinkages;"
          },
          "outcomes": {
            "success": "1771348423476"
          },
          "code": "PRJ_PJE_CODE_UPDATE_LINK_LEVEL_FOR_CONTRACT_LINES",
          "id": "1772455307883",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 6327,
            "y": 18022
          }
        },
        {
          "metadata": {
            "name": "Set Task Details"
          },
          "outcomes": {
            "success": "1772455307883"
          },
          "code": "PRJ_PJE_SET_FIELDS_SET_TASK_DETAILS",
          "id": "1772457093281",
          "inputs": [
            {
              "id": "1772457100418",
              "name": "prjPjeVarUqTasksDetailsMap",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.PRJ_PJE_CODE_COLLECT_TASK_DETAILS.$output.result}}"
            }
          ],
          "type": "SET_FIELDS",
          "diagram": {
            "x": 6369,
            "y": 17800
          }
        },
        {
          "metadata": {
            "name": "Analyse Linkage Level"
          },
          "outcomes": {
            "success": "1772520241543"
          },
          "code": "PRJ_PJE_LLM_ANALYSE_LINKAGE_LEVEL",
          "id": "1772518842560",
          "inputs": [
            {
              "id": "1772518842561_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a list of new contract line linkages and existing contract line linkages. Analyse the existing contract line linkages and suggest what should be the linkage level for the new contract line linkages.\n\n\n### Existing Contract Line Linkages:\n\n{{$context.$nodes.PRJ_PJE_CODE_CAPTURE_DETAILS_TO_CREATE_NEW_LINES.$output.result.contractLineLinkagesForLLM}}\n \n### New Contract Line Linkages:\n\n{{$context.$nodes.PRJ_PJE_CODE_CAPTURE_DETAILS_TO_CREATE_NEW_LINES.$output.result.newImpactDetailsChanges.ContractLineLinkChanges}}\n\n\n### Instructions:\n\n1. Analyze all `LinkTaskLevel` values in the Existing Contract Line Linkages.\n2. Determine the `LinkTaskLevel` that has the **maximum number of occurrences**.\n3. If multiple `LinkTaskLevel` values have the same highest number of occurrences, select the **smallest (least) numeric value** among them.\n4. Treat the identified value as the `RequiredLinkLevel` for all New Contract Line Linkages.\n5. For each object in the New Contract Line Linkages array:\n\n   * Add a new field called `RequiredLinkLevel` using the value determined above.\n6. Return only the following attributes in the response:\n\n   * `LinkId`\n   * `RequiredLinkLevel`\n7. The output must be a valid JSON array.\n8. Do not include explanations, comments, or additional fields in the response.\n\n### Sample Output Format:\n\n```json\n[\n  {\n    \"LinkId\": \"-300119212282429258\",\n    \"RequiredLinkLevel\": 1\n  },\n  {\n    \"LinkId\": \"-300119212562770027\",\n    \"RequiredLinkLevel\": 1\n  }\n]\n```\n\nReturn only the final JSON result."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"LinkId\", \"RequiredLinkLevel\"],\n        \"properties\": {\n          \"LinkId\": {\n            \"type\": \"string\"\n          },\n          \"RequiredLinkLevel\": {\n            \"type\": \"integer\",\n            \"minimum\": 0\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\"result\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM",
          "diagram": {
            "x": 5556,
            "y": 20518
          }
        },
        {
          "metadata": {
            "name": "Consolidate Create Lines and Linkages",
            "returnType": "object",
            "sourceCode": "let impactDetailsChanges = $context.$variables.prjPjeVarUqImpactDetailsChanges;\n\nlet tasksDetailsMap = $context.$variables.prjPjeVarUqTasksDetailsMap;\n\nlet contractLines =  $context.$variables.prjPjeVarUqContractLines;\n\nlet cllChanges = impactDetailsChanges.ContractLineLinkChanges;\n\nlet clChanges = impactDetailsChanges.ContractLineChanges;\n\nlet linkageAnalysis = $context.$nodes.PRJ_PJE_LLM_ANALYSE_LINKAGE_LEVEL.$output.result;\n\n\n// Update cllChanges with RequiredLinkLevel for each item in linkageAnalysis\nlinkageAnalysis.forEach(item => {\n  const matchingChange = cllChanges.find(change => change.LinkId === item.LinkId);\n  if (matchingChange) {\n    matchingChange.RequiredLinkLevel = item.RequiredLinkLevel;\n  }\n});\n\n// Identify parent task at RequiredLinkLevel and update RequiredLinkTaskId\ncllChanges.forEach(change => {\n  if (change.RequiredLinkLevel !== undefined) {\n    let currentId = change.ProjElementId;\n    let currentLevel = tasksDetailsMap[currentId]?.TaskLevel ?? change.TaskLevel;\n    let targetLevel = change.RequiredLinkLevel;\n\n    while (currentLevel > targetLevel && tasksDetailsMap[currentId] && tasksDetailsMap[currentId].ParentTaskId) {\n      currentId = tasksDetailsMap[currentId].ParentTaskId;\n      currentLevel = tasksDetailsMap[currentId].TaskLevel;\n    }\n\n    if (currentLevel === targetLevel) {\n      change.RequiredLinkTaskId = currentId;\n    }\n  }\n});\n\n// Group cllChanges by RequiredLinkTaskId\nconst cllGroups = {};\ncllChanges.forEach(change => {\n  if (change.RequiredLinkTaskId) {\n    const taskId = change.RequiredLinkTaskId;\n    if (!cllGroups[taskId]) {\n      cllGroups[taskId] = [];\n    }\n    cllGroups[taskId].push(change);\n  }\n});\n\n// Process each group\nfor (const [taskId, group] of Object.entries(cllGroups)) {\n  const lineIds = [...new Set(group.map(c => c.LineId))];\n  const correspondingClChanges = clChanges.filter(cl => lineIds.includes(cl.LineId));\n  \n  if (correspondingClChanges.length > 1) {\n    // Consolidate multiple clChanges\n    const firstCl = correspondingClChanges[0];\n    const oldLineAmount = correspondingClChanges.reduce((sum, cl) => sum + parseFloat(cl.OldLineAmount || 0), 0);\n    const lineAmountDelta = correspondingClChanges.reduce((sum, cl) => {\n      const delta = cl.LineAmountDelta !== undefined && cl.LineAmountDelta !== null && cl.LineAmountDelta !== ''\n        ? parseFloat(cl.LineAmountDelta || 0)\n        : parseFloat(cl.LineAmount || 0) - parseFloat(cl.OldLineAmount || 0);\n      return sum + delta;\n    }, 0);\n    const consolidated = Object.assign({}, firstCl, {\n      OldLineAmount: oldLineAmount,\n      LineAmountDelta: lineAmountDelta,\n      LineAmount: oldLineAmount + lineAmountDelta\n    });\n\n    // Remove originals\n    clChanges = clChanges.filter(cl => !lineIds.includes(cl.LineId));\n    // Add consolidated\n    clChanges.push(consolidated);\n    // Update LineId in cllChange group to consolidated LineId\n    group.forEach(c => { c.LineId = consolidated.LineId; });\n  }\n}\n\n// Consolidate cllChanges by RequiredLinkTaskId, summing FundingAmount and OldFundingAmount if present\nconst consolidatedCllChanges = [];\nfor (const [taskId, group] of Object.entries(cllGroups)) {\n  if (group.length > 1) {\n    const first = group[0];\n    const consolidated = { ...first };\n    consolidated.FundingAmount = group.reduce((sum, change) => sum + change.FundingAmount, 0);\n    if (first.OldFundingAmount !== undefined) {\n      consolidated.OldFundingAmount = group.reduce((sum, change) => sum + parseFloat(change.OldFundingAmount || 0), 0);\n    }\n    // Remove specified attributes from consolidated object\n    delete consolidated.ProjElementId;\n    delete consolidated.TaskLevel;\n    delete consolidated.TaskNumber;\n    delete consolidated.Id;\n    delete consolidated.LinkId;\n    delete consolidated.LineNumber;\n    // Preserve other fields from first item\n    consolidatedCllChanges.push(consolidated);\n  } else {\n    const single = { ...group[0] };\n    // Remove specified attributes from single item\n    delete single.ProjElementId;\n    delete single.TaskLevel;\n    delete single.TaskNumber;\n    delete single.Id;\n    delete single.LinkId;\n    delete single.LineNumber;\n    consolidatedCllChanges.push(single);\n  }\n}\n\n// Handle non-grouped items (e.g., FOUND items without RequiredLinkTaskId)\nconst nonGrouped = cllChanges.filter(change => !change.RequiredLinkTaskId);\nnonGrouped.forEach(item => {\n  // Remove specified attributes from non-grouped items\n  if(item.Action != 'UPDATE'){\n    delete item.ProjElementId;\n    delete item.TaskLevel;\n    delete item.TaskNumber;\n    delete item.Id;\n    delete item.LinkId;\n    delete item.LineNumber;\n  }\n\n});\n\ncllChanges = [...consolidatedCllChanges, ...nonGrouped];\n\n// Add array of CLProjElementId objects to each clChange after consolidation\n// clChanges.forEach(clChange => {\n//   clChange.TaskLinkages = cllChanges\n//     .filter(cll => cll.LineId === clChange.LineId && cll.CLProjElementId)\n//     .map(cll => ({ \n//       CLProjElementId: cll.CLProjElementId,\n//       TaskNumber: tasksDetailsMap[cll.CLProjElementId] ? tasksDetailsMap[cll.CLProjElementId].TaskNumber : '',\n//       TaskName: tasksDetailsMap[cll.CLProjElementId] ? tasksDetailsMap[cll.CLProjElementId].TaskName : ''\n//     }));\n// });\n\nimpactDetailsChanges.ContractLineLinkChanges = cllChanges;\nimpactDetailsChanges.ContractLineChanges = clChanges;\n\n\nconst createContractLines = clChanges.filter(cl => cl.Action === \"CREATE\").map(cl => ({ Id: cl.Id, LineTypeId: cl.LineTypeId }));\n\nconst contractLinesForAnalysis = [];\nfor (const [lineId, details] of Object.entries(contractLines)) {\n  contractLinesForAnalysis.push({\n    LineName: details.LineName,\n    LineNumber: details.LineNumber\n  })\n}\n\n\n\nlet data = {};\ndata.ImpactDetailsChanges = impactDetailsChanges;\ndata.linkageAnalysis = linkageAnalysis;\ndata.createContractLines = createContractLines;\ndata.contractLines = contractLines;\ndata.contractLinesForAnalysis = contractLinesForAnalysis;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1772523552788"
          },
          "code": "PRJ_PJE_CODE_CONSOLIDATE_CREATE_LINES_AND_LINKAGES",
          "id": "1772520241543",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
