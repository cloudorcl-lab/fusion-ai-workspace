        {
          "metadata": {
            "name": "Capture Contract",
            "returnType": "object",
            "sourceCode": "let projDetails = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_PROJECT_DETAILS.$output.items;\nlet contractsResponse=  $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_PROJECT_CONTRACTS.$output.items;\nlet currentDate = $context.$system.$currentDate;\n\nlet contract = {};\ncontract.contractId = -1;\ncontract.status = 'NONE';\ncontract.contractUniqueId = -1;\ncontract.contractLines = [];\ncontract.date = currentDate;\ncontract.currencyCode = 'NA';\nlet projectName = projDetails?.[0]?.name || projDetails?.[0]?.projectNumber;\ncontract.message = `Active Contract not found for Project: ${projectName}`;\n\nlet uniqueContractNumbers = [...new Set(contractsResponse.map(c => c.ContractNumber).filter(Boolean))];\nif(uniqueContractNumbers.length === 0){\n      contract.status = 'NO_CONTRACT';\n      contract.message = `No Contract is associated to Project: ${projectName}`;\n} else if(uniqueContractNumbers.length > 1 ){\n      contract.status = 'MULTIPLE_CONTRACTS';\n      contract.message = `Multiple Contracts associated to Project: ${projectName}`;\n} else {\n      let anyContractInActiveStatus = contractsResponse.filter( c => c.StsCode == 'ACTIVE' && c.VersionType == 'C');\n      if(anyContractInActiveStatus.length == 1){\n            let activeContract = anyContractInActiveStatus[0];\n            let projectCurrencyCode = projDetails?.[0]?.projectCurrency?.currencyCode;\n\n            if(projectCurrencyCode && activeContract.CurrencyCode !== projectCurrencyCode){\n                  contract.status = 'CURRENCY_MISMATCH';\n                  contract.currencyCode = activeContract.CurrencyCode;\n                  contract.message = `Currency mismatch between Project:${projectName} and Contract:${activeContract.ContractNumber} → ${projectCurrencyCode} vs ${activeContract.CurrencyCode}`;\n            } else {\n                  contract.contractId = activeContract.ContractId;\n                  contract.status = 'FOUND';\n                  contract.contractNumber = activeContract.ContractNumber;\n                  contract.currencyCode = activeContract.CurrencyCode;\n                  contract.contractUniqueId = activeContract.Id;\n                  contract.contractLines = activeContract.ContractLine;\n                  let contractDate = activeContract.StartDate;\n                  contract.amendDate = currentDate >= activeContract.StartDate ? currentDate :  activeContract.StartDate;\n                  contract.message = 'Active contract found successfully';\n            }\n      }\n}\n\n//console.log(contract);\nreturn contract;"
          },
          "outcomes": {
            "success": "1770279709582"
          },
          "code": "PRJ_PJE_CODE_CAPTURE_CONTRACT",
