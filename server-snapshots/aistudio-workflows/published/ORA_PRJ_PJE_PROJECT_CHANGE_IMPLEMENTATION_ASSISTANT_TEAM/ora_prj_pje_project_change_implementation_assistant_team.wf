                {
                  "metadata": {
                    "name": "Generate Update Contract Line Payload",
                    "returnType": "object",
                    "sourceCode": "function toNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return 0;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? 0 : value;\n  }\n  var parsed = Number(String(value).replace(/,/g, ''));\n  return isNaN(parsed) ? 0 : parsed;\n}\n\nfunction hasValue(value) {\n  return value !== null && value !== undefined && String(value).trim() !== '';\n}\n\nlet data = {};\nlet currentItem = $context.$nodes.PRJ_PJE_LOOP_PROCESS_CONTRACT_LINES_CHANGES.$currentItem || {};\nlet oldLineAmount = toNumber(currentItem.OldLineAmount);\nlet lineAmountDelta = hasValue(currentItem.LineAmountDelta)\n  ? toNumber(currentItem.LineAmountDelta)\n  : toNumber(currentItem.LineAmount) - oldLineAmount;\n\n// Contract line update expects the final line amount, not only the net change.\ndata.LineAmount = oldLineAmount + lineAmountDelta;\n\nlet oldComments = currentItem.Comments || '';\n\nlet name = $context.$variables.prjPjeVarUqChangeOrderName;\nlet number = $context.$variables.prjPjeVarUqChangeOrderNumber;\nlet reason = $context.$variables.prjPjeVarUqChangeOrderReason;\nlet newComments = `Change Order Name: ${name}; Number: ${number}; Reason: ${reason}; Change Amount: ${lineAmountDelta};`;\ndata.Comments = oldComments + newComments;\n\nreturn data;"
                  },
                  "outcomes": {
                    "success": "1771500764390"
                  },
                  "diagram": {
                    "x": 5051.5,
                    "y": 9221
                  },
                  "code": "PRJ_PJE_CODE_GENERATE_UPDATE_CONTRACT_LINE_PAYLOAD",
                  "id": "1773320310507",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
