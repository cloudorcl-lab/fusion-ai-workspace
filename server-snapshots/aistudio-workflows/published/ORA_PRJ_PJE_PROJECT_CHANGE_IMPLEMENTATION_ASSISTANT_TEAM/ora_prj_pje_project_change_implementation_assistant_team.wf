        {
          "metadata": {
            "name": "Build User Message for Contract Prohibition",
            "returnType": "object",
            "sourceCode": "var v = $context.$variables || {};\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return {};\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return {};\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction htmlEscape(value) {\n  return normalizeString(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction isTrueValue(value) {\n  if (value === true) {\n    return true;\n  }\n  var text = normalizeString(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === 'completed';\n}\n\nfunction isCompletedStatus(value) {\n  return normalizeString(value).toLowerCase() === 'completed';\n}\n\nfunction buildImplementationMessages(status) {\n  var messages = [];\n  if (isTrueValue(status.ImplementProjectPlanPolicy) && isCompletedStatus(status.ImplementProjectPlanStatus)) {\n    var projectPlanMessage = 'Project plan changes have been implemented successfully.';\n    if (isTrueValue(status.BaselineProjectPlanPolicy) && isTrueValue(status.BaselineProjectPlanStatus)) {\n      projectPlanMessage = 'Project plan changes have been implemented successfully and the project plan has been baselined.';\n    }\n    messages.push(projectPlanMessage);\n  }\n  if (isTrueValue(status.ImplementBudgetsPolicy) && isCompletedStatus(status.ImplementBudgetsStatus)) {\n    messages.push('Budget and Forecast changes have been implemented.');\n  }\n  return messages;\n}\n\nfunction buildLegacyHtml(implementationMessages, prohibitionMessage) {\n  var html = '<div class=\"bubble\">';\n  html += '<div><strong>Here is the summary of the implemented changes</strong></div>';\n  html += '<br>';\n  for (var i = 0; i < implementationMessages.length; i++) {\n    html += '<div class=\"caption\"> • ' + htmlEscape(implementationMessages[i]) + '</div><br>';\n  }\n  html += '<div class=\"caption\"> • ' + htmlEscape(prohibitionMessage) + '</div><br>';\n  html += '<br>';\n  html += '</div>';\n  return html;\n}\n\nvar status = parseMaybe(v.prjPjeVarUqChangeOrderProcessedStatus);\nvar implementationMessages = buildImplementationMessages(status);\nvar prohibitionMessage = 'Contract changes are skipped as they are prohibited by policy.';\nvar messages = ['Here is the summary of the implemented changes'];\nfor (var i = 0; i < implementationMessages.length; i++) {\n  messages.push(implementationMessages[i]);\n}\nmessages.push(prohibitionMessage);\n\nreturn {\n  kind: 'contractProhibition',\n  intent: 'IMPLEMENT_CHANGE_ORDER',\n  title: 'Contract changes skipped',\n  description: prohibitionMessage,\n  message: prohibitionMessage,\n  implementationMessages: implementationMessages,\n  prohibitionMessage: prohibitionMessage,\n  messages: messages,\n  legacyHtmlKey: 'contractProhibition',\n  legacyHtml: buildLegacyHtml(implementationMessages, prohibitionMessage)\n};"
          },
