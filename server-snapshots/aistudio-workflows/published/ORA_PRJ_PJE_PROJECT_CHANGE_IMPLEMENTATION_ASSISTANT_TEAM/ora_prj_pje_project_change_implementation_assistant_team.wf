        {
          "metadata": {
            "name": "Compute Total Revenue Impact",
            "returnType": "object",
            "sourceCode": "const impactDetails = $context.$variables.prjPjeVarUqImpactDetails || [];\n\nlet totalRevenueImpact = 0;\n\nfor (const detail of impactDetails) {\n  const revenue = Number(detail?.PCRevenue || 0);\n  if (!Number.isNaN(revenue)) {\n    totalRevenueImpact += revenue;\n  }\n}\n\nreturn {\n  totalRevenueImpact,\n  hasPositiveRevenueImpact: totalRevenueImpact > 0\n};"
          },
          "outcomes": {
            "success": "1777000000002"
          },
          "code": "PRJ_PJE_CODE_COMPUTE_TOTAL_REVENUE_IMPACT",
          "convergenceTargetId": "end",
          "id": "1777000000001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 6960,
            "y": 14860
          }
        },
        {
          "metadata": {
            "name": "Check Positive Revenue Impact"
          },
          "outcomes": {
            "true": "1770199872303",
            "false": "1777000000003"
          },
          "code": "PRJ_PJE_CONDITION_CHECK_POSITIVE_REVENUE_IMPACT",
          "convergenceTargetId": "1783000000303",
          "id": "1777000000002",
          "inputs": [
            {
              "id": "1777000000002_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJE_CODE_COMPUTE_TOTAL_REVENUE_IMPACT.$output.result.hasPositiveRevenueImpact == true}}"
            }
          ],
          "type": "CONDITION",
          "diagram": {
