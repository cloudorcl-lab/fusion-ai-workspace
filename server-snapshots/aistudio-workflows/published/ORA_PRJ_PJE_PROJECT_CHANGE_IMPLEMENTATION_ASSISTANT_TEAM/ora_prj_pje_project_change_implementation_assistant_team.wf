          "metadata": {
            "name": "Build Success Message",
            "returnType": "object",
            "sourceCode": "var v = $context.$variables || {};\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  return String(value).replace(/\\s+/g, ' ').trim();\n}\n\nvar contractNumber = normalizeString(v.prjPjeVarUqContractNumber);\nvar message = 'Implementation is completed. Contract ' + contractNumber + ' has been updated and submitted for approval.';\n\nreturn {\n  kind: 'successMessage',\n  intent: 'IMPLEMENT_CHANGE_ORDER',\n  title: 'Implementation completed',\n  description: message,\n  message: message,\n  contractNumber: contractNumber,\n  messages: [message],\n  legacyText: message\n};"
