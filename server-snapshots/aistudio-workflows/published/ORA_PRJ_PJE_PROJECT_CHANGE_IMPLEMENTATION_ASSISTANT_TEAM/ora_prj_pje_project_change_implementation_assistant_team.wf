\n  var blocks = [\n    buildTextBlock('I found ' + rows.length + ' change orders for ' + projectName + '. Choose one to implement:', 1, 'Project change orders')\n  ];\n  blocks.push(buildTableBlock(\n    'Change orders for ' + projectName + ' Project',\n    [\n      buildColumn('changeOrder', 'Change Order Number'),\n      buildColumn('summary', 'Summary'),\n      buildColumn('costImpact', 'Cost Impact'),\n      buildColumn('revenueImpact', 'Revenue Impact')\n    ],\n    rows,\n    2,\n    'This table lists change orders for ' + projectName\n  ));\n  return buildBaseContent('IMPLEMENT_CHANGE_ORDER', 'Change orders for ' + projectName, responseText, blocks);\n}\n\nfunction sanitizeDisplayBlock(block) {\n  if (!block || typeof block !== 'object') {\n    return block;\n  }\n  var sanitized = {};\n  for (var key in block) {\n    if (Object.prototype.hasOwnProperty.call(block, key)) {\n      sanitized[key] = block[key];\n    }\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'text')) {\n    sanitized.text = normalizeString(sanitized.text);\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'heading')) {\n    sanitized.heading = normalizeString(sanitized.heading);\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'description')) {\n    sanitized.description = normalizeString(sanitized.description);\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'title')) {\n    sanitized.title = normalizeString(sanitized.title);\n  }\n  if (sanitized.display_type === 'table') {\n    var tableColumns = asArray(sanitized.columns).map(function(column) {\n      var field = normalizeString(column.field || column.key);\n      return {\n        headerText: normalizeString(column.headerText || column.label),\n        field: field,\n        className: normalizeString(column.className),\n        resizable: normalizeString(column.resizable || 'enabled'),\n        id: normalizeString(column.id || field),\n        template: normalizeString(column.template)\n      };\n    });\n    var tableRows = asArray(sanitized.rows).map(function(row) {\n      var cleanRow = {};\n      for (var rowKey in row) {\n        if (Object.prototype.hasOwnProperty.call(row, rowKey)) {\n          cleanRow[rowKey] = normalizeString(row[rowKey]);\n        }\n      }\n      return cleanRow;\n    });\n    var keyField = tableColumns.length ? tableColumns[0].field : 'id';\n    sanitized.heading = normalizeString(sanitized.heading);\n    sanitized.columns = { items: tableColumns };\n    sanitized.rows = { items: tableRows };\n    sanitized.keyAttributes = { items: [keyField] };\n    sanitized.accessibility = sanitized.accessibility && typeof sanitized.accessibility === 'object'\n      ? sanitized.accessibility\n      : {};\n    sanitized.accessibility['aria-label'] = normalizeString(sanitized.accessibility['aria-label'] || ('This table lists ' + sanitized.heading));\n    sanitized.accessibility['row.accessible-row-header'] = normalizeString(sanitized.accessibility['row.accessible-row-header'] || keyField);\n  }\n  if (sanitized.display_type === 'card' && sanitized.attributes && typeof sanitized.attributes === 'object') {\n    var attrs = {};\n    for (var attrKey in sanitized.attributes) {\n      if (Object.prototype.hasOwnProperty.call(sanitized.attributes, attrKey)) {\n        attrs[normalizeString(attrKey)] = normalizeString(sanitized.attributes[attrKey]);\n      }\n    }\n    sanitized.attributes = attrs;\n  }\n  return sanitized;\n}\n\nfunction sanitizeContent(content) {\n  if (!content || typeof content !== 'object') {\n    return content;\n  }\n  var sanitized = {};\n  for (var key in content) {\n    if (Object.prototype.hasOwnProperty.call(content, key)) {\n      sanitized[key] = content[key];\n    }\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'title')) {\n    sanitized.title = normalizeString(sanitized.title);\n  }\n  if (Object.prototype.hasOwnProperty.call(sanitized, 'description')) {\n    sanitized.description = normalizeString(sanitized.description);\n  }\n  if (Array.isArray(sanitized.agent_response)) {\n    sanitized.agent_response = sanitized.agent_response.map(sanitizeDisplayBlock);\n  }\n  if (Array.isArray(sanitized.agentResponse)) {\n    sanitized.agentResponse = sanitized.agentResponse.map(sanitizeDisplayBlock);\n  }\n  return sanitized;\n}\n\nfunction buildFallbackTextBlocks(responseText) {\n  var text = normalizeString(responseText);\n  if (!text) {\n    return [buildTextBlock('', '1')];\n  }\n  var parts = text.split(/\\s*•\\s*/).filter(function(part) {\n    return normalizeString(part);\n  });\n  if (parts.length <= 1) {\n    parts = [text];\n  }\n  return parts.map(function(part, index) {\n    return buildTextBlock(part, String(index + 1));\n  });\n}\n\nfunction buildContent(responsePayload) {\n  var responseText = responseTextFromPayload(responsePayload);\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'contractLinesProcessingError') {\n    var contractErrorBlocks = asArray(responsePayload.messages).map(function(message, index) {\n      return buildTextBlock(message, String(index + 1));\n    });\n    if (!contractErrorBlocks.length) {\n      contractErrorBlocks = [buildTextBlock(responseText, '1')];\n    }\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Contract changes not processed',\n      responseText,\n      contractErrorBlocks\n    ));\n  }\n\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'projectNotFound') {\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Project not found',\n      responseText,\n      [buildTextBlock(responseText, '1')]\n    ));\n  }\n\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'invalidContractStatus') {\n    var invalidStatusBlocks = asArray(responsePayload.messages).map(function(message, index) {\n      return buildTextBlock(message, String(index + 1));\n    });\n    if (!invalidStatusBlocks.length) {\n      invalidStatusBlocks = [buildTextBlock(responseText, '1')];\n    }\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Contract changes not processed',\n      responseText,\n      invalidStatusBlocks\n    ));\n  }\n\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'successMessage') {\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Implementation completed',\n      responseText,\n      [buildTextBlock(responseText, '1')]\n    ));\n  }\n\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'noRevenueImpact') {\n    var noRevenueBlocks = asArray(responsePayload.messages).map(function(message, index) {\n      return buildTextBlock(message, String(index + 1));\n    });\n    if (!noRevenueBlocks.length) {\n      noRevenueBlocks = [buildTextBlock(responseText, '1')];\n    }\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Contract updates not needed',\n      responseText,\n      noRevenueBlocks\n    ));\n  }\n\n  if (responsePayload && typeof responsePayload === 'object' && responsePayload.kind === 'contractProhibition') {\n    var prohibitionBlocks = asArray(responsePayload.messages).map(function(message, index) {\n      return buildTextBlock(message, String(index + 1));\n    });\n    if (!prohibitionBlocks.length) {\n      prohibitionBlocks = [buildTextBlock(responseText, '1')];\n    }\n    return sanitizeContent(buildBaseContent(\n      responsePayload.intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'IMPLEMENT_CHANGE_ORDER',\n      responsePayload.title || 'Contract changes skipped',\n      responseText,\n      prohibitionBlocks\n    ));\n  }\n\n  var contractReviewContent = buildNativeContractReviewContent(responseText);\n  if (contractReviewContent) {\n    return sanitizeContent(contractReviewContent);\n  }\n\n  var contractReviewContent = buildNativeContractReviewContent(responseText);\n  if (contractReviewContent) {\n    return sanitizeContent(contractReviewContent);\n  }\n\n  var contractReviewContent = buildNativeContractReviewContent(responseText);\n  if (contractReviewContent) {\n    return sanitizeContent(contractReviewContent);\n  }\n\n  var parsed = safeJsonParse(responseText);\n  if (parsed && typeof parsed === 'object' && parsed.agent_response) {\n    return sanitizeContent(parsed);\n  }\n\n  var projectTableContent = buildNativeProjectChangeOrdersContent(responseText);\n  if (projectTableContent) {\n    return sanitizeContent(projectTableContent);\n  }\n\n  var pendingTableContent = buildNativePendingChangeOrdersContent(responseText);\n  if (pendingTableContent) {\n    return sanitizeContent(pendingTableContent);\n  }\n\n  var fallbackBlocks = buildFallbackTextBlocks(responseText);\n  var fallbackDescription = fallbackBlocks.length ? fallbackBlocks[0].text : responseText;\n  return sanitizeContent(buildBaseContent(\n    asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'CHANGE_IMPLEMENTATION',\n    'Project Change Implementation Assistant',\n    fallbackDescription,\n    fallbackBlocks\n  ));\n}\n\nvar currentApprovalContext = approvalContext();\nvar compactApproval = compactApprovalContext(currentApprovalContext);\nvar stateSnapshot = {\n  ContextProjectId: variable('prjPjeVarUqcontextProjectId'),\n  ContextType: variable('prjPjeVarUqcontextType'),\n  ContextValue: variable('prjPjeVarUqcontextValue'),\n  ProjectBusinessUnit: variable('prjPjeVarUqProjectBusinessUnit'),\n  ProjectId: variable('prjPjeVarUqProjectId'),\n  ChangeOrderId: variable('prjPjeVarUqChangeOrderId'),\n  ChangeOrderNumber: variable('prjPjeVarUqChangeOrderNumber'),\n  ChangeOrderName: variable('prjPjeVarUqChangeOrderName'),\n  ChangeOrderStage: variable('prjPjeVarUqChangeOrderStage'),\n  ChangeOrderReason: variable('prjPjeVarUqChangeOrderReason'),\n  ContractId: variable('prjPjeVarUqContractId'),\n  ContractNumber: variable('prjPjeVarUqContractNumber'),\n  ContractCurrencyCode: variable('prjPjeVarUqContractCurrencyCode'),\n  ChangeOrderProcessedStatus: variable('prjPjeVarUqChangeOrderProcessedStatus'),\n  ProjectPlanImplementationStatus: variable('prjPjeVarUqProjPlanImplementationStatus'),\n  BudgetImplementationStatus: variable('prjPjeVarUqBudgetsImplementationStatus'),\n  ProjectPlanBaselineStatus: variable('prjPjeVarUqProjPlanBaselineStatus'),\n  prjPjeVarConvRoutingContext: variable('prjPjeVarConvRoutingContext'),\n  prjPjeVarConvStrategicAgentChatHistory: variable('prjPjeVarConvStrategicAgentChatHistory'),\n  prjPjeVarConvStrategicAttachContent: variable('prjPjeVarConvStrategicAttachContent'),\n  prjPjeVarConvWorkflowStage: variable('prjPjeVarConvWorkflowStage'),\n  prjPjeVarConvLatestUserIntent: variable('prjPjeVarConvLatestUserIntent'),\n  prjPjeVarConvLatestUserMessage: variable('prjPjeVarConvLatestUserMessage'),\n  prjPjeVarConvLatestIntentConfidence: variable('prjPjeVarConvLatestIntentConfidence'),\n  prjPjeVarConvApprovalContext: compactApproval,\n  prjPjeVarConvReturnEnvelopeFlag: shouldReturnEnvelope() ? 'Y' : 'N'\n};\n\nvar contextDetails = {};\nfor (var key in stateSnapshot) {\n  if (Object.prototype.hasOwnProperty.call(stateSnapshot, key) && stateSnapshot[key] !== undefined) {\n    contextDetails[key] = stateSnapshot[key];\n  }\n}\n\nvar responsePayload = pickResponse();\nvar responseText = responseTextFromPayload(responsePayload);\nvar content = buildContent(responsePayload);\n// Contract Review Diagnostics Context Merge - Start\ncontextDetails.ContractReviewRowsCount = contractReviewDiagnostics.RowsCount;\ncontextDetails.ContractReviewDataSource = contractReviewDiagnostics.DataSource;\ncontextDetails.ContractReviewSkippedReason = contractReviewDiagnostics.SkippedReason;\n// Contract Review Diagnostics Context Merge - End\nvar contract = {\n  redwoodResponse: {\n    type: 'redwood',\n    content: content\n  },\n  atomicAgentDetails: {\n    atomicAgentCode: 'PROJECT_CHANGE_IMPLEMENTATION_ASSISTANT',\n    atomicAgentContext: 'Change Implementation Assistant',\n    contextDetails: contextDetails,\n    filters: null,\n    atomicAgentResponse: content\n  }\n};\n\nvar legacyResponse = responseText;\nif (responsePayload && typeof responsePayload === 'object') {\n  if (!isBlank(responsePayload.legacyHtml)) {\n    legacyResponse = asString(responsePayload.legacyHtml);\n  } else if (!isBlank(responsePayload.legacyText)) {\n    legacyResponse = asString(responsePayload.legacyText);\n  }\n}\nvar returnValue = shouldReturnEnvelope() ? JSON.stringify(contract) : legacyResponse;\n\nreturn {\n  response: responseText,\n  redwoodResponse: contract.redwoodResponse,\n  atomicAgentDetails: contract.atomicAgentDetails,\n  returnValue: returnValue\n};"
