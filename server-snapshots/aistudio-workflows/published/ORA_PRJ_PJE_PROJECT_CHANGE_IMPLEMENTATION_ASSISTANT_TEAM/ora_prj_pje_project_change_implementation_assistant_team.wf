        {
          "metadata": {
            "name": "Filter Implementation Pending Change Orders",
            "returnType": "array",
            "sourceCode": "let changeOrders = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_CHANGE_ORDERS_PENDING_IMPLEMENTATION.$output.items; \n\nlet changeOrdersInImplStage = changeOrders;\n\nchangeOrdersInImplStage = changeOrdersInImplStage.map(function(item) {\n  try {\n    // Gather every change impact detail for this change order.\n    const impactItems = (item.ChangeImpacts && item.ChangeImpacts.items) || [];\n    const currencyCodes = impactItems.reduce(function(acc, impact) {\n      if (impact.Currency && !acc.includes(impact.Currency)) {\n        acc.push(impact.Currency);\n      }\n      return acc;\n    }, []);\n    const currencyCode = currencyCodes.length > 0 ? currencyCodes[0] : null;\n\n    const changeImpactDetails = impactItems.reduce(function(acc, impact) {\n      const details = (impact.ChangeImpactDetails && impact.ChangeImpactDetails.items) || [];\n      return acc.concat(details);\n    }, []);\n\n    const totals = changeImpactDetails.reduce(function(acc, detail) {\n      const burdenedCost = parseFloat(detail.PCBurdenedCost);\n      const revenue = parseFloat(detail.PCRevenue);\n\n      if (!isNaN(burdenedCost)) {\n        acc.totalPCBurdenedCost += burdenedCost;\n      }\n\n      if (!isNaN(revenue)) {\n        acc.totalPCRevenue += revenue;\n      }\n\n      return acc;\n    }, { totalPCBurdenedCost: 0, totalPCRevenue: 0 });\n\n    return {\n      ChangeDocumentNumber: item.ChangeDocumentNumber,\n      Summary: item.Summary,\n      Description: item.Description || item.description,\n      Project: item.ProjectName,\n      ChangeDocumentId: item.ChangeDocumentId,\n      CurrencyCode: currencyCode,\n      TotalPCBurdenedCost: totals.totalPCBurdenedCost,\n      TotalPCRevenue: totals.totalPCRevenue\n    };\n  } catch (error) {\n    console.error('Failed to aggregate change impact details for change order', item.ChangeDocumentId, error);\n    return {\n      ChangeDocumentNumber: item.ChangeDocumentNumber,\n      Summary: item.Summary,\n      Description: item.Description || item.description,\n      Project: item.ProjectName,\n      ChangeDocumentId: item.ChangeDocumentId,\n      CurrencyCode: null,\n      TotalPCBurdenedCost: 0,\n      TotalPCRevenue: 0\n    };\n  }\n});\n\n//console.dir(changeOrdersInImplStage);\nreturn changeOrdersInImplStage;"
          },
          "outcomes": {
            "success": "1783000000011"
          },
          "code": "PRJ_PJE_CODE_FILTER_IMPLEMENTATION_PENDING_CHANGE_ORDERS",
          "id": "1771673320985",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 9111,
            "y": 6760
          }
        },
        {
          "metadata": {
            "name": "Build Change Orders List",
            "description": "",
            "returnType": "object",
            "sourceCode": "function nodeOutput(code) {\n  try {\n    var node = $context.$nodes ? $context.$nodes[code] : null;\n    return node ? node.$output : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction resultFromCode(code) {\n  var output = nodeOutput(code);\n  if (output && typeof output === 'object' && output.result !== undefined) {\n    return output.result;\n  }\n  return output;\n}\n\nfunction asString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction normalizeString(value) {\n  return asString(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return 0;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? 0 : value;\n  }\n  var parsed = Number(String(value).replace(/,/g, ''));\n  return isNaN(parsed) ? 0 : parsed;\n}\n\nfunction formatNumber(value) {\n  var numberValue = toNumber(value);\n  if (Math.round(numberValue) === numberValue) {\n    return String(numberValue);\n  }\n  return String(Math.round(numberValue * 100) / 100);\n}\n\nfunction truncateText(value, maxLength) {\n  var text = normalizeString(value);\n  if (!maxLength || text.length <= maxLength) {\n    return text;\n  }\n  return text.substring(0, maxLength - 3) + '...';\n}\n\nfunction escapeHtml(value) {\n  return normalizeString(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction impactBadge(value, currency) {\n  var numberValue = toNumber(value);\n  var sign = numberValue >= 0 ? '+' : '-';\n  var badgeClass = numberValue >= 0 ? 'oj-badge-success' : 'oj-badge-danger';\n  var text = sign + formatNumber(Math.abs(numberValue));\n  var currencyText = normalizeString(currency);\n  if (currencyText) {\n    text += ' ' + currencyText;\n  }\n  return '<span class=\"oj-badge ' + badgeClass + ' oj-badge-subtle\">' + escapeHtml(text) + '</span>';\n}\n\nvar changeOrders = asArray(resultFromCode('PRJ_PJE_CODE_FILTER_IMPLEMENTATION_PENDING_CHANGE_ORDERS'));\nvar count = changeOrders.length;\nvar noRecordsMessage = 'You have no change orders ready for implementation.';\n\nvar rows = [];\nfor (var i = 0; i < changeOrders.length; i++) {\n  var item = changeOrders[i] || {};\n  var currency = firstNonEmpty([item.CurrencyCode, item.Currency, item.ContractCurrencyCode]);\n  rows.push({\n    changeOrder: normalizeString(firstNonEmpty([item.ChangeDocumentNumber, item.ChangeOrderNumber, item.ChangeOrder])),\n    project: normalizeString(firstNonEmpty([item.Project, item.ProjectName, item.ProjectNumber])),\n    summary: truncateText(firstNonEmpty([item.Summary, item.Description, item.description]), 60),\n    costImpact: impactBadge(item.TotalPCBurdenedCost, currency),\n    revenueImpact: impactBadge(item.TotalPCRevenue, currency)\n  });\n}\n\nvar description = count === 0\n  ? noRecordsMessage\n  : 'I found ' + count + ' approved change orders ready to implement. Choose one to implement:';\n\nvar legacyHtml = noRecordsMessage;\nif (count > 0) {\n  var htmlRows = rows.map(function(row) {\n    return '<tr>\\n'\n      + '<td>' + escapeHtml(row.changeOrder) + '</td>\\n'\n      + '<td>' + escapeHtml(row.project) + '</td>\\n'\n      + '<td>' + escapeHtml(row.summary) + '</td>\\n'\n      + '<td>' + row.costImpact + '</td>\\n'\n      + '<td>' + row.revenueImpact + '</td>\\n'\n      + '</tr>';\n  }).join('\\n');\n  legacyHtml = '<div class=\"bubble\">\\n\\n'\n    + '<style>\\n'\n    + 'table{width:100%;border:1px solid #ccced1;border-radius:8px;border-collapse:separate;border-spacing:0;overflow:hidden}\\n'\n    + 'th{padding:6px;text-align:left;background:#ededed;border-bottom:1px solid #ccced1;white-space:nowrap}\\n'\n    + 'td{padding:6px;border-bottom:1px solid #ccced1}\\n'\n    + 'tbody tr:last-child td{border-bottom:none}\\n'\n    + '</style>\\n\\n'\n    + '<div style=\"margin-bottom:6px\">\\n'\n    + description + '\\n'\n    + '</div>\\n'\n    + '<br>\\n\\n'\n    + '<table>\\n'\n    + '<thead>\\n'\n    + '<tr>\\n'\n    + '<th>Change Order</th>\\n'\n    + '<th>Project</th>\\n'\n    + '<th>Summary</th>\\n'\n    + '<th>Cost Impact</th>\\n'\n    + '<th>Revenue Impact</th>\\n'\n    + '</tr>\\n'\n    + '</thead>\\n\\n'\n    + '<tbody>\\n\\n'\n    + htmlRows + '\\n\\n'\n    + '</tbody>\\n'\n    + '</table>\\n'\n    + '</div>';\n}\n\nreturn {\n  kind: 'changeOrdersList',\n  intent: 'FETCH_IMPLEMENTATION_PENDING_CHANGE_ORDERS',\n  title: count === 0 ? 'No change orders ready for implementation' : 'Approved change orders ready to implement',\n  description: description,\n  message: description,\n  count: count,\n  rows: rows,\n  messages: [description],\n  legacyHtmlKey: 'changeOrdersList',\n  legacyText: noRecordsMessage,\n  legacyHtml: legacyHtml\n};"
          },
          "outcomes": {
            "success": "1783000000303"
          },
          "code": "PRJ_PJE_CODE_BUILD_CHANGE_ORDERS_LIST",
