        {
          "metadata": {
            "name": "Analyse Change Order",
            "returnType": "object",
            "sourceCode": "const changeOrder = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_CHANGE_ORDER_DETAILS.$output.items[0];\nconst userEmail = $context.$nodes.PRJ_PJE_TOOL_USER_DETAILS.$output.items[0].EmailAddress;\nconst projDetails = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_PROJECT_DETAILS.$output.items[0];\n\nlet businessUnit = projDetails?.businessUnit?.name || 'NOT_FOUND';\n\nlet data;\ntry {\n  data = {\n    isValid: false,\n    projectId: changeOrder?.ProjectId || null,\n    stage: changeOrder?.Stage || 'UNKNOWN',\n    changeOrderName: changeOrder?.Name || null,\n    reason: changeOrder?.Reason || null,\n    participantId: -1,\n    participantImplStatus: 'NONE',\n    amendMethod: changeOrder?.ContractAmendmentMethod || 'UNKNOWN',\n  };\n\n  const participants = changeOrder?.ChangeParticipants?.items || [];\n\n  if (data.stage !== 'IMPLEMENTATION') {\n    data.status = `Change Order ${changeOrder?.ChangeDocumentNumber || 'Unknown'} is not in Implementation status`;\n  } else {\n    let participant = participants.find(\n      p => p?.ImplementationStatus === \"Completed\"\n    );\n\n    if (participant) {\n      data.participantImplStatus = participant.ImplementationStatus;\n      data.status = `Change Order ${changeOrder?.ChangeDocumentNumber || 'Unknown'} has already been implemented. Please choose a change order that is still pending implementation.`;\n    } else {\n      participant = participants.find(\n        p => p?.ParticipantEmail === userEmail\n      );\n\n      if (participant?.ImplementationFlag === true) {\n        data.participantImplStatus = participant.ImplementationStatus || 'NONE';\n        data.participantId = participant.ParticipantId || -1;\n        data.participantEmail = participant.ParticipantEmail || '';\n        data.status = 'Valid';\n        data.isValid = true;\n      } else {\n        data.status = `User doesn't have Implementation role for Change Order ${changeOrder?.ChangeDocumentNumber || 'Unknown'}`;\n        data.isValid = false;\n      }\n    }\n  }\n} catch (error) {\n  data = {\n    status: 'Error',\n    isValid: false,\n    projectId: changeOrder?.ProjectId || null,\n    stage: changeOrder?.Stage || 'UNKNOWN',\n    changeOrderName: changeOrder?.Name || null,\n    reason: changeOrder?.Reason || null,\n    participantId: -1,\n    participantImplStatus: 'NONE',\n    amendMethod: changeOrder?.ContractAmendmentMethod || 'UNKNOWN',\n    errorMessage: error?.message || 'Unexpected error while analyzing change order'\n  };\n}\ndata.businessUnit = businessUnit;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1773919630621"
          },
          "code": "PRJ_PJE_CODE_ANALYSE_CHANGE_ORDER",
