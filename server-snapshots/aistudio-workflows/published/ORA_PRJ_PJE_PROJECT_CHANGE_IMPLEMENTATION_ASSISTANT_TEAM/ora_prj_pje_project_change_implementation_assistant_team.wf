        {
          "metadata": {
            "name": "Extract Impacts",
            "returnType": "object",
            "sourceCode": "const impactsData = $context.$nodes.PRJ_PJE_BO_FUNCTION_FETCH_CHANGE_IMPACTS_AND_DETAILS.$output.items[0].ChangeImpacts.items;\n\nlet impactsType = 'NONE';\n\n// Determine impactsType using simple for loops\nfor (var x = 0; x < impactsData.length; x++) {\n  if (impactsData[x].Area === 'PROJECT_PLAN') {\n    impactsType = 'PROJECT_PLAN';\n    break;\n  }\n}\n\nif (impactsType === 'NONE') {\n  for (var y = 0; y < impactsData.length; y++) {\n    if (impactsData[y].Area === 'BUDGET_AND_FORECAST') {\n      impactsType = 'BUDGET_AND_FORECAST';\n      break;\n    }\n  }\n}\n\n//Collect Impacts, Impacted Tasks, Impact Details\nlet impactTasks = [];\nlet impactDetails = [];\n\nlet result = {\n  impactsType: impactsType,\n  impactTasks: [],\n  impacts: [],\n  impactDetails: []\n};\n\nfor (var i = 0; i < impactsData.length; i++) {\n  var impact = impactsData[i];\n  var outputImpact = {};\n\n  // Copy all top-level keys except nested metadata\n  var keys = Object.keys(impact);\n  for (var a = 0; a < keys.length; a++) {\n    var key = keys[a];\n    if (\n      key !== \"ChangeImpactDetails\" &&\n      key !== \"ChangeImpactTaskDetails\" &&\n      key !== \"@context\"\n    ) {\n      outputImpact[key] = impact[key];\n    }\n  }\n\n  // Handle ChangeImpactDetails\n  outputImpact.ChangeImpactDetails = { items: [] };\n  var details = impact.ChangeImpactDetails.items;\n\n  for (var j = 0; j < details.length; j++) {\n    var detail = {};\n    var detailKeys = Object.keys(details[j]);\n\n    for (var b = 0; b < detailKeys.length; b++) {\n      var dKey = detailKeys[b];\n      if (dKey !== \"@context\") {\n        detail[dKey] = details[j][dKey];\n      }\n     \n     //Capture Impacted TaskId\n      if(dKey == 'ProjElementId'){\n         impactTasks.push(details[j][dKey]);\n      }\n    }\n\n    outputImpact.ChangeImpactDetails.items.push(detail);\n\timpactDetails.push(detail);\n  }\n\n  // Handle ChangeImpactTaskDetails\n  outputImpact.ChangeImpactTaskDetails = { items: [] };\n  var taskItems = impact.ChangeImpactTaskDetails.items;\n\n  for (var k = 0; k < taskItems.length; k++) {\n    var task = {};\n    var taskKeys = Object.keys(taskItems[k]);\n\n    for (var c = 0; c < taskKeys.length; c++) {\n      var tKey = taskKeys[c];\n      if (tKey !== \"@context\") {\n        task[tKey] = taskItems[k][tKey];\n      }\n    }\n\n    outputImpact.ChangeImpactTaskDetails.items.push(task);\n  }\n\n  result.impacts.push(outputImpact);\n}\n\nresult.impactTasks = impactTasks;\nresult.impactDetails = impactDetails;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770286090444"
          },
