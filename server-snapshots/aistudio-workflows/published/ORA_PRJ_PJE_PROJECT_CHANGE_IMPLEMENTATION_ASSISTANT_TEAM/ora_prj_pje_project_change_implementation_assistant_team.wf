          "code": "PRJ_PJE_BO_FUNCTION_FETCH_TASK_DETAILS",
          "id": "1771348312986",
          "inputs": [
            {
              "id": "1773139014431_1",
              "name": "projectId",
              "type": "string",
              "value": "{{$context.$variables.prjPjeVarUqProjectId}}"
            },
            {
              "id": "1773139014432_2",
