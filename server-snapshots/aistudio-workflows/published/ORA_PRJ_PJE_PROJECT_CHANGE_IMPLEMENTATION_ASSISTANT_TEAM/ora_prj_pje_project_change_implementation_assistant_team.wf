            "name": "Build Parent Response Contract",
            "returnType": "object",
            "sourceCode": "function variable(name) {\n  try {\n    return $context.$variables ? $context.$variables[name] : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction restInput() {\n  try {\n    return ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) || {};\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction nodeOutput(code) {\n  try {\n    var node = $context.$nodes ? $context.$nodes[code] : null;\n    return node ? node.$output : null;\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction asString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value === 'string') {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction stripDisplayMarkup(value) {\n  return asString(value)\n    .replace(/```html|```/gi, ' ')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>');\n}\n\nfunction normalizeString(value) {\n  return stripDisplayMarkup(value).replace(/\\s+/g, ' ').trim();\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction asArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n  return [];\n}\n\nfunction firstNonEmpty(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value !== null && value !== undefined && String(value).trim() !== '') {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction parseMaybe(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (typeof value === 'object') {\n    return value;\n  }\n  if (typeof value !== 'string') {\n    return null;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction toNumber(value) {\n  if (value === null || value === undefined || value === '') {\n    return 0;\n  }\n  if (typeof value === 'number') {\n    return isNaN(value) ? 0 : value;\n  }\n  var parsed = Number(String(value).replace(/,/g, ''));\n  return isNaN(parsed) ? 0 : parsed;\n}\n\nfunction formatNumber(value) {\n  var numberValue = toNumber(value);\n  if (Math.round(numberValue) === numberValue) {\n    return String(numberValue);\n  }\n  return String(Math.round(numberValue * 100) / 100);\n}\n\nfunction formatAmount(value, currency) {\n  var numberValue = toNumber(value);\n  var sign = numberValue > 0 ? '+' : numberValue < 0 ? '-' : '';\n  var amount = sign + formatNumber(Math.abs(numberValue));\n  var currencyText = normalizeString(currency);\n  return currencyText ? amount + ' ' + currencyText : amount;\n}\n\nfunction formatMonetaryValue(value, currency) {\n  var amount = formatNumber(toNumber(value));\n  var currencyText = normalizeString(currency);\n  return currencyText ? '{amount:' + amount + ',currency:' + currencyText + '}' : '{amount:' + amount + '}';\n}\n\nfunction truncateText(value, maxLength) {\n  var text = normalizeString(value);\n  if (!maxLength || text.length <= maxLength) {\n    return text;\n  }\n  return text.substring(0, maxLength - 3) + '...';\n}\n\nfunction changeOrderSummaryText(item) {\n  return truncateText(firstNonEmpty([\n    item && item.Summary,\n    item && item.Description,\n    item && item.description\n  ]), 60);\n}\n\nfunction resultFromCode(code) {\n  var output = nodeOutput(code);\n  if (output && typeof output === 'object' && output.result !== undefined) {\n    return output.result;\n  }\n  return output;\n}\n\nfunction responsePayloadFromNode(code) {\n  var output = nodeOutput(code);\n  if (output && typeof output === 'object' && output.result !== undefined) {\n    output = output.result;\n  }\n  return output;\n}\n\nfunction responseTextFromPayload(payload) {\n  if (payload && typeof payload === 'object') {\n    return firstNonEmpty([\n      payload.message,\n      payload.description,\n      payload.text,\n      payload.title\n    ]);\n  }\n  return asString(payload);\n}\n\nfunction outputText(code) {\n  return responseTextFromPayload(responsePayloadFromNode(code));\n}\n\nfunction isContractReviewTurn() {\n  if (!isBlank(outputText('PRJ_PJE_CODE_BUILD_USER_MESSAGE_WITH_CHANGES'))) {\n    return true;\n  }\n  return normalizeString(variable('prjPjeVarConvWorkflowStage')) === 'WAIT_CONTRACT_APPROVAL_DECISION';\n}\n\nfunction routingContext() {\n  var input = restInput();\n  return firstNonEmpty([\n    variable('prjPjeVarConvRoutingContext'),\n    variable('prjPjeRoutingContext'),\n    variable('prjPjfRoutingContext'),\n    input.prjPjeRoutingContext,\n    input.prjPjfRoutingContext,\n    input.source,\n    variable('source')\n  ]);\n}\n\nfunction shouldReturnEnvelope() {\n  var flag = firstNonEmpty([\n    variable(\"prjPjeVarConvReturnEnvelopeFlag\")\n  ]);\n  if (flag) {\n    var normalizedFlag = String(flag).trim().toUpperCase();\n    return normalizedFlag === \"Y\" || normalizedFlag === \"TRUE\";\n  }\n  return String(routingContext() || \"\").toLowerCase() === \"redwoodui\";\n}\n\nfunction approvalContext() {\n  return parseMaybe(variable('prjPjeVarConvApprovalContext')) || variable('prjPjeVarConvApprovalContext') || {};\n}\n\nfunction compactApprovalContext(ctx) {\n  ctx = ctx || {};\n  var names = [\n    'prjPjeVarUqcontextProjectId',\n    'prjPjeVarUqcontextValue',\n    'prjPjeVarUqcontextType',\n    'prjPjeVarUqProjectBusinessUnit',\n    'prjPjeVarUqChangeOrderReason',\n    'prjPjeVarUqChangeOrderName',\n    'prjPjeVarUqIsProjectLinkageContract',\n    'prjPjeVarUqChangeOrderProcessedStatus',\n    'prjPjeVarUqChangeOrderNumber',\n    'prjPjeVarUqProjPlanBaselineStatus',\n    'prjPjeVarUqBudgetsImplementationStatus',\n    'prjPjeVarUqProjPlanImplementationStatus',\n    'prjPjeVarUqContractCurrencyCode',\n    'prjPjeVarUqErrorMessage',\n    'prjPjeVarUqanyNewContractLines',\n    'prjPjeVarUqlineTypeId',\n    'prjPjeVarUqbillPlanId',\n    'prjPjeVarUqrevenuePlanId',\n    'prjPjeVarUqContractNumber',\n    'prjPjeVarUqAmendedImpactDetailsChanges',\n    'prjPjeVarUqImpactDetailsSavedChanges',\n    'prjPjeVarUqTempObject',\n    'prjPjeVarUqAnyErrorInImpactDetailsChanges',\n    'prjPjeVarUqImpactDetailsChanges',\n    'prjPjeVarUqImpactDetails',\n    'prjPjeVarUqContractLineLinkages',\n    'prjPjeVarUqNewTasksData',\n    'prjPjeVarUqloopVariable',\n    'prjPjeVarUqTempImpactedTasksIds',\n    'prjPjeVarUqTasksDetailsMap',\n    'prjPjeVarUqisTaskDetailsRequired',\n    'prjPjeVarUqImpactedTasks',\n    'prjPjeVarUqImpacts',\n    'prjPjeVarUqContractLines',\n    'prjPjeVarUqNewContractLineAmount',\n    'prjPjeVarUqContractLineAmount',\n    'prjPjeVarUqContractAmendDate',\n    'prjPjeVarUqContractUniqueId',\n    'prjPjeVarUqTemp',\n    'prjPjeVarUqParticipantEmail',\n    'prjPjeVarUqPolicyOptions',\n    'prjPjeVarUqParticipantStatus',\n    'prjPjeVarUqChangeOrderStage',\n    'prjPjeVarUqContractLineId',\n    'prjPjeVarUqParticipantResourceId',\n    'prjPjeVarUqParticipantId',\n    'prjPjeVarUqHasBudgetImpacts',\n    'prjPjeVarUqHasProjectPlanImpacts',\n    'prjPjeVarUqAmendmentEffectiveDate',\n    'prjPjeVarUqChangeOrderId',\n    'prjPjeVarUqContractId',\n    'prjPjeVarUqProjectId'\n  ];\n  var compact = {};\n  for (var i = 0; i < names.length; i++) {\n    var name = names[i];\n    if (Object.prototype.hasOwnProperty.call(ctx, name) && ctx[name] !== undefined) {\n      compact[name] = ctx[name];\n    }\n  }\n  compact.contractReviewRows = asArray(ctx.contractReviewRows);\n  compact.contractReviewRowCount = ctx.contractReviewRowCount || compact.contractReviewRows.length;\n  compact.contractReviewDataSource = ctx.contractReviewDataSource || (compact.contractReviewRows.length ? 'prjPjeVarUqImpactDetailsChanges' : 'none');\n  compact.contractReviewSkippedReason = ctx.contractReviewSkippedReason || (compact.contractReviewRows.length ? '' : 'no_contract_line_changes');\n  compact.prjPjeVarConvWorkflowStage = firstNonEmpty([\n    ctx.prjPjeVarConvWorkflowStage,\n    variable('prjPjeVarConvWorkflowStage')\n  ]);\n  compact.prjPjeVarConvLatestUserIntent = firstNonEmpty([\n    ctx.prjPjeVarConvLatestUserIntent,\n    variable('prjPjeVarConvLatestUserIntent')\n  ]);\n  compact.prjPjeVarConvLatestUserMessage = firstNonEmpty([\n    ctx.prjPjeVarConvLatestUserMessage,\n    variable('prjPjeVarConvLatestUserMessage')\n  ]);\n  compact.pendingApprovalNodeCode = firstNonEmpty([\n    ctx.pendingApprovalNodeCode,\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_WITH_CHANGES'\n  ]);\n  compact.changeOrderApprovalContextVersion = ctx.changeOrderApprovalContextVersion || '2';\n  return compact;\n}\n\nfunction pickResponse() {\n  var fetchByNumber = nodeOutput('PRJ_PJE_BO_FUNCTION_FETCH_CHANGE_ORDER_BY_NUMBER');\n  if (fetchByNumber && Array.isArray(fetchByNumber.items) && fetchByNumber.items.length === 0) {\n    return 'Unable to retrieve a change order ' + asString(variable('prjPjeVarUqcontextValue')) + ' . Please review and share a valid change order number pending for implementation.';\n  }\n\n  var decisionResult = resultFromCode('PRJ_PJE_CODE_RESOLVE_CONTRACT_APPROVAL_DECISION') || {};\n  var decision = asString(decisionResult.decision).trim().toUpperCase();\n  if (decision === 'REJECTED' || decision === 'UNKNOWN') {\n    return 'Change Order impacts have been successfully implemented. You may proceed to update the contract manually.';\n  }\n\n  var intent = asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')).trim();\n  var pendingApprovalContext = approvalContext();\n  var hasPendingApproval = !!(pendingApprovalContext && pendingApprovalContext.prjPjeVarConvWorkflowStage === 'WAIT_CONTRACT_APPROVAL_DECISION' && pendingApprovalContext.prjPjeVarUqContractId && pendingApprovalContext.prjPjeVarUqImpactDetailsChanges);\n  if (intent === 'DECIDE_CONTRACT_CHANGES' && !hasPendingApproval && !decision) {\n    return 'I could not find a pending contract approval review in the previous context. Please implement the change order first, then approve or reject the proposed contract changes.';\n  }\n\n  var terminalNodes = [\n    'PRJ_PJE_CODE_BUILD_PROJECT_NOT_FOUND_MESSAGE',\n    'PRJ_PJE_CODE_BUILD_CONTRACT_LINES_PROCESSING_ERROR_MESSAGE',\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_INVALID_CONTRACT_STATUS',\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_MULTIPLE_CHANGE_ORDER_IN_PROJECT_CONTEXT',\n    'PRJ_PJE_LLM_GENERATE_HELP_FOR_MISSING_CONTEXT',\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_NO_REVENUE_IMPACT',\n    'PRJ_PJE_LLM_OFF_TOPIC_HANDLER',\n    'PRJ_PJE_CODE_BUILD_CHANGE_ORDERS_LIST',\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_WITH_CHANGES',\n    'PRJ_PJE_CODE_BUILD_SUCCESS_MESSAGE',\n    'PRJ_PJE_CODE_BUILD_USER_MESSAGE_FOR_CONTRACT_PROHIBITION'\n  ];\n\n  for (var i = 0; i < terminalNodes.length; i++) {\n    var payload = responsePayloadFromNode(terminalNodes[i]);\n    var text = responseTextFromPayload(payload);\n    if (!isBlank(text)) {\n      return payload;\n    }\n  }\n\n  return 'I could not complete the change implementation request. Please review the change order details and try again.';\n}\n\nfunction safeJsonParse(value) {\n  if (typeof value !== 'string') {\n    return null;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction buildColumn(field, headerText) {\n  return {\n    headerText: headerText,\n    field: field,\n    className: '',\n    resizable: 'enabled',\n    id: field,\n    template: field === 'costImpact'\n      || field === 'revenueImpact'\n      || field === 'from'\n      || field === 'to'\n      || field === 'change'\n      || field === 'totalAmount'\n        ? 'monetaryTemplate'\n        : ''\n  };\n}\n\nfunction buildTextBlock(text, sequence, heading) {\n  return {\n    display_type: 'text',\n    display_sequence: sequence,\n    text: normalizeString(text)\n  };\n}\n\nfunction buildTableBlock(heading, columns, rows, sequence, ariaLabel) {\n  var tableColumns = asArray(columns);\n  var key = tableColumns.length ? tableColumns[0].field : 'id';\n  return {\n    display_type: 'table',\n    display_sequence: String(sequence),\n    heading: normalizeString(heading),\n    rows: { items: asArray(rows) },\n    columns: { items: tableColumns },\n    keyAttributes: { items: [key] },\n    accessibility: {\n      'aria-label': ariaLabel || ('This table lists ' + normalizeString(heading)),\n      'row.accessible-row-header': key\n    }\n  };\n}\n\nfunction buildCardBlock(title, description, attributes, sequence) {\n  return {\n    display_type: 'card',\n    display_sequence: sequence,\n    title: normalizeString(title),\n    description: normalizeString(description),\n    attributes: attributes || {}\n  };\n}\n\nfunction buildActionBlock(sequence) {\n  return {\n    display_type: 'action',\n    display_sequence: String(sequence),\n    actions: {\n      items: ['Approve', 'Reject']\n    }\n  };\n}\n\nfunction buildBaseContent(intent, title, description, blocks) {\n  return {\n    agent: 'project_change_implementation_assistant',\n    intent: intent || asString(nodeOutput('PRJ_PJE_LLM_IDENTIFY_USER_INTENT')) || 'CHANGE_IMPLEMENTATION',\n    schema_version: '1',\n    title: normalizeString(title || 'Project Change Implementation Assistant'),\n    description: normalizeString(description),\n    timestamp: new Date().toISOString(),\n    agent_response: asArray(blocks)\n  };\n}\n\nfunction getCurrencyFromChangeOrder(changeOrder) {\n  var impacts = asArray(changeOrder && changeOrder.ChangeImpacts);\n  for (var i = 0; i < impacts.length; i++) {\n    var impact = impacts[i] || {};\n    var currency = firstNonEmpty([impact.Currency, impact.CurrencyCode, impact.ContractCurrencyCode]);\n    if (currency) {\n      return currency;\n    }\n    var details = asArray(impact.ChangeImpactDetails);\n    for (var d = 0; d < details.length; d++) {\n      var detail = details[d] || {};\n      currency = firstNonEmpty([detail.Currency, detail.CurrencyCode, detail.ContractCurrencyCode]);\n      if (currency) {\n        return currency;\n      }\n    }\n  }\n  return firstNonEmpty([changeOrder && changeOrder.CurrencyCode, changeOrder && changeOrder.Currency, variable('prjPjeVarUqContractCurrencyCode')]);\n}\n\nfunction sumNestedImpactDetails(changeOrder, fieldName) {\n  var total = 0;\n  var impacts = asArray(changeOrder && changeOrder.ChangeImpacts);\n  for (var i = 0; i < impacts.length; i++) {\n    var details = asArray(impacts[i] && impacts[i].ChangeImpactDetails);\n    for (var d = 0; d < details.length; d++) {\n      total += toNumber(details[d] && details[d][fieldName]);\n    }\n  }\n  return total;\n}\n\nfunction changeOrderImpactAmount(changeOrder, topLevelField, nestedField) {\n  var topLevel = changeOrder && changeOrder[topLevelField];\n  if (topLevel !== null && topLevel !== undefined && String(topLevel).trim() !== '') {\n    return toNumber(topLevel);\n  }\n  return sumNestedImpactDetails(changeOrder, nestedField);\n}\n\nfunction buildPendingChangeOrderRows() {\n  var rows = [];\n  var items = asArray(resultFromCode('PRJ_PJE_CODE_FILTER_IMPLEMENTATION_PENDING_CHANGE_ORDERS'));\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i] || {};\n    var currency = firstNonEmpty([item.CurrencyCode, item.Currency, item.ContractCurrencyCode, variable('prjPjeVarUqContractCurrencyCode')]);\n    rows.push({\n      changeOrder: firstNonEmpty([item.ChangeDocumentNumber, item.ChangeOrderNumber, item.ChangeOrder, 'row' + (i + 1)]),\n      project: firstNonEmpty([item.Project, item.ProjectName, item.ProjectNumber]),\n      summary: changeOrderSummaryText(item),\n      costImpact: formatMonetaryValue(item.TotalPCBurdenedCost, currency),\n      revenueImpact: formatMonetaryValue(item.TotalPCRevenue, currency)\n    });\n  }\n  return rows;\n}\n\nfunction buildProjectContextChangeOrderRows() {\n  var rows = [];\n  var output = nodeOutput('PRJ_PJE_BO_FUNCTION_FETCH_CHANGE_ORDERS_PENDING_IMPLEMENTATION_BY_PROJECT');\n  var items = asArray(output && output.items);\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i] || {};\n    var currency = getCurrencyFromChangeOrder(item);\n    rows.push({\n      changeOrder: firstNonEmpty([item.ChangeDocumentNumber, item.ChangeOrderNumber, item.ChangeOrder, 'row' + (i + 1)]),\n      summary: changeOrderSummaryText(item),\n      costImpact: formatMonetaryValue(changeOrderImpactAmount(item, 'TotalPCBurdenedCost', 'PCBurdenedCost'), currency),\n      revenueImpact: formatMonetaryValue(changeOrderImpactAmount(item, 'TotalPCRevenue', 'PCRevenue'), currency)\n    });\n  }\n  return rows;\n}\n\nfunction buildNativePendingChangeOrdersContent(responseText) {\n  var rows = buildPendingChangeOrderRows();\n  if (!rows.length || isBlank(outputText('PRJ_PJE_CODE_BUILD_CHANGE_ORDERS_LIST'))) {\n    return null;\n  }\n  var blocks = [\n    buildTextBlock('I found ' + rows.length + ' approved change orders ready to implement. Choose one to implement:', 1, 'Approved change orders')\n  ];\n  blocks.push(buildTableBlock(\n    'Approved change orders ready to implement',\n    [\n      buildColumn('changeOrder', 'Change Order'),\n      buildColumn('project', 'Project'),\n      buildColumn('summary', 'Summary'),\n      buildColumn('costImpact', 'Cost Impact'),\n      buildColumn('revenueImpact', 'Revenue Impact')\n    ],\n    rows,\n    2,\n    'This table lists approved change orders ready to implement'\n  ));\n  return buildBaseContent('FETCH_IMPLEMENTATION_PENDING_CHANGE_ORDERS', 'Approved change orders ready to implement', responseText, blocks);\n}\n\nfunction formatAction(value) {\n  var text = normalizeString(value).toUpperCase();\n  if (text === 'CREATE' || text === 'NEW') {\n    return 'New Contract Line';\n  }\n  if (text === 'UPDATE' || text === 'FOUND') {\n    return 'Update Existing Contract Line';\n  }\n  return 'Update Existing Contract Line';\n}\n\nfunction hasContractLineChanges(value) {\n  return !!(value && typeof value === 'object' && asArray(value.ContractLineChanges).length);\n}\n\n// Contract Review Diagnostics Helpers - Start\nvar contractReviewDiagnostics = {\n  RowsCount: 0,\n  DataSource: 'none',\n  SkippedReason: ''\n};\n\nfunction setContractReviewDiagnostics(rowsCount, dataSource, skippedReason) {\n  contractReviewDiagnostics.RowsCount = rowsCount || 0;\n  contractReviewDiagnostics.DataSource = dataSource || contractReviewDiagnostics.DataSource || 'none';\n  contractReviewDiagnostics.SkippedReason = skippedReason || '';\n}\n\nfunction contractReviewContextObject() {\n  var ctx = approvalContext();\n  return parseMaybe(ctx) || ctx || {};\n}\n\nfunction contractReviewStateSnapshot(ctx) {\n  return parseMaybe(ctx && ctx.stateJson) || {};\n}\n\nfunction normalizePrebuiltContractReviewRow(row, index) {\n  row = row || {};\n  return {\n    type: normalizeString(firstNonEmpty([row.type, row.changeType, row.ChangeType, 'Update Existing Contract Line'])),\n    line: normalizeString(firstNonEmpty([row.line, row.lineNumber, row.LineNumber, String(index + 1)])),\n    name: normalizeString(firstNonEmpty([row.name, row.lineName, row.LineName, row.itemName, String(index + 1)])),\n    from: normalizeString(firstNonEmpty([row.from, row.currentAmount, row.CurrentAmount, row.OldLineAmount])),\n    to: normalizeString(firstNonEmpty([row.to, row.proposedAmount, row.ProposedAmount, row.LineAmount])),\n    change: normalizeString(firstNonEmpty([row.change, row.netChange, row.NetChange])),\n    projectAssociation: normalizeString(firstNonEmpty([row.projectAssociation, row.associatedProjectTask, row.AssociatedProjectTask]))\n  };\n}\n\nfunction prebuiltContractReviewRows() {\n  var ctx = contractReviewContextObject();\n  var state = contractReviewStateSnapshot(ctx);\n  var candidates = [\n    { source: 'approvalContext.contractReviewRows', value: ctx.contractReviewRows },\n    { source: 'approvalContext.ContractReviewRows', value: ctx.ContractReviewRows },\n    { source: 'approvalContext.stateJson.contractReviewRows', value: state.contractReviewRows },\n    { source: 'approvalContext.stateJson.ContractReviewRows', value: state.ContractReviewRows }\n  ];\n  for (var i = 0; i < candidates.length; i++) {\n    var rows = asArray(candidates[i].value);\n    if (rows.length) {\n      setContractReviewDiagnostics(rows.length, candidates[i].source, '');\n      return rows.map(normalizePrebuiltContractReviewRow);\n    }\n  }\n  return [];\n}\n// Contract Review Diagnostics Helpers - End\n\nfunction contractReviewData() {\n  var currentApprovalContext = contractReviewContextObject();\n  var state = contractReviewStateSnapshot(currentApprovalContext);\n  var candidates = [\n    { source: 'variable.prjPjeVarUqImpactDetailsChanges', value: variable('prjPjeVarUqImpactDetailsChanges') },\n    { source: 'approvalContext.prjPjeVarUqImpactDetailsChanges', value: currentApprovalContext && currentApprovalContext.prjPjeVarUqImpactDetailsChanges },\n    { source: 'approvalContext.ImpactDetailsChanges', value: currentApprovalContext && currentApprovalContext.ImpactDetailsChanges },\n    { source: 'approvalContext.impactDetailsChanges', value: currentApprovalContext && currentApprovalContext.impactDetailsChanges },\n    { source: 'approvalContext.stateJson.prjPjeVarUqImpactDetailsChanges', value: state && state.prjPjeVarUqImpactDetailsChanges },\n    { source: 'approvalContext.stateJson.ImpactDetailsChanges', value: state && state.ImpactDetailsChanges },\n    { source: 'approvalContext.stateJson.impactDetailsChanges', value: state && state.impactDetailsChanges },\n    { source: 'approvalContext', value: currentApprovalContext },\n    { source: 'approvalContext.stateJson', value: state }\n  ];\n  for (var i = 0; i < candidates.length; i++) {\n    var parsed = parseMaybe(candidates[i].value) || candidates[i].value;\n    if (hasContractLineChanges(parsed)) {\n      setContractReviewDiagnostics(asArray(parsed.ContractLineChanges).length, candidates[i].source, '');\n      return parsed;\n    }\n  }\n  for (var j = 0; j < candidates.length; j++) {\n    var fallback = parseMaybe(candidates[j].value) || candidates[j].value;\n    if (fallback && typeof fallback === 'object') {\n      setContractReviewDiagnostics(0, candidates[j].source, 'no_contract_line_changes');\n      return fallback;\n    }\n  }\n  setContractReviewDiagnostics(0, 'none', 'no_contract_review_data');\n  return {};\n}\n\nfunction contractAssociationForLine(lineChange, linkChanges) {\n  function pushUnique(values, value) {\n    var text = normalizeString(value);\n    if (!text) {\n      return;\n    }\n    for (var i = 0; i < values.length; i++) {\n      if (values[i] === text) {\n        return;\n      }\n    }\n    values.push(text);\n  }\n\n  function taskDetailsFor(taskMap, taskId) {\n    if (taskId === null || taskId === undefined || taskId === '') {\n      return {};\n    }\n    return taskMap[taskId] || taskMap[String(taskId)] || {};\n  }\n\n  function taskAssociationText(link, taskMap) {\n    var taskId = firstNonEmpty([\n      link.RequiredLinkTaskId,\n      link.CLProjElementId,\n      link.ProjElementId,\n      link.LineTaskTopTaskId\n    ]);\n    var taskDetails = taskDetailsFor(taskMap, taskId);\n    var taskNumber = normalizeString(firstNonEmpty([\n      link.TaskNumber,\n      link.CLTaskNumber,\n      link.ProjectOrTaskNumber,\n      taskDetails.TaskNumber,\n      taskId\n    ]));\n    var taskName = normalizeString(firstNonEmpty([\n      link.TaskName,\n      link.ProjectOrTaskName,\n      link.ProjElementName,\n      taskDetails.TaskName\n    ]));\n    if (taskNumber && taskName && taskNumber !== taskName) {\n      return taskNumber + ' ' + taskName;\n    }\n    return taskNumber || taskName;\n  }\n\n  var values = [];\n  var taskMap = variable('prjPjeVarUqTasksDetailsMap') || {};\n  var lineId = lineChange && lineChange.LineId;\n  for (var i = 0; i < linkChanges.length; i++) {\n    var link = linkChanges[i] || {};\n    if (lineId && link.LineId && String(link.LineId) !== String(lineId)) {\n      continue;\n    }\n    pushUnique(values, taskAssociationText(link, taskMap));\n  }\n  return values.join(', ');\n}\n\nfunction buildContractReviewRows() {\n  var data = contractReviewData();\n  var lineChanges = asArray(data.ContractLineChanges);\n  var linkChanges = asArray(data.ContractLineLinkChanges);\n  var currency = firstNonEmpty([variable('prjPjeVarUqContractCurrencyCode'), variable('prjPjeVarUqCurrencyCode')]);\n  var rows = [];\n  for (var i = 0; i < lineChanges.length; i++) {\n    var change = lineChanges[i] || {};\n    var oldAmount = toNumber(change.OldLineAmount);\n    var newAmount = toNumber(change.LineAmount);\n    rows.push({\n      type: formatAction(firstNonEmpty([change.Action, change.Status, 'Update'])),\n      line: normalizeString(firstNonEmpty([change.LineNumber, change.LineId, String(i + 1)])),\n      name: normalizeString(firstNonEmpty([change.LineName, change.ItemNameTxt, change.LineId, String(i + 1)])),\n      from: formatMonetaryValue(oldAmount, currency),\n      to: formatMonetaryValue(newAmount, currency),\n      change: formatMonetaryValue(newAmount - oldAmount, currency),\n      projectAssociation: normalizeString(contractAssociationForLine(change, linkChanges))\n    });\n  }\n  if (rows.length) {\n    setContractReviewDiagnostics(rows.length, contractReviewDiagnostics.DataSource, '');\n    return rows;\n  }\n  var storedRows = prebuiltContractReviewRows();\n  if (storedRows.length) {\n    return storedRows;\n  }\n  setContractReviewDiagnostics(0, contractReviewDiagnostics.DataSource, contractReviewDiagnostics.SkippedReason || 'no_contract_line_changes');\n  return [];\n}\n\nfunction isTrueValue(value) {\n  if (value === true) {\n    return true;\n  }\n  var text = normalizeString(value).toLowerCase();\n  return text === 'true' || text === 'y' || text === 'yes' || text === 'completed';\n}\n\nfunction isCompletedStatus(value) {\n  return normalizeString(value).toLowerCase() === 'completed';\n}\n\nfunction statusOrNA(value) {\n  return normalizeString(value) || 'NA';\n}\n\nfunction buildImplementationStatusBlocks(data, startSequence) {\n  var blocks = [buildTextBlock('Here is the summary of the implemented changes', String(startSequence))];\n  var sequence = startSequence + 1;\n  var hasStatus = false;\n  var projectPlanStatus = firstNonEmpty([data.ImplementProjectPlanStatus, variable('prjPjeVarUqProjPlanImplementationStatus')]);\n  var baselineStatus = firstNonEmpty([data.BaselineProjectPlanStatus, variable('prjPjeVarUqProjPlanBaselineStatus')]);\n  var budgetStatus = firstNonEmpty([data.ImplementBudgetsStatus, data.ImplementBudgetStatus, variable('prjPjeVarUqBudgetsImplementationStatus')]);\n  var changeOrderStatus = firstNonEmpty([\n    data.Status,\n    variable('prjPjeVarUqChangeOrderProcessedStatus'),\n    variable('prjPjeVarUqChangeOrderStatus')\n  ]);\n\n  if (isTrueValue(data.ImplementProjectPlanPolicy)) {\n    hasStatus = true;\n    var projectPlanMessage = isCompletedStatus(projectPlanStatus)\n      ? 'Project plan changes have been implemented successfully.'\n      : 'Project plan changes implementation status: ' + statusOrNA(projectPlanStatus) + '.';\n    if (isCompletedStatus(projectPlanStatus) && isTrueValue(data.BaselineProjectPlanPolicy) && isTrueValue(baselineStatus)) {\n      projectPlanMessage = 'Project plan changes have been implemented successfully and the project plan has been baselined.';\n    }\n    blocks.push(buildTextBlock(projectPlanMessage, String(sequence++)));\n  }\n\n  if (isTrueValue(data.ImplementBudgetsPolicy)) {\n    hasStatus = true;\n    var budgetMessage = isCompletedStatus(budgetStatus)\n      ? 'Budget and Forecast changes have been implemented.'\n      : 'Budget and Forecast changes implementation status: ' + statusOrNA(budgetStatus) + '.';\n    blocks.push(buildTextBlock(budgetMessage, String(sequence++)));\n  }\n\n  if (!hasStatus) {\n    blocks.push(buildTextBlock('Change order implementation status: ' + statusOrNA(changeOrderStatus) + '.', String(sequence++)));\n  }\n\n  return blocks;\n}\n\nfunction buildNativeContractReviewContent(responseText) {\n  if (!isContractReviewTurn()) {\n    setContractReviewDiagnostics(0, contractReviewDiagnostics.DataSource, 'not_contract_review_turn');\n    return null;\n  }\n  var rows = buildContractReviewRows();\n  if (!rows.length) {\n    setContractReviewDiagnostics(0, contractReviewDiagnostics.DataSource, contractReviewDiagnostics.SkippedReason || 'no_contract_line_changes');\n    return null;\n  }\n  var changeOrderNumber = normalizeString(variable('prjPjeVarUqChangeOrderNumber')) || normalizeString(variable('prjPjeVarUqcontextValue'));\n  var contractNumber = normalizeString(variable('prjPjeVarUqContractNumber'));\n  var projectName = normalizeString(firstNonEmpty([variable('prjPjeVarUqProjectName'), variable('prjPjeVarUqcontextProjectName'), variable('prjPjeVarUqcontextValue')]));\n  var currency = firstNonEmpty([variable('prjPjeVarUqContractCurrencyCode'), variable('prjPjeVarUqCurrencyCode')]);\n  var rowDataSource = contractReviewDiagnostics.DataSource;\n  var data = contractReviewData();\n  if (rowDataSource && rowDataSource.indexOf('contractReviewRows') !== -1) {\n    setContractReviewDiagnostics(rows.length, rowDataSource, '');\n  }\n  var totalNetChangeAmount = toNumber(data.TotalNetChange);\n  var totalNetChange = formatAmount(totalNetChangeAmount, currency);\n  var statusBlocks = buildImplementationStatusBlocks(data, 1);\n  var tableSequence = statusBlocks.length + 1;\n  var netChangeBlocks = [];\n  if (totalNetChangeAmount !== 0) {\n    var netChangeLabel = totalNetChangeAmount > 0 ? 'Total net increase: ' : 'Total net decrease: ';\n    netChangeBlocks.push(buildTextBlock(netChangeLabel + totalNetChange, String(tableSequence + 1)));\n  }\n  var reviewSequence = tableSequence + netChangeBlocks.length + 1;