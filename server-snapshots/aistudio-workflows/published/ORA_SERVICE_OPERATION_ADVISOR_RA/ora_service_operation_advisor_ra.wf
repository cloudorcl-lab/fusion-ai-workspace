          "code": "CURRENT_SR_INFO",
          "id": "1775102169329",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Process Open SR Data",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_SR_BY_QUERY.$output.items;\nconst result = {\n  srNumbers: [],\n  byStatus: {},\n  bySeverity: {}\n};\n\ndata.forEach(sr => {\n  const status = sr.StatusTypeCdMeaning;\n  const severity = sr.SeverityCdMeaning;\n  const srNumber = sr.SrNumber;\n\n  if (!status || !severity || !srNumber) return;\n\n  result.srNumbers.push(srNumber);\n\n  if (!result.byStatus[status]) {\n    result.byStatus[status] = 0;\n  }\n  result.byStatus[status]++;\n\n  if (!result.bySeverity[severity]) {\n    result.bySeverity[severity] = 0;\n  }\n  result.bySeverity[severity]++;\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775511437026"
          },
          "code": "PROCESS_OPEN_SR_DATA",
          "id": "1775237459478",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Form Open SR Query",
            "returnType": "string",
            "sourceCode": "const data = JSON.parse($context.$triggers.REST.$input.OraAction);\nconst srArray = data.srNumbers.split(\",\");\n\nreturn \"SrNumber IN (\" + srArray.map(n => `'${n}'`).join(\",\") + \")\";"
          },
          "outcomes": {
            "success": "1775238920997"
          },
          "code": "FORM_OPEN_SR_QUERY",
          "id": "1775238285035",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
