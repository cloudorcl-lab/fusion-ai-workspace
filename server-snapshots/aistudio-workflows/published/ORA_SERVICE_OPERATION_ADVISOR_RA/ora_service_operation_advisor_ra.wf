        {
          "metadata": {
            "name": "Form Stalled SR Query",
            "returnType": "string",
            "sourceCode": "let stalledSRs = $context.$nodes.GET_STALLED_SRS?.$output;\nlet excludedSRs = $context.$nodes.EXCLUDE_SRS?.$output;\n\n// Safely extract SR IDs\nlet stalledList = stalledSRs?.items?.map(item => item.SrId) || [];\nlet excludedList = excludedSRs?.items?.map(item => item.SrId) || [];\n\n// Remove excluded SRs\nlet finalSRs = stalledList.filter(sr => !excludedList.includes(sr));\n\n// Build output string\nlet result = finalSRs.length > 0\n  ? `SrId IN (${finalSRs.join(\",\")})`\n  : `SrId IN (-1)`;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774646510825"
          },
