          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Similar SR Count by Resolver",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.RANK_SIMILAR_SR_DETAILS_BY_SCORE.$output.result\nconst result = Object.values(\n  data.reduce((acc, row) => {\n    const key = row.ResolvedBy || \"UNKNOWN\";\n\n    if (!acc[key]) {\n      acc[key] = {\n        ResolvedBy: key,\n        SRCount: 0\n      };\n    }\n\n    acc[key].SRCount += 1;\n    return acc;\n  }, {})\n);\nreturn result;"
          },
          "outcomes": {
            "success": "1774391623362"
          },
          "code": "SIMILAR_SR_COUNT_BY_RESOLVER",
          "id": "1774892328972",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
