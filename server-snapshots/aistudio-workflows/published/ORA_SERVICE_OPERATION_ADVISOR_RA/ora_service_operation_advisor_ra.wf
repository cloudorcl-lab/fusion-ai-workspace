        {
          "metadata": {
            "name": "SRs Grouped by Severity",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst severityGrouping = {\n  High: {\n    total: 0,\n    srNumbers: [],\n    byStatus: { \"In Progress\": 0, \"Waiting\": 0 }\n  },\n  Medium: {\n    total: 0,\n    srNumbers: [],\n    byStatus: { \"In Progress\": 0, \"Waiting\": 0 }\n  },\n  Low: {\n    total: 0,\n    srNumbers: [],\n    byStatus: { \"In Progress\": 0, \"Waiting\": 0 }\n  }\n};\n\nfor (const row of data) {\n  const severity = row.SeverityCdMeaning;\n  const status = row.StatusTypeCdMeaning;\n  const srNumber = row.SrNumber;\n\n  if (!severityGrouping[severity]) continue; // ignore unexpected severity\n\n  severityGrouping[severity].total += 1;\n  if (srNumber) severityGrouping[severity].srNumbers.push(srNumber);\n\n  if (status === \"In Progress\" || status === \"Waiting\") {\n    severityGrouping[severity].byStatus[status] += 1;\n  }\n}\n\nseverityGrouping;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "SRS_GROUPED_BY_SEVERITY",
          "convergenceTargetId": "1775847512668",
          "id": "1775846632912",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SRs Grouped by Status",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items;\n\nconst result = {};\n\nfor (const row of data) {\n  const status = row.StatusTypeCdMeaning || \"Unknown\";\n  const severity = row.SeverityCdMeaning || \"Unknown\";\n  const srNumber = row.SrNumber || null;\n\n  // Initialize status group if not exists\n  if (!result[status]) {\n    result[status] = {\n      total: 0,\n      srNumbers: [],\n      bySeverity: {\n        High: 0,\n        Medium: 0,\n        Low: 0,\n        Unknown: 0\n      }\n    };\n  }\n\n  // Increment totals\n  result[status].total += 1;\n  if (srNumber) result[status].srNumbers.push(srNumber);\n\n  // Increment severity breakdown\n  if (!result[status].bySeverity[severity]) {\n    result[status].bySeverity[severity] = 0;\n  }\n  result[status].bySeverity[severity] += 1;\n}\n\nresult;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "SRS_GROUPED_BY_STATUS",
          "id": "1775847570194",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SRs Grouped by Reopens",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst reopenGrouping = {\n  Reopened: {\n    total: 0,\n    srNumbers: [],\n    bySeverity: { High: 0, Medium: 0, Low: 0 }\n  },\n  NotReopened: {\n    total: 0,\n    srNumbers: [],\n    bySeverity: { High: 0, Medium: 0, Low: 0 }\n  }\n};\n\nfor (const row of data) {\n  const severity = row.SeverityCdMeaning;\n  const srNumber = row.SrNumber;\n\n  const isReopened = row.LastReopenDate !== null && row.LastReopenDate !== undefined;\n  const key = isReopened ? \"Reopened\" : \"NotReopened\";\n\n  reopenGrouping[key].total += 1;\n  if (srNumber) reopenGrouping[key].srNumbers.push(srNumber);\n\n  if (severity === \"High\" || severity === \"Medium\" || severity === \"Low\") {\n    reopenGrouping[key].bySeverity[severity] += 1;\n  }\n}\n\nreopenGrouping;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "SRS_GROUPED_BY_REOPENS",
          "id": "1775847734864",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SRs Grouped by Product",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst productGrouping = {};\n\nfor (const row of data) {\n  const product = row.ProductItemDescription;\n  const severity = row.SeverityCdMeaning;\n  const srNumber = row.SrNumber;\n\n  // Normalize product name\n  const productName =\n    product !== null && product !== undefined && String(product).trim() !== \"\"\n      ? String(product).trim()\n      : \"Unknown\";\n\n  // Initialize group\n  if (!productGrouping[productName]) {\n    productGrouping[productName] = {\n      total: 0,\n      srNumbers: [],\n      bySeverity: { High: 0, Medium: 0, Low: 0 }\n    };\n  }\n\n  productGrouping[productName].total += 1;\n  if (srNumber) productGrouping[productName].srNumbers.push(srNumber);\n\n  if (severity === \"High\" || severity === \"Medium\" || severity === \"Low\") {\n    productGrouping[productName].bySeverity[severity] += 1;\n  }\n}\n\nproductGrouping;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "SRS_GROUPED_BY_PRODUCT",
          "id": "1775847977149",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SRs Grouped by Queue",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst queueGrouping = {};\n\nfor (const row of data) {\n  const queue = row.QueueName;\n  const severity = row.SeverityCdMeaning;\n  const srNumber = row.SrNumber;\n\n  // Normalize queue name\n  const queueName =\n    queue !== null && queue !== undefined && String(queue).trim() !== \"\"\n      ? String(queue).trim()\n      : \"Unknown\";\n\n  // Initialize group\n  if (!queueGrouping[queueName]) {\n    queueGrouping[queueName] = {\n      total: 0,\n      srNumbers: [],\n      bySeverity: { High: 0, Medium: 0, Low: 0 }\n    };\n  }\n\n  queueGrouping[queueName].total += 1;\n  if (srNumber) queueGrouping[queueName].srNumbers.push(srNumber);\n\n  if (severity === \"High\" || severity === \"Medium\" || severity === \"Low\") {\n    queueGrouping[queueName].bySeverity[severity] += 1;\n  }\n}\n\nqueueGrouping;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
