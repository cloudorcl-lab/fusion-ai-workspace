          "inputs": [
            {
              "id": "1776013627829_1",
              "name": "prompt",
              "type": "string",
              "value": "Based on the user request {{$context.$system.$inputMessage}}, extract the requested action and all relevant entities mentioned in the request.\n\nRequirements:\n- Identify the action, such as \"reassign\", \"add_team_member\", or another user-requested operation.\n- Extract all explicitly mentioned entities into an object.\n- Common entities may include:\n  - srNumber\n  - personName\n- Include any other relevant entities if they are explicitly present in the request.\n- Do not infer or guess missing values.\n- If the action is not clear, return null for action.\n- If no entities are found, return an empty object for entities.\n- If no valid SR number is explicitly present in the user request, set \"srNumber\" to null.\n\nReturn only a JSON object in this format:\n{\n  \"action\": \"<action or null>\",\n  \"entities\": {\n    \"srNumber\": \"<entityValue>\",\n    \"personName\":\"<entityValue>\",\n    ...\n  }\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"result\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Form Resource Query",
            "returnType": "string",
            "sourceCode": "const output = $context.$nodes.EXTRACT_ACTION_AND_ENTITIES.$output.result;\nconst personName = output?.entities?.personName;\n\nif (!personName) {\n  return \"\";\n}\n\nreturn `RecordSet='ORA_MYREPORTEES' and PartyName like '%${personName}%'`;"
          },
          "outcomes": {
            "success": "1776014284649"
          },
