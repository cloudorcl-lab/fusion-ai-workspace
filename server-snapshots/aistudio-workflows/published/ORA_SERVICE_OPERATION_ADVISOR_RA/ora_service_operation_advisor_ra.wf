        {
          "metadata": {
            "name": "Clean Up Stalled SR Details",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_SR_DETAILS.$output.items;\nconst severityRank = {\n  High: 1,\n  Medium: 2,\n  Low: 3,\n};\n\nconst cleanedData = (data|| [])\n  .map(({ [\"@context\"]: _, ...rest }) => rest)\n  .sort((a, b) => {\n    const rankA = severityRank[a.SeverityCdMeaning] ?? 999;\n    const rankB = severityRank[b.SeverityCdMeaning] ?? 999;\n\n    if (rankA !== rankB) {\n      return rankA - rankB;\n    }\n\n    return String(a.SrNumber || \"\").localeCompare(String(b.SrNumber || \"\"));\n  });\n\nreturn cleanedData;"
          },
          "outcomes": {
            "success": "1775072164073"
          },
