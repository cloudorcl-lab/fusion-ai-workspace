          "code": "REVENUE_ANSWER_BOT",
          "id": "1772222011990",
          "inputs": [
            {
              "id": "1772222011992_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a question: {{$context.$system.$inputMessage}}.\nRevenue information has been retrieved: {{$context.$nodes.GET_REVENUE.$output}}.\n\nInstructions:\n\nUse only the retrieved information to answer the question.\nIn your response, refer to the information as \"the information I retrieved\" or simply state facts, rather than using phrases like \"according to the data provided.\"\nPresent only the relevant business outcome (for example, amount spent or total revenue), not the underlying data source (such as opportunity).\nWhen presenting your answer, translate technical field names into plain, human-readable language\nSummarize the results clearly and concisely, without repeating information or being redundant."
            }
          ],
          "type": "LLM"
        },
