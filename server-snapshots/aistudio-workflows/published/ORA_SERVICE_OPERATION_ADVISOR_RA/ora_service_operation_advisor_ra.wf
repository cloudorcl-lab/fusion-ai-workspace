            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Form Alternative Finder Query",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_SR_MESSAGE_HISTORY.$output || {};\nconst items = Array.isArray(data.items) ? data.items : [];\n\nconst srData = {};\n\nconst groupedBySR = items.reduce((acc, item) => {\n  const srNumber = item?.SrNumber;\n  if (!srNumber) return acc;\n\n  if (!acc[srNumber]) {\n    acc[srNumber] = [];\n  }\n  acc[srNumber].push(item);\n  return acc;\n}, {});\n\nObject.keys(groupedBySR).forEach((srNumber) => {\n  const messages = groupedBySR[srNumber];\n\n  const actionHistory = messages\n    .filter((msg) => {\n      if (\n        msg?.MessageTypeCd !== \"ORA_SVC_AI_SYSTEM_NOTE\" ||\n        !msg?.MessageContent\n      ) {\n        return false;\n      }\n\n      try {\n        const parsed = JSON.parse(msg.MessageContent);\n        return (\n          parsed.workflowCode === \"ORA_SERVICE_OPERATIONS_WORKSPACE\" &&\n          (\n            parsed.ActionTaken === \"Reassign\" ||\n            parsed.ActionTaken === \"AddTeamMember\" ||\n            parsed.ActionTaken === \"Add Team Member\"\n          )\n        );\n      } catch (e) {\n        return false;\n      }\n    })\n    .map((msg) => {\n      let parsed = {};\n      try {\n        parsed = JSON.parse(msg.MessageContent);\n      } catch (e) {}\n\n      return {\n        CreationDate: msg?.CreationDate || \"\",\n        Summary: parsed.output?.Summary || \"\",\n        ActionTaken: parsed.ActionTaken || \"\"\n      };\n    });\n\n  const latestMsgDate =\n    actionHistory.length > 0\n      ? actionHistory\n          .map((msg) => new Date(msg.CreationDate))\n          .filter((d) => !isNaN(d.getTime()))\n          .reduce((a, b) => (a > b ? a : b), null)\n      : null;\n\n  srData[srNumber] = {\n    ActionHistory: actionHistory,\n    LatestMessageTimestamp: latestMsgDate ? latestMsgDate.toISOString() : \"\"\n  };\n});\n\nreturn srData;"
          },
          "outcomes": {
            "success": "1775672804161"
          },
          "code": "FORM_ALTERNATIVE_FINDER_QUERY",
          "id": "1775676417808",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
