          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"keywords\": {\n            \"type\": \"string\"\n        }\n    }\n}",
