            "name": "Check Assignee In Reportees",
            "returnType": "boolean",
            "sourceCode": "const srData = $context.$nodes.GET_SR_INFO.$output;\nconst reportees = $context.$nodes.GET_MY_REPORTEES.$output;\nconst assigneePartyId = srData.items[0]?.AssigneePartyId;\n\nconst isInReportees = reportees.items.some(\n  item => String(item.PartyId) === String(assigneePartyId)\n);\n\nisInReportees;"
