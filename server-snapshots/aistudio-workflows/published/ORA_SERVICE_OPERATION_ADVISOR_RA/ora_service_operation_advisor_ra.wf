        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_ADAPTIVESEARCHQUERIES",
            "functionName": "getSRsByAdaptiveSearchParameters",
            "name": "Get Stalled SRs"
          },
          "outcomes": {
            "success": "1775493705754"
          },
          "code": "GET_STALLED_SRS",
          "id": "1775493015965",
          "inputs": [
            {
              "id": "1775493037258_1",
              "name": "body",
              "type": "string",
              "value": "{\n    \"entity\": \"CRMServiceRequest\",\n    \"onlyData\": true,\n    \"fields\": [\n        \"SrId\",\n        \"SrNumber\"    ],\n    \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n            {\n                \"op\": \"$in\",\n                \"attribute\": \"StatusTypeCd\",\n                \"values\": [\n                    \"ORA_SVC_INPROGRESS\",\n                    \"ORA_SVC_WAITING\"\n                ]\n            },\n            {\n                \"op\": \"$pr\",\n                \"attribute\": \"ProblemDescription\"\n            },\n            {\n                \"op\": \"$wi\",\n                \"attribute\": \"OpenDate\",\n                \"value1\": \"now-30d\",\n                \"value2\": \"now\"\n            },\n            {\n                \"op\": \"$in\",\n                \"attribute\": \"ApplicationStripe\",\n                \"values\": [\n                    \"ora_svc_crm\"\n                ]\n            },\n            {\n                \"op\": \"$eq\",\n                \"attribute\": \"RecordSet\",\n                \"value\": \"ORA_SVC_MY_SUBORD_SRS\"\n            }\n        ]\n    },\n    \"sort\": [\n        {\n            \"attribute\": \"LastUpdateDate\",\n            \"direction\": \"descending\"\n        }\n    ],\n    \"limit\": 100,\n    \"offset\": 0\n}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_ADAPTIVESEARCHQUERIES",
            "functionName": "getSRsByAdaptiveSearchParameters",
            "name": "Exclude SRs"
          },
          "outcomes": {
            "success": "1775493705754"
          },
          "code": "EXCLUDE_SRS",
          "id": "1775493078931",
          "inputs": [
            {
              "id": "1775493095832_1",
              "name": "body",
              "type": "string",
              "value": "{\n  \"entity\": \"CRMServiceRequest\",\n  \"onlyData\": true,\n  \"fields\": [\"SrId\"],\n  \"q\": {\n    \"op\": \"$and\",\n    \"criteria\": [\n      {\n        \"op\": \"$in\",\n        \"attribute\": \"ListOfMessages.MessageTypeCd\",\n        \"values\": [\"ORA_SVC_AI_SYSTEM_NOTE\"]\n      },\n      {\n        \"op\": \"$in\",\n        \"attribute\": \"ListOfMessages.Subject\",\n        \"values\": [\"agentic app action\"]\n      }, \n      {\n        \"op\": \"$any\",\n        \"attribute\": \"ListOfMessages.MessageContent\",\n        \"value\": \"SERVICE_REQUEST_STALL_MANAGEMENT_ADVISOR_RA\"\n      },\n      {\n        \"op\": \"$wi\",\n        \"attribute\": \"ListOfMessages.CreationDate\",\n        \"value1\": \"now-1d\",\n        \"value2\": \"now\"\n      }\n    ]\n  },\n  \"limit\": 100\n}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
