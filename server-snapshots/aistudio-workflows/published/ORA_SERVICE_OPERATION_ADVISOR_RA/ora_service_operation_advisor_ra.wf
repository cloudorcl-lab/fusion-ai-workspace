          "id": "1775848033567",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SRs Grouped by Assignee",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst assigneeGrouping = {};\n\nfor (const row of data) {\n  const assignee = row.AssigneePersonName;\n  const severity = row.SeverityCdMeaning;\n  const srNumber = row.SrNumber;\n\n  // Normalize assignee name\n  const assigneeName =\n    assignee !== null && assignee !== undefined && String(assignee).trim() !== \"\"\n      ? String(assignee).trim()\n      : \"Unassigned\";\n\n  // Initialize group\n  if (!assigneeGrouping[assigneeName]) {\n    assigneeGrouping[assigneeName] = {\n      total: 0,\n      srNumbers: [],\n      bySeverity: { High: 0, Medium: 0, Low: 0 }\n    };\n  }\n\n  assigneeGrouping[assigneeName].total += 1;\n  if (srNumber) assigneeGrouping[assigneeName].srNumbers.push(srNumber);\n\n  if (severity === \"High\" || severity === \"Medium\" || severity === \"Low\") {\n    assigneeGrouping[assigneeName].bySeverity[severity] += 1;\n  }\n}\n\nassigneeGrouping;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "SRS_GROUPED_BY_ASSIGNEE",
          "id": "1775848095009",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Stalled SR Overview",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_STALLED_SR_DETAILS.$output.items || [];\n\nconst result = {\n  total: 0,\n  srNumbers: [],\n  bySeverity: {\n    High: { total: 0, byStatusType: { \"In Progress\": 0, Waiting: 0 } },\n    Medium: { total: 0, byStatusType: { \"In Progress\": 0, Waiting: 0 } },\n    Low: { total: 0, byStatusType: { \"In Progress\": 0, Waiting: 0 } }\n  },\n  byStatusType: {\n    \"In Progress\": { total: 0, bySeverity: { High: 0, Medium: 0, Low: 0 } },\n    Waiting: { total: 0, bySeverity: { High: 0, Medium: 0, Low: 0 } }\n  }\n};\n\nfor (const row of data) {\n  const srNumber = row.SrNumber || null;\n  const severity = row.SeverityCdMeaning;\n  const status = row.StatusTypeCdMeaning;\n\n  const validSeverity = severity === \"High\" || severity === \"Medium\" || severity === \"Low\";\n  const validStatus = status === \"In Progress\" || status === \"Waiting\";\n\n  result.total += 1;\n  if (srNumber) result.srNumbers.push(srNumber);\n\n  if (validSeverity) {\n    result.bySeverity[severity].total += 1;\n  }\n\n  if (validStatus) {\n    result.byStatusType[status].total += 1;\n  }\n\n  if (validSeverity && validStatus) {\n    result.bySeverity[severity].byStatusType[status] += 1;\n    result.byStatusType[status].bySeverity[severity] += 1;\n  }\n}\n\nresult;"
          },
          "outcomes": {
            "success": "1774567181662"
          },
          "code": "STALLED_SR_OVERVIEW",
          "id": "1775848212765",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Severity Sorted Open SR",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.GET_OPEN_SR_DETAILS.$output;\nconst severityRank = {\n  High: 1,\n  Medium: 2,\n  Low: 3,\n};\n\nconst cleanedData = (data.items || [])\n  .map(({ [\"@context\"]: _, ...rest }) => rest)\n  .sort((a, b) => {\n    const rankA = severityRank[a.SeverityCdMeaning] ?? 999;\n    const rankB = severityRank[b.SeverityCdMeaning] ?? 999;\n\n    if (rankA !== rankB) {\n      return rankA - rankB;\n    }\n\n    return String(a.SrNumber || \"\").localeCompare(String(b.SrNumber || \"\"));\n  });\n\nreturn cleanedData;"
          },
          "outcomes": {
            "success": "1775238958827"
          },
          "code": "SEVERITY_SORTED_OPEN_SR",
          "id": "1775859855113",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
