        {
          "metadata": {
            "name": "Extract SR Numbers",
            "returnType": "string",
            "sourceCode": "const items = $context.$nodes.SERVICE_REQUEST_KEYWORDS_SEARCH.$output.items;\n\n// Filter items with a valid 'number' property and score > 70\nconst srNumbers = items\n  .filter(item => item.number && item.$context.search.vectorScore > 70)\n  .map(item => item.number);\n\n// Build a single comma-separated string with double quotes around each SR number\nconst quotedSrNumbers = srNumbers.map(n => \"'\" + n + \"'\").join(',');\n\n// Return the string of quoted SR numbers\nreturn quotedSrNumbers;"
          },
          "outcomes": {
            "success": "1772576966800"
          },
          "code": "EXTRACT_SR_NUMBERS",
          "id": "1772492241148",
          "inputs": [],
