        {
          "metadata": {
            "name": "Refine Call Notes Output",
            "returnType": "object",
            "sourceCode": "var json = $context.$nodes.GET_CALL_NOTES.$output ;\n\n// list of properties to remove\nvar propsToRemove = [\"count\", \"hasMore\", \"limit\", \"offset\", \"links\", \"@context\"];\n\n// recursive cleanup\nvar stack = [json];\nwhile(stack.length > 0){\n    var current = stack.pop();\n    if(current && typeof current === \"object\"){\n        for(var key in current){\n            if(propsToRemove.indexOf(key) !== -1){\n                delete current[key];\n            } else if(typeof current[key] === \"object\"){\n                stack.push(current[key]);\n            }\n        }\n    }\n}\n\nreturn json;"
          },
          "outcomes": {
            "success": "1767863788876"
          },
          "code": "REFINE_CALL_NOTES_OUTPUT",
          "id": "1767862776525",
          "inputs": [],
