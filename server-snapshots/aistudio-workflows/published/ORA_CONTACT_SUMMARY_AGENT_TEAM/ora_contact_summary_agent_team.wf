              "type": "string"
            },
            {
              "id": "1767861855409_4",
              "name": "limit",
              "type": "integer"
            },
            {
              "id": "1767861855412_5",
              "name": "fields",
              "type": "string",
              "value": "['PartyId','PersonName','PrimaryAccount','JobTitle','AffinityLevel','ContactRollup','PrimaryAddress','FormattedAddress', 'SalesBuyingRoleCode', 'SalesAffinityCode']"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Query Params",
            "returnType": "object",
            "sourceCode": "const output = {};\nconst partyId = JSON.parse($context.$nodes.GET_CONTACT_DETAILS.$output[0].PartyId);\nconst partyIdString = partyId.toString();\n\n// Leads\noutput.QExpressionLead = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'PrimaryContactId.PartyId',\n    value: partyIdString \n  }]\n};\n\n// Opportunity\noutput.QExpressionOpportunity = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'ListOfContacts.PerPartyId.PartyId',\n    value: partyIdString \n  }]\n};\n\n// Activity\noutput.QExpressionActivity = {\n  op: '$and',\n  criteria: [{\n    op: '$eq',\n    attribute: 'ListOfContacts.ContactId.PartyId',\n    value: partyIdString \n  }]\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1767862083728"
          },
          "code": "PREPARE_QUERY_PARAMS",
          "id": "1767862007525",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Run in Parallel"
          },
