          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "PrepareVariableValues",
            "returnType": "object",
            "sourceCode": "const userPrompt = $context.$system.$inputMessage;\nconst hint = $context.$app.$OraMessageHint;\nconst strAction = $context.$app.$OraAction;\nconst actionDetails = $context.$variables.actionDetails; \nconst action = $context.$app.$OraAction;\nconst panel = $context.$app.$OraPanelName;\n\n\nlet userMessageHint = \"QUERY\";\nlet addPrompt = '';\nlet newPrompt = userPrompt;\nvar actionCode='' ;\nlet transactionId = '';\n\n// START POPULATE  newPrompt and actionCode\n\nif  (hint === 'InvokeAction')  {\nactionCode='' ;\n\nif (typeof strAction === 'object') {\n    actionCode = strAction.actionCode;  \n} else {\n  var idx = strAction.indexOf('actionCode');\n  if (idx !== -1) {\n  var colonIdx = strAction.indexOf(':', idx);\n  if (colonIdx !== -1) {\n    var quoteStart = strAction.indexOf('\"', colonIdx);\n    if (quoteStart !== -1) {\n      var quoteEnd = strAction.indexOf('\"', quoteStart + 1);\n      if (quoteEnd !== -1) {\n        actionCode = strAction.substring(quoteStart + 1, quoteEnd);\n      }\n    }\n  }\n}\n}\nactionCode = actionCode.replace(/\\\\+$/, '');\nnewPrompt = \"Action is not configured. Showing default response.\";\n\nif (actionCode && actionDetails && Array.isArray(actionDetails.Actions)) {\n  for (var i = 0; i < actionDetails.Actions.length; i++) {\n    if (actionDetails.Actions[i].actionCode === actionCode) {\n      newPrompt = actionDetails.Actions[i].actionPrompt;\n      break;\n    }\n  }\n }\n \n if (typeof strAction === 'object') {\n    transactionId = strAction.transactionId;  \n} else {\n  var idx = strAction.indexOf('transactionId');\n  if (idx !== -1) {\n  var colonIdx = strAction.indexOf(':', idx);\n  if (colonIdx !== -1) {\n    var quoteStart = strAction.indexOf('\"', colonIdx);\n    if (quoteStart !== -1) {\n      var quoteEnd = strAction.indexOf('\"', quoteStart + 1);\n      if (quoteEnd !== -1) {\n        transactionId = strAction.substring(quoteStart + 1, quoteEnd);\n      }\n    }\n  }\n}\n}\nif(transactionId){\ntransactionId = transactionId.replace(/\\\\+$/, '');\n}\n\n}\n\n\n\nif (hint === \"InitCommunications\") {\n  addPrompt = \"list all employees compensation and talent details\";\n} else if (hint === \"FillParameters\") {\n  if (actionDetails && Array.isArray(actionDetails.Actions)) {\n    for (let i = 0; i < actionDetails.Actions.length; i++) {\n      if (actionDetails.Actions[i].actionCode === \"modelCompensationCycleScenarios\") {\n        addPrompt = actionDetails.Actions[i].actionPrompt;\n        break;\n      }\n    }\n  }\n}\n  \nif (addPrompt !== '') \n  newPrompt = addPrompt; \n\nif(transactionId){\n   newPrompt = newPrompt + transactionId;\n}\n\n// END POPULATE  newPrompt and actionCode\n\n\n// START POPULATE userMessageHint\n\nif ( hint === \"InitDisplay\" || hint === \"Summary\" ||  hint === \"InitActions\" || hint === \"InitSubtitle\" || hint ===  \"AdditionalContent\") {\n    userMessageHint = \"INIT\";\n} else if ( hint === \"InitCommunications\" || hint === \"FillParameters\" || hint === \"GenerateTemplateContent\" || hint === \"SendCommunication\") {\n    userMessageHint = \"COMM\";\n} else if (typeof action !== \"undefined\") {\n    if (action.includes(\"showOpenNotifications\") || action.includes(\"showNotification\") || action.includes(\"approveNotification\") || action.includes(\"rejectNotification\") ||  action.includes(\"showOpenJourney\")) {\n        userMessageHint = \"ACTION\";\n    }\n} else {\n    userMessageHint = \"QUERY\";\n}\n\n// END POPULATE userMessageHint\n\n\n\n\n\n\n// START POPULATE flowPath\n\nlet flowPath = \"QUERY\";\n\nif ( panel === \"rejectNotification\" || actionCode.includes(\"approveNotification\")) {\n  flowPath = \"NOQUERY\";\n} \n\n// END POPULATE flowPath\n\n\n\n\nlet result = {actionCode : actionCode, newPrompt: newPrompt, userMessageHint: userMessageHint, flowPath: flowPath, transactionId: transactionId}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771608135245"
          },
