              "value": "{\n  \"Actions\": [\n  {\n    \"actionCode\": \"showOpenNotifications\",\n    \"actionTitle\": \"Pending Transactions\",\n    \"actionText\": \"View Pending Transactions\",\n    \"actionDescription\": \"View all pending transactions requiring user attention\",\n    \"actionPriority\": \"true\",\n    \"actionPrompt\": \"show all unread and open worklist notifications only as messageListWidget based on below guidelines. 0. show all notification with `action` attached for each row `ora.Invoke(\\\"sendAgentCmd\\\", {\\\"actionCode\\\": \\\"showNotification\\\", \\\"transactionId\\\" : \\\"<transactionId>\\\"})`.  \",\n    \"actionDisplay\": \"false\"\n  },\n    {\n    \"actionCode\": \"showNotification\",\n    \"actionTitle\": \"show notification\",\n    \"actionText\": \"Show Notification\",\n    \"actionDescription\": \"Show specific notification details\",\n    \"actionPriority\": \"false\",\n    \"actionPrompt\": \"show notification for transactionId : <transactionId>\",\n    \"actionDisplay\": \"false\"\n  },\n    {\n    \"actionCode\": \"approveNotification\",\n    \"actionTitle\": \"Approve notification\",\n    \"actionText\": \"Approve Notification\",\n    \"actionDescription\": \"Approve specific notification details\",\n    \"actionPriority\": \"false\",\n    \"actionPrompt\": \"approve notification for transactionId : <transactionId>\",\n    \"actionDisplay\": \"false\"\n  },\n    {\n    \"actionCode\": \"rejectNotification\",\n    \"actionTitle\": \"Reject notification\",\n    \"actionText\": \"Reject Notification\",\n    \"actionDescription\": \"Reject specific notification details\",\n    \"actionPriority\": \"false\",\n    \"actionPrompt\": \"reject notification for transactionId : <transactionId>\",\n    \"actionDisplay\": \"false\"\n  }\n]\n}"
