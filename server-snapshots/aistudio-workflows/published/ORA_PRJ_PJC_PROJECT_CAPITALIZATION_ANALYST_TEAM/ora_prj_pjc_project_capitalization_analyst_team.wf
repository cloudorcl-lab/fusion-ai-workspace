            "name": "Is Project Validation Required",
            "returnType": "string",
            "sourceCode": "const projectInput= $context.$nodes.ROUTE_USER_INTENT.$output.request.scope.projectInput  \nconst currentProjectDetails= $context.$variables.prjPjcVarConvCurrentProjectDetails \nconst normalizedProjectInput = typeof projectInput === \"string\" ? projectInput.trim() : \"\";\n\n  const isEmptyObject = (value) =>\n    value &&\n    typeof value === \"object\" &&\n    !Array.isArray(value) &&\n    Object.keys(value).length === 0;\n\n  const hasUsableCurrentProjectDetails =\n    currentProjectDetails &&\n    typeof currentProjectDetails === \"object\" &&\n    !Array.isArray(currentProjectDetails) &&\n    !isEmptyObject(currentProjectDetails);\n\n  if (!normalizedProjectInput) {\n    return \"NONE\";\n  }\n\n  if (!hasUsableCurrentProjectDetails) {\n    return \"REQUIRED\";\n  }\n\n  const currentProjectName =\n    typeof currentProjectDetails.projectName === \"string\"\n      ? currentProjectDetails.projectName.trim()\n      : \"\";\n\n  const currentProjectNumber =\n    typeof currentProjectDetails.projectNumber === \"string\"\n      ? currentProjectDetails.projectNumber.trim()\n      : \"\";\n\n  const isMatch =\n    normalizedProjectInput === currentProjectName ||\n    normalizedProjectInput === currentProjectNumber;\n\n  return isMatch ? \"NONE\" : \"REQUIRED\";"
          },
          "outcomes": {
            "success": "1772598813605"
          },
