            "name": "Prepare Presentation Currency Context",
            "returnType": "object",
            "sourceCode": "function parseJson(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction text(value) {\n  if (value === null || value === undefined) return \"\";\n  const result = String(value).trim();\n  if (!result || result.toLowerCase() === \"null\" || result.toLowerCase() === \"undefined\") return \"\";\n  return result;\n}\n\nfunction addCurrency(candidates, value) {\n  const code = text(value).toUpperCase();\n  if (code && /^[A-Z]{3}$/.test(code) && !candidates.includes(code)) candidates.push(code);\n}\n\nfunction inspectRows(candidates, rows) {\n  if (!Array.isArray(rows)) return;\n  for (const row of rows) {\n    if (!row || typeof row !== \"object\") continue;\n    addCurrency(candidates, row.receiverLedgerCurrencyCode);\n    addCurrency(candidates, row.currencyCode);\n    addCurrency(candidates, row.CurrencyCode);\n    addCurrency(candidates, row.CURRENCYCODE);\n    addCurrency(candidates, row.projectLedgerCurrencyCode);\n    addCurrency(candidates, row.providerLedgerCurrencyCode);\n    addCurrency(candidates, row.PROVIDERLEDGERCURRENCYCODE);\n  }\n}\n\nfunction inspectValidationGroups(candidates, groups) {\n  if (!Array.isArray(groups)) return;\n  for (const group of groups) {\n    if (!group || typeof group !== \"object\") continue;\n    addCurrency(candidates, group.currencyCode);\n    if (Array.isArray(group.currencyCodes)) {\n      for (const code of group.currencyCodes) addCurrency(candidates, code);\n    }\n    inspectRows(candidates, group.detailedTransactionDetails);\n  }\n}\n\nconst presentationTarget = text( $context.$variables.prjPjcVarPresentationTarget ).toUpperCase() || \"QUERY\";\n\nconst currencyCandidates = [];\nconst currentProject = parseJson($context.$variables.prjPjcVarConvCurrentProjectDetails, {});\naddCurrency(currencyCandidates, currentProject.receiverLedgerCurrencyCode);\naddCurrency(currencyCandidates, currentProject.currencyCode);\naddCurrency(currencyCandidates, currentProject.projectLedgerCurrencyCode);\n\nconst queryDetails = parseJson($context.$nodes.GET_TRANSACTION_DETAILS?.$output, []);\ninspectRows(currencyCandidates, Array.isArray(queryDetails) ? queryDetails : queryDetails.items);\nconst querySummary = parseJson($context.$nodes.GET_PENDING_COST_SUMMARY?.$output, []);\ninspectRows(currencyCandidates, Array.isArray(querySummary) ? querySummary : querySummary.items);\n\nconst validationData = parseJson($context.$nodes.FORMAT_CACHED_VALIDATION_RESULTS?.$output?.result, {});\nif (validationData && Array.isArray(validationData.groups)) inspectValidationGroups(currencyCandidates, validationData.groups);\n\nconst lastDataBlock = parseJson($context.$variables.prjPjcVarConvLastDataBlock, {});\nif (lastDataBlock && Array.isArray(lastDataBlock.groups)) inspectValidationGroups(currencyCandidates, lastDataBlock.groups);\n\nconst assetData = parseJson($context.$nodes.GET_ASSET_DETAILS?.$output, []);\ninspectRows(currencyCandidates, Array.isArray(assetData) ? assetData : assetData.items);\n\nconst currencyCodes = currencyCandidates.slice().sort((a, b) => a.localeCompare(b));\nconst singleCurrencyCode = currencyCodes.length === 1 ? currencyCodes[0] : \"\";\nconst qExpression = currencyCodes.map((code) => \"CurrencyCode='\" + code.replace(/'/g, \"''\") + \"'\").join(\" or \");\nconst currencyPrecisionRequestParams = currencyCodes.length > 0\n  ? \"q=\" + encodeURIComponent(qExpression)\n  : \"\";\n\nreturn {\n  presentationTarget,\n  currencyCodes,\n  singleCurrencyCode,\n  isMultiCurrency: currencyCodes.length > 1,\n  currencyCode: singleCurrencyCode,\n  shouldLookupPrecision: currencyCodes.length > 0,\n  currencyPrecisionRequestParams,\n  precisionByCurrency: {}\n};"
          },
          "outcomes": {
            "success": "1778000100002"
          },
          "code": "PREPARE_PRESENTATION_CURRENCY_CONTEXT",
          "id": "1778000100001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
