            "errorNodeId": "1775736275713",
            "name": "Refining POETAF Response",
            "returnType": "string",
            "sourceCode": "const html= $context.$nodes.POETAF_INFO_RETRIEVER.$output.output \nlet result = \"\";\n  let matches = html.match(/style\\s*=\\s*(['\"])(.*?)\\1/gi);\n  let i = 0;\n\n  result = html;\n\n  if (matches) {\n    for (i = 0; i < matches.length; i++) {\n      let fullStyle = matches[i];\n      let styleValue = fullStyle.replace(/style\\s*=\\s*['\"]|['\"]$/gi, \"\");\n      let updated = styleValue\n        .replace(/(^|;)\\s*font-size\\s*:\\s*[^;]+;?/gi, \"$1\")\n        .replace(/;\\s*;/g, \";\")\n        .replace(/^\\s*;\\s*|\\s*;\\s*$/g, \"\")\n        .trim();\n      let replacement = \"\";\n\n      replacement = 'style=\"' + updated + '\"';\n      result = result.replace(fullStyle, replacement);\n    }\n  }\n\n  return result;"
          },
          "outcomes": {
            "success": "1779534139119"
          },
          "code": "REFINING_POETAF_RESPONSE",
          "convergenceTargetId": "1774375839147",
          "id": "1775198849974",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Redwood UI Response",
            "returnType": "string",
            "sourceCode": "function getValue(value, fallback) {\n  return value === null || value === undefined ? fallback : value;\n}\n\nvar raw = String(getValue($context.$variables.prjPjcVarConvRoutingResponsePayload, '')).trim();\nvar route = ($context.$nodes.ROUTE_USER_INTENT && $context.$nodes.ROUTE_USER_INTENT.$output) ? $context.$nodes.ROUTE_USER_INTENT.$output : {};\nvar request = route.request || {};\nvar intent = String(getValue(route.branch || request.requestType, 'RESPONSE')).trim() || 'RESPONSE';\nvar resolvedUserQuery = String(getValue(route.resolvedUserQuery, '')).trim();\nvar agent = 'ORA_PRJ_PJC_PROJECT_CAPITALIZATION_ANALYST_TEAM';\n\nfunction decode(text) {\n  return String(getValue(text, ''))\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\");\n}\n\nfunction normalizeWhitespace(text) {\n  return decode(String(getValue(text, '')))\n    .replace(/\\r/g, '')\n    .replace(/[ \\t]+\\n/g, '\\n')\n    .replace(/\\n[ \\t]+/g, '\\n')\n    .replace(/[ \\t]{2,}/g, ' ')\n    .trim();\n}\n\nfunction stripTagsToLines(text) {\n  return normalizeWhitespace(\n    String(getValue(text, ''))\n      .replace(/<br\\s*\\/?>/gi, '\\n')\n      .replace(/<\\/(div|p|li|ul|ol|h\\d|tr)>/gi, '\\n')\n      .replace(/<li[^>]*>/gi, '- ')\n      .replace(/<\\/td>\\s*<td[^>]*>/gi, '\\t')\n      .replace(/<\\/th>\\s*<th[^>]*>/gi, '\\t')\n      .replace(/<\\/?[a-z][a-z0-9]*(?:\\s[^>]*)?>/gi, '')\n  )\n    .split(/\\n+/)\n    .map(function (value) { return value.trim(); })\n    .filter(function (value) { return Boolean(value); });\n}\n\nfunction toId(text) {\n  var value = String(getValue(text, 'value'))\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '');\n  return value || 'value';\n}\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nvar numberPreferences = parseJsonSafe($context.$variables.prjPjcVarUserNumberFormatPreferences, {});\n\nfunction normalizeCurrencyCode(value) {\n  var code = String(getValue(value, '')).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : '';\n}\n\nfunction parseHeaderCurrencyCode(headerText) {\n  var match = String(getValue(headerText, '')).match(/\\(([A-Z]{3})\\)\\s*$/);\n  return match ? normalizeCurrencyCode(match[1]) : '';\n}\n\nfunction isMonetaryColumnHeader(headerText) {\n  var normalized = String(getValue(headerText, '')).trim().toLowerCase();\n  return /\\bamount\\b/.test(normalized) || /\\bcost\\b/.test(normalized);\n}\n\nfunction normalizeNumericText(text) {\n  var normalized = String(getValue(text, '')).trim();\n  if (!normalized) {\n    return '';\n  }\n\n  var groupingSeparator = typeof numberPreferences.groupingSeparator === 'string' ? numberPreferences.groupingSeparator : ',';\n  var decimalSeparator = typeof numberPreferences.decimalSeparator === 'string' ? numberPreferences.decimalSeparator : '.';\n\n  if (groupingSeparator) {\n    normalized = normalized.split(groupingSeparator).join('');\n  }\n\n  if (decimalSeparator && decimalSeparator !== '.') {\n    normalized = normalized.split(decimalSeparator).join('.');\n  }\n\n  normalized = normalized.replace(/[^0-9.+-]/g, '');\n  return /^[+-]?\\d+(?:\\.\\d+)?$/.test(normalized) ? normalized : '';\n}\n\nfunction formatMonetaryToken(amount, currencyCode) {\n  if (!amount || !currencyCode) {\n    return '';\n  }\n\n  return '{amount:' + amount + ',currency:' + currencyCode + '}';\n}\n\nfunction parseMonetaryCell(cellText, defaultCurrencyCode) {\n  var text = normalizeWhitespace(cellText);\n  if (!text || text === '—' || text === '-') {\n    return null;\n  }\n\n  var tokenMatch = text.match(/^\\{amount:([^,}]+),currency:([A-Za-z]{3})\\}$/);\n  if (tokenMatch) {\n    var existingAmount = normalizeNumericText(tokenMatch[1]);\n    var existingCurrencyCode = normalizeCurrencyCode(tokenMatch[2]);\n    if (!existingAmount || !existingCurrencyCode) {\n      return null;\n    }\n    return formatMonetaryToken(existingAmount, existingCurrencyCode);\n  }\n\n  var currencyCode = normalizeCurrencyCode(defaultCurrencyCode);\n  var suffixMatch = text.match(/\\b([A-Z]{3})\\s*$/);\n  if (suffixMatch) {\n    currencyCode = normalizeCurrencyCode(suffixMatch[1]);\n    text = text.slice(0, suffixMatch.index).trim();\n  }\n\n  var amount = normalizeNumericText(text);\n  if (!amount || !currencyCode) {\n    return null;\n  }\n\n  return formatMonetaryToken(amount, currencyCode);\n}\n\nfunction makeText(text) {\n  return {\n    display_type: 'text',\n    display_sequence: 0,\n    text: text\n  };\n}\n\nfunction escapeDisplayText(text) {\n  return String(getValue(text, ''))\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n}\n\nfunction makeList(items, heading) {\n  var header = heading || 'Recommendations';\n  return {\n    display_type: 'list',\n    display_sequence: 0,\n    header: header,\n    fields: {\n      items: items.map(function (item, index) {\n        var value = escapeDisplayText(String(getValue(item, '')).trim());\n        return {\n          id: toId(value || ('item_' + (index + 1))),\n          Default: value,\n          value: value\n        };\n      })\n    },\n    keyAttributes: {\n      items: ['id']\n    },\n    selection_mode: 'none',\n    accessibility: {\n      'aria-label': header\n    }\n  };\n}\n\nfunction parseTable(tableHtml, heading) {\n  var rowMatches = tableHtml.match(/<tr[\\s\\S]*?<\\/tr>/gi) || [];\n  if (!rowMatches.length) {\n    return null;\n  }\n\n  var headerMatches = [];\n  var headerRegex = /<th[^>]*>([\\s\\S]*?)<\\/th>/gi;\n  var headerMatch;\n  while ((headerMatch = headerRegex.exec(rowMatches[0]))) {\n    headerMatches.push(stripTagsToLines(headerMatch[1]).join(' '));\n  }\n\n  if (!headerMatches.length) {\n    var fallbackHeaderRegex = /<t[dh][^>]*>([\\s\\S]*?)<\\/t[dh]>/gi;\n    while ((headerMatch = fallbackHeaderRegex.exec(rowMatches[0]))) {\n      headerMatches.push(stripTagsToLines(headerMatch[1]).join(' '));\n    }\n  }\n\n  if (!headerMatches.length) {\n    return null;\n  }\n\n  var columns = [];\n  var columnMeta = [];\n  var i;\n  for (i = 0; i < headerMatches.length; i++) {\n    var sourceHeaderText = headerMatches[i] || ('Column ' + (i + 1));\n    var headerText = sourceHeaderText;\n    var isMonetary = isMonetaryColumnHeader(headerText);\n    if (isMonetary) {\n      headerText = 'Amount';\n    }\n    var colId = isMonetary ? 'amount' : (toId(headerText) || ('col_' + (i + 1)));\n    columns.push({\n      headerText: headerText,\n      field: colId,\n      id: colId,\n      className: '',\n      resizable: 'enabled',\n      template: isMonetary ? 'monetaryTemplate' : ''\n    });\n    columnMeta.push({\n      isMonetary: isMonetary,\n      defaultCurrencyCode: parseHeaderCurrencyCode(sourceHeaderText)\n    });\n  }\n\n  var items = [];\n  for (i = 1; i < rowMatches.length; i++) {\n    var rowHtml = rowMatches[i];\n    var cellRegex = /<t[dh][^>]*>([\\s\\S]*?)<\\/t[dh]>/gi;\n    var cellMatch;\n    var cells = [];\n\n    while ((cellMatch = cellRegex.exec(rowHtml))) {\n      cells.push(stripTagsToLines(cellMatch[1]).join(' '));\n    }\n\n    if (!cells.length) {\n      continue;\n    }\n\n    var row = {};\n    var c;\n    for (c = 0; c < columns.length; c++) {\n      var cellValue = cells[c] || '';\n      var metadata = columnMeta[c];\n\n      if (metadata && metadata.isMonetary) {\n        var monetaryToken = parseMonetaryCell(cellValue, metadata.defaultCurrencyCode);\n        if (monetaryToken) {\n          row[columns[c].field] = monetaryToken;\n          continue;\n        }\n      }\n\n      row[columns[c].field] = cellValue;\n    }\n    items.push(row);\n  }\n\n  var finalHeading = heading ? heading : '';\n\n  return {\n    display_type: 'table',\n    display_sequence: 0,\n    heading: finalHeading,\n    rows: { items: items },\n    columns: { items: columns },\n    keyAttributes: { items: [columns[0].field] },\n    accessibility: {\n      'aria-label': finalHeading || 'table',\n      'row.accessible-row-header': columns[0].id\n    }\n  };\n}\n\nfunction extractSegments(html) {\n  var segments = [];\n  var regex = /<table[\\s\\S]*?<\\/table>/gi;\n  var lastIndex = 0;\n  var match;\n\n  while ((match = regex.exec(html))) {\n    if (match.index > lastIndex) {\n      segments.push({\n        type: 'html',\n        content: html.slice(lastIndex, match.index)\n      });\n    }\n    segments.push({\n      type: 'table',\n      content: match[0]\n    });\n    lastIndex = regex.lastIndex;\n  }\n\n  if (lastIndex < html.length) {\n    segments.push({\n      type: 'html',\n      content: html.slice(lastIndex)\n    });\n  }\n\n  return segments;\n}\n\nfunction normalizeHeading(line) {\n  return String(line || '').replace(/:$/, '').trim().toLowerCase();\n}\n\nfunction isActionHeading(line) {\n  return /^(validation findings|issue group details|what needs attention|recommended action|recommendations|what you can do next|to continue, enter one of these)[:]?$/i.test(line);\n}\n\nfunction isTableHeading(line) {\n  return /^(findings|transactions affected)$/i.test(line);\n}\n\nfunction isActionItem(line, heading) {\n  if (/^- /.test(line)) return true;\n  if (/^\\d+\\./.test(line)) return true;\n  if (/^[A-Z]\\)/.test(line)) return true;\n\n  var normalizedHeading = normalizeHeading(heading);\n  var normalizedLine = String(line || '').trim().toLowerCase();\n\n  if (normalizedHeading === 'recommended action' || normalizedHeading === 'recommendations') {\n    return /^(go to|select|create|assign|associate|include|use|after|run)\\b/i.test(line);\n  }\n\n  if (normalizedHeading === 'what needs attention') {\n    return true;\n  }\n\n  if (normalizedHeading === 'issue group details') {\n    if (normalizedLine === 'amounts are shown in receiver ledger currency.') {\n      return false;\n    }\n    if (normalizedLine === 'transactions affected') {\n      return false;\n    }\n    if (normalizedLine === 'what needs attention') {\n      return false;\n    }\n    if (normalizedLine === 'recommended action') {\n      return false;\n    }\n    if (normalizedLine === 'what you can do next') {\n      return false;\n    }\n    return true;\n  }\n\n  if (normalizedHeading === 'validation findings') {\n    if (normalizedLine === 'amounts are shown in receiver ledger currency.') {\n      return false;\n    }\n    if (normalizedLine === 'findings') {\n      return false;\n    }\n    return true;\n  }\n\n  if (normalizedHeading === 'what you can do next' || normalizedHeading === 'to continue, enter one of these') {\n    return true;\n  }\n\n  return false;\n}\n\nfunction cleanActionItem(line) {\n  return line.replace(/^(?:- )/, '').trim();\n}\n\nfunction flushTextBuffer(blocks, buffer) {\n  if (!buffer.length) {\n    return;\n  }\n  blocks.push(makeText(buffer.join('\\n')));\n  buffer.length = 0;\n}\n\nfunction flushListBuffer(blocks, items, heading) {\n  if (!items.length) {\n    return '';\n  }\n  blocks.push(makeList(items.slice(), heading));\n  items.length = 0;\n  return '';\n}\n\nvar blocks = [];\nvar segments = extractSegments(raw);\nvar textBuffer = [];\nvar listItems = [];\nvar listHeading = '';\nvar pendingTableHeading = '';\n\nvar s;\nfor (s = 0; s < segments.length; s++) {\n  var segment = segments[s];\n\n  if (segment.type === 'html') {\n    var lines = stripTagsToLines(segment.content);\n    var lineIndex;\n\n    for (lineIndex = 0; lineIndex < lines.length; lineIndex++) {\n      var line = lines[lineIndex];\n\n      if (isTableHeading(line)) {\n        flushTextBuffer(blocks, textBuffer);\n        listHeading = flushListBuffer(blocks, listItems, listHeading);\n        pendingTableHeading = line;\n        continue;\n      }\n\n      if (isActionHeading(line)) {\n        flushTextBuffer(blocks, textBuffer);\n        listHeading = flushListBuffer(blocks, listItems, listHeading);\n        listHeading = line.replace(/:$/, '');\n        continue;\n      }\n\n      if (listHeading) {\n        if (isActionItem(line, listHeading)) {\n          listItems.push(cleanActionItem(line));\n          continue;\n        }\n\n        listHeading = flushListBuffer(blocks, listItems, listHeading);\n        textBuffer.push(line);\n        continue;\n      }\n\n      textBuffer.push(line);\n    }\n\n    continue;\n  }\n\n  flushTextBuffer(blocks, textBuffer);\n  listHeading = flushListBuffer(blocks, listItems, listHeading);\n\n  var table = parseTable(segment.content, pendingTableHeading);\n  pendingTableHeading = '';\n\n  if (table) {\n    blocks.push(table);\n  }\n}\n\nflushTextBuffer(blocks, textBuffer);\nlistHeading = flushListBuffer(blocks, listItems, listHeading);\n\nif (!blocks.length) {\n  blocks.push(makeText(raw ? decode(raw) : ''));\n}\n\nvar blockIndex;\nfor (blockIndex = 0; blockIndex < blocks.length; blockIndex++) {\n  blocks[blockIndex].display_sequence = blockIndex + 1;\n}\n\nvar title = '';\nfor (blockIndex = 0; blockIndex < blocks.length; blockIndex++) {\n  if (blocks[blockIndex].display_type === 'text' && blocks[blockIndex].text) {\n    title = blocks[blockIndex].text.split('\\n')[0].trim();\n    if (title) {\n      break;\n    }\n  }\n}\n\nvar response = {\n  schema_version: '1',\n  agent: agent,\n  intent: intent,\n  title: title || intent.replace(/_/g, ' '),\n  description: resolvedUserQuery || intent.replace(/_/g, ' '),\n  timestamp: new Date().toISOString(),\n  agent_response: blocks\n};\n\nreturn JSON.stringify(response);"
          },
