            "sourceCode": "const params = String($context.$nodes.PREPARE_PRESENTATION_CURRENCY_CONTEXT?.$output?.result?.currencyPrecisionRequestParams || \"\");\nconst queryValue = params.split(\"&\").find((part) => part.indexOf(\"q=\") === 0);\nconst filter = queryValue ? decodeURIComponent(queryValue.slice(2)) : \"1=0\";\n\nreturn {\n  viewQueries: {\n    currencyList: {\n      module: \"oraErpCoreCurrencySetup\",\n      businessObject: \"Currency\",\n      view: \"currencyList\",\n      fieldAliases: {\n        currencyCode: \"currencyCode\",\n        precision: \"precision\",\n        minimumAccountableUnit: \"minimumAccountableUnit\"\n      }\n    }\n  },\n  select: \"SELECT currencyCode,precision,minimumAccountableUnit from currencyList where \" + filter\n};"
          },
