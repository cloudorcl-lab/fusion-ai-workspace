        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Normalize Input Message",
            "returnType": "string",
            "sourceCode": "function normalizeString(value) {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return String(value).trim();\n}\n\nfunction startsWithValidationVerb(text) {\n  return /^(diagnose|validate|analy[sz]e|check why)\\b/i.test(text);\n}\n\nfunction extractTransactionNumbers(text) {\n  var matches = String(text || \"\").match(/\\b\\d{5,}\\b/g);\n  return Array.isArray(matches) ? matches : [];\n}\n\nfunction hasTransactionSelectionIntent(text) {\n  var normalized = normalizeString(text).toLowerCase();\n  if (!normalized) {\n    return false;\n  }\n\n  var hasTxnPhrase =\n    /\\bselected transactions?\\b/.test(normalized) ||\n    /\\btransaction numbers?\\b/.test(normalized) ||\n    /\\btransactions?\\b/.test(normalized);\n\n  var numbers = extractTransactionNumbers(normalized);\n  return hasTxnPhrase && numbers.length > 0;\n}\n\nfunction normalizeIssueFollowup(text) {\n  var normalized = normalizeString(text);\n  var lower = normalized.toLowerCase();\n\n  if (!normalized) {\n    return normalized;\n  }\n\n  if (/\\bshow issue groups\\b/.test(lower)) {\n    return \"show issue groups\";\n  }\n\n  var issueMatch =\n    lower.match(/\\bissue\\s*#?\\s*(\\d+)\\b/) ||\n    lower.match(/\\bshow issue\\s*#?\\s*(\\d+)\\b/) ||\n    lower.match(/\\bgroup\\s*#?\\s*(\\d+)\\b/) ||\n    lower.match(/\\bshow group\\s*#?\\s*(\\d+)\\b/);\n\n  if (issueMatch) {\n    return \"issue \" + issueMatch[1];\n  }\n\n  return normalized;\n}\n\nvar inputMessage = normalizeString( $context.$system.$inputMessage );\n\nvar normalizedIssueMessage = normalizeIssueFollowup(inputMessage);\nif (normalizedIssueMessage !== inputMessage) {\n  return normalizedIssueMessage;\n}\n\nif (hasTransactionSelectionIntent(inputMessage) && !startsWithValidationVerb(inputMessage)) {\n  return \"diagnose \" + inputMessage;\n}\n\nreturn inputMessage;"
          },
