            "errorNodeId": "1775736275713",
            "name": "Build Presentation Currency Precision Context",
            "returnType": "object",
            "sourceCode": "function parseJson(value, fallback) {\n  if (typeof value === \"string\") {\n    try { return JSON.parse(value); } catch (e) { return fallback; }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return \"\";\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : \"\";\n}\n\nfunction extractPrecision(value) {\n  const precision = Number(value);\n  return Number.isFinite(precision) && precision >= 0 && precision <= 10 ? Math.floor(precision) : null;\n}\n\nfunction extractMinimumAccountableUnit(value) {\n  if (value === null || value === undefined || value === \"\") return null;\n  const text = String(value).trim();\n  if (!text || text === \"0\") return null;\n  const amount = Number(text);\n  return Number.isFinite(amount) && amount > 0 ? text : null;\n}\n\nfunction getDefaultRoundingIncrement(precision) {\n  const digits = extractPrecision(precision);\n  if (digits === null || digits === 0) return \"1\";\n  return \"0.\" + \"0\".repeat(Math.max(0, digits - 1)) + \"1\";\n}\n\nfunction getRoundingIncrement(precision, minimumAccountableUnit) {\n  const mau = extractMinimumAccountableUnit(minimumAccountableUnit);\n  return mau === null ? getDefaultRoundingIncrement(precision) : mau;\n}\n\nconst base = parseJson($context.$nodes.PREPARE_PRESENTATION_CURRENCY_CONTEXT?.$output?.result, {});\nconst raw = parseJson($context.$nodes.GET_RECEIVER_LEDGER_CURRENCY_PRECISION?.$output, {});\n\nconst precisionByCurrency = {};\nconst minimumAccountableUnitByCurrency = {};\n\nfunction addFromObject(obj, fallbackCode) {\n  if (!obj || typeof obj !== \"object\") return;\n\n  const code = normalizeCurrencyCode(\n    obj.CURRENCYCODE ?? obj.CurrencyCode ?? obj.currencyCode ?? fallbackCode\n  );\n\n  const precision = extractPrecision(\n    obj.PRECISION ?? obj.Precision ?? obj.precision ?? obj.CurrencyPrecision ?? obj.currencyPrecision\n  );\n\n  const minimumAccountableUnit = extractMinimumAccountableUnit(\n    obj.MINIMUMACCOUNTABLEUNIT ?? obj.MinimumAccountableUnit ?? obj.minimumAccountableUnit\n  );\n\n  if (code && precision !== null) precisionByCurrency[code] = precision;\n  if (code) minimumAccountableUnitByCurrency[code] = minimumAccountableUnit;\n}\n\nfunction inspect(value, fallbackCode) {\n  if (!value) return;\n\n  if (Array.isArray(value)) {\n    for (const item of value) inspect(item, fallbackCode);\n    return;\n  }\n\n  if (typeof value !== \"object\") return;\n\n  addFromObject(value, fallbackCode);\n\n  if (Array.isArray(value.items)) inspect(value.items, fallbackCode);\n  if (value.result) inspect(value.result, fallbackCode);\n  if (value.output) inspect(value.output, fallbackCode);\n}\n\ninspect(raw, base.singleCurrencyCode || base.currencyCode || \"\");\n\nconst currencyCodes = Array.isArray(base.currencyCodes)\n  ? base.currencyCodes.map(normalizeCurrencyCode).filter(Boolean)\n  : [];\n\nfor (const code of currencyCodes) {\n  if (precisionByCurrency[code] === undefined) precisionByCurrency[code] = 2;\n  if (minimumAccountableUnitByCurrency[code] === undefined) minimumAccountableUnitByCurrency[code] = null;\n}\n\nconst roundingIncrementByCurrency = {};\nconst currencyFormatRecords = [];\n\nfor (const code of currencyCodes) {\n  const precision = precisionByCurrency[code];\n  const minimumAccountableUnit = minimumAccountableUnitByCurrency[code];\n  const roundingIncrement = getRoundingIncrement(precision, minimumAccountableUnit);\n\n  roundingIncrementByCurrency[code] = roundingIncrement;\n\n  currencyFormatRecords.push({\n    currencyCode: code,\n    precision,\n    minimumAccountableUnit,\n    roundingIncrement,\n    roundingMode: \"HALF_UP\"\n  });\n}\n\nreturn {\n  ...base,\n  currencyCodes,\n  singleCurrencyCode: currencyCodes.length === 1 ? currencyCodes[0] : \"\",\n  isMultiCurrency: currencyCodes.length > 1,\n  currencyCode: currencyCodes.length === 1 ? currencyCodes[0] : \"\",\n  precisionByCurrency,\n  minimumAccountableUnitByCurrency,\n  roundingIncrementByCurrency,\n  roundingMode: \"HALF_UP\",\n  currencyFormatRecords\n};"
          },
