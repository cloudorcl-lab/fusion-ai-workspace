            "name": "Build Project Search Payload",
            "returnType": "object",
            "sourceCode": "const projectName = $context.$nodes.ROUTE_USER_INTENT.$output.request.scope.projectInput \nconst projectNumber = $context.$nodes.ROUTE_USER_INTENT.$output.request.scope.projectInput \n\nconst payload = {\n  viewQueries: {\n    projects: {\n      module: \"oraErpCoreProjectPlanning\",\n      businessObject: \"Project\",\n      view: \"projectList\",\n      fieldAliases: {\n        id: \"projectId\",\n        name: \"projectName\",\n        projectNumber: \"projectNumber\",\n        \"businessUnit.name\": \"businessUnitName\" ,\n       \"projectLedgerCurrency.currencyCode\":\"currencyCode\"\n     }\n    }\n  },\n  select: `SELECT projectId, projectName, projectNumber,businessUnitName,currencyCode FROM projects where ( UPPER(projectName) LIKE UPPER('%${projectName}%') OR UPPER(projectNumber) LIKE UPPER('%${projectNumber}%') ) and businessUnitName is not NULL and ROWNUM <= 51 ORDER BY projectNumber`,\n  return: [\n    { name: \"projectId\", type: \"int64\" },\n    { name: \"projectName\", type: \"string\" },\n    { name: \"projectNumber\", type: \"string\" },\n    { name: \"businessUnitName\", type: \"string\" },\n     { name: \"currencyCode\", type: \"string\" }\n  ]\n};\n\n// payload is the resulting JSON object\npayload;"
          },
          "outcomes": {
            "success": "1773152813866"
          },
          "code": "BUILD_PROJECT_SEARCH_PAYLOAD",
          "id": "1773152756716",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
