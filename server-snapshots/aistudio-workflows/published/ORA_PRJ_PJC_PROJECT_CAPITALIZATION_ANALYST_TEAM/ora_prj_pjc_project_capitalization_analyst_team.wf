            "ADDITIONAL_INFO": "1774375191401",
            "EXCEPTION_HANDLING": "1775736275713"
          },
          "code": "CHOOSE_INTENT_PATH",
          "convergenceTargetId": "1779900100101",
          "id": "1772598720794",
          "inputs": [
            {
              "id": "1772598720795_1",
