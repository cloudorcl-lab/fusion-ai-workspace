            "name": "Get User Display Preferences",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.GET_USER_SESSION_DETAILS.$output ;\n\nfunction parseJson(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\ndata = parseJson(data, {});\n\nconst candidates = [];\nif (data && typeof data === \"object\") {\n  candidates.push(data);\n  if (data.result && typeof data.result === \"object\") candidates.push(data.result);\n  if (Array.isArray(data.items) && data.items.length > 0 && data.items[0]) candidates.push(data.items[0]);\n  if (data.result && Array.isArray(data.result.items) && data.result.items.length > 0 && data.result.items[0]) {\n    candidates.push(data.result.items[0]);\n  }\n}\n\nfunction firstText(keys, fallback) {\n  for (const obj of candidates) {\n    if (!obj || typeof obj !== \"object\") continue;\n    for (const key of keys) {\n      const value = obj[key];\n      if (value !== null && value !== undefined && String(value).trim() !== \"\") {\n        return String(value).trim();\n      }\n    }\n  }\n  return fallback;\n}\n\nconst dateFormat = firstText([\"DateFormat\", \"dateFormat\", \"DATE_FORMAT\"], \"yyyy-MM-dd\");\n\nconst numberFormatPreferences = {\n  numberFormat: firstText([\"numberFormat\", \"NumberFormat\", \"NUMBER_FORMAT\"], \"#,##0.###\"),\n  decimalSeparator: firstText([\"decimalSeparator\", \"DecimalSeparator\", \"DECIMAL_SEPARATOR\"], \".\"),\n  groupingSeparator: firstText([\"groupingSeparator\", \"GroupingSeparator\", \"GROUPING_SEPARATOR\"], \",\"),\n  preferredCurrency: firstText([\"preferredCurrency\", \"PreferredCurrency\", \"PREFERRED_CURRENCY\"], \"\"),\n  nlsLanguageCode: firstText([\"nlsLanguageCode\", \"NlsLanguageCode\", \"NLS_LANGUAGE_CODE\"], \"\"),\n  nlsLanguageString: firstText([\"nlsLanguageString\", \"NlsLanguageString\", \"NLS_LANGUAGE_STRING\"], \"\")\n};\n\nreturn {\n  dateFormat,\n  numberFormatPreferences\n};"
          },
          "outcomes": {
            "success": "1775738357662"
          },
