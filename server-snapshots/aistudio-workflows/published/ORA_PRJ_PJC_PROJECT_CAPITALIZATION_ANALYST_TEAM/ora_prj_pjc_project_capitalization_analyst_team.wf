            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value !== 'string') {\n    return String(value).trim();\n  }\n  var normalized = value.trim();\n  try {\n    var parsed = JSON.parse(normalized);\n    if (typeof parsed === 'string') {\n      normalized = parsed.trim();\n    }\n  } catch (e) {}\n  return normalized;\n}\n\nfunction extractEnvelope(rawInput) {\n  var parsed = parseJsonSafe(rawInput, null);\n  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n    return null;\n  }\n  if (\n    parsed.message !== undefined ||\n    parsed.prjPjcChatHistory !== undefined ||\n    parsed.prjPjcAtomicAgentRelevantInfo !== undefined ||\n    parsed.prjPjcRoutingContext !== undefined\n  ) {\n    return parsed;\n  }\n  return null;\n}\n\nfunction getWorkflowInputCandidates() {\n  var candidates = [];\n\n  try {\n    if ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object') {\n      candidates.push($context.$triggers.REST.$input);\n    }\n  } catch (e) {}\n\n  return candidates;\n}\n\nfunction firstNonEmptyString(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = normalizeString(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n  return '';\n}\n\nfunction firstObject(values) {\n  for (var i = 0; i < values.length; i++) {\n    var value = parseJsonSafe(values[i], null);\n    if (value && typeof value === 'object') {\n      return value;\n    }\n  }\n  return null;\n}\n\nfunction normalizeChatMessageContent(message) {\n  var parsed = parseJsonSafe(message, null);\n  var payload = parsed;\n\n  if (payload && typeof payload === 'object' && payload.redwoodResponse && payload.redwoodResponse.content) {\n    payload = payload.redwoodResponse.content;\n  }\n\n  if (!payload || typeof payload !== 'object') {\n    return normalizeString(message);\n  }\n\n  var lines = [];\n  if (payload.title) {\n    lines.push(String(payload.title));\n  }\n\n  var agentResponse = Array.isArray(payload.agent_response) ? payload.agent_response : [];\n  for (var i = 0; i < agentResponse.length; i++) {\n    var item = agentResponse[i] || {};\n    var displayType = normalizeString(item.display_type).toLowerCase();\n\n    if (displayType === 'text' && item.text) {\n      lines.push(String(item.text));\n      continue;\n    }\n\n    if (displayType === 'table') {\n      var tableLines = [];\n      if (item.heading) {\n        tableLines.push(String(item.heading));\n      }\n      var columns = item.columns && Array.isArray(item.columns.items) ? item.columns.items : [];\n      var rows = item.rows && Array.isArray(item.rows.items) ? item.rows.items : [];\n      if (columns.length > 0) {\n        tableLines.push(columns.map(function (column) {\n          return String(column.headerText || column.field || '');\n        }).join(' | '));\n      }\n      for (var r = 0; r < rows.length; r++) {\n        var row = rows[r] || {};\n        var rowValues = [];\n        for (var c = 0; c < columns.length; c++) {\n          var field = columns[c] && columns[c].field ? columns[c].field : null;\n          rowValues.push(field ? String(row[field] === null || row[field] === undefined ? '' : row[field]) : '');\n        }\n        if (rowValues.length > 0) {\n          tableLines.push(rowValues.join('\\n'));\n        }\n      }\n      if (tableLines.length > 0) {\n        lines.push(tableLines.join('\\n'));\n      }\n      continue;\n    }\n\n    if (displayType === 'action' && item.recommendations && Array.isArray(item.recommendations.items)) {\n      lines.push(item.recommendations.items.map(function (entry) {\n        return String(entry);\n      }).join('\\n'));\n    }\n  }\n\n  return lines.length > 0 ? lines.join('\\n') : normalizeString(message);\n}\n\nfunction extractMessagesFlexible(historyStr) {\n  var s = String(historyStr || '');\n  var pattern = /(USER:|AI:)/g;\n  var matches = [];\n  var match;\n\n  while ((match = pattern.exec(s)) !== null) {\n    matches.push({ token: match[0], index: match.index });\n  }\n\n  var messages = [];\n  for (var i = 0; i < matches.length; i++) {\n    var role = matches[i].token === 'USER:' ? 'user' : 'assistant';\n    var start = matches[i].index + matches[i].token.length;\n    var end = i + 1 < matches.length ? matches[i + 1].index : s.length;\n    var content = s.slice(start, end).replace(/^\\s+/, '').trim();\n    if (content) {\n      messages.push({ role: role, content: role === 'assistant' ? normalizeChatMessageContent(content) : content });\n    }\n  }\n\n  return messages;\n}\n\nfunction normalizeChatHistory(rawHistory, currentUserMessage) {\n  var normalized = [];\n  var parsedHistory = parseJsonSafe(rawHistory, null);\n\n  if (Array.isArray(parsedHistory)) {\n    for (var i = 0; i < parsedHistory.length; i++) {\n      var item = parsedHistory[i] || {};\n      var role = item.role === 'ai' ? 'assistant' : normalizeString(item.role || 'user').toLowerCase();\n      if (role !== 'assistant' && role !== 'user' && role !== 'system') {\n        role = 'user';\n      }\n      var contentSource = item.content !== undefined ? item.content : item.message;\n      var content = role === 'assistant' ? normalizeChatMessageContent(contentSource) : normalizeString(contentSource);\n      if (content) {\n        normalized.push({ role: role, content: content });\n      }\n    }\n  } else if (typeof rawHistory === 'string' && rawHistory.trim() !== '') {\n    normalized = extractMessagesFlexible(rawHistory);\n  }\n\n  var currentMessage = normalizeString(currentUserMessage);\n  if (currentMessage) {\n    var last = normalized.length > 0 ? normalized[normalized.length - 1] : null;\n    if (!last || last.role !== 'user' || last.content !== currentMessage) {\n      normalized.push({ role: 'user', content: currentMessage });\n    }\n  }\n\n  while (normalized.length > 6) {\n    normalized.shift();\n  }\n\n  return normalized;\n}\n\nfunction lastAssistantMessage(messages) {\n  if (!Array.isArray(messages)) return '';\n  for (var i = messages.length - 1; i >= 0; i--) {\n    var message = messages[i] || {};\n    if (message.role === 'assistant' && message.content) {\n      return normalizeString(message.content);\n    }\n  }\n  return '';\n}\n\nfunction lastPriorUserMessage(messages, currentUserMessage) {\n  if (!Array.isArray(messages)) return '';\n  var normalizedCurrent = normalizeString(currentUserMessage);\n  var skippedCurrent = false;\n  for (var i = messages.length - 1; i >= 0; i--) {\n    var message = messages[i] || {};\n    if (message.role !== 'user' || !message.content) {\n      continue;\n    }\n    var content = normalizeString(message.content);\n    if (!skippedCurrent && normalizedCurrent && content === normalizedCurrent) {\n      skippedCurrent = true;\n      continue;\n    }\n    return content;\n  }\n  return '';\n}\n\nfunction extractProjectIdentifier(message) {\n  var text = normalizeString(message);\n  if (!text) return '';\n  text = text.replace(/^project\\s*(name|number)?\\s*[:=-]?\\s*/i, '');\n  return normalizeString(text);\n}\n\nfunction looksLikeSimpleProjectReply(message) {\n  var text = normalizeString(message);\n  if (!text) return false;\n  if (/^(show|view|list|run|validate|diagnose|get|why|how|group|pending|capitalization)\\b/i.test(text)) {\n    return false;\n  }\n  return extractProjectIdentifier(text) !== '';\n}\n\nfunction parseRowSelection(message) {\n  var text = normalizeString(message).toLowerCase();\n  var match = text.match(/^(?:row\\s*)?(\\d{1,3})$/i) || text.match(/^row\\s+number\\s+(\\d{1,3})$/i);\n  return match ? String(match[1]) : '';\n}\n\nfunction isPendingProjectRequest(sessionData) {\n  if (!sessionData || typeof sessionData !== 'object') return false;\n  var request = sessionData.request && typeof sessionData.request === 'object' ? sessionData.request : {};\n  var requestType = normalizeString(request.requestType).toUpperCase();\n  return requestType === 'PENDING_COST_LIST' || requestType === 'PENDING_COST_GROUP_SUMMARY' || requestType === 'PENDING_COST_FILTERED_LIST';\n}\n\nfunction inferPendingProjectRequestType(previousSessionData, assistantMessage, previousUserMessage, activeAtomicAgentDetails) {\n  if (isPendingProjectRequest(previousSessionData)) {\n    return normalizeString((previousSessionData.request || {}).requestType).toUpperCase();\n  }\n\n  var assistant = normalizeString(assistantMessage).toLowerCase();\n  var priorUser = normalizeString(previousUserMessage).toLowerCase();\n  var combined = assistant + '\\n' + priorUser;\n  var assistantAsksForProject = /which project|enter the row number, project name, or project number to select the project|project name or number|provide the project name or number/.test(assistant);\n  var pendingCostContext = /(pending costs|pending capitalization costs)/.test(combined);\n\n  if (!assistantAsksForProject || !pendingCostContext) {\n    return '';\n  }\n\n  var groupBy = normalizeString(activeAtomicAgentDetails && activeAtomicAgentDetails.filters && activeAtomicAgentDetails.filters.groupBy).toLowerCase();\n  if (groupBy === 'transactionsource') {\n    return 'PENDING_COST_GROUP_SUMMARY';\n  }\n  if (/grouped by transaction source|group by transaction source/.test(combined) || /\\bgroup(ed)?\\b/.test(priorUser)) {\n    return 'PENDING_COST_GROUP_SUMMARY';\n  }\n  if (/filtered/.test(priorUser)) {\n    return 'PENDING_COST_FILTERED_LIST';\n  }\n\n  return 'PENDING_COST_LIST';\n}\n\nfunction buildPendingCostQuery(projectInput, requestType) {\n  if (!projectInput) {\n    return '';\n  }\n  if (requestType === 'PENDING_COST_GROUP_SUMMARY') {\n    return 'show pending capitalization costs grouped by transaction source for project ' + projectInput;\n  }\n  return 'show pending capitalization costs for project ' + projectInput;\n}\n\nfunction rewriteFollowUpMessage(currentUserMessage, previousSessionData, assistantMessage, previousUserMessage, activeAtomicAgentDetails) {\n  var requestType = inferPendingProjectRequestType(previousSessionData, assistantMessage, previousUserMessage, activeAtomicAgentDetails);\n  if (!requestType) {\n    return currentUserMessage;\n  }\n\n  if (!looksLikeSimpleProjectReply(currentUserMessage)) {\n    return currentUserMessage;\n  }\n\n  var projectInput = extractProjectIdentifier(currentUserMessage);\n  if (!projectInput) {\n    return currentUserMessage;\n  }\n\n  return buildPendingCostQuery(projectInput, requestType);\n}\n\nfunction hasRelevantInfo(details) {\n  return !!(details && typeof details === 'object' && Object.keys(details).length > 0);\n}\n\nfunction normalizeAtomicAgentResponseContent(response) {\n  if (!response || typeof response !== 'object') {\n    return '';\n  }\n\n  var lines = [];\n  var keys = Object.keys(response).sort();\n\n  for (var i = 0; i < keys.length; i++) {\n    var key = keys[i];\n    var value = response[key];\n\n    if (/^text\\d+$/i.test(key)) {\n      var textValue = normalizeString(value);\n      if (textValue) {\n        lines.push(textValue);\n      }\n      continue;\n    }\n\n    if (/^table\\d+$/i.test(key) && value && typeof value === 'object' && Array.isArray(value.items)) {\n      var rows = value.items;\n      if (rows.length > 0 && rows[0] && typeof rows[0] === 'object') {\n        var columns = Object.keys(rows[0]);\n        if (columns.length > 0) {\n          lines.push(columns.join(' | '));\n        }\n        for (var r = 0; r < rows.length; r++) {\n          var row = rows[r] || {};\n          var rowValues = [];\n          for (var c = 0; c < columns.length; c++) {\n            rowValues.push(normalizeString(row[columns[c]]));\n          }\n          if (rowValues.length > 0) {\n            lines.push(rowValues.join(' | '));\n          }\n        }\n      }\n      continue;\n    }\n\n    if (/^list\\d+$/i.test(key) && value && typeof value === 'object' && Array.isArray(value.items)) {\n      for (var l = 0; l < value.items.length; l++) {\n        var entry = normalizeString(value.items[l]);\n        if (entry) {\n          lines.push(entry);\n        }\n      }\n    }\n  }\n\n  return lines.join('\\n').trim();\n}\n\nfunction buildHistoryFromRelevantInfo(activeAtomicAgentDetails) {\n  var history = [];\n  var details = hasRelevantInfo(activeAtomicAgentDetails) ? activeAtomicAgentDetails : {};\n  var contextDetails = details && details.contextDetails && typeof details.contextDetails === 'object'\n    ? details.contextDetails\n    : {};\n  var workflowSessionState = contextDetails && contextDetails.workflowSessionState && typeof contextDetails.workflowSessionState === 'object'\n    ? contextDetails.workflowSessionState\n    : {};\n  var previousSessionData = workflowSessionState.prjPjcVarConvSessionData && typeof workflowSessionState.prjPjcVarConvSessionData === 'object'\n    ? workflowSessionState.prjPjcVarConvSessionData\n    : {};\n  var resolvedUserQuery = normalizeString(previousSessionData.resolvedUserQuery);\n  var responseText = normalizeAtomicAgentResponseContent(details.atomicAgentResponse);\n  var assistantParts = [];\n\n  if (resolvedUserQuery) {\n    assistantParts.push(resolvedUserQuery);\n  }\n  if (responseText) {\n    assistantParts.push(responseText);\n  }\n\n  if (assistantParts.length > 0) {\n    history.push({\n      role: 'assistant',\n      content: assistantParts.join('\\n')\n    });\n  }\n\n  return history;\n}\n\nvar envelope = extractEnvelope($context.$system.$inputMessage);\nvar candidateInputs = getWorkflowInputCandidates();\nvar routingCandidates = [envelope && envelope.prjPjcRoutingContext, $context.$variables.prjPjcVarConvRoutingContext];\nvar messageCandidates = [envelope && envelope.message];\nvar chatHistoryCandidates = [envelope && envelope.prjPjcChatHistory];\nvar atomicDetailCandidates = [envelope && envelope.prjPjcAtomicAgentRelevantInfo];\n\nfor (var i = 0; i < candidateInputs.length; i++) {\n  var candidate = candidateInputs[i] || {};\n  routingCandidates.push(candidate.prjPjcRoutingContext);\n  messageCandidates.push(candidate.message);\n  chatHistoryCandidates.push(candidate.prjPjcChatHistory);\n  atomicDetailCandidates.push(candidate.prjPjcAtomicAgentRelevantInfo);\n}\n\nvar routingContext = firstNonEmptyString(routingCandidates);\nvar isRedwoodUI = routingContext.toLowerCase() === 'redwoodui';\nvar originalUserMessage = isRedwoodUI ? firstNonEmptyString(messageCandidates) || normalizeString($context.$system.$inputMessage) : normalizeString($context.$system.$inputMessage);\nvar activeAtomicAgentDetails = isRedwoodUI ? firstObject(atomicDetailCandidates) || parseJsonSafe($context.$variables.prjPjcVarConvActiveAtomicAgentDetails, null) : parseJsonSafe($context.$variables.prjPjcVarConvActiveAtomicAgentDetails, null);\nvar relevantInfoPresent = isRedwoodUI && hasRelevantInfo(activeAtomicAgentDetails);\nvar providedChatHistory = isRedwoodUI ? firstNonEmptyString(chatHistoryCandidates) : '';\n\nvar formattedChatHistorySource = relevantInfoPresent\n  ? buildHistoryFromRelevantInfo(activeAtomicAgentDetails)\n  : (providedChatHistory || '');\nvar formattedChatHistory = normalizeChatHistory(formattedChatHistorySource, '');\nvar previousSessionData = relevantInfoPresent\n  ? parseJsonSafe(\n      activeAtomicAgentDetails &&\n      activeAtomicAgentDetails.contextDetails &&\n      activeAtomicAgentDetails.contextDetails.workflowSessionState &&\n      activeAtomicAgentDetails.contextDetails.workflowSessionState.prjPjcVarConvSessionData,\n      null\n    )\n  : parseJsonSafe($context.$variables.prjPjcVarConvSessionData, null);\nvar previousFilter = $context.$variables.prjPjcVarConvPreviousFilter;\nvar assistantMessage = lastAssistantMessage(formattedChatHistory);\nvar previousUserMessage = lastPriorUserMessage(formattedChatHistory, originalUserMessage);\nvar currentUserMessage = rewriteFollowUpMessage(originalUserMessage, previousSessionData, assistantMessage, previousUserMessage, activeAtomicAgentDetails);\nvar effectiveChatHistory = normalizeChatHistory(formattedChatHistory, currentUserMessage);\n\nif (isRedwoodUI && activeAtomicAgentDetails && typeof activeAtomicAgentDetails === 'object') {\n  if (activeAtomicAgentDetails.filters !== null && activeAtomicAgentDetails.filters !== undefined) {\n    previousFilter = activeAtomicAgentDetails.filters;\n  }\n}\n\nreturn {\n  routingContext: routingContext,\n  isRedwoodUI: isRedwoodUI,\n  currentUserMessage: currentUserMessage,\n  effectiveChatHistory: effectiveChatHistory,\n  activeAtomicAgentDetails: activeAtomicAgentDetails,\n  previousSessionData: previousSessionData,\n  previousFilter: previousFilter === undefined ? null : previousFilter\n};"
