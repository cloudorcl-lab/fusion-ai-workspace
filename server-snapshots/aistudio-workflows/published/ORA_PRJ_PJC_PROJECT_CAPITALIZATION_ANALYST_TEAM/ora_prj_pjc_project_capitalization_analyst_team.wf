            "returnType": "object",
            "sourceCode": "const result = $context.$nodes.EXTRACT_ASSET_DETAILS.$output.extractedDetails \n\nconst assetName = result.asset;\nconst projectInput = result.project;\n\nconst payload = {\n  \"viewQueries\": {\n    \"projectAsset\": {\n            \"module\": \"oraErpCoreProjectAsset\",\n            \"businessObject\": \"ProjectAsset\",\n            \"view\": \"projectAssetsView\",\n            \"fieldAliases\": {\n               \"description\": \"description\",\n                \"assetNumber\": \"assetNumber\",\n                \"actualUnits\": \"actualUnits\",\n                \"capitalHoldFlag\": \"capitalHoldFlag\",\n                \"capitalizedCost\": \"capitalizedCost\",\n                \"capitalizedDate\": \"capitalizedDate\",\n                \"capitalizedFlag\": \"capitalizedFlag\",\n                \"costAdjustmentFlag\": \"costAdjustmentFlag\",\n                \"createdBy\": \"createdBy\",\n                \"timeCreated\": \"timeCreated\",\n                \"actualInServiceOrRetirementDate\": \"actualInServiceOrRetirementDate\",\n                 \"manufacturerName\": \"manufacturerName\",\n                \"modelNumber\": \"modelNumber\",\n                 \"assetName\":\"assetName\",\n                 \"project.name\":\"projectName\",\n                 \"project.projectNumber\":\"projectNumber\",\n                  \"assetType.lookupCode\": \"assetTypeCode\"\n\n            }\n        }},\n  \"select\": ` SELECT assetName,description,assetNumber,assetTypeCode,actualUnits,capitalHoldFlag,capitalizedCost,capitalizedDate,costAdjustmentFlag,createdBy,timeCreated,actualInServiceOrRetirementDate,manufacturerName,modelNumber,projectName,projectNumber   FROM projectAsset where assetName='${assetName}' and (projectName='${projectInput}' or projectNumber='${projectInput}')` \n  \n};\n\nreturn payload;"
          },
