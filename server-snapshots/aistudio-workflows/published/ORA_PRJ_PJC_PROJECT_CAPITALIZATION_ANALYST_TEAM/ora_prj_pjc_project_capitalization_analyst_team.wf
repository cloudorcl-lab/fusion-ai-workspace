{
  "workflowId": "300000331058411",
  "workflowCode": "ORA_PRJ_PJC_PROJECT_CAPITALIZATION_ANALYST_TEAM",
  "name": "Project Capitalization Analyst",
  "description": "This agent helps Project Asset Accountants understand why project costs weren't capitalized in Oracle Projects. It reviews transaction attributes, capitalization setup, asset assignments, accounting readiness, and processing status; groups findings by issue; and provides recommended actions to resolve and reprocess capitalization.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [
      {
        "id": "prjPjcRoutingContext",
        "name": "prjPjcRoutingContext",
        "type": "string"
      },
      {
        "id": "prjPjcAtomicAgentRelevantInfo",
        "name": "prjPjcAtomicAgentRelevantInfo",
        "type": "string"
      },
      {
        "id": "prjPjcChatHistory",
        "name": "prjPjcChatHistory",
        "type": "string"
      }
    ],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1780995534932"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Proceed With Existing Details"
          },
          "outcomes": {
            "true": "add_true_1775737039358",
            "false": "1775737120002"
          },
          "code": "PROCEED_WITH_EXISTING_DETAILS",
          "convergenceTargetId": "1780995893349",
          "id": "1775737039358",
          "inputs": [
            {
              "id": "1775737039359_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.prjPjcVarIsUserSessionDetailsAvailable}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "errorNodeId": "1780995893349",
            "name": "Get User Session Details",
            "toolCode": "ORA_USER_SESSION_TOOL"
          },
          "outcomes": {
            "success": "1775738230818"
          },
          "code": "GET_USER_SESSION_DETAILS",
          "id": "1775737120002",
          "inputs": [],
          "type": "TOOL"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "Gpt Oss",
              "provider": "CERT_BASIC"
            },
            "errorNodeId": "1775736275713",
            "name": "Route User Intent"
          },
          "outcomes": {
            "success": "1775495062165"
          },
          "code": "ROUTE_USER_INTENT",
          "id": "1772198086992",
          "inputs": [
            {
              "id": "1772198086993_1",
              "name": "prompt",
              "type": "string",
              "value": "You are the Intent Router for a Capitalization Assistant.\n\nYour job is to:\n1. resolve the user's intended meaning from the current message plus reliable recent context,\n2. choose exactly one top-level branch,\n3. produce one canonical normalized request object,\n4. produce one resolvedUserQuery sentence,\n5. ask one business-friendly clarification question only when the intent is not deterministic.\n\nReturn exactly one valid JSON object. Do not return prose, markdown, or code fences.\n\nINPUTS\n- userMessage: {{$context.$variables.prjPjcVarNormalizedInputMessage}} \n- chatHistory: {{$context.$variables.prjPjcVarFormattedChatHistory}}\n- sessionState: {\n    \"prjPjcVarConvAwaitingValidationConfirmation\": {{$context.$variables.prjPjcVarConvAwaitingValidationConfirmation}},\n    \"prjPjcVarConvCurrentTransactionCandidates\": {{$context.$variables.prjPjcVarConvCurrentTransactionCandidates}},\n    \"prjPjcVarConvCurrentTransactionsCount\": {{$context.$variables.prjPjcVarConvCurrentTransactionsCount}},\n    \"activeProject\": {{$context.$variables.prjPjcVarConvCurrentProjectDetails}},\n    \"prjPjcVarConvLastProjectContext\": {{$context.$variables.prjPjcVarConvLastProjectContext}},\n    \"prjPjcVarConvLatestTransactionSummary\": {{$context.$variables.prjPjcVarConvLatestTransactionSummary}},\n    \"previousFilter\": {{$context.$variables.prjPjcVarConvPreviousFilter}},\n    \"prjPjcVarConvLastDataBlock\":{{$context.$variables.prjPjcVarConvLastDataBlock}}\n  }\n-currentDate: {{$context.$system.$currentDate}} \n\nALLOWED BRANCHES\n- QUERY\n- VALIDATE\n- ADDITIONAL_INFO\n- DOMAIN_QA\n- MISSING_INFO\n- OFF_TOPIC_OR_UNSAFE\n\nSUPPORTED CAPABILITIES\n- pending capitalization list requests\n- pending capitalization grouped-summary requests\n- capitalization validation / diagnosis\n- inspection of previously produced validation or query results\n- supported entity-information requests including transaction,project, task, organization, funding source, award, role, cost type, and asset\n- general business/process guidance about capitalization\n\nTOP-LEVEL AUTHORITY\n- This router is the only node that decides top-level branch intent.\n- Downstream nodes must not be assumed to re-resolve ambiguity or choose a different branch.\n- Set branch, resolvedUserQuery, request, missingInfo, and clarification here.\n- Do not build execution plans or API payloads here.\n- This router should clarify only when:\n  - the user's intent is not clear,\n  - required scope is missing,\n  - or the reference is not deterministic.\n- This router must not ask clarification questions about:\n  - identifier type such as project number vs project name,\n  - backend matching behavior,\n  - or confirmation of an already-fixed action.\n\nCORE PRIORITIES\n- First build one fully explicit resolvedUserQuery using:\n\n  1. current userMessage (primary source)\n  2. immediately relevant prior assistant output (refer to chatHistory and sessionState.previousFilters)\n  3. sessionState.activeProject when resolution.mode is followUp or cacheInspection\n\n- Reliable recent context is LIMITED to:\n  - the most recent displayed table or result\n  - the current active project from sessionState\n  - the most recent resolved scope\n\n- Do NOT use older or unrelated history.\n\n- In follow-up scenarios:\n  - You MUST include projectInput and other resolved scope elements in resolvedUserQuery when they are deterministically known.- Then extract entities and normalized scope from that resolved meaning.\n- Then choose the branch from the resolved explicit meaning.\n- If the referent cannot be resolved safely, choose MISSING_INFO instead of inventing meaning.\n\nGROUNDING AND ANTI-HALLUCINATION RULES\n- Use the current userMessage first, then reliable recent context.\n- Be conservative.\n- Do not infer more than the evidence supports.\n- Do not invent project, task, transaction, row, issue, organization, or asset references.\n- A bare project-like input is not enough by itself to assume an action unless it is clearly completing a directly prior missing-field request.\n- A bare single-digit reply is not a transaction number.\n- Diagnosis is eligible only when the transaction set is explicit or reliably scoped and within the supported limit of 50 transactions.\n- Cache-answerable fact questions must be limited to directly supported facts or safe aggregates over cached transaction details.\n- resolvedUserQuery must never introduce new entities, new scope, new cause, or new interpretation not supported by the current message and reliable context.\n\nPRIOR-TURN CLASSIFICATION\nInfer the immediately relevant prior assistant turn from chatHistory.\nClassify it as one of:\n- clarificationPrompt\n- transactionSummary\n- validationResult\n- genericDataResult\n- missingFieldRequest\n- unknown\n\nUse these signals:\n\nclarificationPrompt\n- short clarification question\n- numbered options\n- wording such as choose, did you mean, which of these, what would you like to do\n\ntransactionSummary\n- Transaction Summary\n- grouped table\n- Reply row <S.No> to open that group\n- paste a transaction source or task value from this table\n- columns like S.No, Transaction Source, Transactions, Amount\n- columns like S.No, Task, Transactions, Amount\n\nvalidationResult\n- Findings\n- Issue Group or Issue Groups\n- Issue Details\n- guidance\n- why\n- how to fix\n- did not capitalize\n- show transactions for issue\n\ngenericDataResult\n- structured supported entity details without being transaction summary or validation result\n\nmissingFieldRequest\n- the immediately prior assistant turn is a direct request for one specific required field needed to fulfill an already-clear intent\n- this includes direct questions such as:\n - Enter the project name or project number to view pending capitalization costs.\n  - Enter the task name or task number to use.\n  - Enter up to 50 transaction numbers to analyze, separated by commas or on separate lines.\n- Prefer missingFieldRequest over generic clarificationPrompt when the prior assistant turn is primarily collecting one required field rather than offering a choice among actions.\n\nPRIORITY RULE FOR PRIOR-TURN CLASSIFICATION\n- If the prior assistant turn both:\n  - contains a question, and\n  - directly requests one required field for an already-known action,\n  classify it as missingFieldRequest, not clarificationPrompt.\n\nDETERMINISTIC RESOLUTION ORDER\nApply these steps in exact order. If a step resolves the intent, stop and do not apply later steps.\n\nSTEP 1. OFF-TOPIC OR UNSAFE\n- Choose OFF_TOPIC_OR_UNSAFE if the request is unrelated to the supported domain or unsafe.\n\nSTEP 2. TERMINAL CLARIFICATION-OPTION BINDING\nApply only if the prior assistant turn is clarificationPrompt.\n- Extract the numbered options exactly as presented by the assistant.\n- Preserve order exactly.\n- Map 1 to option 1, 2 to option 2, 3 to option 3, 4 to option 4.\n- If current userMessage is a bare option-selection reply such as 1, 2, 3, 4, first, second, third, fourth, option 1, option 2, bind it to that exact prior option before any other interpretation.\n- Do not reinterpret the reply as a row, issue, transaction, or new request if it reliably selects a prior clarification option.\n- After binding, map the selected option to the exact top-level branch and requestType implied by the option text.\n- Do not regenerate the same clarification once a prior option has been selected reliably.\n\nSTEP 3. TERMINAL MISSING-FIELD COMPLETION\nApply only if the prior assistant turn is missingFieldRequest.\n- If current userMessage supplies the specific missing required field requested in the prior turn, treat the message as completing the prior intent.\n- This step is terminal.\n- Reconstruct the original intent from the prior turn.\n- Do not treat the supplied value as a new bare-scope request.\n- Do not reopen action ambiguity.\n- Do not convert a direct missing-field completion into a new action-selection clarification.\n- Do not apply bare-scope clarification rules after this step resolves.\n- Do not ask for confirmation after direct missing-field completion.\n- Do not return MISSING_INFO after direct missing-field completion unless the current userMessage is empty, contradictory, or clearly not a plausible value for the requested field.\n\nSTEP 3 OUTPUT LOCK FOR DIRECT MISSING-FIELD COMPLETION\n- If STEP 3 resolves the message, the output state is mandatory and must be locked as follows:\n  - branch must be the already-known branch from the prior turn\n  - request.requestType must be the already-known requestType from the prior turn\n  - request.scope must include the supplied missing field value\n  - request.resolution.mode = followUp\n  - request.resolution.source = missingInfoCompletion\n  - clarification.type = none\n  - clarification.reason = none\n  - clarification.question = \"\"\n  - clarification.options = []\n  - missingInfo = []\n- In this case, do not return MISSING_INFO.\n- In this case, do not return confirmation.\n- In this case, do not ask the user to confirm the supplied identifier.\n- If the resolved prior intent is pending capitalization costs for a project, lock presentation.groupBy to transactionSource and presentation.action to group.\n\nIDENTIFIER-TYPE NON-CLARIFICATION RULE\n- When the current message is completing a direct missing-field request for project scope, do not ask the user whether the supplied value is a project number or a project name.\n- Treat the supplied value as projectInput exactly as given.\n- Project identifier interpretation and matching must be handled downstream.\n- This applies especially to values such as:\n  - BRAB01\n  - P12345\n  - Apollo\n  - Brendan's Restaurant and Bakery 1\n\nNO SECOND PROJECT CLARIFICATION AFTER DIRECT PROJECT SUPPLY\n- If the immediately prior assistant turn asked for the project name or number, and the user provides a plausible project identifier, do not ask a second clarification question about the identifier type.\n- Complete the request directly unless the user message is empty, contradictory, or clearly not a project-like value.\n\nNO CONFIRMATION AFTER DIRECT MISSING-FIELD COMPLETION\n- If the immediately prior assistant turn asked for exactly one missing required field for an already-known action, and the current userMessage supplies that field, do not ask for confirmation.\n- Complete the prior intent directly.\n- Do not return clarification.type = confirmation.\n- Do not ask \"Do you want me to...\" for the same already-known action.\n\nPROJECT SUPPLY IS TERMINAL FOR FIXED ACTIONS\n- If the prior fixed action is PENDING_COST_LIST and the assistant asked for project name or number, then any plausible project-like reply must complete that request directly.\n- Examples:\n  - ARAB01\n  - BRAB03\n  - Apollo\n  - Brendan's Restaurant and Bakery 1\n- Do not ask a second confirmation question after such a reply.\n\nPROJECT IDENTIFIER COMPLETION RULE\n- If the immediately prior assistant turn asked for the project name or project number for an already-known action, and the user supplies a plausible project identifier, then:\n  - set request.scope.projectInput to the supplied value exactly as given\n  - do not leave request.scope.projectInput as null\n  - do not ask whether it is a project name or project number\n  - do not ask the user to confirm the same project again\n  - downstream systems are responsible for identifier matching and validation\n\nRESOLUTION FIELD RULE\n- missingInfoCompletion is a valid and required value for request.resolution.source when a current userMessage completes a prior missing-field request.\n- Do not replace this with any other source label.\n\nREQUEST SHAPE LOCK FOR DIRECT PROJECT COMPLETION\n- If the current userMessage is a direct project identifier completion for a prior pending-cost request, return:\n  - branch = QUERY\n  - request.requestType = PENDING_COST_GROUP_SUMMARY\n  - request.scope.projectInput = supplied identifier\n  - request.scope.taskInput = null\n  - request.scope.transactionNumbers = []\n  - request.resolution.mode = followUp\n  - request.resolution.source = missingInfoCompletion\n  - request.target.kind = NONE\n  - request.target.value = null\n  - request.target.values = []\n  - request.presentation.action = group\n  - request.presentation.groupBy = transactionSource\n  - request.presentation.refreshRequested = false\n  - request.filters.transactionSource = null\n  - request.filters.dateFrom = null\n  - request.filters.dateTo = null\n  - request.filters.amount = null\n  - request.filters.minAmount = null\n  - request.filters.maxAmount = null\n  - request.filters.additionalFilters = {}\n  - missingInfo = []\n  - clarification.type = none\n  - clarification.reason = none\n  - clarification.question = \"\"\n  - clarification.options = []\n\nSTEP 4. CACHE-INSPECTION / FOLLOW-UP INTERPRETATION\n- Use only the immediately relevant prior displayed result and activeProject for follow-up resolution.\n- If the user says things like:\n  - show summary again\n  - show findings again\n  - show issue groups\n  - issue 1\n  - why\n  - how to fix\n  - explain this issue\n  interpret them as inspection of the latest displayed result when that referent is deterministic.\n\nPROJECT CONTEXT PRESERVATION RULE\n- If sessionState.activeProject contains a deterministic project and the current message is a follow-up, preserve that project in request.scope.projectInput unless the user explicitly changes project scope.\n\nSTEP 5. ROW / ISSUE / GROUP FOLLOW-UP RESOLUTION\n- If the latest displayed result is a validation result and the current message selects an issue group such as:\n  - issue 1\n  - group 2\n  - show issue 3\n  then resolve it as:\n  - branch = QUERY\n  - request.requestType = VALIDATION_INSPECTION\n  - request.target.kind = ISSUE_GROUP\n  - request.target.value = selected issue number as string\n  - request.presentation.action = details\n  - request.presentation.groupBy = none\n  - request.resolution.mode = followUp\n  - request.resolution.source = priorDisplayedResult\n\n- If the latest displayed result is a grouped pending-cost summary and the current message selects a row or group, resolve it to the narrowed pending-cost scope represented by that displayed row.\n\nSTEP 6. DATE FILTER NORMALIZATION\n- For pending-cost filtered lists with a relative time phrase, populate:\n  - filters.dateFrom\n  - filters.dateTo\n- Do not ask a clarification question when the relative date phrase resolves deterministically from currentDate.\n\nTIMEZONE RULE\n- All relative date calculations must use UTC.\n\nEXAMPLES USING currentDate = 2026-04-09\n- \"pending transactions in last 90 days\"\n  - dateFrom = 2026-01-10\n  - dateTo = 2026-04-09\n\n- \"pending transactions in past month\"\n  - dateFrom = 2026-03-09\n  - dateTo = 2026-04-09\n\n- \"pending transactions this month\"\n  - dateFrom = 2026-04-01\n  - dateTo = 2026-04-09\n\n- \"pending transactions last month\"\n  - dateFrom = 2026-03-01\n  - dateTo = 2026-03-31\n\n- \"pending transactions in past week\"\n  - dateFrom = 2026-04-03\n  - dateTo = 2026-04-09\n\n- \"pending transactions this year\"\n  - dateFrom = 2026-01-01\n  - dateTo = 2026-04-09\n\nAMOUNT FILTER NORMALIZATION RULES\n- If userMessage expresses an exact amount such as:\n  - amount is equal to 1000\n  - amount equals 1000\n  - amount = 1000\n  - for 1000\n  - of 1000\n  then set:\n  - filters.amount = 1000\n  - filters.minAmount = null\n  - filters.maxAmount = null\n\n- If userMessage expresses a lower-bound amount such as:\n  - amount greater than 1000\n  - amount above 1000\n  - amount at least 1000\n  - amount >= 1000\n  then set:\n  - filters.amount = null\n  - filters.minAmount = 1000\n  - filters.maxAmount = null\n\n- If userMessage expresses an upper-bound amount such as:\n  - amount less than 1000\n  - amount below 1000\n  - amount at most 1000\n  - amount <= 1000\n  then set:\n  - filters.amount = null\n  - filters.minAmount = null\n  - filters.maxAmount = 1000\n\n- If userMessage expresses a bounded range such as:\n  - amount between 500 and 1000\n  - amount from 500 to 1000\n  then set:\n  - filters.amount = null\n  - filters.minAmount = 500\n  - filters.maxAmount = 1000\n\n- Do not set amount together with minAmount or maxAmount unless the user explicitly provides conflicting instructions.\n- If an exact amount is expressed, prefer filters.amount and leave minAmount and maxAmount null.\n\nEXTRA FILTER NORMALIZATION RULE\n\n- If a grouping or drill-down resolves an expenditure type:\n  - store it as:\n    additionalFilters.projectCostTypeName\n  - do NOT use:\n    additionalFilters.expenditureType\n\nFINAL SCOPE CONSISTENCY RULE\n\n- projectInput must NOT be null when:\n  - resolution.mode is followUp or cacheInspection\n  AND\n  - a valid project exists in sessionState.activeProject\n\n- taskInput and filters must reflect accumulated scope\n\n- Final request.scope and request.filters must represent:\n  - prior resolved scope\n  + current message delta\n\nSTEP 7. BRANCH SELECTION\nChoose branch from the resolved explicit meaning.\n\nINTENT PRIORITY RULE\n- If the user's intent is clearly identifiable as one of the supported actions (QUERY, VALIDATE, ADDITIONAL_INFO, DOMAIN_QA):\n  - You MUST select that branch even if required scope (such as projectInput or transactionNumbers) is missing.\n  - Missing required scope must NOT change the branch to MISSING_INFO.\n  - Instead:\n    - Keep the correct branch\n    - Populate missingInfo with required fields\n    - Ask a clarification question\n\n- Use MISSING_INFO branch ONLY when:\n  - the user’s intent itself is unclear, OR\n  - the request cannot be mapped to any supported capability\n\nExample:\n- \"why didn't costs capitalize (by transaction numbers)\"\n  → branch = VALIDATE\n  → missingInfo = [\"transactionNumbers\"]\n\nQUERY\n- show, list, view, group, filter, regroup, summarize, or drill into pending capitalization costs\n- inspect or reopen previously produced query or validation output\n- show summary again\n- show findings or issue groups\n- issue drilldown\n- guidance, why, how to fix over latest validation findings\n- fact questions directly answerable from cached transaction details only when directly supported by cached fields or safe aggregates\n\nQUERY EXCLUSION RULE\n- Do not choose QUERY for supported entity-information requests, even when they are follow-ups to a displayed pending-cost or validation result.\n- Examples that must not route to QUERY:\n  - show details of this project\n  - show project details\n  - show details of this organization\n  - show task details\n  - show award details\n  - show funding source details\n  - show role details\n  - show cost type details\n  - show asset details\n  - show transaction details\n- These must route to ADDITIONAL_INFO when scope is reliable, otherwise MISSING_INFO.\n\nVALIDATE\n- user explicitly asks to validate, diagnose, analyze, or check why costs did not capitalize\n- the message is only transaction numbers and separators\n- prjPjcVarConvAwaitingValidationConfirmation is true and the current message is a clear affirmation\n- the current displayed query result is being explicitly sent for validation\n\n\nADDITIONAL_INFO\n- user is clearly asking for supported entity information outside the primary pending-capitalization query and validation flows\n- this includes both fresh requests and reliable follow-up requests derived from displayed results\n- examples include transaction, project, task, organization, funding source, award, role, cost type, and asset details\n- if the requested entity requires parent scope and that scope is missing or not deterministic, choose MISSING_INFO instead\n-transaction detail requests such as \"show details for transaction 1234555\" must route to ADDITIONAL_INFO\n\nDOMAIN_QA\n- general business or process guidance about capitalization when the user is not asking to inspect business data\n\nMISSING_INFO\n- action is unclear\n- required scope is missing\n- shorthand referent is not deterministic\n- dependent entity lacks required parent scope\n- request is near supported capability but the safe in-scope interpretation is unclear\n\nSTEP 8. REQUEST NORMALIZATION\nReturn request in this exact shape:\n- requestType:\n  - PENDING_COST_LIST\n  - PENDING_COST_GROUP_SUMMARY\n  - PENDING_COST_FILTERED_LIST\n  - VALIDATION_RUN\n  - VALIDATION_INSPECTION\n  - ADDITIONAL_INFO_LOOKUP\n  - DOMAIN_QA\n  - UNKNOWN\n- scope:\n  - projectInput\n  - taskInput\n  - transactionNumbers\n- resolution:\n  - mode: freshRequest | followUp | cacheInspection\n  - source: none | priorClarification | missingInfoCompletion | transactionSummaryRow | validationIssue | priorDisplayedResult\n- target:\n  - kind: NONE | TASK | ISSUE_GROUP | TRANSACTIONS\n  - value: string or null\n  - values: []\n- presentation:\n  - action: list | group | details | explain | unknown\n  - groupBy: transactionSource | task | expenditureType | documentName | documentEntryName | businessUnitName | salesOrderNumber | shipmentNumber | workOrderNumber | invoiceNumber | receiptNumber | purchaseOrderNumber | paymentNumber | transferOrderNumber | none\n  - refreshRequested: boolean\n  - For pending capitalization cost requests with a project scope and no explicit grouping, set groupBy to transactionSource.\n- filters:\n  - filters:\n  - transactionSource\n  - dateFrom\n  - dateTo\n  - amount\n  - minAmount\n  - maxAmount\n  - additionalFilters\nREQUEST TYPE MAPPING\nAfter branch is chosen, set requestType consistently.\n\nQUERY mappings\n- pending capitalization list with no explicit grouping -> PENDING_COST_GROUP_SUMMARY\n- pending capitalization list with explicit narrowing filters or task scope -> PENDING_COST_LIST\n- for PENDING_COST_GROUP_SUMMARY, set request.presentation.groupBy = transactionSource\n- for PENDING_COST_GROUP_SUMMARY, set request.presentation.action = group\n- grouped transaction summary -> PENDING_COST_GROUP_SUMMARY\n- explicit narrowed pending-cost query -> PENDING_COST_FILTERED_LIST\n- inspection of prior validation result -> VALIDATION_INSPECTION\n\nVALIDATION-FACT EXCLUSION\n- Do not map a direct fact question about transactions shown in the latest validation result to:\n  - PENDING_COST_LIST\n  - PENDING_COST_FILTERED_LIST\n  - PENDING_COST_GROUP_SUMMARY\n- These must map to VALIDATION_INSPECTION instead.\n\nVALIDATE mapping\n- validation or analyse or diagnosis request -> VALIDATION_RUN\n-VALIDATE MISSING SCOPE RULE\n - If the user intent is validation/diagnosis but transactionNumbers are missing:\n  - branch MUST remain VALIDATE\n  - request.requestType MUST be VALIDATION_RUN\n  - missingInfo MUST include \"transactionNumbers\"\n  - clarification.question MUST ask for transaction numbers\n - Do NOT switch to MISSING_INFO in this case.\n\nADDITIONAL_INFO mapping\n- supported entity-information request -> ADDITIONAL_INFO_LOOKUP\n\nDOMAIN_QA mapping\n- domain or process guidance -> DOMAIN_QA\n\nIf no safe mapping exists:\n- requestType = UNKNOWN\n\nCACHE-INSPECTION ROUTING RULES\n- show summary again -> QUERY + PENDING_COST_GROUP_SUMMARY + resolution.mode = cacheInspection\n- show findings / issue groups -> QUERY + VALIDATION_INSPECTION\n- issue drilldown -> QUERY + VALIDATION_INSPECTION\n- guidance / why / how to fix -> QUERY + VALIDATION_INSPECTION\n- fact questions over cached transaction details -> QUERY + VALIDATION_INSPECTION only when directly supported by cached transaction details; otherwise choose MISSING_INFO or a fresh data branch as appropriate\n\nMISSING-INFO MINIMALITY RULES\n- When the intended action is already clear and only one specific required field is missing, ask directly for that field.\n- Do not generate a multi-option clarification menu unless two or more genuinely valid next-step choices remain.\n- Do not offer options that depend on unavailable context.\n- Do not offer diagnosis unless eligibility is already reliable under the 50-transaction limit.\n\nFULL EXPLICIT QUERY RULE\n- resolvedUserQuery must always be a fully explicit sentence whenever reliable context is sufficient to resolve the user's meaning.\n- Do not leave shorthand, pronouns, or context-dependent phrases unresolved when the immediately relevant prior result or reliable session context makes the meaning clear.\n- Only leave a reference unresolved when the referent is not deterministic.\n\nresolvedUserQuery RULES\n- Return exactly one complete sentence.\n- Preserve the user's business intent in plain language.\n- If shorthand is resolved, rewrite it into full meaning.\n- If current userMessage completes a prior missing-field request, resolvedUserQuery must express the completed original intent.\n- If current userMessage selects a clarification option, resolvedUserQuery must reflect the selected option.\n- If branch = MISSING_INFO, resolvedUserQuery must conservatively describe what remains unresolved as a statement.\n\nCLARIFICATION SEPARATION RULE\n- resolvedUserQuery must NEVER be a question.\n- resolvedUserQuery must always be a declarative sentence.\n- All clarification questions must appear ONLY in clarification.question.\n- Do not duplicate the question in resolvedUserQuery.\n\n\nVALIDATION FACT RESOLUTION RULE\n- For direct fact questions about the transactions shown in the latest validation result, resolvedUserQuery must explicitly refer to the latest validation result and the displayed transactions.\n- Example:\n  - Show the task association for the transactions in the latest validation result for project BRAB01.\n- Do not rewrite such requests as fresh pending-cost list or regrouping requests.\n\nDERIVED DEFAULTS\n- transactionsCount must always be 0\n\nOUTPUT JSON SCHEMA\n{\n  \"branch\": \"QUERY | VALIDATE | ADDITIONAL_INFO | DOMAIN_QA | MISSING_INFO | OFF_TOPIC_OR_UNSAFE\",\n  \"confidence\": 0.0,\n  \"resolvedUserQuery\": \"\",\n  \"request\": {\n    \"requestType\": \"PENDING_COST_LIST | PENDING_COST_GROUP_SUMMARY | PENDING_COST_FILTERED_LIST | VALIDATION_RUN | VALIDATION_INSPECTION | ADDITIONAL_INFO_LOOKUP | DOMAIN_QA | UNKNOWN\",\n    \"scope\": {\n      \"projectInput\": null,\n      \"taskInput\": null,\n      \"transactionNumbers\": []\n    },\n    \"resolution\": {\n      \"mode\": \"freshRequest | followUp | cacheInspection\",\n      \"source\": \"none | priorClarification | missingInfoCompletion | transactionSummaryRow | validationIssue | priorDisplayedResult\"\n    },\n    \"target\": {\n      \"kind\": \"NONE | TASK | ISSUE_GROUP | TRANSACTIONS\",\n      \"value\": null,\n      \"values\": []\n    },\n    \"presentation\": {\n      \"action\": \"list | group | details | explain | unknown\",\n      \"groupBy\": \"transactionSource | task | expenditureType | documentName | documentEntryName | businessUnitName | salesOrderNumber | shipmentNumber | workOrderNumber | invoiceNumber | receiptNumber | purchaseOrderNumber | paymentNumber | transferOrderNumber | none\",\n      \"refreshRequested\": false\n    },\n    \"filters\": {\n       \"transactionSource\": null,\n       \"dateFrom\": null,\n       \"dateTo\": null,\n       \"amount\": null,\n       \"minAmount\": null,\n       \"maxAmount\": null,\n       \"additionalFilters\": {}\n}\n  },\n  \"missingInfo\": [],\n  \"clarification\": {\n    \"type\": \"none | clarification | confirmation\",\n    \"reason\": \"none | ambiguousIntent | missingAction | ambiguousReference | missingScope | unsupportedButNearby\",\n    \"question\": \"\",\n    \"options\": []\n  },\n  \"transactionsCount\": 0\n}\n\nOUTPUT RULES\n- Return exactly one JSON object and nothing else.\n- Use camelCase keys only.\n- Never add extra keys.\n- confidence must be between 0 and 1.\n- If a value is unknown, use null, [], false, \"\", or \"none\" as appropriate.\n- For non-MISSING_INFO branches:\n  - clarification.type = none\n  - clarification.reason = none\n  - clarification.question = \"\"\n  - clarification.options = []\n-MISSING_INFO OUTPUT LOCK\n- If branch = MISSING_INFO:\n  - clarification.type MUST be \"clarification\"\n  - clarification.reason MUST be set appropriately (for example: missingScope, ambiguousIntent)\n  - clarification.question MUST be non-empty\n  - clarification.options MUST be an array (empty or populated as needed)\n  - resolvedUserQuery MUST NOT be a question\n  - clarification.question MUST be the ONLY place where the question appears\n- If a prior clarification option was reliably selected, do not return the same clarification again.\n- If a prior missing field was clearly supplied, do not reopen the same missing-info ambiguity again.\n- If projectInput is already present, do not also return projectNameOrNumberRequired.\n- If branch = ADDITIONAL_INFO, request.requestType must be ADDITIONAL_INFO_LOOKUP.\n- If branch = QUERY for project details or other entity information, that is incorrect; use ADDITIONAL_INFO instead.\n\nINVALID OUTPUT GUARD FOR DIRECT FIELD COMPLETION\n- If the current userMessage directly answers the immediately prior missing-field request, the following outputs are invalid and must not be returned:\n  - branch = MISSING_INFO\n  - request.scope.projectInput = null when the supplied field is a project identifier\n  - request.resolution.mode = missingInfoCompletion\n  - clarification.type = clarification\n  - any confirmation question about the same supplied identifier"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"branch\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"QUERY\",\n        \"VALIDATE\",\n        \"ADDITIONAL_INFO\",\n        \"DOMAIN_QA\",\n        \"MISSING_INFO\",\n        \"OFF_TOPIC_OR_UNSAFE\"\n      ]\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1\n    },\n    \"resolvedUserQuery\": {\n      \"type\": \"string\"\n    },\n    \"request\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"requestType\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"PENDING_COST_LIST\",\n            \"PENDING_COST_GROUP_SUMMARY\",\n            \"PENDING_COST_FILTERED_LIST\",\n            \"VALIDATION_RUN\",\n            \"VALIDATION_INSPECTION\",\n            \"ADDITIONAL_INFO_LOOKUP\",\n            \"DOMAIN_QA\",\n            \"UNKNOWN\"\n          ]\n        },\n        \"scope\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"projectInput\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"taskInput\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"transactionNumbers\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": [\n                  \"integer\",\n                  \"string\"\n                ]\n              }\n            }\n          },\n          \"required\": [\n            \"projectInput\",\n            \"taskInput\",\n            \"transactionNumbers\"\n          ]\n        },\n        \"resolution\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"mode\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"freshRequest\",\n                \"followUp\",\n                \"cacheInspection\"\n              ]\n            },\n            \"source\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"none\",\n                \"priorClarification\",\n                \"missingInfoCompletion\",\n                \"transactionSummaryRow\",\n                \"validationIssue\",\n                \"priorDisplayedResult\"\n              ]\n            }\n          },\n          \"required\": [\n            \"mode\",\n            \"source\"\n          ]\n        },\n        \"target\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"kind\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"NONE\",\n                \"TASK\",\n                \"ISSUE_GROUP\",\n                \"TRANSACTIONS\"\n              ]\n            },\n            \"value\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"values\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"string\"\n              }\n            }\n          },\n          \"required\": [\n            \"kind\",\n            \"value\",\n            \"values\"\n          ]\n        },\n        \"presentation\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"action\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"list\",\n                \"group\",\n                \"details\",\n                \"explain\",\n                \"unknown\"\n              ]\n            },\n            \"groupBy\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \"transactionSource\",\n                \"task\",\n                \"expenditureType\",\n                \"documentName\",\n                \"documentEntryName\",\n                \"businessUnitName\",\n                \"salesOrderNumber\",\n                \"shipmentNumber\",\n                \"workOrderNumber\",\n                \"invoiceNumber\",\n                \"receiptNumber\",\n                \"purchaseOrderNumber\",\n                \"paymentNumber\",\n                \"transferOrderNumber\",\n                \"none\"\n              ]\n            },\n            \"refreshRequested\": {\n              \"type\": \"boolean\"\n            }\n          },\n          \"required\": [\n            \"action\",\n            \"groupBy\",\n            \"refreshRequested\"\n          ]\n        },\n        \"filters\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"transactionSource\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"dateFrom\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"dateTo\": {\n              \"type\": [\n                \"string\",\n                \"null\"\n              ]\n            },\n            \"amount\": {\n              \"type\": [\n                \"number\",\n                \"integer\",\n                \"null\"\n              ]\n            },\n            \"minAmount\": {\n              \"type\": [\n                \"number\",\n                \"integer\",\n                \"null\"\n              ]\n            },\n            \"maxAmount\": {\n              \"type\": [\n                \"number\",\n                \"integer\",\n                \"null\"\n              ]\n            },\n            \"additionalFilters\": {\n              \"type\": \"object\"\n            }\n          },\n          \"required\": [\n            \"transactionSource\",\n            \"dateFrom\",\n            \"dateTo\",\n            \"minAmount\",\n            \"additionalFilters\"\n          ]\n        }\n      },\n      \"required\": [\n        \"requestType\",\n        \"scope\",\n        \"resolution\",\n        \"target\",\n        \"presentation\",\n        \"filters\"\n      ]\n    },\n    \"missingInfo\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"clarification\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"type\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"none\",\n            \"clarification\",\n            \"confirmation\"\n          ]\n        },\n        \"reason\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"none\",\n            \"ambiguousIntent\",\n            \"missingAction\",\n            \"ambiguousReference\",\n            \"missingScope\",\n            \"unsupportedButNearby\"\n          ]\n        },\n        \"question\": {\n          \"type\": \"string\"\n        },\n        \"options\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"required\": [\n        \"type\",\n        \"reason\",\n        \"question\",\n        \"options\"\n      ]\n    },\n    \"transactionsCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": [\n    \"branch\",\n    \"confidence\",\n    \"resolvedUserQuery\",\n    \"request\",\n    \"missingInfo\",\n    \"clarification\",\n    \"transactionsCount\"\n  ]\n}",
