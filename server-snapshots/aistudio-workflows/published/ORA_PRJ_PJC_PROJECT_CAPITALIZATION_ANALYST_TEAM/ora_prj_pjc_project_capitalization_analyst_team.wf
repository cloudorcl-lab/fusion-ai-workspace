        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Format Transaction List for Validation",
            "returnType": "object",
            "sourceCode": "let extractedInput = $context.$nodes.PLAN_TRANSACTION_VALIDATION.$output.transactionNumbers;\nlet fetchedInput = $context.$variables.prjPjcVarConvCurrentTransactionCandidates;\n\nlet extracted = Array.isArray(extractedInput)\n  ? extractedInput\n  : (typeof extractedInput === \"string\" && extractedInput.trim()\n      ? JSON.parse(extractedInput)\n      : []);\n\nlet fetched = Array.isArray(fetchedInput)\n  ? fetchedInput\n  : (typeof fetchedInput === \"string\" && fetchedInput.trim()\n      ? JSON.parse(fetchedInput)\n      : []);\n\nif (!Array.isArray(extracted)) extracted = [];\nif (!Array.isArray(fetched)) fetched = [];\n\nlet Transactions = [];\n\nif (extracted.length === 0 && fetched.length === 0) {\n  Transactions = [];\n} else if (extracted.length === 0 && fetched.length > 0) {\n  Transactions = fetched;\n} else if (extracted.length > 0 && fetched.length === 0) {\n  Transactions = extracted;\n} else {\n  Transactions = extracted;\n}\n\nreturn Transactions;"
          },
          "outcomes": {
            "success": "1775560713482"
          },
          "code": "FORMAT_TRANSACTION_LIST_FOR_VALIDATION",
          "id": "1773762487744",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Validation Transaction Count Payload",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.EXTRACT_REQUEST_PARAMS.$output.result;\n\nconst currentProjectDetails = $context.$variables.prjPjcVarConvCurrentProjectDetails;\n\nconst fieldAliases = {\n  \"project.projectNumber\": \"projectNumber\",\n  \"includedInAssetLine\": \"includedInAssetLine\",\n  \"capitalizable.lookupCode\": \"capitalizableFlag\",\n  \"projectCostClassification.code\": \"projectCostClassificationCode\",\n  \"project.projectType.constructionInProgressCostBasis\": \"capitalCostTypeCode\",\n  \"burdenedCostInReceiverLedgerCurrency\": \"burdenedCostInReceiverLedgerCurrency\",\n  \"rawCostInReceiverLedgerCurrency\": \"rawCostInReceiverLedgerCurrency\",\n  \"transactionNumber\": \"transactionNumber\",\n  \"transactionDate\": \"transactionDate\",\n  \"transactionSource.name\": \"transactionSource\",\n  \"task.taskNumber\": \"taskNumber\",\n  \"task.name\": \"taskName\",\n  \"project.name\": \"projectName\",\n  \"projectCostType.name\": \"expenditureType\",\n  \"createdBy\": \"createdBy\",\n  \"timeCreated\": \"timeCreated\",\n  \"contract.contractNumber\": \"contractNumber\",\n  \"contract.contractName\": \"contractName\",\n  \"fundingSource.fundingSourceNumber\": \"fundingSourceNumber\",\n  \"supplier.supplierNumber\": \"supplierNumber\",\n  \"supplier.name\": \"supplierName\",\n  \"originalTransactionReference\": \"originalTransactionReference\",\n  \"netZeroItemFlag\": \"netZeroItemFlag\",\n  \"transferredFromTransactionNumber\": \"transferredFromTransactionNumber\",\n  \"adjustingTransactionNumber\": \"adjustingTransactionNumber\",\n  \"accrualFlag\": \"accrualFlag\",\n  \"providerAccrualDate\": \"providerAccrualDate\",\n  \"receiverAccrualDate\": \"receiverAccrualDate\",\n  \"document.name\": \"documentName\",\n  \"documentEntry.name\": \"documentEntryName\",\n  \"projectRole.name\": \"projectRoleName\",\n  \"personJob.name\": \"personJobName\",\n  \"businessUnit.name\": \"businessUnitName\",\n  \"burdenedCostInProviderLedgerCurrency\": \"burdenedCostInProviderLedgerCurrency\",\n  \"rawCostInProviderLedgerCurrency\": \"rawCostInProviderLedgerCurrency\",\n  \"burdenedCostInTransactionCurrency\": \"burdenedCostInTransactionCurrency\",\n  \"rawCostInTransactionCurrency\": \"rawCostInTransactionCurrency\",\n  \"quantity\": \"quantity\",\n  \"salesOrderNumber\": \"salesOrderNumber\",\n  \"shipmentNumber\": \"shipmentNumber\",\n  \"workOrderNumber\": \"workOrderNumber\",\n  \"invoiceNumber\": \"invoiceNumber\",\n  \"receiptNumber\": \"receiptNumber\",\n  \"purchaseOrderNumber\": \"purchaseOrderNumber\",\n  \"paymentNumber\": \"paymentNumber\",\n  \"transferOrderNumber\": \"transferOrderNumber\",\n  \"providerLedgerCurrency.currencyCode\": \"providerLedgerCurrencyCode\"\n};\n\nconst aliasNames = Object.values(fieldAliases);\nconst conditions = [];\nconst caseInsensitiveFields = [\n  \"taskNumber\",\n  \"taskName\",\n  \"expenditureType\",\n  \"contractNumber\",\n  \"contractName\",\n  \"fundingSourceNumber\",\n  \"supplierNumber\",\n  \"supplierName\",\n  \"documentName\",\n  \"documentEntryName\",\n  \"projectRoleName\",\n  \"personJobName\",\n  \"businessUnitName\",\n  \"projectCostTypeName\",\n  \"projectCostTypeCode\"\n];\n\nif (\n  currentProjectDetails &&\n  currentProjectDetails.projectNumber !== null &&\n  currentProjectDetails.projectNumber !== undefined &&\n  currentProjectDetails.projectNumber !== \"\"\n) {\n  conditions.push(\"projectNumber='\" + String(currentProjectDetails.projectNumber).replace(/'/g, \"''\") + \"'\");\n}\n\nconditions.push(\"includedInAssetLine='N'\");\nconditions.push(\"capitalizableFlag='Y'\");\nconditions.push(\"(capitalCostTypeCode <> 'R' OR projectCostClassificationCode <> 'BTC')\");\n\nif (input.filters) {\n  for (const originalKey in input.filters) {\n    const value = input.filters[originalKey];\n\n    if (value === null || value === undefined || value === \"\") {\n      continue;\n    }\n\n    let key = originalKey;\n\n    if (key === \"projectCostTypeCode\" || key === \"projectCostTypeName\" || key===\"costType\") {\n      key = \"expenditureType\";\n    }\n\n    if (key === \"taskInput\") {\n      if (Array.isArray(value)) {\n        const validTaskValues = [];\n        for (const taskValue of value) {\n          if (taskValue !== null && taskValue !== undefined && taskValue !== \"\") {\n            validTaskValues.push(\"'\" + String(taskValue).replace(/'/g, \"''\").toUpperCase() + \"'\");\n          }\n        }\n\n        if (validTaskValues.length === 1) {\n          const oneTask = validTaskValues[0];\n          conditions.push(\"(UPPER(taskName)=\" + oneTask + \" OR UPPER(taskNumber)=\" + oneTask + \")\");\n        } else if (validTaskValues.length > 1) {\n          const inList = validTaskValues.join(\", \");\n          conditions.push(\"(UPPER(taskName) IN (\" + inList + \") OR UPPER(taskNumber) IN (\" + inList + \"))\");\n        }\n      } else {\n        const oneTask = \"'\" + String(value).replace(/'/g, \"''\").toUpperCase() + \"'\";\n        conditions.push(\"(UPPER(taskName)=\" + oneTask + \" OR UPPER(taskNumber)=\" + oneTask + \")\");\n      }\n      continue;\n    }\n\n    if (key === \"dateFrom\") {\n      conditions.push(\"transactionDate >= TO_DATE('\" + String(value).replace(/'/g, \"''\") + \"','YYYY-MM-DD')\");\n      continue;\n    }\n\n    if (key === \"dateTo\") {\n      conditions.push(\"transactionDate <= TO_DATE('\" + String(value).replace(/'/g, \"''\") + \"','YYYY-MM-DD')\");\n      continue;\n    }\n\n    if (key === \"amount\") {\n      conditions.push(\"(CASE WHEN capitalCostTypeCode = 'B' THEN COALESCE(burdenedCostInReceiverLedgerCurrency, 0) WHEN capitalCostTypeCode = 'R' THEN COALESCE(rawCostInReceiverLedgerCurrency, 0) ELSE 0 END) = \" + Number(value));\n      continue;\n    }\n\n    if (key === \"minAmount\") {\n      conditions.push(\"(CASE WHEN capitalCostTypeCode = 'B' THEN COALESCE(burdenedCostInReceiverLedgerCurrency, 0) WHEN capitalCostTypeCode = 'R' THEN COALESCE(rawCostInReceiverLedgerCurrency, 0) ELSE 0 END) >= \" + Number(value));\n      continue;\n    }\n\n    if (key === \"maxAmount\") {\n      conditions.push(\"(CASE WHEN capitalCostTypeCode = 'B' THEN COALESCE(burdenedCostInReceiverLedgerCurrency, 0) WHEN capitalCostTypeCode = 'R' THEN COALESCE(rawCostInReceiverLedgerCurrency, 0) ELSE 0 END) <= \" + Number(value));\n      continue;\n    }\n\n    if (aliasNames.includes(key)) {\n      if (Array.isArray(value)) {\n        const validValues = [];\n        for (const item of value) {\n          if (item !== null && item !== undefined && item !== \"\") {\n            if (caseInsensitiveFields.includes(key)) {\n              validValues.push(\"UPPER('\" + String(item).replace(/'/g, \"''\") + \"')\");\n            } else {\n              validValues.push(\"'\" + String(item).replace(/'/g, \"''\") + \"'\");\n            }\n          }\n        }\n\n        if (validValues.length === 1) {\n          if (caseInsensitiveFields.includes(key)) {\n            conditions.push(\"UPPER(\" + key + \")=\" + validValues[0]);\n          } else {\n            conditions.push(key + \"=\" + validValues[0]);\n          }\n        } else if (validValues.length > 1) {\n          if (caseInsensitiveFields.includes(key)) {\n            conditions.push(\"UPPER(\" + key + \") IN (\" + validValues.join(\", \") + \")\");\n          } else {\n            conditions.push(key + \" IN (\" + validValues.join(\", \") + \")\");\n          }\n        }\n      } else {\n        if (caseInsensitiveFields.includes(key)) {\n          conditions.push(\"UPPER(\" + key + \")='\" + String(value).replace(/'/g, \"''\").toUpperCase() + \"'\");\n        } else {\n          conditions.push(key + \"='\" + String(value).replace(/'/g, \"''\") + \"'\");\n        }\n      }\n    }\n  }\n}\n\nconst countPayload = {\n  viewQueries: {\n    projectCostTransaction: {\n      module: \"oraErpCoreProjectCostTransactions\",\n      businessObject: \"ProjectCostTransaction\",\n      view: \"projectCostTransactionDetails\",\n      fieldAliases: fieldAliases\n    }\n  },\n  select: \"SELECT COUNT(1) AS Count FROM projectCostTransaction WHERE \" + conditions.join(\" AND \"),\n  return: [\n    {\n      name: \"Count\",\n      type: \"string\"\n    }\n  ]\n};\n\nreturn countPayload;"
          },
          "outcomes": {
            "success": "1773223473895"
          },
          "code": "BUILD_VALIDATION_TRANSACTION_COUNT_PAYLOAD",
          "id": "1775555861813",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
