            "name": "Can Proceed To Validation",
            "returnType": "boolean",
            "sourceCode": "let input = $context.$nodes.FORMAT_TRANSACTION_LIST_FOR_VALIDATION.$output.result \n\nlet transactions = [];\n\nif (Array.isArray(input)) {\n  transactions = input;\n} else if (typeof input === \"string\" && input.trim()) {\n  try {\n    const parsed = JSON.parse(input);\n\n    if (Array.isArray(parsed)) {\n      transactions = parsed;\n    } else if (typeof parsed === \"string\" && parsed.trim()) {\n      transactions = [parsed];\n    } else if (parsed != null) {\n      transactions = [parsed];\n    }\n  } catch {\n    transactions = [input];\n  }\n}\n\nif (!Array.isArray(transactions)) {\n  transactions = [];\n}\n\nreturn transactions.length > 0 && transactions.length <= 50;"
          },
          "outcomes": {
            "success": "1773762744073"
          },
