            "name": "Check Asset Details Avalability",
            "returnType": "boolean",
            "sourceCode": "let data = $context.$nodes.GET_ASSET_DETAILS.$output ;\n\nif (typeof data === \"string\") {\n  try {\n    data = JSON.parse(data);\n  } catch (e) {\n    return false;\n  }\n}\nlet result = false;\nif (Array.isArray(data) && data.length > 0) {\n result = true;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775751389742"
          },
          "code": "CHECK_ASSET_DETAILS_AVALABILITY",
          "id": "1775746678732",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Check Validation Count Threshold",
            "returnType": "boolean",
            "sourceCode": "const input= $context.$nodes.GET_VALIDATION_TRANSACTION_COUNT.$output \nlet result = false;\n\n// Normalize to array\nlet arr =\nArray.isArray(input)\n? input\n: (typeof input === 'string' ? JSON.parse(input) : null);\n\n// Validate array and extract Count\nif (Array.isArray(arr) && arr.length > 0 && arr[0] && 'Count' in arr[0]) {\nconst num = Number(arr[0].Count);\nif (Number.isFinite(num) && num <= 50) {\nresult = true;\n}\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773669643855"
          },
          "code": "CHECK_VALIDATION_COUNT_THRESHOLD",
          "convergenceTargetId": "1773223122031",
          "id": "1773669192821",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Format Cached Validation Results",
            "returnType": "object",
            "sourceCode": "let gr = $context.$nodes.VALIDATION_ENGINE.$output.output ;\nlet ic = {\n  \"version\": \"1.4\",\n  \"language\": \"en\",\n  \"mappings\": [\n    {\n      \"code\": \"Transaction_Doesnot_Exist\",\n      \"shortIssueText\": \"Transaction not found\",\n      \"detailedIssueText\": \"The transaction number was not found. Confirm the transaction number and try again.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs.\",\n        \"Search for the affected transaction.\",\n        \"If the transaction is not found, confirm that the transaction number is correct and that the transaction was successfully created or imported.\",\n        \"Run the validation again after correcting the transaction number.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Project_Not_Enabled_For_Capitalization\",\n      \"shortIssueText\": \"Project is not enabled for capitalization\",\n      \"detailedIssueText\": \"The transaction belongs to a project that is not enabled for capitalization.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Confirm that the project should be capitalized according to your business policy.\",\n        \"Use a project that was created from a project template whose project type is enabled for capitalization.\",\n        \"Move or recreate the costs on the correct capital project, if required by your business process.\",\n        \"Run Generate Asset Lines again for the transaction on the capital-enabled project.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Task_Not_Enabled_For_Capitalization\",\n      \"shortIssueText\": \"Task is not enabled for capitalization\",\n      \"detailedIssueText\": \"The task for this transaction is not enabled for capitalization, so asset lines cannot be generated.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Confirm that the task should be capitalizable according to your business policy.\",\n        \"Update the task capitalization setup, or move the cost to a capitalizable task if required.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Transaction_Marked_Not_Capitalizable\",\n      \"shortIssueText\": \"Transaction is not capitalizable\",\n      \"detailedIssueText\": \"The transaction is marked as noncapitalizable, so asset lines cannot be generated.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs.\",\n        \"Search for the affected transaction.\",\n        \"Confirm that the transaction should be capitalizable according to your business policy.\",\n        \"Correct the source transaction or adjustment if the transaction should be capitalizable.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Project_Status_Not_Capitalizable\",\n      \"shortIssueText\": \"Project status blocks capitalization\",\n      \"detailedIssueText\": \"Capitalization is blocked by project or task status controls.\",\n      \"whereToGo\": \"Project Financial Management > Manage Financial Project Settings\",\n      \"guidanceSteps\": [\n        \"Open the affected project.\",\n        \"Review the project and task status controls for capitalization.\",\n        \"Update the project or task status controls to allow capitalization, if appropriate for your business policy.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Raw_BTC\",\n      \"shortIssueText\": \"Capitalization basis mismatch\",\n      \"detailedIssueText\": \"The transaction is a summarized burden transaction, but the project is configured to capitalize raw cost. There is no raw cost amount available to capitalize.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs and open the affected transaction.\",\n        \"Review the transaction cost basis and confirm whether the project should capitalize raw or burdened cost.\",\n        \"If the project should capitalize burdened cost, update the project setup according to your policy.\",\n        \"If the project must capitalize raw cost, correct the source cost so a valid raw amount is available.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\",\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Capitalized\",\n      \"shortIssueText\": \"Transaction is already capitalized\",\n      \"detailedIssueText\": \"The transaction has already been capitalized, so new asset lines will not be generated for the same transaction.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"No corrective action is required.\",\n        \"To review the generated asset lines, go to Projects > Assets > Manage Capital Projects, open the affected project, and select Actions > Manage Asset Lines.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"CrossCharge\",\n      \"shortIssueText\": \"Cross-ledger cost is not eligible\",\n      \"detailedIssueText\": \"This transaction is a cross-ledger cross-charge cost and is not eligible for this capitalization process.\",\n      \"whereToGo\": \"\",\n      \"guidanceSteps\": [\n        \"Exclude this transaction from the capitalization run, or follow your organization's cross-ledger cross-charge capitalization process if one applies.\"\n      ],\n      \"parameters\": []\n    },\n    {\n      \"code\": \"ZeroCost\",\n      \"shortIssueText\": \"Eligible cost amount is zero\",\n      \"detailedIssueText\": \"The transaction has a zero amount for the capitalization cost basis, so there is no cost to capitalize.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs.\",\n        \"Search for the affected transaction and open it.\",\n        \"Review the raw and burdened cost amounts for the capitalization basis used by the project.\",\n        \"If the amount should not be zero, correct the source cost or adjustment.\",\n        \"Complete accounting if required, then run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Pending_Adjustments\",\n      \"shortIssueText\": \"Transaction has a pending adjustment\",\n      \"detailedIssueText\": \"The transaction has an adjustment in progress, so it is not in a final state for capitalization.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs.\",\n        \"Search for the affected transaction and review the adjustment status.\",\n        \"Complete or cancel the pending adjustment according to your business process.\",\n        \"Run Generate Asset Lines again after the transaction is in a final state.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Event_DoesNot_Exists\",\n      \"shortIssueText\": \"Capital event is required\",\n      \"detailedIssueText\": \"The project uses an event-based processing method, but no capital event is available for this transaction.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Assets > Manage Capital Projects and open the affected project.\",\n        \"Select Actions > Manage Capital Events.\",\n        \"Create a capital event according to your event-based capitalization process.\",\n        \"Associate eligible assets to the event if required.\",\n        \"Include the affected transaction costs in the event according to your process.\",\n        \"Run Generate Asset Lines again and select the event.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\",\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Event_Exists\",\n      \"shortIssueText\": \"Capital event setup is incomplete\",\n      \"detailedIssueText\": \"The project uses an event-based processing method, but the transaction is not linked to an eligible capital event or the event setup is incomplete.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Assets > Manage Capital Projects and open the affected project.\",\n        \"Select Actions > Manage Capital Events and open the intended event.\",\n        \"Confirm that eligible assets are associated with the event if required.\",\n        \"Include the affected transaction costs in the event according to your process.\",\n        \"Run Generate Asset Lines again and select the event.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\",\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Asset_Not_Event_Stamped\",\n      \"shortIssueText\": \"No project asset is linked to the capital event\",\n      \"detailedIssueText\": \"The transaction is linked to a capital event, but no project asset is associated with that event.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Assets > Manage Capital Projects and open the affected project.\",\n        \"Select Actions > Manage Capital Events and open the event linked to the affected transaction.\",\n        \"Associate the correct project asset with the event.\",\n        \"Verify the related asset setup in Manage Capital Assets if needed.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\",\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Inservice_Asset_On_Hold\",\n      \"shortIssueText\": \"Project asset is on hold\",\n      \"detailedIssueText\": \"An associated project asset is on hold, so it cannot receive capitalized cost.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Assets > Manage Capital Projects and open the affected project.\",\n        \"Select Actions > Manage Capital Assets.\",\n        \"Locate the related project asset.\",\n        \"Remove Capital Hold when the asset is ready to receive project costs according to your policy.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Inservice_Asset_Not_On_Hold\",\n      \"shortIssueText\": \"Asset hold is not blocking capitalization\",\n      \"detailedIssueText\": \"An eligible project asset exists and is not on hold. If asset lines were not generated, another prerequisite is blocking capitalization.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"No action is required for asset hold.\",\n        \"Review any other issue groups shown for the affected transaction.\",\n        \"Common next checks are asset assignments, capital event setup, and accounting completion.\"\n      ],\n      \"parameters\": []\n    },\n    {\n      \"code\": \"Inservice_Asset_Doesnot_Exist\",\n      \"shortIssueText\": \"No eligible project asset exists\",\n      \"detailedIssueText\": \"No eligible project asset exists for this project, so asset lines cannot be generated.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Assets > Manage Capital Projects and open the affected project.\",\n        \"Select Actions > Manage Capital Assets.\",\n        \"Create or update the project asset as needed.\",\n        \"If the asset is ready to receive costs, set the project asset type to As-built and provide an actual in-service date.\",\n        \"Confirm that asset assignments are valid for the project or task level.\",\n        \"Run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"NoProjectAssignment\",\n      \"shortIssueText\": \"Project assets are not assigned\",\n      \"detailedIssueText\": \"Asset lines cannot be created because project assets have not been assigned to this project or task structure.\",\n      \"whereToGo\": \"Projects > Assets > Manage Capital Projects\",\n      \"guidanceSteps\": [\n        \"Assign project assets at the project or task level according to your capitalization design.\",\n        \"For bulk updates, use the Project Asset and Assignment Interface FBDI workbook.\",\n        \"After assignments are in place, run Generate Asset Lines again.\"\n      ],\n      \"parameters\": [\n        \"ProjectNumber\"\n      ]\n    },\n    {\n      \"code\": \"Accounting_Not_Run\",\n      \"shortIssueText\": \"Accounting is not complete\",\n      \"detailedIssueText\": \"Accounting is not complete for the transaction, so asset lines cannot be generated yet.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Go to Projects > Costs > Manage Project Costs.\",\n        \"Search for the affected transaction and open it.\",\n        \"Review the accounting status.\",\n        \"Run or complete accounting as required.\",\n        \"Run Generate Asset Lines again after accounting is complete.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Accounting_Errors\",\n      \"shortIssueText\": \"Accounting errors must be resolved\",\n      \"detailedIssueText\": \"One or more cost distributions for this transaction have accounting issues that must be resolved before capitalization.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Review the transaction accounting status and accounting error details.\",\n        \"If reset accounting is allowed, correct the Subledger Accounting setup, reset accounting for the affected transaction, and run Create Accounting.\",\n        \"If reset accounting is not allowed, reverse and reload the transaction with the correct attributes according to your business process.\",\n        \"Contact Oracle Support if the accounting issue cannot be resolved through standard correction steps.\",\n        \"Run Generate Asset Lines again after accounting is complete.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    },\n    {\n      \"code\": \"Catch_All\",\n      \"shortIssueText\": \"Generate Asset Lines setup needs review\",\n      \"detailedIssueText\": \"The validation did not identify a specific blocking reason for this transaction. Review the Generate Asset Lines process parameters and capitalization setup.\",\n      \"whereToGo\": \"Projects > Costs > Manage Project Costs\",\n      \"guidanceSteps\": [\n        \"Review the parameters used for Generate Asset Lines.\",\n        \"Confirm that the transaction project is included in the selected business unit and project number range.\",\n        \"Confirm that the placed-in-service date and project accounting through date include the relevant assets and costs.\",\n        \"If the project uses capital events, confirm that the correct capital event is selected.\",\n        \"Run Generate Asset Lines again after confirming the process parameters.\"\n      ],\n      \"parameters\": [\n        \"TransactionNumber\"\n      ]\n    }\n  ]\n};\n// Parse wrapper outputs\nif (typeof gr === \"string\") {\n  try { gr = JSON.parse(gr); } catch (e) { gr = {}; }\n}\n\nif (typeof ic === \"string\") {\n  try { ic = JSON.parse(ic); } catch (e) { ic = {}; }\n}\n\nconst nowIso = new Date().toISOString();\n\n// Extract results\nconst resultArr =\n  Array.isArray(gr?.output?.result) ? gr.output.result :\n  Array.isArray(gr?.result) ? gr.result :\n  [];\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return \"\";\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : \"\";\n}\n\nfunction addCurrency(candidates, value) {\n  const code = normalizeCurrencyCode(value);\n  if (code && !candidates.includes(code)) candidates.push(code);\n  return code;\n}\n\n// Catalog\nconst catalogArray = Array.isArray(ic?.mappings) ? ic.mappings : [];\nconst catalogByCode = new Map(catalogArray.map(it => [it.code, it]));\n\n// Details lookup\nconst allDetails = [];\nfor (const r of resultArr) {\n  if (Array.isArray(r?.prjPjcVarConvTransactionDetails)) {\n    allDetails.push(...r.prjPjcVarConvTransactionDetails);\n  }\n}\n\nconst detailsByTxn = new Map(allDetails.map(d => [Number(d.transactionNumber), d]));\n\n// Summaries\nconst summaries = [];\nfor (const r of resultArr) {\n  const s = r?.prjPjcVarConvTransactionSummary;\n  if (s && typeof s === \"object\") summaries.push(s);\n}\n\n// Build buckets by issue only. Currency metadata is preserved for display safety.\nconst bucketToTxns = new Map();\nfor (const s of summaries) {\n  for (const [bucket, txns] of Object.entries(s)) {\n    if (!Array.isArray(txns)) continue;\n    if (!bucketToTxns.has(bucket)) bucketToTxns.set(bucket, []);\n    const arr = bucketToTxns.get(bucket);\n    for (const t of txns) if (!arr.includes(t)) arr.push(t);\n  }\n}\n\nif (bucketToTxns.size === 0) {\n  return { version: \"1.0\", generatedAt: nowIso, totalTransactions: 0, currencyCodes: [], isMultiCurrency: false, totalAmountByCurrency: {}, groups: [] };\n}\n\nfunction computeAmount(bucket, d) {\n  if (bucket === \"Transaction_Doesnot_Exist\") return \"\";\n  if (bucket === \"Project_Not_Enabled_For_Capitalization\") return 0;\n  const costType = String(d?.capitalCostTypeCode || \"\").trim().toUpperCase();\n  if (costType === \"R\") return Number(d?.rawCostInReceiverLedgerCurrency) || 0;\n  if (costType === \"B\") return Number(d?.burdenedCostInReceiverLedgerCurrency) || 0;\n  return 0;\n}\n\n// Totals\nconst prelimGroups = [];\nconst resultCurrencyCodes = [];\n\nfor (const [bucket, txnNumbers] of bucketToTxns.entries()) {\n  const groupCurrencyCodes = [];\n  const totalAmountByCurrency = {};\n  const detailedTransactionDetails = [];\n\n  if (bucket === \"Transaction_Doesnot_Exist\") {\n    for (const tn of txnNumbers) {\n      const d = detailsByTxn.get(Number(tn)) || { transactionNumber: Number(tn) || 0 };\n      detailedTransactionDetails.push({\n        ...d,\n        computedAmount: \"\",\n        computedAmountDisplay: \"\"\n      });\n    }\n\n    prelimGroups.push({\n      bucket,\n      transactionNumbers: txnNumbers.slice(),\n      count: txnNumbers.length,\n      totalAmount: \"\",\n      totalAmountDisplay: \"\",\n      currencyCodes: [],\n      currencyCode: \"\",\n      isMultiCurrency: false,\n      totalAmountByCurrency,\n      detailedTransactionDetails\n    });\n    continue;\n  }\n\n  for (const tn of txnNumbers) {\n    const d = detailsByTxn.get(Number(tn)) || { transactionNumber: Number(tn) || 0 };\n    const currencyCode = addCurrency(groupCurrencyCodes, d.receiverLedgerCurrencyCode || d.currencyCode || d.CurrencyCode);\n    addCurrency(resultCurrencyCodes, currencyCode);\n    const computedAmount = computeAmount(bucket, d);\n\n    if (computedAmount !== \"\") {\n      const key = currencyCode || \"\";\n      totalAmountByCurrency[key] = (totalAmountByCurrency[key] || 0) + (Number(computedAmount) || 0);\n    }\n\n    detailedTransactionDetails.push({\n      ...d,\n      receiverLedgerCurrencyCode: currencyCode || d.receiverLedgerCurrencyCode,\n      currencyCode,\n      computedAmount,\n      computedAmountDisplay: \"\"\n    });\n  }\n\n  const singleCurrencyCode = groupCurrencyCodes.length === 1 ? groupCurrencyCodes[0] : \"\";\n  const totalAmount = singleCurrencyCode ? (totalAmountByCurrency[singleCurrencyCode] || 0) : \"\";\n\n  prelimGroups.push({\n    bucket,\n    transactionNumbers: txnNumbers.slice(),\n    count: txnNumbers.length,\n    totalAmount,\n    totalAmountDisplay: \"\",\n    currencyCodes: groupCurrencyCodes.slice(),\n    currencyCode: singleCurrencyCode,\n    isMultiCurrency: groupCurrencyCodes.length > 1,\n    totalAmountByCurrency,\n    detailedTransactionDetails\n  });\n}\n\nconst groupsEnriched = prelimGroups.map(g => {\n  const catItem = catalogByCode.get(g.bucket);\n  const txnNumbers = g.transactionNumbers || [];\n\n  return {\n    issueCode: g.bucket,\n    shortIssueText: catItem?.shortIssueText ?? g.bucket,\n    completeIssueText: catItem?.detailedIssueText ?? \"No detailed guidance is available for this issue category yet.\",\n    amountTotal: g.totalAmount,\n    amountTotalDisplay: g.totalAmountDisplay,\n    currencyCodes: Array.isArray(g.currencyCodes) ? g.currencyCodes.slice() : [],\n    currencyCode: g.currencyCode || \"\",\n    isMultiCurrency: g.isMultiCurrency === true,\n    totalAmountByCurrency: g.totalAmountByCurrency || {},\n    transactionCount: Number.isFinite(g.count) ? g.count : 0,\n    transactionNumbers: txnNumbers.slice(),\n    detailedGuidance: {\n      steps: Array.isArray(catItem?.guidanceSteps) ? catItem.guidanceSteps.slice() : []\n    },\n    detailedTransactionDetails: Array.isArray(g.detailedTransactionDetails)\n      ? g.detailedTransactionDetails.slice(0, 50)\n      : []\n  };\n});\n\n// Sort\nconst isResultMultiCurrency = resultCurrencyCodes.length > 1;\ngroupsEnriched.sort((a, b) => {\n  if (!isResultMultiCurrency) {\n    const aSortAmount = Number(a.amountTotal) || 0;\n    const bSortAmount = Number(b.amountTotal) || 0;\n    if (bSortAmount !== aSortAmount) return bSortAmount - aSortAmount;\n  }\n  if (b.transactionCount !== a.transactionCount) return b.transactionCount - a.transactionCount;\n  return String(a.issueCode).localeCompare(String(b.issueCode));\n});\n\n// Finalize\nlet totalTransactions = 0;\n\nconst groups = groupsEnriched.map((g, idx) => {\n  totalTransactions += Array.isArray(g.transactionNumbers) ? g.transactionNumbers.length : 0;\n  return { sNo: idx + 1, ...g };\n});\n\nconst totalAmountByCurrency = {};\nfor (const g of groups) {\n  if (!g.totalAmountByCurrency || typeof g.totalAmountByCurrency !== \"object\") continue;\n  for (const [code, amount] of Object.entries(g.totalAmountByCurrency)) {\n    if (!code || !Number.isFinite(Number(amount))) continue;\n    totalAmountByCurrency[code] = (totalAmountByCurrency[code] || 0) + Number(amount);\n  }\n}\n\nconst result = {\n  version: \"1.0\",\n  generatedAt: nowIso,\n  totalTransactions,\n  currencyCodes: resultCurrencyCodes.slice().sort((a, b) => a.localeCompare(b)),\n  isMultiCurrency: isResultMultiCurrency,\n  totalAmount: resultCurrencyCodes.length === 1 ? (totalAmountByCurrency[resultCurrencyCodes[0]] || 0) : \"\",\n  totalAmountDisplay: \"\",\n  totalAmountByCurrency,\n  groups\n};\n\nreturn result;"
          },
