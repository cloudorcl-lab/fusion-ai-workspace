            "sourceCode": "let data = $context.$nodes.FORMAT_CACHED_VALIDATION_RESULTS.$output.result ;\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === \"string\") {\n    try { return JSON.parse(value); } catch (e) { return fallback; }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return \"\";\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : \"\";\n}\n\nconst currencyContext = parseJsonSafe($context.$nodes.BUILD_PRESENTATION_CURRENCY_PRECISION_CONTEXT?.$output?.result, {});\nconst numberPreferences = parseJsonSafe($context.$variables.prjPjcVarUserNumberFormatPreferences, {});\ndata = parseJsonSafe(data, {});\n\nfunction getPrecision(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const map = currencyContext && currencyContext.precisionByCurrency && typeof currencyContext.precisionByCurrency === \"object\" ? currencyContext.precisionByCurrency : {};\n  const precision = Number(map[code]);\n  if (Number.isFinite(precision) && precision >= 0 && precision <= 10) return Math.floor(precision);\n  return 2;\n}\n\nfunction getRoundingIncrement(currencyCode, precision) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const incrementMap =\n    currencyContext &&\n    currencyContext.roundingIncrementByCurrency &&\n    typeof currencyContext.roundingIncrementByCurrency === \"object\"\n      ? currencyContext.roundingIncrementByCurrency\n      : {};\n\n  const increment = Number(incrementMap[code]);\n  if (Number.isFinite(increment) && increment > 0) return increment;\n\n  return 1 / Math.pow(10, precision);\n}\n\nfunction roundHalfUpToIncrement(amount, increment) {\n  if (!Number.isFinite(amount) || !Number.isFinite(increment) || increment <= 0) return amount;\n\n  const sign = amount < 0 ? -1 : 1;\n  const roundedUnits = Math.floor(Math.abs(amount) / increment + 0.5 + 1e-9);\n\n  return sign * roundedUnits * increment;\n}\n\nfunction toAmountNumber(value) {\n  if (typeof value === \"number\") return Number.isFinite(value) ? value : NaN;\n  if (typeof value !== \"string\") return NaN;\n  let text = value.trim();\n  if (!text || text === \"—\" || text === \"-\") return NaN;\n  if (/^[+-]?\\d+(\\.\\d+)?$/.test(text)) return Number(text);\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === \"string\" ? numberPreferences.groupingSeparator : \",\";\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === \"string\" ? numberPreferences.decimalSeparator : \".\";\n  if (groupingSeparator) text = text.split(groupingSeparator).join(\"\");\n  if (decimalSeparator && decimalSeparator !== \".\") text = text.split(decimalSeparator).join(\".\");\n  text = text.replace(/[^0-9.+-]/g, \"\");\n  const amount = Number(text);\n  return Number.isFinite(amount) ? amount : NaN;\n}\n\nfunction groupIntegerPart(integerPart, numberFormat, groupingSeparator, decimalSeparator) {\n  if (!groupingSeparator || integerPart.length <= 3) return integerPart;\n  let format = typeof numberFormat === \"string\" && numberFormat ? numberFormat : \"#,##0.###\";\n  let decimalIndex = decimalSeparator ? format.lastIndexOf(decimalSeparator) : -1;\n  if (decimalIndex < 0 && decimalSeparator !== \".\") decimalIndex = format.lastIndexOf(\".\");\n  const integerPattern = decimalIndex >= 0 ? format.slice(0, decimalIndex) : format;\n  let patternGroupingSeparator = groupingSeparator;\n  if (!integerPattern.includes(patternGroupingSeparator)) {\n    if (integerPattern.includes(\",\")) patternGroupingSeparator = \",\";\n    else if (integerPattern.includes(\".\")) patternGroupingSeparator = \".\";\n  }\n  if (!integerPattern.includes(patternGroupingSeparator)) return integerPart;\n  const groups = integerPattern.split(patternGroupingSeparator).map((part) => part.replace(/[^#0]/g, \"\"));\n  const primarySize = Math.max(1, groups[groups.length - 1]?.length || 3);\n  const secondarySize = groups.length > 2 ? Math.max(1, groups[groups.length - 2]?.length || primarySize) : primarySize;\n  const parts = [];\n  let cursor = integerPart.length;\n  parts.unshift(integerPart.slice(Math.max(0, cursor - primarySize), cursor));\n  cursor -= primarySize;\n  while (cursor > 0) {\n    parts.unshift(integerPart.slice(Math.max(0, cursor - secondarySize), cursor));\n    cursor -= secondarySize;\n  }\n  return parts.filter(Boolean).join(groupingSeparator);\n}\n\nfunction formatAmount(value, currencyCode) {\n  if (value === null || value === undefined || value === \"\") return \"—\";\n  const amount = toAmountNumber(value);\n  if (!Number.isFinite(amount)) return String(value);\n  const numberFormat = typeof numberPreferences.numberFormat === \"string\" && numberPreferences.numberFormat ? numberPreferences.numberFormat : \"#,##0.###\";\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === \"string\" ? numberPreferences.decimalSeparator : \".\";\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === \"string\" ? numberPreferences.groupingSeparator : \",\";\n  const precision = getPrecision(currencyCode);\nconst roundedAmount = roundHalfUpToIncrement(\n  amount,\n  getRoundingIncrement(currencyCode, precision)\n);\nconst sign = roundedAmount < 0 ? \"-\" : \"\";\nconst fixed = Math.abs(roundedAmount).toFixed(precision);\n  const parts = fixed.split(\".\");\n  const integerPart = groupIntegerPart(parts[0], numberFormat, groupingSeparator, decimalSeparator);\n  if (precision === 0) return sign + integerPart;\n  return sign + integerPart + decimalSeparator + (parts[1] || \"\").padEnd(precision, \"0\");\n}\n\nfunction amountHeader(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  return code ? \"Amount (\" + code + \")\" : \"Amount\";\n}\n\nfunction collectCurrencyCodes(groups) {\n  const codes = [];\n  function add(value) {\n    const code = normalizeCurrencyCode(value);\n    if (code && !codes.includes(code)) codes.push(code);\n  }\n  if (Array.isArray(data.currencyCodes)) for (const code of data.currencyCodes) add(code);\n  for (const group of groups) {\n    add(group.currencyCode);\n    if (Array.isArray(group.currencyCodes)) for (const code of group.currencyCodes) add(code);\n    if (Array.isArray(group.detailedTransactionDetails)) {\n      for (const row of group.detailedTransactionDetails) add(row.receiverLedgerCurrencyCode || row.currencyCode);\n    }\n  }\n  return codes.sort((a, b) => a.localeCompare(b));\n}\n\nfunction normalizeGroup(rawGroup, index) {\n  if (!rawGroup || typeof rawGroup !== \"object\" || Array.isArray(rawGroup)) return null;\n  let sNo = index + 1;\n  if (rawGroup.sNo !== null && rawGroup.sNo !== undefined && rawGroup.sNo !== \"\" && Number.isFinite(Number(rawGroup.sNo))) sNo = Number(rawGroup.sNo);\n  const groupCurrencyCodes = [];\n  function addGroupCode(value) {\n    const code = normalizeCurrencyCode(value);\n    if (code && !groupCurrencyCodes.includes(code)) groupCurrencyCodes.push(code);\n  }\n  addGroupCode(rawGroup.currencyCode);\n  if (Array.isArray(rawGroup.currencyCodes)) for (const code of rawGroup.currencyCodes) addGroupCode(code);\n  let detailedTransactionDetails = [];\n  if (Array.isArray(rawGroup.detailedTransactionDetails)) {\n    for (const row of rawGroup.detailedTransactionDetails) {\n      if (row && typeof row === \"object\" && !Array.isArray(row)) {\n        addGroupCode(row.receiverLedgerCurrencyCode || row.currencyCode);\n        detailedTransactionDetails.push(row);\n      }\n    }\n  }\n  const currencyCode = groupCurrencyCodes.length === 1 ? groupCurrencyCodes[0] : \"\";\n  let transactionNumbers = [];\n  if (Array.isArray(rawGroup.transactionNumbers)) {\n    for (const v of rawGroup.transactionNumbers) {\n      if (v !== null && v !== undefined && v !== \"\" && Number.isFinite(Number(v))) transactionNumbers.push(String(Number(v)));\n    }\n  }\n  let guidanceSteps = [];\n  if (rawGroup.detailedGuidance && typeof rawGroup.detailedGuidance === \"object\" && Array.isArray(rawGroup.detailedGuidance.steps)) {\n    for (const step of rawGroup.detailedGuidance.steps) if (typeof step === \"string\" && step.trim() !== \"\") guidanceSteps.push(step.trim());\n  }\n  let transactionCount = 0;\n  if (rawGroup.transactionCount !== null && rawGroup.transactionCount !== undefined && rawGroup.transactionCount !== \"\" && Number.isFinite(Number(rawGroup.transactionCount))) transactionCount = Number(rawGroup.transactionCount);\n  else transactionCount = transactionNumbers.length || detailedTransactionDetails.length;\n  const hasAmountTotal = rawGroup.amountTotal !== null && rawGroup.amountTotal !== undefined && rawGroup.amountTotal !== \"\" && Number.isFinite(Number(rawGroup.amountTotal));\n  const amountTotal = hasAmountTotal ? Number(rawGroup.amountTotal) : \"\";\n  return {\n    sNo,\n    issueCode: typeof rawGroup.issueCode === \"string\" ? rawGroup.issueCode : \"\",\n    currencyCodes: groupCurrencyCodes,\n    currencyCode,\n    shortIssueText: typeof rawGroup.shortIssueText === \"string\" && rawGroup.shortIssueText.trim() !== \"\" ? rawGroup.shortIssueText.trim() : \"Issue\",\n    issueText: typeof rawGroup.completeIssueText === \"string\" && rawGroup.completeIssueText.trim() !== \"\" ? rawGroup.completeIssueText.trim() : (typeof rawGroup.shortIssueText === \"string\" ? rawGroup.shortIssueText : \"Issue\"),\n    transactionCount,\n    amountTotal,\n    amountTotalDisplay: hasAmountTotal && currencyCode ? formatAmount(amountTotal, currencyCode) : \"\",\n    transactionNumbers,\n    detailedTransactionDetails,\n    guidanceSteps\n  };\n}\n\nlet rawGroups = Array.isArray(data && data.groups) ? data.groups : [];\nlet groups = [];\nfor (let i = 0; i < rawGroups.length; i++) {\n  const group = normalizeGroup(rawGroups[i], i);\n  if (group) groups.push(group);\n}\n\nlet sNoOk = true;\nlet seenSNo = {};\nfor (const group of groups) {\n  if (!Number.isFinite(group.sNo) || seenSNo[String(group.sNo)]) { sNoOk = false; break; }\n  seenSNo[String(group.sNo)] = true;\n}\nif (sNoOk) groups.sort((a, b) => a.sNo - b.sNo);\n\nlet totalTransactions = null;\nif (data && data.totalTransactions !== null && data.totalTransactions !== undefined && data.totalTransactions !== \"\" && Number.isFinite(Number(data.totalTransactions))) {\n  totalTransactions = Number(data.totalTransactions);\n} else {\n  const txnSeen = {};\n  let count = 0;\n  for (const group of groups) {\n    for (const txn of group.transactionNumbers) if (!txnSeen[txn]) { txnSeen[txn] = true; count++; }\n    for (const row of group.detailedTransactionDetails) {\n      if (row.transactionNumber !== null && row.transactionNumber !== undefined && row.transactionNumber !== \"\" && Number.isFinite(Number(row.transactionNumber))) {\n        const key = String(Number(row.transactionNumber));\n        if (!txnSeen[key]) { txnSeen[key] = true; count++; }\n      }\n    }\n  }\n  totalTransactions = count;\n}\n\nconst groupCount = groups.length;\nif (groupCount === 0) return 'No issues were found in the latest validation run. If you expected issues, check the inputs and rerun validation.';\n\nconst currencyCodes = collectCurrencyCodes(groups);\nconst isMultiCurrency = currencyCodes.length > 1;\nconst singleCurrencyCode = currencyCodes.length === 1 ? currencyCodes[0] : \"\";\nconst transactionWord = totalTransactions === 1 ? \"transaction\" : \"transactions\";\n\nfunction amountDisclosureHtml() {\n  return '<div>Amounts are shown in <b>Receiver Ledger Currency</b>.</div>';\n}\n\nlet html = '';\nif (groupCount === 1) html += '<div>I analyzed <b>' + escapeHtml(totalTransactions) + '</b> ' + escapeHtml(transactionWord) + ' and found <b>1</b> issue group to review below.</div>';\nelse html += '<div>I analyzed <b>' + escapeHtml(totalTransactions) + '</b> ' + escapeHtml(transactionWord) + ' and grouped the findings below into <b>' + escapeHtml(groupCount) + '</b> issue groups.</div>';\n\nif (!isMultiCurrency) {\n  html += '<div style=\"height:6px;\"></div>';\n  html += amountDisclosureHtml();\n}\nhtml += '<div style=\"height:8px;\"></div>';\nhtml += '<div><b>Findings</b></div>';\nhtml += '<div style=\"display:inline-block; max-width:600px; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">';\nhtml += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\nhtml += '<tr>';\nhtml += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Issue Group</th>';\nhtml += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Issue</th>';\nhtml += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Transactions</th>';\nif (!isMultiCurrency) html += '<th style=\"white-space:nowrap; width:1%; text-align:right;\">' + escapeHtml(amountHeader(singleCurrencyCode)) + '</th>';\nhtml += '</tr>';\nfor (const group of groups) {\n  html += '<tr>';\n  html += '<td style=\"white-space:nowrap;\">' + escapeHtml(group.sNo) + '</td>';\n  html += '<td style=\"white-space:nowrap;\">' + escapeHtml(group.shortIssueText) + '</td>';\n  html += '<td style=\"white-space:nowrap;\">' + escapeHtml(group.transactionCount) + '</td>';\n  if (!isMultiCurrency) html += '<td style=\"white-space:nowrap; text-align:right;\">' + escapeHtml(group.amountTotalDisplay || '-') + '</td>';\n  html += '</tr>';\n}\nhtml += '</table>';\nhtml += '</div>';\n\nif (isMultiCurrency) {\n  html += '<div style=\"height:6px;\"></div>';\n  html += '<div>Amount totals are not shown at the issue-group level because the selected transactions use more than one receiver ledger currency.</div>';\n}\n\nif (groupCount === 1) {\n  const group = groups[0];\n  const detailCurrencyCodes = collectCurrencyCodes([group]);\n  const isDetailMultiCurrency = detailCurrencyCodes.length > 1;\n  const detailSingleCurrencyCode = detailCurrencyCodes.length === 1 ? detailCurrencyCodes[0] : \"\";\n  html += '<div style=\"height:8px;\"></div>';\n  html += '<div><b>What Needs Attention</b></div>';\n  html += '<div>' + escapeHtml(group.issueText) + '</div>';\n\n  if (group.guidanceSteps.length > 0) {\n    html += '<div style=\"height:8px;\"></div>';\n    html += '<div><b>Recommended Action</b></div>';\n    html += '<ul>';\n    for (const step of group.guidanceSteps) html += '<li>' + escapeHtml(step) + '</li>';\n    html += '</ul>';\n  }\n\n  const hasDetailedRows = group.detailedTransactionDetails.length > 0;\n  const hasTxnNumbers = group.transactionNumbers.length > 0;\n  if (hasDetailedRows || hasTxnNumbers) {\n    html += '<div style=\"height:8px;\"></div>';\n    html += '<div><b>Transactions Affected</b></div>';\n    if (hasDetailedRows) {\n      html += '<div style=\"height:6px;\"></div>';\n      html += '<div>Amounts are shown in <b>Receiver Ledger Currency</b>.</div>';\n      html += '<div style=\"display:inline-block; max-width:600px; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">';\n      html += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\n      html += '<tr>';\n      html += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Transaction</th>';\n      html += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Project Number</th>';\n      html += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Task Number</th>';\n      html += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Transaction Source</th>';\n      html += '<th style=\"white-space:nowrap; width:1%; text-align:right;\">' + escapeHtml(amountHeader(detailSingleCurrencyCode)) + '</th>';\n      html += '</tr>';\n      for (const row of group.detailedTransactionDetails) {\n        const rowCurrencyCode = normalizeCurrencyCode(row.receiverLedgerCurrencyCode || row.currencyCode) || detailSingleCurrencyCode;\n        const txnNo = row.transactionNumber !== null && row.transactionNumber !== undefined && row.transactionNumber !== \"\" ? String(row.transactionNumber) : \"—\";\n        const projectNumber = row.projectNumber !== null && row.projectNumber !== undefined && row.projectNumber !== \"\" ? String(row.projectNumber) : \"—\";\n        const taskNumber = row.taskNumber !== null && row.taskNumber !== undefined && row.taskNumber !== \"\" ? String(row.taskNumber) : \"—\";\n        const transactionSource = typeof row.transactionSource === \"string\" && row.transactionSource.trim() !== \"\" ? row.transactionSource : \"—\";\n        let txnAmountDisplay = \"-\";\n        if (row.computedAmount !== null && row.computedAmount !== undefined && row.computedAmount !== \"\" && Number.isFinite(Number(row.computedAmount))) txnAmountDisplay = formatAmount(row.computedAmount, rowCurrencyCode);\n        else if (typeof row.computedAmountDisplay === \"string\" && row.computedAmountDisplay !== \"\") txnAmountDisplay = formatAmount(row.computedAmountDisplay, rowCurrencyCode);\n        html += '<tr>';\n        html += '<td style=\"white-space:nowrap;\">' + escapeHtml(txnNo) + '</td>';\n        html += '<td style=\"white-space:nowrap;\">' + escapeHtml(projectNumber) + '</td>';\n        html += '<td style=\"white-space:nowrap;\">' + escapeHtml(taskNumber) + '</td>';\n        html += '<td style=\"white-space:nowrap;\">' + escapeHtml(transactionSource) + '</td>';\n        if (isDetailMultiCurrency && rowCurrencyCode && txnAmountDisplay !== '-' && txnAmountDisplay !== '—') txnAmountDisplay = txnAmountDisplay + ' ' + rowCurrencyCode;\n        html += '<td style=\"white-space:nowrap; text-align:right;\">' + escapeHtml(txnAmountDisplay) + '</td>';\n        html += '</tr>';\n      }\n      html += '</table>';\n      html += '</div>';\n    } else {\n      html += '<div style=\"display:inline-block; max-width:600px; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">';\n      html += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\n      html += '<tr><th style=\"white-space:nowrap; width:1%; text-align:left;\">Transaction</th></tr>';\n      for (const txn of group.transactionNumbers) html += '<tr><td style=\"white-space:nowrap;\">' + escapeHtml(txn) + '</td></tr>';\n      html += '</table>';\n      html += '</div>';\n    }\n  }\n\n  if (hasDetailedRows || hasTxnNumbers) html += '<div style=\"height:8px;\"></div><div>To review transaction details, open the transaction in Manage Project Costs.</div>';\n  else if (group.guidanceSteps.length > 0) html += '<div style=\"height:8px;\"></div><div>After completing the recommended action above, rerun validation.</div>';\n} else {\n  html += '<div style=\"height:8px;\"></div>';\n  html += '<div><b>What you can do next</b></div>';\n  html += '<div>Reply <b>issue &lt;Issue Group&gt;</b> to view the details and recommended action for a specific issue.</div>';\n}\n\nreturn html;"
          },
          "outcomes": {
            "success": "1775554940996"
          },
          "code": "BUILD_VALIDATION_SUMMARY_PAYLOAD",
          "id": "1775555597805",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Asset Details Presentation Payload",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.GET_ASSET_DETAILS.$output ;\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\ndata = parseJsonSafe(data, []);\n\nlet asset = {};\nif (Array.isArray(data) && data.length > 0 && data[0] && typeof data[0] === \"object\") {\n  asset = data[0];\n} else if (data && Array.isArray(data.items) && data.items.length > 0 && data.items[0] && typeof data.items[0] === \"object\") {\n  asset = data.items[0];\n}\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return \"\";\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : \"\";\n}\n\nconst currencyContext = parseJsonSafe($context.$nodes.BUILD_PRESENTATION_CURRENCY_PRECISION_CONTEXT?.$output?.result, {});\nconst numberPreferences = parseJsonSafe($context.$variables.prjPjcVarUserNumberFormatPreferences, {});\nconst assetCurrencyCode = normalizeCurrencyCode(currencyContext.singleCurrencyCode || currencyContext.currencyCode || $context.$variables.prjPjcVarConvCurrentProjectDetails?.currencyCode);\n\nfunction getPrecision(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const map = currencyContext && currencyContext.precisionByCurrency && typeof currencyContext.precisionByCurrency === \"object\" ? currencyContext.precisionByCurrency : {};\n  const precision = Number(map[code]);\n  if (Number.isFinite(precision) && precision >= 0 && precision <= 10) return Math.floor(precision);\n  return 2;\n}\n\nfunction getRoundingIncrement(currencyCode, precision) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const incrementMap =\n    currencyContext &&\n    currencyContext.roundingIncrementByCurrency &&\n    typeof currencyContext.roundingIncrementByCurrency === \"object\"\n      ? currencyContext.roundingIncrementByCurrency\n      : {};\n\n  const increment = Number(incrementMap[code]);\n  if (Number.isFinite(increment) && increment > 0) return increment;\n\n  return 1 / Math.pow(10, precision);\n}\n\nfunction roundHalfUpToIncrement(amount, increment) {\n  if (!Number.isFinite(amount) || !Number.isFinite(increment) || increment <= 0) return amount;\n\n  const sign = amount < 0 ? -1 : 1;\n  const roundedUnits = Math.floor(Math.abs(amount) / increment + 0.5 + 1e-9);\n\n  return sign * roundedUnits * increment;\n}\n\n\n\nfunction toAmountNumber(value) {\n  if (typeof value === \"number\") return Number.isFinite(value) ? value : NaN;\n  if (typeof value !== \"string\") return NaN;\n  let text = value.trim();\n  if (!text || text === \"—\" || text === \"-\") return NaN;\n  if (/^[+-]?\\d+(\\.\\d+)?$/.test(text)) return Number(text);\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === \"string\" ? numberPreferences.groupingSeparator : \",\";\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === \"string\" ? numberPreferences.decimalSeparator : \".\";\n  if (groupingSeparator) text = text.split(groupingSeparator).join(\"\");\n  if (decimalSeparator && decimalSeparator !== \".\") text = text.split(decimalSeparator).join(\".\");\n  text = text.replace(/[^0-9.+-]/g, \"\");\n  const amount = Number(text);\n  return Number.isFinite(amount) ? amount : NaN;\n}\n\nfunction groupIntegerPart(integerPart, numberFormat, groupingSeparator, decimalSeparator) {\n  if (!groupingSeparator || integerPart.length <= 3) return integerPart;\n  let format = typeof numberFormat === \"string\" && numberFormat ? numberFormat : \"#,##0.###\";\n  let decimalIndex = decimalSeparator ? format.lastIndexOf(decimalSeparator) : -1;\n  if (decimalIndex < 0 && decimalSeparator !== \".\") decimalIndex = format.lastIndexOf(\".\");\n  const integerPattern = decimalIndex >= 0 ? format.slice(0, decimalIndex) : format;\n  let patternGroupingSeparator = groupingSeparator;\n  if (!integerPattern.includes(patternGroupingSeparator)) {\n    if (integerPattern.includes(\",\")) patternGroupingSeparator = \",\";\n    else if (integerPattern.includes(\".\")) patternGroupingSeparator = \".\";\n  }\n  if (!integerPattern.includes(patternGroupingSeparator)) return integerPart;\n  const groups = integerPattern.split(patternGroupingSeparator).map((part) => part.replace(/[^#0]/g, \"\"));\n  const primarySize = Math.max(1, groups[groups.length - 1]?.length || 3);\n  const secondarySize = groups.length > 2 ? Math.max(1, groups[groups.length - 2]?.length || primarySize) : primarySize;\n  const parts = [];\n  let cursor = integerPart.length;\n  parts.unshift(integerPart.slice(Math.max(0, cursor - primarySize), cursor));\n  cursor -= primarySize;\n  while (cursor > 0) {\n    parts.unshift(integerPart.slice(Math.max(0, cursor - secondarySize), cursor));\n    cursor -= secondarySize;\n  }\n  return parts.filter(Boolean).join(groupingSeparator);\n}\n\nfunction formatAmount(value, currencyCode) {\n  if (value === null || value === undefined || value === \"\") return \"—\";\n  const amount = toAmountNumber(value);\n  if (!Number.isFinite(amount)) return String(value);\n  const numberFormat = typeof numberPreferences.numberFormat === \"string\" && numberPreferences.numberFormat ? numberPreferences.numberFormat : \"#,##0.###\";\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === \"string\" ? numberPreferences.decimalSeparator : \".\";\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === \"string\" ? numberPreferences.groupingSeparator : \",\";\n  const precision = getPrecision(currencyCode);\nconst roundedAmount = roundHalfUpToIncrement(\n  amount,\n  getRoundingIncrement(currencyCode, precision)\n);\nconst sign = roundedAmount < 0 ? \"-\" : \"\";\nconst fixed = Math.abs(roundedAmount).toFixed(precision);\n  const parts = fixed.split(\".\");\n  const integerPart = groupIntegerPart(parts[0], numberFormat, groupingSeparator, decimalSeparator);\n  if (precision === 0) return sign + integerPart;\n  return sign + integerPart + decimalSeparator + (parts[1] || \"\").padEnd(precision, \"0\");\n}\n\nfunction formatValue(key, value) {\n  if (value === null || value === undefined || value === \"\") return \"—\";\n  if (key === \"CAPITALIZEDCOST\") return formatAmount(value, assetCurrencyCode);\n  if (key === \"CAPITALHOLDFLAG\" || key === \"COSTADJUSTMENTFLAG\") {\n    if (String(value).toUpperCase() === \"Y\") return \"Yes\";\n    if (String(value).toUpperCase() === \"N\") return \"No\";\n  }\n  return String(value);\n}\n\nconst fieldLabels = {\n  ASSETNAME: \"Asset Name\",\n  DESCRIPTION: \"Description\",\n  ASSETNUMBER: \"Asset Number\",\n  PROJECTNAME: \"Project Name\",\n  PROJECTNUMBER: \"Project Number\",\n  ASSETTYPECODE: \"Asset Type\",\n  ACTUALUNITS: \"Actual Units\",\n  CAPITALHOLDFLAG: \"Capital Hold\",\n  CAPITALIZEDCOST: assetCurrencyCode ? \"Capitalized Cost (\" + assetCurrencyCode + \")\" : \"Capitalized Cost\",\n  CAPITALIZEDDATE: \"Capitalized Date\",\n  COSTADJUSTMENTFLAG: \"Cost Adjustment\",\n  CREATEDBY: \"Created By\",\n  TIMECREATED: \"Time Created\",\n  ACTUALINSERVICEORRETIREMENTDATE: \"In Service / Retirement Date\",\n  MANUFACTURERNAME: \"Manufacturer Name\",\n  MODELNUMBER: \"Model Number\"\n};\n\nconst orderedKeys = [\n  \"ASSETNAME\",\n  \"DESCRIPTION\",\n  \"ASSETNUMBER\",\n  \"PROJECTNAME\",\n  \"PROJECTNUMBER\",\n  \"ASSETTYPECODE\",\n  \"ACTUALUNITS\",\n  \"CAPITALHOLDFLAG\",\n  \"CAPITALIZEDCOST\",\n  \"CAPITALIZEDDATE\",\n  \"COSTADJUSTMENTFLAG\",\n  \"CREATEDBY\",\n  \"TIMECREATED\",\n  \"ACTUALINSERVICEORRETIREMENTDATE\",\n  \"MANUFACTURERNAME\",\n  \"MODELNUMBER\"\n];\n\nlet assetName = asset.ASSETNAME || \"—\";\nlet projectName = asset.PROJECTNAME || \"—\";\n\nlet html = \"\";\nhtml += '<div>Here are the details for asset <b>' + escapeHtml(assetName) + '</b> in project <b>' + escapeHtml(projectName) + '</b></div>';\nhtml += '<div style=\"height:8px;\"></div>';\n\nhtml += '<div style=\"display:inline-block; max-width:600px; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">';\nhtml += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\nhtml += '<tr>';\nhtml += '<th style=\"white-space:nowrap; width:1%; text-align:left;\">Field</th>';\nhtml += '<th style=\"white-space:nowrap; width:1%; text-align:right;\">Value</th>';\nhtml += '</tr>';\n\nfor (const key of orderedKeys) {\n  const label = fieldLabels[key];\n  const value = formatValue(key, asset[key]);\n  html += '<tr>';\n  html += '<td style=\"white-space:nowrap;\">' + escapeHtml(label) + '</td>';\n  const valueStyle = key === \"CAPITALIZEDCOST\" ? 'white-space:nowrap; text-align:right;' : 'white-space:nowrap;';\n  html += '<td style=\"' + valueStyle + '\">' + escapeHtml(value) + '</td>';\n  html += '</tr>';\n}\n\nhtml += '</table>';\nhtml += '</div>';\n\nreturn html;"
          },
