        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Multiple Project Matches Message",
            "returnType": "string",
            "sourceCode": "const input = $context.$nodes.SEARCH_PROJECT_MATCHES.$output;\nconst projectInputRaw = $context.$nodes.ROUTE_USER_INTENT.$output.request.scope.projectInput ;\nconst maxDisplayCount = 50;\n\nlet arr;\nif (Array.isArray(input)) {\n  arr = input;\n} else if (typeof input === \"string\") {\n  if (input.trim() === \"\") {\n    arr = [];\n  } else {\n    try {\n      const parsed = JSON.parse(input);\n      arr = Array.isArray(parsed) ? parsed : [];\n    } catch {\n      arr = [];\n    }\n  }\n} else {\n  arr = [];\n}\n\nif (arr.length <= 1) {\n  return \"\";\n}\n\nlet projectInput = \"your input\";\nif (typeof projectInputRaw === \"string\" && projectInputRaw.trim().length > 0) {\n  projectInput = projectInputRaw\n    .trim()\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nconst totalCount = arr.length;\nconst displayCount = totalCount > maxDisplayCount ? maxDisplayCount : totalCount;\nconst displayedProjects = arr.slice(0, maxDisplayCount);\n\nconst rows = displayedProjects\n  .map((project, index) => {\n    const projectNumber =\n      typeof project.projectNumber === \"string\" && project.projectNumber.length > 0\n        ? project.projectNumber\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\")\n        : \"—\";\n\n    const projectName =\n      typeof project.projectName === \"string\" && project.projectName.length > 0\n        ? project.projectName\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\")\n        : \"—\";\n\n    const businessUnit =\n      typeof project.businessUnitName === \"string\" && project.businessUnitName.length > 0\n        ? project.businessUnitName\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\")\n        : \"—\";\n\n    return `<tr>\n<td style=\"white-space:nowrap;\">${index + 1}</td>\n<td style=\"white-space:nowrap;\">${projectNumber}</td>\n<td style=\"white-space:nowrap;\">${projectName}</td>\n<td style=\"white-space:nowrap;\">${businessUnit}</td>\n</tr>`;\n  })\n  .join(\"\");\n\nlet headerMessage = \"\";\nif (totalCount <= maxDisplayCount) {\n  headerMessage = `<div style=\"margin-bottom:8px;\">I found <b>${totalCount}</b> matching projects for <b>\"${projectInput}\"</b>.</div>`;\n} else {\n  headerMessage = `<div style=\"margin-bottom:8px;\">I found multiple matching projects for <b>\"${projectInput}\"</b>.</div>\n<div style=\"margin-bottom:8px;\">Showing the first <b>${displayCount}</b> matches in <b>Project Number order</b>. More matching projects are available.</div>`;\n}\n\nconst html=`${headerMessage}\n<div style=\"display:inline-block; max-width:600px; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">\n<thead>\n<tr>\n<th style=\"white-space:nowrap; width:1%;\">S.No.</th>\n<th style=\"white-space:nowrap; width:1%;\">Project Number</th>\n<th style=\"white-space:nowrap; width:1%;\">Project Name</th>\n<th style=\"white-space:nowrap; width:1%;\">Business Unit</th>\n</tr>\n</thead>\n<tbody>\n${rows}\n</tbody>\n</table>\n</div>\n<div style=\"margin-top:12px;\">\n  <div style=\"font-weight:bold; margin-bottom:6px;\">What You Can Do Next</div>\n  <div>1. Enter the <b>row number, project name, or project number</b> to select the project.</div>\n  <div>2. If you do not see your project, reply with a more specific <b>Project Name or Number</b>.</div>\n</div>`;\n\nreturn html;"
          },
          "outcomes": {
            "success": "1773665707231"
          },
          "code": "BUILD_MULTIPLE_PROJECT_MATCHES_MESSAGE",
