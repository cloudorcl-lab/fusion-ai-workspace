            "errorNodeId": "1775736275713",
            "name": "Extract Transaction Numbers",
            "returnType": "array",
            "sourceCode": "const src = $context.$nodes.GET_TRANSACTION_DETAILS.$output ?? [];\nlet arr = Array.isArray(src) ? src : [];\nif (!Array.isArray(src) && typeof src === 'string') {\ntry { arr = JSON.parse(src); } catch (e) { arr = []; }\n}\nif (!Array.isArray(arr)) arr = [];\n\n// Extract transaction numbers without using functions\nconst transactionNumbers = [];\nfor (let i = 0; i < arr.length; i++) {\nconst item = arr[i];\nif (!item || typeof item !== 'object') continue;\ntransactionNumbers.push(item.transactionNumber);\n}\n\nreturn transactionNumbers;"
          },
