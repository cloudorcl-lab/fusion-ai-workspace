          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Is Transaction Summary Update Required",
            "returnType": "boolean",
            "sourceCode": "const currentSummaryInput = $context.$nodes.GET_PENDING_COST_SUMMARY.$output ;\n\nconst previousSummaryInput = $context.$variables.prjPjcVarConvLatestTransactionSummary ;\n\nlet currentSummary = [];\nlet previousSummary = [];\n\nif (Array.isArray(currentSummaryInput)) {\n  currentSummary = currentSummaryInput;\n} else if (typeof currentSummaryInput === \"string\" && currentSummaryInput.trim() !== \"\") {\n  try {\n    const parsedCurrent = JSON.parse(currentSummaryInput);\n    currentSummary = Array.isArray(parsedCurrent) ? parsedCurrent : [];\n  } catch {\n    currentSummary = [];\n  }\n}\n\nif (Array.isArray(previousSummaryInput)) {\n  previousSummary = previousSummaryInput;\n} else if (typeof previousSummaryInput === \"string\" && previousSummaryInput.trim() !== \"\") {\n  try {\n    const parsedPrevious = JSON.parse(previousSummaryInput);\n    previousSummary = Array.isArray(parsedPrevious) ? parsedPrevious : [];\n  } catch {\n    previousSummary = [];\n  }\n}\n\nlet result = false;\n\nif (currentSummary.length > 1) {\n  result = true;\n} else if (currentSummary.length <= 1 && previousSummary.length === 0) {\n  result = true;\n} else if (currentSummary.length <= 1 && previousSummary.length > 0) {\n  result = false;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775671861989"
          },
