          "code": "CHECK_TRANSACTION_COUNT_THRESHOLD",
          "convergenceTargetId": "1772729239384",
          "id": "1775535369702",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Format Last Cache Result Block",
            "returnType": "string",
            "sourceCode": "const resolvedUserQuery = String($context.$nodes.ROUTE_USER_INTENT?.$output?.resolvedUserQuery || '').trim();\nconst request = $context.$nodes.ROUTE_USER_INTENT?.$output?.request || {};\nconst currentProject = $context.$variables.prjPjcVarConvCurrentProjectDetails || {};\nconst lastDataBlockRaw = $context.$variables.prjPjcVarConvLastDataBlock;\nconst latestTransactionSummaryRaw = $context.$variables.prjPjcVarConvLatestTransactionSummary;\nconst summaryCountRaw = $context.$variables.prjPjcVarConvLastTransactionSummaryCount;\nconst numberPreferencesRaw = $context.$variables.prjPjcVarUserNumberFormatPreferences;\nconst currencyContextRaw = $context.$nodes.BUILD_PRESENTATION_CURRENCY_PRECISION_CONTEXT?.$output?.result;\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try { return JSON.parse(value); } catch (e) { return fallback; }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return '';\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : '';\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === 'string' && value.trim() !== '';\n}\n\nconst numberPreferences = parseJsonSafe(numberPreferencesRaw, {});\nconst currencyContext = parseJsonSafe(currencyContextRaw, {});\nconst lastDataBlock = parseJsonSafe(lastDataBlockRaw, {});\nconst latestTransactionSummary = parseJsonSafe(latestTransactionSummaryRaw, []);\n\nfunction getPrecision(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const map = currencyContext && typeof currencyContext.precisionByCurrency === 'object' ? currencyContext.precisionByCurrency : {};\n  const precision = Number(map[code]);\n  return Number.isFinite(precision) && precision >= 0 && precision <= 10 ? Math.floor(precision) : 2;\n}\n\nfunction getRoundingIncrement(currencyCode, precision) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const incrementMap = currencyContext && typeof currencyContext.roundingIncrementByCurrency === 'object' ? currencyContext.roundingIncrementByCurrency : {};\n  const increment = Number(incrementMap[code]);\n  if (Number.isFinite(increment) && increment > 0) return increment;\n  return 1 / Math.pow(10, precision);\n}\n\nfunction roundHalfUpToIncrement(amount, increment) {\n  if (!Number.isFinite(amount) || !Number.isFinite(increment) || increment <= 0) return amount;\n  const sign = amount < 0 ? -1 : 1;\n  const roundedUnits = Math.floor(Math.abs(amount) / increment + 0.5 + 1e-9);\n  return sign * roundedUnits * increment;\n}\n\n\n\nfunction toAmountNumber(value) {\n  if (typeof value === 'number') return Number.isFinite(value) ? value : NaN;\n  if (typeof value !== 'string') return NaN;\n  let text = value.trim();\n  if (!text || text === '—' || text === '-') return NaN;\n  if (/^[+-]?\\\\d+(\\\\.\\\\d+)?$/.test(text)) return Number(text);\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === 'string' ? numberPreferences.groupingSeparator : ',';\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === 'string' ? numberPreferences.decimalSeparator : '.';\n  if (groupingSeparator) text = text.split(groupingSeparator).join('');\n  if (decimalSeparator && decimalSeparator !== '.') text = text.split(decimalSeparator).join('.');\n  text = text.replace(/[^0-9.+-]/g, '');\n  const amount = Number(text);\n  return Number.isFinite(amount) ? amount : NaN;\n}\n\nfunction groupIntegerPart(integerPart, numberFormat, groupingSeparator, decimalSeparator) {\n  if (!groupingSeparator || integerPart.length <= 3) return integerPart;\n  let format = typeof numberFormat === 'string' && numberFormat ? numberFormat : '#,##0.###';\n  let decimalIndex = decimalSeparator ? format.lastIndexOf(decimalSeparator) : -1;\n  if (decimalIndex < 0 && decimalSeparator !== '.') decimalIndex = format.lastIndexOf('.');\n  const integerPattern = decimalIndex >= 0 ? format.slice(0, decimalIndex) : format;\n  let patternGroupingSeparator = groupingSeparator;\n  if (!integerPattern.includes(patternGroupingSeparator)) {\n    if (integerPattern.includes(',')) patternGroupingSeparator = ',';\n    else if (integerPattern.includes('.')) patternGroupingSeparator = '.';\n  }\n  if (!integerPattern.includes(patternGroupingSeparator)) return integerPart;\n  const groups = integerPattern.split(patternGroupingSeparator).map((part) => part.replace(/[^#0]/g, ''));\n  const primarySize = Math.max(1, groups[groups.length - 1] ? groups[groups.length - 1].length : 3);\n  const secondarySize = groups.length > 2 ? Math.max(1, groups[groups.length - 2] ? groups[groups.length - 2].length : primarySize) : primarySize;\n  const parts = [];\n  let cursor = integerPart.length;\n  parts.unshift(integerPart.slice(Math.max(0, cursor - primarySize), cursor));\n  cursor -= primarySize;\n  while (cursor > 0) {\n    parts.unshift(integerPart.slice(Math.max(0, cursor - secondarySize), cursor));\n    cursor -= secondarySize;\n  }\n  return parts.filter(Boolean).join(groupingSeparator);\n}\n\nfunction formatAmount(value, currencyCode) {\n  if (value === null || value === undefined || value === '') return '—';\n  const amount = toAmountNumber(value);\n  if (!Number.isFinite(amount)) return String(value);\n  const numberFormat = typeof numberPreferences.numberFormat === 'string' && numberPreferences.numberFormat ? numberPreferences.numberFormat : '#,##0.###';\n  const decimalSeparator = typeof numberPreferences.decimalSeparator === 'string' ? numberPreferences.decimalSeparator : '.';\n  const groupingSeparator = typeof numberPreferences.groupingSeparator === 'string' ? numberPreferences.groupingSeparator : ',';\n  const precision = getPrecision(currencyCode);\n  const roundedAmount = roundHalfUpToIncrement(amount, getRoundingIncrement(currencyCode, precision));\n  const sign = roundedAmount < 0 ? '-' : '';\n  const fixed = Math.abs(roundedAmount).toFixed(precision);\n  const parts = fixed.split('.');\n  const integerPart = groupIntegerPart(parts[0], numberFormat, groupingSeparator, decimalSeparator);\n  if (precision === 0) return sign + integerPart;\n  return sign + integerPart + decimalSeparator + (parts[1] || '').padEnd(precision, '0');\n}\n\nfunction amountHeader(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  return code ? 'Amount (' + code + ')' : 'Amount';\n}\n\nfunction disclosureLine() {\n  return '<div>Amounts are shown in <b>Receiver Ledger Currency</b>.</div>';\n}\n\nfunction projectLabel() {\n  const projectName = isNonEmptyString(currentProject.projectName) ? currentProject.projectName.trim() : '';\n  const projectNumber = isNonEmptyString(currentProject.projectNumber) ? currentProject.projectNumber.trim() : '';\n  if (projectName && projectNumber && projectName.toLowerCase() !== projectNumber.toLowerCase()) return projectName + ' (' + projectNumber + ')';\n  if (projectName) return projectName;\n  if (projectNumber) return projectNumber;\n  return 'this project';\n}\n\nfunction businessUnitLine() {\n  return isNonEmptyString(currentProject.businessUnitName) ? '<div>Business Unit: <b>' + escapeHtml(currentProject.businessUnitName.trim()) + '</b></div>' : '';\n}\n\nfunction makeTable(columns, rows, includeScroll) {\n  let html = includeScroll ? '<div style=\"width:600px; max-width:100%; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">' : '';\n  html += '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\n  html += '<tr>';\n  for (const column of columns) {\n    const amount = column.isAmount === true;\n    html += '<th style=\"white-space:nowrap; width:1%; text-align:' + (amount ? 'right' : 'left') + ';\">' + escapeHtml(column.label) + '</th>';\n  }\n  html += '</tr>';\n  for (const row of rows) {\n    html += '<tr>';\n    for (let i = 0; i < columns.length; i++) {\n      const amount = columns[i].isAmount === true;\n      html += '<td style=\"white-space:nowrap;' + (amount ? ' text-align:right;' : '') + '\">' + row[i] + '</td>';\n    }\n    html += '</tr>';\n  }\n  html += '</table>';\n  if (includeScroll) html += '</div>';\n  return html;\n}\n\nfunction normalizeValidationGroups() {\n  const groups = Array.isArray(lastDataBlock && lastDataBlock.groups) ? lastDataBlock.groups : [];\n  const normalized = [];\n  for (let i = 0; i < groups.length; i++) {\n    const raw = groups[i];\n    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) continue;\n    const currencyCodes = [];\n    function addCode(value) {\n      const code = normalizeCurrencyCode(value);\n      if (code && !currencyCodes.includes(code)) currencyCodes.push(code);\n    }\n    addCode(raw.currencyCode);\n    if (Array.isArray(raw.currencyCodes)) {\n      for (const code of raw.currencyCodes) addCode(code);\n    }\n    const detailsRows = [];\n    if (Array.isArray(raw.detailedTransactionDetails)) {\n      for (const row of raw.detailedTransactionDetails) {\n        if (!row || typeof row !== 'object' || Array.isArray(row)) continue;\n        addCode(row.receiverLedgerCurrencyCode || row.currencyCode);\n        detailsRows.push(row);\n      }\n    }\n    const currencyCode = currencyCodes.length === 1 ? currencyCodes[0] : '';\n    const transactionNumbers = Array.isArray(raw.transactionNumbers)\n      ? raw.transactionNumbers.filter((v) => v !== null && v !== undefined && v !== '').map((v) => String(Number(v)))\n      : [];\n    const guidanceSteps = raw.detailedGuidance && Array.isArray(raw.detailedGuidance.steps)\n      ? raw.detailedGuidance.steps.filter((step) => isNonEmptyString(step)).map((step) => step.trim())\n      : [];\n    const amountTotal = raw.amountTotal !== null && raw.amountTotal !== undefined && raw.amountTotal !== '' && Number.isFinite(Number(raw.amountTotal))\n      ? Number(raw.amountTotal)\n      : '';\n    normalized.push({\n      sNo: Number.isFinite(Number(raw.sNo)) ? Number(raw.sNo) : i + 1,\n      issueCode: isNonEmptyString(raw.issueCode) ? raw.issueCode.trim() : '',\n      issueTitle: isNonEmptyString(raw.shortIssueText) ? raw.shortIssueText.trim() : 'Issue',\n      issueExplanation: isNonEmptyString(raw.completeIssueText) ? raw.completeIssueText.trim() : '',\n      transactionCount: Number.isFinite(Number(raw.transactionCount)) ? Number(raw.transactionCount) : transactionNumbers.length,\n      transactionNumbers,\n      amountTotal,\n      amountTotalDisplay: amountTotal !== '' && currencyCode ? formatAmount(amountTotal, currencyCode) : '',\n      currencyCodes,\n      currencyCode,\n      detailsRows,\n      guidanceSteps\n    });\n  }\n  normalized.sort((a, b) => a.sNo - b.sNo);\n  return normalized;\n}\n\nfunction normalizeSummaryRows() {\n  const rows = Array.isArray(latestTransactionSummary) ? latestTransactionSummary.filter((row) => row && typeof row === 'object' && !Array.isArray(row)) : [];\n  if (!rows.length) return { rows: [], groupBy: '', groupHeader: '' };\n  const candidates = ['transactionSource', 'taskName', 'taskNumber', 'expenditureType', 'projectCostTypeName'];\n  let groupBy = '';\n  for (const candidate of candidates) {\n    if (rows.some((row) => row[candidate] !== null && row[candidate] !== undefined && String(row[candidate]).trim() !== '')) {\n      groupBy = candidate;\n      break;\n    }\n  }\n  if (!groupBy) {\n    const keys = Object.keys(rows[0]).sort();\n    for (const key of keys) {\n      if (key === 'Count' || key === 'Amount') continue;\n      if (rows.some((row) => row[key] !== null && row[key] !== undefined && String(row[key]).trim() !== '')) { groupBy = key; break; }\n    }\n  }\n  const headerMap = {\n    transactionSource: 'Transaction Source',\n    taskName: 'Task',\n    taskNumber: 'Task Number',\n    expenditureType: 'Expenditure Type',\n    projectCostTypeName: 'Expenditure Type'\n  };\n  const groupHeader = headerMap[groupBy] || (groupBy ? groupBy.replace(/[_.]+/g, ' ').replace(/([a-z])([A-Z])/g, '$1 $2').replace(/\\s+/g, ' ').trim().replace(/\\b\\w/g, (c) => c.toUpperCase()) : 'Group');\n  return { rows, groupBy, groupHeader };\n}\n\nfunction renderValidationSummary(groups) {\n  const currencyCodes = [];\n  for (const group of groups) for (const code of group.currencyCodes) if (code && !currencyCodes.includes(code)) currencyCodes.push(code);\n  const singleCurrency = currencyCodes.length === 1 ? currencyCodes[0] : '';\n  let html = '<div><b>Validation Findings</b></div>';\n  html += '<div>I analyzed <b>' + escapeHtml(lastDataBlock.totalTransactions || groups.reduce((sum, group) => sum + group.transactionCount, 0)) + '</b> ' + escapeHtml((Number(lastDataBlock.totalTransactions || groups.reduce((sum, group) => sum + group.transactionCount, 0)) === 1 ? 'transaction' : 'transactions')) + ' and grouped the findings into <b>' + escapeHtml(groups.length) + '</b> issue groups.</div>';\n  const buLine = businessUnitLine();\n  if (buLine) html += buLine;\n  if (singleCurrency) html += disclosureLine();\n  html += '<div style=\"height:8px;\"></div>';\n  html += '<div><b>Findings</b></div>';\n  const columns = [\n    { label: 'Issue Group' },\n    { label: 'Issue' },\n    { label: 'Transactions' }\n  ];\n  if (singleCurrency) columns.push({ label: amountHeader(singleCurrency), isAmount: true });\n  const rows = groups.map((group) => {\n    const row = [escapeHtml(group.sNo), escapeHtml(group.issueTitle), escapeHtml(group.transactionCount)];\n    if (singleCurrency) row.push(escapeHtml(group.amountTotalDisplay || '—'));\n    return row;\n  });\n  html += makeTable(columns, rows, true);\n  html += '<div style=\"height:8px;\"></div>';\n  html += '<div><b>What You Can Do Next</b></div>';\n  if (groups[0]) html += '<div>1. Reply <b>issue ' + escapeHtml(groups[0].sNo) + '</b> to open that issue group.</div>';\n  if (groups[1]) html += '<div>2. Reply <b>issue ' + escapeHtml(groups[1].sNo) + '</b> to open another issue group.</div>';\n  return html;\n}\n\nfunction renderValidationDetail(group, hasMultipleGroups) {\n  if (!group) {\n    return '<div><b>Validation Findings</b></div><div>That issue group is not present in the latest findings.</div><div>Reply <b>show issue groups</b> to review the available findings.</div>';\n  }\n  const detailCurrencyCodes = [];\n  for (const code of group.currencyCodes) if (code && !detailCurrencyCodes.includes(code)) detailCurrencyCodes.push(code);\n  for (const row of group.detailsRows) {\n    const code = normalizeCurrencyCode(row.receiverLedgerCurrencyCode || row.currencyCode);\n    if (code && !detailCurrencyCodes.includes(code)) detailCurrencyCodes.push(code);\n  }\n  const singleCurrency = detailCurrencyCodes.length === 1 ? detailCurrencyCodes[0] : '';\n  let html = '<div><b>Issue Group Details</b></div>';\n  html += '<div>Issue Group <b>' + escapeHtml(group.sNo) + '</b> needs attention.</div>';\n  const buLine = businessUnitLine();\n  if (buLine) html += buLine;\n  html += '<div style=\"height:8px;\"></div>';\n  html += '<div><b>What Needs Attention</b></div>';\n  html += '<div>' + escapeHtml(group.issueTitle) + '</div>';\n  if (group.issueExplanation) html += '<div>' + escapeHtml(group.issueExplanation) + '</div>';\n  if (group.guidanceSteps.length) {\n    html += '<div style=\"height:8px;\"></div>';\n    html += '<div><b>Recommended Action</b></div>';\n    html += '<ul style=\"margin:0; padding-left:20px;\">';\n    for (const step of group.guidanceSteps) html += '<li>' + escapeHtml(step) + '</li>';\n    html += '</ul>';\n  }\n  if (group.detailsRows.length || group.transactionNumbers.length) {\n    html += '<div style=\"height:8px;\"></div>';\n    html += '<div><b>Transactions Affected</b></div>';\n    if (group.detailsRows.length) {\n      html += '<div style=\"height:6px;\"></div>';\n      html += disclosureLine();\n      const columns = [\n        { label: 'Transaction' },\n        { label: 'Project' },\n        { label: 'Task' },\n        { label: 'Transaction Source' },\n        { label: singleCurrency ? amountHeader(singleCurrency) : 'Amount', isAmount: true }\n      ];\n      const rows = group.detailsRows.map((row) => {\n        const rowCurrency = normalizeCurrencyCode(row.receiverLedgerCurrencyCode || row.currencyCode) || singleCurrency;\n        let amount = '—';\n        if (row.computedAmount !== null && row.computedAmount !== undefined && row.computedAmount !== '' && Number.isFinite(Number(row.computedAmount))) amount = formatAmount(row.computedAmount, rowCurrency);\n        else if (isNonEmptyString(row.computedAmountDisplay)) amount = formatAmount(row.computedAmountDisplay, rowCurrency);\n        if (!singleCurrency && rowCurrency && amount !== '—') amount += ' ' + rowCurrency;\n        return [\n          escapeHtml(row.transactionNumber !== null && row.transactionNumber !== undefined && row.transactionNumber !== '' ? row.transactionNumber : '—'),\n          escapeHtml(row.projectName || row.projectNumber || '—'),\n          escapeHtml(row.taskName || row.taskNumber || '—'),\n          escapeHtml(row.transactionSource || '—'),\n          escapeHtml(amount)\n        ];\n      });\n      html += makeTable(columns, rows, true);\n    } else {\n      const rows = group.transactionNumbers.map((txn) => [escapeHtml(txn)]);\n      html += makeTable([{ label: 'Transaction' }], rows, true);\n    }\n  }\n  if (hasMultipleGroups) {\n    html += '<div style=\"height:8px;\"></div>';\n    html += '<div><b>What You Can Do Next</b></div>';\n    html += '<div>1. Reply <b>show issue groups</b> to return to the findings summary.</div>';\n    html += '<div>2. Reply <b>issue &lt;number&gt;</b> to open another issue group.</div>';\n  }\n  return html;\n}\n\nfunction renderValidationFactView(groups) {\n  const rows = [];\n  const seen = {};\n  for (const group of groups) {\n    for (const row of group.detailsRows) {\n      const txn = row.transactionNumber !== null && row.transactionNumber !== undefined && row.transactionNumber !== '' ? String(Number(row.transactionNumber)) : '';\n      if (!txn || seen[txn]) continue;\n      seen[txn] = true;\n      rows.push(row);\n    }\n  }\n  if (!rows.length) return '<div><b>Latest Available Result</b></div><div>That information isn\\'t available in the latest result.</div><div>Reply <b>show issue groups</b> to review the available findings.</div>';\n\n  const q = resolvedUserQuery.toLowerCase();\n  const title = '<div><b>Validation Fact Check</b></div>';\n  const buLine = businessUnitLine();\n\n  function distinct(fieldNames) {\n    const values = [];\n    const seenValues = {};\n    for (const row of rows) {\n      let value = '';\n      for (const fieldName of fieldNames) {\n        if (row[fieldName] !== null && row[fieldName] !== undefined && String(row[fieldName]).trim() !== '') {\n          value = String(row[fieldName]).trim();\n          break;\n        }\n      }\n      if (!value || seenValues[value]) continue;\n      seenValues[value] = true;\n      values.push(value);\n    }\n    return values;\n  }\n\n  if (q.includes('task association') || q.includes('what task') || q.includes('task name') || q.includes('task number')) {\n    let html = title;\n    html += '<div>Here is the task association for the transactions in the latest validation result.</div>';\n    if (buLine) html += buLine;\n    html += '<div style=\"height:8px;\"></div><div><b>Key Facts</b></div>';\n    const tableRows = rows.map((row) => [\n      escapeHtml(row.transactionNumber !== null && row.transactionNumber !== undefined && row.transactionNumber !== '' ? row.transactionNumber : '—'),\n      escapeHtml(row.projectName || row.projectNumber || '—'),\n      escapeHtml(row.taskName || '—'),\n      escapeHtml(row.taskNumber || '—')\n    ]);\n    html += makeTable([\n      { label: 'Transaction' },\n      { label: 'Project' },\n      { label: 'Task' },\n      { label: 'Task Number' }\n    ], tableRows, true);\n    return html;\n  }\n\n  if (q.includes('transaction number') || q.includes('transaction numbers') || q.includes('list of transactions')) {\n    let html = title;\n    html += '<div>The latest validation result includes <b>' + escapeHtml(rows.length) + '</b> transaction' + (rows.length === 1 ? '' : 's') + '.</div>';\n    if (buLine) html += buLine;\n    html += '<div style=\"height:8px;\"></div><div><b>Key Facts</b></div>';\n    html += makeTable([{ label: 'Transaction' }], rows.map((row) => [escapeHtml(row.transactionNumber)]), true);\n    return html;\n  }\n\n  if (q.includes('project status')) {\n    const statuses = distinct(['projectStatusCode']);\n    let html = title;\n    html += '<div>Project status in the latest validation result: <b>' + escapeHtml(statuses.join(', ') || '—') + '</b>.</div>';\n    if (buLine) html += buLine;\n    return html;\n  }\n\n  if (q.includes('project name') || q.includes('project number')) {\n    const values = q.includes('project number') ? distinct(['projectNumber']) : distinct(['projectName', 'projectNumber']);\n    let html = title;\n    html += '<div>' + escapeHtml((q.includes('project number') ? 'Project number' : 'Project')) + ' in the latest validation result: <b>' + escapeHtml(values.join(', ') || '—') + '</b>.</div>';\n    if (buLine) html += buLine;\n    return html;\n  }\n\n  if (q.includes('transaction source')) {\n    const values = distinct(['transactionSource']);\n    let html = title;\n    html += '<div>Transaction source' + (values.length === 1 ? '' : 's') + ' in the latest validation result: <b>' + escapeHtml(values.join(', ') || '—') + '</b>.</div>';\n    if (buLine) html += buLine;\n    return html;\n  }\n\n  if (q.includes('capitalizable') || q.includes('included in asset line') || q.includes('enable capitalization')) {\n    const facts = [];\n    const sample = rows[0] || {};\n    if (q.includes('capitalizable')) facts.push(['Capitalizable', sample.capitalizableFlag === 'Y' ? 'Yes' : sample.capitalizableFlag === 'N' ? 'No' : '—']);\n    if (q.includes('included in asset line')) facts.push(['Included In Asset Line', sample.includedInAssetLine === 'Y' ? 'Yes' : sample.includedInAssetLine === 'N' ? 'No' : '—']);\n    if (q.includes('enable capitalization')) facts.push(['Project Enables Capitalization', sample.enableCapitalizationFlag === true || sample.enableCapitalizationFlag === 'Y' ? 'Yes' : sample.enableCapitalizationFlag === false || sample.enableCapitalizationFlag === 'N' ? 'No' : '—']);\n    let html = title;\n    html += '<div>Here are the relevant flags from the latest validation result.</div>';\n    if (buLine) html += buLine;\n    html += '<div style=\"height:8px;\"></div><div><b>Key Facts</b></div>';\n    html += makeTable([{ label: 'Field' }, { label: 'Value' }], facts.map((fact) => [escapeHtml(fact[0]), escapeHtml(fact[1])]), true);\n    return html;\n  }\n\n  if (q.includes('raw amount') || q.includes('burdened amount')) {\n    let total = 0;\n    let any = false;\n    const fieldName = q.includes('raw amount') ? 'rawCostInReceiverLedgerCurrency' : 'burdenedCostInReceiverLedgerCurrency';\n    const currencyCode = normalizeCurrencyCode(currencyContext.singleCurrencyCode || currencyContext.currencyCode || currentProject.currencyCode || rows[0].receiverLedgerCurrencyCode || rows[0].currencyCode);\n    for (const row of rows) {\n      const amount = Number(row[fieldName]);\n      if (!Number.isFinite(amount)) continue;\n      any = true;\n      total += amount;\n    }\n    let html = title;\n    html += '<div>' + escapeHtml(q.includes('raw amount') ? 'Total raw amount' : 'Total burdened amount') + ' in the latest validation result: <b>' + escapeHtml(any ? formatAmount(total, currencyCode) : '—') + '</b>.</div>';\n    if (buLine) html += buLine;\n    return html;\n  }\n\n  return '<div><b>Latest Available Result</b></div><div>That information isn\\'t available in the latest result.</div><div>Reply <b>show issue groups</b> to review the available findings.</div>';\n}\n\nfunction renderSummaryView(summaryInfo) {\n  if (!summaryInfo.rows.length) return '<div><b>Latest Available Result</b></div><div>No previous result is available. Ask for the relevant summary or detail again.</div>';\n  if (!summaryInfo.rows.length) return '<div><b>Latest Available Result</b></div><div>No previous result is available. Ask for the relevant summary or detail again.</div>';\n\n  if (resolvedUserQuery.toLowerCase().includes('row ')) {\n    return '<div><b>Transaction Summary</b></div><div>To open a specific group, run a fresh query for that group.</div>';\n  }\n  if (resolvedUserQuery.toLowerCase().includes('row ')) {\n    return '<div><b>Transaction Summary</b></div><div>To open a specific group, run a fresh query for that group.</div>';\n  }\n  const currencyCode = normalizeCurrencyCode(currencyContext.singleCurrencyCode || currencyContext.currencyCode || currentProject.currencyCode);\n  let totalCount = Number(summaryCountRaw);\n  if (!Number.isFinite(totalCount)) {\n    totalCount = 0;\n    for (const row of summaryInfo.rows) {\n      const countValue = Number(row.Count);\n      if (Number.isFinite(countValue)) totalCount += countValue;\n    }\n  }\n  let html = '<div><b>Transaction Summary</b></div>';\n  html += '<div>I found <b>' + escapeHtml(totalCount) + '</b> pending capitalization transaction' + (totalCount === 1 ? '' : 's') + ' for ' + escapeHtml(projectLabel()) + '.</div>';\n  const buLine = businessUnitLine();\n  if (buLine) html += buLine;\n  if (summaryInfo.groupHeader) html += '<div>They are grouped below by ' + escapeHtml(summaryInfo.groupHeader.toLowerCase()) + '.</div>';\n  html += disclosureLine();\n  html += '<div style=\"height:8px;\"></div><div><b>Summary</b></div>';\n  const rows = summaryInfo.rows.map((row, index) => [\n    escapeHtml(index + 1),\n    escapeHtml(row[summaryInfo.groupBy] !== null && row[summaryInfo.groupBy] !== undefined && String(row[summaryInfo.groupBy]).trim() !== '' ? row[summaryInfo.groupBy] : '—'),\n    escapeHtml(row.Count !== null && row.Count !== undefined && String(row.Count).trim() !== '' ? row.Count : '—'),\n    escapeHtml(formatAmount(row.Amount, currencyCode))\n  ]);\n  html += makeTable([\n    { label: 'S.No' },\n    { label: summaryInfo.groupHeader || 'Group' },\n    { label: 'Transactions' },\n    { label: amountHeader(currencyCode), isAmount: true }\n  ], rows, true);\n  const anyDiagnosableGroup = summaryInfo.rows.some((row) => {\n    const countValue = Number(row.Count);\n    return Number.isFinite(countValue) && countValue <= 50;\n  });\n  const isTaskGrouping = summaryInfo.groupBy === 'taskName' || summaryInfo.groupBy === 'taskNumber';\n  html += '<div style=\"height:12px;\"></div><div><b>What You Can Do Next</b></div>';\n  if (summaryInfo.rows.length === 1) {\n    if (anyDiagnosableGroup) {\n      html += '<div>1. You can reply <b>diagnose row 1</b> to review possible issues in this group.</div>';\n      html += isTaskGrouping\n        ? '<div>2. Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.</div>'\n        : '<div>2. To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.</div>';\n    } else {\n      html += '<div>1. I can diagnose up to <b>50</b> transactions at a time. Apply a filter, such as date range or minimum amount, to narrow this group.</div>';\n      html += isTaskGrouping\n        ? '<div>2. Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.</div>'\n        : '<div>2. To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.</div>';\n    }\n  } else {\n    html += '<div>1. Reply with a row number, such as <b>row 1</b>, to open that <b>' + escapeHtml(summaryInfo.groupHeader || 'Group') + '</b> group.</div>';\n    html += anyDiagnosableGroup\n      ? '<div>2. If your chosen row has <b>50 or fewer</b> transactions, you can reply <b>diagnose row &lt;S.No.&gt;</b> to review possible issues in that group.</div>'\n      : '<div>2. I can diagnose up to <b>50</b> transactions at a time. Apply a filter, such as date range or minimum amount, to narrow this group.</div>';\n    html += isTaskGrouping\n      ? '<div>3. Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.</div>'\n      : '<div>3. To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.</div>';\n  }\n  return html;\n}\n\nconst validationGroups = normalizeValidationGroups();\nconst summaryInfo = normalizeSummaryRows();\nconst requestType = isNonEmptyString(request.requestType) ? request.requestType.trim() : '';\nconst targetKind = request.target && isNonEmptyString(request.target.kind) ? request.target.kind.trim().toUpperCase() : '';\nconst targetValue = request.target ? request.target.value : null;\nconst action = request.presentation && isNonEmptyString(request.presentation.action) ? request.presentation.action.trim().toLowerCase() : '';\nconst queryLower = resolvedUserQuery.toLowerCase();\nconst validationRequested = requestType === 'VALIDATION_INSPECTION' || queryLower.includes('issue') || queryLower.includes('findings') || queryLower.includes('validation');\nconst issueDetailRequested = validationRequested && targetKind === 'ISSUE_GROUP' && targetValue !== null && targetValue !== undefined && String(targetValue).trim() !== '';\nconst guidanceWithoutNumber = validationRequested && !issueDetailRequested && validationGroups.length === 1 && (queryLower.includes('guidance') || queryLower.includes('why') || queryLower.includes('recommended action') || queryLower.includes('how to fix'));\nconst factRequested = validationRequested && action === 'details' && !issueDetailRequested;\nconst summaryRequested = !validationRequested || requestType === 'PENDING_COST_GROUP_SUMMARY' || queryLower.includes('transaction summary') || queryLower.includes('grouped summary') || queryLower.includes('source summary') || queryLower.includes('task summary');\n\nif (issueDetailRequested) {\n  const desired = String(targetValue).trim();\n  const group = validationGroups.find((item) => String(item.sNo) === desired);\n  return renderValidationDetail(group, validationGroups.length > 1);\n}\nif (guidanceWithoutNumber) {\n  return renderValidationDetail(validationGroups[0], false);\n}\nif (factRequested) {\n  return renderValidationFactView(validationGroups);\n}\nif (validationRequested && validationGroups.length) {\n  return renderValidationSummary(validationGroups);\n}\nif (summaryRequested && summaryInfo.rows.length) {\n  return renderSummaryView(summaryInfo);\n}\nif (validationGroups.length) {\n  return renderValidationSummary(validationGroups);\n}\nif (summaryInfo.rows.length) {\n  return renderSummaryView(summaryInfo);\n}\nreturn '<div><b>Latest Available Result</b></div><div>No previous result is available. Ask for the relevant summary or detail again.</div>';"
          },
          "outcomes": {
            "success": "1779900100004"
          },
          "code": "FORMAT_LAST_CACHE_RESULT",
          "id": "1772813987125",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Presentation Payload",
            "returnType": "string",
            "sourceCode": "const input = {\n  appliedFilters: $context.$nodes.EXTRACT_REQUEST_PARAMS.$output.result ,\n  displayMode: $context.$nodes.CHOOSE_SUMMARY_OR_DETAILS_PATH.$output ,\n  details: $context.$nodes.GET_TRANSACTION_DETAILS.$output ,\n  summary: $context.$nodes.GET_PENDING_COST_SUMMARY.$output ,\n  projectName: $context.$variables.prjPjcVarConvCurrentProjectDetails.projectName ,\n  projectNumber: $context.$variables.prjPjcVarConvCurrentProjectDetails.projectNumber ,\n  businessUnitName: $context.$variables.prjPjcVarConvCurrentProjectDetails.businessUnitName,\n  currencyCode: $context.$variables.prjPjcVarConvCurrentProjectDetails.currencyCode,\n  preferredDateFormat: $context.$variables.prjPjcVarUserPreferredDateFormat,\n  lastTransactionSummary: $context.$variables.prjPjcVarConvLatestTransactionSummary \n};\n\nconst displayNames = {\n  taskNumber: \"Task Number\",\n  taskName: \"Task Name\",\n  expenditureType: \"Expenditure Type\",\n  contractNumber: \"Contract Number\",\n  contractName: \"Contract Name\",\n  fundingSourceNumber: \"Funding Source Number\",\n  supplierNumber: \"Supplier Number\",\n  supplierName: \"Supplier Name\",\n  documentName: \"Document Name\",\n  documentEntryName: \"Document Entry Name\",\n  projectRoleName: \"Project Role Name\",\n  personJobName: \"Person Job Name\",\n  businessUnitName: \"Business Unit\",\n  transactionDate: \"Transaction Date\",\n  Amount: \"Amount\",\n  transactionNumber: \"Transaction\",\n  transactionSource: \"Transaction Source\",\n  projectCostTypeName: \"Expenditure Type\",\n  amount: \"Amount\",\n  dateFrom: \"Transaction Date From\",\n  dateTo: \"Transaction Date To\",\n  minAmount: \"Minimum Amount\",\n  maxAmount: \"Maximum Amount\"\n};\n\nlet appliedFilters =\n  input &&\n  input.appliedFilters &&\n  typeof input.appliedFilters === \"object\" &&\n  !Array.isArray(input.appliedFilters)\n    ? input.appliedFilters\n    : {};\n\nlet displayMode =\n  typeof input.displayMode === \"string\"\n    ? input.displayMode.trim().toUpperCase()\n    : \"DETAILS\";\n\nif (displayMode !== \"DETAILS\" && displayMode !== \"SUMMARY\") {\n  displayMode = \"DETAILS\";\n}\n\nlet details = Array.isArray(input.details)\n  ? input.details.filter(row => row && typeof row === \"object\" && !Array.isArray(row))\n  : [];\n\nlet summary = Array.isArray(input.summary)\n  ? input.summary.filter(row => row && typeof row === \"object\" && !Array.isArray(row))\n  : [];\n\nlet projectName =\n  input.projectName === null || input.projectName === undefined\n    ? \"\"\n    : String(input.projectName).trim();\n\nlet projectNumber =\n  input.projectNumber === null || input.projectNumber === undefined\n    ? \"\"\n    : String(input.projectNumber).trim();\n\nlet businessUnitName =\n  input.businessUnitName === null || input.businessUnitName === undefined\n    ? \"\"\n    : String(input.businessUnitName).trim();\n\nlet currencyCode =\n  input.currencyCode === null || input.currencyCode === undefined\n    ? \"\"\n    : String(input.currencyCode).trim();\n\nlet preferredDateFormat =\n  input.preferredDateFormat === null || input.preferredDateFormat === undefined\n    ? \"yyyy-MM-dd\"\n    : String(input.preferredDateFormat).trim();\n\nif (!preferredDateFormat) {\n  preferredDateFormat = \"yyyy-MM-dd\";\n}\n\n\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction getNumberPreferences() {\n  const prefs = parseJsonSafe($context.$variables.prjPjcVarUserNumberFormatPreferences, {});\n  return prefs && typeof prefs === \"object\" && !Array.isArray(prefs) ? prefs : {};\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (value === null || value === undefined) return \"\";\n  const code = String(value).trim().toUpperCase();\n  return /^[A-Z]{3}$/.test(code) ? code : \"\";\n}\n\nfunction getPresentationCurrencyContext() {\n  const raw = parseJsonSafe($context.$nodes.BUILD_PRESENTATION_CURRENCY_PRECISION_CONTEXT?.$output?.result, {});\n  return raw && typeof raw === \"object\" && !Array.isArray(raw) ? raw : {};\n}\n\nconst presentationCurrencyContext = getPresentationCurrencyContext();\n\nfunction getPrecision(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const map = presentationCurrencyContext.precisionByCurrency && typeof presentationCurrencyContext.precisionByCurrency === \"object\"\n    ? presentationCurrencyContext.precisionByCurrency\n    : {};\n  const precision = Number(map[code]);\n  if (Number.isFinite(precision) && precision >= 0 && precision <= 10) {\n    return Math.floor(precision);\n  }\n  return 2;\n}\n\nfunction getRoundingIncrement(currencyCode, precision) {\n  const code = normalizeCurrencyCode(currencyCode);\n  const incrementMap =\n    presentationCurrencyContext &&\n    typeof presentationCurrencyContext.roundingIncrementByCurrency === \"object\"\n      ? presentationCurrencyContext.roundingIncrementByCurrency\n      : {};\n\n  const increment = Number(incrementMap[code]);\n  if (Number.isFinite(increment) && increment > 0) return increment;\n\n  return 1 / Math.pow(10, precision);\n}\n\nfunction roundHalfUpToIncrement(amount, increment) {\n  if (!Number.isFinite(amount) || !Number.isFinite(increment) || increment <= 0) return amount;\n\n  const sign = amount < 0 ? -1 : 1;\n  const roundedUnits = Math.floor(Math.abs(amount) / increment + 0.5 + 1e-9);\n\n  return sign * roundedUnits * increment;\n}\n\nfunction amountHeader(currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  return code ? \"Amount (\" + code + \")\" : \"Amount\";\n}\n\nfunction amountFilterLabel(label, currencyCode) {\n  const code = normalizeCurrencyCode(currencyCode);\n  return code ? label + \" (\" + code + \")\" : label;\n}\n\nfunction isAmountColumn(column) {\n  return column === \"Amount\" || /^Amount \\([A-Z]{3}\\)$/.test(String(column));\n}\n\nconst amountCurrencyCode = normalizeCurrencyCode(presentationCurrencyContext.singleCurrencyCode || presentationCurrencyContext.currencyCode || currencyCode);\nconst amountColumnHeader = amountHeader(amountCurrencyCode);\n\nfunction toAmountNumber(value) {\n  if (typeof value === \"number\") {\n    return Number.isFinite(value) ? value : NaN;\n  }\n\n  if (typeof value !== \"string\") {\n    return NaN;\n  }\n\n  let text = value.trim();\n  if (!text || text === \"—\" || text === \"-\") {\n    return NaN;\n  }\n\n  if (/^[+-]?\\d+(\\.\\d+)?$/.test(text)) {\n    const rawAmount = Number(text);\n    return Number.isFinite(rawAmount) ? rawAmount : NaN;\n  }\n\n  const prefs = getNumberPreferences();\n  const groupingSeparator = typeof prefs.groupingSeparator === \"string\" ? prefs.groupingSeparator : \",\";\n  const decimalSeparator = typeof prefs.decimalSeparator === \"string\" ? prefs.decimalSeparator : \".\";\n\n  if (groupingSeparator) {\n    text = text.split(groupingSeparator).join(\"\");\n  }\n\n  if (decimalSeparator && decimalSeparator !== \".\") {\n    text = text.split(decimalSeparator).join(\".\");\n  }\n\n  text = text.replace(/[^0-9.+-]/g, \"\");\n  const amount = Number(text);\n  return Number.isFinite(amount) ? amount : NaN;\n}\n\nfunction groupIntegerPart(integerPart, numberFormat, groupingSeparator, decimalSeparator) {\n  if (!groupingSeparator || integerPart.length <= 3) {\n    return integerPart;\n  }\n\n  let format = typeof numberFormat === \"string\" && numberFormat ? numberFormat : \"#,##0.###\";\n  let decimalIndex = decimalSeparator ? format.lastIndexOf(decimalSeparator) : -1;\n  if (decimalIndex < 0 && decimalSeparator !== \".\") {\n    decimalIndex = format.lastIndexOf(\".\");\n  }\n\n  const integerPattern = decimalIndex >= 0 ? format.slice(0, decimalIndex) : format;\n  let patternGroupingSeparator = groupingSeparator;\n  if (!integerPattern.includes(patternGroupingSeparator)) {\n    if (integerPattern.includes(\",\")) {\n      patternGroupingSeparator = \",\";\n    } else if (integerPattern.includes(\".\")) {\n      patternGroupingSeparator = \".\";\n    }\n  }\n\n  if (!integerPattern.includes(patternGroupingSeparator)) {\n    return integerPart;\n  }\n\n  const groups = integerPattern\n    .split(patternGroupingSeparator)\n    .map((part) => part.replace(/[^#0]/g, \"\"));\n\n  const primarySize = Math.max(1, groups[groups.length - 1]?.length || 3);\n  const secondarySize = groups.length > 2 ? Math.max(1, groups[groups.length - 2]?.length || primarySize) : primarySize;\n  const parts = [];\n  let cursor = integerPart.length;\n\n  parts.unshift(integerPart.slice(Math.max(0, cursor - primarySize), cursor));\n  cursor -= primarySize;\n\n  while (cursor > 0) {\n    parts.unshift(integerPart.slice(Math.max(0, cursor - secondarySize), cursor));\n    cursor -= secondarySize;\n  }\n\n  return parts.filter(Boolean).join(groupingSeparator);\n}\n\nfunction formatAmount(value, currencyCode) {\n  if (value === null || value === undefined || value === \"\") {\n    return \"—\";\n  }\n\n  const amount = toAmountNumber(value);\n  if (!Number.isFinite(amount)) {\n    return String(value);\n  }\n\n  const prefs = getNumberPreferences();\n  const numberFormat = typeof prefs.numberFormat === \"string\" && prefs.numberFormat ? prefs.numberFormat : \"#,##0.###\";\n  const decimalSeparator = typeof prefs.decimalSeparator === \"string\" ? prefs.decimalSeparator : \".\";\n  const groupingSeparator = typeof prefs.groupingSeparator === \"string\" ? prefs.groupingSeparator : \",\";\n  const precision = getPrecision(currencyCode);\nconst roundedAmount = roundHalfUpToIncrement(\n  amount,\n  getRoundingIncrement(currencyCode, precision)\n);\nconst sign = roundedAmount < 0 ? \"-\" : \"\";\nconst fixed = Math.abs(roundedAmount).toFixed(precision);\n  const parts = fixed.split(\".\");\n  const integerPart = groupIntegerPart(parts[0], numberFormat, groupingSeparator, decimalSeparator);\n\n  if (precision === 0) {\n    return sign + integerPart;\n  }\n\n  return sign + integerPart + decimalSeparator + (parts[1] || \"\").padEnd(precision, \"0\");\n}\n\nlet lastTransactionSummary = input.lastTransactionSummary;\n\nif (typeof lastTransactionSummary === \"string\") {\n  try {\n    lastTransactionSummary = JSON.parse(lastTransactionSummary);\n  } catch (e) {\n  }\n}\n\nlet hasLastTransactionSummary = false;\nif (Array.isArray(lastTransactionSummary)) {\n  hasLastTransactionSummary = lastTransactionSummary.length > 0;\n} else if (\n  lastTransactionSummary !== null &&\n  lastTransactionSummary !== undefined &&\n  !(typeof lastTransactionSummary === \"string\" && lastTransactionSummary.trim() === \"\")\n) {\n  hasLastTransactionSummary = true;\n}\n\nlet projectRef = \"this project\";\nif (\n  projectName &&\n  projectNumber &&\n  projectName.toLowerCase() !== projectNumber.toLowerCase()\n) {\n  projectRef = projectName + \" (\" + projectNumber + \")\";\n} else if (projectName) {\n  projectRef = projectName;\n} else if (projectNumber) {\n  projectRef = projectNumber;\n}\n\nlet filters = [];\nlet rawFilters =\n  appliedFilters.filters &&\n  typeof appliedFilters.filters === \"object\" &&\n  !Array.isArray(appliedFilters.filters)\n    ? appliedFilters.filters\n    : {};\n\nfor (let key of Object.keys(rawFilters)) {\n  let value = rawFilters[key];\n\n  let isEmpty =\n    value === null ||\n    value === undefined ||\n    value === false ||\n    (typeof value === \"string\" &&\n      (value.trim() === \"\" ||\n        value.trim().toLowerCase() === \"null\" ||\n        value.trim().toLowerCase() === \"undefined\" ||\n        value.trim().toLowerCase() === \"all\"));\n\n  if (isEmpty) continue;\n\n  let label = displayNames[key];\n  if (!label) {\n    label = key\n      .replace(/[_.]+/g, \" \")\n      .replace(/([a-z])([A-Z])/g, \"$1 $2\")\n      .replace(/\\s+/g, \" \")\n      .trim()\n      .split(\" \")\n      .map(part => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())\n      .join(\" \");\n  }\n\n  let displayValue = String(value);\n\n  if (key === \"amount\" || key === \"minAmount\" || key === \"maxAmount\") {\n    label = amountFilterLabel(label, amountCurrencyCode);\n    displayValue = formatAmount(value, amountCurrencyCode);\n  }\n\n  if (key === \"transactionDate\" || key === \"dateFrom\" || key === \"dateTo\") {\n    let text = String(value).trim();\n    let date = new Date(text);\n\n    if (isNaN(date.getTime())) {\n      let match = text.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n      if (match) {\n        date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));\n      }\n    }\n\n    if (!isNaN(date.getTime())) {\n      let year4 = String(date.getFullYear());\n      let year2 = year4.slice(-2);\n      let month = String(date.getMonth() + 1);\n      let month2 = String(date.getMonth() + 1).padStart(2, \"0\");\n      let day = String(date.getDate());\n      let day2 = String(date.getDate()).padStart(2, \"0\");\n\n      displayValue = preferredDateFormat;\n      displayValue = displayValue.replace(/yyyy/gi, year4);\n      displayValue = displayValue.replace(/yy/gi, year2);\n      displayValue = displayValue.replace(/mm/gi, month2);\n      displayValue = displayValue.replace(/m/gi, month);\n      displayValue = displayValue.replace(/dd/gi, day2);\n      displayValue = displayValue.replace(/d/gi, day);\n    }\n  }\n\n  filters.push({\n    label,\n    value: displayValue\n  });\n}\n\nlet totalCount = 0;\n\nif (displayMode === \"DETAILS\") {\n  totalCount = details.length;\n} else {\n  for (let row of summary) {\n    let countNum =\n      typeof row.Count === \"number\"\n        ? row.Count\n        : typeof row.Count === \"string\" && row.Count.trim() !== \"\"\n        ? Number(row.Count.trim())\n        : NaN;\n\n    if (Number.isFinite(countNum)) {\n      totalCount += countNum;\n    }\n  }\n}\n\nlet headerLine = \"\";\nif (totalCount === 0) {\n  headerLine =\n    \"No pending capitalization transactions were found for \" +\n    String(projectRef)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \".\";\n} else if (totalCount === 1) {\n  headerLine =\n    \"I found <b>1</b> pending capitalization transaction for \" +\n    String(projectRef)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \".\";\n} else {\n  headerLine =\n    \"I found <b>\" +\n    String(totalCount)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \"</b> pending capitalization transactions for \" +\n    String(projectRef)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \".\";\n}\n\nlet secondaryLine = \"\";\nlet bodyLines = [];\nlet guidanceItems = [];\nlet showAmountDisclosure = false;\nlet table = null;\n\nif (displayMode === \"DETAILS\") {\n  if (details.length > 0) {\n    secondaryLine = \"Transaction-level results are shown below.\";\n    showAmountDisclosure = true;\n\n    let taskColumnHeader = \"Task\";\n    if (\n      details.some(\n        row =>\n          row.taskName !== null &&\n          row.taskName !== undefined &&\n          String(row.taskName).trim() !== \"\"\n      )\n    ) {\n      taskColumnHeader = displayNames.taskName;\n    } else if (\n      details.some(\n        row =>\n          row.taskNumber !== null &&\n          row.taskNumber !== undefined &&\n          String(row.taskNumber).trim() !== \"\"\n      )\n    ) {\n      taskColumnHeader = displayNames.taskNumber;\n    }\n\n    table = {\n      title: \"Transaction Details\",\n      columns: [\"S.No\", displayNames.transactionNumber, taskColumnHeader, amountColumnHeader],\n      rows: []\n    };\n\n    for (let i = 0; i < details.length; i++) {\n      let row = details[i];\n\n      let transactionNumber =\n        row.transactionNumber === null ||\n        row.transactionNumber === undefined ||\n        row.transactionNumber === \"\"\n          ? \"—\"\n          : String(row.transactionNumber);\n\n      let task =\n        row.taskName !== null &&\n        row.taskName !== undefined &&\n        String(row.taskName) !== \"\"\n          ? String(row.taskName)\n          : row.taskNumber !== null &&\n            row.taskNumber !== undefined &&\n            String(row.taskNumber) !== \"\"\n          ? String(row.taskNumber)\n          : \"—\";\n\n      let amount = formatAmount(row.Amount, amountCurrencyCode);\n\n      table.rows.push([\n        String(i + 1)\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        transactionNumber\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        task\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        amount\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\")\n      ]);\n    }\n\n guidanceItems = [\n  {\n    number: \"1.\",\n    text: \"Reply <b>diagnose everything</b> to review possible capitalization issues for the transactions shown.\"\n  },\n  {\n    number: \"2.\",\n    text: \"To diagnose specific transactions, paste the selected transaction numbers from the list above.\"\n  }\n];\n\n    if (hasLastTransactionSummary) {\n      guidanceItems.push({\n        number: \"3.\",\n        text: \"Reply <b>show transaction summary</b> to view previous transaction summary.\"\n      });\n    }\n  } else {\n    bodyLines = [\n      \"Adjust the filters, such as source, date range, or minimum amount, and search again.\"\n    ];\n  }\n}\n\nif (displayMode === \"SUMMARY\") {\n  let groupingKey = \"Group\";\n\n  if (\n    summary.some(\n      row =>\n        row.transactionSource !== null &&\n        row.transactionSource !== undefined &&\n        String(row.transactionSource).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"transactionSource\";\n  } else if (\n    summary.some(\n      row =>\n        row.taskName !== null &&\n        row.taskName !== undefined &&\n        String(row.taskName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"taskName\";\n  } else if (\n    summary.some(\n      row =>\n        row.taskNumber !== null &&\n        row.taskNumber !== undefined &&\n        String(row.taskNumber).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"taskNumber\";\n  } else if (\n    summary.some(\n      row =>\n        row.expenditureType !== null &&\n        row.expenditureType !== undefined &&\n        String(row.expenditureType).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"expenditureType\";\n  } else if (\n    summary.some(\n      row =>\n        row.contractNumber !== null &&\n        row.contractNumber !== undefined &&\n        String(row.contractNumber).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"contractNumber\";\n  } else if (\n    summary.some(\n      row =>\n        row.contractName !== null &&\n        row.contractName !== undefined &&\n        String(row.contractName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"contractName\";\n  } else if (\n    summary.some(\n      row =>\n        row.fundingSourceNumber !== null &&\n        row.fundingSourceNumber !== undefined &&\n        String(row.fundingSourceNumber).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"fundingSourceNumber\";\n  } else if (\n    summary.some(\n      row =>\n        row.supplierNumber !== null &&\n        row.supplierNumber !== undefined &&\n        String(row.supplierNumber).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"supplierNumber\";\n  } else if (\n    summary.some(\n      row =>\n        row.supplierName !== null &&\n        row.supplierName !== undefined &&\n        String(row.supplierName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"supplierName\";\n  } else if (\n    summary.some(\n      row =>\n        row.documentName !== null &&\n        row.documentName !== undefined &&\n        String(row.documentName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"documentName\";\n  } else if (\n    summary.some(\n      row =>\n        row.documentEntryName !== null &&\n        row.documentEntryName !== undefined &&\n        String(row.documentEntryName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"documentEntryName\";\n  } else if (\n    summary.some(\n      row =>\n        row.projectRoleName !== null &&\n        row.projectRoleName !== undefined &&\n        String(row.projectRoleName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"projectRoleName\";\n  } else if (\n    summary.some(\n      row =>\n        row.personJobName !== null &&\n        row.personJobName !== undefined &&\n        String(row.personJobName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"personJobName\";\n  } else if (\n    summary.some(\n      row =>\n        row.businessUnitName !== null &&\n        row.businessUnitName !== undefined &&\n        String(row.businessUnitName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"businessUnitName\";\n  } else if (\n    summary.some(\n      row =>\n        row.transactionDate !== null &&\n        row.transactionDate !== undefined &&\n        String(row.transactionDate).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"transactionDate\";\n  } else if (\n    summary.some(\n      row =>\n        row.projectCostTypeName !== null &&\n        row.projectCostTypeName !== undefined &&\n        String(row.projectCostTypeName).trim() !== \"\"\n    )\n  ) {\n    groupingKey = \"projectCostTypeName\";\n  } else {\n    let extraKeys = [];\n    for (let row of summary) {\n      for (let key of Object.keys(row)) {\n        if (key !== \"Count\" && key !== \"Amount\" && !extraKeys.includes(key)) {\n          extraKeys.push(key);\n        }\n      }\n    }\n    extraKeys.sort((a, b) => a.localeCompare(b));\n    if (extraKeys.length > 0) groupingKey = extraKeys[0];\n  }\n\n  let groupHeader = displayNames[groupingKey];\n  if (!groupHeader) {\n    groupHeader = groupingKey\n      .replace(/[_.]+/g, \" \")\n      .replace(/([a-z])([A-Z])/g, \"$1 $2\")\n      .replace(/\\s+/g, \" \")\n      .trim()\n      .split(\" \")\n      .map(part => part.charAt(0).toUpperCase() + part.slice(1).toLowerCase())\n      .join(\" \");\n  }\n\n  let groupHeaderLowercase = groupHeader;\n\n  if (summary.length > 0) {\n    secondaryLine =\n      \"Results are grouped below by \" +\n      groupHeaderLowercase\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\") +\n      \".\";\n    showAmountDisclosure = true;\n\n    table = {\n      title: \"Transaction Summary\",\n      columns: [\"S.No\", groupHeader, \"Transactions\", amountColumnHeader],\n      rows: []\n    };\n\n    for (let i = 0; i < summary.length; i++) {\n      let row = summary[i];\n\n      let groupValue =\n        row[groupingKey] === null ||\n        row[groupingKey] === undefined ||\n        row[groupingKey] === \"\"\n          ? \"—\"\n          : String(row[groupingKey]);\n\n      if (groupingKey === \"transactionDate\" && groupValue !== \"—\") {\n        let text = String(groupValue).trim();\n        let date = new Date(text);\n\n        if (isNaN(date.getTime())) {\n          let match = text.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n          if (match) {\n            date = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));\n          }\n        }\n\n        if (!isNaN(date.getTime())) {\n          let year4 = String(date.getFullYear());\n          let year2 = year4.slice(-2);\n          let month = String(date.getMonth() + 1);\n          let month2 = String(date.getMonth() + 1).padStart(2, \"0\");\n          let day = String(date.getDate());\n          let day2 = String(date.getDate()).padStart(2, \"0\");\n\n          groupValue = preferredDateFormat;\n          groupValue = groupValue.replace(/yyyy/gi, year4);\n          groupValue = groupValue.replace(/yy/gi, year2);\n          groupValue = groupValue.replace(/mm/gi, month2);\n          groupValue = groupValue.replace(/m/gi, month);\n          groupValue = groupValue.replace(/dd/gi, day2);\n          groupValue = groupValue.replace(/d/gi, day);\n        }\n      }\n\n      let countValue =\n        row.Count === null || row.Count === undefined || row.Count === \"\"\n          ? \"—\"\n          : String(row.Count);\n\n      let amountValue = formatAmount(row.Amount, amountCurrencyCode);\n\n      table.rows.push([\n        String(i + 1)\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        groupValue\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        countValue\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\"),\n        amountValue\n          .replace(/&/g, \"&amp;\")\n          .replace(/</g, \"&lt;\")\n          .replace(/>/g, \"&gt;\")\n          .replace(/\"/g, \"&quot;\")\n          .replace(/'/g, \"&#39;\")\n      ]);\n    }\n\n    let anyDiagnosableGroup = false;\n    for (let row of summary) {\n      let countNum =\n        typeof row.Count === \"number\"\n          ? row.Count\n          : typeof row.Count === \"string\" && row.Count.trim() !== \"\"\n          ? Number(row.Count.trim())\n          : NaN;\n\n      if (Number.isFinite(countNum) && countNum <= 50) {\n        anyDiagnosableGroup = true;\n        break;\n      }\n    }\n\n    let isTaskGrouping = groupingKey === \"taskName\" || groupingKey === \"taskNumber\";\n\n    if (summary.length === 1) {\n      if (anyDiagnosableGroup) {\n        guidanceItems.push({\n          number: \"1.\",\n          text: \"You can reply <b>diagnose row 1</b> to review possible issues in this group.\"\n        });\n        guidanceItems.push({\n          number: \"2.\",\n          text: isTaskGrouping\n            ? \"Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.\"\n            : \"To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.\"\n        });\n      } else {\n        guidanceItems.push({\n          number: \"1.\",\n          text: \"I can diagnose up to <b>50</b> transactions at a time. Apply a filter, such as date range or minimum amount, to narrow this group.\"\n        });\n        guidanceItems.push({\n          number: \"2.\",\n          text: isTaskGrouping\n            ? \"Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.\"\n            : \"To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.\"\n        });\n      }\n    } else {\n      guidanceItems.push({\n        number: \"1.\",\n        text:\n          \"Reply with a row number, such as <b>row 1</b>, to open that \" +\n          groupHeaderLowercase\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\") +\n          \" group.\"\n      });\n\n      guidanceItems.push({\n        number: \"2.\",\n        text: anyDiagnosableGroup\n          ? \"If your chosen row has <b>50 or fewer</b> transactions, you can reply <b>diagnose row &lt;S.No.&gt;</b> to review possible issues in that group.\"\n          : \"I can diagnose up to <b>50</b> transactions at a time. Apply a filter, such as date range or minimum amount, to narrow this group.\"\n      });\n\n      guidanceItems.push({\n        number: \"3.\",\n        text: isTaskGrouping\n          ? \"Apply additional filters such as <b>date range</b> or <b>minimum amount</b> to narrow the result further.\"\n          : \"To narrow the result further, reply <b>group by task</b> or apply filters such as <b>date range</b> or <b>minimum amount</b>.\"\n      });\n    }\n  } else {\n    bodyLines = [\n      \"Adjust the filters, such as source, date range, or minimum amount, and search again.\"\n    ];\n  }\n}\n\nlet html = \"\";\n\nif (headerLine) {\n  html += \"<div>\" + headerLine + \"</div>\";\n}\n\nlet renderedMetaSection = false;\n\nif (businessUnitName) {\n  html +=\n    \"<div>\" +\n    displayNames.businessUnitName +\n    \": <b>\" +\n    String(businessUnitName)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \"</b></div>\";\n  renderedMetaSection = true;\n}\n\nif (secondaryLine) {\n  html += \"<div>\" + secondaryLine + \"</div>\";\n  renderedMetaSection = true;\n}\n\nif (filters.length > 0) {\n  html += \"<div>Applied filters:</div>\";\n  for (let filter of filters) {\n    html +=\n      \"<div>\" +\n      String(filter.label)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\") +\n      \": <b>\" +\n      String(filter.value)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\") +\n      \"</b></div>\";\n  }\n  renderedMetaSection = true;\n}\n\nif (renderedMetaSection) {\n  html += '<div style=\"height:12px;\"></div>';\n}\n\nif (table && table.title) {\n  html +=\n    \"<div><b>\" +\n    String(table.title)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\") +\n    \"</b></div>\";\n}\n\nif (table && showAmountDisclosure) {\n  html += '<div style=\"height:6px;\"></div>';\n}\n\nif (table && showAmountDisclosure) {\n  html += \"<div>Amounts are shown in <b>Receiver Ledger Currency</b>.</div>\";\n}\n\nif (table) {\n  html +=\n    '<div style=\"width:600px; max-width:100%; max-height:320px; overflow:auto; border:1px solid #d0d0d0; box-sizing:border-box;\">';\n  html +=\n    '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\" style=\"border-collapse:collapse; table-layout:auto; width:max-content; min-width:100%;\">';\n\n  html += \"<tr>\";\n  for (let column of table.columns) {\n    let headerStyle = isAmountColumn(column)\n      ? 'white-space:nowrap; width:1%; text-align:right;'\n      : 'white-space:nowrap; width:1%; text-align:left;';\n    html +=\n      '<th style=\"' + headerStyle + '\">' +\n      String(column)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\") +\n      \"</th>\";\n  }\n  html += \"</tr>\";\n\n  for (let row of table.rows) {\n    html += \"<tr>\";\n  for (let i = 0; i < row.length; i++) {\n    let cell = row[i];\n    let columnName = table.columns[i];\n\n    if (isAmountColumn(columnName)) {\n      html += '<td style=\"white-space:nowrap; text-align:right;\">' + cell + \"</td>\";\n    } else {\n      html += '<td style=\"white-space:nowrap;\">' + cell + \"</td>\";\n    }\n  }\n    html += \"</tr>\";\n  }\n\n  html += \"</table>\";\n  html += \"</div>\";\n}\n\nif (bodyLines.length > 0) {\n  if (table) {\n    html += '<div style=\"height:12px;\"></div>';\n  }\n  for (let line of bodyLines) {\n    html += \"<div>\" + line + \"</div>\";\n  }\n}\n\nif (guidanceItems.length > 0) {\n  if (table) {\n    html += '<div style=\"height:12px;\"></div>';\n  }\n  html += \"<div><b>What You Can Do Next</b></div>\";\n  for (let item of guidanceItems) {\n    html += \"<div>\" + item.number + \" \" + item.text + \"</div>\";\n  }\n}\nreturn html;"
