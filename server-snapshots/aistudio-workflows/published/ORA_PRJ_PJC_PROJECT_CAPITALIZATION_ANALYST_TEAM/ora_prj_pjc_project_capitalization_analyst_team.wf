        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Invalid Transaction Validation Message",
            "returnType": "string",
            "sourceCode": "const input = $context.$nodes.FORMAT_TRANSACTION_LIST_FOR_VALIDATION.$output.result;\n\nlet transactions = [];\n\nif (Array.isArray(input)) {\n  transactions = input;\n} else if (typeof input === \"string\" && input.trim()) {\n  try {\n    const parsed = JSON.parse(input);\n\n    if (Array.isArray(parsed)) {\n      transactions = parsed;\n    } else if (typeof parsed === \"string\" && parsed.trim()) {\n      transactions = [parsed];\n    } else if (parsed != null) {\n      transactions = [parsed];\n    }\n  } catch {\n    transactions = [input];\n  }\n}\n\nif (!Array.isArray(transactions)) {\n  transactions = [];\n}\n\nlet message = \"\";\n\nif (transactions.length === 0) {\n  message = \"Enter up to 50 transaction numbers to analyze, separated by commas or on separate lines.\";\n} else if (transactions.length > 50) {\n  message = '<div>I can analyze up to <b>50</b> transactions at a time. Refine the search so the results contain 50 or fewer transactions.</div><div>For example, group by task or expenditure type, or add a date or amount filter.</div>';\n}\n\nreturn message;"
          },
          "outcomes": {
            "success": "1773762962077"
          },
