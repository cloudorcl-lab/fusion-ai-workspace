        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Build Strategic Handoff Redwood Output",
            "returnType": "string",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value !== 'string') {\n    return String(value).trim();\n  }\n  return value.trim();\n}\n\nfunction stripHtml(value) {\n  return normalizeString(value)\n    .replace(/<br\\s*\\/?>/gi, '\\n')\n    .replace(/<\\/div>/gi, '\\n')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&nbsp;/gi, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction asObject(value) {\n  var parsed = parseJsonSafe(value, null);\n  return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};\n}\n\nfunction asArray(value) {\n  var parsed = parseJsonSafe(value, null);\n  return Array.isArray(parsed) ? parsed : [];\n}\n\nfunction valueOrDefault(value, fallback) {\n  if (value === null || value === undefined || value === '') {\n    return fallback;\n  }\n  return parseJsonSafe(value, value);\n}\n\nfunction asBoolean(value, fallback) {\n  if (typeof value === 'boolean') {\n    return value;\n  }\n  if (typeof value === 'string') {\n    var normalized = value.trim().toLowerCase();\n    if (normalized === 'true') return true;\n    if (normalized === 'false') return false;\n    try {\n      var parsed = JSON.parse(value);\n      if (typeof parsed === 'boolean') {\n        return parsed;\n      }\n    } catch (e) {}\n  }\n  return fallback;\n}\n\nfunction normalizeFilters(requestParams, routeOutput) {\n  if (!requestParams || typeof requestParams !== 'object') {\n    requestParams = {};\n  }\n  var filters = requestParams.filters && typeof requestParams.filters === 'object' ? requestParams.filters : null;\n  var groupBy = requestParams.groupBy;\n  var request = routeOutput && typeof routeOutput === 'object' && routeOutput.request && typeof routeOutput.request === 'object' ? routeOutput.request : {};\n  var scope = request.scope && typeof request.scope === 'object' ? request.scope : {};\n  var projectInput = normalizeString(scope.projectInput);\n  var taskInput = normalizeString(scope.taskInput);\n  var transactionNumbers = Array.isArray(scope.transactionNumbers) ? scope.transactionNumbers : [];\n  var output = {};\n  var hasValue = false;\n  if (filters) {\n    Object.keys(filters).forEach(function (key) {\n      var value = filters[key];\n      if (value !== null && value !== undefined && value !== '') {\n        output[key] = value;\n        hasValue = true;\n      }\n    });\n  }\n  if (groupBy !== null && groupBy !== undefined && groupBy !== '') {\n    output.groupBy = groupBy;\n    hasValue = true;\n  }\n  if (projectInput) {\n    output.projectInput = projectInput;\n    hasValue = true;\n  }\n  if (taskInput) {\n    output.taskInput = taskInput;\n    hasValue = true;\n  }\n  if (transactionNumbers.length > 0) {\n    output.transactionNumbers = transactionNumbers;\n    hasValue = true;\n  }\n  return hasValue ? output : null;\n}\n\nfunction hasMissing(missingInfo, candidates) {\n  var list = asArray(missingInfo).map(function (item) {\n    return normalizeString(item);\n  });\n  for (var i = 0; i < candidates.length; i++) {\n    if (list.indexOf(candidates[i]) !== -1) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction includesText(text, fragment) {\n  return normalizeString(text).toLowerCase().indexOf(String(fragment).toLowerCase()) !== -1;\n}\n\nfunction isPendingCostRequest(requestType) {\n  return requestType === 'PENDING_COST_GROUP_SUMMARY' || requestType === 'PENDING_COST_LIST' || requestType === 'PENDING_COST_FILTERED_LIST';\n}\n\nfunction buildWorkflowSessionState() {\n  return {\n    prjPjcVarConvCurrentProjectDetails: asObject($context.$variables.prjPjcVarConvCurrentProjectDetails),\n    prjPjcVarConvIsSelectionRequired: asBoolean($context.$variables.prjPjcVarConvIsSelectionRequired, false),\n    prjPjcVarConvMatchedProjects: valueOrDefault($context.$variables.prjPjcVarConvMatchedProjects, []),\n    prjPjcVarConvSessionData: asObject($context.$variables.prjPjcVarConvSessionData),\n    prjPjcVarConvPreviousFilter: asObject($context.$variables.prjPjcVarConvPreviousFilter),\n    prjPjcVarConvLastProjectContext: valueOrDefault($context.$variables.prjPjcVarConvLastProjectContext, ''),\n    prjPjcVarConvLatestTransactionSummary: valueOrDefault($context.$variables.prjPjcVarConvLatestTransactionSummary, []),\n    prjPjcVarConvLastTransactionSummaryCount: valueOrDefault($context.$variables.prjPjcVarConvLastTransactionSummaryCount, ''),\n    prjPjcVarConvLatestValidationSummary: asObject($context.$variables.prjPjcVarConvLatestValidationSummary),\n    prjPjcVarConvLastDataBlock: asObject($context.$variables.prjPjcVarConvLastDataBlock),\n    prjPjcVarConvLastValidationFindings: asObject($context.$variables.prjPjcVarConvLastValidationFindings),\n    prjPjcVarConvLastTransactionCandidates: valueOrDefault($context.$variables.prjPjcVarConvLastTransactionCandidates, []),\n    prjPjcVarConvCurrentTransactionCandidates: valueOrDefault($context.$variables.prjPjcVarConvCurrentTransactionCandidates, ''),\n    prjPjcVarConvCurrentTransactionsCount: valueOrDefault($context.$variables.prjPjcVarConvCurrentTransactionsCount, ''),\n    prjPjcVarConvAwaitingValidationConfirmation: asBoolean($context.$variables.prjPjcVarConvAwaitingValidationConfirmation, false),\n    prjPjcVarPresentationTarget: valueOrDefault($context.$variables.prjPjcVarPresentationTarget, '')\n  };\n}\n\nfunction mergeContextDetails(baseContextDetails, workflowSessionState) {\n  var output = asObject(baseContextDetails);\n  output.workflowSessionState = workflowSessionState;\n  return output;\n}\n\nfunction buildAtomicAgentContext(routeOutput, infoCategory, routingPayload, workflowSessionState) {\n  var request = asObject(routeOutput && routeOutput.request);\n  var requestType = normalizeString(request.requestType).toUpperCase();\n  var target = asObject(request.target);\n  var targetKind = normalizeString(target.kind).toUpperCase();\n  var branch = normalizeString(routeOutput && routeOutput.branch).toUpperCase();\n  var missingInfo = asArray(routeOutput && routeOutput.missingInfo);\n  var payloadText = stripHtml(routingPayload).toLowerCase();\n  var selectionRequired = asBoolean(workflowSessionState.prjPjcVarConvIsSelectionRequired, false);\n  var matchedProjects = asArray(workflowSessionState.prjPjcVarConvMatchedProjects);\n  var normalizedInfoCategory = normalizeString(infoCategory).toUpperCase();\n  var hasProjectMissing = hasMissing(missingInfo, ['projectNameOrNumberRequired', 'projectRequired']);\n  var hasTaskMissing = hasMissing(missingInfo, ['taskIdentifierRequired', 'taskRequired']);\n  var isAssetInfo = requestType === 'ADDITIONAL_INFO_LOOKUP' && normalizedInfoCategory === 'ASSET';\n\n  if (branch === 'OFF_TOPIC_OR_UNSAFE') {\n    return 'User request is outside the supported scope of the capitalization assistant.';\n  }\n\n  if (includesText(payloadText, 'temporary service, access, or environment issue')) {\n    return 'User request could not be completed because of a temporary service, access, or environment issue.';\n  }\n\n  if (isAssetInfo) {\n    if (includesText(payloadText, 'no matching asset details were found')) {\n      return 'User requested asset details in the capitalization flow, but no matching asset details were found.';\n    }\n    if (hasProjectMissing || includesText(payloadText, 'project identifier is missing')) {\n      return 'User requests asset details in the capitalization flow, but the project identifier is missing.';\n    }\n    if (includesText(payloadText, 'asset identifier is missing') || includesText(payloadText, 'asset name is missing') || includesText(payloadText, 'asset number is missing')) {\n      return 'User requests asset details in the capitalization flow, but the asset identifier is missing.';\n    }\n    if (includesText(payloadText, 'required asset query details are missing')) {\n      return 'User requests asset details in the capitalization flow, but required asset query details are missing.';\n    }\n    return 'User is requesting additional capitalization-related information for an asset.';\n  }\n\n  if (requestType === 'DOMAIN_QA' || branch === 'DOMAIN_QA') {\n    return 'User is asking for capitalization business guidance.';\n  }\n\n  if (selectionRequired && matchedProjects.length > 1 && isPendingCostRequest(requestType)) {\n    return 'User requests pending capitalization costs for a project, but multiple matching projects were found and project selection is required.';\n  }\n\n  if (includesText(payloadText, 'no matching project was found')) {\n    return 'User requests pending capitalization costs for a project, but no matching project was found.';\n  }\n\n  if (requestType === 'VALIDATION_RUN' && (includesText(payloadText, 'transaction numbers') || includesText(payloadText, 'up to 50 transaction') || hasMissing(missingInfo, ['transactionNumbersRequired', 'transactionSetRequired']))) {\n    return 'User requests capitalization validation, but transaction numbers are missing.';\n  }\n\n  if (hasProjectMissing) {\n    if (isPendingCostRequest(requestType)) {\n      return 'User requests pending capitalization costs for a project, but the project identifier is missing.';\n    }\n    return 'User request is in the capitalization flow, but the project identifier is missing.';\n  }\n\n  if (hasTaskMissing && isPendingCostRequest(requestType)) {\n    return 'User requests pending capitalization costs for a project, but the task identifier is missing.';\n  }\n\n  if (requestType === 'VALIDATION_INSPECTION') {\n    if (targetKind === 'ISSUE_GROUP') {\n      return 'User is reviewing details for a capitalization validation issue group.';\n    }\n    return 'User is reviewing capitalization validation findings for a project.';\n  }\n\n  if (requestType === 'VALIDATION_RUN') {\n    return 'User is validating capitalization for selected transactions.';\n  }\n\n  if (requestType === 'PENDING_COST_GROUP_SUMMARY') {\n    if (includesText(payloadText, 'no pending capitalization costs were found')) {\n      return 'User requested pending capitalization costs for a project, and no pending capitalization costs were found.';\n    }\n    return 'User is viewing pending capitalization costs grouped by transaction source for a project.';\n  }\n\n  if (requestType === 'PENDING_COST_FILTERED_LIST') {\n    return 'User is viewing filtered pending capitalization costs for a project.';\n  }\n\n  if (requestType === 'PENDING_COST_LIST') {\n    return 'User is viewing pending capitalization cost details for a project.';\n  }\n\n  if (requestType === 'ADDITIONAL_INFO_LOOKUP') {\n    return 'User is requesting additional capitalization-related information for a supported entity.';\n  }\n\n  if (branch === 'MISSING_INFO') {\n    return 'User request is understood in the capitalization flow, but clarification is required before proceeding.';\n  }\n\n  return 'User request is within the capitalization flow and has been handled by the Project Capitalization Analyst.';\n}\n\nvar redwoodPayload = parseJsonSafe($context.$nodes.BUILD_REDWOOD_UI_RESPONSE.$output.result, null);\nvar routeOutput = parseJsonSafe($context.$nodes.ROUTE_USER_INTENT.$output, {});\nvar requestParams = parseJsonSafe($context.$nodes.EXTRACT_REQUEST_PARAMS.$output.result, null);\nvar infoCategory = ($context.$nodes.ROUTE_ASSET_INFO && $context.$nodes.ROUTE_ASSET_INFO.$output) ? $context.$nodes.ROUTE_ASSET_INFO.$output.category : null;\nvar assetDetails = ($context.$nodes.EXTRACT_ASSET_DETAILS && $context.$nodes.EXTRACT_ASSET_DETAILS.$output) ? $context.$nodes.EXTRACT_ASSET_DETAILS.$output.extractedDetails : null;\nvar routingPayload = valueOrDefault($context.$variables.prjPjcVarConvRoutingResponsePayload, '');\nvar workflowSessionState = buildWorkflowSessionState();\nvar atomicAgentContext = buildAtomicAgentContext(routeOutput, infoCategory, routingPayload, workflowSessionState);\nworkflowSessionState.prjPjcVarConvAtomicAgentContext = atomicAgentContext;\n\nvar atomicAgentDetails = {\n  atomicAgentCode: 'ORA_PRJ_PJC_PROJECT_CAPITALIZATION_ANALYST_TEAM',\n  atomicAgentContext: atomicAgentContext,\n  contextDetails: mergeContextDetails(infoCategory === 'ASSET' && assetDetails && typeof assetDetails === 'object' && Object.keys(assetDetails).length > 0 ? assetDetails : null, workflowSessionState),\n  filters: normalizeFilters(requestParams, routeOutput)\n};\n\nvar responseEnvelope = asObject(redwoodPayload);\nresponseEnvelope.atomicAgentDetails = atomicAgentDetails;\n\nreturn JSON.stringify(responseEnvelope);"
          },
