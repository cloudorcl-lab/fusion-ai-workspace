            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === 'string') {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n  if (typeof value !== 'string') {\n    return String(value).trim();\n  }\n  var normalized = value.trim();\n  try {\n    var parsed = JSON.parse(normalized);\n    if (typeof parsed === 'string') {\n      normalized = parsed.trim();\n    }\n  } catch (e) {}\n  return normalized;\n}\n\nfunction asObject(value, fallback) {\n  var parsed = parseJsonSafe(value, null);\n  if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {\n    return parsed;\n  }\n  return fallback;\n}\n\nfunction asArray(value, fallback) {\n  var parsed = parseJsonSafe(value, null);\n  if (Array.isArray(parsed)) {\n    return parsed;\n  }\n  return fallback;\n}\n\nfunction asBoolean(value, fallback) {\n  if (typeof value === 'boolean') {\n    return value;\n  }\n  if (typeof value === 'string') {\n    var normalized = normalizeString(value).toLowerCase();\n    if (normalized === 'true') return true;\n    if (normalized === 'false') return false;\n    try {\n      var parsed = JSON.parse(value);\n      if (typeof parsed === 'boolean') {\n        return parsed;\n      }\n    } catch (e) {}\n  }\n  return fallback;\n}\n\nfunction valueOrDefault(value, fallback) {\n  if (value === null || value === undefined || value === '') {\n    return fallback;\n  }\n  return parseJsonSafe(value, value);\n}\n\nvar triggerInput = ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && typeof $context.$triggers.REST.$input === 'object')\n  ? $context.$triggers.REST.$input\n  : {};\nvar routingContext = normalizeString(triggerInput.prjPjcRoutingContext || $context.$variables.prjPjcVarConvRoutingContext);\nvar isRedwoodUI = routingContext.toLowerCase() === 'redwoodui';\nvar activeAtomicAgentDetails = asObject(triggerInput.prjPjcAtomicAgentRelevantInfo, {});\nvar contextDetails = asObject(activeAtomicAgentDetails.contextDetails, {});\nvar workflowSessionState = asObject(contextDetails.workflowSessionState, {});\n\nreturn {\n  isRedwoodUI: isRedwoodUI,\n  routingContext: routingContext,\n  prjPjcVarConvCurrentProjectDetails: asObject(workflowSessionState.prjPjcVarConvCurrentProjectDetails, asObject($context.$variables.prjPjcVarConvCurrentProjectDetails, {})),\n  prjPjcVarConvIsSelectionRequired: asBoolean(workflowSessionState.prjPjcVarConvIsSelectionRequired, asBoolean($context.$variables.prjPjcVarConvIsSelectionRequired, false)),\n  prjPjcVarConvMatchedProjects: asArray(workflowSessionState.prjPjcVarConvMatchedProjects, asArray($context.$variables.prjPjcVarConvMatchedProjects, [])),\n  prjPjcVarConvSessionData: asObject(workflowSessionState.prjPjcVarConvSessionData, asObject($context.$variables.prjPjcVarConvSessionData, {})),\n  prjPjcVarConvPreviousFilter: asObject(workflowSessionState.prjPjcVarConvPreviousFilter, asObject($context.$variables.prjPjcVarConvPreviousFilter, {})),\n  prjPjcVarConvLastProjectContext: normalizeString(workflowSessionState.prjPjcVarConvLastProjectContext || $context.$variables.prjPjcVarConvLastProjectContext),\n  prjPjcVarConvLatestTransactionSummary: asArray(workflowSessionState.prjPjcVarConvLatestTransactionSummary, asArray($context.$variables.prjPjcVarConvLatestTransactionSummary, [])),\n  prjPjcVarConvLastTransactionSummaryCount: valueOrDefault(workflowSessionState.prjPjcVarConvLastTransactionSummaryCount, valueOrDefault($context.$variables.prjPjcVarConvLastTransactionSummaryCount, '')),\n  prjPjcVarConvLatestValidationSummary: asObject(workflowSessionState.prjPjcVarConvLatestValidationSummary, asObject($context.$variables.prjPjcVarConvLatestValidationSummary, {})),\n  prjPjcVarConvLastDataBlock: asObject(workflowSessionState.prjPjcVa