        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Extract Request Params",
            "returnType": "object",
            "sourceCode": "const input = $context.$nodes.ROUTE_USER_INTENT.$output.request\n\nconst requestParams = {\n  groupBy: input.presentation?.groupBy || \"\",\n  filters: {}\n};\n\nfunction parseJsonSafe(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeText(value) {\n  if (value === null || value === undefined) return \"\";\n  return String(value).trim();\n}\n\nfunction setFilter(key, value) {\n  const normalizedValue = normalizeText(value);\n  if (!normalizedValue) return;\n\n  if (key === \"taskInput\" || key === \"taskName\" || key === \"taskNumber\") {\n    requestParams.filters.taskInput = normalizedValue;\n    delete requestParams.filters.taskName;\n    delete requestParams.filters.taskNumber;\n    return;\n  }\n\n  requestParams.filters[key] = value;\n}\n\nfunction extractSelectedRowNumber() {\n  const message = normalizeText($context.$variables.prjPjcVarNormalizedInputMessage).toLowerCase();\n  const match = message.match(/\\brow\\s*(\\d{1,3})\\b/) || message.match(/^\\s*(\\d{1,3})\\s*$/);\n  return match ? Number(match[1]) : null;\n}\n\nfunction isFollowUpRequest() {\n  const resolutionSource = normalizeText(input.resolution?.source);\n  const message = normalizeText($context.$variables.prjPjcVarNormalizedInputMessage);\n\n  return (\n    input.resolution?.mode === \"followUp\" ||\n    resolutionSource === \"transactionSummaryRow\" ||\n    /row\\s*\\d{1,3}/i.test(message)\n  );\n}\n\nfunction getPreviousActiveProject() {\n  return parseJsonSafe($context.$variables.prjPjcVarConvCurrentProjectDetails, {});\n}\n\nfunction currentProjectInput() {\n  return normalizeText(input.scope?.projectInput);\n}\n\nfunction sameProjectForPreviousFilters() {\n  const previousProject = getPreviousActiveProject();\n\n  const previousProjectNumber = normalizeText(previousProject.projectNumber).toLowerCase();\n  const previousProjectName = normalizeText(previousProject.projectName).toLowerCase();\n  const current = currentProjectInput().toLowerCase();\n\n  if (!current) return true;\n  if (!previousProjectNumber && !previousProjectName) return false;\n\n  return current === previousProjectNumber || current === previousProjectName;\n}\n\nfunction applyPreviousFiltersIfFollowUp() {\n  if (!isFollowUpRequest()) return;\n  if (!sameProjectForPreviousFilters()) return;\n\n  const previousFilter = parseJsonSafe($context.$variables.prjPjcVarConvPreviousFilter, {});\n  if (!previousFilter || typeof previousFilter !== \"object\" || Array.isArray(previousFilter)) return;\n\n  const previousFilters =\n    previousFilter.filters && typeof previousFilter.filters === \"object\" && !Array.isArray(previousFilter.filters)\n      ? previousFilter.filters\n      : previousFilter;\n\n  if (!previousFilters || typeof previousFilters !== \"object\" || Array.isArray(previousFilters)) return;\n\n  for (const key in previousFilters) {\n    if (\n      key === \"projectInput\" ||\n      key === \"projectNumber\" ||\n      key === \"projectName\" ||\n      key === \"scope\"\n    ) {\n      continue;\n    }\n\n    const value = previousFilters[key];\n    if (value !== null && value !== undefined && value !== \"\") {\n      setFilter(key, value);\n    }\n  }\n}\n\nfunction applySummaryRowScope() {\n  const resolutionSource = normalizeText(input.resolution?.source);\n  const isSummaryRowFollowUp =\n    resolutionSource === \"transactionSummaryRow\" ||\n    /row\\s*\\d{1,3}/i.test(normalizeText($context.$variables.prjPjcVarNormalizedInputMessage));\n\n  if (!isSummaryRowFollowUp) return;\n\n  const rowNumber = extractSelectedRowNumber();\n  if (!Number.isFinite(rowNumber) || rowNumber <= 0) return;\n\n  const summary = parseJsonSafe($context.$variables.prjPjcVarConvLatestTransactionSummary, []);\n  const rows = Array.isArray(summary) ? summary : [];\n  const row = rows[rowNumber - 1];\n\n  if (!row || typeof row !== \"object\" || Array.isArray(row)) return;\n\n  const scopedFields = [\n    \"transactionSource\",\n    \"taskInput\",\n    \"taskNumber\",\n    \"taskName\",\n    \"projectCostTypeName\",\n    \"expenditureType\",\n    \"businessUnitName\"\n  ];\n\n  for (const field of scopedFields) {\n    const value = normalizeText(row[field]);\n    if (value) {\n      setFilter(field, value);\n      if (field === \"taskInput\" || field === \"taskNumber\" || field === \"taskName\") {\n        continue;\n      }\n    }\n  }\n}\n\napplyPreviousFiltersIfFollowUp();\n\nif (input.scope?.taskInput !== null && input.scope?.taskInput !== undefined) {\n  setFilter(\"taskInput\", input.scope.taskInput);\n}\n\nfor (const key in input.filters) {\n  const value = input.filters[key];\n\n  if (key === \"additionalFilters\" && value && typeof value === \"object\") {\n    for (const innerKey in value) {\n      if (value[innerKey] !== null && value[innerKey] !== undefined) {\n        setFilter(innerKey, value[innerKey]);\n      }\n    }\n  } else if (value !== null && value !== undefined) {\n    setFilter(key, value);\n  }\n}\n\napplySummaryRowScope();\n\nreturn requestParams;"
          },
          "outcomes": {
            "success": "1772730603875"
          },
