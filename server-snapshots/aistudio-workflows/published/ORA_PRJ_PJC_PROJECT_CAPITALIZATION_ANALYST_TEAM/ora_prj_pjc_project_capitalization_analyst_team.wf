        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Format Chat History",
            "returnType": "array",
            "sourceCode": "function parseJsonSafe(value, fallback) {\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return fallback;\n    }\n  }\n  return value === null || value === undefined ? fallback : value;\n}\n\nfunction normalizeString(value) {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return String(value).trim();\n}\n\nfunction firstNonEmptyString(values) {\n  for (let i = 0; i < values.length; i++) {\n    const value = normalizeString(values[i]);\n    if (value) {\n      return value;\n    }\n  }\n  return \"\";\n}\n\nconst triggerInput =\n  $context.$triggers &&\n  $context.$triggers.REST &&\n  $context.$triggers.REST.$input &&\n  typeof $context.$triggers.REST.$input === \"object\"\n    ? $context.$triggers.REST.$input\n    : {};\n\nconst parsedInputMessage = parseJsonSafe($context.$system.$inputMessage, null);\nconst envelope = parsedInputMessage && typeof parsedInputMessage === \"object\" && !Array.isArray(parsedInputMessage)\n  ? parsedInputMessage\n  : {};\n\nconst routingContext = firstNonEmptyString([\n  triggerInput.prjPjcRoutingContext,\n  envelope.prjPjcRoutingContext\n]);\nconst isRedwoodUI = routingContext.toLowerCase() === \"redwoodui\";\n\nconst chatHistory = isRedwoodUI\n  ? firstNonEmptyString([\n      triggerInput.prjPjcChatHistory,\n      envelope.prjPjcChatHistory,\n      $context.$system.$chatHistory\n    ])\n  : $context.$system.$chatHistory;\n\nconst currentUserMessage = isRedwoodUI\n  ? firstNonEmptyString([\n      triggerInput.message,\n      envelope.message,\n      $context.$system.$inputMessage\n    ])\n  : String($context.$system.$inputMessage ?? \"\").trim();\n\nconst existing = isRedwoodUI ? [] : $context.$variables.prjPjcVarFormattedChatHistory;\n\nconst extractMessagesFlexible = (historyStr = \"\") => {\n  const s = String(historyStr ?? \"\");\n  const pattern = /(USER:|AI:)/g;\n  const matches = [...s.matchAll(pattern)];\n\n  return matches.map((match, i) => {\n    const roleToken = match[0];\n    const role = roleToken === \"USER:\" ? \"user\" : \"ai\";\n\n    const start = (match.index ?? 0) + roleToken.length;\n    const end = i + 1 < matches.length ? (matches[i + 1].index ?? s.length) : s.length;\n\n    const message = s\n      .slice(start, end)\n      .replace(/^ /, \"\")\n      .trimEnd();\n\n    return { role, message };\n  });\n};\n\nconst allMessages = extractMessagesFlexible(chatHistory);\n\nlet lastUserContent = null;\nlet lastAiContent = null;\nfor (let i = allMessages.length - 1; i >= 0; i--) {\n  const m = allMessages[i];\n  if (lastUserContent === null && m.role === \"user\") lastUserContent = m.message;\n  if (lastAiContent === null && m.role === \"ai\") lastAiContent = m.message;\n  if (lastUserContent !== null && lastAiContent !== null) break;\n}\n\nconst history = Array.isArray(existing) ? existing.slice() : [];\nfor (let i = 0; i < history.length; i++) {\n  const h = history[i];\n  if (h && h.message !== undefined && h.content === undefined) {\n    history[i] = { role: h.role === \"ai\" ? \"assistant\" : h.role, content: h.message };\n  }\n}\n\nif (lastUserContent !== null) history.push({ role: \"user\", content: lastUserContent });\nif (lastAiContent !== null) history.push({ role: \"assistant\", content: lastAiContent });\n\nif (currentUserMessage) {\n  history.push({ role: \"user\", content: currentUserMessage });\n}\n\nconst seen = new Set();\nconst dedupedReversed = [];\nfor (let i = history.length - 1; i >= 0; i--) {\n  const h = history[i];\n  const key = h.role + \"|\" + String(h.content);\n  if (!seen.has(key)) {\n    seen.add(key);\n    dedupedReversed.push(h);\n  }\n}\nconst deduped = dedupedReversed.reverse();\n\nwhile (deduped.length > 4) deduped.shift();\n\nreturn deduped;"
          },
