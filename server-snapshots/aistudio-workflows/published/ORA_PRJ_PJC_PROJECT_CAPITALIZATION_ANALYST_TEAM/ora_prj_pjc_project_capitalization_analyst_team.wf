        {
          "metadata": {
            "errorNodeId": "1775736275713",
            "name": "Check Transaction Count Threshold",
            "returnType": "string",
            "sourceCode": "const count = Number( $context.$nodes.EXTRACT_TRANSACTION_COUNT.$output.result );\n\nconst result =\n  Number.isNaN(count) ? \"NONE\" :\n  count === 0 ? \"NONE\" :\n  count > 50 ? \"SUMMARY\" :\n  \"DETAILS\";\n\nreturn result;"
