        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_MANUFACTUR_GETMANUFACTURINGORGANIZATIONS",
            "functionName": "getProcessMfgPlants",
            "processJson": true,
            "name": "Get Process Manufacturing Plants For List"
          },
          "outcomes": {
            "success": "1781503459718"
          },
          "code": "GET_ORG_LIST_PROCESS_MFG_PLANTS",
          "id": "1781503459717",
          "inputs": [],
          "outputSpecification": "{}\n",
          "type": "BO_FUNCTION",
          "diagram": {
            "x": 17907.5,
            "y": 6538
          }
        },
        {
          "metadata": {
            "name": "Filter Organization List Results",
            "returnType": "object",
            "sourceCode": "const detect = $context.$nodes.DETECT_ORG_LIST_REQUEST?.$output?.result || {};\nconst listType = detect.listType === \"nonProcess\" ? \"nonProcess\" : \"process\";\nconst boOutput = $context.$nodes.GET_ORG_LIST_PROCESS_MFG_PLANTS?.$output || {};\n\nfunction parseJsonObject(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return null;\n\n  const trimmed = value.trim();\n  if (!trimmed) return null;\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction getItems(value) {\n  if (Array.isArray(value?.items)) return value.items;\n  if (Array.isArray(value?.result?.items)) return value.result.items;\n  if (Array.isArray(value?.output?.items)) return value.output.items;\n\n  const parsed = parseJsonObject(value);\n  if (Array.isArray(parsed?.items)) return parsed.items;\n  if (Array.isArray(parsed?.result?.items)) return parsed.result.items;\n  if (Array.isArray(parsed?.output?.items)) return parsed.output.items;\n\n  const responseObject = parseJsonObject(parsed?.output?.response);\n  if (Array.isArray(responseObject?.items)) return responseObject.items;\n\n  return [];\n}\n\nfunction getPlantParameter(row) {\n  if (Array.isArray(row?.plantParameters)) {\n    return row.plantParameters[0] || null;\n  }\n\n  if (Array.isArray(row?.plantParameters?.items)) {\n    return row.plantParameters.items[0] || null;\n  }\n\n  return null;\n}\n\nconst organizations = getItems(boOutput)\n  .filter(row => {\n    const processEnabled = getPlantParameter(row)?.EnableProcessManufacturingFlag === true;\n    return listType === \"process\" ? processEnabled : !processEnabled;\n  })\n  .map(row => {\n    const processEnabled = getPlantParameter(row)?.EnableProcessManufacturingFlag === true;\n    return {\n      OrganizationCode: row?.OrganizationCode ?? null,\n      OrganizationName: row?.OrganizationName ?? null,\n      OrganizationId: row?.OrganizationId ?? null,\n      ProcessManufacturingEnabled: processEnabled ? \"Yes\" : \"No\"\n    };\n  })\n  .filter(row => row.OrganizationCode || row.OrganizationName || row.OrganizationId)\n  .sort((a, b) => {\n    const aValue = String(a.OrganizationCode || a.OrganizationName || \"\").toUpperCase();\n    const bValue = String(b.OrganizationCode || b.OrganizationName || \"\").toUpperCase();\n    return aValue.localeCompare(bValue);\n  });\n\nreturn {\n  listType,\n  title: listType === \"process\" ? \"Process manufacturing organizations\" : \"Non-process manufacturing organizations\",\n  organizations,\n  organizationCount: organizations.length\n};"
          },
          "outcomes": {
            "success": "1781503459719"
          },
          "code": "FILTER_ORG_LIST_RESULTS",
          "id": "1781503459718",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 17948,
            "y": 6760
          }
