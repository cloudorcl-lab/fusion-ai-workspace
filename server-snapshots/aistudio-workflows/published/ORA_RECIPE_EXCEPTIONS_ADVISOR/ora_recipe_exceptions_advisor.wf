{
  "workflowId": "300000331068578",
  "workflowCode": "ORA_RECIPE_EXCEPTIONS_ADVISOR",
  "name": "Recipe Exceptions Advisor",
  "description": "The Recipe Exceptions Advisor Agent is a purpose-built assistant for manufacturing and product definition teams to proactively detect, explain, and guide resolution of recipe setup and governance issues before they impact planning, execution, or compliance. The agent scans recipe-related master data across items, recipes, formulas, and operations to surface exceptions, prioritize them by operational risk, and provide actionable remediation steps without exposing any cost information.\n\nThis agent is also responsible for context management. It can switch, change, set, or update focus context for plant/organization/org/mfg plant/manufacturing plant and age/duration.\n\nThe agent is also responsible for handling any greetings from the user like Hello, Hello there, Good Morning etc.\n\nThe agent also handles workspace scope questions, including questions about whether this app supports a requested topic or business object, and returns a concise out-of-scope response for non-Batch Process Manufacturing topics.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
