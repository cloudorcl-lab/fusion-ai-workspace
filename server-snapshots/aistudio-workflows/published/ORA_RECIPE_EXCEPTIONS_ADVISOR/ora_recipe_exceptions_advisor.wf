          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW",
          "diagram": {
            "x": 14328.5,
            "y": 5206
          }
        },
        {
          "metadata": {
            "name": "Extract Context",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context?.$nodes?.ESTABLISH_CONTEXT?.$output?.output;\nlet parsed = {};\n\ntry {\n  parsed =\n    typeof rawOutput === \"string\"\n      ? JSON.parse(rawOutput)\n      : rawOutput || {};\n} catch (e) {\n  parsed = {};\n}\n\nconst result = parsed?.result || {};\nconst data = result?.data || {};\n\nconst validProcessManufacturingOrganizations = Array.isArray(data?.validProcessManufacturingOrganizations)\n  ? data.validProcessManufacturingOrganizations\n      .map(org => ({\n        organizationCode: org?.organizationCode ?? org?.OrganizationCode ?? null,\n        organizationName: org?.organizationName ?? org?.OrganizationName ?? null\n      }))\n      .filter(org => org.organizationCode || org.organizationName)\n      .sort((a, b) => {\n        const aValue = String(a.organizationCode || a.organizationName || \"\").toUpperCase();\n        const bValue = String(b.organizationCode || b.organizationName || \"\").toUpperCase();\n        return aValue.localeCompare(bValue);\n      })\n  : [];\n\nreturn {\n  ok: result?.ok ?? false,\n  status: result?.status ?? null,\n  mode: result?.mode ?? null,\n\n  OrganizationId: data?.OrganizationId ?? null,\n  OrganizationCode: data?.OrganizationCode ?? null,\n  OrganizationName: data?.OrganizationName ?? null,\n  Age: data?.Age ?? null,\n  Context: data?.Context ?? null,\n  validProcessManufacturingOrganizations,\n\n  errorCode: result?.errorCode ?? null,\n  errorMessage: result?.errorMessage ?? null\n};\n"
          },
          "outcomes": {
            "success": "1774897126622"
          },
          "code": "EXTRACT_CONTEXT",
