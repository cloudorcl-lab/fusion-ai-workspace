        {
          "metadata": {
            "name": "Detect Organization List Request",
            "returnType": "object",
            "sourceCode": "const inputMessage = String($context?.$system?.$inputMessage ?? \"\").trim();\n\nconst hasListVerb = /\\b(show|display|list|search|find|get|view)\\b/i.test(inputMessage);\nconst hasOrgTerm = /\\b(plant|plants|org|orgs|organization|organizations|mfg\\s*org|mfg\\s*orgs|mfg\\s*plant|mfg\\s*plants|manufacturing\\s*org|manufacturing\\s*orgs|manufacturing\\s*organization|manufacturing\\s*organizations|manufacturing\\s*plant|manufacturing\\s*plants)\\b/i.test(inputMessage);\n\nconst hasNonProcessIntent = /\\b(non[-\\s]*process|not\\s+process|not\\s+process[-\\s]*enabled|not\\s+enabled\\s+for\\s+process|discrete)\\b/i.test(inputMessage);\nconst hasProcessIntent = /\\b(process\\s*(?:manufacturing|mfg)?|process[-\\s]*enabled|process\\s*plants?|process\\s*orgs?|process\\s*organizations?)\\b/i.test(inputMessage);\n\nconst isOrgListRequest = hasListVerb && hasOrgTerm && (hasProcessIntent || hasNonProcessIntent);\nconst listType = isOrgListRequest ? (hasNonProcessIntent ? \"nonProcess\" : \"process\") : null;\n\nreturn {\n  isOrgListRequest,\n  listType\n};"
          },
          "outcomes": {
            "success": "1781503459716"
          },
          "code": "DETECT_ORG_LIST_REQUEST",
          "id": "1781503459715",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 14079.5,
            "y": 6094
