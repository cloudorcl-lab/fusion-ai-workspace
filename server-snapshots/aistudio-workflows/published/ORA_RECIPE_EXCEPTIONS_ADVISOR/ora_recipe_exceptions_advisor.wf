          "inputs": [
            {
              "id": "1781294132843_1",
              "name": "prompt",
              "type": "string",
              "value": "You are summarizing Oracle SCM Process Manufacturing recipe exceptions by type.\n\n     User question:\n     {{$context.$system.$inputMessage}}\n\n     Cleaned recipe exception summary payload:\n     {{$context.$nodes.EXTRACT_RECIPE_EXCEPTION_DATA.$output}} \n\n     Use only the cleaned payload above.\n\n     Data rules:\n     - Read records from items.\n     - For each item, use only ExceptionMessage, ExceptionCode, and ExceptionCount.\n     - Ignore @context, links, href, rel, name, kind, limit, offset, and other REST metadata.\n     - Treat ExceptionCount as a number even if it is provided as a string.\n     - Do not call tools.\n     - Do not invent records, causes, resolutions, statuses, products, recipes, or operational guidance.\n\n     Response rules:\n     - Summarize exceptions by type.\n     - Include each exception type and its count.\n     - Include the total exception count across returned items.\n     - Identify the highest-count exception type when records are present.\n     - If there are no items, say that no recipe exception summary records are available.\n     - Keep the answer concise and business-facing."
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 19832,
            "y": 7870
          }
        },
        {
