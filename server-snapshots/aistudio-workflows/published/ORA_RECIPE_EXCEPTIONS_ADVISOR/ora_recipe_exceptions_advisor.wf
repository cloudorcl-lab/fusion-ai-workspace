                    "sourceCode": "let recipeData = $context.$nodes.LOOP_THROUGH_NOT_ACTIVE_RECIPES.$currentItem;\nlet WorkDefinitionId =$context.$nodes.LOOP_THROUGH_NOT_ACTIVE_RECIPES.GET_DETAILS_FROM_NOT_ACTIVE_RECIPE.$output.items[0].WorkDefinitionId;\n\n\nlet newData = {\n   \"Process\":recipeData.Process,\n   \"WorkDefinitionId\":WorkDefinitionId,\n   \"Recipe\":recipeData.Recipe,\n   \"VersionNumber\":recipeData.VersionNumber,\n   \"StartDate\":recipeData.StartDate,\n   \"Product\":recipeData.Product,\n   \"UserItemType\":recipeData.UserItemType,\n   \"RecipeQuantity\":recipeData.RecipeQuantity,\n   \"VersionStatus\":recipeData.VersionStatus,\n   \"RecipeStatus\":recipeData.RecipeStatus\n};\n\nlet existingItems = $context.$variables.RecipeDetailsArray || [];\n\nexistingItems.push(newData);\n\nreturn existingItems;\n\n",
