        {
          "metadata": {
            "name": "AggregateByBusinessProcess",
            "returnType": "array",
            "sourceCode": "var data = $context.$nodes.GETUSERVIOLATIONDATA.$output;\n\nvar result = null;\nif (data) {\n  var parsedData = data;\n  if (typeof data === 'string') {\n    try {\n      parsedData = JSON.parse(data);\n    } catch (e) {\n      var trimmed = data.trim();\n      if ((trimmed.startsWith('\"') && trimmed.endsWith('\"')) ||\n          (trimmed.startsWith(\"'\") && trimmed.endsWith(\"'\"))) {\n        try {\n          parsedData = JSON.parse(trimmed.slice(1, -1));\n        } catch (e2) {\n          return null;\n        }\n      } else {\n        return null;\n      }\n    }\n  }\n  \n  if (!Array.isArray(parsedData)) {\n    return null;\n  }\n  \n  var algorithmToProcess = {\n    \"Access Requests\": \"Financial Processes\",\n    \"Accounts Payables invoices approved by IT Superusers\": \"Source to Settle\",\n    \"Additions and Deletions to Data Roles\": \"Information Technology\",\n    \"Additions and Deletions to Item Master\": \"Source to Settle\",\n    \"Additions and Deletions to Key Flexfield Cross Validation Rules\": \"Record to Report\",\n    \"Additions and Deletions to Profile Options\": \"Information Technology\",\n    \"Additions and Deletions to Security Profiles\": \"Information Technology\",\n    \"Adjust Project Costs and Maintain Capital Projects\": \"Project Management\",\n    \"Adjust Project Costs and Perform Project Capitalization\": \"Project Management\",\n    \"Application Implementation Consultant Role Events for Users\": \"Information Technology\",\n    \"Approval Workflow Rules for Financials by IT Superusers\": \"Record to Report\",\n    \"Approve Payables Invoices and Create Payables Invoices\": \"Source to Settle\",\n    \"Approve Payables Invoices and Create Payments\": \"Source to Settle\",\n    \"Approved or Posted Journals by IT Superusers\": \"Record to Report\",\n    \"Asset Workbench Created by the Same User Managing Physical Inventory\": \"Record to Report\",\n    \"Associate Customer to Invoicing Partners and Create Joint Venture Accounts Receivable Invoices\": \"Order to Cash\",\n    \"Backdated Purchase Orders\": \"Source to Settle\",\n    \"Bank Account Reconciliation and Create Payables Invoices\": \"Source to Settle\",\n    \"Bank Account Reconciliation and Create Payments\": \"Record to Report\",\n    \"Bank Account Reconciliation and Enter Customer Receipts\": \"Record to Report\",\n    \"Benefits Personal Data\": \"Hire to Retire\",\n    \"Capture Project Expenditures and Release Project Expenditures\": \"Project Management\",\n    \"Changes to Supplier Bank Accounts on a Weekend\": \"Source to Settle\",\n    \"Contract Payment Terms Different than Invoices\": \"Source to Settle\",\n    \"Create Customer and Associate Customer to Invoicing Partners\": \"Order to Cash\",\n    \"Create Customer and Create Sales Order\": \"Order to Cash\",\n    \"Create Customer and Enter Accounts Receivables Invoice\": \"Order to Cash\",\n    \"Create Customer and Enter Customer Receipts\": \"Order to Cash\",\n    \"Create Customer and Release Sales Order\": \"Order to Cash\",\n    \"Create Customer and Remittances\": \"Order to Cash\",\n    \"Create Items and Cycle Counting\": \"Supply Chain Management\",\n    \"Create Items and Inventory Transactions\": \"Source to Settle\",\n    \"Create Payables Invoices and Create Payments\": \"Source to Settle\",\n    \"Create Payables Invoices and Maintain Project Contracts\": \"Source to Settle\",\n    \"Create Payables Invoices and Manage Payables System Option\": \"Source to Settle\",\n    \"Create Payables Invoices and Receive Goods and Services\": \"Source to Settle\",\n    \"Create Payments and Receive Goods and Services\": \"Source to Settle\",\n    \"Create Purchase Orders and Approve Payables Invoices\": \"Source to Settle\",\n    \"Create Purchase Orders and Create Payables Invoices\": \"Source to Settle\",\n    \"Create Purchase Orders and Create Payments\": \"Source to Settle\",\n    \"Create Purchase Orders and Define Procurement Approval Routing Rules\": \"Source to Settle\",\n    \"Create Purchase Orders and Manage Payables System Option\": \"Source to Settle\",\n    \"Create Purchase Orders and Receive Goods and Services\": \"Source to Settle\",\n    \"Create Purchase Orders and Return Goods and Services\": \"Source to Settle\",\n    \"Create Role and Provision Role\": \"Information Technology\",\n    \"Create Suppliers & Manage Payables Invoice Tolerance Set\": \"Source to Settle\",\n    \"Create Suppliers and Approve Payables Invoices\": \"Source to Settle\",\n    \"Create Suppliers and Create Payables Invoices\": \"Source to Settle\",\n    \"Create Suppliers and Create Payments\": \"Source to Settle\",\n    \"Create Suppliers and Create Purchase Agreements\": \"Source to Settle\",\n    \"Create Suppliers and Create Purchase Orders\": \"Source to Settle\",\n    \"Create Suppliers and Maintain Supplier Bank Accounts\": \"Source to Settle\",\n    \"Create Suppliers and Receive Goods and Services\": \"Source to Settle\",\n    \"Create User and Manage Compensation\": \"Hire to Retire\",\n    \"Create User and Manage Payroll\": \"Hire to Retire\",\n    \"Create User and Manage Payroll Batch Processes\": \"Hire to Retire\",\n    \"Create User and Manage Payroll Costing\": \"Hire to Retire\",\n    \"Create User and Manage Time and Labor\": \"Hire to Retire\",\n    \"Created or Updated Customers by IT Superusers\": \"Order to Cash\",\n    \"Created or Updated Employee Job Assignments by IT Superusers\": \"Hire to Retire\",\n    \"Created or Updated Employee Payroll Transactions by IT Superusers\": \"Hire to Retire\",\n    \"Created or Updated Employee Personal Payment Methods by IT Superusers\": \"Hire to Retire\",\n    \"Created or Updated Employee Salary by IT Superusers\": \"Hire to Retire\",\n    \"Created or Updated General Ledger Account Combinations by IT Superusers\": \"Record to Report\",\n    \"Created or Updated General Ledger Options by IT Superusers\": \"Record to Report\",\n    \"Created or Updated Journals by IT Superusers\": \"Record to Report\",\n    \"Created or Updated Payables Invoices by IT Superusers\": \"Source to Settle\",\n    \"Created or Updated Receivables Invoices by IT Superusers\": \"Order to Cash\",\n    \"Created or Updated Receivables Standard Receipts by IT Superusers\": \"Order to Cash\",\n    \"Created or Updated Suppliers by IT Superusers\": \"Source to Settle\",\n    \"Created or updated payables invoices by IT Superusers\": \"Source to Settle\",\n    \"Created or updated payments by IT Superusers\": \"Source to Settle\",\n    \"Custom Roles Not Used\": \"Information Technology\",\n    \"Customers Missing Taxpayer Identification Number\": \"Order to Cash\",\n    \"Customers With No Invoice Activity\": \"Order to Cash\",\n    \"Customers and Receivables Invoices Managed by the Same User\": \"Order to Cash\",\n    \"Cycle Counting and Receive Goods and Services\": \"Supply Chain Management\",\n    \"Delete Receipts and Release Sales Order\": \"Order to Cash\",\n    \"Dormant General Ledger Accounts\": \"Record to Report\",\n    \"Duplicate Expenses Submitted by Different Employees\": \"Source to Settle\",\n    \"Duplicate Expenses Submitted by Employee for Reimbursement\": \"Source to Settle\",\n    \"Duplicate Payables Invoices\": \"Source to Settle\",\n    \"Duplicate Suppliers and Sites\": \"Source to Settle\",\n    \"Enter Journals and Post Journal Entry\": \"Record to Report\",\n    \"Enter Journals and Approve Payables Invoices\": \"Source to Settle\",\n    \"Manage Employee and Manage Payroll\": \"Hire to Retire\",\n    \"Manage Time and Labor and Manage Payroll\": \"Hire to Retire\"\n  };\n  \n  var processToBusinessName = {\n    \"Source to Settle\": \"Accounts Payable\",\n    \"Record to Report\": \"General Ledger\",\n    \"Hire to Retire\": \"Human Resources\",\n    \"Order to Cash\": \"Accounts Receivable\",\n    \"Information Technology\": \"Information Technology\",\n    \"Project Management\": \"Project Management\",\n    \"Supply Chain Management\": \"Inventory Management\",\n    \"Financial Processes\": \"Financial Processes\"\n  };\n  \n  var totalAlgorithmsPerProcess = {\n    \"Source to Settle\": 127,\n    \"Record to Report\": 118,\n    \"Hire to Retire\": 59,\n    \"Order to Cash\": 34,\n    \"Information Technology\": 22,\n    \"Project Management\": 13,\n    \"Supply Chain Management\": 12,\n    \"Financial Processes\": 2\n  };\n  \n  var violationsByProcess = {};\n  var violatedAlgorithmsByProcess = {};\n  \n  for (var i = 0; i < parsedData.length; i++) {\n    var item = parsedData[i];\n    var controlName = item.ControlName || '';\n    var algorithmName = controlName.replace(/^\\d+:\\s*/, '');\n    var processL2 = algorithmToProcess[algorithmName] || 'Other';\n    var numIncidents = item.NumIncidents || 1;\n    \n    if (!violationsByProcess[processL2]) {\n      violationsByProcess[processL2] = 0;\n      violatedAlgorithmsByProcess[processL2] = {};\n    }\n    violationsByProcess[processL2] += numIncidents;\n    violatedAlgorithmsByProcess[processL2][algorithmName] = true;\n  }\n  \n  result = [];\n  for (var proc in totalAlgorithmsPerProcess) {\n    var totalAlgs = totalAlgorithmsPerProcess[proc];\n    var violatedAlgsCount = violatedAlgorithmsByProcess[proc] ? Object.keys(violatedAlgorithmsByProcess[proc]).length : 0;\n    var numViolations = violationsByProcess[proc] || 0;\n    var compliancePercent = Math.round(((totalAlgs - violatedAlgsCount) / totalAlgs) * 100);\n    \n    result.push({\n      BusinessProcess: processToBusinessName[proc] || proc,\n      ProcessL2: proc,\n      NumViolations: numViolations,\n      ViolatedAlgorithms: violatedAlgsCount,\n      TotalAlgorithms: totalAlgs,\n      CompliancePercent: compliancePercent\n    });\n  }\n  \n  result.sort(function(a, b) { return b.NumViolations - a.NumViolations; });\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765991888105"
          },
          "code": "AGGREGATEBYBUSINESSPROCESS",
          "id": "1765506012867",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
