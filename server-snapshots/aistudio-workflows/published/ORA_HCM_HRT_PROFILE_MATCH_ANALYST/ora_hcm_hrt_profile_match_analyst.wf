{
  "workflowId": "300000331062506",
  "workflowCode": "ORA_HCM_HRT_PROFILE_MATCH_ANALYST",
  "name": "Profile Match Analyst",
  "description": "Evaluates how well an employee's talent profile aligns with a career role. This assistant compares the skills, competencies, and experience of the employee against those required for the role and identifies specific gaps. It also estimates the effort needed to close them and recommends targeted actions to improve fit and role readiness.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
