            {
              "id": "1764792002318_1",
              "name": "pWaveNumber",
              "type": "string",
              "value": "{{$context.$nodes.SET_INITIAL_VARIABLES.$input.WaveNumber}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_count\": {\n      \"type\": \"integer\"\n    },\n    \"page_nbr\": {\n      \"type\": \"integer\"\n    },\n    \"next_page\": {\n      \"type\": \"null\"\n    },\n    \"previous_page\": {\n      \"type\": \"null\"\n    },\n    \"results\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"title\": \"Wave Object\",\n        \"type\": \"object\",\n        \"properties\": {\n          \"id\": {\n            \"type\": \"integer\",\n            \"description\": \"Internal Wave ID identifier.\"\n          },\n          \"cubing_rule_id\": {\n            \"type\": [\"integer\", \"null\"],\n            \"description\": \"The ID of the cubing rule applied (nullable).\"\n          },\n          \"cubing_mode_id\": {\n            \"type\": [\"integer\", \"null\"],\n            \"description\": \"The ID of the cubing mode applied (nullable).\"\n          }\n        },\n        \"required\": [\"id\"]\n      }\n    }\n  },\n  \"required\": [\n    \"result_count\",\n    \"page_count\",\n    \"page_nbr\",\n    \"next_page\",\n    \"previous_page\",\n    \"results\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
