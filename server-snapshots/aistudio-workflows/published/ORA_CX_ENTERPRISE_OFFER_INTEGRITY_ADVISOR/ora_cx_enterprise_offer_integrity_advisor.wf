{
  "workflowId": "100002355226878",
  "workflowCode": "ORA_CX_ENTERPRISE_OFFER_INTEGRITY_ADVISOR",
  "name": "Offer Integrity Analyst",
  "description": "Advise user about integrity of a Product offering when given the required details.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1763997206396"
          },
          "code": "START",
          "id": "start",
