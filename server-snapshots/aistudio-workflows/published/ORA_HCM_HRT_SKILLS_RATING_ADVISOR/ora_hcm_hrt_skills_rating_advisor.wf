          },
          "code": "ASSESSMENTGENERATOR",
          "id": "1770392388098",
          "inputs": [
            {
              "id": "1770392388099_1",
              "name": "prompt",
              "type": "string",
              "value": "{\n  \"task\": \"Generate a 12-question multiple-choice assessment for the specified skill. Questions must test applied knowledge and practical decision-making in realistic workplace scenarios, moving beyond rote memorization.\",\n  \"inputs\": {\n    \"skill\": \"{{$context.$triggers.REST.$input.skill}}\",\n    \"company\": \"{{$context.$triggers.REST.$input.company}}\",\n    \"rating_model\": \"{{$context.$triggers.REST.$input.ratingModel}}\"\n  },\n  \"instructions\": {\n    \"req_1_scenario_based_application\": \"Frame each question around a realistic workplace scenario or problem. The test-taker must apply their domain expertise and best practices to resolve the scenario. Avoid simple trivia or dictionary-definition questions.\",\n    \"req_2_skill_boundary\": \"Maintain strict boundaries around the target 'skill'. Do not drift into related but distinct fields. For example, if testing 'Sales Strategy', do not ask questions about 'Product Marketing'; if testing 'Financial Accounting', do not assess 'Tax Law'.\",\n    \"req_3_objective_correctness\": \"There must be exactly one unambiguously correct answer. The correct answer must be rooted in established industry standards, verifiable facts, or logical best practices for that specific skill.\",\n    \"req_4_plausible_distractors\": \"Incorrect options (distractors) must be highly plausible. They should represent common novice mistakes, outdated practices, or actions that sound reasonable but are technically incorrect or sub-optimal in the given scenario. Do not use silly or obvious throwaway options.\",\n    \"req_5_no_self_reference\": \"Do NOT use self-referential options like 'All of the above', 'None of the above', 'Option A', or 'Both B and C'. Each option must be a standalone, complete, and independent statement.\",\n    \"req_6_progressive_difficulty\": \"Distribute the 12 questions across the proficiency levels provided in the rating_model. Early questions should test foundational concepts; later questions should test complex troubleshooting, edge cases, and advanced strategic decision-making.\",\n    \"req_7_silent_distribution_and_randomization\": \"You MUST perfectly distribute the correct answers across the 4 positions (exactly 3 times each). CRITICAL: The sequence of answers MUST be highly randomized. Do not use repeating sequences or predictable loops (e.g., 1, 2, 3, 4, 1, 2...). Never use the same position more than twice in a row. Silently calculate this randomized map in your reasoning phase before generating the JSON.\",\n    \"req_8_clarity_and_conciseness\": \"Keep scenarios clear and direct. Provide enough context to make the situation realistic, but avoid unnecessary fluff or excessively long reading passages.\",\n    \"req_9_strict_json_format\": \"Return ONLY a valid, raw JSON object matching the exact structure below. You MUST generate exactly 12 questions; do not stop early. Do not use markdown formatting, do not include conversational filler, and ensure all text is end-user ready.\",\n    \"req_10_exact_string_match\": \"CRITICAL: The string inside the 'correct_answers' array MUST be an exact, character-for-character copy of one of the strings in the 'answer_choices' array. Do not alter capitalization, punctuation, or spacing.\",\n    \"output_format\": {\n      \"survey_title\": \"Assessment for {skill}\",\n      \"survey_instructions\": \"Read each workplace scenario carefully and select the single best approach based on standard industry practices.\",\n      \"number_of_questions\": 12,\n      \"questions\": [\n        {\n          \"question\": \"<The scenario and the specific question being asked>\",\n          \"answer_type\": \"single_choice\",\n          \"answer_choices\": [\n            \"<Option 1>\",\n            \"<Option 2>\",\n            \"<Option 3>\",\n            \"<Option 4>\"\n          ],\n          \"correct_answers\": [\n            \"<Exact text of the correct option>\"\n          ]\n        }\n      ]\n    }\n  }\n}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"required\": [\"id\", \"choices\"],\n  \"properties\": {\n    \"id\": {\n      \"type\": \"string\",\n      \"format\": \"uuid\",\n      \"description\": \"Unique identifier for the response.\"\n    },\n    \"choices\": {\n      \"type\": \"array\",\n      \"minItems\": 1,\n      \"maxItems\": 1,\n      \"description\": \"Always contains exactly one choice.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"index\", \"text\"],\n        \"properties\": {\n          \"index\": {\n            \"type\": \"integer\",\n            \"const\": 0,\n            \"description\": \"Always 0.\"\n          },\n          \"text\": {\n            \"type\": \"string\",\n            \"description\": \"Returned text content.\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        }
      ],
