        {
          "metadata": {
            "name": "extractOptyNumbers",
            "returnType": "array",
            "sourceCode": "let response = $context.$nodes.GET_OPPORTUNITIES_TO_PROCESS.$output;\nlet items = response?.items?.map(item => ({\n  id: item.opportunity?.id, \n  puid: item.opportunity?.optyNumber,  \n  insightId: item.id, \n  insightNumber: item.engagementInsightNumber\n})) || [];\n\n// Chunk the array into arrays of max length 50\nconst chunkSize = 50;\nconst chunked = [];\nfor (let i = 0; i < items.length; i += chunkSize) {\n  chunked.push(items.slice(i, i + chunkSize));\n}\nreturn chunked;"
          },
          "outcomes": {
            "success": "1769821411869"
          },
          "code": "EXTRACTOPTYNUMBERS",
          "id": "1764724024844",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
