          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_CREATEANNOUNCEMENT",
            "functionName": "getall_announcements",
            "processJson": true,
            "name": "Get all announcements"
          },
          "outcomes": {
            "success": "1769461537123"
          },
          "code": "GET_ALL_ANNOUNCEMENTS",
          "id": "1769461481565",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Find missing announcements",
            "returnType": "array",
            "sourceCode": "// ------------------------------------------------------------                                                                  \n  // CODE node: Identify missing required announcements                                                                            \n  // ------------------------------------------------------------                                                                  \n                                                                                                                                   \n  const requiredAnnouncements = [                                                                                                  \n    { id: \"894871897531002\", name: \"Intra-role Access Violations\" },                                                                          \n    { id: \"894871897531003\", name: \"User Access Violations\" },                                                                                \n    { id: \"894871897531004\", name: \"Business Process Compliance\" },                                                                           \n    { id: \"894871897531007\", name: \"Transaction Activity (Correlated Risk)\" },                                                                \n    { id: \"894871897531011\", name: \"Intra-role Violation Recommendations\" }                                                                   \n  ];                                                                                                                               \n                                                                                                                                   \n  const apiResponse = $context.$nodes.GET_ALL_ANNOUNCEMENTS.$output;                                                               \n                                                                                                                                   \n  let missingAnnouncements = [];                                                                                                   \n                                                                                                                                   \n  if (apiResponse && Array.isArray(apiResponse.items)) {                                                                           \n    const existingIds = new Set();                                                                                                 \n    apiResponse.items.forEach((item) => {                                                                                          \n      if (item && item.AnnouncementId) {                                                                                           \n        existingIds.add(String(item.AnnouncementId).trim());                                                                       \n      }                                                                                                                            \n    });                                                                                                                            \n                                                                                                                                   \n    missingAnnouncements = requiredAnnouncements                                                                                   \n      .filter((req) => !existingIds.has(req.id))                                                                                   \n      .map((req) => ({                                                                                                             \n        AnnouncementId: req.id,                                                                                                    \n        Subject: req.name                                                                                                          \n      }));                                                                                                                         \n  }                                                                                                                                \n                                                                                                                                   \n  return missingAnnouncements;"
          },
          "outcomes": {
            "success": "1769462945462"
          },
          "code": "FIND_MISSING_ANNOUNCEMENTS",
          "id": "1769461537123",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
