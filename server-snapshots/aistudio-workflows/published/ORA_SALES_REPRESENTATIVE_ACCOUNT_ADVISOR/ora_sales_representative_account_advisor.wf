          "id": "1774828687397",
          "code": "GET_ACCOUNTS",
          "type": "BO_FUNCTION",
          "inputs": [
            {
              "id": "1774828687397_object",
              "name": "object",
              "value": "Account",
              "required": false,
              "type": "string"
            },
            {
              "id": "1774828687397_q",
              "name": "q",
              "value": "{\"op\": \"$and\",\"criteria\": [{\"op\": \"$eq\",\"attribute\": \"PartyRecordSet\",\"value\": \"MYSALESTEAMTERRACCTS\"}]}",
              "required": false,
              "type": "string"
            },
            {
              "id": "1774828687397_sort",
              "name": "sort",
              "value": "[{\"attribute\": \"AccountRollup.LastCompletedActivity\",\"direction\": \"descending\"}]",
              "required": false,
              "type": "string"
            },
            {
              "id": "1774828687397_limit",
              "name": "limit",
              "value": "25",
              "required": false,
              "type": "integer"
            },
            {
              "id": "1774828687397_fields",
              "name": "fields",
              "value": "[\"PartyId\",\"PartyNumber\",\"PartyUniqueName\",\"AccountRollup\"]",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "id": "1779817977133",
          "code": "BUILD_PAYLOAD_FOR_INSIGHTS",
          "type": "CODE",
          "metadata": {
            "name": "Build Payload for Insights",
            "sourceCode": "let result = {};\ntry {\n  // Access the array of rows safely\n  const rows = $context.$nodes?.GET_ACCOUNTS?.$output || [];\n\n  // Extract PartyNumber from each row, filtering out null/undefined\n  const objectAltKeys = rows\n    .map(row => row.PartyNumber)\n    .filter(partyNumber => partyNumber !== undefined && partyNumber !== null);\n\n  // Build standardParameters as JSON string\n  const standardParameters = JSON.stringify({\n    objectType: \"ACCOUNT\",\n    objectAltKeys: objectAltKeys\n  });\n\n  // Build optionalParameters string as specified\n  const optionalParameters = \"outcomeType IN('SUMMARY', 'INSIGHT') and outcomeReferences[primaryRef='Y']\";\n\n  result = {\n    standardParameters: standardParameters,\n    optionalParameters: optionalParameters\n  };\n} catch (error) {\n  // Fallback empty object on error\n  result = {\n    standardParameters: JSON.stringify({ objectType: \"ACCOUNT\", objectAltKeys: [] }),\n    optionalParameters: \"outcomeType IN('SUMMARY', 'INSIGHT') and outcomeReferences[primaryRef='Y']\"\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5225,
            "y": 5650
          },
          "outcomes": {
            "success": "1779818182232"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1779818182232",
          "code": "GET_INSIGHTS_AND_SUMMARY",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Insights and Summary",
            "businessObjectCode": "ORA_CX_SALESFORCE_AIOUTCOMESTORE",
            "functionName": "getOutcomes"
          },
          "diagram": {
            "x": 5225,
            "y": 5872
          },
          "outcomes": {
            "success": "1779818634632"
          },
          "inputs": [
            {
              "id": "1779818182232_Outcome_Standard_Parameters",
              "name": "Outcome_Standard_Parameters",
              "value": "{{$context.$nodes.BUILD_PAYLOAD_FOR_INSIGHTS.$output.result.standardParameters}}",
              "required": false,
              "type": "string"
            },
            {
              "id": "1779818182232_Outcome_Optional_Parameters",
              "name": "Outcome_Optional_Parameters",
              "value": "{{$context.$nodes.BUILD_PAYLOAD_FOR_INSIGHTS.$output.result.optionalParameters}}",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "id": "1779818634632",
          "code": "COMBINE_ACCOUNTS_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Combine Accounts Data",
            "sourceCode": "let result = [];\n\ntry {\n  const accounts = Array.isArray($context.$nodes?.GET_ACCOUNTS?.$output)\n    ? $context.$nodes.GET_ACCOUNTS.$output\n    : [];\n\n  const insightsOutput = $context.$nodes?.GET_INSIGHTS_AND_SUMMARY?.$output;\n  const insightsAndSummary = Array.isArray(insightsOutput)\n    ? insightsOutput\n    : Array.isArray(insightsOutput?.items)\n      ? insightsOutput.items\n      : [];\n\n  const insightsMap = new Map();\n  const summaryMap = new Map();\n\n  for (const item of insightsAndSummary) {\n    const key = String(item?.primaryObjectAltKey || \"\").trim();\n    const outcomeType = String(item?.outcomeType || \"\").trim().toUpperCase();\n\n    if (!key) continue;\n\n    if (outcomeType === \"INSIGHT\") {\n      if (!insightsMap.has(key)) {\n        insightsMap.set(key, []);\n      }\n      insightsMap.get(key).push(item);\n    } else if (outcomeType === \"SUMMARY\") {\n      if (!summaryMap.has(key)) {\n        summaryMap.set(key, []);\n      }\n      summaryMap.get(key).push(item);\n    }\n  }\n\n  for (const account of accounts) {\n    const partyNumber = String(account?.PartyNumber || \"\").trim();\n    if (!partyNumber) continue;\n\n    result.push({\n      account: account,\n      accountInsights: insightsMap.get(partyNumber) || [],\n      accountSummary: summaryMap.get(partyNumber) || []\n    });\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 5225,
            "y": 6094
          },
          "outcomes": {
            "success": "1779819003981"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
