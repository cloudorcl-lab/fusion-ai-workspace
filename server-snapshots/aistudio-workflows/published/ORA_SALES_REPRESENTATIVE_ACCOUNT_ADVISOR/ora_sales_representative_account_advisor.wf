          "id": "1776662830088",
          "code": "PRIORITIZE_ACCOUNTS",
          "type": "REFERENCE",
          "inputs": [
            {
              "id": "1776662830088_listOfAccounts",
              "name": "listOfAccounts",
              "type": "array",
              "value": "{{$context.$variables.AccountsContextArray}}"
            }
          ]
        },
        {
          "id": "1779821152791",
          "code": "REFINE_PRIORITIZED_ACCOUNTS",
          "type": "CODE",
          "metadata": {
            "name": "Refine Prioritized Accounts",
            "sourceCode": "let result = [];\ntry {\n  // Access the prioritized accounts output\n  let prioritizedOutput = $context.$nodes?.PRIORITIZE_ACCOUNTS?.$output || [];\n\n  // If output is a string, parse it to JSON\n  if (typeof prioritizedOutput === \"string\") {\n    try {\n      prioritizedOutput = JSON.parse(prioritizedOutput);\n    } catch (parseError) {\n      prioritizedOutput = [];\n    }\n  }\n\n  // Validate prioritizedOutput is an array\n  if (!Array.isArray(prioritizedOutput)) {\n    prioritizedOutput = [];\n  }\n\n  // Access the full list of account context objects from workflow variable\n  const allAccountsContext = $context.$variables?.AccountsContextArray || [];\n\n  // Create a map for quick lookup by PartyId\n  const accountMap = new Map();\n\n  for (const item of allAccountsContext) {\n    // Each item expected to have account, accountInsights, accountSummary\n    const account = item?.account;\n    const accountInsights = item?.accountInsights;\n    const accountSummary = item?.accountSummary;\n\n    const partyId = account?.PartyId;\n\n    if (partyId !== undefined && partyId !== null) {\n      accountMap.set(Number(partyId), { account, accountInsights, accountSummary });\n    }\n  }\n\n  // Combine prioritized results with base account data\n  for (const prioritizedRow of prioritizedOutput) {\n    const accountId = prioritizedRow?.accountId ?? prioritizedRow?.PartyId;\n    const partyId = Number(accountId);\n\n    const baseData = accountMap.get(partyId);\n\n    if (baseData) {\n      result.push({\n        account: baseData.account,\n        accountInsights: baseData.accountInsights,\n        accountSummary: baseData.accountSummary,\n        priorityOrder: prioritizedRow.priorityOrder,\n        priorityTier: prioritizedRow.priorityTier,\n        scoreRationale: prioritizedRow.scoreRationale,\n        recommendedAction: prioritizedRow.recommendedAction\n      });\n    }\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
            "returnType": "array"
          },
          "diagram": {
            "x": 5223.5,
            "y": 6760
          },
          "outcomes": {
            "success": "1774838637320"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
