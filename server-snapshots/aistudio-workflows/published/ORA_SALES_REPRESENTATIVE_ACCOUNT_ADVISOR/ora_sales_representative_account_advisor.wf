        {
          "id": "1779907539287",
          "code": "REFINE_QUERY_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Refine Query Data",
            "sourceCode": "let result = { isArray: false, data: {}, list: null };\n\ntry {\n  let nodeOutput = $context.$nodes.INVOKE_CUSTOMER_INSIGHTS_CHAT_AGENT?.$output;\n\n  // Parse top-level string if needed\n  if (typeof nodeOutput === \"string\") {\n    try {\n      nodeOutput = JSON.parse(nodeOutput);\n    } catch (e) {\n      nodeOutput = {};\n    }\n  }\n\n  let payload = nodeOutput && typeof nodeOutput === \"object\"\n    ? (nodeOutput.output ?? nodeOutput)\n    : {};\n\n  // Parse payload string if needed\n  if (typeof payload === \"string\") {\n    try {\n      payload = JSON.parse(payload);\n    } catch (e) {\n      payload = {};\n    }\n  }\n\n  const accountData = payload?.accountData;\n\n  if (Array.isArray(accountData)) {\n    result = {\n      isArray: true,\n      data: payload,\n      list: accountData\n    };\n  } else {\n    result = {\n      isArray: false,\n      data: payload,\n      list: null\n    };\n  }\n\n} catch (error) {\n  result = {\n    isArray: false,\n    data: {},\n    list: null\n  };\n}\n\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5900,
            "y": 5650
          },
          "outcomes": {
            "success": "1779907689092"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
