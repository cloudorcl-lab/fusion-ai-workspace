                  "type": "POLICY",
                  "metadata": {
                    "name": "Get Attributes For Prioritization",
                    "policyCode": "ORA_ACCOUNT_PRIORITIZATION_POLICY",
                    "functionCode": "IDENTIFYACCOUNTCONFIGURABLEATTRIBUTES"
                  },
                  "diagram": {
                    "x": 6646.5,
                    "y": 5241
