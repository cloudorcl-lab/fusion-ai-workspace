                {
                  "metadata": {
                    "name": "Refine the top 5 Accounts",
                    "sourceCode": "let result = [];\n\ntry {\n  const accounts = $context.$nodes.PRIORITIZE_ACCOUNT.$output || [];\n\n  result = accounts\n    .slice()\n    .sort((a, b) => {\n      const priorityA = a.priorityOrder ?? Number.MIN_SAFE_INTEGER;\n      const priorityB = b.priorityOrder ?? Number.MIN_SAFE_INTEGER;\n      return priorityB - priorityA;\n    })\n    .slice(0, 5);\n\n} catch (error) {\n  result = [];\n}\n\nreturn result;",
                    "returnType": "array"
                  },
                  "diagram": {
                    "x": 6675,
