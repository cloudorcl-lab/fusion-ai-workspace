                "ORA_LAYOUT_MULTICARD",
                "ORA_LAYOUT_MESSAGES_LIST",
                "ORA_LAYOUT_CHART",
                "ORA_LAYOUT_CHANGE_LIST",
                "ORA_LAYOUT_RECORD",
                "ORA_LAYOUT_MULTIRECORD"
              ]
            }
          }
        },
        {
          "metadata": {
            "name": "Get Accounts",
            "businessObjectCode": "ORA_CX_SALESFORCE_CXOBJECTSEARCHB",
            "functionName": "SEARCH_OBJECTS"
          },
          "diagram": {
