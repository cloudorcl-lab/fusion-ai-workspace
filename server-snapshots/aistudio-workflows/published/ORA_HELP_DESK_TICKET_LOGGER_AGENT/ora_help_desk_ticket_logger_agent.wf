{
  "workflowId": "100002355227272",
  "workflowCode": "ORA_HELP_DESK_TICKET_LOGGER_AGENT",
  "name": "Help Desk Request Creator Agent",
  "description": "Ticket logging agent drafts a title and problemDescription from the user query and history and logs a ticket.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
