            "sourceCode": "const d = new Date();\nd.setUTCDate(d.getUTCDate() - 15); // subtract 15 days in UTC\n\nconst months = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n\nreturn `${months[d.getUTCMonth()]} ${d.getUTCDate()},${d.getUTCFullYear()}`;"
          },
          "outcomes": {
            "success": "1776708235293"
          },
