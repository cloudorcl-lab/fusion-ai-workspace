            "sourceCode": "const d = new Date();\nd.setUTCDate(d.getUTCDate() - 15); // subtract days in UTC\n\n  // toISOString() => \"YYYY-MM-DDTHH:mm:ss.sssZ\"\n  // remove milliseconds\n  return d.toISOString().replace(/\\.\\d{3}Z$/, \"Z\");"
          },
