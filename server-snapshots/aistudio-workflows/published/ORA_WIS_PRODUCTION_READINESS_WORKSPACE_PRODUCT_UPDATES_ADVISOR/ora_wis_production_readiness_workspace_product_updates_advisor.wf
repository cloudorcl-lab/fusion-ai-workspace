            "name": "prepare mat batch payload",
            "returnType": "object",
            "sourceCode": "const toArray = (value) => {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n\n  return [];\n};\n\nconst toNumberOrNull = (value) => {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const n = Number(value);\n  return Number.isNaN(n) ? null : n;\n};\n\nconst toTimeOrNull = (value) => {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const t = new Date(value).getTime();\n  return Number.isNaN(t) ? null : t;\n};\n\nconst overlaps = (start1, end1, start2, end2) => {\n  const s1 = start1 === null ? Number.NEGATIVE_INFINITY : start1;\n  const e1 = end1 === null ? Number.POSITIVE_INFINITY : end1;\n  const s2 = start2 === null ? Number.NEGATIVE_INFINITY : start2;\n  const e2 = end2 === null ? Number.POSITIVE_INFINITY : end2;\n\n  return s1 < e2 && s2 < e1;\n};\n\nconst existingOutput =\n  $context.$nodes.FETCH_EXISTING_WORK_DEFINITION_MATERIALS.$output;\nconst componentOutput =\n  $context.$nodes.FETCH_COMPONENTS_BY_CHANGE_LINE.$output;\n\nconst existingRows = toArray(existingOutput);\nconst componentRows = toArray(componentOutput);\n\nif (existingRows.length === 0 || componentRows.length === 0) {\n  return { parts: [] };\n}\n\nconst existingNode = existingRows[0];\n\nconst workDefinitionId = toNumberOrNull(existingNode.WorkDefinitionId);\nconst billSequenceId = toNumberOrNull(existingNode.BillSequenceId);\n\nif (workDefinitionId === null || billSequenceId === null) {\n  return { parts: [] };\n}\n\nconst versionRows = toArray(existingNode.WorkDefinitionVersion);\nconst opItems = toArray(existingNode.WorkDefinitionOperation);\nconst materialItems = toArray(existingNode.WorkDefinitionMaterial);\n\nif (versionRows.length === 0) {\n  return { parts: [] };\n}\n\nconst componentItems = [];\n\nfor (const c of componentRows) {\n  const componentStart = toTimeOrNull(c.StartDateTime);\n  const componentEnd = toTimeOrNull(c.EndDateTime);\n\n  if (\n    componentStart !== null &&\n    componentEnd !== null &&\n    componentStart === componentEnd\n  ) {\n    continue;\n  }\n\n  componentItems.push(c);\n}\n\nif (componentItems.length === 0) {\n  return { parts: [] };\n}\n\nconst parts = [];\n\n// Build lineage lookup from the actual component payload\nconst componentBySeqId = new Map();\n\nfor (const c of componentItems) {\n  const componentBillSequenceId = toNumberOrNull(c.BillSequenceId);\n  const componentSequenceId = toNumberOrNull(c.ComponentSequenceId);\n\n  if (componentBillSequenceId !== billSequenceId) {\n    continue;\n  }\n\n  if (c.ComponentType !== \"INPUT\") {\n    continue;\n  }\n\n  if (componentSequenceId === null) {\n    continue;\n  }\n\n  componentBySeqId.set(componentSequenceId, c);\n}\n\n// Build one state per WD version\nconst versionStates = [];\n\nfor (const version of versionRows) {\n  const versionId = toNumberOrNull(version.WorkDefinitionVersionId);\n  const versionStart = toTimeOrNull(version.EffectiveFromDate);\n  const versionEnd = toTimeOrNull(version.EffectiveToDate);\n\n  if (versionId === null || versionStart === null) {\n    continue;\n  }\n\n  const opSeqToWdOps = new Map();\n  const activeWdOperationIds = new Set();\n  const existingAssignmentsByComponentSeqId = new Map();\n  const maxMaterialSeqByWdOperationId = new Map();\n  const existingIds = new Set();\n\n  // Keep only operations active in this version\n  for (const op of opItems) {\n    const wdOperationId = toNumberOrNull(op.WdOperationId);\n    const operationSequenceNumber = toNumberOrNull(\n      op.OperationSequenceNumber\n    );\n    const opStart = toTimeOrNull(op.EffectiveFromDate);\n    const opEnd = toTimeOrNull(op.EffectiveToDate);\n\n    if (\n      wdOperationId === null ||\n      operationSequenceNumber === null ||\n      opStart === null\n    ) {\n      continue;\n    }\n\n    if (!overlaps(opStart, opEnd, versionStart, versionEnd)) {\n      continue;\n    }\n\n    activeWdOperationIds.add(wdOperationId);\n\n    if (!opSeqToWdOps.has(operationSequenceNumber)) {\n      opSeqToWdOps.set(operationSequenceNumber, []);\n    }\n\n    opSeqToWdOps.get(operationSequenceNumber).push(op);\n  }\n\n  // A material belongs to this version only if its WdOperationId\n  // belongs to an operation active in this version.\n  for (const material of materialItems) {\n    const componentSequenceId = toNumberOrNull(material.ComponentSequenceId);\n    const wdOperationId = toNumberOrNull(material.WdOperationId);\n    const materialSequenceNumber = toNumberOrNull(\n      material.MaterialSequenceNumber\n    );\n    const materialQuantity = toNumberOrNull(material.MaterialQuantity);\n\n    if (\n      componentSequenceId === null ||\n      wdOperationId === null ||\n      materialSequenceNumber === null\n    ) {\n      continue;\n    }\n\n    if (!activeWdOperationIds.has(wdOperationId)) {\n      continue;\n    }\n\n    existingIds.add(componentSequenceId);\n\n    const currentMax = maxMaterialSeqByWdOperationId.get(wdOperationId) || 0;\n    if (materialSequenceNumber > currentMax) {\n      maxMaterialSeqByWdOperationId.set(\n        wdOperationId,\n        materialSequenceNumber\n      );\n    }\n\n    if (!existingAssignmentsByComponentSeqId.has(componentSequenceId)) {\n      existingAssignmentsByComponentSeqId.set(componentSequenceId, []);\n    }\n\n    existingAssignmentsByComponentSeqId.get(componentSequenceId).push({\n      WdOperationId: wdOperationId,\n      MaterialSequenceNumber: materialSequenceNumber,\n      MaterialQuantity: materialQuantity\n    });\n  }\n\n  for (const assignments of existingAssignmentsByComponentSeqId.values()) {\n    assignments.sort((a, b) => {\n      if (a.WdOperationId !== b.WdOperationId) {\n        return a.WdOperationId - b.WdOperationId;\n      }\n\n      return a.MaterialSequenceNumber - b.MaterialSequenceNumber;\n    });\n  }\n\n  versionStates.push({\n    versionId,\n    workDefinitionId,\n    versionStart,\n    versionEnd,\n    opSeqToWdOps,\n    existingAssignmentsByComponentSeqId,\n    maxMaterialSeqByWdOperationId,\n    existingIds\n  });\n}\n\n// Process each component against each overlapping WD version\nfor (const c of componentItems) {\n  const componentBillSequenceId = toNumberOrNull(c.BillSequenceId);\n\n  if (componentBillSequenceId !== billSequenceId) {\n    continue;\n  }\n\n  if (c.ComponentType !== \"INPUT\") {\n    continue;\n  }\n\n  const organizationId = toNumberOrNull(c.OrganizationId);\n  const componentSequenceId = toNumberOrNull(c.ComponentSequenceId);\n  const inventoryItemId = toNumberOrNull(c.ComponentItemId);\n  const materialQuantity = toNumberOrNull(c.Quantity);\n  const supplyType = toNumberOrNull(c.WipSupplyType);\n  const suggestedOpSeq = toNumberOrNull(c.SuggestedOperationSequence);\n  const oldComponentSequenceId = toNumberOrNull(c.OldComponentSequenceId);\n\n  const componentStart = toTimeOrNull(c.StartDateTime);\n  const componentEnd = toTimeOrNull(c.EndDateTime);\n\n  if (\n    organizationId === null ||\n    componentSequenceId === null ||\n    inventoryItemId === null\n  ) {\n    continue;\n  }\n\n  const isNewComponent = oldComponentSequenceId === null;\n\n  for (const versionState of versionStates) {\n    if (\n      !overlaps(\n        componentStart,\n        componentEnd,\n        versionState.versionStart,\n        versionState.versionEnd\n      )\n    ) {\n      continue;\n    }\n\n    if (versionState.existingIds.has(componentSequenceId)) {\n      continue;\n    }\n\n    // New component: use suggested op in this version\n    if (isNewComponent) {\n      if (suggestedOpSeq === null) {\n        continue;\n      }\n\n      const candidateOps =\n        versionState.opSeqToWdOps.get(suggestedOpSeq) || [];\n\n      if (candidateOps.length === 0) {\n        continue;\n      }\n\n      let createdForThisVersion = false;\n\n      for (const wdOp of candidateOps) {\n        const wdOperationId = toNumberOrNull(wdOp.WdOperationId);\n\n        if (wdOperationId === null) {\n          continue;\n        }\n\n        const currentMax =\n          versionState.maxMaterialSeqByWdOperationId.get(wdOperationId) || 0;\n        const materialSequenceNumber = currentMax + 10;\n\n        versionState.maxMaterialSeqByWdOperationId.set(\n          wdOperationId,\n          materialSequenceNumber\n        );\n\n        parts.push({\n          id: `${versionState.workDefinitionId}-${versionState.versionId}-${componentSequenceId}-${wdOperationId}-${materialSequenceNumber}`,\n          path: `/workDefinitionsV2/${versionState.workDefinitionId}/child/WorkDefinitionMaterial`,\n          operation: \"create\",\n          payload: {\n            AdhocFlag: \"N\",\n            OrganizationId: organizationId,\n            ComponentSequenceId: componentSequenceId,\n            InventoryItemId: inventoryItemId,\n            MaterialQuantity: materialQuantity,\n            InverseMaterialQuantity: 1,\n            MaterialSequenceNumber: materialSequenceNumber,\n            MaterialType: \"COMPONENT\",\n            SupplyType: supplyType,\n            WdOperationId: wdOperationId\n          }\n        });\n\n        createdForThisVersion = true;\n      }\n\n      if (createdForThisVersion) {\n        versionState.existingIds.add(componentSequenceId);\n      }\n\n      continue;\n    }\n\n    // Changed component: search ancestor assignments only inside this version\n    let ancestorAssignments = [];\n    const visited = new Set();\n    let currentAncestorId = oldComponentSequenceId;\n\n    while (currentAncestorId !== null && !visited.has(currentAncestorId)) {\n      visited.add(currentAncestorId);\n\n      const assignmentsInThisVersion =\n        versionState.existingAssignmentsByComponentSeqId.get(\n          currentAncestorId\n        ) || [];\n\n      if (assignmentsInThisVersion.length > 0) {\n        ancestorAssignments = assignmentsInThisVersion;\n        break;\n      }\n\n      const ancestorComponent = componentBySeqId.get(currentAncestorId);\n      currentAncestorId = ancestorComponent\n        ? toNumberOrNull(ancestorComponent.OldComponentSequenceId)\n        : null;\n    }\n\n    if (ancestorAssignments.length === 0) {\n      continue;\n    }\n\n    const isSplit = ancestorAssignments.length > 1;\n    let createdForThisVersion = false;\n\n    for (const assignment of ancestorAssignments) {\n      const quantityToUse =\n        isSplit && assignment.MaterialQuantity !== null\n          ? assignment.MaterialQuantity\n          : materialQuantity;\n\n      parts.push({\n        id: `${versionState.workDefinitionId}-${versionState.versionId}-${componentSequenceId}-${assignment.WdOperationId}-${assignment.MaterialSequenceNumber}`,\n        path: `/workDefinitionsV2/${versionState.workDefinitionId}/child/WorkDefinitionMaterial`,\n        operation: \"create\",\n        payload: {\n          AdhocFlag: \"N\",\n          OrganizationId: organizationId,\n          ComponentSequenceId: componentSequenceId,\n          InventoryItemId: inventoryItemId,\n          MaterialQuantity: quantityToUse,\n          InverseMaterialQuantity: 1,\n          MaterialSequenceNumber: assignment.MaterialSequenceNumber,\n          MaterialType: \"COMPONENT\",\n          SupplyType: supplyType,\n          WdOperationId: assignment.WdOperationId\n        }\n      });\n\n      createdForThisVersion = true;\n    }\n\n    if (createdForThisVersion) {\n      versionState.existingIds.add(componentSequenceId);\n    }\n  }\n}\n\nreturn { parts };"
          },
          "outcomes": {
            "success": "1775456393000"
          },
          "code": "PREPARE_MAT_BATCH_PAYLOAD",
          "convergenceTargetId": "1775393539612",
          "id": "1773637789261",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
