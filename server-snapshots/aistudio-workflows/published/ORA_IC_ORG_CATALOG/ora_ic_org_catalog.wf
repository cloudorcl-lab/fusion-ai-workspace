name !== undefined && existingRow.name !== null ? String(existingRow.name).trim() : '';\n    if (!existingName) {\n      continue;\n    }\n    var directKey = normalizeCatalogNameKey(existingName);\n    var signatureKey = buildCatalogWordSignature(existingName);\n    if (directKey && index.direct[directKey] === undefined) {\n      index.direct[directKey] = idx;\n    }\n    if (signatureKey && index.signature[signatureKey] === undefined) {\n      index.signature[signatureKey] = idx;\n    }\n  }\n  return index;\n};\n\nvar mergeCatalogName = function(targetRows, index, name) {\n  if (!targetRows || targetRows.length === undefined || !index || name === null || name === undefined) {\n    return;\n  }\n  var trimmed = String(name).trim();\n  if (!trimmed) {\n    return;\n  }\n\n  var directKey = normalizeCatalogNameKey(trimmed);\n  var signatureKey = buildCatalogWordSignature(trimmed);\n  if (directKey && index.direct[directKey] !== undefined) {\n    return;\n  }\n  if (signatureKey && index.signature[signatureKey] !== undefined) {\n    var signatureIndex = index.signature[signatureKey];\n    targetRows[signatureIndex] = { name: trimmed };\n    if (directKey) {\n      index.direct[directKey] = signatureIndex;\n    }\n    index.signature[signatureKey] = signatureIndex;\n    return;\n  }\n\n  var nextIndex = targetRows.length;\n  targetRows.push({ name: trimmed });\n  if (directKey) {\n    index.direct[directKey] = nextIndex;\n  }\n  if (signatureKey) {\n    index.signature[signatureKey] = nextIndex;\n  }\n};\n\nfor (var s = 0; s < nodeSpec.length; s += 1) {\n  var spec = nodeSpec[s];\n  raw = $context.$nodes[spec.nodeCode] ? $context.$nodes[spec.nodeCode].$output : null;\n  nodeItems[spec.key] = extractBoItems(raw);\n}\n\nbuRows = nodeItems.buRows;\nintervalRows = nodeItems.intervalRows;\ndetailTypeRows = nodeItems.detailTypeRows;\nbasicAttributeRows = nodeItems.basicAttributeRows;\nmeasureResultRows = nodeItems.measureResultRows;\ncomponentResultRows = nodeItems.componen