(valueRow);\n  }\n  for (var av = 0; av < outAllowed.length; av += 1) {\n    if (!valueSeen[outAllowed[av]]) {\n      outValues.push(compactLookupRow(new Object(), outAllowed[av]));\n      valueSeen[outAllowed[av]] = true;\n    }\n  }\n  staticLookups[lookupType] = { allowedCodes: outAllowed, values: outValues };\n}\n\nvar staticExpressionCatalog = $context.$variables.staticExpressionCatalog;\nif (typeof staticExpressionCatalog === 'string') {\n  try { staticExpressionCatalog = JSON.parse(staticExpressionCatalog); } catch (e27) { staticExpressionCatalog = new Object(); }\n}\nif (!staticExpressionCatalog || typeof staticExpressionCatalog !== 'object') {\n  staticExpressionCatalog = new Object();\n}\n\nexpressionCatalogObj = staticExpressionCatalog;\nif (!expressionCatalogObj.icFunctionCatalog || typeof expressionCatalogObj.icFunctionCatalog !== 'object') {\n  expressionCatalogObj.icFunctionCatalog = new Object();\n}\nif (!expressionCatalogObj.icBaseAttributes || typeof expressionCatalogObj.icBaseAttributes !== 'object') {\n  expressionCatalogObj.icBaseAttributes = new Object();\n}\nif (!expressionCatalogObj.measureResultAttributes || expressionCatalogObj.measureResultAttributes.length === undefined) {\n  expressionCatalogObj.measureResultAttributes = new Array();\n}\nif (!expressionCatalogObj.componentResultAttributes || expressionCatalogObj.componentResultAttributes.length === undefined) {\n  expressionCatalogObj.componentResultAttributes = new Array();\n}\nif (!expressionCatalogObj.expressionDetailTypes || expressionCatalogObj.expressionDetailTypes.length === undefined) {\n  expressionCatalogObj.expressionDetailTypes = new Array();\n}\nif (!expressionCatalogObj.attributeAliases || expressionCatalogObj.attributeAliases.length === undefined) {\n  expressionCatalogObj.attributeAliases = new Array();\n}\n\nvar detailTypeSeen = new Object();\nfor (i = 0; i < expressionCatalogObj.expressionDetailTypes.length; i += 1) {\n  var existingDt = expressionCatalogObj.expressionD