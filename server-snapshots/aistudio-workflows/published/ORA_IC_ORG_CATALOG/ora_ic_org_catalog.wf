N\", \"signature\": \"SIGN(Value*)\"}, {\"name\": \"ABS\", \"signature\": \"ABS(Value*)\"}, {\"name\": \"CEIL\", \"signature\": \"CEIL(Value*)\"}, {\"name\": \"FLOOR\", \"signature\": \"FLOOR(Value*)\"}, {\"name\": \"MOD\", \"signature\": \"MOD(Value 1*, Value 2*)\"}, {\"name\": \"POWER\", \"signature\": \"POWER(Base*, Exponent*)\"}, {\"name\": \"SQRT\", \"signature\": \"SQRT(Value*)\"}], \"textFunctions\": [{\"name\": \"CONCAT\", \"signature\": \"CONCAT(String 1*, String 2*, ...)\"}, {\"name\": \"INSTR\", \"signature\": \"INSTR(String*, Substring*)\"}, {\"name\": \"LPAD\", \"signature\": \"LPAD(String*, Length, Pad)\"}, {\"name\": \"RPAD\", \"signature\": \"RPAD(String*, Length, Pad)\"}, {\"name\": \"SUBSTRING\", \"signature\": \"SUBSTRING(String*, Start*, Length)\"}, {\"name\": \"SUBSTR\", \"signature\": \"SUBSTR(String*, Start*, Length)\"}, {\"name\": \"UPPER\", \"signature\": \"UPPER(String*)\"}, {\"name\": \"LOWER\", \"signature\": \"LOWER(String*)\"}, {\"name\": \"LENGTH\", \"signature\": \"LENGTH(String*)\"}, {\"name\": \"REPLACE\", \"signature\": \"REPLACE(String*, Search*, Replacement)\"}, {\"name\": \"TRIM\", \"signature\": \"TRIM(String*)\"}], \"dateFunctions\": [{\"name\": \"ADD_MONTHS\", \"signature\": \"ADD_MONTHS(Date*, Months*)\"}, {\"name\": \"MONTHS_BETWEEN\", \"signature\": \"MONTHS_BETWEEN(Date 1*, Date 2*)\"}, {\"name\": \"TO_DATE\", \"signature\": \"TO_DATE(String*, Format)\"}, {\"name\": \"LAST_DAY\", \"signature\": \"LAST_DAY(Date*)\"}, {\"name\": \"SYSDATE\", \"signature\": \"SYSDATE\"}], \"conversionFunctions\": [{\"name\": \"TO_NUMBER\", \"signature\": \"TO_NUMBER(Value*)\"}, {\"name\": \"TO_CHAR\", \"signature\": \"TO_CHAR(Value*, Format)\"}, {\"name\": \"DECODE\", \"signature\": \"DECODE(Expression*, Search 1*, Result 1*, ..., Default)\"}], \"valueSetFunctions\": [{\"name\": \"SUM_VALUE_SET\", \"signature\": \"SUM_VALUE_SET(UDQ) | SUM_VALUE_SET(UDQ(param1, param2, ...))\", \"description\": \"Sum values from a UDQ result set\"}, {\"name\"