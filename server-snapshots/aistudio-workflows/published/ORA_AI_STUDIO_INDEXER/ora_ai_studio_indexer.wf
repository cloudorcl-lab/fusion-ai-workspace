            "sourceCode": "let allResult = [];\n\nconst buildEmbeddingText = (obj) => {\n  let content = '';\n  if (obj && typeof obj === 'object') {\n    if (obj.name) content += 'Name: ' + obj.name + '\\n';\n    if (obj.description) content += 'Description: ' + obj.description + '\\n';\n  }\n  return content.trim();\n};\n\ntry {\n  const entities = $context.$nodes?.FETCH_DEEPLINKS_BY_CODES?.$output?.items || [];\n  allResult = entities\n    .filter(entity => entity?.deepLinkCode !== undefined && entity?.deepLinkCode !== null)\n    .map(entity => ({\n      documentId: entity.deepLinkCode,\n      parentObjectId: 'artifacts',\n      content: buildEmbeddingText(entity),\n      metaData: { code: entity.deepLinkCode }\n    }));\n} catch (error) {\n  allResult = [];\n}\n\nreturn allResult;"
          },
          "outcomes": {
            "success": "1775532749616"
          },
          "inputs": [],
          "diagram": {
