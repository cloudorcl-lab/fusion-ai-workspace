        {
          "id": "1775532749620",
          "code": "CREATE_APPS_SELECTED_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Create Apps Selected Payload",
            "returnType": "array",
            "sourceCode": "let allResult = [];\n\nconst buildEmbeddingText = (obj) => {\n  let content = '';\n  if (obj && typeof obj === 'object') {\n    if (obj.name) content += 'Name: ' + obj.name + '\\n';\n    if (obj.description) content += 'Description: ' + obj.description + '\\n';\n  }\n  return content.trim();\n};\n\ntry {\n  const entities = $context.$nodes?.FETCH_APPS_BY_CODES?.$output?.items || [];\n  allResult = entities\n    .filter(entity => entity?.code !== undefined && entity?.code !== null)\n    .map(entity => ({\n      documentId: entity.code,\n      parentObjectId: 'artifacts',\n      content: buildEmbeddingText(entity),\n      metaData: { code: entity.code }\n    }));\n} catch (error) {\n  allResult = [];\n}\n\nreturn allResult;"
          },
          "outcomes": {
            "success": "1775532749621"
          },
          "inputs": [],
          "diagram": {
            "x": 5604,
            "y": 6587
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1775532749590",
          "code": "CREATE_BOS_SELECTED_PAYLOAD",
          "type": "CODE",
          "metadata": {
            "name": "Create BOs Selected Payload",
            "returnType": "array",
            "sourceCode": "const buildEmbeddingText = (obj) => {\n  let content = '';\n  let hasExample = false;\n\n  if (obj && typeof obj === 'object') {\n    if (obj.name) content += 'Name: ' + obj.name + '\\n';\n    if (obj.description) content += 'Description: ' + obj.description + '\\n';\n\n    let objectProps = null;\n    if (obj.objectProperties) {\n      if (typeof obj.objectProperties === 'string') {\n        try { objectProps = JSON.parse(obj.objectProperties); } catch (e) { objectProps = null; }\n      } else if (typeof obj.objectProperties === 'object') {\n        objectProps = obj.objectProperties;\n      }\n    }\n\n    if (objectProps && objectProps.tools && objectProps.tools.length) {\n      content += 'Tools:\\n';\n      for (let i = 0; i < objectProps.tools.length; i++) {\n        const tool = objectProps.tools[i];\n        if (!tool) continue;\n        if (tool.sampleQueries && Array.isArray(tool.sampleQueries) && tool.sampleQueries.length > 0) hasExample = true;\n        content += '- ';\n        if (tool.name) content += tool.name;\n        if (tool.description) content += ': ' + tool.description;\n        content += '\\n';\n      }\n    }\n  }\n\n  return { content: content.trim(), hasExample };\n};\n\nlet allResult = [];\n\ntry {\n  const entities = $context.$nodes?.FETCH_BOS_BY_CODES?.$output?.items || [];\n  for (let i = 0; i < entities.length; i++) {\n    const bo = entities[i];\n    if (!bo || bo.objectCode === undefined || bo.objectCode === null) continue;\n    const built = buildEmbeddingText(bo);\n    allResult.push({\n      documentId: bo.objectCode,\n      parentObjectId: 'artifacts',\n      content: built.content,\n      metaData: { code: bo.objectCode, hasExample: built.hasExample }\n    });\n  }\n} catch (error) {\n  allResult = [];\n}\n\nreturn allResult;"
          },
          "outcomes": {
            "success": "1775532749591"
          },
          "inputs": [],
          "diagram": {
            "x": 6054,
            "y": 6587
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
