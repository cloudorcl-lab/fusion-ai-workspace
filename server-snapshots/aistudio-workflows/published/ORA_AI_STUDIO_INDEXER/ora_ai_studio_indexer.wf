        {
          "id": "1775532749585",
          "code": "PREPARE_ITEMS_TO_INDEX",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Items To Index",
            "returnType": "object",
            "sourceCode": "let result = {\n  BUSINESSOBJECTS: '',\n  AGENTTEAMS: '',\n  TOOLS: '',\n  AGENTS: '',\n  TOPICS: '',\n  DEEPLINKS: '',\n  APPS: '',\n  POLICY: '',\n  hasBUSINESSOBJECTS: false,\n  hasAGENTTEAMS: false,\n  hasTOOLS: false,\n  hasAGENTS: false,\n  hasTOPICS: false,\n  hasDEEPLINKS: false,\n  hasAPPS: false,\n  hasPOLICY: false,\n  hasAny: false\n};\n\nconst appendCodes = (prev, next) => {\n  if (!next) return prev;\n  if (!prev) return next;\n  return prev + ',' + next;\n};\n\nconst allowed = new Set(['BUSINESSOBJECTS','AGENTTEAMS','TOOLS','AGENTS','TOPICS','DEEPLINKS','APPS','POLICY']);\nconst inputItems = Array.isArray($context.$triggers?.REST?.$input?.ItemsToIndex) ? $context.$triggers.REST.$input.ItemsToIndex : [];\n\nfor (const item of inputItems) {\n  if (!item || typeof item !== 'object') continue;\n  const type = String(item.type || '').trim().toUpperCase();\n  if (!allowed.has(type)) continue;\n  const codesArray = Array.isArray(item.codes) ? item.codes : [];\n  if (codesArray.length === 0) continue;\n\n  // Wrap each code in single quotes and join with commas\n  const quotedCodes = codesArray.map(code => `'${String(code).replace(/'/g, \"\\\\'\")}'`).join(',');\n\n  result[type] = appendCodes(result[type], quotedCodes);\n}\n\nfor (const type of allowed) {\n  const flag = 'has' + type;\n  result[flag] = !!result[type];\n  if (result[flag]) result.hasAny = true;\n}\n\nreturn result;\n"
          },
          "outcomes": {
            "success": "1775532749629"
          },
          "inputs": [],
          "diagram": {
            "x": 6306.75,
            "y": 5690
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
