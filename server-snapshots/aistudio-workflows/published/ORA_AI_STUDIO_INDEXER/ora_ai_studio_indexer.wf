            "returnType": "array",
            "sourceCode": "let allResult = [];\n\nconst buildEmbeddingText = (obj) => {\n  let content = '';\n  if (obj && typeof obj === 'object') {\n    if (obj.name) content += 'Name: ' + obj.name + '\\n';\n    if (obj.description) content += 'Description: ' + obj.description + '\\n';\n  }\n  return content.trim();\n};\n\ntry {\n  const entities = $context.$nodes?.FETCH_WORKFLOWS_BY_CODES?.$output?.items || [];\n  allResult = entities\n    .filter(wf => wf?.workflowCode !== undefined && wf?.workflowCode !== null && wf?.hiddenFlag !== true)\n    .map(wf => ({\n      documentId: wf.workflowCode,\n      parentObjectId: 'artifacts',\n      content: buildEmbeddingText(wf),\n      metaData: { code: wf.workflowCode, aiAppsCompatibleFlag: wf.aiAppsCompatibleFlag }\n    }));\n} catch (error) {\n  allResult = [];\n}\n\nreturn allResult;"
