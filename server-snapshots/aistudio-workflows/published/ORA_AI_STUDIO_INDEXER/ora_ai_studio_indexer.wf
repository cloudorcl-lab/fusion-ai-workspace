                {
                  "id": "1774769672172",
                  "code": "CREATE_WORKFLOW_PAYLOAD",
                  "type": "CODE",
                  "metadata": {
                    "name": "Create Workflow Payload",
                    "returnType": "array",
                    "sourceCode": "let allResult = [];\n\nconst buildEmbeddingText = ( obj) => {\n  let content = \"\";\n  if( obj && typeof obj === \"object\") {\n    if( obj.name) {\n      content += \"Name: \" + obj.name + \"\\n\";\n    }\n    if( obj.description) {\n      content += \"Description: \" + obj.description + \"\\n\";\n    }\n  }\n  return content.trim();\n};\n\ntry {\n  // Safely access the items array from FETCH_AGENT_TEAMS output\n  \n  const agentTeams = $context.$nodes?.FETCH_AGENT_TEAMS?.$output?.items || [];\n  allResult = agentTeams.filter( wf => wf?.workflowCode !== undefined && wf?.workflowCode !== null && wf?.hiddenFlag !== true ).map( wf => ( {\n    documentId: wf.workflowCode,\n    parentObjectId: \"artifacts\",\n    content: buildEmbeddingText(wf),\n    metaData: {\n      code: wf.workflowCode,\n      aiAppsCompatibleFlag: wf.aiAppsCompatibleFlag\n    }\n  }));\n}\ncatch( error) {\n  allResult = [];\n}\nreturn allResult;"
                  },
