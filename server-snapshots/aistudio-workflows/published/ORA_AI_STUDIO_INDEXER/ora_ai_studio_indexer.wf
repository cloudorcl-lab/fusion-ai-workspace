                    "returnType": "array",
                    "sourceCode": "let allResult = [];\n\nconst buildEmbeddingText = ( obj) => {\n  let content = \"\";\n  if( obj && typeof obj === \"object\") {\n    if( obj.name) {\n      content += \"Name: \" + obj.name + \"\\n\";\n    }\n    if( obj.description) {\n      content += \"Description: \" + obj.description + \"\\n\";\n    }\n  }\n  return content.trim();\n};\n\ntry {\n  // Safely access the items array from FETCH_AGENT_TEAMS output\n  \n  const entities = $context.$nodes?.FETCH_DEEPLINKS?.$output?.items || [];\n  allResult = entities.filter( entity => entity?.deepLinkCode!== undefined && entity?.deepLinkCode !== null).map( entity => ( {\n    documentId: entity.deepLinkCode,\n    parentObjectId: \"artifacts\",\n    content: buildEmbeddingText(entity),\n    metaData: {\n      code: entity.deepLinkCode\n    }\n  }));\n}\ncatch( error) {\n  allResult = [];\n}\nreturn allResult;"
                  },
