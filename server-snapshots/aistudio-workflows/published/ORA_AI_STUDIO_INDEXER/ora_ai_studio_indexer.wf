        {
          "metadata": {
            "name": "Get New Index Prefix",
            "returnType": "string",
            "sourceCode": "let liveIndex = \"\";\nconst outputArray = $context.$nodes.GET_CURRENT_BLUE_GREEN.$output;\nif (Array.isArray(outputArray) && outputArray.length > 0) {\n  liveIndex = outputArray[0].text;\n  liveIndex = liveIndex? liveIndex.trim(): liveIndex;\n}\nlet newIndex = \"\";\nif (!liveIndex) {\n  newIndex = \"BLUE\";\n} else if (liveIndex === \"BLUE\") {\n  newIndex = \"GREEN\";\n} else if (liveIndex === \"GREEN\") {\n  newIndex = \"BLUE\";\n} else {\n  newIndex = \"BLUE\";\n}\nreturn newIndex;"
          },
          "outcomes": {
            "success": "1774721067791"
          },
