                  "code": "UPDATE_BO_ITERATORS",
                  "type": "SET_FIELDS",
                  "inputs": [
                    {
                      "id": "fe460e60-d46f-4f47-a621-dce83c1a9e67",
                      "name": "hasMoreBO",
                      "value": "{{$context.$nodes.FETCH_AND_INDEX_BOS.FETCH_BOS.$output.hasMore}}"
                    },
                    {
                      "id": "407a466b-8eb3-4c9c-9777-4efaff35d26b",
                      "name": "boOffset",
                      "value": "{{$context.$variables.boOffset + $context.$nodes.FETCH_AND_INDEX_BOS.FETCH_BOS.$output.items.length}}"
                    }
                  ]
                },
                {
                  "metadata": {
                    "name": "Create BO Payload",
                    "returnType": "array",
                    "sourceCode": "const buildEmbeddingText = (obj) => {\n  let content = \"\";\n  let hasExample = false;\n\n  if (obj && typeof obj === \"object\") {\n    if (obj.name) {\n      content += \"Name: \" + obj.name + \"\\n\";\n    }\n\n    if (obj.description) {\n      content += \"Description: \" + obj.description + \"\\n\";\n    }\n\n    let objectProps = null;\n\n    if (obj.objectProperties) {\n      if (typeof obj.objectProperties === \"string\") {\n        try {\n          objectProps = JSON.parse(obj.objectProperties);\n        } catch (e) {\n          objectProps = null;\n        }\n      } else if (typeof obj.objectProperties === \"object\") {\n        objectProps = obj.objectProperties;\n      }\n    }\n\n    if (objectProps && objectProps.tools && objectProps.tools.length) {\n      content += \"Tools:\\n\";\n\n      for (let i = 0; i < objectProps.tools.length; i++) {\n        const tool = objectProps.tools[i];\n        if (!tool) continue;\n\n        if (tool.sampleQueries && Array.isArray(tool.sampleQueries) && tool.sampleQueries.length > 0) {\n          hasExample = true;\n        }\n\n        content += \"- \";\n        if (tool.name) {\n          content += tool.name;\n        }\n\n        if (tool.description) {\n          content += \": \" + tool.description;\n        }\n\n        content += \"\\n\";\n      }\n    }\n  }\n\n  return {\n    content: content.trim(),\n    hasExample: hasExample\n  };\n};\n\nlet allResult = [];\n\ntry {\n  const bos = $context.$nodes?.FETCH_BOS?.$output?.items || [];\n\n  for (let i = 0; i < bos.length; i++) {\n    const bo = bos[i];\n    if (!bo || bo.objectCode === undefined || bo.objectCode === null) continue;\n\n    const built = buildEmbeddingText(bo);\n\n    allResult.push({\n      documentId: bo.objectCode,\n      parentObjectId: \"artifacts\",\n      content: built.content,\n      metaData: {\n        code: bo.objectCode,\n        hasExample: built.hasExample\n      }\n    });\n  }\n\n} catch (error) {\n  allResult = [];\n}\n\nreturn allResult;"
                  },
                  "diagram": {
                    "x": 7639.467818966515,
                    "y": 7339.285040967269
                  },
                  "outcomes": {
                    "success": "1774735114087"
                  },
                  "id": "1774735114086",
                  "code": "CREATE_BO_PAYLOAD",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
