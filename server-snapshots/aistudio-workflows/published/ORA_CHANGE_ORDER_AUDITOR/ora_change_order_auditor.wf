          "code": "EXTRACT_AUDIT_VIOLATIONS",
          "id": "1774932117104",
          "inputs": [
            {
              "id": "1776350253300_1",
              "name": "ChangeId",
              "type": "string",
              "value": "{{$context.$nodes.GET_CHANGE_ORDER_DETAILS.$output.items[0].ChangeId}}"
            },
            {
              "id": "1776350253301_2",
              "name": "StatusCode",
              "type": "string",
