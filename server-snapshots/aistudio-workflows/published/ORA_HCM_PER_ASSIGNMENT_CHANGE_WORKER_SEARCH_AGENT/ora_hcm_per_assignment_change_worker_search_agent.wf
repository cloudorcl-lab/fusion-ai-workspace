          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"isAssignmentNumberPresent\": {\n            \"type\": \"boolean\"\n        },\n        \"AssignmentNumber\": {\n            \"type\": \"string\"\n        },\n        \"bothEffectiveDateAndDisplayNamePresent\": {\n            \"type\": \"boolean\"\n        },\n        \"onlyEffectiveDatePresent\": {\n            \"type\": \"boolean\"\n        },\n        \"onlyDisplayNamePresent\": {\n            \"type\": \"boolean\"\n        },\n        \"EffectiveDate\": {\n            \"type\": \"string\"\n        },\n        \"DisplayName\": {\n            \"type\": \"string\"\n        }\n    }\n}",
