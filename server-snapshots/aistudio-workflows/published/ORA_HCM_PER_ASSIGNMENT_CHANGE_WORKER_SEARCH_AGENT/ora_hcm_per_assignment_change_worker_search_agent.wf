            {
              "id": "1762451880318_1",
              "name": "prompt",
              "type": "string",
              "value": "From the response -  {{$context.$nodes.SEARCH_WORKER_BY_NAME.$output.items}},\nif you find a single record with `DisplayName` matching exactly with {{$context.$variables.DisplayName}} , then set singleMatchPresent to true and return singleMatchingRecord.\nElse If you find multiple records with `DisplayName` matching exactly with  {{$context.$variables.DisplayName}} , then set multipleMatchesPresent to true and set multipleMatchingRecords with {{$context.$nodes.SEARCH_WORKER_BY_NAME.$output.items}} with the records that match with the display name.\nElse if you find multiple persons , then set multipleMatchesPresent to true and set multipleMatchingRecords with {{$context.$nodes.SEARCH_WORKER_BY_NAME.$output.items}}\n\nif you find {{$context.$nodes.SEARCH_WORKER_BY_NAME.$output.items}} as empty then set noRecordsFound to true"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"multipleMatchingRecords\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {}\n            }\n        },\n        \"multipleMatchesPresent\": {\n            \"type\": \"boolean\"\n        },\n        \"noRecordsFound\": {\n            \"type\": \"boolean\"\n        },\n        \"singleMatchingRecord\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        },\n        \"singleMatchPresent\": {\n            \"type\": \"boolean\"\n        }\n    }\n}",
