{
  "workflowId": "100002355226943",
  "workflowCode": "ORA_FIN_AP_PAYMENT_EXECUTION_SCOPE_MONITOR",
  "name": "Payment Execution Scope Monitor",
  "description": "Assists payables specialists by identifying and managing out-of-scope inquiries. This monitor classifies requests as unsupported payment queries or general off-topic topics to maintain conversation focus. While it facilitates the redirection of invalid requests, it does not provide financial data or execute payment actions.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
