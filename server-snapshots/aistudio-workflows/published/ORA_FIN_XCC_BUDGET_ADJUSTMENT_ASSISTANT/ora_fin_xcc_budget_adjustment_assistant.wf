        {
          "metadata": {
            "name": "Validate Completeness",
            "returnType": "string",
            "sourceCode": "let fuzzyScore = (input, candidate) => {\n  let a = input.toLowerCase().replace(/\\s+/g, \" \").trim();\n  let b = candidate.toLowerCase().replace(/\\s+/g, \" \").trim();\n  let tokA = a.split(\" \");\n  let tokB = b.split(\" \");\n  let overlap = 0;\n  for (let t = 0; t < tokA.length; t++) {\n    for (let u = 0; u < tokB.length; u++) {\n      if (tokA[t] === tokB[u]) {\n        overlap++;\n        break;\n      }\n    }\n  }\n  let tokenRatio = overlap / Math.max(tokA.length, tokB.length);\n  let containsBonus = (b.indexOf(a) !== -1 || a.indexOf(b) !== -1) ? 0.35 : 0;\n  let startsWithBonus = (b === a || b.indexOf(a + \" \") === 0) ? 0.20 : 0;\n  let embeddedPhraseBonus = (!startsWithBonus && b.indexOf(\" \" + a) !== -1) ? 0.05 : 0;\n  let lengthPenalty = b.length > a.length + 12 ? 0.05 : 0;\n  return (tokenRatio * 0.4) + containsBonus + startsWithBonus + embeddedPhraseBonus - lengthPenalty;\n};\n\nlet entities = $context.$variables.finXccVarConvEntities || {};\nlet segData = $context.$variables.finXccVarConvSegmentMappings;\nlet intent = $context.$variables.finXccVarConvIntent;\nlet currentInputRaw = ($context.$system.$inputMessage || \"\").trim();\nlet inputMessage = currentInputRaw.toLowerCase();\nlet priorValidation = $context.$variables.finXccVarConvValidationFollowup || \"\";\nlet segmentLabels = [];\nlet expectedSegCount = 0;\nlet budgetName = entities.control_budget_name;\n\nlet normalizeText = (value) => String(value || \"\").toLowerCase().replace(/\\s+/g, \" \").trim();\nlet affirmativePattern = /^(yes|y|yep|yeah|correct|that'?s right|right|use that|that one|go ahead|proceed|submit|create it|create this|do it|confirm|confirmed)$/i;\nlet isAffirmativeSelection = (value) => affirmativePattern.test(String(value || \"\").trim());\nlet extractSuggestedBudgets = (text) => {\n  let raw = String(text || \"\").trim();\n  if (!raw) return [];\n  if (/Did you mean the budget period /i.test(raw)) return [];\n  let multi = raw.match(/Did you mean one of these: (.+?)\\?$/i);\n  if (multi && multi[1]) {\n    return multi[1].split(/,\\s*/).map(function(item) { return item.trim(); }).filter(function(item) { return item !== \"\"; });\n  }\n  let single = raw.match(/Did you mean (.+?)\\?$/i);\n  if (single && single[1]) {\n    return [single[1].trim()];\n  }\n  return [];\n};\nlet extractSuggestedPeriod = (text) => {\n  let raw = String(text || \"\").trim();\n  if (!raw) return \"\";\n  let match = raw.match(/Did you mean the budget period(?: of)? ([^?]+)\\?/i);\n  return match && match[1] ? match[1].trim() : \"\";\n};\nlet resolveBudgetSelection = (text, options) => {\n  if (!options || options.length === 0) return \"\";\n  let raw = String(text || \"\").trim();\n  let normalized = normalizeText(raw);\n  if (!normalized) return \"\";\n  for (let i = 0; i < options.length; i++) {\n    if (normalizeText(options[i]) === normalized) return options[i];\n  }\n  let ordinalMap = {\"1\": 0, \"1st\": 0, \"first\": 0, \"one\": 0, \"2\": 1, \"2nd\": 1, \"second\": 1, \"two\": 1, \"3\": 2, \"3rd\": 2, \"third\": 2, \"three\": 2};\n  if (ordinalMap[normalized] !== undefined && options[ordinalMap[normalized]]) {\n    return options[ordinalMap[normalized]];\n  }\n  if (options.length === 1 && isAffirmativeSelection(raw)) {\n    return options[0];\n  }\n  return \"\";\n};\nlet budgetHasRequestedPeriod = (budgetItem, periodName) => {\n  if (!periodName || !budgetItem || !budgetItem.budgetPeriodStatuses || !budgetItem.budgetPeriodStatuses.items) return false;\n  let normalizedPeriod = normalizeText(periodName);\n  let statuses = budgetItem.budgetPeriodStatuses.items;\n  for (let i = 0; i < statuses.length; i++) {\n    let status = statuses[i];\n    let code = (status.periodStatus && status.periodStatus.lookupCode) ? status.periodStatus.lookupCode : \"\";\n    if (normalizeText(status.periodName) === normalizedPeriod && (code === \"OPEN\" || code === \"AVAILABLE_FOR_BUDGETING\")) {\n      return true;\n    }\n  }\n  return false;\n};\nlet buildFuzzySuggestion = (requestedName, scoredOptions) => {\n  if (!scoredOptions || scoredOptions.length === 0) return \"\";\n  if (scoredOptions[0].score >= 0.50 && (scoredOptions.length === 1 || (scoredOptions[0].score - scoredOptions[1].score) >= 0.10)) {\n    return \"I could not find an exact match for \\\"\" + requestedName + \"\\\". Did you mean \" + scoredOptions[0].name + \"?\";\n  }\n  let names = [];\n  let cap = Math.min(scoredOptions.length, 3);\n  for (let i = 0; i < cap; i++) {\n    names.push(scoredOptions[i].name);\n  }\n  return \"I could not find an exact match for \\\"\" + requestedName + \"\\\". Did you mean one of these: \" + names.join(\", \") + \"?\";\n};\n\nlet suggestedBudgets = extractSuggestedBudgets(priorValidation);\nlet resolvedBudgetName = resolveBudgetSelection(currentInputRaw, suggestedBudgets);\nif (resolvedBudgetName) {\n  budgetName = resolvedBudgetName;\n  entities.control_budget_name = resolvedBudgetName;\n}\n\nlet suggestedPeriod = extractSuggestedPeriod(priorValidation);\nlet confirmedSuggestedPeriod = suggestedPeriod && isAffirmativeSelection(currentInputRaw);\n\nif (!segData || !segData.items || segData.items.length === 0) {\n  let allBudgets = $context.$variables.finXccVarConvBudgetList;\n  let budgetItems = [];\n  let budgetNames = [];\n  let userPeriod = null;\n  if (entities.lines && entities.lines.length > 0 && entities.lines[0].period) {\n    userPeriod = entities.lines[0].period;\n  }\n  if (allBudgets && allBudgets.items) {\n    for (let b = 0; b < allBudgets.items.length; b++) {\n      let budgetItem = allBudgets.items[b];\n      budgetItems.push(budgetItem);\n      if (!userPeriod || budgetHasRequestedPeriod(budgetItem, userPeriod)) {\n        budgetNames.push(budgetItem.name);\n      }\n    }\n  }\n\n  let scored = [];\n  for (let b = 0; b < budgetItems.length; b++) {\n    let item = budgetItems[b];\n    let score = fuzzyScore(budgetName, item.name);\n    let periodMatch = userPeriod ? budgetHasRequestedPeriod(item, userPeriod) : false;\n    if (periodMatch) score += 0.20;\n    if (score >= 0.35) {\n      scored.push({name: item.name, score: score, periodMatch: periodMatch});\n    }\n  }\n  scored.sort((a, b) => {\n    if (b.score !== a.score) return b.score - a.score;\n    if (a.periodMatch !== b.periodMatch) return a.periodMatch ? -1 : 1;\n    return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;\n  });\n\n  let fuzzySuggestion = buildFuzzySuggestion(budgetName, scored);\n  if (fuzzySuggestion) {\n    return fuzzySuggestion;\n  }\n\n  if (budgetNames.length === 0 && userPeriod) {\n    return \"No accessible control budgets have the period \" + userPeriod + \" open for budgeting.\";\n  }\n  if (budgetNames.length === 0) {\n    return \"The control budget \\\"\" + budgetName + \"\\\" was not found and no control budgets are currently available. Please contact your administrator.\";\n  }\n  let displayNames = budgetNames.slice(0, 5);\n  let remaining = budgetNames.length - displayNames.length;\n  let listStr = displayNames.join(\", \");\n  if (remaining > 0) {\n    listStr += \" + \" + remaining + \" more\";\n  }\n  if (userPeriod) {\n    return \"The control budget \\\"\" + budgetName + \"\\\" was not found. For the period \" + userPeriod + \", you have access to the following control budgets: \" + listStr + \". Which control budget would you like to use?\";\n  }\n  return \"The control budget \\\"\" + budgetName + \"\\\" was not found. You have access to the following control budgets: \" + listStr + \". Which control budget would you like to update?\";\n}\n\nlet cb = segData.items[0];\nlet startPeriod = cb.startPeriodName || null;\nlet endPeriod = cb.endPeriodName || null;\nlet increasesAllowed = cb.balanceIncreasesAllowedFlag;\nlet decreasesAllowed = cb.balanceDecreasesAllowedFlag;\n\nlet validPeriods = [];\nlet allPeriods = [];\nlet periodsHasMore = false;\nlet periodDataRaw = $context.$variables.finXccVarUqPeriodData;\nif (periodDataRaw) {\n  let pd = null;\n  if (typeof periodDataRaw === \"string\") {\n    try {\n      pd = JSON.parse(periodDataRaw);\n    } catch (e) {}\n  } else {\n    pd = periodDataRaw;\n  }\n  if (pd) {\n    validPeriods = pd.validPeriods || [];\n    allPeriods = pd.allPeriods || [];\n    periodsHasMore = pd.periodsHasMore === true;\n  }\n}\n\nlet periodDesc = \"\";\nif (validPeriods.length >= 2) {\n  periodDesc = \"Valid periods are from \" + validPeriods[0] + \" to \" + validPeriods[validPeriods.length - 1] + \".\";\n} else if (validPeriods.length === 1) {\n  periodDesc = \"The only valid period is \" + validPeriods[0] + \".\";\n} else if (startPeriod && endPeriod) {\n  periodDesc = \"Valid periods are from \" + startPeriod + \" to \" + endPeriod + \".\";\n} else {\n  periodDesc = \"Please provide a valid budget period.\";\n}\n\nlet mappings = [];\nif (cb.controlBudgetAccountSegments && cb.controlBudgetAccountSegments.items) {\n  let rawMappings = cb.controlBudgetAccountSegments.items;\n  for (let m = 0; m < rawMappings.length; m++) {\n    mappings.push({\n      seq: rawMappings[m].displaySequenceNumber,\n      source: rawMappings[m].sourceSegmentColumnName,\n      key: rawMappings[m].keySegmentColumnName\n    });\n  }\n  mappings.sort((a, b) => a.seq - b.seq);\n}\nexpectedSegCount = mappings.length;\n\nlet glSegments = {};\nif (cb.budgetChartOfAccount && cb.budgetChartOfAccount.structure && cb.budgetChartOfAccount.structure.segments && cb.budgetChartOfAccount.structure.segments.items) {\n  let segs = cb.budgetChartOfAccount.structure.segments.items;\n  for (let s = 0; s < segs.length; s++) {\n    glSegments[segs[s].columnName] = segs[s].name;\n  }\n}\n\nfor (let m = 0; m < mappings.length; m++) {\n  let label = glSegments[mappings[m].key] || mappings[m].source;\n  segmentLabels.push(label);\n}\n\nlet segLabelStr = segmentLabels.join(\"-\");\nlet exampleSegs = [];\nfor (let m = 0; m < expectedSegCount; m++) {\n  exampleSegs.push(\"XXXX\");\n}\nlet exampleStr = exampleSegs.join(\"-\");\nlet acctDesc = \"The control budget \" + budgetName + \" budget account has \" + expectedSegCount + \" segments: \" + segLabelStr + \" (e.g. \" + exampleStr + \").\";\n\nlet monthNames = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\nlet monthIndex = {Jan: 1, Feb: 2, Mar: 3, Apr: 4, May: 5, Jun: 6, Jul: 7, Aug: 8, Sep: 9, Oct: 10, Nov: 11, Dec: 12};\nlet parsePeriodName = (period) => {\n  if (!period || typeof period !== \"string\") return null;\n  let match = period.trim().match(/^([A-Za-z]{3})-(\\d{2})$/);\n  if (!match) return null;\n  let monKey = match[1].charAt(0).toUpperCase() + match[1].slice(1, 3).toLowerCase();\n  let mon = monthIndex[monKey];\n  if (!mon) return null;\n  return {month: mon, year: parseInt(match[2], 10)};\n};\nlet formatPeriodName = (parsed) => monthNames[parsed.month - 1] + \"-\" + String(parsed.year).padStart(2, \"0\");\nlet expandMonthRange = (startPeriod, endPeriod) => {\n  let start = parsePeriodName(startPeriod);\n  let end = parsePeriodName(endPeriod);\n  if (!start || !end) return null;\n  let startKey = start.year * 12 + start.month;\n  let endKey = end.year * 12 + end.month;\n  if (endKey < startKey) return null;\n  let periods = [];\n  for (let cursor = startKey; cursor <= endKey; cursor++) {\n    let month = ((cursor - 1) % 12) + 1;\n    let year = Math.floor((cursor - month) / 12);\n    periods.push(formatPeriodName({month: month, year: year}));\n  }\n  return periods;\n};\nlet fiscalYearPeriods = (yearText) => {\n  let yy = String(yearText || \"\").replace(/\\D/g, \"\").slice(-2);\n  if (!yy) return null;\n  let periods = [];\n  for (let i = 0; i < validPeriods.length; i++) {\n    let parsed = parsePeriodName(validPeriods[i]);\n    if (parsed && String(parsed.year).padStart(2, \"0\") === yy) periods.push(formatPeriodName(parsed));\n  }\n  if (periods.length > 0) return periods;\n  return expandMonthRange(\"Jan-\" + yy, \"Dec-\" + yy);\n};\nlet parseAmountValue = (value) => {\n  if (value === null || value === undefined || value === \"\") return null;\n  let num = Number(String(value).replace(/,/g, \"\").trim());\n  return isNaN(num) ? null : num;\n};\nlet repeatedPeriodLinesFromInput = (message, existingLines) => {\n  if (typeof message !== \"string\") return null;\n  let normalizedMessage = message.replace(/\\s+/g, \" \").trim().replace(/[.]+$/, \"\");\n  if (!/\\b(add|increase|adjust|remove|reduce|decrease|cut)\\b/i.test(normalizedMessage)) return null;\n  let amountMatch = normalizedMessage.match(/\\b(?:add|increase|adjust|remove|reduce|decrease|cut)\\s*\\$?\\s*([0-9][0-9,]*(?:\\.\\d+)?)/i);\n  let accountMatch = normalizedMessage.match(/\\b(?:account|acct)\\s+([0-9A-Za-z]+(?:-[0-9A-Za-z]+)+)\\b/i) || normalizedMessage.match(/\\bto\\s+([0-9A-Za-z]+(?:-[0-9A-Za-z]+)+)\\b/i);\n  let amount = amountMatch ? parseAmountValue(amountMatch[1]) : parseAmountValue(existingLines && existingLines[0] ? existingLines[0].amount : null);\n  let account = accountMatch ? accountMatch[1].replace(/\\s/g, \"\") : (existingLines && existingLines[0] && existingLines[0].account ? String(existingLines[0].account).replace(/\\s/g, \"\") : \"\");\n  if (amount === null || !account) return null;\n  if (/\\b(remove|reduce|decrease|cut)\\b/i.test(normalizedMessage) && amount > 0) amount = -amount;\n  let periods = null;\n  let rangeMatch = normalizedMessage.match(/\\b(?:months?|periods?)\\s+(?:from\\s+)?([A-Za-z]{3}-\\d{2})\\s+(?:to|through)\\s+([A-Za-z]{3}-\\d{2})\\b/i)\n    || normalizedMessage.match(/\\bfrom\\s+([A-Za-z]{3}-\\d{2})\\s+(?:to|through)\\s+([A-Za-z]{3}-\\d{2})\\b/i)\n    || normalizedMessage.match(/\\b(?:in|for)\\s+([A-Za-z]{3}-\\d{2})\\s+(?:to|through)\\s+([A-Za-z]{3}-\\d{2})\\b/i);\n  if (rangeMatch) periods = expandMonthRange(rangeMatch[1], rangeMatch[2]);\n  let fyMatch = normalizedMessage.match(/\\ball\\s+months?\\s+in\\s+(?:fiscal\\s+year|fy)\\s+(\\d{2,4})\\b/i);\n  if (!periods && fyMatch) periods = fiscalYearPeriods(fyMatch[1]);\n  if (!periods || periods.length === 0) return null;\n  let rebuilt = [];\n  for (let i = 0; i < periods.length; i++) {\n    rebuilt.push({account: account, amount: amount, period: periods[i]});\n  }\n  return rebuilt;\n};\n\nlet lines = entities.lines || [];\nlet repeatedPeriodLines = repeatedPeriodLinesFromInput(currentInputRaw, lines);\nif (repeatedPeriodLines && repeatedPeriodLines.length > 0) {\n  lines = repeatedPeriodLines;\n  entities.lines = lines;\n}\nlet hasReductionVerb = /\\b(remove|reduce|decrease|cut)\\b/.test(inputMessage);\nlet hasTransferCue = /\\b(transfer|move|reallocate|shift|redistribute|split|distribute)\\b/.test(inputMessage);\nlet hasNegativeAmount = false;\nlet hasPositiveAmount = false;\nfor (let i = 0; i < lines.length; i++) {\n  let amt = Number(lines[i].amount);\n  if (!isNaN(amt)) {\n    if (amt < 0) hasNegativeAmount = true;\n    if (amt > 0) hasPositiveAmount = true;\n  }\n}\nlet looksLikeRangeReduction = intent === \"transfer_period\" && hasReductionVerb && !hasTransferCue && hasNegativeAmount && !hasPositiveAmount;\nlet effectiveIntent = looksLikeRangeReduction ? \"add_budget\" : intent;\nlet isTransfer = (effectiveIntent === \"transfer_period\" || effectiveIntent === \"transfer_account\");\nlet isReview = (effectiveIntent === \"review_entries\" || effectiveIntent === \"review_balances\");\n\nif (isTransfer) {\n  if (increasesAllowed === false) {\n    return \"The control budget \" + budgetName + \" does not allow budget increases, which are required for transfers.\";\n  }\n  if (decreasesAllowed === false) {\n    return \"The control budget \" + budgetName + \" does not allow budget decreases, which are required for transfers.\";\n  }\n}\nif (effectiveIntent === \"add_budget\" && lines.length > 0) {\n  let hasIncrease = false;\n  let hasDecrease = false;\n  for (let i = 0; i < lines.length; i++) {\n    if (lines[i].amount !== null && lines[i].amount !== undefined) {\n      if (Number(lines[i].amount) > 0) hasIncrease = true;\n      if (Number(lines[i].amount) < 0) hasDecrease = true;\n    }\n  }\n  if (hasIncrease && increasesAllowed === false) {\n    return \"The control budget \" + budgetName + \" does not allow budget increases.\";\n  }\n  if (hasDecrease && decreasesAllowed === false) {\n    return \"The control budget \" + budgetName + \" does not allow budget decreases.\";\n  }\n}\n\nif (allPeriods.length > 0 && validPeriods.length === 0) {\n  return budgetName + \" has no periods currently open for budgeting. All \" + allPeriods.length + \" periods are Closed or Never Opened.\";\n}\nif (effectiveIntent === \"transfer_period\" && validPeriods.length === 1) {\n  return budgetName + \" only has 1 open period (\" + validPeriods[0] + \"). Period transfers require at least 2 open periods.\";\n}\n\nif (lines.length === 0) {\n  if (isTransfer) {\n    if (effectiveIntent === \"transfer_account\") {\n      return \"A from and to budget account is needed to complete your transfer request. \" + acctDesc + \" Please provide the source and destination budget accounts.\";\n    }\n    return \"A from and to budget period is needed to complete your transfer request. \" + periodDesc + \" Please provide the source and destination periods.\";\n  }\n  return \"A budget account is needed to complete your request. \" + acctDesc + \" Please provide the entire budget account.\";\n}\n\nlet missingFields = [];\nlet segCountMismatch = false;\nlet mismatchUserCount = 0;\nfor (let i = 0; i < lines.length; i++) {\n  let line = lines[i];\n  if (!line.account) {\n    if (missingFields.indexOf(\"account\") === -1) missingFields.push(\"account\");\n  } else {\n    let segs = line.account.replace(/\\s/g, \"\").split(\"-\");\n    if (expectedSegCount > 0 && segs.length !== expectedSegCount) {\n      segCountMismatch = true;\n      mismatchUserCount = segs.length;\n    }\n  }\n  if (!line.period) {\n    if (missingFields.indexOf(\"period\") === -1) missingFields.push(\"period\");\n  }\n  if (!isReview && (line.amount === null || line.amount === undefined)) {\n    if (missingFields.indexOf(\"amount\") === -1) missingFields.push(\"amount\");\n  }\n}\n\nif (segCountMismatch) {\n  return \"The budget account provided has \" + mismatchUserCount + \" segments, but \" + budgetName + \" requires \" + expectedSegCount + \". \" + acctDesc + \" Please provide the entire budget account.\";\n}\n\nif (isTransfer && lines.length < 2) {\n  if (effectiveIntent === \"transfer_account\") {\n    let hasAccount = lines[0] && lines[0].account;\n    if (hasAccount) {\n      return \"A destination budget account is needed to complete your transfer request. \" + acctDesc + \" Please provide the destination budget account.\";\n    }\n    return \"A from and to budget account is needed to complete your transfer request. \" + acctDesc + \" Please provide the source and destination budget accounts.\";\n  }\n  let hasPeriod = lines[0] && lines[0].period;\n  if (hasPeriod) {\n    return \"A destination budget period is needed to complete your transfer request. \" + periodDesc + \" Please provide the destination period.\";\n  }\n  return \"A from and to budget period is needed to complete your transfer request. \" + periodDesc + \" Please provide the source and destination periods.\";\n}\n\nif (missingFields.length > 0) {\n  if (missingFields.indexOf(\"account\") !== -1) {\n    if (isTransfer) {\n      return \"A from and to budget account is needed to complete your transfer request. \" + acctDesc + \" Please provide the source and destination budget accounts.\";\n    }\n    if (missingFields.indexOf(\"period\") !== -1) {\n      return \"A budget account and period are needed to complete your request. \" + acctDesc + \" \" + periodDesc + \" Please provide the entire budget account and a valid period.\";\n    }\n    return \"A budget account is needed to complete your request. \" + acctDesc + \" Please provide the entire budget account.\";\n  }\n  if (missingFields.indexOf(\"period\") !== -1) {\n    return \"A budget period is needed to complete your request for \" + budgetName + \". \" + periodDesc + \" Please provide a valid period.\";\n  }\n  if (missingFields.indexOf(\"amount\") !== -1) {\n    return \"An amount is needed to complete your request. Please provide the budget amount.\";\n  }\n}\n\nif (isTransfer) {\n  let netSum = 0;\n  let sourceTotal = 0;\n  let destTotal = 0;\n  for (let i = 0; i < lines.length; i++) {\n    let amount = Number(lines[i].amount);\n    netSum += amount;\n    if (amount < 0) sourceTotal += Math.abs(amount);\n    else destTotal += amount;\n  }\n  if (Math.abs(netSum) > 0.001) {\n    return \"The transfer amounts are not balanced. Source total: \" + sourceTotal + \", destination total: \" + destTotal + \". The amounts must be equal. Please adjust the amounts.\";\n  }\n  let awaitingTransferConfirmation = /please confirm if you want me to create this transfer\\./i.test(priorValidation);\n  let resumingBalancedTransfer = /The transfer amounts are not balanced\\./.test(priorValidation) || awaitingTransferConfirmation;\n  if (resumingBalancedTransfer && !isAffirmativeSelection(currentInputRaw)) {\n    return \"The transfer is now balanced. Source total: \" + sourceTotal + \", destination total: \" + destTotal + \". Please confirm if you want me to create this transfer.\";\n  }\n}\n\nif (allPeriods.length > 0) {\n  let allPeriodsLower = {};\n  for (let i = 0; i < allPeriods.length; i++) {\n    if (allPeriods[i] && allPeriods[i].periodName) {\n      allPeriodsLower[String(allPeriods[i].periodName).toLowerCase()] = allPeriods[i];\n    }\n  }\n  let monthFullIndex = {\n    jan: 1, january: 1,\n    feb: 2, february: 2,\n    mar: 3, march: 3,\n    apr: 4, april: 4,\n    may: 5,\n    jun: 6, june: 6,\n    jul: 7, july: 7,\n    aug: 8, august: 8,\n    sep: 9, sept: 9, september: 9,\n    oct: 10, october: 10,\n    nov: 11, november: 11,\n    dec: 12, december: 12\n  };\n  let compactPeriodPattern = /^[A-Za-z]{3}-\\d{2}$/;\n  let getPeriodInfo = (periodName) => allPeriodsLower[String(periodName || \"\").toLowerCase()] || null;\n  let resolveSemanticPeriodName = (period) => {\n    let raw = String(period || \"\").trim();\n    if (!raw || compactPeriodPattern.test(raw)) return \"\";\n    let cleaned = raw.replace(/[,]+/g, \" \").replace(/\\s+/g, \" \").trim();\n    let match = cleaned.match(/^([A-Za-z]+)\\s+(\\d{2,4})$/) || cleaned.match(/^([A-Za-z]+)[-\\/](\\d{2,4})$/);\n    if (!match) return \"\";\n    let monthNumber = monthFullIndex[String(match[1] || \"\").toLowerCase()];\n    if (!monthNumber) return \"\";\n    let yy = String(match[2] || \"\").replace(/\\D/g, \"\").slice(-2);\n    if (!yy) return \"\";\n    let candidateName = monthNames[monthNumber - 1] + \"-\" + yy;\n    let periodInfo = getPeriodInfo(candidateName);\n    return periodInfo ? periodInfo.periodName : \"\";\n  };\n  let validatePeriodStatus = (periodInfo) => {\n    if (periodInfo.lookupCode === \"CLOSED\") {\n      return \"The period \" + periodInfo.periodName + \" is Closed in \" + budgetName + \". Only Open or Available for Budgeting periods can be used.\";\n    }\n    if (periodInfo.lookupCode === \"NEVER_OPENED\") {\n      return \"The period \" + periodInfo.periodName + \" has Never Been Opened in \" + budgetName + \". Only Open or Available for Budgeting periods can be used.\";\n    }\n    return \"\";\n  };\n  for (let i = 0; i < lines.length; i++) {\n    let p = lines[i].period;\n    if (p) {\n      let periodInfo = getPeriodInfo(p);\n      if (!periodInfo) {\n        let semanticPeriodName = resolveSemanticPeriodName(p);\n        if (semanticPeriodName) {\n          if (confirmedSuggestedPeriod && normalizeText(suggestedPeriod) === normalizeText(semanticPeriodName)) {\n            periodInfo = getPeriodInfo(semanticPeriodName);\n          } else {\n            return \"I couldn't find budget period \\\"\" + p + \"\\\" for budget \\\"\" + budgetName + \"\\\". Did you mean the budget period of \" + semanticPeriodName + \"?\";\n          }\n        }\n      }\n      if (!periodInfo && confirmedSuggestedPeriod && !compactPeriodPattern.test(String(p || \"\").trim())) {\n        periodInfo = getPeriodInfo(suggestedPeriod);\n      }\n      if (periodInfo) {\n        let statusError = validatePeriodStatus(periodInfo);\n        if (statusError) return statusError;\n        lines[i].period = periodInfo.periodName;\n      } else {\n        let hasMoreNote = periodsHasMore ? \" (Note: not all periods could be retrieved; the period may exist beyond the retrieved set.)\" : \"\";\n        return \"The period \" + p + \" is not valid for \" + budgetName + \". \" + periodDesc + hasMoreNote;\n      }\n    }\n  }\n}\n\nreturn \"\";"
