        {
          "metadata": {
            "name": "Format Budget List",
            "returnType": "string",
            "sourceCode": "let listData = $context.$nodes.LIST_CALL_ALL.$output;\nlet entities = $context.$variables.finXccVarConvEntities;\nlet userPeriod = null;\nif (entities && entities.lines && entities.lines.length > 0 && entities.lines[0].period) {\n  userPeriod = entities.lines[0].period;\n}\n\nlet budgets = [];\nif (listData && listData.items) {\n  for (let i = 0; i < listData.items.length; i++) {\n    let item = listData.items[i];\n    if (userPeriod && item.budgetPeriodStatuses && item.budgetPeriodStatuses.items) {\n      let match = false;\n      let ps = item.budgetPeriodStatuses.items;\n      for (let p = 0; p < ps.length; p++) {\n        let code = (ps[p].periodStatus && ps[p].periodStatus.lookupCode) ? ps[p].periodStatus.lookupCode : \"\";\n        if (ps[p].periodName && ps[p].periodName.toLowerCase() === userPeriod.toLowerCase() && (code === \"OPEN\" || code === \"AVAILABLE_FOR_BUDGETING\")) {\n          match = true;\n          break;\n        }\n      }\n      if (match) budgets.push(item);\n    } else {\n      budgets.push(item);\n    }\n  }\n}\n\nif (budgets.length === 0 && userPeriod) {\n  return \"No accessible control budgets have the period \" + userPeriod + \" open for budgeting.\";\n}\n\nif (budgets.length === 0) {\n  return \"No control budgets are currently available. Please contact your administrator.\";\n}\n\nlet lines = [];\nfor (let i = 0; i < budgets.length; i++) {\n  let b = budgets[i];\n  let periodInfo = \"\";\n  if (b.startPeriodName && b.endPeriodName) {\n    periodInfo = \" (\" + b.startPeriodName + \" to \" + b.endPeriodName + \")\";\n  }\n  lines.push((i + 1) + \". \" + b.name + periodInfo);\n}\n\nlet header = userPeriod\n  ? \"You have access to \" + budgets.length + \" control budget\" + (budgets.length === 1 ? \"\" : \"s\") + \" with \" + userPeriod + \" open for budgeting:\"\n  : \"You have access to \" + budgets.length + \" control budget\" + (budgets.length === 1 ? \"\" : \"s\") + \":\";\n\nreturn header + \"\\n\\n\" + lines.join(\"\\n\") + \"\\n\\nTo get started, just tell me which budget you'd like to work with and what you'd like to do.\";"
          },
          "outcomes": {
            "success": "LIST_RETURN"
          },
          "code": "LIST_FORMAT_ALL",
          "id": "LIST_FORMAT_ALL_NODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
