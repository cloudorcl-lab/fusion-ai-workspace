            "name": "Review Check Exists",
            "returnType": "string",
            "sourceCode": "let fuzzyScore = (input, candidate) => {\n  let a = input.toLowerCase().replace(/\\s+/g, \" \").trim();\n  let b = candidate.toLowerCase().replace(/\\s+/g, \" \").trim();\n  let tokA = a.split(\" \");\n  let tokB = b.split(\" \");\n  let overlap = 0;\n  for (let t = 0; t < tokA.length; t++) {\n    for (let u = 0; u < tokB.length; u++) {\n      if (tokA[t] === tokB[u]) {\n        overlap++;\n        break;\n      }\n    }\n  }\n  let tokenRatio = overlap / Math.max(tokA.length, tokB.length);\n  let containsBonus = (b.indexOf(a) !== -1 || a.indexOf(b) !== -1) ? 0.35 : 0;\n  let startsWithBonus = (b === a || b.indexOf(a + \" \") === 0) ? 0.20 : 0;\n  let embeddedPhraseBonus = (!startsWithBonus && b.indexOf(\" \" + a) !== -1) ? 0.05 : 0;\n  let lengthPenalty = b.length > a.length + 12 ? 0.05 : 0;\n  return (tokenRatio * 0.4) + containsBonus + startsWithBonus + embeddedPhraseBonus - lengthPenalty;\n};\n\nlet segData = $context.$nodes.REVIEW_GET_SEGMENTS.$output;\nlet entities = $context.$variables.finXccVarConvEntities || {};\nlet intent = $context.$variables.finXccVarConvIntent;\nlet currentInputRaw = ($context.$system.$inputMessage || \"\").trim();\nlet priorValidation = $context.$variables.finXccVarConvValidationFollowup || \"\";\nlet budgetName = entities.control_budget_name;\n\nlet normalizeText = (value) => String(value || \"\").toLowerCase().replace(/\\s+/g, \" \").trim();\nlet affirmativePattern = /^(yes|y|yep|yeah|correct|that'?s right|right|use that|that one|go ahead|proceed|submit|create it|create this|do it|confirm|confirmed)$/i;\nlet extractSuggestedBudgets = (text) => {\n  let raw = String(text || \"\").trim();\n  if (!raw) return [];\n  if (/Did you mean the budget period /i.test(raw)) return [];\n  let multi = raw.match(/Did you mean one of these: (.+?)\\?$/i);\n  if (multi && multi[1]) {\n    return multi[1].split(/,\\s*/).map(function(item) { return item.trim(); }).filter(function(item) { return item !== \"\"; });\n  }\n  let single = raw.match(/Did you mean (.+?)\\?$/i);\n  if (single && single[1]) {\n    return [single[1].trim()];\n  }\n  return [];\n};\nlet extractSuggestedPeriod = (text) => {\n  let raw = String(text || \"\").trim();\n  if (!raw) return \"\";\n  let match = raw.match(/Did you mean the budget period(?: of)? ([^?]+)\\?/i);\n  return match && match[1] ? match[1].trim() : \"\";\n};\nlet resolveBudgetSelection = (text, options) => {\n  if (!options || options.length === 0) return \"\";\n  let raw = String(text || \"\").trim();\n  let normalized = normalizeText(raw);\n  if (!normalized) return \"\";\n  for (let i = 0; i < options.length; i++) {\n    if (normalizeText(options[i]) === normalized) return options[i];\n  }\n  let ordinalMap = {\"1\": 0, \"1st\": 0, \"first\": 0, \"one\": 0, \"2\": 1, \"2nd\": 1, \"second\": 1, \"two\": 1, \"3\": 2, \"3rd\": 2, \"third\": 2, \"three\": 2};\n  if (ordinalMap[normalized] !== undefined && options[ordinalMap[normalized]]) {\n    return options[ordinalMap[normalized]];\n  }\n  if (options.length === 1 && affirmativePattern.test(raw)) {\n    return options[0];\n  }\n  return \"\";\n};\nlet budgetHasRequestedPeriod = (budgetItem, periodName) => {\n  if (!periodName || !budgetItem || !budgetItem.budgetPeriodStatuses || !budgetItem.budgetPeriodStatuses.items) return false;\n  let normalizedPeriod = normalizeText(periodName);\n  let statuses = budgetItem.budgetPeriodStatuses.items;\n  for (let i = 0; i < statuses.length; i++) {\n    let status = statuses[i];\n    let code = (status.periodStatus && status.periodStatus.lookupCode) ? status.periodStatus.lookupCode : \"\";\n    if (normalizeText(status.periodName) === normalizedPeriod && (code === \"OPEN\" || code === \"AVAILABLE_FOR_BUDGETING\")) {\n      return true;\n    }\n  }\n  return false;\n};\nlet buildFuzzySuggestion = (requestedName, scoredOptions) => {\n  if (!scoredOptions || scoredOptions.length === 0) return \"\";\n  if (scoredOptions[0].score >= 0.50 && (scoredOptions.length === 1 || (scoredOptions[0].score - scoredOptions[1].score) >= 0.10)) {\n    return \"I couldn't find an exact match for \\\"\" + requestedName + \"\\\". Did you mean \" + scoredOptions[0].name + \"?\";\n  }\n  let names = [];\n  let cap = Math.min(scoredOptions.length, 3);\n  for (let i = 0; i < cap; i++) {\n    names.push(scoredOptions[i].name);\n  }\n  return \"I couldn't find an exact match for \\\"\" + requestedName + \"\\\". Did you mean one of these: \" + names.join(\", \") + \"?\";\n};\n\nlet suggestedBudgets = extractSuggestedBudgets(priorValidation);\nlet resolvedBudgetName = resolveBudgetSelection(currentInputRaw, suggestedBudgets);\nif (resolvedBudgetName) {\n  budgetName = resolvedBudgetName;\n  entities.control_budget_name = resolvedBudgetName;\n}\n\nlet suggestedPeriod = extractSuggestedPeriod(priorValidation);\nlet confirmedSuggestedPeriod = suggestedPeriod && affirmativePattern.test(currentInputRaw);\n\n// 1. Budget existence check\nif (!segData || !segData.items || segData.items.length === 0) {\n  let allBudgets = $context.$variables.finXccVarConvBudgetList;\n  let budgetItems = [];\n  let budgetNames = [];\n  let userPeriod = (entities.lines && entities.lines.length > 0 && entities.lines[0].period) ? entities.lines[0].period : null;\n  if (allBudgets && allBudgets.items) {\n    for (let b = 0; b < allBudgets.items.length; b++) {\n      let item = allBudgets.items[b];\n      budgetItems.push(item);\n      if (!userPeriod || budgetHasRequestedPeriod(item, userPeriod)) {\n        budgetNames.push(item.name);\n      }\n    }\n  }\n\n  let scored = [];\n  for (let b = 0; b < budgetItems.length; b++) {\n    let item = budgetItems[b];\n    let score = fuzzyScore(budgetName, item.name);\n    let periodMatch = userPeriod ? budgetHasRequestedPeriod(item, userPeriod) : false;\n    if (periodMatch) score += 0.20;\n    if (score >= 0.35) {\n      scored.push({name: item.name, score: score, periodMatch: periodMatch});\n    }\n  }\n  scored.sort((a, b) => {\n    if (b.score !== a.score) return b.score - a.score;\n    if (a.periodMatch !== b.periodMatch) return a.periodMatch ? -1 : 1;\n    return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;\n  });\n\n  let fuzzySuggestion = buildFuzzySuggestion(budgetName, scored);\n  if (fuzzySuggestion) {\n    return fuzzySuggestion;\n  }\n\n  if (budgetNames.length === 0) {\n    return \"The control budget \\\"\" + budgetName + \"\\\" was not found and no control budgets are currently available. Please contact your administrator.\";\n  }\n  let displayNames = budgetNames.slice(0, 5);\n  let remaining = budgetNames.length - displayNames.length;\n  let listStr = displayNames.join(\", \");\n  if (remaining > 0) {\n    listStr += \" + \" + remaining + \" more\";\n  }\n  return \"The control budget \\\"\" + budgetName + \"\\\" was not found. You have access to the following control budgets: \" + listStr + \". Which control budget would you like to review?\";\n}\n\nlet cb = segData.items[0];\n\n// Build segment labels and example string from BOSS API response\nlet mappings = [];\nif (cb.controlBudgetAccountSegments && cb.controlBudgetAccountSegments.items) {\n  let rawMappings = cb.controlBudgetAccountSegments.items;\n  for (let m = 0; m < rawMappings.length; m++) {\n    mappings.push({seq: rawMappings[m].displaySequenceNumber, key: rawMappings[m].keySegmentColumnName});\n  }\n  mappings.sort((a, b) => a.seq - b.seq);\n}\nlet expectedSegCount = mappings.length;\n\nlet glSegments = {};\nif (cb.budgetChartOfAccount && cb.budgetChartOfAccount.structure && cb.budgetChartOfAccount.structure.segments && cb.budgetChartOfAccount.structure.segments.items) {\n  let segs = cb.budgetChartOfAccount.structure.segments.items;\n  for (let s = 0; s < segs.length; s++) {\n    glSegments[segs[s].columnName] = segs[s].name;\n  }\n}\n\nlet segmentLabels = [];\nfor (let m = 0; m < mappings.length; m++) {\n  let label = glSegments[mappings[m].key] || mappings[m].key;\n  segmentLabels.push(label);\n}\nlet segLabelStr = segmentLabels.join(\"-\");\nlet exampleSegs = [];\nfor (let m = 0; m < expectedSegCount; m++) {\n  exampleSegs.push(\"XXXX\");\n}\nlet exampleStr = exampleSegs.join(\"-\");\nlet acctDesc = budgetName + \" has \" + expectedSegCount + \" segments: \" + segLabelStr + \" (e.g. \" + exampleStr + \").\";\n\nlet startPeriod = cb.startPeriodName || null;\nlet endPeriod = cb.endPeriodName || null;\nlet periodDesc = \"\";\nif (startPeriod && endPeriod) {\n  periodDesc = \"Valid periods are from \" + startPeriod + \" to \" + endPeriod + \".\";\n}\n\n// 2. Check for required fields based on intent\n// review_balances (RBCB): requires control budget + period + account\n// review_entries (RBE): requires control budget + period. Account is optional.\nlet line = (entities.lines && entities.lines.length > 0) ? entities.lines[0] : null;\nlet hasAccount = line && line.account;\nlet hasPeriod = line && line.period;\n\nlet needsAccount = (intent === \"review_balances\");\n\n// Review deeplinks should preserve the account fragment the user asked to review.\n// Do not block deeplink continuation on segment-count validation here.\n\n// Period range check (if period present)\nif (hasPeriod) {\n  let monthNames = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];\n  let monthIndex = {jan: 1, feb: 2, mar: 3, apr: 4, may: 5, jun: 6, jul: 7, aug: 8, sep: 9, oct: 10, nov: 11, dec: 12};\n  let monthFullIndex = {\n    jan: 1, january: 1,\n    feb: 2, february: 2,\n    mar: 3, march: 3,\n    apr: 4, april: 4,\n    may: 5,\n    jun: 6, june: 6,\n    jul: 7, july: 7,\n    aug: 8, august: 8,\n    sep: 9, sept: 9, september: 9,\n    oct: 10, october: 10,\n    nov: 11, november: 11,\n    dec: 12, december: 12\n  };\n  let compactPeriodPattern = /^[A-Za-z]{3}-\\d{2}$/;\n  let parsePeriodName = (period) => {\n    if (!period || typeof period !== \"string\") return null;\n    let match = period.trim().match(/^([A-Za-z]{3})-(\\d{2})$/);\n    if (!match) return null;\n    let mon = monthIndex[String(match[1]).toLowerCase()];\n    if (!mon) return null;\n    return {month: mon, year: parseInt(match[2], 10)};\n  };\n  let periodInfoByLower = {};\n  if (cb.budgetPeriodStatuses && cb.budgetPeriodStatuses.items) {\n    for (let i = 0; i < cb.budgetPeriodStatuses.items.length; i++) {\n      let status = cb.budgetPeriodStatuses.items[i];\n      if (status && status.periodName) {\n        periodInfoByLower[String(status.periodName).toLowerCase()] = status;\n      }\n    }\n  }\n  let getPeriodInfo = (periodName) => periodInfoByLower[String(periodName || \"\").toLowerCase()] || null;\n  let resolveSemanticPeriodName = (period) => {\n    let raw = String(period || \"\").trim();\n    if (!raw || compactPeriodPattern.test(raw)) return \"\";\n    let cleaned = raw.replace(/[,]+/g, \" \").replace(/\\s+/g, \" \").trim();\n    let match = cleaned.match(/^([A-Za-z]+)\\s+(\\d{2,4})$/) || cleaned.match(/^([A-Za-z]+)[-\\/](\\d{2,4})$/);\n    if (!match) return \"\";\n    let monthNumber = monthFullIndex[String(match[1] || \"\").toLowerCase()];\n    if (!monthNumber) return \"\";\n    let yy = String(match[2] || \"\").replace(/\\D/g, \"\").slice(-2);\n    if (!yy) return \"\";\n    let candidateName = monthNames[monthNumber - 1] + \"-\" + yy;\n    let periodInfo = getPeriodInfo(candidateName);\n    return periodInfo ? periodInfo.periodName : \"\";\n  };\n  let periodInfo = getPeriodInfo(line.period);\n  if (!periodInfo) {\n    let semanticPeriodName = resolveSemanticPeriodName(line.period);\n    if (semanticPeriodName) {\n      if (confirmedSuggestedPeriod && normalizeText(suggestedPeriod) === normalizeText(semanticPeriodName)) {\n        periodInfo = getPeriodInfo(semanticPeriodName);\n      } else {\n        return \"I couldn't find budget period \\\"\" + line.period + \"\\\" for budget \\\"\" + budgetName + \"\\\". Did you mean the budget period of \" + semanticPeriodName + \"?\";\n      }\n    }\n  }\n  if (!periodInfo && confirmedSuggestedPeriod && !compactPeriodPattern.test(String(line.period || \"\").trim())) {\n    periodInfo = getPeriodInfo(suggestedPeriod);\n  }\n  if (periodInfo) {\n    line.period = periodInfo.periodName;\n  }\n\n  if (startPeriod && endPeriod) {\n    let parsedPeriod = parsePeriodName(line.period);\n    let parsedStart = parsePeriodName(startPeriod);\n    let parsedEnd = parsePeriodName(endPeriod);\n    if (parsedPeriod && parsedStart && parsedEnd) {\n      let pNum = parsedPeriod.year * 100 + parsedPeriod.month;\n      let sNum = parsedStart.year * 100 + parsedStart.month;\n      let eNum = parsedEnd.year * 100 + parsedEnd.month;\n      if (pNum < sNum || pNum > eNum) {\n        return \"The period \" + line.period + \" is not a valid period for \" + budgetName + \". \" + periodDesc + \" Please provide a valid period.\";\n      }\n    }\n  }\n}\n\n// Missing fields check\nlet missingParts = [];\nif (needsAccount && !hasAccount) missingParts.push(\"account\");\nif (!hasPeriod) missingParts.push(\"period\");\n\nif (missingParts.length > 0) {\n  let msg = \"\";\n  if (missingParts.length === 2) {\n    msg = \"A budget account and period are needed to review budgetary control balances. \" + acctDesc + \" \" + periodDesc + \" Please provide the budget account and period.\";\n  } else if (missingParts[0] === \"account\") {\n    msg = \"A budget account is needed to review budgetary control balances. \" + acctDesc + \" Please provide the budget account.\";\n  } else {\n    msg = \"A budget period is needed to complete your review request for \" + budgetName + \". \" + periodDesc + \" Please provide a valid period.\";\n  }\n  return msg;\n}\n\nreturn \"\";"
          },
