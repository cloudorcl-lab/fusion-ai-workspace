        {
          "metadata": {
            "name": "Build Raw Response",
            "returnType": "string",
            "sourceCode": "let postResult = $context.$variables.finXccVarConvPostResult;\nlet processedResult = $context.$variables.finXccVarConvProcessedResult;\nlet processed = null;\nif (typeof processedResult === \"string\") {\n  try { processed = JSON.parse(processedResult); } catch (e) { processed = processedResult; }\n} else {\n  processed = processedResult;\n}\nlet response = {\n  BatchResultCode: (postResult && postResult.BatchResultCode) ? postResult.BatchResultCode : \"\",\n  BatchFatalErrorMessage: (postResult && postResult.BatchFatalErrorMessage) ? postResult.BatchFatalErrorMessage : \"\",\n  TransactionNumber: (postResult && postResult.TransactionNumber) ? postResult.TransactionNumber : \"\",\n  SourceBudget: (postResult && postResult.SourceBudget) ? postResult.SourceBudget : \"\",\n  ProcessId: (postResult && postResult.ProcessId) ? postResult.ProcessId : \"\",\n  DetailedResult: processed\n};\nreturn JSON.stringify(response);"
          },
