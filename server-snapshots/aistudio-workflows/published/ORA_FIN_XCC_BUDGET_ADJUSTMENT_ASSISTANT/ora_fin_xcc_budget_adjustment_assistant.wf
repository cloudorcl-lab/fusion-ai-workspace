        {
          "metadata": {
            "name": "Build Deeplink",
            "returnType": "object",
            "sourceCode": "let entities = $context.$variables.finXccVarConvEntities;\nlet intent = $context.$variables.finXccVarConvIntent;\nlet line = (entities.lines && entities.lines.length > 0) ? entities.lines[0] : {};\nlet budgetName = entities.control_budget_name.replace(/ /g, \"%20\");\nlet account = (line.account) ? line.account : \"\";\nlet period = (line.period) ? line.period : \"\";\nlet reviewSegData = $context.$nodes.REVIEW_GET_SEGMENTS ? $context.$nodes.REVIEW_GET_SEGMENTS.$output : null;\nif (period && reviewSegData && reviewSegData.items && reviewSegData.items.length > 0) {\n  let budgetPeriods = reviewSegData.items[0].budgetPeriodStatuses;\n  let statuses = budgetPeriods && budgetPeriods.items ? budgetPeriods.items : [];\n  for (let i = 0; i < statuses.length; i++) {\n    if (statuses[i] && statuses[i].periodName && String(statuses[i].periodName).toLowerCase() === String(period).toLowerCase()) {\n      period = statuses[i].periodName;\n      break;\n    }\n  }\n}\nlet objType = intent === \"review_entries\" ? \"XCC_REVIEWBUDGETENTRIES\" : \"XCC_REVIEWBUDGETBALANCES\";\nlet action = \"NONE\";\nlet url = \"/fscmUI/faces/deeplink?objType=\" + objType + \"&action=\" + action + \"&objKey=controlBudgetName=\" + budgetName + \";budgetAccount=\" + account + \";periodName=\" + period;\nlet label = intent === \"review_entries\" ? \"Review Budget Entries\" : \"Review Budgetary Control Balances\";\nlet desc = \"control budget \" + entities.control_budget_name;\nif (account) {\n  desc += \", account \" + account;\n}\nif (period) {\n  desc += \", and period \" + period;\n}\nreturn {\"url\": url, \"label\": label, \"controlBudgetName\": entities.control_budget_name, \"budgetAccount\": account, \"periodName\": period, \"description\": desc};"
          },
