        {
          "metadata": {
            "name": "Process Result",
            "returnType": "string",
            "sourceCode": "let rawData = $context.$nodes.CALL_GETBUDGETTRANSACTIONRESULT.$output;\n\n// Handle API error responses (e.g., 400 Bad Request for access denied)\nif (rawData && rawData.status && !rawData.items) {\n  let errorMsg = \"An error occurred retrieving transaction results.\";\n  if (rawData[\"o:errorDetails\"] && rawData[\"o:errorDetails\"].length > 0) {\n    errorMsg = rawData[\"o:errorDetails\"][0].detail || errorMsg;\n  } else if (rawData.title) {\n    errorMsg = rawData.title;\n  }\n  return JSON.stringify({rows: [], count: 0, dedupedCount: 0, batchResult: \"ERROR\", effectiveBatchResult: \"ERROR\", budgetManager: \"\", hasDisplayRows: false, errorMessage: errorMsg});\n}\nlet items = [];\nif (rawData && rawData.items) {\n  items = rawData.items;\n}\n\n// Handle empty GET results (e.g., access denied — POST returned FAIL but GET has no detail rows)\nif (items.length === 0) {\n  let postResult = $context.$variables.finXccVarConvPostResult;\n  let batchCode = (postResult && postResult.BatchResultCode) ? postResult.BatchResultCode : \"\";\n  let fatalMsg = (postResult && postResult.BatchFatalErrorMessage) ? postResult.BatchFatalErrorMessage : \"\";\n  let errorMsg = fatalMsg || \"No detailed results are available. You may not have data access to the control budgets related to this source budget. Please contact your security manager or budget manager for access.\";\n  return JSON.stringify({rows: [], count: 0, dedupedCount: 0, batchResult: batchCode || \"NO_DETAILS\", effectiveBatchResult: batchCode || \"NO_DETAILS\", budgetManager: \"\", hasDisplayRows: false, errorMessage: errorMsg});\n}\n\n// Strip to only display-relevant fields\nlet cleaned = [];\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n  cleaned.push({\n    CB: item.ControlBudget || \"\",\n    P: item.ControlBudgetPeriod || \"\",\n    A: item.BudgetAccount || \"\",\n    Amt: item.TransactionAmount,\n    BR: item.BatchResult || \"\",\n    HS: item.HeaderStatus || \"\",\n    HR: item.HeaderResult || \"\",\n    LS: item.LineStatus || \"\",\n    LR: item.LineResult || \"\",\n    AS: item.ActivityStatus || \"\",\n    AR: item.ActivityResult || \"\",\n    TB: item.TotalBudgetBalance,\n    FA: item.FundsAvailableBalance,\n    CC: item.ControlBudgetCurrency || \"USD\",\n    BM: item.BudgetManager || \"\"\n  });\n}\n\n// Deduplicate: rows where ALL fields match\nlet deduped = [];\nlet seen = {};\nfor (let i = 0; i < cleaned.length; i++) {\n  let r = cleaned[i];\n  let key = r.CB + \"|\" + r.A + \"|\" + r.P + \"|\" + r.TB + \"|\" + r.FA + \"|\" + r.Amt + \"|\" + r.BR + \"|\" + r.HS + \"|\" + r.HR + \"|\" + r.LS + \"|\" + r.LR + \"|\" + r.AR;\n  if (!seen[key]) {\n    seen[key] = true;\n    deduped.push(r);\n  }\n}\n\n// Sort: by ControlBudget name ASC, then by period chronologically\nlet mo = {\"jan\":1,\"feb\":2,\"mar\":3,\"apr\":4,\"may\":5,\"jun\":6,\"jul\":7,\"aug\":8,\"sep\":9,\"oct\":10,\"nov\":11,\"dec\":12};\nlet pNum = (p) => {\n  if (!p) return 99999;\n  if (p.indexOf(\"FY\") === 0) return parseInt(p.replace(\"FY \", \"\")) * 100 + 13;\n  let pts = p.split(\"-\");\n  if (pts.length === 2) return (parseInt(pts[1]) || 0) * 100 + (mo[String(pts[0]).toLowerCase()] || 0);\n  return 99999;\n}\ndeduped.sort((a, b) => {\n  if (a.CB < b.CB) return -1;\n  if (a.CB > b.CB) return 1;\n  let pDiff = pNum(a.P) - pNum(b.P);\n  if (pDiff !== 0) return pDiff;\n  if (a.A < b.A) return -1;\n  if (a.A > b.A) return 1;\n  return 0;\n});\n\nlet firstBatchResult = items.length > 0 ? (items[0].BatchResult || \"\") : \"\";\nlet hasFailure = false;\nlet hasDisplayRows = false;\nlet errorMessages = [];\nlet seenMessages = {};\nlet addMessage = (msg) => {\n  let value = String(msg || \"\").replace(/\\s+/g, \" \").trim();\n  if (value && !seenMessages[value]) {\n    seenMessages[value] = true;\n    errorMessages.push(value);\n  }\n};\nfor (let i = 0; i < deduped.length; i++) {\n  let r = deduped[i];\n  let statusText = (r.BR + \" \" + r.HS + \" \" + r.LS + \" \" + r.AS).toLowerCase();\n  if (statusText.indexOf(\"fail\") !== -1 || statusText.indexOf(\"error\") !== -1) {\n    hasFailure = true;\n    addMessage(r.HR);\n    addMessage(r.LR);\n    addMessage(r.AR);\n  }\n  if (r.CB || r.P || r.A || r.Amt !== null || r.TB !== null || r.FA !== null) {\n    hasDisplayRows = true;\n  }\n}\nlet batchLower = String(firstBatchResult || \"\").toLowerCase();\nlet effectiveBatchResult = hasFailure ? \"FAIL\" : (batchLower.indexOf(\"error\") !== -1 ? \"ERROR\" : firstBatchResult);\n\nreturn JSON.stringify({rows: deduped, count: items.length, dedupedCount: deduped.length, batchResult: firstBatchResult, effectiveBatchResult: effectiveBatchResult, budgetManager: (items.length > 0 ? (items[0].BudgetManager || \"\") : \"\"), hasDisplayRows: hasDisplayRows, errorMessage: errorMessages.join(\" \")});"
          },
          "outcomes": {
            "success": "SAVE_PROCESSED_RESULT"
          },
          "code": "PROCESS_RESULT",
          "id": "PROCESS_RESULT_NODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Save Processed Result"
          },
          "outcomes": {
            "success": "CHECK_RAW_RESPONSE_COND"
          },
          "code": "SAVE_PROCESSED_RESULT",
          "id": "SAVE_PROCESSED_RESULT",
          "inputs": [
            {
              "id": "SPR_1",
              "name": "finXccVarConvProcessedResult",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.PROCESS_RESULT.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Extract Period Data",
            "returnType": "string",
            "sourceCode": "let segData = $context.$nodes.CALL_GET_SEGMENTS.$output;\nlet validArr = [];\nlet allArr = [];\nlet hasMore = false;\nif (segData && segData.items && segData.items.length > 0) {\n  let budget = segData.items[0];\n  let ps = budget.budgetPeriodStatuses;\n  if (ps && ps.items) {\n    hasMore = ps.hasMore === true;\n    let sorted = [];\n    for (let i = 0; i < ps.items.length; i++) {\n      let p = ps.items[i];\n      let code = (p.periodStatus && p.periodStatus.lookupCode) ? p.periodStatus.lookupCode : 'UNKNOWN';\n      sorted.push({periodName: p.periodName, lookupCode: code, effectivePeriodNumber: p.effectivePeriodNumber || '0'});\n    }\n    sorted.sort((a, b) => a.effectivePeriodNumber < b.effectivePeriodNumber ? -1 : a.effectivePeriodNumber > b.effectivePeriodNumber ? 1 : 0);\n    for (let i = 0; i < sorted.length; i++) {\n      allArr.push(sorted[i]);\n      if (sorted[i].lookupCode === 'OPEN' || sorted[i].lookupCode === 'AVAILABLE_FOR_BUDGETING') {\n        validArr.push(sorted[i].periodName);\n      }\n    }\n  }\n}\nreturn JSON.stringify({validPeriods: validArr, allPeriods: allArr, periodsHasMore: hasMore});"
          },
          "outcomes": {
            "success": "SAVE_PERIOD_DATA"
          },
          "code": "EXTRACT_PERIOD_DATA",
          "id": "EXTRACT_PERIOD_DATA",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Save Period Data"
          },
          "outcomes": {
            "success": "VALIDATE_COMPLETENESS_NODE"
          },
          "code": "SAVE_PERIOD_DATA",
          "id": "SAVE_PERIOD_DATA",
          "inputs": [
            {
              "id": "SPD_1",
              "name": "finXccVarUqPeriodData",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_PERIOD_DATA.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Check EPM Passthrough",
            "returnType": "object",
            "sourceCode": "let msg = $context.$system.$inputMessage;\nlet restInput = ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input)\n  ? $context.$triggers.REST.$input\n  : null;\nlet priorIntent = $context.$variables.finXccVarConvIntent || \"\";\nlet priorEntities = $context.$variables.finXccVarConvEntities || {};\n\nlet emptyResult = {\n  isPassthrough: false,\n  rawResponse: false,\n  intent: \"\",\n  entities: {},\n  intentForState: priorIntent,\n  entitiesForState: priorEntities,\n  txnNumber: \"\",\n  sourceBudgetName: \"\",\n  requestBody: {}\n};\n\nlet parseMaybeJson = (value) => {\n  if (!value) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return null;\n    }\n  }\n  return null;\n};\n\nlet normalizeBoolean = (value) => {\n  if (value === true || value === false) return value;\n  if (typeof value === \"string\") {\n    let lowered = value.toLowerCase().trim();\n    if (lowered === \"true\") return true;\n    if (lowered === \"false\") return false;\n  }\n  return false;\n};\n\nlet looksLikePassthrough = (value) => {\n  return !!(value && typeof value === \"object\" && (value.EpmPassthrough !== undefined || value.Payload !== undefined));\n};\n\nlet visited = [];\nlet alreadyVisited = (value) => {\n  for (let i = 0; i < visited.length; i++) {\n    if (visited[i] === value) return true;\n  }\n  return false;\n};\n\nlet findPassthroughSource = (value, depth) => {\n  if (value === null || value === undefined || depth > 7) return null;\n\n  if (typeof value === \"string\") {\n    let parsed = parseMaybeJson(value);\n    if (parsed) {\n      return findPassthroughSource(parsed, depth + 1);\n    }\n    return null;\n  }\n\n  if (typeof value !== \"object\") return null;\n  if (alreadyVisited(value)) return null;\n  visited.push(value);\n\n  if (looksLikePassthrough(value)) {\n    return value;\n  }\n\n  let keys = Object.keys(value);\n  for (let i = 0; i < keys.length; i++) {\n    let found = findPassthroughSource(value[keys[i]], depth + 1);\n    if (found) return found;\n  }\n\n  return null;\n};\n\nlet directRoots = [\n  msg,\n  restInput,\n  ($context.$system && $context.$system.$chatHistory) ? $context.$system.$chatHistory : null,\n  ($context.$system && $context.$system.$input) ? $context.$system.$input : null,\n  ($context.$system && $context.$system.input) ? $context.$system.input : null,\n  ($context.$system && $context.$system.$request) ? $context.$system.$request : null,\n  ($context.$system && $context.$system.request) ? $context.$system.request : null,\n  ($context.$system && $context.$system.$workflowInput) ? $context.$system.$workflowInput : null,\n  ($context.$system && $context.$system.workflowInput) ? $context.$system.workflowInput : null,\n  ($context.$triggers && $context.$triggers.REST) ? $context.$triggers.REST : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.parameters) ? $context.$triggers.REST.parameters : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$parameters) ? $context.$triggers.REST.$parameters : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.parameters) ? $context.$triggers.REST.$input.parameters : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.$parameters) ? $context.$triggers.REST.$input.$parameters : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.message) ? $context.$triggers.REST.$input.message : null,\n  ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input && $context.$triggers.REST.$input.adminInput) ? $context.$triggers.REST.$input.adminInput : null,\n  ($context.$variables && $context.$variables.parameters) ? $context.$variables.parameters : null,\n  $context.$system || null,\n  $context.$triggers || null\n];\n\nlet passthroughSource = null;\nfor (let i = 0; i < directRoots.length; i++) {\n  if (passthroughSource) break;\n  passthroughSource = findPassthroughSource(directRoots[i], 0);\n}\n\nif (!passthroughSource || !normalizeBoolean(passthroughSource.EpmPassthrough) || passthroughSource.Payload === undefined || passthroughSource.Payload === null || passthroughSource.Payload === \"\") {\n  return emptyResult;\n}\n\nlet payload = parseMaybeJson(passthroughSource.Payload) || passthroughSource.Payload;\nif (!payload || typeof payload !== \"object\") {\n  return emptyResult;\n}\nif (payload.BudgetTransactionPayload && typeof payload.BudgetTransactionPayload !== \"string\") {\n  payload.BudgetTransactionPayload = JSON.stringify(payload.BudgetTransactionPayload);\n}\n\nlet rawResponse = normalizeBoolean(passthroughSource.RawResponse);\n\nlet lines = [];\nlet totalPositive = 0;\nlet totalNegative = 0;\ntry {\n  let txnPayload = parseMaybeJson(payload.BudgetTransactionPayload);\n  if (txnPayload && txnPayload.Lines) {\n    for (let i = 0; i < txnPayload.Lines.length; i++) {\n      let l = txnPayload.Lines[i];\n      let amt = parseFloat(l.Amount);\n      if (isNaN(amt)) amt = 0;\n      if (amt >= 0) totalPositive += amt;\n      else totalNegative += Math.abs(amt);\n      let segKeys = Object.keys(l)\n        .filter(function(k) { return k.indexOf(\"Segment\") === 0; })\n        .sort(function(a, b) {\n          return Number(a.replace(\"Segment\", \"\")) - Number(b.replace(\"Segment\", \"\"));\n        });\n      let acct = segKeys.map(function(k) { return l[k]; }).join(\"-\");\n      lines.push({account: acct, amount: amt, period: l.PeriodName});\n    }\n  }\n} catch (e) {\n  // Keep passthrough enabled even if the payload lines could not be parsed.\n}\n\nlet intent = \"add_budget\";\nlet totalAmount = totalPositive || totalNegative;\nif (totalNegative > 0 && totalPositive > 0 && Math.abs(totalPositive - totalNegative) < 0.01) {\n  let accounts = {};\n  for (let i = 0; i < lines.length; i++) {\n    accounts[lines[i].account] = true;\n  }\n  intent = Object.keys(accounts).length === 1 ? \"transfer_period\" : \"transfer_account\";\n  totalAmount = totalNegative;\n} else if (totalNegative > 0 && totalPositive === 0) {\n  totalAmount = totalNegative;\n}\n\nlet inferredEntities = {\n  control_budget_name: payload.SourceBudget,\n  totalAmount: totalAmount,\n  lines: lines\n};\n\nreturn {\n  isPassthrough: true,\n  rawResponse: rawResponse,\n  intent: intent,\n  entities: inferredEntities,\n  intentForState: intent,\n  entitiesForState: inferredEntities,\n  txnNumber: payload.TransactionNumber,\n  sourceBudgetName: payload.SourceBudget,\n  requestBody: payload\n};"
          },
          "outcomes": {
            "success": "EPM_SAVE"
          },
