            "FillParameters": "1767852534909",
            "SendCommunication": "1766363338289"
          },
          "code": "FLOW_JUNCTURE",
          "convergenceTargetId": "end",
          "id": "1766363054428",
          "inputs": [
            {
              "id": "1766363054429_1",
