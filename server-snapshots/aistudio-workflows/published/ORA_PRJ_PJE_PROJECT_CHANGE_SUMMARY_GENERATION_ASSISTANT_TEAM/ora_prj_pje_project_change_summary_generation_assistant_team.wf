{
  "workflowId": "300000331058351",
  "workflowCode": "ORA_PRJ_PJE_PROJECT_CHANGE_SUMMARY_GENERATION_ASSISTANT_TEAM",
  "name": "Project Change Summary Generation Assistant",
  "description": "Enables project managers and change owners to instantly generate a comprehensive summary of change orders. The assistant analyzes change order details and automatically produces an editable summary that highlights key elements such as financial impacts, the nature of proposed changes, and their significance to the project.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
