          "diagram": {
            "x": 5247.5,
            "y": 5246
          },
          "outcomes": {
            "success": "1775727764585"
          },
          "inputs": [
            {
              "id": "1774872692003_1",
              "name": "conversationNumber",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.conversationNumber}}"
            }
          ]
        },
        {
          "id": "1775727764585",
          "code": "PROCESS_CONVERSATION_REFERENCES",
          "type": "CODE",
          "metadata": {
            "name": "Process conversation references",
            "sourceCode": "const referenceResponse = $context.$nodes.GET_CONVERSATION_REFERENCES.$output || {};\n\nconst referenceItems = Array.isArray(referenceResponse.items) ? referenceResponse.items : [];\nconst referenceCount = Number(referenceResponse.count) || referenceItems.length;\n\nlet hasAccount = false;\nlet hasOpportunity = false;\nlet hasOnlyAccountRefs = true;\nconst accounts = [];\n\n/**\n * canProcess rules:\n * - false if reference records exist AND at least one OPTY or SERVICE_REQUEST reference exists\n * - true if no references OR references are only ORA_HZ_ORGANIZATION_PROFILES\n */\nlet canProcess = referenceCount === 0;\n\nif (referenceCount > 0) {\n  canProcess = true;\n\n  for (let i = 0; i < referenceItems.length; i += 1) {\n    const ref = referenceItems[i] || {};\n    const type = ref.ObjectTypeCd || '';\n\n    // OPTY or SERVICE_REQUEST reference found -> stop and block processing.\n    if (type === 'ORA_MOO_OPTY' || type === 'ORA_SVC_SERVICE_REQUESTS') {\n      hasOpportunity = true;\n      canProcess = false;\n      break;\n    }\n\n    if (type === 'ORA_HZ_ORGANIZATION_PROFILES') {\n      hasAccount = true;\n      accounts.push({\n        accountPartyNumber: ref.ObjectNumber,\n        accountPartyId: ref.ObjectId\n      });\n      continue;\n    }\n\n    hasOnlyAccountRefs = false;\n  }\n\n  // If loop completed without OPTY/SR, allow only account-only references.\n  if (canProcess) {\n    canProcess = hasOnlyAccountRefs;\n  }\n}\n\nconst association = {\n  isAssociated: hasAccount || hasOpportunity,\n  isAcntAssociated: hasAccount,\n  isOptyAssociated: hasOpportunity,\n  accounts\n};\n\nconst result = {\n  canProcess,\n  association\n};\n\nreturn result;",
            "returnType": "object",
            "description": "",
            "errorNodeId": "1776061172604"
          },
          "diagram": {
            "x": 5229.5,
            "y": 5468
          },
          "outcomes": {
            "success": "1775726888650"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1775726888650",
