          "code": "GET_CONVERSATION_REFERENCES",
          "type": "BO_FUNCTION",
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_CONVERSATIONS",
            "functionName": "get_conversationReferences",
            "processJson": true,
            "name": "Get conversation references",
