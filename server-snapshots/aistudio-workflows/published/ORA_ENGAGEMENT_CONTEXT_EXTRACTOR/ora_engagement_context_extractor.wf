        {
          "id": "1776314558522",
          "code": "BUILD_CONVERSATION_MESSAGE_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Build conversation message query",
            "returnType": "object",
            "sourceCode": "const conversationId = Number($context.$triggers.REST.$input.conversationId); \nif (Number.isNaN(conversationId)) {\n  throw new Error('conversationId is required');\n}\n\nconst emailTypeCode = 'ORA_SVC_EMAIL'; // TODO: filter emails only\n\nconst query = `ConversationId=${conversationId}`;\nconst fields =  'MessageId,MessageNumber,MessageTypeCd,MessageTitle,SenderPartyTypeCd,SenderFreeFormAddress,recipients';\nconst sort = 'CreationDate:asc';\nconst payload = { query, fields, sort };\nreturn payload;",
            "errorNodeId": "1776061172604"
          },
          "diagram": {
            "x": 5450,
            "y": 5912
          },
          "outcomes": {
            "success": "1776314558523"
          },
          "inputs": []
        },
        {
          "id": "1776314558523",
          "code": "GET_EMAIL_MESSAGES",
          "type": "BO_FUNCTION",
          "metadata": {
            "processJson": true,
            "name": "Get email messages",
            "businessObjectCode": "ORA_CX_SALESFORCE_EMAILS",
            "functionName": "get_all_emails_with_recipients"
          },
          "diagram": {
            "x": 5837.466953828069,
            "y": 6115.823414553573
          },
          "outcomes": {
            "success": "1774874858207"
          },
          "inputs": [
            {
              "id": "1776314558523_query",
              "name": "query",
              "value": "{{$context.$nodes.BUILD_CONVERSATION_MESSAGE_QUERY.$output.result.query}}",
              "required": false,
              "type": "string"
            },
            {
              "id": "1776314558523_fields",
              "name": "fields",
              "value": "{{$context.$nodes.BUILD_CONVERSATION_MESSAGE_QUERY.$output.result.fields}}",
              "required": false,
              "type": "string"
            },
            {
              "id": "1776314558523_sort",
              "name": "sort",
              "value": "{{$context.$nodes.BUILD_CONVERSATION_MESSAGE_QUERY.$output.result.sort}}",
              "required": false,
              "type": "string"
            }
          ]
        },
        {
          "metadata": {
            "name": "Build engagement metadata",
            "returnType": "object",
            "sourceCode": "const referenceProcessingResult = $context.$nodes.PROCESS_CONVERSATION_REFERENCES.$output.result || {};\nconst messageResponse = $context.$nodes.GET_EMAIL_MESSAGES.$output || {};\n\nconst conversationId = Number($context.$triggers.REST.$input.conversationId);\nconst conversationNumber = String($context.$triggers.REST.$input.conversationNumber || '');\n\nconst association = referenceProcessingResult.association || {\n  isAssociated: false,\n  isAcntAssociated: false,\n  isOptyAssociated: false,\n  accounts: []\n};\n\n// Message & participant extraction\nconst customerSet = new Set();\nconst salesSet = new Set();\nconst messageItems = messageResponse.items || [];\n\n/**\n * Full message chain metadata used for downstream attachment processing.\n */\nconst messageChain = [];\nfor (let i = 0; i < messageItems.length; i += 1) {\n  const msg = messageItems[i];\n\n  // Collect message id/number for every message in the thread.\n  messageChain.push({\n    messageId: msg.MessageId,\n    messageNumber: msg.MessageNumber || ''\n  });\n\n  const senderEmail = (msg.SenderFreeFormAddress || '').trim().toLowerCase();\n  const senderType = msg.SenderPartyTypeCd;\n\n  // Sender classification: sales users come through as ORA_SVC_RESOURCE;\n  // everyone else (customer contacts, partners, etc.) goes into customerSet.\n  if (senderEmail) {\n    if (senderType === 'ORA_SVC_RESOURCE') {\n      salesSet.add(senderEmail);\n    } else {\n      customerSet.add(senderEmail);\n    }\n  }\n\n  const recipientContainer = msg.recipients || [];\n  const recipients = recipientContainer.items || recipientContainer;\n\n  // Recipient classification: iterate every address, normalize casing,\n  // skip empties, then bucket by party type exactly as we do for senders.\n  for (let j = 0; j < recipients.length; j += 1) {\n    const rec = recipients[j];\n    const email = (rec.FreeFormAddress || '').trim().toLowerCase();\n    if (!email) continue;\n\n    if (rec.RecipientPartyTypeCd === 'ORA_SVC_RESOURCE') {\n      salesSet.add(email);\n    } else {\n      customerSet.add(email);\n    }\n  }\n}\n\n/**\n * Store the most recent message's detailed metadata separately.\n * Messages are already in ascending CreationDate order.\n */\nconst latestMessage = messageItems.length\n  ? messageItems[messageItems.length - 1]\n  : null;\n\nconst recentMessage = latestMessage\n  ? {\n      messageId: latestMessage.MessageId,\n      messageNumber: latestMessage.MessageNumber,\n      messageTitle: latestMessage.MessageTitle || '',\n      direction: latestMessage.MessageTypeCd || '',\n      senderEmail: (latestMessage.SenderFreeFormAddress || '').trim().toLowerCase(),\n      sentDate: latestMessage.CreationDate || null\n    }\n  : null;\n\nconst engagementContext = {\n  conversationId,\n  conversationNumber,\n  association,\n  recentMessage,\n  messageChain,\n  customerContactEmails: Array.from(customerSet),\n  salesUserEmails: Array.from(salesSet)\n};\n\nreturn engagementContext;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "BUILD_ENGAGEMENT_METADATA",
          "id": "1774874858207",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
