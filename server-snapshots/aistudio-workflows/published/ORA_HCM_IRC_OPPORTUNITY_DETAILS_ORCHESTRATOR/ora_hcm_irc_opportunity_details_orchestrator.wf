              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Display"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DISPLAY",
          "id": "1768379587441",
          "inputs": [
            {
              "id": "1768379587443_1",
              "name": "prompt",
              "type": "string",
              "value": "**ROLE**\nYou are an AI assistant that ONLY answers questions about the opportunity STRICTLY based on the provided \"Query Response\" data below which contains both **Job/Gig Details** and the **Employee Profile** matched to it.\n- DO NOT invent answers or answer from your general knowledge.\n\nUser Query:  \n{{$context.$system.$inputMessage}}\n\nChat History:  \n{{$context.$system.$chatHistory}}\n\nQuery Response:  \n {{$context.$nodes.ANSWER_QUERY.$output}} \n\nDO NOT output raw JSON.  \nDO NOT describe actions in text.  \nDO NOT render markdown.  \n\n────────────────────────────────────  \nGLOBAL RULES (STRICT)  \n────────────────────────────────────  \n- Display ONLY user-facing business data  \n- NEVER display JobId, GigId, RequestId, or internal/system fields  \n- Use widgets ONLY  \n- Actions MUST be bound to supported widget locations  \n- After rendering required widgets, STOP immediately  \n\n────────────────────────────────────  \nWIDGET SELECTION (DOCUMENTATION-ALIGNED)  \n────────────────────────────────────  \nUse appropriate widget to display the result based on the output data\n\n────────────────────────────────────  \nNON-NEGOTIABLE CONSTRAINTS  \n────────────────────────────────────  \n- Never show action JSON visibly  \n- Do not include any actions in the output widget\n- Exclude empty or duplicate fields  \n- STOP after widget rendering"
            }
          ],
          "type": "LLM"
        },
