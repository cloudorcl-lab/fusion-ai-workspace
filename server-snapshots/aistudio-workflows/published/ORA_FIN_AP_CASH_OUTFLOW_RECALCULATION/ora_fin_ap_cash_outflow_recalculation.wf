          },
          "code": "FIN_AP_VARIABLES_SET_CASH_OUT_FLOW_FOR_INVALID_PROGRAMS",
          "id": "1769595878565",
          "inputs": [
            {
              "id": "1769595903997",
              "name": "cashFlowResult",
              "type": "array",
              "value": "{{$context.$nodes.FIN_AP_CODE_RETURN_INVALID_PAYMENT_PROGRAM.$output.result}}"
            }
