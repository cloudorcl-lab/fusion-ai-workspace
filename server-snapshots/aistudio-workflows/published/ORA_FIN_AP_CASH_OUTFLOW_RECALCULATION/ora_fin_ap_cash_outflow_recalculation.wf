          "code": "FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_SIGNED_FINANCING_PROGRAMS",
          "convergenceTargetId": "1769449448653",
          "id": "1769413609418",
          "inputs": [
            {
              "id": "1777533568720_1",
              "name": "currentDate",
