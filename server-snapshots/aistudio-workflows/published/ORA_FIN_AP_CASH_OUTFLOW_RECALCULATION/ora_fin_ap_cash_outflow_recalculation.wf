          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Process Payment Instruments",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_PAYMENT_INSTRUMENT_DETAILS.$output \n\n// ensure items is always an array\nconst programs = data.items || [];\n\nconst result = programs.flatMap(program => {\n  const financingProgramId = Number(program.financingProgram.financingProgramId);\n\n  const instruments = program.virtualCardProgramPaymentInstrumentUses?.items || [];\n\n  return instruments.flatMap(use => {\n    const instrument = use.paymentInstrument;\n    const instrumentName = instrument?.paymentInstrumentAlias;\n    const instrumentId = Number(use.id);\n    const currency = instrument.currency?.currencyCode;\n\n    const assignments =\n      instrument.paymentInstrumentBusinessUnitAssignments?.items || [];\n\n    // create one record per business unit assignment\n    return assignments.map(assign => ({\n      instrumentName,\n      instrumentId,\n      currency,\n      financingProgramId,\n      businessUnitId: Number(assign.businessUnit?.id)\n    }));\n  });\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1769413828345"
          },
          "code": "FIN_AP_CODE_PROCESS_PAYMENT_INSTRUMENTS",
          "id": "1769413571592",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Weekly Bucket Aggregated Data",
            "returnType": "array",
            "sourceCode": "let data = $context.$triggers.REST.$input.payablesBalance;\nconst aggregated = Object.values(\n  data.reduce((acc, item) => {\n    const bucket = item.daysRemainingSevenDayBucketHierarchy.sevenDayBucket;\n    const supplierName = item.supplierTypeHierarchy.supplierName;\n    const amount = item.invoiceRemainingAmount;\n\n    const key = `${bucket}|${supplierName}`;\n\n    if (!acc[key]) {\n      acc[key] = {\n        sevenDayBucket: bucket,\n        supplierName: supplierName,\n        amount: 0\n      };\n    }\n\n    acc[key].amount += amount;\n    return acc;\n  }, {})\n);\n\nreturn aggregated;"
          },
          "outcomes": {
            "success": "1769413828345"
          },
          "code": "FIN_AP_CODE_GET_WEEKLY_BUCKET_AGGREGATED_DATA",
          "convergenceTargetId": "1769428776796",
          "id": "1769427419923",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Handle cash flow follow up queries"
          },
          "outcomes": {
            "success": "1769522067648"
          },
          "code": "FIN_AP_LLM_HANDLE_CASH_FLOW_FOLLOW_UP_QUERIES",
          "id": "1769449900532",
          "inputs": [
            {
              "id": "1769449900534_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a smart payments assistant specialized in explaining **already presented** new cash outflows for users after they adopt payment programs.\nUser input - {{$context.$system.$inputMessage}} \nChat history - {{$context.$triggers.REST.$input.chatHistory}} \n# Context:\n- The user has already been shown their new cash outflow, which is available in the chat history.\n- Upcoming payments are grouped in weekly buckets (1-7 days, 8-14 days, etc.) and converted to **week numbers** (Week 1, Week 2, etc.).\n- Programs supported:\n  1. Virtual Credit Card (VCC)\n  2. Dynamic Discounting (DD)\n\n# Program Logic Recap:\n- VCC:\n  - Payments may have been shifted to later weeks based on `extendedDays`.\n  - Original amounts may have been reduced by the `totalBenefit`.\n- Dynamic Discounting (DD):\n  - Payments are assumed to have been made today.\n  - Only the **total cash outflow** is available; no week-based table was presented.\n\n# Strict Guardrails for LLM:\n- The user is asking a **follow-up question** about the already presented cash flow.\n- **Do NOT create or generate any tables.** \n- **Do NOT suggest any follow-up actions or recommendations.** \n- Only provide **clarifications, explanations, or reasoning** for the data already shown.\n- Focus on explaining:\n  - Why a payment amount is zero for a week\n  - Why a payment moved to a specific week\n  - What the last week amount represents\n  - The DD assumption and total cash outflow if relevant\n- Always respond in a **concise, professional, and business-friendly tone**.\n- Include program references (VCC or DD) **only if relevant** to the follow-up question.\n- Do not introduce new calculations or project payments beyond what was already presented.\n\n# If the user asks about SCF:\n- If the user references **Supply Chain Financing (SCF)**, kindly inform them that **SCF is currently not supported** in this context, and offer assistance with the available programs (VCC and DD).\n\n# Examples of follow-up questions:\n- \"Why is week 4 zero?\" → Explain why the cash flow for Week 4 is zero (e.g., delayed payment or program effect)\n- \"Can you explain the last week amount?\" → Explain the value shown in the last week\n- \"Why did the payment move to week 6?\" → Explain why the payment shifted to that week\n\n# Output Guidelines:\n- Always provide **only textual explanation**; no tables, charts, or new data.\n- Keep answers **clear, precise, and non-technical**.\n- If the user’s question is ambiguous, ask a **polite clarifying question**.\n- Respond as if the user has already seen the table or total cash outflow."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Return invalid payment program",
            "returnType": "array",
            "sourceCode": "const intentOutput =\n  $context.$nodes.FIN_AP_CODE_CORRECTING_PROGRAM_TYPE_AND_NAME.$output.result;\n\nif (\n  intentOutput.paymentProgramType === \"NONE\" &&\n  !intentOutput.paymentProgramName\n) {\n  return [{\n    type: \"text\",\n    content: [\n      \"Please specify the financing program you would like to analyze. You can provide a financing program type (Dynamic Discounting, Virtual Credit Card) or a specific financing program name.\"\n    ],\n    sequence: 1,\n    formatHint: \"\"\n  }];\n}\n\nreturn [{\n  type: \"text\",\n  content: [\n    \"A supported financing program is required to view the cash outflow visualization. Please provide the financing program name to continue.\"\n  ],\n  sequence: 1,\n  formatHint: \"\"\n}];"
          },
