        {
          "metadata": {
            "name": "Check for Dynamic Discount Program"
          },
          "outcomes": {
            "true": "1769451283871",
            "false": "1769428414824"
          },
          "code": "FIN_AP_CONDITION_CHECK_FOR_DYNAMIC_DISCOUNT_PROGRAM",
          "convergenceTargetId": "end",
          "id": "1769450532100",
          "inputs": [
            {
              "id": "1769450532101_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_DEFAULTING_NODE.$output.result.paymentProgramType == \"DYNAMIC_DISCOUNTING\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Return for DD Program",
            "returnType": "array",
            "sourceCode": "// --- SUPPLIER FILTERING INPUTS ---\nconst intentOutput = $context.$nodes.FIN_AP_LLM_INTENT_CLASSIFIER.$output || {};\nconst isSpecificSupplierRequested = intentOutput.isSpecificSupplierRequested; \nconst requestedSuppliers = intentOutput.requestedSuppliers || []; \nconst requestedSupplierNotFound = intentOutput.requestedSupplierNotFound;\n\n// Use 'let' so we can filter these arrays before processing\nlet benefits = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_PAYMENT_BENEFIT_SERVICE.$output || [];\nlet weeklyBuckets = $context.$nodes.FIN_AP_CODE_GET_WEEKLY_BUCKET_AGGREGATED_DATA.$output.result || [];\n\nconst extractedProgramName = $context.$nodes.FIN_AP_CODE_DEFAULTING_NODE.$output.result.paymentProgramName;\nconst currencyCode = $context.$triggers.REST.$input.currencyCode || \"USD\";\n\n// --- APPLY SUPPLIER FILTERING ---\nlet targetText = \"your\";\nif (isSpecificSupplierRequested && requestedSuppliers.length > 0) {\n    benefits = benefits.filter(supplier => requestedSuppliers.includes(supplier.supplierName));\n    weeklyBuckets = weeklyBuckets.filter(bucket => requestedSuppliers.includes(bucket.supplierName));\n    targetText = requestedSuppliers.join(\" and \"); // e.g., \"Dell Computers and Advanced Network Devices\"\n}\n\n// --- SMART FALLBACK & TRANSPARENCY FIX ---\nlet finalProgramName = extractedProgramName;\nlet selectedDDPrograms = [];\nlet didSwitchProgram = false;\n\n// 1. Try to match the exact name provided (case-insensitive)\nif (finalProgramName) {\n    for (const supplier of benefits) {\n        const match = supplier.roiResults?.find(r => \n            r.programType === \"DYNAMIC_DISCOUNTING\" && \n            r.programName && r.programName.trim().toLowerCase() === finalProgramName.trim().toLowerCase()\n        );\n        if (match) selectedDDPrograms.push(match);\n    }\n}\n\n// 2. ACTIVE DATA OVERRIDE: If no matches were found (zero benefits) OR no specific name was given\nif (selectedDDPrograms.length === 0) {\n    let fallbackProgramName = null;\n    \n    // Find the very first DD program that actually exists in the data\n    for (const supplier of benefits) {\n        const firstDD = supplier.roiResults?.find(r => r.programType === \"DYNAMIC_DISCOUNTING\");\n        if (firstDD && firstDD.programName) {\n            fallbackProgramName = firstDD.programName; \n            break;\n        }\n    }\n    \n    // If we found a valid backup program in the data, lock onto it\n    if (fallbackProgramName) {\n        if (extractedProgramName && extractedProgramName.trim().toLowerCase() !== fallbackProgramName.trim().toLowerCase()) {\n            didSwitchProgram = true;\n        }\n        \n        finalProgramName = fallbackProgramName;\n        \n        // Gather benefits using our safely locked fallback name\n        for (const supplier of benefits) {\n            const match = supplier.roiResults?.find(r => \n                r.programType === \"DYNAMIC_DISCOUNTING\" && r.programName === finalProgramName\n            );\n            if (match) selectedDDPrograms.push(match);\n        }\n    }\n}\n\n// --- CALCULATE BENEFITS ---\nlet totalDDBenefit = 0;\nlet isExternal = false; \n\nfor (const prog of selectedDDPrograms) {\n    if (prog.totalBenefit !== undefined) {\n        totalDDBenefit += prog.totalBenefit;\n        if (prog.programCategory === \"external\") {\n            isExternal = true;\n        }\n    }\n}\n\n// Round to 2 decimals\ntotalDDBenefit = +totalDDBenefit.toFixed(2);\n\n// Calculate totals once for efficiency\nconst sumOriginalAmount = weeklyBuckets.reduce((sum, bucket) => sum + (bucket.amount || 0), 0);\nconst totalAmount = sumOriginalAmount - totalDDBenefit;\n\nconst origAmountDue = `${sumOriginalAmount.toFixed(2)} ${currencyCode}`;\nconst benefitEarned = `${totalDDBenefit.toFixed(2)} ${currencyCode}`;\nlet newCashFlow = `${totalAmount.toFixed(2)} ${currencyCode}`;\n\n// Program name for the text response (fallback to generic if completely null)\nconst displayProgramName = finalProgramName ? finalProgramName : \"Dynamic Discounting (DD)\";\n\n// Dynamic text based on filtered suppliers\nconst ddExplanationText = isSpecificSupplierRequested \n    ? `For ${displayProgramName}, payments are assumed to be made today to earn early-payment discounts. Therefore, the new cash outflow for ${targetText} equals the sum of all original amounts due within the selected period.`\n    : `For ${displayProgramName}, payments are assumed to be made today to earn early-payment discounts. Therefore, the new cash outflow equals the sum of all original amounts due within the selected period.`;\n\n\n// --- BUILD DYNAMIC RESPONSE ---\nlet responseForDDProgram = [];\nlet currentSequence = 1;\n\n// Add fallback message if supplier was requested but not found\nif (requestedSupplierNotFound) {\n    responseForDDProgram.push({\n        \"type\": \"text\",\n        \"content\": [\"The supplier mentioned was not found among the currently identified upcoming installments to calculate cash flow. Proceeding with available suppliers.\"],\n        \"sequence\": currentSequence++\n    });\n}\n\n// NEW: Add fallback message if the requested program had no benefits and we switched\nif (didSwitchProgram) {\n    responseForDDProgram.push({\n        \"type\": \"text\",\n        \"content\": [`The program \"${extractedProgramName}\" does not currently provide any optimizable benefits for these payments. Proceeding with ${displayProgramName} instead.`],\n        \"sequence\": currentSequence++\n    });\n}\n\nresponseForDDProgram.push({\n    \"type\": \"text\",\n    \"content\": [ddExplanationText],\n    \"sequence\": currentSequence++,\n    \"formatHint\": \"\"\n});\n\nresponseForDDProgram.push({\n    \"type\": \"text\",\n    \"content\": [\"Original Amount Due: \" + origAmountDue],\n    \"sequence\": currentSequence++,\n    \"formatHint\": \"Make Amount Field BOLD\"\n});\n\nresponseForDDProgram.push({\n    \"type\": \"text\",\n    \"content\": [`Benefit from ${displayProgramName} (early-payment discount): ` + benefitEarned],\n    \"sequence\": currentSequence++, \n    \"formatHint\": \"Make Amount Field BOLD\"\n});\n\nresponseForDDProgram.push({\n    \"type\": \"text\",\n    \"content\": [`The revised cash outflow, if you opt for ${displayProgramName}, would be ` + newCashFlow],\n    \"sequence\": currentSequence++, \n    \"formatHint\": \"Make Amount Field BOLD\"\n});\n\n// If an external program was used, append the warning note dynamically\nif (isExternal) {\n    responseForDDProgram.push({\n        \"type\": \"text\",\n        \"content\": [\n            \"Note: Draft offers cannot be created using external programs.\"\n        ],\n        \"sequence\": currentSequence++,\n        \"formatHint\": \"\"\n    });\n}\n\nreturn responseForDDProgram;"
          },
          "outcomes": {
            "success": "1769590882593"
          },
          "code": "FIN_AP_CODE_RETURN_FOR_DD_PROGRAM",
          "id": "1769451283871",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set CashFlow Output For DD"
          },
          "outcomes": {
            "success": "1769590387040"
          },
          "code": "FIN_AP_VARIABLES_SET_CASHFLOW_OUTPUT_FOR_DD",
          "id": "1769590882593",
          "inputs": [
            {
              "id": "1769590904266",
              "name": "cashFlowResult",
              "type": "array",
              "value": "{{$context.$nodes.FIN_AP_CODE_RETURN_FOR_DD_PROGRAM.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Get Financing Duration",
            "returnType": "array",
            "sourceCode": "const benefitResults =\n  $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_PAYMENT_BENEFIT_SERVICE.$output || [];\n\nconst result = [];\n\nconst allowedTypes = new Set([\n  \"SUPPLY_CHAIN_FINANCING\",\n  \"VIRTUAL_CREDIT_CARD\"\n]);\n\nfor (const supplierEntry of benefitResults) {\n\n  const supplierName = supplierEntry.supplierName;\n  const roiResults = supplierEntry.roiResults || [];\n\n  for (const roi of roiResults) {\n\n    const programType = roi.programType;\n\n    if (\n      allowedTypes.has(programType) &&\n      roi.totalBenefit !== undefined\n    ) {\n\n      result.push({\n        supplierName: supplierName,\n        programType: programType,\n        financingProgramName: roi.programName,\n        programCategory: roi.programCategory,\n        extendedDays: roi.extendedDays || 0,\n        totalBenefit: roi.totalBenefit\n      });\n\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1769446700094"
          },
          "code": "FIN_AP_CODE_GET_FINANCING_DURATION",
          "convergenceTargetId": "1769446700094",
          "id": "1769428414824",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct table data",
            "returnType": "array",
            "sourceCode": "// --- SUPPLIER FILTERING INPUTS ---\nconst intentOutput = $context.$nodes.FIN_AP_LLM_INTENT_CLASSIFIER.$output || {};\nconst isSpecificSupplierRequested = intentOutput.isSpecificSupplierRequested; \nconst requestedSuppliers = intentOutput.requestedSuppliers || []; \nconst requestedSupplierNotFound = intentOutput.requestedSupplierNotFound;\n\nlet weeklyBuckets = $context.$nodes.FIN_AP_CODE_GET_WEEKLY_BUCKET_AGGREGATED_DATA.$output.result || [];\nlet extendedInfo = $context.$nodes.FIN_AP_CODE_GET_FINANCING_DURATION.$output.result || [];\n\nconst programType = $context.$nodes.FIN_AP_CODE_DEFAULTING_NODE.$output.result.paymentProgramType;\nconst extractedProgramName = $context.$nodes.FIN_AP_CODE_DEFAULTING_NODE.$output.result.paymentProgramName;\nconst currencyCode = $context.$triggers.REST.$input.currencyCode || \"USD\";\n\n// --- APPLY SUPPLIER FILTERING ---\nlet targetText = \"your\";\nif (isSpecificSupplierRequested && requestedSuppliers.length > 0) {\n    weeklyBuckets = weeklyBuckets.filter(bucket => requestedSuppliers.includes(bucket.supplierName));\n    extendedInfo = extendedInfo.filter(info => requestedSuppliers.includes(info.supplierName));\n    targetText = requestedSuppliers.join(\" and \"); // e.g., \"Dell Computers and Advanced Network Devices\"\n}\n\nconst MAX_WEEKS = 6;\nconst tableRows = [];\n\n// Initialize weeks\nfor (let i = 1; i <= MAX_WEEKS; i++) {\n    tableRows.push({\n        week: `Week ${i}`,\n        originalAmount: 0,\n        newAmount: 0\n    });\n}\n\n// --- SMART FALLBACK & TRANSPARENCY FIX ---\nconst allTypeMatches = extendedInfo.filter(item => item.programType === programType);\n\nlet targetProgramMatches = [];\nlet finalProgramName = extractedProgramName;\nlet didSwitchProgram = false;\n\n// 1. Try to match the exact name provided (case-insensitive for safety)\nif (finalProgramName) {\n    targetProgramMatches = allTypeMatches.filter(item => \n        item.financingProgramName && \n        item.financingProgramName.trim().toLowerCase() === finalProgramName.trim().toLowerCase()\n    );\n}\n\n// 2. ACTIVE DATA OVERRIDE: If the requested program yielded NO benefits (empty array)\n// OR if no specific name was given at all, lock onto the first program with actual data.\nif (targetProgramMatches.length === 0 && allTypeMatches.length > 0) {\n    const fallbackProgramName = allTypeMatches[0].financingProgramName;\n    \n    // If we had an extracted name, but it failed, flag that we are making a switch\n    if (extractedProgramName && extractedProgramName.trim().toLowerCase() !== fallbackProgramName.trim().toLowerCase()) {\n        didSwitchProgram = true;\n    }\n    \n    finalProgramName = fallbackProgramName; \n    targetProgramMatches = allTypeMatches.filter(item => item.financingProgramName === finalProgramName);\n}\n\n// Proceed with math using the safely locked data\nconst totalBenefit = targetProgramMatches.reduce((sum, item) => sum + (item.totalBenefit || 0), 0);\n\n// Determine if the selected program is external\nconst isExternal = targetProgramMatches.some(p => p.programCategory === \"external\");\n\n// Get the display name for the UI \nconst displayProgramName = finalProgramName ? finalProgramName : (programType || \"the program\");\nconst totalBenefitFormatted = `${totalBenefit.toFixed(2)} ${currencyCode}`;\n\n// Dynamic summary text based on filtered suppliers\nconst summaryText = `Here’s what cash outflow looks like for ${targetText} if you adopt ${displayProgramName}`;\n\nconst supplierProgramMap = new Map(\n    targetProgramMatches.map(p => [p.supplierName, p])\n);\n\n// Process supplier buckets\nfor (const entry of weeklyBuckets) {\n    const supplierName = entry.supplierName;\n    const supplierProgram = supplierProgramMap.get(supplierName);\n    const extendedDays = supplierProgram?.extendedDays || 0;\n\n    // Extract bucket upper range (e.g., \"29-35\" → 35)\n    const bucketParts = entry.sevenDayBucket.split(\"-\");\n    const upperDay = parseInt(bucketParts[1], 10);\n\n    // Determine original week from upper range\n    const originalWeek = Math.ceil(upperDay / 7);\n\n    if (originalWeek >= 1 && originalWeek <= MAX_WEEKS) {\n        // Add original amount\n        tableRows[originalWeek - 1].originalAmount += entry.amount;\n\n        // Shift payment date using extendedDays\n        const shiftedDay = upperDay + extendedDays;\n\n        // Determine new week based on shifted day\n        const newWeek = Math.ceil(shiftedDay / 7);\n\n        if (newWeek >= 1 && newWeek <= MAX_WEEKS) {\n            tableRows[newWeek - 1].newAmount += entry.amount;\n        }\n    }\n}\n\n// Format output\nconst tableContent = tableRows.map(row => ({\n    \"Week\": row.week,\n    \"Original Cash Outflow\": `${row.originalAmount.toFixed(2)} ${currencyCode}`,\n    \"Revised Cash Outflow\": `${row.newAmount.toFixed(2)} ${currencyCode}`\n}));\n\n// Set the action text based on whether the program is external\nconst actionText = isExternal \n    ? \"Draft offers cannot be created using external programs. Please proceed with signed programs for draft offer creation\"\n    : \"Create draft offer for the virtual card program \" + displayProgramName + \".\";\n\n// --- BUILD DYNAMIC RESPONSE ---\nlet result = [];\nlet currentSequence = 1;\n\n// Add fallback message if supplier was requested but not found\nif (requestedSupplierNotFound) {\n    result.push({\n        \"type\": \"text\",\n        \"content\": [\"The supplier mentioned was not found among the currently identified upcoming installments to calculate cash flow. Proceeding with available suppliers.\"],\n        \"sequence\": currentSequence++\n    });\n}\n\n// NEW: Add fallback message if the requested program had no benefits and we switched\nif (didSwitchProgram) {\n    result.push({\n        \"type\": \"text\",\n        \"content\": [`The program \"${extractedProgramName}\" does not currently provide any optimizable benefits for these payments. Proceeding with ${displayProgramName} instead.`],\n        \"sequence\": currentSequence++\n    });\n}\n\nresult.push({\n    \"type\": \"text\",\n    \"content\": [summaryText],\n    \"sequence\": currentSequence++\n});\n\nresult.push({\n    \"type\": \"text\",\n    \"content\": [\n        \"By opting for this payment program, you will receive an additional benefit of \" + totalBenefitFormatted\n    ],\n    \"sequence\": currentSequence++\n});\n\nresult.push({\n    \"type\": \"table\",\n    \"content\": tableContent,\n    \"sequence\": currentSequence++,\n    \"columnOrder\": [\"Week\", \"Original Cash Outflow\", \"Revised Cash Outflow\"]\n});\n\nresult.push({\n    \"type\": \"actions\",\n    \"content\": [\n        actionText\n    ],\n    \"sequence\": currentSequence++\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1769590927763"
          },
