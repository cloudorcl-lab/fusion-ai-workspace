        {
          "metadata": {
            "name": "Correcting Program Type and Name",
            "returnType": "object",
            "sourceCode": "const intentOutput = $context.$nodes.FIN_AP_LLM_INTENT_CLASSIFIER.$output;\nconst allPrograms = $context.$nodes.FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM.$output.result.allPrograms;\n\nconst normalize = (str) => (str || \"\").toLowerCase().trim();\n\nconst getScore = (a, b) => {\n  const aTokens = normalize(a).split(/\\s+/);\n  const bTokens = normalize(b).split(/\\s+/);\n\n  let matches = 0;\n  for (const token of aTokens) {\n    if (bTokens.includes(token)) matches++;\n  }\n\n  return matches / Math.max(aTokens.length, bTokens.length);\n};\n\nlet {\n  paymentProgramName,\n  paymentProgramType,\n  programCategory,\n  isAnyProgramRequested\n} = intentOutput;\n\nlet matchedProgram = null;\nlet matchingPrograms = [];\n\nif (\n  Array.isArray(allPrograms) &&\n  paymentProgramType &&\n  paymentProgramType !== \"NONE\"\n) {\n  matchingPrograms = allPrograms.filter(p =>\n    p.financingProgramType === paymentProgramType &&\n    (programCategory === \"ALL\" || p.financingProgramCategory === programCategory)\n  );\n}\n\nif (isAnyProgramRequested && matchingPrograms.length > 0) {\n  return {\n    ...intentOutput,\n    matchingPrograms\n  };\n}\n\nif (matchingPrograms.length === 1) {\n  matchedProgram = matchingPrograms[0];\n} else if (Array.isArray(allPrograms) && paymentProgramName) {\n  matchedProgram = allPrograms.find(p =>\n    normalize(p.financingProgramName) === normalize(paymentProgramName)\n  );\n\n  if (!matchedProgram) {\n    matchedProgram = allPrograms.find(p =>\n      normalize(p.financingProgramName).includes(normalize(paymentProgramName)) ||\n      normalize(paymentProgramName).includes(normalize(p.financingProgramName))\n    );\n  }\n\n  if (!matchedProgram) {\n    let bestMatch = null;\n    let bestScore = 0;\n\n    for (const program of allPrograms) {\n      const score = getScore(paymentProgramName, program.financingProgramName);\n      if (score > bestScore) {\n        bestScore = score;\n        bestMatch = program;\n      }\n    }\n\n    if (bestScore >= 0.5) {\n      matchedProgram = bestMatch;\n    }\n  }\n}\n\nif (matchedProgram) {\n  paymentProgramName = matchedProgram.financingProgramName;\n  if (matchedProgram.financingProgramType) {\n    paymentProgramType = matchedProgram.financingProgramType;\n  }\n}\n\nreturn {\n  ...intentOutput,\n  paymentProgramName,\n  paymentProgramType,\n  matchingPrograms:\n    !matchedProgram && matchingPrograms.length > 1\n      ? matchingPrograms\n      : undefined\n};"
          },
          "outcomes": {
            "success": "1769449448653"
          },
          "code": "FIN_AP_CODE_CORRECTING_PROGRAM_TYPE_AND_NAME",
          "id": "1774519114816",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Defaulting Node",
            "returnType": "object",
            "sourceCode": "const financingProgramBenefits =\n  $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_PAYMENT_BENEFIT_SERVICE.$output;\n\nconst priorDefaultingResults =\n  $context.$nodes.FIN_AP_CODE_CORRECTING_PROGRAM_TYPE_AND_NAME.$output.result;\n\nconst normalize = (str) => (str || \"\").toLowerCase().trim();\n\nconst mapRequestedCategoryToBenefitCategory = (category) => {\n  const normalized = normalize(category);\n\n  if (normalized === \"signed\") return \"internal\";\n  if (normalized === \"external\") return \"external\";\n  return \"all\";\n};\n\nlet paymentProgramName = priorDefaultingResults.paymentProgramName || null;\nlet paymentProgramType = priorDefaultingResults.paymentProgramType || null;\n\n// If a single program name was already defaulted, propagate it as-is.\nif (paymentProgramName) {\n  return {\n    paymentProgramName,\n    paymentProgramType\n  };\n}\n\n// Flatten ROI results from all supplier buckets\nconst allBenefitPrograms = Array.isArray(financingProgramBenefits)\n  ? financingProgramBenefits.flatMap(bucket =>\n      Array.isArray(bucket.roiResults) ? bucket.roiResults : []\n    )\n  : [];\n\nlet candidatePrograms = allBenefitPrograms;\n\n// Filter by program type if present\nif (paymentProgramType && paymentProgramType !== \"NONE\") {\n  candidatePrograms = candidatePrograms.filter(\n    p => p.programType === paymentProgramType\n  );\n}\n\n// Filter by program category if present and not ALL\nconst requestedBenefitCategory = mapRequestedCategoryToBenefitCategory(\n  priorDefaultingResults.programCategory\n);\n\nif (requestedBenefitCategory !== \"all\") {\n  candidatePrograms = candidatePrograms.filter(\n    p => normalize(p.programCategory) === requestedBenefitCategory\n  );\n}\n\nlet bestProgram = null;\nlet bestBenefit = -Infinity;\n\nfor (const program of candidatePrograms) {\n  const totalBenefit = Number(program.totalBenefit);\n\n  if (!Number.isFinite(totalBenefit)) {\n    continue;\n  }\n\n  if (bestProgram === null || totalBenefit > bestBenefit) {\n    bestBenefit = totalBenefit;\n    bestProgram = program;\n    continue;\n  }\n\n  if (totalBenefit === bestBenefit) {\n    const currentName = normalize(program.programName);\n    const bestName = normalize(bestProgram.programName);\n\n    if (currentName < bestName) {\n      bestProgram = program;\n    }\n  }\n}\n\nif (bestProgram) {\n  paymentProgramName = bestProgram.programName || null;\n  paymentProgramType = bestProgram.programType || paymentProgramType;\n}\n\nreturn {\n  paymentProgramName,\n  paymentProgramType\n};"
          },
          "outcomes": {
            "success": "1769450532100"
          },
          "code": "FIN_AP_CODE_DEFAULTING_NODE",
          "id": "1780642114965",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
