          },
          "code": "FIN_AP_RETURN_FOLLOW_UP_RESPONSE",
          "id": "1769522067648",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check if payment program present",
            "returnType": "boolean",
            "sourceCode": "let correctedOutput =\n  $context.$nodes.FIN_AP_CODE_CORRECTING_PROGRAM_TYPE_AND_NAME.$output.result;\n\nlet userAskedProgram = correctedOutput.paymentProgramName;\nlet matchingPrograms = correctedOutput.matchingPrograms;\n\nlet availablePrograms =\n  $context.$nodes.FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM.$output.result.allPrograms;\n\n// remove SUPPLY_CHAIN_FINANCING\navailablePrograms = availablePrograms.filter(\n  program => program.financingProgramType !== \"SUPPLY_CHAIN_FINANCING\"\n);\n\nlet isProgramAvailable = false;\n\n// Case 1: Multiple matching programs returned\nif (Array.isArray(matchingPrograms) && matchingPrograms.length > 0) {\n  isProgramAvailable = matchingPrograms.every(mp =>\n    availablePrograms.some(\n      ap => ap.financingProgramName === mp.financingProgramName\n    )\n  );\n}\n\n// Case 2: Single program name returned\nelse if (userAskedProgram) {\n  isProgramAvailable = availablePrograms.some(\n    program => program.financingProgramName === userAskedProgram\n  );\n}\n\nreturn isProgramAvailable;"
          },
          "outcomes": {
            "success": "1769449622939"
          },
          "code": "FIN_AP_CODE_CHECK_IF_PAYMENT_PROGRAM_PRESENT",
          "id": "1769592592908",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Add node for branch 1",
            "name": "Add 1"
          },
          "outcomes": {
            "success": "1769413828345"
          },
          "id": "add_1769413491393_2",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Process Signed Financing Program",
            "returnType": "object",
            "sourceCode": "// Get signed financing programs\nconst data = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_GET_SIGNED_FINANCING_PROGRAMS.$output;\nconst signedPrograms = (data.items || []).map(item => {\n  const obj = {\n    financingProgramId: item.financingProgramId,\n    financingProgramName: item.name,\n    financingProgramType: item.financingOptionTypeCode,\n    financingProgramCode: item.financingProgramCode,\n    financingProgramCategory: \"SIGNED\"\n  };\n\n  if (item.maximumDiscountRate !== undefined) obj.maxAPR = item.maximumDiscountRate;\n  if (item.minimumDiscountRate !== undefined) obj.minAPR = item.minimumDiscountRate;\n  if (item.defaultDiscountRate !== undefined) obj.defaultAPR = item.defaultDiscountRate;\n  if (item.defaultCurrencyCode !== undefined) obj.defaultCurrencyCode = item.defaultCurrencyCode;\n\n  return obj;\n});\n\nconst signedProgramsByCode = new Map(\n  signedPrograms.map(program => [program.financingProgramCode, program])\n);\n\n// Get and normalize RAG programs\nconst ragOutput = $context.$nodes.FIN_AP_LLM_RAG_OUTPUT_PROCESSING_AGENT.$output.ragDocument ?? [];\n\nconst externalPrograms = [];\nfor (const item of ragOutput) {\n  const ragProgram = {\n    financingProgramName: item.financingProgramName,\n    financingProgramType: item.financingProgramType,\n    financingProgramCode: item.financingProgramCode,\n    defaultAPR: item.defaultAPR,\n    marketBorrowingInterestRate: item.marketBorrowingInterestRate,\n    marketShortTermInvestmentInterestRate: item.marketShortTermInvestmentInterestRate,\n    instruments: item.instruments\n  };\n\n  // Remove undefined fields\n  Object.keys(ragProgram).forEach(key => {\n    if (ragProgram[key] === undefined) delete ragProgram[key];\n  });\n\n  const signedMatch = signedProgramsByCode.get(ragProgram.financingProgramCode);\n\n  if (signedMatch) {\n    // Enrich signed program without changing its category\n    for (const [key, value] of Object.entries(ragProgram)) {\n      if (signedMatch[key] === undefined) {\n        signedMatch[key] = value;\n      }\n    }\n  } else {\n    // Unique to RAG only => EXTERNAL\n    externalPrograms.push({\n      ...ragProgram,\n      financingProgramCategory: \"EXTERNAL\"\n    });\n  }\n}\n\n// Combine signed + unique external programs\nconst allPrograms = signedPrograms.concat(externalPrograms);\n\n// Sort both arrays\nconst sortByIdDesc = (a, b) => (Number(b.financingProgramId) || 0) - (Number(a.financingProgramId) || 0);\n\nallPrograms.sort(sortByIdDesc);\nsignedPrograms.sort(sortByIdDesc);\n\n// Return both\nreturn {\n  allPrograms,\n  signedPrograms\n};"
          },
          "outcomes": {
            "success": "1774519114816"
          },
          "code": "FIN_AP_CODE_PROCESS_SIGNED_FINANCING_PROGRAM",
          "convergenceTargetId": "1769449448653",
          "id": "1769413666759",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
