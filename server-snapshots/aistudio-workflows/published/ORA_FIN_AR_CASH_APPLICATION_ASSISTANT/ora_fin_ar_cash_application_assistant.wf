           \"description\": \"Payment channel used for the receipt, currently populated as ACH\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"bankAccount\",\n                    \"description\": \"Receiving bank account name and account number where the payment was deposited\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"originatorName\",\n                    \"description\": \"Name of the payment sender from remittance advice or, if unavailable, the receipt customer name\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"remittanceReference\",\n                    \"description\": \"Best available remittance reference derived from structured payment reference, invoice reference, customer reference, purchase order, sales order, contract number, balance forward bill number, or waybill number\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"checkNumber\",\n                    \"description\": \"Check number from the remittance advice when the payment was made by check\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"lockboxBatch\",\n                    \"description\": \"Receipt batch name used as the closest available lockbox batch identifier\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"amount\",\n                    \"description\": \"Payment amount from the remittance advice, or the receipt amount if bank-side amount is unavailable\",\n                    \"dataType\": \"Decimal\"\n                },\n                {\n                    \"attributeName\": \"currency\",\n                    \"description\": \"Currency code of the receipt or bank transaction\",\n                    \"dataType\": \"String\"\n                }\n            ]\n        },\n        {\n            \"catalogName\": \"receivablesRemittanceReferenceDetail\",\n            \"attributes\": [\n                {\n                    \"attributeName\": \"receiptNumber\",\n                    \"description\": \"Receipt number of the cash receipt associated with the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"receiptDate\",\n                    \"description\": \"Date on which the cash receipt was recorded\",\n                    \"dataType\": \"Date\"\n                },\n                {\n                    \"attributeName\": \"receiptAmount\",\n                    \"description\": \"Amount of the cash receipt associated with the remittance reference\",\n                    \"dataType\": \"Decimal\"\n                },\n                {\n                    \"attributeName\": \"transactionNumber\",\n                    \"description\": \"Transaction number matched or referenced by the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"invoiceReference\",\n                    \"description\": \"Invoice reference captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"purchaseOrderNumber\",\n                    \"description\": \"Purchase order number captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"waybillNumber\",\n                    \"description\": \"Waybill number captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"salesOrder\",\n                    \"description\": \"Sales order number captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"contractNumber\",\n                    \"description\": \"Contract number captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"balanceFwdBillNumber\",\n                    \"description\": \"Balance forward bill number captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"structuredPaymentReference\",\n                    \"description\": \"Structured payment reference captured on the remittance reference\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"receiptReferenceStatus\",\n                    \"description\": \"Status of the remittance reference used to indicate whether the reference is already applied or still open for matching\",\n                    \"dataType\": \"String\",\n                    \"allowedValues\": [\n                        {\n                            \"code\": \"INV_APPLIED\",\n                            \"meaning\": \"Closed\"\n                        },\n                        {\n                            \"code\": \"NOT_MATCHED\",\n                            \"meaning\": \"Open\"\n                        }\n                    ]\n                }\n            ]\n        },{\n  \"catalogName\": \"receivablesRemittanceAdviceDetail\",\n  \"attributes\": [\n    {\n      \"attributeName\": \"receiptNumber\",\n      \"description\": \"Receipt number of the cash receipt linked to the remittance advice. This