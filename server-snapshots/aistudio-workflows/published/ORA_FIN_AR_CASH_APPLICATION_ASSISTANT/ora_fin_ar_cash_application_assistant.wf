        {
          "metadata": {
            "name": "receiptsummaryOutput",
            "returnType": "object",
            "sourceCode": "// ---Inputs---\nconst result = $context.$nodes.DATAROLLUP.$output.result || {};\n\n//const summary =\nconst summary = $context.$nodes.SUMMARIZERECEIPT.$output.summary;\nconst data = $context.$nodes.DATAROLLUP.$output;\nconst filterText = $context.$nodes.SUMMARIZERECEIPT.$output.filterText;\n// result.filterText || $context.$variables.chatcontext.semantic_rewrite;\nconst suggestions = $context.$nodes.SUMMARIZERECEIPT.$output.suggestions;\n\n// ---Resolve data rows---\nlet dataItems = Array.isArray(result.data)\n  ? result.data\n  : [];\n\nfunction isUniformNonBlankField(rows, fieldName) {\n  if (!Array.isArray(rows) || rows.length === 0) return false;\n\n  const firstValue = rows[0]?.[fieldName];\n\n  if (firstValue == null || String(firstValue).trim() === \"\") {\n    return false;\n  }\n\n  return rows.every(row => String(row?.[fieldName] ?? \"\") === String(firstValue));\n}\n\nfunction removeUniformScopeColumns(rows) {\n  if (!Array.isArray(rows) || rows.length === 0) return [];\n\n  const fieldsToSuppress = [\n    \"CUSTOMERNAME\",\n    \"CUSTOMERACCOUNTNUMBER\",\n    \"BUSINESSUNITNAME\"\n  ].filter(fieldName => isUniformNonBlankField(rows, fieldName));\n\n  if (fieldsToSuppress.length === 0) {\n    return rows;\n  }\n\n  return rows.map(row => {\n    const copy = { ...row };\n\n    fieldsToSuppress.forEach(fieldName => {\n      delete copy[fieldName];\n    });\n\n    return copy;\n  });\n}\n\ndataItems = removeUniformScopeColumns(dataItems);\n\nconst isEmpty = dataItems.length === 0;\n\n// ---Resolve application rows---\nconst applicationItems = Array.isArray(result.application)\n  ? result.application\n  : [];\n\nconst hasApplication = applicationItems.length > 0;\n\n// ---Resolve remittance/reference rows---\nconst remitRefItems = Array.isArray(result.remitref)\n  ? result.remitref\n  : [];\n\nconst hasRemitRef = remitRefItems.length > 0;\n\n// ---Resolve summary text---\nconst summaryText = (\n  typeof summary === \"string\"\n    ? summary\n    : summary?.text || summary?.result || summary?.message || \"\"\n) || \"\";\n\n// ---Resolve filters text---\nconst filtersText = (\n  typeof filterText === \"string\"\n    ? filterText\n    : filterText?.text || filterText?.result || filterText?.message || \"\"\n) || \"\";\n\n// ---Escape HTML for safe suggestions rendering---\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\n// ---Resolve suggestions HTML---\n// Always normalize suggestions into <ul><li>...</li></ul>\nlet suggestionsHtml = \"\";\n\nif (Array.isArray(suggestions) && suggestions.length > 0) {\n  const items = suggestions\n    .filter(Boolean)\n    .map(s => String(s).replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n} else if (typeof suggestions === \"string\" && suggestions.trim()) {\n  const rawSuggestions = suggestions.trim();\n\n  if (/^\\s*<ul[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = rawSuggestions;\n  } else if (/^\\s*<li[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = \"<ul>\" + rawSuggestions + \"</ul>\";\n  } else {\n    const items = rawSuggestions\n      .split(/\\n+/)\n      .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n      .filter(Boolean);\n\n    if (items.length > 0) {\n      suggestionsHtml =\n        \"<ul>\" +\n        items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n        \"</ul>\";\n    }\n  }\n} else if (suggestions?.text || suggestions?.result || suggestions?.message) {\n  const rawSuggestions = String(\n    suggestions.text || suggestions.result || suggestions.message || \"\"\n  ).trim();\n\n  const items = rawSuggestions\n    .split(/\\n+/)\n    .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n}\n\n// ---GUARD: No data, no summary, no filter, no suggestions---\nif (!summaryText && !filtersText && isEmpty && !hasApplication && !hasRemitRef && !suggestionsHtml) {\n  return {\n    messages: [\n      {\n        id: \"no_data\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"Return a short standalone message. Do not include a title.\",\n        data: \"No data found.\"\n      }\n    ]\n  };\n}\n\n// ---Build messages array---\n// Order:\n// 1. Summary - text\n// 2. Filter - text\n// 3. Data - table\n// 4. Suggestion - text\n\nconst messages = [];\n\n// 1. Summary text\nif (summaryText) {\n  messages.push({\n    id: \"summary\",\n    type: \"text\",\n    contentPolicy: \"preserve\",\n    authoringHints: \"Display as is. Render any HTML bulleted list. Do not summarize or rewrite.\",\n    data: summaryText\n  });\n}\n\n// 2. Filter text\nif (filtersText && !isEmpty) {\n  messages.push({\n    id: \"filters\",\n    type: \"text\",\n    contentPolicy: \"preserve\",\n    authoringHints: \"Do not summarize, display as is.\",\n    data: filtersText\n  });\n}\n\n// 3. Data table\nif (!isEmpty) {\n  messages.push({\n    id: \"details_table\",\n    type: \"table\",\n    title: \"Receipts\",\n    authoringHints: \"List of records. Exclude the currency column from the output.\",\n    data: dataItems.slice(0,100),\n    chatDisplayConfig: {\n      limitRowsInChat: true,\n      rowLimit: 10\n    }\n  });\n}\n\nif (hasApplication) {\n  messages.push({\n    id: \"application_table\",\n    type: \"table\",\n    title: \"Receipt Application\",\n    authoringHints: \"List of receipt applications for the receipt.\",\n    data: applicationItems,\n    chatDisplayConfig: {\n      limitRowsInChat: true,\n      rowLimit: 10\n    }\n  });\n}\n\nif (hasRemitRef) {\n  messages.push({\n    id: \"remittance_reference_table\",\n    type: \"table\",\n    title: \"Remittance Advice / Reference\",\n    authoringHints: \"List of remittance advice or reference details associated with the receipt.\",\n    data: remitRefItems,\n    chatDisplayConfig: {\n      limitRowsInChat: true,\n      rowLimit: 10\n    }\n  });\n}\n\n// 4. Suggestions text\nif (suggestionsHtml) {\n  messages.push({\n    id: \"suggestions\",\n    type: \"text\",\n    title: \"Suggestions\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Display as HTML bulleted list. Do not summarize or rewrite.\",\n    data: suggestionsHtml\n  });\n}\n\nreturn {\n  messages\n};"
          },
