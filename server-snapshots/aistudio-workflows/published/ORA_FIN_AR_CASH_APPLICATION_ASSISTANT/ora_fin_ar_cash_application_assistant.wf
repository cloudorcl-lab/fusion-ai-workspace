        {
          "metadata": {
            "name": "applyshapepreparation",
            "returnType": "object",
            "sourceCode": "function buildApplicationShapes() {\n  const inv    = $context.$variables.chatcontext.entities_extracted.invoice_number;\n  const rcpt   = $context.$variables.chatcontext.entities_extracted.receipt_Number;\n  const dsVar  = $context.$variables.datashapes;\n\n  // Parse if string\n  const parsed = typeof dsVar === \"string\" ? JSON.parse(dsVar) : dsVar;\n  const shapes = parsed.data_shapes || [];\n\n  // Target shape names\n  const targetNames = [\"invoiceapplyprep\", \"receptapplyprep\"];\n\n  // Build lookup map\n  const shapeMap = {};\n  for (const shape of shapes) {\n    shapeMap[shape.name] = shape.value;\n  }\n\n  const result = targetNames.map((name) => {\n    const value = shapeMap[name];\n\n    if (!value) {\n      return { name, error: `Shape '${name}' not found` };\n    }\n\n    // Replace placeholders in select statement\n    let resolvedSelect = value.select;\n\n    if (name === \"invoiceapplyprep\" && inv) {\n      resolvedSelect = resolvedSelect.replace(/dummyinv_num/g, `'${inv}'`);\n    }\n\n    if (name === \"receptapplyprep\" && rcpt) {\n      resolvedSelect = resolvedSelect.replace(/dummyrec_num/g, `'${rcpt}'`);\n    }\n\n    return {\n      name,\n      value: {\n        select: resolvedSelect,\n        viewQueries: value.viewQueries\n      }\n    };\n  });\n\n  return result;\n}\n\nconst output = buildApplicationShapes();\nreturn output;"
          },
          "outcomes": {
            "success": "1776996989635"
          },
