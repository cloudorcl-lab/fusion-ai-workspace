              "scope": "JOB",
              "type": "object",
              "value": "{\n    \"data_shapes\": [\n        {\n            \"name\": \"receivablesPaymentSchedule\",\n            \"value\": {\n                \"select\": \"select customerName,customerAccountNumber,transactionNumber,installmentDueDate,amountRemaining,originalAmount,invoiceCurrencyCode,businessUnitName FROM receivablesPaymentSchedule order by amountRemaining desc FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"receivablesPaymentSchedule\": {\n                        \"module\": \"oraErpCoreReceivablesBilling\",\n                        \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n                        \"view\": \"receivablesPaymentSchedule\",\n                        \"fieldAliases\": {\n                            \"paymentScheduleId\": \"paymentScheduleId\",\n                            \"installmentDueDate\": \"installmentDueDate\",\n                            \"transactionDate\": \"transactionDate\",\n                            \"amountApplied\": \"amountApplied\",\n                            \"originalAmount\": \"originalAmount\",\n                            \"amountRemaining\": \"amountRemaining\",\n                            \"amountOnAccount\": \"amountOnAccount\",\n                            \"transactionNumber\": \"transactionNumber\",\n                            \"conversionDate\": \"conversionDate\",\n                            \"conversionRate\": \"conversionRate\",\n                            \"disputeAmount\": \"disputeAmount\",\n                            \"installmentClass\": \"installmentClass\",\n                            \"installmentStatus\": \"installmentStatus\",\n                            \"excludeFromDunning\": \"excludeFromDunning\",\n                            \"numberOfInstallments\": \"numberOfInstallments\",\n                            \"accountedBalanceDue\": \"accountedBalanceDue\",\n                            \"dunningLevel\": \"dunningLevel\",\n                            \"dunningLevelOverrideDate\": \"dunningLevelOverrideDate\",\n                            \"accountingDate\": \"accountingDate\",\n                            \"closedAccountingDate\": \"closedAccountingDate\",\n                            \"actualClosedDate\": \"actualClosedDate\",\n                            \"lateChargeDate\": \"lateChargeDate\",\n                            \"excludeFromConsolidatedInvoice\": \"excludeFromConsolidatedInvoice\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"timeUpdated\": \"timeUpdated\",\n                            \"amountAdjusted\": \"amountAdjusted\",\n                            \"amountCredited\": \"amountCredited\",\n                            \"originalFreightAmount\": \"originalFreightAmount\",\n                            \"freightBalanceDue\": \"freightBalanceDue\",\n                            \"originalTaxAmount\": \"originalTaxAmount\",\n                            \"taxRemainingAmount\": \"taxRemainingAmount\",\n                            \"earnedDiscount\": \"earnedDiscount\",\n                            \"unearnedDiscount\": \"unearnedDiscount\",\n                            \"amountOtherAccount\": \"amountOtherAccount\",\n                            \"pendingAdjustmentAmount\": \"pendingAdjustmentAmount\",\n                            \"disputeDate\": \"disputeDate\",\n                            \"sequence\": \"sequence\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customer.id\": \"customerId\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"customerAccount.customer.registryId\": \"customerRegistryId\",\n                            \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n                            \"customerTransaction.intercompany\": \"customerTransactionIntercompany\",\n                            \"customerTransaction.createdFromApplication\": \"customerTransactionCreatedFromApplication\",\n                            \"customerTransaction.printPending\": \"customerTransactionPrintPending\",\n                            \"customerTransaction.billTemplateName\": \"customerTransactionBillTemplateName\",\n                            \"customerTransaction.firstPrintDate\": \"customerTransactionFirstPrintDate\",\n                            \"customerTransaction.lastPrintingDate\": \"customerTransactionLastPrintingDate\",\n                            \"customerTransaction.printCount\": \"customerTransactionPrintCount\",\n                            \"customerTransaction.sourceSystem\": \"customerTransactionSourceSystem\",\n                            \"customerTransaction.payingCustomerAccount.customerAccountId\": \"payingCustomerAccountId\",\n                            \"customerTransaction.payingCustomerAccount.accountNumber\": \"payingCustomerAccountNumber\",\n                            \"customerTransaction.payingCustomerAccount.customer.id\": \"payingCustomerPartyId\",\n                            \"customerTransaction.payingCustomerAccount.customer.name\": \"payingCustomerPartyName\",\n                            \"customerTransaction.payingCustomerAccount.customer.registryId\": \"payingCustomerPartyRegistryId\",\n                            \"customerTransaction.payingCustomerSiteUse.siteUseId\": \"payingSiteUseId\",\n                            \"customerTransaction.payingCustomerSiteUse.customerAccountSite.customerAccountSiteId\": \"payingCustomerAccountSiteId\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"legalEntity.legalEntityId\": \"legalEntityId\",\n                            \"legalEntity.legalEntityName\": \"legalEntityName\",\n                            \"legalEntity.legalEntityIdentifier\": \"legalEntityIdentifier\",\n                            \"delinquency.delinquencyId\": \"delinquencyId\",\n                            \"delinquency.statusLookup.lookupType\": \"delinquencyStatusLookupType\",\n                            \"delinquency.statusLookup.meaning\": \"delinquencyStatusMeaning\",\n                            \"customerSiteUse.siteUseId\": \"siteUseId\",\n                            \"customerTransactionType.customerTransactionTypeSequenceId\": \"customerTransactionTypeSequenceId\",\n                            \"customerTransactionType.name\": \"customerTransactionTypeName\",\n                            \"paymentTerm.termId\": \"paymentTermId\",\n                            \"paymentTerm.name\": \"paymentTermName\",\n                            \"receivablesPaymentSchedulePrediction.id\": \"predictionId\",\n                            \"receivablesPaymentSchedulePrediction.predictedPaymentDate\": \"predictedPaymentDate\",\n                            \"receivablesPaymentSchedulePrediction.timeUpdated\": \"predictionTimeUpdated\",\n                            \"receivablesPaymentSchedulePrediction.timeCreated\": \"predictionTimeCreated\",\n                            \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"receivablesReceiptDetail\",\n            \"value\": {\n                \"select\": \"SELECT customerName, customerAccountNumber, receiptNumber, receiptDate, (-1 * amountRemaining) AS AmountRemaining,receiptCurrencyCode receiptCurrency,businessUnitName FROM ReceivablesReceiptDetail order by AmountRemaining desc FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"ReceivablesReceiptDetail\": {\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"cashReceiptId\": \"cashReceiptId\",\n                            \"receiptDate\": \"receiptDate\",\n                            \"depositDate\": \"depositDate\",\n                            \"receiptNumber\": \"receiptNumber\",\n                            \"type\": \"type\",\n                            \"conversionRate\": \"conversionRate\",\n                            \"conversionDate\": \"conversionDate\",\n                            \"status\": \"cashReceiptStatus\",\n                            \"receiptAmount\": \"receiptAmount\",\n                            \"reversalDate\": \"reversalDate\",\n                            \"reversalCategory\": \"reversalCategory\",\n                            \"reversalComments\": \"reversalComments\",\n                            \"anticipatedClearingDate\": \"anticipatedClearingDate\",\n                            \"documentNumber\": \"documentNumber\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"timeUpdated\": \"timeUpdated\",\n                            \"actualValueDate\": \"actualValueDate\",\n                            \"postmarkDate\": \"postmarkDate\",\n                            \"factorDiscountAmount\": \"factorDiscountAmount\",\n                            \"isSelectedForFactoring\": \"isSelectedForFactoring\",\n                            \"recommendationCount\": \"recommendationCount\",\n                            \"currentCashReceiptHistory.transactionDate\": \"statusDate\",\n                            \"currentCashReceiptHistory.status\": \"receiptStatus\",\n                            \"currentCashReceiptHistory.currentRecord\": \"currentCashReceiptHistoryCurrentRecord\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"receiptBatch.name\": \"receiptBatchName\",\n                            \"receiptBatch.batchDate\": \"receiptBatchDate\",\n                            \"bankAccountUse.bankAccount.name\": \"bankAccountName\",\n                            \"bankAccountUse.bankAccount.accountNumber\": \"bankAccountNumber\",\n                            \"bankAccountUse.bankAccount.bankBranch.name\": \"bankBranchName\",\n                            \"bankAccountUse.bankAccount.bankBranch.bank.name\": \"bankName\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n                            \"paymentSchedule.installmentStatus\": \"receiptInternalStatus\",\n                            \"paymentSchedule.amountRemaining\": \"amountRemaining\",\n                            \"paymentSchedule.amountRemainingOffset\": \"amountRemainingOffset\",\n                            \"paymentSchedule.amountOtherAccount\": \"amountOtherAccount\",\n                            \"paymentSchedule.amountOnAccount\": \"amountOnAccount\",\n                            \"statementLine.id\": \"statementLineId\",\n                            \"statementLine.additionalEntryInformation\": \"statementLineAdditionalEntryInformation\",\n                            \"statementLine.checkNumber\": \"statementLineCheckNumber\",\n                            \"statementLine.structuredPaymentReference\": \"statementLineStructuredPaymentReference\",\n                            \"statementLine.bookingDate\": \"statementLineBookingDate\",\n                            \"receiptCurrency.currencyCode\": \"receiptCurrencyCode\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"collectionPromises\",\n            \"value\": {\n                \"select\": \"SELECT paysched.customerName, paysched.customerAccountNumber,promise.promiseDate, promise.promiseAmount, promise.transactionNumber, paysched.amountRemaining, paysched .invoiceCurrencyCode,paysched .businessUnitName FROM promiseDetail promise, receivablesPaymentSchedule paysched WHERE promise.paymentScheduleId = paysched.paymentScheduleId and promise.state = 'PROMISE' order by promise.promiseAmount desc FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"promiseDetail\": {\n                        \"module\": \"oraErpCoreAdvancedCollections\",\n                        \"businessObject\": \"CustomerPromiseDetail\",\n                        \"view\": \"collectionsPaymentPromise\",\n                        \"fieldAliases\": {\n                            \"promiseDetailId\": \"promiseDetailId\",\n                            \"promiseDate\": \"promiseDate\",\n                            \"promiseAmount\": \"promiseAmount\",\n                            \"promisePaymentMethod\": \"promisePaymentMethod\",\n                            \"promiseBrokenDate\": \"promiseBrokenDate\",\n                            \"remainingAmount\": \"remainingAmount\",\n                            \"timeUpdated\": \"timeUpdated\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"createdBy\": \"createdBy\",\n                            \"updatedBy\": \"updatedBy\",\n                            \"state\": \"state\",\n                            \"delinquency.delinquencyId\": \"delinquencyId\",\n                            \"delinquency.paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n                            \"delinquency.paymentSchedule.transactionNumber\": \"transactionNumber\"\n                        }\n                    },\n                    \"receivablesPaymentSchedule\": {\n                        \"module\": \"oraErpCoreReceivablesBilling\",\n                        \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n                        \"view\": \"receivablesPaymentSchedule\",\n                        \"fieldAliases\": {\n                            \"paymentScheduleId\": \"paymentScheduleId\",\n                            \"installmentDueDate\": \"installmentDueDate\",\n                            \"originalAmount\": \"originalAmount\",\n                            \"amountRemaining\": \"amountRemaining\",\n                            \"transactionNumber\": \"transactionNumber\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customer.id\": \"customerId\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"receivablesInvoiceMatch\",\n            \"value\": {\n                \"select\": \"select rcpt.customerName, rcpt.customerAccountNumber, rcpt.receiptNumber as receiptNumber, invps.transactionNumber as invoiceNumber,rcpt.businessUnitName, (-1 * rcpt.receiptAmount) as receiptAmount, rcpt.receiptCurrencyCode as receiptCurrencyCode, invps.amountRemaining as remainingInvoiceBalance, invps.invoiceCurrencyCode as invoiceCurrencyCode,invps.installmentDueDate, round(greatest(0, (1 - abs((-1 * rcpt.receiptAmount) - invps.amountRemaining) / (-1 * rcpt.receiptAmount))) * 100, 2) as matchPercent, round(abs(((-1 * rcpt.receiptAmount) - invps.amountRemaining)) / (-1 * rcpt.receiptAmount) * 100, 2) as differencePercentage, case when (-1 * rcpt.receiptAmount) = invps.amountRemaining then '100% match, receipt amount matches invoice balance' else to_char(round(greatest(0, (1 - abs((-1 * rcpt.receiptAmount) - invps.amountRemaining) / (-1 * rcpt.receiptAmount))) * 100, 2)) || '% invoice match, amounts differ by ' || to_char(round(abs(((-1 * rcpt.receiptAmount) - invps.amountRemaining)) / (-1 * rcpt.receiptAmount) * 100, 2)) || '%' end as matchCommentary from ReceivablesReceiptDetail rcpt join receivablesPaymentSchedule invps on rcpt.customerAccountId = invps.customerAccountId and rcpt.businessUnitId = invps.businessUnitId where invps.installmentStatus = 'OP' and rcpt.receiptAmount <> 0 and invps.amountRemaining <> 0 and (-1 * rcpt.receiptAmount) <> 0 order by matchPercent desc, differencePercentage asc, invps.amountRemaining desc FETCH FIRST 100 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"receivablesPaymentSchedule\": {\n                        \"view\": \"receivablesPaymentSchedule\",\n                        \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n                        \"module\": \"oraErpCoreReceivablesBilling\",\n                        \"fieldAliases\": {\n                            \"transactionNumber\": \"transactionNumber\",\n                            \"amountRemaining\": \"amountRemaining\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"installmentStatus\": \"installmentStatus\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\",\n                            \"installmentDueDate\": \"installmentDueDate\"\n                        }\n                    },\n                    \"ReceivablesReceiptDetail\": {\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"paymentSchedule.amountRemaining\": \"receiptAmount\",\n                            \"paymentSchedule.installmentStatus\": \"receiptStatus\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"receiptNumber\": \"receiptNumber\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"receiptCurrency.currencyCode\": \"receiptCurrencyCode\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"promiseMatch\",\n            \"value\": {\n                \"viewQueries\": {\n                    \"promiseDetail\": {\n                        \"module\": \"oraErpCoreAdvancedCollections\",\n                        \"businessObject\": \"CustomerPromiseDetail\",\n                        \"view\": \"collectionsPaymentPromise\",\n                        \"fieldAliases\": {\n                            \"promiseDetailId\": \"promiseDetailId\",\n                            \"promiseDate\": \"promiseDate\",\n                            \"promiseAmount\": \"promiseAmount\",\n                            \"delinquency.paymentSchedule.transactionNumber\": \"invoiceNumber\",\n                            \"delinquency.paymentSchedule.amountRemaining\": \"remainingInvoiceBalance\",\n                            \"delinquency.paymentSchedule.installmentDueDate\": \"invoiceDueDate\",\n                            \"delinquency.paymentSchedule.customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"delinquency.paymentSchedule.businessUnit.id\": \"businessUnitId\",\n                            \"currencyCodeLookup.currencyCode\": \"promiseCurrencyCode\"\n                        }\n                    },\n                    \"ReceivablesReceiptDetail\": {\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"fieldAliases\": {\n                            \"receiptNumber\": \"receiptNumber\",\n                            \"receiptAmount\": \"receiptAmount\",\n                            \"paymentSchedule.amountRemaining\": \"rcptAmountRemaining\",\n                            \"customerAccount.customerAccountId\": \"customerAccountId\",\n                            \"businessUnit.id\": \"businessUnitId\",\n                            \"businessUnit.name\": \"businessUnitName\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"timeCreated\": \"timeCreated\",\n                            \"receiptCurrency.currencyCode\": \"receiptCurrencyCode\"\n                        }\n                    }\n                },\n                \"select\": \"select rcpt.receiptNumber as receiptNumber, rcpt.receiptAmount as receiptAmount, rcpt.receiptCurrencyCode as receiptCurrencyCode, rcpt.rcptAmountRemaining as rcptAmountRemaining, pd.promiseDate as promiseDate, pd.promiseAmount as promiseAmount, pd.promiseCurrencyCode as promiseCurrencyCode, pd.invoiceNumber as invoiceNumber, pd.remainingInvoiceBalance as remainingInvoiceBalance, pd.promiseCurrencyCode as invoiceCurrencyCode, pd.invoiceDueDate as invoiceDueDate, rcpt.businessUnitName, round(greatest(0, (1 - abs(abs(rcpt.rcptAmountRemaining) - pd.promiseAmount) / pd.promiseAmount)) * 100, 2) as matchPercent, case when abs(rcpt.rcptAmountRemaining) = pd.promiseAmount and trunc(sysdate) > trunc(pd.promiseDate) then '100% match, promise overdue by ' || to_char(trunc(sysdate) - trunc(pd.promiseDate)) || ' days' when abs(rcpt.rcptAmountRemaining) = pd.promiseAmount then '100% match, promise fulfilled' when trunc(sysdate) > trunc(pd.promiseDate) then to_char(round(greatest(0, (1 - abs(abs(rcpt.rcptAmountRemaining) - pd.promiseAmount) / pd.promiseAmount)) * 100, 2)) || '% amount match, promise overdue by ' || to_char(trunc(sysdate) - trunc(pd.promiseDate)) || ' days' else to_char(round(greatest(0, (1 - abs(abs(rcpt.rcptAmountRemaining) - pd.promiseAmount) / pd.promiseAmount)) * 100, 2)) || '% amount match' end as matchCommentary from ReceivablesReceiptDetail rcpt join promiseDetail pd on rcpt.customerAccountId = pd.customerAccountId and rcpt.businessUnitId = pd.businessUnitId where rcpt.rcptAmountRemaining is not null and pd.promiseAmount is not null and pd.remainingInvoiceBalance is not null and pd.invoiceNumber is not null order by greatest(0, (1 - abs(abs(rcpt.rcptAmountRemaining) - pd.promiseAmount) / pd.promiseAmount)) desc, case when trunc(sysdate) > trunc(pd.promiseDate) then trunc(sysdate) - trunc(pd.promiseDate) else 0 end desc FETCH FIRST 25000 ROWS ONLY\"\n            }\n        },\n        {\n            \"name\": \"receivablesRemittanceAdviceDetail\",\n            \"value\": {\n                \"select\": \"select customerName, remittanceAdviceDate, remittanceAdviceAmount, remittanceAdviceCurrencyCode from ReceivablesRemittanceAdviceDetail where UPPER(statusCode) not in ('PURGED','DUPLICATE','ERROR') order by remittanceAdviceAmount desc FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"ReceivablesRemittanceAdviceDetail\": {\n                        \"view\": \"receivablesRemittanceAdviceDetail\",\n                        \"businessObject\": \"ReceivablesRemittanceAdvice\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"cashReceipt.receiptNumber\": \"receiptNumber\",\n                            \"cashReceipt.receiptDate\": \"customerReceiptDate\",\n                            \"cashReceipt.receiptAmount\": \"receiptAmount\",\n                            \"cashReceipt.receiptCurrency.currencyCode\": \"receiptCurrencyCode\",\n                            \"customerName\": \"customerName\",\n                            \"receiptDate\": \"remittanceAdviceDate\",\n                            \"paymentAmount\": \"remittanceAdviceAmount\",\n                            \"currencyCode\": \"remittanceAdviceCurrencyCode\",\n                            \"checkNumber\": \"checkNumber\",\n                            \"depositDate\": \"depositDate\",\n                            \"comments\": \"comments\",\n                            \"customerReason\": \"customerReason\",\n                            \"customerReference\": \"customerReference\",\n                            \"customerDetails\": \"customerDetails\",\n                            \"statusCode\": \"statusCode\",\n                            \"timeCreated\": \"timeCreated\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"invoiceapplyprep\",\n            \"value\": {\n                \"select\": \"select paymentScheduleId,customerName,customerAccountNumber,transactionNumber,originalAmount,amountRemaining,installmentDueDate,invoiceCurrencyCode,businessUnitName FROM receivablesPaymentSchedule where transactionNumber = dummyinv_num FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"receivablesPaymentSchedule\": {\n                        \"module\": \"oraErpCoreReceivablesBilling\",\n                        \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n                        \"view\": \"receivablesPaymentSchedule\",\n                        \"fieldAliases\": {\n                            \"paymentScheduleId\": \"paymentScheduleId\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"installmentDueDate\": \"installmentDueDate\",\n                            \"originalAmount\": \"originalAmount\",\n                            \"amountRemaining\": \"amountRemaining\",\n                            \"transactionNumber\": \"transactionNumber\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\",\n                            \"businessUnit.name\": \"businessUnitName\"\n                        }\n                    }\n                }\n            }\n        },\n        {\n            \"name\": \"receptapplyprep\",\n            \"value\": {\n                \"select\": \"SELECT cashReceiptId,customerName,customerAccountNumber,receiptNumber,receiptDate,(-1 * amountRemaining) AS AmountRemaining,receiptCurrencyCode,businessUnitName FROM ReceivablesReceiptDetail where receiptNumber= dummyrec_num FETCH FIRST 25000 ROWS ONLY\",\n                \"viewQueries\": {\n                    \"ReceivablesReceiptDetail\": {\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"cashReceiptId\": \"cashReceiptId\",\n                            \"customerAccount.customer.name\": \"customerName\",\n                            \"receiptCurrency.currencyCode\": \"receiptCurrencyCode\",\n                            \"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"receiptDate\": \"receiptDate\",\n                            \"receiptNumber\": \"receiptNumber\",\n                            \"paymentSchedule.amountRemaining\": \"amountRemaining\",\n                            \"businessUnit.name\": \"businessUnitName\"\n                        }\n                    }\n                }\n            }\n        }\n    ]\n}"
            }
          ],
          "type": "SET_FIELDS"
        },
