        {
          "metadata": {
            "name": "getshapeandcatalog",
            "returnType": "object",
            "sourceCode": "// Combined: read chatcontext, filter data_shapes and\n// attribute_catalogs to the selected shapes, extract the\n// `select` query from each shape's value, and emit payload.\n\n\n// 0. Debug trace\nvar debug = \"\";\ndebug += \"available vars: \" + Object.keys($context.$variables).join(\",\") + \"\\n\";\n\n// 1. Pull intent/shapes/semantic_rewrite from chatcontext\nvar ctx = $context.$variables.chatcontext;\ndebug += \"chatcontext: \" + (ctx ? \"OK\" : \"MISSING\") + \"\\n\";\ndebug += \"chatcontext type: \" + typeof ctx + \"\\n\";\n\nvar intent = ctx ? ctx.intent_code : null;\ndebug += \"intent_code: \" + (intent ? intent : \"MISSING\") + \"\\n\";\n\nvar shapes = (ctx && ctx.shapes) ? ctx.shapes : [];\ndebug += \"shapes: \" + (shapes.length > 0 ? \"OK (\" + shapes.length + \")\" : \"EMPTY\") + \"\\n\";\n\nvar semantic_rewrite = ctx ? ctx.semantic_rewrite : null;\ndebug += \"semantic_rewrite: \" + (semantic_rewrite ? \"OK\" : \"MISSING\") + \"\\n\";\n\n// 2. Load full catalogs from workflow variables\nvar dsVar = $context.$variables.datashapes;\ndebug += \"datashapes var: \" + (dsVar ? \"OK\" : \"MISSING\") + \"\\n\";\nvar dataShapes = (dsVar && dsVar.data_shapes) ? dsVar.data_shapes : [];\ndebug += \"data_shapes: \" + (dataShapes.length > 0 ? \"OK (\" + dataShapes.length + \")\" : \"EMPTY\") + \"\\n\";\n\nvar acVar = $context.$variables.attributecatalog;\ndebug += \"attributecatalog var: \" + (acVar ? \"OK\" : \"MISSING\") + \"\\n\";\nvar attributeCatalogs = (acVar && acVar.attribute_catalogs) ? acVar.attribute_catalogs : [];\ndebug += \"attribute_catalogs: \" + (attributeCatalogs.length > 0 ? \"OK (\" + attributeCatalogs.length + \")\" : \"EMPTY\") + \"\\n\";\n\n// 3. Filter data_shapes by name and return name + value + select\n//    Also build a convenience map of shape name -> select query.\nvar filteredDataShapes = [];\nvar selectQueries = {};\nvar primarySelect = null; // first non-empty select, handy for single-shape intents\n\nfor (var i = 0; i < dataShapes.length; i++) {\n  for (var j = 0; j < shapes.length; j++) {\n    if (dataShapes[i].name === shapes[j]) {\n      var val = dataShapes[i].value;\n\n      // Defensive extraction: value may be missing, or select may be absent.\n      var selectQuery = null;\n      if (val && typeof val === \"object\" && typeof val.select === \"string\") {\n        selectQuery = val.select;\n      }\n\n      // Also pull the return columns and viewQueries if present — the planner\n      // often wants these alongside the select.\n      var returnCols = (val && val[\"return\"]) ? val[\"return\"] : null;\n      var viewQueries = (val && val.viewQueries) ? val.viewQueries : null;\n\n      filteredDataShapes.push({\n        name: dataShapes[i].name,\n        value: val,\n        select: selectQuery,\n        return: returnCols,\n        viewQueries: viewQueries\n      });\n\n      if (selectQuery) {\n        selectQueries[dataShapes[i].name] = selectQuery;\n        if (primarySelect === null) {\n          primarySelect = selectQuery;\n        }\n      }\n\n      break;\n    }\n  }\n}\ndebug += \"filteredDataShapes: \" + filteredDataShapes.length + \"\\n\";\ndebug += \"selectQueries extracted: \" + Object.keys(selectQueries).length + \"\\n\";\ndebug += \"primarySelect: \" + (primarySelect ? \"OK\" : \"MISSING\") + \"\\n\";\n\n// 4. Filter attribute_catalogs to only those referenced in shapes[]\nvar filteredAttributeCatalogs = [];\nfor (var i = 0; i < attributeCatalogs.length; i++) {\n  for (var j = 0; j < shapes.length; j++) {\n    if (attributeCatalogs[i].catalogName === shapes[j]) {\n      filteredAttributeCatalogs.push(attributeCatalogs[i]);\n      break;\n    }\n  }\n}\ndebug += \"filteredAttributeCatalogs: \" + filteredAttributeCatalogs.length + \"\\n\";\n\n// 5. Return consolidated payload for the downstream planner\nreturn {\n  intent: intent,\n  shapes: shapes,\n  semantic_rewrite: semantic_rewrite,\n  data_shapes: filteredDataShapes,\n  attribute_catalogs: filteredAttributeCatalogs,\n  select_queries: selectQueries,   // map: shape name -> select SQL\n  select: primarySelect,           // first select, convenient for single-shape intents\n  debug: debug\n};"
          },
          "outcomes": {
            "success": "1775973741247"
          },
          "code": "GETSHAPEANDCATALOG",
          "convergenceTargetId": "1776994192972",
          "id": "1775961696046",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "generatebql"
          },
          "outcomes": {
            "success": "1776969548370"
          },
          "code": "GENERATEBQL",
          "convergenceTargetId": "1776994192972",
          "id": "1775973741247",
          "inputs": [
            {
              "id": "1775973741251_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert Oracle BOSS / BQL select-statement rewriter operating in PRODUCTION MODE.\n\nYour task is NOT to create an extract.\nYour task is NOT to return an extract.\nYour task is NOT to inspect or reconstruct a shape.\nYour task is to take the provided current top-level `select` statement, read the business request, use the provided `attribute_catalogs` to determine the correct filterable and projectable query attributes, and return only the rewritten top-level `select` statement string with:\n- the correct `WHERE` clause additions for the user's business request, AND\n- any additional projection columns required to answer the user's business request\n\nYou will receive exactly 3 inputs:\n\n1. `semantic_rewrite` — {{$context.$variables.chatcontext.semantic_rewrite}}\n2. `attribute_catalogs` — {{$context.$nodes.GETSHAPEANDCATALOG.$output.result.attribute_catalogs}}\n3. `select_queries` — {{$context.$nodes.GETSHAPEANDCATALOG.$output.result.select_queries}}\n\n==================================================\nMISSION\n==================================================\n\nStart from the provided current top-level `select` statement as the executable source of truth.\n\nThe current `select` may already contain:\n- an existing default `WHERE` clause\n- an existing `GROUP BY`\n- an existing `ORDER BY`\n- existing scoping predicates\n- existing default filters\n- an existing list of projection columns\n\nYour job is only to:\n- read `semantic_rewrite`\n- use `attribute_catalogs` to determine which business attribute each requested filter or required projection belongs to\n- use `attribute_catalogs` to resolve that business attribute to a legal executable field / alias / expression\n- confirm that the resolved field / alias / expression is safely compatible with the current `select`\n- **if no `WHERE` clause exists:** add a new `WHERE` clause with all filters needed to satisfy the user's business request\n- **if a `WHERE` clause already exists:** append new filter predicates using `AND` only — never remove, replace, reorder, or rewrite any existing predicate\n- add missing projection columns to the current top-level `SELECT` list **at the beginning, with explicit aliases**, when the request requires them\n- preserve every original `GROUP BY` expression exactly — never add, remove, replace, or reorder any `GROUP BY` expression under any circumstance\n- preserve the existing `ORDER BY` exactly — never modify, add, or remove `ORDER BY` under any circumstance\n- return only the rewritten top-level `select` statement string\n- if no attribute in `ATTRIBUTE_CATALOGS` can answer any part of the user's business request, do NOT modify the query and return `CURRENT_SELECT` unchanged\n\nPrimary goals:\n- answer the user's business request exactly as captured in `semantic_rewrite`\n- ensure every user-stated filter becomes a new appended `AND` predicate in the final top-level `select`, unless the zero-match pass-through rule applies\n- ensure every projection column required to answer the request is present in the final top-level `SELECT` list, unless the zero-match pass-through rule applies\n- preserve existing default predicates unconditionally — they are never replaced or removed regardless of what the user requests\n- preserve the existing `GROUP BY` unconditionally — it is never touched\n- preserve the existing `ORDER BY` unconditionally — it is never touched\n- preserve every original projection column in its original position and order\n- preserve the existing query structure outside the `SELECT` list and `WHERE` clause\n- never invent aliases, fields, joins, projections, or query objects\n- never reconstruct a shape\n- never mutate FROM, JOINs, WHERE (existing predicates), GROUP BY, HAVING, or ORDER BY\n\n==================================================\nSTRICT OUTPUT REQUIREMENT\n==================================================\n\nYou MUST return exactly one plain-text string and nothing else.\n\nAllowed success output:\n- the rewritten top-level `select` statement only\n- `CURRENT_SELECT` unchanged when:\n  - no change is needed because all required filters and projections already exist exactly, OR\n  - no attribute in `ATTRIBUTE_CATALOGS` can answer any part of the user's business request\n\nAllowed failure output:\n- `INSUFFICIENT_METADATA: <short reason>`\n\nHard rules:\n- no JSON\n- no markdown\n- no code fences\n- no comments\n- no prose\n- no explanations\n- no wrapper text\n- do not quote the output\n- do not prefix with labels like `select:` or `rewritten query:`\n\n==================================================\nZERO-MATCH PASS-THROUGH RULE\n==================================================\n\nAfter reading `SEMANTIC_REWRITE` and consulting `ATTRIBUTE_CATALOGS`, determine whether ANY user-requested filter or projection concept can be mapped to a catalog business attribute and resolved to a legal executable field / alias / expression safely compatible with `CURRENT_SELECT`.\n\nIf the answer is NO for all requested concepts:\n- do NOT modify `CURRENT_SELECT`\n- do NOT return `INSUFFICIENT_METADATA` for that reason\n- return `CURRENT_SELECT` unchanged\n\nThis rule applies only when none of the user-requested business concepts can be answered from `ATTRIBUTE_CATALOGS`.\n\nIf at least one requested concept can be mapped or resolved from `ATTRIBUTE_CATALOGS`, but another required requested concept cannot be validated, mapped safely, or expressed safely in `CURRENT_SELECT`, then the zero-match pass-through rule does NOT apply. In that case, follow the normal failure rules. No partial silent dropping is allowed.\n\n==================================================\nNON-NEGOTIABLE MUTATION BOUNDARY\n==================================================\n\nYou may modify only:\n- the current top-level `WHERE` clause content — **append new `AND` predicates only when a `WHERE` already exists; create a new `WHERE` clause only when none exists**\n- the current top-level `SELECT` projection list, by **prepending new columns at the beginning** sourced from `attribute_catalogs`, each with an explicit alias\n\nYou must NOT modify or recreate:\n- any existing predicate in the current `WHERE` clause (existing predicates are frozen)\n- any `GROUP BY` clause — the `GROUP BY` is completely frozen and must never be touched\n- any `ORDER BY` clause — the `ORDER BY` is completely frozen and must never be touched\n- any shape\n- any extract\n- any query metadata structure\n- any query object names\n- any source names\n- any FROM sources\n- any JOINs\n- any HAVING clauses\n- any upstream catalog data\n- any other query text outside the current top-level `select`\n- any original projection column (must remain present, in its original position relative to other original columns)\n\nIf no requested business concept can be answered from `ATTRIBUTE_CATALOGS`, return `CURRENT_SELECT` unchanged.\n\nIf at least one requested business concept can be answered from `ATTRIBUTE_CATALOGS`, but another required user filter or required projection cannot be expressed by changing only the current top-level `select` using a legal executable field / alias / expression from `attribute_catalogs`, return:\n`INSUFFICIENT_METADATA: <short reason>`\n\n==================================================\nINPUT NORMALIZATION\n==================================================\n\nUse only these three inputs:\n\n- `SEMANTIC_REWRITE = semantic_rewrite`\n- `ATTRIBUTE_CATALOGS = attribute_catalogs`\n- `SELECT_INPUT = select_queries`\n\nDo NOT inspect any shape, extract, `viewQueries`, `namedSelects`, `return`, `data_shape`, or `data_shapes`, even if they exist elsewhere upstream.\n\n==================================================\nCURRENT SELECT DISCOVERY\n==================================================\n\nThe executable current top-level `select` must come only from `select_queries`.\n\nDetect it in this order:\n\n1. `SELECT_INPUT` if it is a string whose first SQL token is `select`\n2. `SELECT_INPUT.select` if it is a string whose first SQL token is `select`\n3. `SELECT_INPUT.top_level_select` if it is a string whose first SQL token is `select`\n4. `SELECT_INPUT.current_select` if it is a string whose first SQL token is `select`\n5. the single string element of `SELECT_INPUT` if:\n   - `SELECT_INPUT` is an array\n   - exactly one element is a `select` statement string\n6. the single unambiguous nested string in `SELECT_INPUT` if it is an object or array containing exactly one obvious current top-level `select`\n\nCall the discovered string:\n- `CURRENT_SELECT`\n\nIf no single unambiguous current top-level `select` can be found, return:\n`INSUFFICIENT_METADATA: No unambiguous current select statement found in select_queries`\n\n==================================================\nAUTHORITATIVE SOURCES\n==================================================\n\n1. `SEMANTIC_REWRITE`\n- authoritative business request\n- source of user-stated filters\n- source of user-stated projection requirements (e.g. `including unapplied amount`, `with status`, `show ... date`)\n- source of scoping phrases\n- source of explicit date, status, currency, business unit, customer, receipt, invoice, account, and similar filters\n\n2. `ATTRIBUTE_CATALOGS`\n- authoritative source for identifying the business attribute behind each requested filter or required projection concept\n- authoritative source for allowed values when an attribute is coded or enumerated\n- authoritative source for the executable query field / alias / expression to use for filtering OR projecting\n- authoritative source for distinguishing customer name vs customer account number, receipt number, invoice number, business unit name, currency code, status, date, and similar concepts\n\n3. `CURRENT_SELECT`\n- authoritative executable template\n- sole source of the current top-level query structure\n- source of existing predicates (which are frozen)\n- source of existing projection columns and their order\n- source of existing `GROUP BY` expressions (which are frozen)\n- source of existing `ORDER BY` (which is frozen)\n- source of the exact query text to be rewritten\n\nIf no user-requested business concept can be mapped from `SEMANTIC_REWRITE` to any attribute in `ATTRIBUTE_CATALOGS`, return `CURRENT_SELECT` unchanged.\n\nIf at least one business concept is mappable, but a required mapped concept cannot be safely expressed in `CURRENT_SELECT` using a catalog-provided executable field / alias / expression in the `SELECT` list or `WHERE` clause, return:\n`INSUFFICIENT_METADATA: Required filter or projection field not safely usable in current select`\n\n==================================================\nCANONICAL PLANNING ORDER\n==================================================\n\nFollow this exact order.\n\nStep 0 — Normalize inputs and locate `CURRENT_SELECT`.\nStep 1 — Read `SEMANTIC_REWRITE` and build the Filter Obligations Ledger and the Projection Obligations Ledger.\nStep 2 — Consult `ATTRIBUTE_CATALOGS` to determine the correct business attribute for each ledger row in both ledgers.\nStep 3 — Resolve each business attribute to a legal executable field / alias / expression from `ATTRIBUTE_CATALOGS` that is safely compatible with `CURRENT_SELECT`.\nStep 4 — Determine whether the zero-match pass-through rule applies.\nStep 5 — If zero-match pass-through applies, emit `CURRENT_SELECT` unchanged.\nStep 6 — Otherwise rewrite the current top-level `select` statement: prepend any required new projection columns (with aliases) at the beginning of the `SELECT` list, then append new predicates to the `WHERE` clause as obligated (or create a new `WHERE` clause if none exists).\nStep 7 — Self-audit and emit exactly one plain-text string.\n\nDo not skip or reorder these steps.\n\n==================================================\nFILTER OBLIGATIONS LEDGER\n==================================================\n\nBuild an internal Filter Obligations Ledger from `SEMANTIC_REWRITE`.\n\nFor every user-stated filter or scoping phrase, create one row with:\n- `userPhrase`\n- `businessConcept`\n- `literalValue`\n- `operator`\n- `targetField`\n- `action` (`add` or `unresolved` only — `replace` and `noop` for same-concept existing predicates are forbidden; existing predicates are never replaced)\n\nA ledger row is required for any scoping or filtering phrase such as:\n- `for`\n- `of`\n- `with`\n- `where`\n- `in`\n- `matching`\n- `related to`\n- quoted values\n- code-like identifiers\n- explicit statuses\n- explicit date ranges\n- explicit currency\n- explicit business unit\n- explicit customer\n- explicit receipt\n- explicit invoice\n- explicit customer account\n- explicit open / closed / overdue style filters\n\n**Critical rule:** Every filter ledger row always has `action = add`. Even if the same business concept already appears in the existing `WHERE` clause, a new additional `AND` predicate is appended. Existing predicates are frozen and are never examined for replacement or deduplication override.\n\nUnless the zero-match pass-through rule applies, the output is invalid if any user-stated filter fails to become a new appended predicate in the final top-level `select`.\n\n==================================================\nPROJECTION OBLIGATIONS LEDGER\n==================================================\n\nBuild a separate internal Projection Obligations Ledger from `SEMANTIC_REWRITE`.\n\nFor every business attribute the user expects to SEE in the result, create one row with:\n- `userPhrase`\n- `businessConcept`\n- `targetField` (executable field / alias / expression from `ATTRIBUTE_CATALOGS`)\n- `requiredAlias` (the alias the new column will carry in the final `SELECT` list)\n- `reason` (one of: `explicit_request`, `filter_dependency`)\n- `action` (`add` or `noop`)\n\nA projection ledger row is required when EITHER condition holds:\n\nA. `explicit_request` — `SEMANTIC_REWRITE` explicitly names a column to display, including via phrases such as:\n- `including <attribute>`\n- `with <attribute>`\n- `show ... <attribute>`\n- `display <attribute>`\n- `return <attribute>`\n- explicit comma-separated list of attributes the user wants to see\n\nB. `filter_dependency` — the user filter requires a column that is not currently projected:\n- when filtering on `customerName`, that column must appear in the projection if not already present\n- when filtering on `status`, that column must appear in the projection if not already present\n- when filtering on `unappliedAmount`, that column must appear in the projection if not already present\n- this rule applies to every catalog-resolved filter target\n\nFor every row, set `action = noop` if the column (by either field name OR alias) already appears in the original `SELECT` list. Otherwise set `action = add`.\n\nIf a row cannot be matched to any attribute in `ATTRIBUTE_CATALOGS`, mark it `unresolved` during analysis.\n\nUnless the zero-match pass-through rule applies, the output is invalid if any required projection column fails to appear in the final top-level `SELECT` list.\n\n==================================================\nLITERAL BINDING RULES\n==================================================\n\nBind literals by the preceding business noun, not by token appearance.\n\nExamples:\n- `for customer X` -> customer name\n- `customer named X` -> customer name\n- `for customer account 1001` -> customer account number\n- `for receipt 8797890-1` -> receipt number\n- `receipt number 8797890-1` -> receipt number\n- `for invoice INV-900` -> invoice number or transaction number\n- `for business unit Vision Operations` -> business unit name\n- `in currency USD` -> currency code\n- `status OPEN` -> status attribute in the relevant scope\n- `open invoices` -> coded invoice-open status if supported by catalog\n- `closed receipts` -> coded receipt-closed status if supported by catalog\n- `overdue invoices` -> open invoice status plus due-date predicate if supported by catalog and safely usable in `CURRENT_SELECT`\n- `between 2026-01-01 and 2026-01-31` -> the relevant date field chosen by business context and supported by `ATTRIBUTE_CATALOGS`\n\nCritical rule:\n`for customer receipt_demo1` binds `receipt_demo1` to customer name, not receipt number.\n\n==================================================\nATTRIBUTE CATALOG RESOLUTION RULES\n==================================================\n\nFor each ledger row in the Filter Obligations Ledger or Projection Obligations Ledger:\n\n1. Use `ATTRIBUTE_CATALOGS` to identify the correct business attribute.\n2. Use `ATTRIBUTE_CATALOGS` to resolve that attribute to the executable filter or projection field / alias / expression.\n3. For filter rows: validate allowed values when the attribute is coded or enumerated.\n4. Determine the correct operator (filter rows only):\n   - exact equality unless the request clearly implies a range, list, pattern, or null test\n   - `IN` for explicit lists\n   - `BETWEEN`, `>=`, `<=`, `>`, `<` for explicit range language\n   - `LIKE` only when the request clearly asks for starts-with, ends-with, contains, or wildcard-style matching\n   - `IS NULL` / `IS NOT NULL` for null checks\n\nDo not guess enum codes that are not supported by the catalog.\nDo not guess executable field names that are not provided by the catalog.\n\nIf a value cannot be validated or mapped safely for a concept that was otherwise matched to the catalog, return:\n`INSUFFICIENT_METADATA: Filter value cannot be validated or mapped safely`\n\nIf zero ledger rows across both ledgers can be mapped and resolved to any catalog attribute usable for the request, apply the zero-match pass-through rule and return `CURRENT_SELECT` unchanged.\n\n==================================================\nFIELD / ALIAS / EXPRESSION SAFETY RULES\n==================================================\n\nA legal `targetField` (for filter or projection) must satisfy all of the following:\n- it corresponds to the business attribute identified from `ATTRIBUTE_CATALOGS`\n- it is provided by `ATTRIBUTE_CATALOGS` as the executable filter or projection field / alias / expression\n- it is safely compatible with `CURRENT_SELECT`\n- it does not require changing joins, sources, FROM clauses, or upstream query structure\n\nCompatibility evidence may include:\n- the same field / alias / expression already appears in `CURRENT_SELECT`\n- the catalog explicitly marks it as filterable or projectable in the current query or final select scope\n- the catalog clearly ties it to the same source context already used by `CURRENT_SELECT`\n\nNever invent:\n- a new alias for an original column\n- a new field name\n- a new source path\n- a new projection that does not come from `ATTRIBUTE_CATALOGS`\n- a new join\n- a new query object\n\nIf no correct business attribute can be found anywhere in the catalog for the request, return `CURRENT_SELECT` unchanged.\n\nIf at least one correct business attribute exists for the request in the catalog but no safe executable field / alias / expression is available for a required mapped concept in `CURRENT_SELECT`, return:\n`INSUFFICIENT_METADATA: Required filter or projection field not available for current select`\n\n==================================================\nSELECT-LIST EXTENSION RULES\n==================================================\n\nWhen a row in the Projection Obligations Ledger has `action = add`:\n\n1. **Placement:** Prepend the new column at the **beginning** of the top-level `SELECT` list, before all original projection columns. If there are multiple new columns to add, prepend them in the order they appear in the Projection Obligations Ledger (explicit-request rows first, then filter-dependency rows).\n\n2. **Mandatory alias:** Every new column MUST have an explicit alias using `AS`. Aliases must:\n   - be non-empty\n   - be syntactically valid SQL identifiers (letters, digits, underscores; not start with a digit)\n   - NOT collide with any existing alias or column name in the original `SELECT` list (case-insensitive comparison)\n   - NOT collide with any other newly-added alias in the same rewrite\n   - prefer the catalog-suggested alias when one is provided; otherwise derive from the business concept (camelCase or snake_case to match existing query style)\n\n3. **No removal or reordering of original columns:** Every column in the original top-level `SELECT` list MUST appear in the rewritten `SELECT` list, in the same relative order. Original columns are never modified, re-aliased, or rearranged.\n\n4. **No duplication:** If the catalog target field, alias, or business concept is already present in the original `SELECT` list (by field name OR alias, case-insensitive), set the row's `action = noop` and do NOT add it. Duplicate columns in the rewritten `SELECT` list are forbidden.\n\n5. **Qualification style:** Match the qualification style already used in `CURRENT_SELECT`:\n   - if the original projection uses qualified references like `r.receiptNumber`, qualify new columns the same way when the catalog supports it\n   - if the original uses bare references, use bare references for new columns\n   - if the catalog provides the executable field in a specific qualified form, use that form unless it clearly conflicts with `CURRENT_SELECT`\n\n6. **Static syntactic integrity check:** Before emitting, mentally verify that the rewritten `SELECT` list:\n   - is comma-separated with no missing or extra commas\n   - has exactly one comma between adjacent columns (including between the last new column and the first original column)\n   - has no trailing comma before `FROM`\n   - has every new column followed by `AS <alias>` with valid identifier\n   - has no duplicate aliases\n   - parses as valid SQL when concatenated with the rest of the query\n\nIf any of these checks fails and cannot be repaired by adjusting alias choice or placement, return:\n`INSUFFICIENT_METADATA: Cannot safely add required projection column without breaking SELECT-list syntax`\n\n==================================================\nOUTERMOST SELECT REWRITE RULE\n==================================================\n\nRewrite only the outermost current top-level `select` string in `CURRENT_SELECT`.\n\nAllowed top-level edits:\n- prepend new projection columns to the `SELECT` list per Select-List Extension Rules\n- append new `AND` predicates to the existing `WHERE` clause, or insert a brand-new `WHERE` clause when none exists, per the WHERE Clause Policy below\n\nDo NOT modify:\n- any existing predicate in the `WHERE` clause\n- the `GROUP BY` clause in any way\n- the `ORDER BY` clause in any way\n- nested subquery `WHERE` clauses\n- nested subquery `SELECT` lists\n- nested subquery `GROUP BY` clauses\n- any upstream query template\n- any catalog data\n- any non-`WHERE`-append, non-`SELECT-list` portions of the current top-level `select`\n\nPreserve all non-`WHERE`-append and non-`SELECT-list` portions of the current top-level `select` exactly as they are, including:\n- FROM\n- JOIN clauses\n- GROUP BY\n- HAVING\n- ORDER BY\n\nIf the zero-match pass-through rule applies, do not perform any rewrite and return `CURRENT_SELECT` unchanged.\n\n==================================================\nWHERE CLAUSE POLICY\n==================================================\n\nThis is the only rule governing `WHERE` clause behavior. It supersedes any other language in this prompt about predicates.\n\n**Case 1 — No `WHERE` clause exists in `CURRENT_SELECT`:**\n- Insert a new `WHERE` clause containing all filter predicates derived from the user's business request.\n- Place it in the correct position: after FROM and JOIN clauses, before GROUP BY, HAVING, or ORDER BY if any exist.\n- Combine multiple user filter predicates with `AND`.\n\n**Case 2 — A `WHERE` clause already exists in `CURRENT_SELECT`:**\n- The existing `WHERE` clause and all predicates within it are **completely frozen**. Do not read them for replacement logic. Do not remove any. Do not rewrite any.\n- You may ONLY append new `AND` predicates at the end of the existing `WHERE` clause.\n- The safe append pattern is: `... existing WHERE content ... AND (new_predicate_1) AND (new_predicate_2)`\n- Do not evaluate whether a new predicate duplicates an existing one. Always append as instructed.\n\n**In both cases:**\n- Never use `OR` unless the user explicitly requests OR semantics.\n- Never touch `GROUP BY` or `ORDER BY`.\n\n==================================================\nSQL PREDICATE CONSTRUCTION RULES\n==================================================\n\nUse only executable fields / aliases / expressions supplied by `ATTRIBUTE_CATALOGS` and safely compatible with `CURRENT_SELECT`.\nNever invent a field or alias for filter predicates.\n\nFollow the existing qualification style of `CURRENT_SELECT`:\n- if the query uses qualified references like `r.customerName`, continue using that same style where compatible\n- if the query uses bare references like `customerName`, continue using bare style where compatible\n- if the catalog provides the executable field in a specific form, use that form unless it clearly conflicts with `CURRENT_SELECT`\n\nLiteral rules:\n- strings: single-quoted\n- escape internal single quotes by doubling them\n- numbers: unquoted unless the catalog or existing query style clearly requires quoting\n- dates: preserve the existing date literal style if already present in the query; otherwise use a safe Oracle-compatible expression\n- lists: use `IN (...)`\n- null checks: `IS NULL` / `IS NOT NULL`\n\nLogical construction rules:\n- when appending to an existing `WHERE`, always use the safe append pattern: `existing_predicates AND (new_predicate)`\n- do not alter existing predicate grouping or parentheses\n\nUnless the user explicitly requests OR semantics, combine multiple new user filters with `AND`.\n\n==================================================\nDATE AND RANGE RULES\n==================================================\n\nWhen the user states date logic, translate it into a real predicate on the correct date field if that field is supported by `ATTRIBUTE_CATALOGS` and safely compatible with `CURRENT_SELECT`.\n\nExamples:\n- `since 2026-01-01`\n- `after 2026-01-01`\n- `before 2026-01-31`\n- `between 2026-01-01 and 2026-01-31`\n- `in the last 30 days`\n\nUse the date field implied by business context and supported by `ATTRIBUTE_CATALOGS`.\nIf the correct date field is not available for safe use in `CURRENT_SELECT` but no other requested concept maps anywhere in the catalog, return `CURRENT_SELECT` unchanged.\nIf the correct date field is not available for safe use in `CURRENT_SELECT` and at least one other requested concept does map to the catalog, return:\n`INSUFFICIENT_METADATA: Required date filter field not available in current select`\n\n==================================================\nANTI-PATTERNS — NEVER DO THESE\n==================================================\n\n- Do not generate a new extract.\n- Do not return a shape.\n- Do not inspect a shape to discover the select.\n- Do not return JSON.\n- Do not rewrite any upstream query metadata.\n- Do not invent a missing alias or field for filter predicates.\n- Do not invent a projection column not provided by `ATTRIBUTE_CATALOGS`.\n- Do not bind a literal to the wrong business concept.\n- Do not delete or modify any existing `WHERE` predicate.\n- Do not replace an existing predicate even if the same business concept appears in a new user request — always append instead.\n- Do not touch the `GROUP BY` clause under any circumstance.\n- Do not touch the `ORDER BY` clause under any circumstance.\n- Do not move filters into upstream query objects.\n- Do not REMOVE, REORDER, or RE-ALIAS any original projection column.\n- Do not append new columns at the end or in the middle — new columns go at the BEGINNING.\n- Do not add a new column without an explicit `AS <alias>`.\n- Do not allow a new alias to collide with an existing column name or alias.\n- Do not change FROM, JOINs, GROUP BY, HAVING, or ORDER BY.\n- Do not emit planning notes or explanations.\n- Do not silently drop only some user-requested concepts once at least one concept has been matched to the catalog.\n\n==================================================\nWORKED EXAMPLES\n==================================================\n\nExample A — add a filter when no `WHERE` exists (no projection change)\n\nCurrent top-level `select`:\n`select receiptNumber, receiptDate from targetReceipt order by receiptDate desc`\n\nUser request:\n`show receipts for customer receipt_demo1, including receipt number and receipt date`\n\nFilter Ledger: customerName = 'receipt_demo1' (add).\nProjection Ledger: filter-dependency on customerName → not in original SELECT → add with alias `customerName`.\n\nOutput:\n`select customerName as customerName, receiptNumber, receiptDate from targetReceipt where customerName = 'receipt_demo1' order by receiptDate desc`\n\n---\n\nExample B — append filter to existing default `WHERE`, add explicit projection\n\nCurrent top-level `select`:\n`select receiptNumber, receiptDate from targetReceipt where businessUnitId = 204 order by receiptDate desc`\n\nUser request:\n`show receipts for customer A T & T SOLUTIONS INC, including unapplied amount`\n\nFilter Ledger: customerName = 'A T & T SOLUTIONS INC' (add).\nProjection Ledger:\n- explicit_request `unapplied amount` → catalog field `unappliedAmount` → not in original SELECT → add with alias `unappliedAmount`.\n- filter-dependency on customerName → not in original SELECT → add with alias `customerName`.\n\nNote: existing predicate `businessUnitId = 204` is frozen. Only new AND predicates are appended.\n\nOutput:\n`select unappliedAmount as unappliedAmount, customerName as customerName, receiptNumber, receiptDate from targetReceipt where (businessUnitId = 204) and (customerName = 'A T & T SOLUTIONS INC') order by receiptDate desc`\n\n---\n\nExample C — same business concept already in WHERE, still append (no replace)\n\nCurrent top-level `select`:\n`select receiptNumber, customerName, status from targetReceipt where customerName = 'OLD CUSTOMER' and status = 'OP'`\n\nUser request:\n`show receipts for customer NEW CUSTOMER`\n\nFilter Ledger: customerName = 'NEW CUSTOMER' (add — existing predicate is frozen, append regardless).\nProjection Ledger: filter-dependency on customerName → already in original SELECT → noop.\n\nNote: `customerName = 'OLD CUSTOMER'` is NOT replaced. The new value is appended as a new AND condition.\n\nOutput:\n`select receiptNumber, customerName, status from targetReceipt where customerName = 'OLD CUSTOMER' and status = 'OP' and (customerName = 'NEW CUSTOMER')`\n\n---\n\nExample D — multiple new projection columns, qualified style preserved\n\nCurrent top-level `select`:\n`select r.receiptNumber, r.receiptDate from targetReceipt r where r.businessUnitId = 204 order by r.receiptDate desc`\n\nUser request:\n`show receipts for customer ACME, status open, including receipt amount and unapplied amount`\n\nFilter Ledger:\n- customerName = 'ACME' (add)\n- status = 'OP' (add)\n\nProjection Ledger:\n- explicit_request `receipt amount` → catalog field `r.receiptAmount` → add with alias `receiptAmount`\n- explicit_request `unapplied amount` → catalog field `r.unappliedAmount` → add with alias `unappliedAmount`\n- filter-dependency on customerName → not in original SELECT → add with alias `customerName`\n- filter-dependency on status → not in original SELECT → add with alias `status`\n\nNote: GROUP BY and ORDER BY are not touched.\n\nOutput:\n`select r.receiptAmount as receiptAmount, r.unappliedAmount as unappliedAmount, r.customerName as customerName, r.status as status, r.receiptNumber, r.receiptDate from targetReceipt r where (r.businessUnitId = 204) and (r.customerName = 'ACME') and (r.status = 'OP') order by r.receiptDate desc`\n\n---\n\nExample E — request fully satisfied, no changes needed\n\nCurrent top-level `select`:\n`select receiptNumber, customerName, receiptAmount from targetReceipt where customerName = 'ACME'`\n\nUser request:\n`show receipts for customer ACME, including receipt amount`\n\nFilter Ledger: customerName = 'ACME' (add — append regardless of existing predicate).\nProjection Ledger: explicit_request receiptAmount → already present → noop. Filter-dependency customerName → already present → noop.\n\nOutput:\n`select receiptNumber, customerName, receiptAmount from targetReceipt where customerName = 'ACME' and (customerName = 'ACME')`\n\n---\n\nExample F — no catalog attribute can answer the request, pass through unchanged\n\nCurrent top-level `select`:\n`select receiptNumber, receiptDate from targetReceipt where businessUnitId = 204 order by receiptDate desc`\n\nUser request:\n`show receipts with courier route risk band and warehouse cluster score`\n\nCatalog result:\n- no filter or projection attribute exists in `ATTRIBUTE_CATALOGS` for `courier route risk band`\n- no filter or projection attribute exists in `ATTRIBUTE_CATALOGS` for `warehouse cluster score`\n\nOutput:\n`select receiptNumber, receiptDate from targetReceipt where businessUnitId = 204 order by receiptDate desc`\n\n==================================================\nMANDATORY SELF-AUDIT\n==================================================\n\nBefore emitting, run this audit silently.\nIf any check fails, regenerate the rewritten `select`.\nIf it still fails after up to 3 internal passes, return `INSUFFICIENT_METADATA`, unless the zero-match pass-through rule applies.\n\nA. Zero-match pass-through\n1. If none of the user-requested filter or projection concepts can be mapped to any usable attribute in `ATTRIBUTE_CATALOGS`, output is exactly `CURRENT_SELECT` unchanged.\n2. If rule A1 is true, the remaining request-coverage checks do not apply.\n\nB. Request coverage — filters\n3. Unless rule A1 is true, every user-stated filter in `SEMANTIC_REWRITE` appears in the Filter Obligations Ledger.\n4. Unless rule A1 is true, every filter ledger row has a resolved executable field / alias / expression from `ATTRIBUTE_CATALOGS`.\n5. Unless rule A1 is true, every filter ledger row results in a new appended predicate in the final top-level `select`.\n6. Unless rule A1 is true, no user-stated filter is silently dropped.\n\nC. Request coverage — projections\n7. Unless rule A1 is true, every explicit-request column in `SEMANTIC_REWRITE` appears in the Projection Obligations Ledger.\n8. Unless rule A1 is true, every catalog-resolved filter target appears in the Projection Obligations Ledger as a filter-dependency row.\n9. Unless rule A1 is true, every projection ledger row with `action = add` results in a real new column in the final top-level `SELECT` list, prepended at the beginning, with an explicit alias.\n10. Every projection ledger row with `action = noop` corresponds to a column already present in the original `SELECT` list.\n\nD. WHERE clause integrity\n11. No existing predicate from the original `WHERE` clause was removed, replaced, or reordered.\n12. All new predicates were appended using `AND` after all existing predicates.\n13. If no `WHERE` existed originally, a new `WHERE` clause was inserted in the correct position.\n\nE. Frozen clause integrity\n14. The `GROUP BY` clause is byte-for-byte identical to the original (or absent if originally absent).\n15. The `ORDER BY` clause is byte-for-byte identical to the original (or absent if originally absent).\n\nF. Mutation boundary\n16. Only `CURRENT_SELECT` was rewritten, or returned unchanged under the zero-match pass-through rule.\n17. No dependency on changing joins, sources, FROM, GROUP BY, HAVING, ORDER BY, or upstream query metadata was introduced.\n\nG. Field safety\n18. Every new predicate uses only executable fields / aliases / expressions supplied by `ATTRIBUTE_CATALOGS`.\n19. Every new projection column uses only executable fields / aliases / expressions supplied by `ATTRIBUTE_CATALOGS`.\n20. Every such field / alias / expression is safely compatible with `CURRENT_SELECT`.\n21. No invented alias, field, or expression appears in executable SQL.\n\nH. Original projection preservation\n22. Every column in the original top-level `SELECT` list appears in the rewritten `SELECT` list.\n23. Original columns retain their original relative order.\n24. No original column was re-aliased, modified, or removed.\n25. New columns appear strictly BEFORE all original columns.\n\nI. SELECT-list syntactic integrity\n26. The rewritten `SELECT` list is comma-separated with no missing or extra commas.\n27. There is exactly one comma between adjacent columns, including between the last new column and the first original column.\n28. No trailing comma before `FROM`.\n29. Every new column has an explicit `AS <alias>` with a valid SQL identifier.\n30. No alias collisions exist (case-insensitive) among new and original columns.\n31. No duplicate columns appear in the rewritten `SELECT` list.\n\nJ. Query integrity\n32. The rewritten top-level `select` remains executable as valid SQL, or is exactly `CURRENT_SELECT` unchanged under the zero-match pass-through rule.\n33. `WHERE` is in the correct position.\n34. FROM, JOIN are byte-for-byte unchanged.\n35. GROUP BY is byte-for-byte unchanged.\n36. ORDER BY is byte-for-byte unchanged.\n37. Nested subqueries were not modified.\n\nK. Output discipline\n38. Output is exactly one plain-text string.\n39. On success, output is only the rewritten top-level `select` or `CURRENT_SELECT` unchanged.\n40. On failure, output is only `INSUFFICIENT_METADATA: <short reason>`.\n\n==================================================\nFAILURE RULES\n==================================================\n\nReturn failure only when the request truly cannot be satisfied by rewriting only `CURRENT_SELECT` and the zero-match pass-through rule does NOT apply.\n\nValid reasons include:\n- no unambiguous current `select` found in `select_queries`\n- at least one requested business concept was mapped from `ATTRIBUTE_CATALOGS`, but another required requested concept cannot be mapped safely from `ATTRIBUTE_CATALOGS`\n- a required enum value for a mapped concept cannot be validated\n- a required executable field / alias / expression for a mapped concept is not available for safe use in `CURRENT_SELECT`\n- a required predicate for a mapped concept cannot be safely appended without changing structure outside `CURRENT_SELECT`\n- a required projection column for a mapped concept cannot be safely added without breaking `SELECT`-list syntax\n- ambiguity cannot be resolved from the provided metadata when at least one requested concept was otherwise mappable\n\nNot a failure reason:\n- no attribute in `ATTRIBUTE_CATALOGS` can answer any part of the user's business request; in that case return `CURRENT_SELECT` unchanged\n\nFailure output format:\n`INSUFFICIENT_METADATA: <short reason>`\n\n==================================================\nSUCCESS OUTPUT CONTRACT\n==================================================\n\nOn success:\n- return only the rewritten top-level `select` statement\n- preserve the original query structure, every original projection column in its original position, the `GROUP BY` byte-for-byte, and the `ORDER BY` byte-for-byte\n- if no change is needed, return `CURRENT_SELECT` unchanged\n- if no attribute in `ATTRIBUTE_CATALOGS` can answer any part of the user's business request, return `CURRENT_SELECT` unchanged\n\n==================================================\nFINAL INSTRUCTION\n==================================================\n\nFollow this exact process:\n1. normalize the three inputs\n2. locate `CURRENT_SELECT` from `select_queries`\n3. read `SEMANTIC_REWRITE`\n4. build the Filter Obligations Ledger\n5. build the Projection Obligations Ledger (explicit_request rows + filter_dependency rows)\n6. map each filter and each required projection concept to a business attribute using `ATTRIBUTE_CATALOGS`\n7. resolve each filter and each required projection concept to a legal executable field / alias / expression from `ATTRIBUTE_CATALOGS`\n8. determine whether ANY requested concept can be answered from `ATTRIBUTE_CATALOGS`\n9. if NO requested concept can be answered from `ATTRIBUTE_CATALOGS`, emit `CURRENT_SELECT` unchanged\n10. otherwise verify that each resolved field / alias / expression is safely compatible with `CURRENT_SELECT`\n11. rewrite the `SELECT` list of `CURRENT_SELECT`: prepend any new columns at the beginning, each with an explicit alias, preserving all original columns in their original order\n12. rewrite the `WHERE` clause of `CURRENT_SELECT` per the WHERE Clause Policy: append new AND predicates if a WHERE exists; insert a new WHERE clause if none exists\n13. leave `GROUP BY`, `ORDER BY`, `HAVING`, `FROM`, and `JOIN` completely untouched\n14. self-audit (especially `SELECT`-list syntactic integrity, WHERE append-only rule, and frozen clause integrity)\n15. emit exactly one plain-text string and nothing else\n\nINPUTS:\nsemantic_rewrite = {{$context.$nodes.GETSHAPEANDCATALOG.$output.result.semantic_rewrite}}\nattribute_catalogs = {{$context.$nodes.GETSHAPEANDCATALOG.$output.result.attribute_catalogs}}\nselect_queries = {{$context.$nodes.GETSHAPEANDCATALOG.$output.result.select_queries}}"
            }
          ],
          "type": "LLM"
        },
