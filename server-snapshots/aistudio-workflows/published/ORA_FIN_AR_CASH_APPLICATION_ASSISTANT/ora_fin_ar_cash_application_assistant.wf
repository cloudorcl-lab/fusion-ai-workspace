            "name": "resolverouting",
            "returnType": "object",
            "sourceCode": "function resolveBranch() {\n  const intent = $context.$variables.chatcontext.intent_code \n\n  if (!intent) return { branch: \"HELPER_ASSISTANCE\", reason: \"No intent found\" };\n\n  const RECEIPT_INQUIRY = [\n    \"OPEN_RECEIPT_EXPLORATION\",\n    \"RECEIPT_SOURCE_EXPLORATION\",\n    \"REMIT_REFERENCE_EXPLORATION\",\n    \"RECEIPT_ACTIVITY_EXPLORATION\"\n  ];\n\n  const HELPER_ASSISTANCE = [\n    \"NEEDS_CLARIFICATION\",\n    \"OUT_OF_SCOPE\"\n  ];\n\n  const APPLICATION_EXPLORE = [\n    \"INVOICE_EXPLORE\",\n    \"PROMISE_EXPLORE\",\n    \"INVOICE_MATCH_EXPLORATION\",\n    \"PROMISE_MATCH_EXPLORATION\"\n  ];\n\n  if (RECEIPT_INQUIRY.includes(intent))    return { branch: \"RECEIPT_INQUIRY\" };\n  if (HELPER_ASSISTANCE.includes(intent))  return { branch: \"HELPER_ASSISTANCE\" };\n  if (intent === \"RECEIPT_APPLICATION\")    return { branch: \"RECEIPT_APPLICATION\" };\n  if (APPLICATION_EXPLORE.includes(intent)) return { branch: \"APPLICATION_EXPLORE\" };\n  if (intent === \"REMITTANCE_ADVICE_EXPLORATION\") return { branch: \"REMITTANCE_ADVICE_EXPLORATION\" };\n  if (intent === \"APPLY_CONFIRMED\") return { branch: \"APPLY_CONFIRMED\" };\nAPPLY_CONFIRMED\n\n  // Fallback for unrecognized intent\n  return { branch: \"HELPER_ASSISTANCE\", reason: `Unrecognized intent: ${intent}` };\n}\n\nconst output = resolveBranch();\nreturn output;"
          },
