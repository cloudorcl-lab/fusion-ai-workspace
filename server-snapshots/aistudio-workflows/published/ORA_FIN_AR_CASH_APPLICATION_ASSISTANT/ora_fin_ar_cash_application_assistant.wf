        {
          "metadata": {
            "name": "applyConfirmOutput",
            "returnType": "object",
            "sourceCode": "// --Inputs--\nconst parseoutput = $context.$nodes.PARSEAPPLYOUTPUT.$output.result;\n\n// --Helpers--\nconst TEXT_AUTHORING_HINTS =\n  \"Display this text exactly as provided. Do not summarize, rewrite, infer, or override the data.\";\n\nconst textBlock = (id, text) => ({\n  id,\n  type: \"text\",\n  contentPolicy: \"normalizeOnly\",\n  authoringHints: TEXT_AUTHORING_HINTS,\n  data: text\n});\n\nfunction safeJsonParse(value) {\n  let current = value;\n\n  for (let i = 0; i < 5; i++) {\n    if (typeof current !== \"string\") {\n      return current;\n    }\n\n    try {\n      current = JSON.parse(current);\n    } catch (e) {\n      return current;\n    }\n  }\n\n  return current;\n}\n\nfunction normalizeResult(value) {\n  return value == null ? \"\" : String(value).trim().toUpperCase();\n}\n\nfunction getDisplayText(value) {\n  const parsed = safeJsonParse(value);\n\n  if (!parsed) return \"\";\n\n  if (typeof parsed === \"string\") {\n    return parsed;\n  }\n\n  if (parsed.detail) {\n    return String(parsed.detail);\n  }\n\n  return JSON.stringify(parsed);\n}\n\n// --Parse Inputs--\nconst parsedOutput = safeJsonParse(parseoutput);\n\nconst apiResult = normalizeResult(parsedOutput && parsedOutput.result);\nconst detailText = getDisplayText(parsedOutput);\n\n// --Build Display--\nconst messages = [];\n\nif (apiResult === \"S\") {\n  messages.push(textBlock(\n    \"apply_success_message\",\n    detailText || \"Receipt successfully applied to the invoice.\"\n  ));\n\n  return {\n    messages\n  };\n}\n\nmessages.push(textBlock(\n  \"apply_error_message\",\n  detailText || \"Receipt was not applied to the invoice.\"\n));\n\nreturn {\n  messages\n};"
          },
          "outcomes": {
            "success": "1777275686557"
          },
          "code": "APPLYCONFIRMOUTPUT",
          "id": "1777021996841",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
