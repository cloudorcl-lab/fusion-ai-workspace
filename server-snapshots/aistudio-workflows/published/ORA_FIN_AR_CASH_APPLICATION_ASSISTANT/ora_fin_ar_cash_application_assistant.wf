{
  "workflowId": "300000331058195",
  "workflowCode": "ORA_FIN_AR_CASH_APPLICATION_ASSISTANT",
  "name": "Cash Application Assistant",
  "description": "The assistant enables users to quickly and easily access receipt information and related activities. It supports natural-language inquiries to review receipt details and receipt activity, and to explore invoice matches associated with receipts.Notes: The assistant enables users to inquire receipt details such as receipt number, customer, amount, currency, date, method, and source; review how receipts are applied across invoices; understand unapplied and remaining balances; explore associated and potential invoice matches; and use natural language queries to retrieve, filter, and summarize receipt and invoice match information.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
