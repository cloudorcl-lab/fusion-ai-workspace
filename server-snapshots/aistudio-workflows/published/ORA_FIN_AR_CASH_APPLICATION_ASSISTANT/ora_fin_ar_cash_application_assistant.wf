state\",\n                    \"description\": \"Promise Status\",\n                    \"dataType\": \"String\",\n                    \"allowedValues\": [\n                        {\n                            \"code\": \"PROMISE\",\n                            \"meaning\": \"Open Promise\"\n                        },\n                        {\n                            \"code\": \"BROKEN\",\n                            \"meaning\": \"Broken Promise\"\n                        },\n                        {\n                            \"code\": \"FULFILLED\",\n                            \"meaning\": \"Promise Fulfilled\"\n                        }\n                    ]\n                  }\n\n            ]\n        },\n        {\n            \"catalogName\": \"receivablesInvoiceMatch\",\n            \"attributes\": [\n                {\n                    \"attributeName\": \"receiptNumber\",\n                    \"description\": \"Receipt number being evaluated for a potential invoice match\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"invoiceNumber\",\n                    \"description\": \"Invoice transaction number from the matched receivables payment schedule\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"receiptAmount\",\n                    \"description\": \"Receipt amount expressed as a negative value for comparison against the remaining invoice balance\",\n                    \"dataType\": \"Decimal\"\n                },\n                {\n                    \"attributeName\": \"remainingInvoiceBalance\",\n                    \"description\": \"Outstanding balance remaining on the matched invoice payment schedule\",\n                    \"dataType\": \"Decimal\"\n                },\n                {\n                    \"attributeName\": \"customerAccountNumber\",\n                