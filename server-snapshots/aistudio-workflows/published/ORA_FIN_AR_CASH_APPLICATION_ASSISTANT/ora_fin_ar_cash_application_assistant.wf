        {
          "metadata": {
            "name": "summarizeMatches",
            "returnType": "object",
            "sourceCode": "// --- Input ---\n\nvar inputData = null;\ninputData = $context.$nodes.EXECUTEEXTRACT.$output;\n\nvar intentCode =\n  $context &&\n  $context.$variables &&\n  $context.$variables.chatcontext &&\n  $context.$variables.chatcontext.intent_code\n    ? String($context.$variables.chatcontext.intent_code)\n    : \"\";\n\nvar debug = {};\n\n// --- Configuration ---\n\nvar MAX_OUTPUT_ROWS = 500;\n\nvar SUPPORTED_INTENTS = [\n  \"INVOICE_MATCH_EXPLORATION\",\n  \"PROMISE_MATCH_EXPLORATION\"\n];\n\n// --- Helpers ---\n\nfunction getSemanticRewriteText() {\n  return $context &&\n    $context.$variables &&\n    $context.$variables.chatcontext &&\n    $context.$variables.chatcontext.semantic_rewrite\n      ? String($context.$variables.chatcontext.semantic_rewrite)\n      : \"\";\n}\n\nfunction normalizeDisplayText(text) {\n  if (text == null) return \"\";\n\n  var value = String(text).trim();\n\n  if (!value) return \"\";\n\n  if (value.charAt(value.length - 1) !== \".\") {\n    value += \".\";\n  }\n\n  return value;\n}\n\nfunction isSupportedIntent(intent) {\n  var intentUpper = String(intent || \"\").toUpperCase();\n\n  for (var i = 0; i < SUPPORTED_INTENTS.length; i++) {\n    if (String(SUPPORTED_INTENTS[i]).toUpperCase() === intentUpper) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction firstNonEmpty() {\n  for (var i = 0; i < arguments.length; i++) {\n    if (arguments[i] != null && arguments[i] !== \"\") {\n      return arguments[i];\n    }\n  }\n\n  return \"\";\n}\n\nfunction parseAmount(value) {\n  if (value == null || value === \"\") return 0;\n\n  var cleanValue = String(value).replace(/,/g, \"\");\n  var num = Number(cleanValue);\n\n  return !isNaN(num) ? num : 0;\n}\n\nfunction roundAmount(value) {\n  return Math.round(Number(value || 0) * 100) / 100;\n}\n\nfunction amountsEqual(a, b) {\n  return Math.abs(roundAmount(a) - roundAmount(b)) < 0.01;\n}\n\nfunction formatAmount(amount) {\n  if (amount == null || isNaN(Number(amount))) return \"unknown amount\";\n\n  return Number(amount).toLocaleString(undefined, {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n}\n\nfunction formatAmountWithCurrency(amount, currency) {\n  var formattedAmount = formatAmount(amount);\n\n  if (currency == null || currency === \"\") {\n    return formattedAmount;\n  }\n\n  return String(currency) + \" \" + formattedAmount;\n}\n\nfunction parseDateValue(value) {\n  if (value == null || value === \"\") return null;\n\n  var d = new Date(value);\n\n  if (isNaN(d.getTime())) return null;\n\n  return d;\n}\n\nfunction ageInDaysFromToday(dateValue) {\n  var d = parseDateValue(dateValue);\n\n  if (!d) return null;\n\n  var today = new Date();\n\n  var todayUtc = Date.UTC(\n    today.getFullYear(),\n    today.getMonth(),\n    today.getDate()\n  );\n\n  var dateUtc = Date.UTC(\n    d.getFullYear(),\n    d.getMonth(),\n    d.getDate()\n  );\n\n  var diffMs = todayUtc - dateUtc;\n\n  return Math.floor(diffMs / (1000 * 60 * 60 * 24));\n}\n\nfunction formatDueStatus(days) {\n  if (days == null) return \"with unknown due status\";\n\n  if (days > 0) {\n    return \"overdue by \" + days + \" day\" + (days === 1 ? \"\" : \"s\");\n  }\n\n  if (days === 0) {\n    return \"due today\";\n  }\n\n  var dueIn = Math.abs(days);\n\n  return \"due in \" + dueIn + \" day\" + (dueIn === 1 ? \"\" : \"s\");\n}\n\nfunction sameCurrency(receiptCurrency, candidateCurrency) {\n  if (!receiptCurrency || !candidateCurrency) return true;\n\n  return String(receiptCurrency).toUpperCase() ===\n    String(candidateCurrency).toUpperCase();\n}\n\nfunction uniqueStrings(values) {\n  var seen = {};\n  var result = [];\n\n  if (!values) return result;\n\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n\n    if (value == null || value === \"\") continue;\n\n    var key = String(value).toLowerCase();\n\n    if (!seen[key]) {\n      seen[key] = true;\n      result.push(String(value));\n    }\n  }\n\n  return result;\n}\n\n// --- Field Accessors ---\n\nfunction getCustomerName(row) {\n  return firstNonEmpty(\n    row.CUSTOMERNAME,\n    row.customerName,\n    row.customer,\n    row.CUSTOMER,\n    row.PARTYNAME,\n    row.partyName\n  );\n}\n\nfunction getReceiptNumber(row) {\n  return firstNonEmpty(\n    row.RECEIPTNUMBER,\n    row.receiptNumber,\n    row.RECEIPT_NUMBER,\n    row.receipt_number,\n    row.CASHRECEIPTNUMBER,\n    row.cashReceiptNumber\n  );\n}\n\nfunction getReceiptAmount(row) {\n  return firstNonEmpty(\n    row.RECEIPTAMOUNT,\n    row.receiptAmount,\n    row.RECEIPT_AMOUNT,\n    row.receipt_amount,\n    row.UNAPPLIEDAMOUNT,\n    row.unappliedAmount,\n    row.AMOUNTREMAINING,\n    row.amountRemaining,\n    row.AMOUNT,\n    row.amount\n  );\n}\n\nfunction getReceiptCurrency(row) {\n  return firstNonEmpty(\n    row.RECEIPTCURRENCYCODE,\n    row.receiptCurrencyCode,\n    row.RECEIPT_CURRENCY_CODE,\n    row.receipt_currency_code,\n    row.RECEIPTCURRENCY,\n    row.receiptCurrency\n  );\n}\n\nfunction getInvoiceNumber(row) {\n  return firstNonEmpty(\n    row.INVOICENUMBER,\n    row.invoiceNumber,\n    row.TRANSACTIONNUMBER,\n    row.transactionNumber,\n    row.TRXNUMBER,\n    row.trxNumber\n  );\n}\n\nfunction getInstallmentDueDate(row) {\n  return firstNonEmpty(\n    row.INSTALLMENTDUEDATE,\n    row.installmentDueDate,\n    row.INVOICEDUEDATE,\n    row.invoiceDueDate,\n    row.DUEDATE,\n    row.dueDate\n  );\n}\n\nfunction getRemainingInvoiceBalance(row) {\n  return firstNonEmpty(\n    row.REMAININGINVOICEBALANCE,\n    row.remainingInvoiceBalance,\n    row.AMOUNTREMAINING,\n    row.amountRemaining,\n    row.REMAININGAMOUNT,\n    row.remainingAmount\n  );\n}\n\nfunction getInvoiceCurrency(row) {\n  return firstNonEmpty(\n    row.INVOICECURRENCYCODE,\n    row.invoiceCurrencyCode,\n    row.INVOICECURRENCY,\n    row.invoiceCurrency,\n    row.CURRENCYCODE,\n    row.currencyCode,\n    row.CURRENCY,\n    row.currency\n  );\n}\n\nfunction getPromiseDate(row) {\n  return firstNonEmpty(\n    row.PROMISEDATE,\n    row.promiseDate\n  );\n}\n\nfunction getPromiseAmount(row) {\n  return firstNonEmpty(\n    row.PROMISEAMOUNT,\n    row.promiseAmount\n  );\n}\n\nfunction getPromiseStatus(row) {\n  return firstNonEmpty(\n    row.PROMISESTATUS,\n    row.promiseStatus,\n    row.STATUS,\n    row.status\n  );\n}\n\nfunction getPromiseNumber(row) {\n  return firstNonEmpty(\n    row.PROMISENUMBER,\n    row.promiseNumber,\n    row.PROMISEID,\n    row.promiseId,\n    row.COLLECTIONPROMISEID,\n    row.collectionPromiseId\n  );\n}\n\n// --- Row Cleanup ---\n\nfunction cleanInvoiceMatchRow(row) {\n  return {\n    RECEIPTAMOUNT: getReceiptAmount(row),\n    RECEIPTCURRENCYCODE: getReceiptCurrency(row),\n    INVOICENUMBER: getInvoiceNumber(row),\n    INSTALLMENTDUEDATE: getInstallmentDueDate(row),\n    REMAININGINVOICEBALANCE: getRemainingInvoiceBalance(row),\n    INVOICECURRENCYCODE: getInvoiceCurrency(row)\n  };\n}\n\nfunction cleanPromiseMatchRow(row) {\n  var promiseDate = getPromiseDate(row);\n  var promiseAgeDays = ageInDaysFromToday(promiseDate);\n  var promiseStatus = getPromiseStatus(row);\n\n  if (!promiseStatus) {\n    promiseStatus = formatDueStatus(promiseAgeDays);\n  }\n\n  return {\n    RECEIPTAMOUNT: getReceiptAmount(row),\n    RECEIPTCURRENCYCODE: getReceiptCurrency(row),\n    INVOICENUMBER: getInvoiceNumber(row),\n    INSTALLMENTDUEDATE: getInstallmentDueDate(row),\n    REMAININGINVOICEBALANCE: getRemainingInvoiceBalance(row),\n    INVOICECURRENCYCODE: getInvoiceCurrency(row),\n    PROMISEDATE: promiseDate,\n    PROMISEAMOUNT: getPromiseAmount(row),\n    PROMISESTATUS_OR_OVERDUEDAYS: promiseStatus\n  };\n}\n\n// --- Match Logic ---\n\nfunction findExactInvoiceMatch(rows, receiptAmount, receiptCurrency) {\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n\n    var invoiceBalance = parseAmount(getRemainingInvoiceBalance(row));\n    var invoiceCurrency = getInvoiceCurrency(row);\n\n    if (\n      amountsEqual(receiptAmount, invoiceBalance) &&\n      sameCurrency(receiptCurrency, invoiceCurrency)\n    ) {\n      return row;\n    }\n  }\n\n  return null;\n}\n\nfunction findExactPromiseMatch(rows, receiptAmount, receiptCurrency) {\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n\n    var promiseAmount = parseAmount(getPromiseAmount(row));\n    var invoiceCurrency = getInvoiceCurrency(row);\n\n    if (\n      amountsEqual(receiptAmount, promiseAmount) &&\n      sameCurrency(receiptCurrency, invoiceCurrency)\n    ) {\n      return row;\n    }\n  }\n\n  return null;\n}\n\nfunction findOldestDueInvoice(rows) {\n  var selectedRow = null;\n  var selectedAgeDays = null;\n  var selectedAmount = 0;\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n\n    var dueDate = getInstallmentDueDate(row);\n    var ageDays = ageInDaysFromToday(dueDate);\n\n    if (ageDays == null) continue;\n\n    var amount = parseAmount(getRemainingInvoiceBalance(row));\n\n    if (selectedRow == null) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n      continue;\n    }\n\n    if (ageDays > selectedAgeDays) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n      continue;\n    }\n\n    if (ageDays === selectedAgeDays && amount > selectedAmount) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n    }\n  }\n\n  return selectedRow;\n}\n\nfunction findOldestDuePromiseInvoice(rows) {\n  var selectedRow = null;\n  var selectedAgeDays = null;\n  var selectedAmount = 0;\n\n  for (var i = 0; i < rows.length; i++) {\n    var row = rows[i];\n\n    var dueDate = getInstallmentDueDate(row);\n    var ageDays = ageInDaysFromToday(dueDate);\n\n    if (ageDays == null) continue;\n\n    var amount = parseAmount(getPromiseAmount(row));\n\n    if (selectedRow == null) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n      continue;\n    }\n\n    if (ageDays > selectedAgeDays) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n      continue;\n    }\n\n    if (ageDays === selectedAgeDays && amount > selectedAmount) {\n      selectedRow = row;\n      selectedAgeDays = ageDays;\n      selectedAmount = amount;\n    }\n  }\n\n  return selectedRow;\n}\n\n// --- Summary Builders ---\n\nfunction buildInvoiceMatchSummary(\n  rows,\n  exactMatchRow,\n  oldestRow,\n  receiptNumber,\n  customerName,\n  receiptAmount,\n  receiptCurrency\n) {\n  if (!rows || !rows.length) {\n    return \"No invoice match candidates were found.\";\n  }\n\n  var text =\n    \"Receipt \" +\n    (receiptNumber || \"unknown receipt\") +\n    \" for \" +\n    (customerName || \"unknown customer\") +\n    \" has \" +\n    formatAmountWithCurrency(receiptAmount, receiptCurrency) +\n    \" unapplied and \" +\n    rows.length +\n    \" invoice match candidate\" +\n    (rows.length === 1 ? \"\" : \"s\") +\n    \".\";\n\n  if (exactMatchRow) {\n    var exactAgeDays = ageInDaysFromToday(getInstallmentDueDate(exactMatchRow));\n\n    text +=\n      \"\\nFound an invoice with an exact amount match. It is \" +\n      formatDueStatus(exactAgeDays) +\n      \".\";\n  }\n\n  if (oldestRow) {\n    var oldestAgeDays = ageInDaysFromToday(getInstallmentDueDate(oldestRow));\n\n    text +=\n      \"\\nThe oldest due invoice is \" +\n      (getInvoiceNumber(oldestRow) || \"unknown invoice\") +\n      \" and is \" +\n      formatDueStatus(oldestAgeDays) +\n      \" with an amount remaining of \" +\n      formatAmountWithCurrency(\n        parseAmount(getRemainingInvoiceBalance(oldestRow)),\n        getInvoiceCurrency(oldestRow)\n      ) +\n      \".\";\n  }\n\n  text += \"\\nReview the invoice list before applying the receipt.\";\n\n  return text;\n}\n\nfunction buildPromiseMatchSummary(\n  rows,\n  exactMatchRow,\n  oldestRow,\n  receiptNumber,\n  customerName,\n  receiptAmount,\n  receiptCurrency\n) {\n  if (!rows || !rows.length) {\n    return \"No promise match candidates were found.\";\n  }\n\n  var text =\n    \"Receipt \" +\n    (receiptNumber || \"unknown receipt\") +\n    \" for \" +\n    (customerName || \"unknown customer\") +\n    \" has \" +\n    formatAmountWithCurrency(receiptAmount, receiptCurrency) +\n    \" unapplied and \" +\n    rows.length +\n    \" promise match candidate\" +\n    (rows.length === 1 ? \"\" : \"s\") +\n    \".\";\n\n  if (exactMatchRow) {\n    var exactPromiseAgeDays = ageInDaysFromToday(getPromiseDate(exactMatchRow));\n\n    text +=\n      \"\\nFound a promise with an exact amount match. It is \" +\n      formatDueStatus(exactPromiseAgeDays) +\n      \".\";\n  }\n\n  if (oldestRow) {\n    var oldestAgeDays = ageInDaysFromToday(getInstallmentDueDate(oldestRow));\n\n    text +=\n      \"\\nThe oldest due invoice is \" +\n      (getInvoiceNumber(oldestRow) || \"unknown invoice\") +\n      \" and is \" +\n      formatDueStatus(oldestAgeDays) +\n      \" with an amount remaining of \" +\n      formatAmountWithCurrency(\n        parseAmount(getRemainingInvoiceBalance(oldestRow)),\n        getInvoiceCurrency(oldestRow)\n      ) +\n      \", promise date \" +\n      (getPromiseDate(oldestRow) || \"unknown\") +\n      \", and promise amount \" +\n      formatAmountWithCurrency(\n        parseAmount(getPromiseAmount(oldestRow)),\n        getInvoiceCurrency(oldestRow)\n      ) +\n      \".\";\n  }\n\n  text += \"\\nReview the promise list before applying the receipt.\";\n\n  return text;\n}\n\n// --- Suggestions ---\n\nfunction buildSuggestionsText(rows) {\n  var intentUpper = String(intentCode || \"\").toUpperCase();\n  var suggestions = [];\n\n  if (!rows || !rows.length) return \"\";\n\n  var firstRow = rows[0];\n\n  var firstReceipt = getReceiptNumber(firstRow);\n  var receiptAmount = parseAmount(getReceiptAmount(firstRow));\n  var receiptCurrency = getReceiptCurrency(firstRow);\n\n  if (intentUpper === \"INVOICE_MATCH_EXPLORATION\") {\n    var exactInvoice = findExactInvoiceMatch(\n      rows,\n      receiptAmount,\n      receiptCurrency\n    );\n\n    var oldestInvoice = findOldestDueInvoice(rows);\n\n    if (exactInvoice && getInvoiceNumber(exactInvoice)) {\n      suggestions.push(\n        \"Apply receipt \" +\n          (firstReceipt || \"\") +\n          \" to exact amount invoice \" +\n          getInvoiceNumber(exactInvoice)\n      );\n    }\n\n    if (oldestInvoice && getInvoiceNumber(oldestInvoice)) {\n      suggestions.push(\n        \"Apply receipt \" +\n          (firstReceipt || \"\") +\n          \" to oldest overdue invoice \" +\n          getInvoiceNumber(oldestInvoice)\n      );\n    }\n\n    suggestions = uniqueStrings(suggestions).slice(0, 4);\n\n    return suggestions.map(function(s) {\n      return \"• \" + s.trim();\n    }).join(\"\\n\");\n  }\n\n  if (intentUpper === \"PROMISE_MATCH_EXPLORATION\") {\n    var exactPromise = findExactPromiseMatch(\n      rows,\n      receiptAmount,\n      receiptCurrency\n    );\n\n    var oldestPromiseInvoice = findOldestDuePromiseInvoice(rows);\n\n    if (exactPromise && getInvoiceNumber(exactPromise)) {\n      suggestions.push(\n        \"Apply receipt \" +\n          (firstReceipt || \"\") +\n          \" to exact promise amount invoice \" +\n          getInvoiceNumber(exactPromise)\n      );\n    }\n\n    if (oldestPromiseInvoice && getInvoiceNumber(oldestPromiseInvoice)) {\n      suggestions.push(\n        \"Apply receipt \" +\n          (firstReceipt || \"\") +\n          \" to oldest overdue promised invoice \" +\n          getInvoiceNumber(oldestPromiseInvoice)\n      );\n    }\n\n    suggestions = uniqueStrings(suggestions).slice(0, 4);\n\n    return suggestions.map(function(s) {\n      return \"• \" + s.trim();\n    }).join(\"\\n\");\n  }\n\n  return \"\";\n}\n\n// --- Output Builder: return structure kept same ---\n\nfunction buildRollupOutput(dataRows, aggregateRows, summaryText, dbg) {\n  return {\n    data: dataRows,\n    aggregatedData: aggregateRows,\n    repeatAttributes: [],\n    summary: summaryText,\n    filterText: normalizeDisplayText(getSemanticRewriteText()),\n    suggestions: buildSuggestionsText(dataRows),\n    debug: dbg\n  };\n}\n\n// --- Parse input ---\n\nvar raw;\n\ntry {\n  raw = typeof inputData === \"string\" ? JSON.parse(inputData) : inputData;\n} catch (e) {\n  raw = null;\n}\n\nvar records = Array.isArray(raw) ? raw : ((raw && raw.data) ? raw.data : []);\nvar recordCount = records.length;\nvar intentUpper = String(intentCode || \"\").toUpperCase();\n\n// --- Unsupported intent ---\n\nif (!isSupportedIntent(intentCode)) {\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    returnedCount: 0,\n    bypassed: true,\n    handled: false,\n    reason: \"This processor handles only INVOICE_MATCH_EXPLORATION and PROMISE_MATCH_EXPLORATION\"\n  };\n\n  return buildRollupOutput(\n    [],\n    [],\n    \"\",\n    debug\n  );\n}\n\n// --- Empty result ---\n\nif (!recordCount) {\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: 0,\n    groupCount: 0,\n    returnedCount: 0,\n    bypassed: true,\n    handled: true,\n    reason: \"No records\"\n  };\n\n  return buildRollupOutput(\n    [],\n    [],\n    intentUpper === \"PROMISE_MATCH_EXPLORATION\"\n      ? \"No promise match candidates were found.\"\n      : \"No invoice match candidates were found.\",\n    debug\n  );\n}\n\n// --- Cap original rows ---\n\nvar matchRows = [];\n\nfor (var m = 0; m < recordCount && matchRows.length < MAX_OUTPUT_ROWS; m++) {\n  matchRows.push(records[m]);\n}\n\n// --- Shared receipt context ---\n\nvar firstRow = matchRows[0];\n\nvar receiptNumber = getReceiptNumber(firstRow);\nvar customerName = getCustomerName(firstRow);\nvar receiptAmount = parseAmount(getReceiptAmount(firstRow));\nvar receiptCurrency = getReceiptCurrency(firstRow);\n\n// --- Invoice Match Exploration ---\n\nif (intentUpper === \"INVOICE_MATCH_EXPLORATION\") {\n  var invoiceRows = [];\n\n  for (var i = 0; i < matchRows.length; i++) {\n    invoiceRows.push(cleanInvoiceMatchRow(matchRows[i]));\n  }\n\n  var exactInvoiceMatch = findExactInvoiceMatch(\n    matchRows,\n    receiptAmount,\n    receiptCurrency\n  );\n\n  var oldestInvoice = findOldestDueInvoice(matchRows);\n\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedCount: invoiceRows.length,\n    maxOutputRows: MAX_OUTPUT_ROWS,\n    bypassed: true,\n    handled: true,\n    matchType: \"invoice\",\n    exactMatchFound: exactInvoiceMatch ? true : false,\n    exactMatchInvoiceNumber: exactInvoiceMatch\n      ? getInvoiceNumber(exactInvoiceMatch)\n      : \"\",\n    oldestDueInvoiceNumber: oldestInvoice\n      ? getInvoiceNumber(oldestInvoice)\n      : \"\",\n    reason: \"Invoice match exploration returns retained match fields only, capped to MAX_OUTPUT_ROWS, with exact amount and oldest due invoice summary logic\",\n    logic: \"Exact match is receipt amount equals remaining invoice balance with matching currency when available. Oldest due invoice is selected by highest overdue days; if multiple invoices share the same due date, the highest remaining balance wins.\"\n  };\n\n  return buildRollupOutput(\n    invoiceRows,\n    invoiceRows,\n    buildInvoiceMatchSummary(\n      matchRows,\n      exactInvoiceMatch,\n      oldestInvoice,\n      receiptNumber,\n      customerName,\n      receiptAmount,\n      receiptCurrency\n    ),\n    debug\n  );\n}\n\n// --- Promise Match Exploration ---\n\nif (intentUpper === \"PROMISE_MATCH_EXPLORATION\") {\n  var promiseRows = [];\n\n  for (var p = 0; p < matchRows.length; p++) {\n    promiseRows.push(cleanPromiseMatchRow(matchRows[p]));\n  }\n\n  var exactPromiseMatch = findExactPromiseMatch(\n    matchRows,\n    receiptAmount,\n    receiptCurrency\n  );\n\n  var oldestPromiseInvoice = findOldestDuePromiseInvoice(matchRows);\n\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedCount: promiseRows.length,\n    maxOutputRows: MAX_OUTPUT_ROWS,\n    bypassed: true,\n    handled: true,\n    matchType: \"promise\",\n    exactMatchFound: exactPromiseMatch ? true : false,\n    exactMatchInvoiceNumber: exactPromiseMatch\n      ? getInvoiceNumber(exactPromiseMatch)\n      : \"\",\n    exactMatchPromiseNumber: exactPromiseMatch\n      ? getPromiseNumber(exactPromiseMatch)\n      : \"\",\n    oldestDueInvoiceNumber: oldestPromiseInvoice\n      ? getInvoiceNumber(oldestPromiseInvoice)\n      : \"\",\n    reason: \"Promise match exploration returns retained match fields only, capped to MAX_OUTPUT_ROWS, with exact promise amount and oldest due invoice summary logic\",\n    logic: \"Exact match is receipt amount equals promise amount with matching currency when available. Oldest due invoice is selected by highest overdue days; if multiple invoices share the same due date, the highest promise amount wins.\"\n  };\n\n  return buildRollupOutput(\n    promiseRows,\n    promiseRows,\n    buildPromiseMatchSummary(\n      matchRows,\n      exactPromiseMatch,\n      oldestPromiseInvoice,\n      receiptNumber,\n      customerName,\n      receiptAmount,\n      receiptCurrency\n    ),\n    debug\n  );\n}"
          },
          "outcomes": {
            "success": "1779408084264"
          },
