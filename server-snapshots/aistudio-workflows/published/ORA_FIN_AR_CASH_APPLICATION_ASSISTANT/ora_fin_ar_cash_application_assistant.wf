        {
          "metadata": {
            "name": "remitoutput",
            "returnType": "object",
            "sourceCode": "// ---Inputs---\nvar summarizeOutput = $context.$nodes.SUMMARIZEREMITEXTRACT.$output.result || {};\n\nconst result =\n  typeof summarizeOutput === \"string\"\n    ? JSON.parse(summarizeOutput)\n    : summarizeOutput;\n\nconst summary = result.summary;\n\nconst filterText =\n  result.filterText ||\n  result.filters ||\n  $context?.$variables?.chatcontext?.semantic_rewrite ||\n  \"\";\n\nconst suggestions = result.suggestions;\n\n//---Check whether table data exists ---\nconst dataRows = Array.isArray(result?.data)\n  ? result.data\n  : Array.isArray(result)\n    ? result\n    : [];\n\nconst hasDataRows = dataRows.length > 0;\n\n// ---Resolve text summary---\nconst summaryText =\n  (typeof summary === \"string\"\n    ? summary\n    : summary?.text || summary?.result || summary?.message || \"\") ||\n  \"\";\n\n// ---Resolve filters text---\n// Do not prefix with \"Filters -\"; the section title already says Filters.\nconst filtersText =\n  (typeof filterText === \"string\"\n    ? filterText\n    : filterText?.text || filterText?.result || filterText?.message || \"\") ||\n  \"\";\n\n// ---Escape HTML for safe suggestions rendering---\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction normalizeObservationItems(value) {\n  if (value == null) return [];\n\n  if (Array.isArray(value)) {\n    return value\n      .filter(Boolean)\n      .map(item =>\n        String(item)\n          .replace(/^[-\\u2022]\\s*/, \"\")\n          .replace(/^of these[:,]?\\s*/i, \"\")\n          .trim()\n      )\n      .filter(Boolean);\n  }\n\n  let raw = String(value).trim();\n  if (!raw) return [];\n\n  raw = raw\n    .replace(/<\\/li>\\s*<li[^>]*>/gi, \"\\n\")\n    .replace(/<\\/?ul[^>]*>/gi, \"\")\n    .replace(/<\\/?li[^>]*>/gi, \"\")\n    .replace(/\\s+\\u2022\\s+/g, \"\\n\");\n\n  const pieces =\n    raw.indexOf(\"\\n\") >= 0 || raw.indexOf(\";\") >= 0\n      ? raw.split(/\\n+|;+/)\n      : raw.match(/[^.!?]+[.!?]?(?=\\s+|$)/g) || [raw];\n\n  return pieces\n    .map(item =>\n      item\n        .replace(/^[-\\u2022]\\s*/, \"\")\n        .replace(/^of these[:,]?\\s*/i, \"\")\n        .trim()\n    )\n    .filter(Boolean);\n}\n\nfunction buildHtmlList(items) {\n  return (\n    \"<ul>\" +\n    items.map(item => \"<li>\" + escapeHtml(item) + \"</li>\").join(\"\") +\n    \"</ul>\"\n  );\n}\n\nfunction formatSummaryWithObservationBullets(summaryValue, fallbackText) {\n  const rawText = String(fallbackText || \"\").trim();\n  if (!rawText) return \"\";\n\n  const explicitObservations =\n    summaryValue && typeof summaryValue === \"object\"\n      ? summaryValue.observations ||\n        summaryValue.observation ||\n        summaryValue.observationsText ||\n        summaryValue.observationText\n      : null;\n\n  let items = normalizeObservationItems(explicitObservations);\n\n  if (items.length > 0) {\n    const lead = rawText.split(/\\bOf these\\b/i)[0].trim();\n    return (\n      (lead ? escapeHtml(lead) + \" \" : \"\") +\n      \"Of these:\" +\n      buildHtmlList(items)\n    );\n  }\n\n  const match = rawText.match(/^(.*?)(?:\\s+)?\\bOf these\\b[:,]?\\s*(.+)$/i);\n  if (!match) return rawText;\n\n  items = normalizeObservationItems(match[2]);\n  if (items.length === 0) return rawText;\n\n  const lead = match[1].trim();\n  return (\n    (lead ? escapeHtml(lead) + \" \" : \"\") +\n    \"Of these:\" +\n    buildHtmlList(items)\n  );\n}\n\nconst renderedSummaryText =\n  formatSummaryWithObservationBullets(summary, summaryText);\n\n// ---Resolve suggestions text---\n// Suggestions come from summarization output: result.suggestions.\n// Supports:\n//   1. Array: [\"Show open invoices for Customer A\", \"Show promises for Customer A\"]\n//   2. Plain string with bullets/newlines\n//   3. HTML string with <ul>/<li>\nlet suggestionsHtml = \"\";\n\nif (Array.isArray(suggestions) && suggestions.length > 0) {\n  const items = suggestions\n    .filter(Boolean)\n    .map(s => String(s).replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n} else if (typeof suggestions === \"string\" && suggestions.trim()) {\n  const rawSuggestions = suggestions.trim();\n\n  if (/^\\s*<ul[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = rawSuggestions;\n  } else if (/^\\s*<li[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = \"<ul>\" + rawSuggestions + \"</ul>\";\n  } else {\n    const items = rawSuggestions\n      .split(/\\n+/)\n      .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n      .filter(Boolean);\n\n    if (items.length > 0) {\n      suggestionsHtml =\n        \"<ul>\" +\n        items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n        \"</ul>\";\n    }\n  }\n} else if (suggestions?.text || suggestions?.result || suggestions?.message) {\n  const rawSuggestions = String(\n    suggestions.text || suggestions.result || suggestions.message || \"\"\n  ).trim();\n\n  const items = rawSuggestions\n    .split(/\\n+/)\n    .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n}\n\n// ---GUARD: No data, no summary, no filters, no suggestions ---\nif (!hasDataRows && !summaryText && !filtersText && !suggestionsHtml) {\n  return {\n    messages: [\n      {\n        id: \"no_data\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"Write a short message\",\n        data: \"No data found.\"\n      }\n    ]\n  };\n}\n\n// --- Build messages in required display order ---\n// 1. Summary - text\n// 2. Filters - text\n// 3. Data - table\n// 4. Suggestions - text\n\nconst messages = [];\n\nif (renderedSummaryText) {\n  messages.push({\n    id: \"summary\",\n    type: \"text\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Display as is. Render any HTML bulleted list. Do not summarize or rewrite.\",\n    data: renderedSummaryText\n  });\n}\n\nif (filtersText) {\n  messages.push({\n    id: \"filters\",\n    type: \"text\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Do not summarize, display as is.\",\n    data: filtersText\n  });\n}\n\nif (hasDataRows) {\n  messages.push({\n    id: \"details_table\",\n    type: \"table\",\n       title: 'Remittance Advices',\n    authoringHints:\n      \"Detailed results from the SUMMARIZEREMITEXTRACT output. Respect the column order provided by the data.\",\n    data: dataRows,\n    chatDisplayConfig: {\n      limitRowsInChat: true,\n      rowLimit: 10\n    }\n  });\n}\n\nif (suggestionsHtml) {\n  messages.push({\n    id: \"suggestions\",\n    type: \"text\",\n    title: \"Suggestions\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Display as HTML bulleted list. Do not summarize or rewrite.\",\n    data: suggestionsHtml\n  });\n}\n\nreturn {\n  messages\n};"
          },
