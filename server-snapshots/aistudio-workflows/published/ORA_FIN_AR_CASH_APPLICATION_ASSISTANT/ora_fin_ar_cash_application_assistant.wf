        {
          "metadata": {
            "name": "parseApplyOutput",
            "returnType": "object",
            "sourceCode": "const receiptData = $context.$nodes.APPLIEDINVOICE.$output;\nconst invoiceData = $context.$nodes.RECEIPTPOSTAPPLY.$output;\n\n// ---Helpers---\nfunction safeJsonParse(value) {\n  let current = value;\n\n  // Handles object, JSON string, or double-stringified JSON\n  for (let i = 0; i < 5; i++) {\n    if (typeof current !== \"string\") {\n      return current;\n    }\n\n    try {\n      current = JSON.parse(current);\n    } catch (e) {\n      return current;\n    }\n  }\n\n  return current;\n}\n\nfunction isBlank(value) {\n  const parsed = safeJsonParse(value);\n\n  if (parsed == null) return true;\n\n  if (typeof parsed === \"string\") {\n    return parsed.trim() === \"\";\n  }\n\n  if (Array.isArray(parsed)) {\n    return parsed.length === 0;\n  }\n\n  if (typeof parsed === \"object\") {\n    return Object.keys(parsed).length === 0;\n  }\n\n  return false;\n}\n\n// ---Parse receipt and invoice data----\nconst parsedReceiptData = safeJsonParse(receiptData);\nconst parsedInvoiceData = safeJsonParse(invoiceData);\n\n// ---Infer success / failure from downstream outputs---\nconst hasReceiptData = !isBlank(parsedReceiptData);\nconst hasInvoiceData = !isBlank(parsedInvoiceData);\n\nif (hasReceiptData && hasInvoiceData) {\n  return {\n    result: \"S\",\n    detail: \"Receipt Successfully applied to the invoice\",\n    receipt: parsedReceiptData,\n    invoice: parsedInvoiceData\n  };\n}\n\nreturn {\n  result: \"E\",\n  detail: \"Receipt was not applied to the invoice. Receipt or invoice confirmation data was not returned.\",\n  receipt: parsedReceiptData,\n  invoice: parsedInvoiceData\n};"
          },
          "outcomes": {
            "success": "1777021996841"
          },
          "code": "PARSEAPPLYOUTPUT",
          "id": "1777402400778",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
