IC\",\n                            \"meaning\": \"Automatic\"\n                        },\n                        {\n                            \"code\": \"BR\",\n                            \"meaning\": \"Bill Receivables\"\n                        },\n                        {\n                            \"code\": \"MANUAL\",\n                            \"meaning\": \"Manual\"\n                        },\n                        {\n                            \"code\": \"BR_REMIT\",\n                            \"meaning\": \"Bills Receivable Remittance\"\n                        },\n                        {\n                            \"code\": \"ORA_NETTING\",\n                            \"meaning\": \"AP/AR Netting\"\n                        }\n                    ]\n                },\n                {\n                    \"attributeName\": \"receiptBatchId\",\n                    \"description\": \"Receipt batch identifier\",\n                    \"dataType\": \"Integer\"\n                },\n                {\n                    \"attributeName\": \"receiptBatchName\",\n                    \"description\": \"Receipt batch name\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"receiptBatchDate\",\n                    \"description\": \"Receipt batch date\",\n                    \"dataType\": \"Date\"\n                },\n                {\n                    \"attributeName\": \"bankAccountName\",\n                    \"description\": \"Bank account name\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"bankAccountNumber\",\n                    \"description\": \"Bank account number\",\n                    \"dataType\": \"String\"\n                },\n                {\n                    \"attributeName\": \"bankBranchName\",\n                    \"description\": \"Bank branch name\",\n   