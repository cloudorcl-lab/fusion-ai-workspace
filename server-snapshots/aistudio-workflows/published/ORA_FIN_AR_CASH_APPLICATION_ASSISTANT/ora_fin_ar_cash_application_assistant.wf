            "name": "verifymatch",
            "returnType": "object",
            "sourceCode": "// ---Inputs from context variables---\nconst receiptData = $context.$nodes.GETRECEIPTFORAPPLY.$output;\nconst invoiceData = $context.$nodes.GETINVFORAPPLY.$output;\nconst catalogData = $context.$variables.cataloglabels;\n\n// --- Build label lookup (case-insensitive on attributeName) \nconst labelMap = {};\nif (catalogData && catalogData.attributes) {\n  for (const attr of catalogData.attributes) {\n    labelMap[attr.attributeName.toLowerCase()] = attr.label;\n  }\n}\n\nconst getLabel = key => labelMap[key.toLowerCase()] || key;\n\nconst applyLabels = obj => {\n  const result = {};\n  for (const [key, value] of Object.entries(obj)) {\n    result[getLabel(key)] = value;\n  }\n  return result;\n};\n\n// --- Resolved balance key labels --\nconst estReceiptBalLabel = getLabel(\"estimatedreceiptbalance\");\nconst estInvBalLabel = getLabel(\"estimatedinvbalance\");\n\n// --- Helpers --\nconst toArray = d => Array.isArray(d) ? d : (d ? [d] : []);\n\nconst stripReceipt = rec => {\n  const { CASHRECEIPTID, ...rest } = rec;\n  return applyLabels(rest);\n};\n\nconst stripInvoice = inv => {\n  const { PAYMENTSCHEDULEID, ...rest } = inv;\n  return applyLabels(rest);\n};\n\nconst computeAppliedAmount = (receipt, invoice) => {\n  const receiptAmt = receipt.AMOUNTREMAINING ?? 0;\n  const invoiceAmt = invoice.AMOUNTREMAINING ?? 0;\n\n  return parseFloat(Math.min(receiptAmt, invoiceAmt).toFixed(2));\n};\n\n// --- Compute Balances ---\nconst computeBalances = (receipt, invoice) => {\n  const receiptAmt = receipt.AMOUNTREMAINING ?? 0;\n  const invoiceAmt = invoice.AMOUNTREMAINING ?? 0;\n  const amtLabel = getLabel(\"AMOUNTREMAINING\");\n\n  if (receiptAmt === 0 && invoiceAmt === 0) {\n    return {\n      estimatedreceiptbalance: 0,\n      estimatedinvbalance: 0,\n      balancecommentary: `No ${amtLabel} remaining on receipt and no ${amtLabel} remaining on invoice — nothing to apply.`\n    };\n  }\n\n  if (receiptAmt === 0) {\n    return {\n      estimatedreceiptbalance: 0,\n      estimatedinvbalance: invoiceAmt,\n      balancecommentary: `No ${amtLabel} remaining on receipt — nothing to apply to invoice.`\n    };\n  }\n\n  if (invoiceAmt === 0) {\n    return {\n      estimatedreceiptbalance: receiptAmt,\n      estimatedinvbalance: 0,\n      balancecommentary: `No ${amtLabel} remaining on invoice — receipt cannot be applied.`\n    };\n  }\n\n  if (receiptAmt === invoiceAmt) {\n    return {\n      estimatedreceiptbalance: 0,\n      estimatedinvbalance: 0,\n      balancecommentary: `Receipt and invoice ${amtLabel} are equal (${receiptAmt}). Both balances will be zero after application.`\n    };\n  }\n\n  if (receiptAmt > invoiceAmt) {\n    const remaining = parseFloat((receiptAmt - invoiceAmt).toFixed(2));\n\n    return {\n      estimatedreceiptbalance: remaining,\n      estimatedinvbalance: 0,\n      balancecommentary: `Receipt ${amtLabel} (${receiptAmt}) exceeds invoice ${amtLabel} (${invoiceAmt}). Invoice fully settled — receipt has remaining balance of ${remaining}.`\n    };\n  }\n\n  const remaining = parseFloat((invoiceAmt - receiptAmt).toFixed(2));\n\n  return {\n    estimatedreceiptbalance: 0,\n    estimatedinvbalance: remaining,\n    balancecommentary: `Invoice ${amtLabel} (${invoiceAmt}) exceeds receipt ${amtLabel} (${receiptAmt}). Receipt fully consumed — invoice has remaining balance of ${remaining}.`\n  };\n};\n\n// --- Confidence / match commentary builder --\nconst buildMatchCommentary = (receipt, invoice, matchType) => {\n  const amountsEqual = receipt.AMOUNTREMAINING === invoice.AMOUNTREMAINING;\n  const nameLabel = getLabel(\"CUSTOMERNAME\");\n  const accountLabel = getLabel(\"CUSTOMERACCOUNTNUMBER\");\n  const amtLabel = getLabel(\"AMOUNTREMAINING\");\n\n  switch (matchType) {\n    case \"SINGLE_SAME\":\n      if (amountsEqual) {\n        return `Confidence: HIGH — Single receipt matched to single invoice. ` +\n               `${nameLabel} and ${accountLabel} align, and ${amtLabel} is equal. ` +\n               `Strong candidate for application.`;\n      }\n\n      return `Confidence: MEDIUM — Single receipt matched to single invoice. ` +\n             `${nameLabel} and ${accountLabel} align, but ${amtLabel} differs ` +\n             `(receipt: ${receipt.AMOUNTREMAINING}, invoice: ${invoice.AMOUNTREMAINING}). ` +\n             `Partial application expected — verify before posting.`;\n\n    case \"SINGLE_MISMATCH\":\n      return `Confidence: LOW — Single receipt and single invoice auto-matched ` +\n             `but ${nameLabel} and ${accountLabel} do not align ` +\n             `(receipt: \"${receipt.CUSTOMERNAME}\" / ${receipt.CUSTOMERACCOUNTNUMBER}, ` +\n             `invoice: \"${invoice.CUSTOMERNAME}\" / ${invoice.CUSTOMERACCOUNTNUMBER}). ` +\n             `Manual review strongly recommended before application.`;\n\n    case \"MULTI_EXACT\":\n      if (amountsEqual) {\n        return `Confidence: HIGH — Matched from multiple records on ` +\n               `${nameLabel} \"${receipt.CUSTOMERNAME}\" and ` +\n               `${accountLabel} \"${receipt.CUSTOMERACCOUNTNUMBER}\". ` +\n               `${amtLabel} is equal — strong candidate for full application.`;\n      }\n\n      return `Confidence: MEDIUM — Matched from multiple records on ` +\n             `${nameLabel} \"${receipt.CUSTOMERNAME}\" and ` +\n             `${accountLabel} \"${receipt.CUSTOMERACCOUNTNUMBER}\". ` +\n             `${amtLabel} differs (receipt: ${receipt.AMOUNTREMAINING}, invoice: ${invoice.AMOUNTREMAINING}) — ` +\n             `partial application expected, verify before posting.`;\n\n    default:\n      return \"Confidence: LOW — Match basis unclear. Manual review required.\";\n  }\n};\n\n// --- Normalize inputs ---\nconst receipts = toArray(receiptData);\nconst invoices = toArray(invoiceData);\n\n// --- GUARD: One or both datasets empty/null ---\nif (receipts.length === 0 || invoices.length === 0) {\n  const output = {\n    receipts: receipts.map(stripReceipt),\n    invoices: invoices.map(stripInvoice),\n    matchcommentary: receipts.length === 0 && invoices.length === 0\n      ? \"Both receipt and invoice data are empty.\"\n      : receipts.length === 0\n        ? \"Receipt data is empty.\"\n        : \"Invoice data is empty.\",\n    matchFound: \"N\"\n  };\n\n  return output;\n}\n\n// --- CASE 1: Single record in BOTH datasets -\nif (receipts.length === 1 && invoices.length === 1) {\n  const receipt = receipts[0];\n  const invoice = invoices[0];\n\n  const sameCustomer =\n    receipt.CUSTOMERNAME === invoice.CUSTOMERNAME &&\n    receipt.CUSTOMERACCOUNTNUMBER === invoice.CUSTOMERACCOUNTNUMBER;\n\n  const { estimatedreceiptbalance, estimatedinvbalance, balancecommentary } =\n    computeBalances(receipt, invoice);\n\n  const appliedamount = computeAppliedAmount(receipt, invoice);\n\n  const confirmationmessage =\n    `Ready to apply receipt ${receipt.RECEIPTNUMBER} ` +\n    `to invoice ${invoice.TRANSACTIONNUMBER} — shall we proceed?`;\n\n  const matchcommentary = buildMatchCommentary(\n    receipt,\n    invoice,\n    sameCustomer ? \"SINGLE_SAME\" : \"SINGLE_MISMATCH\"\n  );\n\n  const output = {\n    CASHRECEIPTID: receipt.CASHRECEIPTID,\n    PAYMENTSCHEDULEID: invoice.PAYMENTSCHEDULEID,\n    appliedamount,\n    receipts: [stripReceipt(receipt)],\n    invoices: [stripInvoice(invoice)],\n    [estReceiptBalLabel]: estimatedreceiptbalance,\n    [estInvBalLabel]: estimatedinvbalance,\n    matchcommentary,\n    balancecommentary,\n    confirmationmessage,\n    matchFound: \"Y\"\n  };\n\n  return output;\n}\n\n// --- CASE 2, 3, 4 Candidate Matching ---\nlet candidateReceipts = receipts;\nlet candidateInvoices = invoices;\n\n// --- CASE 2: Multiple invoices, single receipt ---\nif (receipts.length === 1 && invoices.length > 1) {\n  const ref = receipts[0];\n\n  candidateInvoices = invoices.filter(inv =>\n    inv.CUSTOMERNAME === ref.CUSTOMERNAME &&\n    inv.CUSTOMERACCOUNTNUMBER === ref.CUSTOMERACCOUNTNUMBER\n  );\n}\n\n// --- CASE 3: Multiple receipts, single invoice ---\nelse if (invoices.length === 1 && receipts.length > 1) {\n  const ref = invoices[0];\n\n  candidateReceipts = receipts.filter(rec =>\n    rec.CUSTOMERNAME === ref.CUSTOMERNAME &&\n    rec.CUSTOMERACCOUNTNUMBER === ref.CUSTOMERACCOUNTNUMBER\n  );\n}\n\n// --- CASE 4: Multiple on BOTH sides ----\nelse if (receipts.length > 1 && invoices.length > 1) {\n  candidateReceipts = [];\n  candidateInvoices = [];\n\n  for (const rec of receipts) {\n    const matchingInvoices = invoices.filter(inv =>\n      inv.CUSTOMERNAME === rec.CUSTOMERNAME &&\n      inv.CUSTOMERACCOUNTNUMBER === rec.CUSTOMERACCOUNTNUMBER\n    );\n\n    if (matchingInvoices.length > 0) {\n      candidateReceipts.push(rec);\n      candidateInvoices.push(...matchingInvoices);\n    }\n  }\n\n  candidateInvoices = candidateInvoices.filter(\n    (inv, idx, self) =>\n      idx === self.findIndex(i => i.PAYMENTSCHEDULEID === inv.PAYMENTSCHEDULEID)\n  );\n}\n\n// --- NO MATCH FOUND — return ALL original records --\nif (candidateReceipts.length === 0 || candidateInvoices.length === 0) {\n  const output = {\n    receipts: receipts.map(stripReceipt),\n    invoices: invoices.map(stripInvoice),\n    matchcommentary: \"\",\n    matchFound: \"N\"\n  };\n\n  return output;\n}\n\n// --- MATCH FOUND ---\nconst matchedReceipt = candidateReceipts[0];\nconst matchedInvoice = candidateInvoices[0];\n\nconst { estimatedreceiptbalance, estimatedinvbalance, balancecommentary } =\n  computeBalances(matchedReceipt, matchedInvoice);\n\nconst appliedamount = computeAppliedAmount(matchedReceipt, matchedInvoice);\n\nconst confirmationmessage =\n  `Ready to apply receipt ${matchedReceipt.RECEIPTNUMBER} ` +\n  `to invoice ${matchedInvoice.TRANSACTIONNUMBER} — shall we proceed?`;\n\nconst matchcommentary = buildMatchCommentary(\n  matchedReceipt,\n  matchedInvoice,\n  \"MULTI_EXACT\"\n);\n\n// --- MATCH FOUND Multi-case Return ---\nconst output = {\n  CASHRECEIPTID: matchedReceipt.CASHRECEIPTID,\n  PAYMENTSCHEDULEID: matchedInvoice.PAYMENTSCHEDULEID,\n  appliedamount,\n  receipts: [stripReceipt(matchedReceipt)],\n  invoices: [stripInvoice(matchedInvoice)],\n  [estReceiptBalLabel]: estimatedreceiptbalance,\n  [estInvBalLabel]: estimatedinvbalance,\n  matchcommentary,\n  balancecommentary,\n  confirmationmessage,\n  matchFound: \"Y\"\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "1777354965575"
          },
          "code": "VERIFYMATCH",
          "id": "1777006631482",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
