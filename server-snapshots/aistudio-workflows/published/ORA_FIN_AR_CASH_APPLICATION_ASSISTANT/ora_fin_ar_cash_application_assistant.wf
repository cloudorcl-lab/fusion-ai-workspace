        {
          "metadata": {
            "name": "explorepathoutput",
            "returnType": "object",
            "sourceCode": "// ---Inputs---\nconst result = $context.$variables.summarizedoutput || {};\n\nconst summary = $context.$nodes.SUMMARIZEAPPEXPLORE.$output.summary;\n\nconst filterText =\n  $context.$nodes.SUMMARIZEAPPEXPLORE.$output.filterText ||\n  $context?.$variables?.chatcontext?.semantic_rewrite ||\n  \"\";\n\nconst suggestions = $context.$nodes.SUMMARIZEAPPEXPLORE.$output.suggestions;\n\nconst intentCode =\n  $context?.$variables?.chatcontext?.intent_code\n    ? String($context.$variables.chatcontext.intent_code).toUpperCase()\n    : \"\";\n\n// ---Resolve table title based on intent---\nfunction getTableTitle(intent) {\n  switch (String(intent || \"\").toUpperCase()) {\n    case \"INVOICE_EXPLORE\":\n      return \"Invoices\";\n\n    case \"PROMISE_EXPLORE\":\n      return \"Promises\";\n\n    case \"INVOICE_MATCH_EXPLORATION\":\n      return \"Invoice Match\";\n\n    case \"PROMISE_MATCH_EXPLORATION\":\n      return \"Promise Match\";\n\n    case \"REMITTANCE_ADVICE\":\n    case \"REMITTANCE_ADVICE_EXPLORE\":\n    case \"REMITTANCE_ADVICE_EXPLORATION\":\n      return \"Remittance Advices\";\n\n    default:\n      return \"Receipt Application\";\n  }\n}\n\nconst tableTitle = getTableTitle(intentCode);\n\n// ---Check whether table data exists---\nlet dataRows = Array.isArray(result?.data)\n  ? result.data\n  : Array.isArray(result)\n    ? result\n    : [];\n\nfunction isUniformNonBlankField(rows, fieldName) {\n  if (!Array.isArray(rows) || rows.length === 0) return false;\n\n  const firstValue = rows[0]?.[fieldName];\n\n  if (firstValue == null || String(firstValue).trim() === \"\") {\n    return false;\n  }\n\n  return rows.every(row => String(row?.[fieldName] ?? \"\") === String(firstValue));\n}\n\nfunction removeUniformScopeColumns(rows) {\n  if (!Array.isArray(rows) || rows.length === 0) return [];\n\n  const fieldsToSuppress = [\n    \"CUSTOMERNAME\",\n    \"CUSTOMERACCOUNTNUMBER\",\n    \"BUSINESSUNITNAME\"\n  ].filter(fieldName => isUniformNonBlankField(rows, fieldName));\n\n  if (fieldsToSuppress.length === 0) {\n    return rows;\n  }\n\n  return rows.map(row => {\n    const copy = { ...row };\n\n    fieldsToSuppress.forEach(fieldName => {\n      delete copy[fieldName];\n    });\n\n    return copy;\n  });\n}\n\ndataRows = removeUniformScopeColumns(dataRows);\n\nconst hasDataRows = dataRows.length > 0;\n\nfunction pluralizeEntityName(entity) {\n  const value = String(entity || \"\").trim();\n  if (!value) return \"records\";\n\n  const lower = value.toLowerCase();\n  const known = {\n    receipt: \"receipts\",\n    invoice: \"invoices\",\n    promise: \"promises\",\n    candidate: \"candidates\",\n    remittance: \"remittances\",\n    \"remittance advice\": \"remittance advices\",\n    advice: \"advices\",\n    application: \"applications\",\n    transaction: \"transactions\",\n    customer: \"customers\",\n    account: \"accounts\"\n  };\n\n  if (known[lower]) return known[lower];\n  if (/[^aeiou]y$/i.test(value)) return value.slice(0, -1) + \"ies\";\n  if (/(s|x|z|ch|sh)$/i.test(value)) return value + \"es\";\n  if (/\\s/.test(value)) return \"records\";\n  return value + \"s\";\n}\n\n// ---Resolve text summary---\nconst summaryText =\n  (typeof summary === \"string\"\n    ? summary\n    : summary?.text || summary?.result || summary?.message || \"\") ||\n  \"\";\n\n// ---Resolve filters text ---\n// Do not prefix with \"Filters -\"; the section title already says Filters.\nconst filtersText = \n  (typeof filterText === \"string\"\n    ? filterText\n    : filterText?.text || filterText?.result || filterText?.message || \"\") ||\n    \"\";\n\n// ---Escape HTML for safe suggestions rendering---\nfunction escapeHtml(value) {\n  return String(value)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\n// ---Resolve suggestions text ---\n// Suggestions come from rollup/summarization output: result.suggestions.\n// Supports:\n//   1. Array: [\"Show open invoices for Customer A\", \"Show promises for Customer A\"]\n//   2. Plain string with bullets/newlines\n//   3. HTML string with <ul>/<li>\nlet suggestionsHtml = \"\";\n\nif (Array.isArray(suggestions) && suggestions.length > 0) {\n  const items = suggestions\n    .filter(Boolean)\n    .map(s => String(s).replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n} else if (typeof suggestions === \"string\" && suggestions.trim()) {\n  const rawSuggestions = suggestions.trim();\n\n  if (/^\\s*<ul[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = rawSuggestions;\n  } else if (/^\\s*<li[\\s>]/i.test(rawSuggestions)) {\n    suggestionsHtml = \"<ul>\" + rawSuggestions + \"</ul>\";\n  } else {\n    const items = rawSuggestions\n      .split(/\\n+/)\n      .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n      .filter(Boolean);\n\n    if (items.length > 0) {\n      suggestionsHtml =\n        \"<ul>\" +\n        items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n        \"</ul>\";\n    }\n  }\n} else if (suggestions?.text || suggestions?.result || suggestions?.message) {\n  const rawSuggestions = String(\n    suggestions.text || suggestions.result || suggestions.message || \"\"\n  ).trim();\n\n  const items = rawSuggestions\n    .split(/\\n+/)\n    .map(s => s.replace(/^[-•]\\s*/, \"\").trim())\n    .filter(Boolean);\n\n  if (items.length > 0) {\n    suggestionsHtml =\n      \"<ul>\" +\n      items.map(s => \"<li>\" + escapeHtml(s) + \"</li>\").join(\"\") +\n      \"</ul>\";\n  }\n}\n\n// ---GUARD: No data, no summary, no filters, no suggestions ---\nif (!hasDataRows && !summaryText && !filtersText && !suggestionsHtml) {\n  return {\n    messages: [\n      {\n        id: \"no_data\",\n        type: \"text\",\n        contentPolicy: \"author\",\n        authoringHints: \"Write a short message\",\n        data: \"No data found.\"\n      }\n    ]\n  };\n}\n\n// ---Build messages in required display order---\n// 1. Summary - text\n// 2. Filters - text\n// 3. Data - table\n// 4. Suggestions - text\n\nconst messages = [];\n\nif (summaryText) {\n  messages.push({\n    id: \"summary\",\n    type: \"text\",\n    contentPolicy: \"preserve\",\n    authoringHints: \"Display as is. Render any HTML bulleted list. Do not summarize or rewrite.\",\n    data: summaryText\n  });\n}\n\nif (filtersText && hasDataRows) {\n  messages.push({\n    id: \"filters\",\n    type: \"text\",\n    contentPolicy: \"preserve\",\n    authoringHints: \"Do not summarize, display as is.\",\n    data: filtersText\n  });\n}\n\nif (hasDataRows) {\n  messages.push({\n    id: \"details_table\",\n    type: \"table\",\n    title: tableTitle,\n    authoringHints:\n      \"Detailed results from the summarization output. Respect the column order provided by the data. Exclude duplicate currency columns if currency is already represented in amount text or summary.\",\n    data: dataRows.slice(0, 200),\n    chatDisplayConfig: {\n      limitRowsInChat: true,\n      rowLimit: 10\n    }\n  });\n}\n\nif (suggestionsHtml) {\n  messages.push({\n    id: \"suggestions\",\n    type: \"text\",\n    title: \"Suggestions\",\n    contentPolicy: \"normalizeOnly\",\n    authoringHints: \"Display as HTML bulleted list. Do not summarize or rewrite.\",\n    data: suggestionsHtml\n  });\n}\n\nreturn {\n  messages\n};"
          },
