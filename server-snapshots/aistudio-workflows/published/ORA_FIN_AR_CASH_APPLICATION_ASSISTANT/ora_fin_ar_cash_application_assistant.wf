          "code": "SETAPPLYCONFIRM",
          "convergenceTargetId": "1777402400778",
          "id": "1777402597934",
          "inputs": [
            {
              "id": "1777402607301",
              "name": "applicationDetails",
              "scope": "JOB",
              "type": "object",
              "value": "{\n    \"confirm_shapes\": [\n        {\n            \"name\": \"invoiceapplyprep\",\n            \"value\": {\n                \"select\": \"select paymentScheduleId,customerName,customerAccountNumber,transactionNumber,originalAmount,amountRemaining, installmentDueDate,paymentScheduleId ,invoiceCurrencyCode FROM receivablesPaymentSchedule where paymentScheduleId = dummyinv_num\",\n                \"viewQueries\": {\n    \"receivablesPaymentSchedule\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n      \"view\": \"receivablesPaymentSchedule\",\n      \"fieldAliases\": {\n        \"paymentScheduleId\": \"paymentScheduleId\",\n\t\t\"customerAccount.customer.name\": \"customerName\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"originalAmount\": \"originalAmount\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"transactionNumber\": \"transactionNumber\",\n\t\t\"customerAccount.accountNumber\": \"customerAccountNumber\",\n\t\t\"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\"\n      }\n    }\n  }\n            }\n        },\n\t\t\n{\n            \"name\": \"receptapplyprep\",\n            \"value\": {\n                \"select\": \"SELECT cashReceiptId,customerName, customerAccountNumber, receiptNumber, receiptDate, (-1 * amountRemaining) AS AmountRemaining, receiptCurrencyCode FROM ReceivablesReceiptDetail where cashReceiptId= dummyrec_num\",\n                \"viewQueries\": {\n                    \"ReceivablesReceiptDetail\": {\n                        \"view\": \"receivablesReceiptDetail\",\n                        \"businessObject\": \"ReceivablesReceipt\",\n                        \"module\": \"oraErpCoreReceivablesPayments\",\n                        \"fieldAliases\": {\n                            \"cashReceiptId\": \"cashReceiptId\",\n\t\t\t\t\t\t\t\"customerAccount.customer.name\": \"customerName\",\n                            \"receiptCurrency.currencyCode\": \"receiptCurrencyCode\",\n\t\t\t\t\t\t\t\"customerAccount.accountNumber\": \"customerAccountNumber\",\n                            \"receiptDate\": \"receiptDate\",\n                            \"receiptNumber\": \"receiptNumber\",\n\t\t\t\t\t\t\t\"paymentSchedule.amountRemaining\": \"amountRemaining\"\n                        }\n                    }\n                }\n            }\n        }\n    ]\n\t}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "postAppDetails",
            "returnType": "object",
            "sourceCode": "function buildApplicationShapes() {\n  const app_details = $context.$variables.applicationDetails;\n  const psid = $context.$variables.matchpsid;\n  const recid = $context.$variables.matchcashrecId;\n\n  // Parse if string\n  const parsed = typeof app_details === \"string\"\n    ? JSON.parse(app_details)\n    : app_details;\n\n  const shapes = parsed.confirm_shapes || [];\n\n  // Target shape names\n  const targetNames = [\"invoiceapplyprep\", \"receptapplyprep\"];\n\n  // Build lookup map\n  const shapeMap = {};\n  for (const shape of shapes) {\n    shapeMap[shape.name] = shape.value;\n  }\n\n  const result = targetNames.map((name) => {\n    const value = shapeMap[name];\n\n    if (!value) {\n      return { name, error: `Shape '${name}' not found` };\n    }\n\n    // Replace placeholders in select statement\n    let resolvedSelect = value.select;\n\n    if (name === \"invoiceapplyprep\" && psid) {\n      resolvedSelect = resolvedSelect.replace(/dummyinv_num/g, psid);\n    }\n\n    if (name === \"receptapplyprep\" && recid) {\n      resolvedSelect = resolvedSelect.replace(/dummyrec_num/g, recid);\n    }\n\n    return {\n      name,\n      value: {\n        select: resolvedSelect,\n        viewQueries: value.viewQueries\n      }\n    };\n  });\n\n  return result;\n}\n\nconst output = buildApplicationShapes();\nreturn output;"
          },
          "outcomes": {
            "success": "1777402760978"
          },
          "code": "POSTAPPDETAILS",
          "convergenceTargetId": "1777402400778",
          "id": "1777402660801",
