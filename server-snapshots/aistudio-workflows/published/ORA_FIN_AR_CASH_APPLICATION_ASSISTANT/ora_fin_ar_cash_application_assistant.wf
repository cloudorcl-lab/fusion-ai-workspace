              "value": "{\n  \"attributes\": [\n    { \"attributeName\": \"accountedBalanceDue\", \"label\": \"Accounted Balance Due\" },\n    { \"attributeName\": \"accountingDate\", \"label\": \"Accounting Date\" },\n    { \"attributeName\": \"activeClaimLookupCategoryId\", \"label\": \"Active Claim Lookup Category ID\" },\n    { \"attributeName\": \"activeClaimLookupCode\", \"label\": \"Active Claim Lookup Code\" },\n    { \"attributeName\": \"activeClaimLookupType\", \"label\": \"Active Claim Lookup Type\" },\n    { \"attributeName\": \"activeClaimMeaning\", \"label\": \"Active Claim Meaning\" },\n    { \"attributeName\": \"actualClosedDate\", \"label\": \"Actual Closed Date\" },\n    { \"attributeName\": \"actualValueDate\", \"label\": \"Actual Value Date\" },\n    { \"attributeName\": \"amount\", \"label\": \"Amount\" },\n    { \"attributeName\": \"amountAdjusted\", \"label\": \"Amount Adjusted\" },\n    { \"attributeName\": \"amountApplied\", \"label\": \"Amount Applied\" },\n    { \"attributeName\": \"amountCredited\", \"label\": \"Amount Credited\" },\n    { \"attributeName\": \"amountOnAccount\", \"label\": \"Amount On Account\" },\n    { \"attributeName\": \"amountOtherAccount\", \"label\": \"Amount in Other Account\" },\n    { \"attributeName\": \"amountRemaining\", \"label\": \"Amount Remaining\" },\n    { \"attributeName\": \"amountRemainingOffset\", \"label\": \"Amount Remaining Offset\" },\n    { \"attributeName\": \"anticipatedClearingDate\", \"label\": \"Anticipated Clearing Date\" },\n    { \"attributeName\": \"applicationDate\", \"label\": \"Application Date\" },\n    { \"attributeName\": \"bankAccount\", \"label\": \"Bank Account\" },\n    { \"attributeName\": \"bankAccountCurrencyCode\", \"label\": \"Bank Account Currency Code\" },\n    { \"attributeName\": \"bankAccountName\", \"label\": \"Bank Account Name\" },\n    { \"attributeName\": \"bankAccountNumber\", \"label\": \"Bank Account Number\" },\n    { \"attributeName\": \"bankBranchName\", \"label\": \"Bank Branch Name\" },\n    { \"attributeName\": \"bankName\", \"label\": \"Bank Name\" },\n    { \"attributeName\": \"balanceFwdBillNumber\", \"label\": \"Balance Forward Bill Number\" },\n    { \"attributeName\": \"businessUnitId\", \"label\": \"Business Unit ID\" },\n    { \"attributeName\": \"businessUnitName\", \"label\": \"Business Unit Name\" },\n    { \"attributeName\": \"cashReceiptId\", \"label\": \"Cash Receipt ID\" },\n    { \"attributeName\": \"cashReceiptStatus\", \"label\": \"Cash Receipt Status\" },\n    { \"attributeName\": \"checkNumber\", \"label\": \"Check Number\" },\n    { \"attributeName\": \"closedAccountingDate\", \"label\": \"Closed Accounting Date\" },\n    { \"attributeName\": \"comments\", \"label\": \"Comments\" },\n    { \"attributeName\": \"contractNumber\", \"label\": \"Contract Number\" },\n    { \"attributeName\": \"conversionDate\", \"label\": \"Conversion Date\" },\n    { \"attributeName\": \"conversionRate\", \"label\": \"Conversion Rate\" },\n    { \"attributeName\": \"conversionRateType\", \"label\": \"Conversion Rate Type\" },\n    { \"attributeName\": \"currentCashReceiptHistoryCurrentRecord\", \"label\": \"Current Cash Receipt History Current Record\" },\n    { \"attributeName\": \"currentCashReceiptHistoryId\", \"label\": \"Current Cash Receipt History ID\" },\n    { \"attributeName\": \"currency\", \"label\": \"Currency\" },\n    { \"attributeName\": \"customerAccountId\", \"label\": \"Customer Account ID\" },\n    { \"attributeName\": \"customerAccountNumber\", \"label\": \"Customer Account Number\" },\n    { \"attributeName\": \"customerDetails\", \"label\": \"Customer Details\" },\n    { \"attributeName\": \"customerId\", \"label\": \"Customer ID\" },\n    { \"attributeName\": \"customerName\", \"label\": \"Customer Name\" },\n    { \"attributeName\": \"customerReason\", \"label\": \"Customer Reason\" },\n    { \"attributeName\": \"customerReference\", \"label\": \"Customer Reference\" },\n    { \"attributeName\": \"customerRegistryId\", \"label\": \"Customer Registry ID\" },\n    { \"attributeName\": \"customerSiteAddress1\", \"label\": \"Customer Site Address Line 1\" },\n    { \"attributeName\": \"customerSiteAddress2\", \"label\": \"Customer Site Address Line 2\" },\n    { \"attributeName\": \"customerSiteAddress3\", \"label\": \"Customer Site Address Line 3\" },\n    { \"attributeName\": \"customerSiteAddress4\", \"label\": \"Customer Site Address Line 4\" },\n    { \"attributeName\": \"customerSiteAddressName\", \"label\": \"Customer Site Address Name\" },\n    { \"attributeName\": \"customerSiteAddressNumber\", \"label\": \"Customer Site Address Number\" },\n    { \"attributeName\": \"customerSiteCity\", \"label\": \"Customer Site City\" },\n    { \"attributeName\": \"customerSiteCountryCode\", \"label\": \"Customer Site Country Code\" },\n    { \"attributeName\": \"customerSiteCountryName\", \"label\": \"Customer Site Country Name\" },\n    { \"attributeName\": \"customerSitePostalCode\", \"label\": \"Customer Site Postal Code\" },\n    { \"attributeName\": \"customerSiteProvince\", \"label\": \"Customer Site Province\" },\n    { \"attributeName\": \"customerSiteState\", \"label\": \"Customer Site State\" },\n    { \"attributeName\": \"customerTransactionBillTemplateName\", \"label\": \"Customer Transaction Bill Template Name\" },\n    { \"attributeName\": \"customerTransactionCreatedFromApplication\", \"label\": \"Customer Transaction Created From Application\" },\n    { \"attributeName\": \"customerTransactionDeliveryContactEmailAddress\", \"label\": \"Customer Transaction Delivery Contact Email Address\" },\n    { \"attributeName\": \"customerTransactionFirstPrintDate\", \"label\": \"Customer Transaction First Print Date\" },\n    { \"attributeName\": \"customerTransactionId\", \"label\": \"Customer Transaction ID\" },\n    { \"attributeName\": \"customerTransactionIntercompany\", \"label\": \"Customer Transaction Intercompany Indicator\" },\n    { \"attributeName\": \"customerTransactionLastPrintingDate\", \"label\": \"Customer Transaction Last Printing Date\" },\n    { \"attributeName\": \"customerTransactionPrintCount\", \"label\": \"Customer Transaction Print Count\" },\n    { \"attributeName\": \"customerTransactionPrintPending\", \"label\": \"Customer Transaction Print Pending\" },\n    { \"attributeName\": \"customerTransactionSourceSystem\", \"label\": \"Customer Transaction Source System\" },\n    { \"attributeName\": \"customerTransactionTypeName\", \"label\": \"Customer Transaction Type Name\" },\n    { \"attributeName\": \"customerTransactionTypeSequenceId\", \"label\": \"Customer Transaction Type Sequence ID\" },\n    { \"attributeName\": \"customerTransactionTypeUsageLookupCategoryId\", \"label\": \"Customer Transaction Type Usage Lookup Category ID\" },\n    { \"attributeName\": \"customerTransactionTypeUsageLookupCode\", \"label\": \"Customer Transaction Type Usage Lookup Code\" },\n    { \"attributeName\": \"customerTransactionTypeUsageLookupType\", \"label\": \"Customer Transaction Type Usage Lookup Type\" },\n    { \"attributeName\": \"customerTransactionTypeUsageMeaning\", \"label\": \"Customer Transaction Type Usage Meaning\" },\n    { \"attributeName\": \"delinquencyId\", \"label\": \"Delinquency ID\" },\n    { \"attributeName\": \"delinquencyStatusLookupType\", \"label\": \"Delinquency Status Lookup Type\" },\n    { \"attributeName\": \"delinquencyStatusMeaning\", \"label\": \"Delinquency Status Meaning\" },\n    { \"attributeName\": \"delinquencyUnpaidReasonLookupCode\", \"label\": \"Delinquency Unpaid Reason Lookup Code\" },\n    { \"attributeName\": \"delinquencyUnpaidReasonLookupType\", \"label\": \"Delinquency Unpaid Reason Lookup Type\" },\n    { \"attributeName\": \"delinquencyUnpaidReasonMeaning\", \"label\": \"Delinquency Unpaid Reason Meaning\" },\n    { \"attributeName\": \"depositDate\", \"label\": \"Deposit Date\" },\n    { \"attributeName\": \"disputeAmount\", \"label\": \"Dispute Amount\" },\n    { \"attributeName\": \"disputeDate\", \"label\": \"Dispute Date\" },\n    { \"attributeName\": \"documentNumber\", \"label\": \"Document Number\" },\n    { \"attributeName\": \"dunningLevel\", \"label\": \"Dunning Level\" },\n    { \"attributeName\": \"dunningLevelOverrideDate\", \"label\": \"Dunning Level Override Date\" },\n    { \"attributeName\": \"earnedDiscount\", \"label\": \"Earned Discount\" },\n    { \"attributeName\": \"excludeFromConsolidatedInvoice\", \"label\": \"Exclude From Consolidated Invoice\" },\n    { \"attributeName\": \"excludeFromDunning\", \"label\": \"Exclude From Dunning\" },\n    { \"attributeName\": \"factorDiscountAmount\", \"label\": \"Factor Discount Amount\" },\n    { \"attributeName\": \"freightBalanceDue\", \"label\": \"Freight Balance Due\" },\n    { \"attributeName\": \"installmentClass\", \"label\": \"Installment Class\" },\n    { \"attributeName\": \"installmentDueDate\", \"label\": \"Installment Due Date\" },\n    { \"attributeName\": \"installmentStatus\", \"label\": \"Installment Status\" },\n    { \"attributeName\": \"invoiceCurrencyCode\", \"label\": \"Invoice Currency Code\" },\n    { \"attributeName\": \"invoiceCurrencyName\", \"label\": \"Invoice Currency Name\" },\n    { \"attributeName\": \"invoiceDueDate\", \"label\": \"Invoice Due Date\" },\n    { \"attributeName\": \"invoiceNumber\", \"label\": \"Invoice Number\" },\n    { \"attributeName\": \"invoiceReference\", \"label\": \"Invoice Reference\" },\n    { \"attributeName\": \"isSelectedForFactoring\", \"label\": \"Selected for Factoring\" },\n    { \"attributeName\": \"lateChargeDate\", \"label\": \"Late Charge Date\" },\n    { \"attributeName\": \"ledgerCurrencyCode\", \"label\": \"Ledger Currency Code\" },\n    { \"attributeName\": \"ledgerCurrencyName\", \"label\": \"Ledger Currency Name\" },\n    { \"attributeName\": \"ledgerCurrencyPrecision\", \"label\": \"Ledger Currency Precision\" },\n    { \"attributeName\": \"legalEntityCountryCode\", \"label\": \"Legal Entity Country Code\" },\n    { \"attributeName\": \"legalEntityGeographyId\", \"label\": \"Legal Entity Geography ID\" },\n    { \"attributeName\": \"legalEntityId\", \"label\": \"Legal Entity ID\" },\n    { \"attributeName\": \"legalEntityIdentifier\", \"label\": \"Legal Entity Identifier\" },\n    { \"attributeName\": \"legalEntityName\", \"label\": \"Legal Entity Name\" },\n    { \"attributeName\": \"lockboxBatch\", \"label\": \"Lockbox Batch\" },\n    { \"attributeName\": \"numberOfInstallments\", \"label\": \"Number of Installments\" },\n    { \"attributeName\": \"originatorName\", \"label\": \"Originator Name\" },\n    { \"attributeName\": \"originalAmount\", \"label\": \"Original Amount\" },\n    { \"attributeName\": \"originalFreightAmount\", \"label\": \"Original Freight Amount\" },\n    { \"attributeName\": \"originalTaxAmount\", \"label\": \"Original Tax Amount\" },\n    { \"attributeName\": \"payingCustomerAccountId\", \"label\": \"Paying Customer Account ID\" },\n    { \"attributeName\": \"payingCustomerAccountNumber\", \"label\": \"Paying Customer Account Number\" },\n    { \"attributeName\": \"payingCustomerAccountSiteId\", \"label\": \"Paying Customer Account Site ID\" },\n    { \"attributeName\": \"payingCustomerPartyId\", \"label\": \"Paying Customer Party ID\" },\n    { \"attributeName\": \"payingCustomerPartyName\", \"label\": \"Paying Customer Party Name\" },\n    { \"attributeName\": \"payingCustomerPartyRegistryId\", \"label\": \"Paying Customer Party Registry ID\" },\n    { \"attributeName\": \"payingSiteUseId\", \"label\": \"Paying Site Use ID\" },\n    { \"attributeName\": \"paymentChannel\", \"label\": \"Payment Channel\" },\n    { \"attributeName\": \"paymentScheduleId\", \"label\": \"Payment Schedule ID\" },\n    { \"attributeName\": \"paymentTermId\", \"label\": \"Payment Term ID\" },\n    { \"attributeName\": \"paymentTermName\", \"label\": \"Payment Term Name\" },\n    { \"attributeName\": \"pendingAdjustmentAmount\", \"label\": \"Pending Adjustment Amount\" },\n    { \"attributeName\": \"postmarkDate\", \"label\": \"Postmark Date\" },\n    { \"attributeName\": \"predictedPaymentDate\", \"label\": \"Predicted Payment Date\" },\n    { \"attributeName\": \"predictionId\", \"label\": \"Prediction ID\" },\n    { \"attributeName\": \"predictionTimeCreated\", \"label\": \"Prediction Created Time\" },\n    { \"attributeName\": \"predictionTimeUpdated\", \"label\": \"Prediction Updated Time\" },\n    { \"attributeName\": \"promiseAmount\", \"label\": \"Promise Amount\" },\n    { \"attributeName\": \"promiseDate\", \"label\": \"Promise Date\" },\n    { \"attributeName\": \"purchaseOrderNumber\", \"label\": \"Purchase Order Number\" },\n    { \"attributeName\": \"receiptAmount\", \"label\": \"Receipt Amount\" },\n    { \"attributeName\": \"receiptBatchDate\", \"label\": \"Receipt Batch Date\" },\n    { \"attributeName\": \"receiptBatchId\", \"label\": \"Receipt Batch ID\" },\n    { \"attributeName\": \"receiptBatchName\", \"label\": \"Receipt Batch Name\" },\n    { \"attributeName\": \"receiptClassCreationMethodCode\", \"label\": \"Receipt Class Creation Method Code\" },\n    { \"attributeName\": \"receiptClassId\", \"label\": \"Receipt Class ID\" },\n    { \"attributeName\": \"receiptCurrencyCode\", \"label\": \"Receipt Currency Code\" },\n    { \"attributeName\": \"receiptCurrencyName\", \"label\": \"Receipt Currency Name\" },\n    { \"attributeName\": \"receiptDate\", \"label\": \"Receipt Date\" },\n    { \"attributeName\": \"receiptInternalStatus\", \"label\": \"Receipt Internal Status\" },\n    { \"attributeName\": \"receiptMethodId\", \"label\": \"Receipt Method ID\" },\n    { \"attributeName\": \"receiptMethodName\", \"label\": \"Receipt Method Name\" },\n    { \"attributeName\": \"receiptNumber\", \"label\": \"Receipt Number\" },\n    { \"attributeName\": \"receiptReferenceStatus\", \"label\": \"Receipt Reference Status\" },\n    { \"attributeName\": \"receiptStatus\", \"label\": \"Receipt Status\" },\n    { \"attributeName\": \"recommendationCount\", \"label\": \"Recommendation Count\" },\n    { \"attributeName\": \"remainingInvoiceBalance\", \"label\": \"Remaining Invoice Balance\" },\n    { \"attributeName\": \"remittanceReference\", \"label\": \"Remittance Reference\" },\n    { \"attributeName\": \"reversalCategory\", \"label\": \"Reversal Category\" },\n    { \"attributeName\": \"reversalComments\", \"label\": \"Reversal Comments\" },\n    { \"attributeName\": \"reversalDate\", \"label\": \"Reversal Date\" },\n    { \"attributeName\": \"reversalReasonLookupCategoryId\", \"label\": \"Reversal Reason Lookup Category ID\" },\n    { \"attributeName\": \"reversalReasonLookupCode\", \"label\": \"Reversal Reason Lookup Code\" },\n    { \"attributeName\": \"reversalReasonLookupType\", \"label\": \"Reversal Reason Lookup Type\" },\n    { \"attributeName\": \"reversalReasonMeaning\", \"label\": \"Reversal Reason Meaning\" },\n    { \"attributeName\": \"salesOrder\", \"label\": \"Sales Order\" },\n    { \"attributeName\": \"sequence\", \"label\": \"Sequence\" },\n    { \"attributeName\": \"siteUseId\", \"label\": \"Site Use ID\" },\n    { \"attributeName\": \"statementLineAdditionalEntryInformation\", \"label\": \"Statement Line Additional Entry Information\" },\n    { \"attributeName\": \"statementLineBookingDate\", \"label\": \"Statement Line Booking Date\" },\n    { \"attributeName\": \"statementLineCheckNumber\", \"label\": \"Statement Line Check Number\" },\n    { \"attributeName\": \"statementLineId\", \"label\": \"Statement Line ID\" },\n    { \"attributeName\": \"statementLineStructuredPaymentReference\", \"label\": \"Statement Line Structured Payment Reference\" },\n    { \"attributeName\": \"statusCode\", \"label\": \"Status Code\" },\n    { \"attributeName\": \"statusDate\", \"label\": \"Status Date\" },\n    { \"attributeName\": \"structuredPaymentReference\", \"label\": \"Structured Payment Reference\" },\n    { \"attributeName\": \"taxRemainingAmount\", \"label\": \"Tax Remaining Amount\" },\n    { \"attributeName\": \"timeCreated\", \"label\": \"Time Created\" },\n    { \"attributeName\": \"timeUpdated\", \"label\": \"Time Updated\" },\n    { \"attributeName\": \"transactionDate\", \"label\": \"Transaction Date\" },\n    { \"attributeName\": \"transactionNumber\", \"label\": \"Transaction Number\" },\n    { \"attributeName\": \"type\", \"label\": \"Type\" },\n    { \"attributeName\": \"unearnedDiscount\", \"label\": \"Unearned Discount\" },\n    { \"attributeName\": \"waybillNumber\", \"label\": \"Waybill Number\" },\n { \"attributeName\": \"estimatedreceiptbalance\", \"label\": \"Estimated Receipt Balance\" },\n { \"attributeName\": \"estimatedinvbalance\", \"label\": \"Estimated Invoice Balance\" }\n  ]\n}"
