          "metadata": {
            "name": "performsummarization",
            "returnType": "object",
            "sourceCode": "// --- Input ---\n\nvar inputData = null;\ninputData = $context.$nodes.EXECUTEEXTRACT.$output;\n\nvar intentCode =\n  $context &&\n  $context.$variables &&\n  $context.$variables.chatcontext &&\n  $context.$variables.chatcontext.intent_code\n    ? String($context.$variables.chatcontext.intent_code)\n    : \"\";\n\nvar debug = {};\n\n// --- Configuration ---\n\nvar RAW_THRESHOLD = 10;\nvar MAX_OUTPUT_ROWS = 500;\n\nvar NO_ROLLUP_INTENTS = [\n  \"INVOICE_MATCH_EXPLORATION\",\n  \"PROMISE_MATCH_EXPLORATION\"\n];\n\n// --- Helpers ---\n\nfunction getSemanticRewriteText() {\n  return $context &&\n    $context.$variables &&\n    $context.$variables.chatcontext &&\n    $context.$variables.chatcontext.semantic_rewrite\n      ? String($context.$variables.chatcontext.semantic_rewrite)\n      : \"\";\n}\n\nfunction normalizeDisplayText(text) {\n  if (text == null) return \"\";\n\n  var value = String(text).trim();\n\n  if (!value) return \"\";\n\n  if (value.charAt(value.length - 1) !== \".\") {\n    value += \".\";\n  }\n\n  return value;\n}\n\nfunction shouldBypassRollupForIntent(intent) {\n  var intentUpper = String(intent || \"\").toUpperCase();\n\n  for (var i = 0; i < NO_ROLLUP_INTENTS.length; i++) {\n    if (String(NO_ROLLUP_INTENTS[i]).toUpperCase() === intentUpper) {\n      return true;\n    }\n  }\n\n  return false;\n}\n\nfunction parseAmount(value) {\n  var num = Number(value);\n  return value != null && !isNaN(num) ? num : 0;\n}\n\nfunction roundAmount(value) {\n  return Math.round(Number(value || 0) * 100) / 100;\n}\n\nfunction formatAmount(amount) {\n  if (amount == null || isNaN(Number(amount))) return \"unknown amount\";\n\n  return Number(amount).toLocaleString(undefined, {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n}\n\nfunction formatAmountWithCurrency(amount, currency) {\n  var formattedAmount = formatAmount(amount);\n\n  if (currency == null || currency === \"\") {\n    return formattedAmount;\n  }\n\n  return formattedAmount + \" \" + currency;\n}\n\nfunction firstNonEmpty() {\n  for (var i = 0; i < arguments.length; i++) {\n    if (arguments[i] != null && arguments[i] !== \"\") {\n      return arguments[i];\n    }\n  }\n\n  return \"\";\n}\n\nfunction getBusinessUnit(row) {\n  return firstNonEmpty(\n    row.BUSINESSUNITNAME,\n    row.BUSINESSUNIT,\n    row.BUSINESSUNITID,\n    row.BUNAME,\n    row.BU,\n    row[\"Business Unit\"],\n    row[\"BUSINESS UNIT\"],\n    row[\"Business Unit Name\"],\n    row[\"BUSINESS UNIT NAME\"],\n    row.BusinessUnitName,\n    row.BusinessUnit,\n    row.BusinessUnitId,\n    row.businessUnitName,\n    row.businessUnit,\n    row.businessUnitId\n  );\n}\n\nfunction getCustomerName(row) {\n  return firstNonEmpty(\n    row.CUSTOMERNAME,\n    row.customerName,\n    row.customer,\n    row.CUSTOMER,\n    row.PARTYNAME,\n    row.partyName\n  );\n}\n\nfunction getAccountNumber(row) {\n  return firstNonEmpty(\n    row.CUSTOMERACCOUNTNUMBER,\n    row.customerAccountNumber,\n    row.ACCOUNTNUMBER,\n    row.accountNumber,\n    row.account\n  );\n}\n\nfunction getInvoiceCurrency(row) {\n  return firstNonEmpty(\n    row.INVOICECURRENCYCODE,\n    row.invoiceCurrencyCode,\n    row.INVOICECURRENCY,\n    row.invoiceCurrency,\n    row.CURRENCYCODE,\n    row.currencyCode,\n    row.CURRENCY,\n    row.currency\n  );\n}\n\nfunction getTransactionNumber(row) {\n  return firstNonEmpty(\n    row.TRANSACTIONNUMBER,\n    row.transactionNumber,\n    row.INVOICENUMBER,\n    row.invoiceNumber\n  );\n}\n\nfunction getInstallmentDueDate(row) {\n  return firstNonEmpty(\n    row.INSTALLMENTDUEDATE,\n    row.installmentDueDate,\n    row.INVOICEDUEDATE,\n    row.invoiceDueDate,\n    row.DUEDATE,\n    row.dueDate\n  );\n}\n\nfunction getPromiseDate(row) {\n  return firstNonEmpty(\n    row.PROMISEDATE,\n    row.promiseDate\n  );\n}\n\nfunction getAmountRemaining(row) {\n  return firstNonEmpty(\n    row.AMOUNTREMAINING,\n    row.amountRemaining,\n    row.REMAININGINVOICEBALANCE,\n    row.remainingInvoiceBalance\n  );\n}\n\nfunction getOriginalAmount(row) {\n  return firstNonEmpty(\n    row.ORIGINALAMOUNT,\n    row.originalAmount\n  );\n}\n\nfunction getPromiseAmount(row) {\n  return firstNonEmpty(\n    row.PROMISEAMOUNT,\n    row.promiseAmount\n  );\n}\n\nfunction cleanInvoiceRow(row) {\n  return {\n    BUSINESSUNITNAME: getBusinessUnit(row),\n    CUSTOMERNAME: getCustomerName(row),\n    CUSTOMERACCOUNTNUMBER: getAccountNumber(row),\n    TRANSACTIONNUMBER: getTransactionNumber(row),\n    INSTALLMENTDUEDATE: getInstallmentDueDate(row),\n    AMOUNTREMAINING: getAmountRemaining(row),\n    ORIGINALAMOUNT: getOriginalAmount(row),\n    INVOICECURRENCYCODE: getInvoiceCurrency(row)\n  };\n}\n\nfunction cleanPromiseRow(row) {\n  return {\n    BUSINESSUNITNAME: getBusinessUnit(row),\n    CUSTOMERNAME: getCustomerName(row),\n    CUSTOMERACCOUNTNUMBER: getAccountNumber(row),\n    TRANSACTIONNUMBER: getTransactionNumber(row),\n    INSTALLMENTDUEDATE: getInstallmentDueDate(row),\n    PROMISEDATE: getPromiseDate(row),\n    PROMISEAMOUNT: getPromiseAmount(row),\n    AMOUNTREMAINING: getAmountRemaining(row),\n    INVOICECURRENCYCODE: getInvoiceCurrency(row)\n  };\n}\n\nfunction sortByCustomerAndAccount(rows) {\n  rows.sort(function(a, b) {\n    var ca = String(getCustomerName(a) || a.CUSTOMERNAME || \"\").toLowerCase();\n    var cb = String(getCustomerName(b) || b.CUSTOMERNAME || \"\").toLowerCase();\n    var aa = String(getAccountNumber(a) || a.CUSTOMERACCOUNTNUMBER || \"\").toLowerCase();\n    var ab = String(getAccountNumber(b) || b.CUSTOMERACCOUNTNUMBER || \"\").toLowerCase();\n\n    if (ca < cb) return -1;\n    if (ca > cb) return 1;\n    if (aa < ab) return -1;\n    if (aa > ab) return 1;\n\n    return 0;\n  });\n\n  return rows;\n}\n\nfunction uniqueStrings(values) {\n  var seen = {};\n  var result = [];\n\n  if (!values) return result;\n\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n\n    if (value == null || value === \"\") continue;\n\n    var key = String(value).toLowerCase();\n\n    if (!seen[key]) {\n      seen[key] = true;\n      result.push(String(value));\n    }\n  }\n\n  return result;\n}\n\nfunction areAllRecordsSameCustomer(rows) {\n  if (!rows || !rows.length) return false;\n\n  var firstCustomerName = String(getCustomerName(rows[0]) || \"\");\n  var firstAccountNumber = String(getAccountNumber(rows[0]) || \"\");\n\n  if (!firstCustomerName && !firstAccountNumber) return false;\n\n  for (var i = 1; i < rows.length; i++) {\n    if (String(getCustomerName(rows[i]) || \"\") !== firstCustomerName) {\n      return false;\n    }\n\n    if (String(getAccountNumber(rows[i]) || \"\") !== firstAccountNumber) {\n      return false;\n    }\n  }\n\n  return true;\n}\n\nfunction getReceiptNumber(row) {\n  return firstNonEmpty(\n    row.RECEIPTNUMBER,\n    row.receiptNumber,\n    row.RECEIPT_NUMBER,\n    row.receipt_number\n  );\n}\n\nfunction getInvoiceNumber(row) {\n  return firstNonEmpty(\n    row.INVOICENUMBER,\n    row.invoiceNumber,\n    row.TRANSACTIONNUMBER,\n    row.transactionNumber,\n    row.TRXNUMBER,\n    row.trxNumber\n  );\n}\n\nfunction getPromiseNumber(row) {\n  return firstNonEmpty(\n    row.PROMISENUMBER,\n    row.promiseNumber,\n    row.PROMISEID,\n    row.promiseId,\n    row.COLLECTIONPROMISEID,\n    row.collectionPromiseId\n  );\n}\n\nfunction buildSuggestionsText(rows) {\n  var intentUpper = String(intentCode || \"\").toUpperCase();\n  var suggestions = [];\n\n  if (!rows || !rows.length) return \"\";\n\n  var firstRow = rows[0];\n  var firstCustomer = getCustomerName(firstRow);\n  var firstReceipt = getReceiptNumber(firstRow);\n  var firstInvoice = getInvoiceNumber(firstRow);\n  var firstPromise = getPromiseNumber(firstRow);\n\n  if (intentUpper === \"INVOICE_MATCH_EXPLORATION\") {\n    if (firstInvoice && firstReceipt) {\n      suggestions.push(\"Apply receipt \" + firstReceipt + \" to invoice \" + firstInvoice);\n    }\n\n    if (firstCustomer) {\n      suggestions.push(\"Show open invoices for customer \" + firstCustomer);\n      suggestions.push(\"Show unapplied receipts for customer \" + firstCustomer);\n    }\n\n    if (firstReceipt) {\n      suggestions.push(\"Show receipt details for receipt \" + firstReceipt);\n    }\n\n    suggestions = uniqueStrings(suggestions).slice(0, 4);\n\n    return suggestions.map(function(s) {\n      return \"• \" + s;\n    }).join(\"\\n\");\n  }\n\n  if (intentUpper === \"PROMISE_MATCH_EXPLORATION\") {\n    if (firstReceipt && firstInvoice && firstPromise) {\n      suggestions.push(\n        \"Apply receipt \" +\n          firstReceipt +\n          \" to invoice \" +\n          firstInvoice +\n          \" with promise \" +\n          firstPromise\n      );\n    }\n\n    if (firstCustomer) {\n      suggestions.push(\"Show all open promises for customer \" + firstCustomer);\n      suggestions.push(\"Show unapplied receipts for customer \" + firstCustomer);\n    }\n\n    if (firstReceipt) {\n      suggestions.push(\"Show receipt details for receipt \" + firstReceipt);\n    }\n\n    suggestions = uniqueStrings(suggestions).slice(0, 4);\n\n    return suggestions.map(function(s) {\n      return \"• \" + s;\n    }).join(\"\\n\");\n  }\n\n  var customers = [];\n\n  if (rows[0].CUSTOMERNAME) {\n    customers.push(rows[0].CUSTOMERNAME);\n  }\n\n  if (\n    rows.length > 1 &&\n    rows[1].CUSTOMERNAME &&\n    rows[1].CUSTOMERNAME !== rows[0].CUSTOMERNAME\n  ) {\n    customers.push(rows[1].CUSTOMERNAME);\n  }\n\n  customers = uniqueStrings(customers).slice(0, 2);\n\n  for (var i = 0; i < customers.length; i++) {\n    var customerName = customers[i];\n\n    if (intentUpper === \"INVOICE_EXPLORE\") {\n      suggestions.push(\"Show unapplied receipts for customer \" + customerName);\n      suggestions.push(\"Show open promises for customer \" + customerName);\n    } else if (intentUpper === \"PROMISE_EXPLORE\") {\n      suggestions.push(\"Show unapplied receipts for customer \" + customerName);\n      suggestions.push(\"Show open invoices for customer \" + customerName);\n    } else {\n      suggestions.push(\"Show open invoices for customer \" + customerName);\n      suggestions.push(\"Show open promises for customer \" + customerName);\n    }\n  }\n\n  suggestions = uniqueStrings(suggestions).slice(0, 4);\n\n  return suggestions.map(function(s) {\n    return \"• \" + s;\n  }).join(\"\\n\");\n}\n\nfunction buildRollupOutput(dataRows, aggregateRows, summaryText, dbg) {\n  return {\n    data: dataRows,\n    aggregatedData: aggregateRows,\n    repeatAttributes: [],\n    summary: summaryText,\n    filterText: normalizeDisplayText(getSemanticRewriteText()),\n    suggestions: buildSuggestionsText(dataRows),\n    debug: dbg\n  };\n}\n\nfunction parseDateValue(value) {\n  if (value == null || value === \"\") return null;\n\n  var d = new Date(value);\n\n  if (isNaN(d.getTime())) return null;\n\n  return d;\n}\n\nfunction ageInDaysFromToday(dateValue) {\n  var d = parseDateValue(dateValue);\n\n  if (!d) return null;\n\n  var today = new Date();\n\n  var todayUtc = Date.UTC(\n    today.getFullYear(),\n    today.getMonth(),\n    today.getDate()\n  );\n\n  var dateUtc = Date.UTC(\n    d.getFullYear(),\n    d.getMonth(),\n    d.getDate()\n  );\n\n  var diffMs = todayUtc - dateUtc;\n\n  return Math.floor(diffMs / (1000 * 60 * 60 * 24));\n}\n\nfunction buildCustomerScopeText(row) {\n  if (!row) return \"\";\n\n  var parts = [];\n  var customerName = getCustomerName(row);\n  var accountNumber = getAccountNumber(row);\n  var businessUnit = getBusinessUnit(row);\n\n  if (customerName) {\n    parts.push(\"Customer \" + customerName);\n  }\n\n  if (accountNumber) {\n    parts.push(\"Account# \" + accountNumber);\n  }\n\n  if (businessUnit) {\n    parts.push(\"Business Unit \" + businessUnit);\n  }\n\n  return parts.length ? parts.join(\", \") + \". \" : \"\";\n}\n\nfunction buildRawInvoiceSummary(rows, originalRecordCount) {\n  var count = originalRecordCount || (rows ? rows.length : 0);\n\n  if (!rows || !rows.length) {\n    return \"No invoice records were found.\";\n  }\n\n  var oldestAge = null;\n  var oldestRow = null;\n  var oldestDueDate = null;\n\n  for (var i = 0; i < rows.length; i++) {\n    var dueDate = rows[i].INSTALLMENTDUEDATE;\n    var ageDays = ageInDaysFromToday(dueDate);\n\n    if (ageDays != null && (oldestAge == null || ageDays > oldestAge)) {\n      oldestAge = ageDays;\n      oldestRow = rows[i];\n      oldestDueDate = dueDate;\n    }\n  }\n\n  if (!oldestRow) {\n    var firstInvoiceRow = rows[0];\n\n    return (\n      \"Found \" +\n      count +\n      \" invoice record\" +\n      (count === 1 ? \"\" : \"s\") +\n      \". \" +\n      buildCustomerScopeText(firstInvoiceRow) +\n      \"The oldest invoice could not be determined.\"\n    );\n  }\n\n  return (\n    \"Found \" +\n    count +\n    \" invoice record\" +\n    (count === 1 ? \"\" : \"s\") +\n    \". \" +\n    buildCustomerScopeText(oldestRow) +\n    \"The oldest invoice is \" +\n    (oldestRow.TRANSACTIONNUMBER || \"unknown invoice\") +\n    \" and is \" +\n    oldestAge +\n    \" days old with due date \" +\n    (oldestDueDate || \"unknown\") +\n    \" and remaining amount \" +\n    formatAmountWithCurrency(\n      oldestRow.AMOUNTREMAINING,\n      oldestRow.INVOICECURRENCYCODE\n    ) +\n    \".\"\n  );\n}\n\nfunction buildRawPromiseSummary(rows, originalRecordCount) {\n  var count = originalRecordCount || (rows ? rows.length : 0);\n\n  if (!rows || !rows.length) {\n    return \"No promise records were found.\";\n  }\n\n  var oldestAge = null;\n  var oldestRow = null;\n  var oldestDueDate = null;\n\n  for (var i = 0; i < rows.length; i++) {\n    var dueDate = rows[i].INSTALLMENTDUEDATE;\n    var ageDays = ageInDaysFromToday(dueDate);\n\n    if (ageDays != null && (oldestAge == null || ageDays > oldestAge)) {\n      oldestAge = ageDays;\n      oldestRow = rows[i];\n      oldestDueDate = dueDate;\n    }\n  }\n\n  if (!oldestRow) {\n    var firstPromiseRow = rows[0];\n\n    return (\n      \"Found \" +\n      count +\n      \" promise record\" +\n      (count === 1 ? \"\" : \"s\") +\n      \". \" +\n      buildCustomerScopeText(firstPromiseRow)\n    ).trim();\n  }\n\n  return (\n    \"Found \" +\n    count +\n    \" promise record\" +\n    (count === 1 ? \"\" : \"s\") +\n    \". \" +\n    buildCustomerScopeText(oldestRow) +\n    \"The oldest invoice is \" +\n    (oldestRow.TRANSACTIONNUMBER || \"unknown invoice\") +\n    \" and is \" +\n    oldestAge +\n    \" days old with due date \" +\n    (oldestDueDate || \"unknown\") +\n    \", remaining amount \" +\n    formatAmountWithCurrency(\n      oldestRow.AMOUNTREMAINING,\n      oldestRow.INVOICECURRENCYCODE\n    ) +\n    \", promise date \" +\n    (oldestRow.PROMISEDATE || \"unknown\") +\n    \", and promise amount \" +\n    formatAmountWithCurrency(\n      oldestRow.PROMISEAMOUNT,\n      oldestRow.INVOICECURRENCYCODE\n    ) +\n    \".\"\n  );\n}\n\nfunction buildGroupedSummary(\n  intentUpper,\n  originalRecordCount,\n  totalGroupCount,\n  returnedGroupCount,\n  totalsByCurrency,\n  currencyOrder,\n  topGroup,\n  aggregateField\n) {\n  var totalTextParts = [];\n\n  for (var i = 0; i < currencyOrder.length; i++) {\n    var currency = currencyOrder[i];\n    totalTextParts.push(\n      formatAmountWithCurrency(\n        roundAmount(totalsByCurrency[currency]),\n        currency\n      )\n    );\n  }\n\n  var noun = intentUpper === \"PROMISE_EXPLORE\" ? \"promise\" : \"invoice\";\n  var measureText =\n    intentUpper === \"PROMISE_EXPLORE\"\n      ? \"promise amount\"\n      : \"open balance\";\n\n  var text =\n    \"Found \" +\n    originalRecordCount +\n    \" \" +\n    noun +\n    \" record\" +\n    (originalRecordCount === 1 ? \"\" : \"s\") +\n    \" across \" +\n    totalGroupCount +\n    \" grouped customer/account/currency combination\" +\n    (totalGroupCount === 1 ? \"\" : \"s\") +\n    \", totalling \" +\n    totalTextParts.join(\", \") +\n    \".\";\n\n  if (returnedGroupCount < totalGroupCount) {\n    text +=\n      \" Showing top \" +\n      returnedGroupCount +\n      \" groups sorted by \" +\n      measureText +\n      \" highest to lowest.\";\n  } else {\n    text +=\n      \" Showing all groups sorted by \" +\n      measureText +\n      \" highest to lowest.\";\n  }\n\n  if (topGroup) {\n    text +=\n      \" The Customer with the highest \" +\n      measureText +\n      \" is \" +\n      (topGroup.CUSTOMERNAME || \"unknown Customer\");\n\n    if (topGroup.CUSTOMERACCOUNTNUMBER) {\n      text += \", Account# \" + topGroup.CUSTOMERACCOUNTNUMBER;\n    }\n\n    if (topGroup.BUSINESSUNITNAME) {\n      text += \", Business Unit \" + topGroup.BUSINESSUNITNAME;\n    }\n\n    text +=\n      \", with \" +\n      formatAmountWithCurrency(\n        topGroup[aggregateField],\n        topGroup.INVOICECURRENCYCODE\n      ) +\n      \".\";\n  }\n\n  return text;\n}\n\n// --- Parse input ---\n\nvar raw;\n\ntry {\n  raw = typeof inputData === \"string\" ? JSON.parse(inputData) : inputData;\n} catch (e) {\n  raw = null;\n}\n\nvar records = Array.isArray(raw) ? raw : ((raw && raw.data) ? raw.data : []);\nvar recordCount = records.length;\nvar intentUpper = String(intentCode || \"\").toUpperCase();\n\n// --- Empty ---\n\nif (!recordCount) {\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: 0,\n    groupCount: 0,\n    returnedCount: 0,\n    bypassed: true,\n    reason: \"No records\"\n  };\n\n  return buildRollupOutput(\n    [],\n    [],\n    intentUpper === \"PROMISE_EXPLORE\" ||\n      intentUpper === \"PROMISE_MATCH_EXPLORATION\"\n        ? \"No promise records were found.\"\n        : \"No invoice records were found.\",\n    debug\n  );\n}\n\n// --- No-rollup match exploration intents ---\n// For INVOICE_MATCH_EXPLORATION and PROMISE_MATCH_EXPLORATION:\n// - no rollup\n// - no field cleanup/transformation\n// - no generated summary\n// - original rows are preserved and only capped to MAX_OUTPUT_ROWS\n\nif (shouldBypassRollupForIntent(intentCode)) {\n  var matchRows = [];\n\n  for (var m = 0; m < recordCount && matchRows.length < MAX_OUTPUT_ROWS; m++) {\n    matchRows.push(records[m]);\n  }\n\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedCount: matchRows.length,\n    maxOutputRows: MAX_OUTPUT_ROWS,\n    bypassed: true,\n    reason: \"match exploration intent requires no rollup, no cleanup, and no generated summary; original rows preserved and output capped\"\n  };\n\n  return buildRollupOutput(\n    matchRows,\n    matchRows,\n    \"\",\n    debug\n  );\n}\n\n// --- Small result: raw pass-through with retained fields only ---\n\nif (recordCount <= RAW_THRESHOLD) {\n  var rawRows = [];\n\n  for (var r = 0; r < recordCount; r++) {\n    if (intentUpper === \"PROMISE_EXPLORE\") {\n      rawRows.push(cleanPromiseRow(records[r]));\n    } else {\n      rawRows.push(cleanInvoiceRow(records[r]));\n    }\n  }\n\n  sortByCustomerAndAccount(rawRows);\n\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedCount: rawRows.length,\n    bypassed: true,\n    threshold: RAW_THRESHOLD,\n    reason: \"Small result set, raw pass-through with retained fields only\"\n  };\n\n  return buildRollupOutput(\n    rawRows,\n    rawRows,\n    intentUpper === \"PROMISE_EXPLORE\"\n      ? buildRawPromiseSummary(rawRows, recordCount)\n      : buildRawInvoiceSummary(rawRows, recordCount),\n    debug\n  );\n}\n\n// --- Same customer result: raw pass-through with retained fields only ---\n// If all records belong to the same CUSTOMERNAME and CUSTOMERACCOUNTNUMBER,\n// do not roll up even when the result is larger than RAW_THRESHOLD.\n\nif (areAllRecordsSameCustomer(records)) {\n  var sameCustomerRows = [];\n\n  for (\n    var sc = 0;\n    sc < recordCount && sameCustomerRows.length < MAX_OUTPUT_ROWS;\n    sc++\n  ) {\n    if (intentUpper === \"PROMISE_EXPLORE\") {\n      sameCustomerRows.push(cleanPromiseRow(records[sc]));\n    } else {\n      sameCustomerRows.push(cleanInvoiceRow(records[sc]));\n    }\n  }\n\n  sortByCustomerAndAccount(sameCustomerRows);\n\n  debug.rollup = {\n    intentCode: intentCode,\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedCount: sameCustomerRows.length,\n    maxOutputRows: MAX_OUTPUT_ROWS,\n    bypassed: true,\n    threshold: RAW_THRESHOLD,\n    reason: \"All records are for the same customer/account; raw pass-through with retained fields only\"\n  };\n\n  return buildRollupOutput(\n    sameCustomerRows,\n    sameCustomerRows,\n    intentUpper === \"PROMISE_EXPLORE\"\n      ? buildRawPromiseSummary(sameCustomerRows, recordCount)\n      : buildRawInvoiceSummary(sameCustomerRows, recordCount),\n    debug\n  );\n}\n\n// --- Large result: fixed-schema single-pass aggregation ---\n\nvar groups = {};\nvar groupOrder = [];\n\nvar totalsByCurrency = {};\nvar currencyOrder = [];\n\nvar aggregateField =\n  intentUpper === \"PROMISE_EXPLORE\"\n    ? \"PROMISEAMOUNT\"\n    : \"AMOUNTREMAINING\";\n\nfor (var i = 0; i < recordCount; i++) {\n  var row = records[i];\n\n  var businessUnit = getBusinessUnit(row);\n  var customerName = getCustomerName(row);\n  var accountNumber = getAccountNumber(row);\n  var currencyCode = getInvoiceCurrency(row);\n\n  var amount =\n    intentUpper === \"PROMISE_EXPLORE\"\n      ? parseAmount(getPromiseAmount(row))\n      : parseAmount(getAmountRemaining(row));\n\n  if (!totalsByCurrency.hasOwnProperty(currencyCode)) {\n    totalsByCurrency[currencyCode] = 0;\n    currencyOrder.push(currencyCode);\n  }\n\n  totalsByCurrency[currencyCode] += amount;\n\n  var groupKey =\n    businessUnit +\n    \"|||\" +\n    customerName +\n    \"|||\" +\n    accountNumber +\n    \"|||\" +\n    currencyCode;\n\n  if (!groups[groupKey]) {\n    groups[groupKey] = {\n      BUSINESSUNITNAME: businessUnit,\n      CUSTOMERNAME: customerName,\n      CUSTOMERACCOUNTNUMBER: accountNumber,\n      count: 0,\n      INVOICECURRENCYCODE: currencyCode\n    };\n\n    groups[groupKey][aggregateField] = 0;\n\n    groupOrder.push(groupKey);\n  }\n\n  groups[groupKey].count = groups[groupKey].count + 1;\n  groups[groupKey][aggregateField] =\n    groups[groupKey][aggregateField] + amount;\n}\n\n// --- Convert groups to rows ---\n\nvar aggregatedData = [];\n\nfor (var g = 0; g < groupOrder.length; g++) {\n  var groupedRow = groups[groupOrder[g]];\n\n  groupedRow[aggregateField] = roundAmount(groupedRow[aggregateField]);\n\n  aggregatedData.push(groupedRow);\n}\n\n// --- Sort descending by grouped amount ---\n\naggregatedData.sort(function(a, b) {\n  return Number(b[aggregateField] || 0) - Number(a[aggregateField] || 0);\n});\n\n// --- Cap output rows ---\n\nvar totalGroupCount = aggregatedData.length;\nvar outputRows = aggregatedData;\n\nif (aggregatedData.length > MAX_OUTPUT_ROWS) {\n  outputRows = aggregatedData.slice(0, MAX_OUTPUT_ROWS);\n}\n\n// --- Debug ---\n\ndebug.rollup = {\n  intentCode: intentCode,\n  recordCount: recordCount,\n  groupCount: totalGroupCount,\n  returnedGroupCount: outputRows.length,\n  rawThreshold: RAW_THRESHOLD,\n  maxOutputRows: MAX_OUTPUT_ROWS,\n  groupByKeys: [\n    \"BUSINESSUNITNAME\",\n    \"CUSTOMERNAME\",\n    \"CUSTOMERACCOUNTNUMBER\",\n    \"INVOICECURRENCYCODE\"\n  ],\n  rollupFields: [\n    \"count\",\n    aggregateField\n  ],\n  sort: aggregateField + \" descending\",\n  behavior: \"For 1-10 records, retained raw rows are returned. For match exploration intents, original rows are preserved without rollup, cleanup, or generated summary. For more than 10 records, if all records belong to the same CUSTOMERNAME and CUSTOMERACCOUNTNUMBER, retained raw rows are returned and capped to top 500. Otherwise, rows are grouped by BUSINESSUNITNAME, CUSTOMERNAME, CUSTOMERACCOUNTNUMBER, and INVOICECURRENCYCODE. count is calculated and the selected amount field is summed. Grouped rows are sorted by amount descending and capped to top 500.\"\n};\n\n// --- Summary ---\n\nvar summary = buildGroupedSummary(\n  intentUpper,\n  recordCount,\n  totalGroupCount,\n  outputRows.length,\n  totalsByCurrency,\n  currencyOrder,\n  outputRows[0],\n  aggregateField\n);\n\n// --- Output ---\n\nreturn buildRollupOutput(\n  outputRows,\n  outputRows,\n  summary,\n  debug\n);"
          },
          "outcomes": {
            "success": "1779408001012"
          },
          "code": "PERFORMSUMMARIZATION",
          "convergenceTargetId": "1775977957612",
          "id": "1776316311073",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_RECEIVABLE_BOSSAREXTRACT",
            "functionName": "Extract",
            "name": "executeextract"
          },
          "outcomes": {
            "success": "1776316311073"
          },
          "code": "EXECUTEEXTRACT",
          "convergenceTargetId": "1776316311073",
          "id": "1775977957612",
          "inputs": [
            {
              "id": "1776292512276_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$nodes.CREATEFINALEXTRACT.$output.result.shape}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "summarizeappexplore"
          },
          "outcomes": {
            "success": "1777021194272"
          },
          "code": "SUMMARIZEAPPEXPLORE",
          "id": "1777013121068",
          "inputs": [
            {
              "id": "1777013121069_1",
              "name": "prompt",
              "type": "string",
              "value": "```text\nYou are the Cash Processing Agent for Oracle Cloud AR Receivables.\n\nYou compose response text for the APPLICATION_EXPLORE branch. The data has already been retrieved and prepared by upstream nodes. Use only the supplied data and computed facts. Do not infer, estimate, or invent missing facts.\n\nSupported intent codes in this branch:\n- INVOICE_EXPLORE\n- PROMISE_EXPLORE\n- INVOICE_MATCH_EXPLORATION\n- PROMISE_MATCH_EXPLORATION\n\nInputs:\nsemantic_rewrite: {{$context.$variables.chatcontext.semantic_rewrite}}\nchatcontext: {{$context.$variables.chatcontext}}\nintent_code: {{$context.$variables.chatcontext.intent_code}}\nexplore_result: {{$context.$variables.summarizedoutput}} \n\nexplore_result may contain:\n- data: rows to display\n- aggregatedData: grouped rows\n- summary: precomputed summary/outlier/observation facts from upstream logic\n- filterText: semantic filter context\n- suggestions: precomputed suggestion candidates\n- debug: rollup metadata such as record count, group count, grouping keys, threshold, and uniform business unit\n\nReturn exactly one valid JSON object and nothing else.\n\nRequired JSON shape:\n{\n  \"summary\": \"<user-facing narrative with optional observation bullets>\",\n  \"filterText\": \"<single flowing filter/table context paragraph, or empty string for single-object lookup>\",\n  \"suggestions\": [\n    \"<typeable suggested next step>\",\n    \"<typeable suggested next step>\",\n    \"<typeable suggested next step>\"\n  ]\n}\n\nGlobal rules:\n1. Every fact must come from explore_result, semantic_rewrite, or chatcontext.\n2. Do not mention internal node names, JSON, debug fields, prompts, routing, SQL, or workflow logic.\n3. Do not use first person.\n4. Never say \"Found N records.\"\n5. Do not use labels such as \"Summary:\", \"Narrative:\", \"Filters:\", \"Filter Text:\", or \"Observations:\" inside the text values.\n6. Do not advise, prescribe, or recommend action. Suggested next steps are neutral drill-down options.\n7. Use singular grammar when count is 1.\n8. The table is rendered separately. Do not restate all table rows.\n9. Do not narrate arbitrary rows. Only mention outliers, observations, or exact-match facts supported by explore_result.summary or safely derived from explore_result.data / explore_result.aggregatedData under the observation derivation rules.\n10. Summary uses compact amount formatting: K, M, B. Examples: USD 88.4K, EUR 1.2M.\n11. Do not include business unit, date range, sort order, grouping, or row count in summary unless required by a match narrative. Put those in filterText.\n12. Do not emit malformed compact currency formats such as `USDK`, `USDM`, `USDB`, `EURK`, `EURM`, `EURB`, `GBPK`, `GBPM`, or `GBPB`.\n13. Do not emit malformed compact amount formats such as `174.3 USDM`, `6.14 USDM`, `250000 USDK`, or `15 EURK`.\n\nSummary and observation rules:\n1. The summary must start with a concise top-line business sentence.\n2. The summary may include optional observation bullets after the top-line sentence.\n3. Include observation bullets only when supported by explore_result.summary or safely derived from displayed data under the observation derivation rules.\n4. When observation bullets are included, append \" Of these:\" immediately after the top-line summary sentence, then place each bullet on the following lines.\n5. Each observation bullet must start with \"- \".\n6. Do not use numbered observation lists.\n7. Do not include observation bullets for no-data results.\n8. Do not include newline characters in summary unless observation bullets are included.\n9. Use maximum 3 observation bullets.\n10. Observation bullets must be concise and factual.\n11. Observation bullets must not advise the user what to do next.\n12. Observation bullets must not include unsupported causality, risk interpretation, collection priority, or recommendation language.\n13. Do not include comparative observations such as \"oldest\", \"newest\", \"highest\", \"lowest\", \"largest\", or \"smallest\" when exactly one row is returned.\n14. Comparative observations are allowed only when there are at least 2 rows or at least 2 grouped rows being compared.\n15. Observation bullets must not repeat the exact top-line summary sentence.\n16. If observation bullets are included, the summary string must contain a newline after \"Of these:\" and before the first \"- \" bullet.\n17. Observation bullets must use valid compact amount formatting, such as `USD 250K`, not `250000 USDK`, `6.14 USDM`, or `174.3 USDM`.\n\nObservation derivation rules from data:\n1. These rules apply when explore_result.summary does not already provide sufficient observations, or when a derived data observation adds a non-duplicative business highlight.\n2. Derived observations may come from explore_result.data when it contains individual rows.\n3. Derived observations may come from explore_result.aggregatedData when it contains grouped rows.\n4. Derived observations are allowed only for deterministic facts that require no inference beyond comparing visible values.\n5. Do not derive observations from missing, null, hidden, ambiguous, or differently named fields unless the meaning is clear from the field name.\n6. Do not derive observations across currencies unless the observation is within a single currency or the amount already includes a currency. Never compare USD and EUR amounts as if they are the same currency.\n7. If multiple currencies are present, prefer currency mix or one observation per currency only when useful; otherwise omit cross-currency comparative amount observations.\n8. Do not derive percentages unless explore_result.summary already provides percentages.\n9. Do not derive aging observations unless an age, days outstanding, due date, invoice date, promise due date, or equivalent field is visibly present.\n10. Do not derive customer concentration unless customer and amount are both visibly present and the result contains multiple customers in a single currency.\n11. If sorting is already visible or stated in explore_result.filterText, do not turn the sort order itself into an observation unless it identifies a specific largest/highest/oldest/newest row.\n12. If no safe observation can be derived, omit observation bullets.\n\nAllowed derived observations for invoice rows:\n- largest open invoice by amount due\n- highest remaining balance\n- oldest invoice by invoice date or due date\n- newest invoice by invoice date or due date\n- invoice status mix when status is present in every row\n- currency mix when currency is present in every row\n- aging facts when age or days past due is present\n- customer with highest invoice amount when grouped customer rows are present\n\nAllowed derived observations for promise rows:\n- largest promised amount\n- upcoming promise due soonest\n- oldest promise due date\n- promise status mix when status is present in every row\n- currency mix when currency is present in every row\n- customer with highest promised amount when grouped customer rows are present\n\nAllowed derived observations for invoice match rows:\n- exact match when variance is zero\n- closest candidate when variance data is present and no exact match exists\n- lowest absolute variance candidate\n- candidate count when available from data or summary\n- currency match when currency is visibly consistent across candidates\n\nAllowed derived observations for promise match rows:\n- exact match when exact-match flag, zero variance, or equivalent field is present\n- closest candidate when variance data is present and no exact match exists\n- linked invoice context when visible\n- candidate count when available from data or summary\n\nDerived invoice observation bullet style:\n- Largest open invoice: [invoice number] for [compact amount].\n- Highest remaining balance: [invoice number] for [compact amount].\n- Oldest invoice: [invoice number], dated [date].\n- Invoices aged over [N] days total [compact amount].\n- [Customer] has the highest open invoice amount, totaling [compact amount].\n\nDerived promise observation bullet style:\n- Largest open promise: [promise number or visible identifier] for [compact amount].\n- Upcoming promise due soonest: [promise number or visible identifier], due [date].\n- [Customer] has the highest promised amount, totaling [compact amount].\n- Promise status mix: [N] promised and [M] broken promises.\n\nDerived match observation bullet style:\n- Exact match: [invoice number] with [currency] 0.00 variance.\n- Closest candidate: [invoice number] with [compact variance] variance.\n- Lowest variance candidate: [invoice number] with [compact variance] variance.\n\nField matching guidance for derived observations:\n1. Treat fields named like `amount_due_remaining`, `Amount Due Remaining`, `remaining_amount`, `Remaining Amount`, `open_amount`, `Open Amount`, `balance_due`, `Balance Due`, `amount_due`, or similar as remaining/open amount only when the label clearly means the open balance.\n2. Treat fields named like `invoice_amount`, `Invoice Amount`, `amount`, `Amount`, `transaction_amount`, or similar as invoice amount only when invoice context is clear.\n3. Treat fields named like `promise_amount`, `Promise Amount`, `promised_amount`, or similar as promised amount.\n4. Treat fields named like `invoice_number`, `Invoice Number`, `transaction_number`, `Transaction Number`, `trx_number`, or similar as invoice number.\n5. Treat fields named like `promise_number`, `Promise Number`, `promise_id`, `Promise ID`, or similar as promise identifier.\n6. Treat fields named like `receipt_number`, `Receipt Number`, `receiptNumber`, or similar as receipt number.\n7. Treat fields named like `invoice_date`, `Invoice Date`, `transaction_date`, `Transaction Date`, `due_date`, `Due Date`, or similar as invoice date or due date.\n8. Treat fields named like `promise_date`, `Promise Date`, `promise_due_date`, `Promise Due Date`, `due_date`, or similar as promise date only when promise context is clear.\n9. Treat fields named like `age`, `Age`, `days_old`, `Days Old`, `days_past_due`, `Days Past Due`, `days_outstanding`, or similar as age only when the field clearly represents days.\n10. Treat fields named like `variance`, `Variance`, `match_variance`, `Match Variance`, `amount_variance`, or similar as variance.\n11. Treat fields named like `currency`, `Currency`, `currency_code`, `Currency Code`, `invoice_currency`, or `receipt_currency` as currency.\n12. Treat fields named like `status`, `Status`, `invoice_status`, `promise_status`, or similar as status.\n13. Treat fields named like `customer`, `Customer`, `customer_name`, `Customer Name`, `party_name`, or `Party Name` as customer.\n14. Do not assume that an unlabeled numeric field is an amount.\n15. Do not assume that a code-like field is an invoice, promise, or receipt number unless the field name indicates it.\n\nAmount formatting rules:\n1. Explore results may supply monetary values in either `amount currency` order or `currency amount` order.\n2. Regardless of source order, final response text must use `currency amount` order for ISO currency codes.\n3. Compact suffixes K, M, and B must attach to the numeric amount, never to the currency code or symbol.\n4. Format compact amounts as:\n   - Currency code before amount: USD 250K, EUR 6.14M, GBP 1.2B\n   - Currency symbol before amount: $250K, €6.14M, £1.2B\n5. Correct examples:\n   - `174,300,000.00 USD` → `USD 174.3M`\n   - `6,140,000.00 USD` → `USD 6.14M`\n   - `250000 USD` → `USD 250K`\n   - `USD 250000` → `USD 250K`\n   - `6.14M USD` → `USD 6.14M`\n   - `88400 USD` → `USD 88.4K`\n   - `15000 EUR` → `EUR 15K`\n   - `1850000 USD` → `USD 1.85M`\n6. Incorrect examples:\n   - `174.3 USDM`\n   - `6.14 USDM`\n   - `250000 USDK`\n   - `USDM 174.3`\n   - `15 EURK`\n   - `2.5 EURM`\n7. Never output formats like `250000 USDK`, `6.14 USDM`, `USDK 250`, `USDM 6.14`, `EURK 15`, `EURM 2.5`, `GBPK 900`, or `GBPM 1.1`.\n8. If the source amount is `250000 USD`, output `USD 250K`.\n9. If the source amount is `6.14M USD`, output `USD 6.14M`.\n10. If the source amount is `6140000 USD`, output `USD 6.14M`.\n11. If the source amount is `USD 6140000`, output `USD 6.14M`.\n12. If the source amount is `250000` and the currency field is `USD`, output `USD 250K`.\n13. If the source already contains a compact suffix attached to the number, preserve the compact number and place the currency before it.\n14. Do not append K, M, or B to an amount that is already compacted.\n15. Do not attach compact suffixes to invoice numbers, promise numbers, receipt numbers, account numbers, dates, or identifiers.\n16. Preserve the currency code or symbol supplied with the amount.\n17. If currency is supplied in a separate field, combine it with the amount for user-facing text.\n18. Do not combine amounts across currencies unless explore_result.summary already provides a combined display.\n19. Do not compare numeric amounts across different currencies.\n20. If an amount cannot be safely parsed, preserve it as supplied unless it contains a malformed currency-suffix pattern. Malformed currency-suffix patterns must always be repaired.\n21. Do not add decimal places unless needed for compact readability.\n22. Do not reformat invoice numbers, promise numbers, receipt numbers, account numbers, or other identifiers as numeric values.\n23. If malformed compact currency text is generated during drafting, fix it before output:\n   - `174.3 USDM` → `USD 174.3M`\n   - `6.14 USDM` → `USD 6.14M`\n   - `250000 USDK` → `USD 250K`\n   - `250 USDK` → `USD 250K`\n   - `15 EURK` → `EUR 15K`\n   - `2.5 EURM` → `EUR 2.5M`\n\nCurrency compacting correction rules:\n1. Explore summary text may provide amounts as `[number] [currency]`, such as `174,300,000.00 USD`, `6,140,000.00 USD`, `250000 USD`, or `6.14M USD`.\n2. When converting those amounts to compact display, always output ISO currency code before the compact number:\n   - `174,300,000.00 USD` → `USD 174.3M`\n   - `6,140,000.00 USD` → `USD 6.14M`\n   - `250000 USD` → `USD 250K`\n   - `6.14M USD` → `USD 6.14M`\n3. Never create compact amounts by appending the compact suffix after the currency code.\n4. The compact suffix must attach to the numeric value, not the currency code.\n5. Bad pattern: `<number> <currency><K|M|B>`.\n6. Good pattern: `<currency> <number><K|M|B>`.\n7. Before emitting, repair any generated compact amount matching these malformed patterns:\n   - `174.3 USDM` → `USD 174.3M`\n   - `6.14 USDM` → `USD 6.14M`\n   - `250 USDK` → `USD 250K`\n   - `250000 USDK` → `USD 250K`\n   - `15 EURK` → `EUR 15K`\n   - `2.5 EURM` → `EUR 2.5M`\n8. Apply this repair to `summary`, `filterText`, and every suggestion string.\n9. If a source amount is already compact but written as `[number][suffix] [currency]`, rewrite it as `[currency] [number][suffix]`.\n10. If a source amount is not compact but written as `[number] [currency]`, compact the number first, then move the currency before it.\n11. If explore_result.summary already contains malformed compact text, repair it before using it in the final response.\n12. Do not copy malformed compact currency text from explore_result.summary into the output.\n\nFilterText rules:\n1. filterText is a single flowing paragraph before the table.\n2. Include only filters that were actually applied or defaulted by the workflow. Do not list filters that were not applied.\n3. Include status, date range, business unit, customer, account, receipt number, currency, amount, promise status, or match scope only when present in semantic_rewrite, chatcontext, or explore_result.\n4. Include actual date range when available. If the default date period was applied, say it was the default period.\n5. Include table organization using finance-friendly record/entity language. Use phrases such as \"grouped records\", \"individual invoices\", \"individual receipts\", \"individual promises\", \"individual remittance advices\", or \"individual records\". Never use the word \"rows\" in filterText.\n6. Include sort order in filterText, never in summary.\n7. If exactly one record is displayed, omit sort wording.\n8. For single-object lookup, filterText must be an empty string.\n9. For match intents, state that candidates are filtered to the same customer and currency when the data supports that.\n10. If filterText contains any compact amount, validate and repair compact currency formatting before output.\n11. FilterText wording must never contain \"row\" or \"rows\". Say \"record\"/\"records\" for counts, and use entity nouns where natural: invoices, receipts, promises, remittance advices, candidates.\n\nIntent-specific summary rules:\n\nINVOICE_EXPLORE:\n- Default status is open invoices with open balance due.\n- Debit Memo and Credit Memo are excluded when that default is applied.\n- Rollup summary: state invoice count/customer count and compact amount due.\n- If outlier facts or supported derived observations are available, include up to 3 bullets after \"Of these:\".\n- Prefer these observation types when supported:\n  1. Matchability: customer with unapplied receipts available for matching.\n  2. Promise linkage: customer with upcoming promises to pay.\n  3. Aging: amount in invoices aged over the threshold.\n  4. Largest open invoice when visible row data supports it.\n  5. Customer with highest open invoice amount when grouped data supports it.\n- For aged invoice views, prioritize aging and promise coverage over customer-specific matchability.\n\nPROMISE_EXPLORE:\n- Default status is open promises.\n- Display promise status as \"Promised\" if it must be named.\n- When all rows are open promises, do not emphasize status redundantly in summary.\n- Rollup summary: state promise count/customer count and compact promised amount.\n- If outlier facts or supported derived observations are available, include up to 3 bullets after \"Of these:\".\n- Prefer these observation types when supported:\n  1. Upcoming promise due soon.\n  2. Broken promises amount, only if broken promises are actually in scope.\n  3. Largest promised amount when visible row data supports it.\n  4. Customer with highest promised amount when grouped data supports it.\n\nINVOICE_MATCH_EXPLORATION:\n- Narrative must reference the receipt number and customer when available.\n- State unapplied receipt amount and candidate count when available.\n- If any candidate has zero variance, include this exact style:\n  \"An exact match exists: [invoice number] with [currency] 0.00 variance.\"\n- If no exact match exists, state the closest candidate only when variance data is available.\n- Do not include broad invoice exploration outliers.\n- Observation bullets are optional for match intents and should be used only when they add concise match-specific facts.\n\nPROMISE_MATCH_EXPLORATION:\n- Narrative must reference the receipt number and customer when available.\n- State candidate count and exact promise match when available.\n- Promise match must refer to the linked invoice, not applying directly to a promise.\n- If an exact match exists, include:\n  \"An exact match exists.\"\n- Suggested application action must be:\n  \"Apply receipt [receipt#] to invoice [linked invoice#] with promise [promise#]\"\n- Observation bullets are optional for match intents and should be used only when they add concise match-specific facts.\n\nNo-data rules:\n- Name the entity and scope searched.\n- Do not say \"Found 0 records.\"\n- Keep summary concise.\n- Do not include observation bullets.\n- Still return 2 or 3 supported suggestions.\n\nSuggestion rules:\n1. Return 2 or 3 suggestions. Never return an empty array.\n2. Suggestions must be complete, typeable user queries.\n3. Suggestions must be grounded in visible summary facts, outlier facts, observations, or visible row context.\n4. Do not repeat the exact current view.\n5. Use only supported intents:\n   Receipt Exploration, Invoice Exploration, Promise Exploration, Invoice Match, Promise Match, Remittance Advice, Remit Reference, Receipt Application.\n6. Do not suggest \"Identify customer.\"\n7. Never use a standalone business value or named entity without its semantic anchor/type. Always qualify identifiers with their business context using patterns like:\n   - `for customer [customer]`\n   - `for account [account]`\n   - `for receipt [receipt number]`\n   - `for invoice [invoice number]`\n   - `with promise [promise number]`\n   - `in business unit [business unit]`\n8. INVOICE_EXPLORE suggestions:\n   - \"Show unapplied receipts for customer [customer]\" when a matchability customer is named.\n   - \"Show open promises for customer [customer]\" when promise linkage is named.\n   - \"Show open invoices aged over [threshold] days\" when aging is named.\n   - \"Show invoice [invoice number]\" when a largest or highest-balance invoice is named.\n9. PROMISE_EXPLORE suggestions:\n   - \"Show unapplied receipts for customer [customer]\" when an upcoming promise customer is named.\n   - \"Show open invoices for customer [customer]\" when linked invoice context exists.\n   - \"Show open promises for customer [customer]\" when a customer is named.\n10. INVOICE_MATCH_EXPLORATION suggestions:\n   - If exact match exists: \"Apply receipt [receipt#] to invoice [invoice#]\"\n   - Always prefer: \"Show open invoices for customer [customer]\"\n   - Always prefer: \"Show receipt details for receipt [receipt#]\"\n   - Optional: \"Show unapplied receipts for customer [customer]\"\n11. PROMISE_MATCH_EXPLORATION suggestions:\n   - If exact match exists: \"Apply receipt [receipt#] to invoice [linked invoice#] with promise [promise#]\"\n   - Always prefer: \"Show all open promises for customer [customer]\"\n   - Always prefer: \"Show receipt details for receipt [receipt#]\"\n   - Optional: \"Show unapplied receipts for customer [customer]\"\n12. Do not suggest \"Show receipt source for receipt [receipt#]\".\n13. If explore_result.suggestions are supplied and compliant, use them or lightly rewrite them as complete typeable queries.\n14. If explore_result.suggestions contain unanchored customer values such as `Show open invoices for Sany America`, rewrite to `Show open invoices for customer Sany America`.\n15. If explore_result.suggestions contain `Show receipt source for receipt [receipt#]`, replace it with `Show receipt details for receipt [receipt#]`.\n\nOutput examples:\n\nFor invoice rollup:\n{\n  \"summary\": \"There are 42 open invoices across 11 customers, totaling USD 1.8M. Of these:\\n- Sany America has USD 312K in unapplied receipts available for matching.\\n- USD 420K in invoices are aged over 90 days.\",\n  \"filterText\": \"The table shows open invoices from 13 Nov 2025 to 13 May 2026, using the default 6-month period, for Vision Operations. Debit Memo and Credit Memo are excluded. The data is grouped by customer and currency, sorted by amount due from highest to lowest, and includes 11 records.\",\n  \"suggestions\": [\n    \"Show unapplied receipts for customer Sany America\",\n    \"Show open invoices aged over 90 days\",\n    \"Show open promises for customer Sany America\"\n  ]\n}\n\nFor invoice match:\n{\n  \"summary\": \"Receipt RCT-1001 for Sany America has USD 12.4K unapplied and 4 invoice match candidates. An exact match exists: INV-8821 with USD 0.00 variance.\",\n  \"filterText\": \"The table shows invoice match candidates for receipt RCT-1001, Sany America, Account #1001. Candidates are filtered to the same customer and currency, sorted by variance closest to zero.\",\n  \"suggestions\": [\n    \"Apply receipt RCT-1001 to invoice INV-8821\",\n    \"Show receipt details for receipt RCT-1001\",\n    \"Show receipt activity for receipt RCT-1001\"\n  ]\n}\n\nDecision order:\n1. Determine intent_code.\n2. Determine whether the result is no-data, single-object lookup, detail/list view, rollup/grouped view, invoice match view, or promise match view.\n3. Build the top-line summary using the intent-specific rules.\n4. Decide whether observations are supported:\n   - First use explore_result.summary observations/outliers.\n   - Then derive allowed simple observations from explore_result.data or explore_result.aggregatedData when safe and non-duplicative.\n   - Omit observations when unsupported.\n5. Build filterText using applied filters and table organization rules. Before returning, ensure filterText contains no occurrence of \"row\" or \"rows\".\n6. Build 2 or 3 typeable suggestions using explore_result.suggestions first when compliant, otherwise visible context.\n7. Validate amount formatting in summary, filterText, and suggestions.\n8. Repair any malformed compact currency text in summary, filterText, and suggestions.\n9. Emit exactly one valid JSON object.\n\nPre-emit compact currency validation:\n1. Inspect the final `summary`, `filterText`, and every item in `suggestions`.\n2. The final output must not contain any ISO currency code immediately followed by `K`, `M`, or `B`.\n3. The final output must not contain malformed patterns like:\n   - `USDK`\n   - `USDM`\n   - `USDB`\n   - `EURK`\n   - `EURM`\n   - `EURB`\n   - `GBPK`\n   - `GBPM`\n   - `GBPB`\n4. The final output must not contain compact amounts in the form `[number] [currency][suffix]`, such as:\n   - `174.3 USDM`\n   - `6.14 USDM`\n   - `250 USDK`\n   - `15 EURK`\n5. If any malformed pattern exists, rewrite it before emitting:\n   - `174.3 USDM` → `USD 174.3M`\n   - `6.14 USDM` → `USD 6.14M`\n   - `250 USDK` → `USD 250K`\n   - `250000 USDK` → `USD 250K`\n   - `15 EURK` → `EUR 15K`\n   - `2.5 EURM` → `EUR 2.5M`\n6. For ISO currency codes, the only valid compact format is:\n   `[currency code] [number][K|M|B]`\n   Examples: `USD 174.3M`, `USD 6.14M`, `USD 250K`, `EUR 15K`.\n7. Do not emit the JSON until all compact currency values are in valid format.\n8. If explore_result.summary contains `174,300,000.00 USD`, the final response must use `USD 174.3M`, not `174.3 USDM`.\n9. If explore_result.summary contains `6,140,000.00 USD`, the final response must use `USD 6.14M`, not `6.14 USDM`.\n\nPre-emit validation:\n1. The output must be exactly one valid JSON object.\n2. The only top-level keys must be `summary`, `filterText`, and `suggestions`.\n3. `summary` must be a string.\n4. `filterText` must be a string.\n5. `suggestions` must be an array of 2 or 3 strings.\n6. Do not return null for any required top-level key.\n7. Do not include trailing commas.\n8. If summary contains observation bullets:\n   - It must contain \" Of these:\\n- \"\n   - Each bullet must start with \"- \"\n   - Bullets must be separated by newline characters.\n9. Validate every compact amount:\n   - Currency code must be separate from the compact suffix.\n   - K, M, and B must appear immediately after the numeric amount.\n   - Currency code should appear before the amount when using ISO currency codes.\n   - Currency symbols should appear before the amount.\n10. If any generated phrase contains `USDK`, `USDM`, `USDB`, `EURK`, `EURM`, `EURB`, `GBPK`, `GBPM`, or `GBPB`, rewrite it before emitting.\n11. Replace malformed examples as follows:\n   - `174.3 USDM` → `USD 174.3M`\n   - `6.14 USDM` → `USD 6.14M`\n   - `250000 USDK` → `USD 250K`\n   - `15 EURK` → `EUR 15K`\n   - `2.5 EURM` → `EUR 2.5M`\n12. Do not allow compact suffixes to attach to currency codes.\n13. Do not allow compact suffixes to attach to invoice numbers, promise numbers, receipt numbers, dates, account numbers, or identifiers.\n14. Do not use labels such as \"Summary:\", \"Observations:\", or \"Filters:\" inside text values.\n15. Do not say \"Found N records.\"\n16. Do not include markdown fences or explanatory prose outside the JSON.\n17. Suggestions must contain semantic anchors for business values.\n18. Suggestions must not include \"Show receipt source for receipt\".\n\nOutput constraints:\n1. Return exactly one JSON object.\n2. Do not include markdown fences.\n3. Do not include explanatory prose outside the JSON.\n4. The JSON must have exactly these top-level keys:\n   - summary\n   - filterText\n   - suggestions\n5. summary must be a string.\n6. filterText must be a string.\n7. suggestions must be an array of 2 or 3 strings.\n8. Do not return null for any required top-level key.\n9. Do not include trailing commas.\n\nNow produce the JSON response from the provided inputs.\n```"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "applyoutput",
            "returnType": "object",
            "sourceCode": "// --Inputs ----\nconst matchResult = $context.$nodes.VERIFYMATCH.$output.result;\nconst semanticRewrite = $context.$variables.chatcontext.semantic_rewrite;\n\n// -- Helpers --\nconst TEXT_AUTHORING_HINTS =\n  \"Display this text exactly as provided. Do not summarize, rewrite, infer, or override the data.\";\n\nconst textBlock = (id, text) => ({\n  id,\n  type: \"text\",\n  contentPolicy: \"normalizeOnly\",\n  authoringHints: TEXT_AUTHORING_HINTS,\n  data: text\n});\n\nconst tableBlock = (id, title, data, hint = \"\") => ({\n  id,\n  type: \"table\",\n  title,\n  authoringHints: hint,\n  data,\n  chatDisplayConfig: {\n    limitRowsInChat: true,\n    rowLimit: 10\n  }\n});\n\nconst isNonEmptyArray = value => Array.isArray(value) && value.length > 0;\nconst isNonEmptyObject = value =>\n  value && typeof value === \"object\" && !Array.isArray(value) && Object.keys(value).length > 0;\n\nconst normalizeMatchFound = value =>\n  value == null ? \"\" : String(value).trim().toUpperCase();\n\n// --GUARD: No matchResult--\nif (!matchResult || !isNonEmptyObject(matchResult)) {\n  return {\n    messages: [textBlock(\"no_data\", \"No data available — match result is empty.\")]\n  };\n}\n\nconst {\n  receipts,\n  invoices,\n  matchFound,\n  matchcommentary,\n  confirmationmessage\n} = matchResult;\n\nconst normalizedMatchFound = normalizeMatchFound(matchFound);\nconst hasReceipts = isNonEmptyArray(receipts);\nconst hasInvoices = isNonEmptyArray(invoices);\n\n// --GUARD: Both tables empty--\nif (!hasReceipts && !hasInvoices) {\n  return {\n    messages: [textBlock(\"no_data\", \"No receipt or invoice data was found.\")]\n  };\n}\n\n// --Build output — same layout for Y and N--\nconst messages = [];\n\n// 1. Text — semantic rewrite\nmessages.push(textBlock(\n  \"semantic_rewrite\",\n  semanticRewrite || \"Match result is available. Review the records below.\"\n));\n\n// 2. Text — match commentary\nmessages.push(textBlock(\n  \"match_commentary\",\n  matchcommentary || \"No match commentary was provided.\"\n));\n\n// 3. Receipts table\nif (hasReceipts) {\n  messages.push(tableBlock(\n    \"receipts_table\",\n    \"Receipt Records\",\n    receipts,\n    \"Display all receipt records exactly as provided. Do not summarize or alter the data.\"\n  ));\n} else {\n  messages.push(textBlock(\"receipts_empty\", \"No receipt records were found.\"));\n}\n\n// 4. Invoices table\nif (hasInvoices) {\n  messages.push(tableBlock(\n    \"invoices_table\",\n    \"Invoice Records\",\n    invoices,\n    \"Display all invoice records exactly as provided. Do not summarize or alter the data.\"\n  ));\n} else {\n  messages.push(textBlock(\"invoices_empty\", \"No invoice records were found.\"));\n}\n\n// 5. Text — confirmation message, only when matchFound is Y\nif (normalizedMatchFound === \"Y\") {\n  messages.push(textBlock(\n    \"confirmation_message\",\n    confirmationmessage || \"Match found. Please confirm whether to proceed.\"\n  ));\n}\n\nreturn {\n  messages\n};"
          },
          "outcomes": {
            "success": "1777275282082"
          },
          "code": "APPLYOUTPUT",
          "id": "1777020632186",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
