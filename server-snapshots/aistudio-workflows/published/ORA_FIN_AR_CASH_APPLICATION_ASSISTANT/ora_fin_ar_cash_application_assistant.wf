        {
          "metadata": {
            "name": "createfinalextract",
            "returnType": "object",
            "sourceCode": "// Inputs:\n//   - $context.$nodes.GETSHAPEANDCATALOG.$output  (wrapper containing result.shape.data_shapes[])\n//   - $context.$nodes.GENERATEBQL.$output         (the new SQL/select to inject)\n// Output:\n//   - Cloned shape value with select replaced by the generated query.\n\n\nvar debug = \"\";\n\n// 1. Pull the upstream shape-and-catalog payload\nvar upstreamOut = $context.$nodes.GETSHAPEANDCATALOG.$output;\ndebug += \"upstreamOut: \" + (upstreamOut ? \"OK\" : \"MISSING\") + \"\\n\";\nif (!upstreamOut) {\n  return { error: \"upstream node output is missing\", debug: debug };\n}\n\n// The result may be wrapped in .result (as in your sample) or not\nvar payload = upstreamOut.result ? upstreamOut.result : upstreamOut;\nvar shapeObj = payload.shape ? payload.shape : payload;\ndebug += \"shapeObj: \" + (shapeObj ? \"OK\" : \"MISSING\") + \"\\n\";\n\nvar dataShapes = (shapeObj && shapeObj.data_shapes) ? shapeObj.data_shapes : [];\ndebug += \"data_shapes count: \" + dataShapes.length + \"\\n\";\nif (dataShapes.length === 0) {\n  return { error: \"no data_shapes found in upstream output\", debug: debug };\n}\n\n// Take the first data shape's value (the object with select / viewQueries / return)\nvar source = dataShapes[0].value ? dataShapes[0].value : dataShapes[0];\ndebug += \"source keys: \" + Object.keys(source).join(\",\") + \"\\n\";\n\n// 2. Pull the generated query\nvar query = $context.$nodes.GENERATEBQL.$output;\nif (!query || typeof query !== \"string\") {\n  return { error: \"query is missing or not a string\", debug: debug };\n}\ndebug += \"query length: \" + query.length + \"\\n\";\n\n// 3. Clone and replace select\nvar cloned = JSON.parse(JSON.stringify(source));\ncloned.select = query;\n\nreturn {\n  shape: cloned,\n  name: dataShapes[0].name,\n  intent: shapeObj.intent,\n  shapes: shapeObj.shapes,\n  semantic_rewrite: shapeObj.semantic_rewrite,\n  debug: debug\n};"
          },
          "outcomes": {
            "success": "1775977957612"
          },
