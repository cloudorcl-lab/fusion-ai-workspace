        {
          "metadata": {
            "name": "summarizeRemitExtract",
            "returnType": "object",
            "sourceCode": "// --- Input ---\n\nvar inputData = null;\nvar tempdata = $context.$nodes.EXTRACTREMITDATA.$output;\n\n// tempdata directly represents the input array provided above.\nconst output = typeof tempdata === \"string\" ? JSON.parse(tempdata) : tempdata;\n\nconst receipts = Array.isArray(output) ? output : [];\n\nconst application = null;\nconst reference = null;\n\ninputData = receipts;\n\nvar debug = {};\n\n// --- Generic helpers ---\n\nfunction getValueIgnoreCase(obj, possibleKeys) {\n  if (!obj || typeof obj !== \"object\") return null;\n\n  for (var i = 0; i < possibleKeys.length; i++) {\n    var wanted = String(possibleKeys[i]).toLowerCase();\n\n    for (var k in obj) {\n      if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;\n\n      if (String(k).toLowerCase() === wanted) {\n        return obj[k];\n      }\n    }\n  }\n\n  return null;\n}\n\nfunction getSemanticRewriteText() {\n  return $context &&\n    $context.$variables &&\n    $context.$variables.chatcontext &&\n    $context.$variables.chatcontext.semantic_rewrite\n      ? String($context.$variables.chatcontext.semantic_rewrite)\n      : \"\";\n}\n\nfunction normalizeDisplayText(text) {\n  if (text == null) return \"\";\n\n  var value = String(text).trim();\n\n  if (!value) return \"\";\n\n  if (value.charAt(value.length - 1) !== \".\") {\n    value += \".\";\n  }\n\n  return value;\n}\n\nfunction getCustomerValue(row) {\n  return getValueIgnoreCase(row, [\n    \"customerName\",\n    \"CUSTOMERNAME\",\n    \"customername\",\n    \"customer\"\n  ]);\n}\n\nfunction isBlank(value) {\n  return value == null || String(value).trim() === \"\";\n}\n\nfunction countDistinctCustomers(rows) {\n  var seen = {};\n  var count = 0;\n\n  if (!rows || !rows.length) return 0;\n\n  for (var i = 0; i < rows.length; i++) {\n    var customer = getCustomerValue(rows[i]);\n\n    // Blank customer means orphan remittance advice, not a customer.\n    if (isBlank(customer)) continue;\n\n    var key = String(customer).trim().toLowerCase();\n\n    if (!seen[key]) {\n      seen[key] = true;\n      count++;\n    }\n  }\n\n  return count;\n}\n\nfunction countOrphanRemittanceAdvice(rows) {\n  var count = 0;\n\n  if (!rows || !rows.length) return 0;\n\n  for (var i = 0; i < rows.length; i++) {\n    var customer = getCustomerValue(rows[i]);\n\n    if (isBlank(customer)) {\n      count++;\n    }\n  }\n\n  return count;\n}\n\nfunction buildSummaryText(rows) {\n  var recordCount = rows && rows.length ? rows.length : 0;\n  var customerCount = countDistinctCustomers(rows);\n  var orphanCount = countOrphanRemittanceAdvice(rows);\n\n  if (recordCount === 0) {\n    return \"No remittance advice records were found.\";\n  }\n\n  var text =\n    \"Found \" +\n    recordCount +\n    \" remittance advice record\" +\n    (recordCount === 1 ? \"\" : \"s\") +\n    \" across \" +\n    customerCount +\n    \" customer\" +\n    (customerCount === 1 ? \"\" : \"s\") +\n    \".\";\n\n  if (orphanCount > 0) {\n    text +=\n      \" \" +\n      orphanCount +\n      \" record\" +\n      (orphanCount === 1 ? \" is\" : \"s are\") +\n      \" orphan remittance advice.\";\n  }\n\n  return text;\n}\n\nfunction buildSuggestionsText(rows) {\n  return \"\";\n}\n\nfunction buildOutput(dataRows, summaryText, dbg) {\n  return {\n    data: dataRows,\n    application: application,\n    remitref: reference,\n    aggregatedData: dataRows,\n    repeatAttributes: [],\n    summary: summaryText,\n    filterText: normalizeDisplayText(getSemanticRewriteText()),\n    suggestions: buildSuggestionsText(dataRows),\n    debug: dbg\n  };\n}\n\n// --- Parse input ---\n\nvar raw;\ntry {\n  raw = typeof inputData === \"string\" ? JSON.parse(inputData) : inputData;\n} catch (e) {\n  raw = null;\n}\n\nvar records = Array.isArray(raw) ? raw : raw && raw.data ? raw.data : [];\n\n// --- Output ---\n\ndebug.summary = {\n  recordCount: records.length,\n  customerCount: countDistinctCustomers(records),\n  orphanRemittanceAdviceCount: countOrphanRemittanceAdvice(records),\n  behavior:\n    \"No rollup is performed. Raw records are returned. Summary only reports total record count, distinct nonblank customer count, and orphan remittance advice count where customer is null or blank.\"\n};\n\nreturn buildOutput(records, buildSummaryText(records), debug);"
          },
          "outcomes": {
            "success": "1777620805007"
          },
