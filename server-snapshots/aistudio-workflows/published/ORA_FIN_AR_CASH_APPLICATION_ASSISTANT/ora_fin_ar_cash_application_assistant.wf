        {
          "metadata": {
            "name": "datarollup",
            "returnType": "object",
            "sourceCode": "// --- Input ---\n\nvar inputData = null;\nvar tempdata = $context.$nodes.RECEIPTINQUIRY.$output.output;\n\nfunction safeParse(value, fallback) {\n  if (value == null) return fallback;\n\n  if (typeof value === \"string\") {\n    var trimmed = value.trim();\n    if (!trimmed) return fallback;\n\n    try {\n      return JSON.parse(trimmed);\n    } catch (e) {\n      return fallback;\n    }\n  }\n\n  return value;\n}\n\nconst output = safeParse(tempdata, {});\nconst result = output && output.result ? output.result : {};\n\nconst receipts = Array.isArray(result.receipts) ? result.receipts : [];\nconst application = Array.isArray(result.application) ? result.application : [];\nconst reference = result.reference || \"\";\n\ninputData = receipts;\n\nvar debug = {};\n\n// --- Configuration ---\n\nvar RAW_THRESHOLD = 10;\nvar MAX_GROUP_OUTPUT_ROWS = 500;\n\n// --- Helpers ---\n\nfunction getSemanticRewriteText() {\n  return $context &&\n    $context.$variables &&\n    $context.$variables.chatcontext &&\n    $context.$variables.chatcontext.semantic_rewrite\n      ? String($context.$variables.chatcontext.semantic_rewrite)\n      : \"\";\n}\n\nfunction normalizeDisplayText(text) {\n  if (text == null) return \"\";\n\n  var value = String(text).trim();\n\n  if (!value) return \"\";\n\n  if (value.charAt(value.length - 1) !== \".\") {\n    value += \".\";\n  }\n\n  return value;\n}\n\nfunction parseAmount(value) {\n  var num = Number(value);\n  return value != null && !isNaN(num) ? num : 0;\n}\n\nfunction roundAmount(value) {\n  return Math.round(Number(value || 0) * 100) / 100;\n}\n\nfunction formatAmount(amount) {\n  if (amount == null || isNaN(Number(amount))) return \"unknown amount\";\n\n  return Number(amount).toLocaleString(undefined, {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2\n  });\n}\n\nfunction formatAmountWithCurrency(amount, currency) {\n  var formattedAmount = formatAmount(amount);\n\n  if (currency == null || currency === \"\") {\n    return formattedAmount;\n  }\n\n  return formattedAmount + \" \" + currency;\n}\n\nfunction buildLargestReceiptSentence(receipt) {\n  if (!receipt || !receipt.RECEIPTNUMBER) return \"\";\n\n  var text =\n    \" The largest unapplied receipt is receipt \" +\n    receipt.RECEIPTNUMBER;\n\n  if (receipt.CUSTOMERNAME) {\n    text += \" for \" + receipt.CUSTOMERNAME;\n  }\n\n  text +=\n    \", with \" +\n    formatAmountWithCurrency(\n      receipt.AMOUNTREMAINING,\n      receipt.RECEIPTCURRENCYCODE\n    ) +\n    \".\";\n\n  return text;\n}\n\nfunction cleanRawReceipt(row) {\n  return {\n    BUSINESSUNITNAME: row.BUSINESSUNITNAME,\n    CUSTOMERNAME: row.CUSTOMERNAME,\n    CUSTOMERACCOUNTNUMBER: row.CUSTOMERACCOUNTNUMBER,\n    RECEIPTNUMBER: row.RECEIPTNUMBER,\n    RECEIPTDATE: row.RECEIPTDATE,\n    AMOUNTREMAINING: row.AMOUNTREMAINING,\n    RECEIPTMETHODNAME: row.RECEIPTMETHODNAME,\n    RECEIPTCURRENCYCODE: row.RECEIPTCURRENCYCODE,\n    BANKNAME: row.BANKNAME,\n    RECEIPTSOURCE: row.RECEIPTSOURCE\n  };\n}\n\nfunction buildSuggestionsText(rows) {\n  var suggestions = [];\n\n  if (!rows || !rows.length) return \"\";\n\n  var firstRow = rows[0];\n\n  if (rows.length === 1 && firstRow.RECEIPTNUMBER) {\n    suggestions.push(\"Show invoice matches for receipt \" + firstRow.RECEIPTNUMBER);\n    suggestions.push(\"Show promise matches for receipt \" + firstRow.RECEIPTNUMBER);\n    suggestions.push(\"Show details for receipt \" + firstRow.RECEIPTNUMBER);\n\n    return suggestions.map(function(s) {\n      return \"• \" + s;\n    }).join(\"\\n\");\n  }\n\n  if (firstRow.CUSTOMERNAME) {\n    suggestions.push(\"Show unapplied receipts for customer \" + firstRow.CUSTOMERNAME);\n    suggestions.push(\"Show open invoices for customer \" + firstRow.CUSTOMERNAME);\n  }\n\n  if (\n    rows.length > 1 &&\n    rows[1].CUSTOMERNAME &&\n    rows[1].CUSTOMERNAME !== firstRow.CUSTOMERNAME\n  ) {\n    suggestions.push(\"Show unapplied receipts for customer \" + rows[1].CUSTOMERNAME);\n    suggestions.push(\"Show open invoices for customer \" + rows[1].CUSTOMERNAME);\n  }\n\n  return suggestions.slice(0, 4).map(function(s) {\n    return \"• \" + s;\n  }).join(\"\\n\");\n}\n\nfunction buildOutput(dataRows, aggregateRows, summaryText, dbg) {\n  return {\n    data: dataRows,\n    application: application,\n    remitref: reference,\n    aggregatedData: aggregateRows,\n    repeatAttributes: [],\n    summary: summaryText,\n    filterText: normalizeDisplayText(getSemanticRewriteText()),\n    suggestions: buildSuggestionsText(dataRows),\n    debug: dbg\n  };\n}\n\nfunction buildRawSummary(rows) {\n  var count = rows ? rows.length : 0;\n\n  if (!count) {\n    return \"No unapplied receipt records were found.\";\n  }\n\n  var totalsByCurrency = {};\n  var currencyOrder = [];\n\n  for (var i = 0; i < rows.length; i++) {\n    var currency = rows[i].RECEIPTCURRENCYCODE || \"\";\n    var amount = parseAmount(rows[i].AMOUNTREMAINING);\n\n    if (!totalsByCurrency.hasOwnProperty(currency)) {\n      totalsByCurrency[currency] = 0;\n      currencyOrder.push(currency);\n    }\n\n    totalsByCurrency[currency] += amount;\n  }\n\n  var totalTextParts = [];\n\n  for (var c = 0; c < currencyOrder.length; c++) {\n    var curr = currencyOrder[c];\n    totalTextParts.push(formatAmountWithCurrency(roundAmount(totalsByCurrency[curr]), curr));\n  }\n\n  var uniformScope = getUniformReceiptScope(rows);\n  var scopeText = buildUniformScopeText(uniformScope);\n\n  if (scopeText) {\n    return (\n      scopeText +\n      \" has \" +\n      count +\n      \" unapplied receipt record\" +\n      (count === 1 ? \"\" : \"s\") +\n      \", totaling \" +\n      totalTextParts.join(\", \") +\n      \".\"\n    );\n  }\n\n  return (\n    \"Found \" +\n    count +\n    \" unapplied receipt record\" +\n    (count === 1 ? \"\" : \"s\") +\n    \", totaling \" +\n    totalTextParts.join(\", \") +\n    \".\"\n  );\n}\n\nfunction buildRollupSummary(\n  totalRecordCount,\n  returnedGroupCount,\n  totalGroupCount,\n  totalsByCurrency,\n  currencyOrder,\n  topGroup,\n  largestReceipt\n) {\n  var totalTextParts = [];\n\n  for (var i = 0; i < currencyOrder.length; i++) {\n    var currency = currencyOrder[i];\n    totalTextParts.push(formatAmountWithCurrency(roundAmount(totalsByCurrency[currency]), currency));\n  }\n\n  var text =\n    \"Found \" +\n    totalRecordCount +\n    \" unapplied receipt records across \" +\n    totalGroupCount +\n    \" grouped customer/account/currency combination\" +\n    (totalGroupCount === 1 ? \"\" : \"s\") +\n    \", totalling \" +\n    totalTextParts.join(\", \") +\n    \".\";\n\n  var uniformScope = getUniformReceiptScope(outputRows);\n  var scopeText = buildUniformScopeText(uniformScope);\n\n  if (scopeText) {\n    text += \" \" + scopeText + \".\";\n  }\n  if (returnedGroupCount < totalGroupCount) {\n    text +=\n      \" Showing top \" +\n      returnedGroupCount +\n      \" groups sorted by amount remaining highest to lowest.\";\n  } else {\n    text += \" Showing all groups sorted by amount remaining highest to lowest.\";\n  }\n\n  if (topGroup) {\n    text +=\n      \" The highest amount group is \" +\n      (topGroup.CUSTOMERNAME || \"unknown Customer\");\n\n    if (topGroup.CUSTOMERACCOUNTNUMBER) {\n      text += \", Account# \" + topGroup.CUSTOMERACCOUNTNUMBER;\n    }\n\n    if (topGroup.BUSINESSUNITNAME) {\n      text += \", Business Unit \" + topGroup.BUSINESSUNITNAME;\n    }\n\n    text +=\n      \", with \" +\n      topGroup.count +\n      \" receipt\" +\n      (topGroup.count === 1 ? \"\" : \"s\") +\n      \" and \" +\n      formatAmountWithCurrency(\n        topGroup.AMOUNTREMAINING,\n        topGroup.RECEIPTCURRENCYCODE\n      ) +\n      \".\";\n  }\n\n  if (largestReceipt) {\n    text += buildLargestReceiptSentence(largestReceipt);\n  }\n\n  return text;\n}\n\nfunction areAllRecordsSameCustomer(rows) {\n  if (!rows || !rows.length) return false;\n\n  var firstCustomerName = rows[0].CUSTOMERNAME || \"\";\n  var firstCustomerAccountNumber = rows[0].CUSTOMERACCOUNTNUMBER || \"\";\n\n  for (var i = 1; i < rows.length; i++) {\n    if ((rows[i].CUSTOMERNAME || \"\") !== firstCustomerName) {\n      return false;\n    }\n\n    if ((rows[i].CUSTOMERACCOUNTNUMBER || \"\") !== firstCustomerAccountNumber) {\n      return false;\n    }\n  }\n\n  return true;\n}\n\n// --- same customer name / account / business unit ---\nfunction getUniformReceiptScope(rows) {\n  var scope = {\n    customerName: null,\n    customerAccountNumber: null,\n    businessUnitName: null,\n    customerNameUniform: false,\n    customerAccountNumberUniform: false,\n    businessUnitNameUniform: false\n  };\n\n  if (!rows || !rows.length) {\n    return scope;\n  }\n\n  function isUniformField(fieldName) {\n    var firstValue = rows[0][fieldName] == null ? \"\" : String(rows[0][fieldName]);\n\n    for (var i = 1; i < rows.length; i++) {\n      var currentValue = rows[i][fieldName] == null ? \"\" : String(rows[i][fieldName]);\n\n      if (currentValue !== firstValue) {\n        return false;\n      }\n    }\n\n    return firstValue !== \"\";\n  }\n\n  scope.customerNameUniform = isUniformField(\"CUSTOMERNAME\");\n  scope.customerAccountNumberUniform = isUniformField(\"CUSTOMERACCOUNTNUMBER\");\n  scope.businessUnitNameUniform = isUniformField(\"BUSINESSUNITNAME\");\n\n  if (scope.customerNameUniform) {\n    scope.customerName = rows[0].CUSTOMERNAME;\n  }\n\n  if (scope.customerAccountNumberUniform) {\n    scope.customerAccountNumber = rows[0].CUSTOMERACCOUNTNUMBER;\n  }\n\n  if (scope.businessUnitNameUniform) {\n    scope.businessUnitName = rows[0].BUSINESSUNITNAME;\n  }\n\n  return scope;\n}\n\nfunction buildUniformScopeText(scope) {\n  var parts = [];\n\n  if (scope && scope.customerName) {\n    parts.push(\"Customer \" + scope.customerName);\n  }\n\n  if (scope && scope.customerAccountNumber) {\n    parts.push(\"Account# \" + scope.customerAccountNumber);\n  }\n\n  if (scope && scope.businessUnitName) {\n    parts.push(\"Business Unit \" + scope.businessUnitName);\n  }\n\n  return parts.join(\", \");\n}\n\n// --- Parse records ---\n\nvar records = Array.isArray(inputData)\n  ? inputData\n  : ((inputData && inputData.data) ? inputData.data : []);\n\nvar recordCount = records.length;\n\n// --- Empty result ---\n\nif (!recordCount) {\n  debug.rollup = {\n    recordCount: 0,\n    groupCount: 0,\n    returnedGroupCount: 0,\n    bypassed: true,\n    reason: \"No records\"\n  };\n\n  return buildOutput(\n    [],\n    [],\n    \"No unapplied receipt records were found.\",\n    debug\n  );\n}\n\n// --- Small result: raw pass-through with CASHRECEIPTID removed ---\n\nif (recordCount <= RAW_THRESHOLD) {\n  var rawRows = [];\n\n  for (var r = 0; r < recordCount; r++) {\n    rawRows.push(cleanRawReceipt(records[r]));\n  }\n\n  debug.rollup = {\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedGroupCount: recordCount,\n    bypassed: true,\n    threshold: RAW_THRESHOLD,\n    reason: \"Small result set, raw pass-through with CASHRECEIPTID removed\"\n  };\n\n  return buildOutput(\n    rawRows,\n    rawRows,\n    buildRawSummary(rawRows),\n    debug\n  );\n}\n\n// --- Same customer result: raw pass-through with CASHRECEIPTID removed ---\n\nif (areAllRecordsSameCustomer(records)) {\n  var sameCustomerRawRows = [];\n\n  for (var sr = 0; sr < recordCount; sr++) {\n    sameCustomerRawRows.push(cleanRawReceipt(records[sr]));\n  }\n\n  debug.rollup = {\n    recordCount: recordCount,\n    groupCount: recordCount,\n    returnedGroupCount: recordCount,\n    bypassed: true,\n    threshold: RAW_THRESHOLD,\n    reason: \"All records are for the same customer/account, raw pass-through with CASHRECEIPTID removed\"\n  };\n\n  return buildOutput(\n    sameCustomerRawRows,\n    sameCustomerRawRows,\n    buildRawSummary(sameCustomerRawRows),\n    debug\n  );\n}\n\n// --- Large result: fixed-schema single-pass aggregation ---\n\nvar groups = {};\nvar groupOrder = [];\n\nvar totalsByCurrency = {};\nvar currencyOrder = [];\nvar largestReceipt = null;\n\nfor (var i = 0; i < recordCount; i++) {\n  var row = records[i];\n\n  var businessUnit = row.BUSINESSUNITNAME || \"\";\n  var customerName = row.CUSTOMERNAME || \"\";\n  var accountNumber = row.CUSTOMERACCOUNTNUMBER || \"\";\n  var currencyCode = row.RECEIPTCURRENCYCODE || \"\";\n  var amountRemaining = parseAmount(row.AMOUNTREMAINING);\n\n  if (!largestReceipt || amountRemaining > parseAmount(largestReceipt.AMOUNTREMAINING)) {\n    largestReceipt = cleanRawReceipt(row);\n  }\n\n  if (!totalsByCurrency.hasOwnProperty(currencyCode)) {\n    totalsByCurrency[currencyCode] = 0;\n    currencyOrder.push(currencyCode);\n  }\n\n  totalsByCurrency[currencyCode] += amountRemaining;\n\n  var groupKey =\n    businessUnit +\n    \"|||\" +\n    customerName +\n    \"|||\" +\n    accountNumber +\n    \"|||\" +\n    currencyCode;\n\n  if (!groups[groupKey]) {\n    groups[groupKey] = {\n      BUSINESSUNITNAME: businessUnit,\n      CUSTOMERNAME: customerName,\n      CUSTOMERACCOUNTNUMBER: accountNumber,\n      count: 0,\n      AMOUNTREMAINING: 0,\n      RECEIPTCURRENCYCODE: currencyCode\n    };\n\n    groupOrder.push(groupKey);\n  }\n\n  groups[groupKey].count = groups[groupKey].count + 1;\n  groups[groupKey].AMOUNTREMAINING =\n    groups[groupKey].AMOUNTREMAINING + amountRemaining;\n}\n\n// --- Convert groups to rows ---\n\nvar aggregatedData = [];\n\nfor (var g = 0; g < groupOrder.length; g++) {\n  var groupedRow = groups[groupOrder[g]];\n\n  groupedRow.AMOUNTREMAINING = roundAmount(groupedRow.AMOUNTREMAINING);\n\n  aggregatedData.push(groupedRow);\n}\n\n// --- Sort descending by grouped AMOUNTREMAINING ---\n\naggregatedData.sort(function(a, b) {\n  return Number(b.AMOUNTREMAINING || 0) - Number(a.AMOUNTREMAINING || 0);\n});\n\n// --- Cap output rows to top 500 ---\n\nvar totalGroupCount = aggregatedData.length;\nvar outputRows = aggregatedData;\n\nif (aggregatedData.length > MAX_GROUP_OUTPUT_ROWS) {\n  outputRows = aggregatedData.slice(0, MAX_GROUP_OUTPUT_ROWS);\n}\n\n// --- Debug ---\n\ndebug.rollup = {\n  recordCount: recordCount,\n  groupCount: totalGroupCount,\n  returnedGroupCount: outputRows.length,\n  rawThreshold: RAW_THRESHOLD,\n  maxGroupOutputRows: MAX_GROUP_OUTPUT_ROWS,\n  groupByKeys: [\n    \"BUSINESSUNITNAME\",\n    \"CUSTOMERNAME\",\n    \"CUSTOMERACCOUNTNUMBER\",\n    \"RECEIPTCURRENCYCODE\"\n  ],\n  rollupFields: [\n    \"count\",\n    \"AMOUNTREMAINING\"\n  ],\n  sort: \"AMOUNTREMAINING descending\",\n  behavior: \"For 1-10 records, raw records are returned with CASHRECEIPTID removed. For more than 10 records, if all records belong to the same CUSTOMERNAME and CUSTOMERACCOUNTNUMBER, raw records are returned with CASHRECEIPTID removed. Otherwise, records are grouped by BUSINESSUNITNAME, CUSTOMERNAME, CUSTOMERACCOUNTNUMBER, and RECEIPTCURRENCYCODE. count is calculated and AMOUNTREMAINING is summed. Grouped rows are sorted by AMOUNTREMAINING descending and capped to top 500.\"\n};\n\n// --- Summary ---\n\nvar summary = buildRollupSummary(\n  recordCount,\n  outputRows.length,\n  totalGroupCount,\n  totalsByCurrency,\n  currencyOrder,\n  outputRows[0],\n  largestReceipt\n);\n\n// --- Output ---\n\nreturn buildOutput(\n  outputRows,\n  outputRows,\n  summary,\n  debug\n);"
          },
