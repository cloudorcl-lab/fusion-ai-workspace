        {
          "metadata": {
            "name": "genericoutputformat",
            "returnType": "object",
            "sourceCode": "// ---Inputs---\nconst output = $context.$nodes.GENERICOUTPUT.$output || {};\n\n// ---Resolve summary text---\nconst summaryText = output.response || \"\";\n\n// ---If summary is empty, return no data message---\nif (!summaryText) {\n  return {\n    messages: [\n      {\n        id: \"summary_body\",\n        type: \"text\",\n        authoringHints: \"Render as the main body paragraph. Use plain prose styling.\",\n        contentPolicy: \"author\",\n        data: \"No Data returned.\"\n      }\n    ]\n  };\n}\n\n// ---Output summary only---\nreturn {\n  messages: [\n    {\n      id: \"summary_body\",\n      type: \"text\",\n      contentPolicy: \"normalizeOnly\",\n      authoringHints: \"Display this text exactly as provided. Do not summarize, rewrite, infer, or override the data.\",\n      data: summaryText\n    }\n  ]\n};"
          },
          "outcomes": {
