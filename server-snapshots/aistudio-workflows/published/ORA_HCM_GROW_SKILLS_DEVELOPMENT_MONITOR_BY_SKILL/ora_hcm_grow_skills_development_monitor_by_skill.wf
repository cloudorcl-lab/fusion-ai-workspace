          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"SkillsSortedByDevelopingCountResponse\",\n  \"type\": \"object\",\n  \"required\": [\"totalResults\", \"offset\", \"hasMore\", \"limit\", \"count\", \"items\"],\n  \"properties\": {\n    \"totalResults\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Total number of results matching the query across all pages.\"\n    },\n    \"offset\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Zero-based index of the first result returned in this page.\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\",\n      \"description\": \"Indicates if additional pages are available after this page.\"\n    },\n    \"limit\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Maximum number of items requested per page.\"\n    },\n    \"count\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"description\": \"Number of items actually returned in this page.\"\n    },\n    \"items\": {\n      \"type\": \"array\",\n      \"description\": \"List of skill aggregates for this page.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\"SkillName\", \"SkillId\", \"AchievedCount\", \"DevelopingCount\", \"TotalCount\"],\n        \"properties\": {\n          \"SkillName\": {\n            \"type\": \"string\",\n            \"minLength\": 1,\n            \"description\": \"Display name of the skill.\"\n          },\n          \"SkillId\": {\n            \"description\": \"Unique identifier of the skill.\",\n            \"oneOf\": [\n              { \"type\": \"integer\" },\n              { \"type\": \"string\", \"minLength\": 1 }\n            ]\n          },\n          \"AchievedCount\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"description\": \"Count of people who achieved the skill.\"\n          },\n          \"DevelopingCount\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"description\": \"Count of people currently developing the skill.\"\n          },\n          \"TotalCount\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"description\": \"Total count for the skill; typically equals AchievedCount + DevelopingCount.\"\n          }\n        },\n        \"additionalProperties\": false\n      }\n    },\n    \"query\": {\n      \"description\": \"Query string or JSON used to generate the results; may be null.\",\n      \"type\": [\"string\", \"null\"]\n    }\n  },\n  \"additionalProperties\": false\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Developing Skills Names",
            "returnType": "array",
            "sourceCode": "var src = $context.$nodes.GET_SKILLS_SORTED_BY_DEVELOPING_COUNT.$output.items;\nvar items = Array.isArray(src) ? src : [];\n\nvar skillsNamesArray = items\n  .filter(function(it) {\n    return it &&\n      typeof it.SkillName === 'string' &&\n      it.SkillName.length > 0 &&\n      Number(it.DevelopingCount) > 0;\n  })\n  .map(function(it) { return it.SkillName; });\n\nreturn skillsNamesArray;"
          },
          "outcomes": {
            "success": "1770145152571"
          },
          "code": "EXTRACT_DEVELOPING_SKILLS_NAMES",
          "convergenceTargetId": "1769727645834",
          "id": "1770144982871",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
