                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Add Employees to Skill",
                    "returnType": "array",
                    "sourceCode": "var acc = $context.$variables.employeesDevelopingSkills;\nif (!Array.isArray(acc)) {\n  acc = [];\n}\n\n// Inputs from the loop\nvar currentSkillName = $context.$nodes.FOR_EACH_DEVELOPING_SKILL.$currentItem;\nvar currentEmployeeItems = $context.$nodes.FOR_EACH_DEVELOPING_SKILL.GET_EMPLOYEES.$output;\n\n// Normalize inputs\nvar skill = String(currentSkillName || '');\nvar itemsToAdd = Array.isArray(currentEmployeeItems)\n  ? currentEmployeeItems\n  : (currentEmployeeItems ? [currentEmployeeItems] : []);\n\n// Find existing entry for this skill\nvar idx = -1;\nfor (var i = 0; i < acc.length; i++) {\n  if (acc[i] && acc[i].skill === skill) { idx = i; break; }\n}\n\n// Insert or update\nif (idx === -1) {\n  acc.push({ skill: skill, employees: itemsToAdd.slice() });\n} else {\n  // Append to existing employees array\n  Array.prototype.push.apply(acc[idx].employees, itemsToAdd);\n}\n\n// Return the updated array (persist in a separate node as needed)\nreturn acc;"
                  },
                  "outcomes": {
                    "success": "1770239622422"
                  },
                  "code": "ADD_EMPLOYEES_TO_SKILL",
                  "id": "1770231319469",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
