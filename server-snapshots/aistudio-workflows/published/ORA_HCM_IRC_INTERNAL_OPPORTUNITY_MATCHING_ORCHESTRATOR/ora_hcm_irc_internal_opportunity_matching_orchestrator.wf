            {
              "id": "1765225186557_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a summary generation agent. You need to summarise the following :\n\n- the candidate's profile. highlight key points\n- the top 2 opportunities suggested to the candidate\n- what skills the candidate has that would make them a strong fit for the suggested roles\n\nReturn a text summary no longer than 3 sentences. Use a friendly and warm tone in writing the summary and refer to the user in second person.\n\nInput: \nCandidate Profile : {{$context.$variables.candidateProfile}}\nMatched Opportunities: {{$context.$variables.matchedOpportunities}}"
            }
          ],
          "type": "LLM"
        },
