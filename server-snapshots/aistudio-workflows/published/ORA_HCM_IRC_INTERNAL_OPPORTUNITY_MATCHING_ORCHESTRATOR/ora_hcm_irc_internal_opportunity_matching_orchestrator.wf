              "type": "string"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Prepare Data For Init Actions Agent",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.ACTION_WF_AGENT.$output.output;\nvar data = raw;\nif (data && typeof data === \"string\") {\n  var trimmed = data.replace(/^\\s+|\\s+$/g, \"\");\n  if (trimmed.charAt(0) === \"{\" || trimmed.charAt(0) === \"[\") {\n    try { data = JSON.parse(trimmed); } catch (e) { data = raw; }\n  }\n}\nvar actions = [];\nif (data && Object.prototype.toString.call(data) === \"[object Array]\") { actions = data; }\nelse if (data && data.actions && Object.prototype.toString.call(data.actions) === \"[object Array]\") { actions = data.actions; }\nelse if (data && data.result && Object.prototype.toString.call(data.result) === \"[object Array]\") { actions = data.result; }\nelse if (data && data.result && data.result.actions && Object.prototype.toString.call(data.result.actions) === \"[object Array]\") { actions = data.result.actions; }\nif (!actions.length) { return data || { actions: [] }; }\nvar normalized = [];\nfor (var i = 0; i < actions.length; i += 1) {\n  var item = actions[i];\n  if (!item || typeof item !== \"object\") { continue; }\n  if (!item.followUpCommand || !item.actionText) { continue; }\n  normalized.push({\n    title: item.title || item.actionText,\n    shortDescription: item.shortDescription || item.description || \"Action available.\",\n    actionText: item.actionText,\n    followUpCommand: item.followUpCommand,\n    priority: item.priority === true\n  });\n}\nreturn { actions: normalized };"
          },
          "outcomes": {
            "success": "1765225756510"
          },
          "code": "PREPARE_DATA_FOR_INIT_ACTIONS_AGENT",
          "id": "1765226712158",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
