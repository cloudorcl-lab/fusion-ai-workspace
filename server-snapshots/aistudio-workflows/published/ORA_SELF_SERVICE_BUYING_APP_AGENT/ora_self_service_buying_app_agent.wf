          "code": "ROUTER",
          "convergenceTargetId": "end",
          "id": "1767162244137",
          "inputs": [
            {
              "id": "1767162244138_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
