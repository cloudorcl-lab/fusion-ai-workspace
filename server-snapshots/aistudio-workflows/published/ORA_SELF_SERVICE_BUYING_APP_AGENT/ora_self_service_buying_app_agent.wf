        {
          "metadata": {
            "name": "Form query param",
            "returnType": "string",
            "sourceCode": "let result = \"\";\nconst accountPartyId=$context.$nodes.RETURN_BUSINESS_UNIT_ID.$output.result.AccountPartyId;\ntry {\n  // Get current date from system variable\n  const today = $context.$system?.$currentDate;\n\n  // Parse the current date string to Date object\n  const todayDate = new Date(today);\n\n  // Add 3 days to current date\n  const endDate = new Date(todayDate);\n  endDate.setDate(endDate.getDate() + 30);\n\n  todayDate.setDate(todayDate.getDate() + 3);\n\n  // Format date to ISO string and slice to yyyy-mm-dd\n  const fmt = d => d.toISOString().slice(0, 10);\n\n  // Build query string with $gte and $lte conditions and additional filters\n  const q = encodeURI(`{\"$and\":[{_s_customerStatus_t:{$eq:\"acceptance\"}},{_customer_id:{$eq:'${accountPartyId}'}},{priceExpirationDate_t:{$gte:'${fmt(todayDate)}'}},{priceExpirationDate_t:{$lte:'${fmt(endDate)}'}},{_s_assignedTo_t:{$eq:\"BUYER\"}},{_s_transactionSource_t:{$eq:\"sellerInitiated\"}},{_s_isPublished_t:{$eq:true}}]}`);\n\n  result = q;\n} catch (error) {\n  result = \"\"; // Return empty string on error\n}\n\nreturn result;"
