          "type": "SWITCH"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "get Actions Details",
            "returnType": "object",
            "sourceCode": "let returnObj = { formSubmit: false }; // Initialize returnObj\nlet formValues = {};\nconst LABEL_TO_SUBACTION = new Map([[\"View Details\", \"Details\"]]);\nconst ACTION_TOKEN_CONFIG = new Map([\n  [\n    \"Submit Order\",\n    {\n      payloadFields: [\n        { index: 3, key: \"billingAddressId\" },\n        { index: 4, key: \"shippingAddressId\" },\n        { index: 5, key: \"ShippingMethodId\" },\n      ],\n      returnAction: \"Accept and Order\",\n      returnSubaction: \"ORDER_TOTALS\",\n      includeContextOnly: true,\n    },\n  ],\n  [\n    \"View Child Lines\",\n    {\n      payloadFields: [\n        { index: 3, key: \"documentNumber\" }\n      ],\n      returnAction: \"View Child Lines\",\n      returnSubaction: \"default\",\n      includeContextOnly: true,\n    },\n  ]\n]);\n\nconst FORM_HANDLERS = new Map([\n  [\n    \"rejectQuote\",\n    {\n      action: \"Reject\",\n      subaction: \"ConfirmReject\",\n      messageTemplate: \"{{rejectPrompt}}\",\n      quoteMessage: true,\n      fields: [{ base: \"rejectPrompt\", as: \"rejectPrompt\" }]\n    }\n  ],\n  [\n    \"requestQuoteChanges\",\n    {\n      action: \"Request Changes\",\n      subaction: \"ConfirmRequest\",\n      messageTemplate: \"{{requestPrompt}}\",\n      quoteMessage: true,\n      fields: [{ base: \"requestPrompt\", as: \"requestPrompt\" }]\n    }\n  ],\n  [\n    \"order_totals_form\",\n    {\n      action: \"Accept and Order\",\n      subaction: \"ORDER_TOTALS\",\n      messageTemplate: \"For Quote: {{id}}\",\n      quoteMessage: false,\n      fields: [\n        { id: \"billing_address\", as: \"billingAddressRaw\" },\n        { id: \"shipping_address\", as: \"shippingAddressRaw\" },\n        {id: \"shipping_method\", as: \"ShippingMethodRaw\"}\n      ]\n    }\n  ]\n]);\n\n// Backward compatibility context extraction mapping (will be filled using the scalable parser below)\nconst FORM_ID_TO_CONTEXT_FIELDS = new Map([\n  [\n    \"order_totals_form\",\n    [\n      {\n        fieldId: \"billing_address\",\n        rawKey: \"billingAddressRaw\",\n        idKey: \"billingAddressId\",\n      },\n      {\n        fieldId: \"shipping_address\",\n        rawKey: \"shippingAddressRaw\",\n        idKey: \"shippingAddressId\",\n      },\n      {\n        fieldId: \"shipping_method\",\n        rawKey: \"ShippingMethodRaw\",\n        idKey: \"ShippingMethodId\",\n      }\n    ],\n  ],\n]);\n\n// Utilities\nconst splitEncoded = (val) => (typeof val === \"string\" ? val.split(\"~~\") : []);\nconst baseOf = (val) =>\n  typeof val === \"string\" ? val.split(\"~~\")[0] : undefined;\nconst truthyStr = (s) => (typeof s === \"string\" && s.length > 0 ? s : null);\nconst tryParseArray = (json) => {\n  try {\n    const parsed = JSON.parse(json);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch {\n    return [];\n  }\n};\nconst template = (tmpl, data) =>\n  tmpl.replace(/\\{\\{\\s*([^}]+)\\s*\\}\\}/g, (_, k) => {\n    const v = data[k];\n    return v === undefined || v === null ? \"\" : String(v);\n  });\n\nconst sanitizeToken = (val) =>\n  typeof val === \"string\" ? val.replace(/\"/g, \"\") : val;\nconst extractActionPayloadContext = (actionType, parts) => {\n  const config = ACTION_TOKEN_CONFIG.get(actionType);\n  if (!config || !Array.isArray(config.payloadFields)) return {};\n\n  const context = {};\n  for (const field of config.payloadFields) {\n    context[field.key] = sanitizeToken(parts[field.index] || \"\") || null;\n  }\n\n  return context;\n};\n\nconst action = $context.$app.$OraAction;\nconst match = action.match(\n  /<oraFormSubmit\\s+id=[\"']([^\"']*)[\"'][^>]*>(.*?)<\\/oraFormSubmit>/s,\n);\n\nif (match) {\n  formValues.id = match[1]; // Extract (possibly encoded) form ID, e.g., \"order_totals_form~~<ID>~~<TID>\"\n  formValues.json = match[2]; // Extract form JSON content\n  returnObj.formSubmit = true;\n  returnObj.formValues = formValues;\n\n  // Decode base form id and embedded ids: <base>~~<ID>~~<TID>\n  const encodedFormId = formValues.id || \"\";\n  const idParts = splitEncoded(encodedFormId);\n  const rawFormId = idParts[0] || encodedFormId; // e.g., 'order_totals_form'\n  const quoteId = idParts[1] || null;\n  const transactionId = idParts[2] || null;\n\n  // Locate handler or fall back\n  const handler = FORM_HANDLERS.get(rawFormId);\n\n  // Parse submitted fields array once\n  const submittedFields = tryParseArray(formValues.json);\n\n  // Generic field extraction honoring handler config\n  const extracted = {};\n  if (handler && Array.isArray(handler.fields)) {\n    for (const cfg of handler.fields) {\n      const matchField = submittedFields.find((f) => {\n        if (!f || typeof f.id !== \"string\") return false;\n        if (cfg.id) return f.id === cfg.id;\n        if (cfg.base) return baseOf(f.id) === cfg.base;\n        return false;\n      });\n      if (matchField) {\n        const val = matchField.value;\n        extracted[cfg.as || cfg.id || cfg.base] = val;\n        if (cfg.takeFirstSeg) {\n          extracted[(cfg.as || cfg.id || cfg.base) + \"First\"] = truthyStr(val)\n            ? val.split(\"~~\")[0]\n            : null;\n        }\n      }\n    }\n  }\n\n  // Build contextual data based on mapping for this form id\n  const context = { formId: rawFormId };\n  const fieldConfigs = FORM_ID_TO_CONTEXT_FIELDS.get(rawFormId);\n  if (Array.isArray(fieldConfigs) && fieldConfigs.length > 0) {\n    // Reuse parsed submittedFields for backward-compatible context mapping\n    let parsed = submittedFields;\n    const getField = (fid) =>\n      Array.isArray(parsed) ? parsed.find((f) => f && f.id === fid) : undefined;\n    const firstSeg = (val) =>\n      typeof val === \"string\" ? val.split(\"~~\")[0] : null;\n\n    for (const cfg of fieldConfigs) {\n      const f = getField(cfg.fieldId);\n      const raw = f && typeof f.value === \"string\" ? f.value : null;\n      if (cfg.rawKey) context[cfg.rawKey] = raw;\n      if (cfg.idKey) context[cfg.idKey] = firstSeg(raw);\n    }\n  }\n\n  // Determine action/subaction and build message using template\n  const actionName = handler?.action || \"QUOTE\";\n  const subAction = handler?.subaction || \"MODIFY\";\n  const dataForTemplate = { id: quoteId, tid: transactionId, ...extracted };\n  let builtMessage = handler?.messageTemplate\n    ? template(handler.messageTemplate, dataForTemplate).trim()\n    : \"\";\n  builtMessage = builtMessage.replace(/\\s+/g, \" \").trim();\n  if (handler?.quoteMessage && builtMessage) {\n    builtMessage = `${builtMessage}`;\n  }\n\n  // Build the structured return object\n  returnObj = {\n    action: actionName,\n    subaction: subAction,\n    tid: transactionId,\n    id: quoteId,\n    message: builtMessage || undefined,\n  };\n\n  // Attach contextual selection details for downstream use\n  returnObj.context = { ...context, ...extracted };\n} else {\n  let actionType;\n  let subActionType = \"default\";\n  let quoteId;\n  let transactionId;\n  let documentNumber;\n  let requestedRatePlan;\n  let actionContext = {};\n\n  if (!action.includes(\"~~\")) {\n    quoteId = action.replace(/\"/g, \"\");\n  } else {\n    const varArr = action.split(\"~~\");\n    actionType = varArr[0] || \"default\";\n    quoteId = varArr[1] || \"\";\n    transactionId = varArr[2] || \"\";\n    const actionConfig = ACTION_TOKEN_CONFIG.get(actionType);\n\n    if (actionConfig) {\n      actionContext = extractActionPayloadContext(actionType, varArr);\n    } else {\n      documentNumber = varArr[3] || \"\";\n      requestedRatePlan = varArr[4] || \"\";\n    }\n  }\n\n  quoteId = quoteId.replace(/\"/g, \"\");\n  actionType = actionType.replace(/\"/g, '');\n  transactionId = transactionId.replace(/\"/g, '');\n  documentNumber = documentNumber?.replace(/\"/g, '');\n  requestedRatePlan = requestedRatePlan?.replace(/\"/g, '');\n  if (actionType === \"Details\" && requestedRatePlan !== \"\") subActionType = \"ConfirmRatePlanUpdate\";\n\n  const actionConfig = ACTION_TOKEN_CONFIG.get(actionType);\n  if (actionConfig?.includeContextOnly) {\n    returnObj = {\n      action: actionConfig.returnAction,\n      subaction: actionConfig.returnSubaction,\n      id: quoteId,\n      tid: transactionId,\n      context: {\n        actualAction: actionType,\n        ...actionContext,\n      },\n    };\n\n    return returnObj;\n  }\n\n  returnObj = {\n    action: actionType,\n    subaction: LABEL_TO_SUBACTION.get(actionType) || subActionType,\n    id: quoteId,\n    tid: transactionId,\n    documentNumber: documentNumber,\n    requestedRatePlan: requestedRatePlan,\n    message: `Get me the details of quote: ${transactionId}`,\n  };\n}\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1769546480246"
          },
          "code": "GET_THE_ACTION_DETAILS",
          "id": "1767687856600",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Form init query param",
            "returnType": "string",
            "sourceCode": "let result = \"\";\nconst accountPartyId=$context.$nodes.RETURN_BUSINESS_UNIT_ID.$output.result.AccountPartyId;\ntry {\n  // Get current date from system variable\n  const today = $context.$system?.$currentDate;\n\n  // Parse the current date string to Date object\n  const todayDate = new Date(today);\n\n  // Add 3 days to current date\n  const endDate = new Date(todayDate);\n  endDate.setDate(endDate.getDate() + 3);\n\n  // Format date to ISO string\n  const fmt = d => d.toISOString();\n\n  // Build query string with $gte and $lt conditions and additional filters\n  const q = encodeURI(`{\"$and\":[{priceExpirationDate_t:{$gte:'${fmt(todayDate)}'}},{priceExpirationDate_t:{$lt:'${fmt(endDate)}'}},{_s_customerStatus_t:{\"$eq\":\"acceptance\"}},{_s_assignedTo_t:{\"$eq\":\"BUYER\"}},{_s_transactionSource_t:{\"$eq\":\"sellerInitiated\"}},{_customer_id:{\"$eq\":'${accountPartyId}'}},{_s_isPublished_t:{\"$eq\":true}}]}`);\n\n  result = q;\n} catch (error) {\n  result = \"\"; // Return empty string on error\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772629391969"
          },
          "code": "FORM_INIT_QUERY_PARAM",
          "id": "1773871493471",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
