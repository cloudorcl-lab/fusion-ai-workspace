        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Prepare Address Object",
            "returnType": "object",
            "sourceCode": "const actionDetails = $context.$nodes.GET_THE_ACTION_DETAILS.$output.result;\nconst defaultData = $context.$nodes.GET_DEFAULT_CUSTOMER_DATA.$output;\nlet data = $context.$nodes.GET_SHIPPING_METHODS.$output;\nlet result = {};\nlet shipMethods = [];\nlet selectedShippingMethod = null;\nlet selectedShippingAddress = null;\nlet selectedBillingAddress = null;\n\nconst selectedContext = actionDetails?.context || {};\nconst selectedShippingAddressId = selectedContext.shippingAddressId;\nconst selectedBillingAddressId = selectedContext.billingAddressId;\nconst selectedShippingMethodId = selectedContext.ShippingMethodId;\n\nfor (let i = 0; i < data.items.length; i++) {\n  const shipMethod = data.items[i];\n  let entry = {};\n  entry.value = shipMethod.ShippingCarrierId + \"~~\" + shipMethod.ShippingModeCode + \"~~\" + shipMethod.ShippingServiceLevelCode;\n  entry.label = shipMethod.ShippingMethodName;\n  if (selectedShippingMethodId && shipMethod.ShippingCarrierId == selectedShippingMethodId) {\n    entry.selected = true;\n    selectedShippingMethod = shipMethod;\n  }\n  shipMethods.push(entry);\n}\n\nlet shippingAddresses = [];\ndata = $context.$nodes.GET_SHIPPING_ADDRESSES.$output;\nfor (let i = 0; i < data.items.length; i++) {\n  const address = data.items[i];\n  let entry = {};\n  entry.value = address.PartySiteId;\n  entry.label = address.FormattedAddress;\n  if (address.PartySiteId == defaultData.ShipToPartySiteId) {\n    entry.default = true;\n    entry.label = address.FormattedAddress + \" (default)\";\n  }\n  if (selectedShippingAddressId && address.PartySiteId == selectedShippingAddressId) {\n    entry.selected = true;\n    selectedShippingAddress = address;\n  }\n  shippingAddresses.push(entry);\n}\n\nlet billingAddresses = [];\ndata = $context.$nodes.GET_BILLING_ADDRESSES.$output;\nfor (let i = 0; i < data.items.length; i++) {\n  const address = data.items[i];\n  let entry = {};\n  entry.value = address.BillToSiteId;\n  entry.label = address.FormattedAddress;\n  if (address.BillToSiteId == defaultData.BillToAccountSiteId) {\n    entry.default = true;\n    entry.label = address.FormattedAddress + \" (default)\";\n  }\n  if (selectedBillingAddressId && address.BillToSiteId == selectedBillingAddressId) {\n    entry.selected = true;\n    selectedBillingAddress = address;\n  }\n  billingAddresses.push(entry);\n}\n\nresult.shippingMethods = shipMethods;\nresult.shippingAddresses = shippingAddresses;\nresult.billingAddresses = billingAddresses;\nresult.selectedShippingMethod = selectedShippingMethod;\nresult.selectedShippingAddress = selectedShippingAddress;\nresult.selectedBillingAddress = selectedBillingAddress;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774952181069"
          },
