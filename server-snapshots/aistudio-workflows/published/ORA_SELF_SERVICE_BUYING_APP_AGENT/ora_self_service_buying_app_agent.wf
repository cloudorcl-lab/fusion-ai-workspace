        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Should Check Chat History",
            "returnType": "boolean",
            "sourceCode": "const llmOutput = $context.$nodes.QUOTE_ID_DETERMINATION.$output;\nconst vectorQuoteId = $context.$nodes.GET_QUOTE_ID.$output[0]?.text;\n\nconst shouldProceed =\n  llmOutput.has_quote_id === false &&\n  (!vectorQuoteId || vectorQuoteId.trim() === \"\");\n\nreturn shouldProceed;"
          },
          "outcomes": {
            "success": "1775152135654"
          },
          "code": "TRANSFORM_INPUT",
          "id": "1775151253124",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Child Transaction Line Items Metadata",
            "returnType": "object",
            "sourceCode": "const transformed = $context.$nodes.TRANSFORM_TRANSACTION_LINES.$output.result || {};\nconst transaction = transformed?.transaction || {};\nconst parentLine = transformed?.parentTransactionLine || null;\nconst items = Array.isArray(transformed?.ChildTransactionLines)\n  ? transformed.ChildTransactionLines\n  : [];\n\nconst statusValue = transaction?._s_customerStatus_t?.value;\nconst showMaskedValues =\n  statusValue === 'solutionDiscovery' || statusValue === 'negotiation';\n\nconst baseColumns = [\n  {\n    key: 'product',\n    title: 'Product',\n    cellType: 'string',\n  },\n  {\n    key: 'itemDescription',\n    title: 'Item Description',\n    cellType: 'string',\n  },\n  {\n    key: 'quantity',\n    title: 'Quantity',\n    cellType: 'string',\n  },\n  {\n    key: 'listPricePerUnit',\n    title: 'List Price Per Unit',\n    cellType: 'string',\n  },\n  {\n    key: 'discount',\n    title: 'Discount',\n    cellType: 'string',\n  },\n  {\n    key: 'netPricePerUnit',\n    title: 'Net Price Per Unit',\n    cellType: 'string',\n  },\n  {\n    key: 'netPriceAmount',\n    title: 'Net Price Amount',\n    cellType: 'string',\n  },\n];\n\nconst createBadgeCell = (text, priority = 'medium') => {\n  if (typeof text !== 'string' || !text.trim()) return '';\n\n  return {\n    type: 'badge',\n    text,\n    priority,\n  };\n};\n\nconst formatNumber = (value) => {\n  if (typeof value !== 'number' || !Number.isFinite(value)) return '';\n\n  const rounded = Math.round((value + Number.EPSILON) * 100) / 100;\n\n  return rounded.toLocaleString(undefined, {\n    minimumFractionDigits: Number.isInteger(rounded) ? 0 : 2,\n    maximumFractionDigits: 2,\n  });\n};\n\nconst formatMoney = (money) => {\n  if (!money || typeof money.value !== 'number' || !Number.isFinite(money.value)) {\n    return '';\n  }\n\n  const amount = formatNumber(money.value);\n  if (!amount) return '';\n\n  if (!money.currency || typeof money.currency !== 'string' || !money.currency.trim()) {\n    return amount;\n  }\n\n  return `${money.currency} ${amount}`;\n};\n\nconst formatDiscount = (value) => {\n  if (typeof value !== 'number' || !Number.isFinite(value)) return '';\n  return value === 0 ? '0' : `${formatNumber(value)}%`;\n};\n\nconst buildCharges = (item) => {\n  const charges = item?._chargeSet?.items;\n  if (!Array.isArray(charges) || charges.length === 0) return '';\n\n  return charges\n    .map((charge) => {\n      const chargeDefinition = charge?._chargeSet_chargeDefinition ?? '';\n      const priceType = charge?._chargeSet_priceType?.displayValue ?? '';\n      const netPrice = formatMoney(charge?._chargeSet_netPrice);\n      const pricePeriod = charge?._chargeSet_pricePeriod?.displayValue ?? '';\n\n      return `${chargeDefinition}: ${priceType} - ${netPrice} ${pricePeriod}`.trim();\n    })\n    .join('\\n');\n};\n\nconst buildRowAction = (item) => {\n  const isSubscription = item?._part_sales_product_type === 'SUBSCRIPTION';\n  const documentNumber = item?.documentNumber_l;\n\n  if (\n    !isSubscription ||\n    !item?._price_applied_ratePlan ||\n    typeof documentNumber !== 'string' ||\n    !documentNumber.trim()\n  ) {\n    return null;\n  }\n\n  return {\n    text: 'Update Rate Plan',\n    actionKey: 'Update Rate Plan',\n    actionData: {\n      documentNumber,\n    },\n  };\n};\n\nconst hasRatePlan = items.some(\n  (item) => item?._part_sales_product_type === 'SUBSCRIPTION' && item?._price_applied_ratePlan\n);\n\nconst hasCharges = items.some(\n  (item) => Array.isArray(item?._chargeSet?.items) && item._chargeSet.items.length > 0\n);\n\nconst rows = items.map((item) => {\n  const hasChildren = item?._state?.queryState?.numOfAllDirectChildren || 0;\n\n  const row = {\n    product: item?._part_display_number ?? '',\n    itemDescription: item?._part_desc ?? '',\n    quantity: item?._price_quantity != null ? formatNumber(item._price_quantity) : '',\n    listPricePerUnit: showMaskedValues ? '--' : formatMoney(item?.listPrice_l),\n    discount: showMaskedValues ? '--' : formatDiscount(item?.discountPercent_l),\n    netPricePerUnit: showMaskedValues ? '--' : formatMoney(item?.netPrice_l),\n    netPriceAmount: showMaskedValues ? '--' : formatMoney(item?.netAmount_l),\n  };\n\n  if (!showMaskedValues) {\n    if (hasRatePlan) {\n      row.ratePlan =\n        item?._part_sales_product_type === 'SUBSCRIPTION' &&\n        typeof item?._price_applied_ratePlan === 'string'\n          ? item._price_applied_ratePlan\n          : '';\n\n      row.ratePlanCell = createBadgeCell(row.ratePlan, 'medium');\n    }\n\n    if (hasCharges) {\n      row.charges = buildCharges(item);\n    }\n\n    if (hasChildren) {\n      const documentNumber = item?.documentNumber_l;\n      const transactionId = transaction?.transactionID_t || '';\n      const quoteId = transaction?.bs_id || transaction?._id || '';\n\n      if (documentNumber !== undefined && documentNumber !== null && String(documentNumber).trim()) {\n        row.drillDownAction = `ora.Invoke(\"selfservice360\", \"View Child Lines~~${transactionId}~~${quoteId}~~${String(documentNumber)}\")`;\n      }\n    }\n\n    const rowAction = buildRowAction(item);\n    if (rowAction) {\n      row.rowAction = rowAction;\n    }\n  }\n\n  return row;\n});\n\nconst columns = [...baseColumns];\n\nif (rows.some((row) => typeof row?.ratePlan === 'string' && row.ratePlan.trim())) {\n  columns.push({\n    key: 'ratePlan',\n    title: 'Rate Plan',\n    cellType: 'prebuilt',\n    valueKey: 'ratePlanCell',\n  });\n}\n\nif (rows.some((row) => typeof row?.charges === 'string' && row.charges.trim())) {\n  columns.push({\n    key: 'charges',\n    title: 'Charges',\n    cellType: 'string',\n  });\n}\n\nreturn {\n  parentLine,\n  columns,\n  rows,\n};"
          },
          "outcomes": {
            "success": "1776773262759"
          },
          "code": "CHILD_TRANSACTION_LINE_ITEMS_METADATA",
          "id": "1776773077212",
          "inputs": [],
