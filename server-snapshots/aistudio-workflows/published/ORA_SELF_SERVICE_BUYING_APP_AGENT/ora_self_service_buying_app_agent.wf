        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Extract Line Item Info",
            "returnType": "array",
            "sourceCode": "const quoteDetails = $context.$nodes.FETCH_QUOTE_DETAILS.$output;\nconst items = quoteDetails?.documents?.transactionLine?.items ?? [];\nvar lineItemsInfo = [];\n\nfor (let i = 0; i < items.length; i++) {\n  var data = {};\n\n  data.itemId = items[i]._fusion_part_id || items[i]._part_id;\n  data.itemNumber = items[i]._part_number;\n  data.quantity = items[i]._price_quantity;\n\n  // do not hardcode unless you must\n  data.orgCode = items[i].fulfillmentOrganizationCode_l || items[i].oRCL_SFA_InventoryOrgID_l || \"V1\";\n\n  // useful for LineQuantityUOMCode\n  data.uomCode = items[i].requestedUnitOfMeasure_l?.value || items[i]._part_default_uom || \"Ea\";\n\n  lineItemsInfo[i] = data;\n}\n\nreturn lineItemsInfo;"
          },
          "outcomes": {
            "success": "1774956437864"
          },
          "code": "EXTRACT_LINE_ITEM_INFO",
          "id": "1774956300669",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ResponseRouter"
