          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Update Quote ID Determination",
            "returnType": "object",
            "sourceCode": "const llmOutput = $context.$nodes.QUOTE_ID_DETERMINATION.$output;\n\nif (llmOutput.has_quote_id === true && llmOutput.quote_id) {\n  return {\n    action: \"SET\",\n    quote_id: llmOutput.quote_id\n  };\n}\n\nif (llmOutput.intent === \"QuoteListing\") {\n  return {\n    action: \"CLEAR\",\n    quote_id: null\n  };\n}\n\nreturn {\n  action: \"KEEP\",\n  quote_id: null\n};"
          },
          "outcomes": {
            "success": "1775153028731"
          },
          "code": "UPDATE_QUOTE_ID_DETERMINATION",
          "id": "1775152823344",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
