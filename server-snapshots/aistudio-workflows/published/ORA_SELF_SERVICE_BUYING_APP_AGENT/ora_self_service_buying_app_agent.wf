            "sourceCode": "const quoteContext =\n  $context.$nodes.GET_THE_ACTION_DETAILS.$output.result || {};\nconst { documentNumber, requestedRatePlan } = quoteContext;\n\nconst payload = {\n  transactionLine: {\n    items: [\n      {\n        _document_number: documentNumber\n      }\n    ]\n  }\n};\n\nreturn payload;"
