            "sourceCode": "let chunkText = $context.$nodes.FETCH_SELFSERVICE_QUOTE_CONFIGURATIONS.$output?.citations?.[0]?.citedText;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(chunkText);\n} catch (e) {\n  parsed = null;\n}\n\nconst defaultValue = {\n  \"mainDocVarName\": \"commerceDocumentsOraclecpqoTransaction\",\n  \"processVarName\": \"oraclecpqo\",\n  \"docVarName\": \"docVarName\",\n  \"attributeVarName\": \"changeReason_l\"\n};\n\nif (\n  parsed &&\n  typeof parsed === \"object\" &&\n  Object.keys(parsed).length > 0\n) {\n  return parsed;\n}\n\nreturn defaultValue;"
