        {
          "metadata": {
            "businessObjectCode": "ORA_CX_CPQCOMMERC_MODIFYQUOTE",
            "errorNodeId": "1768190969668",
            "functionName": "AssignQuoteToSeller",
            "processJson": true,
            "name": "Request  Changes"
          },
          "outcomes": {
            "success": "1772609646420"
          },
          "code": "REQUEST_CHANGES",
          "convergenceTargetId": "1773732287735",
          "id": "1773327326039",
          "inputs": [
            {
