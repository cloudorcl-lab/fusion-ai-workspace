          "code": "UPDATE_RATEPLAN_PROMPT_EXTRACTOR",
          "id": "1773314247855",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Determine Quote Actions",
            "returnType": "array",
            "sourceCode": "const quoteDetails = $context.$nodes.GET_QUOTE_DETAILS.$output;\nconst actionDetails = $context.$nodes.GET_THE_ACTION_DETAILS.$output;\n\nconst documents = quoteDetails && quoteDetails.documents ? quoteDetails.documents : null;\nconst accessItems =\n  documents &&\n    documents._s_checkoutAccessEnabled_t &&\n    Array.isArray(documents._s_checkoutAccessEnabled_t.items)\n    ? documents._s_checkoutAccessEnabled_t.items\n    : [];\n\nconst selfCheckoutEnabled = accessItems.some(\n  item => item && item.value === \"SELF_SERVICE_CHECKOUT\"\n);\n\nconst salesRepCheckoutEnabled = accessItems.some(\n  item => item && item.value === \"SALES_REP_CHECKOUT\"\n);\n\nconst assignedToBuyer =\n  !!documents &&\n  !!documents._s_assignedTo_t &&\n  documents._s_assignedTo_t.value === \"BUYER\";\n\nconst inAcceptancePhase =\n  !!documents &&\n  !!documents._s_customerStatus_t &&\n  documents._s_customerStatus_t.value === \"acceptance\";\n\nconst canDownloadProposal =\n  !!documents &&\n  !!documents.fileAttachment_t &&\n  documents.fileAttachment_t.isFileSaved === true &&\n  typeof documents.fileAttachment_t.fileLocation === \"string\" &&\n  documents.fileAttachment_t.fileLocation !== \"\";\n\nconst priceExpirationDate =\n  !!documents && typeof documents.priceExpirationDate_t === \"string\"\n    ? documents.priceExpirationDate_t\n    : \"\";\n\nconst isQuoteExpired =\n  priceExpirationDate !== \"\" &&\n  !Number.isNaN(Date.parse(priceExpirationDate)) &&\n  Date.parse(priceExpirationDate) < Date.now();\n\nconst id =\n  actionDetails &&\n    actionDetails.result &&\n    actionDetails.result.id != null &&\n    String(actionDetails.result.id) !== \"\"\n    ? String(actionDetails.result.id)\n    : \"\";\n\nconst tid =\n  actionDetails &&\n    actionDetails.result &&\n    actionDetails.result.tid != null &&\n    String(actionDetails.result.tid) !== \"\"\n    ? String(actionDetails.result.tid)\n    : \"\";\n\nconst getCommandForAction = label =>\n  label === \"Accept\"\n    ? \"selfservice360refresh\"\n    : \"selfservice360\";\n\nconst actions =\n  id === \"\" || tid === \"\" || isQuoteExpired === true\n    ? []\n    : [\n      ...(canDownloadProposal ? [\"Download Proposal\"] : []),\n      ...(assignedToBuyer === true && inAcceptancePhase === true\n        ? [\"Request changes\", \"Reject\"]\n        : []),\n      ...(\n        assignedToBuyer === true &&\n        inAcceptancePhase === true &&\n        selfCheckoutEnabled === true\n          ? [\"Accept\"]\n          : []\n      ),\n      ...(\n        assignedToBuyer === true &&\n        inAcceptancePhase === true &&\n        (!selfCheckoutEnabled && salesRepCheckoutEnabled)\n          ? [\"Accept\"]\n          : []\n      )\n    ].map(label => ({\n      label,\n      command: getCommandForAction(label)\n    }));\n\nreturn actions;"
          },
          "outcomes": {
            "success": "1775149440786"
          },
          "code": "DETERMINE_QUOTE_ACTIONS",
          "convergenceTargetId": "1773730179813",
          "id": "1773304308240",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Input Payload",
            "returnType": "object",
            "sourceCode": "const pricingStrategy = $context.$nodes.GET_SALES_PRICING_STRATEGY.$output?.Header?.[0];\nconst addressObject = $context.$nodes.PREPARE_ADDRESS_OBJECT.$output.result;\n\nconst HEADER = pricingStrategy\n  ? [{\n      ...pricingStrategy,\n      SellingLegalEntityId: pricingStrategy?.SellingBusinessUnitId\n    }]\n  : [];\n\nlet LINES = [];\nconst itemsData = $context.$nodes.EXTRACT_LINE_ITEM_INFO.$output.result;\n\nfor (let i = 0; i < itemsData.length; i++) {\n  var item = {\n    AllowPriceListUpdateFlag: true,\n    ShipMethodId: addressObject?.selectedShippingMethod?.ShippingMethodId,\n    ShipToLocationId: 1222,\n    HeaderId: 1,\n    LineId: i + 1,\n    LineQuantity: {\n      Value: itemsData[i].quantity,\n      UomCode: itemsData[i].uomCode || \"Ea\"\n    },\n    LineTypeCode: \"ORA_BUY\",\n    LineCategoryCode: \"ORDER\",\n    LineQuantityUOMCode: itemsData[i].uomCode || \"Ea\",\n    TaxClassificationCode: \"VAT20\",\n    InventoryItemNumber: itemsData[i].itemNumber,\n    InventoryOrganizationCode: itemsData[i].orgCode\n  };\n\n  LINES[i] = item;\n}\n\nreturn {\n  PricingServiceParameter: {\n    PricingContext: \"SALES\",\n    PerformValueIdConversionsFlag: true\n  },\n  Header: HEADER,\n  Line: LINES\n};"
          },
          "outcomes": {
            "success": "1774961365978"
          },
