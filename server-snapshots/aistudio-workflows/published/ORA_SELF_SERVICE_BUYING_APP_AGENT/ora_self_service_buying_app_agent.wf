          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Get Document Object",
            "returnType": "object",
            "sourceCode": "const transactionResponse = $context.$nodes.FETCH_QUOTE_DETAILS.$output ?? null;\n\nconst previewResponse = $context?.$nodes?.FETCH_SHIPPING_AND_TAX?.$output ?? null;\n\nconst toArray = (value) => (Array.isArray(value) ? value : []);\n\nconst toNumber = (value) => {\n  const numericValue = Number(value ?? 0);\n  return Number.isFinite(numericValue) ? numericValue : 0;\n};\n\nconst roundCurrency = (value) => Math.round((toNumber(value) + Number.EPSILON) * 100) / 100;\n\nconst buildMoney = (value, currency) => ({\n  value: roundCurrency(value),\n  currency: currency || \"USD\",\n});\n\nconst getCurrencyCode = (previewHeader, transactionDocuments, transactionLine) =>\n  previewHeader?.AppliedCurrencyCode ??\n  previewHeader?.DefaultCurrencyCode ??\n  transactionDocuments?.currency_t?.value ??\n  transactionDocuments?.currency_t?.displayValue ??\n  transactionLine?.netAmount_l?.currency ??\n  transactionLine?.listAmount_l?.currency ??\n  \"USD\";\n\nconst getExtendedAmount = (component) =>\n  component?.HeaderCurrencyExtendedAmount?.Value ??\n  component?.ExtendedAmount?.Value ??\n  component?.HeaderCurrencyExtendedAmount?.value ??\n  component?.ExtendedAmount?.value ??\n  0;\n\nconst getUnitAmount = (component) =>\n  component?.HeaderCurrencyUnitPrice?.Value ??\n  component?.UnitPrice?.Value ??\n  component?.HeaderCurrencyUnitPrice?.value ??\n  component?.UnitPrice?.value ??\n  0;\n\nconst getTaxableAmount = (taxDetail) =>\n  taxDetail?.HeaderCurrencyTaxableAmount?.Value ??\n  taxDetail?.TaxableAmount?.Value ??\n  taxDetail?.HeaderCurrencyTaxableAmount?.value ??\n  taxDetail?.TaxableAmount?.value ??\n  0;\n\nconst getTaxAmount = (taxDetail) =>\n  taxDetail?.HeaderCurrencyTaxAmount?.Value ??\n  taxDetail?.TaxAmount?.Value ??\n  taxDetail?.HeaderCurrencyTaxAmount?.value ??\n  taxDetail?.TaxAmount?.value ??\n  0;\n\nconst sumAmounts = (items, selector) =>\n  roundCurrency(toArray(items).reduce((total, item) => total + toNumber(selector(item)), 0));\n\nconst normalizeUsageCode = (component) => {\n  if (component?.PriceElementUsageCode) {\n    return component.PriceElementUsageCode;\n  }\n\n  if (component?.PriceElementCode === \"QP_EXCLUSIVE_TAX\") {\n    return \"EXCLUSIVE_TAX\";\n  }\n\n  if (component?.PriceElementCode === \"QP_NET_PRICE_PLUS_TAX\") {\n    return \"NET_PRICE_PLUS_TAX\";\n  }\n\n  if (component?.PriceElementCode === \"QP_NET_PRICE\") {\n    return \"NET_PRICE\";\n  }\n\n  if (component?.PriceElementCode === \"QP_LIST_PRICE\") {\n    return \"LIST_PRICE\";\n  }\n\n  return component?.PriceElementCode ?? null;\n};\n\nconst isShippingCharge = (charge) =>\n  charge?.ChargeAppliesTo === \"SHIPPING\" || String(charge?.ChargeTypeCode ?? \"\").includes(\"SHIPPING\");\n\nconst buildComponentsByChargeId = (components) =>\n  toArray(components).reduce((accumulator, component) => {\n    const chargeId = component?.ChargeId;\n\n    if (chargeId === null || chargeId === undefined) {\n      return accumulator;\n    }\n\n    if (!accumulator[chargeId]) {\n      accumulator[chargeId] = [];\n    }\n\n    accumulator[chargeId].push(component);\n    return accumulator;\n  }, {});\n\nconst buildChargesByLineId = (charges) =>\n  toArray(charges).reduce((accumulator, charge) => {\n    const lineId = charge?.LineId ?? charge?.ParentEntityId;\n\n    if (lineId === null || lineId === undefined) {\n      return accumulator;\n    }\n\n    if (!accumulator[lineId]) {\n      accumulator[lineId] = [];\n    }\n\n    accumulator[lineId].push(charge);\n    return accumulator;\n  }, {});\n\nconst buildTaxDetailsByComponentId = (taxLineDetails) =>\n  toArray(taxLineDetails).reduce((accumulator, taxLineDetail) => {\n    const chargeComponentId = taxLineDetail?.ChargeComponentId;\n\n    if (chargeComponentId === null || chargeComponentId === undefined) {\n      return accumulator;\n    }\n\n    if (!accumulator[chargeComponentId]) {\n      accumulator[chargeComponentId] = [];\n    }\n\n    accumulator[chargeComponentId].push(taxLineDetail);\n    return accumulator;\n  }, {});\n\nconst buildChargeMetrics = (charges, componentsByChargeId) => {\n  const chargeComponents = toArray(charges).flatMap((charge) => toArray(componentsByChargeId[charge?.ChargeId]));\n  const netPriceComponents = chargeComponents.filter((component) => normalizeUsageCode(component) === \"NET_PRICE\");\n  const exclusiveTaxComponents = chargeComponents.filter((component) => normalizeUsageCode(component) === \"EXCLUSIVE_TAX\");\n  const totalWithTaxComponents = chargeComponents.filter((component) => normalizeUsageCode(component) === \"NET_PRICE_PLUS_TAX\");\n\n  const totalAmountMinusTax = sumAmounts(netPriceComponents, getExtendedAmount);\n  const totalPriceMinusTax = sumAmounts(netPriceComponents, getUnitAmount);\n  const taxAmountTotal = sumAmounts(exclusiveTaxComponents, getExtendedAmount);\n  const taxPrice = sumAmounts(exclusiveTaxComponents, getUnitAmount);\n  const totalAmount = totalWithTaxComponents.length\n    ? sumAmounts(totalWithTaxComponents, getExtendedAmount)\n    : roundCurrency(totalAmountMinusTax + taxAmountTotal);\n  const totalPrice = totalWithTaxComponents.length\n    ? sumAmounts(totalWithTaxComponents, getUnitAmount)\n    : roundCurrency(totalPriceMinusTax + taxPrice);\n\n  return {\n    totalAmountMinusTax,\n    totalPriceMinusTax,\n    taxAmountTotal,\n    taxPrice,\n    totalAmount,\n    totalPrice,\n  };\n};\n\nconst buildTaxBreakdown = (charges, componentsByChargeId, taxDetailsByComponentId) =>\n  toArray(charges).flatMap((charge) => {\n    const chargeComponents = toArray(componentsByChargeId[charge?.ChargeId]);\n    const netPriceComponents = chargeComponents.filter((component) => normalizeUsageCode(component) === \"NET_PRICE\");\n    const totalWithTaxComponents = chargeComponents.filter((component) => normalizeUsageCode(component) === \"NET_PRICE_PLUS_TAX\");\n\n    return chargeComponents\n      .filter((component) => normalizeUsageCode(component) === \"EXCLUSIVE_TAX\")\n      .map((component) => {\n        const taxDetails = toArray(taxDetailsByComponentId[component?.ChargeComponentId]);\n        const firstTaxDetail = taxDetails[0] ?? {};\n        const unitTaxAmount = taxDetails.length ? sumAmounts(taxDetails, getTaxAmount) : roundCurrency(getUnitAmount(component));\n        const unitTaxableAmount = taxDetails.length ? sumAmounts(taxDetails, getTaxableAmount) : sumAmounts(netPriceComponents, getUnitAmount);\n\n        return {\n          chargeId: charge?.ChargeId ?? null,\n          chargeComponentId: component?.ChargeComponentId ?? null,\n          chargeTypeCode: charge?.ChargeTypeCode ?? null,\n          chargeAppliesTo: charge?.ChargeAppliesTo ?? null,\n          chargeDefinitionCode: charge?.ChargeDefinitionCode ?? null,\n          priceElementCode: component?.PriceElementCode ?? null,\n          priceElementUsageCode: normalizeUsageCode(component),\n          taxRateCode: firstTaxDetail?.TaxRateCode ?? firstTaxDetail?.TaxRateName ?? null,\n          taxRateName: firstTaxDetail?.TaxRateName ?? null,\n          taxRate: toNumber(firstTaxDetail?.TaxRate),\n          taxJurisdictionCode: firstTaxDetail?.TaxJurisdictionCode ?? null,\n          taxJurisdictionName: firstTaxDetail?.TaxJurisdictionName ?? null,\n          taxRegimeCode: firstTaxDetail?.TaxRegimeCode ?? null,\n          taxStatusCode: firstTaxDetail?.TaxStatusCode ?? null,\n          taxAmountInclusiveFlag: Boolean(\n            firstTaxDetail?.TaxAmountInclusiveFlag ?? component?.TaxIncludedFlag ?? charge?.TaxIncludedFlag,\n          ),\n          taxableAmount: unitTaxableAmount,\n          taxableAmountTotal: sumAmounts(netPriceComponents, getExtendedAmount),\n          taxAmount: unitTaxAmount,\n          taxAmountTotal: roundCurrency(getExtendedAmount(component)),\n          totalAmount: totalWithTaxComponents.length ? sumAmounts(totalWithTaxComponents, getUnitAmount) : null,\n          totalAmountTotal: totalWithTaxComponents.length ? sumAmounts(totalWithTaxComponents, getExtendedAmount) : null,\n          explanation: component?.Explanation ?? null,\n        };\n      });\n  });\n\nconst buildPreviewLineSummaries = (previewData, transactionDocuments) => {\n  const previewHeader = toArray(previewData?.Header)[0] ?? {};\n  const previewLines = toArray(previewData?.Line);\n  const chargesByLineId = buildChargesByLineId(previewData?.Charge);\n  const componentsByChargeId = buildComponentsByChargeId(previewData?.ChargeComponent);\n  const taxDetailsByComponentId = buildTaxDetailsByComponentId(previewData?.TaxLineDetail);\n  const pricingServiceParameter = toArray(previewData?.PricingServiceParameter)[0] ?? {};\n\n  return previewLines.map((previewLine) => {\n    const currencyCode = getCurrencyCode(previewHeader, transactionDocuments, null);\n    const lineCharges = toArray(chargesByLineId[previewLine?.LineId]);\n    const productCharges = lineCharges.filter((charge) => !isShippingCharge(charge));\n    const shippingCharges = lineCharges.filter((charge) => isShippingCharge(charge));\n    const productMetrics = buildChargeMetrics(productCharges, componentsByChargeId);\n    const shippingMetrics = buildChargeMetrics(shippingCharges, componentsByChargeId);\n    const taxBreakdown = buildTaxBreakdown(lineCharges, componentsByChargeId, taxDetailsByComponentId);\n    const totalTaxAmount = roundCurrency(productMetrics.taxAmountTotal + shippingMetrics.taxAmountTotal);\n\n    return {\n      previewLineId: previewLine?.LineId ?? null,\n      inventoryItemNumber: previewLine?.InventoryItemNumber ?? null,\n      inventoryItemId: previewLine?.InventoryItemId ?? null,\n      quantity: toNumber(previewLine?.LineQuantity?.Value),\n      currencyCode,\n      productMetrics,\n      shippingMetrics,\n      taxCalculationInfo: JSON.stringify({\n        pricingContext: pricingServiceParameter?.PricingContext ?? null,\n        lineId: previewLine?.LineId ?? null,\n        inventoryItemNumber: previewLine?.InventoryItemNumber ?? null,\n        inventoryItemId: previewLine?.InventoryItemId ?? null,\n        taxClassificationCode: previewLine?.TaxClassificationCode ?? null,\n        currencyCode,\n        totals: {\n          lineAmountExcludingTax: productMetrics.totalAmountMinusTax,\n          lineTaxAmount: productMetrics.taxAmountTotal,\n          lineAmountIncludingTax: productMetrics.totalAmount,\n          shippingAmountExcludingTax: shippingMetrics.totalAmountMinusTax,\n          shippingTaxAmount: shippingMetrics.taxAmountTotal,\n          shippingAmountIncludingTax: shippingMetrics.totalAmount,\n          totalTaxAmount,\n        },\n        breakdown: taxBreakdown,\n      }),\n    };\n  });\n};\n\nconst matchesPreviewLine = (transactionLine, previewLineSummary) => {\n  const transactionItemNumber = transactionLine?._part_number ?? transactionLine?._part_display_number ?? null;\n  const previewItemNumber = previewLineSummary?.inventoryItemNumber ?? null;\n  const transactionQuantity = toNumber(transactionLine?._price_quantity);\n  const previewQuantity = toNumber(previewLineSummary?.quantity);\n  const itemNumberMatches =\n    transactionItemNumber && previewItemNumber ? transactionItemNumber === previewItemNumber : true;\n  const quantityMatches =\n    transactionQuantity > 0 && previewQuantity > 0 ? transactionQuantity === previewQuantity : true;\n\n  return itemNumberMatches && quantityMatches;\n};\n\nconst findMatchingTransactionLineIndex = (transactionLines, previewLineSummary, previewIndex, usedIndexes) => {\n  const candidateIndexes = [\n    toNumber(previewLineSummary?.previewLineId),\n    toNumber(previewLineSummary?.previewLineId) - 1,\n    toNumber(previewIndex),\n  ].filter((index, position, array) => index >= 0 && array.indexOf(index) === position);\n\n  for (let i = 0; i < candidateIndexes.length; i += 1) {\n    const candidateIndex = candidateIndexes[i];\n    const transactionLine = transactionLines[candidateIndex];\n\n    if (transactionLine && !usedIndexes.has(candidateIndex) && matchesPreviewLine(transactionLine, previewLineSummary)) {\n      return candidateIndex;\n    }\n  }\n\n  for (let i = 0; i < transactionLines.length; i += 1) {\n    if (!usedIndexes.has(i) && matchesPreviewLine(transactionLines[i], previewLineSummary)) {\n      return i;\n    }\n  }\n\n  for (let i = 0; i < transactionLines.length; i += 1) {\n    if (!usedIndexes.has(i)) {\n      return i;\n    }\n  }\n\n  return -1;\n};\n\nconst buildTransactionLineUpdate = (transactionLine, previewLineSummary, transactionDocuments) => {\n  const currencyCode = getCurrencyCode(null, transactionDocuments, transactionLine) || previewLineSummary?.currencyCode;\n\n  return {\n    _document_number: transactionLine?._document_number ?? transactionLine?.documentNumber_l ?? null,\n    _tax_calculation_info: previewLineSummary?.taxCalculationInfo ?? JSON.stringify({ breakdown: [], totals: {} }),\n    _tax_taxPrice_l: buildMoney(previewLineSummary?.productMetrics?.taxPrice, currencyCode),\n    _tax_totalAmount_l: buildMoney(previewLineSummary?.productMetrics?.totalAmount, currencyCode),\n    _tax_totalPrice_l: buildMoney(previewLineSummary?.productMetrics?.totalPrice, currencyCode),\n    _tax_totalAmountMinusTax_l: buildMoney(previewLineSummary?.productMetrics?.totalAmountMinusTax, currencyCode),\n    _tax_totalPriceMinusTax_l: buildMoney(previewLineSummary?.productMetrics?.totalPriceMinusTax, currencyCode),\n    totalShippingCost_l: buildMoney(previewLineSummary?.shippingMetrics?.totalAmount, currencyCode),\n  };\n};\n\nconst buildUpdateLineItemsPayload = (transactionData, previewData) => {\n  const transactionDocuments = transactionData?.documents ?? {};\n  const transactionLines = toArray(transactionDocuments?.transactionLine?.items);\n  const previewLineSummaries = buildPreviewLineSummaries(previewData, transactionDocuments);\n  const usedIndexes = new Set();\n\n  const updatedLineItems = previewLineSummaries\n    .map((previewLineSummary, previewIndex) => {\n      const transactionLineIndex = findMatchingTransactionLineIndex(\n        transactionLines,\n        previewLineSummary,\n        previewIndex,\n        usedIndexes,\n      );\n\n      if (transactionLineIndex < 0) {\n        return null;\n      }\n\n      usedIndexes.add(transactionLineIndex);\n      return buildTransactionLineUpdate(\n        transactionLines[transactionLineIndex],\n        previewLineSummary,\n        transactionDocuments,\n      );\n    })\n    .filter((line) => line && line._document_number !== null && line._document_number !== undefined);\n\n  const payload = {\n    documents: {\n      //freezePriceFlag_t: true,\n      transactionLine: {\n        items: updatedLineItems,\n      },\n    },\n    freezePrice: true\n  };\n\n  // if (transactionData?.revisionId) {\n  //   payload.revisionId = transactionData.revisionId;\n  // }\n\n  // if (transactionData?.cacheInstanceId) {\n  //   payload.cacheInstanceId = transactionData.cacheInstanceId;\n  // }\n\n  return payload.documents;\n};\n\nreturn buildUpdateLineItemsPayload(transactionResponse, previewResponse);"
          },
