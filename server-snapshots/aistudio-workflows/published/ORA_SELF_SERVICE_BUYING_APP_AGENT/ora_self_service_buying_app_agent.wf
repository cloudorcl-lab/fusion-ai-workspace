        {
          "metadata": {
            "errorNodeId": "1768190969668",
            "name": "Input Message Transformer",
            "returnType": "string",
            "sourceCode": "const inputMessage = $context.$system.$inputMessage;\nconst llmOutput = $context.$nodes.QUOTE_ID_DETERMINATION.$output;\nconst vectorQuoteId = $context.$nodes.GET_QUOTE_ID.$output[0]?.text;\nconst historyQuoteId = $context.$nodes.CHAT_HISTORY_ANALYZER?.$output?.quote_id;\n\nlet result = inputMessage;\n\n\nlet resolvedQuoteId = null;\nif (llmOutput.has_quote_id === true) {\n  return inputMessage;\n}\n\nif (vectorQuoteId && vectorQuoteId.trim() !== \"\") {\n  resolvedQuoteId = vectorQuoteId;\n} else if (historyQuoteId && historyQuoteId.trim() !== \"\") {\n  resolvedQuoteId = historyQuoteId;\n}\n\nif (\n  llmOutput.has_quote_id === false &&\n  llmOutput.intent === \"QuoteEnquiry\" &&\n  resolvedQuoteId\n) {\n  result = \"For the \" + resolvedQuoteId + \" \" + inputMessage;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773858373481"
          },
          "code": "INPUT_MESSAGE_TRANSFORMER",
          "id": "1775152261060",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
