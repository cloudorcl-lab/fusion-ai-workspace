{
  "workflowId": "300000331068170",
  "workflowCode": "ORA_TRANSACTION_FAILURE_ANALYSIS_WORKFLOW",
  "name": "Transaction Failure Analysis Workflow",
  "description": "This agent is used to find the reason behind the failure of transaction and provide the respective issue description and resolution. Use this only when user explicitly asks for the reason for failure of a transaction. Do not use it otherwise.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1762779998137"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Process Failed Transaction Id"
          },
          "outcomes": {
            "success": "1762780290422"
          },
          "code": "PROCESS_FAILED_TRANSACTION_ID",
          "id": "1762779998137",
          "inputs": [
            {
              "id": "1762779998139_1",
              "name": "prompt",
              "type": "string",
              "value": "Take this {{$context.$system.$inputMessage}} as user input. \n\nFrom this identify the transaction Id and return it."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"TransactionIdExtraction\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"TransactionId\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"TransactionId\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_TRANSACTIONFAIL",
            "functionName": "get_issueId_from_transaction_id",
            "name": "Transaction Failure Analysis"
          },
          "outcomes": {
            "success": "1762782755975"
          },
          "code": "TRANSACTION_FAILURE_ANALYSIS",
          "id": "1762780290422",
          "inputs": [
            {
              "id": "1762780347015_1",
              "name": "transactionId",
              "type": "string",
              "value": "{{$context.$nodes.PROCESS_FAILED_TRANSACTION_ID.$output.TransactionId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"CompositeTransactionDetailsResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"response\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"result\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"CompositeDetails\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"ConsoleTransactionId\": { \"type\": \"integer\" },\n                \"ModuleInstanceId\": { \"type\": \"integer\" },\n                \"Ecid\": { \"type\": \"string\" },\n                \"ModuleFlowId\": { \"type\": \"integer\" }\n              },\n              \"required\": [\n                \"ConsoleTransactionId\",\n                \"ModuleInstanceId\",\n                \"Ecid\",\n                \"ModuleFlowId\"\n              ]\n            },\n            \"IssueDetails\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"IssueCSV\": { \"type\": \"string\" }\n              },\n              \"required\": [ \"IssueCSV\" ]\n            },\n            \"TransactionDetails\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"ConsoleTransactionId\": { \"type\": \"integer\" },\n                \"ConsoleTxnStatus\": { \"type\": \"string\" },\n                \"Header\": { \"type\": \"string\" },\n                \"AssignedOn\": { \"type\": \"string\" },\n                \"ObjectId\": { \"type\": \"integer\" },\n                \"Object\": { \"type\": \"string\" },\n                \"ProcessId\": { \"type\": \"integer\" },\n                \"SubjectId\": { \"type\": \"integer\" },\n                \"Subject\": { \"type\": \"string\" }\n              },\n              \"required\": [\n                \"ConsoleTransactionId\",\n                \"ConsoleTxnStatus\",\n                \"Header\",\n                \"AssignedOn\",\n                \"ObjectId\",\n                \"Object\",\n                \"ProcessId\",\n                \"SubjectId\",\n                \"Subject\"\n              ]\n            },\n            \"ArmProcessDetails\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"TaskFileName\": { \"type\": \"string\" },\n                \"RuleFileName\": { \"type\": \"string\" }\n              },\n              \"required\": [\n                \"TaskFileName\",\n                \"RuleFileName\"\n              ]\n            }\n          },\n          \"required\": [\n            \"CompositeDetails\",\n            \"IssueDetails\",\n            \"TransactionDetails\",\n            \"ArmProcessDetails\"\n          ]\n        }\n      },\n      \"required\": [ \"result\" ]\n    },\n    \"responseStatus\": { \"type\": \"integer\" }\n  },\n  \"required\": [ \"response\", \"responseStatus\" ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Issue Id Identifier"
          },
          "outcomes": {
            "success": "1763554745732"
          },
          "code": "ISSUE_ID_IDENTIFIER",
          "id": "1762782755975",
          "inputs": [
            {
              "id": "1762782755976_1",
              "name": "prompt",
              "type": "string",
              "value": "Take this response as input {{$context.$nodes.TRANSACTION_FAILURE_ANALYSIS.$output}}\nconst response = {{$context.$nodes.TRANSACTION_FAILURE_ANALYSIS.$output}}\n\nLook for issueCSV inside the response. \n\nFrom this input you have to identify the issue ids. Issue id is a string of length 15 and looks like \"300100660290606\" and it contains all number characters. \nIdentify all issue ids and put them in an array. \n\nUse the following example to identify the issue Id. If issue id is not there then return an empty array. \n\nExample - \nInput - \"300100660290606$BPEL_FAULT$BPEL_FAULT 2025-11-05T07:03:04.0Z$null$null,300100660290605$TASK_30053$TASK_30053 2025-11-05T07:03:03.0Z$null$null\"\nOutput - [\"300100660290606\", \"300100660290605\"]\n\nIf issue id is not identified then return an empty array."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"IssueIdArray\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"string\"\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Format Desription And Resolution"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_DESRIPTION_AND_RESOLUTION",
          "id": "1762851557924",
          "inputs": [
            {
              "id": "1762851557925_1",
              "name": "prompt",
              "type": "string",
              "value": "Take this response as input {{$context.$nodes.TRANSACTION_FAILURE_ANALYSIS_RESOLUTION.$output}} and return formatted output. \n\nFormatting should be in this format - \n<b>Cause of Failure</b>: <Issue Description from response>\n<b>Possible Solution</b>: <Resolution from response>\n\nIf the response is failed or no response received from call then convey the following message\nThe information is not available at the moment. Please try again later."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_TRANSACTIONFAIL",
            "functionName": "show_issue_description_resolution",
            "name": "Transaction Failure Analysis Resolution"
          },
          "outcomes": {
            "success": "1762851557924"
          },
          "code": "TRANSACTION_FAILURE_ANALYSIS_RESOLUTION",
          "id": "1763554745732",
          "inputs": [
            {
              "id": "1763554833906_1",
              "name": "transactionId",
              "type": "string",
              "value": "{{$context.$nodes.PROCESS_FAILED_TRANSACTION_ID.$output.TransactionId}}"
            },
            {
              "id": "1763554833907_2",
              "name": "issueId",
              "type": "string",
              "value": "{{$context.$nodes.ISSUE_ID_IDENTIFIER.$output[0]}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"LLMIssueDescriptionResolution\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"issue_description\": { \"type\": \"string\" },\n        \"resolution\": { \"type\": \"string\" }\n      },\n      \"required\": [\"issue_description\", \"resolution\"]\n    }\n  },\n  \"required\": [\"result\"]\n}",
          "type": "BO_FUNCTION"
        }
      ],
      "rootNode": "start",
      "variables": [
        {
          "id": "1762851223950",
          "name": "issueDescriptionAndResolution",
          "type": "string"
        }
      ],
