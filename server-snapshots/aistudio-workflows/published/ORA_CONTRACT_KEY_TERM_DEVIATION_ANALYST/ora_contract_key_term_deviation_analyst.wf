          "code": "PARSED_RESPONSE",
          "convergenceTargetId": "1772163649362",
          "id": "1771858488039",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "rules",
            "returnType": "object",
            "sourceCode": "let o= {\n  \"rules\": [\n    {\n      \"keyTermName\": \"Indemnity\",\n      \"standard\": \"Unilateral indemnity — Supplier indemnifies Buyer for third-party claims from IP infringement, data/confidentiality breaches, and Supplier breach or negligence.\",\n      \"fallbacks\": [\n        {\n          \"name\": \"Fallback 1\",\n          \"text\": \"Unilateral indemnity with carve-outs: Supplier indemnifies Buyer for third-party IP/data claims, with carveouts for Buyer misuse, unauthorized changes, or third-party materials; operational claims limited to gross negligence/wilful misconduct.\"\n        },\n        {\n          \"name\": \"Fallback 2\",\n          \"text\": \"Mutual indemnity for third-party claims caused by each party’s breach, negligence, or violation of law.\"\n        }\n      ],\n      \"notAcceptable\": \"No indemnity; IP-only indemnity; indemnity capped at contract value only.\"\n    },\n    {\n      \"keyTermName\": \"Liability Cap\",\n      \"standard\": \"Aggregate liability capped at 2x total fees, with uncapped liability for IP infringement, confidentiality, data protection, fraud, and wilful misconduct.\",\n      \"fallbacks\": [\n        {\n          \"name\": \"Fallback 1\",\n          \"text\": \"Liability capped at 1x annual fees with carve-outs for data breach, IP infringement, and fraud.\"\n        },\n        {\n          \"name\": \"Fallback 2\",\n          \"text\": \"Liability capped at total fees paid, with higher cap for data breach and confidentiality.\"\n        }\n      ],\n      \"notAcceptable\": \"Cap below total fees; per-claim caps; liability capped for data breach/IP; broad exclusions removing meaningful recovery.\"\n    },\n    {\n      \"keyTermName\": \"Breach Notification\",\n      \"standard\": \"Supplier must notify Buyer within 24–48 hours of discovering a breach and provide updates and remediation details.\",\n      \"fallbacks\": [\n        {\n          \"name\": \"Fallback 1\",\n          \"text\": \"Notification within 72 hours of discovery.\"\n        },\n        {\n          \"name\": \"Fallback 2\",\n          \"text\": \"Notification without undue delay, not exceeding 5 business days.\"\n        }\n      ],\n      \"notAcceptable\": \"Notification after investigation completion; notice beyond 7 days; supplier decides materiality before notifying.\"\n    },\n    {\n      \"keyTermName\": \"Data Processing Role\",\n      \"standard\": \"Supplier acts solely as Data Processor, processing data only on documented instructions and not using it for its own purposes.\",\n      \"fallbacks\": [\n        {\n          \"name\": \"Fallback 1\",\n          \"text\": \"Processor role with rights to use anonymized/aggregated data for service improvement.\"\n        },\n        {\n          \"name\": \"Fallback 2\",\n          \"text\": \"Supplier is a Data Processor for Buyer data and may act as an Independent Controller only where legally required, with clearly defined responsibilities.\"\n        }\n      ],\n      \"notAcceptable\": \"Supplier is a Joint Controller without defined obligations and may use or monetize Buyer data for its own purposes beyond the services.\"\n    },\n    {\n      \"keyTermName\": \"Audit Rights\",\n      \"standard\": \"Buyer may conduct audits annually or upon an incident with reasonable notice, including on-site inspections, remote audits, and security and compliance reviews.\",\n      \"fallbacks\": [\n        {\n          \"name\": \"Fallback 1\",\n          \"text\": \"Buyer may audit biennially, while Supplier provides annual SOC 2, ISO 27001, or equivalent reports. On-site audits are allowed if the reports identify material gaps or insufficient controls.\"\n        },\n        {\n          \"name\": \"Fallback 2\",\n          \"text\": \"Third-party audit summaries acceptable; on-site audits limited to regulatory needs.\"\n        }\n      ],\n      \"notAcceptable\": \"No audit rights; audits only after material breach; excessive audit fees; supplier self-certification only.\"\n    }\n  ]\n}\nreturn o"
          },
          "outcomes": {
            "success": "1772115692597"
          },
          "code": "RULES_",
          "convergenceTargetId": "1772163649362",
          "id": "1771859823981",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "summarized js",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.PARSED_RESPONSE.$output.result;\nconst contracts = Array.isArray(data?.items) ? data.items : [];\nconst severity = { STANDARD: 0, FALLBACK1: 1, FALLBACK2: 2, PROHIBITED: 3 };\nconst deviatingSet = new Set([\"FALLBACK1\", \"FALLBACK2\", \"PROHIBITED\"]);\nconst isDeviating = (code) => deviatingSet.has(code);\n\n// keyTermName -> aggregate\nconst byTerm = new Map();\nfor (const c of contracts) {\n  const contractNumber = String(c?.ContractNumber ?? \"\").trim();\n  if (!contractNumber) continue;\n\n  // Contract-level metadata you said you want to retain\n  const contractMeta = {\n    contractNumber,\n    contractId: c?.ContractId ?? null,\n    latestExtractId: c?.LatestExtractId ?? null,\n    supplierName: String(c?.PrimaryParty ?? \"\").trim(),\n    category: String(c?.ContractTypeName ?? \"\").trim(),\n    startDate: String(c?.StartDate ?? \"\").trim()\n  };\n\n  const terms = c?.latestContractKeyTerms?.items;\n  if (!Array.isArray(terms) || terms.length === 0) continue;\n\n  // Deduplicate within this contract: pick worst DeviationCode per keyTermName\n  // Also keep KeyTermId (optional) from the selected record.\n  const bestPerTerm = new Map(); // keyTermName -> { deviationCode, actualValue, keyTermId }\n  for (const t of terms) {\n    const keyTermName = String(t?.KeyTermName ?? \"\").trim();\n    if (!keyTermName) continue;\n    const deviationCode = String(t?.DeviationCode ?? \"\").trim();\n    if (!(deviationCode in severity)) continue;\n    const actualValue = String(t?.KeyTermValue ?? \"\").trim();\n    const keyTermId = t?.KeyTermId ?? null;\n    const prev = bestPerTerm.get(keyTermName);\n    if (!prev || severity[deviationCode] > severity[prev.deviationCode]) {\n      bestPerTerm.set(keyTermName, { deviationCode, actualValue, keyTermId });\n    }\n  }\n\n  for (const [keyTermName, best] of bestPerTerm.entries()) {\n    if (!byTerm.has(keyTermName)) {\n      byTerm.set(keyTermName, {\n        keyTermName,\n        contractsWithTerm: new Set(), // contractNumbers\n        deviationCodeCounts: { STANDARD: 0, FALLBACK1: 0, FALLBACK2: 0, PROHIBITED: 0 },\n        deviatingContracts: new Set(), // contractNumbers\n        deviatingSuppliers: new Set(), // supplier names\n        deviatingValueFreq: new Map(), // actualValue -> count (deviating only)\n        // Full lists (NO LIMITS)\n        deviations: [], // deviating only\n        standards: [],  // standard only\n      });\n    }\n    const s = byTerm.get(keyTermName);\n    s.contractsWithTerm.add(contractNumber);\n    s.deviationCodeCounts[best.deviationCode] += 1;\n    const record = {\n      keyTermName,\n      keyTermId: best.keyTermId,\n      deviationCode: best.deviationCode,\n      actualValue: best.actualValue,\n      ...contractMeta,\n    };\n    if (isDeviating(best.deviationCode)) {\n      s.deviatingContracts.add(contractNumber);\n      if (contractMeta.supplierName) s.deviatingSuppliers.add(contractMeta.supplierName);\n      if (best.actualValue) {\n        s.deviatingValueFreq.set(\n          best.actualValue,\n          (s.deviatingValueFreq.get(best.actualValue) || 0) + 1\n        );\n      }\n      s.deviations.push(record);\n    } else {\n      s.standards.push(record);\n    }\n  }\n}\n\nconst keyTerms = [...byTerm.values()].map((s) => {\n  const denominatorContracts = s.contractsWithTerm.size;\n  const deviatingContracts = s.deviatingContracts.size;\n  const deviationPercent = denominatorContracts\n    ? Math.round((deviatingContracts / denominatorContracts) * 100)\n    : 0;\n\n  // Top 5 exceptions by frequency\n  const topExceptions = [...s.deviatingValueFreq.entries()]\n    .sort((a, b) => b[1] - a[1])\n    .slice(0, 5)\n    .map(([value, count]) => ({ value, count }));\n\n  return {\n    keyTermName: s.keyTermName,\n    denominatorContracts,\n    deviatingContracts,\n    deviationPercent,\n    deviationCodeCounts: s.deviationCodeCounts,\n    deviatingSuppliersCount: s.deviatingSuppliers.size,\n    topExceptions,\n    deviations: s.deviations,\n    standards: s.standards,\n  };\n});\n\nkeyTerms.sort((a, b) => {\n  // highest deviation first\n  if (b.deviationPercent !== a.deviationPercent) {\n    return b.deviationPercent - a.deviationPercent;\n  }\n  // tie-breakers (optional but recommended):\n  if (b.deviatingSuppliersCount !== a.deviatingSuppliersCount) {\n    return b.deviatingSuppliersCount - a.deviatingSuppliersCount;\n  }\n  // stable final tie-breaker\n  return a.keyTermName.localeCompare(b.keyTermName);\n});\n\nlet o = {\n  totalContracts: contracts.length,\n  keyTerms,\n};\nreturn o;"
          },
          "outcomes": {
            "success": "1766561857783"
          },
          "code": "SUMMARIZED_JS",
          "convergenceTargetId": "1772163649362",
          "id": "1772115692597",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
