        },
        {
          "metadata": {
            "name": "target keyterm deviations",
            "returnType": "object",
            "sourceCode": "// Targeted key term (case-insensitive match)\nconst TARGET_KEYTERM = JSON.parse( $context.$triggers.REST.$input.OraAction ).keyTermName\nconst targetLower = TARGET_KEYTERM.trim().toLowerCase();\n\nconst data = $context.$nodes.PARSE_QUERY_DEVIATIONS_RESPONSE.$output.result\nconst contracts = Array.isArray(data?.items) ? data.items : [];\n\n// Used to choose the \"worst\" record per contract (includes STANDARD so we can dedupe correctly)\nconst severity = { STANDARD: 0, FALLBACK1: 1, FALLBACK2: 2, PROHIBITED: 3 };\n\n// Only deviations you want returned\nconst deviatingSet = new Set([\"FALLBACK1\", \"FALLBACK2\", \"PROHIBITED\"]);\nconst isDeviating = (code) => deviatingSet.has(code);\n\n// Sorting order you requested: PROHIBITED first, then FALLBACK2, then FALLBACK1\nconst deviationSortRank = { PROHIBITED: 3, FALLBACK2: 2, FALLBACK1: 1 };\n\nconst deviations = [];\n\nfor (const c of contracts) {\n  const contractNumber = String(c?.ContractNumber ?? \"\").trim();\n  if (!contractNumber) continue;\n\n  const contractMeta = {\n    contractNumber,\n    contractId: c?.ContractId ?? null,\n    latestExtractId: c?.LatestExtractId ?? null,\n    supplierName: String(c?.PrimaryParty ?? \"\").trim(),\n    category: String(c?.ContractTypeName ?? \"\").trim(),\n    startDate: String(c?.StartDate ?? \"\").trim()\n  };\n\n  const terms = c?.latestContractKeyTerms?.items;\n  if (!Array.isArray(terms) || terms.length === 0) continue;\n\n  // Find the worst deviation record for this TARGET key term within the contract\n  let best = null; // { keyTermName, deviationCode, actualValue, keyTermId }\n\n  for (const t of terms) {\n    const keyTermName = String(t?.KeyTermName ?? \"\").trim();\n    if (!keyTermName) continue;\n    if (keyTermName.toLowerCase() !== targetLower) continue;\n\n    const deviationCode = String(t?.DeviationCode ?? \"\").trim();\n    if (!(deviationCode in severity)) continue;\n\n    const actualValue = String(t?.KeyTermValue ?? \"\").trim();\n    const keyTermId = t?.KeyTermId ?? null;\n\n    if (!best || severity[deviationCode] > severity[best.deviationCode]) {\n      best = { keyTermName, deviationCode, actualValue, keyTermId };\n    }\n  }\n\n  // Only return deviating records\n  if (!best || !isDeviating(best.deviationCode)) continue;\n\n  deviations.push({\n    keyTermName: best.keyTermName, // preserves original casing from data\n    keyTermId: best.keyTermId,\n    deviationCode: best.deviationCode,\n    actualValue: best.actualValue,\n    ...contractMeta\n  });\n}\n\n// Sort deviations: PROHIBITED > FALLBACK2 > FALLBACK1\ndeviations.sort((a, b) => {\n  const ra = deviationSortRank[a.deviationCode] || 0;\n  const rb = deviationSortRank[b.deviationCode] || 0;\n  if (rb !== ra) return rb - ra;\n  // optional stable tie-breaker\n  return String(a.contractNumber).localeCompare(String(b.contractNumber));\n});\n\nreturn   deviations;"
          },
          "outcomes": {
            "success": "1766562019626"
          },
          "code": "TARGET_KEYTERM_DEVIATIONS",
          "id": "1772683282153",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
