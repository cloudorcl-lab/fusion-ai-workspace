            "sourceCode": "var lastProcTime = $context.$system.$currentDateTime+'Z';\nvar summary =$context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION.$output.output??\"\";\n\n\n\nvar payload = [{\n  \"progressionSummary\": summary,\n  \"lastProcessedTime\": lastProcTime, \n  \"$id\": $context.$nodes.GETINSIGHTNUMBER.$output.result.insightNumber,\n  \"$operation\" : \"MERGE\"\n}];\n\nreturn payload;"
