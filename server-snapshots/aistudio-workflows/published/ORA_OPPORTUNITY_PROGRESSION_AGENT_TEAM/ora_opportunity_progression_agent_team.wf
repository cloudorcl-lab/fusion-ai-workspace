        {
          "metadata": {
            "name": "getInsightNumber",
            "returnType": "object",
            "sourceCode": "let returnValue = {};\nconst insightNumber = $context.$triggers.REST.$input.insightNumber;\nconst insightId = $context.$triggers.REST.$input.insightId;\nconst derivedInsightNumber = $context.$nodes.GETENGAGEMENTINSIGHT.$output?.items[0].engagementInsightNumber;\nconst derivedInsightId = $context.$nodes.GETENGAGEMENTINSIGHT.$output?.items[0].id;\nreturnValue.insightNumber = derivedInsightNumber ? derivedInsightNumber : insightNumber;\nreturnValue.insightId = derivedInsightId ? derivedInsightId : insightId;\nreturn returnValue;"
          },
          "outcomes": {
            "success": "1764726005361"
          },
