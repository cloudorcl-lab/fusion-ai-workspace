        {
          "metadata": {
            "name": "IncludeDataCapture",
            "returnType": "array",
            "sourceCode": "var response = $context.$nodes.CONSTRUCT_INSIGHT_UPDATE_PAYLOAD.$output.result;\nlet additionalInsightData;\ntry {\n  additionalInsightData = JSON.parse( $context.$nodes.CONTEXT_BUILDER.$output.output);\n  additionalInsightData = additionalInsightData?.result?.ENGAGEMENT?.insight_data?.items[0]?.additionalInsightData ?? \"{}\";\n  additionalInsightData = JSON.parse(additionalInsightData);\ntry{\n  additionalInsightData.dataCapture = JSON.parse( $context.$nodes.PROCESS_DATA_CAPTURE.$output.output)?.dataCapture;\n}catch(e){}\n  additionalInsightData.recommendedContacts = JSON.parse( $context.$nodes.GET_RECOMMENDED_CONTACTS.$output.output, )?.result?.recommendedContacts;\n\n  // Remove duplicates in recommendedContacts based on EmailAddress (case insensitive)\n  if (Array.isArray(additionalInsightData.recommendedContacts)) {\n    const seenEmails = new Set();\n    additionalInsightData.recommendedContacts = additionalInsightData.recommendedContacts.filter(contact => {\n      if (!contact.EmailAddress) return true;\n      const emailLower = contact.EmailAddress.toLowerCase();\n      if (seenEmails.has(emailLower)) {\n        return false;\n      } else {\n        seenEmails.add(emailLower);\n        return true;\n      }\n    });\n  }\n\n  //recommendedConversations. Just parsing it to avoid double stringify.\n  additionalInsightData.recommendedConversations =  additionalInsightData.recommendedConversations;\n}\ncatch(e) {}\n\nlet payload = {};\n\nif (typeof additionalInsightData === 'string') {\n  payload = JSON.parse(additionalInsightData);\n} else {\n   payload = additionalInsightData ?? {};\n}\n\nresponse[0].additionalInsightData = JSON.stringify(payload);\n\nreturn response;"
          },
