          "code": "HVAOUTPUT",
          "type": "CODE",
          "metadata": {
            "name": "New code Node",
            "sourceCode": "let a = $context.$nodes.OPPORTUNITY_HIGH_VALUE_ACTIVITY_EVALUATION_AGENT_TEAM.$output.output \n\nreturn a;",
            "returnType": "object"
          },
          "diagram": {
            "x": 5708.5,
            "y": 6779
