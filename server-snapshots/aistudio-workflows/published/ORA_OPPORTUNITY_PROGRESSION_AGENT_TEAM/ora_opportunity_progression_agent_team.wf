        {
          "metadata": {
            "name": "create payload for AI outcome",
            "returnType": "array",
            "sourceCode": "const date = new Date(); \n// Add 30 days\ndate.setDate(date.getDate() + 30); \n// Format output\nconst expiryTime = date.toISOString();\nconst effectiveDate = new Date().toISOString();\n\nlet summary = {\n\"schemaVersion\":\"1.0\",\n  what: {\n    title:\"Opportuniy Summary\",\n    summary: $context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION.$output.output ??\"\",\n  }\n};\n\nlet payload = [\n  {\n    outcomeType: \"SUMMARY\",\n    primaryObjectKey: $context.$triggers.REST.$input.id,\n    urgency: \"MEDIUM\",\n    payload: JSON.stringify(summary),\n    primaryObjectAltKey: $context.$triggers.REST.$input.puid,\n    category: \"ENGAGEMENT\",\n    expiryTime:expiryTime,\n    effectiveDate:effectiveDate,\n    generatedBy: \"agent:progressionAgent/v1\",\n    \"$operation\": \"MERGE\",\n    \"$lookupBy\": {\n      outcomeType: \"SUMMARY\",\n      outcomeSubtype: \"STATE_SUMMARY\",\n      category: \"ENGAGEMENT\",\n      primaryObjectType: \"OPPORTUNITY\",\n      primaryObjectAltKey: $context.$triggers.REST.$input.puid,\n    },\n    outcomeSubtype: \"STATE_SUMMARY\",\n    primaryObjectType: \"OPPORTUNITY\",\n    status: \"ACTIVE\",\n  },\n];\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1774890003301"
          },
