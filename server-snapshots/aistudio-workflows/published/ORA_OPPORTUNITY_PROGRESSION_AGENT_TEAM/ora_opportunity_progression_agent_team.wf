        {
          "metadata": {
            "name": "construct context for opty summarization",
            "returnType": "object",
            "sourceCode": "const contextBuilderDataTxt = $context.$nodes.CONTEXT_BUILDER.$output?.output;\nconst contextBuilderData = JSON.parse(contextBuilderDataTxt);\n\nconst opportunityData  = contextBuilderData?.result?.OPPORTUNITY;\n\nconst opportunitySummaryData = contextBuilderData?.result?.ENGAGEMENT?.insight_data;\nconst newEngagementsCollection = contextBuilderData?.result?.ENGAGEMENT?.engagements;\nconst webActivities = contextBuilderData?.result?.WEBACTIVITIES?.items;\n\nlet retObj =  {\"opportunity_and_its_child_object_data\" : opportunityData, \"current_opportunity_summary\": opportunitySummaryData, \"new_engagements\": newEngagementsCollection, \"webActivities\": webActivities}\nreturn retObj;"
          },
          "outcomes": {
            "success": "1778059788432"
          },
