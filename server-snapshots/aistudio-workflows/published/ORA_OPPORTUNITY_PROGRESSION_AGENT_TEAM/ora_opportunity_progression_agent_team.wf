          "outcomes": {
            "success": "1765305356023"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Construct Context for Recommendations",
            "returnType": "object",
            "sourceCode": "var contextBuilderOutput = $context.$nodes.CONTEXT_BUILDER.$output;\n\nif (!contextBuilderOutput) {\n    contextBuilderOutput = new Object();\n}\n\nvar contextBuilderPayload = contextBuilderOutput.output;\nvar contextBuilderParsed = new Object();\n\ntry {\n    if (typeof contextBuilderPayload === \"string\" && contextBuilderPayload.length > 0) {\n        contextBuilderParsed = JSON.parse(contextBuilderPayload);\n    } else if (contextBuilderPayload) {\n        contextBuilderParsed = contextBuilderPayload;\n    }\n} catch (e) {\n    contextBuilderParsed = new Object();\n}\n\nvar contextBuilderResult = new Object();\n\nif (contextBuilderParsed && contextBuilderParsed.result) {\n    contextBuilderResult = contextBuilderParsed.result;\n} else if (contextBuilderParsed) {\n    contextBuilderResult = contextBuilderParsed;\n}\n\n\n// -----------------------------------------------------------------------------\n// High Value Activity / Sales Motion parsing\n// Expected HVA node output shape:\n// $context.$nodes.OPPORTUNITY_HIGH_VALUE_ACTIVITY_EVALUATION_AGENT_TEAM.$output.output\n// is a JSON string like:\n// {\"result\":[{ objectiveId, objectiveStatus, name, highValueActivities: { items: [...] } }]}\n// -----------------------------------------------------------------------------\n\nvar hvaRawOutput = $context.$nodes.OPPORTUNITY_HIGH_VALUE_ACTIVITY_EVALUATION_AGENT_TEAM.$output;\n\nif (!hvaRawOutput) {\n    hvaRawOutput = new Object();\n}\n\nvar hvaPayload = hvaRawOutput.output;\nvar hvaParsed = new Object();\n\ntry {\n    if (typeof hvaPayload === \"string\" && hvaPayload.length > 0) {\n        hvaParsed = JSON.parse(hvaPayload);\n    } else if (hvaPayload) {\n        hvaParsed = hvaPayload;\n    }\n} catch (e2) {\n    hvaParsed = new Object();\n}\n\nvar salesMotionContext = new Array();\n\nif (hvaParsed && Array.isArray(hvaParsed.result)) {\n    salesMotionContext = hvaParsed.result;\n}\n\nvar salesMotionStatusLedger = new Array();\n\nfor (var objectiveIndex = 0; objectiveIndex < salesMotionContext.length; objectiveIndex++) {\n    var objective = salesMotionContext[objectiveIndex];\n\n    if (!objective) {\n        objective = new Object();\n    }\n\n    var objectiveName = objective.name || \"\";\n    var objectiveStatus = objective.objectiveStatus || \"\";\n    var hvas = new Array();\n\n    if (objective.highValueActivities && Array.isArray(objective.highValueActivities.items)) {\n        hvas = objective.highValueActivities.items;\n    }\n\n    for (var hvaIndex = 0; hvaIndex < hvas.length; hvaIndex++) {\n        var hva = hvas[hvaIndex];\n\n        if (!hva) {\n            hva = new Object();\n        }\n\n        var ledgerItem = new Object();\n\n        ledgerItem.objectiveName = objectiveName;\n        ledgerItem.objectiveStatus = objectiveStatus;\n        ledgerItem.hvaName = hva.name || \"\";\n        ledgerItem.hvaStatus = hva.highValueActivityStatus || \"\";\n        ledgerItem.hvaId = hva.highValueActivityId || \"\";\n        ledgerItem.justification = hva.justification || \"\";\n\n        salesMotionStatusLedger.push(ledgerItem);\n    }\n}\n\n\n// -----------------------------------------------------------------------------\n// Engagement parsing\n// -----------------------------------------------------------------------------\n\nvar engagementContext = contextBuilderResult.ENGAGEMENT || contextBuilderResult.engagements;\n\nif (!engagementContext) {\n    engagementContext = new Object();\n}\n\nvar engagementItems = new Array();\n\nif (engagementContext.engagements && Array.isArray(engagementContext.engagements)) {\n    engagementItems = engagementContext.engagements;\n} else if (Array.isArray(engagementContext)) {\n    engagementItems = engagementContext;\n} else if (contextBuilderResult.engagements && Array.isArray(contextBuilderResult.engagements)) {\n    engagementItems = contextBuilderResult.engagements;\n}\n\n\n// -----------------------------------------------------------------------------\n// Insight data\n// -----------------------------------------------------------------------------\n\nvar insightData = \"\";\n\nif (\n    $context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION &&\n    $context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION.$output &&\n    $context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION.$output.output\n) {\n    insightData = $context.$nodes.CALL_DEAL_ADVISOR_FOR_SUMMARIZATION.$output.output;\n} else if (engagementContext && engagementContext.insight_data) {\n    insightData = engagementContext.insight_data;\n} else if (contextBuilderResult.insight_data) {\n    insightData = contextBuilderResult.insight_data;\n}\n\n\n// -----------------------------------------------------------------------------\n// Opportunity data\n// -----------------------------------------------------------------------------\n\nvar optyData = contextBuilderResult.OPPORTUNITY || contextBuilderResult.opty_data;\n\nif (!optyData) {\n    optyData = new Object();\n}\n\n\n// -----------------------------------------------------------------------------\n// Final output\n// -----------------------------------------------------------------------------\n\nvar output = new Object();\n\noutput.opty_data = optyData;\n\noutput.engagement = contextBuilderResult.ENGAGEMENT || contextBuilderResult.engagement || engagementContext;\n\noutput.engagements = {\n    items: engagementItems\n};\n\noutput.insight_data = insightData;\n\n// camelCase fields\n//output.salesMotionContext = salesMotionContext;\n//output.salesMotionStatusLedger = salesMotionStatusLedger;\n\n// snake_case fields, kept for compatibility\noutput.sales_motion_context = salesMotionContext;\noutput.sales_motion_status_ledger = salesMotionStatusLedger;\n\nreturn output;"
          },
          "outcomes": {
            "success": "1765308364587"
          },
