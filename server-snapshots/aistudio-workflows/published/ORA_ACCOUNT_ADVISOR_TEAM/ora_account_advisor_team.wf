        {
          "metadata": {
            "name": "getAccountData",
            "returnType": "object",
            "sourceCode": "let raw = $context.$nodes.GETACCOUNTDETAILS.$output;\n\nlet data;\ntry {\n  data = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n} catch (e) {\n  data = null;\n}\n\nlet item = Array.isArray(data) ? data[0] : data;\n\nlet result = item ? {\n  partyId: item?.PartyId ?? null,\n  partyNumber: item?.PartyNumber ?? null,\n  partyName: item?.PartyName ?? null,\n  salesProfileType: item?.SalesProfileType ?? null,\n  organizationType: item?.OrganizationType ?? null,\n  primaryContactName: item?.PrimaryContact?.PartyName ?? null,\n  ultimateParentPartyId: item?.AccountHierarchySummary?.UltimateParent?.PartyId ?? null,\n  ultimateParentPartyNumber: item?.AccountHierarchySummary?.UltimateParent?.PartyNumber ?? null\n} : {};\n\nresult;"
          },
          "outcomes": {
            "success": "1773958907170"
          },
