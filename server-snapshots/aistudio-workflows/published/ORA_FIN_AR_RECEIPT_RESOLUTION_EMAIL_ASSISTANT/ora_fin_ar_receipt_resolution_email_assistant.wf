            "name": "Build ERP Email Message Payload",
            "returnType": "object",
            "sourceCode": "const memory = $context.$nodes.MEMORY_MANAGER.$output.result.memory;\n\nconst to = memory.send?.to;\nconst cc = Array.isArray(memory.send?.cc) ? memory.send.cc : [];\nconst subject = memory.draft?.subject;\nconst body =\n  $context.$nodes.FORMAT_EMAIL_FOR_SEND.$output.body ||\n  $context.$nodes.PREPARE_EMAIL_SEND.$output.result.body ||\n  memory.draft?.body;\n\nif (!to) {\n  throw new Error(\"Missing recipient email address.\");\n}\n\nif (!subject || !body) {\n  throw new Error(\"Missing draft subject or body.\");\n}\n\nfunction cleanEmail(value) {\n  const str = String(value || \"\").trim();\n  return str || null;\n}\n\nconst toList = Array.isArray(to)\n  ? to.map(cleanEmail).filter(Boolean)\n  : String(to)\n      .split(\",\")\n      .map(cleanEmail)\n      .filter(Boolean);\n\nconst ccList = cc\n  .map(cleanEmail)\n  .filter(Boolean);\n\nreturn {\n  externalMessageReference: null,\n  conversationReference: null,\n  emailTypeCode: \"ORA_OUTBOUND\",\n  messageHeader: null,\n  virtualAddress: \"ORA_FIN_AR_UNAPPLIED_RECEIPTS_EMAIL_RESOLUTION_ASSISTANT\",\n  senderAddress: null,\n  recipientAddress: JSON.stringify({\n    to: toList,\n    cc: ccList,\n    bcc: []\n  }),\n  subject,\n  messageBody: body,\n  emailFile: null,\n  messageStatusCode: \"ORA_PROCESSED\",\n  locale: null,\n  replyToMessageId: null,\n  emailMessageAttachments: {\n    items: []\n  }\n};"
          },
