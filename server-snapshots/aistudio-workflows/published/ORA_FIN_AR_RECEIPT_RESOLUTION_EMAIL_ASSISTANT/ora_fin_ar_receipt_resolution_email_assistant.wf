        {
          "metadata": {
            "description": "",
            "name": "Load Memory",
            "returnType": "object",
            "sourceCode": "const existingMemory = $context.$variables.conversationMemory;\n\nfunction defaultMemory() {\n  return {\n    schemaVersion: \"1.0\",\n    taskState: \"IDLE\",\n    requiredInput: \"NONE\",\n    receiptContext: {\n      receiptNumbers: [],\n      cashReceiptIds: [],\n      selectionOptions: [],\n      customerAccountId: null,\n      customerAccountNumber: null,\n      customerAccountName: null,\n      customerName: null,\n      businessUnitId: null,\n      businessUnitName: null,\n      resolutionIssue: null,\n      receipts: []\n    },\n    invoiceContext: {\n      openInvoiceCount: null,\n      openInvoices: []\n    },\n    draft: {\n      subject: null,\n      body: null,\n      version: 0\n    },\n    send: {\n      to: null,\n      cc: [],\n      requested: false,\n      confirmed: false,\n      sentReference: null,\n      lastError: null\n    }\n  };\n}\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\" && parsed.trim()) {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction mergeObject(base, incoming) {\n  const result = JSON.parse(JSON.stringify(base));\n\n  if (!incoming || typeof incoming !== \"object\") {\n    return result;\n  }\n\n  for (const key of Object.keys(incoming)) {\n    if (\n      incoming[key] &&\n      typeof incoming[key] === \"object\" &&\n      !Array.isArray(incoming[key]) &&\n      result[key] &&\n      typeof result[key] === \"object\" &&\n      !Array.isArray(result[key])\n    ) {\n      result[key] = mergeObject(result[key], incoming[key]);\n    } else {\n      result[key] = incoming[key];\n    }\n  }\n\n  return result;\n}\n\nlet memory = null;\n\ntry {\n  memory = parseIfString(existingMemory);\n} catch (e) {\n  memory = null;\n}\n\nif (!memory || typeof memory !== \"object\" || memory.schemaVersion !== \"1.0\") {\n  memory = defaultMemory();\n} else {\n  memory = mergeObject(defaultMemory(), memory);\n}\n\nreturn memory;"
          },
