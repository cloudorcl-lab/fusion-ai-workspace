          "id": "1780389948932",
          "inputs": [
            {
              "id": "1780389948932_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.MEMORY_MANAGER.$output.result.nextAction}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "description": "",
            "name": "Build Receipt Lookup Extract",
            "returnType": "object",
            "sourceCode": "const memory = $context.$nodes.MEMORY_MANAGER.$output.result.memory;\n\nconst receiptNumbers = Array.isArray(memory.receiptContext?.receiptNumbers)\n  ? memory.receiptContext.receiptNumbers\n  : [];\n\nconst cashReceiptIds = Array.isArray(memory.receiptContext?.cashReceiptIds)\n  ? memory.receiptContext.cashReceiptIds\n  : [];\n\nfunction clean(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n\n  const str = String(value).trim();\n  return str ? str : null;\n}\n\nfunction unique(values) {\n  return [...new Set(values.map(clean).filter(Boolean))];\n}\n\nfunction quote(value) {\n  return `'${String(value).replace(/'/g, \"''\")}'`;\n}\n\nconst cleanReceiptNumbers = unique(receiptNumbers);\nconst cleanCashReceiptIds = unique(cashReceiptIds);\n\nif (!cleanReceiptNumbers.length && !cleanCashReceiptIds.length) {\n  throw new Error(\"Missing receipt number or cash receipt ID for receipt lookup.\");\n}\n\nlet whereClause;\n\nif (cleanCashReceiptIds.length) {\n  whereClause = `cashReceiptId in (${cleanCashReceiptIds.map(quote).join(\",\")})`;\n} else {\n  whereClause = `receiptNumber in (${cleanReceiptNumbers.map(quote).join(\",\")})`;\n}\n\nreturn {\n  select:\n    \"select \" +\n    \"receiptNumber, \" +\n    \"cashReceiptId, \" +\n    \"receiptDate, \" +\n    \"receiptAmount, \" +\n    \"-1 * amountRemaining as amountRemaining, \" +\n    \"receiptCurrency, \" +\n    \"receiptStatus, \" +\n    \"customerId, \" +\n    \"customerAccountId, \" +\n    \"customerAccountNumber, \" +\n    \"customerAccountName, \" +\n    \"customerName, \" +\n    \"businessUnitId, \" +\n    \"businessUnitName \" +\n    \"from ReceivablesReceiptDetail \" +\n    `where ${whereClause}`,\n\n  viewQueries: {\n    ReceivablesReceiptDetail: {\n      view: \"receivablesReceiptDetail\",\n      businessObject: \"ReceivablesReceipt\",\n      module: \"oraErpCoreReceivablesPayments\",\n      fieldAliases: {\n        receiptNumber: \"receiptNumber\",\n        cashReceiptId: \"cashReceiptId\",\n        receiptDate: \"receiptDate\",\n        receiptAmount: \"receiptAmount\",\n        \"paymentSchedule.amountRemaining\": \"amountRemaining\",\n        \"receiptCurrency.currencyCode\": \"receiptCurrency\",\n        status: \"receiptStatus\",\n        \"customerAccount.customer.id\": \"customerId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.accountNumber\": \"customerAccountNumber\",\n        \"customerAccount.accountName\": \"customerAccountName\",\n        \"customerAccount.customer.name\": \"customerName\",\n        \"businessUnit.id\": \"businessUnitId\",\n        \"businessUnit.name\": \"businessUnitName\"\n      }\n    }\n  }\n};"
          },
          "outcomes": {
            "success": "1780333904912"
          },
          "code": "BUILD_RECEIPT_LOOKUP_EXTRACT",
          "id": "1780333798058",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Revise Draft Email"
          },
          "outcomes": {
            "success": "1780390736431"
          },
          "code": "REVISE_DRAFT_EMAIL",
          "id": "1780395003752",
          "inputs": [
            {
              "id": "1780395003752_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1780395003752_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are revising one Accounts Receivable remittance-advice email draft.\n\nYour job is to update the existing draft according to the latest user instruction while preserving business accuracy.\n\nYou do not:\n- execute actions\n- update memory\n- send email\n- invent receipt, invoice, customer, amount, date, currency, business unit, recipient, or payment facts\n\nLATEST_USER_INSTRUCTION:\n{{$context.$system.$inputMessage}}\n\nCURRENT_DRAFT:\n{{$context.$variables.conversationMemory.draft}}\n\nRECEIPT_CONTEXT:\n{{$context.$variables.conversationMemory.receiptContext}}\n\nINVOICE_CONTEXT:\n{{$context.$variables.conversationMemory.invoiceContext}}\n\nCore rules:\n- Preserve the original email purpose: request remittance advice or allocation instructions.\n- Apply the user's requested changes to wording, tone, length, formatting, subject, or included details.\n- Use only facts present in CURRENT_DRAFT, RECEIPT_CONTEXT, or INVOICE_CONTEXT.\n- Do not change the customer unless RECEIPT_CONTEXT supports it.\n- Do not add recipient email addresses.\n- Do not mention internal workflow state.\n- Do not mention that this is generated by an AI assistant.\n- Do not mention the business unit in the email body or subject.\n- Keep the tone courteous, operational, and non-threatening.\n- Sign off as Accounts Receivable Team unless the user explicitly asks for a different non-conflicting signoff.\n\nReceipt amount rules:\n- `amountRemaining` is the unapplied amount that still needs allocation.\n- `receiptAmount` is the original receipt amount.\n- When asking for allocation/remittance details, emphasize `amountRemaining`.\n- Do not describe `receiptAmount` as the unapplied amount.\n- If `amountRemaining` is present, include it in receipt details.\n- If `amountRemaining` is not present, use `receiptAmount` as the available receipt amount without calling it unapplied.\n\nReceipt status wording rules:\n- Do not show raw receipt status codes in the email.\n- Convert receipt status codes to customer-friendly wording.\n- Use \"Unapplied\" for statuses such as UNAPP, UNAPPLIED, UNID, or unidentified/unapplied receipt states.\n- If the status cannot be safely converted, omit the status instead of showing a raw code.\n\nDraft formatting rules:\n- The body must be plain text suitable for chat preview.\n- Use normal paragraphs for the message text.\n- Use markdown-style tables for receipt details and open invoice details unless the user explicitly asks for no table or plain text without tables.\n- Do not use HTML tags in the draft body.\n- Do not create tab-separated, space-aligned, or free-form text tables.\n- A valid markdown table must contain:\n  - one header row using pipes\n  - one separator row using pipes and dashes\n  - one data row per receipt or invoice\n- Keep the draft readable for the user before sending.\n\nCurrency formatting rules:\n- Do not create a separate currency column.\n- If all rows in a table use the same currency, include the currency code in the amount column header, for example \"Receipt Amount (USD)\" and \"Amount Remaining (USD)\".\n- If rows in the same table use different currencies, include the currency code inside each amount cell, for example \"4,818.12 USD\".\n- Apply this separately for the Receipt Details table and the Open Invoices table.\n\nAllowed revisions:\n- Make the email shorter, longer, clearer, more formal, friendlier, or more concise.\n- Change or improve the subject.\n- Reorder sections.\n- Add polite urgency if requested.\n- Add user-provided non-conflicting wording, such as a requested reply deadline.\n- Remove invoice details if requested.\n- Remove receipt details if requested.\n- Mention only selected receipts or invoices if requested and present in context.\n- Preserve markdown-style tables unless the user asks to remove tables or use plain paragraphs.\n\nInvoice rules:\n- If the user asks to include a specific invoice, include it only if it exists in INVOICE_CONTEXT.\n- If the user asks to remove a specific invoice, remove it from the draft body if present.\n- If the user asks to remove all invoice details, remove the invoice section completely.\n- If the user asks to mention only specific invoices, include only those invoices that exist in INVOICE_CONTEXT.\n- Do not invent invoice numbers, balances, dates, or amounts.\n\nReceipt rules:\n- If the user asks to include a specific receipt, include it only if it exists in RECEIPT_CONTEXT.\n- If the user asks to remove a specific receipt, remove it from the draft body if present.\n- If the user asks to remove all receipt details, keep the remittance advice request but make the receipt reference more general.\n- If the user asks to mention only specific receipts, include only those receipts that exist in RECEIPT_CONTEXT.\n- Do not invent receipt numbers, cash receipt IDs, amounts, dates, statuses, or currencies.\n- Do not modify RECEIPT_CONTEXT or INVOICE_CONTEXT. You only revise the draft text.\n\nUnsupported edit handling:\n- If the user asks to add a factual detail that is not present in CURRENT_DRAFT, RECEIPT_CONTEXT, or INVOICE_CONTEXT, omit that unsupported detail.\n- If the requested edit conflicts with the available facts, preserve the available facts.\n- Do not explain omissions; just return the best accurate revised draft.\n\nOutput requirements:\n- Return valid JSON only.\n- No explanations.\n- No text outside JSON.\n- The `body` value must be plain text and may contain markdown-style tables.\n- Escape JSON correctly so the returned JSON is valid.\n\nReturn exactly this shape:\n{\n  \"subject\": \"string\",\n  \"body\": \"string\"\n}"
            }
          ],
          "outputSpecification": "{\n  \"title\": \"DraftEmailOutput\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"subject\", \"body\"],\n  \"properties\": {\n    \"subject\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"body\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_RECEIVABLE_BOSSAREXTRACT",
            "functionName": "Extract",
            "name": "Lookup Receipt"
          },
          "outcomes": {
            "success": "1780379221938"
          },
          "code": "LOOKUP_RECEIPT",
          "id": "1780333904912",
          "inputs": [
            {
              "id": "1780333904912_extraction_query_json_object",
              "name": "extraction_query_json_object",
              "value": "{{$context.$nodes.BUILD_RECEIPT_LOOKUP_EXTRACT.$output.result}}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "appendTurnMemory"
          },
          "outcomes": {
            "success": "1780390382581"
          },
          "code": "APPENDTURNMEMORY",
          "id": "1780390970068",
          "inputs": [
            {
              "id": "1780390970068_conversationMemory",
              "name": "conversationMemory",
              "value": "{{$context.$nodes.MEMORY_FINALIZE.$output.result.memory}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Resolve Receipt Context",
            "returnType": "object",
            "sourceCode": "const managerOutput = $context.$nodes.MEMORY_MANAGER.$output.result;\nconst memory = JSON.parse(JSON.stringify(managerOutput.memory));\nconst rowsRaw = $context.$nodes.LOOKUP_RECEIPT.$output || [];\n\nfunction normalizeRows(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (value && Array.isArray(value.result)) {\n    return value.result;\n  }\n\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n\n  return [];\n}\n\nfunction get(row, camelKey, upperKey) {\n  if (!row || typeof row !== \"object\") {\n    return null;\n  }\n\n  if (row[camelKey] !== undefined) {\n    return row[camelKey];\n  }\n\n  if (row[upperKey] !== undefined) {\n    return row[upperKey];\n  }\n\n  return null;\n}\n\nfunction clean(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n\n  const str = String(value).trim();\n  return str ? str : null;\n}\n\nfunction asAmount(value) {\n  if (value === null || value === undefined || value === \"\") {\n    return null;\n  }\n\n  const num = Number(value);\n  return Number.isFinite(num) ? num : value;\n}\n\nfunction unique(values) {\n  return [\n    ...new Set(\n      values\n        .map(clean)\n        .filter(v => v !== null)\n    )\n  ];\n}\n\nfunction asReceipt(row) {\n  return {\n    receiptNumber: clean(get(row, \"receiptNumber\", \"RECEIPTNUMBER\")),\n    cashReceiptId: clean(get(row, \"cashReceiptId\", \"CASHRECEIPTID\")),\n    receiptDate: clean(get(row, \"receiptDate\", \"RECEIPTDATE\")),\n    receiptAmount: asAmount(get(row, \"receiptAmount\", \"RECEIPTAMOUNT\")),\n    amountRemaining: asAmount(get(row, \"amountRemaining\", \"AMOUNTREMAINING\")),\n    receiptCurrency: clean(get(row, \"receiptCurrency\", \"RECEIPTCURRENCY\")),\n    receiptStatus: clean(get(row, \"receiptStatus\", \"RECEIPTSTATUS\")),\n    customerId: clean(get(row, \"customerId\", \"CUSTOMERID\")),\n    customerAccountId: clean(get(row, \"customerAccountId\", \"CUSTOMERACCOUNTID\")),\n    customerAccountNumber: clean(get(row, \"customerAccountNumber\", \"CUSTOMERACCOUNTNUMBER\")),\n    customerAccountName: clean(get(row, \"customerAccountName\", \"CUSTOMERACCOUNTNAME\")),\n    customerName: clean(get(row, \"customerName\", \"CUSTOMERNAME\")),\n    businessUnitId: clean(get(row, \"businessUnitId\", \"BUSINESSUNITID\")),\n    businessUnitName: clean(get(row, \"businessUnitName\", \"BUSINESSUNITNAME\"))\n  };\n}\n\nconst rows = normalizeRows(rowsRaw).map(asReceipt);\n\nlet nextAction = \"LOOKUP_OPEN_INVOICES\";\nlet responsePlan = null;\n\nif (rows.length === 0) {\n  memory.taskState = \"RESOLVING_RECEIPT\";\n  memory.requiredInput = \"RECEIPT_NUMBER\";\n  memory.receiptContext.resolutionIssue = \"NO_MATCH\";\n\n  responsePlan = {\n    responseType: \"NO_RECEIPT_FOUND\",\n    facts: {\n      receiptNumbers: memory.receiptContext.receiptNumbers || [],\n      cashReceiptIds: memory.receiptContext.cashReceiptIds || []\n    }\n  };\n\n  nextAction = \"RESPOND_ONLY\";\n} else {\n  const cashReceiptIds = unique(rows.map(r => r.cashReceiptId));\n  const receiptNumbers = unique(rows.map(r => r.receiptNumber));\n  const customerAccountIds = unique(rows.map(r => r.customerAccountId));\n  const businessUnitIds = unique(rows.map(r => r.businessUnitId));\n\n  const missingCustomerContext =\n    customerAccountIds.length === 0 ||\n    rows.some(r => !r.customerAccountId || !r.customerName);\n\n  const missingBusinessUnitContext =\n    businessUnitIds.length === 0 ||\n    rows.some(r => !r.businessUnitId);\n\n  if (missingCustomerContext) {\n    memory.taskState = \"RESOLVING_RECEIPT\";\n    memory.requiredInput = \"RECEIPT_NUMBER\";\n    memory.receiptContext.receiptNumbers = receiptNumbers.length ? receiptNumbers : memory.receiptContext.receiptNumbers;\n    memory.receiptContext.cashReceiptIds = cashReceiptIds;\n    memory.receiptContext.businessUnitId = rows[0]?.businessUnitId || null;\n    memory.receiptContext.businessUnitName = rows[0]?.businessUnitName || null;\n    memory.receiptContext.resolutionIssue = \"MISSING_CUSTOMER_CONTEXT\";\n\n    responsePlan = {\n      responseType: \"MISSING_CUSTOMER_CONTEXT\",\n      facts: {\n        receiptNumbers,\n        cashReceiptIds,\n        receiptStatus: rows[0]?.receiptStatus || null,\n        businessUnitName: rows[0]?.businessUnitName || null\n      }\n    };\n\n    nextAction = \"RESPOND_ONLY\";\n  } else if (missingBusinessUnitContext) {\n    memory.taskState = \"RESOLVING_RECEIPT\";\n    memory.requiredInput = \"RECEIPT_NUMBER\";\n    memory.receiptContext.receiptNumbers = receiptNumbers.length ? receiptNumbers : memory.receiptContext.receiptNumbers;\n    memory.receiptContext.cashReceiptIds = cashReceiptIds;\n    memory.receiptContext.resolutionIssue = \"MISSING_BUSINESS_UNIT_CONTEXT\";\n\n    responsePlan = {\n      responseType: \"MISSING_BUSINESS_UNIT_CONTEXT\",\n      facts: {\n        receiptNumbers,\n        cashReceiptIds\n      }\n    };\n\n    nextAction = \"RESPOND_ONLY\";\n  } else if (customerAccountIds.length !== 1 || businessUnitIds.length !== 1) {\n    memory.taskState = \"RESOLVING_RECEIPT\";\n    memory.requiredInput = \"RECEIPT_NUMBER\";\n    memory.receiptContext.receiptNumbers = receiptNumbers.length ? receiptNumbers : memory.receiptContext.receiptNumbers;\n    memory.receiptContext.cashReceiptIds = cashReceiptIds;\n    memory.receiptContext.resolutionIssue = \"MULTI_CUSTOMER_OR_BUSINESS_UNIT\";\n\n    responsePlan = {\n      responseType: \"MULTI_CUSTOMER_OR_BU\",\n      facts: {\n        receiptNumbers,\n        cashReceiptIds,\n        customerAccountCount: customerAccountIds.length,\n        businessUnitCount: businessUnitIds.length\n      }\n    };\n\n    nextAction = \"RESPOND_ONLY\";\n  } else {\n    const first = rows[0];\n\n    memory.taskState = \"RESOLVING_RECEIPT\";\n    memory.requiredInput = \"NONE\";\n\n    memory.receiptContext.receiptNumbers = receiptNumbers;\n    memory.receiptContext.cashReceiptIds = cashReceiptIds;\n    memory.receiptContext.customerId = first.customerId;\n    memory.receiptContext.customerAccountId = first.customerAccountId;\n    memory.receiptContext.customerAccountNumber = first.customerAccountNumber;\n    memory.receiptContext.customerAccountName = first.customerAccountName;\n    memory.receiptContext.customerName = first.customerName;\n    memory.receiptContext.businessUnitId = first.businessUnitId;\n    memory.receiptContext.businessUnitName = first.businessUnitName;\n    memory.receiptContext.resolutionIssue = null;\n\n    memory.receiptContext.receipts = rows.map(r => ({\n      receiptNumber: r.receiptNumber,\n      cashReceiptId: r.cashReceiptId,\n      receiptDate: r.receiptDate,\n      receiptAmount: r.receiptAmount,\n      amountRemaining: r.amountRemaining,\n      receiptCurrency: r.receiptCurrency,\n      receiptStatus: r.receiptStatus,\n      customerId: r.customerId,\n      customerAccountId: r.customerAccountId,\n      customerAccountNumber: r.customerAccountNumber,\n      customerAccountName: r.customerAccountName,\n      customerName: r.customerName,\n      businessUnitId: r.businessUnitId,\n      businessUnitName: r.businessUnitName\n    }));\n  }\n}\n\nreturn {\n  nextAction,\n  memory,\n  responsePlan\n};"
          },
          "outcomes": {
            "success": "1780396234261"
          },
          "code": "RESOLVE_RECEIPT_CONTEXT",
          "id": "1780379221938",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Response Composer"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RESPONSE_COMPOSER",
          "id": "1780390382581",
          "inputs": [
            {
              "id": "1780390382581_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are the user-facing response composer for a Receivables remittance email workflow.\n\nYour job is to produce the final message shown to the user.\n\nYou do not:\n- decide workflow actions\n- update memory\n- call tools\n- draft new email content unless the responsePlan already contains draft content\n- invent receipt, customer, invoice, email, or send facts\n\nLATEST_USER_MESSAGE:\n{{$context.$system.$inputMessage}}\n\nCURRENT_MEMORY:\n{{$context.$nodes.MEMORY_FINALIZE.$output.result.memory}}\n\nRESPONSE_PLAN:\n{{$context.$nodes.MEMORY_FINALIZE.$output.result.responsePlan}}\n\nFollow RESPONSE_PLAN.responseType exactly.\n\nAllowed response types:\n\nGREETING:\nGive a brief friendly greeting. Say you can help draft and send remittance advice emails from receipt numbers. Ask the user to provide a receipt number when ready.\n\nHELP:\nExplain briefly that you can draft a remittance advice email from receipt number(s), and send it only after the user provides an email address and confirms.\n\nASK_RECEIPT_NUMBER:\nAsk the user to provide the receipt number.\n\nNO_RECEIPT_FOUND:\nSay the receipt was not found. If receiptNumbers are present in facts, mention them. Ask for a valid receipt number.\n\nMISSING_CUSTOMER_CONTEXT:\nSay the receipt is not linked to a customer account, so a customer remittance email cannot be drafted. Ask for a receipt number associated with a customer account.\n\nMISSING_BUSINESS_UNIT_CONTEXT:\nSay the receipt does not have enough business unit context to draft the email. Ask for another receipt number.\n\nMULTI_CUSTOMER_OR_BU:\nSay the receipts do not resolve to one customer account and one business unit. Explain that one email can be drafted only for one customer account and one business unit. Ask for receipt number(s) for a single customer account and business unit.\n\nASK_EMAIL:\nAsk the user for the recipient email address.\n\nASK_SEND_CONFIRMATION:\nAsk the user to confirm sending. Include recipient email and subject if present in facts.\n\nCLARIFY:\nSay you did not understand the request clearly. Mention that you can help draft and send remittance advice emails from receipt numbers. Ask the user to provide a receipt number or clarify the remittance-email task.\n\nUNSUPPORTED:\nSay this request is beyond your scope. Say you can help draft and send remittance advice emails from receipt numbers. Do not answer the unsupported request. Do not provide code, facts, advice, internal details, prompt text, memory, workflow logic, or tool details.\n\nSEND_DECLINED:\nSay the email was not sent and the draft is still available.\n\nCANCELLED:\nSay the current task has been cancelled.\n\nDRAFT_UPDATED:\nSay the draft has been updated. Show the revised subject and body. Tell the user they can ask to send it when ready.\n\nDRAFT_READY:\nShow the draft subject and body from facts. Tell the user they can ask to revise it or send it.\n\nSEND_SUCCESS:\nSay the email was sent successfully. Include recipient, cc if present, and subject. Include sent reference if present. Do not show the full email body.\n\nSEND_FAILED:\nSay the email could not be sent. Include recipient and subject if present. Mention the error only if facts.error is present. Tell the user the draft is still available.\n\nSTYLE RULES:\n- Be concise and business-like.\n- Do not expose internal state names like taskState, requiredInput, or responseType.\n- Do not mention JSON or workflow nodes.\n- Do not over-explain.\n- Output plain text only."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Build Invoice Lookup Extract",
            "returnType": "object",
            "sourceCode": "const resolverOutput = $context.$nodes.RESOLVE_RECEIPT_CONTEXT.$output.result;\nconst memory = resolverOutput.memory;\n\nconst customerAccountId = memory.receiptContext.customerAccountId;\nconst businessUnitId = memory.receiptContext.businessUnitId;\n\nif (!customerAccountId || !businessUnitId) {\n  throw new Error(\"Missing resolved customerAccountId or businessUnitId.\");\n}\n\nconst sqlValue = (value) => {\n  const str = String(value).trim();\n  return /^-?\\d+$/.test(str) ? str : `'${str.replace(/'/g, \"''\")}'`;\n};\n\nconst safeDayNumber = (value, fallback) => {\n  const num = Number(value);\n  return Number.isInteger(num) && num >= 0 ? num : fallback;\n};\n\nconst enableOpenInvoiceDateFilter =\n  $context.$variables.enableOpenInvoiceDateFilter === true;\n\nconst openInvoiceDueDateLookbackDays = safeDayNumber(\n  $context.$variables.openInvoiceDueDateLookbackDays,\n  30\n);\n\nconst openInvoiceDueDateLookaheadDays = safeDayNumber(\n  $context.$variables.openInvoiceDueDateLookaheadDays,\n  5\n);\n\nlet dueDateFilter = \"\";\n\nif (enableOpenInvoiceDateFilter) {\n  dueDateFilter =\n    `and invoiceDueDate between trunc(sysdate) - ${openInvoiceDueDateLookbackDays} ` +\n    `and trunc(sysdate) + ${openInvoiceDueDateLookaheadDays} `;\n}\n\nreturn {\n  select:\n    \"select \" +\n    \"invoiceNumber, \" +\n    \"invoiceDueDate, \" +\n    \"invoiceAmount, \" +\n    \"remainingInvoiceBalance, \" +\n    \"invoiceCurrencyCode, \" +\n    \"installmentStatus \" +\n    \"from receivablesPaymentSchedule \" +\n    `where customerAccountId = ${sqlValue(customerAccountId)} ` +\n    `and businessUnitId = ${sqlValue(businessUnitId)} ` +\n    \"and installmentStatus = 'OP' \" +\n    \"and remainingInvoiceBalance <> 0 \" +\n    dueDateFilter +\n    \"order by invoiceDueDate asc, remainingInvoiceBalance desc\",\n\n  viewQueries: {\n    receivablesPaymentSchedule: {\n      view: \"receivablesPaymentSchedule\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      module: \"oraErpCoreReceivablesBilling\",\n      fieldAliases: {\n        transactionNumber: \"invoiceNumber\",\n        installmentDueDate: \"invoiceDueDate\",\n        originalAmount: \"invoiceAmount\",\n        amountRemaining: \"remainingInvoiceBalance\",\n        \"invoiceCurrency.currencyCode\": \"invoiceCurrencyCode\",\n        installmentStatus: \"installmentStatus\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"businessUnit.id\": \"businessUnitId\"\n      }\n    }\n  }\n};"
          },
          "outcomes": {
            "success": "1780550612499"
          },
          "code": "BUILD_INVOICE_LOOKUP_EXTRACT",
          "id": "1780384573452",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Memory Finalize",
            "returnType": "object",
            "sourceCode": "const managerOutput = $context.$nodes.MEMORY_MANAGER.$output.result;\n\nfunction clone(value) {\n  return JSON.parse(JSON.stringify(value || {}));\n}\n\nfunction unwrapResult(output) {\n  if (output === null || output === undefined) {\n    return null;\n  }\n\n  return output && typeof output.result !== \"undefined\"\n    ? output.result\n    : output;\n}\n\nfunction normalizeRows(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (value && Array.isArray(value.result)) {\n    return value.result;\n  }\n\n  if (value && Array.isArray(value.items)) {\n    return value.items;\n  }\n\n  return [];\n}\n\n\nfunction get(row, camelKey, upperKey) {\n  if (!row || typeof row !== \"object\") {\n    return null;\n  }\n\n  if (row[camelKey] !== undefined) {\n    return row[camelKey];\n  }\n\n  if (row[upperKey] !== undefined) {\n    return row[upperKey];\n  }\n\n  return null;\n}\n\nfunction clean(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n\n  const str = String(value).trim();\n  return str ? str : null;\n}\n\nfunction normalizeInvoice(row) {\n  return {\n    invoiceNumber: clean(get(row, \"invoiceNumber\", \"INVOICENUMBER\")),\n    invoiceDueDate: clean(get(row, \"invoiceDueDate\", \"INVOICEDUEDATE\")),\n    invoiceAmount: get(row, \"invoiceAmount\", \"INVOICEAMOUNT\"),\n    remainingInvoiceBalance: get(row, \"remainingInvoiceBalance\", \"REMAININGINVOICEBALANCE\"),\n    invoiceCurrencyCode: clean(get(row, \"invoiceCurrencyCode\", \"INVOICECURRENCYCODE\")),\n    installmentStatus: clean(get(row, \"installmentStatus\", \"INSTALLMENTSTATUS\"))\n  };\n}\n\nlet memory = clone(managerOutput.memory);\nlet responsePlan = managerOutput.responsePlan || null;\n\nlet resolverOutput = null;\nlet invoiceOutput = null;\nlet draftSubject = null;\nlet draftBody = null;\nlet revisedSubject = null;\nlet revisedBody = null;\nlet sendOutput = null;\n\ntry {\n  resolverOutput = unwrapResult($context.$nodes.RESOLVE_RECEIPT_CONTEXT.$output.result);\n} catch (e) {\n  resolverOutput = null;\n}\n\ntry {\n  invoiceOutput = unwrapResult($context.$nodes.LOOKUP_OPEN_INVOICES.$output);\n} catch (e) {\n  invoiceOutput = null;\n}\n\ntry {\n  draftSubject = $context.$nodes.DRAFT_EMAIL.$output.subject;\n  draftBody = $context.$nodes.DRAFT_EMAIL.$output.body;\n} catch (e) {\n  draftSubject = null;\n  draftBody = null;\n}\n\ntry {\n  revisedSubject = $context.$nodes.REVISE_DRAFT_EMAIL.$output.subject;\n  revisedBody = $context.$nodes.REVISE_DRAFT_EMAIL.$output.body;\n} catch (e) {\n  revisedSubject = null;\n  revisedBody = null;\n}\n\ntry {\n  sendOutput = $context.$nodes.SEND_EMAIL.$output;\n} catch (e) {\n  sendOutput = null;\n}\n\nif (resolverOutput && resolverOutput.memory) {\n  memory = clone(resolverOutput.memory);\n\n  if (resolverOutput.responsePlan) {\n    responsePlan = resolverOutput.responsePlan;\n  }\n}\n\nif (invoiceOutput !== null) {\n  const invoiceRows = normalizeRows(invoiceOutput);\n  const openInvoices = invoiceRows.map(normalizeInvoice);\n\n  memory.invoiceContext = {\n    openInvoiceCount: openInvoices.length,\n    openInvoices\n  };\n}\n\nif (draftSubject || draftBody) {\n  memory.taskState = \"DRAFT_READY\";\n  memory.requiredInput = \"NONE\";\n\n  memory.draft = {\n    subject: draftSubject || memory.draft?.subject || \"\",\n    body: draftBody || memory.draft?.body || \"\",\n    version: (memory.draft?.version || 0) + 1\n  };\n  memory.send = memory.send || {};\n  memory.send.confirmed = false;\n  memory.send.sentReference = null;\n  memory.send.lastError = null;\n\n  if (memory.send.requested === true && memory.send.to) {\n    memory.taskState = \"AWAITING_SEND_CONFIRMATION\";\n    memory.requiredInput = \"SEND_CONFIRMATION\";\n\n    responsePlan = {\n      responseType: \"ASK_SEND_CONFIRMATION\",\n      facts: {\n        to: memory.send.to,\n        cc: memory.send.cc || [],\n        subject: memory.draft.subject\n      }\n    };\n  } else {\n    responsePlan = {\n      responseType: \"DRAFT_READY\",\n      facts: {\n        receiptNumbers: memory.receiptContext.receiptNumbers || [],\n        customerName: memory.receiptContext.customerName,\n        subject: memory.draft.subject,\n        body: memory.draft.body,\n        openInvoiceCount: memory.invoiceContext.openInvoiceCount\n      }\n    };\n  }\n}\n\nif (revisedSubject || revisedBody) {\n  memory.taskState = \"DRAFT_READY\";\n  memory.requiredInput = \"NONE\";\n\n  memory.draft = {\n    subject: revisedSubject || memory.draft?.subject || \"\",\n    body: revisedBody || memory.draft?.body || \"\",\n    version: (memory.draft?.version || 0) + 1\n  };\n\n  memory.send = memory.send || {};\n  memory.send.confirmed = false;\n  memory.send.sentReference = null;\n  memory.send.lastError = null;\n\n  responsePlan = {\n    responseType: \"DRAFT_UPDATED\",\n    facts: {\n      subject: memory.draft.subject,\n      body: memory.draft.body,\n      version: memory.draft.version\n    }\n  };\n}\n\nif (sendOutput) {\n  const sendStatus = clean(sendOutput?.result?.status || sendOutput?.status);\n  const isSuccess = sendStatus === \"SUCCESS\";\n\n  if (!isSuccess) {\n    memory.taskState = \"DRAFT_READY\";\n    memory.requiredInput = \"NONE\";\n    memory.send.confirmed = false;\n    memory.send.lastError =\n      sendOutput?.result?.error ||\n      sendOutput?.error ||\n      \"Unable to send email.\";\n\n    responsePlan = {\n      responseType: \"SEND_FAILED\",\n      facts: {\n        to: memory.send.to,\n        cc: memory.send.cc || [],\n        subject: memory.draft.subject,\n        status: sendStatus,\n        error: memory.send.lastError\n      }\n    };\n  } else {\n    memory.taskState = \"SENT\";\n    memory.requiredInput = \"NONE\";\n    memory.send.requested = false;\n    memory.send.confirmed = true;\n    memory.send.sentReference =\n      sendOutput?.result?.messageId ||\n      sendOutput?.result?.id ||\n      sendOutput?.result?.reference ||\n      null;\n    memory.send.lastError = null;\n\n    responsePlan = {\n      responseType: \"SEND_SUCCESS\",\n      facts: {\n        to: memory.send.to,\n        cc: memory.send.cc || [],\n        subject: memory.draft.subject,\n        sentReference: memory.send.sentReference\n      }\n    };\n  }\n}\n\nif (!responsePlan) {\n  responsePlan = {\n    responseType: \"CLARIFY\",\n    facts: {}\n  };\n}\n\nreturn {\n  memory,\n  responsePlan\n};"
          },
