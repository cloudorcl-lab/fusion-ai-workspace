            "name": "Extract ERP Email Message Id",
            "returnType": "string",
            "sourceCode": "let messageId =\n  ($context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders &&\n    $context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders.location &&\n    Array.isArray($context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders.location) &&\n    $context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders.location.length > 0)\n    ? $context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders.location[0].substring(\n        $context.$nodes.CREATE_ERP_EMAIL_MESSAGE.$responseHeaders.location[0].lastIndexOf(\"/\") + 1\n      )\n    : null;\n\nreturn messageId;"
          },
          "outcomes": {
            "success": "1780651378557"
          },
          "code": "EXTRACT_ERP_EMAIL_MESSAGE_ID",
          "id": "1780642542362",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Customer Message Payload",
            "returnType": "array",
            "sourceCode": "const memory = $context.$nodes.MEMORY_MANAGER.$output.result.memory;\nconst messageId = $context.$nodes.EXTRACT_ERP_EMAIL_MESSAGE_ID.$output.result;\n\nconst receipts = Array.isArray(memory.receiptContext?.receipts)\n  ? memory.receiptContext.receipts\n  : [];\n\nconst customerId = memory.receiptContext?.customerId;\nconst customerAccountId = memory.receiptContext?.customerAccountId;\nconst businessUnitId = memory.receiptContext?.businessUnitId;\n\nif (!messageId) {\n  throw new Error(\"Missing ERP email messageId.\");\n}\n\nif (!customerAccountId) {\n  throw new Error(\"Missing customerAccountId.\");\n}\n\nif (!businessUnitId) {\n  throw new Error(\"Missing businessUnitId.\");\n}\n\nif (!receipts.length) {\n  throw new Error(\"Missing resolved receipts.\");\n}\n\nfunction clean(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n\n  const str = String(value).trim();\n  return str ? str : null;\n}\n\nconst cleanCustomerId = clean(customerId);\nconst cleanCustomerAccountId = clean(customerAccountId);\nconst cleanBusinessUnitId = clean(businessUnitId);\nconst cleanMessageId = clean(messageId);\n\nreturn receipts.map((receipt) => {\n  const cashReceiptId = clean(receipt.cashReceiptId);\n\n  if (!cashReceiptId) {\n    throw new Error(\"Missing cashReceiptId for one resolved receipt.\");\n  }\n\n  const payload = {\n    customerAccount: {\n      customerAccountId: cleanCustomerAccountId\n    },\n    receipt: {\n      cashReceiptId\n    },\n    businessUnit: {\n      id: cleanBusinessUnitId\n    },\n    emailMessage: {\n      messageId: cleanMessageId\n    }\n  };\n\n  if (cleanCustomerId) {\n    payload.customer = {\n      id: cleanCustomerId\n    };\n  }\n\n  return payload;\n});"
          },
          "outcomes": {
            "success": "1780651481345"
          },
          "code": "BUILD_CUSTOMER_MESSAGE_PAYLOAD",
          "id": "1780651378557",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
