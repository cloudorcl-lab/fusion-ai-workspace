          "id": "node_summary",
          "inputs": [
            {
              "id": "input_summary",
              "name": "prompt",
              "type": "string",
              "value": "Data:\n{{$context.$nodes.BUILD_PRECOMPUTED_OUTPUT.$output.result.violations}}\n\nCreate a summary in 50 words or less for the given violation data."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Action Parameters",
            "returnType": "object",
            "sourceCode": "var oraActionStr = $context.$app.$OraAction || '{}';\nvar oraAction = {};\ntry {\n  oraAction = JSON.parse(oraActionStr);\n} catch(e) {\n  oraAction = {};\n}\nvar userName = oraAction.userName || $context.$nodes.EXTRACT_USER.$output.result.User || '';\nvar roleCode = oraAction.roleCode || '';\nvar roleName = oraAction.roleName || '';\n\nvar result = {\n  userName: userName,\n  roleCode: roleCode,\n  roleName: roleName\n};\nreturn result;"
          },
          "outcomes": {
            "success": "set_action_vars"
          },
          "code": "EXTRACT_ACTION_PARAMETERS",
          "id": "extract_action_params",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"userName\": {\"type\": \"string\"},\n    \"roleCode\": {\"type\": \"string\"},\n    \"roleName\": {\"type\": \"string\"}\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Action Variables"
          },
          "outcomes": {
            "success": "node_invoke_action"
          },
          "code": "set_action_vars",
          "id": "set_action_vars",
          "inputs": [
            {
              "id": "set_userName",
              "name": "userName",
              "scope": "JOB",
              "type": "string",
