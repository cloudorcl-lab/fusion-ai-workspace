{
  "workflowId": "100002355227054",
  "workflowCode": "ORA_RMC_USER_ACCESS_DETAILS_ANALYST",
  "name": "RMC User Access Details Analyst",
  "description": "Presents access violations for a selected account, highlights revocation candidates, and answers follow-up detail queries.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "EXTRACT_USER"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "name": "Extract User",
            "returnType": "object",
            "sourceCode": "var contextApp = $context.$triggers.REST.$input.OraAppContext || '';\nvar username = '';\nvar displayUser = '';\nif (contextApp && contextApp.indexOf && contextApp.indexOf('|') !== -1) {\n  var parts = contextApp.split('|');\n  username = parts[0];\n  displayUser = parts[1] || '';\n} else if (contextApp) {\n  username = String(contextApp);\n  displayUser = String(contextApp);\n}\nvar result = { User: username, DisplayUser: displayUser };\nreturn result;"
          },
          "outcomes": {
            "success": "GET_STORED_USER_VIOLATION_SUMMARY"
          },
          "code": "EXTRACT_USER",
          "id": "EXTRACT_USER",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_GRC_OTHER_DESCRIPTIONCLOB",
            "functionName": "get_announcements-DescriptionClob",
            "name": "Get Stored User Violation Summary"
          },
          "outcomes": {
            "success": "GET_DETAIL_USER_VIOLATIONS_BY_USER"
          },
          "code": "GET_STORED_USER_VIOLATION_SUMMARY",
          "id": "GET_STORED_USER_VIOLATION_SUMMARY",
          "inputs": [
            {
              "id": "GET_STORED_USER_VIOLATION_SUMMARY_1",
              "name": "announcements_Id",
              "type": "string",
              "value": "894871897531003"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Detail User Violations By User",
            "returnType": "array",
            "sourceCode": "var data = $context.$nodes.GET_STORED_USER_VIOLATION_SUMMARY.$output;\nif (!data) return [];\nvar parsedData = data;\nif (typeof data === 'string') {\n  try {\n    parsedData = JSON.parse(data);\n  } catch (e) {\n    var trimmed = data.trim();\n    if ((trimmed.charAt(0) === '\"' && trimmed.charAt(trimmed.length-1) === '\"')) {\n      try {\n        parsedData = JSON.parse(trimmed.slice(1, -1));\n      } catch (e2) {\n        return [];\n      }\n    } else {\n      return [];\n    }\n  }\n}\nif (!Array.isArray(parsedData)) return [];\nvar username = $context.$nodes.EXTRACT_USER.$output.result.User;\nvar filtered = [];\nfor (var i = 0; i < parsedData.length; i++) {\n  if (parsedData[i].UserName === username) {\n    filtered.push(parsedData[i]);\n  }\n}\nvar result = filtered;\nreturn result;"
          },
          "outcomes": {
            "success": "BUILD_PRECOMPUTED_OUTPUT"
          },
          "code": "GET_DETAIL_USER_VIOLATIONS_BY_USER",
          "id": "GET_DETAIL_USER_VIOLATIONS_BY_USER",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"array\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Precomputed Output",
            "returnType": "object",
            "sourceCode": "var violations = $context.$nodes.GET_DETAIL_USER_VIOLATIONS_BY_USER.$output.result || [];\nviolations.sort(function(a, b) { return (b.NumIncidents || 0) - (a.NumIncidents || 0); });\nvar username = $context.$nodes.EXTRACT_USER.$output.result.User || '';\nvar rows = [];\nvar seenRoles = {};\nvar insightStrings = [];\nvar maxRows = 15;\nvar totalViolations = violations.length;\nvar intraTemplates = ['Violates control: ', 'Causes conflict in: ', 'Risk from: ', 'Excessive access: '];\nvar sodTemplates = ['Conflicts with: ', 'SoD violation with: ', 'Incompatible with: ', 'Segregation issue with: '];\nvar roleIndex = 0;\nfor (var i = 0; i < violations.length; i++) {\n  var v = violations[i];\n  var controlName = v.ControlName || '';\n  var roleName = v.Role || '';\n  var entitlementName = v.Entitlement || '';\n  var conflictingRoles = v.ConflictingRoles || '';\n  var incidentCount = String(v.NumIncidents || 0);\n  var isIntraRole = v.IsIntraRoleViol === 1 || v.IsIntraRoleViol === '1';\n  var roleCode = v.RoleCode || '';\n  var intraRoleBadge = { type: 'badge', text: isIntraRole ? 'YES' : 'NO', priority: isIntraRole ? 'alert' : 'medium' };\n  if (i < maxRows) {\n    var row = { cells: [controlName, roleName, entitlementName, conflictingRoles, incidentCount, intraRoleBadge] };\n    rows.push(row);\n  }\n  if (!seenRoles[roleName]) {\n    seenRoles[roleName] = true;\n    var followUpCmd = 'ora.Agent({\\\"command\\\": \\\"revokeRole\\\", \\\"userName\\\": \\\"' + username + '\\\", \\\"roleCode\\\": \\\"' + roleCode + '\\\", \\\"roleName\\\": \\\"' + roleName + '\\\"})';\n    var tplIdx = roleIndex % 4;\n    var shortDesc = isIntraRole ? intraTemplates[tplIdx] + controlName : sodTemplates[tplIdx] + conflictingRoles;\n    var insightObj = { title: 'Revoke ' + roleName, shortDescription: shortDesc, actionText: 'Revoke Role', followUpCommand: followUpCmd, priority: !isIntraRole };\n    insightStrings.push('<oraInsight>' + JSON.stringify(insightObj) + '</oraInsight>');\n    roleIndex++;\n  }\n}\nif (totalViolations > maxRows) {\n  rows.push({ cells: ['... and ' + (totalViolations - maxRows) + ' more violations', '', '', '', '', ''] });\n}\nvar widget = { title: 'Top ' + Math.min(totalViolations, maxRows) + ' of ' + totalViolations, patternId: 'multiRecordWidget', description: 'List of access violations by role and entitlement', properties: { subtitle: 'Summary of control violations and incidents', cols: ['Control Violated', 'Role', 'Entitlement', 'Conflicting Roles', '# Incidents', 'Intra-role'], rows: rows } };\nvar widgetOutput = '<oraInfoDisplay key=\"list\">' + JSON.stringify(widget) + '</oraInfoDisplay>';\nvar insightsOutput = insightStrings.join('');\nvar result = { widgetOutput: widgetOutput, insightsOutput: insightsOutput, violations: violations, _debug: { violationCount: totalViolations, uniqueRoles: Object.keys(seenRoles).length, rowsDisplayed: rows.length } };\nreturn result;"
          },
          "outcomes": {
            "success": "node_switch"
          },
          "code": "BUILD_PRECOMPUTED_OUTPUT",
          "id": "BUILD_PRECOMPUTED_OUTPUT",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    }\n  }\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Route by Message Hint"
          },
          "outcomes": {
            "InitActions": "node_init_actions",
            "Query": "node_handle_query",
            "InitDisplay": "node_init_display",
            "InitCommunications": "node_init_comms",
            "Summary": "node_summary",
            "InvokeAction": "extract_action_params",
            "FillParameters": "node_fill_params",
            "InitSubtitle": "node_init_subtitle"
          },
          "code": "ROUTE_BY_MESSAGE_HINT",
          "convergenceTargetId": "end",
          "id": "node_switch",
          "inputs": [
            {
              "id": "input_switch_case",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_INSIGHTS"
              ],
