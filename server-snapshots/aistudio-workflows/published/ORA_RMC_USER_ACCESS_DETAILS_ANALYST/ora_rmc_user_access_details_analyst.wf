              "name": "prompt",
              "type": "string",
              "value": "<chatHistory>{{$context.$system.$chatHistory}}</chatHistory>\n\nUser Violations Data:\n{{$context.$nodes.BUILD_PRECOMPUTED_OUTPUT.$output.result.violations}}\n\nUser Query:\n{{$context.$system.$inputMessage}}\n\nAnswer the user's question based on the violation data above."
            }
          ],
