                {
                  "metadata": {
                    "name": "codeBlockToSetValues",
                    "returnType": "object",
                    "sourceCode": "let arrItemObj = $context.$nodes.FORLOOP.$currentItem;\n\nif(arrItemObj.itemType == \"item\"){\n    //because we have merged both summary & item agent together\n    arrItemObj[\"employee_checkin_summary\"] = $context.$nodes.FORLOOP?.EMPLOYEECHECKINSUMMARYOFSUMMARY?.$output?.employeeCheckInDataOutput ? $context.$nodes.FORLOOP.EMPLOYEECHECKINSUMMARYOFSUMMARY.$output.employeeCheckInDataOutput : \"\";\n\n    arrItemObj[\"manager_checkin_summary\"] = $context.$nodes.FORLOOP?.MANAGERCHECKINSUMMARYOFSUMMARY?.$output?.managerCheckInDataOutput ? $context.$nodes.FORLOOP.MANAGERCHECKINSUMMARYOFSUMMARY.$output.managerCheckInDataOutput : \"\";\n\n}\narrItemObj[\"interim_feedback_summary\"] = $context.$nodes.FORLOOP?.INTERIMFEEDBACKSUMMARYOFSUMMARY?.$output?.interimFeedbackSummary ? $context.$nodes.FORLOOP.INTERIMFEEDBACKSUMMARYOFSUMMARY.$output.interimFeedbackSummary : \"\";  \n\narrItemObj[\"participant_feedback_summary\"] = $context.$nodes.FORLOOP?.PARTICIPANTFEEDBACKSUMMARYOFSUMMARY?.$output?.participantFeedbackOutput ? $context.$nodes.FORLOOP.PARTICIPANTFEEDBACKSUMMARYOFSUMMARY.$output.participantFeedbackOutput : \"\" ;\n\nreturn arrItemObj;"
                  },
                  "outcomes": {
                    "success": "1765791531190"
                  },
                  "code": "CODEBLOCKTOSETVALUES",
                  "id": "1765791509739",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
