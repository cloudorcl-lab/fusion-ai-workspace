        {
          "metadata": {
            "name": "Construct Relevant Data",
            "returnType": "array",
            "sourceCode": "const rawArr = $context.$nodes.GET_WORK_ORDER_COST_AND_ESTIMATES_LOOP.$output ?? [];\n\nconst toNum = (v) => {\n  const n = Number(String(v ?? '').replace(/[, ]+/g, ''));\n  return Number.isFinite(n) ? n : 0;\n};\n\nconst collections = (Array.isArray(rawArr) ? rawArr : [])\n  .map(s => { try { return JSON.parse(String(s)); } catch { return null; } })\n  .filter(o => o && Array.isArray(o.items) && o.items.length > 0);\n\n//Flatten to a single items array\nconst items = collections.flatMap(o => o.items);\n\nconst byWO = new Map();\n\nfor (const it of items) {\n  const wo = it?.WorkOrderNumber;\n  if (!wo) continue;\n\n  const lineTotal = toNum(it?.TotalCost) || (toNum(it?.UnitCost) * toNum(it?.EstimatedQuantity));\n\n  const rec = byWO.get(wo) || { WorkOrderNumber: wo, CurrencyCode: null, MaterialCost: 0, ResourceCost: 0, TotalCost: 0 };\n\n  const hasItem = it?.ItemNumber != null; \n  const hasResource = (it?.ResourceType ?? '') !== ''; \n\n  if (hasResource && !hasItem) {\n    rec.ResourceCost += lineTotal;\n  } else if (hasItem && !hasResource) {\n    rec.MaterialCost += lineTotal;\n  } else {\n    if ((it?.ResourceType ?? '').toUpperCase() === 'LABOR') rec.ResourceCost += lineTotal;\n    else rec.MaterialCost += lineTotal;\n  }\n  \n  rec.TotalCost = rec.MaterialCost + rec.ResourceCost;\n  rec. CurrencyCode = it?. CurrencyCode;\n  byWO.set(wo, rec);\n}\n\nconst result = Array.from(byWO.values());\nreturn result;"
          },
          "outcomes": {
            "success": "1768487696941"
          },
          "code": "CONSTRUCT_RELEVANT_DATA",
