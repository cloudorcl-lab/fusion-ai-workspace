        {
          "metadata": {
            "name": "Validate Conditions",
            "returnType": "array",
            "sourceCode": "var rawConditions = Array.isArray($context.$variables.conditions)\n  ? $context.$variables.conditions\n  : [];\n\nvar attrsRoot = $context.$variables.attributes || {};\nvar attrs = attrsRoot.attributes ? attrsRoot.attributes : attrsRoot;\n\nvar catalog = attrs;\n\nvar LEVEL_KEY_MAP = {\n  allProductFamiliesAttr: 'allProductFamilies',\n  productFamilyAttr: 'productFamily',\n  productLineAttr: 'productLine',\n  modelAttr: 'model'\n};\n\nvar attrLevelLookup = {};\n\n['configurable', 'nonConfigurable', 'system', 'account', 'user'].forEach(function (bucket) {\n  var section = catalog[bucket];\n  if (!section) { return; }\n\n  Object.keys(LEVEL_KEY_MAP).forEach(function (levelKey) {\n    var levelName = LEVEL_KEY_MAP[levelKey];\n    var list = section[levelKey];\n    if (!Array.isArray(list)) { return; }\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) { return; }\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) { return; }\n      attrLevelLookup[key] = levelName;\n    });\n  });\n});\n\nvar attrMeta = {};\n['configurable', 'nonConfigurable', 'system', 'account', 'user'].forEach(function (bucket) {\n  var section = attrs[bucket];\n  if (!section) { return; }\n\n  Object.keys(section).forEach(function (levelKey) {\n    var list = section[levelKey];\n    if (!Array.isArray(list)) { return; }\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) { return; }\n\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) { return; }\n\n      var menu = [];\n      var menuItems = attr.menuItems;\n      if (Array.isArray(menuItems)) {\n        menu = menuItems.map(function (m) { return String(m.itemValue); });\n      } else if (menuItems && Array.isArray(menuItems.items)) {\n        menu = menuItems.items.map(function (m) { return String(m.itemValue); });\n      }\n\n      attrMeta[key] = {\n        attrVar: attr.variableName,\n        inputType: attr.inputTypeCode || '',\n        dataType: attr.dataType || '',\n        menuValues: menu.filter(function (v) { return v !== undefined && v !== null; })\n      };\n    });\n  });\n});\n\nfunction getMeta(attrVar) {\n  if (!attrVar) { return null; }\n  return attrMeta[String(attrVar).trim().toLowerCase()] || null;\n}\n\nvar operatorMap = {\n  SingleSelectMenu: ['EqualTo', 'NotEqualTo'],\n  MultiSelectMenu: ['EqualTo', 'NotEqualTo', 'Contains', 'NotContains'],\n  Boolean: ['EqualTo'],\n  Currency: ['LessThan', 'LessThanEqualTo', 'EqualTo', 'NotEqualTo', 'GreaterThan', 'GreaterThanEqualTo', 'Between'],\n  Date: ['EqualTo', 'NotEqualTo', 'Before', 'OnOrBefore', 'After', 'OnOrAfter', 'Between'],\n  TextField_text: ['EqualTo', 'NotEqualTo', 'Contains', 'NotContains', 'StartsWith', 'NotStartsWith', 'EndsWith', 'NotEndsWith'],\n  TextField_integer: ['LessThan', 'LessThanEqualTo', 'EqualTo', 'NotEqualTo', 'GreaterThan', 'GreaterThanEqualTo', 'Between'],\n  TextField_float: ['LessThan', 'LessThanEqualTo', 'EqualTo', 'NotEqualTo', 'GreaterThan', 'GreaterThanEqualTo', 'Between']\n};\n\nfunction allowedOperators(meta) {\n  if (!meta) { return []; }\n  if (meta.inputType === 'TextField') {\n    var dt = (meta.dataType || '').toLowerCase();\n    if (dt === 'integer') { return operatorMap.TextField_integer; }\n    if (dt === 'float') { return operatorMap.TextField_float; }\n    return operatorMap.TextField_text;\n  }\n  return operatorMap[meta.inputType] || [];\n}\n\nfunction cleanSelectableValues(meta, values) {\n  var list = Array.isArray(values) ? values.map(String) : [];\n  if (!meta || !meta.menuValues.length) { return list; }\n\n  var menuSet = {};\n  meta.menuValues.forEach(function (v) { menuSet[v.toLowerCase()] = v; });\n\n  var filtered = [];\n  list.forEach(function (val) {\n    var hit = menuSet[val.toLowerCase()];\n    if (hit !== undefined) { filtered.push(hit); }\n  });\n\n  if (filtered.length === 0 && meta.menuValues.length > 0) {\n    filtered = [meta.menuValues[0]];\n  }\n  return filtered;\n}\n\nfunction buildSentinel() {\n  return [\n    {\n      criteria: {\n        criteriaType: 'Attribute',\n        attribute: '_alwaysTrue'\n      },\n      operator: 'EqualTo',\n      value: {\n        valueType: 'Static',\n        values: ['true']\n      },\n      index: 1\n    }\n  ];\n}\n\nvar cleanedConditions = [];\nrawConditions.forEach(function (cond) {\n  if (!cond || !cond.criteria || cond.criteria.criteriaType !== 'Attribute') { return; }\n\n  var meta = getMeta(cond.criteria.attribute);\n  if (!meta) { return; }\n\n  var op = cond.operator ? String(cond.operator) : '';\n  var allowed = allowedOperators(meta);\n  if (allowed.length > 0 && allowed.indexOf(op) === -1) { return; }\n\n  var valueObj = cond.value || { valueType: 'Static', values: [] };\n  var newValue = {\n    valueType: valueObj.valueType || 'Static',\n    values: Array.isArray(valueObj.values) ? valueObj.values.map(String) : []\n  };\n\n  if (meta.inputType === 'SingleSelectMenu' || meta.inputType === 'MultiSelectMenu') {\n    newValue.values = cleanSelectableValues(meta, newValue.values);\n  } else if (meta.inputType !== 'MultiSelectMenu' && meta.inputType !== 'SingleSelectMenu') {\n    if (newValue.values.length === 0 && valueObj.values && valueObj.values.length > 0) {\n      newValue.values = [String(valueObj.values[0])];\n    } else if (newValue.values.length > 1) {\n      newValue.values = [newValue.values[0]];\n    }\n  }\n\n  if (op === 'Between') {\n    var rangeOp = valueObj.rangeOperator ? String(valueObj.rangeOperator) : null;\n    var rangeVal = Array.isArray(valueObj.rangeValue) ? valueObj.rangeValue.map(String) : [];\n    if (!rangeOp || rangeVal.length === 0) { return; }\n    newValue.rangeOperator = rangeOp;\n    newValue.rangeValue = [rangeVal[0]];\n  }\n\n  var cleaned = {\n    criteria: {\n      criteriaType: 'Attribute',\n      attribute: meta.attrVar\n    },\n    operator: op,\n    value: newValue\n  };\n\n  var lookupKey = String(meta.attrVar).trim().toLowerCase();\n  var inferredLevel = attrLevelLookup[lookupKey];\n\n  if (cond.level !== undefined) {\n    cleaned.level = cond.level;\n  } else if (inferredLevel) {\n    cleaned.level = inferredLevel;\n  }\n\n  cleaned.index = cleanedConditions.length + 1;\n  cleanedConditions.push(cleaned);\n});\n\nif (cleanedConditions.length === 0) {\n  return buildSentinel();\n}\n\nreturn cleanedConditions;"
          },
