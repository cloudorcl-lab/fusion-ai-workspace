        {
          "metadata": {
            "name": "Get Level",
            "returnType": "string",
            "sourceCode": "// Retrieve the values coming from the REST trigger\nvar pf = $context.$triggers.REST.$input.productFamily || '';\nvar pl = $context.$triggers.REST.$input.productLine  || '';\nvar m  = $context.$triggers.REST.$input.model        || '';\n\n// Determine the correct level\nvar level;\nif (m.trim() !== '') {\n  level = 'model';\n} else if (pl.trim() !== '') {\n  level = 'productLine';\n} else if (pf.trim() !== '') {\n  level = 'productFamily';\n} else {\n  level = 'allProductFamilies';\n}\n\nreturn level;"
          },
          "outcomes": {
            "success": "1775239023603"
          },
          "code": "GET_LEVEL",
          "id": "1775007200676",
          "inputs": [],
          "type": "CODE",
