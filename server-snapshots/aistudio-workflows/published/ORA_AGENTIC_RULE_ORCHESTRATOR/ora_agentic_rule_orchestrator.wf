        {
          "metadata": {
            "name": "Extract Rule Payload",
            "returnType": "object",
            "sourceCode": "var fallback = $context.$variables.currentRuleInstance;\nvar raw = $context.$nodes.CREATE_RULE && $context.$nodes.CREATE_RULE.$output\n  ? $context.$nodes.CREATE_RULE.$output.output\n  : null;\n\nif (!raw) {\n  return fallback;\n}\n\nvar payload;\nif (typeof raw === 'string') {\n  try { payload = JSON.parse(raw); } catch (e) { payload = null; }\n} else {\n  payload = raw;\n}\n\nif (\n  payload &&\n  payload.messages &&\n  Array.isArray(payload.messages) &&\n  payload.messages.length > 0\n) {\n  var first = payload.messages[0];\n  if (\n    first &&\n    first.payload &&\n    first.payload.rawData &&\n    first.payload.rawData.rulePayload\n  ) {\n    return first.payload.rawData.rulePayload;\n  }\n}\n\nreturn fallback;"
          },
