        {
          "id": "1775856346582",
          "code": "VALIDATE_ACTIONS",
          "type": "CODE",
          "metadata": {
            "name": "Validate Actions",
            "sourceCode": "var rawActions = Array.isArray($context.$variables.actions)\n  ? $context.$variables.actions\n  : [];\n\nvar attrsRoot = $context.$variables.attributes || {};\nvar attrs = attrsRoot.attributes ? attrsRoot.attributes : attrsRoot;\nvar catalog = attrs;\n\nvar ruleTypeObj =\n  ($context.$variables.currentRuleInstance && $context.$variables.currentRuleInstance.ruleType) ||\n  ($context.$triggers.REST.$input && $context.$triggers.REST.$input.ruleType) ||\n  {};\n\nvar ruleTypeCode =\n  ruleTypeObj && ruleTypeObj.lookupCode != null\n    ? String(ruleTypeObj.lookupCode)\n    : null;\n\nvar LEVEL_KEY_MAP = {\n  allProductFamiliesAttr: \"allProductFamilies\",\n  productFamilyAttr: \"productFamily\",\n  productLineAttr: \"productLine\",\n  modelAttr: \"model\"\n};\n\nvar attrLevelLookup = {};\n[\"configurable\", \"nonConfigurable\", \"system\", \"account\", \"user\"].forEach(function (bucket) {\n  var section = catalog[bucket];\n  if (!section) return;\n\n  Object.keys(LEVEL_KEY_MAP).forEach(function (levelKey) {\n    var levelName = LEVEL_KEY_MAP[levelKey];\n    var list = section[levelKey];\n    if (!Array.isArray(list)) return;\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) return;\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) return;\n      attrLevelLookup[key] = levelName;\n    });\n  });\n});\n\nvar attrMeta = {};\n[\"configurable\", \"nonConfigurable\", \"system\", \"account\", \"user\"].forEach(function (bucket) {\n  var section = attrs[bucket];\n  if (!section) return;\n\n  Object.keys(section).forEach(function (levelKey) {\n    var list = section[levelKey];\n    if (!Array.isArray(list)) return;\n\n    list.forEach(function (attr) {\n      if (!attr || !attr.variableName) return;\n\n      var key = String(attr.variableName).trim().toLowerCase();\n      if (!key) return;\n\n      var menu = [];\n      var menuItems = attr.menuItems;\n      if (Array.isArray(menuItems)) {\n        menu = menuItems.map(function (m) { return String(m.itemValue); });\n      } else if (menuItems && Array.isArray(menuItems.items)) {\n        menu = menuItems.items.map(function (m) { return String(m.itemValue); });\n      }\n\n      attrMeta[key] = {\n        attrVar: attr.variableName,\n        inputType: attr.inputTypeCode || \"\",\n        dataType: attr.dataType || \"\",\n        menuValues: menu.filter(function (v) { return v !== undefined && v !== null; })\n      };\n    });\n  });\n});\n\nfunction getMeta(attrVar) {\n  if (attrVar === undefined || attrVar === null) return null;\n  return attrMeta[String(attrVar).trim().toLowerCase()] || null;\n}\n\nfunction toStringArray(values) {\n  if (!Array.isArray(values)) return [];\n  return values\n    .filter(function (v) { return v !== undefined && v !== null; })\n    .map(function (v) { return String(v); });\n}\n\nfunction cleanSelectableValues(meta, values) {\n  var list = toStringArray(values);\n  if (!meta || !meta.menuValues.length) return list;\n\n  var menuSet = {};\n  meta.menuValues.forEach(function (v) { menuSet[String(v).toLowerCase()] = v; });\n\n  var filtered = [];\n  list.forEach(function (val) {\n    var hit = menuSet[String(val).toLowerCase()];\n    if (hit !== undefined) filtered.push(hit);\n  });\n\n  if (filtered.length === 0 && meta.menuValues.length > 0) {\n    filtered = [meta.menuValues[0]];\n  }\n\n  return filtered;\n}\n\nfunction inferredLevel(attrVar) {\n  if (attrVar === undefined || attrVar === null) return null;\n  var key = String(attrVar).trim().toLowerCase();\n  return attrLevelLookup[key] || null;\n}\n\nfunction dedupeKey(attribute, values) {\n  return JSON.stringify({\n    a: attribute === null ? null : String(attribute).toLowerCase(),\n    v: toStringArray(values).map(function (v) { return v.toLowerCase(); }).sort()\n  });\n}\n\nvar cleanedActions = [];\nvar seen = {};\n\nrawActions.forEach(function (act) {\n  if (!act || typeof act !== \"object\") return;\n\n  // MessageOnly: no attribute validation\n  if (ruleTypeCode === \"24\") {\n    var msgAttr = act.attribute === undefined ? null : act.attribute;\n    var msgVals = toStringArray(act.values);\n\n    if (msgAttr === null && msgVals.length === 0) return;\n\n    var msgClean = {\n      attribute: msgAttr === null ? null : String(msgAttr),\n      values: msgVals\n    };\n\n    if (msgClean.attribute !== null) {\n      msgClean.level = act.level !== undefined ? act.level : inferredLevel(msgClean.attribute);\n    } else if (act.level !== undefined) {\n      msgClean.level = act.level;\n    }\n\n    var msgKey = dedupeKey(msgClean.attribute, msgClean.values);\n    if (!seen[msgKey]) {\n      seen[msgKey] = true;\n      cleanedActions.push(msgClean);\n    }\n    return;\n  }\n\n  // For non-message rules, attribute must exist and be valid\n  if (act.attribute === undefined || act.attribute === null || String(act.attribute).trim() === \"\") return;\n\n  var meta = getMeta(act.attribute);\n  if (!meta) return;\n\n  var values = toStringArray(act.values);\n\n  if (ruleTypeCode === \"11\") {\n    // Hiding: ignore values\n    values = [];\n  } else {\n    // Constraint / Recommendation / fallback: validate values using metadata when possible\n    if (meta.inputType === \"SingleSelectMenu\" || meta.inputType === \"MultiSelectMenu\") {\n      values = cleanSelectableValues(meta, values);\n    } else if (values.length > 1) {\n      values = [values[0]];\n    }\n  }\n\n  var cleaned = {\n    attribute: meta.attrVar,\n    values: values\n  };\n\n  var level = act.level !== undefined ? act.level : inferredLevel(meta.attrVar);\n  if (level !== null && level !== undefined) {\n    cleaned.level = level;\n  }\n\n  var key = dedupeKey(cleaned.attribute, cleaned.values);\n  if (!seen[key]) {\n    seen[key] = true;\n    cleanedActions.push(cleaned);\n  }\n});\n\nreturn cleanedActions;",
            "returnType": "array"
          },
