        {
          "metadata": {
            "name": "Extract Attributes",
            "returnType": "array",
            "sourceCode": "var attrs = $context.$variables.attributes || [];\n\nvar result = {\n  configurable : { allProductFamiliesAttr: [], productFamilyAttr: [], productLineAttr: [], modelAttr: [] },\n  nonConfigurable : { allProductFamiliesAttr: [], productFamilyAttr: [], productLineAttr: [], modelAttr: [] },\n  system : { allProductFamiliesAttr: [], productFamilyAttr: [], productLineAttr: [], modelAttr: [] },\n  account : { allProductFamiliesAttr: [], productFamilyAttr: [], productLineAttr: [], modelAttr: [] },\n  user : { allProductFamiliesAttr: [], productFamilyAttr: [], productLineAttr: [], modelAttr: [] }\n};\n\nfor (var i = 0; i < attrs.length; i++) {\n  var attr = attrs[i];\n  if (!attr) { continue; }\n\n  var categoryKey = null;\n  if (attr.category && attr.category.displayValue === \"Configurable\")      categoryKey = \"configurable\";\n  else if (attr.category && attr.category.displayValue === \"Regular\")      categoryKey = \"nonConfigurable\";\n  else if (attr.category && attr.category.displayValue === \"System\")       categoryKey = \"system\";\n  else if (attr.category && attr.category.displayValue === \"Account\")      categoryKey = \"account\";\n  else if (attr.category && attr.category.displayValue === \"User\")         categoryKey = \"user\";\n  if (!categoryKey) { continue; }\n\n  var refKey = null;\n  var refDisp = attr.refType && attr.refType.displayValue;\n  if      (refDisp === \"All Product Families\") refKey = \"allProductFamiliesAttr\";\n  else if (refDisp === \"Product Family\")       refKey = \"productFamilyAttr\";\n  else if (refDisp === \"Product Line\")         refKey = \"productLineAttr\";\n  else if (refDisp === \"Model\")                refKey = \"modelAttr\";\n  else { continue; }\n\n  var payload = {\n    variableName  : attr.variableName,\n    label         : attr.label,\n    inputTypeCode : attr.inputTypeCode\n  };\n\n  if (attr.inputTypeCode === \"TextField\" && attr.dataType && attr.dataType.displayValue) {\n    payload.dataType = attr.dataType.displayValue;\n  }\n\n  if (attr.inputTypeCode === \"SingleSelectMenu\" || attr.inputTypeCode === \"MultiSelectMenu\") {\n    var menuArr = [];\n    if (attr.menuItems && Array.isArray(attr.menuItems.items)) {\n      for (var j = 0; j < attr.menuItems.items.length; j++) {\n        var m = attr.menuItems.items[j];\n        if (m) {\n          menuArr.push({\n            id        : m.id,\n            itemText  : m.itemText,\n            itemValue : m.itemValue\n          });\n        }\n      }\n    }\n    payload.menuItems = menuArr;\n  }\n\n  result[categoryKey][refKey].push(payload);\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775010663635"
          },
          "code": "EXTRACT_ATTRIBUTES",
          "id": "1775010632311",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 6409.5,
            "y": 6365
          }
        },
        {
          "metadata": {
            "name": "Extract Rule Variable Names",
            "returnType": "array",
            "sourceCode": "var names = [];\n\nif (Array.isArray($context.$variables.ruleList)) {\n  for (var i = 0; i < $context.$variables.ruleList.length; i++) {\n    var rule = $context.$variables.ruleList[i];\n    if (rule && rule.variableName) {\n      names.push(String(rule.variableName));\n    }\n  }\n}\n\nreturn names;"
          },
          "outcomes": {
            "success": "1775239879981"
          },
          "code": "EXTRACT_RULE_VARIABLE_NAMES",
          "id": "1775239848182",
          "inputs": [],
          "type": "CODE",
          "diagram": {
            "x": 6859.5,
            "y": 6365
          }
        },
