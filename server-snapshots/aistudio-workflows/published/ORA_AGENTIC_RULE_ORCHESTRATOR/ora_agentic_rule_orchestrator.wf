        {
          "metadata": {
            "name": "Create Similarity Output",
            "returnType": "object",
            "sourceCode": "var simNodeOut = (($context.$nodes.RULE_SIMILARITY_CHECK || {}).$output || {});\nvar raw = (simNodeOut.result !== undefined) ? simNodeOut.result : simNodeOut.output;\n\n// parse if string\nif (raw && typeof raw === \"string\") {\n  try { raw = JSON.parse(raw); } catch (e) { raw = {}; }\n}\n\n// normalize to tiers object\nvar tiersObj = (raw && raw.result) ? raw.result : (raw || {});\nvar tier1 = Array.isArray(tiersObj.tier1) ? tiersObj.tier1 : [];\nvar tier2 = Array.isArray(tiersObj.tier2) ? tiersObj.tier2 : [];\nvar tier3 = Array.isArray(tiersObj.tier3) ? tiersObj.tier3 : [];\n\nvar updateRule = null;\nif (tier1.length > 0) {\n  updateRule = tier1[0];\n} else if (tier2.length > 0) {\n  updateRule = tier2[0];\n} else if (tier3.length > 0) {\n  updateRule = tier3[0];\n}\n\nvar hasUpdateOption = !!updateRule;\n\n// If no similar rules found, return empty object as requested.\nif (!hasUpdateOption) {\n  return {};\n}\n\nfunction asText(value) {\n  if (Array.isArray(value)) return value.join(\", \");\n  if (value && typeof value === \"object\") {\n    if (Array.isArray(value.values)) return value.values.join(\", \");\n    if (value.label) return String(value.label);\n    if (value.value !== undefined && value.value !== null) return asText(value.value);\n    if (value.sentence) return String(value.sentence);\n  }\n  return value == null ? \"\" : String(value);\n}\n\nfunction buildUpdatePanelPayload(updateRule, tiersObj) {\n  var updateName = asText(updateRule && updateRule.name);\n  var updateDesc = asText(updateRule && (updateRule.description || updateRule.ruleDescription));\n\n  var items = {\n    updateRule: updateRule,\n    title: \"Review existing rule\",\n    existingRule: updateName,\n    action: \"\",\n    condition: \"\"\n  };\n\n  return {\n    primary: {\n      style: \"\",\n      sections: [{\n        style: \"section\",\n        title: \"Review and Update\",\n        primaryText: updateName,\n        secondaryText: updateDesc,\n        items: items,\n        actions: [{\n          id: \"edit_rule\",\n          icon: \"oj-ux-ico-edit\",\n          label: \"Edit\"\n        }]\n      }]\n    },\n    secondary: {\n      style: \"\",\n      sections: []\n    },\n    rawData: {\n      updateRule: updateRule,\n      similarRules: tiersObj\n    }\n  };\n}\n\nreturn {\n  messages: [{\n    type: \"chip\",\n    id: \"update_rule\",\n    primaryText: \"Review and Update\",\n    secondaryText: updateRule && updateRule.name ? updateRule.name : \"\",\n    icon: \"oj-ux-ico-edit\",\n    headerText: \"You can review and update an existing similar rule\",\n    payload: buildUpdatePanelPayload(updateRule, tiersObj)\n  }]\n};"
          },
          "outcomes": {
            "success": "1775583690163"
          },
          "code": "CREATE_SIMILARITY_OUTPUT",
          "id": "1775582157608",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
