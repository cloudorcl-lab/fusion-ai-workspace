                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "176471274452"
                  },
                  "id": "start_176471274450",
                  "code": "START_1771619386325",
                  "type": "START"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_HCM_OTHER_AISTUDIOTOOLSBYTYPE",
                    "errorNodeId": "1767727720773",
                    "functionName": "getall_hcmAgentToolsV2ByTypeWithSpecification",
                    "processJson": true,
                    "name": "Fetch Tools (Business Object Function)"
                  },
                  "outcomes": {
                    "success": "176471274453"
                  },
                  "code": "FETCH_TOOLS_BUSINESS_OBJECT_FUNCTION",
                  "id": "176471274452",
                  "inputs": [
                    {
                      "id": "1779998737672_1",
                      "name": "limit",
                      "type": "string",
                      "value": "{{$context.$variables.limit}}"
                    },
                    {
                      "id": "1779998737673_2",
                      "name": "offset",
                      "type": "string",
                      "value": "{{$context.$variables.offset}}"
                    },
                    {
                      "id": "1779998737674_3",
                      "name": "type",
                      "type": "string",
                      "value": "EXTERNAL_REST"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "IF Fetch Tools (Business Object Function) succesful - IF CONDITION\""
                  },
                  "outcomes": {
                    "true": "176471274454",
                    "false": "add_false_17647127445LOOP_0_1"
                  },
                  "code": "IF_FETCH_TOOLS_BUSINESS_OBJECT_FUNCTION_SUCCESFUL__IF_CONDITION",
                  "id": "176471274453",
                  "convergenceTargetId": "end_176471274450",
                  "inputs": [
                    {
                      "id": "176471274453_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{!!$context.$nodes.PAGINATE_FETCH_EXTERNAL_REST_TOOLS_WHILE.FETCH_TOOLS_BUSINESS_OBJECT_FUNCTION.$output}}"
                    }
                  ],
                  "type": "CONDITION"
                },
                {
                  "metadata": {
                    "name": "Update pagination and collect tools"
                  },
                  "outcomes": {
                    "success": "end_176471274450"
                  },
                  "code": "UPDATE_PAGINATION_AND_COLLECT_TOOLS",
                  "id": "176471274454",
                  "inputs": [
                    {
                      "id": "17715383143598",
                      "name": "offset",
                      "scope": "JOB",
                      "type": "number",
                      "value": "{{$context.$variables.offset + $context.$variables.limit}}"
                    },
                    {
                      "id": "17715383143599",
                      "name": "tools_all",
                      "scope": "JOB",
                      "type": "array",
                      "value": "{{$context.$variables.tools_all.concat($context.$nodes.PAGINATE_FETCH_EXTERNAL_REST_TOOLS_WHILE.FETCH_TOOLS_BUSINESS_OBJECT_FUNCTION.$output.items)}}"
                    },
                    {
                      "id": "177153831435910",
                      "name": "hasMore",
                      "scope": "JOB",
                      "type": "boolean",
                      "value": "{{$context.$nodes.PAGINATE_FETCH_EXTERNAL_REST_TOOLS_WHILE.FETCH_TOOLS_BUSINESS_OBJECT_FUNCTION.$output.hasMore && $context.$variables.tools_all.length < 40}}"
                    }
                  ],
                  "type": "SET_FIELDS"
                },
                {
                  "metadata": {
                    "description": "Add node for false branch",
                    "name": "Add (False Branch)"
                  },
                  "outcomes": {
                    "success": "end_176471274450"
                  },
                  "id": "add_false_17647127445LOOP_0_1",
                  "inputs": [],
