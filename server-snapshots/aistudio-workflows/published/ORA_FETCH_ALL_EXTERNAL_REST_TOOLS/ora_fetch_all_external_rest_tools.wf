          },
          "code": "PAGINATE_FETCH_EXTERNAL_REST_TOOLS_WHILE",
          "id": "176471274450",
          "inputs": [
            {
              "id": "176471274450_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$variables.hasMore == true}}"
            }
          ],
          "type": "WHILE"
        },
