{
  "workflowId": "300000331058007",
  "workflowCode": "ORA_FETCH_ALL_EXTERNAL_REST_TOOLS",
  "name": "Fetch All External Rest Tools",
  "description": "Aggregates EXTERNAL_REST tool records by repeatedly calling the getall_hcmAgentToolsV2ByType business function with pagination until no more results. Returns the combined list of tools to the user.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
