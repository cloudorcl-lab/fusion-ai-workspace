            "name": "Extract Item Ids",
            "returnType": "string",
            "sourceCode": "const getItemQuery = (items)=>{\nvar itemNumbers = items.map(item=>item.ComponentItemNumber.toString());\nreturn \"(\\'\"+itemNumbers.join(\"\\' , \\'\")+\"\\')\";\n}\nconst items = $context.$nodes.GET_ITEM_STRUCTURES_DATA.$output.items;\nconst result = getItemQuery(items)\nreturn result"
          },
