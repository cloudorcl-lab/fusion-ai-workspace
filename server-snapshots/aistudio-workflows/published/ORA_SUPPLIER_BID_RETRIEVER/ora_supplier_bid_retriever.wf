        {
          "metadata": {
            "name": "Extract Supplier Response Ids",
            "returnType": "string",
            "sourceCode": "const getItemQuery = (items) => {\n  var itemNumbers = items.map((item) => item.AuctionHeaderId.toString());\n  if (itemNumbers.length > 0) {\n    return \"(\\'\" + itemNumbers.join(\"\\' , \\'\") + \"\\')\";\n  } else {\n    return ('-1');\n  }\n};\nconst items = $context.$nodes.GET_SUPPLIER_NEGOTIATIONS.$output.items;\nconst result = getItemQuery(items);\nreturn result;\n"
          },
          "outcomes": {
            "success": "1778150229602"
          },
          "code": "EXTRACT_NEGOTIATION_IDS",
          "id": "1769405739750",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Format Supplier Responses",
            "returnType": "array",
            "sourceCode": "const parseNegotiationResponse = (payload,negotiationDetailArray) => {\n const out = [];\n const responses = Array.isArray(payload?.items) ? payload.items : [];\n\n for (const resp of responses) {\n const negotiation = resp.Negotiation ?? resp.NegotiationNumber ?? \"\";\n const supplier = resp.Supplier ?? \"\";\nconst email = (negotiationDetailArray.find(e=>e.Negotiation===resp.Negotiation) || {EmailAddress: \"\"}).EmailAddress\n\n // 1) Collect selected requirement answers across all sections\n const requirementAnswers = {};\n const sections = resp.sections?.items ?? [];\n for (const section of sections) {\n const reqs = section.requirements?.items ?? [];\n for (const req of reqs) {\n const key = toPascalCase(req.Requirement || \"\");\n const rvItems = req.responseValues?.items ?? [];\n\n // Prefer the selected flag; if none are selected, fall back to highest score or first item.\n let chosen =\n rvItems.find((v) => v.IsSelectedFlag === true) ||\n (rvItems.length\n ? rvItems.reduce((a, b) => {\n const as = toNum(a.Score);\n const bs = toNum(b.Score);\n return bs > as ? b : a;\n })\n : null);\n\n if (chosen) {\n requirementAnswers[key] = \n req.Comments ??\n chosen.ResponseValueText ??\n chosen.ResponseValueNumber ??\n chosen.ResponseValueDate ??\n chosen.ResponseValueDateTime ??\n \"\";\n }\n }\n }\n\n // Compute OverallRank and RequirementScore (sum of SectionWeightedScore), fallback to header value\n const overallRank = resp.OverallRank ?? resp.OverallRankComposite ?? null;\n let requirementScore = null;\n if (sections && sections.length) {\n const sum = sections.reduce((acc, s) => {\n const v = Number(s.SectionWeightedScore);\n return acc + (Number.isFinite(v) ? v : 0);\n }, 0);\n if (sum > 0) requirementScore = sum.toFixed(2);\n }\n if (requirementScore == null && resp.RequirementScore != null) {\n requirementScore = String(resp.RequirementScore);\n }\n\n // 2) Try to find line-level data for Item and Quote\n const lineCollections = [\"responsePricesByLines\", \"lines\", \"allLines\"]; \n let lines = null;\n for (const name of lineCollections) {\n const items = resp[name]?.items;\n if (Array.isArray(items) && items.length) {\n lines = items;\n break;\n }\n }\n\n if (lines) {\n for (const line of lines) {\n const item =\n line.Item ??\n line.ItemNumber ??\n line.ItemId ??\n line.Line ??\n line.LineNumber ??\n null;\n\n const quote = firstDefined(\n line.ResponsePrice,\n line.UnitPrice,\n line.Price,\n line.LinePrice,\n line.Total,\n line.Amount\n );\n const targetPrice = firstDefined(\n line.TargetPrice,\n line.TargetUnitPrice,\n line.TargetAmount,\n line.Target\n );\n\n out.push({\n Negotiation: String(negotiation),\nemail:String(email),\n Item: item != null ? String(item) : null,\n Supplier: String(supplier),\n Quote: quote != null ? String(quote) : null,\n TargetPrice: targetPrice != null ? String(targetPrice) : null,\n OverallRank: overallRank != null ? String(overallRank) : null,\n RequirementScore: requirementScore != null ? String(requirementScore) : null,\n ...requirementAnswers,\n });\n }\n } else {\n // No lines present in this payload: emit a single aggregate row with requirement answers\n out.push({\n Negotiation: String(negotiation),\nemail:String(email),\n Item: null,\n Supplier: String(supplier),\n Quote: null,\n TargetPrice: null,\n OverallRank: overallRank != null ? String(overallRank) : null,\n RequirementScore: requirementScore != null ? String(requirementScore) : null,\n ...requirementAnswers,\n });\n }\n }\n\n return out;\n}\n\n// Helpers\nconst toPascalCase = (s) => {\n if (!s) return \"\";\n return (\n String(s)\n .match(/[A-Za-z0-9]+/g)\n ?.map((tok) => tok.charAt(0).toUpperCase() + tok.slice(1))\n .join(\"\") ?? \"\"\n );\n}\nconst toNum = (x) => {\n const n = Number(x);\n return Number.isFinite(n) ? n : -Infinity;\n}\nconst firstDefined = (...vals) => {\n for (const v of vals) if (v !== undefined && v !== null) return v;\n return null;\n}\nconst negotiationDetailArray = $context.$nodes.GET_SUPPLIER_NEGOTIATIONS.$output.items;\nconst k = parseNegotiationResponse( $context.$nodes.GET_SUPPLIER_NEGOTIATION_RESPONSES.$output,negotiationDetailArray);\nreturn k"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_SUPPLIER_RESPONSES",
