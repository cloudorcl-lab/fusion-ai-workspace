          "code": "PARALLEL_1775049970891",
          "convergenceTargetId": "1775046609580",
          "id": "1775049970890",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_GETOTBIDATA",
            "functionName": "GetOTBIData",
            "name": "getOTBIData"
          },
          "outcomes": {
            "success": "1775046609580"
          },
          "code": "GETOTBIDATA",
          "convergenceTargetId": "1775049979136",
          "id": "1770178523519",
          "inputs": [
            {
              "id": "1770178549878_1",
              "name": "pPayload",
              "type": "string",
              "value": "{\n    \"executionOptions\": {\n        \"async\": \"false\",\n        \"presentationInfo\": \"false\",\n        \"refresh\": \"false\",\n        \"maxRowsPerPage\": 50\n    },\n    \"outputFormat\": \"SAWRowsetSchemaAndData\",\n    \"sessionId\": \"1\",\n    \"sqlQuery\": \"SELECT CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) AS Resolution_Day, AVG(TIMESTAMPDIFF(SQL_TSI_MINUTE, \\\"Service Request\\\".\\\"Open Date\\\", \\\"Service Request\\\".\\\"Last Resolution Date\\\")) AS Avg_Resolution_Minutes FROM \\\"Service - CRM Service Requests Real Time\\\" WHERE \\\"Service Request\\\".\\\"Last Resolution Date\\\" IS NOT NULL AND \\\"Service Request\\\".\\\"Last Resolution Date\\\" >= TIMESTAMPADD(SQL_TSI_DAY, -10, CURRENT_DATE) AND \\\"Service Request\\\".\\\"Last Resolution Date\\\" < CURRENT_DATE  AND  (\\\"Service Resource Hierarchy\\\".\\\"User Organization Hierarchy Based Login\\\" =  VALUEOF(NQ_SESSION.\\\"USER_PARTY_ID\\\")) AND (DESCRIPTOR_IDOF(\\\"Service Request\\\".\\\"Stripe\\\") = 'ORA_SVC_CRM') GROUP BY CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) ORDER BY Resolution_Day\"\n}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SERVICECEN_GETOTBIDATA",
            "functionName": "GetOTBIData",
            "name": "getAvgPreviousData"
          },
          "outcomes": {
            "success": "1775046609580"
          },
          "code": "GETAVGPREVIOUSDATA",
          "convergenceTargetId": "1775050005111",
          "id": "1770178947554",
          "inputs": [
            {
              "id": "1770178991171_1",
              "name": "pPayload",
              "type": "string",
              "value": "{\n    \"executionOptions\": {\n        \"async\": \"false\",\n        \"presentationInfo\": \"true\",\n        \"refresh\": \"false\",\n        \"maxRowsPerPage\": 8\n    },\n    \"outputFormat\": \"SAWRowsetSchemaAndData\",\n    \"sessionId\": \"1\",\n    \"sqlQuery\": \"SELECT  CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) AS Resolution_Day, AVG(TIMESTAMPDIFF(SQL_TSI_MINUTE, \\\"Service Request\\\".\\\"Open Date\\\", \\\"Service Request\\\".\\\"Last Resolution Date\\\")) AS Prev_Avg_Resolution_Minutes FROM  \\\"Service - CRM Service Requests Real Time\\\" WHERE \\\"Service Request\\\".\\\"Last Resolution Date\\\" IS NOT NULL AND CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) >= TIMESTAMPADD(SQL_TSI_DAY, -20, CURRENT_DATE) AND CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) < TIMESTAMPADD(SQL_TSI_DAY, -10, CURRENT_DATE)  AND  (\\\"Service Resource Hierarchy\\\".\\\"User Organization Hierarchy Based Login\\\" =  VALUEOF(NQ_SESSION.\\\"USER_PARTY_ID\\\")) AND (DESCRIPTOR_IDOF(\\\"Service Request\\\".\\\"Stripe\\\") = 'ORA_SVC_CRM') GROUP BY CAST(\\\"Service Request\\\".\\\"Last Resolution Date\\\" AS DATE) ORDER BY Resolution_Day\"\n}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
