        {
          "metadata": {
            "name": "ExtractNames",
            "returnType": "array",
            "sourceCode": "let input = $context.$nodes.DOCUMENTTYPELOVCALL.$output.items;\n\nconst docTypeNames = (input || []).map(item => item.DocumentType);\n\nconst docTypeNameIdObject = (input || []).reduce((acc, { DocumentTypeId, DocumentType }) => {\n  acc[DocumentTypeId] = DocumentType;\n  return acc;\n}, {});\n\nlet groupByInput = $context.$nodes.GROUPBYLOV.$output.items;\n\nconst groupBy = (groupByInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[LookupCode] = Meaning;\n  return acc;\n}, {});\n\nlet categoryInput = $context.$nodes.CATEGORYLOOKUPSLOV.$output.items;\n\nconst category = (categoryInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[LookupCode] = Meaning;\n  return acc;\n}, {});\n\nlet tagsInput = $context.$nodes.TAGSLOOKUPLOV.$output.items;\n\nconst tags = (tagsInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[LookupCode] = Meaning;\n  return acc;\n}, {});\n\nlet relatedObjectInput = $context.$nodes.RELATEDOBJECTNAMELOV.$output.items;\n\nconst relatedObject = (relatedObjectInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[LookupCode] = Meaning;\n  return acc;\n}, {});\nreturn [docTypeNames,docTypeNameIdObject,groupBy,category,tags,relatedObject];"
          },
          "outcomes": {
            "success": "1773312766286"
          },
