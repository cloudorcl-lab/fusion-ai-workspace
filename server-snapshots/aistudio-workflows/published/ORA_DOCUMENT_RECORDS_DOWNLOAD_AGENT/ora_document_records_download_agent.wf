            "name": "createPersonNamePayload",
            "returnType": "array",
            "sourceCode": "let terms = $context.$variables.personIdArray.result;\n\nlet payload = {\n    \"displayFields\": [\n\"PersonId\",\"DisplayName\",\"PersonNumber\"\n    ],\n    \"filters\": [\n        {\n            \"name\": \"PersonId\",\n            \"terms\": terms\n        }\n    ],\n    \"securityFilters\": {\n        \"type\": \"PersonSearch\",\n        \"value\": \"AdvancedSearch\"\n    },\n    \"limit\": 2000\n};\n\nlet isPersonIdPresent = $context.$variables.personIdArray.result.length>0 ? true : false;\n\n\nreturn [payload,isPersonIdPresent];"
          },
          "outcomes": {
            "success": "1779791493503"
          },
