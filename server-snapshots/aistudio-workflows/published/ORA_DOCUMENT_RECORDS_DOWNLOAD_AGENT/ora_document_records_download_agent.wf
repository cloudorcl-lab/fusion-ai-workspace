            "name": "GetPersonIds",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.GETALLMASSDOWNLOADS.$output;\n\nconst personIds = (data.items || [])\n  .flatMap(item => item.parameters?.items || [])\n  .map(param => param.PersonId)   // key in your JSON is \"PersonId\"\n  .filter(id => id != null);      // removes null/undefined\n\nreturn {\n  result: Array.isArray(personIds) ? personIds : [personIds]\n};"
          },
          "outcomes": {
            "success": "1779790618337"
          },
