        },
        {
          "metadata": {
            "name": "setDownloadInfoArray",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.GETALLMASSDOWNLOADS.$output;\n\nconst result = input.items.map(record => ({\n  attachments: (record.attachments?.items || []).map(att => ({\n    AttachedDocumentId: att.AttachedDocumentId ?? null,\n    FileName: att.FileName ?? null,\n    href: att['@context']?.links?.find(link => link.rel === 'self')?.href ?? null\n  })),\n  CompletedTime: record.CompletedTime ?? null,\n  requestId: record.RequestId ?? null,\n  Comments: record.Comments ?? null,\n  SubmissionTime: record.SubmissionTime ?? null,\n  Link: `${((record?.[\"@context\"]?.links?.[0]?.href || \"\").split(\".com\")[0] + \".com\")}/fscmUI/redwood/massdownload-documentrecords` ?? null,\n  parameters: (record.parameters?.items || []).map(param => {\n    return {\n      CategoryCode: param.CategoryCode ?? null,\n      ProcessName: param.ProcessName ?? null,\n      FailedRecords: param.FailedRecords ?? null,\n      LastUpdateDateTo: param.LastUpdateDateTo ?? null,\n      DocumentTypeId: param.DocumentTypeId ?? null,\n      LastUpdateDateFrom: param.LastUpdateDateFrom ?? null,\n      ProcessedRecords: param.ProcessedRecords ?? null,\n      PersonId: param.PersonId ?? null,\n      RelatedObjectName: param.RelatedObjectName ?? null,\n      AttachGroupCode: param.AttachGroupCode ?? null,\n      TotalRecords: param.TotalRecords ?? null,\n      TagList: param.TagList ?? null\n    };\n  }),\n  StateDescription: record.StateDescription ?? null\n}));\n\nconst tagMapping =  $context.$variables.tagsObject ;\n\nconst attachGroupCodeMapping = $context.$variables.groupByObject ; \n\nconst categoryCodeMapping = $context.$variables.categoryObject ;\n\nconst relatedObjectMapping = $context.$variables.relatedObject ;\n\nconst documentTypeMapping = $context.$variables.documentTypeObject ;\n\nresult.forEach(obj => {\n  if (obj.parameters) {\n    obj.parameters.forEach(param => {\n      if (param.TagList) {\n        const mapped = param.TagList.split(',').map(tag => tagMapping[tag.trim()] || tag.trim()).join(', ');\n        param.TagList = mapped;\n      }\n      if (param.CategoryCode) {\n       const mapped = param.CategoryCode.split(',').map(code => categoryCodeMapping[code.trim()] || code.trim()).join(', ');\n        param.CategoryCode = mapped;\n      }\n      if (param.AttachGroupCode) {\n        param.AttachGroupCode = attachGroupCodeMapping[param.AttachGroupCode] || param.AttachGroupCode;\n      }\n      if (param.RelatedObjectName) {\n        const mapped = param.RelatedObjectName.split(',').map(code => relatedObjectMapping[code.trim()] || code.trim()).join(', ');\n        param.RelatedObjectName = mapped;\n      }\n      if (param.DocumentTypeId) {\n        const mapped = param.DocumentTypeId.split(',').map(id => documentTypeMapping[id.trim()] || id.trim()).join(', ');\n        param.DocumentTypeId = mapped;\n      }\n    })\n  }\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765273126630"
          },
