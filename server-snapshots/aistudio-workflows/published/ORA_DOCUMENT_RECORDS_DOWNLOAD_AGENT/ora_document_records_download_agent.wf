            },
            "name": "IdentifyIntent"
          },
          "outcomes": {
            "success": "1764747385912"
          },
          "code": "IDENTIFYINTENT",
          "convergenceTargetId": "1764236205478",
          "id": "1764668751349",
          "inputs": [
            {
              "id": "1764668751351_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an Intent Classification Assistant for Mass Download of Document Records application. You are expected to convert an user question to a structured query output.\nYour job:\n- Take the user's message.\n- Understand whether the user wants to VIEW information or SUBMIT/CREATE something.\n\nDEFINITIONS:\n1. VIEW Intent:\n   - User wants to get, see, read, list, check, fetch, or view information of Mass Download requests.\n   - Keywords: show, list, get, view, see, check, find, lookup, status, details, history.\n\n2. SUBMIT Intent:\n   - User wants to create, submit, update, add, register, download, request an ESS job formally for Mass Download operation.\n   - Keywords: create, submit, raise, file, add, open a request, report, register, request new, generate, ESS, ESS request, download.\n\nRULES:\n- If the message clearly expresses creating or submitting → intent = \"SUBMIT\".\n- If the message clearly expresses retrieving or checking → intent = \"VIEW\".\n- If ambiguous, choose the most likely intent.\n- Never add explanations outside JSON.\n- Always fill every field in the JSON.\n- Respond with only the JSON object, with valid JSON syntax.\n\nUser question: {{$context.$system.$inputMessage}}\n\n**Output Format**: Return a json object with the field - operationType\n\n**Required Output:** A json object with structure {operationType: string}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"operationType\": {\n      \"type\": \"string\",\n      \"description\": \"Operation to be performed (e.g., VIEW or SUBMIT)\"\n    }\n  },\n  \"required\": [\n    \"operationType\"\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
