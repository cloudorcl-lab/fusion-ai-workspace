        {
          "metadata": {
            "name": "PresentDataSubmitRequest"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PRESENTDATASUBMITREQUEST",
          "id": "1767340577518",
          "inputs": [
            {
              "id": "1767340577520_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a JSON object - {{$context.$nodes.SETOBJECTTOPRESENTDATA.$output.result}} and array {{$context.$nodes.SUBMIT.$output.documentTypeName}}, representing a request, with nested fields and sub-objects. \nYour task is to extract the following key information from this JSON, array and present it in a concise, well-formatted summary:\n\nInput value: {{$context.$nodes.SETOBJECTTOPRESENTDATA.$output.result}}, {{$context.$nodes.SUBMIT.$output.documentTypeName}}\n\nRequest Id: (from field RequestId)\nStatus: (use StateDescription; if not available, convert State to a human-readable string)\nSubmissionTime: (convert SubmissionTime to \"MM-DD-YYYY\" format)\nCompletedTime: (convert CompletedTime to \"MM-DD-YYYY\" format; if null, ignore the field)\nComments: (from Comments; if null, ignore the field)\nCategory: (from parameters.items[0].CategoryCode; if null, ignore the field)\nDocument Type: (from {{$context.$nodes.SUBMIT.$output.documentTypeName}}; if null, ignore the field)\nRecords Updated From Date:  (from parameters.items[0].LastUpdateDateFrom; if null, ignore the field - convert to \"MM-DD-YYYY\" format)\nRecords Updated To Date:  (from parameters.items[0].LastUpdateDateTo; if null, ignore the field - convert to \"MM-DD-YYYY\" format)\nPerson Name:  (print 'DisplayName' from {{$context.$variables.personDetails}} ; if null, ignore the field)\nProcess Name: (from parameters.items[0].ProcessName; if null, ignore the field)\nProcessed Records: (from parameters.items[0].ProcessedRecords; if null, ignore the field)\nFailed Records: (from parameters.items[0].FailedRecords; if null, ignore the field)\nCreated From: (from parameters.items[0].RelatedObjectName; if null, ignore the field)\nGroup By: (from parameters.items[0].AttachGroupCode; if null, ignore the field)\nTotal Records: (from parameters.items[0].TotalRecords; if null, ignore the field)\nTags: (from parameters.items[0].TagList; if null, ignore the field)\n\nImportant:\nAfter the last extracted key-value line, ALWAYS add, as a new line at the end:\nenclose inside an anchor tag (<a href=\"\" target=\"_blank\">  </a>) with href value from this variable for attachments- parameters.items[0].link to provide as clickable link.\nTo view the progress, click : parameters.items[0].link \n\nExample Output Format:\n\nRequest Id: 299040\nStatus: Succeeded\nSubmissionTime: 12-17-2025\nCompletedTime: 12-17-2025\nComments: sample\nCategory: Absence, Benefits\nCreated From: Recruitment Offers\nDocument Type Name: Birth, Visa Information\nRecords Updated From Date:  01-07-2025\nRecords Updated To Date:  01-01-2026\nPerson Name:  Meg Fitzimmons\nProcessed Records: 0\nFailed Records: 0\nRelatedObjectName: Absence Cases\nGroup By: Person\nTotal Records: 0\nTags: Employment\nTo view the progress, click : <a href=\"https://cpdcamvqy.fusionappspreprod.ocs.oc-test.com/fscmUI/redwood/massdownload-documentrecords\" target=\"_blank\"> https://cpdcamvqy.fusionappspreprod.ocs.oc-test.com/fscmUI/redwood/massdownload-documentrecords </a>\n\nFor any missing or null values, ignore the field. Dates should be in \"MM-DD-YYYY\" format. Ignore other fields and system links."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "ProvidePersonDORAttribute"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PROVIDEPERSONDORATTRIBUTE",
          "id": "1767341402276",
          "inputs": [
            {
              "id": "1767341402278_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an Agent performing to inform users to provide certain values to generate the Massdownload Request :\n\nInform as :\n\"Please provide at least one of the following valid values to proceed with generating a MassDownload request:\n1. Person Name\n2. Any \"Document Record\" attribute, such as:\n        - Category of the document\n        - Document Type of the document\nWithout at least one of these values, the MassDownload request cannot be generated.\""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "setObjectToPresentData",
            "returnType": "object",
            "sourceCode": "const tagMapping =  $context.$variables.tagsObject ;\n\nconst attachGroupCodeMapping = $context.$variables.groupByObject ; \n\nconst categoryCodeMapping = $context.$variables.categoryObject ;\n\nconst relatedObjectMapping = $context.$variables.relatedObject ;\n\n// Your input object\nconst input = $context.$nodes.GETONEMASSDOWNLOAD.$output;\n\nlet output = {};\n\n// Top-level fields (excluding the disallowed/all context/links/attachments keys)\noutput.CompletedTime = input.CompletedTime;\noutput.Comments = input.Comments;\noutput.RequestId = input.RequestId;\noutput.State = input.State;\noutput.StateDescription = input.StateDescription;\noutput.SubmissionTime = input.SubmissionTime;\n\n// Handle parameters, ignoring count, hasMore, limit, offset, links, @context\noutput.parameters = {};\n\nlet items = input.parameters.items;\nlet processedItems = [];\nfor (let i = 0; i < items.length; i++) {\n  let item = items[i];\n  let newItem = {};\n\n  // AttachGroupCode mapping\n  if (item.AttachGroupCode) {\n    let vals = item.AttachGroupCode.split(',');\n    let mapped = [];\n    for (let j = 0; j < vals.length; j++) {\n      mapped.push(attachGroupCodeMapping[vals[j]] || vals[j]);\n    }\n    newItem.AttachGroupCode = mapped.join(',');\n  } else {\n    newItem.AttachGroupCode = item.AttachGroupCode;\n  }\n\n  // CategoryCode mapping\n  if (item.CategoryCode) {\n    let vals = item.CategoryCode.split(',');\n    let mapped = [];\n    for (let j = 0; j < vals.length; j++) {\n      mapped.push(categoryCodeMapping[vals[j]] || vals[j]);\n    }\n    newItem.CategoryCode = mapped.join(',');\n  } else {\n    newItem.CategoryCode = item.CategoryCode;\n  }\n\n  newItem.LastUpdateDateFrom = item.LastUpdateDateFrom;\n  newItem.LastUpdateDateTo = item.LastUpdateDateTo;\n\n  // RelatedObjectName mapping\n  if (item.RelatedObjectName) {\n    let vals = item.RelatedObjectName.split(',');\n    let mapped = [];\n    for (let j = 0; j < vals.length; j++) {\n      mapped.push(relatedObjectMapping[vals[j]] || vals[j]);\n    }\n    newItem.RelatedObjectName = mapped.join(',');\n  } else {\n    newItem.RelatedObjectName = item.RelatedObjectName;\n  }\n\n  newItem.ProcessedRecords = item.ProcessedRecords;\n  newItem.TotalRecords = item.TotalRecords;\n  newItem.FailedRecords = item.FailedRecords;\n\n  // TagList mapping\n  if (item.TagList) {\n    let vals = item.TagList.split(',');\n    let mapped = [];\n    for (let j = 0; j < vals.length; j++) {\n      mapped.push(tagMapping[vals[j]] || vals[j]);\n    }\n    newItem.TagList = mapped.join(',');\n  } else {\n    newItem.TagList = item.TagList;\n  }\n\n  newItem.ProcessName = item.ProcessName;\n  newItem.SubCategoryCode = item.SubCategoryCode;\n  newItem.HcmListId = item.HcmListId;\n  newItem.link = `${((item?.[\"@context\"]?.links?.[0]?.href || \"\").split(\".com\")[0] + \".com\")}/fscmUI/redwood/massdownload-documentrecords`;\n// Omits @context and other disallowed keys\n\n  processedItems.push(newItem);\n}\noutput.parameters.items = processedItems;\n\nreturn output;"
          },
          "outcomes": {
            "success": "1767340577518"
          },
          "code": "SETOBJECTTOPRESENTDATA",
          "id": "1767768203793",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
