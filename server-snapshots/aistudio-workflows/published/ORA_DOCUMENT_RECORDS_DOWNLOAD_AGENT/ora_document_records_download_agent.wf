          "metadata": {
            "name": "MappingLOVObject",
            "returnType": "array",
            "sourceCode": "let groupByInput = $context.$nodes.GROUPBYLOV.$output.items;\n\nconst groupBy = (groupByInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[Meaning] = LookupCode;\n  return acc;\n}, {});\n\nlet categoryInput = $context.$nodes.CATEGORYLOOKUPSLOV.$output.items;\n\nconst category = (categoryInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[Meaning] = LookupCode;\n  return acc;\n}, {});\n\nlet tagsInput = $context.$nodes.TAGSLOOKUPLOV.$output.items;\n\nconst tags = (tagsInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[Meaning] = LookupCode;\n  return acc;\n}, {});\n\nlet relatedObjectInput = $context.$nodes.RELATEDOBJECTNAMELOV.$output.items;\n\nconst relatedObject = (relatedObjectInput || []).reduce((acc, { LookupCode, Meaning }) => {\n  acc[Meaning] = LookupCode;\n  return acc;\n}, {});\n\nreturn [groupBy,category,tags,relatedObject];"
          },
          "outcomes": {
            "success": "1764747558671"
          },
