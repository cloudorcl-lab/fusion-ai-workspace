            "name": "Consolidate query",
            "returnType": "string",
            "sourceCode": "let recommendation = $context.$triggers.REST.$input.recommendationDetails;\nlet userMessage = $context.$system.$inputMessage;\nlet username = $context.$user.$name\nlet context = {};\nlet consolidateOutput = JSON.stringify({userQuery: userMessage , userName: username , recommendation: recommendation})\nreturn consolidateOutput;"
          },
          "outcomes": {
            "success": "1778143418482"
          },
          "code": "CONSOLIDATE_QUERY",
          "id": "1778142622771",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
