            },
            {
              "id": "1778143418482_SalesPlay",
              "name": "SalesPlay",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.salesPlay}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW",
          "diagram": {
            "x": 5225,
            "y": 5650
          }
        },
        {
          "metadata": {
            "name": "ifTaskType"
          },
          "outcomes": {
            "true": "1772043749310",
            "false": "1772043858678"
          },
          "code": "IFTASKTYPE",
          "convergenceTargetId": "end",
          "id": "1772043711064",
          "inputs": [
            {
              "id": "1772043711065_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.taskType == 'CREATE_MEETING_AGENDA'}}"
            }
          ],
          "type": "CONDITION",
          "diagram": {
            "x": 5225,
            "y": 5872
          }
        },
        {
          "metadata": {
            "name": "createMeetingAgendaTask"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CREATEMEETINGAGENDATASK",
          "id": "1772043749310",
          "inputs": [
            {
              "id": "1772043749311_1",
              "name": "prompt",
              "type": "string",
              "value": "Answer user question: {{$context.$system.$inputMessage}}, and if provided use these additional details to help answer the user question: {{$context.$triggers.REST.$input.recommendationDetails}}. Source information from the opportunity context: {{$context.$nodes.CALL_DEAL_ADVISOR.$output.output.OPPORTUNITY}} and the excerpt or excerptArray property from \n{{$context.$nodes.CALL_DEAL_ADVISOR.$output.output.SALESPLAY}}\n if relevant information is found for the meeting agenda.\n\nRespond with JSON with the following attributes:\n- primaryText\n- secondaryText\n- icon\n- postback\n\nRules regarding the JSON attributes:\n- The valid value for the icon is \"oj-ux-ico-calendar-add\"\n- primaryText should be the suggested meeting title. It has to be short.\n- secondaryText should include the account name if available\n- postback should contain the detailed agenda with meeting title and details in bulleted points in html format eg: <p>, <ul>, <li>, <b> with no newlines.\n\nRULES:\nDO NOT HALLUCINATE OR MAKE UP THE FACTS\nDo not use any other content or properties from the output. If there is no valid content, do not generate suggestions, summaries, or hallucinate any facts."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"postback\": {\n            \"type\": \"string\"\n        },\n        \"icon\": {\n            \"type\": \"string\"\n        },\n        \"secondaryText\": {\n            \"type\": \"string\"\n        },\n        \"primaryText\": {\n            \"type\": \"string\"\n        },\n        \"headerText\": {\n            \"type\": \"string\"\n        },\n        \"type\": {\n            \"type\": \"string\",\n            \"defaultValue\": \"chip\"\n        }\n    }\n}",
          "type": "LLM",
          "diagram": {
            "x": 5000,
            "y": 6094
          }
        },
        {
          "metadata": {
            "name": "transformMessagesResponse"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "TRANSFORMMESSAGESRESPONSE",
          "id": "1772043858678",
          "inputs": [
            {
              "id": "1772043858680_1",
              "name": "prompt",
              "type": "string",
              "value": "Respond to the user question: {{$context.$system.$inputMessage}}\nAdditional details: {{$context.$triggers.REST.$input.recommendationDetails}}\nexcerpts: {{$context.$nodes.CALL_DEAL_ADVISOR.$output.output}}\n\nCurrent Date and Time: {{$context.$system.$currentDateTime}}\n\n----------------------------------------\nSTRICT BEHAVIOR RULES\n----------------------------------------\n1. Use ONLY facts that are directly found in the excerpts.\n2. DO NOT infer, assume, summarize beyond the excerpts, or add any external knowledge.\n3. DO NOT include any information that is not explicitly present in the excerpts.\n4. Do not mention internal systems, retrieval, excerpts, Content Intelligence, or source mechanics.\n5. Do not add any extra JSON fields beyond the required schema for the selected response type.\n\n----------------------------------------\nDATE AND TIME GROUNDING RULES\n----------------------------------------\n- Treat {{$context.$system.$currentDateTime}} as the only source of truth for the current date and time.\n- If the response needs to generate, suggest, schedule, propose, or return a date or date/time that is not explicitly provided in the excerpts, use only dates in the window from the current date through the next 2 calendar days, inclusive.\n- Do not invent or return past dates unless that exact past date is explicitly present in the excerpts and the user is asking about historical or record-based information.\n- For scheduling, meeting, follow-up, callback, reminder, next-step, or outreach timing requests, suggest options using today, tomorrow, or the day after tomorrow based on {{$context.$system.$currentDateTime}}.\n- When the user uses relative date language such as today, tomorrow, next meeting, next follow-up, soon, or later this week, resolve it against {{$context.$system.$currentDateTime}} and keep the result within the current-date-to-next-2-days window unless the excerpts explicitly provide a different future date.\n- If a specific date is required but cannot be safely inferred within this window, ask for confirmation instead of inventing a date.\n- Preserve explicitly sourced dates from the excerpts when the user asks about factual historical or record-based information such as published dates, expiration dates, renewal dates, close dates, invoice dates, or activity history.\n\n----------------------------------------\nOPPORTUNITY CONTEXT AND RELEVANCE RULES\n----------------------------------------\n- Extract opportunity context from the excerpts before composing the answer when such fields are present.\n- Account/customer name = Opportunity.CustomerAccount.PartyUniqueName when present.\n- Opportunity name = Opportunity.Name when present.\n- Product names = all distinct Opportunity.ListOfRevenues[*].ProdGroupId.Name_localizedValue values when present.\n- Primary stakeholder = Opportunity.PrConPartyId.PartyName and/or ListOfContacts[*].PerPartyId.PartyName when relevant.\n- Use extracted account/customer name, opportunity name, product names, and primary stakeholder only to choose and prioritize relevant details that are explicitly present in the excerpts.\n- If the user asks for customer references, customer success stories, proof points, examples, positioning, or sales guidance, prefer details from the excerpts that match the opportunity products, account context, stakeholder persona, industry, use case, or business priorities.\n- If multiple opportunity products are present, consider every distinct product when selecting relevant content.\n- Do not focus only on the first or primary product unless the user explicitly narrows the question to one product.\n- You may mention extracted opportunity context in postback when it helps make the answer specific.\n- Do not invent product names, customer facts, stakeholders, industries, success stories, proof points, or links.\n\n----------------------------------------\nWHEN EXCERPTS ARE EMPTY OR UNUSABLE\n----------------------------------------\nIf excerpts are empty, null, missing, or contain no usable content, return EXACTLY:\n\n{\n  \"text\": \"No results found\",\n  \"headerText\": \"\",\n  \"type\": \"text\"\n}\n\nDo not return postback, icon, primaryText, or secondaryText in this case.\n\n----------------------------------------\nWHEN VALID EXCERPTS EXIST\n----------------------------------------\nReturn exactly one JSON object with only these fields:\n- primaryText\n- secondaryText\n- icon\n- postback\n- type\n\nField rules:\n- type must be: \"chip\"\n- icon must be one of:\n  - oj-ux-ico-email\n  - oj-ux-ico-detail-view\n- primaryText must be a short label derived strictly from excerpts.\n- secondaryText must be short supporting text derived strictly from excerpts.\n- postback must contain detailed content from excerpts only.\n\n----------------------------------------\nSOURCE COVERAGE RULES\n----------------------------------------\n- Treat every non-empty value in the excerpts as source content that may contain customer-relevant details.\n- Review the full excerpts before answering.\n- Do not stop after the first paragraph, first item, first matching sentence, or first useful-looking detail.\n- Include all materially relevant details that answer the user question or support the requested sales guidance.\n- Do not collapse rich source content into a generic one-sentence answer when the excerpts include specific capabilities, outcomes, differentiators, examples, recommended actions, or links.\n- Preserve the meaning and specificity of named products, capabilities, business outcomes, differentiators, customer benefits, and recommended actions from the excerpts.\n- Remove duplicate or near-duplicate statements when the same detail appears more than once.\n- If the user asks a narrow question, include only details relevant to that question.\n- If the user asks a broad question, overview, positioning, pitch, follow-up, or recommendation, include the relevant breadth from the excerpts.\n\n----------------------------------------\nCUSTOMER-FACING FORMATTING RULES\n----------------------------------------\n- Write postback as polished customer-facing HTML.\n- Use only these HTML tags in postback:\n  <p>, <ul>, <li>, <b>, <a>\n- Include:\n  - A short title\n  - A concise opening paragraph when useful\n  - Bullet points of key details when multiple relevant points exist\n- Convert source headings into readable customer-facing labels when useful, but do not invent headings that add new meaning.\n- Do not expose source-system noise such as retrieval keys, duplicate confidentiality footers, internal metadata labels, or formatting artifacts unless the user explicitly asks for technical/source details.\n- Do not mention that the answer came from excerpts, Content Intelligence, retrieval, or an internal system.\n\n----------------------------------------\nLINK FORMATTING RULES\n----------------------------------------\n- Scan all raw URLs and all HTML hyperlinks in the excerpts.\n- Include only links that are explicitly present in the excerpts.\n- Do not invent, infer, shorten, rewrite, or add links from any other source.\n- Do not fabricate links.\n- If a link is customer-facing and relevant to the answer, include it in postback as a clickable hyperlink.\n- Include every distinct relevant customer-facing URL or hyperlink from the excerpts.\n- Do not collapse multiple available links into one generic link.\n- When multiple customer stories, reference titles, product pages, documents, or proof points each have their own link, preserve each distinct title-to-link pairing as a separate clickable hyperlink.\n- If duplicate excerpts repeat the same URL with the same or near-identical display text, include that link only once.\n- Format links using:\n  <a href=\"URL\" target=\"_blank\">LINK_TEXT</a>\n- If the source provides display text for the link, use that display text.\n- If the source provides only a raw URL, use:\n  <a href=\"URL\" target=\"_blank\">Click here</a>\n- If a remaining link is already present as a valid HTML hyperlink, preserve it.\n- Do not put raw URLs in postback when they can be represented as hyperlinks.\n\n----------------------------------------\nFINAL OUTPUT CONSTRAINTS\n----------------------------------------\n- Return only valid JSON.\n- Do not wrap the JSON in markdown.\n- Do not add commentary before or after the JSON.\n- Do not add any extra fields beyond the required schema.\n- Do not omit required fields when type = \"chip\".\n- Do not include empty or irrelevant values.\n- Ensure every value is grounded in excerpts only."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"postback\": { \"type\": \"string\" },\n    \"icon\": { \"type\": \"string\" },\n    \"secondaryText\": { \"type\": \"string\" },\n    \"primaryText\": { \"type\": \"string\" },\n    \"headerText\": { \"type\": \"string\" },\n    \"type\": { \"type\": \"string\", \"defaultValue\": \"chip\" },\n    \"text\": { \"type\": \"string\" }\n  }\n}",
          "type": "LLM",
          "diagram": {
