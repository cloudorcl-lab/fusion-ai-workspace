        {
          "metadata": {
            "errorNodeId": "1782837018527",
            "name": "Generate Hash for Policies",
            "returnType": "string",
            "sourceCode": "function simpleChecksum(text) {\n  text = String(text || \"\");\n\n  let hash = 0;\n\n  for (let i = 0; i < text.length; i++) {\n    hash = (hash << 5) - hash + text.charCodeAt(i);\n    hash = hash | 0;\n  }\n\n  return Math.abs(hash).toString(16);\n}\n\nfunction normalizeValue(value) {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n\n  return String(value).trim();\n}\n\nfunction getInfluenceAndTargetValueHash(obj) {\n  const details = obj && Array.isArray(obj.details) ? obj.details : [];\n  let source = \"\";\n\n  for (let i = 0; i < details.length; i++) {\n    const influences = Array.isArray(details[i].influences)\n      ? details[i].influences\n      : [];\n\n    const targets = Array.isArray(details[i].targets)\n      ? details[i].targets\n      : [];\n\n    source += \"I:\";\n\n    for (let j = 0; j < influences.length; j++) {\n      source += normalizeValue(influences[j].value);\n      source += \",\";\n    }\n\n    source += \"|T:\";\n\n    for (let k = 0; k < targets.length; k++) {\n      source += normalizeValue(targets[k].value);\n      source += \",\";\n    }\n\n    source += \"||\";\n  }\n\n  return simpleChecksum(source);\n}\n\nconst checksum = getInfluenceAndTargetValueHash($context.$nodes.MERGE_ALL_POLICIES.$output.result);\n\nreturn checksum;"
          },
          "outcomes": {
            "success": "1781751389890"
          },
