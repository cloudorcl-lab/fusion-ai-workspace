        {
          "metadata": {
            "description": "Sync the Activation status and errormessage from Invoice Completion",
            "errorNodeId": "1782837018527",
            "name": "Sync the Activation status from Invoice Completion",
            "returnType": "object",
            "sourceCode": "function updateDraftFromIdrOutput(idrOutputJson, draftJson) {\n  const parseJson = value => {\n    if (value == null) {\n      return null;\n    }\n\n    if (typeof value !== \"string\") {\n      return value;\n    }\n\n    const trimmed = value.trim();\n    if (!trimmed) {\n      return null;\n    }\n\n    return JSON.parse(trimmed);\n  };\n\n  const idrOutput = parseJson(idrOutputJson) ?? {};\n  const draft = parseJson(draftJson) ?? {};\n\n  const sourceDetails =\n    idrOutput?.policyDetails ??\n    idrOutput?.output?.result?.policyDetails ??\n    idrOutput?.output?.policyDetails ??\n    idrOutput?.result?.policyDetails ??\n    [];\n\n  const clone = value => JSON.parse(JSON.stringify(value));\n  const invoiceCompletionDetails = Array.isArray(sourceDetails)\n    ? sourceDetails.filter(detail => detail && detail.category === \"Invoice Completion\")\n    : [];\n  const draftDetails = Array.isArray(draft.details) ? draft.details : [];\n  const preservedDetails = draftDetails.filter(\n    detail => !detail || detail.category !== \"Invoice Completion\"\n  );\n\n  return {\n    ...draft,\n    details: clone([...preservedDetails, ...invoiceCompletionDetails])\n  };\n}\n\n\nconst updatedDraft = updateDraftFromIdrOutput(\n  $context.$nodes.INVOKE_ATTRIBUTE_BUILDER_WORKFLOW.$output.output,\n  $context.$variables.existingPoliciesAndDetailsDraft\n);\n\nreturn updatedDraft;"
          },
          "outcomes": {
            "success": "1783986463267"
          },
