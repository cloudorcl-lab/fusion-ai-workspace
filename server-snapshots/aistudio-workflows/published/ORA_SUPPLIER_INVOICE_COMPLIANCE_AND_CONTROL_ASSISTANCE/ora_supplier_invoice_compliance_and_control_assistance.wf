        {
          "metadata": {
            "errorNodeId": "1781734484609",
            "name": "Merge All Policies",
            "returnType": "object",
            "sourceCode": "function combineAndConsolidatePolicies(\n  invoiceCompletionPolicies,\n  anomalyControlPolicies,\n  documentProcessingPolicies\n) {\n  const deepClone = (obj) => {\n    if (typeof structuredClone === \"function\") return structuredClone(obj);\n    return JSON.parse(JSON.stringify(obj));\n  };\n\n  const policyGroups = [\n    invoiceCompletionPolicies,\n    anomalyControlPolicies,\n    documentProcessingPolicies\n  ].filter(Boolean);\n\n  const categoryById = new Map();\n  const policyById = new Map();\n  const detailById = new Map();\n\n  for (const group of policyGroups) {\n    for (const category of group.categories || []) {\n      if (!categoryById.has(category.categoryId)) {\n        categoryById.set(category.categoryId, deepClone(category));\n      }\n    }\n\n    for (const policy of group.policies || []) {\n      if (!policyById.has(policy.policyId)) {\n        policyById.set(policy.policyId, deepClone(policy));\n      }\n    }\n\n    for (const detail of group.details || []) {\n      if (!detailById.has(detail.detailId)) {\n        detailById.set(detail.detailId, deepClone(detail));\n      }\n    }\n  }\n\n  const categories = Array.from(categoryById.values());\n  const policies = Array.from(policyById.values());\n  const details = Array.from(detailById.values());\n\n  const detailsByPolicyId = new Map();\n\n  for (const detail of details) {\n    if (!detailsByPolicyId.has(detail.policyId)) {\n      detailsByPolicyId.set(detail.policyId, []);\n    }\n\n    detailsByPolicyId.get(detail.policyId).push(detail);\n  }\n\n  for (const policy of policies) {\n    const relatedDetails = detailsByPolicyId.get(policy.policyId) || [];\n\n    policy.detailCount = relatedDetails.length;\n    policy.validDetailCount = relatedDetails.filter(\n      (detail) => detail.status === \"Valid\"\n    ).length;\n    policy.invalidDetailCount = relatedDetails.filter(\n      (detail) => detail.status === \"Invalid\"\n    ).length;\n    policy.detailIds = relatedDetails.map((detail) => detail.detailId);\n    policy.allDetailsValid = policy.invalidDetailCount === 0;\n  }\n\n  const categoryValidationStatus = categories.map((category) => {\n    const categoryPolicies = policies.filter(\n      (policy) => policy.categoryId === category.categoryId\n    );\n\n    const validPolicyCount = categoryPolicies.filter(\n      (policy) => policy.status === \"Valid\"\n    ).length;\n\n    const invalidPolicyCount = categoryPolicies.filter(\n      (policy) => policy.status === \"Invalid\"\n    ).length;\n\n    return {\n      categoryId: category.categoryId,\n      category: category.name,\n      allPoliciesValid: invalidPolicyCount === 0,\n      policyCount: categoryPolicies.length,\n      validPolicyCount,\n      invalidPolicyCount,\n    };\n  });\n\n  const validDetailCount = details.filter(\n    (detail) => detail.status === \"Valid\"\n  ).length;\n\n  const invalidDetailCount = details.filter(\n    (detail) => detail.status === \"Invalid\"\n  ).length;\n\n  const orphanDetailsExist = details.some(\n    (detail) => !policyById.has(detail.policyId)\n  );\n\n  return {\n    summary: {\n      allPoliciesValid: policies.every(\n        (policy) => policy.status === \"Valid\"\n      ),\n      orphanDetailsExist,\n      categoryValidationStatus,\n      totals: {\n        categoryCount: categories.length,\n        policyCount: policies.length,\n        detailCount: details.length,\n        validDetailCount,\n        invalidDetailCount,\n      },\n    },\n    categories,\n    policies,\n    details,\n  };\n}\n\nconst updated = combineAndConsolidatePolicies(\n  $context.$nodes.VALIDATE_INVOICE_COMPLETION_TARGETS_AND_DETERMINANTS.$output.result,\n  $context.$nodes.FETCH_PAYABLES_ANOMALY_CONTROLS.$output,\n  $context.$nodes.MERGE_DOCUMENT_PROCESSING_OPTIONS_WITH_SOP.$output.result\n);\n\nreturn updated;"
          },
          "outcomes": {
            "success": "1782090331814"
          },
