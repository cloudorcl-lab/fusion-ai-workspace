        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75,
                "temperature": 0.01,
                "reasoning_effort": "low"
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Followup Question and Answering"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FOLLOWUP_QUESTION_AND_ANSWERING",
          "id": "1781752564563",
          "inputs": [
            {
              "id": "1781752564563_prompt",
              "name": "prompt",
              "type": "string",
              "value": "## INPUT\nUser Input\n{{$context.$system.$inputMessage}}\n\nParsed Policies\n{{$context.$variables.parsedPoliciesAndDetails}}\n\nPolicy Dictionary\n{{$context.$variables.policyDictionary}}\n\nExisting Draft Policies \n{{$context.$variables.existingPoliciesAndDetailsDraft}}\n\nActivated Policies\n{{$context.$variables.publishedPoliciesAndDetails}}\n\n## INPUT DEFINITIONS\n- Parsed Policies: contains the parsed information and details for all policies processed so far.\n- Policy Dictionary: contains the canonical attributes, supported target attributes, and influences for each category and subcategory such as Account Coding, Tax Determinants, Asset Details, and similar.\n- Existing Draft Policies : These are existing draft policies in the system\n- Activated Polcies : These are the live policies in the system\n- User Input: contains the user's request.\n\n## TASK\nUse the available inputs to understand the user's request and respond appropriately based on the parsed policies, policy dictionary, and processed files.\n\n## RESPONSE RULES\n- Use the provided inputs as the source of truth.\n- If inputs conflict, prioritize the most relevant and most specific information.\n- Do not invent missing information.\n- Respond only to the user's request.\n- Return the response in plain text only.\n\n##OUTPUT Format (Strict)\n {\n  \"agent\": \"ORA_SUPPLIER_INVOICE_COMPLIANCE_AND_CONTROL_ASSISTANCE\",\n  \"intent\": \"Inquiry Intent\",\n  \"schema_version\": \"1\",\n  \"title\": \"Policy Extraction Details\",\n  \"description\": \"Small description based on user question and generated respose\",\n  \"timestamp\": \"timestamp\",\n  \"topicName\": \"Based on User question and response\",\n  \"agent_response\": [\n    {\n      \"display_type\": \"text\",\n      \"display_sequence\": 1,\n      \"text\": \"<Response>\"\n    },\n    {\n\n      \"display_type\": \"canvas\",\n      \"display_sequence\": 2,\n      \"canvas_content\": {\n     \"response\": \"Chat Response Received at <Timestamp>\"                       \n      }\n  ]\n}"
            }
          ],
          "type": "LLM",
          "diagram": {
            "x": 11146.3125,
            "y": 6538
          }
        },
        {
          "metadata": {
            "description": "Read All incoming details",
            "errorNodeId": "1782837018527",
            "name": "Get All the Details",
            "returnType": "object",
            "sourceCode": "function transformExcelExtractToJsonStructure(\n  excelExtract,\n  jsonStructure,\n  policyDictionary\n) {\n  function getSafeJsonStructure(jsonStructure) {\n    const fallback = {\n      summary: {\n        creationDateTime: null,\n        allPoliciesValid: true,\n        orphanDetailsExist: false,\n        categoryValidationStatus: [],\n        totals: {\n          categoryCount: 2,\n          policyCount: 0,\n          detailCount: 0,\n          validDetailCount: 0,\n          invalidDetailCount: 0\n        }\n      },\n      categories: [\n        { categoryId: \"INVOICE_COMPLETION\", name: \"Invoice Completion\" },\n        { categoryId: \"cat-invoice-controls\", name: \"Invoice Controls\" }\n      ],\n      policies: [],\n      details: [],\n      checksum: \"\"\n    };\n\n    try {\n      if (!jsonStructure || typeof jsonStructure !== \"object\" || Array.isArray(jsonStructure)) {\n        return fallback;\n      }\n\n      return {\n        summary: jsonStructure.summary || fallback.summary,\n        categories:\n          Array.isArray(jsonStructure.categories) && jsonStructure.categories.length > 0\n            ? jsonStructure.categories\n            : fallback.categories,\n        policies: Array.isArray(jsonStructure.policies) ? jsonStructure.policies : [],\n        details: [],\n        checksum: jsonStructure.checksum || \"\"\n      };\n    } catch (e) {\n      return fallback;\n    }\n  }\n\n  const output = JSON.parse(JSON.stringify(getSafeJsonStructure(jsonStructure)));\n\n  const SHEET_TO_CATEGORY = {\n    \"Account Coding\": \"Invoice Completion\",\n    \"Asset Details\": \"Invoice Completion\",\n    \"Project Details\": \"Invoice Completion\",\n    \"Payment Details\": \"Invoice Completion\",\n    \"Tax Determinants\": \"Invoice Completion\",\n    \"Anomaly Verification\": \"Invoice Controls\",\n    \"Document Processing\": \"Invoice Controls\"\n  };\n\n  const IGNORED_SHEETS = { fileName: true, type: true };\n\n  const RESERVED_COLUMNS = {\n    priority: true,\n    \"target attribute\": true,\n    \"target value\": true,\n    \"error message\": true\n  };\n\n  function isBlank(value) {\n    return value === null || value === undefined || String(value).trim() === \"\";\n  }\n\n  function normalize(value) {\n    return String(value == null ? \"\" : value).trim().toLowerCase();\n  }\n\n  function normalizeKey(value) {\n    return String(value || \"\")\n      .replace(/[^a-zA-Z0-9]/g, \"\")\n      .toLowerCase();\n  }\n\n  function normalizeStatement(value) {\n    return normalize(value).replace(/\\s+/g, \" \");\n  }\n\n  function toPriority(value, fallback) {\n    const n = Number(value);\n    return Number.isFinite(n) ? n : fallback;\n  }\n\n  function listToSentence(arr) {\n    return arr.length\n      ? arr.map(function (x) { return '\"' + x + '\"'; }).join(\", \")\n      : \"\";\n  }\n\n  function uniqueSortedAttributes(items, keyName) {\n    const map = {};\n\n    for (let i = 0; i < items.length; i++) {\n      const attr = items[i] && items[i][keyName];\n\n      if (!isBlank(attr)) {\n        map[normalizeKey(attr)] = String(attr).trim();\n      }\n    }\n\n    return Object.keys(map)\n      .sort()\n      .map(function (key) {\n        return map[key];\n      });\n  }\n\n  function buildDetailId(sheetName, sequenceNumber) {\n    if (sheetName === \"Anomaly Verification\") {\n      return \"det-anomaly-\" + String(sequenceNumber).padStart(3, \"0\");\n    }\n\n    if (sheetName === \"Document Processing\") {\n      return \"idr-det-\" + String(sequenceNumber).padStart(3, \"0\");\n    }\n\n    return \"ic-det-\" + String(sequenceNumber).padStart(3, \"0\");\n  }\n\n  function buildPolicyId(prefix, sequenceNumber) {\n    return prefix + String(sequenceNumber).padStart(3, \"0\");\n  }\n\n  function makeAttributeSetKey(values) {\n    const seen = {};\n    const keys = [];\n\n    for (let i = 0; i < (values || []).length; i++) {\n      const key = normalizeKey(values[i]);\n\n      if (key && !seen[key]) {\n        seen[key] = true;\n        keys.push(key);\n      }\n    }\n\n    return keys.sort().join(\"|\");\n  }\n\n  function makeDetailNameValueKey(items) {\n    const keys = [];\n\n    for (let i = 0; i < (items || []).length; i++) {\n      keys.push(\n        normalizeKey(items[i].attribute) + \"=\" + normalizeKey(items[i].value)\n      );\n    }\n\n    return keys.sort().join(\"|\");\n  }\n\n  function arrayContainsNormalized(arr, value) {\n    const normalizedValue = normalizeKey(value);\n\n    for (let i = 0; i < arr.length; i++) {\n      if (normalizeKey(arr[i]) === normalizedValue) return true;\n    }\n\n    return false;\n  }\n\n  function makePolicyMatchKey(categoryIdOrName, subCategory, influences, targets) {\n    return [\n      normalizeKey(categoryIdOrName),\n      normalizeKey(subCategory),\n      makeAttributeSetKey(influences),\n      makeAttributeSetKey(targets)\n    ].join(\"::\");\n  }\n\n  function makePolicyMatchKeyFromPolicy(policy) {\n    return makePolicyMatchKey(\n      policy.categoryId || policy.category,\n      policy.subCategory,\n      policy.influences || [],\n      policy.targets || []\n    );\n  }\n\n  function makePolicyMatchKeyFromDetail(detail) {\n    return makePolicyMatchKey(\n      getCategoryId(detail.category),\n      detail.subCategory,\n      (detail.influences || []).map(function (item) {\n        return item.attribute;\n      }),\n      (detail.targets || []).map(function (item) {\n        return item.attribute;\n      })\n    );\n  }\n\n  function makePolicyDuplicateKey(policy) {\n    return makePolicyMatchKeyFromPolicy(policy);\n  }\n\n  function makeDetailDuplicateKey(detail) {\n    return [\n      normalizeKey(detail.policyId),\n      normalizeKey(detail.category),\n      normalizeKey(detail.subCategory),\n      makeDetailNameValueKey(detail.influences || []),\n      makeDetailNameValueKey(detail.targets || [])\n    ].join(\"::\");\n  }\n\n  let indexes;\n\n  function createIndexes() {\n    const policyById = {};\n    const policyMatchByKey = {};\n    const policyStatementByKey = {};\n    const categoryIdByName = {};\n\n    const categories = output.categories || [];\n    const policies = output.policies || [];\n\n    for (let i = 0; i < categories.length; i++) {\n      categoryIdByName[normalizeKey(categories[i].name)] = categories[i].categoryId;\n    }\n\n    for (let i = 0; i < policies.length; i++) {\n      const policy = policies[i];\n\n      policyById[policy.policyId] = policy;\n      policyMatchByKey[makePolicyMatchKeyFromPolicy(policy)] = policy.policyId;\n      policyStatementByKey[\n        normalizeStatement(policy.policy) + \"::\" + normalizeKey(policy.category)\n      ] = policy.policyId;\n    }\n\n    return {\n      policyById: policyById,\n      policyMatchByKey: policyMatchByKey,\n      policyStatementByKey: policyStatementByKey,\n      categoryIdByName: categoryIdByName\n    };\n  }\n\n  function refreshIndexes() {\n    indexes = createIndexes();\n  }\n\n  refreshIndexes();\n\n  function getCategoryId(categoryName) {\n    return indexes.categoryIdByName[normalizeKey(categoryName)] || null;\n  }\n\n  function getPolicyById(policyId) {\n    return indexes.policyById[policyId] || null;\n  }\n\n  function findMatchingPolicy(detail) {\n    return indexes.policyMatchByKey[makePolicyMatchKeyFromDetail(detail)] || \"Missing\";\n  }\n\n  function findPolicyByStatement(policyStatement, category) {\n    const key = normalizeStatement(policyStatement) + \"::\" + normalizeKey(category);\n    return indexes.policyStatementByKey[key] || \"Missing\";\n  }\n\n  function buildPolicyName(detail) {\n    const targetAttrs = uniqueSortedAttributes(detail.targets || [], \"attribute\");\n    return targetAttrs.length > 0 ? targetAttrs.join(\", \") : detail.subCategory + \" Policy\";\n  }\n\n  function buildGeneratedPolicyText(detail) {\n    const targetAttrs = uniqueSortedAttributes(detail.targets || [], \"attribute\");\n    const influenceAttrs = uniqueSortedAttributes(detail.influences || [], \"attribute\");\n\n    const targetText = targetAttrs.length > 0 ? targetAttrs.join(\", \") : \"target attributes\";\n    const influenceText =\n      influenceAttrs.length > 0 ? influenceAttrs.join(\", \") : \"available invoice attributes\";\n\n    if (detail.category === \"Invoice Completion\") {\n      return \"For all unmatched invoices, derive \" + targetText + \" based on \" + influenceText + \".\";\n    }\n\n    return \"For all invoices, derive \" + targetText + \" based on \" + influenceText + \".\";\n  }\n\n  function createPolicyForDetail(detail, policyCounters) {\n    const generatedPolicyStatement = buildGeneratedPolicyText(detail);\n    const existingPolicyByStatement = findPolicyByStatement(\n      generatedPolicyStatement,\n      detail.category\n    );\n\n    if (existingPolicyByStatement !== \"Missing\") {\n      return existingPolicyByStatement;\n    }\n\n    let prefix;\n\n    if (detail.category === \"Invoice Completion\") {\n      prefix = \"ic-pol-\";\n    } else if (detail.subCategory === \"Document Processing\") {\n      prefix = \"idr-pol-\";\n    } else if (detail.subCategory === \"Anomaly Verification\") {\n      prefix = \"pol-anomaly-\";\n    } else {\n      prefix = \"pol-\";\n    }\n\n    policyCounters[prefix] = policyCounters[prefix] || 1;\n\n    let policyId = buildPolicyId(prefix, policyCounters[prefix]);\n\n    while (indexes.policyById[policyId]) {\n      policyCounters[prefix]++;\n      policyId = buildPolicyId(prefix, policyCounters[prefix]);\n    }\n\n    policyCounters[prefix]++;\n\n    const policy = {\n      policyId: policyId,\n      categoryId: getCategoryId(detail.category),\n      category: detail.category,\n      subCategory: detail.subCategory,\n      policyName: buildPolicyName(detail),\n      policy: generatedPolicyStatement,\n      status: \"Valid\",\n      allDetailsValid: true,\n      errorMessage: null,\n      influences: uniqueSortedAttributes(detail.influences || [], \"attribute\"),\n      targets: uniqueSortedAttributes(detail.targets || [], \"attribute\"),\n      detailCount: 0,\n      validDetailCount: 0,\n      invalidDetailCount: 0,\n      detailIds: []\n    };\n\n    output.policies = output.policies || [];\n    output.policies.push(policy);\n\n    indexes.policyById[policy.policyId] = policy;\n    indexes.policyMatchByKey[makePolicyMatchKeyFromPolicy(policy)] = policy.policyId;\n    indexes.policyStatementByKey[\n      normalizeStatement(policy.policy) + \"::\" + normalizeKey(policy.category)\n    ] = policy.policyId;\n\n    return policyId;\n  }\n\n  function buildPolicyDetailStatement(detail) {\n    const influences = detail.influences || [];\n    const targets = detail.targets || [];\n\n    const influenceText =\n      influences.length > 0\n        ? influences\n            .map(function (i) {\n              return i.attribute + ' \"' + i.value + '\"';\n            })\n            .join(\" and \")\n        : \"all invoices\";\n\n    const targetText = targets\n      .map(function (t) {\n        return t.attribute + ' as \"' + t.value + '\"';\n      })\n      .join(\" and \");\n\n    return \"For \" + influenceText + \", derive \" + targetText + \".\";\n  }\n\n  function assignPolicyToDetail(detail, policyCounters) {\n    detail.policyId = findMatchingPolicy(detail);\n\n    if (detail.policyId === \"Missing\") {\n      detail.policyId = createPolicyForDetail(detail, policyCounters);\n    }\n\n    if (detail.policyId === \"Missing\") {\n      detail.status = \"Invalid\";\n      detail.errorMessage =\n        \"No matching policy found for category, subCategory, influences, and targets.\";\n    } else {\n      detail.status = \"Valid\";\n      detail.errorMessage = null;\n    }\n\n    return detail;\n  }\n\n  function buildStandardDetails(sheetName, sheetData, category, detailCounters, policyCounters) {\n    const details = [];\n    const records = Array.isArray(sheetData.records) ? sheetData.records : [];\n    const detailCounterKey =\n      category === \"Invoice Completion\" ? category : sheetName;\n\n    for (let i = 0; i < records.length; i++) {\n      const record = records[i];\n      const targetAttribute = record[\"Target Attribute\"];\n      const targetValue = record[\"Target Value\"];\n\n      if (isBlank(targetAttribute)) continue;\n\n      const targets = [];\n\n      if (!isBlank(targetValue)) {\n        targets.push({\n          attribute: String(targetAttribute).trim(),\n          value: String(targetValue).trim()\n        });\n      }\n\n      const influences = [];\n\n      for (const column in record) {\n        if (!Object.prototype.hasOwnProperty.call(record, column)) continue;\n\n        const value = record[column];\n\n        if (RESERVED_COLUMNS[normalize(column)] || isBlank(value)) continue;\n\n        influences.push({\n          attribute: column,\n          value: String(value).trim()\n        });\n      }\n\n      detailCounters[detailCounterKey] = detailCounters[detailCounterKey] || 1;\n\n      const detail = {\n        detailId: buildDetailId(sheetName, detailCounters[detailCounterKey]),\n        policyId: \"Missing\",\n        status: \"Valid\",\n        category: category,\n        subCategory: sheetName,\n        priority: toPriority(record.Priority, i + 1),\n        errorMessage: null,\n        policyDetailStatement: \"\",\n        influences: influences,\n        targets: targets\n      };\n\n      detailCounters[detailCounterKey]++;\n      detail.policyDetailStatement = buildPolicyDetailStatement(detail);\n      assignPolicyToDetail(detail, policyCounters);\n\n      details.push(detail);\n    }\n\n    return details;\n  }\n\n  function buildDocumentProcessingDetails(\n    sheetName,\n    sheetData,\n    category,\n    detailCounters,\n    policyCounters\n  ) {\n    const details = [];\n    const records = Array.isArray(sheetData.records) ? sheetData.records : [];\n\n    for (let recordIndex = 0; recordIndex < records.length; recordIndex++) {\n      const record = records[recordIndex];\n\n      for (const column in record) {\n        if (!Object.prototype.hasOwnProperty.call(record, column)) continue;\n\n        const value = record[column];\n\n        if (column === \"Priority\" || RESERVED_COLUMNS[normalize(column)] || isBlank(value)) {\n          continue;\n        }\n\n        detailCounters[sheetName] = detailCounters[sheetName] || 1;\n\n        const detail = {\n          detailId: buildDetailId(sheetName, detailCounters[sheetName]),\n          policyId: \"Missing\",\n          status: \"Valid\",\n          category: category,\n          subCategory: sheetName,\n          priority: 1,\n          errorMessage: null,\n          policyDetailStatement: \"\",\n          influences: [],\n          targets: [\n            {\n              attribute: column,\n              value: String(value).trim()\n            }\n          ]\n        };\n\n        detailCounters[sheetName]++;\n        detail.policyDetailStatement = buildPolicyDetailStatement(detail);\n        assignPolicyToDetail(detail, policyCounters);\n\n        details.push(detail);\n      }\n    }\n\n    return details;\n  }\n\n  function removeDuplicatePoliciesAndDetails() {\n    const policies = output.policies || [];\n    const details = output.details || [];\n\n    const seenPolicyKeys = {};\n    const duplicatePolicyIdToKeptPolicyId = {};\n    const uniquePolicies = [];\n\n    for (let i = 0; i < policies.length; i++) {\n      const policy = policies[i];\n      const policyKey = makePolicyDuplicateKey(policy);\n\n      if (seenPolicyKeys[policyKey]) {\n        duplicatePolicyIdToKeptPolicyId[policy.policyId] = seenPolicyKeys[policyKey].policyId;\n      } else {\n        seenPolicyKeys[policyKey] = policy;\n        uniquePolicies.push(policy);\n      }\n    }\n\n    for (let i = 0; i < details.length; i++) {\n      const detail = details[i];\n\n      if (duplicatePolicyIdToKeptPolicyId[detail.policyId]) {\n        detail.policyId = duplicatePolicyIdToKeptPolicyId[detail.policyId];\n      }\n    }\n\n    const seenDetailKeys = {};\n    const uniqueDetails = [];\n\n    for (let i = 0; i < details.length; i++) {\n      const detail = details[i];\n      const detailKey = makeDetailDuplicateKey(detail);\n\n      if (!seenDetailKeys[detailKey]) {\n        seenDetailKeys[detailKey] = true;\n        uniqueDetails.push(detail);\n      }\n    }\n\n    output.policies = uniquePolicies;\n    output.details = uniqueDetails;\n  }\n\n  function makeValidationErrorMessage(params) {\n    const parts = [];\n\n    if (params.missingGroup) {\n      parts.push(\"Unsupported subcategory.\");\n    }\n\n    if (params.invalidInfluences.length) {\n      parts.push(\"Unsupported influences: \" + listToSentence(params.invalidInfluences) + \".\");\n    }\n\n    if (params.invalidTargets.length) {\n      parts.push(\"Unsupported targets: \" + listToSentence(params.invalidTargets) + \".\");\n    }\n\n    return (\n      params.entityType +\n      ' in \"' +\n      params.groupName +\n      '\" is invalid. ' +\n      parts.join(\" \")\n    ).trim();\n  }\n\n  function validateInvoiceCompletionOutput() {\n    const CATEGORY_NAME = \"Invoice Completion\";\n    const DICT_ROOT_KEY = \"invoiceCompletion\";\n\n    const SUPPORTED_SUBCATEGORIES = [\n      \"Account Coding\",\n      \"Tax Determinants\",\n      \"Asset Details\",\n      \"Project Details\",\n      \"Payment Details\"\n    ];\n\n    const displayNameByDictKey = {\n      AccountCoding: \"Account Coding\",\n      TaxDeterminants: \"Tax Determinants\",\n      AssetDetails: \"Asset Details\",\n      ProjectDetails: \"Project Details\",\n      PaymentDetails: \"Payment Details\"\n    };\n\n    const supportedSubCategoryKeys = {};\n\n    for (let i = 0; i < SUPPORTED_SUBCATEGORIES.length; i++) {\n      supportedSubCategoryKeys[normalizeKey(SUPPORTED_SUBCATEGORIES[i])] = true;\n    }\n\n    const dictRoot =\n      policyDictionary && policyDictionary[DICT_ROOT_KEY]\n        ? policyDictionary[DICT_ROOT_KEY]\n        : {};\n\n    const subCategoryKeyMap = {};\n    const allowedSetsBySubCategory = {};\n    const dictKeys = Object.keys(dictRoot || {});\n\n    for (let i = 0; i < dictKeys.length; i++) {\n      const dictKey = dictKeys[i];\n\n      if (dictKey === \"canonicalAttributes\") continue;\n      if (!supportedSubCategoryKeys[normalizeKey(dictKey)]) continue;\n\n      subCategoryKeyMap[normalizeKey(dictKey)] = dictKey;\n      allowedSetsBySubCategory[dictKey] = {\n        supportedTargets: dictRoot[dictKey].supportedTargets || [],\n        supportedInfluences: dictRoot[dictKey].supportedInfluences || []\n      };\n    }\n\n    function classifySubCategoryByTargets(targets) {\n      let bestMatch = null;\n      const subCategories = Object.keys(allowedSetsBySubCategory);\n\n      for (let i = 0; i < subCategories.length; i++) {\n        const subCategory = subCategories[i];\n        const allowed = allowedSetsBySubCategory[subCategory];\n        let targetMatches = 0;\n\n        for (let j = 0; j < targets.length; j++) {\n          if (arrayContainsNormalized(allowed.supportedTargets, targets[j])) {\n            targetMatches++;\n          }\n        }\n\n        if (!bestMatch || targetMatches > bestMatch.targetMatches) {\n          bestMatch = {\n            subCategory: subCategory,\n            targetMatches: targetMatches\n          };\n        }\n      }\n\n      if (!bestMatch || bestMatch.targetMatches === 0) return null;\n\n      return bestMatch.subCategory;\n    }\n\n    const categories = output.categories || [];\n    const policies = output.policies || [];\n    const details = output.details || [];\n    const invoiceCompletionCategoryIds = {};\n\n    for (let i = 0; i < categories.length; i++) {\n      if (normalizeKey(categories[i].name) === normalizeKey(CATEGORY_NAME)) {\n        invoiceCompletionCategoryIds[categories[i].categoryId] = true;\n      }\n    }\n\n    function isInvoiceCompletionPolicy(policy) {\n      return !!invoiceCompletionCategoryIds[policy.categoryId];\n    }\n\n    for (let i = 0; i < policies.length; i++) {\n      const policy = policies[i];\n\n      if (!isInvoiceCompletionPolicy(policy)) continue;\n\n      const classifiedSubCategoryKey = classifySubCategoryByTargets(policy.targets || []);\n      const providedSubCategoryKey = subCategoryKeyMap[normalizeKey(policy.subCategory || \"\")];\n      const dictSubCategoryKey = classifiedSubCategoryKey || providedSubCategoryKey;\n\n      const allowed = dictSubCategoryKey\n        ? allowedSetsBySubCategory[dictSubCategoryKey]\n        : null;\n\n      if (dictSubCategoryKey && displayNameByDictKey[dictSubCategoryKey]) {\n        policy.subCategory = displayNameByDictKey[dictSubCategoryKey];\n      }\n\n      if (!allowed) {\n        policy.status = \"Invalid\";\n        policy.errorMessage = makeValidationErrorMessage({\n          entityType: \"Policy\",\n          groupName: policy.subCategory || \"\",\n          invalidInfluences: [],\n          invalidTargets: [],\n          missingGroup: true\n        });\n        continue;\n      }\n\n      const invalidInfluences = [];\n      const invalidTargets = [];\n\n      for (let j = 0; j < (policy.influences || []).length; j++) {\n        if (!arrayContainsNormalized(allowed.supportedInfluences, policy.influences[j])) {\n          invalidInfluences.push(policy.influences[j]);\n        }\n      }\n\n      for (let j = 0; j < (policy.targets || []).length; j++) {\n        if (!arrayContainsNormalized(allowed.supportedTargets, policy.targets[j])) {\n          invalidTargets.push(policy.targets[j]);\n        }\n      }\n\n      if (invalidInfluences.length || invalidTargets.length) {\n        policy.status = \"Invalid\";\n        policy.errorMessage = makeValidationErrorMessage({\n          entityType: \"Policy\",\n          groupName: policy.subCategory || \"\",\n          invalidInfluences: invalidInfluences,\n          invalidTargets: invalidTargets,\n          missingGroup: false\n        });\n      } else {\n        policy.status = \"Valid\";\n        policy.errorMessage = null;\n      }\n    }\n\n    refreshIndexes();\n\n    for (let i = 0; i < details.length; i++) {\n      const detail = details[i];\n      const parentPolicy = getPolicyById(detail.policyId);\n\n      if (!parentPolicy) {\n        detail.status = \"Invalid\";\n        detail.errorMessage = \"Detail is invalid. Related policy was not found.\";\n        continue;\n      }\n\n      if (!isInvoiceCompletionPolicy(parentPolicy)) continue;\n\n      const detailInfluences = [];\n      const detailTargets = [];\n\n      for (let j = 0; j < (detail.influences || []).length; j++) {\n        if (detail.influences[j].attribute) {\n          detailInfluences.push(detail.influences[j].attribute);\n        }\n      }\n\n      for (let j = 0; j < (detail.targets || []).length; j++) {\n        if (detail.targets[j].attribute) {\n          detailTargets.push(detail.targets[j].attribute);\n        }\n      }\n\n      const detailSubCategoryKey =\n        classifySubCategoryByTargets(detailTargets) ||\n        subCategoryKeyMap[normalizeKey(parentPolicy.subCategory || \"\")];\n\n      const detailAllowed = detailSubCategoryKey\n        ? allowedSetsBySubCategory[detailSubCategoryKey]\n        : null;\n\n      if (detailSubCategoryKey && displayNameByDictKey[detailSubCategoryKey]) {\n        detail.subCategory = displayNameByDictKey[detailSubCategoryKey];\n      }\n\n      if (!detailAllowed) {\n        detail.status = \"Invalid\";\n        detail.errorMessage = makeValidationErrorMessage({\n          entityType: \"Detail\",\n          groupName: detail.subCategory || parentPolicy.subCategory || \"\",\n          invalidInfluences: [],\n          invalidTargets: [],\n          missingGroup: true\n        });\n        continue;\n      }\n\n      const detailInvalidInfluences = [];\n      const detailInvalidTargets = [];\n\n      for (let j = 0; j < detailInfluences.length; j++) {\n        if (!arrayContainsNormalized(detailAllowed.supportedInfluences, detailInfluences[j])) {\n          detailInvalidInfluences.push(detailInfluences[j]);\n        }\n      }\n\n      for (let j = 0; j < detailTargets.length; j++) {\n        if (!arrayContainsNormalized(detailAllowed.supportedTargets, detailTargets[j])) {\n          detailInvalidTargets.push(detailTargets[j]);\n        }\n      }\n\n      if (detailInvalidInfluences.length || detailInvalidTargets.length) {\n        detail.status = \"Invalid\";\n        detail.errorMessage = makeValidationErrorMessage({\n          entityType: \"Detail\",\n          groupName: detail.subCategory || parentPolicy.subCategory || \"\",\n          invalidInfluences: detailInvalidInfluences,\n          invalidTargets: detailInvalidTargets,\n          missingGroup: false\n        });\n      } else {\n        detail.status = \"Valid\";\n        detail.errorMessage = null;\n      }\n    }\n  }\n\n  function recalculatePolicyCounts() {\n    const policies = output.policies || [];\n    const details = output.details || [];\n\n    for (let i = 0; i < policies.length; i++) {\n      policies[i].detailIds = [];\n      policies[i].detailCount = 0;\n      policies[i].validDetailCount = 0;\n      policies[i].invalidDetailCount = 0;\n      policies[i].allDetailsValid = true;\n    }\n\n    for (let i = 0; i < details.length; i++) {\n      const detail = details[i];\n      const policy = getPolicyById(detail.policyId);\n\n      if (!policy) continue;\n\n      policy.detailIds.push(detail.detailId);\n      policy.detailCount++;\n\n      if (detail.status === \"Valid\") policy.validDetailCount++;\n      if (detail.status === \"Invalid\") policy.invalidDetailCount++;\n\n      policy.allDetailsValid = policy.invalidDetailCount === 0;\n    }\n  }\n\n  function recalculateSummary() {\n    const policies = output.policies || [];\n    const details = output.details || [];\n    const categories = output.categories || [];\n\n    let validDetailCount = 0;\n    let invalidDetailCount = 0;\n\n    for (let i = 0; i < details.length; i++) {\n      if (details[i].status === \"Valid\") validDetailCount++;\n      if (details[i].status === \"Invalid\") invalidDetailCount++;\n    }\n\n    const categoryValidationStatus = [];\n\n    for (let i = 0; i < categories.length; i++) {\n      const category = categories[i];\n      let policyCount = 0;\n      let validPolicyCount = 0;\n      let invalidPolicyCount = 0;\n\n      for (let j = 0; j < policies.length; j++) {\n        if (policies[j].categoryId !== category.categoryId) continue;\n\n        policyCount++;\n\n        if (policies[j].status === \"Valid\") validPolicyCount++;\n        if (policies[j].status === \"Invalid\") invalidPolicyCount++;\n      }\n\n      categoryValidationStatus.push({\n        categoryId: category.categoryId,\n        category: category.name,\n        allPoliciesValid: invalidPolicyCount === 0,\n        policyCount: policyCount,\n        validPolicyCount: validPolicyCount,\n        invalidPolicyCount: invalidPolicyCount\n      });\n    }\n\n    let orphanDetailsExist = false;\n\n    for (let i = 0; i < details.length; i++) {\n      if (details[i].policyId === \"Missing\" || !getPolicyById(details[i].policyId)) {\n        orphanDetailsExist = true;\n        break;\n      }\n    }\n\n    let allPoliciesValid = invalidDetailCount === 0;\n\n    for (let i = 0; i < policies.length; i++) {\n      if (policies[i].status !== \"Valid\") {\n        allPoliciesValid = false;\n        break;\n      }\n    }\n\n    output.summary = output.summary || {};\n    output.summary.orphanDetailsExist = orphanDetailsExist;\n    output.summary.allPoliciesValid = allPoliciesValid;\n    output.summary.categoryValidationStatus = categoryValidationStatus;\n\n    output.summary.totals = output.summary.totals || {};\n    output.summary.totals.categoryCount = categories.length;\n    output.summary.totals.policyCount = policies.length;\n    output.summary.totals.detailCount = details.length;\n    output.summary.totals.validDetailCount = validDetailCount;\n    output.summary.totals.invalidDetailCount = invalidDetailCount;\n  }\n\n  const newDetails = [];\n  const detailCounters = {};\n  const policyCounters = {};\n\n  for (const sheetName in excelExtract || {}) {\n    if (!Object.prototype.hasOwnProperty.call(excelExtract, sheetName)) continue;\n    if (IGNORED_SHEETS[sheetName]) continue;\n\n    const category = SHEET_TO_CATEGORY[sheetName];\n    if (!category) continue;\n\n    const sheetData = excelExtract[sheetName];\n    if (!sheetData || !Array.isArray(sheetData.records)) continue;\n\n    const sheetDetails =\n      sheetName === \"Document Processing\"\n        ? buildDocumentProcessingDetails(sheetName, sheetData, category, detailCounters, policyCounters)\n        : buildStandardDetails(sheetName, sheetData, category, detailCounters, policyCounters);\n\n    for (let i = 0; i < sheetDetails.length; i++) {\n      newDetails.push(sheetDetails[i]);\n    }\n  }\n\n  output.details = newDetails;\n\n  removeDuplicatePoliciesAndDetails();\n  refreshIndexes();\n\n  validateInvoiceCompletionOutput();\n  refreshIndexes();\n\n  recalculatePolicyCounts();\n  recalculateSummary();\n\n  return output;\n}\n\nfunction safeParseJson(value) {\n  try {\n    if (typeof value === \"string\") {\n      if (value.trim() === \"\") return null;\n      return JSON.parse(value);\n    }\n\n    return value;\n  } catch (e) {\n    return null;\n  }\n}\n\nconst finalJsonStructure = transformExcelExtractToJsonStructure(\n  safeParseJson($context.$triggers.REST.$input.uploadedPolicyDetails),\n  safeParseJson($context.$variables.existingPoliciesAndDetailsDraft),\n  safeParseJson($context.$variables.policyDictionary)\n);\n\nreturn finalJsonStructure;"
          },
