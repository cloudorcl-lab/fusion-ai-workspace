        {
          "metadata": {
            "description": "",
            "errorNodeId": "1782837018527",
            "name": "Final Activation",
            "returnType": "object",
            "sourceCode": "function updateAnomalyDetails(draftPayload, anomalyPayload) {\n  const updatedDraft = JSON.parse(JSON.stringify(draftPayload));\n  const anomalyDetails = (anomalyPayload && anomalyPayload.details) || [];\n\n  const anomalyMap = {};\n  for (var i = 0; i < anomalyDetails.length; i++) {\n    anomalyMap[anomalyDetails[i].detailId] = anomalyDetails[i];\n  }\n\n  if (!updatedDraft.details || !Array.isArray(updatedDraft.details)) {\n    updatedDraft.details = [];\n    return updatedDraft;\n  }\n\n  for (var j = 0; j < updatedDraft.details.length; j++) {\n    var draftDetail = updatedDraft.details[j];\n    var anomalyDetail = anomalyMap[draftDetail.detailId];\n\n    if (anomalyDetail) {\n      draftDetail.status = anomalyDetail.status;\n      draftDetail.errorMessage = anomalyDetail.errorMessage;\n    }\n  }\n\n  return updatedDraft;\n}\n\nconst draftPayload = $context.$variables.existingPoliciesAndDetailsDraft;\nconst anomalyPayload = JSON.parse($context.$nodes.INVOICE_ANOMLAY_WORKFLOW.$output.output).result;\nconst updated = updateAnomalyDetails(draftPayload, anomalyPayload)\nreturn updated;"
          },
          "outcomes": {
            "success": "1783986976845"
          },
