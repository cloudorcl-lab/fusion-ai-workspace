{
  "workflowId": "100002355226917",
  "workflowCode": "ORA_SUPPLIER_INVOICE_COMPLIANCE_AND_CONTROL_ASSISTANCE",
  "name": "Payables Invoice Compliance and Control Assistant",
  "description": "Automatically translates user-uploaded Standard Operating Procedure (SOP) documents into structured Payables compliance policies. By extracting critical guidelines around Invoice Completion, Invoice Controls, and Exception Handling, the agent seamlessly maps raw procedures into a standardized framework. This ensures automated verification and consistent adherence to internal governance and regulatory mandates across all Payables operations.",
