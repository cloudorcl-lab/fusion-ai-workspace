            "name": "Extract Invoice Completion Details",
            "returnType": "object",
            "sourceCode": "const data = $context.$variables.existingPoliciesAndDetailsDraft;\n\nconst policyDetails = (data?.details || []).filter(\n  detail =>\n    (detail.category === \"INVOICE_COMPLETION\" ||\n      detail.category === \"Invoice Completion\") &&\n    detail.status !== \"Invalid\"\n);\n\nreturn {\n  policyDetails\n};"
