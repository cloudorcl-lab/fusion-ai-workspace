ture Type\",                \"Line Type\"            ]        },        \"TaxDeterminants\": {            \"supportedTargets\": [                \"User-defined Fiscal Classification\",                \"Transaction Business Category\",                \"Ship to-Location\",                \"Product Fiscal Classification\",                \"Product Type\",                \"Product Category\",                \"Intended Use\",                \"Document Fiscal Classification\",                \"Location of Final Discharge\"            ],            \"supportedInfluences\": [                \"Business Unit\",                \"Legal Entity\",                \"Supplier Type\",                \"Stream\",                \"Ship to-Location\",                \"Payable Invoice Currency\",                \"Project Number\",                \"Project Expenditure Type\"            ]        },        \"AssetDetails\": {            \"supportedTargets\": [                \"Asset Category\",                \"Asset Book Type\"            ],            \"supportedInfluences\": [                \"Business Unit\",                \"Legal Entity\",                \"Supplier Type\",                \"Stream\",                \"Product Type\",                \"Product Category\",                \"Ship to-Location\"            ]        },        \"ProjectDetails\": {            \"supportedTargets\": [                \"Project Number\",                \"Project Organization\",                \"Project Task Name\",                \"Project Contract Number\",                \"Project Expenditure Type\",                \"Funding Source Name\"            ],            \"supportedInfluences\": [                \"Business Unit\",                \"Legal Entity\",                \"Supplier Type\",                \"Stream\",                \"Ship to-Location\",                \"Payable Invoice Currency\",                \"Track as Asset Indicator\",                \"Project Contract Number\",                