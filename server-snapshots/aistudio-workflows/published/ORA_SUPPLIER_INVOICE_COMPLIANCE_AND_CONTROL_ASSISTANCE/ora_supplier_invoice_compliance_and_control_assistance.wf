            {
              "id": "1781752487219_prompt",
              "name": "prompt",
              "type": "string",
              "value": "##OUTPUT(STRICT)\nSorry, that request is outside my area of support. I’m designed to help with questions and requests related to policies and policy details.\n\nIf you are attaching a policy or policy detail document for processing, please rename the document before reattaching the same file for processing."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/DataText.schema.json\",\n  \"type\": \"object\",\n  \"properties\": {\n\t\"heading\": { \"type\": \"string\" },\n    \"text\": { \"type\": \"string\" }\n  },\n  \"required\": [\"text\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM",
