        {
          "metadata": {
            "description": "Synchronize the activation status for IDR Options",
            "errorNodeId": "1782837018527",
            "name": "Sync the Activation Status for IDR Options",
            "returnType": "object",
            "sourceCode": "function updateDraftFromIdrOutput(idrOutputJson, draftJson) {\n  const parseJson = value => {\n    if (value == null) {\n      return null;\n    }\n\n    if (typeof value !== \"string\") {\n      return value;\n    }\n\n    const trimmed = value.trim();\n    if (!trimmed) {\n      return null;\n    }\n\n    return JSON.parse(trimmed);\n  };\n\n  const idrOutput = parseJson(idrOutputJson) ?? {};\n  const draft = parseJson(draftJson) ?? {};\n\n  const idrDetails =\n    idrOutput?.details ??\n    idrOutput?.output?.result?.details ??\n    idrOutput?.output?.details ??\n    idrOutput?.result?.details ??\n    [];\n\n  const updatesByDetailId = new Map(\n    idrDetails\n      .filter(detail => detail && detail.detailId && detail.subCategory === \"Document Processing\")\n      .map(detail => [detail.detailId, detail])\n  );\n\n  const clone = value => JSON.parse(JSON.stringify(value));\n\n  const updatedDetails = idrDetails\n    .filter(detail => detail && detail.subCategory === \"Document Processing\")\n    .map(detail => {\n      const update = updatesByDetailId.get(detail.detailId);\n      return clone(update ?? detail);\n    });\n  const draftDetails = Array.isArray(draft.details) ? draft.details : [];\n  const preservedDetails = draftDetails.filter(\n    detail => !detail || detail.subCategory !== \"Document Processing\"\n  );\n\n  const walk = node => {\n    if (Array.isArray(node)) {\n      return node.map(walk);\n    }\n\n    if (!node || typeof node !== \"object\") {\n      return node;\n    }\n\n    if (node.detailId && node.subCategory === \"Document Processing\" && updatesByDetailId.has(node.detailId)) {\n      return clone(updatesByDetailId.get(node.detailId));\n    }\n\n    const copy = { ...node };\n\n    for (const key of Object.keys(copy)) {\n      copy[key] = walk(copy[key]);\n    }\n\n    return copy;\n  };\n\n  const mergedDraft = walk(draft);\n\n  return {\n    ...mergedDraft,\n    details: clone([...preservedDetails, ...updatedDetails])\n  };\n}\n\nconst updatedDraft = updateDraftFromIdrOutput(\n  $context.$nodes.CALL_IDR_OPTIONS_FOR_ACTIVATION.$output.output,\n  $context.$variables.existingPoliciesAndDetailsDraft\n);\n\nreturn updatedDraft;"
          },
