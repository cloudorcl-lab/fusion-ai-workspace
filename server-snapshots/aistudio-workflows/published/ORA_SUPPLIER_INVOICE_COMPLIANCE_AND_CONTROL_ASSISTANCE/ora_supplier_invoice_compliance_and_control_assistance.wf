        {
          "metadata": {
            "description": "Update existing Document Processing settings with those of SOP",
            "errorNodeId": "1782837018527",
            "name": "Merge Document Processing Options with SOP",
            "returnType": "object",
            "sourceCode": "const settings = [\n  [\"Recognize Tax Amount\", \"idr-pol-001\", \"boolean\"],\n  [\"Recognize Freight Amount\", \"idr-pol-002\", \"boolean\"],\n  [\"Recognize Lines for Matched Invoices\", \"idr-pol-003\", \"boolean\"],\n  [\"Recognize Lines for Unmatched Invoices\", \"idr-pol-004\", \"boolean\"],\n  [\"Calculate Tax During Import\", \"idr-pol-005\", \"boolean\"],\n  [\"Always Create Invoices in Incomplete Status\", \"idr-pol-006\", \"boolean\"],\n  [\"Create Single Invoice line for Service Orders\", \"idr-pol-007\", \"boolean\"],\n  [\"Create Single Invoice Line for Utility Suppliers\", \"idr-pol-008\", \"boolean\"],\n  [\"Import only Paired lines for Matched Invoices\", \"idr-pol-009\", \"boolean\"],\n  [\"Validate Legal Entity Identified for Matched Invoices\", \"idr-pol-010\", \"boolean\"],\n  [\"Prorate Freight and Miscellaneous Lines\", \"idr-pol-011\", \"boolean\"],\n  [\"Business Unit Derivation Mode for Emails\", \"idr-pol-012\", \"enum\"]\n];\n\nconst supportedSettings = new Set(settings.map(([name]) => name));\n\nfunction isObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction hasValue(value) {\n  return value !== undefined && value !== null && String(value).trim() !== \"\";\n}\n\nfunction isDone(value) {\n  return typeof value === \"string\" && value.trim().toLowerCase() === \"done\";\n}\n\nfunction normalizeInput(input) {\n  if (typeof input !== \"string\") return input;\n\n  try {\n    return JSON.parse(input);\n  } catch {\n    return input;\n  }\n}\n\nfunction getDetailsArray(input) {\n  const data = normalizeInput(input);\n\n  if (Array.isArray(data?.output?.result?.details)) return data.output.result.details;\n  if (Array.isArray(data?.output?.details)) return data.output.details;\n  if (Array.isArray(data?.result?.details)) return data.result.details;\n  if (Array.isArray(data?.details)) return data.details;\n\n  return [];\n}\n\nfunction getPoliciesArray(input) {\n  const data = normalizeInput(input);\n\n  if (Array.isArray(data?.output?.result?.policies)) return data.output.result.policies;\n  if (Array.isArray(data?.output?.policies)) return data.output.policies;\n  if (Array.isArray(data?.result?.policies)) return data.result.policies;\n  if (Array.isArray(data?.policies)) return data.policies;\n\n  return [];\n}\n\nfunction getTargetsObject(input) {\n  const data = normalizeInput(input);\n\n  if (isObject(data?.output?.result?.targets)) return data.output.result.targets;\n  if (isObject(data?.output?.targets)) return data.output.targets;\n  if (isObject(data?.result?.targets)) return data.result.targets;\n  if (isObject(data?.targets)) return data.targets;\n\n  return null;\n}\n\nfunction addValue(values, key, value, skipBlank) {\n  if (!supportedSettings.has(key)) return;\n  if (skipBlank && !hasValue(value)) return;\n\n  values[key] = value;\n}\n\nfunction readTargetsInto(values, targets, skipBlank) {\n  if (Array.isArray(targets)) {\n    targets.forEach(target => {\n      if (target?.attribute && Object.prototype.hasOwnProperty.call(target, \"value\")) {\n        addValue(values, target.attribute, target.value, skipBlank);\n      }\n    });\n  }\n\n  if (isObject(targets)) {\n    Object.entries(targets).forEach(([key, value]) => {\n      addValue(values, key, value, skipBlank);\n    });\n  }\n}\n\nfunction getExistingValues(input) {\n  const values = {};\n  const data = normalizeInput(input);\n\n  getDetailsArray(data).forEach(detail => {\n    if (detail?.subCategory && detail.subCategory !== \"Document Processing\") return;\n    readTargetsInto(values, detail?.targets, false);\n  });\n\n  readTargetsInto(values, getTargetsObject(data), false);\n\n  if (isObject(data)) {\n    readTargetsInto(values, data, false);\n  }\n\n  return values;\n}\n\nfunction getPromptUpdates(promptOutput) {\n  const updates = {};\n  const data = normalizeInput(promptOutput);\n\n  if (\n    isDone(data) ||\n    isDone(data?.output) ||\n    isDone(data?.result) ||\n    isDone(data?.output?.result)\n  ) {\n    return updates;\n  }\n\n  getDetailsArray(data).forEach(detail => {\n    readTargetsInto(updates, detail?.targets, true);\n  });\n\n  getPoliciesArray(data).forEach(policy => {\n    if (Array.isArray(policy?.details)) {\n      policy.details.forEach(detail => {\n        readTargetsInto(updates, detail?.targets, true);\n      });\n    }\n  });\n\n  readTargetsInto(updates, getTargetsObject(data), true);\n\n  return updates;\n}\n\nfunction normalizeValue(value, type) {\n  const rawValue = value === undefined || value === null ? value : String(value).trim();\n\n  if (type === \"boolean\") {\n    if (value === true || rawValue === \"true\" || rawValue === \"Yes\") {\n      return { value: \"Yes\", valid: true, errorMessage: null };\n    }\n\n    if (\n      value === false ||\n      value === null ||\n      rawValue === \"false\" ||\n      rawValue === \"null\" ||\n      rawValue === \"No\"\n    ) {\n      return { value: \"No\", valid: true, errorMessage: null };\n    }\n\n    return { value: String(value), valid: false, errorMessage: \"Unsupported value\" };\n  }\n\n  const enumMap = {\n    RE: \"Recipient Email\",\n    SE: \"Sender's Email\",\n    RA: \"Email Routing Attribute\",\n    N : \"None\"\n  };\n\n  const allowed = [\n    \"Recipient Email\",\n    \"Sender's Email\",\n    \"Email Routing Attribute\"\n  ];\n\n  const finalValue = enumMap[rawValue] || rawValue;\n\n  if (allowed.includes(finalValue)) {\n    return { value: finalValue, valid: true, errorMessage: null };\n  }\n\n  if (!hasValue(finalValue)) {\n    return { value: \"\", valid: false, errorMessage: \"Target value is missing\" };\n  }\n\n  return {\n    value: String(finalValue),\n    valid: false,\n    errorMessage: \"Unsupported Business Unit Derivation Mode value\"\n  };\n}\n\nfunction buildOutput(existingValues, promptOutput) {\n  const currentValues = getExistingValues(existingValues);\n  const promptUpdates = getPromptUpdates(promptOutput);\n  const updatedValues = { ...currentValues, ...promptUpdates };\n\n  let detailNumber = 1;\n  const details = [];\n\n  const policies = settings.map(([name, policyId, type]) => {\n    const detailIds = [];\n    let detailCount = 0;\n    let validDetailCount = 0;\n    let invalidDetailCount = 0;\n\n    if (Object.prototype.hasOwnProperty.call(updatedValues, name)) {\n      const normalized = normalizeValue(updatedValues[name], type);\n      const detailId = `idr-det-${String(detailNumber).padStart(3, \"0\")}`;\n\n      detailNumber += 1;\n      detailIds.push(detailId);\n      detailCount = 1;\n\n      if (normalized.valid) {\n        validDetailCount = 1;\n      } else {\n        invalidDetailCount = 1;\n      }\n\n      details.push({\n        detailId,\n        policyId,\n        status: normalized.valid ? \"Valid\" : \"Invalid\",\n        category: \"Invoice Controls\",\n        subCategory: \"Document Processing\",\n        priority: 1,\n        errorMessage: normalized.valid ? null : normalized.errorMessage,\n        policyDetailStatement: `For invoices from Image Stream, set ${name} to ${normalized.value}.`,\n        influences: [],\n        targets: [\n          {\n            attribute: name,\n            value: normalized.value\n          }\n        ]\n      });\n    }\n\n    const status = invalidDetailCount === 0 ? \"Valid\" : \"Invalid\";\n\n    return {\n      policyId,\n      categoryId: \"cat-invoice-controls\",\n      subCategory: \"Document Processing\",\n      policyName: name,\n      policy: `For invoices from Image Stream, configure ${name}.`,\n      status,\n      allDetailsValid: invalidDetailCount === 0,\n      errorMessage: status === \"Valid\" ? null : \"Linked detail is invalid\",\n      influences: [],\n      targets: [name],\n      detailCount,\n      validDetailCount,\n      invalidDetailCount,\n      detailIds\n    };\n  });\n\n  const validPolicyCount = policies.filter(policy => policy.status === \"Valid\").length;\n  const invalidPolicyCount = policies.filter(policy => policy.status === \"Invalid\").length;\n  const detailCount = details.length;\n  const validDetailCount = details.filter(detail => detail.status === \"Valid\").length;\n  const invalidDetailCount = details.filter(detail => detail.status === \"Invalid\").length;\n\n  return {\n    summary: {\n      allPoliciesValid: invalidPolicyCount === 0,\n      orphanDetailsExist: false,\n      categoryValidationStatus: [\n        {\n          categoryId: \"cat-invoice-controls\",\n          category: \"Invoice Controls\",\n          allPoliciesValid: invalidPolicyCount === 0,\n          policyCount: settings.length,\n          validPolicyCount,\n          invalidPolicyCount\n        }\n      ],\n      totals: {\n        categoryCount: 1,\n        policyCount: settings.length,\n        detailCount,\n        validDetailCount,\n        invalidDetailCount\n      }\n    },\n    categories: [\n      {\n        categoryId: \"cat-invoice-controls\",\n        name: \"Invoice Controls\"\n      }\n    ],\n    policies,\n    details\n  };\n}\n\nconst existingSource =\n  $context.$nodes.GET_EXISTING_DOCUMENT_PROCESSING_OPTIONS.$output?.output ??\n  $context.$nodes.GET_EXISTING_DOCUMENT_PROCESSING_OPTIONS.$output;\n\nconst promptSource = $context.$nodes.FETCH_DOCUMENT_PROCESSING_OPTIONS.$output;\n\nconst docProcessingOptions = buildOutput(existingSource, promptSource);\n\nreturn docProcessingOptions;"
          },
          "outcomes": {
            "success": "1781547996509"
          },
