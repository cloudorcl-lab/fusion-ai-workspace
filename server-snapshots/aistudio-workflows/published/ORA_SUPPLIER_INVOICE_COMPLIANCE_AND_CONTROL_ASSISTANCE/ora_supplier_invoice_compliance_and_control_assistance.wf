        {
          "metadata": {
            "errorNodeId": "1782837018527",
            "name": "Validate Invoice Completion Targets and Determinants",
            "returnType": "object",
            "sourceCode": "function validateInvoiceCompletion(data, policyDictionary) {\n  var CATEGORY_NAME = \"Invoice Completion\";\n  var DICT_ROOT_KEY = \"invoiceCompletion\";\n\n  var deepClone = function (obj) {\n    return JSON.parse(JSON.stringify(obj));\n  };\n\n  var normalizeKey = function (value) {\n    return String(value || \"\")\n      .replace(/[^a-zA-Z0-9]/g, \"\")\n      .toLowerCase();\n  };\n\n  var SUPPORTED_SUBCATEGORIES = [\n    \"Account Coding\",\n    \"Tax Determinants\",\n    \"Asset Details\",\n    \"Project Details\",\n    \"Payment Details\",\n  ];\n\n  var supportedSubCategoryKeys = {};\n  for (var i = 0; i < SUPPORTED_SUBCATEGORIES.length; i++) {\n    supportedSubCategoryKeys[normalizeKey(SUPPORTED_SUBCATEGORIES[i])] = true;\n  }\n\n  var displayNameByDictKey = {\n    AccountCoding: \"Account Coding\",\n    TaxDeterminants: \"Tax Determinants\",\n    AssetDetails: \"Asset Details\",\n    ProjectDetails: \"Project Details\",\n    PaymentDetails: \"Payment Details\",\n  };\n\n  var listToSentence = function (arr) {\n    if (!arr.length) return \"\";\n\n    return arr\n      .map(function (x) {\n        return '\"' + x + '\"';\n      })\n      .join(\", \");\n  };\n\n  var makeErrorMessage = function (params) {\n    var parts = [];\n\n    if (params.missingGroup) {\n      parts.push(\"Unsupported subcategory.\");\n    }\n\n    if (params.invalidInfluences.length) {\n      parts.push(\n        \"Unsupported influences: \" +\n          listToSentence(params.invalidInfluences) +\n          \".\"\n      );\n    }\n\n    if (params.invalidTargets.length) {\n      parts.push(\n        \"Unsupported targets: \" + listToSentence(params.invalidTargets) + \".\"\n      );\n    }\n\n    return (\n      params.entityType +\n      ' in \"' +\n      params.groupName +\n      '\" is invalid. ' +\n      parts.join(\" \")\n    ).trim();\n  };\n\n  var getPolicyById = function (policies, policyId) {\n    for (var i = 0; i < policies.length; i++) {\n      if (policies[i].policyId === policyId) return policies[i];\n    }\n    return null;\n  };\n\n  var arrayContainsNormalized = function (arr, value) {\n    var normalizedValue = normalizeKey(value);\n\n    for (var i = 0; i < arr.length; i++) {\n      if (normalizeKey(arr[i]) === normalizedValue) return true;\n    }\n\n    return false;\n  };\n\n  var makeSortedKey = function (items, isObjectArray) {\n    var parts = [];\n\n    for (var i = 0; i < items.length; i++) {\n      if (isObjectArray) {\n        parts.push(\n          normalizeKey(items[i].attribute) + \"=\" + normalizeKey(items[i].value)\n        );\n      } else {\n        parts.push(normalizeKey(items[i]));\n      }\n    }\n\n    parts.sort();\n\n    return parts.join(\"|\");\n  };\n\n  var dictRoot =\n    policyDictionary && policyDictionary[DICT_ROOT_KEY]\n      ? policyDictionary[DICT_ROOT_KEY]\n      : {};\n\n  var subCategoryKeyMap = {};\n  var allowedSetsBySubCategory = {};\n  var dictKeys = Object.keys(dictRoot || {});\n\n  for (var i = 0; i < dictKeys.length; i++) {\n    var dictKey = dictKeys[i];\n\n    if (dictKey === \"canonicalAttributes\") continue;\n    if (!supportedSubCategoryKeys[normalizeKey(dictKey)]) continue;\n\n    subCategoryKeyMap[normalizeKey(dictKey)] = dictKey;\n\n    allowedSetsBySubCategory[dictKey] = {\n      supportedTargets: dictRoot[dictKey].supportedTargets || [],\n      supportedInfluences: dictRoot[dictKey].supportedInfluences || [],\n    };\n  }\n\n  var classifySubCategoryByTargets = function (targets) {\n    var bestMatch = null;\n    var subCategories = Object.keys(allowedSetsBySubCategory);\n\n    for (var i = 0; i < subCategories.length; i++) {\n      var subCategory = subCategories[i];\n      var allowed = allowedSetsBySubCategory[subCategory];\n      var targetMatches = 0;\n\n      for (var j = 0; j < targets.length; j++) {\n        if (arrayContainsNormalized(allowed.supportedTargets, targets[j])) {\n          targetMatches++;\n        }\n      }\n\n      if (!bestMatch || targetMatches > bestMatch.targetMatches) {\n        bestMatch = {\n          subCategory: subCategory,\n          targetMatches: targetMatches,\n        };\n      }\n    }\n\n    if (!bestMatch || bestMatch.targetMatches === 0) return null;\n\n    return bestMatch.subCategory;\n  };\n\n  var isInvoiceCompletionPolicy = function (policy, invoiceCompletionCategoryIds) {\n    for (var i = 0; i < invoiceCompletionCategoryIds.length; i++) {\n      if (policy.categoryId === invoiceCompletionCategoryIds[i]) return true;\n    }\n    return false;\n  };\n\n  var correctPolicySubCategory = function (policy) {\n    var classifiedSubCategoryKey = classifySubCategoryByTargets(\n      policy.targets || []\n    );\n\n    var providedSubCategoryKey =\n      subCategoryKeyMap[normalizeKey(policy.subCategory || \"\")];\n\n    var dictSubCategoryKey = classifiedSubCategoryKey || providedSubCategoryKey;\n\n    if (dictSubCategoryKey && displayNameByDictKey[dictSubCategoryKey]) {\n      policy.subCategory = displayNameByDictKey[dictSubCategoryKey];\n    }\n\n    return dictSubCategoryKey;\n  };\n\n  var validatePolicy = function (policy, dictSubCategoryKey) {\n    var allowed = dictSubCategoryKey\n      ? allowedSetsBySubCategory[dictSubCategoryKey]\n      : null;\n\n    if (!allowed) {\n      policy.status = \"Invalid\";\n      policy.errorMessage = makeErrorMessage({\n        entityType: \"Policy\",\n        groupName: policy.subCategory || \"\",\n        invalidInfluences: [],\n        invalidTargets: [],\n        missingGroup: true,\n      });\n      return;\n    }\n\n    var invalidInfluences = [];\n    var policyInfluences = policy.influences || [];\n\n    for (var i = 0; i < policyInfluences.length; i++) {\n      if (\n        !arrayContainsNormalized(\n          allowed.supportedInfluences,\n          policyInfluences[i]\n        )\n      ) {\n        invalidInfluences.push(policyInfluences[i]);\n      }\n    }\n\n    var invalidTargets = [];\n    var policyTargets = policy.targets || [];\n\n    for (var i = 0; i < policyTargets.length; i++) {\n      if (!arrayContainsNormalized(allowed.supportedTargets, policyTargets[i])) {\n        invalidTargets.push(policyTargets[i]);\n      }\n    }\n\n    if (invalidInfluences.length || invalidTargets.length) {\n      policy.status = \"Invalid\";\n      policy.errorMessage = makeErrorMessage({\n        entityType: \"Policy\",\n        groupName: policy.subCategory || \"\",\n        invalidInfluences: invalidInfluences,\n        invalidTargets: invalidTargets,\n        missingGroup: false,\n      });\n    } else {\n      policy.status = \"Valid\";\n      policy.errorMessage = null;\n    }\n  };\n\n  var removeDuplicatePoliciesAndDetails = function (output) {\n    var policies = output.policies || [];\n    var details = output.details || [];\n\n    var seenPolicyKeys = {};\n    var duplicatePolicyIdToKeptPolicyId = {};\n    var uniquePolicies = [];\n\n    for (var i = 0; i < policies.length; i++) {\n      var policy = policies[i];\n\n      var policyKey =\n        normalizeKey(policy.categoryId) +\n        \"::\" +\n        normalizeKey(policy.subCategory) +\n        \"::I:\" +\n        makeSortedKey(policy.influences || [], false) +\n        \"::T:\" +\n        makeSortedKey(policy.targets || [], false);\n\n      if (seenPolicyKeys[policyKey]) {\n        duplicatePolicyIdToKeptPolicyId[policy.policyId] =\n          seenPolicyKeys[policyKey].policyId;\n      } else {\n        seenPolicyKeys[policyKey] = policy;\n        uniquePolicies.push(policy);\n      }\n    }\n\n    for (var i = 0; i < details.length; i++) {\n      var detail = details[i];\n\n      if (duplicatePolicyIdToKeptPolicyId[detail.policyId]) {\n        detail.policyId = duplicatePolicyIdToKeptPolicyId[detail.policyId];\n      }\n    }\n\n    var seenDetailKeys = {};\n    var uniqueDetails = [];\n\n    for (var i = 0; i < details.length; i++) {\n      var detail = details[i];\n\n      var detailKey =\n        normalizeKey(detail.policyId) +\n        \"::I:\" +\n        makeSortedKey(detail.influences || [], true) +\n        \"::T:\" +\n        makeSortedKey(detail.targets || [], true);\n\n      if (!seenDetailKeys[detailKey]) {\n        seenDetailKeys[detailKey] = true;\n        uniqueDetails.push(detail);\n      }\n    }\n\n    output.policies = uniquePolicies;\n    output.details = uniqueDetails;\n  };\n\n  var output = deepClone(data);\n\n  var categories = output.categories || [];\n  var policies = output.policies || [];\n  var details = output.details || [];\n\n  var invoiceCompletionCategoryIds = [];\n\n  for (var i = 0; i < categories.length; i++) {\n    if (normalizeKey(categories[i].name) === normalizeKey(CATEGORY_NAME)) {\n      invoiceCompletionCategoryIds.push(categories[i].categoryId);\n    }\n  }\n\n  for (var i = 0; i < policies.length; i++) {\n    if (isInvoiceCompletionPolicy(policies[i], invoiceCompletionCategoryIds)) {\n      var dictSubCategoryKey = correctPolicySubCategory(policies[i]);\n      validatePolicy(policies[i], dictSubCategoryKey);\n    }\n  }\n\n  removeDuplicatePoliciesAndDetails(output);\n\n  policies = output.policies || [];\n  details = output.details || [];\n\n  for (var i = 0; i < details.length; i++) {\n    var detail = details[i];\n    var parentPolicy = getPolicyById(policies, detail.policyId);\n\n    if (!parentPolicy) {\n      detail.status = \"Invalid\";\n      detail.errorMessage = \"Detail is invalid. Related policy was not found.\";\n      continue;\n    }\n\n    if (!isInvoiceCompletionPolicy(parentPolicy, invoiceCompletionCategoryIds)) {\n      continue;\n    }\n\n    var detailInfluences = [];\n    var rawDetailInfluences = detail.influences || [];\n\n    for (var j = 0; j < rawDetailInfluences.length; j++) {\n      if (rawDetailInfluences[j].attribute) {\n        detailInfluences.push(rawDetailInfluences[j].attribute);\n      }\n    }\n\n    var detailTargets = [];\n    var rawDetailTargets = detail.targets || [];\n\n    for (var j = 0; j < rawDetailTargets.length; j++) {\n      if (rawDetailTargets[j].attribute) {\n        detailTargets.push(rawDetailTargets[j].attribute);\n      }\n    }\n\n    var detailSubCategoryKey =\n      classifySubCategoryByTargets(detailTargets) ||\n      subCategoryKeyMap[normalizeKey(parentPolicy.subCategory || \"\")];\n\n    var detailAllowed = detailSubCategoryKey\n      ? allowedSetsBySubCategory[detailSubCategoryKey]\n      : null;\n\n    if (detailSubCategoryKey && displayNameByDictKey[detailSubCategoryKey]) {\n      detail.subCategory = displayNameByDictKey[detailSubCategoryKey];\n    }\n\n    if (!detailAllowed) {\n      detail.status = \"Invalid\";\n      detail.errorMessage = makeErrorMessage({\n        entityType: \"Detail\",\n        groupName: detail.subCategory || parentPolicy.subCategory || \"\",\n        invalidInfluences: [],\n        invalidTargets: [],\n        missingGroup: true,\n      });\n      continue;\n    }\n\n    var detailInvalidInfluences = [];\n\n    for (var j = 0; j < detailInfluences.length; j++) {\n      if (\n        !arrayContainsNormalized(\n          detailAllowed.supportedInfluences,\n          detailInfluences[j]\n        )\n      ) {\n        detailInvalidInfluences.push(detailInfluences[j]);\n      }\n    }\n\n    var detailInvalidTargets = [];\n\n    for (var j = 0; j < detailTargets.length; j++) {\n      if (\n        !arrayContainsNormalized(detailAllowed.supportedTargets, detailTargets[j])\n      ) {\n        detailInvalidTargets.push(detailTargets[j]);\n      }\n    }\n\n    if (detailInvalidInfluences.length || detailInvalidTargets.length) {\n      detail.status = \"Invalid\";\n      detail.errorMessage = makeErrorMessage({\n        entityType: \"Detail\",\n        groupName: detail.subCategory || parentPolicy.subCategory || \"\",\n        invalidInfluences: detailInvalidInfluences,\n        invalidTargets: detailInvalidTargets,\n        missingGroup: false,\n      });\n    } else {\n      detail.status = \"Valid\";\n      detail.errorMessage = null;\n    }\n  }\n\n  for (var i = 0; i < policies.length; i++) {\n    var summaryPolicy = policies[i];\n    var relatedDetails = [];\n\n    for (var j = 0; j < details.length; j++) {\n      if (details[j].policyId === summaryPolicy.policyId) {\n        relatedDetails.push(details[j]);\n      }\n    }\n\n    var validDetailCountForPolicy = 0;\n    var invalidDetailCountForPolicy = 0;\n    var detailIds = [];\n\n    for (var j = 0; j < relatedDetails.length; j++) {\n      if (relatedDetails[j].status === \"Valid\") validDetailCountForPolicy++;\n      if (relatedDetails[j].status === \"Invalid\") invalidDetailCountForPolicy++;\n      detailIds.push(relatedDetails[j].detailId);\n    }\n\n    summaryPolicy.detailCount = relatedDetails.length;\n    summaryPolicy.validDetailCount = validDetailCountForPolicy;\n    summaryPolicy.invalidDetailCount = invalidDetailCountForPolicy;\n    summaryPolicy.detailIds = detailIds;\n    summaryPolicy.allDetailsValid = invalidDetailCountForPolicy === 0;\n  }\n\n  var categoryValidationStatus = [];\n\n  for (var i = 0; i < categories.length; i++) {\n    var category = categories[i];\n    var categoryPolicies = [];\n\n    for (var j = 0; j < policies.length; j++) {\n      if (policies[j].categoryId === category.categoryId) {\n        categoryPolicies.push(policies[j]);\n      }\n    }\n\n    var validPolicyCount = 0;\n    var invalidPolicyCount = 0;\n\n    for (var j = 0; j < categoryPolicies.length; j++) {\n      if (categoryPolicies[j].status === \"Valid\") validPolicyCount++;\n      if (categoryPolicies[j].status === \"Invalid\") invalidPolicyCount++;\n    }\n\n    categoryValidationStatus.push({\n      categoryId: category.categoryId,\n      category: category.name,\n      allPoliciesValid: invalidPolicyCount === 0,\n      policyCount: categoryPolicies.length,\n      validPolicyCount: validPolicyCount,\n      invalidPolicyCount: invalidPolicyCount,\n    });\n  }\n\n  var validDetailCount = 0;\n  var invalidDetailCount = 0;\n\n  for (var i = 0; i < details.length; i++) {\n    if (details[i].status === \"Valid\") validDetailCount++;\n    if (details[i].status === \"Invalid\") invalidDetailCount++;\n  }\n\n  var orphanDetailsExist = false;\n\n  for (var i = 0; i < details.length; i++) {\n    if (!getPolicyById(policies, details[i].policyId)) {\n      orphanDetailsExist = true;\n      break;\n    }\n  }\n\n  var allInvoiceCompletionPoliciesValid = true;\n\n  for (var i = 0; i < policies.length; i++) {\n    if (\n      isInvoiceCompletionPolicy(policies[i], invoiceCompletionCategoryIds) &&\n      policies[i].status !== \"Valid\"\n    ) {\n      allInvoiceCompletionPoliciesValid = false;\n      break;\n    }\n  }\n\n  output.summary = output.summary || {};\n  output.summary.allPoliciesValid = allInvoiceCompletionPoliciesValid;\n  output.summary.orphanDetailsExist = orphanDetailsExist;\n  output.summary.categoryValidationStatus = categoryValidationStatus;\n\n  output.summary.totals = {\n    categoryCount: categories.length,\n    policyCount: policies.length,\n    detailCount: details.length,\n    validDetailCount: validDetailCount,\n    invalidDetailCount: invalidDetailCount,\n  };\n\n  return output;\n}\n\nvar updated = validateInvoiceCompletion(\n  JSON.parse($context.$nodes.FETCH_INVOICE_COMPLETION_POLCIES_AND_DETAILS.$output.output),\n  $context.$variables.policyDictionary\n);\n\nreturn updated;"
          },
