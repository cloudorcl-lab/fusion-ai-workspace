        {
          "metadata": {
            "errorNodeId": "1782837018527",
            "name": "Sync Existing and SOP Anomalies",
            "returnType": "object",
            "sourceCode": "\"use strict\";\n\nvar CATEGORY_ID = \"cat-invoice-controls\";\nvar CATEGORY_NAME = \"Invoice Controls\";\nvar SUBCATEGORY = \"Anomaly Verification\";\n\nvar ANOMALY_DEFINITIONS = {\n  \"pol-invoice-currency\": {\n    policyId: \"pol-invoice-currency\",\n    detailId: \"det-invoice-currency\",\n    policyName: \"Invoice Currency\",\n    targetAttribute: \"Invoice Currency\",\n    policyInfluences: [\"Historical Time Period\"],\n    detailInfluenceAttributes: [\"Historical Time Period\"],\n    defaultDetailInfluences: [\n      {\n        attribute: \"Historical Time Period\",\n        value: 1\n      }\n    ],\n    defaultDetailTargets: [\n      {\n        attribute: \"Invoice Currency\",\n        value: \"No\"\n      }\n    ],\n    defaultTargetValue: \"No\"\n  },\n  \"pol-remittance-bank-account\": {\n    policyId: \"pol-remittance-bank-account\",\n    detailId: \"det-remittance-bank-account\",\n    policyName: \"Remittance Bank Account\",\n    targetAttribute: \"Remittance Bank Account\",\n    policyInfluences: [\"Enabled\"],\n    detailInfluenceAttributes: [],\n    defaultDetailInfluences: [],\n    defaultDetailTargets: [\n      {\n        attribute: \"Remittance Bank Account\",\n        value: \"No\"\n      }\n    ],\n    defaultTargetValue: \"No\"\n  },\n  \"pol-high-invoice-amount\": {\n    policyId: \"pol-high-invoice-amount\",\n    detailId: \"det-high-invoice-amount\",\n    policyName: \"High Invoice Amount\",\n    targetAttribute: \"High Invoice Amount\",\n    policyInfluences: [\"Historical Time Period\", \"Amount Variation\"],\n    detailInfluenceAttributes: [\"Historical Time Period\", \"Variation\"],\n    defaultDetailInfluences: [\n      {\n        attribute: \"Historical Time Period\",\n        value: 1\n      },\n      {\n        attribute: \"Variation\",\n        value: 100\n      }\n    ],\n    defaultDetailTargets: [\n      {\n        attribute: \"High Invoice Amount\",\n        value: \"No\"\n      }\n    ],\n    defaultTargetValue: \"No\"\n  },\n  \"pol-fraudulent-invoice\": {\n    policyId: \"pol-fraudulent-invoice\",\n    detailId: \"det-fraudulent-invoice\",\n    policyName: \"Fraudulent Invoice\",\n    targetAttribute: \"Fraudulent Invoice\",\n    policyInfluences: [\n      \"Historical Time Period\",\n      \"Amount\",\n      \"Currency\",\n      \"Invoice Date\",\n      \"Supplier\",\n      \"Supplier Site\",\n      \"Purchase Order Number\",\n      \"Invoice Header Description\"\n    ],\n    detailInfluenceAttributes: [\n      \"Historical Time Period\",\n      \"Amount\",\n      \"Currency\",\n      \"Invoice Date\",\n      \"Supplier\",\n      \"Supplier Site\",\n      \"Purchase Order Number\",\n      \"Invoice Header Description\"\n    ],\n    defaultDetailInfluences: [\n      {\n        attribute: \"Historical Time Period\",\n        value: 1\n      },\n      {\n        attribute: \"Amount\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Currency\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Invoice Date\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Supplier\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Supplier Site\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Purchase Order Number\",\n        value: \"No\"\n      },\n      {\n        attribute: \"Invoice Header Description\",\n        value: \"No\"\n      }\n    ],\n    defaultDetailTargets: [\n      {\n        attribute: \"Fraudulent Invoice\",\n        value: \"No\"\n      }\n    ],\n    defaultTargetValue: \"No\"\n  },\n  \"pol-duplicate-invoice\": {\n    policyId: \"pol-duplicate-invoice\",\n    detailId: \"det-duplicate-invoice\",\n    policyName: \"Duplicate Invoice\",\n    targetAttribute: \"Duplicate Invoice\",\n    policyInfluences: [\"Historical Time Period\"],\n    detailInfluenceAttributes: [\"Historical Time Period\"],\n    defaultDetailInfluences: [\n      {\n        attribute: \"Historical Time Period\",\n        value: 1\n      }\n    ],\n    defaultDetailTargets: [\n      {\n        attribute: \"Duplicate Invoice\",\n        value: \"No\"\n      }\n    ],\n    defaultTargetValue: \"No\"\n  }\n};\n\nvar POLICY_ID_LOOKUP = buildPolicyIdLookup();\n\nfunction mergeAnomalyPayload(existingPayload, sopPayload) {\n  var clone = createCloner();\n  var existing = normalizePayload(existingPayload, clone);\n  var sop = normalizePayload(sopPayload, clone);\n  var mergedDetails = mergeCanonicalDetails(existing.details, sop.details, clone);\n  var sourcePolicies = mergePolicySources(existing.policies, sop.policies, clone);\n  var policies = buildPoliciesFromDetails(mergedDetails, sourcePolicies);\n  var categories = [buildCategory()];\n  var summary = buildSummary(categories, policies, mergedDetails);\n\n  return {\n    summary: summary,\n    categories: categories,\n    policies: policies,\n    details: mergedDetails\n  };\n}\n\nfunction mergeCanonicalDetails(baseDetails, sopDetails, clone) {\n  var detailMap = new Map();\n  var orderedKeys = [];\n\n  addDetailsToMap(baseDetails, detailMap, orderedKeys, clone);\n  addDetailsToMap(sopDetails, detailMap, orderedKeys, clone);\n\n  return orderedKeys.map(function (key) {\n    return detailMap.get(key);\n  });\n}\n\nfunction mergePolicySources(existingPolicies, sopPolicies, clone) {\n  var merged = [];\n\n  if (Array.isArray(existingPolicies)) {\n    merged = merged.concat(\n      existingPolicies.map(function (policy) {\n        return clone(policy);\n      })\n    );\n  }\n\n  if (Array.isArray(sopPolicies)) {\n    merged = merged.concat(\n      sopPolicies.map(function (policy) {\n        return clone(policy);\n      })\n    );\n  }\n\n  return merged;\n}\n\nfunction addDetailsToMap(details, detailMap, orderedKeys, clone) {\n  if (!Array.isArray(details)) {\n    return;\n  }\n\n  details.forEach(function (detail) {\n    var definition = getDefinitionForRecord(detail);\n    if (!definition) {\n      return;\n    }\n\n    var key = definition.policyId;\n    var existingDetail = detailMap.has(key) ? detailMap.get(key) : null;\n    var mergedDetail = mergeDetailRecord(existingDetail, detail, definition, clone);\n\n    if (!detailMap.has(key)) {\n      orderedKeys.push(key);\n    }\n\n    detailMap.set(key, mergedDetail);\n  });\n}\n\nfunction mergeDetailRecord(existingDetail, sourceDetail, definition, clone) {\n  var sourceHasInfluences = hasOwn(sourceDetail, \"influences\");\n  var sourceHasTargets = hasOwn(sourceDetail, \"targets\");\n  var sourceHasStatement = hasOwn(sourceDetail, \"policyDetailStatement\");\n  var influences;\n  var targets;\n  var policyDetailStatement;\n\n  influences = normalizeDetailInfluences(\n    sourceHasInfluences ? sourceDetail.influences : null,\n    existingDetail && existingDetail.influences,\n    definition,\n    clone\n  );\n\n  targets = normalizeDetailTargets(\n    sourceHasTargets ? sourceDetail.targets : null,\n    existingDetail && existingDetail.targets,\n    definition,\n    clone\n  );\n\n  policyDetailStatement = chooseText(\n    sourceHasStatement ? sourceDetail.policyDetailStatement : null,\n    existingDetail && existingDetail.policyDetailStatement,\n    buildDetailStatement(definition, targets, influences)\n  );\n\n  return {\n    detailId: definition.detailId,\n    policyId: definition.policyId,\n    status: \"Valid\",\n    category: CATEGORY_NAME,\n    subCategory: SUBCATEGORY,\n    priority: 1,\n    errorMessage: null,\n    policyDetailStatement: policyDetailStatement,\n    influences: influences,\n    targets: targets\n  };\n}\n\nfunction normalizePayload(payload, clone) {\n  if (Array.isArray(payload)) {\n    return {\n      categories: [],\n      policies: [],\n      details: payload.map(function (item) {\n        return clone(item);\n      })\n    };\n  }\n\n  if (!payload || typeof payload !== \"object\") {\n    return {\n      categories: [],\n      policies: [],\n      details: []\n    };\n  }\n\n  return {\n    categories: Array.isArray(payload.categories)\n      ? payload.categories.map(function (item) {\n          return clone(item);\n        })\n      : [],\n    policies: Array.isArray(payload.policies)\n      ? payload.policies.map(function (item) {\n          return clone(item);\n        })\n      : [],\n    details: Array.isArray(payload.details)\n      ? payload.details.map(function (item) {\n          return clone(item);\n        })\n      : []\n  };\n}\n\nfunction buildPoliciesFromDetails(details, sourcePolicies) {\n  var sourcePolicyMap = buildPolicyMap(sourcePolicies);\n\n  return details.map(function (detail) {\n    var definition = getDefinitionForRecord(detail);\n    var sourcePolicy = sourcePolicyMap.get(definition.policyId);\n\n    return buildPolicyRecord(definition, sourcePolicy);\n  });\n}\n\nfunction buildPolicyMap(policies) {\n  var map = new Map();\n\n  if (!Array.isArray(policies)) {\n    return map;\n  }\n\n  policies.forEach(function (policy) {\n    var definition = getDefinitionForRecord(policy);\n    if (!definition) {\n      return;\n    }\n\n    map.set(definition.policyId, policy);\n  });\n\n  return map;\n}\n\nfunction buildPolicyRecord(definition, sourcePolicy) {\n  return {\n    policyId: definition.policyId,\n    categoryId: CATEGORY_ID,\n    subCategory: SUBCATEGORY,\n    policyName: definition.policyName,\n    policy: chooseText(\n      sourcePolicy && sourcePolicy.policy,\n      null,\n      buildPolicyText(definition)\n    ),\n    status: \"Valid\",\n    allDetailsValid: true,\n    errorMessage: null,\n    influences: definition.policyInfluences.slice(),\n    targets: [definition.targetAttribute],\n    detailCount: 1,\n    validDetailCount: 1,\n    invalidDetailCount: 0,\n    detailIds: [definition.detailId]\n  };\n}\n\nfunction buildPolicyText(definition) {\n  return (\n    \"For all invoices for \" +\n    definition.policyName +\n    \" anomaly check, analyze based on \" +\n    joinWithAnd(definition.policyInfluences) +\n    \".\"\n  );\n}\n\nfunction buildCategory() {\n  return {\n    categoryId: CATEGORY_ID,\n    name: CATEGORY_NAME\n  };\n}\n\nfunction buildSummary(categories, policies, details) {\n  var policyIdSet = new Set();\n  var invalidPolicies = [];\n  var validDetails = [];\n  var invalidDetails = [];\n\n  policies.forEach(function (policy) {\n    policyIdSet.add(policy.policyId);\n    if (policy.status !== \"Valid\") {\n      invalidPolicies.push(policy);\n    }\n  });\n\n  details.forEach(function (detail) {\n    if (detail.status === \"Valid\") {\n      validDetails.push(detail);\n    } else {\n      invalidDetails.push(detail);\n    }\n  });\n\n  return {\n    allPoliciesValid: policies.length === 0 ? true : invalidPolicies.length === 0,\n    orphanDetailsExist: details.some(function (detail) {\n      return !policyIdSet.has(detail.policyId);\n    }),\n    categoryValidationStatus: categories.map(function (category) {\n      var categoryPolicies = policies.filter(function (policy) {\n        return policy.categoryId === category.categoryId;\n      });\n\n      return {\n        categoryId: category.categoryId,\n        category: category.name,\n        allPoliciesValid:\n          categoryPolicies.length === 0\n            ? true\n            : categoryPolicies.every(function (policy) {\n                return policy.status === \"Valid\";\n              }),\n        policyCount: categoryPolicies.length,\n        validPolicyCount: categoryPolicies.filter(function (policy) {\n          return policy.status === \"Valid\";\n        }).length,\n        invalidPolicyCount: categoryPolicies.filter(function (policy) {\n          return policy.status !== \"Valid\";\n        }).length\n      };\n    }),\n    totals: {\n      categoryCount: categories.length,\n      policyCount: policies.length,\n      detailCount: details.length,\n      validDetailCount: validDetails.length,\n      invalidDetailCount: invalidDetails.length\n    }\n  };\n}\n\nfunction getDefinitionForRecord(record) {\n  var policyId;\n\n  if (!record || typeof record !== \"object\") {\n    return null;\n  }\n\n  policyId = lookupPolicyId(record.policyId);\n  if (policyId) {\n    return ANOMALY_DEFINITIONS[policyId];\n  }\n\n  policyId = lookupPolicyId(record.detailId);\n  if (policyId) {\n    return ANOMALY_DEFINITIONS[policyId];\n  }\n\n  policyId = lookupPolicyId(getFirstTargetAttribute(record.targets));\n  if (policyId) {\n    return ANOMALY_DEFINITIONS[policyId];\n  }\n\n  policyId = lookupPolicyId(record.policyName);\n  if (policyId) {\n    return ANOMALY_DEFINITIONS[policyId];\n  }\n\n  return null;\n}\n\nfunction normalizeDetailTargets(sourceTargets, fallbackTargets, definition, clone) {\n  var chosenTargets = chooseNonEmptyArray(sourceTargets, fallbackTargets, definition.defaultDetailTargets);\n  var defaultValue = definition.defaultTargetValue;\n  var normalized = [];\n  var seen = {};\n\n  chosenTargets.forEach(function (item) {\n    var normalizedTarget = normalizeDetailTargetItem(item, definition, defaultValue);\n    var key;\n\n    if (!normalizedTarget) {\n      return;\n    }\n\n    key = normalizeText(normalizedTarget.attribute);\n    if (seen[key]) {\n      return;\n    }\n\n    seen[key] = true;\n    normalized.push(normalizedTarget);\n  });\n\n  if (normalized.length === 0) {\n    return clone(definition.defaultDetailTargets);\n  }\n\n  return normalized;\n}\n\nfunction normalizeDetailInfluences(sourceInfluences, fallbackInfluences, definition, clone) {\n  var chosenInfluences = chooseNonEmptyArray(\n    sourceInfluences,\n    fallbackInfluences,\n    definition.defaultDetailInfluences\n  );\n  var defaultValueMap = buildDefaultDetailInfluenceValueMap(definition.defaultDetailInfluences);\n  var normalized = [];\n  var seen = {};\n\n  chosenInfluences.forEach(function (item) {\n    var normalizedInfluence = normalizeDetailInfluenceItem(\n      item,\n      definition,\n      defaultValueMap\n    );\n    var key;\n\n    if (!normalizedInfluence) {\n      return;\n    }\n\n    key = normalizeText(normalizedInfluence.attribute);\n    if (seen[key]) {\n      return;\n    }\n\n    seen[key] = true;\n    normalized.push(normalizedInfluence);\n  });\n\n  if (normalized.length === 0) {\n    return clone(definition.defaultDetailInfluences);\n  }\n\n  return normalized;\n}\n\nfunction normalizeDetailTargetItem(item, definition, defaultValue) {\n  var attribute;\n  var value;\n\n  if (item && typeof item === \"object\") {\n    attribute = canonicalizeDetailAttribute(item.attribute, definition.targetAttribute);\n    if (!attribute) {\n      return null;\n    }\n\n    value = item.value;\n    if (value === undefined || value === null || value === \"\") {\n      value = defaultValue;\n    }\n\n    return {\n      attribute: attribute,\n      value: value\n    };\n  }\n\n  if (isNonEmptyString(item)) {\n    attribute = canonicalizeDetailAttribute(item, definition.targetAttribute);\n    if (!attribute) {\n      return null;\n    }\n\n    return {\n      attribute: attribute,\n      value: defaultValue\n    };\n  }\n\n  return null;\n}\n\nfunction normalizeDetailInfluenceItem(item, definition, defaultValueMap) {\n  var attribute;\n  var value;\n\n  if (item && typeof item === \"object\") {\n    attribute = canonicalizeDetailAttribute(item.attribute, null, definition.detailInfluenceAttributes);\n    if (!attribute) {\n      return null;\n    }\n\n    value = item.value;\n    if (value === undefined || value === null || value === \"\") {\n      value = defaultValueMap[normalizeText(attribute)];\n    }\n\n    return {\n      attribute: attribute,\n      value: value\n    };\n  }\n\n  if (isNonEmptyString(item)) {\n    attribute = canonicalizeDetailAttribute(item, null, definition.detailInfluenceAttributes);\n    if (!attribute) {\n      return null;\n    }\n\n    return {\n      attribute: attribute,\n      value: defaultValueMap[normalizeText(attribute)]\n    };\n  }\n\n  return null;\n}\n\nfunction buildDetailStatement(definition, targets, influences) {\n  var targetValue = getTargetValue(targets, definition.targetAttribute, definition.defaultTargetValue);\n  var phrases = [];\n  var baseText;\n\n  baseText =\n    \"For all invoices for \" +\n    definition.policyName +\n    \" anomaly check, set enabled to \" +\n    formatPlainValue(targetValue);\n\n  influences.forEach(function (influence) {\n    phrases.push(formatDetailInfluencePhrase(influence.attribute, influence.value));\n  });\n\n  if (phrases.length === 0) {\n    return baseText + \".\";\n  }\n\n  return baseText + \" and \" + joinWithAnd(phrases) + \".\";\n}\n\nfunction formatDetailInfluencePhrase(attribute, value) {\n  var normalizedAttribute = normalizeText(attribute);\n\n  if (normalizedAttribute === \"historical time period\") {\n    return \"historical time period to \" + formatTimeValue(value);\n  }\n\n  if (normalizedAttribute === \"variation\" || normalizedAttribute === \"amount variation\") {\n    return \"variation to \" + formatPlainValue(value);\n  }\n\n  return normalizedAttribute + \" to \" + formatPlainValue(value);\n}\n\nfunction formatTimeValue(value) {\n  var text = formatPlainValue(value);\n\n  if (/^\\d+$/.test(text)) {\n    return text + \" days\";\n  }\n\n  return text;\n}\n\nfunction formatPlainValue(value) {\n  if (value === undefined || value === null) {\n    return \"\";\n  }\n\n  return String(value);\n}\n\nfunction normalizeText(value) {\n  if (value === undefined || value === null) {\n    return \"\";\n  }\n\n  return String(value)\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \" \")\n    .trim();\n}\n\nfunction getTargetValue(targets, targetAttribute, defaultValue) {\n  var normalizedTargetAttribute = normalizeText(targetAttribute);\n  var i;\n\n  if (Array.isArray(targets)) {\n    for (i = 0; i < targets.length; i += 1) {\n      if (!targets[i] || typeof targets[i] !== \"object\") {\n        continue;\n      }\n\n      if (normalizeText(targets[i].attribute) === normalizedTargetAttribute) {\n        if (targets[i].value !== undefined && targets[i].value !== null && targets[i].value !== \"\") {\n          return targets[i].value;\n        }\n      }\n    }\n  }\n\n  return defaultValue;\n}\n\nfunction chooseNonEmptyArray(preferred, fallback, defaultArray) {\n  if (Array.isArray(preferred) && preferred.length > 0) {\n    return preferred;\n  }\n\n  if (Array.isArray(fallback) && fallback.length > 0) {\n    return fallback;\n  }\n\n  if (Array.isArray(defaultArray)) {\n    return defaultArray;\n  }\n\n  return [];\n}\n\nfunction buildDefaultDetailInfluenceValueMap(defaultInfluences) {\n  var map = {};\n\n  if (!Array.isArray(defaultInfluences)) {\n    return map;\n  }\n\n  defaultInfluences.forEach(function (item) {\n    if (!item || typeof item !== \"object\" || !isNonEmptyString(item.attribute)) {\n      return;\n    }\n\n    map[normalizeText(item.attribute)] = item.value;\n  });\n\n  return map;\n}\n\nfunction canonicalizeDetailAttribute(attribute, targetAttribute, allowedAttributes) {\n  var normalized = normalizeText(attribute);\n  var canonical;\n  var allowed;\n\n  if (!normalized) {\n    return null;\n  }\n\n  if (normalized === \"po\" || normalized === \"purchase order\") {\n    normalized = \"purchase order number\";\n  }\n\n  if (normalized === \"amount variation\") {\n    normalized = \"variation\";\n  }\n\n  if (targetAttribute && normalizeText(targetAttribute) === normalized) {\n    return targetAttribute;\n  }\n\n  allowed = Array.isArray(allowedAttributes) ? allowedAttributes : [];\n  for (var i = 0; i < allowed.length; i += 1) {\n    if (normalizeText(allowed[i]) === normalized) {\n      canonical = allowed[i];\n      break;\n    }\n  }\n\n  return canonical || null;\n}\n\nfunction chooseText(preferred, fallback, generated) {\n  if (isNonEmptyString(preferred)) {\n    return preferred;\n  }\n\n  if (isNonEmptyString(fallback)) {\n    return fallback;\n  }\n\n  return generated;\n}\n\nfunction joinWithAnd(items) {\n  if (!Array.isArray(items) || items.length === 0) {\n    return \"\";\n  }\n\n  if (items.length === 1) {\n    return items[0];\n  }\n\n  if (items.length === 2) {\n    return items[0] + \" and \" + items[1];\n  }\n\n  return items.slice(0, -1).join(\", \") + \" and \" + items[items.length - 1];\n}\n\nfunction getFirstTargetAttribute(targets) {\n  if (!Array.isArray(targets) || targets.length === 0) {\n    return null;\n  }\n\n  if (targets[0] && typeof targets[0] === \"object\" && isNonEmptyString(targets[0].attribute)) {\n    return targets[0].attribute;\n  }\n\n  if (isNonEmptyString(targets[0])) {\n    return targets[0];\n  }\n\n  return null;\n}\n\nfunction lookupPolicyId(value) {\n  var normalized = normalizeText(value);\n\n  if (!normalized) {\n    return null;\n  }\n\n  return POLICY_ID_LOOKUP[normalized] || null;\n}\n\nfunction buildPolicyIdLookup() {\n  var lookup = {};\n  var policyId;\n  var definition;\n\n  for (policyId in ANOMALY_DEFINITIONS) {\n    if (!Object.prototype.hasOwnProperty.call(ANOMALY_DEFINITIONS, policyId)) {\n      continue;\n    }\n\n    definition = ANOMALY_DEFINITIONS[policyId];\n    registerLookup(lookup, definition.policyId, definition.policyId);\n    registerLookup(lookup, definition.detailId, definition.policyId);\n    registerLookup(lookup, definition.policyName, definition.policyId);\n    registerLookup(lookup, definition.targetAttribute, definition.policyId);\n  }\n\n  return lookup;\n}\n\nfunction registerLookup(lookup, key, policyId) {\n  var normalized = normalizeText(key);\n\n  if (!normalized) {\n    return;\n  }\n\n  lookup[normalized] = policyId;\n}\n\nfunction createCloner() {\n  if (typeof structuredClone === \"function\") {\n    return function (value) {\n      return structuredClone(value);\n    };\n  }\n\n  return function (value) {\n    if (value === undefined) {\n      return undefined;\n    }\n\n    return JSON.parse(JSON.stringify(value));\n  };\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction hasO