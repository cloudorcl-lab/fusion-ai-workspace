  "workflowCode": "ORA_HCM_HRL_TEAM_ACTIVITY_ORCHESTRATOR",
  "name": "Team Activity Orchestrator",
  "description": "Coordinates domain-specific agents to fulfill manager queries about their team. Routes requests to the appropriate team-level agents and aggregates responses across HR domains.",
