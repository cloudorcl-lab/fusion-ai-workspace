            {
              "id": "1768494938300_1",
              "name": "prompt",
              "type": "string",
              "value": "Read the following output and extract it into the JSON format as shown:\n{\n\"itemGid\": \"<domainName>.<itemXid>\" | \"MISSING\" if not found,\n\"needsReview\": true | false\n}\n\nIf itemGid is greater than 1 gid or is missing, then set needsReview to true. Otherwise, set it to false.\n\nExample 1:\n{\n \"itemGid\": \"DOMAIN.ITEMXID\",\n \"needsReview\": false\n}\nExample 2:\n{\n\"itemGid\": \"DOMAIN.ITEMXID1,DOMAIN.ITEMXID2\",\n\"needsReview\": true\n}\n\nOutput: {{$context.$nodes.GET_ITEM_BY_ITEM_NAME.$output}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"needsReview\": {\n            \"type\": \"boolean\"\n        },\n        \"itemGid\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
