{
  "workflowId": "300000326919596",
  "workflowCode": "ORA_OTM_RATE_INQUIRY_ASSISTANT_TEMPLATE",
  "name": "OTM Rate Inquiry Assistant Deprecated",
  "description": "A workflow designed for performing OTM Rate Inquiry helping you quickly find shipping options and rates. To get started, please provide the following required information: number of ship units, item ID, source ID, and destination ID. You may also include optional details such as per ship unit weight and per ship unit volume for more accurate results.\nYou can provide GID, XID or Name for item, source and destination locations.\nYou can ask for all available options, the fastest transit, or the lowest cost shipping solutions.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
