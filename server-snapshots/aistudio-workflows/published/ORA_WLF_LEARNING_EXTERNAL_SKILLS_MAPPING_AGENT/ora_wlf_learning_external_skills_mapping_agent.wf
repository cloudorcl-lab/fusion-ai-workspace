                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"skillMappingId\": { \"type\": \"integer\" },\n    \"provider\": { \"type\": \"string\" },\n    \"providerSkill\": { \"type\": \"string\" },\n    \"dispositionMethod\": { \"type\": \"string\" },\n    \"skillCatalogItemId\": { \"type\": \"integer\" }\n  },\n  \"required\": [\n    \"skillMappingId\",\n    \"provider\",\n    \"providerSkill\",\n    \"dispositionMethod\",\n    \"skillCatalogItemId\"\n  ]\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Existing Entry",
                    "returnType": "object",
                    "sourceCode": "let raw =\n  $context.$nodes.FOR_EACH_NORMALIZED_SKILL\n    .FETCH_SKILL_MAPPING_ENTRY.$output.items[0];\n\nlet existingItem =\n  typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\nlet resultObj = {\n  skillMappingId: existingItem.skillMappingId,\n  dispositionMethod: existingItem.dispositionMethod,\n  skillCatalogItemId: existingItem.skillCatalogItemId,\n  matchingSkill: existingItem.matchingSkill,\n  mappingResult: \"EXISTING\"\n};\n\nresultObj;"
                  },
                  "outcomes": {
                    "success": "end_1763085629151"
                  },
                  "code": "EXISTING_ENTRY",
                  "id": "1771323482050",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1763085629151"
            },
            "loopType": "PARALLEL",
            "name": "For Each Normalized Skill"
          },
          "outcomes": {
            "success": "1766040045995"
          },
          "code": "FOR_EACH_NORMALIZED_SKILL",
          "id": "1763085629151",
          "inputs": [
            {
              "id": "1763085629152_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.CONVERT_TO_JSON_OBJECT.$output.result}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Convert Agent output to JSON object",
            "returnType": "array",
            "sourceCode": "let normalizedOutput = $context.$nodes.CALL_SKILL_NORMALIZATION_AGENT_WFA.$output.output;\nif (typeof normalizedOutput === \"string\") {\n  try {\n    normalizedOutput = JSON.parse(normalizedOutput);\n  } catch (e) {\n    normalizedOutput = null;\n  }\n}\nlet collection = [];\nif (normalizedOutput) {\n  if (Array.isArray(normalizedOutput.result)) {\n    collection = normalizedOutput.result;\n  }  else if (typeof normalizedOutput.result === \"object\" && normalizedOutput.result !== null) {\n    collection = [normalizedOutput.result];\n  } else if (Array.isArray(normalizedOutput)) {\n    collection = normalizedOutput.map(item => item.result);\n  }\n}\nreturn collection;"
          },
          "outcomes": {
            "success": "1763085629151"
          },
          "code": "CONVERT_TO_JSON_OBJECT",
          "id": "1764832312731",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare agent response",
            "returnType": "array",
            "sourceCode": "const consolidated = [];\nlet forEachResults = [];\nlet normalizedOutput = $context.$nodes.FOR_EACH_NORMALIZED_SKILL.$output;\nif (typeof normalizedOutput === \"string\") {\n  try {\n    normalizedOutput = JSON.parse(normalizedOutput);\n  } catch (e) {\n    normalizedOutput = null;\n  }\n}\nif (normalizedOutput && Array.isArray(normalizedOutput.result)) {\n  forEachResults = normalizedOutput.result.map(str => {\n    try {\n      return JSON.parse(str);\n    } catch (e) {\n      return str;\n    }\n  });\n} else if (Array.isArray(normalizedOutput)) {\n  forEachResults = normalizedOutput.map(str => {\n    try {\n      return JSON.parse(str);\n    } catch (e) {\n      return str;\n    }\n  });\n}\n\nlet normalizedSkills = $context.$nodes.CONVERT_TO_JSON_OBJECT.$output.result;\nnormalizedSkills.forEach((skillItem, index) => {\n     let inputSkill = skillItem.inputSkill;\n     let result = forEachResults[index];  \n     if (result && result.result) {\n         result = result.result;\n     }\n    if (result && typeof result === \"object\" && result.skillMappingId !== undefined) {\n        consolidated.push({\n            inputSkill,\n            skillMappingId: result.skillMappingId,\n            dispositionMethod: result.dispositionMethod,\n            skillCatalogItemId: result.skillCatalogItemId,\n            matchingSkill: result.matchingSkill,\n            mappingResult: result.mappingResult || \"SUCCESS\"\n        });\n    } else {\n        consolidated.push({\n            inputSkill,\n            skillMappingId: -1,\n            dispositionMethod: skillItem.dispositionMethod,\n            skillCatalogItemId: -1,\n            matchingSkill: \"\",\n            mappingResult: result\n        });\n    }\n});\nreturn consolidated;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PREPARE_AGENT_RESPONSE",
          "id": "1766040045995",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
