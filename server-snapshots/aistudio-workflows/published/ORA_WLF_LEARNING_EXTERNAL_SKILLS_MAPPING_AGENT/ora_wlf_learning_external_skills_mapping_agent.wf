                  "code": "CHECK_IF_MAPPING_ENTRY_UPDATE_ALLOWED",
                  "convergenceTargetId": "end_1763085629151",
                  "id": "1771322927308",
                  "inputs": [
                    {
                      "id": "1771322927310_1",
                      "name": "condition",
                      "type": "string",
                      "value": "{{$context.$nodes.FOR_EACH_NORMALIZED_SKILL.$currentItem.dispositionMethod != 'ORA_HRT_NEW_SKILL' && $context.$nodes.FOR_EACH_NORMALIZED_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].dispositionMethod == 'ORA_HRT_NEW_SKILL' &&  $context.$nodes.FOR_EACH_NORMALIZED_SKILL.FETCH_SKILL_MAPPING_ENTRY.$output.items[0].skillCatalogItemId == null}}"
                    }
                  ],
                  "type": "CONDITION"
