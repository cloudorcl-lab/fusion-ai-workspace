          "code": "CHECKINPUTPASSED",
          "convergenceTargetId": "1766164284943",
          "id": "1766150787451",
          "inputs": [
            {
              "id": "1766150787455_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.focusPersons[0].PersonId != null && $context.$triggers.REST.$input.focusPersons[0] .PersonId!== \"\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "ReturnTeamDetails",
            "returnType": "object",
            "sourceCode": "// Input: $context.$nodes.LOOPTEAMDETAILS.$output\nvar raw = $context.$nodes.LOOPTEAMDETAILS.$output;\n\n// Parse outer array\nvar outer = (typeof raw === \"string\") ? JSON.parse(raw) : raw;\n\n// Parse wrapper object (first element is a string)\nvar wrapperStr = (outer && outer.length) ? outer[0] : null;\nvar wrapperObj = (typeof wrapperStr === \"string\") ? JSON.parse(wrapperStr) : wrapperStr;\n\n// Get array of section strings\nvar fptd = (wrapperObj && wrapperObj.result && wrapperObj.result.focusPersonTeamDetails)\n  ? wrapperObj.result.focusPersonTeamDetails\n  : [];\nif (!fptd || typeof fptd.length !== \"number\") {\n  fptd = [fptd];\n}\n\n// Collect sections as-is: sectionName -> rows array\nvar sectionsByName = {};\nvar i, sectionStr, parsed, sectionResult, sectionName;\n\nfor (i = 0; i < fptd.length; i++) {\n  sectionStr = \"\" + fptd[i];\n  // normalize **true**/**false**/**null** if present\n  sectionStr = sectionStr.replace(/\\*\\*(true|false|null)\\*\\*/gi, \"$1\");\n  parsed = JSON.parse(sectionStr);       // {result:{employment_details:[...]}, ...}\n  sectionResult = parsed.result || {};   // {employment_details:[...]} etc.\n\n  for (sectionName in sectionResult) {\n    if (sectionResult.hasOwnProperty(sectionName)) {\n      sectionsByName[sectionName] = sectionResult[sectionName];\n    }\n  }\n}\n\n// Build worker_details by AssignmentId and FLATTEN all unique attributes from\n// employment_details + talent_details + compensation_details directly under worker_details items.\nvar empRows  = sectionsByName[\"employment_details\"]   || [];\nvar talRows  = sectionsByName[\"talent_details\"]       || [];\nvar compRows = sectionsByName[\"compensation_details\"] || [];\n\nvar workerIndex = {};   // AssignmentId -> merged object\nvar workerOrder = [];   // preserve order based on employment_details first\n\nvar j, row, aid, k;\n\n// Seed + merge from employment_details\nfor (j = 0; j < empRows.length; j++) {\n  row = empRows[j];\n  if (!row || !row.AssignmentId) continue;\n\n  aid = row.AssignmentId;\n\n  if (!workerIndex[aid]) {\n    workerIndex[aid] = { AssignmentId: aid };\n    workerOrder.push(aid);\n  }\n\n  // Copy all keys from row onto worker (flatten), except AssignmentId\n  for (k in row) {\n    if (row.hasOwnProperty(k)) {\n      if (k === \"AssignmentId\") continue;\n      workerIndex[aid][k] = row[k];\n    }\n  }\n}\n\n// Merge from talent_details\nfor (j = 0; j < talRows.length; j++) {\n  row = talRows[j];\n  if (!row || !row.AssignmentId) continue;\n\n  aid = row.AssignmentId;\n\n  if (!workerIndex[aid]) {\n    workerIndex[aid] = { AssignmentId: aid };\n    workerOrder.push(aid);\n  }\n\n  for (k in row) {\n    if (row.hasOwnProperty(k)) {\n      if (k === \"AssignmentId\") continue;\n      workerIndex[aid][k] = row[k]; // overwrites if same key exists\n    }\n  }\n}\n\n// Merge from compensation_details\nfor (j = 0; j < compRows.length; j++) {\n  row = compRows[j];\n  if (!row || !row.AssignmentId) continue;\n\n  aid = row.AssignmentId;\n\n  if (!workerIndex[aid]) {\n    workerIndex[aid] = { AssignmentId: aid };\n    workerOrder.push(aid);\n  }\n\n  for (k in row) {\n    if (row.hasOwnProperty(k)) {\n      if (k === \"AssignmentId\") continue;\n      workerIndex[aid][k] = row[k]; // overwrites if same key exists\n    }\n  }\n}\n\n// worker_details array\nvar worker_details = [];\nfor (i = 0; i < workerOrder.length; i++) {\n  worker_details.push(workerIndex[workerOrder[i]]);\n}\n\n// Final output:\n// - worker_details added (flattened; no nested employment_details/talent_details/compensation_details)\n// - all other sections kept as-is\n// - do NOT include employment_details/talent_details/compensation_details at top level\nvar finalOut = { worker_details: worker_details };\n\nfor (sectionName in sectionsByName) {\n  if (sectionsByName.hasOwnProperty(sectionName)) {\n    if (sectionName === \"employment_details\") continue;\n    if (sectionName === \"talent_details\") continue;\n    if (sectionName === \"compensation_details\") continue;\n    finalOut[sectionName] = sectionsByName[sectionName]; // keep absence_details etc.\n  }\n}\n\nvar output = finalOut;\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURNTEAMDETAILS",
