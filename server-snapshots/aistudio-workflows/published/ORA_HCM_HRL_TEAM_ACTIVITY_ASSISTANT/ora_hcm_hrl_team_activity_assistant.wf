                            "name": "PrepareDateFilterArray",
                            "returnType": "array",
                            "sourceCode": "const dateArray = [];\nconst currentDate = new Date($context.$system.$currentDate); // e.g., \"2026-02-27\"\n\n// Helper: midnight UTC ISO\nconst toMidnightIsoUTC = (d) =>\nnew Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate(), 0, 0, 0, 0)).toISOString();\n\n// Add calendar months with day clamping, then set to midnight UTC\nconst addMonthsMidnightIso = (d, months) => {\nconst y = d.getUTCFullYear();\nconst m = d.getUTCMonth();\nconst day = d.getUTCDate();\nconst tmp = new Date(Date.UTC(y, m + months, 1, 0, 0, 0, 0));\nconst lastDay = new Date(Date.UTC(tmp.getUTCFullYear(), tmp.getUTCMonth() + 1, 0)).getUTCDate();\ntmp.setUTCDate(Math.min(day, lastDay)); // clamp day\nreturn new Date(Date.UTC(tmp.getUTCFullYear(), tmp.getUTCMonth(), tmp.getUTCDate(), 0, 0, 0, 0)).toISOString();\n};\n\ndateArray.push(toMidnightIsoUTC(currentDate)); // current date start of day\ndateArray.push(addMonthsMidnightIso(currentDate, 6)); // +6 months start of day\n\nconst absDateFilterArray =  [\n  {\n    name: [\"AbsenceDateRange\"],\n    values: dateArray\n  }\n];\n\nreturn absDateFilterArray;"
                          },
                          "outcomes": {
                            "success": "1772210405710"
                          },
                          "code": "PREPAREDATEFILTERARRAY",
                          "convergenceTargetId": "1766642103987",
                          "id": "1772209459882",
