          "inputs": [
            {
              "id": "1772981983180_1",
              "name": "collection_filter_string",
              "type": "string",
              "value": "{{$context.$nodes.CONSTRUCT_INSIGHTS_FILTER_PAYLOAD.$output.result.collection}}"
            },
            {
              "id": "1772981983181_2",
              "name": "input_parameters",
              "type": "string",
              "value": "{{$context.$nodes.CONSTRUCT_INSIGHTS_FILTER_PAYLOAD.$output.result.parameters}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"object\",\n          \"properties\": {\n            \"insightRecipientId\": {\n              \"type\": \"string\"\n            },\n            \"recipientTypeCode\": {\n              \"type\": \"string\"\n            },\n            \"recipientName\": {\n              \"type\": \"string\"\n            },\n            \"statusCode\": {\n              \"type\": \"string\"\n            },\n            \"timeCreated\": {\n              \"type\": \"string\"\n            },\n            \"sensorSignal\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"signalId\": {\n                  \"type\": \"string\"\n                },\n                \"policy\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"ruleId\": {\n                      \"type\": \"string\"\n                    },\n                    \"ruleName\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"ruleId\",\n                    \"ruleName\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"signalId\",\n                \"policy\"\n              ]\n            }\n          },\n          \"required\": [\n            \"insightRecipientId\",\n            \"recipientTypeCode\",\n            \"recipientName\",\n            \"statusCode\",\n            \"timeCreated\",\n            \"sensorSignal\"\n          ]\n        },\n        {\n          \"type\": \"object\",\n          \"properties\": {\n            \"insightRecipientId\": {\n              \"type\": \"string\"\n            },\n            \"recipientTypeCode\": {\n              \"type\": \"string\"\n            },\n            \"recipientName\": {\n              \"type\": \"string\"\n            },\n            \"statusCode\": {\n              \"type\": \"string\"\n            },\n            \"timeCreated\": {\n              \"type\": \"string\"\n            },\n            \"sensorSignal\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"signalId\": {\n                  \"type\": \"string\"\n                },\n                \"policy\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"ruleId\": {\n                      \"type\": \"string\"\n                    },\n                    \"ruleName\": {\n                      \"type\": \"string\"\n                    }\n                  },\n                  \"required\": [\n                    \"ruleId\",\n                    \"ruleName\"\n                  ]\n                }\n              },\n              \"required\": [\n                \"signalId\",\n                \"policy\"\n              ]\n            }\n          },\n          \"required\": [\n            \"insightRecipientId\",\n            \"recipientTypeCode\",\n            \"recipientName\",\n            \"statusCode\",\n            \"timeCreated\",\n            \"sensorSignal\"\n          ]\n        }\n      ]\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"hasMore\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Add node for get_insights_by_rule_filters case branch",
            "name": "Add (get_insights_by_rule_filters Case)"
          },
          "outcomes": {
            "success": "end"
          },
          "id": "add_get_insights_by_rule_filters_1772949888706",
          "inputs": [],
          "type": "ADD"
        },
        {
          "metadata": {
            "name": "Construct Insights Filter Payload",
            "returnType": "object",
            "sourceCode": "let sensorCode = $context.$triggers.REST.$input.sensorCode;\nlet  query = $context.$triggers.REST.$input.query;\n\nconst promptFilters = query?.promptFilters ?? [];\nconst categoryFilters = query?.categoryFilters?? [];\nconst statusFilters = query?.statusFilters?? [];\nconst priorityFilters = query?.priorityFilters?? [];\nconst limit = query.limit?? 25;\nconst offset = query.offset?? 0;\n\nif(!Array.isArray(promptFilters)) promptFilters = [];\n\nif (promptFilters.length > 0 && !Array.isArray(promptFilters[0])) promptFilters = [promptFilters];\n\n\nconst queryParts = [];\n\n// default filter : rule_active = true\nqueryParts.push(\"sensorSignal.policy.activeFlag=true\");\n\n\n// constructing prompt filters query string\nconst orGroups = promptFilters\n    .filter(group => Array.isArray(group) && group.length > 0)\n    .map(group => {\n      const andParts = group\n        .filter(v => v !== null && v !== undefined && String(v).trim() !== \"\")\n        .map(v => `sensorSignal.policy.ruleName ~like '%${String(v)}%'`);\n      return andParts.length ? `(${andParts.join(\" AND \")})` : \"\";\n    })\n    .filter(Boolean);\n\n  if (orGroups.length) {\n    queryParts.push(`(${orGroups.join(\" OR \")})`);\n  }\n\n\n\n// constructing category filters query string\nif(categoryFilters.length)\n{\n      const categoryFiltersQuery = categoryFilters.map( item=> `sensorSignal.policy.categoryCode='${String(item)}'`).join(\" OR \");\n      queryParts.push(`(${categoryFiltersQuery})`);\n}\n\n// constructing priority filters query string\nif(priorityFilters.length)\n{\n      const priorityFiltersQuery = priorityFilters.map( item=> `sensorSignal.policy.rulePriority.lookupCode= '${String(item)}'`).join(\" OR \");\n      queryParts.push(`(${priorityFiltersQuery})`);\n}\n\n// constructing status filters query string\nif(statusFilters.length)\n{\n      const statusFiltersQuery = statusFilters.map( item=> `status.lookupCode='${String(item)}'`).join(\" OR \");\n      queryParts.push(`(${statusFiltersQuery})`);\n}\n\nconst payloadObject = {\n      parameters: { \"sensorCode\": sensorCode},\n    collection: { \n          filter: queryParts.join(\" AND \"),\n      ...(limit !== undefined ? { limit } : {}),\n      ...(offset !== undefined ? { offset } : {})}\n}\n\nreturn payloadObject;"
          },
          "outcomes": {
            "success": "1772975546186"
          },
          "code": "CONSTRUCT_INSIGHTS_FILTER_PAYLOAD",
          "convergenceTargetId": "1772975546186",
          "id": "1772951129203",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
