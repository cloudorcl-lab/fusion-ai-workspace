              "modelName": "GPT-5 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Extract Account Search Terms"
          },
          "outcomes": {
            "success": "19000000000235"
          },
          "diagram": {
            "x": 5825,
            "y": 5912
          },
          "id": "19000000000233",
          "code": "EXTRACT_ACCOUNT_SEARCH_TERMS",
          "type": "LLM",
          "inputs": [
            {
              "id": "19000000000233_prompt",
              "name": "prompt",
              "type": "string",
              "value": "ROLE:\nExtract account search terms for an individual-account question.\n\nUSER QUESTION:\n{{$context.$system.$inputMessage}}\n\nCHAT HISTORY:\n{{$context.$system.$chatHistory}}\n\nTASK:\nReturn account identifiers and search terms needed to find the account.\n\nSOURCE PRIORITY:\n1. First use the current USER QUESTION.\n2. If the current USER QUESTION explicitly names an account, email, address, PartyId, or PartyNumber, use that and ignore conflicting older chat history.\n3. If the current USER QUESTION says \"this account\", \"that account\", \"the account\", \"same account\", \"current account\", or similar, resolve it from the most recent relevant CHAT HISTORY only when exactly one account is clearly referenced.\n4. If the current USER QUESTION uses those referential phrases and CHAT HISTORY contains multiple possible accounts or multiple PartyNumbers, do not guess. Set ambiguousHistoryReference to true and leave PartyNumber empty.\n\nFIELDS TO EXTRACT:\n- PartyId\n- PartyNumber\n- PartyUniqueName\n- PrimaryEmail\n- PrimaryAddress\n- candidatePartyNumbers\n- ambiguousHistoryReference\n\nEXTRACTION RULES:\n- PartyId should be returned only when explicitly available.\n- PartyNumber should be returned only when explicitly available or when one clear prior account is referenced by the current question. Party numbers may look like CDRM_12345, ORCL-0001, DACC_001, or similar account identifiers.\n- PartyUniqueName should be the company, customer, or account name.\n- PrimaryEmail should be returned only when an email address is explicitly available.\n- PrimaryAddress should be an address, city, state, country, postal code, or location phrase only if explicitly available.\n- candidatePartyNumbers should contain all distinct possible PartyNumbers from relevant CHAT HISTORY when the current question refers to a prior account ambiguously.\n- ambiguousHistoryReference must be true only when the user refers to a prior account and multiple possible accounts are present in CHAT HISTORY.\n- Do not put generic words such as account, owner, opportunity, opportunities, open, show, tell, who, this, that, same, or customer into PartyUniqueName.\n- If a string value is not present, return an empty string for that field.\n- Return valid JSON only.\n- Do not include markdown or explanation.\n- Preserve all extracted values exactly as they appear in the current USER QUESTION or CHAT HISTORY. Do not normalize, title-case, lowercase, uppercase, trim internal spacing, correct spelling, expand abbreviations, or otherwise rewrite extracted values.\n\nSTRICT OUTPUT FORMAT:\n{\n  \"PartyId\": \"string\",\n  \"PartyNumber\": \"string\",\n  \"PartyUniqueName\": \"string\",\n  \"PrimaryEmail\": \"string\",\n  \"PrimaryAddress\": \"string\",\n  \"candidatePartyNumbers\": [\"string\"],\n  \"ambiguousHistoryReference\": false\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"PartyId\": {\n      \"type\": \"string\"\n    },\n    \"PartyNumber\": {\n      \"type\": \"string\"\n    },\n    \"PartyUniqueName\": {\n      \"type\": \"string\"\n    },\n    \"PrimaryEmail\": {\n      \"type\": \"string\"\n    },\n    \"PrimaryAddress\": {\n      \"type\": \"string\"\n    },\n    \"candidatePartyNumbers\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"ambiguousHistoryReference\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"PartyId\",\n    \"PartyNumber\",\n    \"PartyUniqueName\",\n    \"PrimaryEmail\",\n    \"PrimaryAddress\",\n    \"candidatePartyNumbers\",\n    \"ambiguousHistoryReference\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Prepare Account Collection Query",
            "sourceCode": "function toPositiveInteger(value) {\n  if (value == null) {\n    return 0;\n  }\n\n  var raw = String(value).trim();\n  if (raw === \"\") {\n    return 0;\n  }\n\n  var numberValue = Number(raw);\n  if (!isFinite(numberValue) || numberValue <= 0) {\n    return 0;\n  }\n\n  return Math.floor(numberValue);\n}\n\nvar restInput = $context.$triggers.REST.$input || {};\nvar action = restInput.action || {};\nvar config = action.config || {};\nvar maxAccounts = toPositiveInteger(config.maxAccounts);\nvar limit = maxAccounts > 0 ? maxAccounts : 50;\n\n var filterConfiguration = action.filterConfiguration || {};\n var accountRecordset = filterConfiguration.accountRecordSet || \"MYSALESTEAMTERRACCTS\";\n\nreturn {\n  object: \"Account\",\n  query: JSON.stringify({\n    op: \"$and\",\n    criteria: [\n      {\n        op: \"$eq\",\n        attribute: \"PartyRecordSet\",\n        value: accountRecordset\n      }\n    ]\n  }),\n  sort: JSON.stringify([\n    {\n      attribute: \"AccountRollup.NextAppointmentDate\",\n      direction: \"descending\"\n    }\n  ]),\n  fields: JSON.stringify([\n    \"PartyId\",\n    \"PartyNumber\",\n    \"PartyUniqueName\",\n    \"AccountRollup\"\n  ]),\n  limit: String(limit)\n};",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1778294692054"
          },
          "diagram": {
            "x": 6275,
            "y": 5912
          },
          "id": "19000000000238",
          "code": "PREPARE_ACCOUNT_COLLECTION_QUERY",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_completion_tokens": 32000,
                "reasoning_effort": "low"
              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "GPT-5 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "FinalOutput"
          },
          "outcomes": {
            "success": "end"
          },
          "diagram": {
            "x": 5375,
            "y": 6134
          },
          "code": "FINALOUTPUT",
          "id": "1765328523317",
          "inputs": [
            {
              "id": "1765328523320_1",
              "name": "prompt",
              "type": "string",
              "value": "INPUT SOURCES\n\nAccount Data from Agent:\n{{$context.$nodes.INVOKE_CUSTOMER_INTENT_INTELLIGENCE_AGENT.$output.output}}\n\nUser Query:\n{{$context.$system.$inputMessage}}\n\n\nOUTPUT FORMAT (STRICT)\n\nheaderText ? Create a short, crisp header Text based on the Input Question\nprimaryText ? A very short phrase describing the output. For example if Input is \"Show me top 10 accounts by ARR\" , then primaryText can be \"Top 10 Customers\"\nsecondaryText ? Another very short phrase describing the context. For example if Input is \"Show me top 10 accounts by ARR\" , then secondaryText can be \"Based on ARR\"\n\n\nThe items array is derived from Account Data from Agent. \nDefault Attributes to display are accountName,accountId,registryIdentifier,annualRecurringRevenue,ownedProducts,suggestedProducts,engagementTrend,renewalDate,currencyCode\nThe renewalDate should not have a time component.\nFor suggestedProducts and ownedProducts - Add a space between each element in the list\nFor engagementTrend is positive, then return \"High\", if negative then \"Low\" . Else return \"Stable\"\nIf user is requesting specific attributes in the question, then it should be added to this list\n\n\n\nThe summary must:\nBe 3?4 lines, concise and insightful. Summaries should provide interpretation, not duplication of the raw data.\nNot repeat information that is already explicitly present in the output data (e.g., highest ARR account, numeric ranges, metrics that are already displayed).\nInstead, provide interpretive insight, such as:\npatterns\ntrends\nanomalies\nconcentration observations\nengagement signals\nrisk indicators\nmeaningful groupings\nExample of acceptable insight (NOT repeating data):\n\n?Most accounts in this list show stable ARR with a few outliers that contribute disproportionately to total revenue.?\n?Several accounts have declining engagement trends, which may impact renewals.?\n?The accounts span multiple industries, suggesting diversified revenue sources.?\n?A cluster of accounts shows open P1 issues, indicating potential churn risk.?\n\n\n\n\n\nicon MUST always be: oj-ux-ico-table\ntype MUST always be: chip\nIf Account Data is empty ? items MUST be an empty array.\n\nRETURN THE RESPONSE IN EXACTLY THIS STRUCTURE\n{\n  \"type\": \"\",\n  \"headerText\": \"\",\n  \"primaryText\": \"\",\n  \"secondaryText\": \"\",\n  \"icon\": \"\",\n  \"postback\": {\n    \"summary\": \"\",\n    \"items\": [\n      {\n        \"ATTRIBUTE\": \"VALUE\"\n      }\n    ]\n  }\n}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": { \"type\": \"string\" },\n    \"headerText\": { \"type\": \"string\" },\n    \"primaryText\": { \"type\": \"string\" },\n    \"secondaryText\": { \"type\": \"string\" },\n    \"icon\": { \"type\": \"string\" },\n    \"postback\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"summary\": { \"type\": \"string\" },\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {}\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Resolve Extracted Account Reference",
            "returnType": "object",
            "sourceCode": "function parseJsonIfNeeded(value) {\n    if (typeof value !== \"string\") {\n      return value || {};\n    }\n\n    var trimmed = value.trim();\n    if (trimmed === \"\") {\n      return {};\n    }\n\n    try {\n      return JSON.parse(trimmed);\n    } catch (e) {\n      return {};\n    }\n  }\n\n  function clean(value) {\n    if (value == null) {\n      return \"\";\n    }\n\n    return String(value).trim();\n  }\n\n  function readBoolean(value) {\n    if (typeof value === \"boolean\") {\n      return value;\n    }\n\n    if (typeof value === \"string\") {\n      return value.toLowerCase() === \"true\";\n    }\n\n    return false;\n  }\n\n  var extracted = parseJsonIfNeeded($context.$nodes.EXTRACT_ACCOUNT_SEARCH_TERMS.$output);\n\n  var partyId = clean(extracted.PartyId || extracted.partyId);\n  var partyNumber = clean(extracted.PartyNumber || extracted.partyNumber || extracted.accountNumber || extracted.AccountNumber);\n  var partyUniqueName = clean(extracted.PartyUniqueName || extracted.partyUniqueName || extracted.accountName || extracted.AccountName);\n  var ambiguousHistoryReference = readBoolean(extracted.ambiguousHistoryReference || extracted.AmbiguousHistoryReference);\n\n  var route = \"SEARCH\";\n  var partyNumbers = [];\n  var reason = \"Search by account attributes.\";\n\n  if (ambiguousHistoryReference) {\n    route = \"CLARIFY\";\n    reason = \"The account reference is ambiguous in chat history.\";\n  } else if (partyNumber !== \"\") {\n    route = \"DIRECT\";\n    partyNumbers = [partyNumber];\n    reason = \"PartyNumber was extracted.\";\n  } else if (partyId !== \"\") {\n    route = \"DIRECT\";\n    partyNumbers = [partyId];\n    reason = \"PartyId was extracted.\";\n  } else if (partyUniqueName !== \"\") {\n    route = \"SEARCH\";\n    reason = \"PartyUniqueName was extracted.\";\n  }\n\n  var result = {\n    route: route,\n    partyNumbers: partyNumbers,\n    candidatePartyNumbers: extracted.candidatePartyNumbers || extracted.CandidatePartyNumbers || [],\n    reason: reason,\n    extracted: extracted\n  };\n\n  return result;"
          },
          "outcomes": {
            "success": "19000000000236"
