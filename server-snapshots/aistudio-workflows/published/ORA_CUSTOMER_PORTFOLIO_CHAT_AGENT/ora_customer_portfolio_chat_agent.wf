          "code": "PREPARE_ACCOUNT_OUTCOME_BATCHES",
          "id": "1778286020801",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare User Account Search Query",
            "returnType": "string",
            "sourceCode": "function parseJsonIfNeeded(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  var trimmed = value.trim();\n  if (trimmed === \"\") {\n    return {};\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction clean(value) {\n  if (value == null) {\n    return \"\";\n  }\n\n  return String(value).trim();\n}\n\nvar extracted = parseJsonIfNeeded($context.$nodes.EXTRACT_ACCOUNT_SEARCH_TERMS.$output);\nvar partyId = clean(extracted.PartyId || extracted.partyId);\nvar partyNumber = clean(extracted.PartyNumber || extracted.partyNumber || extracted.accountNumber || extracted.AccountNumber);\nvar partyUniqueName = clean(extracted.PartyUniqueName || extracted.partyUniqueName || extracted.accountName || extracted.AccountName || extracted.name || extracted.account);\nvar primaryEmail = clean(extracted.PrimaryEmail || extracted.primaryEmail || extracted.email || extracted.EmailAddress || extracted.emailAddress);\nvar primaryAddress = clean(extracted.PrimaryAddress || extracted.primaryAddress || extracted.accountAddress || extracted.AccountAddress || extracted.address || extracted.FormattedAddress || extracted.formattedAddress);\n\nvar criteria = [\n  {\n    op: \"$eq\",\n    attribute: \"PartyRecordSet\",\n    value: \"MYSALESTEAMTERRACCTS\"\n  }\n];\n\nif (partyId !== \"\") {\n  criteria.push({\n    op: \"$eq\",\n    attribute: \"PartyId\",\n    value: partyId\n  });\n}\n\nif (partyNumber !== \"\") {\n  criteria.push({\n    op: \"$eq\",\n    attribute: \"PartyNumber\",\n    value: partyNumber\n  });\n}\n\nif (partyUniqueName !== \"\") {\n  criteria.push({\n    op: \"$co\",\n    attribute: \"PartyUniqueName\",\n    value: partyUniqueName\n  });\n}\n\nif (primaryEmail !== \"\") {\n  criteria.push({\n    op: \"$co\",\n    attribute: \"PrimaryEmail.EmailAddress\",\n    value: primaryEmail\n  });\n}\n\nif (primaryAddress !== \"\") {\n  criteria.push({\n    op: \"$co\",\n    attribute: \"PrimaryAddress.FormattedAddress\",\n    value: primaryAddress\n  });\n}\n\nvar query = {\n  op: \"$and\",\n  criteria: criteria\n};\n\nreturn JSON.stringify(query);"
          },
          "outcomes": {
            "success": "1900000000026"
          },
