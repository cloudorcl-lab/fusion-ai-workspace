          "code": "INDIVIDUAL_ACCOUNT_FINAL_RESPONSE",
          "id": "1778275893415",
          "inputs": [
            {
              "id": "1778275893415_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You role is to take multiple already-generated HTML outputs and stitch them together into one final HTML response without altering content."
            },
            {
              "id": "1778275893415_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are given a list of workflow outputs for multiple account party numbers.\n\nSource:\n{{$context.$nodes.LOOP_ACCOUNT_ADVISOR_RESPONSES.$output}}\n\nEach item contains an HTML response for one account inside the output section.\n\nYour task:\n- Consolidate the responses for all accounts.\n- Preserve each account?s content exactly as provided.\n- Preserve the HTML structure and formatting for each account exactly as provided.\n- Only sequence the HTML blocks one after another, account by account.\n- Do not summarize, rewrite, paraphrase, translate, reorder, merge, or remove any content.\n- Do not change any data values.\n- You may fix only invalid HTML syntax if necessary, and only to make the HTML valid.\n- Do not alter the meaning, wording, tags, attributes, or visible content of any account response.\n\nFinal Output requirements:\n- Return a single combined HTML result.\n- Keep each account response intact.\n- Separate account sections clearly, but do not modify the account content itself.\n- If there is more than one account, place the HTML blocks in the same order as the input.\n\nImportant:\n- Strictly no content changes.\n- Strictly no data changes.\n- Strictly preserve HTML format for each account.\n- Only concatenate the account HTML responses."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Prepare Account Advisor Party Numbers",
            "returnType": "object",
            "sourceCode": "function parseJsonIfNeeded(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  var trimmed = value.trim();\n  if (trimmed === \"\") {\n    return {};\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return {};\n  }\n}\n\nfunction addPartyNumber(value, target, seen) {\n  var item = value == null ? \"\" : String(value).trim();\n  if (item !== \"\" && !seen[item]) {\n    seen[item] = true;\n    target.push(item);\n  }\n}\n\nvar partyNumbers = [];\nvar seen = {};\nvar direct = parseJsonIfNeeded($context.$nodes.RESOLVE_EXTRACTED_ACCOUNT_REFERENCE.$output);\nvar directResult = direct && direct.result ? direct.result : direct;\n\nif (directResult && directResult.route === \"DIRECT\" && Array.isArray(directResult.partyNumbers)) {\n  directResult.partyNumbers.forEach(function(value) {\n    addPartyNumber(value, partyNumbers, seen);\n  });\n}\n\nif (partyNumbers.length === 0) {\n  var raw = $context.$nodes.MATCH_INDIVIDUAL_ACCOUNTS.$output;\n  var parsed = parseJsonIfNeeded(raw);\n  var matches = [];\n\n  if (parsed && Array.isArray(parsed.matches)) {\n    matches = parsed.matches;\n  } else if (Array.isArray(parsed)) {\n    matches = parsed;\n  }\n\n  matches.forEach(function(match) {\n    var value = match;\n    if (match && typeof match === \"object\") {\n      value = match.partyNumber || match.PartyNumber || match.accountNumber || match.AccountNumber;\n    }\n\n    addPartyNumber(value, partyNumbers, seen);\n  });\n}\n\nreturn partyNumbers;"
          },
          "outcomes": {
            "success": "1900000000021"
          },
