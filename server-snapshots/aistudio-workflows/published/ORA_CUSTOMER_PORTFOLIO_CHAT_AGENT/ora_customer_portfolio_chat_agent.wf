          "metadata": {
            "name": "Prepare Account Outcome Batches",
            "returnType": "object",
            "sourceCode": "function parseJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  return JSON.parse(value.trim());\n}\n\nvar accounts = parseJson($context.$nodes.FETCH_ACCOUNT_COLLECTION.$output);\n\nif (!Array.isArray(accounts)) {\n  accounts = parseJson(accounts.result || accounts.output || accounts.items || accounts.accounts || []);\n}\n\nvar partyNumbers = accounts\n  .map(function(account) {\n    return String(account.PartyNumber).trim();\n  })\n  .filter(function(partyNumber) {\n    return partyNumber !== \"\";\n  });\n\nvar batches = [];\n\nfor (var i = 0; i < partyNumbers.length; i += 25) {\n  batches.push(partyNumbers.slice(i, i + 25).join(\",\"));\n}\n\nreturn {\n  batches: batches\n};"
          },
          "outcomes": {
            "success": "1900000000102"
          },
          "diagram": {
