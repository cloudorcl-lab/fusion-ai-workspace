          "code": "ROUTE_BY_FILTER_CONFIGURATION",
          "convergenceTargetId": "end",
          "id": "1900000000001",
          "inputs": [
            {
              "id": "1900000000001_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input?.action?.config?.dataSource == \"CX_UNITY\" ? \"CX_UNITY\" : \"DEFAULT\"}}"
