        {
          "metadata": {
            "name": "constructMYFilter",
            "returnType": "string",
            "sourceCode": "// Resolve my account filter\nvar accountFilterClause = \"\";\n\nvar accountRecordset =\n  $context.$triggers.REST.$input.filterConfiguration.accountRecordSet;\n\nif (accountRecordset != null) {\n  const accountRecordSets = {\n    MYACCTS:\n      \"ownerResource.partyId = @faContext.partyId\",\n\n    MYSALESTEAMACCTS:\n      \"salesTeam[resource.partyId = @faContext.partyId]\",\n\n    MYSUBORDINATESACCTS:\n      \"ownerResource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]\",\n\n    MYSUBORDSSALESTEAMACCTS:\n      \"salesTeam[resource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]]\",\n\n    MYASSGTERRACCTS:\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]\",\n\n    MYASSGDESCTERRACCTS:\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId] or ancestorTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]]]\",\n\n    MYSALESTEAMTERRACCTS:\n      \"salesTeam[resource.partyId = @faContext.partyId] or salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]\",\n\n    MYSUBORDTEAMTERRACCTS:\n      \"salesTeam[resource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]] or \" +\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId] or \" +\n      \"ancestorTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]]]\"\n  };\n\n  if (accountRecordSets[accountRecordset] != null) {\n    accountFilterClause =\n      \"(fusionAccount[\" + accountRecordSets[accountRecordset] + \"])\";\n  }\n}\n\nif ($context.$triggers.REST.$input.filterConfiguration.accountFilter) {\n  accountFilterClause =\n    $context.$triggers.REST.$input.filterConfiguration.accountFilter;\n}\n\n// Resolve my product filter\nvar productFilter = \"\";\n\n// Product filter-by-territory is enabled and user territories cover products\nif ($context.$triggers.REST.$input.filterConfiguration.filterProductByTerritory==null || $context.$triggers.REST.$input.filterConfiguration.filterProductByTerritory) {\n  productFilter =\n    \"((productType = 'PRODUCT_GROUP' and \" +\n    \"fusionProductGroup[parentProductGroupHierarchies[\" +\n    \"baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]) \" +\n    \"or (productType = 'Item' and fusionProduct[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]] \" +\n    \"or parentProductGroups[activeFlag = true and startDate < @currentDateTime \" +\n    \"and endDate > @currentDateTime and productGroup[\" +\n    \"parentProductGroupHierarchies[baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]]]))\";\n}\n\n// Construct MY filter\nvar MYFilter = accountFilterClause;\n\nif (MYFilter !== \"\" && productFilter !== \"\") {\n  MYFilter += \" and \";\n}\n\nif (productFilter !== \"\") {\n  MYFilter += productFilter;\n}\n\nif (MYFilter === \"\") {\n  MYFilter = \"1=1\";\n}\n\nreturn MYFilter;"
          },
          "outcomes": {
            "success": "1771798665988"
          },
