            "sourceCode": "function parseJsonIfNeeded(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  var trimmed = value.trim();\n  if (trimmed === \"\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction hasOutcomeData(value) {\n  var parsed = parseJsonIfNeeded(value);\n\n  if (parsed == null) {\n    return false;\n  }\n\n  if (Array.isArray(parsed)) {\n    return parsed.some(function(item) {\n      return hasOutcomeData(item);\n    });\n  }\n\n  if (typeof parsed !== \"object\") {\n    return false;\n  }\n\n  if (parsed.outcomeType || parsed.OutcomeType || parsed.outcomeSubtype || parsed.OutcomeSubtype || parsed.primaryObjectAltKey || parsed.PrimaryObjectAltKey || parsed.payload || parsed.Payload || parsed.outcomeReferences || parsed.OutcomeReferences) {\n    return true;\n  }\n\n  return Object.keys(parsed).some(function(key) {\n    return hasOutcomeData(parsed[key]);\n  });\n}\n\nvar rawAIOutcomeBatches = $context.$nodes.PAGE_ACCOUNTS_AND_OUTCOMES.$output;\n\nreturn {\n  hasData: hasOutcomeData(rawAIOutcomeBatches),\n  rawAIOutcomeBatches: rawAIOutcomeBatches\n};"
          },
