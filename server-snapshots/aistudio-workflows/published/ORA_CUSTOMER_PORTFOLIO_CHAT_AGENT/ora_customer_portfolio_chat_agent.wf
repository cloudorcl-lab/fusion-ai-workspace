                {
                  "metadata": {
                    "name": "Prepare Outcome Store IN Clause",
                    "returnType": "object",
                    "sourceCode": "function parseJsonIfNeeded(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  var trimmed = value.trim();\n  if (trimmed === \"\") {\n    return value;\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (e) {\n    return value;\n  }\n}\n\nfunction clean(value) {\n  if (value == null) {\n    return \"\";\n  }\n\n  return String(value).trim();\n}\n\nfunction quote(value) {\n  return \"'\" + String(value).replace(/'/g, \"''\") + \"'\";\n}\n\nfunction readPartyNumber(account) {\n  if (!account || typeof account !== \"object\") {\n    return clean(account);\n  }\n\n  return clean(account.PartyNumber || account.partyNumber || account.AccountNumber || account.accountNumber || account.primaryObjectAltKey || account.PrimaryObjectAltKey);\n}\n\nvar raw = parseJsonIfNeeded($context.$nodes.PAGE_ACCOUNTS_AND_OUTCOMES.$currentItem);\nvar objectAltKeys = [];\n\nif (Array.isArray(raw)) {\n  objectAltKeys = raw.map(readPartyNumber);\n} else if (raw && typeof raw === \"object\" && Array.isArray(raw.partyNumbers)) {\n  objectAltKeys = raw.partyNumbers;\n} else if (raw && typeof raw === \"object\" && Array.isArray(raw.accounts)) {\n  objectAltKeys = raw.accounts.map(readPartyNumber);\n} else {\n  objectAltKeys = String(raw || \"\").split(\",\");\n}\n\nobjectAltKeys = objectAltKeys\n  .map(clean)\n  .filter(function(value) {\n    return value !== \"\";\n  });\n\nvar accountInClause = objectAltKeys.length > 0\n  ? \"primaryObjectAltKey IN(\" + objectAltKeys.map(quote).join(\",\") + \")\"\n  : \"primaryObjectAltKey IN('__NO_ACCOUNT__')\";\n\nreturn {\n  objectAltKeys: objectAltKeys,\n  batchSize: objectAltKeys.length,\n  standardParameters: JSON.stringify({\n    objectType: \"ACCOUNT\",\n    objectAltKeys: objectAltKeys\n  }),\n  optionalParameters: \"outcomeType IN('SUMMARY', 'INSIGHT') and outcomeReferences[primaryRef='Y']\"\n};"
                  },
