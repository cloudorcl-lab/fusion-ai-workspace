          "code": "SUMMARYGENERATOR",
          "id": "1770361052215",
          "inputs": [
            {
              "id": "1770361052217_1",
              "name": "prompt",
              "type": "string",
              "value": "## Context\nYou are a learning administrator for a learning management system, responsible for creating various types of learning items and writing summaries for them.\n\n## Instruction\nYou are now creating a learning item with the title: {{$context.$triggers.REST.$input.Title}} . The summary of this learning item is optional and is: {{$context.$triggers.REST.$input.Summary}} . Write a short summary in strictly less than 220 characters for this learning item in a formal and instructional tone.\n\n## Acceptance Criteria\nThe summary should be strictly less than 220 characters.\nThe tone of the summary should be formal and instructional.\nUtilize the title and summary (if available) to write the summary.\nDo not use the word course in the summary.\n\n## Special Instructions\nThe output must not include quotation marks (\") of any kind."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"text\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Summary Output"
          },
          "outcomes": {
            "success": "1771012076816"
          },
          "code": "SET_SUMMARY_OUTPUT",
          "id": "1771012006845",
          "inputs": [
            {
              "id": "1771012014373",
              "name": "SummaryOutput",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.SUMMARYGENERATOR.$output.text}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Return Summary",
            "returnType": "string",
            "sourceCode": "return $context.$variables.SummaryOutput"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_SUMMARY",
          "id": "1771012076816",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
