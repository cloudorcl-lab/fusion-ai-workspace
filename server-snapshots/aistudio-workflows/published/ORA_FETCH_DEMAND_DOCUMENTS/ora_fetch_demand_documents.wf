            "sourceCode": "const suggestions = JSON.parse($context.$nodes.SUPPLY_SUGGESTIONS.$output.output);\nconst filteredSuggestions = suggestions.filter(suggestion => suggestion.Suggestion !== \"No eligible supply\");\nreturn filteredSuggestions;"
          },
          "outcomes": {
