                    "name": "Extract Line Details",
                    "returnType": "object",
                    "sourceCode": "const lines = $context.$nodes.EXTRACT_DEMAND_LINES.EXTRACT_DEMAND_LINES_BO.$output.items;\nconst reducedLines = lines.map(line => { return {\n  \"DemandSourceHeaderNumber\": line.DemandSourceHeaderNumber,\n  \"DemandSourceTypeId\": line.DemandSourceTypeId,\n  \"DemandSourceLineNumber\": line.DemandSourceLineNumber,\n  \"RequestedQuantity\": line.RequestedQuantity,\n  \"ReservationStatus\": line.ReservationStatus,\n  \"ItemNumber\": line.ItemNumber,\n  \"ItemId\": line.InventoryItemId,\n  \"UOM\": line.PrimaryUnitOfMeasure,\n  \"RequestedDate\": line.RequestedDate\n}});\n\n//Get the Integration Status Flag for the line\nconst shipmentLinesInfo = $context.$nodes.EXTRACT_DEMAND_LINES.FETCH_SHIPMENT_LINE_INFORMATION.$output.items;\nconst integrationStatus = shipmentLinesInfo?.[0]?.IntegrationStatusCode || null;\nconst requestedDate = shipmentLinesInfo?.[0]?.RequestedDate || null;\n\n// Merge the objects together\nconst merged = reducedLines.map(item => ({\n  ...item,\n  \"IntegrationStatusCode\": integrationStatus,\n  //\"RequestedDate\": requestedDate\n}));\n\nreturn merged;"
                  },
