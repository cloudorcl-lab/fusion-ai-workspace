        {
          "metadata": {
            "name": "Adapt Lines",
            "returnType": "object",
            "sourceCode": "const output = $context.$nodes.EXTRACT_DEMAND_LINES?.$output;\nconst response = Array.isArray(output) ? output : (output?.items || []);\n\nconst lowerDate = new Date($context.$variables.LowerDateTime).getTime();\nconst upperDate = new Date($context.$variables.UpperDateTime).getTime();\n\nconst adaptedResponse = response\n  .map(line => {\n    const obj = (typeof line === \"string\") ? JSON.parse(line) : line;\n    return obj?.result;\n  })\n.reduce((accum, result) => {\n    if (Array.isArray(result)) {\n      accum.push(...result);\n    } else {\n      accum.push(result);\n    }\n    return accum;\n  }, [])\n.filter(item => {\n  if (item?.IntegrationStatusCode === \"INTERFACED\") return false;\n  if (lowerDate && upperDate) {\n     if (!item?.RequestedDate) return false;\n\n     const t = Date.parse(item.RequestedDate);\n     if (isNaN(t)) return false;\n\n     return t >= lowerDate && t <= upperDate;\n  }\n  return true;\n});\n\nreturn adaptedResponse;"
          },
          "outcomes": {
            "success": "1773252480119"
          },
          "code": "ADAPT_LINES",
          "convergenceTargetId": "1773252480119",
          "id": "1773252594830",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
