        {
          "metadata": {
            "name": "Detailed Demand Line Records",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.FDD_FETCH_DEMAND_DOCUMENT_LINES_BO.$output.items;\nconst output = {\n    \"data\": response.map((item) => {\n        if (!item) return null; // Skip invalid indices gracefully\n        \n        const extracted = {\n            DemandSourceHeaderId: item.DemandSourceHeaderId,\n            DemandSourceHeaderNumber: item.DemandSourceHeaderNumber || null,\n            RequestedQuantity: item.RequestedQuantity || null,\n            InventoryItemId: item.InventoryItemId,\n            ItemNumber: item.ItemNumber || null,\n            DemandSourceLineNumber: item.DemandSourceLineNumber || null,\n            OperationSequenceNumber: item.OperationSequenceNumber || null,\n            ExpectedDate: item.RequestedDate,\n            ReservationStatus: item.ReservationStatus,\n            ReservationUnitOfMeasure: item.PrimaryUnitOfMeasure || null,\n            AvailableToReserveOnhand: item.AvailableToReserveOnhand,\n            AvailableToReserveTransferOrderReturn: item.AvailableToReserveTransferOrderReturn,\n            AvailableToReserveWorkOrder: item.AvailableToReserveWorkOrder,\n            AvailableToReserveTransferOrder: item.AvailableToReserveTransferOrder,\n            AvailableToReservePurchaseOrder: item.AvailableToReservePurchaseOrder\n        };\n        \n        // Only return if at least one field has a value\n        return Object.values(extracted).some(value => value !== null) ? extracted : null;\n    }).filter(item => item !== null), // Filter out null entries\n    \"formatted\": false,\n    \"error\": \"\",\n    \"status\": \"success\",\n    \"header\": \"Demand Document Lines Flow\"\n};\nreturn output"
          },
          "outcomes": {
            "success": "end"
          },
