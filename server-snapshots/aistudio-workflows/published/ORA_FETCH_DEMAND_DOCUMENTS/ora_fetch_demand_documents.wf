            "sourceCode": "let original_response =  $context.$nodes.FDD_FETCH_SOTO_BO.$output ;\nlet adapted_response_so = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.DemandSourceHeaderId,\n        DemandSourceHeaderNumber: item.DemandSourceHeaderNumber,\n        DemandSourceTypeId: item.DemandSourceTypeId,\n        TotalLines: item.TotalLines,\n        ReservationStatus: item.ReservationStatus,\n        ExpectedDate: item.ExpectedDate,\n        OrganizationId: $context.$variables.OrganizationCode\n    };\n});\n/*\noriginal_response = $context.$nodes.FDD_ND_RECOMMEND_BO.$output ;\nlet adapted_response_nd = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.DemandSourceHeaderId,\n        DemandSourceHeaderNumber: item.DemandSourceHeaderNumber,\n        DemandSourceName: item.DemandSourceName,\n        DemandSourceTypeId: item.DemandSourceTypeId,\n        TotalLines: item.TotalLines,\n        ExpectedDate: item.ExpectedDate,\n        ReservationStatus: item.ReservationStatusMeaning,\n        OrganizationId: $context.$variables.OrganizationCode\n    };\n});\n*/\noriginal_response = $context.$nodes.FDD_WO_RECOMMEND_BO.$output ; \nlet adapted_response_wo = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.WorkOrderId,\n        DemandSourceHeaderNumber: item.WorkOrderNumber,\n        DemandSourceTypeId: 5,\n        TotalLines: item.TotalLines,\n        ExpectedDate: item.ExpectedDate,\n        ReservationStatus: item.ReservationStatusMeaning,\n        OrganizationId: $context.$variables.OrganizationCode\n    };\n});\nconst adapted_response = [...adapted_response_so, ...adapted_response_wo];\n\nadapted_response.sort((a, b) => \n  new Date(a.ExpectedDate) - new Date(b.ExpectedDate)\n);\n\nreturn adapted_response;"
