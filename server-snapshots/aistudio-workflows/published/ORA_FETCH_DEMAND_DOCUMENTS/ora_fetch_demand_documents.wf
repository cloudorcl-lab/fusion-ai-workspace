            "5": "1762376530899"
          },
          "code": "DEMAND_SOURCE_ROUTER",
          "convergenceTargetId": "1762371895209",
          "id": "1761764062247",
          "inputs": [
            {
              "id": "1761764062248_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.GROUP_DEMAND_SOURCE_TYPES.$output.result}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Set Finder for Sales Orders",
            "returnType": "string",
            "sourceCode": "let finder = \"&finder=filterByItemExpectedDate;\";\nlet bindedVars = [];\nconst item = $context.$variables.InventoryItemId;\nif (item !== \"\" && item !== undefined) {\n    bindedVars.push(\"BindItemId=\" + $context.$variables.InventoryItemId);\n}\nlet startDate = \"BindExpectedStartDate=2010-01-01\";\nlet endDate = \"BindExpectedEndDate=2050-01-01\";\nif ( $context.$variables.ExpectedDate != '') {\n  endDate = \"BindExpectedEndDate=\" + $context.$variables.ExpectedDate;\n}\nbindedVars.push(startDate);\nbindedVars.push(endDate);\nif (bindedVars.length === 0) {\n    return '';\n}\nfinder += bindedVars.join(',');\nreturn finder;"
          },
          "outcomes": {
            "success": "1771887892272"
          },
          "code": "SET_FINDER_FOR_SALES_ORDERS",
          "id": "1761765000515",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "WO Response Adapter",
            "returnType": "object",
            "sourceCode": "const original_response = $context.$nodes.FETCH_WORK_ORDERS_BO.$output; \nlet adapted_response = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.WorkOrderId,\n        DemandSourceHeaderNumber: item.WorkOrderNumber,\n        DemandSourceTypeId: 5,\n        TotalLines: item.TotalLines,\n        ExpectedDate: item.ExpectedDate,\n        ReservationStatus: item.ReservationStatusMeaning\n    };\n});\nreturn adapted_response;"
          },
          "outcomes": {
            "success": "1762373886294"
          },
          "code": "WO_RESPONSE_ADAPTER",
          "id": "1761769273540",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Group Demand Source Types",
            "returnType": "number",
            "sourceCode": "const demandSourceTypeId = $context.$variables.DemandSourceTypeId;\nif (demandSourceTypeId === 2 || demandSourceTypeId === 8 || demandSourceTypeId === 18) {\n    return 2;\n}\nif (demandSourceTypeId === 3 || demandSourceTypeId === 6 || demandSourceTypeId === 13 || demandSourceTypeId === 9) {\n    return 0;\n}\nif (demandSourceTypeId === 5) {\n    return 5;\n}\nreturn 0;"
          },
          "outcomes": {
            "success": "1761764062247"
          },
          "code": "GROUP_DEMAND_SOURCE_TYPES",
          "id": "1761772458035",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Finder for Non Document",
            "returnType": "string",
            "sourceCode": "let finder = \"findByItemAndExpirationDate;\";\nlet bindedVars = [];\nconst item = $context.$variables.InventoryItemId;\nif (item !== \"\" && item !== undefined) {\n    bindedVars.push(\"bindItemId=\" + $context.$variables.InventoryItemId);\n}\nlet startDate = \"bindFromDate=2010-01-01\";\nlet endDate = \"bindToDate=2050-01-01\";\nif ( $context.$variables.ExpectedDate != '') {\n  endDate = \"bindToDate=\" + $context.$variables.ExpectedDate;\n}\nbindedVars.push(startDate);\nbindedVars.push(endDate);\nif (bindedVars.length === 0) {\n    return '';\n}\nfinder += bindedVars.join(',');\nreturn finder;"
          },
          "outcomes": {
            "success": "1762378321594"
          },
          "code": "SET_FINDER_FOR_NON_DOCUMENT",
          "id": "1761773560423",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ND Response Adapter",
            "returnType": "object",
            "sourceCode": "const original_response = $context.$nodes.FETCH_NON_DOCUMENTS_BO.$output ;\nlet adapted_response = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.DemandSourceHeaderId,\n        DemandSourceHeaderNumber: item.DemandSourceHeaderNumber,\n        DemandSourceName: item.DemandSourceName,\n        DemandSourceTypeId: item.DemandSourceTypeId,\n        TotalLines: item.TotalLines,\n        ReservationStatus: item.ReservationStatusMeaning\n    };\n});\nreturn adapted_response;"
          },
          "outcomes": {
            "success": "1762377079805"
          },
          "code": "ND_RESPONSE_ADAPTER",
          "id": "1761776001773",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FDD Extract Input"
          },
          "outcomes": {
            "success": "1761763972828"
          },
          "code": "FDD_EXTRACT_INPUT",
          "id": "1762238222840",
          "inputs": [
            {
              "id": "1762238222842_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the following outputs from this user query: `{{$context.$triggers.REST.$input.userQuery}}`\nToday's Date: {{$context.$system.$currentDate}}\nIf an expected/due date is present, extract it into ExpectedDate (if it’s relative like “past/next month,” resolve it using today's date as the reference to deduce the intended expected date); if no expected/due date is present, set ExpectedDate to an empty string \"\". Note that ExpectedDate should only be a date string or empty string, nothing else. Also when just past due date is mentioned then set ExpectedDate to today's date.\nIf the reservation status related data is present extract it to ReservationStatus output. The reservation status would be either 'Reserved'/'Unreserved'/'Partially reserved'. Default value is relevant data is not present should be an empty string \"\".\nIf the demand document header number(that usually appears after the demand type) related data is present extract it into DemandSourceHeaderNumber output. \nIf the demand document line number related data is present extract it into DemandSourceLineNumber output. If no DemandSourceLineNumber is present set it as empty string \"\".\nIf the demand document related data is present then extract the DemandSourceType and DemandSourceTypeId refer below. Check for the demand source types in the user query to deduces the DemandSouceTypeId. If DemandSourceTypeId is not present set it as empty string \"\". \nNote: If both demand and supply details are present ignore the supply details and only focus on demand details.\n  | DOCUMENT TYPE | DEMAND SOURCE TYPE    | DEMAND SOURCE TYPE ID |  \n            | ------------- | --------------------- | --------------------- |  \n            | Demand        | Sales order           | 2                     |  \n            | Demand        | Transfer order        | 8                     |  \n            | Demand        | Transfer order return | 18                    |  \n            | Demand        | Work order            | 5                     |  \n            | Demand        | Purchase order        | 1                     |  \n            | Demand        | Account               | 3                     |  \n            | Demand        | Account alias         | 6                     |  \n            | Demand        | Cycle count           | 9                     |  \n            | Demand        | User defined          | 13                    |\nExtract Demand Source Name, this is a string that represent the name of the demand source document. It is not the same as DemandSourceType or DemandSourceHeaderNumber into the output 'DemandSourceName'. If it is not present set it as empty string \"\".\nDemandSourceName does not exist for Work order/Sales order/Transfer orders as they have DemandSourceHeaderNumber instead."
            },
            {
              "id": "1762238222843_2",
              "name": "temperature",
              "type": "number",
              "value": ""
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"OperationSequenceNumber\": {\n            \"type\": \"string\"\n        },\n        \"DemandSourceLineNumber\": {\n            \"type\": \"string\"\n        },\n        \"ExpectedDate\": {\n            \"type\": \"string\"\n        },\n        \"ReservationStatus\": {\n            \"type\": \"string\"\n        },\n        \"DemandSourceType\": {\n            \"type\": \"string\"\n        },\n        \"DemandSourceName\": {\n            \"type\": \"string\"\n        },\n        \"DemandSourceTypeId\": {\n            \"type\": \"number\"\n        },\n        \"DemandSourceHeaderNumber\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "FDD SO Response Setter"
          },
          "outcomes": {
            "success": "1762371895209"
          },
          "code": "FDD_SO_RESPONSE_SETTER",
          "id": "1762369897048",
          "inputs": [
            {
              "id": "1762372038207",
              "name": "DemandHeadersResponse",
              "type": "object",
              "value": "{{$context.$nodes.FDD_SO_RESPONSE_ADAPTER.$output.result}}"
            },
            {
              "id": "1762371849910",
              "name": "NumberOfDemandDocuments",
              "type": "integer",
              "value": "{{$context.$variables.ReservationStatus == 'Unreserved' ? 2 : $context.$nodes.FETCH_SALES_AND_TRANSFER_ORDERS_BO.$output .items.length}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "FDD Demand Document Lines Router"
          },
          "outcomes": {
            "0": "1763510309317",
            "1": "1762384653461",
            "2": "1773250525436"
          },
          "code": "FDD_DEMAND_DOCUMENT_LINES_ROUTER",
          "convergenceTargetId": "end",
          "id": "1762371895209",
          "inputs": [
            {
              "id": "1762371895210_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.NumberOfDemandDocuments > 1 ? 2 : $context.$variables.NumberOfDemandDocuments}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "FDD Multiple Demand Documents Handler"
          },
          "outcomes": {
            "success": "1763510523472"
          },
          "code": "FDD_MULTIPLE_DEMAND_DOCUMENTS_HANDLER",
          "id": "1762372074279",
          "inputs": [
            {
              "id": "1762372074279_1",
              "name": "prompt",
              "type": "string",
              "value": "Use the corresponding inputs based on the UnreservedFlag Input.\n\n##UnreservedFlag Input\n{{$context.$nodes.IS_UNRESERVED.$output}}\n\nIf UnreservedFlag is true, use the following Inputs:\n1. All demand records:\n{{$context.$nodes.ADAPT_LINES.$output.result}}\n\n2. Suggestions:\n{{$context.$nodes.FILTER_SUGGESTIONS.$output.result}}\n\nIf UnreservedFlag is false, use the following Input:\n1. All demand records:\n{{$context.$variables.DemandHeadersResponse}}\n\n\nRules:\n- Use \"All demand records\" for the input data.\n- Render exactly one <tr> for every record in All demand records.\n- If there are no rows, output a user-friendly message stating there are no demands records to show in place of the table.\n- Do not output the IntegrationStatusCode.\n- The table rows must NOT depend on Suggestions.\n- Suggestions are displayed only in a separate section below the table.\n- If Suggestions is not empty, list them below the table.\n- Do not remove demand rows just because they do not appear in Suggestions.\n\nReference for Demand Source Types:\n  | DOCUMENT TYPE | DEMAND SOURCE TYPE    | DEMAND SOURCE TYPE ID |  \n            | ------------- | --------------------- | --------------------- |  \n            | Demand        | Sales order           | 2                     |  \n            | Demand        | Transfer order        | 8                     |  \n            | Demand        | Transfer order return | 18                    |  \n            | Demand        | Work order            | 5                     |  \n            | Demand        | Purchase order        | 1                     |  \n            | Demand        | Account               | 3                     |  \n            | Demand        | Account alias         | 6                     |  \n            | Demand        | Cycle count           | 9                     |  \n            | Demand        | User defined          | 13                    |\n\nReference for Supply Source Types\n| DOCUMENT TYPE | SUPPLY SOURCE TYPE         | SUPPLY SOURCE TYPE ID |  \n            | ------------- | -------------------------- | --------------------- |  \n            | Supply        | On hand                    | 13                    |  \n            | Supply        | Purchase order             | 1                     |  \n            | Supply        | Purchase order requisition | 17                    |  \n            | Supply        | Transfer order             | 8                     |  \n            | Supply        | Transfer order return      | 18                    |  \n            | Supply        | Work order                 | 5                     |\n\n\nOrganizationCode: {{$context.$triggers.REST.$input.OrganizationCode}}\n\nDO NOT include internal system IDs (e.g., DemandSourceHeaderId, ItemId).\nYou MAY include business document numbers such as DemandSourceHeaderNumber and DemandSourceLineNumber. \nIf the Suggestions is empty then use the following template for output.\n##Template 1\n<h4>Demand Documents for Org:<insert OrganziationCode></h4>\n\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr>\n      <th>Demand Source Header</th>\n      <th>Demand Source</th>\n      <th>Total Lines</th>\n      <th>Expected Date</th>\n      <th>Reservation Status</th>\n    </tr>\n  </thead>\n  <tbody>\n    <!-- Repeat this <tr> for each record -->\n    <tr>\n      <td>{DemandSourceHeaderNumber or null}</td>\n      <td>{MappedDemandSourceTypeFromDemandSourceTypeId}</td>\n      <td>{TotalLines}</td>\n      <td>{ExpectedDate}</td>\n      <td>{ReservationStatus}</td>\n    </tr>\n  </tbody>\n</table>\n\n<h5>Suggested Next Actions</h5>\n<ul>\n  <li>Refine Search with more filters (e.g. OrganizationId, ItemNumber, ReservationStatus and DemandSourceType).</li>\n  <li>Get demand line details for one of the above documents.</li>\n  <li>Return to home</li>\n</ul>\n\nIf Suggestions is not empty use the following template for the output. For the lines that do NOT appear in \"Suggestions\" data, include them in the table using \"All demand records\" data but change the quantity to 0.\n##Template 2\n<h4>Demand Documents</h4>\n<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr>\n      <th>Demand Source Header</th>\n      <th>Demand Source Line</th>\n      <th>Suggested Quantity</th>\n      <th>UOM</th>\n      <th>Requested Date</th>\n      <th>Supply Recommendation</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>{DemandSourceHeaderNumber}</td>\n      <td>{DemandSourceLineNumber}</td>\n      <td>{RequestedQuantity}</td>\n      <td>{UOM}</td>\n      <td>{RequestedDate}</td> (This will be a DateTime type. Only output the date, not the time)\n      <td>\n        <!-- Always show supply type -->\n        <div><b>Type:</b> {SupplySourceType extract from SupplySourceTypeId mapping}</div>\n\n        <!-- Show supply header ONLY when SupplySourceType is NOT Onhand AND SupplySourceTypeId != 13 -->\n        {#if (and (ne SupplySourceType \"Onhand\") (ne SupplySourceTypeId 13))}\n          <div><b>Header:</b> {SupplySourceHeaderNumber}</div>\n\n          <!-- Show supply line ONLY when also SupplySourceTypeId != 5 -->\n          {#if (ne SupplySourceTypeId 5)}\n            <div><b>Line:</b> {SupplySourceLineNumber}</div>\n          {/if}\n\n          <div><b>Delivery Date:</b> {ExpectedDeliveryDate}</div>\n        {/if}\n      </td>\n    </tr>\n  </tbody>\n</table>\n\n<h5>Suggested Next Actions</h5>\n<ul>\n  <!-- MUST include this data as the list options in Suggestions on top of existing ones -->\n  <li>Add list of Suggestions data here</li>\n  <li>Reserve all the eligible lines in the above table</li>\n  <li>View More</li>\n  <li>Return to home</li>\n</ul>"
            },
            {
              "id": "1762372074279_2",
              "name": "temperature",
              "type": "number"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "FDD SO Response Adapter",
            "returnType": "object",
            "sourceCode": "const original_response = $context.$nodes.FETCH_SALES_AND_TRANSFER_ORDERS_BO.$output;\nlet adapted_response = original_response.items.map(item => {\n    return {\n        DemandSourceHeaderId: item.DemandSourceHeaderId,\n        DemandSourceHeaderNumber: item.DemandSourceHeaderNumber,\n        DemandSourceTypeId: item.DemandSourceTypeId,\n        TotalLines: item.TotalLines,\n        ReservationStatus: item.ReservationStatus,\n        ExpectedDate: item.ExpectedDate\n    };\n});\nreturn adapted_response;"
          },
          "outcomes": {
            "success": "1762369897048"
          },
          "code": "FDD_SO_RESPONSE_ADAPTER",
          "id": "1762372516425",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FDD SO Query Builder",
            "returnType": "string",
            "sourceCode": "const OrganizationId=$context.$variables.OrganizationId;\nconst DemandSourceTypeId=$context.$variables.DemandSourceTypeId;\nconst DemandSourceHeaderNumber=$context.$variables.DemandSourceHeaderNumber;\nconst DemandSourceLineNumber= $context.$variables.DemandSourceLineNumber;\nconst ReservationStatus = $context.$variables.ReservationStatus;\nlet filters = [];\nif (ReservationStatus !== null && ReservationStatus !== \"\") {\n    filters.push(\"ReservationStatus='\" + ReservationStatus + \"'\");\n}\nif (OrganizationId !== null && OrganizationId !== \"\") {\n    filters.push('OrganizationId=' + OrganizationId);\n}\nif (DemandSourceTypeId !== null && DemandSourceTypeId !== \"\") {\n    filters.push('DemandSourceTypeId=' + DemandSourceTypeId);\n}\nif (DemandSourceHeaderNumber !== null && DemandSourceHeaderNumber !== \"\") {\n    filters.push(\"DemandSourceHeaderNumber='\" + DemandSourceHeaderNumber + \"'\");\n}\nreturn filters.join(' and ');"
          },
          "outcomes": {
            "success": "1761765000515"
          },
          "code": "FDD_SO_QUERY_BUILDER",
          "id": "1762373435084",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FDD WO Response Setter"
          },
          "outcomes": {
            "success": "1762371895209"
          },
          "code": "FDD_WO_RESPONSE_SETTER",
          "id": "1762373886294",
          "inputs": [
            {
              "id": "1762373923323",
              "name": "NumberOfDemandDocuments",
              "type": "integer",
              "value": "{{$context.$variables.ReservationStatus == 'Unreserved' ? 2 : $context.$nodes.FETCH_WORK_ORDERS_BO.$output.items.length}}"
            },
            {
              "id": "1762373895298",
              "name": "DemandHeadersResponse",
              "type": "object",
              "value": "{{$context.$nodes.WO_RESPONSE_ADAPTER.$output.result}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "FDD WO Query Builder",
            "returnType": "string",
            "sourceCode": "const OrganizationId=$context.$variables.OrganizationId;\nconst DemandSourceHeaderNumber=$context.$variables.DemandSourceHeaderNumber;\nconst InventoryItemId= $context.$variables.InventoryItemId;\nconst ReservationStatus = $context.$variables.ReservationStatus;\nlet filters = [];\nif (ReservationStatus !== null && ReservationStatus !== \"\") {\n    filters.push(\"ReservationStatusMeaning='\" + ReservationStatus + \"'\");\n}\nif (OrganizationId !== null && OrganizationId !== \"\") {\n    filters.push('OrganizationId=' + OrganizationId);\n}\nif (DemandSourceHeaderNumber !== null && DemandSourceHeaderNumber !== \"\") {\n    filters.push('WorkOrderNumber=' + \"'\" + DemandSourceHeaderNumber + \"'\");\n}\nreturn filters.join(' and ');"
          },
          "outcomes": {
            "success": "1771449175778"
          },
          "code": "FDD_WO_QUERY_BUILDER",
          "id": "1762376530899",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "FDD ND Response Setter"
          },
          "outcomes": {
