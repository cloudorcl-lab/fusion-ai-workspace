                    "name": "Demand Lines BO Param Builder",
                    "returnType": "object",
                    "sourceCode": "const DemandSourceTypeId = $context.$nodes.EXTRACT_DEMAND_LINES.$currentItem.DemandSourceTypeId;\nlet finder = \"\"\nif (DemandSourceTypeId === 13) {\n    const DemandSourceName = $context.$variables.DemandHeadersResponse[0].DemandSourceName;\n    finder = \"FindByUserDefinedDemandAndUOMType;bindDemandSourceTypeId=\" + DemandSourceTypeId + \",bindDemandSourceName=\" + DemandSourceName;\n}\nconst DemandSourceHeaderId = $context.$nodes.EXTRACT_DEMAND_LINES.$currentItem.DemandSourceHeaderId;\nfinder = \"FindByDemandAndUOMType;bindDemandSourceTypeId=\" + DemandSourceTypeId + \",bindDemandSourceHeaderId=\" + DemandSourceHeaderId;\n\nconst filters = []\nconst item = $context.$variables.InventoryItemId;\nif (item != null && item != '') {\n  filters.push(\"InventoryItemId=\" + item);\n}\n\nfilters.push(\"ReservationStatus='Unreserved'\");\n\nconst query = filters.join(\" and \");\nconst params = {\n  query,\n  finder\n}\n\nreturn params;"
                  },
