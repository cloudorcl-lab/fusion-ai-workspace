{
  "workflowId": "300000331058348",
  "workflowCode": "ORA_PRJ_PJE_CHANGE_ORDER_INITIATION_ASSISTANT_TEAM",
  "name": "Project Change Order Initiation Assistant",
  "description": "Assists project managers with creating project change orders directly from project issues.  It reduces manual workload and improves the accuracy and efficiency of tracking project changes.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
