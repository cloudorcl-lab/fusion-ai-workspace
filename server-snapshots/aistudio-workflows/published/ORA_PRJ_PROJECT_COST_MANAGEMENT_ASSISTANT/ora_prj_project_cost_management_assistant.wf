{
  "workflowId": "300000332558413",
  "workflowCode": "ORA_PRJ_PROJECT_COST_MANAGEMENT_ASSISTANT",
  "name": "Project Cost Management Assistant",
  "description": "Project Cost Management Assistant Continuously monitors and analyzes all project costs, providing real-time insights, explanations of discrepancies, and actionable recommendations or guided corrections that ensure accurate, compliant, and up-to-date project financials.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
