            "description": "Invokes the granular Project Cost Exceptions Assistant.",
            "name": "Project Cost Exceptions Assistant",
            "workflowCode": "ORA_PRJ_PJC_PROJECT_COST_EXCEPTION_ASSISTANT_TEAM"
          },
          "outcomes": {
            "success": "5"
          },
          "code": "PRJ_PJC_WORKFLOW_INVOKE_PROJECT_COST_EXCEPTIONS_ASSISTANT",
          "id": "3",
          "inputs": [
            {
              "id": "1779425671918_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1779425671919_2",
              "name": "prjPjcAtomicAgentRelevantInfo",
              "type": "object",
              "value": "{{$context.$triggers.REST.$input.prjPjcAtomicAgentRelevantInfo}}"
            },
            {
              "id": "1779425671920_3",
              "name": "prjPjcChatHistory",
              "type": "object",
              "value": "{{$context.$triggers.REST.$input.prjPjcChatHistory}}"
            },
            {
              "id": "1779425671921_4",
              "name": "prjPjcRoutingContext",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_CODE_ROUTING_CONTEXT.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "description": "Builds the Level 2 Cost Management unsupported response in the UI JSON envelope format.",
            "name": "Cost Management Unsupported Message",
            "returnType": "object",
            "sourceCode": "var title='Project Cost Management';\nvar description='Guidance for cost-management requests that are outside the currently connected granular assistant scope.';\nvar message='Your request is in the project cost management domain, but it\\'s not currently supported. I can help you with query requests related to project costs and exceptions.';\nvar q=String($context.$system.$currentDateTime||''),\nts=q?q.slice(8,10)+'-'+q.slice(5,7)+'-'+q.slice(0,4)+' '+q.slice(11,16):String($context.$system.$currentDate||''),\no={\n  agent:($context.$workflow&&$context.$workflow.$code)||'ORA_PRJ_PROJECT_COST_MANAGEMENT_ASSISTANT',\n  intent:'unsupported_context',\n  schema_version:'1',\n  title:title,\n  description:description,\n  timestamp:ts,\n  agent_response:[\n    {\n      display_type:'text',\n      display_sequence:1,\n      text:message\n    }\n  ]\n};\n\nreturn {\n  activeContext:'Cost Management',\n  message:message,\n  wrappedResponse:JSON.stringify(o)\n};"
          },
          "outcomes": {
            "success": "9"
          },
          "code": "PRJ_PJC_CODE_COST_MANAGEMENT_UNSUPPORTED_MESSAGE",
          "id": "8",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
