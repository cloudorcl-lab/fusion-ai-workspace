            "name": "Return Cost Management Unsupported Message"
          },
          "outcomes": {},
          "code": "PRJ_PJC_RETURN_COST_MANAGEMENT_UNSUPPORTED",
          "id": "9",
          "inputs": [
            {
              "id": "9_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_CODE_COST_MANAGEMENT_UNSUPPORTED_MESSAGE.$output.result.wrappedResponse}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "description": "Checks whether the granular Project Cost Exceptions Assistant returned a non-empty response.",
            "name": "Has Child Response"
          },
          "outcomes": {
            "true": "6",
            "false": "7"
          },
          "code": "PRJ_PJC_IF_HAS_CHILD_RESPONSE",
          "convergenceTargetId": "end",
          "id": "5",
          "inputs": [
            {
              "id": "5_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.PRJ_PJC_WORKFLOW_INVOKE_PROJECT_COST_EXCEPTIONS_ASSISTANT.$output.output && $context.$nodes.PRJ_PJC_WORKFLOW_INVOKE_PROJECT_COST_EXCEPTIONS_ASSISTANT.$output.output.trim().length > 0}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
