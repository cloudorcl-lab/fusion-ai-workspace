            "name": "DISPLAY DOCUMENTATION",
            "returnType": "string",
            "sourceCode": "const message = `To get started, please add your career roles in the Opportunity Marketplace.`;\nreturn message;\n\nconst status = \"more_info\";\n\nconst outputArr= [];\n\noutputArr.push(message);\noutputArr.push(status);\n\nreturn outputArr;"
          },
          "outcomes": {
            "success": "1765097456890"
          },
          "code": "DISPLAY_DOCUMENTATION",
          "id": "1765097516878",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              },
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Generate Skills Gap Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GENERATE_SKILLS_GAP_SUMMARY",
          "convergenceTargetId": "1765097647340",
          "id": "1765005670204",
          "inputs": [
            {
              "id": "1765005670207_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an assistant that compares a candidate's skills to a target job.\n\nAny statements in the output should be made as if you are talking directly to the user. Refer to them in second person\n\nBased on the data provided on the employee skills, employment info provided in the profile and the details of the career roles they aspire to and the respective skills for those roles. Calculate a combined readiness score for the candidate. \nThe score should reflect how prepared the candidate is for the career roles they aspire to. Compare the skills the candidate has and the skills needed for the roles. Use your own logic with other details in the inputs to create a realistic and accurate score. \n\nHere are the \nEmployee Skills and Employment Info : {{$context.$variables.ProfileSummary}} \nCareer Role Info : {{$context.$variables.targetRoles}} \n\nIn the output generate the following items as JSON properties\n1. Current Employment Role: The name of the employee's current role\n2. Aspirational roles: The names of the career roles the employee is targeting\n3. Combined Readiness Score: a score that represents the employees preparedness for the aspirational roles. this should be calculated by comparing the employee's profile to the requirements for the target roles. The score should not be for independent target roles but combined for all.\n4. Strengths: in this section mention the skills the employee has which match the requirements for the target roles.\n5. Skill Gaps: In this section mention the skills the employee does not have but are mentioned in the target roles. also include a brief 1 sentence description showing how much the employee has to improve\n\nOutput should be a strict JSON schema."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"CurrentEmploymentRole\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"AspirationalRoles\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"required\": [],\n        \"properties\": {}\n      }\n    },\n    \"CombinedReadinessScore\": {\n      \"type\": \"number\"\n    },\n    \"Strengths\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"required\": [],\n        \"properties\": {}\n      }\n    },\n    \"SkillGaps\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"Skill\",\n          \"Description\"\n        ],\n        \"properties\": {\n          \"Skill\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Description\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"CurrentEmploymentRole\",\n    \"AspirationalRoles\",\n    \"CombinedReadinessScore\",\n    \"Strengths\",\n    \"SkillGaps\"\n  ]\n}",
          "type": "LLM"
        },
