        {
          "metadata": {
            "name": "Extract Skill Fields",
            "returnType": "array",
            "sourceCode": "const publicSkills = $context.$nodes.GET_PUBLIC_SKILLS.$output.items || [];\nconst otherSkills = $context.$nodes.GET_OTHER_SKILLS.$output.items || [];\n\nconst allSkills = [\n...otherSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nYearsOfExperience: item.YearsOfExperience,\nProjectOrActivity: item.ProjectOrActivity,\nDescription: item.Description\n})),\n...publicSkills.map(item => ({\nSkillId: item.SkillId,\nSkill: item.Skill,\nProjectName: item.ProjectName,\nSkillName: item.SkillName,\nYearsOfExperience: item.YearsOfExperience,\nDescription: item.Description,\nProficiencyLevel: item.NumericRating,\nMaxProficiencyLevel: 5\n}))\n] ;\n\nreturn allSkills ;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "EXTRACT_SKILL_FIELDS",
          "id": "1764854811147",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
