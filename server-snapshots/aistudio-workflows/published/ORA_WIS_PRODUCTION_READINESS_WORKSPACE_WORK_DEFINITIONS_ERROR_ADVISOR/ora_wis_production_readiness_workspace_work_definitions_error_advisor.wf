          "metadata": {
            "name": "filter invalid records",
            "returnType": "array",
            "sourceCode": "let input = $context.$nodes.WDCOMPLETENESSCHECKBO.$output.items;\nlet result = [];\n\nfor (let i = 0; i < input.length; i++) {\n  let item = input[i];\n\n  const hasWorkCenterId =\n    item.ResourceWorkCenterId !== null &&\n    item.ResourceWorkCenterId !== undefined &&\n    item.ResourceWorkCenterId !== \"\";\n\n  if (item.Entity === \"Resource\" && hasWorkCenterId) {\n    item.ActionText = \"Add Resource\";\n    if (item.ChargeType == null) {\n        item.ChargeType = \"MANUAL\";\n    }\n    result.push(item);\n  } else if (item.Entity === \"Material\" ) {\n    if (item.WdOperationMaterialId == null) {\n      item.ActionText = \"Add Material\";\n    } else {\n      item.ActionText = \"Update Material\";\n    }\n    result.push(item);\n  }\n}\n\nreturn result;"
          },
