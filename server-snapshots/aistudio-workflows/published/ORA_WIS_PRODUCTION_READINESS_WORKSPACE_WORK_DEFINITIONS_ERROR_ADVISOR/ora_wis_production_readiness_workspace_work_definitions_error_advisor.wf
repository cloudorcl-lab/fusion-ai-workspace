          "code": "CHECK_APP_CONTEXT",
          "id": "1774502389920",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "retrieve org context",
            "returnType": "object",
            "sourceCode": "const appCtx = $context && $context.$app ? $context.$app.$OraAppContext : null;\n\n// appCtx might already be a JSON string, or it might be an object/proxy.\n// Normalize to a plain object:\nlet plain = {};\nif (typeof appCtx === 'string') {\n  try {\n    plain = JSON.parse(appCtx) || {};\n  } catch (e) {\n    plain = {};\n  }\n} else {\n  plain = JSON.parse(JSON.stringify(appCtx || {}));\n}\n\nconst orgCode = plain.OrganizationCode || null;\nconst orgName = plain.OrganizationName || null;\nconst orgId = plain.OrganizationId || null;\nlet orgIdqParam = \"\";\nif (plain.OrganizationId != null) {\n  orgIdqParam = \"OrganizationId=\" + plain.OrganizationId.toString();\n}\nlet orgIdqParamFinal = \"\";\nif ($context.$variables.organizationId) {\n  orgIdqParamFinal = \"OrganizationId=\" + $context.$variables.organizationId + \" and WorkMethodCode in ('DISCRETE_MANUFACTURING','PROCESS_MANUFACTURING') and WorkCenterId is not null\";\n}\n\nreturn {\n  OrganizationCode: orgCode,\n  OrganizationName: orgName,\n  OrganizationId: orgId,\n  OrganizationIdqParam: orgIdqParamFinal  \n};"
          },
          "outcomes": {
            "success": "1772516458276"
          },
          "code": "RETRIEVE_ORG_CONTEXT",
          "id": "1774502433221",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "fetch action",
            "returnType": "string",
            "sourceCode": "const value = $context.$app.$OraMessageHint;\n\nlet result;\nif (typeof value === 'string' && (value === 'InitActions' || value === 'InitDisplay')) {\n  result = 'Init';\n} else {\n  result = value;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774502389920"
          },
