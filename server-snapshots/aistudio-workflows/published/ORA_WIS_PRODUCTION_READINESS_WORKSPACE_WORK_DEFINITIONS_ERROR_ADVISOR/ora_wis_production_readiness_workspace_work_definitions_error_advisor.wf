            "success": "1776749266786"
          },
          "code": "FETCH_ALL_ERRORS",
          "id": "1775483369609",
          "inputs": [
            {
              "id": "1775483386470_1",
              "name": "OrganizationId",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_ACTION.$output.result.data.OrganizationId}}"
            },
            {
              "id": "1775483386471_2",
              "name": "WorkDefinitionId",
              "type": "string",
              "value": "{{$context.$nodes.PARSE_ACTION.$output.result.data.WorkDefinitionId}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "payload to fix all errors",
            "returnType": "object",
            "sourceCode": "let input = $context.$nodes.FILTER_INVALID_RECORDS_FIX.$output.result;\n\nlet payload = [];\nlet matSeqVal = 0;\n\ninput.forEach((record, index) => {\n  if (record.Entity == 'Material') {\n    const qty = Number(record.ComponentQuantity);\n    const inverseQty = qty ? (1 / qty).toString() : null;\n    if (record.WdOperationMaterialId == null) {\n      matSeqVal += 10;\n      payload.push({\n        \"id\": `${record.WorkDefinitionId}-${record.WdOperationId}`,\n        \"path\": `/workDefinitionsV2/${record.WorkDefinitionId}/child/WorkDefinitionMaterial/`,\n        \"operation\": \"create\",\n        \"payload\": {\n          \"AdhocFlag\": false,\n          \"OrganizationId\": `${record.OrganizationId}`,\n          \"ComponentSequenceId\": `${record.ComponentSequenceId}`,\n          \"InventoryItemId\": `${record.InventoryItemId}`,\n          \"MaterialQuantity\": `${record.ComponentQuantity}`,\n          \"InverseMaterialQuantity\": inverseQty,\n          \"MaterialSequenceNumber\": matSeqVal,\n          \"MaterialType\": \"COMPONENT\",\n          \"SupplyType\": `${record.SupplyType}`,\n          \"WdOperationId\": `${record.WdOperationId}`\n        }\n      });\n    } else {\n      payload.push({\n        \"id\": `${record.WorkDefinitionId}-${record.WdOperationId}-${record.WdOperationMaterialId}`,\n        \"path\": `/workDefinitionsV2/${record.WorkDefinitionId}/child/WorkDefinitionMaterial/${record.WdOperationMaterialId}`,\n        \"operation\": \"update\",\n        \"payload\": {\n          \"MaterialQuantity\": `${record.ComponentQuantity}`,\n          \"InverseMaterialQuantity\": inverseQty\n        }\n      });\n    }\n  } else {\n    payload.push({\n      \"id\": `${record.WorkDefinitionId}-${record.WdOperationId}-${record.ResourceId}`,\n      \"path\": `/workDefinitionsV2/${record.WorkDefinitionId}/child/WorkDefinitionEditResource/`,\n      \"operation\": \"create\",\n      \"payload\": {\n        \"ResourceSequenceNumber\": `${record.ResourceSequenceNumber}`,\n        \"AssignedUnits\": 1,\n        \"BasisType\": `${record.BasisType}`,\n        \"UsageRate\": 1,\n        \"InverseUsageRate\": 1,\n        \"UOMCode\": `${record.PrimaryUOMCode}`,\n        \"ScheduleType\": \"NO\",\n        \"PrincipalFlag\": false,\n        \"ChargeType\": `${record.ChargeType}`,\n        \"WorkCenterId\": `${record.WorkCenterId}`,\n        \"ResourceId\": `${record.ResourceId}`,\n        \"WdOperationId\": `${record.WdOperationId}`\n      }\n    });\n  }\n});\n\n\n\nreturn { \"parts\": payload };"
          },
          "outcomes": {
            "success": "1775484227519"
          },
          "code": "PAYLOAD_TO_FIX_ALL_ERRORS",
          "id": "1775483409018",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_MANUFACTUR_WORKDEFINITIONBATCHPAYLOAD",
