            "sourceCode": "let value = 10;\n\nif ($context.$nodes.GET_MATERIAL_SEQ_NUM.$output.count > 0) {\nvalue = parseInt($context.$nodes.GET_MATERIAL_SEQ_NUM.$output.items[0].MaterialSequenceNumber, 10) + 10;\n} \n\nreturn value;"
