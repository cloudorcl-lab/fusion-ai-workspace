              "type": "object",
              "value": "{\n  \"name\": \"paymentsPayablesPaymentProcessRequest\",\n  \"type\": \"view\",\n  \"businessObject\": \"PayablesPaymentProcessRequest\",\n  \"module\": \"oraErpCorePaymentsFundsDisbursement\",\n  \"defaultFields\": [\n    \"paymentProcessRequestName\",\n    \"paymentProcessRequestStatus.lookupCode\"\n  ],\n  \"fields\": [\n    \"paymentProcessRequestId\",\n    \"paymentProcessRequestName\",\n    \"timeUpdated\",\n    \"timeCreated\"\n  ],\n  \"accessors\": [\n    {\n      \"accessorName\": \"paymentProcessRequestStatus\",\n      \"shape\": \"Lookup\",\n      \"fields\": [\n        \"lookupType\",\n        \"meaning\",\n        \"lookupCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"paymentProcessOrganizations\",\n      \"shape\": \"PaymentProcessOrganization\",\n      \"fields\": [\n        \"objectId\",\n        \"objectType\",\n        \"organizationType\",\n        \"businessUnitId\"\n      ]\n    },\n    {\n      \"accessorName\": \"bankAccount\",\n      \"shape\": \"BankAccount\",\n      \"fields\": [\n        \"id\",\n        \"name\"\n      ]\n    }\n  ],\n  \"drivers\": [\n    {\n      \"topic\": \"PPR fail statuses\",\n      \"description\": \"Statuses in the PPR lifecycle that denote a failure or error condition.\",\n      \"statuses\": [\n        \"PENDING_REVIEW_DOC_VAL_ERRORS\",\n        \"PENDING_REVIEW_PMT_VAL_ERRORS\",\n        \"VALIDATION_FAILED\",\n        \"FAILED_PAYMENT_VALIDATION\",\n        \"MISSING RATES\",\n        \"MISSING_X_RATES\",\n        \"ORA_APPROVAL_ERROR\",\n        \"TERMINATED\"\n      ]\n    },\n    {\n      \"topic\": \"iby table statuses\",\n      \"description\": \"Statuses whose source is IBY.\",\n      \"statuses\": [\n        \"INSERTED\",\n        \"PENDING_REVIEW\",\n        \"INFORMATION_REQUIRED\",\n        \"DOCUMENTS_VALIDATED\",\n        \"PENDING_REVIEW_DOC_VAL_ERRORS\",\n        \"PENDING_REVIEW_PMT_VAL_ERRORS\",\n        \"VALIDATION_FAILED\",\n        \"FAILED_PAYMENT_VALIDATION\",\n        \"CALCULATING\",\n        \"MISSING RATES\",\n        \"MISSING_X_RATES\",\n        \"ORA_REQUIRE_APPROVAL\",\n        \"ORA_APPROVAL_INITIATED\",\n        \"ORA_APPROVAL_WITHDRAWN\",\n        \"ORA_APPROVED\",\n        \"ORA_APPROVAL_ERROR\",\n        \"ORA_REFRESH_INSTALLMENTS\",\n        \"PAYMENTS_INITIATED\",\n        \"PAYMENTS_CREATED\",\n        \"RETRY_DOCUMENT_VALIDATION\",\n        \"RETRY_PAYMENT_CREATION\",\n        \"COMPLETED\",\n        \"CANCELING\",\n        \"TERMINATED\",\n        \"ASSIGNMENT_COMPLETE\"\n      ]\n    },\n    {\n      \"topic\": \"AP table statuses\",\n      \"description\": \"Statuses whose source is AP.\",\n      \"statuses\": [\n        \"UNSTARTED\",\n        \"SELECTING\",\n        \"SELECTED\",\n        \"REVIEW\",\n        \"SUBMITTED\",\n        \"CANCELED\",\n        \"CANCELLED NO PAYMENTS\",\n        \"CANCELING\"\n      ]\n    }\n  ]\n}"
            },
            {
              "id": "1774241619492",
