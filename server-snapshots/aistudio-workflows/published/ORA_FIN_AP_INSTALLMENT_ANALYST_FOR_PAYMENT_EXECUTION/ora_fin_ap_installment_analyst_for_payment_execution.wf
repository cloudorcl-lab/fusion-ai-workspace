            \"meaning\"\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"paymentProcessRequest\",\n      \"shape\": \"PayablesPaymentProcessRequest\",\n      \"fields\": [\n        \"checkrunId\",\n        \"checkrunName\"\n      ]\n    },\n    {\n      \"accessorName\": \"code\",\n      \"shape\": \"Lookup\",\n      \"fields\": [\n        \"lookupType\",\n        \"meaning\",\n        \"lookupCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"paymentMethod\",\n      \"shape\": \"PaymentMethod\",\n      \"fields\": [\n        \"paymentMethodName\",\n        \"code\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"paymentMode\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupCode\",\n            \"lookupType\",\n            \"meaning\"\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"financeProgram\",\n      \"shape\": \"FinancingProgram\",\n      \"fields\": [\n        \"financingProgramId\",\n        \"financingOptionTypeCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"financeProgramOffer\",\n      \"shape\": \"FinancingProgramOffer\",\n      \"fields\": [\n        \"financingProgramOfferId\"\n      ]\n    },\n    {\n      \"accessorName\": \"externalBankAccount\",\n      \"shape\": \"ExternalBankAccount\",\n      \"fields\": [\n        \"maskedAccountNumber\",\n        \"maskedIban\",\n        \"id\"\n      ]\n    }\n  ],\n  \"filters\": [\n    {\n      \"attribute\": \"paymentProcessRequest.checkrunId\",\n      \"type\": \"int64\"\n    },\n    {\n      \"attribute\": \"paymentProcessRequest.checkrunName\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.invoiceNumber\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierId\",\n      \"type\": \"int64\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction<Invoice>.supplier.name\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction<Invoice>.supplierSite.name\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.paymentCurrency.currencyCode\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.invoiceCurrency.currencyCode\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"paymentMethod.paymentMethodName\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.legalEntity.legalEntityId\",\n      \"type\": \"int64\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.paymentTerm.termId\",\n      \"type\": \"int64\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction.businessUnit.id\",\n      \"type\": \"int64\"\n    },\n    {\n      \"attribute\": \"dueDate\",\n      \"type\": \"date\"\n    },\n    {\n      \"attribute\": \"unpaidAmount\",\n      \"type\": \"string\"\n    },\n    {\n      \"attribute\": \"invoiceTransaction<Invoice>.supplier.supplierType.lookupCode\",\n      \"type\": \"string\",\n      \"possibleValues\": [\n        \"ATTORNEY\",\n        \"CONTRACTOR\",\n        \"FEDERAL\",\n        \"GOVERNMENT\",\n        \"INSURANCE\",\n        \"Internal\",\n        \"MANUFACTURING\",\n        \"PCF_Supplier_Type1\",\n        \"PCF_Supplier_Type2\",\n        \"PCF_Supplier_Type3\",\n        \"PCF_Supplier_Type4\",\n        \"PCF_Supplier_Type5\",\n        \"POZ TEST SUPPLIER TYPE\",\n        \"PUBLIC SECTOR COMPANIES\",\n        \"SERVICES\",\n        \"SUB-CONTRACTOR\",\n        \"SUPPLIER\",\n        \"TAX AUTHORITY\",\n        \"TRANSPORTADOR\",\n        \"TRUST\",\n        \"UTILITY\"\n      ]\n    }\n  ],\n  \"drivers\": [\n    {\n      \"topic\": \"staticDiscountAmountCalculation\",\n      \"alias\": \"discountAmount\",\n      \"description\": \"Use the following formula to calculate staticDiscount from the fields: CASE WHEN  scheduleDueDate >= TRUNC (SYSDATE) AND aprDiscountRate IS NULL THEN CASE WHEN alwaysTakeDiscountFlag = 'Y' THEN firstDiscAmtAvailable WHEN (payDateBasisLookupCode = 'DISCOUNT' AND discountDate IS NOT NULL AND firstDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) <= discountDate ) THEN firstDiscAmtAvailable WHEN ( payDateBasisLookupCode = 'DISCOUNT' AND secondDiscountDate IS NOT NULL AND secondDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) > discountDate AND TRUNC (SYSDATE) <= secondDiscountDate ) THEN secondDiscAmtAvailable WHEN ( payDateBasisLookupCode = 'DISCOUNT' AND thirdDiscountDate IS NOT NULL AND thirdDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) > secondDiscountDate AND TRUNC (SYSDATE) <= thirdDiscountDate ) THEN thirdDiscAmtAvailable ELSE 0 END ELSE 0 END AS staticDiscountAmount\"\n    },\n    {\n      \"topic\": \"staticDiscountDateCalculation\",\n      \"alias\": \"discountDate\",\n      \"description\": \"Use the following formulat to calculate staticDiscountDate from the fields: TO_CHAR(CASE WHEN  scheduleDueDate >= TRUNC (SYSDATE) AND aprDiscountRate IS NULL THEN CASE WHEN alwaysTakeDiscountFlag = 'Y' THEN discountDate WHEN (payDateBasisLookupCode = 'DISCOUNT' AND discountDate IS NOT NULL AND firstDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) <= discountDate ) THEN discountDate WHEN ( payDateBasisLookupCode = 'DISCOUNT' AND secondDiscountDate IS NOT NULL AND secondDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) > discountDate AND TRUNC (SYSDATE) <= secondDiscountDate ) THEN secondDiscountDate WHEN ( payDateBasisLookupCode = 'DISCOUNT' AND thirdDiscountDate IS NOT NULL AND thirdDiscAmtAvailable IS NOT NULL AND TRUNC (SYSDATE) > secondDiscountDate AND TRUNC (SYSDATE) <= thirdDiscountDate ) THEN thirdDiscountDate ELSE scheduleDueDate END ELSE scheduleDueDate END, 'YYYY-MM-DD') AS discountDate\"\n    }\n  ]\n}"
            },
            {
              "id": "1772688494701",
              "name": "installmentExtractionSample",
              "scope": "JOB",
              "type": "object",
              "value": "{\n    \"viewQueries\": {\n        \"payablesInvoiceInstallments\": {\n            \"module\": \"oraErpCorePayablesInvoices\",\n            \"businessObject\": \"PayablesInvoiceInstallment\",\n            \"view\": \"payablesPaymentScheduleDetail\",\n            \"fieldAliases\": {\n                \"discountAPR\":\"aprDiscountRate\",\n                \"installmentNumber\": \"installmentNumber\",\n                \"dueDate\": \"scheduleDueDate\",\n                \"invoiceTransaction.invoiceNumber\": \"invoiceNumber\",\n                \"invoiceTransaction<Invoice>.supplierSite.name\": \"supplierSiteName\",\n                \"invoiceTransaction.paymentTerm.paymentTerm\": \"paymentTerm\",\n                \"invoiceTransaction.paymentTerm.termId\": \"termId\",\n                \"invoiceTransaction.businessUnit.name\": \"businessUnitName\",\n                \"invoiceTransaction.businessUnit.id\": \"businessUnitId\",\n                \"paymentMethod.paymentMethodName\":\"paymentMethod\",\n                \"externalBankAccount.maskedAccountNumber\":\"bank\",\n                \"invoiceTransaction.invoiceCurrency.currencyCode\": \"currency\",             \n                \"invoiceTransaction<Invoice>.supplierSite.alwaysTakeDiscount\": \"alwaysTakeDiscountFlag\",\n                \"invoiceTransaction<Invoice>.supplier.name\": \"supplierName\",\n                \"invoiceTransaction<Invoice>.supplier.supplierId\": \"supplierId\",\n                \"invoiceTransaction.legalEntity.legalEntityName\": \"legalEntityName\",       \n                \"invoiceTransaction.legalEntity.legalEntityId\": \"legalEntityId\",\n                \"invoiceTransaction<Invoice>.supplierSite.payDateBasisCode\": \"payDateBasisLookupCode\"\n\n            }\n        }\n    },\n    \"select\": \"select installmentNumber, dueDate, currency, supplierSiteName from (select invoiceNumber ||'-'|| installmentNumber as installmentNumber, to_char(scheduleDueDate,'YYYY-MM-DD') as dueDate, currency, supplierSiteName from payablesInvoiceInstallments where scheduleDueDate>=TRUNC (SYSDATE) order by unpaidAmount) where ROWNUM<=20\",\n    \"return\": [\n        {\n            \"name\": \"installmentNumber\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\": \"dueDate\",\n            \"type\": \"string\"\n        }, \n        {\n            \"name\": \"currency\",\n            \"type\": \"string\"\n        },\n        {\n            \"name\": \"supplierSiteName\",\n            \"type\": \"string\"\n        }\n    ]\n}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
