              "scope": "JOB",
              "type": "object",
              "value": "{\n  \"name\": \"paymentRunInstallments\",\n  \"type\": \"view\",\n  \"businessObject\": \"PayablesDocumentPayable\",\n  \"module\": \"oraErpCorePaymentsFundsDisbursement\",\n  \"defaultFields\": [\n    \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",\n    \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",\n    \"payablesInvoiceInstallment.installmentNumber\",\n    \"payablesInvoiceInstallment.dueDate\",\n    \"paymentCurrencyCode\",\n    \"amountToBePaid\"\n  ],\n  \"fields\": [\n    \"documentPayableId\",\n    \"paymentDate\",\n    \"documentDate\",\n    \"documentCurrencyCode\",\n    \"documentAmount\",\n    \"interestRate\",\n    \"discount\",\n    \"invoiceTypeCode\",\n    \"documentCurrencyPaymentAmount\",\n    \"paymentCurrencyCode\",\n    \"amountToBePaid\",\n    \"paymentDueDate\",\n    \"sourceProductReferenceNumber\",\n    \"sourceProductFirstUniqueIdentifier\",\n    \"sourceProductThirdUniqueIdentifier\",\n    \"withheldAmount\"\n  ],\n  \"accessors\": [\n    {\n      \"accessorName\": \"paymentMethod\",\n      \"shape\": \"PaymentMethod\",\n      \"fields\": [\n        \"code\",\n        \"paymentMethodName\"\n      ]\n    },\n    {\n      \"accessorName\": \"type\",\n      \"shape\": \"Lookup\",\n      \"fields\": [\n        \"lookupType\",\n        \"meaning\",\n        \"lookupCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"documentPayableStatus\",\n      \"shape\": \"Lookup\",\n      \"fields\": [\n        \"lookupType\",\n        \"meaning\",\n        \"lookupCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"paymentMode\",\n      \"shape\": \"Lookup\",\n      \"fields\": [\n        \"lookupType\",\n        \"meaning\",\n        \"lookupCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"businessUnit\",\n      \"shape\": \"BusinessUnit\",\n      \"fields\": [\n        \"id\",\n        \"name\",\n        \"effectiveStartDate\",\n        \"effectiveEndDate\"\n      ]\n    },\n    {\n      \"accessorName\": \"legalEntity\",\n      \"shape\": \"LegalEntity\",\n      \"fields\": [\n        \"legalEntityId\",\n        \"name\"\n      ]\n    },\n    {\n      \"accessorName\": \"supplierSite\",\n      \"shape\": \"SupplierSite\",\n      \"fields\": [\n        \"id\",\n        \"name\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"supplier\",\n          \"shape\": \"Supplier\",\n          \"fields\": [\n            \"supplierId\"\n          ],\n          \"accessors\": [\n            {\n              \"accessorName\": \"supplierType\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"payeeParty\",\n      \"shape\": \"Party\",\n      \"fields\": [\n        \"id\",\n        \"name\"\n      ]\n    },\n    {\n      \"accessorName\": \"bankAccount\",\n      \"shape\": \"BankAccount\",\n      \"fields\": [\n        \"id\",\n        \"name\"\n      ]\n    },\n    {\n      \"accessorName\": \"externalBankAccount\",\n      \"shape\": \"ExternalBankAccount\",\n      \"fields\": [\n        \"id\",\n        \"bankAccountName\",\n        \"countryCode\"\n      ]\n    },\n    {\n      \"accessorName\": \"accountPaymentProfile\",\n      \"shape\": \"PaymentProcessProfileAccount\",\n      \"fields\": [\n        \"paymentProfileId\",\n        \"paymentProfileName\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"systemPaymentProfile\",\n          \"shape\": \"PaymentProcessProfile\",\n          \"fields\": [\n            \"systemProfileCode\"\n          ],\n          \"accessors\": [\n            {\n              \"accessorName\": \"processingType\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"paymentFormat\",\n              \"shape\": \"PaymentFormat\",\n              \"fields\": [\n                \"paymentFormatCode\",\n                \"formatName\"\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"payablesInvoiceInstallment\",\n      \"shape\": \"PayablesInvoiceInstallment\",\n      \"fields\": [\n        \"invoiceId\",\n        \"installmentNumber\",\n        \"invoiceToPaymentConversionRate\",\n        \"unpaidAmount\",\n        \"dueDate\",\n        \"installmentAmount\",\n        \"remitToSupplierName\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"invoiceTransaction\",\n          \"shape\": \"PayablesInvoiceTransaction\",\n          \"fields\": [\n            \"invoiceId\",\n            \"invoiceNumber\",\n            \"invoiceTypeDiscriminator\",\n            \"invoiceDate\",\n            \"invoiceAmount\"\n          ],\n          \"accessors\": [\n            {\n              \"accessorName\": \"invoiceTypeCode\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupCode\",\n                \"lookupType\",\n                \"meaning\"\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"paymentsPayablesPaymentProcessRequest\",\n      \"shape\": \"PayablesPaymentProcessRequest\",\n      \"fields\": [\n        \"paymentProcessRequestId\",\n        \"paymentProcessRequestName\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"paymentProcessRequestStatus\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupType\",\n            \"meaning\",\n            \"lookupCode\"\n          ],\n          \"lookupType\": \"PPR_STATUS\",\n          \"possibleValues\": [\n            { \"lookupCode\": \"ASSIGNMENT_COMPLETE\", \"meaning\": \"Assignment complete\" },\n            { \"lookupCode\": \"CALCULATING\", \"meaning\": \"Calculating withholding and interest\" },\n            { \"lookupCode\": \"CANCELED\", \"meaning\": \"Cancelled Payment\" },\n            { \"lookupCode\": \"CANCELING\", \"meaning\": \"Terminating\" },\n            { \"lookupCode\": \"CANCELLED NO PAYMENTS\", \"meaning\": \"No available installments\" },\n            { \"lookupCode\": \"COMPLETED\", \"meaning\": \"Payments completed\" },\n            { \"lookupCode\": \"DOCUMENTS_VALIDATED\", \"meaning\": \"Documents validated\" },\n            { \"lookupCode\": \"FAILED_PAYMENT_VALIDATION\", \"meaning\": \"Failed payment validation\" },\n            { \"lookupCode\": \"INFORMATION_REQUIRED\", \"meaning\": \"Pending action to complete information required\" },\n            { \"lookupCode\": \"INSERTED\", \"meaning\": \"Pending\" },\n            { \"lookupCode\": \"MISSING RATES\", \"meaning\": \"Missing payment conversion rates\" },\n            { \"lookupCode\": \"MISSING_X_RATES\", \"meaning\": \"Missing cross-currency rates\" },\n            { \"lookupCode\": \"ORA_APPROVAL_ERROR\", \"meaning\": \"Error in payments approval\" },\n            { \"lookupCode\": \"ORA_APPROVAL_INITIATED\", \"meaning\": \"Payments approval initiated\" },\n            { \"lookupCode\": \"ORA_APPROVAL_WITHDRAWN\", \"meaning\": \"Withdrawn from approval\" },\n            { \"lookupCode\": \"ORA_APPROVED\", \"meaning\": \"Payments approved\" },\n            { \"lookupCode\": \"ORA_REFRESH_INSTALLMENTS\", \"meaning\": \"Refreshing selected installments\" },\n            { \"lookupCode\": \"ORA_REQUIRE_APPROVAL\", \"meaning\": \"Pending payments approval\" },\n            { \"lookupCode\": \"PAYMENTS_CREATED\", \"meaning\": \"Waiting for payment file processing\" },\n            { \"lookupCode\": \"PAYMENTS_INITIATED\", \"meaning\": \"Pending Payment File Completion\" },\n            { \"lookupCode\": \"PENDING_REVIEW\", \"meaning\": \"Pending proposed payment review\" },\n            { \"lookupCode\": \"PENDING_REVIEW_DOC_VAL_ERRORS\", \"meaning\": \"Pending action to address document validation errors\" },\n            { \"lookupCode\": \"PENDING_REVIEW_PMT_VAL_ERRORS\", \"meaning\": \"Pending action to address payment validation errors\" },\n            { \"lookupCode\": \"RETRY_DOCUMENT_VALIDATION\", \"meaning\": \"Retry document validation\" },\n            { \"lookupCode\": \"RETRY_PAYMENT_CREATION\", \"meaning\": \"Retry payment creation\" },\n            { \"lookupCode\": \"REVIEW\", \"meaning\": \"Pending installments review\" },\n            { \"lookupCode\": \"SELECTED\", \"meaning\": \"Installments selected\" },\n            { \"lookupCode\": \"SELECTING\", \"meaning\": \"Selecting installments\" },\n            { \"lookupCode\": \"SUBMITTED\", \"meaning\": \"Submitted\" },\n            { \"lookupCode\": \"TERMINATED\", \"meaning\": \"Terminated\" },\n            { \"lookupCode\": \"UNSTARTED\", \"meaning\": \"Pending installments selection\" },\n            { \"lookupCode\": \"VALIDATION_FAILED\", \"meaning\": \"Failed document validation\" }\n          ]\n        },\n        {\n          \"accessorName\": \"paymentInitiation\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupType\",\n            \"meaning\",\n            \"lookupCode\"\n          ]\n        },\n        {\n          \"accessorName\": \"bankAccount\",\n          \"shape\": \"BankAccount\",\n          \"fields\": [\n            \"id\"\n          ]\n        }\n      ]\n    },\n    {\n      \"accessorName\": \"payablesDisbursementPayment\",\n      \"shape\": \"PayablesDisbursementPayment\",\n      \"fields\": [\n        \"paymentId\",\n        \"paymentProfileAccountName\",\n        \"paymentProfileSystemName\",\n        \"paymentReferenceNumber\",\n        \"paperDocumentNumber\",\n        \"paymentAmount\",\n        \"paymentDate\",\n        \"paymentCompleteFlag\",\n        \"bepErrorCode\",\n        \"bepErrorMessageText\",\n        \"maturityDate\",\n        \"paymentReasonComments\",\n        \"bankStatusCode\",\n        \"paymentSystemResponseIdentifier\",\n        \"issuerAuthorizationReference\",\n        \"acquirerTransactionReference\",\n        \"issuerProcessingTimestamp\",\n        \"voidDate\",\n        \"voidReason\",\n        \"invoiceDueDate\",\n        \"stopRequestPlacedBy\"\n      ],\n      \"accessors\": [\n        {\n          \"accessorName\": \"paymentStatus\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupType\",\n            \"meaning\",\n            \"lookupCode\"\n          ]\n        },\n        {\n          \"accessorName\": \"fundsStatus\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupType\",\n            \"meaning\",\n            \"lookupCode\"\n          ]\n        },\n        {\n          \"accessorName\": \"paymentFunction\",\n          \"shape\": \"Lookup\",\n          \"fields\": [\n            \"lookupType\",\n            \"meaning\",\n            \"lookupCode\"\n          ]\n        },\n        {\n          \"accessorName\": \"payablesPayment\",\n          \"shape\": \"PayablesPayment\",\n          \"fields\": [\n            \"paymentId\",\n            \"paymentDate\",\n            \"paymentCurrencyCode\",\n            \"supplierName\",\n            \"paymentAmount\",\n            \"remitToSupplierName\",\n            \"remitToAddressName\",\n            \"futurePayDueDate\",\n            \"conversionRate\",\n            \"conversionDate\",\n            \"paymentBaseAmount\",\n            \"positivePayStatusCode\",\n            \"paymentNumber\",\n            \"clearingAmount\",\n            \"clearingDate\",\n            \"clearingBaseAmount\",\n            \"clearingConversionRate\",\n            \"clearingConversionDate\",\n            \"clearingConversionRateType\",\n            \"reconciledFlag\",\n            \"maturityConversionRate\",\n            \"maturityConversionDate\",\n            \"maturityConversionRateType\",\n            \"releasedDate\",\n            \"stopDate\"\n          ],\n          \"accessors\": [\n            {\n              \"accessorName\": \"paymentType\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"paymentStatus\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"paymentCurrency\",\n              \"shape\": \"Currency\",\n              \"fields\": [\n                \"currencyCode\",\n                \"issuingTerritoryCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"paymentSettlementPriority\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            }\n          ]\n        },\n        {\n          \"accessorName\": \"payablesPaymentFile\",\n          \"shape\": \"PayablesPaymentFile\",\n          \"fields\": [\n            \"paymentInstructionId\",\n            \"paymentCount\",\n            \"transmissionDate\",\n            \"processingDate\",\n            \"bankStatusCode\"\n          ],\n          \"accessors\": [\n            {\n              \"accessorName\": \"paymentFileProcessingStatus\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"disbursementInboundFile\",\n              \"shape\": \"DisbursementInboundFile\",\n              \"fields\": [\n                \"id\",\n                \"fileName\",\n                \"timeCreated\",\n                \"errorMessage\"\n              ],\n              \"accessors\": [\n                {\n                  \"accessorName\": \"paymentSystem\",\n                  \"shape\": \"PaymentSystem\",\n                  \"fields\": [\n                    \"id\",\n                    \"paymentSystemName\"\n                  ]\n                },\n                {\n                  \"accessorName\": \"inboundFileProcessingStatus\",\n                  \"shape\": \"Lookup\",\n                  \"fields\": [\n                    \"lookupType\",\n                    \"meaning\",\n                    \"lookupCode\"\n                  ]\n                }\n              ]\n            },\n            {\n              \"accessorName\": \"paymentFileConfirmationStatus\",\n              \"shape\": \"Lookup\",\n              \"fields\": [\n                \"lookupType\",\n                \"meaning\",\n                \"lookupCode\"\n              ]\n            },\n            {\n              \"accessorName\": \"paymentDocument\",\n              \"shape\": \"PaymentDocument\",\n              \"fields\": [\n                \"id\",\n                \"paymentDocument\",\n                \"firstAvailableDocumentNumber\",\n                \"lastAvailableDocumentNumber\",\n                \"lastIssuedDocumentNumber\"\n              ],\n              \"accessors\": [\n                {\n                  \"accessorName\": \"paymentDocumentCategory\",\n                  \"shape\": \"PaymentDocumentCategory\",\n                  \"fields\": [\n                    \"code\",\n                    \"applicationId\",\n                    \"name\"\n                  ]\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"drivers\": [\n    {\n      \"topic\": \"payment mode mappings\",\n      \"values\": [\n        { \"meaning\": \"Virtual Card\", \"lookupCode\": \"VIRTUAL_CARD\" }\n      ]\n    },\n    {\n      \"topic\": \"stuck due to failure\",\n      \"description\": \"A narrower stuck-in-failure family for payment-run detail and summary routing. The installments in these statuses are not released and will be 'stuck', since the cannot be included in other PPRs. Match rows where either the PPR status is blocked in a failure state or the payment instruction itself failed during processing.\",\n      \"pprStatusPath\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",\n      \"pprStatuses\": [\n        \"INFORMATION_REQUIRED\",\n        \"PENDING_REVIEW_DOC_VAL_ERRORS\",\n        \"PENDING_REVIEW_PMT_VAL_ERRORS\",\n        \"MISSING RATES\",\n        \"MISSING_X_RATES\",\n        \"ORA_APPROVAL_ERROR\"\n      ],\n      \"paymentInstructionStatusPath\": \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",\n      \"paymentInstructionStatuses\": [\n        \"FORMATTING_FAILED\",\n        \"TRANSMISSION_FAILED\",\n        \"CREATION_ERROR\"\n      ]\n    }\n  ]\n\n}"
