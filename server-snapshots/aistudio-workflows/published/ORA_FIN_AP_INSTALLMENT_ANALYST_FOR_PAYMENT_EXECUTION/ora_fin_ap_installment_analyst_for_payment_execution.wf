                {
                  "metadata": {
                    "name": "Format Selected Installments Summary",
                    "returnType": "object",
                    "sourceCode": "let dataFetched = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.FIN_AP_BO_FETCH_SUMMARY_OF_SELECTED_INSTALLMENTS.$output?.items??[]\n\nlet fields = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fields;\n\nlet fieldAlias = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fieldAlias;\n\nlet processedData = [];\nfor (let i = 0; i < dataFetched.length; i++) {\n    let file = dataFetched[i];\n    let reconstructedRow = {};\n    for (let key in file) {\n        reconstructedRow[key] = file[key];\n    }\n\t    for (let alias in fieldAlias) {\n\t        let path = alias;\n\t        let pathParts = path.split('.');\n\t        let value = file;\n\t        for (let j = 0; j < pathParts.length; j++) {\n\t            if (value && value.hasOwnProperty(pathParts[j])) {\n\t                value = value[pathParts[j]];\n            } else {\n                value = undefined;\n\t                break;\n\t            }\n\t        }\n\t        let outputKey = pathParts.length > 1 ? pathParts[0] : alias;\n\t        reconstructedRow[outputKey] = value;\n\t    }\n\t    processedData.push(reconstructedRow);\n\t}\n\nlet fieldsArr = fields.split(',');\nlet columnOrder = fieldsArr;\n\n// ?? Final output\nlet output = {\n    type: \"table\",\n    heading: $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.heading ,\n    columnOrder: columnOrder,\n    content: processedData\n};\n\nreturn output;"
                  },
