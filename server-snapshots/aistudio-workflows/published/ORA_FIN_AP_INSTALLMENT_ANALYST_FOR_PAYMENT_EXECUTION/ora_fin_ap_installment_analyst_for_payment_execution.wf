            {
              "id": "1773989900709",
              "name": "payablesSelectedInstallmentsSummary",
              "scope": "JOB",
              "type": "object",
              "value": "{\n  \"name\": \"payablesSelectedInstallmentsSummary\",\n  \"type\": \"analyticView\",\n  \"module\": \"oraErpCorePayablesPayments\",\n  \"drivers\": [\n    {\n      \"topic\": \"Summary semantics\",\n      \"description\": \"This analytic view already returns deduplicated summary data for the supported payment process request reporting scope. When the requested summary metrics are supported by this AV, use it directly and do not add extra union or deduplication logic.\"\n    }\n  ],\n  \"measures\": [\n    \"paymentAmount\",\n    \"unpaidAmount\",\n    \"withheldAmount\",\n    \"discountAmount\",\n    \"interestAmount\"\n  ],\n  \"dimensions\": [\n    {\n      \"name\": \"legalEntity\",\n      \"attributes\": [\n        { \"name\": \"legalEntityId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"legalEntityName\", \"sortable\": true, \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"legalEntityHierarchy\", \"levels\": [\"LEGALENTITY\"] }\n      ]\n    },\n    {\n      \"name\": \"businessUnit\",\n      \"attributes\": [\n        { \"name\": \"businessUnitId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"businessUnitName\", \"sortable\": true, \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"businessUnitHierarchy\", \"levels\": [\"BUSINESSUNIT\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentProcessRequest\",\n      \"attributes\": [\n        { \"name\": \"checkrunId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"checkrunName\", \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentProcessRequestHierarchy\", \"levels\": [\"PAYMENTPROCESSREQUEST\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentProcessRequestStatus\",\n      \"attributes\": [\n        { \"name\": \"paymentProcessRequestStatusCode\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"paymentProcessRequestStatus\", \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentProcessRequestStatusHierarchy\", \"levels\": [\"PAYMENTPROCESSREQUESTSTATUS\"] }\n      ]\n    },\n    {\n      \"name\": \"supplierSite\",\n      \"attributes\": [\n        { \"name\": \"supplierSiteId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"supplierSiteName\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"partySiteId\" },\n        { \"name\": \"country\" },\n        { \"name\": \"supplierId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"partyNumber\" },\n        { \"name\": \"supplierName\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"dunsNumber\" },\n        { \"name\": \"supplierNumber\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"partyId\" },\n        { \"name\": \"supplierType\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"supplierTypeMeaning\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"standardIndustryClassification\" },\n        { \"name\": \"taxOrganizationType\" },\n        { \"name\": \"oneTimeFlag\" },\n        { \"name\": \"paymentTermId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"paymentTerm\" }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"supplierHierarchy\", \"levels\": [\"SUPPLIERSITE\", \"SUPPLIER\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentCurrency\",\n      \"attributes\": [\n        { \"name\": \"currencyCode\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"currencyName\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"currencySymbol\" }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentCurrencyHierarchy\", \"levels\": [\"CURRENCYCODE\"] }\n      ]\n    },\n    {\n      \"name\": \"dueDate\",\n      \"attributes\": [\n        { \"name\": \"calendarDate\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"calendarYear\", \"sortable\": true },\n        { \"name\": \"calendarQuarter\" },\n        { \"name\": \"calendarMonth\", \"sortable\": true },\n        { \"name\": \"calendarWeek\" },\n        { \"name\": \"dayOfMonth\" }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"dueDateToYearHierarchy\", \"levels\": [\"DAY\", \"MONTH\", \"QUARTER\", \"YEAR\"] },\n        { \"name\": \"dueDateWeekToYearHierarchy\", \"levels\": [\"DAY\", \"WEEK\", \"YEAR\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentDate\",\n      \"attributes\": [\n        { \"name\": \"calendarDate\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"calendarYear\", \"sortable\": true },\n        { \"name\": \"calendarQuarter\" },\n        { \"name\": \"calendarMonth\", \"sortable\": true },\n        { \"name\": \"calendarWeek\" },\n        { \"name\": \"dayOfMonth\" }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentDateToYearHierarchy\", \"levels\": [\"DAY\", \"MONTH\", \"QUARTER\", \"YEAR\"] },\n        { \"name\": \"paymentDateWeekToYearHierarchy\", \"levels\": [\"DAY\", \"WEEK\", \"YEAR\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentMethod\",\n      \"attributes\": [\n        { \"name\": \"paymentMethodCode\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"paymentMethodName\", \"sortable\": true, \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentMethodHierarchy\", \"levels\": [\"PAYMENTMETHOD\"] }\n      ]\n    },\n    {\n      \"name\": \"paymentProcessProfile\",\n      \"attributes\": [\n        { \"name\": \"paymentProfileId\", \"sortable\": true, \"searchable\": true },\n        { \"name\": \"paymentProcessProfileName\", \"sortable\": true, \"searchable\": true }\n      ],\n      \"hierarchies\": [\n        { \"name\": \"paymentProcessProfileHierarchy\", \"levels\": [\"PAYMENTPROCESSPROFILE\"] }\n      ]\n    },\n    