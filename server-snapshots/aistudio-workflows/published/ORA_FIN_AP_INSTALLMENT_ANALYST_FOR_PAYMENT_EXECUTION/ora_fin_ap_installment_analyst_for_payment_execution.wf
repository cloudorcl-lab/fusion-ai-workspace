                  "code": "FIN_AP_BO_FETCH_PAYABLES_DOCUMENT_PAYABLE",
                  "id": "1774329222314",
                  "inputs": [
                    {
                      "id": "1775825304918_1",
                      "name": "fields",
                      "type": "string",
                      "value": "{{$context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fields}}"
                    },
                    {
                      "id": "1775825304919_2",
                      "name": "filter",
                      "type": "string",
                      "value": "{{$context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.filter}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Format Payment Run Installments",
                    "returnType": "object",
                    "sourceCode": "let dataFetched = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.FIN_AP_BO_FETCH_PAYABLES_DOCUMENT_PAYABLE.$output?.items??[]\n\nlet fields = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fields;\n\nlet fieldAlias = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fieldAliases;\n\n// Ensure fieldAlias is an object\nif (typeof fieldAlias === \"string\") {\n    fieldAlias = JSON.parse(\"{\" + fieldAlias + \"}\");\n}\n\n\n// ?? Filter only valid fields (present in fieldAlias) in correct order\nlet fieldsArr = fields.split(',');\nlet validFields = fieldsArr.filter(f => fieldAlias[f]);\n\n// ?? Column order = aliases in correct order\nlet columnOrder = validFields.map(f => fieldAlias[f]);\n\nlet processedData = [];\n\n// ?? Process data\nfor (let i = 0; i < dataFetched.length; i++) {\n    let file = dataFetched[i];\n    let reconstructedRow = {};\n\n    for (let j = 0; j < validFields.length; j++) {\n        let fieldPath = validFields[j];\n        let alias = fieldAlias[fieldPath];\n\n        let pathParts = fieldPath.split('.');\n        let value = file;\n\n        for (let k = 0; k < pathParts.length; k++) {\n            if (value && Object.prototype.hasOwnProperty.call(value, pathParts[k])) {\n                value = value[pathParts[k]];\n            } else {\n                value = \"\";\n                break;\n            }\n        }\n            reconstructedRow[alias] = (value === null || value === undefined) ? \"\" : value;\n    }\n\n    processedData.push(reconstructedRow);\n}\n\n// ?? Final output\nlet output = {\n    type: \"table\",\n    heading: $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.heading ,\n    columnOrder: columnOrder,\n    content: processedData\n};\n\nreturn output;"
                  },
                  "outcomes": {
                    "success": "end_1772688978888"
                  },
                  "code": "FIN_AP_CODE_FORMAT_PAYABLES_DOCUMENT_PAYABLES",
