                {
                  "metadata": {
                    "name": "Format Data for Invoice Installments",
                    "returnType": "object",
                    "sourceCode": "let dataFetched = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.FIN_AP_BO_EXTRACTION.$output??[]\n\nlet fields = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fields;\n\nlet fieldAlias = $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.fieldAlias;\n\nlet processedFiles = [];\nfor (let i = 0; i < dataFetched.length; i++) {\n    let file = dataFetched[i];\n    let newFile = {};\n    for (let key in file) {\n        newFile[key] = file[key];\n    }\n    for (let alias in fieldAlias) {\n        let path = fieldAlias[alias];\n        let pathParts = path.split('.');\n        let value = file;\n        for (let j = 0; j < pathParts.length; j++) {\n            if (value && value.hasOwnProperty(pathParts[j])) {\n                value = value[pathParts[j]];\n            } else {\n                value = undefined;\n                break;\n            }\n        }\n        newFile[alias] = value;\n    }\n    processedFiles.push(newFile);\n}\n\nlet fieldsArr = fields.split(',');\nlet columnOrder = [];\nfor (let i = 0; i < fieldsArr.length; i++) {\n    let f = fieldsArr[i];\n    let aliasName = null;\n    for (let alias in fieldAlias) {\n        if (fieldAlias[alias] === f) {\n            aliasName = alias;\n            break;\n        }\n    }\n    if (aliasName) {\n        columnOrder.push(aliasName);\n    } else {\n        columnOrder.push(f);\n    }\n}\n\nlet output = {\n    \"type\": \"table\",\n    \"heading\": $context.$nodes.FIN_AP_FOR_OBJECT_FETCH_LOOP.$currentItem.heading ,\n    \"columnOrder\": columnOrder,\n    \"content\": processedFiles\n};\n\nreturn output;"
