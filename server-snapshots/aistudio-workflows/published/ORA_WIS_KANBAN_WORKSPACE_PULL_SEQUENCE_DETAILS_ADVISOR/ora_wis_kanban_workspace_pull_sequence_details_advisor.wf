        {
          "metadata": {
            "name": "Get Reasons",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FILTER_KANBAN_PULLSEQUENCE_SUMMARIES.$output.result?.items;\nconst thresholdRaw = parseFloat($context.$variables.threshold);\nconst threshold = Number.isFinite(thresholdRaw) ? thresholdRaw : 0;\n\nconst data = Array.isArray(input) ? input : [];\n\nconst ranked = data.map((r, idx) => {\n  // Safe parsing\n  const pctDiffTotalRaw = parseFloat(r?.PctDiffTotal);\n  const pctDiffFullRaw  = parseFloat(r?.PctDiffFull);\n\n  const pctDiffTotal = Number.isFinite(pctDiffTotalRaw) ? pctDiffTotalRaw : 0;\n  const pctDiffFull  = Number.isFinite(pctDiffFullRaw)  ? pctDiffFullRaw  : 0;\n\n  // Point Of Use\n  const subinventory = r?.SubinventoryCode ?? \"\";\n  const locator = r?.Locator ?? \"\";\n  const pointOfUse = locator ? `${subinventory}:${locator}` : subinventory;\n\n  // Reason + priority\n  let reason = \"\";\n  let priority = 3;\n\n  if (pctDiffTotal > threshold) {\n    reason = \"Total # of cards outside safety range\";\n    priority = 1;\n  } else if (pctDiffFull > threshold && pctDiffTotal <= threshold) {\n    reason = \"Full cards outside safety range\";\n    priority = 2;\n  } else if (pctDiffFull <= threshold) {\n    reason = \"All cards within safety range\";\n    priority = 3;\n  }\n\n  return {\n    priority,\n    idx, // stable tie-breaker\n    row: {\n      \"Point Of Use\": pointOfUse || \"\",\n      \"Expected # of Cards\": r?.NumberOfCards ?? \"\",\n      \"Total\": r?.TotalKanbanCards ?? \"\",\n      \"Full\": r?.FullCards ?? \"\",\n      \"Empty\": r?.EmptyCards ?? \"\",\n      \"New\": r?.NewCards ?? \"\",\n      \"In Process\": r?.InprocessCards ?? \"\",\n      \"Temporary\": r?.TemporaryCards ?? \"\",\n      \"Reason\": reason || \"\"\n    }\n  };\n});\n\n// Sort by requested priority: 1 -> 2 -> 3\nranked.sort((a, b) => (a.priority - b.priority) || (a.idx - b.idx));\n\nreturn ranked.map((x) => x.row);\n"
          },
          "outcomes": {
            "success": "1769667420378"
          },
          "code": "GET_REASONS",
          "id": "1776073440940",
