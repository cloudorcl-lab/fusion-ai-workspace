        {
          "metadata": {
            "name": "Get List of Kanban Cards",
            "returnType": "array",
            "sourceCode": "let filteredKanbanCardNumbers = [];\nlet data = $context.$nodes.GET_ALL_KANBAN_CARDS_FOR_PULLSEQUENCE_ID.$output;\n\nfilteredKanbanCardNumbers = data.items.filter(card => (card.SupplyStatus == \"1\" || card.SupplyStatus == 1 ) && card.CardStatusMeaning === \"Active\").map(card => card.KanbanCardNumber);\n\n\n// Remove duplicates, if any\nfilteredKanbanCardNumbers = [...new Set(filteredKanbanCardNumbers)];\n\nreturn filteredKanbanCardNumbers;"
          },
          "outcomes": {
            "success": "1769765795750"
          },
