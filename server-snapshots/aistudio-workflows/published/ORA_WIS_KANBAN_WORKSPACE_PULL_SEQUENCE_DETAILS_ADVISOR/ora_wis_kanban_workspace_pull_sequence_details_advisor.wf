{
  "workflowId": "300000331058603",
  "workflowCode": "ORA_WIS_KANBAN_WORKSPACE_PULL_SEQUENCE_DETAILS_ADVISOR",
  "name": "Kanban Item Stock Anomalies",
  "description": "This agent team provides a focused item level investigation of stock anomalies helping planners quickly understand what went wrong why it happened and what to do next\nFor a selected item the agents collaboratively analyze historical and real time signals such as Kanban consumption patterns replenishment cycles lead time deviations and demand spikes to surface anomalies like unexpected shortages excess inventory or erratic usage\n\nThe team presents\n\nA clear breakdown of anomaly type and severity\n\nRoot cause indicators demand volatility supplier delays sizing issues or pull sequence imbalance\n\nContextual timelines showing when and where the deviation occurred\n\nActionable recommendations to restore stock health and prevent recurrence\n\nBy turning raw inventory signals into explainable insights this agent team enables faster data backed decisions at the item level without manual analysis",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
