        {
          "metadata": {
            "name": "Build Batch Payload",
            "returnType": "object",
            "sourceCode": "const requiredTemporaryCards = $context.$nodes.NUMBER_OF_REQUIRED_TEMPORARY_CARDS.$output.result;\nconst pullSequenceId = $context.$nodes.GET_PULL_SEQUENCE_ID.$output.PullSequenceId;\n\nconst pullSequenceSummaries = $context.$nodes.GET_ALL_PULL_SEQUENCE_SUMMARIES_BY_ITEM.$output.items || [];\nconst supplierDetails = $context.$nodes.GET_PULL_SEQUENCE_SUPPLIER.$output.items || [];\n\nconst matchedSummary = pullSequenceSummaries.find(\n  r => String(r.PullSequenceId) === String(pullSequenceId)\n);\n\n// Determine SupplierId from supplierDetails\nlet supplierId = null;\nlet supplierSiteId = null;\nif (supplierDetails && supplierDetails.length > 0) {\n  supplierId = supplierDetails[0].SupplierId;\n  supplierSiteId = supplierDetails[0].SupplierSiteId;\n}\n\nlet parts = [];\nfor (let i = 0; i < requiredTemporaryCards; i++) {\n  let payload = {\n    MaximumReplenishments: 1,\n    PullSequenceId: pullSequenceId\n  };\n\n  if (\n    matchedSummary &&\n    String(matchedSummary.SourceType) === \"2\" &&\n    supplierId != null\n  ) {\n    payload.SupplierId = supplierId;\n    payload.SupplierSiteId = supplierSiteId;\n  }\n\n  parts.push({\n    id: String(i + 1),\n    path: \"/kanbanCards?onlyData=true\",\n    operation: \"create\",\n    payload\n  });\n}\n\nreturn { parts };"
          },
          "outcomes": {
            "success": "1775656233474"
          },
          "code": "BUILD_BATCH_PAYLOAD",
