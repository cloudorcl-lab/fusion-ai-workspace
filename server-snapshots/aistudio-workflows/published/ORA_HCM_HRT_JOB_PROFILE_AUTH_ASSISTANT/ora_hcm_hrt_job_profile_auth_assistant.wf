          "code": "JOBPROFIILEGENERATOR",
          "id": "1770392388098",
          "inputs": [
            {
              "id": "1770392388099_1",
              "name": "prompt",
              "type": "string",
              "value": "## instructions\nCreate a compelling profile for the job {{$context.$triggers.REST.$input.ProfileTitle}} for use in talent acquisition and management processes. Make sure the tone of the profile inspires employees to pursue this role for their career.\n\nThe profile should include multiple sections: summary, description, responsibilities, and qualifications.\nThe summary should be no more than 75 words.\nLimit the responsibilities to no more than 10 items.\nLimit the qualifications to no more than 10 items.\nThe total should be at most 500 words.\n\nOutput an RFC8259 compliant JSON object in the following format:\n{\n    \"summary\": \"<insert a short summary of the job position>\",\n    \"description\": \"<insert a medium paragraph to describe the job position>\",\n    \"responsibilities\": [\n        <strictly no more than 10 items in this array>\n    ],\n    \"qualifications\":  [\n        <strictly no more than 10 items in this array>\n    ]\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"text\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Job Profile Output"
          },
          "outcomes": {
            "success": "1771348126749"
          },
          "code": "SET_JOB_PROFILE_OUTPUT",
          "id": "1771347958499",
          "inputs": [
            {
              "id": "1771347966053",
              "name": "JobProfileOutput",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.JOBPROFIILEGENERATOR.$output.text}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Return Job Summary",
            "returnType": "string",
            "sourceCode": "return $context.$variables.JobProfileOutput"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RETURN_JOB_SUMMARY",
          "id": "1771348126749",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
