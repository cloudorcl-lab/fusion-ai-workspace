{
  "workflowId": "100002355226976",
  "workflowCode": "ORA_FIN_AP_INSTALLMENT_ANALYST",
  "name": "Installment Analyst for Payment Options",
  "description": "Retrieves and interprets scheduled payment information for invoices, including payment due dates, amounts, and payment completion status. This assistant queries payment schedule data to answer payments specialist inquiries about upcoming payment obligations and partial payments.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
