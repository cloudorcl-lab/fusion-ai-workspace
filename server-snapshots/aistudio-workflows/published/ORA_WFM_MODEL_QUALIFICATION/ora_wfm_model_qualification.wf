        {
          "metadata": {
            "name": "Create Explore Query",
            "returnType": "object",
            "sourceCode": "const raw = $context.$triggers.REST.$input.OraAction;\n\nif (!raw) {\n  return \"No OraAction found\";\n}\n\nlet payload = null;\n\n// If OraAction is a string → parse JSON\nif (typeof raw === \"string\") {\n  try {\n    payload = JSON.parse(raw);\n  } catch (e) {\n    return \"Failed to parse OraAction JSON\";\n  }\n}\n// If OraAction is already an object\nelse if (typeof raw === \"object\") {\n  payload = raw;\n}\n\nif (!payload || !payload.model) {\n  return \"No model found in InvokeAction payload\";\n}\n\nconst model = payload.model;\n\nconst query =\n  `Get the model purpose, required inputs, and supported business use cases for the algorithm:${model}`;\n\nreturn query;"
          },
          "outcomes": {
            "success": "1768226569909"
          },
          "code": "CREATE_EXPLORE_QUERY",
