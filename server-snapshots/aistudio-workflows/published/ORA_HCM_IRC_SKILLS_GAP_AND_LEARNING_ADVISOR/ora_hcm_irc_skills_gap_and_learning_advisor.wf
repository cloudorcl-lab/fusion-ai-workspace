              "name": "input",
              "type": "string",
              "value": "{{$context.$nodes.CONVERT_GAPS_ARRAY_TO_STRING.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Consolidate Gaps And Recommendations",
            "returnType": "object",
            "sourceCode": "let skillsOutput = $context.$nodes.SKILLS_GAP_ADVISOR.$output.output;\nlet parsedSkillsOutput = {};\nif (skillsOutput)\n{\nparsedSkillsOutput=JSON.parse(skillsOutput);\n}\nlet learningOutput = $context.$nodes.RECOMMENDED_LEARNINGS.$output.output;\nlet parsedLearningOutput = {};\n\nif (learningOutput) {\n    parsedLearningOutput = JSON.parse(learningOutput);\n}\nconst gapDetails = {\n    ...parsedSkillsOutput,\n    RecommendedCourses: parsedLearningOutput.result.courses,\n    RecommendedGigs: parsedLearningOutput.result.gigs\n};\n\nconst careerRoles = gapDetails.AspirationalRoles;\nlet finalOutput = null;\n\nif (careerRoles && Array.isArray(careerRoles) && careerRoles.length > 0) {\n    finalOutput = gapDetails;\n}\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CONSOLIDATE_GAPS_AND_RECOMMENDATIONS",
          "id": "1765443118034",
