                    "sourceCode": "const item =  $context.$nodes.LOOPCONTACTS.$currentItem;\nconst objectNumber = String(item.PartyNumber) ; \nconst output = {}; \noutput.activitiesObjectCode = \"Activity\";\n\noutput.filter = {\n\t'op':'$and',\n\t'criteria':[{\n\t\t'op':'$eq',\n\t\t'attribute':'ListOfContacts.ContactId.PartyNumber',\n\t\t'value': objectNumber\n\t}]\n};\n\nreturn output;"
