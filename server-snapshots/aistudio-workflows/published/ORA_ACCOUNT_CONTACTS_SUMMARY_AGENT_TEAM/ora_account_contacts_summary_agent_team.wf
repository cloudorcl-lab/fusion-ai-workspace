          "metadata": {
            "name": "getContactPartyIds",
            "returnType": "string",
            "sourceCode": "const rawOutput = $context.$nodes.SEARCH_ACCOUNT.$output;\n\n \nconst parsedOutput = typeof rawOutput === 'string'\n  ? JSON.parse(rawOutput)\n  : rawOutput;\n \nconst partyCollection = (parsedOutput || [])\n  .flatMap(item => item?.ListOfContacts || [])\n  .map(contact => {\n    const subject = contact?.SubjectId;\n    return (subject?.PartyId && subject?.PartyNumber)\n      ? { PartyId: subject.PartyId, PartyNumber: subject.PartyNumber }\n      : null;\n  })\n  .filter(Boolean);\n\nreturn JSON.stringify(partyCollection);"
          },
          "outcomes": {
            "success": "1778393444925"
          },
          "code": "GETCONTACTPARTYIDS",
          "id": "1778393315245",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
