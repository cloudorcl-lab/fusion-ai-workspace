          "metadata": {
            "name": "IdentifyIntent",
            "returnType": "string",
            "sourceCode": "const actionName = $context.$variables.actionName;\nlet result;\n\nif (actionName === \"RECOMMENDATION\") {\n  result = \"RECOMMENDATION\";\n} else if (actionName === \"TOPCONTACT\") {\n  result = \"RECOMMENDATION\";\n} else if (actionName === \"SUMMARY\") {\n  result = \"SUMMARY\";\n} else if (actionName === \"ENGAGEMENT_SUMMARY\") {\n  result = \"ENGAGEMENT_SUMMARY\";\n} else if (actionName === \"OUT_OF_SCOPE\") {\n  result = \"OUT_OF_SCOPE\";\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778268620181"
          },
          "code": "IDENTIFYINTENT",
          "id": "1778312530022",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
