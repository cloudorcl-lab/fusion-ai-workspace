            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Account Contacts",
            "returnType": "object",
            "sourceCode": "var raw = $context.$nodes.SEARCH_ACCOUNT.$output;\nvar account = null;\nif (Array.isArray(raw)) { account = raw[0]; }\nelse if (Array.isArray(raw?.items)) { account = raw.items[0]; }\nelse if (raw && typeof raw === \"object\") { account = raw; }\nvar list = account?.ListOfContacts || account?.Contacts || account?.contacts || [];\nif (!Array.isArray(list)) { list = list.items || []; }\nvar nums = [];\nfor (var i = 0; i < list.length; i++) {\n  var c = list[i];\n  var n = c?.SubjectId?.PartyNumber || c?.PartyNumber || c?.ContactPartyNumber;\n  if (n) { nums.push(String(n)); }\n}\nvar values = nums.length ? \"'\" + nums.join(\"','\") + \"'\" : \"'__NO_CONTACT__'\";\nvar q = \"{'op':'$and','criteria':[{'op':'$in','attribute':'PartyNumber','values':[\" + values + \"]}]}\";\nreturn {account: account || {}, contactPartyNumbers: nums, hasContacts: nums.length > 0, contactQuery: q};"
          },
          "outcomes": {
            "success": "1778267608900",
            "failure": ""
          },
          "code": "EXTRACT_ACCOUNT_CONTACTS",
          "id": "1779100000004",
