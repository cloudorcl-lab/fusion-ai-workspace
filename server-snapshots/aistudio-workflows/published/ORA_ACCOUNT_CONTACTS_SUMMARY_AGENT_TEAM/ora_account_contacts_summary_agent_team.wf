          "metadata": {
            "name": "Build Account Query",
            "returnType": "string",
            "sourceCode": "let partyNumber = $context.$variables.accountNumber;\nlet partyNumberValue = partyNumber == null ? \"\" : String(partyNumber);\n\nlet q = {\n  op: '$eq',\n  attribute: 'PartyNumber',\n  value: partyNumberValue\n};\n\nlet qStr = JSON.stringify(q);\nreturn qStr;"
          },
          "outcomes": {
            "success": "1779100000003"
          },
          "code": "BUILD_ACCOUNT_QUERY",
          "id": "1778270372219",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
