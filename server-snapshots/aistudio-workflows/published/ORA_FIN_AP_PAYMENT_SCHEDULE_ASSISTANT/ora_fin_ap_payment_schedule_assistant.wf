{
  "workflowId": "300000327004567",
  "workflowCode": "ORA_FIN_AP_PAYMENT_SCHEDULE_ASSISTANT",
  "name": "Payment Schedule Assistant",
  "description": "Assists payables specialists in scheduling and submitting payment process requests. This assistant validates payment templates, identifies schedule types—such as one-time or recurring—and submits finalized schedules for processing. While it facilitates the scheduling workflow, it does not modify existing payment templates or perform submission of the payment process requests with user entered parameters.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
