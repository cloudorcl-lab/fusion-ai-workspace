          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START",
          "diagram": {
            "x": 7275.25,
            "y": 5000
          }
        },
        {
          "metadata": {
            "name": "If Handoff Ready"
          },
          "outcomes": {
