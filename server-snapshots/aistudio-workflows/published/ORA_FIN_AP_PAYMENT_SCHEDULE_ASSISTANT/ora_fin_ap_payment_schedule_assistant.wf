        {
          "id": "1784112657533",
          "code": "FIN_AP_CODE_ENCODE_TEMPLATE_NAME",
          "type": "CODE",
          "metadata": {
            "name": "Encode Template Name",
            "returnType": "string",
            "sourceCode": "const inputValue = $context.$nodes.FIN_AP_CODE_GET_PPR_TEMPLATE.$output.result.name;\nlet rawTemplateName = \"\";\n\nif (inputValue !== null && inputValue !== undefined) {\n  rawTemplateName = \"\" + inputValue;\n}\n\nlet odataSafeTemplateName = \"\";\nlet i = 0;\n\nwhile (i < rawTemplateName.length) {\n  if (rawTemplateName.charAt(i) === \"'\") {\n    odataSafeTemplateName += \"''\";\n  } else {\n    odataSafeTemplateName += rawTemplateName.charAt(i);\n  }\n  i += 1;\n}\n\nconst hexChars = \"0123456789ABCDEF\";\nlet encodedTemplateName = \"\";\ni = 0;\n\nwhile (i < odataSafeTemplateName.length) {\n  let codeUnit = odataSafeTemplateName.charCodeAt(i);\n\n  if (codeUnit >= 55296 && codeUnit <= 56319 && i + 1 < odataSafeTemplateName.length) {\n    const nextCodeUnit = odataSafeTemplateName.charCodeAt(i + 1);\n\n    if (nextCodeUnit >= 56320 && nextCodeUnit <= 57343) {\n      const codePoint =\n        65536 +\n        ((codeUnit - 55296) * 1024) +\n        (nextCodeUnit - 56320);\n\n      let byte1 = 240 | (codePoint >> 18);\n      let byte2 = 128 | ((codePoint >> 12) & 63);\n      let byte3 = 128 | ((codePoint >> 6) & 63);\n      let byte4 = 128 | (codePoint & 63);\n\n      encodedTemplateName += \"%\" + hexChars.charAt((byte1 >> 4) & 15) + hexChars.charAt(byte1 & 15);\n      encodedTemplateName += \"%\" + hexChars.charAt((byte2 >> 4) & 15) + hexChars.charAt(byte2 & 15);\n      encodedTemplateName += \"%\" + hexChars.charAt((byte3 >> 4) & 15) + hexChars.charAt(byte3 & 15);\n      encodedTemplateName += \"%\" + hexChars.charAt((byte4 >> 4) & 15) + hexChars.charAt(byte4 & 15);\n\n      i += 2;\n      continue;\n    }\n  }\n\n  if (codeUnit >= 55296 && codeUnit <= 57343) {\n    codeUnit = 65533;\n  }\n\n  if (\n    (codeUnit >= 65 && codeUnit <= 90) ||\n    (codeUnit >= 97 && codeUnit <= 122) ||\n    (codeUnit >= 48 && codeUnit <= 57) ||\n    codeUnit === 45 ||\n    codeUnit === 46 ||\n    codeUnit === 95 ||\n    codeUnit === 126\n  ) {\n    encodedTemplateName += odataSafeTemplateName.charAt(i);\n  } else if (codeUnit <= 127) {\n    encodedTemplateName += \"%\" + hexChars.charAt((codeUnit >> 4) & 15) + hexChars.charAt(codeUnit & 15);\n  } else if (codeUnit <= 2047) {\n    let byte1 = 192 | (codeUnit >> 6);\n    let byte2 = 128 | (codeUnit & 63);\n\n    encodedTemplateName += \"%\" + hexChars.charAt((byte1 >> 4) & 15) + hexChars.charAt(byte1 & 15);\n    encodedTemplateName += \"%\" + hexChars.charAt((byte2 >> 4) & 15) + hexChars.charAt(byte2 & 15);\n  } else {\n    let byte1 = 224 | (codeUnit >> 12);\n    let byte2 = 128 | ((codeUnit >> 6) & 63);\n    let byte3 = 128 | (codeUnit & 63);\n\n    encodedTemplateName += \"%\" + hexChars.charAt((byte1 >> 4) & 15) + hexChars.charAt(byte1 & 15);\n    encodedTemplateName += \"%\" + hexChars.charAt((byte2 >> 4) & 15) + hexChars.charAt(byte2 & 15);\n    encodedTemplateName += \"%\" + hexChars.charAt((byte3 >> 4) & 15) + hexChars.charAt(byte3 & 15);\n  }\n\n  i += 1;\n}\n\nreturn encodedTemplateName;"
          },
          "diagram": {
