          "metadata": {
            "name": "NER for PPR Template Parser",
            "returnType": "array",
            "sourceCode": "const response = $context.$nodes.FIN_AP_WORKFLOW_NER_FOR_PPR_TEMPLATE.$output;\nlet result = null;\n\nif (response && typeof response.output === 'string') {\n  const outputStr = response.output.trim();\n  try {\n    const parsed = JSON.parse(outputStr);\n    if (parsed && typeof parsed === 'object' && Array.isArray(parsed.result)) {\n      result = parsed.result;\n    } else {\n      result = parsed;\n    }\n  } catch (e) {\n    result = outputStr;\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768431018610"
          },
