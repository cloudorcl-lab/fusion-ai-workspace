            "sourceCode": "const currentInput = $context.$system.$inputMessage;\n\nconst previousAllUserInput =\n  $context.$variables.allUserInput ?? \"\";\n\nconst allUserInput =\n  previousAllUserInput\n    ? previousAllUserInput + \"\\n\" + currentInput\n    : currentInput;\n\nreturn allUserInput;"
