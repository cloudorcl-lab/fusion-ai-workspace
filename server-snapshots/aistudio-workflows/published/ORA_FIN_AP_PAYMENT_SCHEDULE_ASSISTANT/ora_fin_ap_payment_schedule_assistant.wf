        {
          "metadata": {
            "name": "Format PPR Schedule Payload",
            "returnType": "object",
            "sourceCode": "const scheduleType = $context.$variables.scheduleType; \nconst startTime = $context.$variables.startTime;\nconst endTime = $context.$variables.endTime;\nconst frequency = $context.$variables.frequency;\nconst submitReport = $context.$variables.submitReport;\nconst templateId = $context.$variables.templateId;\n\nlet payload = null;\n\nif (scheduleType === \"oneTimePprScheduleRequest\") {\n  payload = `{\n        \"description\": \"Initiate Payment Process Requests\",\n        \"jobDefinitionId\": \"JobDefinition://oracle/apps/ess/financials/payables/payments/AutoSelect\",\n        \"application\": \"FscmEss\",\n        \"requestParameters\": [\n            {\n                \"name\": \"submit.argument1\",\n                \"paramType\": \"STRING\",\n                \"value\": \"\"\n            },\n            {\n                \"name\": \"submit.argument2\",\n                \"paramType\": \"STRING\",\n                \"value\": \"${templateId}\"\n            },\n            {\n                \"name\": \"submit.argument3\",\n                \"paramType\": \"STRING\",\n                \"value\": \"${submitReport}\"\n            }\n        ],\n        \"startTime\": \"${startTime}\"\n    }`;\n} else if (scheduleType === \"recurringPprScheduleRequest\") {\n  payload = `\n        {\n            \"description\": \"Initiate Payment Process Requests\",\n            \"jobDefinitionId\": \"JobDefinition://oracle/apps/ess/financials/payables/payments/AutoSelect\",\n            \"application\": \"FscmEss\",\n            \"requestParameters\": [\n                {\n                    \"name\": \"submit.argument1\",\n                    \"paramType\": \"STRING\",\n                    \"value\": \"\"\n                },\n                {\n                    \"name\": \"submit.argument2\",\n                    \"paramType\": \"STRING\",\n                    \"value\": \"${templateId}\"\n                },\n                {\n                    \"name\": \"submit.argument3\",\n                    \"paramType\": \"STRING\",\n                    \"value\": \"${submitReport}\"\n                }\n            ],\n            \"schedule\": {\n                \"recurrences\": [\n                    {\n                        \"icalString\": \"${frequency}\"\n                    }\n                ]\n            },\n            \"startTime\": \"${startTime}\",\n            \"endTime\": \"${endTime}\"\n        }\n    `;\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1768434932564"
          },
          "code": "FIN_AP_CODE_FORMAT_PPR_SCHEDULE_PAYLOAD",
