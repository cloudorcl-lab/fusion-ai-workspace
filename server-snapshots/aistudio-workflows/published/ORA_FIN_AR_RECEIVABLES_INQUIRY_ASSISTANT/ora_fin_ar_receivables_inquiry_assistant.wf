            "returnType": "object",
            "sourceCode": "try{\n  let value=$context.$nodes.DISPLAY_FORMATTER.$output.output;\n  while(typeof value==='string')value=JSON.parse(value);\n  let result=value&&typeof value==='object'&&value.result?value.result:value;\n  let cleaned=JSON.parse(JSON.stringify(result).replace(/\\{date:(\\d{4}-\\d{2}-\\d{2})\\}/g,'$1'));\n  let target=cleaned&&Array.isArray(cleaned.agent_response)?cleaned:(cleaned&&cleaned.result&&Array.isArray(cleaned.result.agent_response)?cleaned.result:null);\n  let a=target?target.agent_response:[],out=[];\n  function num(n){let v=Number(String(n).replace(/,/g,'').replace(/[^0-9.\\-]/g,''));return Number.isFinite(v)?v:null}\n  function round(v,p){v=Number(v);if(!Number.isFinite(v))return null;p=p==null?2:p;let m=Math.pow(10,p);return Math.round((v+Number.EPSILON)*m)/m}\n  function fmtExact(c,n){let v=round(num(n),2);if(v==null||!c||c==='ANY'||c==='XXX')return '';return c+' '+v.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2})}\n  function fmtCompact(c,n,suf){let v=num(n);if(v==null||!c||c==='ANY'||c==='XXX')return '';if(suf){let d0=Math.abs(v)>=100?0:(Math.abs(v)>=10?1:2),rv=round(v,d0);return c+' '+rv.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:d0})+suf}let a=Math.abs(v),y=v,s='';if(a>=1000000000){y=v/1000000000;s='B'}else if(a>=1000000){y=v/1000000;s='M'}else if(a>=1000){y=v/1000;s='K'}else return fmtExact(c,v);let d=Math.abs(y)>=100?0:(Math.abs(y)>=10?1:2),ry=round(y,d);return c+' '+ry.toLocaleString('en-US',{minimumFractionDigits:0,maximumFractionDigits:d})+s}\n  function cleanText(s,compact){let x=String(s||'');x=x.replace(/\\{\\s*amount\\s*:\\s*([^,{}]+?)\\s*,\\s*currency\\s*:\\s*([A-Z]{3})\\s*\\}/g,function(_,n,c){return (c==='ANY'||c==='XXX')?'':(compact?fmtCompact(c,n):fmtExact(c,n))});x=x.replace(/[$€£]/g,'').replace(/\\b(?:ANY|XXX)\\s*-?[0-9][0-9,]*(?:\\.\\d+)?[KMB]?\\b/gi,'').replace(/\\b-?[0-9][0-9,]*(?:\\.\\d+)?[KMB]?\\s*(?:ANY|XXX)\\b/gi,'').replace(/\\b(ANY|XXX)\\b/gi,'').replace(/\\b([0-9][0-9,]*(?:\\.\\d+)?)\\s*([A-Z]{3})([KMB])\\b/g,'$2 $1$3');x=x.replace(/\\b([A-Z]{3})\\s*(-?[0-9][0-9,]*(?:\\.\\d+)?)([KMB])\\b/g,function(_,c,n,suf){return fmtCompact(c,n,suf)});x=x.replace(/\\b([A-Z]{3})\\s+(-?[0-9]{4,}(?:\\.\\d+)?)\\b/g,function(_,c,n){return compact?fmtCompact(c,n):fmtExact(c,n)});x=x.replace(/\\b([A-Z]{3})\\s+(-?[0-9][0-9,]*\\.\\d{3,})\\b/g,function(_,c,n){return compact?fmtCompact(c,n):fmtExact(c,n)});x=x.replace(/\\b([A-Z]{3})\\s+(-?(?:[0-9]{1,3}(?:,[0-9]{3})+|[0-9]+)(?:\\.\\d+)?)\\b(?![0-9,KMB]|\\.\\d)/g,function(_,c,n){return compact?fmtCompact(c,n):fmtExact(c,n)});return x.replace(/\\s+(and|or)\\s*$/i,'').replace(/\\s{2,}/g,' ').trim()}\n  function moneyKey(k){return /amount|balance|price|credit|debit|charge|tax|total|remaining|original|accounted|applied|unearned|earned|lineamount|extended|gross/i.test(String(k||''))&&!/rate|percent|number|id|code|status|class|date|name|description|reference|reason|type/i.test(String(k||''))}function fieldListMoney(o){let f=String(o.FIELD||o.field||'');return /amount|balance|price|credit|debit|charge|tax|total|remaining|original|accounted|applied|unearned|earned|extended|gross/i.test(f)&&!/rate|percent|number|id|code|status|class|date|name|description|reference|reason|type/i.test(f)}function cleanMoneyObject(o){if(Array.isArray(o)){for(let z=0;z<o.length;z++)cleanMoneyObject(o[z]);return}if(o&&typeof o==='object'){let fl=fieldListMoney(o);for(let k of Object.keys(o)){if(typeof o[k]==='string'){if(fl&&/^(VALUE|value)$/.test(k))o[k]=cleanText(o[k],false);else if(moneyKey(k))o[k]=cleanText(o[k],false)}else cleanMoneyObject(o[k])}}}\n  for(let i=0;i<a.length;i++){\n    let b=a[i];if(!b)continue;\n    let h=String(b.heading||'').toLowerCase();\n    if(b.display_type==='text'&&b.text){b.text=cleanText(b.text,h==='summary')}\n    if(b.display_type==='table'){cleanMoneyObject(b.rows);cleanMoneyObject(b.artifact)}\n    if(b.display_type==='scoreboard'||b.display_type==='metric'||b.display_type==='card'){cleanMoneyObject(b)}\n    if(b.display_type==='action'){let items=[];if(Array.isArray(b.actions))items=b.actions;else if(b.actions&&Array.isArray(b.actions.items))items=b.actions.items;else if(Array.isArray(b.recommendations))items=b.recommendations;else if(b.recommendations&&Array.isArray(b.recommendations.items))items=b.recommendations.items;items=items.map(function(x){return String(x||'').replace(/^[-•]\\s*/,'').trim()}).filter(Boolean);b={display_type:'text',text:items.length?('Suggested Next Steps\\n'+items.map(function(x){return '- '+x}).join('\\n')):'Suggested Next Steps'}}\n    delete b.heading;delete b.title;delete b.header;\n    b.display_sequence=out.length+1;out.push(b)\n  }\n  let next=[],main=[];for(let q=0;q<out.length;q++){let z=out[q],txt=String(z&&z.text||'');if(z&&z.display_type==='text'&&/^Suggested Next Steps/i.test(txt))next.push(z);else main.push(z)}out=main.concat(next);for(let q=0;q<out.length;q++)out[q].display_sequence=q+1;\n  if(target)target.agent_response=out;\n  return cleaned\n}catch(error){return{status:'error',message:error&&error.message?error.message:'Unable to parse formatter output'}}"
          },
