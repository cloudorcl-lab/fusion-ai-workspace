            {
              "id": "1770000001001_3",
              "name": "billingAttributeCatalog",
              "scope": "JOB",
              "type": "object",
              "value": "{\"invoiceDetail\":{\"catalogName\":\"invoiceDetail\",\"catalogVersion\":\"rich-attribute-catalog-v2\",\"intent\":\"LOCATE_INVOICE_BY_REFERENCE\",\"queryName\":\"invoiceDetail\",\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransactionLine\",\"view\":\"receivablesTransactionDetail\",\"description\":\"Attributes used to locate receivables invoices from source references, order references, purchase orders, document numbers, customer names, or bill-to accounts.\",\"primaryBusinessQuestion\":\"Which Receivables invoice corresponds to this order, PO, reference, document, customer, or account?\",\"grain\":\"Receivables transaction line. Multiple rows can represent one invoice, so responses should deduplicate by customerTransactionId or invoiceNumber for header-level questions.\",\"filterStrategy\":\"Use exact matching for invoice, order, PO, document, account, and internal IDs. Use contains matching for customer name because users commonly provide partial customer names.\",\"filters\":{\"invoiceNumber\":\"invoiceNumber\",\"salesOrderNumber\":\"salesOrderNumber\",\"poNumber\":\"poNumber\",\"customerReference\":\"customerReference\",\"documentNumber\":\"documentNumber\",\"customerTransactionId\":\"customerTransactionId\",\"customerName\":\"billToCustomerName\",\"accountNumber\":\"billToAccountNumber\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Use invoiceNumber when the user provides invoiceNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"salesOrderNumber\",\"queryField\":\"salesOrderNumber\",\"description\":\"Use salesOrderNumber when the user provides salesOrderNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"poNumber\",\"queryField\":\"poNumber\",\"description\":\"Use poNumber when the user provides poNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerReference\",\"queryField\":\"customerReference\",\"description\":\"Use customerReference when the user provides customerReference.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"documentNumber\",\"queryField\":\"documentNumber\",\"description\":\"Use documentNumber when the user provides documentNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Use customerTransactionId when the user provides customerTransactionId.\",\"dataType\":\"Integer\",\"matchStrategy\":\"exact\",\"supportedOperators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"]},{\"anchor\":\"customerName\",\"queryField\":\"billToCustomerName\",\"description\":\"Use billToCustomerName when the user provides customerName.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"=\",\"LIKE\",\"IN\"]},{\"anchor\":\"accountNumber\",\"queryField\":\"billToAccountNumber\",\"description\":\"Use billToAccountNumber when the user provides accountNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]}],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"transactionStatus\",\"salesOrderNumber\",\"poNumber\",\"customerReference\",\"documentNumber\",\"billToCustomerName\",\"billToAccountNumber\"],\"identityAttributes\":[\"customerTransactionLineId\",\"customerTransactionId\",\"invoiceNumber\",\"documentNumber\"],\"customerAttributes\":[\"billToCustomerName\",\"billToAccountNumber\",\"billToCustomerAccountId\",\"shipToAccountName\",\"shipToAccountNumber\",\"shipToCustomerAccountId\",\"shipToCustomerName\",\"shipToCustomerId\",\"shipToCustomerRegistryId\"],\"referenceAttributes\":[\"salesOrderNumber\",\"salesOrderLine\",\"poNumber\",\"customerReference\"],\"dateAttributes\":[\"transactionDate\"],\"amountAttributes\":[],\"statusAttributes\":[\"transactionStatus\"],\"attributes\":[{\"attributeName\":\"customerTransactionLineId\",\"queryField\":\"customerTransactionLineId\",\"description\":\"Internal identifier for a Receivables transaction line.\",\"businessMeaning\":\"Line-level key for preserving or debugging the exact invoice line row returned by the extract.\",\"dataType\":\"Integer\",\"category\":\"Line Identity\",\"semanticRole\":\"lineKey\",\"synonyms\":[\"transaction line id\",\"invoice line id\",\"customer transaction line id\",\"customerTransactionLineId\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[],\"format\":\"integer\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransactionLineId\",\"tablePriority\":null},{\"attributeName\":\"lineNumber\",\"queryField\":\"lineNumber\",\"description\":\"Invoice line sequence number.\",\"businessMeaning\":\"Line ordering field used to display invoice charges in the same logical sequence as the transaction.\",\"dataType\":\"Number\",\"category\":\"Line Detail\",\"semanticRole\":\"lineSequence\",\"synonyms\":[\"line number\",\"invoice line number\",\"line sequence\",\"lineNumber\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[],\"format\":\"number\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"lineNumber\",\"tablePriority\":null},{\"att