ld\":\"discountDueMonthsAhead\",\"description\":\"Payment-term discount rule attribute: discountDueMonthsAhead\",\"businessMeaning\":\"Supports invoice payment-term line and discount-tier responses.\",\"dataType\":\"Number\",\"category\":\"Payment Term Discounts\",\"semanticRole\":\"detail\",\"synonyms\":[\"discountDueMonthsAhead\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"number\",\"summaryBehavior\":\"Use when explaining invoice payment-term lines and discount tiers.\",\"nullHandling\":\"If null or blank, omit from prose unless the user explicitly asks for this field.\",\"sourcePath\":\"discountDueMonthsAhead\",\"tablePriority\":28},{\"attributeName\":\"setId\",\"queryField\":\"setId\",\"description\":\"Payment-term discount rule attribute: setId\",\"businessMeaning\":\"Supports invoice payment-term line and discount-tier responses.\",\"dataType\":\"String\",\"category\":\"Payment Term Discounts\",\"semanticRole\":\"detail\",\"synonyms\":[\"setId\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use when explaining invoice payment-term lines and discount tiers.\",\"nullHandling\":\"If null or blank, omit from prose unless the user explicitly asks for this field.\",\"sourcePath\":\"setId\",\"tablePriority\":29}],\"ruleAttributes\":[\"termLineDueDays\",\"discountPercent\",\"discountDueDays\",\"accountDiscountGraceDays\",\"siteDiscountGraceDays\"]},\"creditMemoTransaction\":{\"catalogName\":\"creditMemoTransaction\",\"catalogVersion\":\"rich-attribute-catalog-v2\",\"intent\":\"CHECK_CREDIT_MEMO_ISSUED\",\"queryName\":\"creditMemoTransaction\",\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransactionLine\",\"view\":\"receivablesTransactionDetail\",\"description\":\"Attributes used to check standard and on-account credit memo transactions from Receivables transaction detail.\",\"primaryBusinessQuestion\":\"Was a credit memo issued for this invoice/customer, and is it standard or on-account?\",\"grain\":\"Receivables transaction line for credit memo transactions. A credit memo can return multiple line rows; summarize or deduplicate by creditMemoCustomerTransactionId/creditMemoNumber and use lineAmount for displayed amount.\",\"filterStrategy\":\"Use previousTransactionNumber when the user asks for a credit memo against an invoice. Use creditMemoNumber for a known credit memo. Use customer/account filters for on-account credit memos.\",\"filters\":{\"invoiceNumber\":\"previousTransactionNumber\",\"creditMemoNumber\":\"creditMemoNumber\",\"customerName\":\"billToCustomerName\",\"accountNumber\":\"billToAccountNumber\",\"customerTransactionId\":\"creditMemoCustomerTransactionId\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"previousTransactionNumber\",\"description\":\"Use previousTransactionNumber when the user asks whether a standard credit memo was issued against an invoice.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"creditMemoNumber\",\"queryField\":\"creditMemoNumber\",\"description\":\"Use creditMemoNumber when the user supplies a specific credit memo number.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerName\",\"queryField\":\"billToCustomerName\",\"description\":\"Use billToCustomerName for customer-scoped credit memo lookup, especially on-account credit memos.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"=\",\"LIKE\",\"IN\"]},{\"anchor\":\"accountNumber\",\"queryField\":\"billToAccountNumber\",\"description\":\"Use billToAccountNumber for account-scoped credit memo lookup.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]}],\"displayAttributes\":[\"creditMemoNumber\",\"creditMemoDate\",\"transactionClass\",\"previousTransactionNumber\",\"previousCustomerTransactionId\",\"lineAmount\",\"creditMemoAmount\",\"currencyCode\",\"billToCustomerName\",\"billToAccountNumber\",\"transactionStatus\",\"creditMemoReason\"],\"identityAttributes\":[\"creditMemoCustomerTransactionId\",\"creditMemoNumber\"],\"customerAttributes\":[\"billToCustomerName\",\"billToAccountNumber\"],\"referenceAttributes\":[\"previousTransactionNumber\",\"previousCustomerTransactionId\"],\"dateAttributes\":[\"creditMemoDate\"],\"amountAttributes\":[\"lineAmount\",\"creditMemoAmount\"],\"statusAttributes\":[\"transactionClass\",\"transactionStatus\"],\"semanticFilters\":{\"STANDARD\":{\"description\":\"Standard credit memos created against a previous/original invoice.\",\"predicates\":[\"transactionClass = 'CM'\",\"previousTransactionNumber IS NOT NULL\"],\"matchPatterns\":[\"standard credit memo\",\"against invoice\",\"for invoice\",\"issued against\"]},\"ON_ACCOUNT\":{\"description\":\"On-account credit memos that are not tied to a previous invoice.\",\"predicates\":[\"transactionClass = 'ONACC'\"],\"matchPatterns\":[\"on account\",\"on-account\",\"open credit\",\"outstanding credit\"]}},\"attributes\":[{\"attributeName\":\"creditMemoCustomerTransactionId\",\"queryField\":\"creditMemoCustomerTransactionId\",\"description\":\"Internal transaction id of the credit memo.\",\"businessMeaning\":\"Internal transaction id of the credit memo.\",\"dataType\":\"Number\",\"category\":\"Credit Memo\",\"semanticRole\":\"primaryKey\",\"synonyms\":[\"creditMemoCustomerTransactionId\"],\"filterAnchors\":[\"customerTransactionId\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"],\"format\":\"number\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If n