eHasTaxRows?gross:(ext!=null?(ext+(lineHasTaxRows?0:(taxAmount||0))):null));o.taxAmount=taxAmount==null?'':taxAmount;o.lineTotal=lineTotal==null?'':lineTotal}var hasCurrencyColumn=false;for(var ck in o){if(/currency/i.test(ck)){hasCurrencyColumn=true;break}}if(C.length&&cc){if(!hasCurrencyColumn)o.currencyCode=cc;else{var filledCurrencyColumn=false;for(var ckk in o){if(/currency/i.test(ckk)&&!o[ckk]){o[ckk]=cc;filledCurrencyColumn=true;break}}}}if(P.shapeKey==='invoiceDelivery'||P.intent==='INVESTIGATE_INVOICE_DELIVERY')o.deliveryStatus=deliveryStatus(r);if(C.length)o=formatMoneyRow(o,cc);detailRows.push(C.length?o:formatMoneyRow(r,cc));if(taxIntent){taxable=H.num(H.val(r,'taxableAmount'));ext=H.num(H.val(r,'extendedAmount'));if(taxable!=null&&cc){var tk=[cc,H.val(r,'customerTransactionTransactionNumber')||H.val(r,'transactionNumber')||'',H.val(r,'lineNumber')||'',H.val(r,'taxRate')||'',taxable].join('|');if(!taxableSeen[tk]){taxableSeen[tk]=1;H.add(totals,'taxableAmount',cc,taxable)}}if(taxAmtRow)H.add(totals,'taxAmount',cc,ext)}else if(lineIntent){lineType=String(H.val(r,'lineType')||'').toUpperCase();isTaxLine=/TAX/.test(lineType);ext=H.num(H.val(r,'extendedAmount'));if(isTaxLine){H.add(totals,'taxAmount',cc,ext)}else{H.add(totals,'netLineAmount',cc,ext);if(!lineHasTaxRows)H.add(totals,'taxAmount',cc,H.num(o.taxAmount))}}else if(deferredIntent){lineType=String(H.val(r,'accountClass')||'').toUpperCase();ext=H.num(H.val(r,'amount'));var acctAmt=H.num(H.val(r,'accountedAmount'));if(lineType==='UNEARN'){H.add(totals,'deferredRevenueAmount',cc,ext);H.add(totals,'deferredAccountedAmount',cc,acctAmt)}else if(lineType==='REV'){H.add(totals,'recognizedRevenueAmount',cc,ext);H.add(totals,'recognizedAccountedAmount',cc,acctAmt)}}else{for(j=0;j<C.length;j++){k=C[j];v=o[k];if(H.moneyField(k))H.add(totals,k,cc,H.num(v))}}}\nif(taxIntent){var ccy,base,tax;for(ccy in (totals.taxableAmount||{})){base=totals.taxableAmount[ccy]||0;tax=(totals.taxAmount||{})[ccy]||0;if(base||tax)H.add(totals,'invoiceTotal',ccy,base+tax)}}\nif(lineIntent){var lccy,net,lineTax,netBucket=totals.netLineAmount||{},taxBucket=totals.taxAmount||{};for(lccy in netBucket){net=netBucket[lccy]||0;lineTax=taxBucket[lccy]||0;if(net||lineTax)H.add(totals,'invoiceTotal',lccy,net+lineTax)}for(lccy in taxBucket){if(!Object.prototype.hasOwnProperty.call(netBucket,lccy)&&taxBucket[lccy])H.add(totals,'invoiceTotal',lccy,taxBucket[lccy])}}\nvar displayMode='DETAIL',rows=detailRows,fieldRows=[];\nif(P.outOfScope||P.missingMessage)displayMode='TEXT_ONLY';else if(!detailRows.length)displayMode='NO_DATA';else if(listView&&detailRows.length>rollupThreshold){displayMode='ROLLUP';rows=ROLL.build(full.length?full:detailRows);artifactRows=detailRows}else if(!listView&&detailRows.length===1){displayMode='FIELD_LIST';fieldRows=buildFieldRows(detailRows[0]);rows=fieldRows.length?fieldRows:detailRows}else displayMode='DETAIL';\nif(displayMode==='ROLLUP'){rows=collapseRollup(rows);for(i=0;i<rows.length;i++)rows[i]=formatMoneyRow(rows[i],rows[i]&&rows[i].currencyCode)}\nreturn finalize(displayMode,rows,detailRows.length,raw.length);"
