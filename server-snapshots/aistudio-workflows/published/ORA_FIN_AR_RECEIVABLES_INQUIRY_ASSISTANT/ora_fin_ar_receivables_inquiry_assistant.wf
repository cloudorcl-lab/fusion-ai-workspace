s Billing inquiries only.';rec='Ask a read-only Billing inquiry question with an invoice, order, PO, customer, account, business unit, or document reference.'}\nelse if(P.missingMessage){ttl=(P.normalizedContext&&P.normalizedContext.clarificationReason)==='AMBIGUOUS_REFERENCE'?'Clarification Needed':'More Information Needed';ans=P.missingMessage;rec='Provide the requested Billing reference and rerun the lookup.'}\nelse if(!(T.rowCount||0)){var invRef=iv||(NC&&NC.invoiceNumber)||'',shapeName=String(P.shapeKey||P.queryName||'Billing data').replace(/([a-z])([A-Z])/g,'$1 $2').replace(/^receivables\\s+/i,'').replace(/^invoice\\s+/i,'invoice ').toLowerCase();if((P.intent==='LOCATE_INVOICE_BY_REFERENCE'||P.shapeKey==='invoiceDetail')&&invRef){ttl='Invoice Not Found';ans='Invoice '+invRef+' was not found in Receivables Billing.';rec='Check the invoice number, sales order, PO, document number, customer, account, or business unit and try the lookup again.'}else if(invRef){ttl='No Matching Billing Data';ans='No '+shapeName+' records were found for invoice '+invRef+'. This does not confirm whether the invoice exists.';if(scope&&ans.indexOf(scope)<0)ans+=' Applied scope: '+scope+'.';rec='Run invoice lookup for invoice '+invRef+' to confirm whether the invoice exists, or try a different Billing reference.'}else{ttl='No Matching Billing Data';ans=(T.noDataMessage||'No matching Billing data was found for the supplied reference.').replace(/\\.$/,'')+(scope?' for '+scope:'')+'.';rec='Try a different invoice, order, PO, customer, account, business unit, or document reference.'}if(date&&ans.indexOf(date)<0)ans+=' The applied date range was '+date+'.'}\nelse if(P.intent==='REVIEW_INVOICE_TAX_CHARGES'){ttl=vm==='TAX_EXEMPTION_REVIEW'?'Tax Exemption Review':'Invoice Tax Details';ans='Invoice '+(iv||'not available')+' has '+(T.rowCount||0)+' tax detail line(s). '+(ct||T.totalsText||'')+'. System records show the returned tax and exemption fields only; no tax-determination cause is inferred from this response.';rec='Review the tax records, then check invoice line charges or payment status if more Billing context is needed.'}\nelse if(P.intent==='REVIEW_INVOICE_LINE_CHARGES'){ttl='Invoice Line Charges';ans='Invoice '+(iv||'not available')+' has '+(T.rowCount||0)+' line charge record(s). '+(ct||T.totalsText||'')+'.';rec='Review tax details, payment status, or document-copy metadata for this invoice.'}\nelse if(P.intent==='REVIEW_CUSTOMER_TOTAL_OUTSTANDING_BALANCE'){ttl='Customer Outstanding Balance';var scopeBal=(P.normalizedContext&&(P.normalizedContext.customerName||P.normalizedContext.accountName||P.normalizedContext.accountNumber||P.normalizedContext.businessUnitName))||R.customerName||R.accountName||R.accountNumber||F.customerName||F.accountName||F.accountNumber||'The selected customer/account';ans=scopeBal+' returned '+(T.rowCount||0)+' aggregate receivables balance record(s). '+(ct||T.totalsText||'')+'. Amounts are grouped by currency and are not individual invoice records.';rec='Use open invoice details to see contributing invoices, or review disputes for the same customer/account.'}\nelse if(P.intent==='CHECK_INVOICE_PAYMENT_BALANCE'||P.intent==='CHECK_INVOICE_DUE_DATE_PAYMENT_TERMS'){ttl=vm==='CUSTOMER_OPEN_INVOICES'?'Customer Open Invoices':(vm==='CUSTOMER_INVOICE_HISTORY'?'Customer Invoice History':(P.intent==='CHECK_INVOICE_DUE_DATE_PAYMENT_TERMS'?'Invoice Due Date and Terms':'Invoice Payment and Balance'));var scope=(P.normalizedContext&&(P.normalizedContext.customerName||P.normalizedContext.accountName||P.normalizedContext.accountNumber||P.normalizedContext.businessUnitName))||R.customerName||R.accountName||F.customerName||F.accountName||iv||'The selected Billing reference';ans=(iv&&vm!=='CUSTOMER_OPEN_INVOICES'&&vm!=='CUSTOMER_INVOICE_HISTORY'?'Invoice '+iv:scope)+' returned '+(T.rowCount||0)+' payment schedule record(s). '+(ct||T.totalsText||'')+(date?' Date range: '+date+'.':'.');rec='Review the payment schedule records and use the next step for charges, credit memos, or adjustments.'}\nelse if(P.intent==='INVESTIGATE_INVOICE_DELIVERY'){ttl='Invoice Print/Header Status';ans='Invoice '+(iv||'not available')+' print/header status is shown below. Delivery method, retry count, and failure reason are not recorded in the current Billing extract.';rec='Use document-copy metadata or payment status if the customer needs a copy or balance follow-up.'}\nelse if(P.intent==='RETRIEVE_INVOICE_DOCUMENT_COPY'){ttl='Invoice Document Lookup';ans='Invoice '+(iv||'not available')+' document-copy metadata was located. This response does not download a PDF or file attachment.';rec='Use the located customer transaction id/document metadata with the attachment or document endpoint when a real file link is required.'}\nelse if(P.intent==='UNDERSTAND_FOREIGN_CURRENCY_CONVERSION'){ttl='Foreign Currency Conversion';ans='Invoice '+(iv||'not available')+' conversion details are shown below. '+(ct||T.totalsText||'')+'.';rec='If conversion date, rate, or rate type is blank, no conversion value is recorded in the returned data.'}\nelse if(P.intent==='REVIEW_DEFERRED_REVENUE_EARNING_SCHEDULE'){ttl='Deferred Revenue and Earning Schedule';ans='Invoice '+(iv||'not available')+' returned '+(T.rowCount||0)+' revenue distribution record(s). '+(ct||T.totalsText||'')+'. System distribution records show account class UNEARN as deferred revenue and REV as recognized revenue; no revenue policy or root-cause inference is made.';rec='Review invoice line charges, FX conversion, or payment status for the same invoice if more Billing context is needed.'}\nelse if(P.intent==='CHECK_SALES_ORDER_FULFILLMENT_LINES'){ttl='Sales Order Fulfillment Lines';ans='The Order Management fulfillment result returned '+(T.rowCount||0)+' fulfillment line record(s). No Receivables invoice is implied by this result.';rec='Use a sales order or PO number for fulfillment details, or run invoice line charges to find related order references.'}\nelse {ttl=S.title||'Billing Inquiry Results';ans=(S.summary&&S.summary.indexOf('ANY')<0)?S.summary:('Found '+(T.rowCount||0)+' Billing record(s). '+(ct||T.totalsText||''));rec=S.recommendation||'Review the returned Billing data and continue with the suggested next step.'}\nfunction userRecordText(s){var x=String(s||\"\");return x.split(\"row(s)\").join(\"record(s)\").split(\"Row(s)\").join(\"Record(s)\").replace(/rows/gi,\"records\").replace(/row/gi,\"record\")}ans=userRecordText(H.clean(ans,true));rec=userRecordText(H.clean(rec,true));return{title:ttl,summary:ans,recommendation:rec};"
