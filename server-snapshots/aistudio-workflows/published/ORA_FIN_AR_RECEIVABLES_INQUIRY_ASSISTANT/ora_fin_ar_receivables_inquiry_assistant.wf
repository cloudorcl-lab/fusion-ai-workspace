tomerTransactionId\",\"customerName\":\"customerName\",\"accountNumber\":\"accountNumber\",\"accountName\":\"accountName\",\"businessUnitName\":\"businessUnitName\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Use invoiceNumber when the user provides invoiceNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Use customerTransactionId when the user provides customerTransactionId.\",\"dataType\":\"Integer\",\"matchStrategy\":\"exact\",\"supportedOperators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"]},{\"anchor\":\"customerName\",\"queryField\":\"customerName\",\"description\":\"Use customerAccount.customer.name when the user provides a customer or customer party name.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"=\",\"LIKE\",\"IN\"]},{\"anchor\":\"accountName\",\"queryField\":\"accountName\",\"description\":\"Use customerAccount.accountName when the user explicitly provides an account name or bill-to account name.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"=\",\"LIKE\",\"IN\"]},{\"anchor\":\"accountNumber\",\"queryField\":\"accountNumber\",\"description\":\"Use accountNumber when the user provides accountNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]}],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"paymentDueDate\",\"transactionHeaderDueDate\",\"installmentStatus\",\"originalAmount\",\"amountApplied\",\"amountRemaining\",\"amountAdjusted\",\"amountCredited\",\"earnedDiscount\",\"unearnedDiscount\",\"currencyCode\",\"customerName\",\"accountName\",\"accountNumber\",\"paymentTermName\",\"overdueFlag\"],\"identityAttributes\":[\"invoiceNumber\",\"customerTransactionId