 transactions. Standard credit memos use transactionClass CM and have previousTransactionNumber populated; on-account credit memos use transactionClass ONACC.\",\"dateFilterField\":\"creditMemoDate\",\"defaultDateWindowDays\":90,\"defaultDateWindowAnchors\":[\"customerName\",\"accountNumber\"]},\"receivablesInvoiceTaxDetail\":{\"viewQueries\":{\"ReceivablesInvoiceTaxDetail\":{\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransactionLine\",\"view\":\"receivablesTransactionDetail\",\"fieldAliases\":{\"customerTransactionLineId\":\"customerTransactionLineId\",\"lineNumber\":\"lineNumber\",\"description\":\"description\",\"extendedAmount\":\"extendedAmount\",\"grossExtendedAmount\":\"grossExtendedAmount\",\"taxableAmount\":\"taxableAmount\",\"taxRate\":\"taxRate\",\"taxExemptionCertificateNumber\":\"taxExemptionCertificateNumber\",\"amountIncludesTax\":\"amountIncludesTax\",\"taxable\":\"taxable\",\"productCategory\":\"productCategory\",\"productFiscalClassification\":\"productFiscalClassification\",\"productType\":\"productType\",\"transactionBusinessCategory\":\"transactionBusinessCategory\",\"userDefinedFiscalClassification\":\"userDefinedFiscalClassification\",\"customerTransaction.transactionNumber\":\"customerTransactionTransactionNumber\",\"customerTransaction.transactionDate\":\"customerTransactionTransactionDate\",\"customerTransaction.billReceivableAmount\":\"customerTransactionBillReceivableAmount\",\"customerTransaction.pONumber\":\"customerTransactionPONumber\",\"customerTransaction.invoiceCurrency.currencyCode\":\"customerTransactionInvoiceCurrencyCurrencyCode\",\"customerTransaction.billToCustomerAccount.accountName\":\"customerTransactionBillToCustomerAccountAccountName\",\"customerTransaction.billToCustomerAccount.accountNumber\":\"customerTransactionBillToCustomerAccountAccountNumber\",\"customerTransaction.taxExempt.meaning\":\"customerTransactionTaxExemptMeaning\",\"customerTransaction.taxExempt.lookupCode\":\"customerTr