            "errorNodeId": "1779832851336",
            "name": "Build Billing Follow Ups",
            "returnType": "object",
            "sourceCode": "return eval(\"let P=$context.$nodes.BUILD_BILLING_EXTRACT.$output.result||{},T=$context.$nodes.PREPARE_BILLING_TABLE.$output.result||{},R=(T.rows||[])[0]||{},F=(T.fullRows||[])[0]||{},c=Object.assign({},P.normalizedContext||{}),A=P.appliedFilters||[],m={},i,f=[],g=[],inv,so,po,isFulfill,pfx;for(i=0;i<A.length;i++)m[A[i].name]=A[i].value;delete c.contextCarryForward;c.invoiceNumber=c.invoiceNumber||F.invoiceNumber||F.transactionNumber||F.customerTransactionTransactionNumber||R.invoiceNumber||R.transactionNumber||R.customerTransactionTransactionNumber||m.invoiceNumber;c.customerTransactionId=c.customerTransactionId||F.customerTransactionId;c.customerName=c.customerName||F.customerName||F.accountName||F.billToCustomerName||m.customerName;c.accountName=c.accountName||F.accountName||R.accountName||m.accountName;c.accountNumber=c.accountNumber||F.accountNumber||F.billToAccountNumber||F.billToCustomerAccountNumber||m.accountNumber;c.businessUnitName=c.businessUnitName||F.businessUnitName||R.businessUnitName||m.businessUnitName;c.salesOrderNumber=c.salesOrderNumber||F.salesOrderSourceOrderNumber||F.salesOrderNumber||R.salesOrderSourceOrderNumber||R.salesOrderNumber||m.salesOrderNumber;c.poNumber=c.poNumber||F.salesOrderCustomerPoNumber||F.poNumber||F.purchaseOrderNumber||R.salesOrderCustomerPoNumber||R.poNumber||R.purchaseOrderNumber||m.poNumber;c.dateRangeText=c.dateRangeText||m.dateRange;let noRows=!(T.rowCount||0)&&!P.missingMessage&&!P.outOfScope,exp=((P.normalizedContext||{}).currentExplicitAnchors||[]),explicitInv=exp.indexOf('invoiceNumber')>=0||exp.indexOf('customerTransactionId')>=0;if(noRows&&(c.invoiceNumber||c.customerTransactionId)&&(explicitInv||P.intent=='LOCATE_INVOICE_BY_REFERENCE'||P.shapeKey=='invoiceDetail')){c.unresolvedInvoiceNumber=c.invoiceNumber||null;c.unresolvedCustomerTransactionId=c.customerTransactionId||null;c.lastNoDataCategory=T.noDataCategory||'NO_MATCHING_DATA';c.invoiceNumber=null;c.customerTransactionId=null}inv=c.invoiceNumber;so=c.salesOrderNumber;po=c.poNumber;isFulfill=P.intent=='CHECK_SALES_ORDER_FULFILLMENT_LINES'||P.shapeKey=='fulfillmentLine';pfx=inv?' for invoice '+inv:'';if(P.outOfScope||P.intent=='OUT_OF_SCOPE_BILLING_REQUEST')g=['Find invoice by sales order','Check payment balance for an invoice','Review invoice line charges'];else if(P.missingMessage)g=['Search by invoice number','Search by sales order number','Search by PO number'];else if(!(T.rowCount||0)){if(isFulfill){if(so)g.push('Try a different sales order number');if(po)g.push('Search by PO '+po);g.push('Search by customer/account')}else{if(so)g.push('Search sales order '+so+' in Order Management');if(po)g.push('Search PO '+po+' in Order Management');g.push('Search by customer/account');if(P.intent!='LOCATE_INVOICE_BY_REFERENCE')g.push('Locate invoice by order/reference')}}else if(isFulfill){if(so)g.push('Locate invoice by sales order '+so);if(po)g.push('Locate invoice by PO '+po);g.push('Search by customer/account')}else if(P.intent=='REVIEW_CUSTOMER_TOTAL_OUTSTANDING_BALANCE')g=['Show open invoice details for this customer','Review disputed invoices for this customer','Check payment status for a specific invoice'];else if(P.intent=='REVIEW_INVOICE_TAX_CHARGES')g=['Review invoice line charges'+pfx,'Check payment status'+pfx,'Retrieve invoice document copy'+pfx];else if(P.intent=='CHECK_DISPUTE_RESOLUTION_STATUS')g=['Show credit memos created from the dispute'+pfx,'Check invoice balance after dispute resolution'+pfx,'Check adjustments'+pfx];else if(P.intent=='CHECK_CREDIT_MEMO_ISSUED'||P.intent=='CHECK_CREDIT_MEMO_APPLICATION')g=['Check invoice balance after credit memo'+pfx,'Review related invoice charges'+pfx,'Check adjustments'+pfx];else if(P.intent=='CHECK_INVOICE_ADJUSTMENTS')g=['Check payment balance'+pfx,'Review invoice line charges'+pfx,'Retrieve invoice document copy'+pfx];else if(P.intent=='RETRIEVE_INVOICE_DOCUMENT_COPY')g=['Check invoice delivery status'+pfx,'Review invoice line charges'+pfx,'Check payment status'+pfx];else if(P.intent=='INVESTIGATE_INVOICE_DELIVERY')g=['Retrieve invoice document copy'+pfx,'Check payment status'+pfx,'Review invoice line charges'+pfx];else if(P.intent=='REVIEW_INVOICE_LINE_CHARGES')g=['Review tax details'+pfx,'Check payment status'+pfx,'Retrieve invoice document copy'+pfx];else if(P.intent=='CHECK_INVOICE_PAYMENT_BALANCE'||P.intent=='CHECK_INVOICE_DUE_DATE_PAYMENT_TERMS'||P.intent=='CHECK_INVOICE_PAYMENT_TERM_DISCOUNTS')g=['Review invoice line charges'+pfx,'Check credit memos'+pfx,'Check adjustments'+pfx];else if(P.intent=='UNDERSTAND_FOREIGN_CURRENCY_CONVERSION')g=['Review invoice line charges'+pfx,'Check payment status'+pfx,'Check adjustments'+pfx];else if(P.intent=='REVIEW_DEFERRED_REVENUE_EARNING_SCHEDULE')g=['Review invoice line charges'+pfx,'Understand foreign currency conversion'+pfx,'Check payment status'+pfx];else g=['Check payment status'+pfx,'Review invoice line charges'+pfx,'Check invoice delivery status'+pfx];for(i=0;i<g.length&&f.length<3;i++)if(g[i]&&f.indexOf(g[i])<0)f.push(g[i]);({followUps:f,contextCarryForward:c})\")"
