"sourcePath\":\"customerAccount.accountNumber\",\"tablePriority\":15},{\"attributeName\":\"accountName\",\"queryField\":\"accountName\",\"description\":\"Customer account display name associated with the payment schedule.\",\"businessMeaning\":\"Bill-to customer account name, distinct from the TCA customer or party name.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"accountName\",\"synonyms\":[\"account name\",\"customer account name\",\"bill-to account name\",\"accountName\"],\"filterAnchors\":[\"accountName\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"LIKE\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerAccount.accountName\",\"tablePriority\":15},{\"attributeName\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Internal Receivables customer transaction identifier for the invoice, debit memo, credit memo, or related transaction.\",\"businessMeaning\":\"Stable internal key used when the user or a downstream API needs to reference the exact Receivables transaction record.\",\"dataType\":\"Integer\",\"category\":\"Invoice Identity\",\"semanticRole\":\"primaryKey\",\"synonyms\":[\"customer transaction id\",\"transaction id\",\"invoice id\",\"receivables transaction id\",\"customer trx id\",\"customerTransactionId\"],\"filterAnchors\":[\"customerTransactionId\"],\"filterable\":true,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"],\"format\":\"integer\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.customerTransactionId\",\"tablePriority\":null},{\"attributeName\":\"paymentTermName\",\"queryField\":\"paymentTermName\",\"description\":\"Payment term name assigned to the invoice.\",\"businessMeaning\":\"Payment term used to derive due dates and discount windows.\",\"dataType\":\"String\",\"category\":\"Payment Terms\",\"semanticRole\":\"paymentTerms\",\"synonyms\":[\"payment terms\",\"terms\",\"payment term name\",\"net terms\",\"paymentTermName\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.paymentTerm.name\",\"tablePriority\":16},{\"attributeName\":\"accountDiscountGraceDays\",\"queryField\":\"accountDiscountGraceDays\",\"description\":\"Discount grace days from the customer account profile.\",\"businessMeaning\":\"Customer-level grace period that can affect discount eligibility.\",\"dataType\":\"Integer\",\"category\":\"Payment Terms\",\"semanticRole\":\"days\",\"synonyms\":[\"discount grace days\",\"grace days\",\"discount grace period\",\"account discount grace days\",\"accountDiscountGraceDays\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[],\"format\":\"integer\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerAccount.customerAccountProfile.discountGraceDays\",\"tablePriority\":null},{\"attributeName\":\"overdueFlag\",\"queryField\":\"overdueFlag\",\"description\":\"Indicator showing whether the payment schedule is overdue.\",\"businessMeaning\":\"Convenience flag for past-due status when evaluating collections or payment risk.\",\"dataType\":\"String\",\"category\":\"Payment Terms\",\"semanticRole\":\"flag\",\"synonyms\":[\"overdue\",\"past due\",\"overdue flag\",\"late\",\"overdueFlag\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"yesNoFlag\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"allowedValues\":[{\"code\":\"Y\",\"meaning\":\"Yes\"},{\"code\":\"N\",\"meaning\":\"No\"}],\"sourcePath\":\"overdueFlag\",\"tablePriority\":17}],\"semanticFilters\":{\"OPEN\":{\"description\":\"Open, unpaid, or outstanding invoice installments with a remaining balance.\",\"matchPatterns\":[\"\\\\b(?:open|unpaid|outstanding) invoices?\\\\b\",\"\\\\binvoices?\\\\s+(?:that are\\\\s+)?(?:open|unpaid|outstanding)\\\\b\",\"\\\\b(?:outstanding balance|remaining balance|amount due|balance due)\\\\b\",\"\\\\b(?:what is|show|get|give me).*\\\\b(?:outstanding|remaining)\\\\s+balance\\\\b\"],\"predicates\":[\"installmentStatus = 'OP'\",\"NVL(amountRemaining, 0) <> 0\"],\"appliedFilterColumn\":\"installmentStatus/amountRemaining\"},\"OVERDUE\":{\"description\":\"Past-due open invoice installments with a remaining balance.\",\"matchPatterns\":[\"\\\\b(?:overdue|past due) invoices?\\\\b\",\"\\\\binvoices?\\\\s+(?:that are\\\\s+)?(?:overdue|past due)\\\\b\"],\"predicates\":[\"installmentStatus = 'OP'\",\"NVL(amountRemaining, 0) <> 0\",\"overdueFlag = 'Y'\"],\"appliedFilterColumn\":\"installmentStatus/amountRemaining/overdueFlag\"},\"PARTIAL\":{\"description\":\"Partially paid invoice installments with applied amount and remaining balance.\",\"matchPatterns\":[\"\\\\bpartially paid invoices?\\\\b\",\"\\\\binvoices?\\\\s+(?:that are\\\\s+)?partially paid\\\\b\"],\"predicates\":[\"installmentStatus = 'OP'\",\"NVL(amountRemaining, 0) <> 0\",\"NVL(amountApplied, 0) > 0\"],\"appliedFilterColumn\":\"installmentStatus/amountRemaining/amountApplied\"},\"CLOSED\":{\"description\":\"Paid, settled, or closed invoice installments.\",\"matchPatterns\":[\"\\\\b(?:paid|settled|closed) invoices?\\\\b\",\"\\\\binvoices?\\\\s+(?:that are\\\\s+)?(?:paid|settled|closed)\\\\b\"],\"predicates\":[\"(installmentStatus = 'CL' OR NVL(amountRemaining, 0) = 0)\"],\"appliedFilterColumn\":\"installmentStatus/amountRemaining\"},\"REVERSED\":{\"description\":\"Reversed invoice installments, when the payment schedule exposes REV status.\",\"matchPatterns\":[\"\\\\b(?:reversed|reverse|rev) invoices?\\\\b\",\"\\\\binvoices?\\\\s+(?:that are\\\\s+)?(?:reversed|reverse|rev)\\\\b\"],\"predicates\":[\"installmentStatus = 'REV'\"],\"appliedFilterColumn\":\"installmentStatus\"}},\"dateFilterField\":\"transactionDate\"},\"invoiceDelivery\":{\"catalogName\":\"invoiceDelivery\",\"catalogVersion\":\"rich-attribute-catalog-v2\",\"intent\":\"INVESTIGATE_INVOICE_DELIVERY\",\"queryName\":\"invoiceDelivery\",\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransaction\",\"view\":\"receivablesTransactionsExtract\",\"description\":\"Attributes used to investigate print, XML readiness, and delivery-related signals on Receivables transaction headers.\",\"primaryBusinessQuestion\":\"Does the invoice look printed, pending print, ready for XML delivery, or not yet sent?\",\"grain\":\"Receivables transaction header/extract. One row represents one transaction header.\",\"filterStrategy\":\"Use invoice, PO, document, customer reference, or customer transaction ID. Delivery conclusions should combine complete, printPending, printCount, print dates, XML readiness, and delivery method.\",\"filters\":{\"invoiceNumber\":\"invoiceNumber\",\"poNumber\":\"poNumber\",\"customerReference\":\"customerReference\",\"documentNumber\":\"documentNumber\",\"customerTransactionId\":\"customerTransactionId\",\"customerName\":\"billToCustomerName\",\"accountName\":\"billToCustomerName\",\"accountNumber\":\"billToAccountNumber\",\"businessUnitName\":\"businessUnitName\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Use invoiceNumber when the user provides invoiceNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"poNumber\",\"queryField\":\"poNumber\",\"description\":\"Use poNumber when the user provides poNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerReference\",\"queryField\":\"customerReference\",\"description\":\"Use customerReference when the user provides customerReference.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"documentNumber\",\"queryField\":\"documentNumber\",\"description\":\"Use documentNumber when the user provides documentNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Use customerTransactionId when the user provides customerTransactionId.\",\"dataType\":\"Integer\",\"matchStrategy\":\"exact\",\"supportedOperators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"]}],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"complete\",\"printPending\",\"printCount\",\"lastPrintingDate\",\"transactionStatusCode\",\"deliveryStatus\",\"billToCustomerName\",\"billToAccountNumber\",\"businessUnitName\"],\"identityAttributes\":[\"customerTransactionId\",\"invoiceNumber\",\"documentNumber\"],\"customerAttributes\":[\"billToCustomerName\",\"billToAccountNumber\"],\"referenceAttributes\":[\"poNumber\",\"customerReference\"],\"dateAttributes\":[\"transactionDate\",\"firstPrintDate\",\"lastPrintingDate\"],\"amountAttributes\":[],\"statusAttributes\":[\"transactionClass\",\"complete\",\"printPending\",\"readyForXmlDelivery\",\"transactionStatusCode\"],\"attributes\":[{\"attributeName\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Internal Receivables customer transaction identifier for the invoice, debit memo, credit memo, or related transaction.\",\"businessMeaning\":\"Stable internal key used when the user or a downstream API needs to reference the exact Receivables transaction record.\",\"dataType\":\"Integer\",\"category\":\"Invoice Identity\",\"semanticRole\":\"primaryKey\",\"synonyms\":[\"customer transaction id\",\"transaction id\",\"invoice id\",\"receivables transaction id\",\"customer trx id\",\"customerTransactionId\"],\"filterAnchors\":[\"customerTransactionId\"],\"filterable\":true,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"],\"format\":\"integer\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.customerTransactionId\",\"tablePriority\":null},{\"attributeName\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Receivables invoice transaction number assigned to the invoice header.\",\"businessMeaning\":\"Primary customer-facing invoice identifier used for payment, dispute, credit memo, document, delivery, and line-charge inquiries.\",\"dataType\":\"String\",\"category\":\"Invoice Identity\",\"semanticRole\":\"businessIdentifier\",\"synonyms\":[\"invoice\",\"invoice number\",\"transaction number\",\"ar invoice\",\"bill number\",\"trx number\",\"invoiceNumber\"],\"filterAnchors\":[\"invoiceNumber\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.transactionNumber\",\"tablePriority\":1},{\"attributeName\":\"transactionDate\",\"queryField\":\"transactionDate\",\"description\":\"Date assigned to the Receivables transaction.\",\"businessMeaning\":\"Invoice or transaction date used to orient results chronologically and distinguish similarly named transactions.\",\"dataType\":\"Date\",\"category\":\"Dates\",\"semanticRole\":\"transactionDate\",\"synonyms\":[\"invoice date\",\"transaction date\",\"billing transaction date\",\"trx date\",\"transactionDate\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"date\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.transactionDate\",\"tablePriority\":2},{\"attributeName\":\"documentNumber\",\"queryField\":\"documentNumber\",\"description\":\"Document sequence number assigned to the Receivables transaction.\",\"businessMeaning\":\"Document-control identifier that can be used when the user knows a document number instead of the invoice number.\",\"dataType\":\"String\",\"category\":\"Invoice Identity\",\"semanticRole\":\"documentIdentifier\",\"synonyms\":[\"document number\",\"document sequence\",\"doc number\",\"document id\",\"documentNumber\"],\"filterAnchors\":[\"documentNumber\"],\"filterable\":true,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"customerTransaction.documentNumber\",\"tablePriority\":null},{\"attributeName\":\"transactionClass\",\"queryField\":\"transactionClass\",\"description\":\"Receivables transaction class code.\",\"businessMeaning\":\"Classifies the transaction as invoice, debit memo, credit memo, chargeback, or bills receivable.\",\"dataType\":\"String\",\"category\":\"Status\",\"semanticRole\":\"classification\",\"synonyms\":[\"transaction class\",\"invoice class\",\"transaction type\",\"transactionClass\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[],\"format\":\"code\",\"summaryBehavior\":\"Use as supporting context or downstream key; omit from compact tables unless needed.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"allowedValues\":[{\"code\":\"INV\",\"meaning\":\"Invoice\"},{\"code\":\"DM\",\"meaning\":\"Debit Memo\"},{\"code\":\"CM\",\"meaning\":\"Credit Memo\"},{\"code\":\"CB\",\"meaning\":\"Chargeback\"},{\"code\":\"BR\",\"meaning\":\"Bills Receivable\"}],\"sourcePath\":\"customerTransaction.transactionClass\",\"tablePriority\":null},{\"attributeName\":\"complete\",\"queryField\":\"complete\",\"description\":\"Indicator showing whether the Receivables transaction is complete.\",\"businessMeaning\":\"Completion signal; incomplete invoices may not be ready for normal delivery or customer processing.\",\"dataType\":\"String\",\"category\":\"Status\",\"semanticRole\":\"flag\",\"synonyms\":[\"complete\",\"completed\",\"transaction complete\",\"invoice complete\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"yesNoFlag\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly as