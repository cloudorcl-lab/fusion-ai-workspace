        {
          "metadata": {
            "description": "Builds the Billing display template consumed by the shared Receivables display formatter.",
            "errorNodeId": "1779832851336",
            "name": "Build Display Template",
            "returnType": "object",
            "sourceCode": "return eval(\"let P=$context.$nodes.BUILD_BILLING_EXTRACT.$output.result||{},T=$context.$nodes.PREPARE_BILLING_TABLE.$output.result||{},S=$context.$nodes.NORMALIZE_BILLING_SUMMARY.$output.result||{},U=$context.$nodes.BUILD_BILLING_FOLLOW_UPS.$output.result||{};\\nlet ttl=S.title||'Billing Inquiry Results',ans=S.summary||P.missingMessage||((T.rowCount||0)?'Found '+T.rowCount+' billing record(s).':T.noDataMessage),rf=U.followUps||P.followUps||[],f=[],ctx=U.contextCarryForward||P.normalizedContext||{},r=Array.isArray(T.rows)?T.rows:[],n=Number.isFinite(Number(T.rowCount))?Number(T.rowCount):r.length,vm=(P.normalizedContext&&P.normalizedContext.viewMode)||P.viewMode||T.viewMode||'DEFAULT';\\nlet inputs=[{id:'billing_summary',type:'text',contentPolicy:'preserve',authoringHints:'Preserve summary as-is. Do not render a visible heading.',data:ans||'No billing response was generated.'}],A=P.appliedFilters||[],parts=[],i,x,tax,singleLookup,hasScope,listScope,showScope,grouped,scopeText='',dataTitle='';\\nsingleLookup=(T.displayMode==='LOOKUP'||T.displayMode==='FIELD_LIST')||((ctx.invoiceNumber||ctx.requestId||ctx.creditMemoNumber||ctx.adjustmentNumber)&&vm!=='CUSTOMER_OPEN_INVOICES'&&vm!=='CUSTOMER_INVOICE_HISTORY'&&T.displayMode!=='ROLLUP');\\nhasScope=!!(A.length||ctx.customerName||ctx.accountName||ctx.accountNumber||ctx.businessUnitName||ctx.dateRangeText||ctx.paymentScheduleStatusFilter);\\nlistScope=!!(vm==='CUSTOMER_OPEN_INVOICES'||vm==='CUSTOMER_INVOICE_HISTORY'||vm==='CUSTOMER_OUTSTANDING_BALANCE'||T.displayMode==='ROLLUP');\\nshowScope=!!(!singleLookup&&hasScope&&!P.missingMessage&&!P.outOfScope&&T.displayMode!=='TEXT_ONLY'&&(n>0||listScope));\\nif(showScope){let seenScope={};let addScope=function(name,value){if(value==null||value===''||seenScope[name])return;seenScope[name]=1;parts.push(String(name)+'='+String(value))};for(i=0;i<A.length;i++){x=A[i]||{};addScope(x.name||'filter',x.value)}addScope('customerName',ctx.customerName);addScope('accountName',ctx.accountName);addScope('accountNumber',ctx.accountNumber);addScope('businessUnitName',ctx.businessUnitName);addScope('dateRange',ctx.dateRangeText);addScope('paymentScheduleStatusFilter',ctx.paymentScheduleStatusFilter);scopeText='Scope: '+parts.join('; ')+'. Record count: '+n+'.'+(T.displayMode==='ROLLUP'?' Data is rolled up for chat; expand to view full detail on canvas.':'');inputs.push({id:'billing_filter_context',type:'text',contentPolicy:'preserve',authoringHints:'Preserve filter context as-is. Do not render a visible heading.',data:scopeText})}\\n\\nif(Array.isArray(rf))for(i=0;i<rf.length&&f.length<3;i++)if(rf[i]&&f.indexOf(rf[i])<0)f.push(rf[i]);\\ntax=(P.intent==='REVIEW_INVOICE_TAX_CHARGES'||P.shapeKey==='receivablesInvoiceTaxDetail')?' Tax table must show taxable amount, tax rate, extended amount, gross amount, exemption certificate, Tax Exempt Status, Tax Exempt Reason, fiscal classification, business category, and currency when present.':'';\\ngrouped=(T.displayMode==='ROLLUP'||vm==='CUSTOMER_OPEN_INVOICES'||vm==='CUSTOMER_INVOICE_HISTORY'||vm==='CUSTOMER_OUTSTANDING_BALANCE')&&n>0&&r.length;\\ndataTitle=ttl;\\nif(n>0&&r.length){let tableInput={id:'billing_results_table',type:'table',authoringHints:'Use monetaryTemplate for amount/balance/tax/extended/gross/total fields; use currency only as currencySourceField. Do not display currency code ANY as a real currency.'+tax,dataRef:'$context.$nodes.PREPARE_BILLING_TABLE.$output.result.rows',pathToItems:'',chatDisplayConfig:{limitRowsInChat:true,rowLimit:10}};if(grouped){tableInput.groupId='billing_results_group';tableInput.groupTitle=dataTitle;tableInput.isPrimary=true}inputs.push(tableInput)}\\nif(grouped&&Array.isArray(T.scoreboard)&&T.scoreboard.length)inputs.push({id:'billing_scoreboard',type:'scoreboard',groupId:'billing_results_group',groupTitle:dataTitle,authoringHints:'Render the supplied deterministic count and total metrics without changing values. Preserve currency-code-first exact amounts.',dataRef:'$context.$nodes.PREPARE_BILLING_TABLE.$output.result.scoreboard',pathToItems:''});\\nif(grouped&&Array.isArray(T.artifactRows)&&T.artifactRows.length)inputs.push({id:'billing_detail_rows',type:'table',groupId:'billing_results_group',groupTitle:dataTitle,authoringHints:'Render the full detail records for artifact drilldown and full detail on canvas when expanded. Preserve source column order and exact amounts.',dataRef:'$context.$nodes.PREPARE_BILLING_TABLE.$output.result.artifactRows',pathToItems:'',chatDisplayConfig:{limitRowsInChat:false,rowLimit:0}});\\nif(f.length)inputs.push({id:'billing_suggested_next_steps',type:'action',authoringHints:'Use this only for ordering. RETURN_DISPLAY_RESULT converts it to plain text; do not render as buttons.',data:f});\\n({templateId:'billing_text_table_action',inputs:inputs,contextCarryForward:ctx})\")"
          },
          "outcomes": {
            "success": "1770000001009"
          },
          "code": "BUILD_DISPLAY_TEMPLATE",
          "id": "1770000001006",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Stores resolved billing context after extraction so follow-up turns can reuse resolved invoice/customer identifiers.",
            "errorNodeId": "1779832851336",
            "name": "Set Response Context"
          },
          "outcomes": {
            "success": "1777273552377"
          },
          "code": "SET_RESPONSE_CONTEXT",
          "id": "1770000001009",
          "inputs": [
            {
              "id": "1770000001009_1",
              "name": "billingContext",
              "scope": "CONVERSATION",
              "type": "object",
              "value": "{{$context.$nodes.BUILD_DISPLAY_TEMPLATE.$output.result.contextCarryForward}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Compile Display Plan",
            "returnType": "object",
            "sourceCode": "/*\n  Summary:\n  - Read the consumer-supplied template input.\n  - Build a valid DisplayPlan with meta, components, and groups.\n  - Keep text and action components ungrouped.\n  - Build drilldownView groups from grouped table/scoreboard/dynamicTable inputs.\n  - Enforce grouping rules so consumers do not need to know display-plan mechanics.\n  - Default text contentPolicy to \"author\" when missing or empty.\n  - Validate text contentPolicy against: author, normalizeOnly, preserve.\n*/\n\n// Inputs: keep all context reads in one place.\nlet templateInputRaw;\ntry {\n  templateInputRaw = $context.$nodes.BUILD_OUT_OF_SCOPE_DISPLAY_TEMPLATE.$output.result;\n} catch (ignored) {\n  templateInputRaw = null;\n}\nif (!templateInputRaw) {\n  try {\n    templateInputRaw = $context.$nodes.BUILD_DISPLAY_TEMPLATE.$output.result;\n  } catch (ignored) {\n    templateInputRaw = null;\n  }\n}\nconst workflowName = $context.$workflow.$name || \"\";\n\nfunction parseIfString(value) {\n  let parsed = value;\n\n  while (typeof parsed === \"string\") {\n    parsed = JSON.parse(parsed);\n  }\n\n  return parsed;\n}\n\nfunction clone(value) {\n  return JSON.parse(JSON.stringify(value));\n}\n\nfunction isNonEmptyString(value) {\n  return typeof value === \"string\" && value.trim().length > 0;\n}\n\nfunction normalizeContentPolicy(value) {\n  if (!isNonEmptyString(value)) {\n    return \"author\";\n  }\n\n  const allowedValues = [\"author\", \"normalizeOnly\", \"preserve\"];\n  const normalizedInput = value.trim().toLowerCase();\n\n  const matchedValue = allowedValues.find(\n    (item) => item.toLowerCase() === normalizedInput\n  );\n\n  if (!matchedValue) {\n    throw new Error(\n      \"contentPolicy must be one of: author, normalizeOnly, preserve\"\n    );\n  }\n\n  return matchedValue;\n}\n\n\nfunction normalizeTemplateInput(input) {\n  if (!input || typeof input !== \"object\") {\n    throw new Error(\"Template input is missing or invalid.\");\n  }\n\n  if (!isNonEmptyString(input.templateId)) {\n    throw new Error(\"templateId is required.\");\n  }\n\n  if (!Array.isArray(input.inputs) || input.inputs.length === 0) {\n    throw new Error(\"inputs must be a non-empty array.\");\n  }\n\n  return input;\n}\n\nfunction validateUniqueComponentIds(inputs) {\n  const seen = new Set();\n\n  inputs.forEach((item) => {\n    if (!isNonEmptyString(item.id)) {\n      throw new Error(\"Each input component must include a non-empty id.\");\n    }\n\n    if (seen.has(item.id)) {\n      throw new Error(\"Duplicate component id found: \" + item.id);\n    }\n\n    seen.add(item.id);\n  });\n}\n\nfunction validateInputShape(input) {\n  if (!isNonEmptyString(input.type)) {\n    throw new Error(\"Component type is required for id: \" + input.id);\n  }\n\n  if (![\"text\", \"table\", \"scoreboard\", \"action\", \"dynamicTable\"].includes(input.type)) {\n    throw new Error(\"Unsupported component type: \" + input.type);\n  }\n\n  if (input.type === \"text\") {\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throw new Error(\"Text components cannot be grouped: \" + input.id);\n    }\n\n    if (input.isPrimary === true) {\n      throw new Error(\"Text components cannot be primary: \" + input.id);\n    }\n\n    if (typeof input.data === \"undefined\") {\n      throw new Error(\"Text component must include data: \" + input.id);\n    }\n\n    normalizeContentPolicy(input.contentPolicy);\n  }\n\n  if (input.type === \"action\") {\n    const hasInlineData = typeof input.data !== \"undefined\";\n    const hasDataRef = isNonEmptyString(input.dataRef);\n\n    if (isNonEmptyString(input.groupId) || isNonEmptyString(input.groupTitle)) {\n      throw new Error(\"Action components cannot be grouped: \" + input.id);\n    }\n\n    if (input.isPrimary === true) {\n      throw new Error(\"Action components cannot be primary: \" + input.id);\n    }\n\n    if (hasInlineData === hasDataRef) {\n      throw new Error(\n        \"Action components must provide exactly one of data or dataRef: \" + input.id\n      );\n    }\n  }\n\n  if (input.type === \"table\") {\n    if (!isNonEmptyString(input.dataRef)) {\n      throw new Error(\"Table component must include dataRef: \" + input.id);\n    }\n\n    if (isNonEmptyString(input.groupId) && !isNonEmptyString(input.groupTitle)) {\n      throw new Error(\"Grouped table component must include groupTitle: \" + input.id);\n    }\n  }\n\n  if (input.type === \"scoreboard\") {\n    if (!isNonEmptyString(input.groupId) || !isNonEmptyString(input.groupTitle)) {\n      throw new Error(\"Scoreboard components must be grouped: \" + input.id);\n    }\n\n    if (input.isPrimary === true) {\n      throw new Error(\"Scoreboard components cannot be primary: \" + input.id);\n    }\n\n    if (!isNonEmptyString(input.dataRef)) {\n      throw new Error(\"Scoreboard component must include dataRef: \" + input.id);\n    }\n  }\n\n  if (input.type === \"dynamicTable\") {\n    if (!isNonEmptyString(input.groupId) || !isNonEmptyString(input.groupTitle)) {\n      throw new Error(\"DynamicTable components must be grouped: \" + input.id);\n    }\n\n    if (input.isPrimary === true) {\n      throw new Error(\"DynamicTable components cannot be primary: \" + input.id);\n    }\n\n    if (typeof input.data === \"undefined\") {\n      throw new Error(\"DynamicTable component must include data: \" + input.id);\n    }\n  }\n}\n\nfunction buildComponent(input) {\n  const component = {\n    id: input.id,\n    type: input.type\n  };\n\n  if (isNonEmptyString(input.title)) {\n    component.title = input.title;\n  }\n\n  if (isNonEmptyString(input.authoringHints)) {\n    component.authoringHints = input.authoringHints;\n  }\n\n  if (input.type === \"table\" || input.type === \"scoreboard\") {\n    component.dataRef = input.dataRef;\n    component.pathToItems = isNonEmptyString(input.pathToItems)\n      ? input.pathToItems\n      : \"\";\n    if (input.type === \"table\" && input.chatDisplayConfig && typeof input.chatDisplayConfig === \"object\") {\n      component.chatDisplayConfig = clone(input.chatDisplayConfig);\n    }\n    return component;\n  }\n\n  if (input.type === \"text\") {\n    component.contentPolicy = normalizeContentPolicy(input.contentPolicy);\n    component.data = clone(input.data);\n    return component;\n  }\n\n  if (input.type === \"dynamicTable\") {\n    component.data = clone(input.data);\n    return component;\n  }\n\n  if (input.type === \"action\") {\n    const hasInlineData = typeof input.data !== \"undefined\";\n    const hasDataRef = isNonEmptyString(input.dataRef);\n\n    if (hasInlineData) {\n      component.data = clone(input.data);\n    } else if (hasDataRef) {\n      component.dataRef = input.dataRef;\n      component.pathToItems = isNonEmptyString(input.pathToItems)\n        ? input.pathToItems\n        : \"\";\n    }\n\n    return component;\n  }\n\n  throw new Error(\"Unsupported component type in buildComponent: \" + input.type);\n}\n\nfunction collectGroups(inputs) {\n  const groupsById = Object.create(null);\n\n  inputs.forEach((input) => {\n    if (!isNonEmptyString(input.groupId)) {\n      return;\n    }\n\n    if (!groupsById[input.groupId]) {\n      groupsById[input.groupId] = {\n        groupId: input.groupId,\n        groupTitle: input.groupTitle,\n        inputs: []\n      };\n    }\n\n    const group = groupsById[input.groupId];\n\n    if (!isNonEmptyString(group.groupTitle) && isNonEmptyString(input.groupTitle)) {\n      group.groupTitle = input.groupTitle;\n    }\n\n    if (\n      isNonEmptyString(group.groupTitle) &&\n      isNonEmptyString(input.groupTitle) &&\n      group.groupTitle !== input.groupTitle\n    ) {\n      throw new Error(\n        \"Conflicting groupTitle values found for groupId: \" + input.groupId\n      );\n    }\n\n    group.inputs.push(input);\n  });\n\n  return groupsById;\n}\n\nfunction buildGroup(group) {\n  if (!isNonEmptyString(group.groupTitle)) {\n    throw new Error(\"Grouped components must include groupTitle for groupId: \" + group.groupId);\n  }\n\n  const primaryTables = group.inputs.filter(\n    (input) => input.type === \"table\" && input.isPrimary === true\n  );\n\n  if (primaryTables.length !== 1) {\n    throw new Error(\n      \"Each group must have exactly one primary table. groupId: \" + group.groupId\n    );\n  }\n\n  const primaryTable = primaryTables[0];\n\n  group.inputs.forEach((input) => {\n    if (input.id === primaryTable.id) {\n      return;\n    }\n\n    if (![\"table\", \"scoreboard\", \"dynamicTable\"].includes(input.type)) {\n      throw new Error(\n        \"Only scoreboard and dynamicTable are allowed as supporting grouped content for now. groupId: \" +\n          group.groupId\n      );\n    }\n  });\n\n  return {\n    groupId: group.groupId,\n    groupTitle: group.groupTitle,\n    behavior: \"drilldownView\",\n    primaryComponentId: primaryTable.id,\n    componentIds: group.inputs.map((input) => input.id)\n  };\n}\n\nfunction buildDisplayPlan(templateInput) {\n  const normalizedInput = normalizeTemplateInput(templateInput);\n  const inputs = normalizedInput.inputs;\n\n  validateUniqueComponentIds(inputs);\n  inputs.forEach(validateInputShape);\n\n  const components = inputs.map(buildComponent);\n  const groupsById = collectGroups(inputs);\n  const groups = Object.values(groupsById).map(buildGroup);\n\n  return {\n    meta: {\n      agentName: workflowName\n    },\n    components,\n    groups\n  };\n}\n\nconst templateInput = parseIfString(templateInputRaw);\nreturn buildDisplayPlan(templateInput);"
          },
          "outcomes": {
            "success": "1777273586554"
          },
          "code": "COMPILE_DISPLAY_PLAN",
          "id": "1777273552377",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Handling error that occurs in different nodes",
            "name": "Handle Billing Error",
            "returnType": "object",
            "sourceCode": "({agent:'Billing Inquiry Assistant',agent_response:[{display_type:'text',display_sequence:1,text:'I could not complete this Billing inquiry because the extract or formatter failed at runtime. This is different from no matching data or a missing reference. Retry with a valid invoice, sales order, PO, customer, account, or document reference; if it repeats, check the Billing extract and formatter logs for this workflow run.'},{display_type:'text',display_sequence:2,text:'Suggested Next Steps\\n- Find invoice by sales order\\n- Check payment balance for an invoice\\n- Review invoice line charges'}],followUpSuggestions:['Find invoice by sales order','Check payment balance for an invoice','Review invoice line charges']})"
          },
