le.discountGraceDays\":\"siteDiscountGraceDays\"}},\"paymentTermLines\":{\"module\":\"oraErpCoreReceivablesSetup\",\"businessObject\":\"ReceivablesPaymentTermPaymentSchedule\",\"view\":\"receivablesPaymentTermPaymentSchedulesDetail\",\"fieldAliases\":{\"paymentTermsId\":\"paymentTermId\",\"installmentId\":\"termsSequenceNumber\",\"dueByDays\":\"termLineDueDays\",\"dueByDate\":\"termLineDueDate\",\"dueByDayOfMonth\":\"termLineDueByDayOfMonth\",\"dueByMonthsAhead\":\"termLineDueByMonthsAhead\"}},\"paymentTermDiscounts\":{\"module\":\"oraErpCoreReceivablesSetup\",\"businessObject\":\"ReceivablesPaymentTermDiscount\",\"view\":\"receivablesPaymentTermDiscountsDetail\",\"fieldAliases\":{\"discountId\":\"discountId\",\"percentage\":\"discountPercent\",\"dueByDays\":\"discountDueDays\",\"dueByDate\":\"discountDueDate\",\"dueByDayOfMonth\":\"discountDueDayOfMonth\",\"dueByMonthsAhead\":\"discountDueMonthsAhead\",\"paymentTerm.termId\":\"discountPaymentTermId\",\"paymentTermLine.paymentTermsId\":\"paymentTermLinePaymentTermId\",\"paymentTermLine.installmentId\":\"termsSequenceNumber\",\"setIdSet.setId\":\"setId\"}}},\"namedSelects\":[{\"name\":\"invoiceInstallmentRows\",\"select\":\"select customerTransactionId, paymentScheduleId, invoiceNumber, transactionDate, transactionHeaderDueDate, installmentClass, installmentStatus, termsSequenceNumber, paymentDueDate, amountDueOriginal, amountDueRemaining, discountTakenEarned, discountTakenUnearned, paymentTermId, paymentTermName, businessUnitName, accountNumber, accountName, accountDiscountGraceDays, siteDiscountGraceDays from invoiceInstallments where {{where}}\"},{\"name\":\"invoiceTermLineRows\",\"select\":\"select i.customerTransactionId, i.paymentScheduleId, i.invoiceNumber, i.transactionDate, i.transactionHeaderDueDate, i.installmentClass, i.installmentStatus, i.termsSequenceNumber, i.paymentDueDate, i.amountDueOriginal, i.amountDueRemaining, i.discountTakenEarned, i.discountTakenUnearned, i.paymentTermId, i.paymentTermName, i.businessUnitName, i.accountNumber, i.accountName, i.accountDiscountGraceDays, i.siteDiscountGraceDays, l.termLineDueDays, l.termLineDueDate, l.termLineDueByDayOfMonth, l.termLineDueByMonthsAhead from invoiceInstallmentRows i left outer join paymentTermLines l on l.paymentTermId = i.paymentTermId and l.termsSequenceNumber = i.termsSequenceNumber\"},{\"name\":\"invoiceTermLineDiscountRows\",\"select\":\"select t.customerTransactionId, t.paymentScheduleId, t.invoiceNumber, t.transactionDate, t.transactionHeaderDueDate, t.installmentClass, t.installmentStatus, t.termsSequenceNumber, t.paymentDueDate, t.amountDueOriginal, t.amountDueRemaining, t.discountTakenEarned, t.discountTakenUnearned, t.paymentTermId, t.paymentTermName, t.businessUnitName, t.accountNumber, t.accountName, t.accountDiscountGraceDays, t.siteDiscountGraceDays, t.termLineDueDays, t.termLineDueDate, t.termLineDueByDayOfMonth, t.termLineDueByMonthsAhead, d.discountId, d.discountPercent, d.discountDueDays, d.discountDueDate, d.discountDueDayOfMonth, d.discountDueMonthsAhead, d.discountPaymentTermId, d.paymentTermLinePaymentTermId, d.setId from invoiceTermLineRows t left outer join paymentTermDiscounts d on d.paymentTermLinePaymentTermId = t.paymentTermId and d.termsSequenceNumber = t.termsSequenceNumber\"}],\"select\":\"select customerTransactionId, paymentScheduleId, invoiceNumber, transactionDate, transactionHeaderDueDate, installmentClass, installmentStatus, termsSequenceNumber, paymentDueDate, amountDueOriginal, amountDueRemaining, discountTakenEarned, discountTakenUnearned, paymentTermId, paymentTermName, businessUnitName, accountNumber, accountName, accountDiscountGraceDays, siteDiscountGraceDays, termLineDueDays, termLineDueDate, termLineDueByDayOfMonth, termLineDueByMonthsAhead, discountId, discountPercent, discountDueDays, discountDueDate, discountDueDayOfMonth, discountDueMonthsAhead, discountPaymentTermId, paymentTermLinePaymentTermId, setId from invoiceTermLineDiscountRows order by paymentScheduleId, termsSequenceNumber, discountId\",\"appendFiltersToSelect\":false,\"return\":[{\"name\":\"customerTransactionId\"},{\"name\":\"paymentScheduleId\"},{\"name\":\"invoiceNumber\"},{\"name\":\"transactionDate\"},{\"name\":\"transactionHeaderDueDate\"},{\"name\":\"installmentClass\"},{\"name\":\"installmentStatus\"},{\"name\":\"termsSequenceNumber\"},{\"name\":\"paymentDueDate\"},{\"name\":\"amountDueOriginal\"},{\"name\":\"amountDueRemaining\"},{\"name\":\"discountTakenEarned\"},{\"name\":\"discountTakenUnearned\"},{\"name\":\"paymentTermId\"},{\"name\":\"paymentTermName\"},{\"name\":\"businessUnitName\"},{\"name\":\"accountNumber\"},{\"name\":\"accountName\"},{\"name\":\"accountDiscountGraceDays\"},{\"name\":\"siteDiscountGraceDays\"},{\"name\":\"termLineDueDays\"},{\"name\":\"termLineDueDate\"},{\"name\":\"termLineDueByDayOfMonth\"},{\"name\":\"termLineDueByMonthsAhead\"},{\"name\":\"discountId\"},{\"name\":\"discountPercent\"},{\"name\":\"discountDueDays\"},{\"name\":\"discountDueDate\"},{\"name\":\"discountDueDayOfMonth\"},{\"name\":\"discountDueMonthsAhead\"},{\"name\":\"discountPaymentTermId\"},{\"name\":\"paymentTermLinePaymentTermId\"},{\"name\":\"setId\"}],\"basePredicate\":\"installmentClass = 'INV'\",\"maxRows\":100,\"grain\":\"One row per payment-term discount line for the invoice term line. Term-line fields repeat when one term line has multiple discount tiers. relativeAmount is not included because the CPTCIIHQY term-line detail view does not expose it.\"},\"creditMemoTransaction\":{\"queryName\":\"creditMemoTransaction\",\"viewQueries\":{\"creditMemoTransaction\":{\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransactionLine\",\"view\":\"receivablesTransactionDetail\",\"fieldAliases\":{\"customerTransaction.customerTransactionId\":\"creditMemoCustomerTransactionId\",\"customerTransaction.transactionNumber\":\"creditMemoNumber\",\"customerTransaction.transactionDate\":\"creditMemoDate\",\"customerTransaction.transactio