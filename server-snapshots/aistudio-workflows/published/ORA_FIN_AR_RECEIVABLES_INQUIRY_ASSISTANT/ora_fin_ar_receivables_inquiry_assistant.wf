ry\":\"Item\",\"semanticRole\":\"itemNumber\",\"synonyms\":[\"item number\",\"inventory item\",\"inventoryItemNumber\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"inventoryItemNumber\",\"tablePriority\":110},{\"attributeName\":\"statusCode\",\"queryField\":\"statusCode\",\"description\":\"Fulfillment line status code.\",\"businessMeaning\":\"Code value for the fulfillment line status.\",\"dataType\":\"String\",\"category\":\"Status\",\"semanticRole\":\"lineStatusCode\",\"synonyms\":[\"line status code\",\"fulfillment status code\",\"statusCode\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":false,\"sortable\":true,\"operators\":[],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"statusCode\",\"tablePriority\":null},{\"attributeName\":\"statusDisplayName\",\"queryField\":\"statusDisplayName\",\"description\":\"Fulfillment line status display name.\",\"businessMeaning\":\"Readable status for the fulfillment line.\",\"dataType\":\"String\",\"category\":\"Status\",\"semanticRole\":\"lineStatus\",\"synonyms\":[\"line status\",\"fulfillment status\",\"statusDisplayName\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"text\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"statusDisplayName\",\"tablePriority\":30}]},\"invoicePaymentTermDiscountRules\":{\"catalogName\":\"invoicePaymentTermDiscountRules\",\"catalogVersion\":\"rich-attribute-catalog-v3\",\"intent\":\"CHECK_INVOICE_PAYMENT_TERM_DISCOUNTS\",\"queryName\":\"invoiceTermLineDiscountRows\",\"module\":\"oraErpCoreReceivablesBilling + oraErpCoreReceivablesSetup\",\"businessObject\":\"ReceivablesTransactionPaymentSchedule + ReceivablesPaymentTermPaymentSchedule + ReceivablesPaymentTermDiscount\",\"view\":\"receivablesPaymentSchedule + receivablesPaymentTermPaymentSchedulesDetail + receivablesPaymentTermDiscountsDetail\",\"description\":\"Attributes used to answer invoice payment-term line, due-day, grace-day, and early-payment discount tier questions. The final rowset is discount-tier grain so multiple discounts can be displayed for one term line.\",\"primaryBusinessQuestion\":\"Which payment-term line and discount tiers apply to this invoice installment?\",\"grain\":\"One row per payment-term discount line for the invoice term line. Term-line fields repeat when one term line has multiple discount tiers. relativeAmount is not included because the CPTCIIHQY term-line detail view does not expose it.\",\"filterStrategy\":\"Filter invoiceInstallments first by invoice or customer anchor, join term lines by paymentTermId and termsSequenceNumber, then join discount rows by paymentTermLine.paymentTermsId and paymentTermLine.installmentId.\",\"filters\":{\"invoiceNumber\":\"invoiceNumber\",\"customerTransactionId\":\"customerTransactionId\",\"customerName\":\"accountName\",\"accountNumber\":\"accountNumber\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Use invoiceNumber when the user provides an invoice number.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Use customerTransactionId when the user provides a customer transaction id.\",\"dataType\":\"Integer\",\"matchStrategy\":\"exact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerName\",\"queryField\":\"accountName\",\"description\":\"Use accountName when the user provides a customer name.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"LIKE\"]},{\"anchor\":\"accountNumber\",\"queryField\":\"accountNumber\",\"description\":\"Use accountNumber when the user provides a customer account number.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]}],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"transactionHeaderDueDate\",\"installmentStatus\",\"termsSequenceNumber\",\"paymentDueDate\",\"amountDueOriginal\",\"amountDueRemaining\",\"discountTakenEarned\",\"discountTakenUnearned\",\"paymentTermId\",\"paymentTermName\",\"businessUnitName\",\"accountName\",\"accountNumber\",\"accountDiscountGraceDays\",\"siteDiscountGraceDays\",\"termLineDueDays\",\"termLineDueDate\",\"termLineDueByDayOfMonth\",\"termLineDueByMonthsAhead\",\"discountId\",\"discountPercent\",\"discountDueDays\",\"discountDueDate\",\"discountDueDayOfMonth\",\"discountDueMonthsAhead\",\"setId\"],\"identityAttributes\":[\"invoiceNumber\",\"customerTransactionId\",\"paymentScheduleId\",\"paymentTermId\",\"termsSequenceNumber\",\"discountId\"],\"customerAttributes\":[\"accountName\",\"accountNumber\"],\"referenceAttributes\":[],\"dateAttributes\":[\"transactionDate\",\"transactionHeaderDueDate\",\"paymentDueDate\",\"termLineDueDate\",\"discountDueDate\"],\"amountAttributes\":[\"amountDueOriginal\",\"amountDueRemaining\",\"discountTakenEarned\",\"discountTakenUnearned\",\"discountPercent\",\"discountDueDays\"],\"statusAttributes\":[\"installmentStatus\"],\"attributes\":[{\"attributeName\":\"invoiceNumber\",\"queryField\":\"invoiceNumber\",\"description\":\"Payment-term discount rule attribute: invoiceNumber\",\"businessMeaning\":\"