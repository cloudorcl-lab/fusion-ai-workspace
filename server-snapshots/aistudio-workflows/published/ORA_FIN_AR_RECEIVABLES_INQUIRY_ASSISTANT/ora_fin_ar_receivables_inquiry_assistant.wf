OPEN_INVOICES'?'Open invoice list':'Billing result')));for(i=0;i<order.length&&scoreboard.length<8;i++){k=order[i];if(totals[k]&&Object.keys(totals[k]).length){var exact=H.fmtBucket('',totals[k]).replace(/^: /,'');scoreboard.push(U.scoreMetric(k,labels[k]||k,exact,'Exact total, currencies kept separate'))}}}\nvar noDataCategory=null;if(P.outOfScope)noDataCategory='UNSUPPORTED_REQUEST';else if(P.missingMessage)noDataCategory=(NC&&NC.clarificationReason==='AMBIGUOUS_REFERENCE')?'CLARIFICATION_REQUIRED':'MISSING_IDENTIFIER';else if(extractError)noDataCategory='EXTRACT_OR_RUNTIME_FAILURE';else if(!rowCount)noDataCategory='NO_MATCHING_DATA';\nvar metrics={rowCount:P.missingMessage?0:rowCount,sourceRowCount:sourceRowCount,displayRowCount:rows.length,displayMode:displayMode,viewMode:viewMode,rollupThreshold:rollupThreshold,artifactRowCount:artifactRows.length,artifactRowLimitApplied:displayMode==='ROLLUP'&&artifactRows.length<rowCount,totalsByField:totals,totalsText:lines.join('; '),compactTotalsText:compactLines.join('; '),primaryCompactTotal:primaryCompactTotal,currencyWarnings:[],dateRangeText:NC.dateRangeText||''};\nreturn{fullRows:full,detailRows:detailRows,artifactRows:artifactRows,rows:P.missingMessage?[]:rows,rowCount:P.missingMessage?0:rowCount,displayRowCount:rows.length,displayMode:displayMode,viewMode:viewMode,tableColumns:C,columns:[],scoreboard:scoreboard,metrics:metrics,totalsText:metrics.totalsText,noDataCategory:noDataCategory,noDataMessage:P.missingMessage||P.noDataMessage||'No matching Billing data was found for the supplied reference.'}}\nvar totals={},i,j,r,o,k,v,key,id,inv,cc,taxAmtRow,ext,taxable,gross,taxAmount,lineTotal,lineType,lineHasTaxRows=false,isTaxLine;\nif(listView&&raw.length>rollupThreshold){full=raw;for(i=0;i<raw.length;i++){r=raw[i]||{};cc=H.cur(r);var invAmt=U.amountFrom(r,['originalAmount','amountDueOriginal','invoiceAmount','customerTransactionBillReceivableAmount','extendedAmount','grossExtendedAmount']);var dueAmt=U.amountFrom(r,['