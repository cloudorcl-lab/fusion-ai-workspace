{
  "workflowId": "300000331058357",
  "workflowCode": "ORA_FIN_AR_RECEIVABLES_INQUIRY_ASSISTANT",
  "name": "Customer Billing Inquiry Assistant",
  "description": "Use the Customer Billing Inquiry Assistant to answer Receivables invoice questions about locating invoices, payment status, due dates, invoice delivery, line charges, currency conversion, disputes, credit memos, and adjustments.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of the Billing Inquiry Assistant workflow",
            "name": "Start"
          },
          "outcomes": {
            "success": "1770000001001"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "Initializes separate Billing intent, data-shape, and attribute catalogs used by routing, extract generation, and display planning.",
            "errorNodeId": "1779832851336",
            "name": "Set Billing Catalogs"
          },
          "outcomes": {
            "success": "1770000001020"
          },
          "code": "SET_BILLING_CATALOGS",
          "id": "1770000001001",
          "inputs": [
            {
              "id": "1770000001001_1",
              "name": "billingIntentCatalog",
              "scope": "JOB",
              "type": "object",
              "value": "{\"LOCATE_INVOICE_BY_REFERENCE\":{\"shapeKey\":\"invoiceDetail\",\"queryName\":\"invoiceDetail\",\"intentDescription\":\"Find the Receivables invoice that was created from a related business reference such as sales order, purchase order, project reference, contract reference, document number, customer, or bill-to account.\",\"keywords\":[\"find invoice\",\"locate invoice\",\"sales order\",\"SO number\",\"purchase order\",\"PO number\",\"project reference\",\"contract number\",\"source reference\",\"document number\"],\"examples\":[\"Find the invoice raised for sales order 521101.\",\"What invoice was generated for PO number AUTO_RW_SS 42406?\",\"I need the invoice number for project reference PRJ-2024-07.\"],\"summaryInstruction\":\"Summarize which invoice was found for the supplied order, purchase order, customer reference, document number, or customer context.\",\"noDataMessage\":\"No invoice was found for the provided order, purchase order, reference, document, customer, or account details.\",\"followUps\":[\"Check payment status for this invoice\",\"Review invoice line charges\",\"Check invoice delivery status\"],\"tableColumns\":[\"invoiceNumber\",\"transactionDate\",\"transactionStatus\",\"salesOrderNumber\",\"poNumber\",\"customerReference\",\"billToCustomerName\",\"billToAccountNumber\",\"documentNumber\"],\"requiredAnchors\":[\"invoiceNumber\",\"salesOrderNumber\",\"poNumber\",\"customerReference\",\"documentNumber\",\"customerTransactionId\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"transactionStatus\",\"salesOrderNumber\",\"poNumber\",\"customerReference\",\"documentNumber\",\"billToCustomerName\",\"billToAccountNumber\"],\"documentCopy\":null},\"CHECK_INVOICE_PAYMENT_BALANCE\":{\"shapeKey\":\"paymentSchedule\",\"queryName\":\"paymentSchedule\",\"intentDescription\":\"Answer whether an invoice is paid, partially paid, open, overdue, or still has an outstanding balance. Also supports due-date and payment-term questions because these are schedule/installment facts.\",\"keywords\":[\"paid\",\"unpaid\",\"outstanding balance\",\"remaining balance\",\"open invoice\",\"partially paid\",\"due date\",\"payment terms\",\"discount date\",\"overdue\",\"amount due\",\"balance due\"],\"examples\":[\"Has invoice 115022 been paid?\",\"What is the remaining balance on invoice NOR-IMP-AR06?\",\"When is invoice 115022 due for payment?\",\"What are the payment terms on this invoice?\"],\"summaryInstruction\":\"State whether the invoice appears paid, partially paid, open, overdue, or still has an outstanding balance.\",\"noDataMessage\":\"No payment schedule or balance information was found for the provided invoice, customer, or account.\",\"followUps\":[\"Show due date and payment terms\",\"Check whether any credit memo was issued\",\"Check invoice adjustments\"],\"tableColumns\":[\"invoiceNumber\",\"paymentDueDate\",\"installmentStatus\",\"originalAmount\",\"amountApplied\",\"amountRemaining\",\"currencyCode\",\"customerName\",\"accountName\",\"paymentTermName\",\"businessUnitName\"],\"requiredAnchors\":[\"invoiceNumber\",\"customerTransactionId\",\"customerName\",\"accountName\",\"accountNumber\",\"businessUnitName\"],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"paymentDueDate\",\"transactionHeaderDueDate\",\"installmentStatus\",\"originalAmount\",\"amountApplied\",\"amountRemaining\",\"amountAdjusted\",\"amountCredited\",\"earnedDiscount\",\"unearnedDiscount\",\"currencyCode\",\"customerName\",\"accountName\",\"accountNumber\",\"paymentTermName\",\"overdueFlag\",\"businessUnitName\"],\"documentCopy\":null},\"INVESTIGATE_INVOICE_DELIVERY\":{\"shapeKey\":\"invoiceDelivery\",\"queryName\":\"invoiceDelivery\",\"intentDescription\":\"Investigate whether an invoice was completed, printed, pending print, or otherwise has header print/document status available.\",\"keywords\":[\"not received\",\"not delivered\",\"delivery status\",\"undelivered\",\"print pending\",\"invoice transmission\",\"distribution failed\",\"email delivery\",\"print pending invoices\",\"printed invoices by customer\",\"invoice delivery by business unit\"],\"examples\":[\"The customer says they did not receive invoice Print_11; check delivery status.\",\"Which invoices have not been sent to customers yet?\",\"Invoice INV-45091 was never delivered.\"],\"summaryInstruction\":\"Explain whether the invoice appears complete, printed, pending print, or missing print-status signals based on available transaction header fields.\",\"noDataMessage\":\"No delivery or print status was found for the provided invoice or reference.\",\"followUps\":[\"Retrieve invoice document copy\",\"Check payment balance\",\"Review invoice line charges\"],\"tableColumns\":[\"invoiceNumber\",\"transactionDate\",\"complete\",\"printPending\",\"printCount\",\"lastPrintingDate\",\"transactionStatusCode\",\"deliveryStatus\",\"billToCustomerName\",\"billToAccountNumber\",\"businessUnitName\"],\"requiredAnchors\":[\"invoiceNumber\",\"poNumber\",\"customerReference\",\"documentNumber\",\"customerTransactionId\",\"customerName\",\"accountNumber\",\"businessUnitName\"],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"complete\",\"printPending\",\"printCount\",\"lastPrintingDate\",\"transactionStatusCode\",\"deliveryStatus\",\"billToCustomerName\",\"billToAccountNumber\",\"businessUnitName\"],\"documentCopy\":null},\"RETRIEVE_INVOICE_DOCUMENT_COPY\":{\"shapeKey\":\"invoiceDocument\",\"queryName\":\"invoiceDocument\",\"intentDescription\":\"Locate invoice document-copy metadata for a Receivables invoice using the normal Billing extract path. Use this intent for invoice copy, PDF, printout, reprint, download, or attachment requests; it does not directly fetch file bytes.\",\"keywords\":[\"invoice copy\",\"invoice PDF\",\"invoice document\",\"copy of invoice\",\"attach invoice\",\"original invoice\",\"reprint invoice\",\"invoice attachment\",\"attachment\",\"download invoice\",\"download PDF\",\"print invoice\",\"invoice file\",\"document attachment\",\"file contents\"],\"examples\":[\"Can you share a copy of invoice INV-20456 as a PDF?\",\"Attach the invoice copy for INV-33012 to this case.\",\"Pull the original invoice document for Print_11.\",\"Is there an attachment for invoice Print_11?\",\"Download the invoice PDF for Print_11.\",\"Find the invoice attachment for invoice INV-33012.\"],\"summaryInstruction\":\"Confirm the invoice identity and customer transaction id needed for document-copy or attachment retrieval. Do not claim the PDF was downloaded unless attachment/file data is present.\",\"noDataMessage\":\"No invoice document-copy lookup record was found for the provided invoice or reference.\",\"followUps\":[\"Check invoice delivery status\",\"Review line charges before sending the copy\",\"Check outstanding balance\"],\"tableColumns\":[\"invoiceNumber\",\"customerTransactionId\",\"transactionDate\",\"documentNumber\",\"printPending\",\"customerTransactionLastPrintingDate\",\"printCount\",\"billToCustomerName\",\"transactionStatus\"],\"requiredAnchors\":[\"invoiceNumber\",\"salesOrderNumber\",\"poNumber\",\"customerReference\",\"documentNumber\",\"customerTransactionId\"],\"displayAttributes\":[\"invoiceNumber\",\"customerTransactionId\",\"transactionDate\",\"documentNumber\",\"printPending\",\"customerTransactionLastPrintingDate\",\"printCount\",\"billToCustomerName\",\"billToAccountNumber\",\"transactionStatus\"],\"documentCopy\":null},\"REVIEW_INVOICE_LINE_CHARGES\":{\"shapeKey\":\"invoiceLineCharges\",\"queryName\":\"invoiceLineCharges\",\"intentDescription\":\"Show line-by-line invoice charges, quantities, unit prices, extended amounts, memo line details, tax flags, and sales order line references.\",\"keywords\":[\"line items\",\"line charges\",\"unit price\",\"quantity billed\",\"item description\",\"charge breakdown\",\"pricing\",\"memo line\",\"item code\"],\"examples\":[\"Break down the charges on invoice Print_11.\",\"Show me the unit prices and quantities billed on invoice 6140.\",\"What line items are on invoice INV-20045?\"],\"summaryInstruction\":\"Summarize invoice line charges, quantities, unit prices, taxes, and total billed amount when available.\",\"noDataMessage\":\"No invoice line charges were found for the provided invoice or reference.\",\"followUps\":[\"Check payment status for this invoice\",\"Understand currency conversion\",\"Retrieve invoice document copy\"],\"tableColumns\":[\"transactionNumber\",\"lineNumber\",\"lineType\",\"description\",\"quantityInvoiced\",\"unitPrice\",\"extendedAmount\",\"taxRate\",\"memoLineName\",\"salesOrderNumber\"],\"requiredAnchors\":[\"invoiceNumber\",\"customerTransactionId\",\"salesOrderNumber\",\"poNumber\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"transactionNumber\",\"lineNumber\",\"lineType\",\"description\",\"quantityInvoiced\",\"quantityOrdered\",\"unitPrice\",\"unitStandardPrice\",\"extendedAmount\",\"grossExtendedAmount\",\"taxableAmount\",\"taxRate\",\"memoLineName\",\"salesOrderNumber\"],\"documentCopy\":null},\"REVIEW_INVOICE_TAX_CHARGES\":{\"shapeKey\":\"receivablesInvoiceTaxDetail\",\"queryName\":\"receivablesInvoiceTaxDetail\",\"intentDescription\":\"Show the recorded tax breakdown for a specific Receivables invoice, including taxable amount, tax rate, exemption certificate fields, tax-exempt flags or reasons, and product or transaction fiscal classifications. For why-taxed or exempt-customer wording, surface the recorded fields only and do not infer root cause beyond the returned data.\",\"keywords\":[\"tax amount\",\"tax charged\",\"tax rate\",\"tax code\",\"tax classification\",\"why taxed\",\"tax applied\",\"VAT\",\"GST\",\"sales tax\",\"tax breakdown\",\"tax line\",\"tax jurisdiction\",\"product tax classification\",\"tax calculation\",\"tax exempt\",\"exemption\",\"tax exemption\",\"exempt customer\",\"should not be taxed\",\"exemption certificate\",\"zero tax\",\"no tax\",\"incorrectly taxed\",\"tax error\",\"exempt transaction\",\"wrong tax\",\"exemption not applied\"],\"examples\":[\"Show me tax charged on invoice INV-20045.\",\"What tax rate was applied to this invoice?\",\"How was the product on this invoice classified for tax - is it standard rated or zero rated?\",\"This customer is tax exempt - show the recorded tax and exemption details for invoice INV-45023.\"],\"summaryInstruction\":\"Summarize the tax lines and recorded tax setup fields for the invoice. Include tax rate, taxable amount, extended/gross amounts, exemption certificate, tax-exempt reason, and product or transaction classification when present. If the user asks why tax was charged, state only what the returned data shows and do not infer tax determination root cause.\",\"noDataMessage\":\"No receivables invoice tax detail was found for the provided invoice or reference.\",\"followUps\":[\"Review invoice line charges\",\"Check payment status for this invoice\",\"Retrieve invoice document copy\",\"Check adjustments on this invoice\"],\"tableColumns\":[\"customerTransactionTransactionNumber\",\"lineNumber\",\"description\",\"taxableAmount\",\"taxRate\",\"extendedAmount\",\"grossExtendedAmount\",\"taxExemptionCertificateNumber\",\"taxExemptMeaning\",\"taxExemptReasonMeaning\",\"productFiscalClassification\",\"transactionBusinessCategory\",\"customerTransactionInvoiceCurrencyCurrencyCode\"],\"requiredAnchors\":[\"invoiceNumber\"],\"displayAttributes\":[\"customerTransactionLineId\",\"lineNumber\",\"description\",\"extendedAmount\",\"grossExtendedAmount\",\"taxableAmount\",\"taxRate\",\"taxExemptionCertificateNumber\",\"amountIncludesTax\",\"taxable\",\"productCategory\",\"productFiscalClassification\",\"productType\",\"transactionBusinessCategory\",\"userDefinedFiscalClassification\",\"customerTransactionTransactionNumber\",\"customerTransactionTransactionDate\",\"customerTransactionBillReceivableAmount\",\"customerTransactionPONumber\",\"customerTransactionInvoiceCurrencyCurrencyCode\",\"customerTransactionBillToCustomerAccountAccountName\",\"customerTransactionBillToCustomerAccountAccountNumber\",\"customerTransactionTaxExemptMeaning\",\"customerTransactionTaxExemptLookupCode\",\"taxExemptMeaning\",\"taxExemptLookupCode\",\"taxExemptReasonMeaning\",\"taxExemptReasonLookupCode\"],\"documentCopy\":null},\"UNDERSTAND_FOREIGN_CURRENCY_CONVERSION\":{\"shapeKey\":\"fxDistribution\",\"queryName\":\"fxDistribution\",\"intentDescription\":\"Explain foreign-currency conversion on an invoice using transaction currency, ledger currency, conversion date/rate/type, receivable amount, and accounted amount from receivables distributions.\",\"keywords\":[\"exchange rate\",\"foreign currency\",\"conversion rate\",\"functional currency\",\"ledger currency\",\"transaction currency\",\"FX rate\",\"accounted amount\"],\"examples\":[\"What exchange rate was used on invoice INV-45023?\",\"How was the EUR invoice converted to USD ledger currency?\",\"Show the accounted amount for invoice 6140.\"],\"summaryInstruction\":\"Explain the transaction currency, ledger currency, conversion date, exchange rate, and stored accounted amount.\",\"noDataMessage\":\"No foreign currency conversion or receivables accounting distribution was found for the provided invoice.\",\"followUps\":[\"Review invoice line charges\",\"Check outstanding balance\",\"Check whether adjustments exist\"],\"tableColumns\":[\"transactionNumber\",\"transactionCurrencyCode\",\"ledgerCurrencyCode\",\"conversionDate\",\"conversionRate\",\"conversionRateType\",\"amount\",\"accountedAmount\",\"businessUnitName\"],\"requiredAnchors\":[\"invoiceNumber\",\"creditMemoNumber\",\"businessUnitName\"],\"displayAttributes\":[\"transactionNumber\",\"transactionCurrencyCode\",\"ledgerCurrencyCode\",\"conversionDate\",\"conversionRate\",\"conversionRateType\",\"amount\",\"accountedAmount\",\"businessUnitName\"],\"documentCopy\":null},\"CHECK_DISPUTE_RESOLUTION_STATUS\":{\"shapeKey\":\"disputeDetail\",\"queryName\":\"disputeDetail\",\"intentDescription\":\"Track a Receivables dispute or credit memo request, including dispute number, disputed invoice, dispute amount, reason, status, approval date, and any related credit memo.\",\"keywords\":[\"dispute resolution\",\"dispute status\",\"credit memo issued\",\"corrected invoice\",\"dispute closed\",\"dispute outcome\",\"dispute case\",\"why disputed\",\"why customer disputed\",\"dispute reason\",\"reason for dispute\",\"customer disputed invoice\",\"dispute amount\",\"amount disputed\",\"credit memo request\",\"CM request\",\"credit request\",\"credit memo request created\"],\"examples\":[\"Why did the customer dispute invoice 787?\",\"Show the dispute number, date, amount, reason, and status for invoice 787.\",\"What is the current status and reason for dispute case 561?\",\"Has a credit memo request been created for invoice 787?\"],\"summaryInstruction\":\"Summarize the dispute number, dispute date, disputed invoice, dispute amount, reason, status, and related credit memo if available.\",\"noDataMessage\":\"No dispute request was found for the provided invoice, request id, customer, or transaction.\",\"followUps\":[\"Show credit memos created for this dispute\",\"Check invoice balance after dispute resolution\",\"Check adjustments on the invoice\"],\"tableColumns\":[\"requestId\",\"timeCreated\",\"customerTransactionTransactionNumber\",\"customerTransactionBillToCustomerAccountCustomerName\",\"totalAmount\",\"creditMemoReasonNameMeaning\",\"statusNameMeaning\",\"creditMemoCustomerTransactionTransactionNumber\"],\"requiredAnchors\":[\"requestId\",\"invoiceNumber\",\"customerTransactionId\",\"customerName\"],\"displayAttributes\":[\"requestId\",\"timeCreated\",\"customerTransactionTransactionNumber\",\"customerTransactionBillToCustomerAccountCustomerName\",\"totalAmount\",\"creditMemoReasonNameMeaning\",\"creditMemoReasonNameLookupCode\",\"statusNameMeaning\",\"statusNameLookupCode\",\"approvalDate\",\"creditMemoCustomerTransactionTransactionNumber\"],\"documentCopy\":null},\"CHECK_CREDIT_MEMO_ISSUED\":{\"shapeKey\":\"creditMemoTransaction\",\"queryName\":\"creditMemoTransaction\",\"intentDescription\":\"Check whether a credit memo transaction exists, either as a standard credit memo created against a specific invoice or as an on-account credit memo for a customer/account.\",\"keywords\":[\"credit memo issued\",\"credit memo created\",\"credit memo raised\",\"credit note issued\",\"credit against invoice\",\"standard credit memo\",\"on-account credit memo\",\"on account credit memo\",\"open credit memo\",\"outstanding credit memo\"],\"examples\":[\"Has a credit memo been issued against invoice 787?\",\"Show standard credit memos created for invoice 787.\",\"Is there an on-account credit memo for ST3 B11 Customer?\"],\"summaryInstruction\":\"Explain whether a credit memo transaction exists. For standard credit memos, show the previous/original invoice. For on-account credit memos, identify transactionClass ONACC and customer/account context. Use lineAmount as the displayed amount because this is a transaction-line grain.\",\"noDataMessage\":\"No credit memo transaction was found for the provided invoice, credit memo, customer, or account.\",\"followUps\":[\"Check what this credit memo was applied to\",\"Check dispute resolution status\",\"Check remaining invoice balance\"],\"tableColumns\":[\"creditMemoNumber\",\"creditMemoDate\",\"transactionClass\",\"previousTransactionNumber\",\"lineAmount\",\"currencyCode\",\"billToCustomerName\",\"billToAccountNumber\",\"transactionStatus\"],\"requiredAnchors\":[\"invoiceNumber\",\"creditMemoNumber\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"creditMemoNumber\",\"creditMemoDate\",\"transactionClass\",\"previousTransactionNumber\",\"previousCustomerTransactionId\",\"lineAmount\",\"creditMemoAmount\",\"currencyCode\",\"billToCustomerName\",\"billToAccountNumber\",\"transactionStatus\",\"creditMemoReason\"],\"documentCopy\":null},\"CHECK_INVOICE_ADJUSTMENTS\":{\"shapeKey\":\"adjustmentDetail\",\"queryName\":\"adjustmentDetail\",\"intentDescription\":\"Check whether receivables adjustments exist for an invoice/customer and show adjustment amount, type, reason, status, receivable activity, and remaining balance.\",\"keywords\":[\"adjustment\",\"adjusted\",\"invoice adjustment\",\"write off\",\"receivable activity\",\"adjustment status\",\"adjustment reason\",\"approved by\",\"approver\",\"who approved\",\"adjustment approval\",\"adjustment approved by\"],\"examples\":[\"Does invoice INV-30045 have any adjustments?\",\"Show adjustments for invoice 6140.\",\"What adjustment amount was posted for this customer?\",\"Who approved the adjustment on invoice 10320?\"],\"summaryInstruction\":\"Summarize adjustments on the invoice, including status, reason, amount, and remaining balance.\",\"noDataMessage\":\"No receivables adjustment was found for the provided invoice, adjustment number, customer, or account.\",\"followUps\":[\"Check current invoice balance\",\"Check credit memo activity\",\"Review dispute resolution status\"],\"tableColumns\":[\"transactionNumber\",\"adjustmentNumber\",\"adjustmentDate\",\"adjustmentAmount\",\"adjustmentTypeCode\",\"reasonCode\",\"statusMeaning\",\"approvedBy\",\"receivableActivityName\",\"amountDueRemaining\",\"customerName\"],\"requiredAnchors\":[\"invoiceNumber\",\"adjustmentNumber\",\"customerName\",\"accountNumber\",\"customerTransactionId\"],\"displayAttributes\":[\"transactionNumber\",\"adjustmentNumber\",\"adjustmentDate\",\"adjustmentAmount\",\"accountedAmount\",\"adjustmentTypeCode\",\"reasonCode\",\"statusMeaning\",\"approvedBy\",\"receivableActivityName\",\"amountDueRemaining\"],\"documentCopy\":null},\"CHECK_INVOICE_DUE_DATE_PAYMENT_TERMS\":{\"shapeKey\":\"paymentSchedule\",\"queryName\":\"paymentSchedule\",\"intentDescription\":\"Answer invoice due date, payment terms, installment due date, early payment discount, and grace-period questions.\",\"keywords\":[\"paid\",\"unpaid\",\"outstanding balance\",\"remaining balance\",\"open invoice\",\"partially paid\",\"due date\",\"payment terms\",\"discount date\",\"overdue\"],\"examples\":[\"Has invoice 115022 been paid?\",\"What is the remaining balance on invoice NOR-IMP-AR06?\",\"When is invoice 115022 due for payment?\",\"What are the payment terms on this invoice?\"],\"summaryInstruction\":\"State the invoice due date, payment term, remaining balance, and any available discount or grace-period information.\",\"noDataMessage\":\"No due date or payment term information was found for the provided invoice, customer, or account.\",\"followUps\":[\"Check whether the invoice has been paid\",\"Review invoice line charges\",\"Check invoice delivery status\"],\"tableColumns\":[\"invoiceNumber\",\"paymentDueDate\",\"installmentStatus\",\"originalAmount\",\"amountApplied\",\"amountRemaining\",\"currencyCode\",\"customerName\",\"accountName\",\"paymentTermName\",\"businessUnitName\"],\"requiredAnchors\":[\"invoiceNumber\",\"customerTransactionId\",\"customerName\",\"accountName\",\"accountNumber\",\"businessUnitName\"],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"paymentDueDate\",\"transactionHeaderDueDate\",\"installmentStatus\",\"originalAmount\",\"amountApplied\",\"amountRemaining\",\"amountAdjusted\",\"amountCredited\",\"earnedDiscount\",\"unearnedDiscount\",\"currencyCode\",\"customerName\",\"accountName\",\"accountNumber\",\"paymentTermName\",\"overdueFlag\",\"businessUnitName\"],\"documentCopy\":null},\"CHECK_SALES_ORDER_FULFILLMENT_LINES\":{\"shapeKey\":\"fulfillmentLine\",\"queryName\":\"fulfillmentLine\",\"intentDescription\":\"Check the source sales order in Order Management fulfillment lines when no Receivables invoice is found yet, or when the user explicitly asks for sales order fulfillment, order line status, bill-to, ship-to, item, or OM order context.\",\"keywords\":[\"search sales order in Order Management\",\"check sales order in Order Management\",\"fulfillment line\",\"fulfillment status\",\"order line status\",\"source order\",\"sales order status\",\"OM fallback\",\"not invoiced yet\"],\"examples\":[\"Search sales order 521104334545 in Order Management.\",\"Check fulfillment lines for sales order 521104334545.\",\"Show order status and fulfillment details for sales order 521104334545.\"],\"summaryInstruction\":\"Summarize Order Management fulfillment-line context for the supplied sales order, including order status, line status, ordered and fulfilled quantities, bill-to customer, ship-to party, item, and whether billing setup appears present when available. Do not claim an AR invoice exists from this extract.\",\"noDataMessage\":\"No Order Management fulfillment line was found for the provided sales order, PO, customer, or account details.\",\"followUps\":[\"Locate invoice by this sales order\",\"Search by customer/account\",\"Check invoice again after fulfillment or billing completes\"],\"tableColumns\":[\"salesOrderSourceOrderNumber\",\"fulfillLineNumber\",\"statusDisplayName\",\"orderedQuantity\",\"fulfilledQuantity\",\"fulfillmentDate\",\"salesOrderStatusDisplayName\",\"salesOrderBillingSetFlag\",\"billToCustomerName\",\"billToCustomerAccountNumber\",\"inventoryItemNumber\",\"salesOrderCustomerPoNumber\"],\"requiredAnchors\":[\"salesOrderNumber\",\"poNumber\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"salesOrderSourceOrderNumber\",\"fulfillLineNumber\",\"statusDisplayName\",\"orderedQuantity\",\"fulfilledQuantity\",\"fulfillmentDate\",\"salesOrderStatusDisplayName\",\"salesOrderBillingSetFlag\",\"billToCustomerName\",\"billToCustomerAccountNumber\",\"inventoryItemNumber\",\"salesOrderCustomerPoNumber\"],\"documentCopy\":null},\"CHECK_INVOICE_PAYMENT_TERM_DISCOUNTS\":{\"shapeKey\":\"invoicePaymentTermDiscountRules\",\"queryName\":\"invoiceTermLineDiscountRows\",\"intentDescription\":\"Explain invoice installment payment-term lines and configured early-payment discount tiers for an invoice. One term line can have multiple discount lines, so the displayed grain is one row per discount tier.\",\"keywords\":[\"payment term discount\",\"discount tiers\",\"early payment discount rules\",\"discount percent\",\"discount days\",\"term lines\",\"payment term lines\",\"grace days\",\"discount rule\",\"relative amount\",\"site discount grace days\",\"account discount grace days\",\"term line details\",\"payment term line details\",\"payment term discount rules\",\"due date and early payment discount\",\"due date and discount\",\"payment due date and discount\",\"discount due date\",\"early payment discount due date\"],\"examples\":[\"What payment term discount rules apply to invoice 101241?\",\"Show the payment term lines and discount tiers for invoice 101241.\",\"Does invoice 101241 have any early payment discount rule?\",\"Show relative amount, discount percent, and discount days for invoice 101241.\",\"What are the payment term line details for invoice 101241?\"],\"summaryInstruction\":\"State the invoice payment term, installment due date, term-line due rule, account/site grace days, and each configured discount percent/due-days tier exposed by the discount detail view.\",\"noDataMessage\":\"No payment-term line or discount tier information was found for the provided invoice, customer transaction, customer, or account.\",\"followUps\":[\"Check invoice payment balance\",\"Review invoice line charges\",\"Check invoice adjustments\"],\"tableColumns\":[\"invoiceNumber\",\"paymentTermName\",\"termsSequenceNumber\",\"paymentDueDate\",\"termLineDueDays\",\"discountId\",\"discountPercent\",\"discountDueDays\",\"discountDueDate\",\"accountDiscountGraceDays\",\"siteDiscountGraceDays\"],\"requiredAnchors\":[\"invoiceNumber\",\"customerTransactionId\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"invoiceNumber\",\"transactionDate\",\"transactionHeaderDueDate\",\"installmentStatus\",\"termsSequenceNumber\",\"paymentDueDate\",\"amountDueOriginal\",\"amountDueRemaining\",\"discountTakenEarned\",\"discountTakenUnearned\",\"paymentTermId\",\"paymentTermName\",\"businessUnitName\",\"accountName\",\"accountNumber\",\"accountDiscountGraceDays\",\"siteDiscountGraceDays\",\"termLineDueDays\",\"termLineDueDate\",\"termLineDueByDayOfMonth\",\"termLineDueByMonthsAhead\",\"discountId\",\"discountPercent\",\"discountDueDays\",\"discountDueDate\",\"discountDueDayOfMonth\",\"discountDueMonthsAhead\",\"setId\"],\"documentCopy\":null,\"exampleUtterances\":[\"Show the due date and early payment discount for invoice 101241.\",\"What is the due date and discount due date for invoice 101241?\"]},\"OUT_OF_SCOPE_BILLING_REQUEST\":{\"shapeKey\":null,\"queryName\":null,\"intentDescription\":\"Reject requests outside Oracle Receivables Billing inquiry scope.\",\"keywords\":[\"out of scope\",\"unrelated request\",\"off topic\"],\"examples\":[\"What is the weather today?\",\"Write a Python script for me.\",\"What is Oracle stock price?\"],\"summaryInstruction\":\"Politely decline out-of-domain requests and redirect the user to Oracle Receivables Billing inquiry topics.\",\"noDataMessage\":\"I can help with Oracle Receivables Billing inquiries such as invoice lookup, payment balance, due dates, delivery, document copy, line charges, tax charges, FX conversion, disputes, credit memos, and adjustments. Please ask a Billing inquiry question.\",\"followUps\":[\"Find invoice by sales order\",\"Check payment balance for an invoice\",\"Review invoice line charges\"],\"tableColumns\":[],\"requiredAnchors\":[],\"displayAttributes\":[],\"documentCopy\":null},\"CHECK_CREDIT_MEMO_APPLICATION\":{\"shapeKey\":\"creditMemoApplication\",\"queryName\":\"creditMemoApplication\",\"intentDescription\":\"Check credit memo application details: what invoice a credit memo was applied to, applied amount, application date, application status, and remaining credit.\",\"keywords\":[\"credit memo application\",\"credit memo applied\",\"applied credit memo\",\"what was applied\",\"when was credit memo applied\",\"applied amount\",\"application date\",\"credit applied to invoice\"],\"examples\":[\"What was credit memo CM-100 applied to?\",\"When was the credit memo applied to invoice 787?\",\"Show credit memo application details for invoice 787.\"],\"summaryInstruction\":\"Explain what the credit memo was applied to, how much was applied, when it was applied, and whether remaining credit is available.\",\"noDataMessage\":\"No credit memo application was found for the provided invoice, credit memo, customer, or account.\",\"followUps\":[\"Check credit memo transaction details\",\"Check dispute resolution status\",\"Check remaining invoice balance\"],\"tableColumns\":[\"invoiceNumber\",\"creditMemoNumber\",\"creditMemoDate\",\"customerName\",\"appliedAmount\",\"applicationDate\",\"applicationStatus\",\"creditMemoOriginalAmount\",\"creditMemoRemainingAmount\",\"creditMemoInstallmentStatus\"],\"requiredAnchors\":[\"invoiceNumber\",\"creditMemoNumber\",\"customerName\",\"accountNumber\"],\"displayAttributes\":[\"invoiceNumber\",\"creditMemoNumber\",\"creditMemoDate\",\"customerName\",\"billToAccountNumber\",\"currencyCode\",\"appliedAmount\",\"applicationDate\",\"applicationStatus\",\"creditMemoOriginalAmount\",\"creditMemoRemainingAmount\",\"creditMemoInstallmentStatus\"],\"documentCopy\":null},\"REVIEW_CUSTOMER_TOTAL_OUTSTANDING_BALANCE\":{\"shapeKey\":\"customerOutstandingBalance\",\"queryName\":\"customerOutstandingBalance\",\"intentDescription\":\"Review total open AR balance for a customer, account, or business unit across invoices using the ReceivablesBalance analytic view. This intent returns aggregate balance totals, not individual invoice records.\",\"keywords\":[\"total outstanding balance\",\"customer owes\",\"amount owed\",\"open AR balance\",\"AR balance\",\"total amount due\",\"aggregate balance\",\"current balance\",\"customer balance\",\"account balance\",\"total open balance\",\"dispute exposure\"],\"examples\":[\"What is the total amount World of Business owes us?\",\"Give me the current open AR balance for account FRW2.\",\"How much is outstanding for customer World of Business in business unit Vision Operations?\",\"Show total outstanding balance and disputed amount for account 1001.\"],\"summaryInstruction\":\"Summarize aggregate open AR balance by customer/account and currency. Use invoiceRemainingAmount as the outstanding balance and disputeAmount as dispute exposure when present. Do not list individual invoices from this AV result.\",\"noDataMessage\":\"No aggregate receivables balance was found for the provided customer, account, or business unit.\",\"followUps\":[\"Show open invoice details for this customer\",\"Review disputed invoices for this customer\",\"Check payment status for a specific invoice\"],\"tableColumns\":[\"customerName\",\"accountName\",\"accountNumber\",\"customerAccountId\",\"businessUnitName\",\"currencyCode\",\"invoiceRemainingAmount\",\"disputeAmount\"],\"requiredAnchors\":[\"customerName\",\"accountName\",\"accountNumber\",\"businessUnitName\"],\"displayAttributes\":[\"customerName\",\"accountName\",\"accountNumber\",\"customerAccountId\",\"businessUnitName\",\"currencyCode\",\"invoiceRemainingAmount\",\"disputeAmount\"],\"documentCopy\":null},\"REVIEW_DEFERRED_REVENUE_EARNING_SCHEDULE\":{\"shapeKey\":\"deferredRevenueSchedule\",\"queryName\":\"deferredRevenueSchedule\",\"intentDescription\":\"Review deferred revenue, recognized revenue, and earning schedule details for a specific Receivables invoice using transaction distribution rows. This is invoice/document-grain accounting distribution detail, not customer-level revenue analytics.\",\"keywords\":[\"deferred revenue\",\"earning schedule\",\"revenue recognition\",\"recognized revenue\",\"unearned revenue\",\"revenue schedule\",\"revenue scheduling rule\",\"accounting rule\",\"recognition period\",\"revenue recognition application\"],\"examples\":[\"How much of invoice 10320 is still unearned?\",\"Show the deferred revenue schedule for invoice 10320.\",\"When will revenue be recognized for invoice 10320?\",\"Show recognized vs unrecognized revenue for invoice 10320.\",\"Which invoice lines have deferred revenue?\"],\"summaryInstruction\":\"Summarize deferred and recognized revenue distribution rows for the invoice. Use accountClass UNEARN as deferred/unearned revenue and REV as recognized revenue. Include accounting date, amount, accounted amount, accounting rule, and revenue scheduling rule dates/periods when present. Do not infer revenue policy or root cause beyond returned distribution data.\",\"noDataMessage\":\"No deferred revenue or earning schedule distribution rows were found for the provided invoice or customer transaction id.\",\"followUps\":[\"Review invoice line charges\",\"Understand foreign currency conversion\",\"Check payment status for this invoice\"],\"tableColumns\":[\"transactionNumber\",\"lineNumber\",\"description\",\"accountClass\",\"accountingDate\",\"amount\",\"accountedAmount\",\"currencyCode\",\"accountingRuleName\",\"revenueSchedulingRuleStartDate\",\"revenueSchedulingRuleEndDate\",\"revenueSchedulingRuleNumberOfPeriods\",\"revenueRecognitionApplication\",\"businessUnitName\"],\"requiredAnchors\":[\"invoiceNumber\",\"customerTransactionId\"],\"displayAttributes\":[\"transactionNumber\",\"customerTransactionId\",\"transactionDate\",\"lineNumber\",\"description\",\"accountClass\",\"accountingDate\",\"amount\",\"accountedAmount\",\"currencyCode\",\"accountingRuleName\",\"revenueSchedulingRuleStartDate\",\"revenueSchedulingRuleEndDate\",\"revenueSchedulingRuleNumberOfPeriods\",\"revenueRecognitionApplication\",\"businessUnitName\"],\"documentCopy\":null}}"
