s field.\",\"sourcePath\":\"amountCredited\",\"tablePriority\":10},{\"attributeName\":\"earnedDiscount\",\"queryField\":\"earnedDiscount\",\"description\":\"Earned discount amount on the payment schedule.\",\"businessMeaning\":\"Discount taken because payment conditions were met within the discount window.\",\"dataType\":\"Number\",\"category\":\"Payment Amounts\",\"semanticRole\":\"discountAmount\",\"synonyms\":[\"earned discount\",\"discount taken\",\"payment discount\",\"earnedDiscount\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"currencyAmount\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"earnedDiscount\",\"tablePriority\":11},{\"attributeName\":\"unearnedDiscount\",\"queryField\":\"unearnedDiscount\",\"description\":\"Unearned discount amount on the payment schedule.\",\"businessMeaning\":\"Potential or missed discount amount not earned under payment timing rules.\",\"dataType\":\"Number\",\"category\":\"Payment Amounts\",\"semanticRole\":\"discountAmount\",\"synonyms\":[\"unearned discount\",\"missed discount\",\"available discount\",\"unearnedDiscount\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"currencyAmount\",\"summaryBehavior\":\"Use in the user-facing table and concise summary when populated.\",\"nullHandling\":\"If null or blank, omit from prose summaries unless the user explicitly asks for this field.\",\"sourcePath\":\"unearnedDiscount\",\"tablePriority\":12},{\"attributeName\":\"currencyCode\",\"queryField\":\"currencyCode\",\"description\":\"Currency code for the invoice, credit memo, adjustment, or payment schedule.\",\"businessMeaning\":\"Entered currency used to interpret monetary amounts.\",\"dataType\":\