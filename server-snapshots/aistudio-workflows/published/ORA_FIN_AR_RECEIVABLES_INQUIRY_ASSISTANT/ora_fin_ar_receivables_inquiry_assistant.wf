nyms\":[\"transactionClass\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"transactionClass\",\"tablePriority\":3},{\"attributeName\":\"previousTransactionNumber\",\"queryField\":\"previousTransactionNumber\",\"description\":\"Original invoice number referenced by a standard credit memo. Null for on-account credit memos.\",\"businessMeaning\":\"Original invoice number referenced by a standard credit memo. Null for on-account credit memos.\",\"dataType\":\"String\",\"category\":\"Credit Memo\",\"semanticRole\":\"reference\",\"synonyms\":[\"previousTransactionNumber\"],\"filterAnchors\":[\"invoiceNumber\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"customerTransaction.previousTransaction.transactionNumber\",\"tablePriority\":4},{\"attributeName\":\"creditMemoAmount\",\"queryField\":\"creditMemoAmount\",\"description\":\"Credit memo transaction amount.\",\"businessMeaning\":\"Header-level credit memo amount if populated by the view. It may be null for CM rows, so lineAmount is preferred for display.\",\"dataType\":\"Number\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"synonyms\":[\"creditMemoAmount\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"],\"format\":\"currencyAmount\",\"summaryBehavior\":\"Use only when populated; otherwise use lineAmount.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"creditMemoAmount\",\"tablePriority\":5},{\"attributeName\":\"currencyCode\",\"queryField\":\"currencyCode\",\"description\":\"Credit memo transaction currency.\",\"businessMeaning\":\"Credit memo transaction currency.\",\"dataType\":\"String\",\"category\":\"Credit Memo\",\"semanticRole\":\"currency\",\"synonyms\":[\"currencyCode\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"currencyCode\",\"tablePriority\":6},{\"attributeName\":\"billToCustomerName\",\"queryField\":\"billToCustomerName\",\"description\":\"Bill-to customer name on the credit memo.\",\"businessMeaning\":\"Bill-to customer name on the credit memo.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"customerName\",\"synonyms\":[\"billToCustomerName\"],\"filterAnchors\":[\"customerName\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"billToCustomerName\",\"tablePriority\":7},{\"attributeName\":\"billToAccountNumber\",\"queryField\":\"billToAccountNumber\",\"description\":\"Bill-to customer account number on the credit memo.\",\"businessMeaning\":\"Bill-to customer account number on the credit memo.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"accountNumber\",\"synonyms\":[\"billToAccountNumber\"],\"filterAnchors\":[\"accountNumber\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"billToAccountNumber\",\"tablePriority\":8},{\"attributeName\":\"transactionStatus\",\"queryField\":\"transactionStatus\",\"description\":\"Credit memo transaction status.\",\"businessMeaning\":\"Credit memo transaction status.\",\"dataType\":\"String\",\"category\":\"Status\",\"semanticRole\":\"status\",\"synonyms\":[\"transactionStatus\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"transactionStatus\",\"tablePriority\":9},{\"attributeName\":\"creditMemoReason\",\"queryField\":\"creditMemoReason\",\"description\":\"Reason on the credit memo transaction.\",\"businessMeaning\":\"Reason on the credit memo transaction.\",\"dataType\":\"String\",\"category\":\"Credit Memo\",\"semanticRole\":\"reason\",\"synonyms\":[\"creditMemoReason\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"summaryBehavior\":\"Use in credit memo issued/on-account credit memo answers when populated.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"creditMemoReason\",\"tablePriority\":10},{\"attributeName\":\"lineAmount\",\"queryField\":\"lineAmount\",\"description\":\"Credit memo line amount.\",\"businessMeaning\":\"Credit memo line amount. Use this as the displayed amount for the transaction-line grain and aggregate by creditMemoNumber only when a header-level total is needed.\",\"dataType\":\"Number\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"synonyms\":[\"lineAmount\"],\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\",\">\",\">=\",\"<\",\"<=\"],\"format\":\"currencyAmount\",\"summaryBehavior\":\"Use as the visible credit memo amount in tables; multiple rows may need grouping by creditMemoNumber.\",\"nullHandling\":\"If null or blank, omit from prose unless this distinguishes standard from on-account credit memo.\",\"sourcePath\":\"lineAmount\",\"tablePriority\":null}],\"dateFilterField\":\"creditMemoDate\",\"defaultDateWindowDays\":90,\"defaultDateWindowAnchors\":[\"customerName\",\"accountNumber\"]},\"receivablesInvoiceTaxDetail\":{\"filters\":{\"invoiceNumber\":\"customerTransactionTransactionNumber\",\"poNumber\":\"customerTransactionPONumber\",\"accountName\":\"customerTransactionBillToCustomerAccountAccountName\",\"accountNumber\":\"customerTransactionBillToCustomerAccountAccountNumber\"},\"dateFilterField\":\"customerTransactionTransactionDate\",\"displayAttributes\":[\"customerTransactionLineId\",\"lineNumber\",\"description\",\"extendedAmount\",\"grossExtendedAmount\",\"taxableAmount\",\"taxRate\",\"taxExemptionCertificateNumber\",\"amountIncludesTax\",\"taxable\",\"productCategory\",\"productFiscalClassification\",\"productType\",\"transactionBusinessCategory\",\"userDefinedFiscalClassification\",\"customerTransactionTransactionNumber\",\"customerTransactionTransactionDate\",\"customerTransactionBillReceivableAmount\",\"customerTransactionPONumber\",\"customerTransactionInvoiceCurrencyCurrencyCode\",\"customerTransactionBillToCustomerAccountAccountName\",\"customerTransactionBillToCustomerAccountAccountNumber\",\"customerTransactionTaxExemptMeaning\",\"customerTransactionTaxExemptLookupCode\",\"taxExemptMeaning\",\"taxExemptLookupCode\",\"taxExemptReasonMeaning\",\"taxExemptReasonLookupCode\"]},\"customerOutstandingBalance\":{\"catalogName\":\"customerOutstandingBalance\",\"catalogVersion\":\"rich-attribute-catalog-v2\",\"intent\":\"REVIEW_CUSTOMER_TOTAL_OUTSTANDING_BALANCE\",\"queryName\":\"customerOutstandingBalance\",\"module\":\"oraErpCoreReceivablesBilling\",\"analyticView\":\"ReceivablesBalance\",\"description\":\"Attributes used to answer customer/account aggregate open AR balance questions from ReceivablesBalance.\",\"primaryBusinessQuestion\":\"What total open receivables balance does this customer/account/business unit have, by currency?\",\"grain\":\"Aggregate ReceivablesBalance row at customer account and invoice currency level. This is not invoice-line or payment-schedule row grain.\",\"filterStrategy\":\"Use only customer, account, or business unit anchors explicitly provided by the user or carried in billing context. Do not auto-select customers or accounts.\",\"filters\":{\"customerName\":\"customerName\",\"accountName\":\"accountName\",\"accountNumber\":\"accountNumber\",\"businessUnitName\":\"businessUnitName\"},\"displayAttributes\":[\"customerName\",\"accountName\",\"accountNumber\",\"customerAccountId\",\"businessUnitName\",\"currencyCode\",\"invoiceRemainingAmount\",\"disputeAmount\"],\"identityAttributes\":[\"customerAccountId\",\"accountNumber\"],\"customerAttributes\":[\"customerName\",\"accountName\",\"accountNumber\",\"customerAccountId\"],\"amountAttributes\":[\"invoiceRemainingAmount\",\"disputeAmount\"],\"attributes\":[{\"attributeName\":\"customerName\",\"queryField\":\"customerName\",\"description\":\"Customer party name in the ReceivablesBalance customer hierarchy.\",\"businessMeaning\":\"Customer name for the aggregate balance row.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"customerName\",\"filterAnchors\":[\"customerName\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"LIKE\",\"IN\"],\"format\":\"text\",\"tablePriority\":1},{\"attributeName\":\"accountName\",\"queryField\":\"accountName\",\"description\":\"Customer account name in the ReceivablesBalance customer hierarchy.\",\"businessMeaning\":\"Account name for the aggregate balance row.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"accountName\",\"filterAnchors\":[\"accountName\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"LIKE\",\"IN\"],\"format\":\"text\",\"tablePriority\":2},{\"attributeName\":\"accountNumber\",\"queryField\":\"accountNumber\",\"description\":\"Customer account number in the ReceivablesBalance customer hierarchy.\",\"businessMeaning\":\"Account number used to scope aggregate balances at account level.\",\"dataType\":\"String\",\"category\":\"Customer\",\"semanticRole\":\"accountNumber\",\"filterAnchors\":[\"accountNumber\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"IN\"],\"format\":\"text\",\"tablePriority\":3},{\"attributeName\":\"customerAccountId\",\"queryField\":\"customerAccountId\",\"description\":\"Internal customer account identifier from the customer hierarchy.\",\"businessMeaning\":\"Stable account id for the aggregate balance row.\",\"dataType\":\"Number\",\"category\":\"Customer\",\"semanticRole\":\"primaryKey\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"integer\",\"tablePriority\":4},{\"attributeName\":\"businessUnitName\",\"queryField\":\"businessUnitName\",\"description\":\"Business unit name when the balance is scoped by business unit.\",\"businessMeaning\":\"Business unit filter/display value for aggregate balance.\",\"dataType\":\"String\",\"category\":\"Business Unit\",\"semanticRole\":\"businessUnitName\",\"filterAnchors\":[\"businessUnitName\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[\"=\",\"LIKE\",\"IN\"],\"format\":\"text\",\"tablePriority\":5},{\"attributeName\":\"currencyCode\",\"queryField\":\"currencyCode\",\"description\":\"Invoice currency code.\",\"businessMeaning\":\"Currency for the aggregate balance; totals must not be combined across currencies.\",\"dataType\":\"String\",\"category\":\"Currency\",\"semanticRole\":\"currency\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"currencyCode\",\"tablePriority\":6},{\"attributeName\":\"invoiceRemainingAmount\",\"queryField\":\"invoiceRemainingAmount\",\"description\":\"Aggregated outstanding invoice remaining amount.\",\"businessMeaning\":\"Total open receivables balance for the scoped customer/account/business unit and currency.\",\"dataType\":\"Number\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"currencyAmount\",\"tablePriority\":7},{\"attributeName\":\"disputeAmount\",\"queryField\":\"disputeAmount\",\"description\":\"Aggregated disputed amount.\",\"businessMeaning\":\"Total dispute exposure included in the ReceivablesBalance result for the same scope and currency.\",\"dataType\":\"Number\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"sortable\":true,\"operators\":[],\"format\":\"currencyAmount\",\"tablePriority\":8}]},\"deferredRevenueSchedule\":{\"catalogName\":\"deferredRevenueSchedule\",\"catalogVersion\":\"rich-attribute-catalog-v2\",\"intent\":\"REVIEW_DEFERRED_REVENUE_EARNING_SCHEDULE\",\"queryName\":\"deferredRevenueSchedule\",\"module\":\"oraErpCoreReceivablesBilling\",\"businessObject\":\"ReceivablesTransactionDistribution\",\"view\":\"receivablesTransactionDistributionDetail\",\"description\":\"Attributes used to answer invoice-level deferred revenue and earning schedule questions from Receivables transaction distributions.\",\"primaryBusinessQuestion\":\"What deferred and recognized revenue distribution schedule exists for this invoice?\",\"grain\":\"One accounting distribution row per invoice/transaction line accounting distribution. This is invoice/document-grain detail, not customer-level revenue aggregation.\",\"filterStrategy\":\"Require invoiceNumber or customerTransactionId. Use only user-provided or carried invoice anchors. Do not infer a customer or account into this distribution detail inquiry.\",\"filters\":{\"invoiceNumber\":\"transactionNumber\",\"customerTransactionId\":\"customerTransactionId\",\"businessUnitName\":\"businessUnitName\"},\"filterDefinitions\":[{\"anchor\":\"invoiceNumber\",\"queryField\":\"transactionNumber\",\"description\":\"Use transactionNumber when the user provides invoiceNumber.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveExact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"customerTransactionId\",\"queryField\":\"customerTransactionId\",\"description\":\"Use customerTransactionId when explicitly provided or carried from prior invoice lookup.\",\"dataType\":\"Number\",\"matchStrategy\":\"exact\",\"supportedOperators\":[\"=\",\"IN\"]},{\"anchor\":\"businessUnitName\",\"queryField\":\"businessUnitName\",\"description\":\"Optional business unit scoping for the invoice distribution rows.\",\"dataType\":\"String\",\"matchStrategy\":\"caseInsensitiveContains\",\"supportedOperators\":[\"LIKE\"]}],\"displayAttributes\":[\"transactionNumber\",\"customerTransactionId\",\"transactionDate\",\"lineNumber\",\"description\",\"accountClass\",\"accountingDate\",\"amount\",\"accountedAmount\",\"currencyCode\",\"accountingRuleName\",\"revenueSchedulingRuleStartDate\",\"revenueSchedulingRuleEndDate\",\"revenueSchedulingRuleNumberOfPeriods\",\"revenueRecognitionApplication\",\"businessUnitName\"],\"identityAttributes\":[\"transactionNumber\",\"customerTransactionId\",\"customerTransactionLineAccountingDistributionId\"],\"dateAttributes\":[\"transactionDate\",\"accountingDate\",\"postedDate\",\"originalAccountingDate\",\"revenueSchedulingRuleStartDate\",\"revenueSchedulingRuleEndDate\"],\"amountAttributes\":[\"amount\",\"accountedAmount\",\"revenueAmount\",\"extendedAmount\"],\"statusAttributes\":[\"accountClass\",\"transactionClass\"],\"semanticRules\":[\"accountClass UNEARN represents deferred or unearned revenue distribution rows.\",\"accountClass REV represents recognized revenue distribution rows.\",\"Do not use this shape for payment status, open invoices, customer balance, or due-date/payment-term questions.\"],\"attributes\":[{\"attributeName\":\"transactionNumber\",\"queryField\":\"transactionNumber\",\"description\":\"Invoice transaction number.\",\"dataType\":\"String\",\"category\":\"Invoice Identity\",\"semanticRole\":\"invoiceNumber\",\"filterAnchors\":[\"invoiceNumber\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"format\":\"text\",\"tablePriority\":1},{\"attributeName\":\"lineNumber\",\"queryField\":\"lineNumber\",\"description\":\"Invoice line number for the distribution row.\",\"dataType\":\"String\",\"category\":\"Line\",\"semanticRole\":\"lineNumber\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"text\",\"tablePriority\":2},{\"attributeName\":\"description\",\"queryField\":\"description\",\"description\":\"Invoice line description.\",\"dataType\":\"String\",\"category\":\"Line\",\"semanticRole\":\"description\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"text\",\"tablePriority\":3},{\"attributeName\":\"accountClass\",\"queryField\":\"accountClass\",\"description\":\"Distribution account class. UNEARN means deferred/unearned revenue; REV means recognized revenue.\",\"dataType\":\"String\",\"category\":\"Revenue Recognition\",\"semanticRole\":\"classification\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"code\",\"tablePriority\":4},{\"attributeName\":\"accountingDate\",\"queryField\":\"accountingDate\",\"description\":\"Accounting date for the distribution row and earning schedule period.\",\"dataType\":\"Date\",\"category\":\"Revenue Recognition\",\"semanticRole\":\"date\",\"filterAnchors\":[\"dateFrom\",\"dateTo\"],\"filterable\":true,\"projectable\":true,\"display\":true,\"format\":\"date\",\"tablePriority\":5},{\"attributeName\":\"amount\",\"queryField\":\"amount\",\"description\":\"Entered distribution amount.\",\"dataType\":\"BigDecimal\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"currencyAmount\",\"tablePriority\":6},{\"attributeName\":\"accountedAmount\",\"queryField\":\"accountedAmount\",\"description\":\"Ledger/accounted distribution amount.\",\"dataType\":\"BigDecimal\",\"category\":\"Amount\",\"semanticRole\":\"amount\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"currencyAmount\",\"tablePriority\":7},{\"attributeName\":\"currencyCode\",\"queryField\":\"currencyCode\",\"description\":\"Invoice currency code for amount display.\",\"dataType\":\"String\",\"category\":\"Currency\",\"semanticRole\":\"currency\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"currencyCode\",\"tablePriority\":8},{\"attributeName\":\"accountingRuleName\",\"queryField\":\"accountingRuleName\",\"description\":\"Accounting rule attached to the transaction line.\",\"dataType\":\"String\",\"category\":\"Revenue Recognition\",\"semanticRole\":\"ruleName\",\"filterAnchors\":[],\"filterable\":false,\"projectable\":true,\"display\":true,\"format\":\"text\",\"tablePriority\":9},{\"attributeName\":\"revenueSchedulingRuleStartDate\",\"queryField\":