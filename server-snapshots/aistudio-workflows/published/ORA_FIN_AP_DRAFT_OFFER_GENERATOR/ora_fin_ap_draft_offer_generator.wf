            "name": "Update Group By Filter Based On User Input"
          },
          "outcomes": {
            "success": "1773257946916"
          },
          "code": "FIN_AP_LLM_UPDATE_GROUP_BY_FILTER_BASED_ON_USER_INPUT",
          "id": "1771654220283",
          "inputs": [
            {
              "id": "1771654220284_1",
              "name": "prompt",
              "type": "string",
              "value": "# CONTEXT\n\n    - User message: {{$context.$system.$inputMessage}}\n    - Current Group By Filter: {{$context.$nodes.FIN_AP_CODE_CREATE_GROUP_BY_FILTER.$output.result}}\n    - Group By Filter Shape: [{ \"supplierName\": \"<string>\", \"sevenDayBucket\": \"<string>\" }, ...]\n\n# OBJECTIVE\n\n    - Return an updated groupByFilter array based on any supplier and/or week constraints explicitly requested in the user message.\n\n# RULES\n\n    - Start with the provided Group By Filter as the source of truth (do not invent new suppliers or buckets).\n    - Supplier filtering (if explicitly requested):\n        - If the user explicitly asks to create a draft offer for one or more specific suppliers, keep only objects whose supplierName matches those supplier(s).\n    - Week filtering (if explicitly requested):\n        - If the user explicitly asks to create a draft offer for a specific week, keep only objects whose sevenDayBucket corresponds to that week:\n          - Week 1: days 1–7\n          - Week 2: days 8–14\n          - Week 3: days 15–21\n          - Continue the same pattern as needed.\n    - Combined constraints:\n        - If the user specifies both suppliers and week, apply both filters (intersection).\n    - No explicit constraints:\n        - If the user does not explicitly constrain suppliers and/or week, return the original Group By Filter unchanged.\n\n# OUTPUT\n\n  - Return the updated array in the following JSON shape:\n  { \"groupByFilter\": [ ... ] }"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"groupByFilter\": {\n            \"type\": \"array\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Remove invoiceRemainingAmount From Group By Filter",
            "returnType": "array",
            "sourceCode": "let list = $context.$nodes.FIN_AP_LLM_UPDATE_GROUP_BY_FILTER_BASED_ON_USER_INPUT.$output.groupByFilter;\n\nconst cleaned = list.map(({ supplierName, sevenDayBucket }) => ({\n  supplierName,\n  sevenDayBucket\n}));\n\nreturn cleaned;"
          },
