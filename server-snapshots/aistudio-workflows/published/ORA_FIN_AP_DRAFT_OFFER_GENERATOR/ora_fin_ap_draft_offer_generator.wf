          "inputs": [
            {
              "id": "1773258097217_1",
              "name": "financingProgramId",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_LLM_DYNAMIC_DISCOUNT_PROGRAM_SELECTOR.$output.dynamicDiscountProgramId}}"
