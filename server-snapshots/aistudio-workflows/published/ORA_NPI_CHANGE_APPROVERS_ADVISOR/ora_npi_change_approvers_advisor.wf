          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AssigneeName\": {\n            \"type\": \"string\",\n            \"description\": \"Name of the assignee, person or role\"\n          },\n          \"ActivityTypeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Type of activity (e.g., Review, Approval)\"\n          },\n          \"StatusCodeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Current status or phase of assigned activity\"\n          },\n          \"AssigneeTypeValue\": {\n            \"type\": \"string\",\n            \"description\": \"Type of assignee (Person or Role)\"\n          },\n          \"ResponseValue\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"Response of the assignee, can be null\"\n          },\n          \"Comments\": {\n            \"type\": [\"string\", \"null\"],\n            \"description\": \"Comments by the assignee, can be null\"\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"description\": \"Unique key for the context\"\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\",\n                    \"description\": \"Entity tag for concurrency\"\n                  }\n                },\n                \"required\": [\"ETag\"]\n              }\n            },\n            \"required\": [\"key\", \"headers\"]\n          }\n        },\n        \"required\": [\n          \"AssigneeName\",\n          \"ActivityTypeValue\",\n          \"StatusCodeValue\",\n          \"AssigneeTypeValue\",\n          \"ResponseValue\",\n          \"Comments\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": {\n      \"type\": \"integer\",\n      \"description\": \"Total number of items\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\",\n      \"description\": \"Indicates whether more records are available\"\n    },\n    \"limit\": {\n      \"type\": \"integer\",\n      \"description\": \"Pagination limit\"\n    },\n    \"offset\": {\n      \"type\": \"integer\",\n      \"description\": \"Pagination offset\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"description\": \"Link relation type\"\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"format\": \"uri\",\n            \"description\": \"Hyperlink reference\"\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"description\": \"Name of the link\"\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"description\": \"Kind of the linked resource\"\n          }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
