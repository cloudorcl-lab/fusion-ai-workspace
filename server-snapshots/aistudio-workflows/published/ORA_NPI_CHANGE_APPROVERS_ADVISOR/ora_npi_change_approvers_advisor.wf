            "errorNodeId": "1769550990146",
            "name": "GetDynamicFilter",
            "returnType": "object",
            "sourceCode": "const changeId= $context.$variables.ChangeId;\n\nif(!changeId){\nthrow new Error(\"Item or Org not found in context\");\n}\nconst filterValues = {\nchangeId: `${changeId}`,\nitemChangeOrderV2UsingId:`ChangeId=${changeId}&onlyData=true&fields=ChangeId,ChangeNotice,PriorityCodeValue,ApprovalStatusValue,ChangeTypeNameValue,CategoryCode,StatusComments,InitiationDateTime,AssignedToRole,NeedByDateTime`,\nitemSearchParams:`changeOrderParticipants?onlyData=true&fields=AssigneeName,ActivityTypeValue,StatusCodeValue,AssigneeTypeValue,ResponseValue,Comments`\n};\nreturn filterValues ;"
          },
          "outcomes": {
            "success": "1770931573536"
          },
          "code": "GETDYNAMICFILTER",
          "id": "1770720188165",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
