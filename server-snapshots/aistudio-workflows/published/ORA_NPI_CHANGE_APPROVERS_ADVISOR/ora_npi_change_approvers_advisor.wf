          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"ChangeId\": {\n            \"type\": \"string\"\n          },\n          \"ChangeTypeId\": {\n            \"type\": \"string\"\n          },\n          \"ChangeNotice\": {\n            \"type\": \"string\"\n          },\n          \"ChangeName\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {},\n          \"OrganizationId\": {\n            \"type\": \"string\"\n          },\n          \"PriorityCode\": {\n            \"type\": \"string\"\n          },\n          \"ReasonCode\": {},\n          \"ChangeTypeValue\": {\n            \"type\": \"string\"\n          },\n          \"OrganizationCode\": {\n            \"type\": \"string\"\n          },\n          \"PriorityCodeValue\": {\n            \"type\": \"string\"\n          },\n          \"ReasonCodeValue\": {},\n          \"AssigneeId\": {\n            \"type\": \"string\"\n          },\n          \"RequestorId\": {\n            \"type\": \"string\"\n          },\n          \"AssignedTo\": {\n            \"type\": \"string\"\n          },\n          \"RequestedBy\": {\n            \"type\": \"string\"\n          },\n          \"StatusType\": {\n            \"type\": \"string\"\n          },\n          \"StatusCode\": {\n            \"type\": \"string\"\n          },\n          \"ApprovalStatus\": {\n            \"type\": \"string\"\n          },\n          \"StatusTypeValue\": {\n            \"type\": \"string\"\n          },\n          \"StatusCodeValue\": {\n            \"type\": \"string\"\n          },\n          \"ApprovalStatusValue\": {\n            \"type\": \"string\"\n          },\n          \"EffectiveImmediatelyFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"EffectivityIncrementDays\": {\n            \"type\": \"number\"\n          },\n          \"CreatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdatedBy\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateLogin\": {\n            \"type\": \"string\"\n          },\n          \"AssignedToRole\": {},\n          \"ApprovalDateTime\": {},\n          \"NeedByDateTime\": {},\n          \"InitiationDateTime\": {\n            \"type\": \"string\"\n          },\n          \"ImplementationDateTime\": {},\n          \"CancellationDateTime\": {},\n          \"ApprovalRequestDateTime\": {\n            \"type\": \"string\"\n          },\n          \"CreationDateTime\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDateTime\": {\n            \"type\": \"string\"\n          },\n          \"StatusComments\": {},\n          \"CustomerId\": {},\n          \"CustomerAccountNumber\": {},\n          \"CustomerName\": {},\n          \"SupplierId\": {},\n          \"SupplierNumber\": {},\n          \"SupplierName\": {},\n          \"ManufacturerId\": {},\n          \"ManufacturerRegistryId\": {},\n          \"ManufacturerName\": {},\n          \"SourceCode\": {},\n          \"SourceName\": {},\n          \"CategoryCode\": {\n            \"type\": \"string\"\n          },\n          \"ChangeTypeNameValue\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteId\": {},\n          \"ReportedBy\": {},\n          \"ReportedDate\": {},\n          \"SupplierSiteCode\": {},\n          \"ReportedByUser\": {}\n        },\n        \"required\": [\n          \"ChangeId\",\n          \"ChangeTypeId\",\n          \"ChangeNotice\",\n          \"ChangeName\",\n          \"Description\",\n          \"OrganizationId\",\n          \"PriorityCode\",\n          \"ReasonCode\",\n          \"ChangeTypeValue\",\n          \"OrganizationCode\",\n          \"PriorityCodeValue\",\n          \"ReasonCodeValue\",\n          \"AssigneeId\",\n          \"RequestorId\",\n          \"AssignedTo\",\n          \"RequestedBy\",\n          \"StatusType\",\n          \"StatusCode\",\n          \"ApprovalStatus\",\n          \"StatusTypeValue\",\n          \"StatusCodeValue\",\n          \"ApprovalStatusValue\",\n          \"EffectiveImmediatelyFlag\",\n          \"EffectivityIncrementDays\",\n          \"CreatedBy\",\n          \"LastUpdatedBy\",\n          \"LastUpdateLogin\",\n          \"AssignedToRole\",\n          \"ApprovalDateTime\",\n          \"NeedByDateTime\",\n          \"InitiationDateTime\",\n          \"ImplementationDateTime\",\n          \"CancellationDateTime\",\n          \"ApprovalRequestDateTime\",\n          \"CreationDateTime\",\n          \"LastUpdateDateTime\",\n          \"StatusComments\",\n          \"CustomerId\",\n          \"CustomerAccountNumber\",\n          \"CustomerName\",\n          \"SupplierId\",\n          \"SupplierNumber\",\n          \"SupplierName\",\n          \"ManufacturerId\",\n          \"ManufacturerRegistryId\",\n          \"ManufacturerName\",\n          \"SourceCode\",\n          \"SourceName\",\n          \"CategoryCode\",\n          \"ChangeTypeNameValue\",\n          \"SupplierSiteId\",\n          \"ReportedBy\",\n          \"ReportedDate\",\n          \"SupplierSiteCode\",\n          \"ReportedByUser\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
