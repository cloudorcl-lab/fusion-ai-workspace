            "name": "Identify Missing Attributes",
            "returnType": "array",
            "sourceCode": "let adjustmentAttr = $context.$variables.prjPjcVarUqAdjustmentAttributes ;\nlet missingAttributes = [];\n\nif (adjustmentAttr == null || adjustmentAttr === \"\") {\n  adjustmentAttr = {};\n}\n\nif (adjustmentAttr[\"Justification\"] == null || adjustmentAttr[\"Justification\"] === \"\") {\n  missingAttributes.push(\"Justification\");\n}\n\nlet expTypeAdj = false;\nlet projectRoleAdj = false;\n\nif (adjustmentAttr[\"ExpenditureType\"] != null && adjustmentAttr[\"ExpenditureType\"] !== \"\") {\n  expTypeAdj = true;\n}\n\nif (adjustmentAttr[\"ProjectRoleName\"] != null && adjustmentAttr[\"ProjectRoleName\"] !== \"\") {\n  projectRoleAdj = true;\n}\n\nif (adjustmentAttr[\"Project\"] != null && adjustmentAttr[\"Project\"] !== \"\") {\n  if (adjustmentAttr[\"Task\"] == null || adjustmentAttr[\"Task\"] === \"\") {\n    missingAttributes.push(\"Task\");\n    return missingAttributes;\n  }\n}\n\nif (adjustmentAttr[\"Project\"] == null || adjustmentAttr[\"Project\"] === \"\") {\n  if (!expTypeAdj && !projectRoleAdj && (adjustmentAttr[\"Task\"] == null || adjustmentAttr[\"Task\"] === \"\")) {\n    missingAttributes.push(\"Project and Task\");\n    return missingAttributes;\n  }\n  if (!expTypeAdj && !projectRoleAdj) {\n    missingAttributes.push(\"Project\");\n    return missingAttributes;\n  }\n\n  if (adjustmentAttr[\"Task\"] != null && adjustmentAttr[\"Task\"] !== \"\") {\n    missingAttributes.push(\"Project\");\n    return missingAttributes;\n  } else if (adjustmentAttr[\"Contract\"] != null && adjustmentAttr[\"Contract\"] !== \"\") {\n    missingAttributes.push(\"Project\");\n    return missingAttributes;\n  } else if (adjustmentAttr[\"FundingSource\"] != null && adjustmentAttr[\"FundingSource\"] !== \"\") {\n    missingAttributes.push(\"Project\");\n    return missingAttributes;\n  }\n}\n\nif (adjustmentAttr[\"Contract\"] != null && adjustmentAttr[\"Contract\"] !== \"\") {\n  if (adjustmentAttr[\"FundingSource\"] == null || adjustmentAttr[\"FundingSource\"] === \"\") {\n    missingAttributes.push(\"FundingSource\");\n    return missingAttributes;\n  }\n}\n\nif (adjustmentAttr[\"FundingSource\"] != null && adjustmentAttr[\"FundingSource\"] !== \"\") {\n  if (adjustmentAttr[\"Contract\"] == null || adjustmentAttr[\"Contract\"] === \"\") {\n    missingAttributes.push(\"Contract\");\n    return missingAttributes;\n  }\n}\n\nreturn missingAttributes;"
          },
          "outcomes": {
            "success": "1771914227671"
          },
