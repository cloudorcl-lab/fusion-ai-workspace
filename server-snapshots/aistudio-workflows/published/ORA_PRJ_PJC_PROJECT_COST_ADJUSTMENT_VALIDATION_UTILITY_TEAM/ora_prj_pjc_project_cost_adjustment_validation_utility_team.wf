            "sourceCode": "let temp1 = $context.$variables.prjPjcVarUqAdjustmentAttributes;\nlet temp2 = $context.$nodes.VALIDATE_PROJECT.$output?.items ?? [];\nlet valueNumber = \"\";\nlet valueName = \"\";\nlet valueId = -1;\nlet ifValueNumber = false;\nif (Array.isArray(temp2) && temp2.length > 0) {\n  valueNumber = temp2[0].projectNumber; \n  valueName = temp2[0].name;\n  valueId = temp2[0].id;\n}\nif(valueId != null && valueId !== -1){\n   temp1['ProjectId'] = valueId;\n}\nif(valueNumber === $context.$variables.prjPjcVarUqAdjustmentAttributes['Project']){\n   temp1['ProjectNumber'] = valueNumber;\n   temp1['ProjectName'] = null;\n   ifValueNumber = true;\n}\nif(valueName === $context.$variables.prjPjcVarUqAdjustmentAttributes['Project'] && !ifValueNumber){\n   temp1['ProjectName'] = valueName;\n   temp1['ProjectNumber'] = null;\n}\nreturn temp1;"
