              "name": "message",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "action allowed for selected action",
            "returnType": "string",
            "sourceCode": "var selectedAction = $context.$variables.action;\nvar actionAllowed = \"INVALID_ACTION\";\nvar actionMap = $context.$variables.applicableActionMap;\nif(selectedAction == \"REASSIGN_ACTION\"){\n     if(actionMap[\"result\"][\"REASSIGN\" ][\"enabled\"] === true || \"true\" === actionMap[\"result\"][\"REASSIGN\" ][\"enabled\"]){\n          actionAllowed = \"Action_Allowed\";\n      } else {\n         actionAllowed =  \"Action_Not_Allowed\";\n      }\n} else if(selectedAction == \"WITHDRAW_ACTION\"){\n     if(actionMap[\"result\"][\"WITHDRAW\" ][\"enabled\"] === true || \"true\" === actionMap[\"result\"][\"WITHDRAW\" ][\"enabled\"]){\n          actionAllowed =  \"Action_Allowed\";\n      } else {\n         actionAllowed =  \"Action_Not_Allowed\";\n      }\n} else if(selectedAction == \"APPROVE_ACTION\"){\n     if(actionMap[\"result\"][\"APPROVE\" ][\"enabled\"] === true  || \"true\" === actionMap[\"result\"][\"APPROVE\" ][\"enabled\"]){\n          actionAllowed =  \"Action_Allowed\";\n      } else {\n         actionAllowed =  \"Action_Not_Allowed\";\n      }\n} else if(selectedAction == \"REJECT_ACTION\"){\n     if(actionMap[\"result\"][\"REJECT\" ][\"enabled\"] === true || \"true\" === actionMap[\"result\"][\"REJECT\" ][\"enabled\"]){\n          actionAllowed =  \"Action_Allowed\";\n      } else {\n         actionAllowed =  \"Action_Not_Allowed\";\n      }\n} else {\n         actionAllowed =  \"INVALID_ACTION\";\n}\nreturn actionAllowed ;"
          },
          "outcomes": {
            "success": "1764261305261"
          },
          "code": "ACTION_ALLOWED_FOR_SELECTED_ACTION",
          "id": "1764260766335",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
