            "success": "1764081713838"
          },
          "code": "EXTRACT_ACTION_TO_PERFORM",
          "id": "1764081538601",
          "inputs": [
            {
              "id": "1764081538602_1",
              "name": "prompt",
              "type": "string",
              "value": "\nFrom the provided input message extract the action that the user wants to perform on the transaction ``` {{$context.$system.$inputMessage}} ```\nOnly following actions are available\n\nAPPROVE_ACTION\nREJECT_ACTION\nWITHDRAW_ACTION\nREASSIGN_ACTION\nASKING_APPLICABLE_ACTION\n\nIf the user asks to perform any action other than the above mentioned then respond with INVALID_ACTION\n\nExample\nuserInput: Approve 300103651358143\noutput: APPROVE_ACTION\n\nuserInput: Reject 300103651358143\noutput: REJECT_ACTION\n\nuserInput: Withdraw 300103651358143\noutput: WITHDRAW_ACTION\n\nuserInput: Reassign 300103651358143 to vmoss\noutput: REASSIGN_ACTION\n\n\nuserInput: what actions can be performed on 300103651358143 \noutput: ASKING_APPLICABLE_ACTION\n\nuserInput: Terminate 300103651358143 \noutput: INVALID_ACTION\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Action Variable"
          },
          "outcomes": {
            "success": "1764258228276"
          },
          "code": "SET_ACTION_VARIABLE",
          "id": "1764081713838",
          "inputs": [
            {
              "id": "1764081724056",
              "name": "action",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_ACTION_TO_PERFORM.$output}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "perform action on transaction"
          },
          "outcomes": {
            "APPROVE_ACTION": "1764081816668",
            "REJECT_ACTION": "1764081871889",
            "WITHDRAW_ACTION": "1764081922905",
            "REASSIGN_ACTION": "1764081976971",
            "INVALID_ACTION": "1764082017184",
            "ASKING_APPLICABLE_ACTION": "1765201426496"
          },
          "code": "PERFORM_ACTION_ON_TRANSACTION",
          "convergenceTargetId": "end",
