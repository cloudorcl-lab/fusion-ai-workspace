          "metadata": {
            "name": "Prepare Post Publish Validation Fetches",
            "returnType": "object",
            "sourceCode": "var result = {\n  planShouldFetch: false,\n  compensationPlanId: null,\n  planParserId: null,\n  componentFetches: [],\n  measureFetches: [],\n};\n\nvar asNumber = function(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  var n = Number(value);\n  return isNaN(n) ? null : n;\n};\n\nvar addUniqueById = function(target, seen, type, parserId, icId, name) {\n  var numericId = asNumber(icId);\n  if (numericId === null) {\n    return;\n  }\n  var key = String(numericId);\n  if (seen[key] === true) {\n    return;\n  }\n  seen[key] = true;\n  target.push({\n    type: type,\n    parserId: parserId ? String(parserId) : null,\n    name: name ? String(name) : null,\n    icId: numericId,\n  });\n};\n\nvar createdEntities = $context.$variables.createdEntities ? $context.$variables.createdEntities : [];\nvar idMappings = $context.$variables.idMappings ? $context.$variables.idMappings : new Object();\nvar seenPlans = new Object();\nvar seenComponents = new Object();\nvar seenMeasures = new Object();\nvar idx = 0;\n\nfor (idx = 0; idx < createdEntities.length; idx += 1) {\n  var entity = createdEntities[idx] ? createdEntities[idx] : new Object();\n  var entityType = entity.type ? String(entity.type) : '';\n  if (entityType === 'plan') {\n    var createdPlanId = asNumber(entity.icId);\n    if (createdPlanId !== null) {\n      seenPlans[String(createdPlanId)] = true;\n      result.planShouldFetch = true;\n      result.compensationPlanId = createdPlanId;\n      result.planParserId = entity.parserId ? String(entity.parserId) : null;\n    }\n  }\n  if (entityType === 'component') {\n    addUniqueById(\n      result.componentFetches,\n      seenComponents,\n      'component',\n      entity.parserId,\n      entity.icId,\n      entity.name\n    );\n  }\n  if (entityType === 'measure') {\n    addUniqueById(\n      result.measureFetches,\n      seenMeasures,\n      'measure',\n      entity.parserId,\n      entity.icId,\n      entity.name\n    );\n  }\n}\n\nvar planMappings = idMappings.compensationPlans ? idMappings.compensationPlans : new Object();\nvar componentMappings = idMappings.components ? idMappings.components : new Object();\nvar measureMappings = idMappings.measures ? idMappings.measures : new Object();\n\nvar parserKeys = Object.keys(planMappings);\nfor (idx = 0; idx < parserKeys.length; idx += 1) {\n  var planParserId = parserKeys[idx];\n  var mappedPlanId = asNumber(planMappings[planParserId]);\n  if (mappedPlanId === null || seenPlans[String(mappedPlanId)] === true) {\n    continue;\n  }\n  seenPlans[String(mappedPlanId)] = true;\n  result.planShouldFetch = true;\n  result.compensationPlanId = mappedPlanId;\n  if (!result.planParserId) {\n    result.planParserId = planParserId;\n  }\n}\n\nparserKeys = Object.keys(componentMappings);\nfor (idx = 0; idx < parserKeys.length; idx += 1) {\n  var componentParserId = parserKeys[idx];\n  addUniqueById(\n    result.componentFetches,\n    seenComponents,\n    'component',\n    componentParserId,\n    componentMappings[componentParserId],\n    null\n  );\n}\n\nparserKeys = Object.keys(measureMappings);\nfor (idx = 0; idx < parserKeys.length; idx += 1) {\n  var measureParserId = parserKeys[idx];\n  addUniqueById(\n    result.measureFetches,\n    seenMeasures,\n    'measure',\n    measureParserId,\n    measureMappings[measureParserId],\n    null\n  );\n}\n\nreturn result;"
