            "sourceCode": "var transformed = ($context.$nodes.TRANSFORM_PLAN && $context.$nodes.TRANSFORM_PLAN.$output)\n  ? $context.$nodes.TRANSFORM_PLAN.$output.result\n  : new Object();\nvar prechecked = ($context.$nodes.APPLY_PUBLISH_PRECHECK && $context.$nodes.APPLY_PUBLISH_PRECHECK.$output)\n  ? $context.$nodes.APPLY_PUBLISH_PRECHECK.$output.result\n  : new Object();\n\nvar errors = new Array();\nvar warnings = new Array();\n\nvar pushError = function(code, message, path, context) {\n  errors.push({\n    code: code,\n    severity: 'ERROR',\n    message: message,\n    path: path || null,\n    context: context || null,\n  });\n};\n\nvar hasValue = function(value) {\n  return value !== null && value !== undefined && String(value).trim().length > 0;\n};\n\nvar countResolutionMappings = function(formula) {\n  var expression = formula && formula.expression ? formula.expression : null;\n  var resolution = expression && expression._resolution ? expression._resolution : null;\n  var mappings = resolution && resolution.mappings ? resolution.mappings : [];\n  return mappings.length;\n};\n\nvar countExpressionTokens = function(formula) {\n  var expression = formula && formula.expression ? formula.expression : null;\n  var tokens = expression && expression.tokens ? expression.tokens : [];\n  return tokens.length;\n};\n\nvar countDeclaredVariables = function(formula) {\n  var expression = formula && formula.expression ? formula.expression : null;\n  var variables = expression && expression.variables ? expression.variables : [];\n  return variables.length;\n};\n\nvar formulaNeedsMaterializedDetails = function(formula) {\n  return countResolutionMappings(formula) > 0 ||\n    countExpressionTokens(formula) > 0 ||\n    countDeclaredVariables(formula) > 0;\n};\n\nvar entityPayloads = transformed && transformed.entityPayloads ? transformed.entityPayloads : new Object();\nvar precheck = prechecked && prechecked.resolvedPlan && prechecked.resolvedPlan.metadata\n  ? prechecked.resolvedPlan.metadata.precheck\n  : null;\nvar gatePrecheck = transformed.gatePrecheck === true || prechecked.gatePrecheck === true;\nvar buildBlockingIssues = function(precheckResult) {\n  if (!precheckResult || typeof precheckResult !== 'object') {\n    return new Array();\n  }\n  var rawIssues = precheckResult.issues ? precheckResult.issues : [];\n  if ((!rawIssues || rawIssues.length === undefined || rawIssues.length === 0) && precheckResult.feedback && precheckResult.feedback.findings && precheckResult.feedback.findings.length !== undefined) {\n    rawIssues = precheckResult.feedback.findings;\n  }\n  var blockingIssues = new Array();\n  var ii = 0;\n  for (ii = 0; ii < rawIssues.length; ii += 1) {\n    var issue = rawIssues[ii] ? rawIssues[ii] : new Object();\n    var severity = issue.severity ? String(issue.severity).toUpperCase() : 'ERROR';\n    if (severity === 'ERROR') {\n      blockingIssues.push(issue);\n    }\n  }\n  return blockingIssues;\n};\nvar precheckBlockingIssues = gatePrecheck ? buildBlockingIssues(precheck) : [];\nvar transformPrecheckBlockingIssues = transformed && transformed.precheckBlockingIssues\n  ? transformed.precheckBlockingIssues\n  : [];\nvar transformWarnings = transformed && transformed.transformWarnings ? transformed.transformWarnings : [];\nvar i = 0;\n\nfor (i = 0; i < precheckBlockingIssues.length; i += 1) {\n  var issue = precheckBlockingIssues[i] ? precheckBlockingIssues[i] : new Object();\n  var severity = issue.severity ? String(issue.severity).toUpperCase() : 'ERROR';\n  if (severity === 'ERROR') {\n    errors.push(issue);\n  }\n}\nfor (i = 0; i < transformWarnings.length; i += 1) {\n  warnings.push({\n    code: 'TRANSFORM_WARNING',\n    severity: 'WARNING',\n    message: String(transformWarnings[i]),\n    path: null,\n    context: null,\n  });\n}\n\nif (gatePrecheck && transformPrecheckBlockingIssues.length > 0) {\n  var blockedResult = new Object();\n  blockedResult.passed = errors.length === 0;\n  blockedResult.errors = errors;\n  blockedResult.warnings = warnings;\n  return blockedResult;\n}\n\nvar plans = entityPayloads.compensationPlans ? entityPayloads.compensationPlans : [];\nfor (i = 0; i < plans.length; i += 1) {\n  var plan = plans[i] ? plans[i] : new Object();\n  if (!hasValue(plan.Name)) {\n    pushError('PAYLOAD_PLAN_NAME_REQUIRED', 'Compensation plan payload requires Name.', 'entityPayloads.compensationPlans[' + i + '].Name');\n  }\n  if (!hasValue(plan.StartDate)) {\n    pushError('PAYLOAD_PLAN_START_DATE_REQUIRED', 'Compensation plan payload requires StartDate.', 'entityPayloads.compensationPlans[' + i + '].StartDate');\n  }\n  if (!hasValue(plan.EndDate)) {\n    pushError('PAYLOAD_PLAN_END_DATE_REQUIRED', 'Compensation plan payload requires EndDate.', 'entityPayloads.compensationPlans[' + i + '].EndDate');\n  }\n  if (!hasValue(plan.OrgId)) {\n    pushError('PAYLOAD_PLAN_ORG_ID_REQUIRED', 'Compensation plan payload requires OrgId.', 'entityPayloads.compensationPlans[' + i + '].OrgId');\n  }\n}\n\nvar components = entityPayloads.components ? entityPayloads.components : [];\nfor (i = 0; i < components.length; i += 1) {\n  var component = components[i] ? components[i] : new Object();\n  if (!hasValue(component.Name)) {\n    pushError('PAYLOAD_COMPONENT_NAME_REQUIRED', 'Component payload requires Name.', 'entityPayloads.components[' + i + '].Name');\n  }\n  if (!hasValue(component.StartDate)) {\n    pushError('PAYLOAD_COMPONENT_START_DATE_REQUIRED', 'Component payload requires StartDate.', 'entityPayloads.components[' + i + '].StartDate');\n  }\n  if (!hasValue(component.EndDate)) {\n    pushError('PAYLOAD_COMPONENT_END_DATE_REQUIRED', 'Component payload requires EndDate.', 'entityPayloads.components[' + i + '].EndDate');\n  }\n  if (!hasValue(component.OrgId)) {\n    pushError('PAYLOAD_COMPONENT_ORG_ID_REQUIRED', 'Component payload requires OrgId.', 'entityPayloads.components[' + i + '].OrgId');\n  }\n  if (!hasValue(component.CalculateIncentive)) {\n    pushError('PAYLOAD_COMPONENT_CALCULATE_INCENTIVE_REQUIRED', 'Component payload requires CalculateIncentive.', 'entityPayloads.components[' + i + '].CalculateIncentive');\n  }\n  if (!hasValue(component.IncentiveType)) {\n    pushError('PAYLOAD_COMPONENT_INCENTIVE_TYPE_REQUIRED', 'Component payload requires IncentiveType.', 'entityPayloads.components[' + i + '].IncentiveType');\n  }\n}\n\nvar rateTables = entityPayloads.rateTables ? entityPayloads.rateTables : [];\nfor (i = 0; i < rateTables.length; i += 1) {\n  var rateTable = rateTables[i] ? rateTables[i] : new Object();\n  if (!hasValue(rateTable.Name)) {\n    pushError('PAYLOAD_RATE_TABLE_NAME_REQUIRED', 'Rate table payload requires Name.', 'entityPayloads.rateTables[' + i + '].Name');\n  }\n  if (!hasValue(rateTable.OrgId)) {\n    pushError('PAYLOAD_RATE_TABLE_ORG_ID_REQUIRED', 'Rate table payload requires OrgId.', 'entityPayloads.rateTables[' + i + '].OrgId');\n  }\n  if (!hasValue(rateTable.RateTableType)) {\n    pushError('PAYLOAD_RATE_TABLE_TYPE_REQUIRED', 'Rate table payload requires RateTableType.', 'entityPayloads.rateTables[' + i + '].RateTableType');\n  }\n}\n\nvar expressions = entityPayloads.expressions ? entityPayloads.expressions : [];\nfor (i = 0; i < expressions.length; i += 1) {\n  var expr = expressions[i] ? expressions[i] : new Object();\n  if (!hasValue(expr.Name)) {\n    pushError('PAYLOAD_EXPRESSION_NAME_REQUIRED', 'Expression payload requires Name.', 'entityPayloads.expressions[' + i + '].Name');\n  }\n  if (!hasValue(expr.OrgId)) {\n    pushError('PAYLOAD_EXPRESSION_ORG_ID_REQUIRED', 'Expression payload requires OrgId.', 'entityPayloads.expressions[' + i + '].OrgId');\n  }\n}\n\nvar expressionDetails = entityPayloads.expressionDetails ? entityPayloads.expressionDetails : [];\nvar detailCountByFormulaId = new Object();\nfor (i = 0; i < expressionDetails.length; i += 1) {\n  var detail = expressionDetails[i] ? expressionDetails[i] : new Object();\n  var path = 'entityPayloads.expressionDetails[' + i + ']';\n  var detailFormulaId = detail && detail._parserFormulaId ? String(detail._parserFormulaId) : null;\n  if (detailFormulaId) {\n    detailCountByFormulaId[detailFormulaId] = (detailCountByFormulaId[detailFormulaId] || 0) + 1;\n  }\n  if (!hasValue(detail.Sequence)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_SEQUENCE_REQUIRED', 'Expression detail payload requires Sequence.', path + '.Sequence');\n  }\n  if (!hasValue(detail.ExpressionDetailType)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_TYPE_REQUIRED', 'Expression detail payload requires ExpressionDetailType.', path + '.ExpressionDetailType');\n  }\n  var type = hasValue(detail.ExpressionDetailType) ? String(detail.ExpressionDetailType).toLowerCase() : '';\n  if (type === 'constant' && !hasValue(detail.ConstantValue)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_CONSTANT_VALUE_REQUIRED', 'Constant expression detail requires ConstantValue.', path + '.ConstantValue');\n  } else if (type === 'measure result' && !hasValue(detail.MeasureName)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_MEASURE_NAME_REQUIRED', 'Measure-result expression detail requires MeasureName.', path + '.MeasureName');\n  } else if (type === 'plan component result' && !hasValue(detail.PlanComponentName)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_COMPONENT_NAME_REQUIRED', 'Plan-component-result expression detail requires PlanComponentName.', path + '.PlanComponentName');\n  } else if (type === 'user defined query' && !hasValue(detail.UserDefinedQueryName)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_UDQ_NAME_REQUIRED', 'User-defined-query expression detail requires UserDefinedQueryName.', path + '.UserDefinedQueryName');\n  } else if ((type === 'basic attribute' || type === 'primary object attribute') && (!hasValue(detail.AttributeGroup) && !hasValue(detail.BasicAttributesGroup) || !hasValue(detail.AttributeName) && !hasValue(detail.BasicAttributeName))) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_ATTRIBUTE_REQUIRED', 'Attribute expression detail requires attribute group and name.', path, {\n      AttributeGroup: detail.AttributeGroup || detail.BasicAttributesGroup || null,\n      AttributeName: detail.AttributeName || detail.BasicAttributeName || null,\n    });\n  } else if (type === 'mathematical operator' && !hasValue(detail.ExpressionOperator)) {\n    pushError('PAYLOAD_EXPRESSION_DETAIL_OPERATOR_REQUIRED', 'Mathematical-operator expression detail requires ExpressionOperator.', path + '.ExpressionOperator');\n  }\n}\n\nvar resolvedPlan = transformed && transformed.resolvedPlan ? transformed.resolvedPlan : new Object();\nvar planComponents = resolvedPlan && resolvedPlan.planComponents ? resolvedPlan.planComponents : [];\nfor (i = 0; i < planComponents.length; i += 1) {\n  var component = planComponents[i] ? planComponents[i] : new Object();\n  var componentPath = 'resolvedPlan.planComponents[' + i + ']';\n  var componentFormulas = component.formulas ? component.formulas : [];\n  var fi = 0;\n  for (fi = 0; fi < componentFormulas.length; fi += 1) {\n    var componentFormula = componentFormulas[fi] ? componentFormulas[fi] : new Object();\n    if (!componentFormula.formulaId || !formulaNeedsMaterializedDetails(componentFormula)) {\n      continue;\n    }\n    if ((detailCountByFormulaId[String(componentFormula.formulaId)] || 0) === 0) {\n      pushError(\n        'PAYLOAD_EXPRESSION_DETAILS_MISSING',\n        'Resolved formula requires at least one expression detail payload before publish.',\n        componentPath + '.formulas[' + fi + ']',\n        {\n          formulaId: componentFormula.formulaId,\n          formulaName: componentFormula.formulaName ? componentFormula.formulaName : null,\n          componentId: component.componentId ? component.componentId : null,\n          componentName: component.componentName ? component.componentName : null,\n        }\n      );\n    }\n  }\n\n  var measures = component.performanceMeasures ? component.performanceMeasures : [];\n  var mi = 0;\n  for (mi = 0; mi < measures.length; mi += 1) {\n    var measure = measures[mi] ? measures[mi] : new Object();\n    var measureFormula = measure.formula ? measure.formula : null;\n    if (!measureFormula || !measureFormula.formulaId || !formulaNeedsMaterializedDetails(measureFormula)) {\n      continue;\n    }\n    if ((detailCountByFormulaId[String(measureFormula.formulaId)] || 0) === 0) {\n      pushError(\n        'PAYLOAD_EXPRESSION_DETAILS_MISSING',\n        'Resolved formula requires at least one expression detail payload before publish.',\n        componentPath + '.performanceMeasures[' + mi + '].formula',\n        {\n          formulaId: measureFormula.formulaId,\n          formulaName: measureFormula.formulaName ? measureFormula.formulaName : null,\n          componentId: component.componentId ? component.componentId : null,\n          componentName: component.componentName ? component.componentName : null,\n          measureId: measure.measureId ? measure.measureId : null,\n          measureName: measure.measureName ? measure.measureName : null,\n        }\n      );\n    }\n  }\n}\n\nvar result = new Object();\nresult.passed = errors.length === 0;\nresult.errors = errors;\nresult.warnings = warnings;\nreturn result;"
          },
