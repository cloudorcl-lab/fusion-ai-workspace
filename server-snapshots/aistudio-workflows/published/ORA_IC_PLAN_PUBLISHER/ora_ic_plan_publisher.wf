                    "sourceCode": "var parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar measure = $context.$nodes.BO_MEASURE_VALIDATION_GET\n  ? parseMaybeJson($context.$nodes.BO_MEASURE_VALIDATION_GET.$output)\n  : null;\nif (measure && measure.output && measure.output.response) {\n  measure = parseMaybeJson(measure.output.response);\n}\n\nvar current = $context.$nodes.MEASURE_VALIDATION_LOOP\n  ? $context.$nodes.MEASURE_VALIDATION_LOOP.$currentItem\n  : null;\nvar validity = measure && measure.ValidForCalculation !== undefined && measure.ValidForCalculation !== null\n  ? String(measure.ValidForCalculation)\n  : null;\n\nvar result = new Object();\nresult.entityType = 'measure';\nresult.parserId = current && current.parserId ? String(current.parserId) : null;\nresult.requestedId = current && current.icId !== undefined && current.icId !== null\n  ? Number(current.icId)\n  : null;\nresult.performanceMeasureId = measure && measure.PerformanceMeasureId !== undefined && measure.PerformanceMeasureId !== null\n  ? Number(measure.PerformanceMeasureId)\n  : result.requestedId;\nresult.name = measure && measure.Name !== undefined && measure.Name !== null\n  ? String(measure.Name)\n  : (current && current.name ? String(current.name) : null);\nresult.validForCalculation = validity;\nresult.isValid = validity === 'COMPLETE';\nresult.invalidReason = measure && measure.InvalidReason !== undefined && measure.InvalidReason !== null && String(measure.InvalidReason).length > 0\n  ? String(measure.InvalidReason)\n  : null;\nresult.measureFormulaExpressionId = measure && measure.MeasureFormulaExpressionId !== undefined && measure.MeasureFormulaExpressionId !== null\n  ? Number(measure.MeasureFormulaExpressionId)\n  : null;\nresult.found = measure !== null;\n\nreturn result;"
