            "sourceCode": "var transformed = ($context.$nodes.TRANSFORM_INPUT && $context.$nodes.TRANSFORM_INPUT.$output)\n  ? $context.$nodes.TRANSFORM_INPUT.$output.result\n  : new Object();\nvar workflowResponse = ($context.$nodes.CALL_PLAN_PRECHECK && $context.$nodes.CALL_PLAN_PRECHECK.$output)\n  ? $context.$nodes.CALL_PLAN_PRECHECK.$output\n  : null;\n\nvar parseMaybeJson = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  if (typeof value !== 'string') {\n    return value;\n  }\n  try {\n    return JSON.parse(value);\n  } catch (_err) {\n    return null;\n  }\n};\n\nvar extractPrecheck = function(value) {\n  var envelope = parseMaybeJson(value);\n  if (!envelope || envelope.output === undefined) {\n    return null;\n  }\n  var child = parseMaybeJson(envelope.output);\n  if (child && child.result) {\n    return parseMaybeJson(child.result);\n  }\n  return child;\n};\n\nvar deepClone = function(value) {\n  if (value === null || value === undefined) {\n    return value;\n  }\n  return JSON.parse(JSON.stringify(value));\n};\n\nvar buildCompactPrecheck = function(precheck) {\n  if (!precheck || typeof precheck !== 'object') {\n    return null;\n  }\n  var feedback = precheck.feedback && typeof precheck.feedback === 'object'\n    ? deepClone(precheck.feedback)\n    : null;\n  if (!feedback) {\n    return null;\n  }\n  feedback.findings = feedback.findings && feedback.findings.length !== undefined\n    ? feedback.findings.slice(0, 50)\n    : [];\n  var compact = {\n    contractVersion: precheck.contractVersion ? String(precheck.contractVersion) : null,\n    passed: precheck.passed === true,\n    feedback: feedback\n  };\n  if (precheck.appliedMutations && precheck.appliedMutations.length !== undefined && precheck.appliedMutations.length > 0) {\n    compact.appliedMutations = deepClone(precheck.appliedMutations);\n  }\n  return compact;\n};\n\nvar precheck = extractPrecheck(workflowResponse);\nvar resolvedPlan = precheck && precheck.resolvedPlan && typeof precheck.resolvedPlan === 'object'\n  ? deepClone(precheck.resolvedPlan)\n  : (transformed && transformed.resolvedPlan ? transformed.resolvedPlan : new Object());\nif (!resolvedPlan.metadata || typeof resolvedPlan.metadata !== 'object') {\n  resolvedPlan.metadata = new Object();\n}\nresolvedPlan.metadata.precheck = buildCompactPrecheck(precheck) || new Object();\n\nvar result = new Object();\nresult.resolvedPlan = resolvedPlan;\nresult.orgId = transformed.orgId;\nresult.businessUnitName = transformed.businessUnitName ? transformed.businessUnitName : null;\nresult.existingSidecar = transformed.existingSidecar;\nresult.publishMode = transformed.publishMode;\nresult.debugOutput = transformed.debugOutput === true;\nresult.gatePrecheck = transformed.gatePrecheck === true;\nreturn result;"
