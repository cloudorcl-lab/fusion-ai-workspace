            "name": "Transform Plan",
            "returnType": "object",
            "sourceCode": "var transformed = ($context.$nodes.APPLY_PUBLISH_PRECHECK && $context.$nodes.APPLY_PUBLISH_PRECHECK.$output)\n  ? $context.$nodes.APPLY_PUBLISH_PRECHECK.$output.result\n  : (($context.$nodes.TRANSFORM_INPUT && $context.$nodes.TRANSFORM_INPUT.$output)\n    ? $context.$nodes.TRANSFORM_INPUT.$output.result\n    : new Object());\n\nvar resolvedPlan = transformed.resolvedPlan ? transformed.resolvedPlan : new Object();\n\nvar precheck = (resolvedPlan.metadata && resolvedPlan.metadata.precheck)\n  ? resolvedPlan.metadata.precheck\n  : null;\nvar gatePrecheck = transformed.gatePrecheck === true;\nvar buildBlockingIssues = function(precheckResult) {\n  if (!precheckResult || typeof precheckResult !== 'object') {\n    return new Array();\n  }\n  var rawIssues = precheckResult.issues ? precheckResult.issues : [];\n  if ((!rawIssues || rawIssues.length === undefined || rawIssues.length === 0) && precheckResult.feedback && precheckResult.feedback.findings && precheckResult.feedback.findings.length !== undefined) {\n    rawIssues = precheckResult.feedback.findings;\n  }\n  var blockingIssues = new Array();\n  var bi = 0;\n  for (bi = 0; bi < rawIssues.length; bi += 1) {\n    var issue = rawIssues[bi] ? rawIssues[bi] : new Object();\n    var severity = issue.severity ? String(issue.severity).toUpperCase() : 'ERROR';\n    if (severity === 'ERROR') {\n      var plainIssue = new Object();\n      plainIssue.code = issue.code ? String(issue.code) : 'PRECHECK_BLOCKED';\n      plainIssue.severity = severity;\n      plainIssue.message = issue.message ? String(issue.message) : 'Precheck blocked publish';\n      plainIssue.path = issue.path ? String(issue.path) : null;\n      if (issue.context !== undefined) {\n        try {\n          plainIssue.context = JSON.parse(JSON.stringify(issue.context));\n        } catch (_e) {\n          plainIssue.context = null;\n        }\n      } else {\n        plainIssue.context = null;\n      }\n      blockingIssues.push(plainIssue);\n    }\n  }\n  return blockingIssues;\n};\n\nvar precheckPassed = null;\nif (precheck && typeof precheck === 'object') {\n  if (precheck.passed === true || precheck.passed === false) {\n    precheckPassed = precheck.passed === true;\n  } else if (precheck.feedback && (precheck.feedback.passed === true || precheck.feedback.passed === false)) {\n    precheckPassed = precheck.feedback.passed === true;\n  }\n}\n\nif (gatePrecheck && precheckPassed === false) {\n  var blockingIssues = buildBlockingIssues(precheck);\n\n  if (blockingIssues.length > 0) {\n    var blockedResult = new Object();\n    blockedResult.resolvedPlan = resolvedPlan;\n    blockedResult.orgId = transformed.orgId;\n    blockedResult.existingSidecar = transformed.existingSidecar;\n    blockedResult.publishMode = transformed.publishMode;\n    blockedResult.entityPayloads = new Object();\n    blockedResult.transformWarnings = new Array();\n    blockedResult.precheckBlockingIssues = blockingIssues;\n    blockedResult.gatePrecheck = gatePrecheck;\n    return blockedResult;\n  }\n}\n\nvar planDetails = resolvedPlan.compensationPlan ? resolvedPlan.compensationPlan : (resolvedPlan.planDetails ? resolvedPlan.planDetails : new Object());\nvar components = resolvedPlan.planComponents ? resolvedPlan.planComponents : (resolvedPlan.components ? resolvedPlan.components : []);\nvar topLevelRateTables = resolvedPlan.rateTables ? resolvedPlan.rateTables : [];\nvar orgCatalog = resolvedPlan && resolvedPlan.metadata && resolvedPlan.metadata.orgCatalog\n  ? resolvedPlan.metadata.orgCatalog\n  : new Object();\nvar expressionCatalog = orgCatalog && orgCatalog.expressionCatalog ? orgCatalog.expressionCatalog : new Object();\nvar intervalRows = orgCatalog && orgCatalog.intervals ? orgCatalog.intervals : [];\n\nvar formatDate = function(value) {\n  if (value && String(value).length > 0) {\n    return String(value).substring(0, 10);\n  }\n  var now = new Date();\n  var m = String(now.getUTCMonth() + 1);\n  var d = String(now.getUTCDate());\n  if (m.length < 2) { m = '0' + m; }\n  if (d.length < 2) { d = '0' + d; }\n  return String(now.getUTCFullYear()) + '-' + m + '-' + d;\n};\n\nvar normalizeIntervalToken = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  var text = String(value).trim().toUpperCase();\n  if (!text) {\n    return null;\n  }\n  return text.replace(/[\\s\\-_]+/g, '');\n};\n\nvar intervalAliasesByToken = {\n  PERIOD: ['PERIOD', 'MONTH', 'MONTHLY'],\n  QUARTER: ['QUARTER', 'QUARTERLY'],\n  ANNUAL: ['ANNUAL', 'ANNUALLY', 'YEAR', 'YEARLY']\n};\n\nvar resolveCatalogInterval = function(interval) {\n  if (interval === null || interval === undefined) {\n    return null;\n  }\n\n  var rawText = String(interval).trim();\n  if (!rawText) {\n    return null;\n  }\n\n  var normalized = normalizeIntervalToken(rawText);\n  if (!normalized) {\n    return null;\n  }\n\n  for (var idx = 0; idx < intervalRows.length; idx += 1) {\n    var row = intervalRows[idx] ? intervalRows[idx] : new Object();\n    var rowName = row.intervalName !== undefined && row.intervalName !== null ? String(row.intervalName).trim() : '';\n    if (!rowName) {\n      continue;\n    }\n    if (normalizeIntervalToken(rowName) === normalized) {\n      return row;\n    }\n    var rowTypeId = row.intervalTypeId !== undefined && row.intervalTypeId !== null ? String(row.intervalTypeId).trim() : '';\n    if (rowTypeId && rowTypeId === rawText) {\n      return row;\n    }\n  }\n\n  var aliases = intervalAliasesByToken[normalized];\n  if (!aliases || aliases.length === undefined) {\n    return null;\n  }\n\n  var aliasSet = new Object();\n  for (var aliasIdx = 0; aliasIdx < aliases.length; aliasIdx += 1) {\n    aliasSet[normalizeIntervalToken(aliases[aliasIdx])] = true;\n  }\n\n  for (var rowIdx = 0; rowIdx < intervalRows.length; rowIdx += 1) {\n    var aliasRow = intervalRows[rowIdx] ? intervalRows[rowIdx] : new Object();\n    var aliasRowName = aliasRow.intervalName !== undefined && aliasRow.intervalName !== null ? String(aliasRow.intervalName).trim() : '';\n    if (!aliasRowName) {\n      continue;\n    }\n    if (aliasSet[normalizeIntervalToken(aliasRowName)]) {\n      return aliasRow;\n    }\n  }\n\n  return null;\n};\n\nvar mapInterval = function(interval) {\n  var matched = resolveCatalogInterval(interval);\n  if (matched && matched.intervalTypeId !== undefined && matched.intervalTypeId !== null && String(matched.intervalTypeId).trim() !== '') {\n    return String(matched.intervalTypeId);\n  }\n  if (interval === 'QUARTER') { return '-1001'; }\n  if (interval === 'ANNUAL') { return '-1002'; }\n  return '-1000';\n};\n\nvar normalizeUpper = function(value) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  var text = String(value).trim();\n  if (!text) {\n    return null;\n  }\n  return text.toUpperCase();\n};\n\nvar mapEarningBasisFlag = function(value) {\n  if (value === null || value === undefined || value === '') {\n    return null;\n  }\n  if (value === true) {\n    return 'Y';\n  }\n  if (value === false) {\n    return 'N';\n  }\n  var normalized = normalizeUpper(value);\n  if (normalized === 'Y' || normalized === 'YES' || normalized === 'TRUE') {\n    return 'Y';\n  }\n  if (normalized === 'N' || normalized === 'NO' || normalized === 'FALSE') {\n    return 'N';\n  }\n  return null;\n};\n\nvar mapOptionalIntervalNumber = function(interval) {\n  if (interval === null || interval === undefined) {\n    return null;\n  }\n  var rawText = String(interval).trim();\n  if (!rawText) {\n    return null;\n  }\n  var numeric = Number(mapInterval(rawText));\n  if (isNaN(numeric)) {\n    return null;\n  }\n  return Math.trunc(numeric);\n};\n\nvar normalizeIncludeIndirectCredits = function(value) {\n  var normalized = normalizeUpper(value);\n  if (normalized === 'ALL' || normalized === 'MGR' || normalized === 'NONE' || normalized === 'TEAM') {\n    return normalized;\n  }\n  if (normalized === 'MANAGER') {\n    return 'MGR';\n  }\n  return 'NONE';\n};\n\nvar buildIncentiveFormulaPatch = function(source) {\n  var formulaSource = source && typeof source === 'object' ? source : new Object();\n  var patch = new Object();\n  patch.TrueUpFlag = formulaSource.trueUp === true;\n  var resetInterval = mapOptionalIntervalNumber(formulaSource.resetInterval);\n  if (resetInterval !== null) {\n    patch.ResetInterval = resetInterval;\n  }\n  patch.PayoutFrequency = mapInterval(formulaSource.payoutFrequency);\n  patch.IncludeIndirectCredits = normalizeIncludeIndirectCredits(formulaSource.includeIndirectCredits);\n  patch.CalculateEnddateParticipantFlag = formulaSource.calculateEnddatedParticipants === true;\n  return patch;\n};\n\nvar buildAllowedSet = function(fallbackCodes) {\n  var set = new Object();\n  var rows = fallbackCodes && fallbackCodes.length !== undefined ? fallbackCodes : [];\n  for (var ii = 0; ii < rows.length; ii += 1) {\n    if (rows[ii] !== null && rows[ii] !== undefined) {\n      set[String(rows[ii]).toUpperCase()] = true;\n    }\n  }\n  return set;\n};\n\nvar processTxnAllowed = buildAllowedSet(['GROUP', 'INDIVIDUAL']);\nvar incentiveTypeAllowed = buildAllowedSet(['COMMISSION', 'BONUS', 'STANDARD']);\n\nvar mapComponentCalculateIncentive = function(componentType) {\n  var normalized = normalizeUpper(componentType);\n  if (normalized === 'COMMISSION') {\n    return 'COMMISSION';\n  }\n  return 'BONUS';\n};\n\nvar mapComponentIncentiveType = function(componentType) {\n  var normalized = normalizeUpper(componentType);\n  if (normalized === 'COMMISSION' || normalized === 'BONUS' || normalized === 'STANDARD') {\n    return normalized;\n  }\n  return 'STANDARD';\n};\n\nvar dedupeByParserKey = function(items, keyName, label, warnings) {\n  var out = new Array();\n  var seen = new Object();\n  var i = 0;\n  for (i = 0; i < items.length; i += 1) {\n    var item = items[i] ? items[i] : new Object();\n    var key = item[keyName] ? String(item[keyName]) : null;\n    if (!key) {\n      out.push(item);\n      continue;\n    }\n    if (!seen[key]) {\n      seen[key] = true;\n      out.push(item);\n      continue;\n    }\n    if (warnings) {\n      warnings.push('Deduped duplicate ' + String(label) + ' payload for parser key ' + key);\n    }\n  }\n  return out;\n};\n\nvar extractVariables = function(expression) {\n  var vars = new Array();\n  if (!expression) {\n    return vars;\n  }\n  var re = /\\{([^}]+)\\}/g;\n  var match;\n  while ((match = re.exec(expression)) !== null) {\n    vars.push(match[1]);\n  }\n  return vars;\n};\n\nvar hasNonBlankText = function(value) {\n  return value !== null && value !== undefined && String(value).trim().length > 0;\n};\n\nvar normalizeRateInputExpressionCarrier = function(rateInput) {\n  var nestedCarrier = rateInput && rateInput.inputExpression && typeof rateInput.inputExpression === 'object'\n    ? rateInput.inputExpression\n    : null;\n  var simpleExpression = nestedCarrier && nestedCarrier.simpleExpression !== undefined && nestedCarrier.simpleExpression !== null\n    ? String(nestedCarrier.simpleExpression)\n    : (\n      rateInput && rateInput.inputExpression !== undefined && rateInput.inputExpression !== null && typeof rateInput.inputExpression !== 'object'\n        ? String(rateInput.inputExpression)\n        : (\n          rateInput && rateInput.simpleExpression !== undefined && rateInput.simpleExpression !== null\n            ? String(rateInput.simpleExpression)\n            : null\n        )\n    );\n  var displayText = rateInput && rateInput.displayText !== undefined && rateInput.displayText !== null\n    ? String(rateInput.displayText)\n    : (\n      nestedCarrier && nestedCarrier.displayText !== undefined && nestedCarrier.displayText !== null\n        ? String(nestedCarrier.displayText)\n        : null\n    );\n  var description = rateInput && rateInput.description !== undefined && rateInput.description !== null\n    ? String(rateInput.description)\n    : (\n      nestedCarrier && nestedCarrier.des