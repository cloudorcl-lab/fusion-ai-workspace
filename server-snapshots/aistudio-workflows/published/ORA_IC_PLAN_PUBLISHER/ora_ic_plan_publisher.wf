                  "id": "EXTRACT_GOAL_ID",
                  "metadata": {
                    "name": "Extract Goal Id",
                    "returnType": "object",
                    "position": {
                      "x": 1380,
                      "y": 200
                    },
                    "sourceCode": "var out = ($context.$nodes.BO_GOAL_QUERY && $context.$nodes.BO_GOAL_QUERY.$output)\n  ? $context.$nodes.BO_GOAL_QUERY.$output\n  : new Object();\n\nvar items = out.items ? out.items : [];\nvar result = new Object();\nvar goalFromQuery = (items.length > 0 && items[0].GoalId !== undefined) ? items[0].GoalId : null;\nvar goalFromHint = ($context.$variables && $context.$variables.resolvedCall && $context.$variables.resolvedCall.call)\n  ? $context.$variables.resolvedCall.call.goalIdHint\n  : null;\nresult.goalId = goalFromQuery ? goalFromQuery : goalFromHint;\nreturn result;"
                  },
                  "outcomes": {
                    "success": "BO_GOAL_UPDATE"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
