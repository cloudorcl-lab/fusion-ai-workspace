            "name": "Transform Input",
            "returnType": "object",
            "sourceCode": "var trigger = ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input)\n  ? $context.$triggers.REST.$input\n  : new Object();\n\nvar resolvedPlan = trigger.resolvedPlan;\nif (typeof resolvedPlan === 'string') {\n  try {\n    resolvedPlan = JSON.parse(resolvedPlan);\n  } catch (e) {\n    resolvedPlan = new Object();\n  }\n}\n\nvar existingSidecar = trigger.existingSidecar;\nif (typeof existingSidecar === 'string') {\n  try {\n    existingSidecar = JSON.parse(existingSidecar);\n  } catch (e2) {\n    existingSidecar = null;\n  }\n}\n\nvar planDetails = resolvedPlan && resolvedPlan.compensationPlan\n  ? resolvedPlan.compensationPlan\n  : (resolvedPlan && resolvedPlan.planDetails ? resolvedPlan.planDetails : new Object());\n\nvar normalizeDate = function(value) {\n  if (value === undefined || value === null) {\n    return null;\n  }\n  var text = String(value).trim();\n  if (!text) {\n    return null;\n  }\n  return text.substring(0, 10);\n};\n\nvar orgId = null;\nif (planDetails && typeof planDetails === 'object') {\n  orgId = planDetails.orgId;\n}\nif (orgId === undefined || orgId === null || orgId === '') {\n  orgId = trigger.orgId;\n}\n\nvar businessUnitName = (planDetails && planDetails.businessUnit)\n  ? String(planDetails.businessUnit)\n  : null;\nvar planStartDate = normalizeDate(planDetails && planDetails.effectiveStartDate ? planDetails.effectiveStartDate : null);\nvar planEndDate = normalizeDate(planDetails && planDetails.effectiveEndDate ? planDetails.effectiveEndDate : null);\n\nvar publishMode = trigger.publishMode ? String(trigger.publishMode) : 'strict';\nvar debugOutput = false;\nif (trigger.debugOutput === true || trigger.debugOutput === false) {\n  debugOutput = trigger.debugOutput === true;\n} else if (trigger.debugOutput !== undefined && trigger.debugOutput !== null) {\n  var debugText = String(trigger.debugOutput).trim().toLowerCase();\n  debugOutput = debugText === 'true' || debugText === '1' || debugText === 'yes';\n}\nvar gatePrecheck = false;\nif (trigger.gatePrecheck === true || trigger.gatePrecheck === false) {\n  gatePrecheck = trigger.gatePrecheck === true;\n} else if (trigger.gatePrecheck !== undefined && trigger.gatePrecheck !== null) {\n  var gateText = String(trigger.gatePrecheck).trim().toLowerCase();\n  gatePrecheck = gateText === 'true' || gateText === '1' || gateText === 'yes';\n}\n\nvar result = new Object();\nresult.resolvedPlan = resolvedPlan ? resolvedPlan : new Object();\nresult.orgId = (orgId === undefined || orgId === null || orgId === '') ? null : Number(orgId);\nresult.businessUnitName = businessUnitName;\nresult.planStartDate = planStartDate;\nresult.planEndDate = planEndDate;\nresult.existingSidecar = existingSidecar;\nresult.publishMode = publishMode;\nresult.debugOutput = debugOutput;\nresult.gatePrecheck = gatePrecheck;\nreturn result;"
