        {
          "id": "8",
          "code": "BUILD_EXECUTION_QUEUE",
          "type": "CODE",
          "metadata": {
            "name": "Build Execution Queue",
            "returnType": "object",
            "sourceCode": "var transformed = ($context.$nodes.TRANSFORM_PLAN && $context.$nodes.TRANSFORM_PLAN.$output)\n  ? $context.$nodes.TRANSFORM_PLAN.$output.result\n  : new Object();\n\nvar entityPayloads = transformed && transformed.entityPayloads\n  ? transformed.entityPayloads\n  : new Object();\nvar resolvedPlan = transformed && transformed.resolvedPlan ? transformed.resolvedPlan : new Object();\n\nvar errors = new Array();\nvar warnings = new Array();\n\nvar ensureArray = function(value) {\n  return value && value.length ? value : [];\n};\n\nvar flattenList = function(items, out) {\n  var target = out || [];\n  if (!items) {\n    return target;\n  }\n\n  var i = 0;\n  for (i = 0; i < items.length; i += 1) {\n    var value = items[i];\n    if (Array.isArray(value)) {\n      flattenList(value, target);\n    } else {\n      target.push(value);\n    }\n  }\n\n  return target;\n};\n\nvar sanitizePayload = function(payload) {\n  var clean = new Object();\n  var source = payload ? payload : new Object();\n  var key;\n  for (key in source) {\n    if (Object.prototype.hasOwnProperty.call(source, key) && String(key).indexOf('_') !== 0) {\n      clean[key] = source[key];\n    }\n  }\n  return clean;\n};\n\nvar cloneArray = function(items) {\n  var out = [];\n  var i = 0;\n  for (i = 0; i < items.length; i += 1) {\n    out.push(items[i]);\n  }\n  return out;\n};\n\nvar uniqueList = function(items) {\n  var out = [];\n  var seen = new Object();\n  var flattened = flattenList(items, []);\n  var i = 0;\n  for (i = 0; i < flattened.length; i += 1) {\n    var value = flattened[i];\n    if (value === null || value === undefined || value === '') {\n      continue;\n    }\n    var key = String(value);\n    if (!seen[key]) {\n      seen[key] = true;\n      out.push(key);\n    }\n  }\n  return out;\n};\n\nvar pushDependsOn = function(node, depId) {\n  if (!node || depId === null || depId === undefined || depId === '') {\n    return;\n  }\n  if (Array.isArray(depId)) {\n    var ai = 0;\n    for (ai = 0; ai < depId.length; ai += 1) {\n      pushDependsOn(node, depId[ai]);\n    }\n    return;\n  }\n  if (!node.dependsOn) {\n    node.dependsOn = [];\n  }\n  var depKey = String(depId);\n  var i = 0;\n  for (i = 0; i < node.dependsOn.length; i += 1) {\n    if (String(node.dependsOn[i]) === depKey) {\n      return;\n    }\n  }\n  node.dependsOn.push(depKey);\n};\n\nvar mergeDependsOn = function(base, extras) {\n  return uniqueList(cloneArray(base).concat(extras));\n};\n\nvar getParserId = function(entityType, payload) {\n  if (!payload) {\n    return null;\n  }\n  if (entityType === 'rateDimensions') {\n    return payload._parserDimensionKey ? String(payload._parserDimensionKey) : null;\n  }\n  if (entityType === 'rateDimensionTiers') {\n    return payload._parserRateDimTierKey ? String(payload._parserRateDimTierKey) : null;\n  }\n  if (entityType === 'rateTables') {\n    return payload._parserRateTableId ? String(payload._parserRateTableId) : null;\n  }\n  if (entityType === 'rateTableRates') {\n    return payload._parserRateTableRateKey ? String(payload._parserRateTableRateKey) : null;\n  }\n  if (entityType === 'expressions') {\n    return payload._parserFormulaId ? String(payload._parserFormulaId) : null;\n  }\n  if (entityType === 'expressionDetails') {\n    return payload._parserExpressionDetailKey\n      ? String(payload._parserExpressionDetailKey)\n      : (payload._parserFormulaId ? (String(payload._parserFormulaId) + '|DETAIL') : null);\n  }\n  if (entityType === 'measures') {\n    return payload._parserMeasureId ? String(payload._parserMeasureId) : null;\n  }\n  if (entityType === 'goals') {\n    return payload._parserGoalKey\n      ? String(payload._parserGoalKey)\n      : (payload._parserMeasureId ? (String(payload._parserMeasureId) + '|GOAL') : null);\n  }\n  if (entityType === 'components') {\n    return payload._parserComponentId ? String(payload._parserComponentId) : null;\n  }\n  if (entityType === 'compensationPlans') {\n    if (payload._parserPlanId) {\n      return String(payload._parserPlanId);\n    }\n    if (payload.Name) {\n      return 'PLAN|' + String(payload.Name);\n    }\n    return 'PLAN|DEFAULT';\n  }\n  return null;\n};\n\nvar switchKeyForCreate = function(entityType) {\n  if (entityType === 'rateDimensions') { return 'dimCreate'; }\n  if (entityType === 'rateDimensionTiers') { return 'tierCreate'; }\n  if (entityType === 'rateTables') { return 'tableCreate'; }\n  if (entityType === 'rateTableRates') { return 'rateCreate'; }\n  if (entityType === 'expressions') { return 'exprCreate'; }\n  if (entityType === 'measures') { return 'measureCreate'; }\n  if (entityType === 'goals') { return 'goalCreate'; }\n  if (entityType === 'components') { return 'compCreate'; }\n  if (entityType === 'compensationPlans') { return 'planCreate'; }\n  return 'default';\n};\n\nvar outputMappings = {\n  rateDimensions: new Object(),\n  rateDimensionTiers: new Object(),\n  rateTables: new Object(),\n  rateTableRates: new Object(),\n  expressions: new Object(),\n  expressionRefs: new Object(),\n  expressionUrls: new Object(),\n  expressionDetailCollectionUrls: new Object(),\n  expressionDetails: new Object(),\n  measures: new Object(),\n  measureScorecards: new Object(),\n  measureRateDimInputUrls: new Object(),\n  measureRateDimInputUrlLists: new Object(),\n  measureRateDimInputRowsByMeasure: new Object(),\n  goals: new Object(),\n  components: new Object(),\n  compensationPlans: new Object(),\n  componentUrls: new Object(),\n  incentiveFormulaUrls: new Object(),\n  rateDimInputUrls: new Object(),\n  rateDimInputUrlLists: new Object(),\n  rateDimInputRowsByComponent: new Object(),\n  componentMeasureLinks: new Object(),\n  componentRateTableLinks: new Object(),\n};\n\nvar reconciliation = new Object();\nvar addRec = function(bucket, parserId, action, reason) {\n  if (!reconciliation[bucket]) {\n    reconciliation[bucket] = [];\n  }\n  reconciliation[bucket].push({\n    parserId: parserId ? String(parserId) : null,\n    action: action ? String(action) : 'CREATE',\n    reason: reason ? String(reason) : null,\n  });\n};\n\nvar buildUniqueParserLookupByName = function(items, entityType) {\n  var result = {\n    unique: new Object(),\n    ambiguous: new Object(),\n  };\n  var i = 0;\n  for (i = 0; i < items.length; i += 1) {\n    var item = items[i] ? items[i] : new Object();\n    var parserId = getParserId(entityType, item);\n    var name = item && item.Name ? String(item.Name) : null;\n    if (!parserId || !name) {\n      continue;\n    }\n    if (result.ambiguous[name]) {\n      continue;\n    }\n    if (result.unique[name] && result.unique[name] !== parserId) {\n      delete result.unique[name];\n      result.ambiguous[name] = true;\n      continue;\n    }\n    result.unique[name] = parserId;\n  }\n  return result;\n};\n\nvar measureNameLookup = buildUniqueParserLookupByName(ensureArray(entityPayloads.measures), 'measures');\nvar componentNameLookup = buildUniqueParserLookupByName(ensureArray(entityPayloads.components), 'components');\n\nvar resolveParserIdByName = function(lookup, name, entityLabel, ownerLabel) {\n  var normalized = name ? String(name) : null;\n  if (!normalized) {\n    errors.push('Missing ' + String(entityLabel) + ' name for ' + String(ownerLabel));\n    return null;\n  }\n  if (lookup.ambiguous[normalized]) {\n    errors.push('Ambiguous ' + String(entityLabel) + ' reference \"' + normalized + '\" for ' + String(ownerLabel));\n    return null;\n  }\n  if (!lookup.unique[normalized]) {\n    errors.push('Unresolved ' + String(entityLabel) + ' reference \"' + normalized + '\" for ' + String(ownerLabel));\n    return null;\n  }\n  return String(lookup.unique[normalized]);\n};\n\nvar sortDetailPayloads = function(items) {\n  return items.slice().sort(function(a, b) {\n    var aSeq = a && a.Sequence !== undefined ? Number(a.Sequence) : 0;\n    var bSeq = b && b.Sequence !== undefined ? Number(b.Sequence) : 0;\n    if (aSeq < bSeq) { return -1; 