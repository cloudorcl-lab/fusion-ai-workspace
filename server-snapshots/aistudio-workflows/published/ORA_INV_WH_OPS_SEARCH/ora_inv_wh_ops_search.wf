{
  "workflowId": "300000326919082",
  "workflowCode": "ORA_INV_WH_OPS_SEARCH",
  "name": "Inventory Search Advisor",
  "description": "Provides intelligent search across inventory entities such as items, lots, organizations, and transactions. Extracts intent and constructs structured search queries.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1771320936007"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Message Hint Switcher"
          },
          "outcomes": {
            "Query": "1770956609087",
            "InvokeAction": "1771321034225"
          },
          "code": "MESSAGE_HINT_SWITCHER",
          "convergenceTargetId": "end",
          "id": "1771320936007",
          "inputs": [
            {
              "id": "1771320936008_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
