        {
          "id": "1782216607981",
          "code": "KNOWLEDGE_ARTIFACTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Knowledge Artifacts",
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
            "functionName": "getKnowledgeArtifacts"
          },
          "diagram": {
            "x": 5418.896113276153,
