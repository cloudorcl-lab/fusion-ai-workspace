        {
          "id": "1781531047899",
          "code": "QUERY_MESSAGE_ANALYSER",
          "type": "LLM",
          "metadata": {
            "name": "Query Message Analyser",
            "chatHistoryEnabled": true
          },
          "diagram": {
            "x": 4899.213256997671,
            "y": 5036.507559100614
          },
          "outcomes": {
            "success": "1781532591691"
          },
          "inputs": [
            {
              "id": "1781531047899_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the latest user message and extract product search or pagination intent.\n\nLatest message:\n{{$context.$system.$inputMessage}}\n\nChat history:\n{{$context.$system.$chatHistory}}\n\nReturn ONLY valid JSON in this format:\n\n{\n\"productName\": string,\n\"offset\": number,\n\"limit\": number\n}\n\nRules:\n\nDefault offset = 0.\nDefault limit = 10.\noffset must never be negative.\nIf the latest user message is a direct product search term or short product query like \"HCM\", set productName to that exact search term, offset to 0, and limit to the requested count if present, otherwise 10.\nIf user just directly search for product like \"HCM\". set productName to that search term, offset to 0, and limit to the requested count if present, otherwise 10.\nIf the user searches for a product, set productName to that search term, offset to 0, and limit to the requested count if present, otherwise 10.\nIf the user asks for \"next N\" products/results/items, set productName to null, limit to 10, and offset to previous offset from chat history + N.\nIf the user asks for \"previous N\" products/results/items, set productName to null, limit to 10, and offset to max(previous offset - N, 0).\nIf the user asks for next/previous without N, use N = 10.\nIf previous offset is not found in chat history, use previous offset = 0.\nIf the message is unrelated or unclear, return productName null, offset 0, limit 10.\nIf the user asks for \"show 10 HCM products\", this is a product search, not pagination: productName = \"HCM\", offset = 0, limit = 10.\nReturn JSON only. No markdown. No explanation.\n\nIn the output if offset is empty or null give default as 0"
            },
            {
              "id": "1781531047899_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "enableCommunications": false,
              "enablePowerPoints": false,
              "customNotes": ""
            }
          },
          "outputSpecification": "{\n  \"productName\": \"\",\n  \"offset\": \"\",\n  \"limit\": \"\"\n}"
        },
        {
          "id": "1781532591691",
          "code": "SET_PRODUCT_DETAILS_FROM_LLM",
          "type": "CODE",
          "metadata": {
            "name": "Set product details from LLM",
            "sourceCode": "try {\n  const output = $context.$nodes.QUERY_MESSAGE_ANALYSER.$output;\n  console.log(\"QUERY_MESSAGE_ANALYSER output:\", output);\n\n  let data;\n\n  if (typeof output === \"string\") {\n    data = JSON.parse(output);\n  } else if (typeof output.output === \"string\") {\n    data = JSON.parse(output.output);\n  } else if (output.output) {\n    data = output.output;\n  } else {\n    data = output;\n  }\n\n  const productName = data.productName || null;\n  const offset = data.offset || 0;\n  const limit = data.limit || 10;\n\n  return {\n    productName,\n    offset,\n    limit\n  };\n} catch (error) {\n  console.log(\"Error:\", error);\n  return {};\n}",
            "returnType": "object"
          },
          "diagram": {
            "x": 4895.861043318713,
            "y": 5165.037723743047
          },
          "outcomes": {
            "success": "1781528789671"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
