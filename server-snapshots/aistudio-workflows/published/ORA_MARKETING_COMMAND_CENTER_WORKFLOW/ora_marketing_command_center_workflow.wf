          "id": "1781327817499",
          "code": "RECOMMEND_TOP_3_PRODUCTS",
          "type": "CODE",
          "metadata": {
            "name": "Recommend Top 3 Products",
            "sourceCode": "let result = [];\ntry {\n  result = $context.$variables.result;\n\n  if (Array.isArray(result) && result.length > 0) {\n    // Access 'accounts' property from the first item\n    \n    return result.slice(0, 5);\n  }\n  return [];\n} catch (error) {\n  return [];\n}",
            "returnType": "array",
            "errorNodeId": "1781273108825"
          },
