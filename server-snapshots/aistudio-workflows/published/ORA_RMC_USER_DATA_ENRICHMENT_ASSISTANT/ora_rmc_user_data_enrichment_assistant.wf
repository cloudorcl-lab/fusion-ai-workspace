{
  "workflowId": "100002355227057",
  "workflowCode": "ORA_RMC_USER_DATA_ENRICHMENT_ASSISTANT",
  "name": "RMC User Data Enrichment Assistant",
  "description": "Enriches a selected account with workforce profile attributes such as role, manager, and organizational details.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [
      {
        "id": "input_username",
        "name": "username",
        "type": "string",
        "description": "The username to enrich with worker details"
      }
    ],
    "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"username\": { \"type\": \"string\" },\n    \"position\": { \"type\": \"string\" },\n    \"manager\": { \"type\": \"string\" },\n    \"displayname\": { \"type\": \"string\" }\n  }\n}",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "node_get_user_account"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
            "name": "End"
          },
          "outcomes": {},
          "code": "END",
          "id": "end",
          "inputs": [],
          "type": "END"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_USERS",
            "functionName": "get_user_account",
            "processJson": true,
            "name": "Get User Account"
          },
          "outcomes": {
            "success": "node_extract_person"
          },
          "code": "GET_USER_ACCOUNT",
          "id": "node_get_user_account",
          "inputs": [
            {
              "id": "input_username",
              "name": "userName",
              "type": "string",
              "value": "{{$context.$input.username}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Person Info",
            "returnType": "object",
            "sourceCode": "var account = $context.$nodes.GET_USER_ACCOUNT.$output;\nvar result = { personid: null, personnumber: null, _debug: { personFound: false } };\n\nif (account) {\n    var data = account;\n    if (typeof account === 'string') {\n        try { data = JSON.parse(account); } catch(e) { data = null; }\n    }\n    if (data && data.items && data.items[0]) {\n        result.personid = data.items[0].PersonId || null;\n        result.personnumber = data.items[0].PersonNumber || null;\n        result._debug = { personFound: true };\n    }\n}\nreturn result;"
          },
          "outcomes": {
            "success": "node_check_person"
          },
          "code": "EXTRACT_PERSON_INFO",
          "id": "node_extract_person",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Person ID Exists"
          },
          "outcomes": {
            "true": "node_get_assignments",
            "false": "node_output_no_person"
          },
          "code": "CHECK_PERSON_ID",
          "convergenceTargetId": "end",
          "id": "node_check_person",
          "inputs": [
            {
              "id": "condition_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_PERSON_INFO.$output.result.personid != null}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_WORKERASSIGNMEN",
            "functionName": "get_worker_assignments",
            "processJson": true,
            "name": "Get Worker Assignments"
          },
          "outcomes": {
            "success": "node_get_worker"
          },
          "code": "GET_WORKER_ASSIGNMENTS",
          "id": "node_get_assignments",
          "inputs": [
            {
              "id": "input_personid",
              "name": "personId",
              "type": "integer",
              "value": "{{$context.$nodes.EXTRACT_PERSON_INFO.$output.result.personid}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_PUBLICWORKERS",
            "functionName": "get_worker_by_person_number",
            "processJson": true,
            "name": "Get Worker Details"
          },
          "outcomes": {
            "success": "node_build_output"
          },
          "code": "GET_WORKER_DETAILS",
          "id": "node_get_worker",
          "inputs": [
            {
              "id": "input_personnumber",
              "name": "personNumber",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_PERSON_INFO.$output.result.personnumber}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build Enriched Output",
            "returnType": "object",
            "sourceCode": "var username = $context.$input.username;\nvar assignments = $context.$nodes.GET_WORKER_ASSIGNMENTS.$output;\nvar worker = $context.$nodes.GET_WORKER_DETAILS.$output;\nvar position = 'N/A';\nvar manager = 'N/A';\nvar displayname = username;\nvar hasAssignment = false;\nvar hasWorker = false;\nif (assignments) {\n    var assignData = assignments;\n    if (typeof assignments === 'string') {\n        try { assignData = JSON.parse(assignments); } catch(e) { assignData = null; }\n    }\n    if (assignData && assignData.items && assignData.items[0]) {\n        var assign = assignData.items[0];\n        position = assign.PositionName || assign.JobName || 'N/A';\n        manager = assign.ManagerDisplayName || 'N/A';\n        hasAssignment = true;\n    }\n}\nif (worker) {\n    var workerData = worker;\n    if (typeof worker === 'string') {\n        try { workerData = JSON.parse(worker); } catch(e) { workerData = null; }\n    }\n    if (workerData && workerData.items && workerData.items[0]) {\n        displayname = workerData.items[0].DisplayName || username;\n        hasWorker = true;\n    }\n}\nvar result = { username: username, position: position, manager: manager, displayname: displayname, _debug: { hasAssignment: hasAssignment, hasWorker: hasWorker } };\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "BUILD_ENRICHED_OUTPUT",
          "id": "node_build_output",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Output No Person Data",
            "returnType": "object",
            "sourceCode": "var username = $context.$input.username;\nvar result = { username: username, position: 'N/A', manager: 'N/A', displayname: username };\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "OUTPUT_NO_PERSON",
          "id": "node_output_no_person",
          "inputs": [],
          "outputSpecification": "{}",
          "type": "CODE"
        }
      ],
      "rootNode": "start",
      "variables": [],
      "errorHandlers": []
    },
    "modelConfiguration": null,
    "humanApprovalFlag": false,
    "waitFlag": false,
    "triggers": [
      {
        "type": "REST",
        "inputs": []
      }
    ],
    "chatExpTPFileUploadEnabledFlag": false,
    "chatExpThirdPartyDetails": [],
    "policyIds": []
  },
  "status": "DRAFT",
  "version": 1,
  "family": "GRC",
  "product": "OTHER",
  "ownerName": null,
  "customFlag": false,
  "seededFlag": true,
  "isTemplate": false,
  "hiddenFlag": false,
  "useCaseId": "NA",
  "accessModifier": "public",
  "architecture": "data_pipeline",
  "aiAppsCompatibleFlag": false,
  "followupEnabledFlag": false,
  "header": {
    "ETag": "\"2\""
  }
}
