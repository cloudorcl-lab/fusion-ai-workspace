                {
                  "metadata": {
                    "description": "Formats the input value",
                    "name": "Format Input",
                    "sourceCode": "let inputSource = $context.$input.Input;\nlet userPreferencesSource = $context.$input.UserPreferences;\n\nlet inputPayload = inputSource;\nlet userPreferences = userPreferencesSource || {};\n\n/* parse input if Agent Studio passes it as JSON string */\ntry {\n  inputPayload = typeof inputPayload === \"string\" ? JSON.parse(inputPayload) : inputPayload;\n} catch (e) {\n  inputPayload = inputSource;\n}\n\n/* parse preferences if Agent Studio passes it as JSON string */\ntry {\n  userPreferences = typeof userPreferences === \"string\" ? JSON.parse(userPreferences) : userPreferences;\n} catch (e) {\n  userPreferences = {};\n}\n\nfunction formatNumberByUserPreference(inputValue, preferences) {\n  try {\n    preferences = preferences || {};\n\n    if (inputValue === null || inputValue === undefined || inputValue === \"\") {\n      return inputValue;\n    }\n\n    let numberFormat = preferences.NumberFormat || \"#,##0.###\";\n    let decimalSeparator = preferences.DecimalSeparator || \".\";\n    let groupingSeparator = preferences.GroupingSeparator || \",\";\n\n    let inputText = String(inputValue).trim();\n    let numberValue = typeof inputValue === \"number\" ? inputValue : Number(inputText.replace(/\\s/g, \"\"));\n\n    if (isNaN(numberValue)) {\n      let normalizedText = inputText.replace(/\\s/g, \"\");\n\n      if (groupingSeparator !== \"\") {\n        normalizedText = normalizedText.split(groupingSeparator).join(\"\");\n      }\n\n      if (decimalSeparator !== \".\") {\n        normalizedText = normalizedText.split(decimalSeparator).join(\".\");\n      }\n\n      numberValue = Number(normalizedText);\n    }\n\n    if (isNaN(numberValue)) {\n      return inputValue;\n    }\n\n    let decimalIndex = numberFormat.lastIndexOf(\".\");\n    let decimalPattern = decimalIndex >= 0 ? numberFormat.substring(decimalIndex + 1) : \"\";\n    let maximumFractionDigits = decimalPattern.length;\n    let minimumFractionDigits = 0;\n\n    for (let i = 0; i < decimalPattern.length; i++) {\n      if (decimalPattern.charAt(i) === \"0\") {\n        minimumFractionDigits = minimumFractionDigits + 1;\n      }\n    }\n\n    let roundedText = Math.abs(numberValue).toFixed(maximumFractionDigits);\n    let roundedDecimalIndex = roundedText.indexOf(\".\");\n    let integerPart = roundedDecimalIndex >= 0 ? roundedText.substring(0, roundedDecimalIndex) : roundedText;\n    let fractionPart = roundedDecimalIndex >= 0 ? roundedText.substring(roundedDecimalIndex + 1) : \"\";\n\n    while (fractionPart.length > minimumFractionDigits && fractionPart.charAt(fractionPart.length - 1) === \"0\") {\n      fractionPart = fractionPart.substring(0, fractionPart.length - 1);\n    }\n\n    let integerPattern = decimalIndex >= 0 ? numberFormat.substring(0, decimalIndex) : numberFormat;\n    let groupedIntegerPart = integerPattern.indexOf(\",\") >= 0 ? integerPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator) : integerPart;\n    let negativeSign = numberValue < 0 && Number(roundedText) !== 0 ? \"-\" : \"\";\n\n    return negativeSign + groupedIntegerPart + (fractionPart.length > 0 ? decimalSeparator + fractionPart : \"\");\n  } catch (e) {\n    return inputValue;\n  }\n}\n\nfunction formatDateByUserPreference(inputValue, preferences) {\n  try {\n    preferences = preferences || {};\n\n    if (inputValue === null || inputValue === undefined || inputValue === \"\") {\n      return inputValue;\n    }\n\n    let dateFormat = preferences.DateFormat || \"yyyy-MM-dd\";\n    let inputText = String(inputValue).trim();\n\n    if (inputText.length >= 10) {\n      inputText = inputText.substring(0, 10);\n    }\n\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(inputText)) {\n      return inputValue;\n    }\n\n    let yearText = inputText.substring(0, 4);\n    let monthTwoDigitText = inputText.substring(5, 7);\n    let dayTwoDigitText = inputText.substring(8, 10);\n\n    let yearNumber = Number(yearText);\n    let monthNumber = Number(monthTwoDigitText);\n    let dayNumber = Number(dayTwoDigitText);\n\n    let leapYear = yearNumber % 400 === 0 || (yearNumber % 4 === 0 && yearNumber % 100 !== 0);\n    let daysInMonth = [31, leapYear ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\n\n    if (monthNumber < 1 || monthNumber > 12 || dayNumber < 1 || dayNumber > daysInMonth[monthNumber - 1]) {\n      return inputValue;\n    }\n\n    let yearTwoDigitText = yearText.substring(2);\n    let monthText = String(monthNumber);\n    let dayText = String(dayNumber);\n    let fullMonthName = \"\";\n    let shortMonthName = \"\";\n    let months = preferences.months || preferences.Months || [];\n\n    for (let monthIndex = 0; monthIndex < months.length; monthIndex++) {\n      let monthItem = months[monthIndex] || {};\n\n      if (Number(monthItem.monthNumber) === monthNumber) {\n        fullMonthName = monthItem.fullMonthName || \"\";\n        shortMonthName = monthItem.shortMonthName || \"\";\n        break;\n      }\n    }\n\n    let requiresFullMonthName = /(FMMonth|MMMM|MONTH|Month)/.test(dateFormat);\n    let dateFormatWithoutFullMonth = dateFormat.replace(/FMMonth|MMMM|MONTH|Month/g, \"\");\n    let requiresShortMonthName = /(MMM|MON|Mon)/.test(dateFormatWithoutFullMonth);\n\n    if ((requiresFullMonthName && fullMonthName === \"\") || (requiresShortMonthName && shortMonthName === \"\")) {\n      return inputValue;\n    }\n\n    let tokenValues = {\n      \"FMMonth\": fullMonthName,\n      \"MMMM\": fullMonthName,\n      \"MONTH\": fullMonthName.toUpperCase(),\n      \"Month\": fullMonthName,\n      \"MMM\": shortMonthName,\n      \"MON\": shortMonthName.toUpperCase(),\n      \"Mon\": shortMonthName,\n      \"YYYY\": yearText,\n      \"yyyy\": yearText,\n      \"YY\": yearTwoDigitText,\n      \"yy\": yearTwoDigitText,\n      \"MM\": monthTwoDigitText,\n      \"M\": monthText,\n      \"DD\": dayTwoDigitText,\n      \"dd\": dayTwoDigitText,\n      \"d\": dayText\n    };\n\n    return dateFormat.replace(/FMMonth|MMMM|MONTH|Month|MMM|MON|Mon|YYYY|yyyy|YY|yy|MM|M|DD|dd|d/g, function(token) {\n      return tokenValues[token] === undefined ? token : tokenValues[token];\n    });\n  } catch (e) {\n    return inputValue;\n  }\n}\n\nfunction formatByType(inputValue, formatType, preferences) {\n  let type = formatType === null || formatType === undefined ? \"\" : String(formatType).toLowerCase();\n\n  if (type === \"amount\" || type === \"currencyamount\" || type === \"number\") {\n    return formatNumberByUserPreference(inputValue, preferences);\n  }\n\n  if (type === \"date\") {\n    return formatDateByUserPreference(inputValue, preferences);\n  }\n\n  return inputValue;\n}\n\nfunction transformPayload(root, preferences) {\n  let result = root;\n  let stack = [{ parent: null, key: null, node: root }];\n\n  while (stack.length > 0) {\n    let frame = stack.pop();\n    let node = frame.node;\n\n    if (node === null || node === undefined || typeof node !== \"object\") {\n      continue;\n    }\n\n    if (!Array.isArray(node) && node.formatType !== undefined && node.formatValue !== undefined) {\n      let formattedValue = formatByType(node.formatValue, node.formatType, preferences);\n\n      if (frame.parent === null) {\n        result = formattedValue;\n      } else {\n        frame.parent[frame.key] = formattedValue;\n      }\n\n      continue;\n    }\n\n    if (Array.isArray(node)) {\n      for (let i = node.length - 1; i >= 0; i--) {\n        stack.push({ parent: node, key: i, node: node[i] });\n      }\n    } else {\n      let keys = Object.keys(node);\n\n      for (let j = keys.length - 1; j >= 0; j--) {\n        stack.push({ parent: node, key: keys[j], node: node[keys[j]] });\n      }\n    }\n  }\n\n  return result;\n}\n\nlet result = transformPayload(inputPayload, userPreferences);\n\nreturn result;",
                    "returnType": "object"
                  },
