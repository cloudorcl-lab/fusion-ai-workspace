          "metadata": {
            "description": "Extracting the error details for batch execution",
            "name": "Extract Error in Batch Execution",
            "returnType": "array",
            "sourceCode": "let errorInfo = $context.$nodes.FIN_IEX_BO_EXECUTE_BATCH_ACTIONS_FOR_EMAIL_MESSAGE.$error.$info;\nconst messageDetailArray = $context.$nodes.FIN_IEX_BO_GET_ACTIONABLE_DETAILS_FROM_EMAIL_MESSAGE.$output || [];\n\n/* parse errorInfo if needed */\nif (typeof errorInfo === \"string\") {\n  try {\n    errorInfo = JSON.parse(errorInfo);\n  } catch (e) {\n    errorInfo = {};\n  }\n}\n\n/* parse result object if needed */\nlet resultObj = errorInfo && errorInfo.result != null ? errorInfo.result : errorInfo;\nif (typeof resultObj === \"string\") {\n  try {\n    resultObj = JSON.parse(resultObj);\n  } catch (e) {\n    resultObj = {};\n  }\n}\n\n/* extract error details */\nconst errorDetails = Array.isArray(resultObj[\"o:errorDetails\"]) ? resultObj[\"o:errorDetails\"] : [];\n\n/* group errors by part index */\nlet groupedErrors = {};\nfor (let i = 0; i < errorDetails.length; i++) {\n  let error = errorDetails[i] || {};\n  let path = error[\"o:errorPath\"] || \"\";\n  const payloadKey = \"payload\";\n  let match = path.match(/\\/parts\\/(\\d+)/);\n  let partIndex = match ? parseInt(match[1], 10) : null;\n  let groupKey = partIndex !== null ? String(partIndex) : \"unknown\";\n\n  if (!groupedErrors[groupKey]) {\n    groupedErrors[groupKey] = {\n      index: partIndex,\n      errors: []\n    };\n  }\n\n  groupedErrors[groupKey].errors.push({\n    errorCode: error[\"o:errorCode\"] || \"\",\n    title: error[\"title\"] || \"\",\n    detail: error[\"detail\"] || \"\"\n  });\n}\n\n/* build final result */\nlet result = [];\nlet groupedKeys = Object.keys(groupedErrors);\n\nfor (let j = 0; j < groupedKeys.length; j++) {\n  let groupedItem = groupedErrors[groupedKeys[j]] || {};\n  let partIndex = groupedItem.index;\n  let errorsForPart = Array.isArray(groupedItem.errors) ? groupedItem.errors : [];\n  let messageDetail = partIndex !== null ? (messageDetailArray[partIndex] || {}) : {};\n  let existingResponseData = messageDetail.RESPONSEDATA;\n  let parsedRequestData = {};\n  let parsedExistingResponseData = null;\n\n  if (messageDetail.REQUESTDATA) {\n    if (typeof messageDetail.REQUESTDATA === \"string\") {\n      try {\n        parsedRequestData = JSON.parse(messageDetail.REQUESTDATA);\n      } catch (e) {\n        parsedRequestData = {};\n      }\n    } else if (typeof messageDetail.REQUESTDATA === \"object\") {\n      parsedRequestData = messageDetail.REQUESTDATA;\n    }\n  }\n\n  if (existingResponseData !== null && existingResponseData !== undefined && existingResponseData !== \"\") {\n    if (typeof existingResponseData === \"string\") {\n      try {\n        parsedExistingResponseData = JSON.parse(existingResponseData);\n      } catch (e) {\n        parsedExistingResponseData = null;\n      }\n    } else if (typeof existingResponseData === \"object\" && !Array.isArray(existingResponseData)) {\n      parsedExistingResponseData = existingResponseData;\n    }\n  }\n\n  let transactionNumber = \"\";\n  if (parsedRequestData.actionablePayload) {\n    transactionNumber = parsedRequestData.actionablePayload.TransactionNumber || \"\";\n  }\n\n  let newResponseData = {\n    transactionNumber: transactionNumber,\n    errors: errorsForPart\n  };\n\n  let finalResponseData = {\n    response: newResponseData\n  };\n\n  if (parsedExistingResponseData && typeof parsedExistingResponseData === \"object\" && !Array.isArray(parsedExistingResponseData)) {\n    finalResponseData = Object.assign({}, parsedExistingResponseData, {\n      response: newResponseData\n    });\n  }\n\n  result.push({\n    messageDetailId: partIndex !== null && messageDetail.CUSTOMERMESSAGEDETAILID\n      ? messageDetail.CUSTOMERMESSAGEDETAILID\n      : null,\n    responseData: finalResponseData,\n    processingStatusCode: \"ORA_PROCESSING_ERROR\"\n  });\n}\n\nreturn result;"
          },
