            "sourceCode": "/* strategy response */\nlet strategyResponse = $context.$nodes.FIN_IEX_BO_FETCH_EXISTING_STRATEGY.$output;\n\n/* strategy items */\nlet strategyItems = [];\nif (strategyResponse != null && strategyResponse.items != null) {\n  strategyItems = strategyResponse.items;\n}\n\n/* first strategy row */\nlet firstStrategy = null;\nif (strategyItems.length > 0) {\n  firstStrategy = strategyItems[0];\n}\n\n/* extracted output */\nlet result = {\n  strategyId: firstStrategy ? firstStrategy.StrategyId : null,\n  accountNumber: firstStrategy ? firstStrategy.AccountNumber : null,\n  partyNumber: firstStrategy ? firstStrategy.PartyNumber : null,\n  strategyTemplateName: firstStrategy ? firstStrategy.StrategyTemplate : null\n};\n\nreturn result;"
