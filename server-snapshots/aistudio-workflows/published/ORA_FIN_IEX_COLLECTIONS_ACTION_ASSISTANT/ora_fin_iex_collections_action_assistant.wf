        {
          "metadata": {
            "description": "Update response data for skip",
            "name": "Update Response Data For Skip",
            "returnType": "object",
            "sourceCode": "let messageDetails = $context.$nodes.FIN_IEX_CODE_EXECUTE_PAYLOAD_FOR_GETTING_MESSAGE_DETAILS_TO_SKIP.$output || [];\n\nlet result = [];\n\nfor (let i = 0; i < messageDetails.length; i++) {\n  let record = messageDetails[i] || {};\n  let processingStatusCode = \"ORA_MANUAL_PROCESSED\";\n  let existingProcessingStatusCode = record.PROCESSINGSTATUSCODE || \"\";\n  let responseData = record.RESPONSEDATA;\n  let resultItem = {\n    messageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n    processingStatusCode: processingStatusCode\n  };\n\n  if (responseData !== null && responseData !== undefined && responseData !== \"\") {\n    if (typeof responseData === \"string\") {\n      try {\n        responseData = JSON.parse(responseData);\n      } catch (e) {\n        responseData = {};\n      }\n    }\n  } else {\n    responseData = {};\n  }\n\n  responseData.existingProcessingStatusCode = existingProcessingStatusCode;\n  resultItem.responseData = responseData;\n\n  result.push(resultItem);\n}\n\nreturn result;",
            "errorNodeId": "1778436031247"
          },
          "outcomes": {
            "success": "1777872532952"
          },
          "diagram": {
            "x": 19222.406848172348,
            "y": 8320.109450755472
          },
