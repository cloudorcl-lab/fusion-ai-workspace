            "name": "Construct Payload For Creating Strategy Tasks",
            "returnType": "array",
            "sourceCode": "let strategyTemplateId = $context.$nodes.FIN_IEX_CODE_EXTRACT_STRATEGY_DATA.$output.result.strategyId;\nlet strategyUserTasks = $context.$variables.StrategyDetails.strategyUserTasks;\n\nif (strategyUserTasks == null) {\n  strategyUserTasks = [];\n}\n\nlet currentTask = strategyUserTasks[0] || {};\nlet strategyTaskTemplate = currentTask.StrategyTaskTemplate || null;\nlet userTaskStatus = currentTask.UserTaskStatus || null;\n\nlet currentDate = new Date();\nlet generatedWorkOrder =\n  String(currentDate.getFullYear()) +\n  String(currentDate.getMonth() + 1).padStart(2, \"0\") +\n  String(currentDate.getDate()).padStart(2, \"0\") +\n  String(currentDate.getHours()).padStart(2, \"0\") +\n  String(currentDate.getMinutes()).padStart(2, \"0\") +\n  String(currentDate.getSeconds()).padStart(2, \"0\") +\n  String(currentDate.getMilliseconds()).padStart(3, \"0\");\n\nlet todayDate = String(currentDate.getFullYear()) + \"-\" + String(currentDate.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(currentDate.getDate()).padStart(2, \"0\");\nlet taskStatus = userTaskStatus === \"Skip\" ? \"Canceled\" : \"Complete\";\n\nlet result = [\n  {\n    id: \"part1\",\n    path: \"/collectionStrategies/\" + strategyTemplateId + \"/child/strategyUserTasks\",\n    operation: \"create\",\n    payload: {\n      StrategyTaskTemplate: strategyTaskTemplate,\n      WorkOrder: generatedWorkOrder\n    }\n  },\n  {\n    id: \"part2\",\n    path: \"/collectionStrategies/\" + strategyTemplateId + \"/child/strategyExecutionTasks\",\n    operation: \"create\",\n    payload: {\n      StrategyTaskTemplate: strategyTaskTemplate,\n      ExecutionStart: todayDate,\n      ScheduleStart: todayDate,\n      ExecutionEnd: todayDate,\n      WorkOrder: generatedWorkOrder,\n      TaskStatus: taskStatus\n    }\n  }\n];\n\nreturn result;"
