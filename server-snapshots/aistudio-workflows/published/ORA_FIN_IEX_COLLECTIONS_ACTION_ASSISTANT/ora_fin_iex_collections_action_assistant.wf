          "code": "DISPLAY_SUCCESSFUL_PTP",
          "id": "1774384072327",
          "inputs": [
            {
              "id": "1774384072328_1",
              "name": "prompt",
              "type": "string",
              "value": "Display a text saying \"Promise to Pay has been created successfully\" in a cardWidget with success variant and subject as \"Promise to Pay Created\" and no title and no description and nothing else."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Customer Details to Skip Customer Call",
            "returnType": "object",
            "sourceCode": "var rawResult = $context?.$nodes?.EXTRACT_CUSTOMER_DETAILS?.$output?.result || \"{}\";\n\nvar sourceData = {};\n\nfunction parseObjectLiteralFields(text) {\n  var result = {};\n  var pattern = /([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*(?:\"([^\"]*)\"|'([^']*)'|([^,}]*))/g;\n  var match;\n\n  while ((match = pattern.exec(String(text))) !== null) {\n    var key = match[1];\n    var value = match[2] !== undefined\n      ? match[2]\n      : match[3] !== undefined\n        ? match[3]\n        : String(match[4] || \"\").trim();\n\n    if (value === \"null\") {\n      value = null;\n    }\n\n    result[key] = value;\n  }\n\n  return result;\n}\n\ntry {\n  sourceData = typeof rawResult === \"string\" ? JSON.parse(rawResult) : rawResult;\n} catch (e) {\n  sourceData = parseObjectLiteralFields(rawResult);\n}\n\nvar result = {\n  partyNumber: sourceData.PARTYNUMBER || \"\",\n  accountNumber: sourceData.ACCOUNTNUMBER || \"\",\n  createdFrom: \"skippingCustomerCall\",\n  strategyUserTasks: [\n    {\n      StrategyTaskTemplate: \"Call Customer\",\n      WorkOrder: 101,\n      UserTaskStatus: \"Skip\"\n    }\n  ]\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1777069808718"
          },
          "diagram": {
            "x": 6350,
            "y": 7022
          },
          "code": "EXTRACT_CUSTOMER_DETAILS_TO_SKIP_CUSTOMER_CALL",
          "id": "1777069530697",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Insights for Customer Call"
