        {
          "metadata": {
            "description": "Updating user preferences with month",
            "name": "Update User Preferences with Month",
            "sourceCode": "let userPreferencesSource = $context.$nodes.FIN_IEX_CODE_EXTRACT_USER_PREFERENCES.$output.result || {};\nlet localeMonthNamesSource = $context.$nodes.FIN_IEX_LLM_GENERATE_LOCALE_MONTH_NAMES.$output || {};\n\nlet userPreferences = {};\nlet localeMonthNames = {};\nlet months = [];\n\ntry {\n  userPreferences = typeof userPreferencesSource === \"string\" ? JSON.parse(userPreferencesSource) : userPreferencesSource;\n} catch (e) {\n  userPreferences = {};\n}\n\ntry {\n  localeMonthNames = typeof localeMonthNamesSource === \"string\" ? JSON.parse(localeMonthNamesSource) : localeMonthNamesSource;\n} catch (e) {\n  localeMonthNames = {};\n}\n\nif (localeMonthNames.months && Array.isArray(localeMonthNames.months)) {\n  months = localeMonthNames.months;\n}\n\nuserPreferences.months = months;\n\nlet result = userPreferences;\n\nreturn result;",
            "returnType": "object"
          },
