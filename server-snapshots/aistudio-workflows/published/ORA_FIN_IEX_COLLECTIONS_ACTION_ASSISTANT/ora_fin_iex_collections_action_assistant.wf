{
  "workflowId": "300000331058672",
  "workflowCode": "ORA_FIN_IEX_COLLECTIONS_ACTION_ASSISTANT",
  "name": "Collections Action Assistant",
  "description": "Centralizes next-best-action invocation for receivables workflows so shared priority actions can be rendered and completed from one dedicated workflow agent.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
