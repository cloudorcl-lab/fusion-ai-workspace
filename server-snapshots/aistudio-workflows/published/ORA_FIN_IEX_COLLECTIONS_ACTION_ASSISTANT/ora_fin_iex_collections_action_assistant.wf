          "code": "EXTRACT_CUSTOMER_DETAILS_TO_COMPLETE_CUSTOMER_CALL",
          "id": "1777069846874",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Construct query to get the isntallments requiring promise",
            "name": "Construct Payload to Fetch Installments Requiring Promise",
            "returnType": "object",
            "sourceCode": "let pAccountId = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.customerAccountId;\n\n/* payload object for receivables payment schedules by account id */\nlet requestPayload = {\n  parameters: {\n    bindAccountId: pAccountId\n  },\n  viewQueries: {\n    receivablesPaymentSchedules: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        \"paymentScheduleId\": \"paymentScheduleId\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"transactionDate\": \"transactionDate\",\n        \"originalAmount\": \"originalAmount\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"disputeAmount\": \"disputeAmount\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"installmentStatus\": \"installmentStatus\",\n        \"installmentClass\": \"installmentClass\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"excludeFromDunning\": \"excludeFromDunning\",\n        \"accountedBalanceDue\": \"accountedBalanceDue\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.customer.registryId\": \"partyNumber\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\"\n      }\n    },\n    collectionsPaymentPromise: {\n      view: \"collectionsPaymentPromise\",\n      businessObject: \"CustomerPromiseDetail\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"promiseDate\": \"promiseDate\",\n        \"promiseAmount\": \"promiseAmount\",\n        \"remainingAmount\": \"remainingAmount\",\n        \"statusLookup.lookupCode\": \"status\",\n        \"delinquency.delinquencyId\": \"delinquencyId\",\n        \"delinquency.paymentSchedule.paymentScheduleId\": \"paymentScheduleId\"\n      }\n    }\n  },\n  select:\n    \"select distinct rps.paymentScheduleId paymentScheduleId, \" +\n    \"to_char(rps.installmentDueDate,'YYYY-MM-DD') installmentDueDate, \" +\n    \"to_char(rps.transactionDate,'YYYY-MM-DD') transactionDate, \" +\n    \"rps.originalAmount originalAmount, \" +\n    \"rps.amountRemaining amountRemaining, \" +\n    \"rps.disputeAmount disputeAmount, \" +\n    \"rps.accountedBalanceDue accountedBalanceDue, \" +\n    \"rps.transactionNumber transactionNumber, \" +\n    \"rps.installmentStatus installmentStatus, \" +\n    \"rps.installmentClass installmentClass, \" +\n    \"rps.overdueFlag overdueFlag, \" +\n    \"rps.currencyCode currencyCode, \" +\n    \"rps.accountId accountId, \" +\n    \"rps.accountNumber accountNumber, \" +\n    \"rps.partyName partyName, \" +\n    \"rps.partyNumber partyNumber, \" +\n    \"rps.customerTransactionId customerTransactionId, \" +\n    \"rps.purchaseOrderNumber purchaseOrderNumber, \" +\n    \"rps.purchaseOrderDate purchaseOrderDate, \" +\n    \"rps.wayBillNumber wayBillNumber, \" +\n    \"rps.fOB fOB, \" +\n    \"rps.customerTransactionReference customerTransactionReference, \" +\n    \"rps.customerTransactionSource customerTransactionSource, \" +\n    \"rps.customerTransactionType customerTransactionType, \" +\n    \"rps.businessUnit businessUnit, \" +\n    \"trunc(sysdate) - trunc(rps.installmentDueDate) daysOverdue \" +\n    \"from receivablesPaymentSchedules rps \" +\n    \"where rps.accountId = :bindAccountId \" +\n    \"and rps.installmentStatus = 'OP' \" +\n    \"and rps.amountRemaining > 0 \" +\n    \"and nvl(rps.disputeAmount,0) = 0 \" +\n    \"and trunc(sysdate) > trunc(rps.installmentDueDate) \" +\n    \"and nvl(rps.excludeFromDunning,'X') != 'C' \" +\n    \"and rps.installmentClass in ('INV','DM','BR','CB') \" +\n    \"and not exists ( \" +\n    \"  select 1 \" +\n    \"  from collectionsPaymentPromise cpp \" +\n    \"  where cpp.paymentScheduleId = rps.paymentScheduleId \" +\n    \"  and cpp.status = 'COLLECTABLE' \" +\n    \"  and trunc(cpp.promiseDate) >= trunc(sysdate) \" +\n    \") \" +\n    \"order by nvl(rps.accountedBalanceDue,0) desc, trunc(sysdate) - trunc(rps.installmentDueDate) desc\"\n};\n\n/* final result to return from agent studio code node */\nlet result = requestPayload;\n\nreturn result;",
            "sourceType": "code"
          },
          "outcomes": {
            "success": "1776689134040"
          },
          "diagram": {
            "x": 8984,
            "y": 7022
          },
