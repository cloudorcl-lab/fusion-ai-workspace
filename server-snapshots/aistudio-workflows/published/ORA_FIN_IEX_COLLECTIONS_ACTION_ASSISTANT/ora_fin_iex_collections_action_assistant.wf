          "id": "1780026430073",
          "code": "FIN_IEX_REFERENCE_BLOCK_VALUE_FORMATTER",
          "type": "REFERENCEABLEBLOCK",
          "inputs": []
        },
        {
          "metadata": {
            "name": "Process Unformatted Email Message Details for Promises",
            "sourceCode": "/* source promise payload records */\nlet promiseMessageDetails = $context.$nodes.FIN_IEX_BO_GET_EMAIL_MESSAGE_DETAILS_FOR_PROMISES.$output || [];\n\n/* eligible statuses */\nlet validStatuses = {\n  ORA_ACTION_PENDING: true,\n  ORA_REVIEW_PENDING: true\n};\n\n/* final output list */\nlet transformedRecords = [];\nlet messageId = \"\";\nlet intentCode = \"\";\nlet summary = null;\nlet errors = [];\nlet status = \"\";\nlet headerErrorsByInvoice = [];\n\n/* iterate through input records */\nfor (let i = 0; i < promiseMessageDetails.length; i++) {\n  let record = promiseMessageDetails[i] || {};\n  let processingStatusCode = record.PROCESSINGSTATUSCODE || \"\";\n  let requestDataSource = record.REQUESTDATA || \"{}\";\n  let requestData = {};\n  let actionablePayload = {};\n  let originalPromiseTransactionRequest = {};\n  let validatedInvoicesObject = {};\n  let promiseDetails = {};\n  let promiseBalanceAmountFlag = \"\";\n  let promiseAmount = null;\n  let promiseDate = \"\";\n  let responseData = record.RESPONSEDATA || {};\n  let isFirstRecord = false;\n\n  try {\n    requestData = typeof requestDataSource === \"string\" ? JSON.parse(requestDataSource) : requestDataSource;\n  } catch (e) {\n    requestData = {};\n  }\n\n  if (typeof responseData === \"string\") {\n    try {\n      responseData = JSON.parse(responseData);\n    } catch (e) {\n      responseData = {};\n    }\n  }\n\n  isFirstRecord = responseData && responseData.firstRecord === \"Y\";\n  actionablePayload = requestData.actionablePayload || {};\n  originalPromiseTransactionRequest = requestData.originalPromiseTransactionRequest || {};\n  validatedInvoicesObject = originalPromiseTransactionRequest.validatedInvoicesObject || {};\n  promiseDetails = validatedInvoicesObject.promise || {};\n\n  promiseBalanceAmountFlag = actionablePayload.PromiseBalanceAmount || promiseDetails.promiseBalanceAmountFlag || \"\";\n\n  if (promiseBalanceAmountFlag === \"Y\") {\n    promiseAmount = record.AMOUNTREMAINING;\n  } else {\n    promiseAmount = actionablePayload.PromiseAmount;\n    if (promiseAmount === undefined || promiseAmount === null || promiseAmount === \"\") {\n      promiseAmount = promiseDetails.totalPromiseAmount;\n    }\n    if (promiseAmount === undefined || promiseAmount === null || promiseAmount === \"\") {\n      promiseAmount = record.AMOUNTREMAINING;\n    }\n  }\n\n  promiseDate = actionablePayload.PromiseDate || promiseDetails.promiseDate || \"\";\n  if (promiseDate && promiseDate.length >= 10) {\n    promiseDate = promiseDate.substring(0, 10);\n  }\n\n  if (validStatuses[processingStatusCode]) {\n    if (isFirstRecord) {\n      summary = requestData.summary || null;\n      errors = requestData.summary && Array.isArray(requestData.summary.errors) ? requestData.summary.errors : [];\n      headerErrorsByInvoice = requestData.summary && Array.isArray(requestData.summary.errorsByInvoice) ? requestData.summary.errorsByInvoice : [];\n      status = processingStatusCode;\n    }\n\n    if (!messageId) {\n      messageId = record.MESSAGEID || \"\";\n    }\n\n    if (!intentCode) {\n      intentCode = record.INTENTCODE || \"\";\n    }\n\n    transformedRecords.push({\n      CustomerMessageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n      ProcessingStatusCode: processingStatusCode,\n      BusinessUnit: actionablePayload.BusinessUnit || record.BUSINESSUNIT || \"\",\n      BillToCustomerAccount: actionablePayload.BillToCustomerAccount || record.ACCOUNTNUMBER || \"\",\n      TransactionNumber: actionablePayload.TransactionNumber || record.TRANSACTIONNUMBER || \"\",\n      TransactionDate: {\n        formatValue: actionablePayload.TransactionDate || record.TRANSACTIONDATE || \"\",\n        formatType: \"Date\"\n      },\n      InstallmentNumber: actionablePayload.InstallmentNumber || \"\",\n      InstallmentDueDate: {\n        formatValue: record.INSTALLMENTDUEDATE || record.DUEDATE || \"\",\n        formatType: \"Date\"\n      },\n      TransactionAmountRemaining: {\n        formatValue: record.AMOUNTREMAINING,\n        formatType: \"Amount\"\n      },\n      TransactionCurrency: record.CURRENCYCODE || \"\",\n      PromiseAmount: {\n        formatValue: promiseAmount,\n        formatType: \"Amount\"\n      },\n      PromiseDate: {\n        formatValue: promiseDate,\n        formatType: \"Date\"\n      }\n    });\n  } else if (processingStatusCode === \"ORA_ERROR_REVIEW_PENDING\") {\n    if (isFirstRecord) {\n      summary = requestData.summary || null;\n      errors = requestData.errors || (requestData.summary && Array.isArray(requestData.summary.errorsByInvoice) ? requestData.summary.errorsByInvoice : []);\n      headerErrorsByInvoice = requestData.summary && Array.isArray(requestData.summary.errorsByInvoice) ? requestData.summary.errorsByInvoice : [];\n      status = processingStatusCode;\n    }\n\n    if (!messageId) {\n      messageId = record.MESSAGEID || \"\";\n    }\n\n    if (!intentCode) {\n      intentCode = record.INTENTCODE || \"\";\n    }\n\n    transformedRecords.push({\n      CustomerMessageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n      ProcessingStatusCode: processingStatusCode,\n      BusinessUnit: actionablePayload.BusinessUnit || record.BUSINESSUNIT || \"\",\n      BillToCustomerAccount: actionablePayload.BillToCustomerAccount || record.ACCOUNTNUMBER || \"\",\n      TransactionNumber: actionablePayload.TransactionNumber || record.TRANSACTIONNUMBER || \"\",\n      TransactionDate: {\n        formatValue: actionablePayload.TransactionDate || record.TRANSACTIONDATE || \"\",\n        formatType: \"Date\"\n      },\n      InstallmentNumber: actionablePayload.InstallmentNumber || \"\",\n      InstallmentDueDate: {\n        formatValue: record.INSTALLMENTDUEDATE || record.DUEDATE || \"\",\n        formatType: \"Date\"\n      },\n      TransactionAmountRemaining: {\n        formatValue: record.AMOUNTREMAINING,\n        formatType: \"Amount\"\n      },\n      TransactionCurrency: record.CURRENCYCODE || \"\",\n      PromiseAmount: {\n        formatValue: promiseAmount,\n        formatType: \"Amount\"\n      },\n      PromiseDate: {\n        formatValue: promiseDate,\n        formatType: \"Date\"\n      }\n    });\n  }\n}\n\n/* update item-level error details from first-record errorsByInvoice */\nfor (let m = 0; m < transformedRecords.length; m++) {\n  let itemRecord = transformedRecords[m] || {};\n  let itemTransactionNumber = itemRecord.TransactionNumber || \"\";\n  let itemErrorDetails = [];\n\n  for (let n = 0; n < headerErrorsByInvoice.length; n++) {\n    let invoiceErrorItem = headerErrorsByInvoice[n] || {};\n    if (invoiceErrorItem.invoiceNumber === itemTransactionNumber) {\n      itemErrorDetails = invoiceErrorItem.errors || [];\n      break;\n    }\n  }\n\n  if (itemErrorDetails.length > 0) {\n    itemRecord.ErrorDetails = itemErrorDetails;\n  }\n}\n\n/* final response json */\nlet result = {\n  messageId: messageId,\n  intentCode: intentCode,\n  status: status,\n  summary: summary,\n  errors: errors,\n  items: transformedRecords\n};\n\nreturn result;",
            "returnType": "object"
          },
