        {
          "metadata": {
            "name": "Process Unformatted Email Message Details for Disputes",
            "returnType": "object",
            "sourceCode": "/* source dispute payload records */\nlet disputeMessageDetails = $context.$nodes.FIN_IEX_BO_GET_EMAIL_MESSAGE_DETAILS_FOR_DISPUTES.$output || [];\n\n/* lookup BO outputs */\nlet disputeSectionsOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_SECTIONS_TO_GET_DETAILS.$output || [];\nlet disputeReasonsOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_REASON_TO_GET_DETAILS.$output || [];\nlet disputeTypesOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_TYPE_TO_GET_DETAILS.$output || [];\n\nfunction buildLookupMap(items, codeKey, meaningKey) {\n  let map = {};\n  let list = Array.isArray(items) ? items : [];\n\n  for (let i = 0; i < list.length; i++) {\n    let item = list[i] || {};\n    let code = item[codeKey];\n    let meaning = item[meaningKey];\n\n    if (code !== undefined && code !== null && code !== \"\") {\n      map[String(code)] = meaning !== undefined && meaning !== null ? meaning : \"\";\n    }\n  }\n\n  return map;\n}\n\nfunction resolveMeaning(value, lookupMap) {\n  if (value === undefined || value === null || value === \"\") {\n    return \"\";\n  }\n\n  let key = String(value);\n  if (Object.prototype.hasOwnProperty.call(lookupMap, key)) {\n    return lookupMap[key];\n  }\n\n  return value;\n}\n\nlet disputeSectionMap = buildLookupMap(disputeSectionsOutput, \"DISPUTESECTIONCODE\", \"DISPUTESECTION\");\nlet disputeReasonMap = buildLookupMap(disputeReasonsOutput, \"DISPUTEREASONCODE\", \"DISPUTEREASON\");\nlet disputeTypeMap = buildLookupMap(disputeTypesOutput, \"DISPUTETYPECODE\", \"DISPUTETYPE\");\n\n/* eligible statuses */\nlet validStatuses = {\n  ORA_ACTION_PENDING: true,\n  ORA_REVIEW_PENDING: true,\n  ORA_ERROR_REVIEW_PENDING: true\n};\n\n/* final output list */\nlet transformedRecords = [];\nlet messageId = \"\";\nlet intentCode = \"\";\nlet summary = null;\nlet errors = [];\nlet status = \"\";\n\n/* iterate through input records */\nfor (let i = 0; i < disputeMessageDetails.length; i++) {\n  let record = disputeMessageDetails[i] || {};\n  let processingStatusCode = record.PROCESSINGSTATUSCODE || \"\";\n  let requestDataSource = record.REQUESTDATA || \"{}\";\n  let responseDataSource = record.RESPONSEDATA || \"{}\";\n  let requestData = {};\n  let responseData = {};\n  let actionablePayload = {};\n  let isFirstRecord = false;\n  let invoiceErrors = [];\n\n  let disputeAmount = 0;\n  let customerComments = \"\";\n  let disputeSection = \"\";\n  let disputePercentage = \"\";\n  let customerTransactionId = \"\";\n  let billToCustomerNumber = \"\";\n  let disputeType = \"\";\n  let disputeReason = \"\";\n  let receivablesDisputeLines = [];\n\n  try {\n    requestData = typeof requestDataSource === \"string\"\n      ? JSON.parse(requestDataSource)\n      : requestDataSource;\n  } catch (e) {\n    requestData = {};\n  }\n\n  try {\n    responseData = typeof responseDataSource === \"string\"\n      ? JSON.parse(responseDataSource)\n      : (responseDataSource || {});\n  } catch (e) {\n    responseData = {};\n  }\n\n  actionablePayload = requestData.actionablePayload || {};\n  isFirstRecord = responseData.firstRecord === \"Y\";\n\n  if (!validStatuses[processingStatusCode]) {\n    continue;\n  }\n\n  if (isFirstRecord) {\n    summary = requestData.summary || null;\n    status = processingStatusCode;\n\n    if (Array.isArray(requestData.errors)) {\n      errors = requestData.errors;\n    } else if (requestData.summary && Array.isArray(requestData.summary.errors)) {\n      errors = requestData.summary.errors;\n    }\n  }\n\n  if (!messageId) {\n    messageId = record.MESSAGEID || \"\";\n  }\n\n  if (!intentCode) {\n    intentCode = record.INTENTCODE || \"\";\n  }\n\n  customerTransactionId = actionablePayload.CustomerTransactionId || record.CUSTOMERTRANSACTIONID || \"\";\n  billToCustomerNumber = actionablePayload.BillToCustomerNumber || record.ACCOUNTNUMBER || \"\";\n  customerComments = actionablePayload.CustomerComments || \"\";\n  disputeSection = resolveMeaning(actionablePayload.DisputeSection || \"\", disputeSectionMap);\n\n  disputePercentage = actionablePayload.DisputePercentage;\n  if (disputePercentage === undefined || disputePercentage === null) {\n    disputePercentage = \"\";\n  }\n\n  disputeType = resolveMeaning(actionablePayload.DisputeType || \"\", disputeTypeMap);\n  disputeReason = resolveMeaning(actionablePayload.DisputeReason || \"\", disputeReasonMap);\n\n  receivablesDisputeLines = Array.isArray(actionablePayload.receivablesDisputeLines)\n    ? actionablePayload.receivablesDisputeLines\n    : [];\n\n  disputeAmount = actionablePayload.DisputeAmount;\n  if (disputeAmount === undefined || disputeAmount === null || disputeAmount === \"\") {\n    disputeAmount = 0;\n  }\n\n  invoiceErrors = Array.isArray(requestData.errors) ? requestData.errors : [];\n\n  let transformedItem = {\n    CustomerMessageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n    MessageId: record.MESSAGEID || \"\",\n    IntentCode: record.INTENTCODE || \"\",\n    ProcessingStatusCode: processingStatusCode,\n    CustomerTransactionId: customerTransactionId,\n    BillToCustomerNumber: billToCustomerNumber,\n    TransactionNumber: record.TRANSACTIONNUMBER || \"\",\n    TransactionDate: {\n      formatValue: record.TRANSACTIONDATE || \"\",\n      formatType: \"Date\"\n    },\n    DueDate: {\n      formatValue: record.DUEDATE || \"\",\n      formatType: \"Date\"\n    },\n    TransactionAmountRemaining: {\n      formatValue: record.AMOUNTREMAINING,\n      formatType: \"Amount\"\n    },\n    TransactionCurrency: record.CURRENCYCODE || \"\",\n    PartyName: record.PARTYNAME || \"\",\n    CustomerTransactionSource: record.CUSTOMERTRANSACTIONSOURCE || \"\",\n    CustomerTransactionType: record.CUSTOMERTRANSACTIONTYPE || \"\",\n    BusinessUnit: record.BUSINESSUNIT || \"\",\n    SiteUseId: record.SITEUSEID || \"\",\n    AccountId: record.ACCOUNTID || \"\",\n    PartyId: record.PARTYID || \"\",\n    DisputeAmount: {\n      formatValue: disputeAmount,\n      formatType: \"Amount\"\n    },\n    CustomerComments: customerComments,\n    DisputeSection: disputeSection,\n    DisputePercentage: disputePercentage,\n    DisputeType: disputeType,\n    DisputeReason: disputeReason,\n    receivablesDisputeLines: receivablesDisputeLines,\n    ErrorDetails: invoiceErrors\n  };\n\n  transformedRecords.push(transformedItem);\n}\n\n/* fallback summary / status / top-level errors if no firstRecord was found */\nif (!summary || !status || errors.length === 0) {\n  for (let k = 0; k < disputeMessageDetails.length; k++) {\n    let fallbackRecord = disputeMessageDetails[k] || {};\n    let fallbackRequestDataSource = fallbackRecord.REQUESTDATA || \"{}\";\n    let fallbackRequestData = {};\n\n    try {\n      fallbackRequestData = typeof fallbackRequestDataSource === \"string\"\n        ? JSON.parse(fallbackRequestDataSource)\n        : fallbackRequestDataSource;\n    } catch (e) {\n      fallbackRequestData = {};\n    }\n\n    if (!summary && fallbackRequestData.summary) {\n      summary = fallbackRequestData.summary;\n    }\n\n    if ((!errors || errors.length === 0) && Array.isArray(fallbackRequestData.errors)) {\n      errors = fallbackRequestData.errors;\n    }\n\n    if (!status && fallbackRecord.PROCESSINGSTATUSCODE) {\n      status = fallbackRecord.PROCESSINGSTATUSCODE;\n    }\n  }\n}\n\n/* final response */\nlet result = {\n  messageId: messageId,\n  intentCode: intentCode,\n  status: status,\n  summary: summary,\n  errors: errors,\n  items: transformedRecords\n};\n\nreturn result;"
