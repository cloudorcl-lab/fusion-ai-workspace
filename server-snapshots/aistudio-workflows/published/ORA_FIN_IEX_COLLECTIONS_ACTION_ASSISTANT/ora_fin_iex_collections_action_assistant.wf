          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Customer Details to Record Customer Call",
            "returnType": "object",
            "sourceCode": "var rawResult = $context?.$nodes?.CONSTRUCT_PAYLOAD_TO_RECORD_CALL_NOTES?.$output?.result || \"{}\";\n\nvar sourceData = {};\ntry {\n  sourceData = typeof rawResult === \"string\" ? JSON.parse(rawResult) : rawResult;\n} catch (e) {\n  sourceData = {};\n}\n\nvar result = {\n  partyNumber: sourceData.PartyNumber || \"\",\n  accountNumber: sourceData.AccountNumber || \"\",\n  createdFrom: \"recordingCustomerCall\",\n  strategyUserTasks: [\n    {\n      StrategyTaskTemplate: \"Call Customer\",\n      WorkOrder: 101,\n      UserTaskStatus: \"Complete\"\n    }\n  ]\n};\n\nreturn result;"
          },
