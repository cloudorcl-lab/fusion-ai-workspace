            "sourceCode": "let result = null;\nlet intentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode || \"\";\n\nif (\n  intentCode === \"ORA_PROMISE_TO_PAY\" &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PROMISE_REQUESTS &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PROMISE_REQUESTS.$output\n) {\n  result = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PROMISE_REQUESTS.$output.result;\n} else if (\n  intentCode === \"ORA_DISPUTE_REQUEST\" &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_DISPUTE_REQUESTS &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_DISPUTE_REQUESTS.$output\n) {\n  result = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_DISPUTE_REQUESTS.$output.result;\n} else if (\n  intentCode === \"ORA_PO_UPDATE\" &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PO_UPDATE &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PO_UPDATE.$output\n) {\n  result = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PO_UPDATE.$output.result;\n} else if (\n  intentCode === \"ORA_INVOICE_REPRINT\" &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_INVOICE_REPRINT &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_INVOICE_REPRINT.$output\n) {\n  result = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_INVOICE_REPRINT.$output.result;\n}\n\nreturn result;",
