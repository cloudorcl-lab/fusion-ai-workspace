        {
          "metadata": {
            "description": "Generating json in unformatted format for failed promise requsets",
            "name": "Process Unformatted Failed Promise Requests",
            "sourceCode": "/* source failed payload records */\nlet failedMessageDetails = $context.$nodes.EXECUTE_PAYLOAD_TO_FETCH_FAILED_PROMISE_REQUESTS.$output || [];\nlet updatedResponseRecords = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PROMISE_REQUESTS.$output.result || [];\n\n/* map updated records by message detail id */\nlet updatedRecordMap = {};\nfor (let j = 0; j < updatedResponseRecords.length; j++) {\n  let updatedRecord = updatedResponseRecords[j] || {};\n  let updatedMessageDetailId = updatedRecord.messageDetailId || \"\";\n\n  if (updatedMessageDetailId) {\n    updatedRecordMap[String(updatedMessageDetailId)] = updatedRecord;\n  }\n}\n\n/* processing status meaning lookup */\nlet processingStatusMeaningMap = {\n  ORA_PROCESSING_ERROR: \"Processing error\",\n  ORA_PROCESSED: \"Processed\",\n  ORA_ACTION_PENDING: \"Action pending\",\n  ORA_REVIEW_PENDING: \"Review pending\"\n};\n\n/* final output list */\nlet transformedRecords = [];\nlet messageId = \"\";\nlet intentCode = \"\";\n\n/* iterate through input records */\nfor (let i = 0; i < failedMessageDetails.length; i++) {\n  let record = failedMessageDetails[i] || {};\n  let messageDetailId = record.CUSTOMERMESSAGEDETAILID || \"\";\n  let matchedUpdatedRecord = updatedRecordMap[String(messageDetailId)] || null;\n  let finalProcessingStatusCode = matchedUpdatedRecord ? (matchedUpdatedRecord.processingStatusCode || \"\") : (record.PROCESSINGSTATUSCODE || \"\");\n  let finalProcessingStatusMeaning = processingStatusMeaningMap[finalProcessingStatusCode] || record.PROCESSINGSTATUSMEANING || \"\";\n  let requestData = {};\n  let actionablePayload = {};\n  let originalPromiseTransactionRequest = {};\n  let validatedInvoicesObject = {};\n  let promiseDetails = {};\n  let promiseBalanceAmountFlag = \"\";\n  let promiseAmount = null;\n  let promiseDate = \"\";\n  let requestDataString = record.REQUESTDATA || \"{}\";\n\n  try {\n    requestData = typeof requestDataString === \"string\" ? JSON.parse(requestDataString) : requestDataString;\n  } catch (e) {\n    requestData = {};\n  }\n\n  actionablePayload = requestData.actionablePayload || {};\n  originalPromiseTransactionRequest = requestData.originalPromiseTransactionRequest || {};\n  validatedInvoicesObject = originalPromiseTransactionRequest.validatedInvoicesObject || {};\n  promiseDetails = validatedInvoicesObject.promise || {};\n\n  promiseBalanceAmountFlag = actionablePayload.PromiseBalanceAmount || promiseDetails.promiseBalanceAmountFlag || \"\";\n\n  if (promiseBalanceAmountFlag === \"Y\") {\n    promiseAmount = record.AMOUNTREMAINING;\n  } else {\n    promiseAmount = actionablePayload.PromiseAmount;\n    if (promiseAmount === undefined || promiseAmount === null || promiseAmount === \"\") {\n      promiseAmount = promiseDetails.totalPromiseAmount;\n    }\n    if (promiseAmount === undefined || promiseAmount === null || promiseAmount === \"\") {\n      promiseAmount = record.AMOUNTREMAINING;\n    }\n  }\n\n  promiseDate = actionablePayload.PromiseDate || promiseDetails.promiseDate || \"\";\n  if (promiseDate && promiseDate.length >= 10) {\n    promiseDate = promiseDate.substring(0, 10);\n  }\n\n  if (!messageId) {\n    messageId = record.MESSAGEID || \"\";\n  }\n\n  if (!intentCode) {\n    intentCode = record.INTENTCODE || \"\";\n  }\n\n  transformedRecords.push({\n    CustomerMessageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n    ProcessingStatusCode: finalProcessingStatusCode,\n    ProcessingStatusMeaning: finalProcessingStatusMeaning,\n    BusinessUnit: actionablePayload.BusinessUnit || record.BUSINESSUNIT || \"\",\n    BillToCustomerAccount: actionablePayload.BillToCustomerAccount || record.ACCOUNTNUMBER || \"\",\n    TransactionNumber: actionablePayload.TransactionNumber || record.TRANSACTIONNUMBER || \"\",\n    TransactionDate: {\n      formatValue: actionablePayload.TransactionDate || record.TRANSACTIONDATE || \"\",\n      formatType: \"Date\"\n    },\n    InstallmentNumber: actionablePayload.InstallmentNumber || \"\",\n    InstallmentDueDate: {\n      formatValue: record.INSTALLMENTDUEDATE || record.DUEDATE || \"\",\n      formatType: \"Date\"\n    },\n    TransactionAmountRemaining: {\n      formatValue: record.AMOUNTREMAINING,\n      formatType: \"Amount\"\n    },\n    TransactionCurrency: record.CURRENCYCODE || \"\",\n    PromiseAmount: {\n      formatValue: promiseAmount,\n      formatType: \"Amount\"\n    },\n    PromiseDate: {\n      formatValue: promiseDate,\n      formatType: \"Date\"\n    },\n    ResponseData: matchedUpdatedRecord ? (matchedUpdatedRecord.responseData || \"\") : (record.RESPONSEDATA || \"\")\n  });\n}\n\n/* final response json */\nlet result = {\n  messageId: messageId,\n  intentCode: intentCode,\n  items: transformedRecords\n};\n\nreturn result;",
            "returnType": "object"
          },
