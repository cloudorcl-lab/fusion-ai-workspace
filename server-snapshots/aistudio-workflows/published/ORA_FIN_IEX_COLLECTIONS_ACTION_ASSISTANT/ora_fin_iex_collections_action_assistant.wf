            "returnType": "object",
            "sourceCode": "const arr = $context.$nodes.FIN_IEX_CODE_REMOVE_ERROR_REQUESTS_FOR_EMAIL_MESSAGE.$output.result;\nconst output = arr.map(item => {\n  const requestData = JSON.parse(item.REQUESTDATA);\n  return {\n    id: item.CUSTOMERMESSAGEDETAILID,\n    path: \"/receivablesInvoices/\" + item.CUSTOMERTRANSACTIONID,\n    operation: \"update\",\n    payload: requestData.actionablePayload.poUpdate\n  };\n});\n\nreturn output;"
