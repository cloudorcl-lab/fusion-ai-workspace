            "returnType": "object",
            "sourceCode": "let pMessageId = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.messageId;\nlet pIntentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode;\n\n/* payload object for message details */\nlet requestPayload = {\n  parameters: {\n    bindMessageId: pMessageId,\n    bindIntentCode: pIntentCode\n  },\n  viewQueries: {\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"processingStatus.meaning\": \"processingStatusMeaning\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customer.id\": \"partyId\"\n      }\n    },\n    receivablesPaymentSchedules: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        \"paymentScheduleId\": \"paymentScheduleId\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"transactionDate\": \"transactionDate\",\n        \"originalAmount\": \"originalAmount\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"installmentStatus\": \"installmentStatus\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.dueDate\": \"dueDate\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\"\n      }\n    }\n  },\n  select: \"select collectionsCustomerMessageDetails.customerMessageDetailId customerMessageDetailId, collectionsCustomerMessageDetails.messageId messageId, collectionsCustomerMessageDetails.paymentScheduleId paymentScheduleId, collectionsCustomerMessageDetails.customerTransactionId customerTransactionId, collectionsCustomerMessageDetails.processingStatusCode processingStatusCode, collectionsCustomerMessageDetails.processingStatusMeaning processingStatusMeaning, collectionsCustomerMessageDetails.intentCode intentCode, collectionsCustomerMessageDetails.requestData requestData, collectionsCustomerMessageDetails.responseData responseData, collectionsCustomerMessageDetails.siteUseId siteUseId, collectionsCustomerMessageDetails.accountId accountId, collectionsCustomerMessageDetails.partyId partyId, to_char(receivablesPaymentSchedules.installmentDueDate ,'YYYY-MM-DD') installmentDueDate, to_char(receivablesPaymentSchedules.transactionDate,'YYYY-MM-DD') transactionDate, receivablesPaymentSchedules.originalAmount originalAmount, receivablesPaymentSchedules.amountRemaining amountRemaining, receivablesPaymentSchedules.transactionNumber transactionNumber, receivablesPaymentSchedules.installmentStatus installmentStatus, receivablesPaymentSchedules.overdueFlag overdueFlag, receivablesPaymentSchedules.currencyCode currencyCode, receivablesPaymentSchedules.accountNumber accountNumber, receivablesPaymentSchedules.partyName partyName, to_char(receivablesPaymentSchedules.dueDate,'YYYY-MM-DD') dueDate, receivablesPaymentSchedules.purchaseOrderNumber purchaseOrderNumber, receivablesPaymentSchedules.purchaseOrderDate purchaseOrderDate, receivablesPaymentSchedules.wayBillNumber wayBillNumber, receivablesPaymentSchedules.fOB fOB, receivablesPaymentSchedules.customerTransactionReference customerTransactionReference, receivablesPaymentSchedules.customerTransactionSource customerTransactionSource, receivablesPaymentSchedules.customerTransactionType customerTransactionType, receivablesPaymentSchedules.businessUnit businessUnit from collectionsCustomerMessageDetails, receivablesPaymentSchedules where collectionsCustomerMessageDetails.intentCode = :bindIntentCode and collectionsCustomerMessageDetails.messageId = :bindMessageId and collectionsCustomerMessageDetails.processingStatusCode in ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING') and collectionsCustomerMessageDetails.paymentScheduleId = receivablesPaymentSchedules.paymentScheduleId\"\n};\n\n/* final result to return from agent studio code node */\nlet result = requestPayload;\nreturn result;",
