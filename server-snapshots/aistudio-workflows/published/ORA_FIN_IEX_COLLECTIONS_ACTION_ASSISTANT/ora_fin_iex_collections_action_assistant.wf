        {
          "metadata": {
            "description": "Constructs payload to fetch existing strategy for the given account",
            "errorNodeId": null,
            "name": "Construct Payload to fetch existing strategy",
            "returnType": "object",
            "sourceCode": "/* input parameters */\nlet bindPartyNumber = $context.$variables.StrategyDetails.partyNumber;\nlet bindAccountNumber = $context.$variables.StrategyDetails.accountNumber;\n\nif (bindPartyNumber == null) {\n  bindPartyNumber = \"\";\n}\n\nif (bindAccountNumber == null) {\n  bindAccountNumber = \"\";\n}\n\n/* derive strategy template name based on account number */\nlet strategyTemplateName = \"\";\n\nstrategyTemplateName = \"Collector Workspace Strategy\";\n\n\n/* build dynamic q filter */\nlet filterParts = [];\n\nif (bindPartyNumber !== \"\") {\n  filterParts.push(\"PartyNumber='\" + bindPartyNumber + \"'\");\n}\n\nif (bindAccountNumber !== \"\") {\n  filterParts.push(\"AccountNumber='\" + bindAccountNumber + \"'\");\n}\n\nfilterParts.push(\"StrategyTemplate='\" + strategyTemplateName + \"'\");\n\nlet qFilter = filterParts.join(\" and \");\nlet fullQuery =  qFilter + \"&orderBy=CreationDate:desc&limit=1\";\n\n/* final result */\nlet result = {\n  q: qFilter,\n  queryString: fullQuery\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776855789412"
          },
          "diagram": {
            "x": 4897.32441100912,
            "y": 8577.657687527353
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_PAYLOAD_TO_FETCH_EXISTING_STRATEGY",
