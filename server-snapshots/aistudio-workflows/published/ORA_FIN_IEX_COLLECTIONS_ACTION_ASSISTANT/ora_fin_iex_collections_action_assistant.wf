          "metadata": {
            "description": "Construct payload to fetch failed PO update requests",
            "name": "Construct Payload to Fetch Failed PO Update Requests",
            "errorNodeId": "1778436031247",
            "returnType": "object",
            "sourceCode": "let pMessageId = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.messageId;\nlet pIntentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode;\n\nlet requestPayload = {\n  parameters: {\n    bindMessageId: pMessageId,\n    bindIntentCode: pIntentCode\n  },\n  viewQueries: {\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customer.id\": \"partyId\"\n      }\n    },\n    receivablesPaymentSchedules: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        \"transactionDate\": \"transactionDate\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"installmentDueDate\": \"dueDate\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\",\n        \"customerTransaction.pONumber\": \"currentPONumber\",\n        \"customerTransaction.pODate\": \"currentPODate\"\n      }\n    }\n  },\n  select: \"select cmd.customerMessageDetailId customerMessageDetailId, cmd.messageId messageId, cmd.customerTransactionId customerTransactionId, cmd.processingStatusCode processingStatusCode, cmd.intentCode intentCode, cmd.requestData requestData, cmd.responseData responseData, cmd.siteUseId siteUseId, cmd.accountId accountId, cmd.partyId partyId, rps.transactionNumber transactionNumber, to_char(rps.transactionDate,'YYYY-MM-DD') transactionDate, to_char(rps.dueDate,'YYYY-MM-DD') dueDate, rps.amountRemaining amountRemaining, rps.currencyCode currencyCode, rps.accountNumber accountNumber, rps.partyName partyName, rps.customerTransactionSource customerTransactionSource, rps.customerTransactionType customerTransactionType, rps.businessUnit businessUnit, rps.currentPONumber currentPONumber, to_char(rps.currentPODate,'YYYY-MM-DD') currentPODate from collectionsCustomerMessageDetails cmd, (select receivablesPaymentSchedules.customerTransactionId customerTransactionId, max(receivablesPaymentSchedules.transactionNumber) transactionNumber, max(receivablesPaymentSchedules.transactionDate) transactionDate, max(receivablesPaymentSchedules.dueDate) dueDate, sum(receivablesPaymentSchedules.amountRemaining) amountRemaining, max(receivablesPaymentSchedules.currencyCode) currencyCode, max(receivablesPaymentSchedules.accountNumber) accountNumber, max(receivablesPaymentSchedules.partyName) partyName, max(receivablesPaymentSchedules.customerTransactionSource) customerTransactionSource, max(receivablesPaymentSchedules.customerTransactionType) customerTransactionType, max(receivablesPaymentSchedules.businessUnit) businessUnit, max(receivablesPaymentSchedules.currentPONumber) currentPONumber, max(receivablesPaymentSchedules.currentPODate) currentPODate from receivablesPaymentSchedules group by receivablesPaymentSchedules.customerTransactionId) rps where cmd.intentCode = :bindIntentCode and cmd.messageId = :bindMessageId and cmd.customerTransactionId = rps.customerTransactionId and cmd.processingStatusCode in ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING')\"\n};\n\nlet result = requestPayload;\nreturn result;"
          },
