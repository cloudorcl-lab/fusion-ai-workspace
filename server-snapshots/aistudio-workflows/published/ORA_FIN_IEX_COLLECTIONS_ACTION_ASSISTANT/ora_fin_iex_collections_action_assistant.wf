        {
          "metadata": {
            "description": "Extracting user preferences from user session tool",
            "name": "Extract User Preferences",
            "sourceCode": "let selfDetailsOutput = $context.$nodes.FIN_IEX_TOOL_GET_USER_SESSION.$output || {};\n\nlet selfDetails = selfDetailsOutput.items && selfDetailsOutput.items.length > 0 ? selfDetailsOutput.items[0] : {};\n\nlet userPreferences = {\n  \"PersonNumber\": selfDetails.PersonNumber === undefined ? null : selfDetails.PersonNumber,\n  \"UserDistinguishedName\": selfDetails.UserDistinguishedName === undefined ? null : selfDetails.UserDistinguishedName,\n  \"Username\": selfDetails.Username === undefined ? null : selfDetails.Username,\n  \"DisplayName\": selfDetails.DisplayName === undefined ? null : selfDetails.DisplayName,\n  \"FirstName\": selfDetails.FirstName === undefined ? null : selfDetails.FirstName,\n  \"LastName\": selfDetails.LastName === undefined ? null : selfDetails.LastName,\n  \"MiddleNames\": selfDetails.MiddleNames === undefined ? null : selfDetails.MiddleNames,\n  \"KnownAs\": selfDetails.KnownAs === undefined ? null : selfDetails.KnownAs,\n  \"NameType\": selfDetails.NameType === undefined ? null : selfDetails.NameType,\n  \"Suffix\": selfDetails.Suffix === undefined ? null : selfDetails.Suffix,\n  \"Title\": selfDetails.Title === undefined ? null : selfDetails.Title,\n  \"EmailAddress\": selfDetails.EmailAddress === undefined ? null : selfDetails.EmailAddress,\n  \"Honors\": selfDetails.Honors === undefined ? null : selfDetails.Honors,\n  \"PreNameAdjunct\": selfDetails.PreNameAdjunct === undefined ? null : selfDetails.PreNameAdjunct,\n\n  \"AccessibilityMode\": selfDetails.AccessibilityMode === undefined ? null : selfDetails.AccessibilityMode,\n  \"ClientEncoding\": selfDetails.ClientEncoding === undefined ? null : selfDetails.ClientEncoding,\n  \"ColorContrast\": selfDetails.ColorContrast === undefined ? null : selfDetails.ColorContrast,\n  \"Currency\": selfDetails.Currency === undefined ? null : selfDetails.Currency,\n  \"DateFormat\": selfDetails.DateFormat === undefined ? null : selfDetails.DateFormat,\n  \"DecimalSeparator\": selfDetails.DecimalSeparator === undefined ? null : selfDetails.DecimalSeparator,\n  \"FontSize\": selfDetails.FontSize === undefined ? null : selfDetails.FontSize,\n  \"GroupingSeparator\": selfDetails.GroupingSeparator === undefined ? null : selfDetails.GroupingSeparator,\n  \"Language\": selfDetails.Language === undefined ? null : selfDetails.Language,\n  \"NumberFormat\": selfDetails.NumberFormat === undefined ? null : selfDetails.NumberFormat,\n  \"ServerTime\": selfDetails.ServerTime === undefined ? null : selfDetails.ServerTime,\n  \"Territory\": selfDetails.Territory === undefined ? null : selfDetails.Territory,\n  \"TimeFormat\": selfDetails.TimeFormat === undefined ? null : selfDetails.TimeFormat,\n  \"TimeZone\": selfDetails.TimeZone === undefined ? null : selfDetails.TimeZone,\n\n  \"DefaultLanguage\": selfDetails.DefaultLanguage === undefined ? null : selfDetails.DefaultLanguage,\n  \"DisplayNameLanguage\": selfDetails.DisplayNameLanguage === undefined ? null : selfDetails.DisplayNameLanguage,\n  \"Initials\": selfDetails.Initials === undefined ? null : selfDetails.Initials,\n  \"AccountType\": selfDetails.AccountType === undefined ? null : selfDetails.AccountType\n};\n\nreturn userPreferences;",
            "returnType": "object"
          },
