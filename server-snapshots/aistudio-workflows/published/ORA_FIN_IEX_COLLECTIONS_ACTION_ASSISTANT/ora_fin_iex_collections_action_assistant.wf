            "name": "Construct for Partial Successful Dispute Requests",
            "returnType": "array",
            "sourceCode": "if ($context.$nodes.FIN_IEX_IF_CHECK_FOR_COMPLETE_FAILURE.$output != true) {\n  const taskData = $context.$nodes.FIN_IEX_BO_EXECUTE_PARTIAL_SUCESSFUL_ACTIONABLE_REQUESTS.$output || {};\n  const messageDetails = $context.$nodes.FIN_IEX_CODE_REMOVE_ERROR_REQUESTS_FOR_EMAIL_MESSAGE.$output.result || [];\n  const originalMessageDetails = $context.$nodes.FIN_IEX_BO_GET_ACTIONABLE_DETAILS_FROM_EMAIL_MESSAGE.$output || [];\n\n  let originalMessageDetailMap = {};\n  for (let i = 0; i < originalMessageDetails.length; i++) {\n    let originalRecord = originalMessageDetails[i] || {};\n    let originalMessageDetailId = originalRecord.CUSTOMERMESSAGEDETAILID || \"\";\n\n    if (originalMessageDetailId) {\n      originalMessageDetailMap[String(originalMessageDetailId)] = originalRecord;\n    }\n  }\n\n  let extractedDataArray = [];\n  let parts = Array.isArray(taskData.parts) ? taskData.parts : [];\n\n  parts.forEach((part, index) => {\n    const payload = (part && part.payload) || {};\n    const messageDetail = messageDetails[index] || {};\n    const customerMessageDetailId = messageDetail.CUSTOMERMESSAGEDETAILID || \"\";\n    const originalMessageDetail = originalMessageDetailMap[String(customerMessageDetailId)] || {};\n    const existingResponseData = originalMessageDetail.RESPONSEDATA;\n\n    const firstLine =\n      payload &&\n      payload.receivablesDisputeLines &&\n      Array.isArray(payload.receivablesDisputeLines.items) &&\n      payload.receivablesDisputeLines.items.length > 0\n        ? payload.receivablesDisputeLines.items[0]\n        : null;\n\n    const newResponseData = {\n      RequestNumber: payload.RequestNumber || \"\",\n      CustomerTransactionId: payload.CustomerTransactionId || \"\",\n      CustomerComments: payload.CustomerComments || \"\",\n      DisputeAmount: payload.DisputeAmount || \"\",\n      DisputeType: payload.DisputeType || \"\",\n      DisputeReason: payload.DisputeReason || \"\",\n      DisputeSection: payload.DisputeSection || \"\",\n      DisputePercentage: payload.DisputePercentage || \"\",\n      TransactionAmount: payload.TransactionAmount || \"\",\n      TransactionCurrencyCode: payload.TransactionCurrencyCode || \"\",\n      TransactionDate: payload.TransactionDate || \"\",\n      TransactionNumber: payload.TransactionNumber || \"\",\n      BillToCustomerNumber: payload.BillToCustomerNumber || \"\",\n      CustomerTransactionLineId: firstLine && firstLine.CustomerTransactionLineId !== undefined && firstLine.CustomerTransactionLineId !== null\n        ? firstLine.CustomerTransactionLineId\n        : \"\",\n      LineNumber: firstLine && firstLine.LineNumber !== undefined && firstLine.LineNumber !== null\n        ? firstLine.LineNumber\n        : \"\",\n      DisputeQuantity: firstLine && firstLine.DisputeQuantity !== undefined && firstLine.DisputeQuantity !== null\n        ? firstLine.DisputeQuantity\n        : \"\",\n      LineDisputeAmount: firstLine && firstLine.LineDisputeAmount !== undefined && firstLine.LineDisputeAmount !== null\n        ? firstLine.LineDisputeAmount\n        : \"\"\n    };\n\n    let finalResponseData = newResponseData;\n    let parsedExistingResponseData = null;\n\n    if (existingResponseData !== null && existingResponseData !== undefined && existingResponseData !== \"\") {\n      if (typeof existingResponseData === \"string\") {\n        try {\n          parsedExistingResponseData = JSON.parse(existingResponseData);\n        } catch (e) {\n          parsedExistingResponseData = null;\n        }\n      } else if (typeof existingResponseData === \"object\" && !Array.isArray(existingResponseData)) {\n        parsedExistingResponseData = existingResponseData;\n      }\n    }\n\n    if (parsedExistingResponseData && typeof parsedExistingResponseData === \"object\" && !Array.isArray(parsedExistingResponseData)) {\n      finalResponseData = Object.assign({}, parsedExistingResponseData, {\n        response: newResponseData\n      });\n    }\n\n    extractedDataArray.push({\n      messageDetailId: customerMessageDetailId,\n      responseData: finalResponseData,\n      processingStatusCode: \"ORA_PROCESSED\"\n    });\n  });\n\n  const errorData = $context.$nodes.FIN_IEX_CODE_EXTRACT_ERROR_IN_BATCH_EXECUTION.$output.result || [];\n  const combinedArray = extractedDataArray.concat(errorData);\n\n  return combinedArray;\n}\n\nreturn $context.$nodes.FIN_IEX_CODE_EXTRACT_ERROR_IN_BATCH_EXECUTION.$output.result;",
            "errorNodeId": "1778436031247"
          },
