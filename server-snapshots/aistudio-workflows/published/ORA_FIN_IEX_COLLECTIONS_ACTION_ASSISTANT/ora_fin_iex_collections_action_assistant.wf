            "sourceCode": "const payloadDetails = $context.$nodes.EXTRACT_PAYLOAD_DETAILS.$output.result || {};\nconst customerContext = payloadDetails.customer_context || {};\n\nconst customerAccountIdRaw =\n  customerContext.customerAccountId ||\n  customerContext.CUSTOMERACCOUNTID ||\n  customerContext[\"Customer Account ID\"] ||\n  null;\n\nconst customerTransactionIdRaw =\n  customerContext.CUSTOMERTRANSACTIONID ||\n  customerContext.customerTransactionId ||\n  customerContext.CustomerTransactionID ||\n  customerContext[\"Customer Transaction ID\"] ||\n  null;\n\nconst accountNumberRaw =\n  customerContext.ACCOUNTNUMBER ||\n  customerContext.accountNumber ||\n  customerContext.AccountNumber ||\n  customerContext[\"Account Number\"] ||\n  \"\";\n\nconst partyNumberRaw =\n  customerContext.PARTYNUMBER ||\n  customerContext.partyNumber ||\n  customerContext.PartyNumber ||\n  customerContext[\"Party Number\"] ||\n  \"\";\n\nreturn {\n  rawPayload: payloadDetails,\n  rawCustomerContext: customerContext,\n  customerAccountId: String(customerAccountIdRaw),\n  customerTransactionId: String(customerTransactionIdRaw),\n  accountNumber: String(accountNumberRaw),\n  partyNumber: String(partyNumberRaw)\n};"
