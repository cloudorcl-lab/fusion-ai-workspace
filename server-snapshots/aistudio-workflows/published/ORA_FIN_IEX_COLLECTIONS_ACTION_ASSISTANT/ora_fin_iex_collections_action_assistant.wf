            "returnType": "object",
            "sourceCode": "/* source failed dispute request records */\nlet failedMessageDetails = $context.$nodes.FIN_IEX_BO_EXECUTE_PAYLOAD_TO_FETCH_FAILED_DISPUTE_REQUESTS.$output || [];\nlet updatedResponseRecords = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_DISPUTE_REQUESTS.$output.result || [];\n\n/* lookup BO outputs */\nlet disputeSectionsOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_SECTIONS_FOR_FAILED_DISPUTE_REQUESTS.$output || [];\nlet disputeReasonsOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_REASON_FOR_FAILED_DISPUTE_REQUESTS.$output || [];\nlet disputeTypesOutput = $context.$nodes.FIN_IEX_BO_GET_DISPUTE_TYPE_FOR_FAILED_DISPUTE_REQUESTS.$output || [];\n\n/* map updated records by message detail id */\nlet updatedRecordMap = {};\nfor (let j = 0; j < updatedResponseRecords.length; j++) {\n  let updatedRecord = updatedResponseRecords[j] || {};\n  let updatedMessageDetailId = updatedRecord.messageDetailId || \"\";\n\n  if (updatedMessageDetailId) {\n    updatedRecordMap[String(updatedMessageDetailId)] = updatedRecord;\n  }\n}\n\nfunction buildLookupMap(items, codeKey, meaningKey) {\n  let map = {};\n  let list = Array.isArray(items) ? items : [];\n\n  for (let i = 0; i < list.length; i++) {\n    let item = list[i] || {};\n    let code = item[codeKey];\n    let meaning = item[meaningKey];\n\n    if (code !== undefined && code !== null && code !== \"\") {\n      map[String(code)] = meaning !== undefined && meaning !== null ? meaning : \"\";\n    }\n  }\n\n  return map;\n}\n\nfunction resolveMeaning(value, lookupMap) {\n  if (value === undefined || value === null || value === \"\") {\n    return \"\";\n  }\n\n  let key = String(value);\n  if (Object.prototype.hasOwnProperty.call(lookupMap, key)) {\n    return lookupMap[key];\n  }\n\n  return value;\n}\n\nlet disputeSectionMap = buildLookupMap(disputeSectionsOutput, \"DISPUTESECTIONCODE\", \"DISPUTESECTION\");\nlet disputeReasonMap = buildLookupMap(disputeReasonsOutput, \"DISPUTEREASONCODE\", \"DISPUTEREASON\");\nlet disputeTypeMap = buildLookupMap(disputeTypesOutput, \"DISPUTETYPECODE\", \"DISPUTETYPE\");\n\n/* processing status meaning lookup */\nlet processingStatusMeaningMap = {\n  ORA_PROCESSING_ERROR: \"Processing error\",\n  ORA_PROCESSED: \"Processed\",\n  ORA_ACTION_PENDING: \"Action pending\",\n  ORA_REVIEW_PENDING: \"Review pending\",\n  ORA_ERROR_REVIEW_PENDING: \"Error review pending\"\n};\n\n/* final output list */\nlet transformedRecords = [];\nlet messageId = \"\";\nlet intentCode = \"\";\nlet summary = null;\nlet errors = [];\nlet status = \"\";\n\n/* iterate through failed request records */\nfor (let i = 0; i < failedMessageDetails.length; i++) {\n  let record = failedMessageDetails[i] || {};\n  let messageDetailId = record.CUSTOMERMESSAGEDETAILID || \"\";\n  let matchedUpdatedRecord = updatedRecordMap[String(messageDetailId)] || null;\n  let finalProcessingStatusCode = matchedUpdatedRecord\n    ? (matchedUpdatedRecord.processingStatusCode || \"\")\n    : (record.PROCESSINGSTATUSCODE || \"\");\n  let finalProcessingStatusMeaning = processingStatusMeaningMap[finalProcessingStatusCode] || record.PROCESSINGSTATUSMEANING || \"\";\n  let requestDataSource = record.REQUESTDATA || \"{}\";\n  let requestData = {};\n  let actionablePayload = {};\n  let invoiceErrors = [];\n\n  let disputeAmount = 0;\n  let customerComments = \"\";\n  let disputeSection = \"\";\n  let disputePercentage = \"\";\n  let customerTransactionId = \"\";\n  let billToCustomerNumber = \"\";\n  let disputeType = \"\";\n  let disputeReason = \"\";\n  let receivablesDisputeLines = [];\n\n  try {\n    requestData = typeof requestDataSource === \"string\"\n      ? JSON.parse(requestDataSource)\n      : (requestDataSource || {});\n  } catch (e) {\n    requestData = {};\n  }\n\n  actionablePayload = requestData.actionablePayload || {};\n\n  if (!summary && requestData.summary) {\n    summary = requestData.summary;\n  }\n\n  if ((!errors || errors.length === 0) && Array.isArray(requestData.errors)) {\n    errors = requestData.errors;\n  }\n\n  if (!status && record.PROCESSINGSTATUSCODE) {\n    status = record.PROCESSINGSTATUSCODE;\n  }\n\n  if (!messageId) {\n    messageId = record.MESSAGEID || \"\";\n  }\n\n  if (!intentCode) {\n    intentCode = record.INTENTCODE || \"\";\n  }\n\n  customerTransactionId = actionablePayload.CustomerTransactionId || record.CUSTOMERTRANSACTIONID || \"\";\n  billToCustomerNumber = actionablePayload.BillToCustomerNumber || record.ACCOUNTNUMBER || \"\";\n  customerComments = actionablePayload.CustomerComments || \"\";\n  disputeSection = resolveMeaning(actionablePayload.DisputeSection || \"\", disputeSectionMap);\n\n  disputePercentage = actionablePayload.DisputePercentage;\n  if (disputePercentage === undefined || disputePercentage === null) {\n    disputePercentage = \"\";\n  }\n\n  disputeType = resolveMeaning(actionablePayload.DisputeType || \"\", disputeTypeMap);\n  disputeReason = resolveMeaning(actionablePayload.DisputeReason || \"\", disputeReasonMap);\n\n  receivablesDisputeLines = Array.isArray(actionablePayload.receivablesDisputeLines)\n    ? actionablePayload.receivablesDisputeLines\n    : [];\n\n  disputeAmount = actionablePayload.DisputeAmount;\n  if (disputeAmount === undefined || disputeAmount === null || disputeAmount === \"\") {\n    disputeAmount = 0;\n  }\n\n  invoiceErrors = Array.isArray(requestData.errors) ? requestData.errors : [];\n\n  transformedRecords.push({\n    CustomerMessageDetailId: messageDetailId,\n    ProcessingStatusCode: finalProcessingStatusCode,\n    ProcessingStatusMeaning: finalProcessingStatusMeaning,\n    BusinessUnit: actionablePayload.BusinessUnit || record.BUSINESSUNIT || \"\",\n    BillToCustomerNumber: billToCustomerNumber,\n    TransactionNumber: actionablePayload.TransactionNumber || record.TRANSACTIONNUMBER || \"\",\n    TransactionDate: {\n      formatValue: actionablePayload.TransactionDate || record.TRANSACTIONDATE || \"\",\n      formatType: \"Date\"\n    },\n    DueDate: {\n      formatValue: record.DUEDATE || \"\",\n      formatType: \"Date\"\n    },\n    TransactionAmountRemaining: {\n      formatValue: record.AMOUNTREMAINING,\n      formatType: \"Amount\"\n    },\n    TransactionCurrency: record.CURRENCYCODE || \"\",\n    DisputeAmount: {\n      formatValue: disputeAmount,\n      formatType: \"Amount\"\n    },\n    DisputeSection: disputeSection,\n    DisputeReason: disputeReason,\n    DisputeType: disputeType,\n    DisputePercentage: disputePercentage,\n    CustomerComments: customerComments,\n    CustomerTransactionId: customerTransactionId,\n    receivablesDisputeLines: receivablesDisputeLines,\n    ErrorDetails: invoiceErrors,\n    ResponseData: matchedUpdatedRecord ? (matchedUpdatedRecord.responseData || \"\") : (record.RESPONSEDATA || \"\")\n  });\n}\n\n/* fallback summary / top-level errors / status */\nif (!summary || !status || errors.length === 0) {\n  for (let k = 0; k < failedMessageDetails.length; k++) {\n    let fallbackRecord = failedMessageDetails[k] || {};\n    let fallbackRequestDataSource = fallbackRecord.REQUESTDATA || \"{}\";\n    let fallbackRequestData = {};\n\n    try {\n      fallbackRequestData = typeof fallbackRequestDataSource === \"string\"\n        ? JSON.parse(fallbackRequestDataSource)\n        : fallbackRequestDataSource;\n    } catch (e) {\n      fallbackRequestData = {};\n    }\n\n    if (!summary && fallbackRequestData.summary) {\n      summary = fallbackRequestData.summary;\n    }\n\n    if ((!errors || errors.length === 0) && Array.isArray(fallbackRequestData.errors)) {\n      errors = fallbackRequestData.errors;\n    }\n\n    if (!status && fallbackRecord.PROCESSINGSTATUSCODE) {\n      status = fallbackRecord.PROCESSINGSTATUSCODE;\n    }\n  }\n}\n\n/* final response */\nlet result = {\n  messageId: messageId,\n  intentCode: intentCode,\n  status: status,\n  summary: summary,\n  errors: errors,\n  items: transformedRecords\n};\n\nreturn result;"
          },
