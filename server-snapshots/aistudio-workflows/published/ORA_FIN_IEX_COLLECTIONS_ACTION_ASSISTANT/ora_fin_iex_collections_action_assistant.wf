          "code": "CREATE_DISPUTE",
          "id": "1774379675124",
          "inputs": [
            {
              "id": "1774379675125_1",
              "name": "prompt",
              "type": "string",
              "value": "Use the customer context from {{$context.$nodes.RESOLVE_CUSTOMER_CONTEXT.$output.result}}, generate a recordWidget with id=create_dispute and title=\"Create Dispute\" and fields: \nfields: [\n  { id: \"invoice_number\", label: \"Invoice Number\", type: \"text\", readOnly: true },\n  { id: \"dispute_amount\", label: \"Dispute Amount\", type: \"number\" },\n  { id: \"dispute_section\", label: \"Dispute Section\", type: \"select\", options: [\n    { value: \"Lines Subtotal\", label: \"Lines Subtotal\" },\n    { value: \"Percent\", label: \"Percent\" },\n    { value: \"Shipping\", label: \"Shipping\" },\n    { value: \"Specific Invoice Lines\", label: \"Specific Invoice Lines\" },\n    { value: \"Tax\", label: \"Tax\" },\n    { value: \"Total\", label: \"Total\" }\n  ]},\n  { id: \"dispute_reason\", label: \"Dispute Reason\", type: \"select\", options: [\n    { value: \"Accounts receivables billing error\", label: \"Accounts receivables billing error\" },\n    { value: \"Billing\", label: \"Billing\" },\n    { value: \"Cancellation\", label: \"Cancellation\" },\n    { value: \"Contract Line Terminated\", label: \"Contract Line Terminated\" },\n    { value: \"Credit and rebill\", label: \"Credit and rebill\" },\n    { value: \"Credit late payment charge\", label: \"Credit late payment charge\" },\n    { value: \"Credit memo from projects\", label: \"Credit memo from projects\" },\n    { value: \"Damaged product\", label: \"Damaged product\" },\n    { value: \"Data entry error\", label: \"Data entry error\" },\n    { value: \"Discount\", label: \"Discount\" },\n    { value: \"Distribution reversal\", label: \"Distribution reversal\" },\n    { value: \"Duplicate billing\", label: \"Duplicate billing\" },\n    { value: \"Employee terminated\", label: \"Employee terminated\" },\n    { value: \"Foreign freight error\", label: \"Foreign freight error\" },\n    { value: \"Free product\", label: \"Free product\" },\n    { value: \"Incorrect administrative charge\", label: \"Incorrect administrative charge\" },\n    { value: \"Late delivery\", label: \"Late delivery\" },\n    { value: \"No reason entered\", label: \"No reason entered\" },\n    { value: \"Not delivered\", label: \"Not delivered\" },\n    { value: \"Order entry error\", label: \"Order entry error\" },\n    { value: \"Ownership definition change\", label: \"Ownership definition change\" },\n    { value: \"PeopleSoft Migration\", label: \"PeopleSoft Migration\" },\n    { value: \"Product return\", label: \"Product return\" },\n    { value: \"Sales tax error\", label: \"Sales tax error\" },\n    { value: \"Service\", label: \"Service\" },\n    { value: \"Shipping and handling\", label: \"Shipping and handling\" },\n    { value: \"Shipping charges error\", label: \"Shipping charges error\" },\n    { value: \"Tax exempt\", label: \"Tax exempt\" },\n    { value: \"Tax rate error\", label: \"Tax rate error\" },\n    { value: \"Write off from projects\", label: \"Write off from projects\" },\n    { value: \"Wrong freight\", label: \"Wrong freight\" },\n    { value: \"Wrong product\", label: \"Wrong product\" },\n    { value: \"Wrong tax rate\", label: \"Wrong tax rate\" }\n  ]},\n  { id: \"dispute_type\", label: \"Dispute Type\", value: \"Not Applicable\", type: \"select\", options: [\n    { value: \"Ace\", label: \"Ace\" },\n    { value: \"Amber\", label: \"Amber\" },\n    { value: \"Green\", label: \"Green\" },\n    { value: \"Not Applicable\", label: \"Not Applicable\" },\n    { value: \"Red\", label: \"Red\" }\n  ]},\n  { id: \"customer_comments\", label: \"Customer Comments\", type: \"textarea\" },\n  { id: \"internal_comments\", label: \"Internal Comments\", type: \"textarea\" }\n]\nPrefill invoice number and amount from the customer context when available. Return only the widget. Do not show description STRICTLY."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Extract Customer Details to Complete Customer Call",
            "returnType": "object",
            "sourceCode": "var rawResult = $context?.$nodes?.EXTRACT_CUSTOMER_DETAILS?.$output?.result || \"{}\";\n\nvar sourceData = {};\ntry {\n  sourceData = typeof rawResult === \"string\" ? JSON.parse(rawResult) : rawResult;\n} catch (e) {\n  sourceData = {};\n}\n\nvar result = {\n  partyNumber: sourceData.PARTYNUMBER || \"\",\n  accountNumber: sourceData.ACCOUNTNUMBER || \"\",\n  createdFrom: \"skippingCustomerCall\",\n  strategyUserTasks: [\n    {\n      StrategyTaskTemplate: \"Call Customer\",\n      WorkOrder: 101,\n      UserTaskStatus: \"Complete\"\n    }\n  ]\n};\n\nreturn result;"
          },
          "outcomes": {
