        {
          "metadata": {
            "name": "Extract Email Request Parameters",
            "returnType": "object",
            "sourceCode": "/* nvp input */\nlet nvpInput = $context.$triggers.REST.$input.OraCommNonTemplateParamList;\n\n/* parsed value holder */\nlet nvpData = nvpInput;\n\n/* parse only when input is string */\nif (typeof nvpInput === \"string\") {\n  nvpData = JSON.parse(nvpInput);\n}\n\n/* dynamically build json object */\nlet result = {};\n\n/* handle array input */\nif (Array.isArray(nvpData)) {\n  for (let i = 0; i < nvpData.length; i++) {\n    let item = nvpData[i];\n    result[item.id] = item.value;\n  }\n} else {\n  result = nvpData;\n}\nresult.createdFrom = \"promiseEmailReminder\";\nresult.strategyUserTasks = [\n  {\n    StrategyTaskTemplate: \"Request Promise-to-Pay\",\n    WorkOrder: 101\n  }\n];\n\nreturn result;"
          },
