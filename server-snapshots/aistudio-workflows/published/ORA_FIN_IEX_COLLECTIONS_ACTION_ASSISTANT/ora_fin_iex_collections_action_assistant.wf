        {
          "metadata": {
            "description": "Construct payload for getting message details to skip",
            "name": "Construct Payload For Getting Message Details To Skip",
            "returnType": "object",
            "sourceCode": "let pMessageId = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.messageId;\nlet pIntentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode;\n\n/* payload object for promise-to-pay message details */\nlet requestPayload = {\n  parameters: {\n    bindMessageId: pMessageId,\n    bindIntentCode: pIntentCode\n  },\n  viewQueries: {\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customer.id\": \"partyId\"\n      }\n    }\n  },\n  select: \"select collectionsCustomerMessageDetails.customerMessageDetailId customerMessageDetailId, collectionsCustomerMessageDetails.messageId messageId, collectionsCustomerMessageDetails.paymentScheduleId paymentScheduleId, collectionsCustomerMessageDetails.customerTransactionId customerTransactionId, collectionsCustomerMessageDetails.processingStatusCode processingStatusCode, collectionsCustomerMessageDetails.intentCode intentCode, collectionsCustomerMessageDetails.requestData requestData, collectionsCustomerMessageDetails.responseData responseData, collectionsCustomerMessageDetails.siteUseId siteUseId, collectionsCustomerMessageDetails.accountId accountId, collectionsCustomerMessageDetails.partyId partyId from collectionsCustomerMessageDetails where collectionsCustomerMessageDetails.intentCode = :bindIntentCode and collectionsCustomerMessageDetails.messageId = :bindMessageId and collectionsCustomerMessageDetails.processingStatusCode in ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING','ORA_ERROR_REVIEW_PENDING') order by customerMessageDetailId\"\n};\n\n/* final result to return from agent studio code node */\nlet result = requestPayload;\nreturn result;",
            "errorNodeId": "1778436031247"
          },
          "outcomes": {
            "success": "1777876747273"
          },
