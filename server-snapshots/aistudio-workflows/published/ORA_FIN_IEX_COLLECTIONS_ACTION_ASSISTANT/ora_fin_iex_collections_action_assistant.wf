          "id": "1779957405414",
          "code": "FIN_IEX_LLM_GENERATE_LOCALE_MONTH_NAMES",
          "type": "LLM",
          "inputs": [
            {
              "id": "1779957405414_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "1779957405414_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a locale month-name resolver.\n\nReturn the month names for the given language and territory.\n\nInput:\nLanguage: {{$context.$nodes.FIN_IEX_CODE_EXTRACT_USER_PREFERENCES.$output.result.Language}}\nTerritory: {{$context.$nodes.FIN_IEX_CODE_EXTRACT_USER_PREFERENCES.$output.result.Territory}}\n\nRules:\n- Use the language-territory locale when possible, for example en-US, es-ES, fr-FR.\n- Return all 12 months in calendar order from January to December.\n- Return localized full month names and localized abbreviated month names.\n- Use normal month-name casing for that locale.\n- Do not translate the keys.\n- Do not include explanations, markdown, or extra text.\n- Return valid JSON only.\n\nJSON response format:\n{\n  \"months\": [\n    {\n      \"monthNumber\": 1,\n      \"fullMonthName\": \"<localized full name>\",\n      \"shortMonthName\": \"<localized abbreviated name>\"\n    }\n  ]\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"months\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"monthNumber\": {\n            \"type\": \"integer\"\n          },\n          \"fullMonthName\": {\n            \"type\": \"string\"\n          },\n          \"shortMonthName\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"monthNumber\",\n          \"fullMonthName\",\n          \"shortMonthName\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"months\"\n  ],\n  \"additionalProperties\": false\n}"
