        {
          "metadata": {
            "name": "Extract Action Details",
            "returnType": "object",
            "sourceCode": "const wrapper = $context.$nodes.DETERMINE_ACTION_WRAPPER.$output.result || {};\nconst payload = Array.isArray(wrapper.payload) ? wrapper.payload : [];\n\nconst payloadMap = payload.reduce((acc, item) => {\n  if (item && item.id) {\n    acc[item.id] = item.value;\n  }\n  return acc;\n}, {});\n\nconst actionMap = {\n  create_dispute: \"submitDispute\",\n  create_ptp: \"submitPTP\",\n  record_call_notes: \"submitCallNotes\",\n  emailActions: \"emailActions\"\n};\n\nconst rawAction = wrapper.actionType || wrapper.formId || \"\";\nconst actionType = actionMap[rawAction] || rawAction;\n\nreturn {\n  actionType,\n  payload: payloadMap\n};"
          },
          "outcomes": {
            "success": "1776206404062"
          },
          "diagram": {
            "x": 7229,
            "y": 6356
          },
          "code": "EXTRACT_ACTION_DETAILS",
          "id": "1774379059569",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Action Code",
            "returnType": "string",
            "sourceCode": "let suggestedAction = String(\n  $context.$triggers?.REST?.$input?.OraAction ||\n  $context.$app?.$OraAction ||\n  \"\"\n).trim();\n\n\nif (!suggestedAction) {\n  throw new Error(\"OraAction is empty\");\n}\n\n// normalize escaped quotes like recordCallNotes\\\", {...}\nsuggestedAction = suggestedAction\n  .replace(/\\\\\"/g, '\"')\n  .replace(/\\\\'/g, \"'\")\n  .trim();\n\nfunction cleanAction(value) {\n  return String(value || \"\")\n    .replace(/^[\"']+|[\"']+$/g, \"\")\n    .trim();\n}\n\n// Case 1: oraFormSubmit -> extract id\nlet match = suggestedAction.match(/^<oraFormSubmit\\b[^>]*id=[\"']([^\"']+)[\"']/i);\nif (match) {\n  return cleanAction(match[1]);\n}\n\n// Case 2: ora.Agent(...)\nmatch = suggestedAction.match(/^ora\\.Agent\\(\\s*\"?([A-Za-z0-9_]+)\"?\\s*,/i);\nif (match) {\n  return cleanAction(match[1]);\n}\n\n// Case 3: plain action with comma payload\nmatch = suggestedAction.match(/^\"?([A-Za-z0-9_]+)\"?\\s*,/);\nif (match) {\n  return cleanAction(match[1]);\n}\n\n// Case 4: simple string\nmatch = suggestedAction.match(/^\"?([A-Za-z0-9_]+)\"?$/);\nif (match) {\n  return cleanAction(match[1]);\n}\n\nthrow new Error(\"Unable to extract action code from OraAction: \" + suggestedAction);"
          },
          "outcomes": {
            "success": "1774378501310"
          },
          "diagram": {
            "x": 7679,
            "y": 6356
          },
