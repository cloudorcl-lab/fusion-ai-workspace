        {
          "metadata": {
            "name": "Set Invocation Context"
          },
          "outcomes": {
            "success": "resolve_customer_context"
          },
          "diagram": {
            "x": 7658.896380860021,
            "y": 4400.870442513099
          },
          "code": "SET_INVOCATION_CONTEXT",
          "id": "set_invocation_context",
          "inputs": [
            {
              "id": "set_invocation_context_1",
              "name": "InvocationContext",
              "value": "{{$context.$triggers.REST.$input.OraAppContext}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Resolve Customer Context",
            "returnType": "string",
            "sourceCode": "const rawOraAction = String(\n  $context.$triggers?.REST?.$input?.OraAction ||\n  $context.$app?.$OraAction ||\n  \"\"\n).trim();\n\nconst triggerCustomerDetails = $context.$triggers?.REST?.$input?.CustomerDetails;\nconst appContext = $context.$variables?.InvocationContext;\n\n// Case 1: ora.Agent(action, payload)\nif (/^ora\\.Agent\\(/i.test(rawOraAction)) {\n  const match = rawOraAction.match(/^ora\\.Agent\\(\\s*\"?[A-Za-z0-9_]+\"?\\s*,\\s*([\\s\\S]*)\\)\\s*$/);\n\n  if (match) {\n    const rawPayload = match[1].trim();\n\n    try {\n      const parsedPayload = JSON.parse(rawPayload);\n\n      if (parsedPayload && parsedPayload.customer_context) {\n        return parsedPayload.customer_context;\n      }\n\n      return parsedPayload;\n    } catch (e) {\n      return rawPayload;\n    }\n  }\n}\n\n// Case 2: plain action,payload\nconst plainActionMatch = rawOraAction.match(/^\"?[A-Za-z0-9_]+\"?\\s*,\\s*([\\s\\S]*)$/);\nif (plainActionMatch) {\n  const rawPayload = plainActionMatch[1].trim();\n\n  try {\n    const parsedPayload = JSON.parse(rawPayload);\n\n    if (parsedPayload && parsedPayload.customer_context) {\n      return parsedPayload.customer_context;\n    }\n\n    return parsedPayload;\n  } catch (e) {\n    return rawPayload;\n  }\n}\n\n// Case 3: oraFormSubmit\nif (/^<oraformsubmit\\b/i.test(rawOraAction)) {\n  const bodyMatch = rawOraAction.match(/>\\s*([\\s\\S]*?)\\s*<\\/oraFormSubmit>\\s*$/i);\n  const body = bodyMatch ? bodyMatch[1].trim() : \"\";\n  let formPayload = [];\n\n  try {\n    formPayload = JSON.parse(body);\n  } catch (e) {\n    formPayload = [];\n  }\n\n  if (Array.isArray(formPayload)) {\n    const customerContextField = formPayload.find(\n      item => item && item.id === \"customer_context\"\n    );\n\n    if (customerContextField && customerContextField.value != null) {\n      return customerContextField.value;\n    }\n  }\n}\n\n// Case 4: direct trigger input\nif (triggerCustomerDetails) {\n  if (typeof triggerCustomerDetails === \"object\") {\n    return triggerCustomerDetails;\n  }\n\n  try {\n    return JSON.parse(String(triggerCustomerDetails));\n  } catch (e) {\n    return String(triggerCustomerDetails);\n  }\n}\n\n// Case 5: app context fallback\nif (appContext && String(appContext).trim()) {\n  if (typeof appContext === \"object\") {\n    return appContext;\n  }\n\n  try {\n    return JSON.parse(String(appContext));\n  } catch (e) {\n    return String(appContext);\n  }\n}\n\nreturn null;"
          },
          "outcomes": {
            "success": "1779891288927"
          },
          "diagram": {
            "x": 7658.896380860021,
            "y": 4532.114909025604
          },
          "code": "RESOLVE_CUSTOMER_CONTEXT",
          "id": "resolve_customer_context",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "RouteRequest"
          },
          "outcomes": {
            "InvokeAction": "1774376503913",
            "InitActions": "display_agent_help",
            "Summary": "1774553377121",
            "SendCommunication": "1776840221512"
          },
          "diagram": {
            "x": 7651.461967600938,
            "y": 5684.634695833867
          },
          "code": "ROUTEREQUEST",
          "convergenceTargetId": "end",
          "id": "route_request",
          "inputs": [
            {
              "id": "route_request_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OraMessageHint}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Determine Action Wrapper",
            "returnType": "object",
            "sourceCode": "const raw = String(\n  $context.$triggers?.REST?.$input?.OraAction ||\n  $context.$app?.$OraAction ||\n  \"\"\n).trim();\n\nfunction normalize(value) {\n  return String(value || \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\");\n}\n\nfunction safeJsonParse(value, fallback) {\n  if (!value) return fallback;\n  try {\n    return JSON.parse(value);\n  } catch (e) {\n    return fallback;\n  }\n}\n\nlet isOraSubmit = false;\nlet formId = \"\";\nlet actionType = \"\";\nlet payload = {};\n\nif (!raw) {\n  return {\n    isOraSubmit: false,\n    formId: \"\",\n    actionType: \"\",\n    payload: {},\n    rawAction: \"\"\n  };\n}\n\nif (/^<oraformsubmit\\b/i.test(raw)) {\n  isOraSubmit = true;\n\n  const idMatch = raw.match(/id=\"([^\"]+)\"/i);\n  const bodyMatch = raw.match(/>\\s*([\\s\\S]*?)\\s*<\\/oraFormSubmit>\\s*$/i);\n\n  formId = idMatch ? idMatch[1] : \"\";\n\n  const body = bodyMatch ? bodyMatch[1].trim() : \"\";\n  payload = safeJsonParse(body, body ? { rawPayload: body } : {});\n\n  const key = normalize(formId);\n\n  if (key === \"createdispute\" || key === \"submitdispute\") {\n    actionType = \"submitDispute\";\n  } else if (key === \"createptp\" || key === \"submitptp\") {\n    actionType = \"submitPTP\";\n  } else if (key === \"recordcallnotes\" || key === \"submitcallnotes\") {\n    actionType = \"submitCallNotes\";\n  } else if (key === \"emailActions\") {\n    actionType = \"emailActions\";\n  } \n} else {\n  isOraSubmit = false;\n  formId = raw;\n  actionType = \"\";\n  payload = {};\n}\n\nreturn {\n  isOraSubmit,\n  formId,\n  actionType,\n  payload,\n  rawAction: raw\n};"
          },
          "outcomes": {
            "success": "1774378160683"
          },
          "diagram": {
