            "sourceCode": "let bindPartyNumber = $context.$variables.StrategyDetails.partyNumber;\nlet bindAccountNumber = $context.$variables.StrategyDetails.accountNumber;\nlet bindCustomerAccountId = $context.$variables.StrategyDetails.customerAccountId;\nlet bindPartyId = $context.$variables.StrategyDetails.partyId;\nlet bindSiteUse = $context.$variables.StrategyDetails.SiteUse;\nlet strategyUserTasks = $context.$variables.StrategyDetails.strategyUserTasks;\n\nif (bindPartyNumber === \"\") {\n  bindPartyNumber = null;\n}\n\nif (bindAccountNumber === \"\") {\n  bindAccountNumber = null;\n}\n\nif (bindCustomerAccountId === \"\") {\n  bindCustomerAccountId = null;\n}\n\nif (bindPartyId === \"\") {\n  bindPartyId = null;\n}\n\nif (bindSiteUse === \"\") {\n  bindSiteUse = null;\n}\n\nif (strategyUserTasks == null) {\n  strategyUserTasks = [];\n}\n\nlet strategyTemplateName = null;\nstrategyTemplateName = \"Collector Workspace Strategy\";\n\nlet currentDate = new Date();\nlet generatedWorkOrder =\n  String(currentDate.getFullYear()) +\n  String(currentDate.getMonth() + 1).padStart(2, \"0\") +\n  String(currentDate.getDate()).padStart(2, \"0\") +\n  String(currentDate.getHours()).padStart(2, \"0\") +\n  String(currentDate.getMinutes()).padStart(2, \"0\") +\n  String(currentDate.getSeconds()).padStart(2, \"0\") +\n  String(currentDate.getMilliseconds()).padStart(3, \"0\");\n\nlet todayDate = String(currentDate.getFullYear())\n  + \"-\"\n  + String(currentDate.getMonth() + 1).padStart(2, \"0\")\n  + \"-\"\n  + String(currentDate.getDate()).padStart(2, \"0\");\n\nlet updatedStrategyUserTasks = [];\nlet strategyExecutionTasks = [];\nlet currentTask = strategyUserTasks[0];\n\nif (currentTask) {\n  let taskStatus = currentTask.UserTaskStatus === \"Skip\" ? \"Canceled\" : \"Complete\";\n\n  updatedStrategyUserTasks.push({\n    StrategyTaskTemplate: currentTask.StrategyTaskTemplate,\n    WorkOrder: generatedWorkOrder\n  });\n\n  strategyExecutionTasks.push({\n    StrategyTaskTemplate: currentTask.StrategyTaskTemplate,\n    ExecutionStart: todayDate,\n    ScheduleStart: todayDate,\n    ExecutionEnd: todayDate,\n    WorkOrder: generatedWorkOrder,\n    TaskStatus: taskStatus\n  });\n}\n\nlet result = {\n  Score: 100,\n  StrategyTemplate: strategyTemplateName,\n  PartyNumber: bindPartyNumber,\n  AccountNumber: bindAccountNumber,\n  SiteUse: bindSiteUse,\n  StrategyStatus: \"Closed\",\n  StrategyUserTasks: updatedStrategyUserTasks,\n  StrategyExecutionTasks: strategyExecutionTasks\n};\n\nreturn result;"
          },
