        {
          "metadata": {
            "name": "Construct Payload to record call notes",
            "returnType": "object",
            "sourceCode": "const encodedCallNotes = $context.$nodes.ENCODE_CALL_NOTES.$output.result;\nconst identifiers = $context.$nodes.EXTRACT_CUSTOMER_IDENTIFIERS.$output.result || {};\n\nreturn {\n  NoteTxt: encodedCallNotes,\n  NoteTypeCode: \"GENERAL\",\n  VisibilityCode: \"INTERNAL\",\n  SourceObjectCode: \"CUSTOMER_ACCOUNT\",\n  SourceObjectId: identifiers.customerAccountId || \"\",\n  CustomerTransactionId: identifiers.customerTransactionId || \"\",\n  AccountNumber: identifiers.accountNumber || \"\",\n  PartyNumber: identifiers.partyNumber || \"\"\n};"
          },
