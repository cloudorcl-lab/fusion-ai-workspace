          "code": "FIN_IEX_LLM_DISPLAY_OUTPUT_TO_SKIP",
          "id": "1777878366685",
          "inputs": [
            {
              "id": "1777878366685_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Create a concise and user-friendly system notification based on the intent code `{{$context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode}}`. Keep the tone professional, clear, and reassuring. Limit the message to one sentence.\n\nRules:\n- If intent code is `ORA_PROMISE_TO_PAY`, generate a message confirming that the promise has been marked for manual review.\n- If intent code is `ORA_DISPUTE_REQUEST`, generate a message confirming that the dispute request has been marked for manual review.\n- If intent code is `ORA_PO_UPDATE`, generate a message confirming that the purchase order update has been marked for manual review.\n- If intent code is `ORA_INVOICE_REPRINT`, generate a message confirming that the invoice reprint request has been marked for manual review.\n- Do not mention the intent code in the final response.\n- Return only the final one-sentence notification.\n\nExamples:\n\nInput intent code: ORA_PROMISE_TO_PAY\nOutput: Your promise to pay has been marked for manual review.\n\nInput intent code: ORA_DISPUTE_REQUEST\nOutput: Your dispute request has been marked for manual review.\n\nInput intent code: ORA_PO_UPDATE\nOutput: Your purchase order update has been marked for manual review.\n\nInput intent code: ORA_INVOICE_REPRINT\nOutput: Your invoice reprint request has been marked for manual review."
            }
          ],
          "type": "LLM"
        },
