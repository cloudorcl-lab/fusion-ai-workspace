        {
          "metadata": {
            "name": "Process Unformatted Failed PO Update Requests",
            "returnType": "object",
            "sourceCode": "/* source failed PO update request records */\nlet failedMessageDetails = $context.$nodes.FIN_IEX_BO_EXECUTE_PAYLOAD_TO_FETCH_FAILED_PO_UPDATE_REQUESTS.$output || [];\nlet updatedResponseRecords = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_FOR_PARTIAL_SUCCESSFUL_PO_UPDATE.$output.result || [];\n\n/* map updated records by message detail id */\nlet updatedRecordMap = {};\nfor (let j = 0; j < updatedResponseRecords.length; j++) {\n  let updatedRecord = updatedResponseRecords[j] || {};\n  let updatedMessageDetailId = updatedRecord.messageDetailId || \"\";\n\n  if (updatedMessageDetailId) {\n    updatedRecordMap[String(updatedMessageDetailId)] = updatedRecord;\n  }\n}\n\n/* processing status meaning lookup */\nlet processingStatusMeaningMap = {\n  ORA_PROCESSING_ERROR: \"Processing error\",\n  ORA_PROCESSED: \"Processed\",\n  ORA_ACTION_PENDING: \"Action pending\",\n  ORA_REVIEW_PENDING: \"Review pending\",\n  ORA_ERROR_REVIEW_PENDING: \"Error review pending\"\n};\n\n/* final output list */\nlet transformedRecords = [];\nlet messageId = \"\";\nlet intentCode = \"\";\nlet summary = null;\nlet errors = [];\nlet status = \"\";\n\n/* iterate through failed request records */\nfor (let i = 0; i < failedMessageDetails.length; i++) {\n  let record = failedMessageDetails[i] || {};\n  let messageDetailId = record.CUSTOMERMESSAGEDETAILID || \"\";\n  let matchedUpdatedRecord = updatedRecordMap[String(messageDetailId)] || null;\n  let finalProcessingStatusCode = matchedUpdatedRecord\n    ? (matchedUpdatedRecord.processingStatusCode || \"\")\n    : (record.PROCESSINGSTATUSCODE || \"\");\n  let finalProcessingStatusMeaning = processingStatusMeaningMap[finalProcessingStatusCode] || record.PROCESSINGSTATUSMEANING || \"\";\n  let requestDataSource = record.REQUESTDATA || \"{}\";\n  let responseDataSource = record.RESPONSEDATA || \"{}\";\n  let requestData = {};\n  let responseData = {};\n  let actionablePayload = {};\n  let poUpdate = {};\n  let invoiceErrors = [];\n\n  try {\n    requestData = typeof requestDataSource === \"string\"\n      ? JSON.parse(requestDataSource)\n      : (requestDataSource || {});\n  } catch (e) {\n    requestData = {};\n  }\n\n  try {\n    responseData = typeof responseDataSource === \"string\"\n      ? JSON.parse(responseDataSource)\n      : (responseDataSource || {});\n  } catch (e) {\n    responseData = {};\n  }\n\n  actionablePayload = requestData.actionablePayload || {};\n  poUpdate = actionablePayload.poUpdate || {};\n\n  if (!summary && requestData.summary) {\n    summary = requestData.summary;\n  }\n\n  if ((!errors || errors.length === 0) && Array.isArray(requestData.errors)) {\n    errors = requestData.errors;\n  } else if ((!errors || errors.length === 0) && requestData.summary && Array.isArray(requestData.summary.errors)) {\n    errors = requestData.summary.errors;\n  }\n\n  if (!status && record.PROCESSINGSTATUSCODE) {\n    status = record.PROCESSINGSTATUSCODE;\n  }\n\n  if (!messageId) {\n    messageId = record.MESSAGEID || \"\";\n  }\n\n  if (!intentCode) {\n    intentCode = record.INTENTCODE || \"\";\n  }\n\n  invoiceErrors = Array.isArray(requestData.errors) ? requestData.errors : [];\n\n  transformedRecords.push({\n    CustomerMessageDetailId: record.CUSTOMERMESSAGEDETAILID || \"\",\n    MessageId: record.MESSAGEID || \"\",\n    IntentCode: record.INTENTCODE || \"\",\n    ProcessingStatusCode: finalProcessingStatusCode,\n    ProcessingStatusMeaning: finalProcessingStatusMeaning,\n    CustomerTransactionId: actionablePayload.CustomerTransactionId || record.CUSTOMERTRANSACTIONID || \"\",\n    BillToCustomerNumber: actionablePayload.BillToCustomerNumber || record.ACCOUNTNUMBER || \"\",\n    TransactionNumber: record.TRANSACTIONNUMBER || poUpdate.TransactionNumber || \"\",\n    TransactionDate: {\n      formatValue: record.TRANSACTIONDATE || poUpdate.TransactionDate || \"\",\n      formatType: \"Date\"\n    },\n    DueDate: {\n      formatValue: record.DUEDATE || \"\",\n      formatType: \"Date\"\n    },\n    TransactionAmountRemaining: {\n      formatValue: record.AMOUNTREMAINING,\n      formatType: \"Amount\"\n    },\n    TransactionCurrency: record.CURRENCYCODE || \"\",\n    PartyName: record.PARTYNAME || \"\",\n    CustomerTransactionSource: record.CUSTOMERTRANSACTIONSOURCE || \"\",\n    CustomerTransactionType: record.CUSTOMERTRANSACTIONTYPE || \"\",\n    BusinessUnit: record.BUSINESSUNIT || \"\",\n    SiteUseId: record.SITEUSEID || \"\",\n    AccountId: record.ACCOUNTID || \"\",\n    PartyId: record.PARTYID || \"\",\n    CurrentPONumber: record.CURRENTPONUMBER || \"\",\n    CurrentPODate: {\n      formatValue: record.CURRENTPODATE || \"\",\n      formatType: \"Date\"\n    },\n    UpdatedPONumber: poUpdate.PurchaseOrder || \"\",\n    ErrorDetails: invoiceErrors,\n    ResponseData: matchedUpdatedRecord ? (matchedUpdatedRecord.responseData || \"\") : responseData\n  });\n}\n\n/* fallback summary / top-level errors / status */\nif (!summary || !status || errors.length === 0) {\n  for (let k = 0; k < failedMessageDetails.length; k++) {\n    let fallbackRecord = failedMessageDetails[k] || {};\n    let fallbackRequestDataSource = fallbackRecord.REQUESTDATA || \"{}\";\n    let fallbackRequestData = {};\n\n    try {\n      fallbackRequestData = typeof fallbackRequestDataSource === \"string\"\n        ? JSON.parse(fallbackRequestDataSource)\n        : fallbackRequestDataSource;\n    } catch (e) {\n      fallbackRequestData = {};\n    }\n\n    if (!summary && fallbackRequestData.summary) {\n      summary = fallbackRequestData.summary;\n    }\n\n    if ((!errors || errors.length === 0) && Array.isArray(fallbackRequestData.errors)) {\n      errors = fallbackRequestData.errors;\n    } else if ((!errors || errors.length === 0) && fallbackRequestData.summary && Array.isArray(fallbackRequestData.summary.errors)) {\n      errors = fallbackRequestData.summary.errors;\n    }\n\n    if (!status && fallbackRecord.PROCESSINGSTATUSCODE) {\n      status = fallbackRecord.PROCESSINGSTATUSCODE;\n    }\n  }\n}\n\n/* final response */\nlet result = {\n  messageId: messageId,\n  intentCode: intentCode,\n  status: status,\n  summary: summary,\n  errors: errors,\n  items: transformedRecords\n};\n\nreturn result;"
