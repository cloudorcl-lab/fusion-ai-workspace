                {
                  "metadata": {
                    "name": "Create Response Data Payload to Skip",
                    "returnType": "object",
                    "sourceCode": "const output = $context.$nodes.FIN_IEX_LOOP_UPDATE_ACTION_OUTPUT_TO_SKIP.$currentItem || {};\nconst messageDetailId = output.messageDetailId;\nconst processingStatusCode = output.processingStatusCode;\nlet responseData = output.responseData;\n\nif (!messageDetailId) {\n  throw new Error(\"messageDetailId is missing from current item\");\n}\n\nif (!processingStatusCode) {\n  throw new Error(\"processingStatusCode is missing from current item\");\n}\n\nif (responseData === null || responseData === undefined || responseData === \"\") {\n  responseData = {};\n}\n\nif (typeof responseData === \"string\") {\n  try {\n    responseData = JSON.parse(responseData);\n  } catch (e) {\n    responseData = {};\n  }\n}\n\nconst updatePayload = {\n  processingStatus: {\n    lookupCode: processingStatusCode\n  },\n  responseData: JSON.stringify(responseData)\n};\n\nconst updatePayloadString = JSON.stringify(updatePayload);\nconst getVersion = $context.$nodes.FIN_IEX_LOOP_UPDATE_ACTION_OUTPUT_TO_SKIP.FIN_IEX_BO_GET_VERSION_NUMBER_OF_MESSAGE_DETAILS_ID_TO_SKIP.$output;\nconst etag='\"'+String(getVersion.$context.etag)+'\"';\n\nconst obj = {\n  messageDetailId: messageDetailId,\n  updatePayload: updatePayloadString,\n  etag: etag\n};\n\nreturn obj;",
                    "description": "Creating payload to update message details",
                    "errorNodeId": "1778436031247"
                  },
