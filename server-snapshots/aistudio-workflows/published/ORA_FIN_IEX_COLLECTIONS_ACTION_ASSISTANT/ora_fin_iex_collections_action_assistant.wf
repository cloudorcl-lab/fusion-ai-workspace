            "sourceCode": "/* response candidates from previous nodes */\nlet partialValidResponseData = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_PARTIAL_VALID_REQUESTS && $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_PARTIAL_VALID_REQUESTS.$output\n  ? $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_PARTIAL_VALID_REQUESTS.$output.result\n  : null;\n\nlet allValidResponseData = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_FOR_ALL_VALID_REQUESTS && $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_FOR_ALL_VALID_REQUESTS.$output\n  ? $context.$nodes.FIN_IEX_CODE_CONSTRUCT_RESPONSE_DATA_FOR_ALL_VALID_REQUESTS.$output.result\n  : null;\n\nlet errorReviewPendingResponseData = $context.$nodes.FIN_IEX_CODE_PROCESS_PAYLOAD_FOR_ERROR_REVIEW_PENDING_RECORDS && $context.$nodes.FIN_IEX_CODE_PROCESS_PAYLOAD_FOR_ERROR_REVIEW_PENDING_RECORDS.$output\n  ? $context.$nodes.FIN_IEX_CODE_PROCESS_PAYLOAD_FOR_ERROR_REVIEW_PENDING_RECORDS.$output.result\n  : [];\n\n/* normalize error review pending response as array */\nlet errorReviewPendingRecords = [];\n\nif (Array.isArray(errorReviewPendingResponseData)) {\n  errorReviewPendingRecords = errorReviewPendingResponseData;\n}\n\n/* final result selection */\nlet result = null;\n\nif (partialValidResponseData !== null && partialValidResponseData !== undefined) {\n  result = partialValidResponseData;\n} else if (allValidResponseData !== null && allValidResponseData !== undefined) {\n  result = allValidResponseData;\n}\n\nif (result === null || result === undefined) {\n  result = [];\n}\n\nfor (let i = 0; i < errorReviewPendingRecords.length; i++) {\n  result.push(errorReviewPendingRecords[i]);\n}\n\nreturn result;",
