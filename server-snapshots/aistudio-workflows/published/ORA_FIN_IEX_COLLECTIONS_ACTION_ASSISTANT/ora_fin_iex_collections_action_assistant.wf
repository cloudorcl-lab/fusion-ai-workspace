        {
          "metadata": {
            "name": "Extract Customer Details",
            "returnType": "string",
            "sourceCode": "let suggestedAction = $context.$app.$OraAction;\n\nif (!suggestedAction) {\n  throw new Error(\"OraAction is empty\");\n}\n\nsuggestedAction = suggestedAction.trim();\n\nconst firstCommaIndex = suggestedAction.indexOf(\",\");\n\nif (firstCommaIndex === -1) {\n  return null;\n}\n\nlet customerDetails = suggestedAction.substring(firstCommaIndex + 1).trim();\n\nreturn customerDetails;"
          },
