          "code": "CONSTRUCT_PAYLOAD_TO_RECORD_CALL_NOTES",
          "id": "1777051592424",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Process Installments that require promise for the given customer account",
            "name": "Process Installments Requiring Promise",
            "returnType": "object",
            "sourceCode": "let customerDetails = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result || {};\nlet customerName = (customerDetails && (customerDetails.customerName || customerDetails.CUSTOMERNAME)) || \"\";\nlet customerAccountId = customerDetails.customerAccountId || \"\";\nlet totalOutstandingAmount = customerDetails.TOTALOPENBALANCE || 0;\nlet totalPastDueBalance = customerDetails.TOTALPASTDUEBALANCE || 0;\nlet collectorName = customerDetails.COLLECTORNAME|| \"\";\n\n/* installment list from BO */\nlet installmentOutput = $context.$nodes.FIN_IEX_BO_FETCH_INSTALLMENTS_REQUIRING_PROMISE.$output || [];\nlet installmentRecords = Array.isArray(installmentOutput) ? installmentOutput : [];\n\n/* total overdue amount by currency */\nlet totalOverdueAmountByCurrency = [];\nlet currencyTotalsMap = {};\n\n/* fetch first non-null delivery contact email */\nlet toEmailAddress = \"\";\n\nfor (let i = 0; i < installmentRecords.length; i++) {\n  let item = installmentRecords[i] || {};\n  let currencyCode = item.CURRENCYCODE || \"UNKNOWN\";\n  let amountRemaining = item.AMOUNTREMAINING;\n  let deliveryContactEmailAddress = item.DELIVERYCONTACTEMAILADDRESS || \"\";\n\n  if (amountRemaining === undefined || amountRemaining === null || amountRemaining === \"\") {\n    amountRemaining = 0;\n  }\n\n  if (!currencyTotalsMap[currencyCode]) {\n    currencyTotalsMap[currencyCode] = 0;\n  }\n\n  currencyTotalsMap[currencyCode] = currencyTotalsMap[currencyCode] + Number(amountRemaining);\n\n  if (!toEmailAddress && deliveryContactEmailAddress) {\n    toEmailAddress = deliveryContactEmailAddress;\n  }\n}\n\nfor (let currency in currencyTotalsMap) {\n  totalOverdueAmountByCurrency.push({\n    currencyCode: currency,\n    totalOverdueAmount: currencyTotalsMap[currency]\n  });\n}\n\n/* final overdue invoice list */\nlet overdueInvoices = installmentRecords.map((item) => {\n  return {\n    paymentScheduleId: item.PAYMENTSCHEDULEID || \"\",\n    installmentDueDate: item.INSTALLMENTDUEDATE || \"\",\n    transactionDate: item.TRANSACTIONDATE || \"\",\n    originalAmount: item.ORIGINALAMOUNT,\n    amountRemaining: item.AMOUNTREMAINING,\n    transactionNumber: item.TRANSACTIONNUMBER || \"\",\n    installmentStatus: item.INSTALLMENTSTATUS || \"\",\n    installmentClass: item.INSTALLMENTCLASS || \"\",\n    overdueFlag: item.OVERDUEFLAG || \"\",\n    currencyCode: item.CURRENCYCODE || \"\",\n    accountId: item.ACCOUNTID || \"\",\n    accountNumber: item.ACCOUNTNUMBER || \"\",\n    partyName: item.PARTYNAME || \"\",\n    partyNumber: item.PARTYNUMBER || \"\",\n    customerTransactionId: item.CUSTOMERTRANSACTIONID || \"\",\n    purchaseOrderNumber: item.PURCHASEORDERNUMBER,\n    purchaseOrderDate: item.PURCHASEORDERDATE,\n    wayBillNumber: item.WAYBILLNUMBER,\n    fOB: item.FOB,\n    customerTransactionReference: item.CUSTOMERTRANSACTIONREFERENCE,\n    customerTransactionSource: item.CUSTOMERTRANSACTIONSOURCE || \"\",\n    customerTransactionType: item.CUSTOMERTRANSACTIONTYPE || \"\",\n    businessUnit: item.BUSINESSUNIT || \"\",\n    daysOverdue: item.DAYSOVERDUE,\n    deliveryContactEmailAddress: item.DELIVERYCONTACTEMAILADDRESS || \"\"\n  };\n});\n\n/* derive account number and party number from first invoice */\nlet accountNumber = \"\";\nlet partyNumber = \"\";\nif (overdueInvoices.length > 0) {\n  if (overdueInvoices[0].accountNumber) {\n    accountNumber = overdueInvoices[0].accountNumber;\n  }\n  if (overdueInvoices[0].partyNumber) {\n    partyNumber = overdueInvoices[0].partyNumber;\n  }\n}\n\n/* email metadata included in same response */\nlet emailData = {\n  title: \"Review and Send\",\n  description: \"Review and send promise to pay email to customer\",\n  to: toEmailAddress,\n  cc: \"\",\n  subject: \"Overdue Balance Follow-up for account \" + customerName + \" - Requesting Payment Commitment\"\n};\n\nlet overdueInvoiceCount = overdueInvoices.length;\n\n\n/* final json object */\nlet result = {\n  title: emailData.title,\n  description: emailData.description,\n  //to: emailData.to,\n  to: \"\",\n  cc: emailData.cc,\n  subject: emailData.subject,\n  CustomerName: customerName,\n  CustomerAccountId: customerAccountId,\n  PartyNumber: partyNumber,\n  AccountNumber: accountNumber,\n  TotalOutstandingAmount: totalOutstandingAmount,\n  TotalOverdueAmount: totalOverdueAmountByCurrency,\n  OverdueInvoices: overdueInvoices,\n  OverdueInvoiceCount: overdueInvoiceCount,\n  TotalPastDueBalance: totalPastDueBalance,\n  CollectorName: collectorName\n};\n\nreturn result;",
            "errorNodeId": "1776869888109"
          },
          "outcomes": {
            "success": "1776837446788"
          },
          "diagram": {
            "x": 6467,
            "y": 7466
          },
          "code": "FIN_IEX_CODE_PROCESS_INSTALLMENTS_REQUIRING_PROMISE",
          "id": "1776694319117",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Constructing Payload for Email Message Details",
            "name": "Construct Payload for Getting Message Details for Promises",
            "returnType": "object",
            "sourceCode": "let pMessageId = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.messageId;\nlet pIntentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode;\n\nlet requestPayload = {\n  parameters: {\n    bindMessageId: pMessageId,\n    bindIntentCode: pIntentCode\n  },\n  viewQueries: {\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customer.id\": \"partyId\"\n      }\n    },\n    receivablesPaymentSchedules: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        \"transactionDate\": \"transactionDate\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"installmentDueDate\": \"dueDate\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\"\n      }\n    }\n  },\n  select: \"select cmd.customerMessageDetailId customerMessageDetailId, cmd.messageId messageId, cmd.customerTransactionId customerTransactionId, cmd.processingStatusCode processingStatusCode, cmd.intentCode intentCode, cmd.requestData requestData, cmd.responseData responseData, cmd.siteUseId siteUseId, cmd.accountId accountId, cmd.partyId partyId, rps.transactionNumber transactionNumber, to_char(rps.transactionDate,'YYYY-MM-DD') transactionDate, to_char(rps.dueDate,'YYYY-MM-DD') dueDate, rps.amountRemaining amountRemaining, rps.currencyCode currencyCode, rps.accountNumber accountNumber, rps.partyName partyName, rps.customerTransactionSource customerTransactionSource, rps.customerTransactionType customerTransactionType, rps.businessUnit businessUnit from collectionsCustomerMessageDetails cmd, (select receivablesPaymentSchedules.customerTransactionId customerTransactionId, max(receivablesPaymentSchedules.transactionNumber) transactionNumber, max(receivablesPaymentSchedules.transactionDate) transactionDate, max(receivablesPaymentSchedules.dueDate) dueDate, sum(receivablesPaymentSchedules.amountRemaining) amountRemaining, max(receivablesPaymentSchedules.currencyCode) currencyCode, max(receivablesPaymentSchedules.accountNumber) accountNumber, max(receivablesPaymentSchedules.partyName) partyName, max(receivablesPaymentSchedules.customerTransactionSource) customerTransactionSource, max(receivablesPaymentSchedules.customerTransactionType) customerTransactionType, max(receivablesPaymentSchedules.businessUnit) businessUnit from receivablesPaymentSchedules group by receivablesPaymentSchedules.customerTransactionId) rps where cmd.intentCode = :bindIntentCode and cmd.messageId = :bindMessageId and cmd.customerTransactionId = rps.customerTransactionId\"\n};\n\nlet result = requestPayload;\nreturn result;"
          },
          "outcomes": {
            "success": "1776658056809"
          },
          "diagram": {
