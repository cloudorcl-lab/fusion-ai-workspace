              "value": "{    \"viewQueries\": {        \"receivablesLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        },        \"collectionsLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select receivablesLookups.lookupType,receivablesLookups.lookupCode disputeReasonCode,receivablesLookups.lookupCategoryId applicationId, receivablesLookups.meaning disputeReason,receivablesLookups.description disputeReasonDescription from receivablesLookups, collectionsLookups where receivablesLookups.lookupCategoryId=222 and receivablesLookups.lookupType='CREDIT_MEMO_REASON' and receivablesLookups.enabledFlag=true and trunc(sysdate) between nvl(receivablesLookups.startDateActive, trunc(sysdate)) and nvl(receivablesLookups.endDateActive, trunc(sysdate)) and collectionsLookups.lookupCategoryId(+)=695 and collectionsLookups.lookupType(+)='ORA_CREDIT_REASON_CLOSE_INV' and tru