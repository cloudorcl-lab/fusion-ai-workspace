        {
          "metadata": {
            "description": "Construct Payload to get actionable details for the given email message ID",
            "name": "Construct Payload to Get Actionable Details from Email Messagee",
            "returnType": "object",
            "sourceCode": "let pMessageId = $context.$nodes.GET_EMAIL_MESSAGE_ID.$output.result;\nlet pIntentCode = $context.$nodes.EXTRACT_CUSTOMER_DETAILS.$output.result.intentCode;\n\n/* payload object for promise-to-pay message details */\nlet requestPayload = {\n  parameters: {\n    bindMessageId: pMessageId,\n    bindIntentCode: pIntentCode\n  },\n  viewQueries: {\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"customerAccount.customerAccountId\": \"accountId\",\n        \"customer.id\": \"partyId\"\n      }\n    }\n  },\n  select: \"select collectionsCustomerMessageDetails.customerMessageDetailId customerMessageDetailId, collectionsCustomerMessageDetails.messageId messageId, collectionsCustomerMessageDetails.paymentScheduleId paymentScheduleId, collectionsCustomerMessageDetails.customerTransactionId customerTransactionId, collectionsCustomerMessageDetails.processingStatusCode processingStatusCode, collectionsCustomerMessageDetails.intentCode intentCode, collectionsCustomerMessageDetails.requestData requestData, collectionsCustomerMessageDetails.responseData responseData, collectionsCustomerMessageDetails.siteUseId siteUseId, collectionsCustomerMessageDetails.accountId accountId, collectionsCustomerMessageDetails.partyId partyId from collectionsCustomerMessageDetails where collectionsCustomerMessageDetails.intentCode IN ('ORA_PROMISE_TO_PAY','ORA_DISPUTE_REQUEST','ORA_PO_UPDATE','ORA_INVOICE_REPRINT') and collectionsCustomerMessageDetails.messageId = :bindMessageId and collectionsCustomerMessageDetails.processingStatusCode in ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING') order by customerMessageDetailId\"\n};\n\n/* final result to return from agent studio code node */\nlet result = requestPayload;\nreturn result;",
            "errorNodeId": "1778436031247"
          },
          "outcomes": {
            "success": "1776681972998"
          },
