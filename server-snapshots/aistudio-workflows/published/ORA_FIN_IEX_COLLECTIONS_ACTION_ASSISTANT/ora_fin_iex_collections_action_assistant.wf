            "name": "Construct All Valid Response Data for Promise",
            "returnType": "array",
            "sourceCode": "const taskData = $context.$nodes.FIN_IEX_BO_EXECUTE_BATCH_ACTIONS_FOR_EMAIL_MESSAGE.$output || {};\nconst messageDetails = $context.$nodes.FIN_IEX_BO_GET_ACTIONABLE_DETAILS_FROM_EMAIL_MESSAGE.$output || [];\n\nlet extractedDataArray = [];\nlet parts = Array.isArray(taskData.parts) ? taskData.parts : [];\nlet detailRecords = Array.isArray(messageDetails) ? messageDetails : [];\n\nparts.forEach((part, index) => {\n    const payload = part && part.payload ? part.payload : {};\n    const messageDetail = detailRecords[index] || {};\n    const messageDetailId = messageDetail.CUSTOMERMESSAGEDETAILID || \"\";\n    let existingResponseData = messageDetail.RESPONSEDATA;\n    let parsedResponseData = {};\n    let hasExistingResponseData = false;\n\n    if (existingResponseData !== null && existingResponseData !== undefined && existingResponseData !== \"\") {\n        if (typeof existingResponseData === \"string\") {\n            try {\n                parsedResponseData = JSON.parse(existingResponseData);\n                if (parsedResponseData && typeof parsedResponseData === \"object\" && !Array.isArray(parsedResponseData)) {\n                    hasExistingResponseData = true;\n                } else {\n                    parsedResponseData = {};\n                }\n            } catch (e) {\n                parsedResponseData = {};\n            }\n        } else if (typeof existingResponseData === \"object\" && !Array.isArray(existingResponseData)) {\n            parsedResponseData = existingResponseData;\n            hasExistingResponseData = true;\n        }\n    }\n\n    const newResponseData = {\n        PromiseDetailId: payload.PromiseDetailId || \"\",\n        PromiseDate: payload.PromiseDate || \"\",\n        PromiseAmount: payload.PromiseAmount || \"\",\n        Currency: payload.Currency || \"\",\n        BusinessUnit: payload.BusinessUnit || \"\",\n        BillToCustomerAccount: payload.BillToCustomerAccount || \"\",\n        TransactionNumber: payload.TransactionNumber || \"\",\n        TransactionDate: payload.TransactionDate || \"\",\n        InstallmentNumber: payload.InstallmentNumber || \"\"\n    };\n\n    let finalResponseData = newResponseData;\n\n    if (hasExistingResponseData) {\n        finalResponseData = Object.assign({}, parsedResponseData, {\n            response: newResponseData\n        });\n    }\n\n    extractedDataArray.push({\n        messageDetailId: messageDetailId,\n        responseData: finalResponseData,\n        processingStatusCode: \"ORA_PROCESSED\"\n    });\n});\n\nreturn extractedDataArray;"
