              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "actionsPrompt": "<actionable_insights_feature>  <overview> Actionable insights are pre-defined actions a user can perform. They are generated only when specific conditions, outlined in your prompting, are met.  The final output for an actionable insight must be the <oraInsight> XML element containing its JSON payload, with no additional wrapping or formatting around the insight itself.  You must not make up things that you cannot do. You must follow your prompting and only send actionable insights that are explicitly asked by your prompting to send. </overview>  <json_schema> {   \"$schema\": \"http://json-schema.org/draft-07/schema#\",   \"type\": \"object\",   \"properties\": {     \"title\": {       \"type\": \"string\",       \"description\": \"The main title of the notification. Must be a concise phrase, under 10 words.\"     },     \"shortDescription\": {       \"type\": \"string\",       \"description\": \"A brief description of the notification, written as a single, complete sentence.\"     },     \"actionText\": {       \"type\": \"string\",       \"description\": \"The text to display on the action button.\"     },     \"followUpCommand\": {       \"type\": \"string\",       \"description\": \"A command string to be executed. Must follow one of three standardized formats: ora.App.*(params), ora.Agent(content), or ora.URL(url). The exact content will be specified by the prompting instructions.\"     },     \"priority\": {       \"type\": \"boolean\",       \"description\": \"Optional. Controls whether this action should be prioritized in the display. If undefined or false, the action will not be prioritized. Only when set to true will the action be prioritized. By default, omit this property or set it to false unless your prompting explicitly instructs you to prioritize the action.\"     }   },   \"required\": [\"title\", \"shortDescription\", \"actionText\", \"followUpCommand\"],   \"additionalProperties\": false } </json_schema>  <command_instructions> The followUpCommand property contains the action to be performed and MUST follow one of these three standardized formats:  1. **ora.App.functionname(params)** - For application-level commands    - Can be called with or without parameters    - Parameters can be strings, numbers, booleans, JSON objects, or other valid types    - Example: `ora.App.update()`    - Example: `ora.App.navigate(\"settings\")`    - Example: `ora.App.setConfig({\"theme\": \"dark\", \"notifications\": true})`    - Example: `ora.App.processData(123, \"high-priority\")`  2. **ora.Agent(content)** - For LLM/agent commands    - Content can be a string, JSON object, or any other format as specified by your prompting    - Example: `ora.Agent(\"turn off the lights\")`    - Example: `ora.Agent({\"command\": \"lights.off\", \"rooms\": [\"bedroom\", \"kitchen\"]})`    - Example: `ora.Agent(\"summarize my emails\")`  3. **ora.URL(url)** - For navigation to URLs    - Example: `ora.URL(\\\"https://example.com/support\\\")`    - Example: `ora.URL(\\\"https://docs.example.com\\\")`  Your additional prompting will specify the exact value to use for the followUpCommand property. You MUST use this value verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind. </command_instructions>  <examples> <example> <description>An actionable insight that lets the user know that they should turn off the lights (using ora.Agent with JSON format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: turn off lights\",   \"shortDescription\": \"No one was detected in the house, suggest you turn off the lights.\",   \"actionText\": \"Turn Off Lights\",   \"followUpCommand\": \"ora.Agent({\\\"command\\\": \\\"lights.off\\\", \\\"zones\\\": [\\\"all\\\"]})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight notifying the user about a software update (using ora.App with no parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Software Update Available\",   \"shortDescription\": \"A new version of the application is ready to install.\",   \"actionText\": \"Install Now\",   \"followUpCommand\": \"ora.App.update()\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight suggesting the user visit a support page (using ora.URL format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Billing Issue Detected\",   \"shortDescription\": \"There seems to be an issue with your recent payment.\",   \"actionText\": \"Visit Support Page\",   \"followUpCommand\": \"ora.URL(\\\"https://example.com/support/billing\\\")\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight for opening a specific document (using ora.App with parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Document Ready for Review\",   \"shortDescription\": \"Your quarterly report has been generated and is ready for review.\",   \"actionText\": \"Open Document\",   \"followUpCommand\": \"ora.App.openDocument(\\\"Q4-2024-report.pdf\\\", {\\\"mode\\\": \\\"edit\\\"})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight using ora.Agent with a simple string command:</description> <code><![CDATA[<oraInsight> {   \"title\": \"Schedule Reminder\",   \"shortDescription\": \"You have a meeting in 15 minutes.\",   \"actionText\": \"Show Details\",   \"followUpCommand\": \"ora.Agent(\\\"show my next meeting details\\\")\" } </oraInsight>]]></code> </example>  <example> <description>A prioritized actionable insight (using the priority field):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Critical Security Alert\",   \"shortDescription\": \"Unusual login activity detected on your account.\",   \"actionText\": \"Review Activity\",   \"followUpCommand\": \"ora.App.openSecurityCenter()\",   \"priority\": true } </oraInsight>]]></code> </example>  <example> <description>A non-prioritized actionable insight (priority explicitly set to false):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: Update Profile\",   \"shortDescription\": \"Your profile information hasn't been updated in a while.\",   \"actionText\": \"Update Now\",   \"followUpCommand\": \"ora.App.navigate(\\\"profile\\\")\",   \"priority\": false } </oraInsight>]]></code> </example> </examples>  <output_contract_and_rules> <rule id=\"followUpCommand_format_contract\"> The followUpCommand property has strict format requirements:  1. **EXACTLY ONE OF THREE FORMATS:** The value MUST use exactly one of these formats:    - `ora.App.functionname()` or `ora.App.functionname(params)` for application commands    - `ora.Agent(content)` for agent/LLM commands    - `ora.URL(url)` for navigation  2. **NO RAW VALUES:** The followUpCommand must NEVER be a raw command, raw function call, or raw URL. It must ALWAYS be wrapped in one of the three ora.* formats.  3. **PROPER ESCAPING:** When parameters contain strings or JSON:    - String parameters must be enclosed in escaped double quotes: `\\\"`    - JSON content must have quotes properly escaped    - **Correct:** `ora.Agent(\"turn on lights\")`    - **Correct:** `ora.Agent({\\\"command\\\": \\\"lights.on\\\"})`    - **Correct:** `ora.App.navigate(\"home\")`    - **Incorrect:** `ora.Agent('turn on lights')`    - **Incorrect:** `ora.Agent(turn on lights)`  4. **FLEXIBLE PARAMETERS:**     - ora.App functions can accept zero or more parameters of any type    - ora.Agent can accept a string, JSON object, or other content as specified by prompting instructions    - ora.URL accepts a single URL string parameter  5. **VERBATIM USAGE:** When your prompting instructions specify a followUpCommand value, you MUST use it exactly as provided without any modifications.  6. **SEPARATION OF CONCERNS:** The user-visible, clickable text is handled *exclusively* by the `actionText` property. The command/destination is handled *exclusively* by the `followUpCommand` property. These two values must never be mixed or combined. </rule>  <rule id=\"self_correction_check\"> MANDATORY FINAL CHECK: Before providing your final response, you MUST perform this self-correction step: 1. Examine the value you are about to output for the followUpCommand property. 2. Ask yourself: \"Does this value start with 'ora.App.', 'ora.Agent(', or 'ora.URL('?\" 3. If the answer is NO, your output is INVALID. You must fix it by wrapping the value in the appropriate ora.* format. 4. Verify that all string content within parameters is properly escaped with `\\\"` characters. 5. For ora.Agent(), ensure the content format (string, JSON, etc.) matches what was specified in your prompting instructions. </rule>  <rule id=\"priority_field_usage\"> PRIORITY FIELD BEHAVIOR AND USAGE: 1. **Display Behavior:** If the priority property is undefined or set to false, the action will not be prioritized in the display. Only when set to true will the action be prioritized.  2. **Default Behavior:** By default, you should omit the priority property or set it to false unless your prompting explicitly instructs you to prioritize the action.  3. **When to Set to True:** Only set priority to true when:    - Your prompting explicitly instructs you to prioritize this specific action    - The action is time-sensitive or critical (and your prompting indicates this should be prioritized)    - The user explicitly requests priority for the action  4. **When to Omit or Set to False:** In all other cases, either omit the priority property entirely or explicitly set it to false. </rule>  </output_contract_and_rules>  <important_notes>  Output Formatting: Each actionable insight MUST be output as a raw <oraInsight> XML element. Do not wrap insights in markdown code blocks, CDATA sections, or other formatting. Actionable insights can be included alongside regular conversational text in your response - simply output your normal text, then append the <oraInsight> elements.   Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct.  Duplicate Prevention: Avoid sending an actionable insight if the value of its followUpCommand property is a character-for-character identical match to one already sent in the current conversation. The calling application is responsible for providing an accurate history of commands used in the current session. </important_notes>  <generation_rules> <rule id=\"positive_condition\"> You MUST only generate an actionable insight if your additional prompting explicitly instructs you to do so. </rule> <rule id=\"negative_condition\"> If the conditions for generating an actionable insight are NOT met, you MUST return a completely empty response. You MUST NOT output any text, including phrases like \"No action required,\" \"No actions available,\" or any other explanatory sentence. Your entire response body must be empty. </rule> </generation_rules>  </actionable_insights_feature>",
              "enableActions": true,
              "communicationsPrompt": "<communication_suggestions_feature>   <overview>     Communication suggestions are options that can be presented to the user to allow them to initiate communication messages using a specific templated format. They are generated only when specific conditions, outlined in your prompting, are met. The final output for a communication suggestion must be only the <oraComms> XML element containing its JSON payload. Your response must not be wrapped in any other formatting, like markdown code blocks or CDATA sections. You must not make up communications on things that you cannot do. You must follow your prompting and only send communication suggestions that are explicitly asked by your prompting to send.   </overview>      <json_schema>     {       \"$schema\": \"http://json-schema.org/draft-07/schema#\",       \"type\": \"object\",       \"required\": [         \"title\",         \"shortDescription\",         \"actionText\",         \"generatingAgent\",         \"targetAgent\",         \"params\"       ],       \"properties\": {         \"title\": {           \"type\": \"string\",           \"description\": \"The title\"         },         \"shortDescription\": {           \"type\": \"string\",           \"description\": \"Short description\"         },         \"templateId\": {           \"type\": \"string\",           \"description\": \"The template to use to generate the content\"         },         \"actionText\": {           \"type\": \"string\",           \"description\": \"Action button text\"         },         \"generatingAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID of template agent\"         },         \"targetAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID to receive communications\"         },         \"params\": {           \"type\": \"array\",           \"description\": \"Template parameters\",           \"items\": {             \"type\": \"object\",             \"required\": [               \"id\",               \"title\",               \"description\",               \"isTemplateParam\",               \"defaultValue\"             ],             \"properties\": {               \"id\": {                 \"type\": \"string\",                 \"description\": \"parameter ID\"               },               \"title\": {                 \"type\": \"string\",                 \"description\": \"name of the parameter\"               },               \"description\": {                 \"type\": \"string\",                 \"description\": \"description of the parameter\"               },               \"defaultValue\": {                 \"type\": \"string\",                 \"description\": \"Default value for the parameter\"               },               \"isTemplateParam\": {                 \"type\": \"boolean\",                 \"description\": \"Flag to indicate if the parameter participates in template content generation. For example, in a incident report, blast radius is part of the template. But something like email address is not part of the template. It is for communication metadata. Set this to false in such cases\"               }             },             \"additionalProperties\": false           }         }       },       \"additionalProperties\": false     }   </json_schema>      <structure_definitions>     The title, shortDescription, isTemplateParam and actionText will be human visible and can be specified by you freely unless given specific text to use by additional prompting. The exact value of the generatingAgent and targetAgent will be specified in your additional prompting. You MUST use these values verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind.       The templateId is optional, only apply this if the exact value of the templateId is specified in your additional prompting. This value must be used verbatim. If this is not mentioned, do not invent a value for this property.          For each param, the ID must be exactly the ID provided. The param description will either be provided or you will be asked to generate it based on specific instructions. These params are mapped to a specific template, so the param IDs **must** be exactly as provided by any additional prompting and must not be made up.   </structure_definitions>      <examples>     <example>       <description>A communication suggestion that when invoked will send a message to a specific person:</description>       <code><![CDATA[<oraComms> {   \"title\": \"Send Update on Project Fiora to John\",   \"shortDescription\": \"Sends a message to John concerning Project Fiora and its delays.\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"email\",       \"title\": \"email address\",       \"defaultValue\": \"abc@oracle.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"projectName\",       \"title\": \"Project Name\",       \"defaultValue\": \"Project Fiora\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"projecUpdateMessage\",       \"title\": \"message\",       \"defaultValue\": \"We are running over budget by $xm. 3 of the milestones were delayed.\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>          <example>       <description>A communication suggestion that when invoked will send an alert out</description>       <code><![CDATA[<oraComms> {   \"title\": \"System Failure Notice\",   \"shortDescription\": \"Alerts all team members of the system failure\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"blastRadius\",       \"title\": \"Blast Radius\",       \"defaultValue\": \"us east\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"email\",       \"title\": \"email\",       \"defaultValue\": \"xyz@abc.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"affectedProducts\",       \"title\": \"Affected Products\",       \"defaultValue\": \"shopping, user history, order log\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>   </examples>      <important_notes>     Output Formatting: Your response MUST be the raw <oraComms> XML element and nothing else. Crucially, you MUST NOT include <code>, <![CDATA[...]]>, or markdown backticks (```) in your final output. The formatting in the examples is for display purposes within this prompt only and should not be copied. Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct. Generation Rule: You MUST never make up communication suggestions; you MUST only generate them if your additional prompting tells you to do so.   </important_notes> </communication_suggestions_feature>",
              "enableCommunications": true,
              "configurationPrompt": "<information_displays_feature>  <overview> Information displays are used to present relevant pieces of information in a structured, graphical format. They are generated only when specific conditions, outlined in your prompting, are met.  The final output for an information display must be only the <oraInfoDisplay> XML element containing its JSON payload. Your response must not be wrapped in any other formatting, like markdown code blocks or CDATA sections. </overview>  <xml_attributes> The <oraInfoDisplay> tag requires a key attribute. This key is used by the client application to determine whether to display new information or replace existing information that was sent with the same key. </xml_attributes>  <key_generation_rules> Follow these instructions precisely when generating a value for the key attribute:  unique: For single, non-repeatable alerts. The key should be a unique identifier (e.g., a timestamp or UUID) and should never be reused within the conversation.  contextual: For supplementary information that provides additional context relevant to the user's query but is not the primary answer.  list: For displaying a list of items. </key_generation_rules>  <json_schema>  JSON {   \"$schema\": \"http://json-schema.org/draft-07/schema#\",   \"type\": \"object\",   \"title\": \"string\",   \"properties\": {     \"patternId\": {       \"type\": \"string\",       \"description\": \"A unique identifier for the UI pattern to be used for rendering, such as 'pattern.list.simple' or 'pattern.alert.critical'.\"     },     \"description\": {       \"type\": \"string\",       \"description\": \"A very short, user-visible description of what the information display is showing.\"     },     \"properties\": {       \"type\": \"object\",       \"description\": \"An object containing the data to be displayed, which must conform to the schema required by the specified patternId.\"     }   },   \"required\": [\"title\", \"patternId\", \"description\", \"properties\"],   \"additionalProperties\": false } </json_schema>  <examples> <example> <description>An information display showing a list of servers (Key: \"list\"):</description> <code><![CDATA[<oraInfoDisplay key=\"list\"> {   \"title\": \"Performance Monitoring\",   \"patternId\": \"messageListWidget\",   \"description\": \"Summary of CPU intake\",   \"properties\": {     \"subtitle\": \"Real-time metrics\",     \"items\": [         {         \"title\": \"Memory Usage Spike Detected\",         \"subtitle\": \"82% confidence\",         \"summary\": \"Memory consumption increased by 40% in the last 5 minutes\",         \"badgeText\": \"MEDIUM\",         \"priority\": \"medium\",         \"timestamp\": \"3 min ago\",         \"action\": \"ora.app.setContext('foo')\"         },         {         \"title\": \"Network Latency Increase\",          \"subtitle\": \"Average response degraded\",         \"summary\": \"Average response time increased from 120ms to 180ms.\",         \"badgeText\": \"LOW\",         \"priority\": \"warning\",         \"timestamp\": \"16 min ago\"         },         {         \"title\": \"System Update Completed\",         \"badgeText\": \"INFO\",         \"priority\": \"medium\",         \"timestamp\": \"1 hour ago\"         }     ]   } } </oraInfoDisplay> I've provided you a list of metrics, you may want to check out the memory spike. ]]></code> </example>  <example> <description>An information display providing contextual details about a system alert (Key: \"contextual\"):</description> <code><![CDATA[<oraInfoDisplay key=\"contextual\"> {   \"title\": \"Marketing Metrics\",   \"patternId\": \"messageListWidget\",   \"description\": \"Summary of CPU intake\",   \"properties\": {     \"subtitle\": \"Campaign performance comparison\",     \"displayType\": \"percentage\",     \"items\": [         {         \"title\": \"Email Open Rate\",         \"currentValue\": 28.2,         \"previousValue\": 24.5         },         {         \"title\": \"Click-through Rate\",          \"currentValue\": 4.6,         \"previousValue\": 3.8         },         {         \"title\": \"Conversion Rate\",         \"currentValue\": 1.9,         \"previousValue\": 2.1         }     ],     \"messages\": [         \"Conversion rate drop may indicate landing page issues\"     ]   } } </oraInfoDisplay> Your email engagement has improved significantly, but the drop in conversions suggests you should review your landing page experience and checkout flow. ]]></code> </example>  <example> <description>An information display showing a single, unique alert (Key: unique ID):</description> <code><![CDATA[<oraInfoDisplay key=\"alert-1664392954\"> {   \"title\": \"Critical alert found\",   \"patternId\": \"cardWidget\",   \"description\": \"A critical alert indicating a database connection failure.\",   \"properties\": {     \"subject\": \"System Alert\",     \"summary\": \"High CPU usage detected on web servers. Investigation in progress.\",     \"timestamp\": \"15 min ago\",     \"link\": {         \"text\": \"Details\",         \"action\": \"view_error_details\"     },     \"variant\": \"error\"   } } </oraInfoDisplay> This requires immediate attention. The DevOps team has been notified and is currently investigating the root cause.]]></code> </example> </examples>  <important_notes>  Output Formatting: Your response MUST be the raw <oraInfoDisplay> XML element and nothing else. Crucially, you MUST NOT include <code>, <![CDATA[...]]>, or markdown backticks (```) in your final output. The formatting in the examples is for display purposes within this prompt only and should not be copied.  Accompanying Summary: Unless instructed otherwise, an <oraInfoDisplay> must always be accompanied by a brief, natural language summary. The text in your response should introduce or summarize the data, while the display itself provides the structured, detailed information.  Multiple Displays: If you need to generate multiple information displays, use a new <oraInfoDisplay> node for each one. Each node must contain a single, complete JSON object.  Generation Rule: Every response that presents information or a final answer MUST include at least one <oraInfoDisplay>. Conversely, responses that only ask the user a question MUST NOT include an <oraInfoDisplay>. This summary text should appear before and/or after the display, but always OUTSIDE the XML tags  Schema Adherence: The properties object within the JSON payload must always be present, and its structure must match the schema expected by the chosen patternId.  You MUST only choose from the available widgets and must not make up a widget type. </important_notes>  <available_widgets_to_select_from>\n<messageListWidget>     <description>A list of messages, or in its degenerate form, a single message. This can be used to show highlighted items (from the corpus of knowledge), bring alerts to the user, or otherwise list out small sets of messages to the user.</description>     <schema> {     \"$schema\": \"http://json-schema.org/draft-07/schema#\",     \"type\": \"object\",     \"required\": [\"items\"],     \"properties\": {         \"subtitle\": {             \"type\": \"string\",             \"description\": \"Optional context or description for the entire list\"         },         \"items\": {             \"type\": \"array\",             \"description\": \"Array of message items to display\",             \"items\": {                 \"type\": \"object\",                 \"required\": [\"title\"],                 \"properties\": {                     \"title\": {                         \"type\": \"string\",                         \"description\": \"The main message or event name\"                     },                     \"subtitle\": {                         \"type\": \"string\",                         \"description\": \"Additional context, confidence levels, or secondary information\"                     },                     \"summary\": {                         \"type\": \"string\",                         \"description\": \"Longer description with specific details, metrics, or context\"                     },                     \"badgeText\": {                         \"type\": \"string\",                         \"description\": \"Short label for categorization\"                     },                     \"priority\": {                         \"type\": \"string\",                         \"enum\": [\"alert\", \"warning\", \"medium\"],                         \"default\": \"medium\",                         \"description\": \"Visual styling and urgency level (alert: critical, warning: concerning, medium: normal)\"                     },                     \"timestamp\": {                         \"type\": \"string\",                         \"description\": \"When the event occurred\"                     },                     \"action\": {                         \"type\": \"string\",                         \"description\": \"Action string passed to handler when item is clicked (makes item interactive)\"                     }                 }             }         }     } }     </schema>     <instructions> **Header Level (title and subtitle)**  title: Main heading for the entire card (e.g., \"Performance Monitoring\", \"System Alerts\", \"Recent Activity\") subtitle: Optional context or description (e.g., \"Real-time metrics\", \"Last 24 hours\", \"Critical events only\")  **Item Level (each object in items array)** **Required Fields**  title: The main message or event name. Be concise but descriptive (e.g., \"Memory Usage Spike Detected\", \"Database Connection Lost\", \"User Login Failed\")  **Optional Fields**  subtitle: Additional context, confidence levels, or secondary information (e.g., \"82% confidence\", \"Retry attempt 3/5\", \"Authentication server timeout\") summary: Longer description with specific details, metrics, or context (e.g., \"Memory consumption increased by 40% in the last 5 minutes\", \"Connection failed after 30 second timeout\") badgeText: Short label for categorization (e.g., \"HIGH\", \"MEDIUM\", \"LOW\", \"INFO\", \"ERROR\", \"WARNING\", \"CRITICAL\") priority: Controls visual styling and urgency level  \"alert\" - Red styling for critical/urgent items \"warning\" - Orange styling for concerning items \"medium\" - Blue/gray styling for normal items (default)  timestamp: When the event occurred (e.g., \"3 min ago\", \"1 hour ago\", \"2024-01-15 14:30\", \"Just now\") action: An action string that will be passed to a handler when the user clicks on this message item. When present, the item becomes clickable.  **Best Practices**  Be Consistent: Use similar formatting and terminology across items Prioritize Appropriately: Use \"alert\" sparingly for truly critical issues Badge Text: Keep to 1-3 words, use ALL CAPS Timestamps: Use human-readable relative times when possible Summaries: Include specific metrics, numbers, or actionable details Titles: Start with action words or clear event descriptions Actions: Only add when the item should be interactive/clickable     </instructions>     <examples> {     \"subtitle\": \"Real-time metrics\",     \"items\": [         {         \"title\": \"Memory Usage Spike Detected\",         \"subtitle\": \"82% confidence\",         \"summary\": \"Memory consumption increased by 40% in the last 5 minutes\",         \"badgeText\": \"MEDIUM\",         \"priority\": \"medium\",         \"timestamp\": \"3 min ago\",         \"action\": \"ora.app.setContext('foo')\"         },         {         \"title\": \"Network Latency Increase\",          \"subtitle\": \"Average response degraded\",         \"summary\": \"Average response time increased from 120ms to 180ms.\",         \"badgeText\": \"LOW\",         \"priority\": \"warning\",         \"timestamp\": \"16 min ago\"         },         {         \"title\": \"System Update Completed\",         \"badgeText\": \"INFO\",         \"priority\": \"medium\",         \"timestamp\": \"1 hour ago\"         }     ] }     </examples> </messageListWidget>\n</available_widgets_to_select_from>  </information_displays_feature>"
            }
          },
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "provider": "CERT_PREMIUM"
            },
            "name": "Init Displays"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "INIT_DISPLAYS",
          "id": "1763418995660",
          "inputs": [
            {
              "id": "1763418995662_1",
              "name": "prompt",
              "type": "string",
              "value": "Your data:\n\n {{$context.$nodes.PREPARE_DATA.$output.result}}\n\n {{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST",
                "ORA_LAYOUT_MULTIRECORD",
                "ORA_LAYOUT_RECORD",
                "ORA_LAYOUT_CARD"
              ],
              "actionsPrompt": "<actionable_insights_feature>  <overview> Actionable insights are pre-defined actions a user can perform. They are generated only when specific conditions, outlined in your prompting, are met.  The final output for an actionable insight must be the <oraInsight> XML element containing its JSON payload, with no additional wrapping or formatting around the insight itself.  You must not make up things that you cannot do. You must follow your prompting and only send actionable insights that are explicitly asked by your prompting to send. </overview>  <json_schema> {   \"$schema\": \"http://json-schema.org/draft-07/schema#\",   \"type\": \"object\",   \"properties\": {     \"title\": {       \"type\": \"string\",       \"description\": \"The main title of the notification. Must be a concise phrase, under 10 words.\"     },     \"shortDescription\": {       \"type\": \"string\",       \"description\": \"A brief description of the notification, written as a single, complete sentence.\"     },     \"actionText\": {       \"type\": \"string\",       \"description\": \"The text to display on the action button.\"     },     \"followUpCommand\": {       \"type\": \"string\",       \"description\": \"A command string to be executed. Must follow one of three standardized formats: ora.App.*(params), ora.Agent(content), or ora.URL(url). The exact content will be specified by the prompting instructions.\"     },     \"priority\": {       \"type\": \"boolean\",       \"description\": \"Optional. Controls whether this action should be prioritized in the display. If undefined or false, the action will not be prioritized. Only when set to true will the action be prioritized. By default, omit this property or set it to false unless your prompting explicitly instructs you to prioritize the action.\"     }   },   \"required\": [\"title\", \"shortDescription\", \"actionText\", \"followUpCommand\"],   \"additionalProperties\": false } </json_schema>  <command_instructions> The followUpCommand property contains the action to be performed and MUST follow one of these three standardized formats:  1. **ora.App.functionname(params)** - For application-level commands    - Can be called with or without parameters    - Parameters can be strings, numbers, booleans, JSON objects, or other valid types    - Example: `ora.App.update()`    - Example: `ora.App.navigate(\"settings\")`    - Example: `ora.App.setConfig({\"theme\": \"dark\", \"notifications\": true})`    - Example: `ora.App.processData(123, \"high-priority\")`  2. **ora.Agent(content)** - For LLM/agent commands    - Content can be a string, JSON object, or any other format as specified by your prompting    - Example: `ora.Agent(\"turn off the lights\")`    - Example: `ora.Agent({\"command\": \"lights.off\", \"rooms\": [\"bedroom\", \"kitchen\"]})`    - Example: `ora.Agent(\"summarize my emails\")`  3. **ora.URL(url)** - For navigation to URLs    - Example: `ora.URL(\\\"https://example.com/support\\\")`    - Example: `ora.URL(\\\"https://docs.example.com\\\")`  Your additional prompting will specify the exact value to use for the followUpCommand property. You MUST use this value verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind. </command_instructions>  <examples> <example> <description>An actionable insight that lets the user know that they should turn off the lights (using ora.Agent with JSON format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: turn off lights\",   \"shortDescription\": \"No one was detected in the house, suggest you turn off the lights.\",   \"actionText\": \"Turn Off Lights\",   \"followUpCommand\": \"ora.Agent({\\\"command\\\": \\\"lights.off\\\", \\\"zones\\\": [\\\"all\\\"]})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight notifying the user about a software update (using ora.App with no parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Software Update Available\",   \"shortDescription\": \"A new version of the application is ready to install.\",   \"actionText\": \"Install Now\",   \"followUpCommand\": \"ora.App.update()\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight suggesting the user visit a support page (using ora.URL format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Billing Issue Detected\",   \"shortDescription\": \"There seems to be an issue with your recent payment.\",   \"actionText\": \"Visit Support Page\",   \"followUpCommand\": \"ora.URL(\\\"https://example.com/support/billing\\\")\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight for opening a specific document (using ora.App with parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Document Ready for Review\",   \"shortDescription\": \"Your quarterly report has been generated and is ready for review.\",   \"actionText\": \"Open Document\",   \"followUpCommand\": \"ora.App.openDocument(\\\"Q4-2024-report.pdf\\\", {\\\"mode\\\": \\\"edit\\\"})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight using ora.Agent with a simple string command:</description> <code><![CDATA[<oraInsight> {   \"title\": \"Schedule Reminder\",   \"shortDescription\": \"You have a meeting in 15 minutes.\",   \"actionText\": \"Show Details\",   \"followUpCommand\": \"ora.Agent(\\\"show my next meeting details\\\")\" } </oraInsight>]]></code> </example>  <example> <description>A prioritized actionable insight (using the priority field):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Critical Security Alert\",   \"shortDescription\": \"Unusual login activity detected on your account.\",   \"actionText\": \"Review Activity\",   \"followUpCommand\": \"ora.App.openSecurityCenter()\",   \"priority\": true } </oraInsight>]]></code> </example>  <example> <description>A non-prioritized actionable insight (priority explicitly set to false):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: Update Profile\",   \"shortDescription\": \"Your profile information hasn't been updated in a while.\",   \"actionText\": \"Update Now\",   \"followUpCommand\": \"ora.App.navigate(\\\"profile\\\")\",   \"priority\": false } </oraInsight>]]></code> </example> </examples>  <output_contract_and_rules> <rule id=\"followUpCommand_format_contract\"> The followUpCommand property has strict format requirements:  1. **EXACTLY ONE OF THREE FORMATS:** The value MUST use exactly one of these formats:    - `ora.App.functionname()` or `ora.App.functionname(params)` for application commands    - `ora.Agent(content)` for agent/LLM commands    - `ora.URL(url)` for navigation  2. **NO RAW VALUES:** The followUpCommand must NEVER be a raw command, raw function call, or raw URL. It must ALWAYS be wrapped in one of the three ora.* formats.  3. **PROPER ESCAPING:** When parameters contain strings or JSON:    - String parameters must be enclosed in escaped double quotes: `\\\"`    - JSON content must have quotes properly escaped    - **Correct:** `ora.Agent(\"turn on lights\")`    - **Correct:** `ora.Agent({\\\"command\\\": \\\"lights.on\\\"})`    - **Correct:** `ora.App.navigate(\"home\")`    - **Incorrect:** `ora.Agent('turn on lights')`    - **Incorrect:** `ora.Agent(turn on lights)`  4. **FLEXIBLE PARAMETERS:**     - ora.App functions can accept zero or more parameters of any type    - ora.Agent can accept a string, JSON object, or other content as specified by prompting instructions    - ora.URL accepts a single URL string parameter  5. **VERBATIM USAGE:** When your prompting instructions specify a followUpCommand value, you MUST use it exactly as provided without any modifications.  6. **SEPARATION OF CONCERNS:** The user-visible, clickable text is handled *exclusively* by the `actionText` property. The command/destination is handled *exclusively* by the `followUpCommand` property. These two values must never be mixed or combined. </rule>  <rule id=\"self_correction_check\"> MANDATORY FINAL CHECK: Before providing your final response, you MUST perform this self-correction step: 1. Examine the value you are about to output for the followUpCommand property. 2. Ask yourself: \"Does this value start with 'ora.App.', 'ora.Agent(', or 'ora.URL('?\" 3. If the answer is NO, your output is INVALID. You must fix it by wrapping the value in the appropriate ora.* format. 4. Verify that all string content within parameters is properly escaped with `\\\"` characters. 5. For ora.Agent(), ensure the content format (string, JSON, etc.) matches what was specified in your prompting instructions. </rule>  <rule id=\"priority_field_usage\"> PRIORITY FIELD BEHAVIOR AND USAGE: 1. **Display Behavior:** If the priority property is undefined or set to false, the action will not be prioritized in the display. Only when set to true will the action be prioritized.  2. **Default Behavior:** By default, you should omit the priority property or set it to false unless your prompting explicitly instructs you to prioritize the action.  3. **When to Set to True:** Only set priority to true when:    - Your prompting explicitly instructs you to prioritize this specific action    - The action is time-sensitive or critical (and your prompting indicates this should be prioritized)    - The user explicitly requests priority for the action  4. **When to Omit or Set to False:** In all other cases, either omit the priority property entirely or explicitly set it to false. </rule>  </output_contract_and_rules>  <important_notes>  Output Formatting: Each actionable insight MUST be output as a raw <oraInsight> XML element. Do not wrap insights in markdown code blocks, CDATA sections, or other formatting. Actionable insights can be included alongside regular conversational text in your response - simply output your normal text, then append the <oraInsight> elements.   Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct.  Duplicate Prevention: Avoid sending an actionable insight if the value of its followUpCommand property is a character-for-character identical match to one already sent in the current conversation. The calling application is responsible for providing an accurate history of commands used in the current session. </important_notes>  <generation_rules> <rule id=\"positive_condition\"> You MUST only generate an actionable insight if your additional prompting explicitly instructs you to do so. </rule> <rule id=\"negative_condition\"> If the conditions for generating an actionable insight are NOT met, you MUST return a completely empty response. You MUST NOT output any text, including phrases like \"No action required,\" \"No actions available,\" or any other explanatory sentence. Your entire response body must be empty. </rule> </generation_rules>  </actionable_insights_feature>",
              "enableActions": true,
              "communicationsPrompt": "<communication_suggestions_feature>   <overview>     Communication suggestions are options that can be presented to the user to allow them to initiate communication messages using a specific templated format. They are generated only when specific conditions, outlined in your prompting, are met. The final output for a communication suggestion must be only the <oraComms> XML element containing its JSON payload. Your response must not be wrapped in any other formatting, like markdown code blocks or CDATA sections. You must not make up communications on things that you cannot do. You must follow your prompting and only send communication suggestions that are explicitly asked by your prompting to send.   </overview>      <json_schema>     {       \"$schema\": \"http://json-schema.org/draft-07/schema#\",       \"type\": \"object\",       \"required\": [         \"title\",         \"shortDescription\",         \"actionText\",         \"generatingAgent\",         \"targetAgent\",         \"params\"       ],       \"properties\": {         \"title\": {           \"type\": \"string\",           \"description\": \"The title\"         },         \"shortDescription\": {           \"type\": \"string\",           \"description\": \"Short description\"         },         \"templateId\": {           \"type\": \"string\",           \"description\": \"The template to use to generate the content\"         },         \"actionText\": {           \"type\": \"string\",           \"description\": \"Action button text\"         },         \"generatingAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID of template agent\"         },         \"targetAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID to receive communications\"         },         \"params\": {           \"type\": \"array\",           \"description\": \"Template parameters\",           \"items\": {             \"type\": \"object\",             \"required\": [               \"id\",               \"title\",               \"description\",               \"isTemplateParam\",               \"defaultValue\"             ],             \"properties\": {               \"id\": {                 \"type\": \"string\",                 \"description\": \"parameter ID\"               },               \"title\": {                 \"type\": \"string\",                 \"description\": \"name of the parameter\"               },               \"description\": {                 \"type\": \"string\",                 \"description\": \"description of the parameter\"               },               \"defaultValue\": {                 \"type\": \"string\",                 \"description\": \"Default value for the parameter\"               },               \"isTemplateParam\": {                 \"type\": \"boolean\",                 \"description\": \"Flag to indicate if the parameter participates in template content generation. For example, in a incident report, blast radius is part of the template. But something like email address is not part of the template. It is for communication metadata. Set this to false in such cases\"               }             },             \"additionalProperties\": false           }         }       },       \"additionalProperties\": false     }   </json_schema>      <structure_definitions>     The title, shortDescription, isTemplateParam and actionText will be human visible and can be specified by you freely unless given specific text to use by additional prompting. The exact value of the generatingAgent and targetAgent will be specified in your additional prompting. You MUST use these values verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind.       The templateId is optional, only apply this if the exact value of the templateId is specified in your additional prompting. This value must be used verbatim. If this is not mentioned, do not invent a value for this property.          For each param, the ID must be exactly the ID provided. The param description will either be provided or you will be asked to generate it based on specific instructions. These params are mapped to a specific template, so the param IDs **must** be exactly as provided by any additional prompting and must not be made up.   </structure_definitions>      <examples>     <example>       <description>A communication suggestion that when invoked will send a message to a specific person:</description>       <code><![CDATA[<oraComms> {   \"title\": \"Send Update on Project Fiora to John\",   \"shortDescription\": \"Sends a message to John concerning Project Fiora and its delays.\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"email\",       \"title\": \"email address\",       \"defaultValue\": \"abc@oracle.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"projectName\",       \"title\": \"Project Name\",       \"defaultValue\": \"Project Fiora\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"projecUpdateMessage\",       \"title\": \"message\",       \"defaultValue\": \"We are running over budget by $xm. 3 of the milestones were delayed.\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>          <example>       <description>A communication suggestion that when invoked will send an alert out</description>       <code><![CDATA[<oraComms> {   \"title\": \"System Failure Notice\",   \"shortDescription\": \"Alerts all team members of the system failure\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"blastRadius\",       \"title\": \"Blast Radius\",       \"defaultValue\": \"us east\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"email\",       \"title\": \"email\",       \"defaultValue\": \"xyz@abc.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"affectedProducts\",       \"title\": \"Affected Products\",       \"defaultValue\": \"shopping, user history, order log\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>   </examples>      <important_notes>     Output Formatting: Your response MUST be the raw <oraComms> XML element and nothing else. Crucially, you MUST NOT include <code>, <![CDATA[...]]>, or markdown backticks (```) in your final output. The formatting in the examples is for display purposes within this prompt only and should not be copied. Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct. Generation Rule: You MUST never make up communication suggestions; you MUST only generate them if your additional prompting tells you to do so.   </important_notes> </communication_suggestions_feature>",
              "enableCommunications": true,
              "configurationPrompt": "<information_displays_feature>  <overview> Information displays are used to present relevant pieces of information in a structured, graphical format. They are generated only when specific conditions, outlined in your prompting, are met.  The final output for an information display must be only the <oraInfoDisplay> XML element containing its JSON payload. Your response must not be wrapped in any other formatting, like markdown code blocks or CDATA sections. </overview>  <xml_attributes> The <oraInfoDisplay> tag requires a key attribute. This key is used by the client application to determine whether to display new information or replace existing information that was sent with the same key. </xml_attributes>  <key_generation_rules> Follow these instructions precisely when generating a value for the key attribute:  unique: For single, non-repeatable alerts. The key should be a unique identifier (e.g., a timestamp or UUID) and should never be reused within the conversation.  contextual: For supplementary information that provides additional context relevant to the user's query but is not the primary answer.  list: For displaying a list of items. </key_generation_rules>  <json_schema>  JSON {   \"$schema\": \"http://json-schema.org/draft-07/schema#\",   \"type\": \"object\",   \"title\": \"string\",   \"properties\": {     \"patternId\": {       \"type\": \"string\",       \"description\": \"A unique identifier for the UI pattern to be used for rendering, such as 'pattern.list.simple' or 'pattern.alert.critical'.\"     },     \"description\": {       \"type\": \"string\",       \"description\": \"A very short, user-visible description of what the information display is showing.\"     },     \"properties\": {       \"type\": \"object\",       \"description\": \"An object containing the data to be displayed, which must conform to the schema required by the specified patternId.\"     }   },   \"required\": [\"title\", \"patternId\", \"description\", \"properties\"],   \"additionalProperties\": false } </json_schema>  <examples> <example> <description>An information display showing a list of servers (Key: \"list\"):</description> <code><![CDATA[<oraInfoDisplay key=\"list\"> {   \"title\": \"Performance Monitoring\",   \"patternId\": \"messageListWidget\",   \"description\": \"Summary of CPU intake\",   \"properties\": {     \"subtitle\": \"Real-time metrics\",     \"items\": [         {         \"title\": \"Memory Usage Spike Detected\",         \"subtitle\": \"82% confidence\",         \"summary\": \"Memory consumption increased by 40% in the last 5 minutes\",         \"badgeText\": \"MEDIUM\",         \"priority\": \"medium\",         \"timestamp\": \"3 min ago\",         \"action\": \"ora.app.setContext('foo')\"         },         {         \"title\": \"Network Latency Increase\",          \"subtitle\": \"Average response degraded\",         \"summary\": \"Average response time increased from 120ms to 180ms.\",         \"badgeText\": \"LOW\",         \"priority\": \"warning\",         \"timestamp\": \"16 min ago\"         },         {         \"title\": \"System Update Completed\",         \"badgeText\": \"INFO\",         \"priority\": \"medium\",         \"timestamp\": \"1 hour ago\"         }     ]   } } </oraInfoDisplay> I've provided you a list of metrics, you may want to check out the memory spike. ]]></code> </example>  <example> <description>An information display providing contextual details about a system alert (Key: \"contextual\"):</description> <code><![CDATA[<oraInfoDisplay key=\"contextual\"> {   \"title\": \"Marketing Metrics\",   \"patternId\": \"messageListWidget\",   \"description\": \"Summary of CPU intake\",   \"properties\": {     \"subtitle\": \"Campaign performance comparison\",     \"displayType\": \"percentage\",     \"items\": [         {         \"title\": \"Email Open Rate\",         \"currentValue\": 28.2,         \"previousValue\": 24.5         },         {         \"title\": \"Click-through Rate\",          \"currentValue\": 4.6,         \"previousValue\": 3.8         },         {         \"title\": \"Conversion Rate\",         \"currentValue\": 1.9,         \"previousValue\": 2.1         }     ],     \"messages\": [         \"Conversion rate drop may indicate landing page issues\"     ]   } } </oraInfoDisplay> Your email engagement has improved significantly, but the drop in conversions suggests you should review your landing page experience and checkout flow. ]]></code> </example>  <example> <description>An information display showing a single, unique alert (Key: unique ID):</description> <code><![CDATA[<oraInfoDisplay key=\"alert-1664392954\"> {   \"title\": \"Critical alert found\",   \"patternId\": \"cardWidget\",   \"description\": \"A critical alert indicating a database connection failure.\",   \"properties\": {     \"subject\": \"System Alert\",     \"summary\": \"High CPU usage detected on web servers. Investigation in progress.\",     \"timestamp\": \"15 min ago\",     \"link\": {         \"text\": \"Details\",         \"action\": \"view_error_details\"     },     \"variant\": \"error\"   } } </oraInfoDisplay> This requires immediate attention. The DevOps team has been notified and is currently investigating the root cause.]]></code> </example> </examples>  <important_notes>  Output Formatting: Your response MUST be the raw <oraInfoDisplay> XML element and nothing else. Crucially, you MUST NOT include <code>, <![CDATA[...]]>, or markdown backticks (```) in your final output. The formatting in the examples is for display purposes within this prompt only and should not be copied.  Accompanying Summary: Unless instructed otherwise, an <oraInfoDisplay> must always be accompanied by a brief, natural language summary. The text in your response should introduce or summarize the data, while the display itself provides the structured, detailed information.  Multiple Displays: If you need to generate multiple information displays, use a new <oraInfoDisplay> node for each one. Each node must contain a single, complete JSON object.  Generation Rule: Every response that presents information or a final answer MUST include at least one <oraInfoDisplay>. Conversely, responses that only ask the user a question MUST NOT include an <oraInfoDisplay>. This summary text should appear before and/or after the display, but always OUTSIDE the XML tags  Schema Adherence: The properties object within the JSON payload must always be present, and its structure must match the schema expected by the chosen patternId.  You MUST only choose from the available widgets and must not make up a widget type. </important_notes>  <available_widgets_to_select_from>\n<messageListWidget>     <description>A list of messages, or in its degenerate form, a single message. This can be used to show highlighted items (from the corpus of knowledge), bring alerts to the user, or otherwise list out small sets of messages to the user.</description>     <schema> {     \"$schema\": \"http://json-schema.org/draft-07/schema#\",     \"type\": \"object\",     \"required\": [\"items\"],     \"properties\": {         \"subtitle\": {             \"type\": \"string\",             \"description\": \"Optional context or description for the entire list\"         },         \"items\": {             \"type\": \"array\",             \"description\": \"Array of message items to display\",             \"items\": {                 \"type\": \"object\",                 \"required\": [\"title\"],                 \"properties\": {                     \"title\": {                         \"type\": \"string\",                         \"description\": \"The main message or event name\"                     },                     \"subtitle\": {                         \"type\": \"string\",                         \"description\": \"Additional context, confidence levels, or secondary information\"                     },                     \"summary\": {                         \"type\": \"string\",                         \"description\": \"Longer description with specific details, metrics, or context\"                     },                     \"badgeText\": {                         \"type\": \"string\",                         \"description\": \"Short label for categorization\"                     },                     \"priority\": {                         \"type\": \"string\",                         \"enum\": [\"alert\", \"warning\", \"medium\"],                         \"default\": \"medium\",                         \"description\": \"Visual styling and urgency level (alert: critical, warning: concerning, medium: normal)\"                     },                     \"timestamp\": {                         \"type\": \"string\",                         \"description\": \"When the event occurred\"                     },                     \"action\": {                         \"type\": \"string\",                         \"description\": \"Action string passed to handler when item is clicked (makes item interactive)\"                     }                 }             }         }     } }     </schema>     <instructions> **Header Level (title and subtitle)**  title: Main heading for the entire card (e.g., \"Performance Monitoring\", \"System Alerts\", \"Recent Activity\") subtitle: Optional context or description (e.g., \"Real-time metrics\", \"Last 24 hours\", \"Critical events only\")  **Item Level (each object in items array)** **Required Fields**  title: The main message or event name. Be concise but descriptive (e.g., \"Memory Usage Spike Detected\", \"Database Connection Lost\", \"User Login Failed\")  **Optional Fields**  subtitle: Additional context, confidence levels, or secondary information (e.g., \"82% confidence\", \"Retry attempt 3/5\", \"Authentication server timeout\") summary: Longer description with specific details, metrics, or context (e.g., \"Memory consumption increased by 40% in the last 5 minutes\", \"Connection failed after 30 second timeout\") badgeText: Short label for categorization (e.g., \"HIGH\", \"MEDIUM\", \"LOW\", \"INFO\", \"ERROR\", \"WARNING\", \"CRITICAL\") priority: Controls visual styling and urgency level  \"alert\" - Red styling for critical/urgent items \"warning\" - Orange styling for concerning items \"medium\" - Blue/gray styling for normal items (default)  timestamp: When the event occurred (e.g., \"3 min ago\", \"1 hour ago\", \"2024-01-15 14:30\", \"Just now\") action: An action string that will be passed to a handler when the user clicks on this message item. When present, the item becomes clickable.  **Best Practices**  Be Consistent: Use similar formatting and terminology across items Prioritize Appropriately: Use \"alert\" sparingly for truly critical issues Badge Text: Keep to 1-3 words, use ALL CAPS Timestamps: Use human-readable relative times when possible Summaries: Include specific metrics, numbers, or actionable details Titles: Start with action words or clear event descriptions Actions: Only add when the item should be interactive/clickable     </instructions>     <examples> {     \"subtitle\": \"Real-time metrics\",     \"items\": [         {         \"title\": \"Memory Usage Spike Detected\",         \"subtitle\": \"82% confidence\",         \"summary\": \"Memory consumption increased by 40% in the last 5 minutes\",         \"badgeText\": \"MEDIUM\",         \"priority\": \"medium\",         \"timestamp\": \"3 min ago\",         \"action\": \"ora.app.setContext('foo')\"         },         {         \"title\": \"Network Latency Increase\",          \"subtitle\": \"Average response degraded\",         \"summary\": \"Average response time increased from 120ms to 180ms.\",         \"badgeText\": \"LOW\",         \"priority\": \"warning\",         \"timestamp\": \"16 min ago\"         },         {         \"title\": \"System Update Completed\",         \"badgeText\": \"INFO\",         \"priority\": \"medium\",         \"timestamp\": \"1 hour ago\"         }     ] }     </examples> </messageListWidget>\n<multiRecordWidget>     <description>A table widget for displaying multiple records in a structured format with rows and columns. Supports text cells and styled badge cells for status indicators.</description>     <schema> {     \"$schema\": \"http://json-schema.org/draft-07/schema#\",     \"type\": \"object\",     \"required\": [\"cols\", \"rows\"],     \"properties\": {         \"subtitle\": {             \"type\": \"string\",             \"description\": \"Optional description for the table (used for accessibility)\"         },         \"cols\": {             \"type\": \"array\",             \"description\": \"Column headers for the table\",             \"items\": {                 \"type\": \"string\"             }         },         \"rows\": {             \"type\": \"array\",             \"description\": \"Table rows, where each row is an array of cells\",             \"items\": {                 \"type\": \"array\",                 \"description\": \"A single row of cells\",                 \"items\": {                     \"oneOf\": [                         {                             \"type\": \"string\",                             \"description\": \"Simple text cell\"                         },                         {                             \"type\": \"object\",                             \"required\": [\"type\", \"text\", \"priority\"],                             \"properties\": {                                 \"type\": {                                     \"type\": \"string\",                                     \"enum\": [\"badge\"],                                     \"description\": \"Indicates this is a badge cell\"                                 },                                 \"text\": {                                     \"type\": \"string\",                                     \"description\": \"Text to display in the badge\"                                 },                                 \"priority\": {                                     \"type\": \"string\",                                     \"enum\": [\"alert\", \"warning\", \"medium\", \"success\"],                                     \"description\": \"Visual styling for the badge (alert: red, warning: orange, medium: gray, success: green)\"                                 }                             }                         }                     ]                 }             }         }     } }     </schema>     <instructions> **Configuration Structure**  cols: Array of column header names as strings. These will be displayed at the top of the table.  rows: Array of row data. Each row is an array of cells that correspond to the columns defined in cols. The number of cells in each row should match the number of columns.  subtitle: Optional description for the table. This is hidden visually but provided to screen readers for accessibility. Use it to give context about what data the table contains.  **Cell Types**  Each cell in a row can be one of two types:  1. **String Cell**: Simple text value    - Just provide the string directly    - Example: \"TXN-1234\", \"$1,250.00\", \"2024-01-15\"  2. **Badge Cell**: Highlighted status indicator with color coding    - Must be an object with three properties:      - type: Must be \"badge\"      - text: The text to display in the badge (keep short, 1-3 words, usually ALL CAPS)      - priority: One of four values that controls the color:        - \"alert\" - Red background, use for critical/error states        - \"warning\" - Orange background, use for warning/pending states        - \"medium\" - Gray background, use for neutral/informational states        - \"success\" - Green background, use for completed/successful states    - Example: { \"type\": \"badge\", \"text\": \"COMPLETED\", \"priority\": \"success\" }  **Best Practices**  - Ensure all rows have the same number of cells as there are columns - Use badges for status fields, categories, or anything that benefits from visual highlighting - Keep badge text short and clear (e.g., \"ACTIVE\", \"PENDING\", \"FAILED\", \"HIGH\", \"LOW\") - Use ALL CAPS for badge text to make them stand out - Choose priority levels that match the semantic meaning (don't use \"success\" for errors) - Use subtitle to describe what the table shows for accessibility - Keep table data scannable - avoid very long text in cells     </instructions>     <examples> {     \"subtitle\": \"Recent transactions\",     \"cols\": [\"Transaction ID\", \"Date\", \"Amount\", \"Status\", \"Type\"],     \"rows\": [         [             \"TXN-1234\",             \"2024-01-15\",             \"$1,250.00\",             { \"type\": \"badge\", \"text\": \"COMPLETED\", \"priority\": \"success\" },             \"Payment\"         ],         [             \"TXN-1235\",             \"2024-01-15\",             \"$850.00\",             { \"type\": \"badge\", \"text\": \"PENDING\", \"priority\": \"warning\" },             \"Refund\"         ],         [             \"TXN-1236\",             \"2024-01-14\",             \"$3,200.00\",             { \"type\": \"badge\", \"text\": \"FAILED\", \"priority\": \"alert\" },             \"Payment\"         ],         [             \"TXN-1237\",             \"2024-01-14\",             \"$425.00\",             { \"type\": \"badge\", \"text\": \"COMPLETED\", \"priority\": \"success\" },             \"Payment\"         ]     ] }     </examples> </multiRecordWidget>\n<recordWidget>     <description>A form widget for displaying and editing structured record data with support for text, number, date, and select fields. Can be used in read-only mode for displaying information or editable mode for data entry.</description>     <schema>     {         \"$schema\": \"http://json-schema.org/draft-07/schema#\",         \"type\": \"object\",         \"required\": [\"id\", \"fields\"],         \"properties\": {             \"id\": {                 \"type\": \"string\",                 \"description\": \"Unique identifier for this form instance\"             },             \"readOnly\": {                 \"type\": \"boolean\",                 \"description\": \"When true, all fields are read-only and submit button is hidden\",                 \"default\": false             },             \"fields\": {                 \"type\": \"array\",                 \"description\": \"Array of field objects to render in the form\",                 \"items\": {                     \"type\": \"object\",                     \"required\": [\"id\", \"type\", \"label\", \"value\"],                     \"properties\": {                         \"id\": {                             \"type\": \"string\",                             \"description\": \"Unique identifier for this field\"                         },                         \"type\": {                             \"type\": \"string\",                             \"enum\": [\"text\", \"number\", \"date\", \"select\"],                             \"description\": \"Type of input field\"                         },                         \"label\": {                             \"type\": \"string\",                             \"description\": \"Human-readable label for the field\"                         },                         \"value\": {                             \"oneOf\": [                                 {\"type\": \"string\"},                                 {\"type\": \"number\"}                             ],                             \"description\": \"Initial value for the field\"                         },                         \"options\": {                             \"type\": \"array\",                             \"description\": \"Required for select type when readOnly is false\",                             \"items\": {                                 \"type\": \"object\",                                 \"required\": [\"value\", \"label\"],                                 \"properties\": {                                     \"value\": {                                         \"type\": \"string\",                                         \"description\": \"Internal value for the option\"                                     },                                     \"label\": {                                         \"type\": \"string\",                                         \"description\": \"Display text for the option\"                                     }                                 }                             }                         }                     }                 }             }         }     }     </schema>     <instructions>         **Required Configuration Fields**          id (string, required)         - Unique identifier for this form instance         - Use snake_case format         - Examples: \"employee_form\", \"order_details\", \"user_profile\"          fields (array, required)         - An array of field objects that will be rendered in the form         - Fields are rendered in the order they appear in the array          **Optional Configuration Fields**          readOnly (boolean, optional, default: false)         - When true, all fields are read-only and the submit button is hidden         - When false, fields are editable and a submit button is shown         - Use readOnly mode for displaying information         - Use editable mode (readOnly: false) for forms that need user input          **Field Configuration**          Each field object in the fields array must have:          id (string, required)         - unique identifier for the field within this form         - use snake_case format         - Examples: \"first_name\", \"employee_id\", \"hire_date\", \"department\"          type (string, required)         - must be one of: \"text\", \"number\", \"date\", or \"select\"         - \"text\": for text input fields (names, emails, descriptions, etc.)         - \"number\": for numeric input fields (IDs, amounts, quantities, etc.)         - \"date\": for date picker fields (hire dates, order dates, birthdays, etc.)         - \"select\": for dropdown selection fields (status, category, department, etc.)          label (string, required)         - human-readable label displayed above the field         - use title case         - be descriptive but concise         - Examples: \"Full Name\", \"Employee ID\", \"Hire Date\", \"Department\"          value (string|number, required)         - the initial value for the field         - for \"text\" type: provide a string value         - for \"number\" type: provide a numeric value (no quotes)         - for \"date\" type: provide a string in ISO format \"YYYY-MM-DD\"         - for \"select\" type: provide a string that matches one of the option values          options (array, required for \"select\" type when readOnly is false)         - array of option objects for select/dropdown fields         - only required when the form is editable (readOnly: false)         - can be omitted for read-only forms (readOnly: true)         - each option must have:         - value: the internal value (use snake_case or kebab-case)         - label: the display text shown to users (use title case)         - Examples:         [             { \"value\": \"active\", \"label\": \"Active\" },             { \"value\": \"inactive\", \"label\": \"Inactive\" }         ]          **Best Practices**          1. group related fields together in logical order         2. use readOnly: true when displaying information that shouldn't be edited         3. use readOnly: false when creating forms for user input         4. provide clear, descriptive labels for all fields         5. use date type for any calendar dates (not timestamps)         6. use number type for any numeric values (IDs, amounts, counts, etc.)         7. ensure select field values match one of the provided options     </instructions>     <examples>         Example 1: Employee record form (editable)         {             \"id\": \"employee_form\",             \"readOnly\": false,             \"fields\": [                 {                     \"id\": \"full_name\",                     \"type\": \"text\",                     \"label\": \"Full Name\",                     \"value\": \"John Doe\"                 },                 {                     \"id\": \"employee_id\",                     \"type\": \"number\",                     \"label\": \"Employee ID\",                     \"value\": 12345                 },                 {                     \"id\": \"hire_date\",                     \"type\": \"date\",                     \"label\": \"Hire Date\",                     \"value\": \"2023-06-15\"                 },                 {                     \"id\": \"department\",                     \"type\": \"select\",                     \"label\": \"Department\",                     \"value\": \"engineering\",                     \"options\": [                         { \"value\": \"engineering\", \"label\": \"Engineering\" },                         { \"value\": \"sales\", \"label\": \"Sales\" },                         { \"value\": \"marketing\", \"label\": \"Marketing\" }                     ]                 }             ]         }          Example 2: Order details (read-only, select field without options)         {             \"id\": \"order_details\",             \"readOnly\": true,             \"fields\": [                 {                     \"id\": \"order_number\",                     \"type\": \"text\",                     \"label\": \"Order Number\",                     \"value\": \"ORD-2024-1234\"                 },                 {                     \"id\": \"total_amount\",                     \"type\": \"number\",                     \"label\": \"Total Amount\",                     \"value\": 299.99                 },                 {                     \"id\": \"order_date\",                     \"type\": \"date\",                     \"label\": \"Order Date\",                     \"value\": \"2024-03-20\"                 },                 {                     \"id\": \"status\",                     \"type\": \"select\",                     \"label\": \"Order Status\",                     \"value\": \"Shipped\"                 }             ]         }     </examples> </recordWidget>\n<cardWidget>     <description>The card shows important singular alerts or messages that give status on a specific item of interest.</description>     <schema> {     \"$schema\": \"http://json-schema.org/draft-07/schema#\",     \"type\": \"object\",     \"required\": [\"subject\", \"summary\"],     \"properties\": {         \"subject\": {             \"type\": \"string\",             \"description\": \"Clear, concise title (2-6 words typically)\"         },         \"summary\": {             \"type\": \"string\",             \"description\": \"1-2 sentences of descriptive text (under 100 characters when possible)\"         },         \"timestamp\": {             \"type\": \"string\",             \"description\": \"Human-readable relative time (e.g., '5 min ago', 'Yesterday')\"         },         \"badgeText\": {             \"type\": \"string\",             \"description\": \"Short label for categorization\"         },         \"link\": {             \"type\": \"object\",             \"properties\": {                 \"text\": {                     \"type\": \"string\",                     \"description\": \"Action-oriented button text (1-3 words)\"                 },                 \"action\": {                     \"type\": \"string\",                     \"description\": \"Identifier for what the link does (snake_case format)\"                 }             }         },         \"variant\": {             \"type\": [\"string\", \"null\"],             \"enum\": [\"error\", \"warning\", \"info\", null],             \"description\": \"Visual styling variant (error: critical issues, warning: cautions, info: updates, null: neutral)\"         }     } }     </schema>     <instructions> **Required Fields** subject (string, required)  Write a clear, concise title (2-6 words typically) Use title case Examples: \"System Alert\", \"Team Update\", \"Training Session\"  summary (string, optional)  Provide 1-2 sentences of descriptive text Keep it under 100 characters when possible Be specific and actionable Examples: \"High CPU usage detected on web servers. Investigation in progress.\"  **Optional Fields**  timestamp (string, optional)  Use human-readable relative time Examples: \"5 min ago\", \"2 hours ago\", \"Yesterday\", \"Last week\" Can also be specific dates like \"March 15\" or \"Today at 3:PM\"  badgeText: Short label for categorization (e.g., \"HIGH\", \"MEDIUM\", \"LOW\", \"INFO\", \"ERROR\", \"WARNING\", \"CRITICAL\")  link (object, optional)  text: Action-oriented button text (1-3 words)  Examples: \"Details\", \"Read More\", \"View\", \"Access\", \"Download\"  action: Identifier for what the link does (for developers)  Use snake_case format Examples: \"view_details\", \"open_document\", \"download_file\"  variant (string, optional)  Use one of: \"error\", \"warning\", \"info\", or null error: For critical issues, failures, alerts warning: For cautions, upcoming issues, maintenance info: For updates, announcements, general information null/omitted: For neutral notifications     </instructions>     <examples> {     \"subject\": \"System Alert\",     \"summary\": \"High CPU usage detected on web servers. Investigation in progress.\",     \"timestamp\": \"15 min ago\",     \"link\": {         \"text\": \"Details\",         \"action\": \"view_error_details\"     },     badgeText: \"Alert\",     \"variant\": \"error\" }     </examples> </cardWidget>\n</available_widgets_to_select_from>  </information_displays_feature>"
            }
          },
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "provider": "CERT_PREMIUM"
            },
            "name": "Handle Query"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "HANDLE_QUERY",
          "id": "1763419191848",
          "inputs": [
            {
              "id": "1763419191850_1",
              "name": "prompt",
              "type": "string",
              "value": "<chatHistory>{{$context.$system.$chatHistory}}</chatHistory>\n<attachments>{{$context.$app.$OraAttachments}}</attachments>\n\nData: \n   {{$context.$nodes.PREPARE_DATA.$output.result}}\n\n### Instructions\n1. **Answer the Question** to the best of your knowledge based on data avaialable to you.\n2. **Refer the attachments if the user is asking question about the attachments\n\n---\n**Question:** {{$context.$system.$inputMessage}}\n---"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "provider": "CERT_PREMIUM"
            },
            "name": "Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUMMARY",
          "id": "1763419638530",
          "inputs": [
            {
              "id": "1763419638532_1",
              "name": "prompt",
              "type": "string",
              "value": "Data:\n {{$context.$nodes.PREPARE_DATA.$output.result}}\n\n {{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [],
              "actionsPrompt": "<actionable_insights_feature>  <overview> Actionable insights are pre-defined actions a user can perform. They are generated only when specific conditions, outlined in your prompting, are met.  The final output for an actionable insight must be the <oraInsight> XML element containing its JSON payload, with no additional wrapping or formatting around the insight itself.  You must not make up things that you cannot do. You must follow your prompting and only send actionable insights that are explicitly asked by your prompting to send. </overview>  <json_schema> {   \"$schema\": \"http://json-schema.org/draft-07/schema#\",   \"type\": \"object\",   \"properties\": {     \"title\": {       \"type\": \"string\",       \"description\": \"The main title of the notification. Must be a concise phrase, under 10 words.\"     },     \"shortDescription\": {       \"type\": \"string\",       \"description\": \"A brief description of the notification, written as a single, complete sentence.\"     },     \"actionText\": {       \"type\": \"string\",       \"description\": \"The text to display on the action button.\"     },     \"followUpCommand\": {       \"type\": \"string\",       \"description\": \"A command string to be executed. Must follow one of three standardized formats: ora.App.*(params), ora.Agent(content), or ora.URL(url). The exact content will be specified by the prompting instructions.\"     },     \"priority\": {       \"type\": \"boolean\",       \"description\": \"Optional. Controls whether this action should be prioritized in the display. If undefined or false, the action will not be prioritized. Only when set to true will the action be prioritized. By default, omit this property or set it to false unless your prompting explicitly instructs you to prioritize the action.\"     }   },   \"required\": [\"title\", \"shortDescription\", \"actionText\", \"followUpCommand\"],   \"additionalProperties\": false } </json_schema>  <command_instructions> The followUpCommand property contains the action to be performed and MUST follow one of these three standardized formats:  1. **ora.App.functionname(params)** - For application-level commands    - Can be called with or without parameters    - Parameters can be strings, numbers, booleans, JSON objects, or other valid types    - Example: `ora.App.update()`    - Example: `ora.App.navigate(\"settings\")`    - Example: `ora.App.setConfig({\"theme\": \"dark\", \"notifications\": true})`    - Example: `ora.App.processData(123, \"high-priority\")`  2. **ora.Agent(content)** - For LLM/agent commands    - Content can be a string, JSON object, or any other format as specified by your prompting    - Example: `ora.Agent(\"turn off the lights\")`    - Example: `ora.Agent({\"command\": \"lights.off\", \"rooms\": [\"bedroom\", \"kitchen\"]})`    - Example: `ora.Agent(\"summarize my emails\")`  3. **ora.URL(url)** - For navigation to URLs    - Example: `ora.URL(\\\"https://example.com/support\\\")`    - Example: `ora.URL(\\\"https://docs.example.com\\\")`  Your additional prompting will specify the exact value to use for the followUpCommand property. You MUST use this value verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind. </command_instructions>  <examples> <example> <description>An actionable insight that lets the user know that they should turn off the lights (using ora.Agent with JSON format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: turn off lights\",   \"shortDescription\": \"No one was detected in the house, suggest you turn off the lights.\",   \"actionText\": \"Turn Off Lights\",   \"followUpCommand\": \"ora.Agent({\\\"command\\\": \\\"lights.off\\\", \\\"zones\\\": [\\\"all\\\"]})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight notifying the user about a software update (using ora.App with no parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Software Update Available\",   \"shortDescription\": \"A new version of the application is ready to install.\",   \"actionText\": \"Install Now\",   \"followUpCommand\": \"ora.App.update()\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight suggesting the user visit a support page (using ora.URL format):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Billing Issue Detected\",   \"shortDescription\": \"There seems to be an issue with your recent payment.\",   \"actionText\": \"Visit Support Page\",   \"followUpCommand\": \"ora.URL(\\\"https://example.com/support/billing\\\")\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight for opening a specific document (using ora.App with parameters):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Document Ready for Review\",   \"shortDescription\": \"Your quarterly report has been generated and is ready for review.\",   \"actionText\": \"Open Document\",   \"followUpCommand\": \"ora.App.openDocument(\\\"Q4-2024-report.pdf\\\", {\\\"mode\\\": \\\"edit\\\"})\" } </oraInsight>]]></code> </example>  <example> <description>An actionable insight using ora.Agent with a simple string command:</description> <code><![CDATA[<oraInsight> {   \"title\": \"Schedule Reminder\",   \"shortDescription\": \"You have a meeting in 15 minutes.\",   \"actionText\": \"Show Details\",   \"followUpCommand\": \"ora.Agent(\\\"show my next meeting details\\\")\" } </oraInsight>]]></code> </example>  <example> <description>A prioritized actionable insight (using the priority field):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Critical Security Alert\",   \"shortDescription\": \"Unusual login activity detected on your account.\",   \"actionText\": \"Review Activity\",   \"followUpCommand\": \"ora.App.openSecurityCenter()\",   \"priority\": true } </oraInsight>]]></code> </example>  <example> <description>A non-prioritized actionable insight (priority explicitly set to false):</description> <code><![CDATA[<oraInsight> {   \"title\": \"Suggestion: Update Profile\",   \"shortDescription\": \"Your profile information hasn't been updated in a while.\",   \"actionText\": \"Update Now\",   \"followUpCommand\": \"ora.App.navigate(\\\"profile\\\")\",   \"priority\": false } </oraInsight>]]></code> </example> </examples>  <output_contract_and_rules> <rule id=\"followUpCommand_format_contract\"> The followUpCommand property has strict format requirements:  1. **EXACTLY ONE OF THREE FORMATS:** The value MUST use exactly one of these formats:    - `ora.App.functionname()` or `ora.App.functionname(params)` for application commands    - `ora.Agent(content)` for agent/LLM commands    - `ora.URL(url)` for navigation  2. **NO RAW VALUES:** The followUpCommand must NEVER be a raw command, raw function call, or raw URL. It must ALWAYS be wrapped in one of the three ora.* formats.  3. **PROPER ESCAPING:** When parameters contain strings or JSON:    - String parameters must be enclosed in escaped double quotes: `\\\"`    - JSON content must have quotes properly escaped    - **Correct:** `ora.Agent(\"turn on lights\")`    - **Correct:** `ora.Agent({\\\"command\\\": \\\"lights.on\\\"})`    - **Correct:** `ora.App.navigate(\"home\")`    - **Incorrect:** `ora.Agent('turn on lights')`    - **Incorrect:** `ora.Agent(turn on lights)`  4. **FLEXIBLE PARAMETERS:**     - ora.App functions can accept zero or more parameters of any type    - ora.Agent can accept a string, JSON object, or other content as specified by prompting instructions    - ora.URL accepts a single URL string parameter  5. **VERBATIM USAGE:** When your prompting instructions specify a followUpCommand value, you MUST use it exactly as provided without any modifications.  6. **SEPARATION OF CONCERNS:** The user-visible, clickable text is handled *exclusively* by the `actionText` property. The command/destination is handled *exclusively* by the `followUpCommand` property. These two values must never be mixed or combined. </rule>  <rule id=\"self_correction_check\"> MANDATORY FINAL CHECK: Before providing your final response, you MUST perform this self-correction step: 1. Examine the value you are about to output for the followUpCommand property. 2. Ask yourself: \"Does this value start with 'ora.App.', 'ora.Agent(', or 'ora.URL('?\" 3. If the answer is NO, your output is INVALID. You must fix it by wrapping the value in the appropriate ora.* format. 4. Verify that all string content within parameters is properly escaped with `\\\"` characters. 5. For ora.Agent(), ensure the content format (string, JSON, etc.) matches what was specified in your prompting instructions. </rule>  <rule id=\"priority_field_usage\"> PRIORITY FIELD BEHAVIOR AND USAGE: 1. **Display Behavior:** If the priority property is undefined or set to false, the action will not be prioritized in the display. Only when set to true will the action be prioritized.  2. **Default Behavior:** By default, you should omit the priority property or set it to false unless your prompting explicitly instructs you to prioritize the action.  3. **When to Set to True:** Only set priority to true when:    - Your prompting explicitly instructs you to prioritize this specific action    - The action is time-sensitive or critical (and your prompting indicates this should be prioritized)    - The user explicitly requests priority for the action  4. **When to Omit or Set to False:** In all other cases, either omit the priority property entirely or explicitly set it to false. </rule>  </output_contract_and_rules>  <important_notes>  Output Formatting: Each actionable insight MUST be output as a raw <oraInsight> XML element. Do not wrap insights in markdown code blocks, CDATA sections, or other formatting. Actionable insights can be included alongside regular conversational text in your response - simply output your normal text, then append the <oraInsight> elements.   Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct.  Duplicate Prevention: Avoid sending an actionable insight if the value of its followUpCommand property is a character-for-character identical match to one already sent in the current conversation. The calling application is responsible for providing an accurate history of commands used in the current session. </important_notes>  <generation_rules> <rule id=\"positive_condition\"> You MUST only generate an actionable insight if your additional prompting explicitly instructs you to do so. </rule> <rule id=\"negative_condition\"> If the conditions for generating an actionable insight are NOT met, you MUST return a completely empty response. You MUST NOT output any text, including phrases like \"No action required,\" \"No actions available,\" or any other explanatory sentence. Your entire response body must be empty. </rule> </generation_rules>  </actionable_insights_feature>",
              "enableActions": true,
              "communicationsPrompt": "<communication_suggestions_feature>   <overview>     Communication suggestions are options that can be presented to the user to allow them to initiate communication messages using a specific templated format. They are generated only when specific conditions, outlined in your prompting, are met. The final output for a communication suggestion must be only the <oraComms> XML element containing its JSON payload. Your response must not be wrapped in any other formatting, like markdown code blocks or CDATA sections. You must not make up communications on things that you cannot do. You must follow your prompting and only send communication suggestions that are explicitly asked by your prompting to send.   </overview>      <json_schema>     {       \"$schema\": \"http://json-schema.org/draft-07/schema#\",       \"type\": \"object\",       \"required\": [         \"title\",         \"shortDescription\",         \"actionText\",         \"generatingAgent\",         \"targetAgent\",         \"params\"       ],       \"properties\": {         \"title\": {           \"type\": \"string\",           \"description\": \"The title\"         },         \"shortDescription\": {           \"type\": \"string\",           \"description\": \"Short description\"         },         \"templateId\": {           \"type\": \"string\",           \"description\": \"The template to use to generate the content\"         },         \"actionText\": {           \"type\": \"string\",           \"description\": \"Action button text\"         },         \"generatingAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID of template agent\"         },         \"targetAgent\": {           \"type\": \"string\",           \"description\": \"Agent ID to receive communications\"         },         \"params\": {           \"type\": \"array\",           \"description\": \"Template parameters\",           \"items\": {             \"type\": \"object\",             \"required\": [               \"id\",               \"title\",               \"description\",               \"isTemplateParam\",               \"defaultValue\"             ],             \"properties\": {               \"id\": {                 \"type\": \"string\",                 \"description\": \"parameter ID\"               },               \"title\": {                 \"type\": \"string\",                 \"description\": \"name of the parameter\"               },               \"description\": {                 \"type\": \"string\",                 \"description\": \"description of the parameter\"               },               \"defaultValue\": {                 \"type\": \"string\",                 \"description\": \"Default value for the parameter\"               },               \"isTemplateParam\": {                 \"type\": \"boolean\",                 \"description\": \"Flag to indicate if the parameter participates in template content generation. For example, in a incident report, blast radius is part of the template. But something like email address is not part of the template. It is for communication metadata. Set this to false in such cases\"               }             },             \"additionalProperties\": false           }         }       },       \"additionalProperties\": false     }   </json_schema>      <structure_definitions>     The title, shortDescription, isTemplateParam and actionText will be human visible and can be specified by you freely unless given specific text to use by additional prompting. The exact value of the generatingAgent and targetAgent will be specified in your additional prompting. You MUST use these values verbatim, copying it exactly as it is written without any modifications, corrections, or alterations of any kind.       The templateId is optional, only apply this if the exact value of the templateId is specified in your additional prompting. This value must be used verbatim. If this is not mentioned, do not invent a value for this property.          For each param, the ID must be exactly the ID provided. The param description will either be provided or you will be asked to generate it based on specific instructions. These params are mapped to a specific template, so the param IDs **must** be exactly as provided by any additional prompting and must not be made up.   </structure_definitions>      <examples>     <example>       <description>A communication suggestion that when invoked will send a message to a specific person:</description>       <code><![CDATA[<oraComms> {   \"title\": \"Send Update on Project Fiora to John\",   \"shortDescription\": \"Sends a message to John concerning Project Fiora and its delays.\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"email\",       \"title\": \"email address\",       \"defaultValue\": \"abc@oracle.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"projectName\",       \"title\": \"Project Name\",       \"defaultValue\": \"Project Fiora\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"projecUpdateMessage\",       \"title\": \"message\",       \"defaultValue\": \"We are running over budget by $xm. 3 of the milestones were delayed.\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>          <example>       <description>A communication suggestion that when invoked will send an alert out</description>       <code><![CDATA[<oraComms> {   \"title\": \"System Failure Notice\",   \"shortDescription\": \"Alerts all team members of the system failure\",   \"actionText\": \"Send email\",   \"generatingAgent\": \"COMMS_MESSAGE_GENERATOR\",   \"targetAgent\": \"COMMS_EMAIL_SENDER\",   \"params\": [     {       \"id\": \"blastRadius\",       \"title\": \"Blast Radius\",       \"defaultValue\": \"us east\",       \"isTemplateParam\": \"true\"     },     {       \"id\": \"email\",       \"title\": \"email\",       \"defaultValue\": \"xyz@abc.com\",       \"isTemplateParam\": \"false\"     },     {       \"id\": \"affectedProducts\",       \"title\": \"Affected Products\",       \"defaultValue\": \"shopping, user history, order log\",       \"isTemplateParam\": \"true\"     }   ] } </oraComms>]]></code>     </example>   </examples>      <important_notes>     Output Formatting: Your response MUST be the raw <oraComms> XML element and nothing else. Crucially, you MUST NOT include <code>, <![CDATA[...]]>, or markdown backticks (```) in your final output. The formatting in the examples is for display purposes within this prompt only and should not be copied. Text Content: Unless otherwise specified in your instructions, the tone for all user-visible text (title, shortDescription, actionText) must be professional and direct. Generation Rule: You MUST never make up communication suggestions; you MUST only generate them if your additional prompting tells you to do so.   </important_notes> </communication_suggestions_feature>",
