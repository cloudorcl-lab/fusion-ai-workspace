          "metadata": {
            "name": "Prepare Data",
            "returnType": "string",
            "sourceCode": "const data = `You have the following knowledge to answer questions. Any actionable insights must always be sent at high priority.\n\n<advisor id=\"CHARLIE_DEALS_ADVISOR\">\n\n    <description>\n        Provides a comprehensive overview of the customer lifecycle, from pre-sale deals to post-sale health. It can advise on deal status, timelines, and blockers. It also tracks customer health indicators such as upcoming renewals, open service requests, open and closed JIRAs, outstanding bugs, and deployment gaps for \n        purchased modules.\n    </description>\n\n    <knowledge>\n\n        <!-- \n            Section 1: Deals in Flight & Recently Closed\n            This section covers active sales cycles and deals closed in the last quarter.\n        -->\n        <deals_in_flight>\n            <deal customer=\"Axios Solutions\">\n                <status>Closed-Won</status>\n                <stage>Implementation Complete</stage>\n                <progress_percent>100</progress_percent>\n                <timeline>\n                    <start_date>2025-02-10</start_date>\n                    <close_date>2025-05-20</close_date>\n                    <go_live_date>2025-06-15</go_live_date>\n                </timeline>\n                <value tcv_usd=\"750000\" arr_usd=\"250000\" />\n                <notes>\n                    Initial deployment was smooth. Customer is fully ramped and seeing value. Awaiting feedback on Q3 product roadmap.\n                </notes>\n            </deal>\n\n            <deal customer=\"Delta Innovations\">\n                <status>On Hold</status>\n                <stage>Implementation</stage>\n                <progress_percent>12</progress_percent>\n                <blocker type=\"Technical\" reference=\"JIRA-22322\">\n                    Cannot setup install scripts for on-premise Kubernetes cluster.\n                </blocker>\n                <timeline>\n                    <start_date>2025-07-01</start_date>\n                    <projected_close_date>2025-08-15</projected_close_date>\n                    <projected_go_live>2025-10-01</projected_go_live>\n                </timeline>\n                <value tcv_usd=\"1200000\" arr_usd=\"400000\" />\n                <notes>\n                    Deal is signed, but implementation is stalled. Engineering team is engaged on the blocker. High risk to project timeline. Escalation notice sent to VP of Customer Success.\n                </notes>\n            </deal>\n\n            <deal customer=\"Polygon Corp\">\n                <status>Active</status>\n                <stage>Technical Validation</stage>\n                <progress_percent>45</progress_percent>\n                <blocker type=\"Sales\">\n                    Awaiting legal review of MSA from customer's side. CIO is our champion but legal team is backlogged.\n                </blocker>\n                <timeline>\n                    <start_date>2025-08-05</start_date>\n                    <projected_close_date>2025-10-30</projected_close_date>\n                </timeline>\n                <value tcv_usd=\"900000\" arr_usd=\"300000\" />\n                <notes>\n                    Proof of Concept (POC) was highly successful, meeting 110% of success criteria. Main risk is deal velocity due to customer-side delays.\n                </notes>\n            </deal>\n        </deals_in_flight>\n\n\n        <!-- \n            Section 2: Upcoming Renewals\n            This section lists all customers with renewal dates in the next 180 days.\n        -->\n        <upcoming_renewals>\n            <renewal customer=\"Zenith Enterprises\">\n                <renewal_date>2025-11-15</renewal_date>\n                <renewal_value_arr_usd>500000</renewal_value_arr_usd>\n                <health_score status=\"Red\">22/100</health_score>\n                <risks>\n                    <risk priority=\"High\">Customer has 3 open Sev-2 service requests aging over 60 days.</risk>\n                    <risk priority=\"High\">Low adoption of the 'AI Analytics' module, which constitutes 40% of the ARR.</risk>\n                    <risk priority=\"Medium\">Original economic buyer and champion left the company 4 months ago.</risk>\n                </risks>\n                <mitigation_plan>\n                    Executive business review scheduled for 2025-09-30. Proposing a professional services credit to drive adoption of the AI module. Engineering has committed to resolving open SRs by end of September.\n                </mitigation_plan>\n            </renewal>\n\n            <renewal customer=\"Axios Solutions\">\n                <renewal_date>2025-12-01</renewal_date>\n                <renewal_value_arr_usd>250000</renewal_value_arr_usd>\n                <health_score status=\"Green\">95/100</health_score>\n                <risks>\n                    <risk priority=\"Low\">Customer has expressed interest in a competitor's new feature set. Marketing to provide battle-cards.</risk>\n                </risks>\n                <mitigation_plan>\n                    Account Manager is building the business case for a multi-year renewal with an uplift. Scheduled a roadmap session for 2025-10-15.\n                </mitigation_plan>\n            </renewal>\n        </upcoming_renewals>\n\n\n        <!-- \n            Section 3: Detailed Customer Health\n            This section provides a snapshot of post-sale activity and status for key customers.\n        -->\n        <customer_health>\n            <customer name=\"Axios Solutions\">\n                <service_requests>\n                    <request id=\"SR-789542\" status=\"Closed\" severity=\"3\" opened=\"2025-08-10\" resolved=\"2025-08-12\">\n                        UI glitch in reporting dashboard date filter.\n                    </request>\n                    <request id=\"SR-789110\" status=\"Closed\" severity=\"4\" opened=\"2025-07-22\" resolved=\"2025-07-22\">\n                        How to export user list via API.\n                    </request>\n                </service_requests>\n                <bugs />\n                <deployment_gaps>\n                    <module name=\"All Purchased Modules\">\n                        <status>Fully Deployed</status>\n                    </module>\n                </deployment_gaps>\n            </customer>\n\n            <customer name=\"Delta Innovations\">\n                <service_requests>\n                    <request id=\"SR-801233\" status=\"Open\" severity=\"1\" opened=\"2025-09-02\">\n                        Production installation failure. Work stoppage. Linked to JIRA-22322.\n                    </request>\n                    <request id=\"SR-799870\" status=\"Closed\" severity=\"2\" opened=\"2025-08-20\" resolved=\"2025-08-25\">\n                        SSO Integration issue with Okta.\n                    </request>\n                </service_requests>\n                <bugs>\n                    <bug id=\"JIRA-22322\" status=\"In Progress\" priority=\"Highest\" reported=\"2025-09-02\">\n                        Install scripts fail on customer's custom Kubernetes distribution due to deprecated API call.\n                    </bug>\n                </bugs>\n                <deployment_gaps>\n                    <module name=\"Core Platform\">\n                        <status>Purchased, Not Deployed</status>\n                        <reason>Blocked by installation failure (JIRA-22322).</reason>\n                        <age_days>74</age_days>\n                    </module>\n                    <module name=\"Advanced Security Module\">\n                        <status>Purchased, Not Deployed</status>\n                        <reason>Dependent on Core Platform deployment.</reason>\n                        <age_days>74</age_days>\n                    </module>\n                </deployment_gaps>\n            </customer>\n\n            <customer name=\"Zenith Enterprises\">\n                <service_requests>\n                    <request id=\"SR-791114\" status=\"Open\" severity=\"2\" opened=\"2025-07-05\">\n                        Data ingestion pipeline is stalling on files larger than 1GB.\n                    </request>\n                    <request id=\"SR-785331\" status=\"Open\" severity=\"2\" opened=\"2025-06-18\">\n                        Performance degradation in AI Analytics dashboard when querying more than 90 days of data.\n                    </request>\n                    <request id=\"SR-785299\" status=\"Open\" severity=\"3\" opened=\"2025-06-17\">\n                        User permissions not propagating correctly from Active Directory groups.\n                    </request>\n                </service_requests>\n                <bugs>\n                    <bug id=\"JIRA-21887\" status=\"In Backlog\" priority=\"Medium\" reported=\"2025-07-05\">\n                        Root cause of data ingestion stall (SR-791114) identified as memory leak in parsing library.\n                    </bug>\n                </bugs>\n                <deployment_gaps>\n                    <module name=\"AI Analytics Suite\">\n                        <status>Deployed, Low Adoption</status>\n                        <reason>Customer reports performance issues (SR-785331) and unclear value proposition. Requires training and professional services intervention.</reason>\n                        <age_days>350</age_days>\n                    </module>\n                </deployment_gaps>\n            </customer>\n\n            <customer name=\"Quantum Dynamics\">\n                <service_requests>\n                     <request id=\"SR-800500\" status=\"Closed\" severity=\"4\" opened=\"2025-08-28\" resolved=\"2025-08-28\">\n                        Documentation clarification for webhook authentication.\n                    </request>\n                </service_requests>\n                <bugs />\n                <deployment_gaps>\n                    <module name=\"All Purchased Modules\">\n                        <status>Fully Deployed</status>\n                    </module>\n                </deployment_gaps>\n            </customer>\n\n        </customer_health>\n\n    </knowledge>\n\n\n</advisor>`;\n\nreturn data;"
          },
          "outcomes": {
            "success": "1763418921466"
          },
          "code": "PREPARE_DATA",
          "id": "1763418883455",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SWITCH"
          },
          "outcomes": {
            "Query": "1763419191848",
            "InitDisplay": "1763418995660",
            "Summary": "1763419638530",
            "InitActions": "1763421296833",
            "FillParameters": "1763423309380",
            "AdditionalContent": "1765313611892",
            "InitCommunications": "1765321741327",
            "SendCommunication": "1765326019745"
          },
          "code": "SWITCH",
          "convergenceTargetId": "end",
          "id": "1763418921466",
          "inputs": [
            {
              "id": "1763418921468_1",
              "name": "caseExpression",
