{
  "workflowId": "300000330413671",
  "workflowCode": "CHARLIE_DEALS_ADVISOR",
  "name": "CHARLIE: Deals Advisor",
  "description": "Provides a comprehensive overview of the customer lifecycle, from pre-sale deals to post-sale health. It can advise on deal status, timelines, and blockers. It also tracks customer health indicators such as upcoming renewals, open service requests, open and closed JIRAs, outstanding bugs, and deployment gaps for purchased modules.",
