        {
          "metadata": {
            "name": "Retrieve Product Name and Code",
            "returnType": "object",
            "sourceCode": "const appInput = $context.$triggers.REST.$input.OraAppContext;\n\nlet result = { targetProductId: \"\", targetProductName: \"\", programType: \"\" };\ntry {\n  let appContextRaw = appInput;\n  let appContextStr = \"\";\n  const appContextMatch = appContextRaw.match(/appContext=([^\\s]+)/);\n  if (appContextMatch) {\n    appContextStr = decodeURIComponent(appContextMatch[1]);\n  } else {\n    appContextStr = appContextRaw;\n  }\n  if ((appContextStr.startsWith('\"') && appContextStr.endsWith('\"')) || (appContextStr.startsWith(\"'\") && appContextStr.endsWith(\"'\"))) {\n    appContextStr = appContextStr.slice(1, -1);\n  }\n  let targetProductId = \"\";\n  let targetProductName = \"\";\n  let programType = \"\";\n  if (appContextStr.startsWith('{') && appContextStr.endsWith('}')) {\n    try {\n      const obj = JSON.parse(appContextStr);\n      targetProductId = obj.targetProductId || \"\";\n      targetProductName = obj.targetProductName || \"\";\n      programType = obj.programType || \"\";\n    } catch (jsonError) {\n      const pairs = appContextStr.slice(1, -1).split(',');\n      pairs.forEach(pair => {\n        const [key, value] = pair.split(':').map(s => s.trim());\n        if (key === 'targetProductId') targetProductId = value || \"\";\n        else if (key === 'targetProductName') targetProductName = value || \"\";\n        else if (key === 'programType') programType = value || \"\";\n      });\n    }\n  } else {\n    const pairs = appContextStr.split(',');\n    pairs.forEach(pair => {\n      let key = \"\";\n      let value = \"\";\n      if (pair.includes('=')) {\n        [key, value] = pair.split('=').map(s => s.trim());\n      } else if (pair.includes(':')) {\n        [key, value] = pair.split(':').map(s => s.trim());\n      }\n      if (key === 'targetProductId') targetProductId = value || \"\";\n      else if (key === 'targetProductName') targetProductName = value || \"\";\n      else if (key === 'programType') programType = value || \"\";\n    });\n  }\n  targetProductName = targetProductName.replace(/\\+/g, ' ');\n  result = { targetProductId, targetProductName, programType };\n} catch (error) {\n  result = { targetProductId: \"\", targetProductName: \"\", programType: \"\" };\n}\nreturn result;"
          },
          "outcomes": {
            "success": "1765489722535"
          },
          "code": "RETRIEVE_PRODUCT_NAME_AND_CODE",
          "id": "1765489686553",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
