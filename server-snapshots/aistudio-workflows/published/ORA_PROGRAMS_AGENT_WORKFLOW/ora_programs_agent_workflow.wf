        },
        {
          "metadata": {
            "name": "Refine Program Data",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  const programs = $context.$nodes.FETCH_PROGRAMS.$output.items || [];\n  result = programs.map(program => {\n    const automations = program.automations.items || [];\n    const totalTactics = automations.length;\n    let tacticsMeets = 0;\n    let tacticsExceeds = 0;\n    let tacticsBelowExpectation = 0;\n\n    automations.forEach(tactic => {\n      const metrics = tactic.metrics.items || [];\n      const enterAutomationMetric = metrics.find(m => m.eventType === \"enterAutomation\");\n      const meetTacticSuccessCriteriaMetric = metrics.find(m => m.eventType === \"meetTacticSuccessCriteria\");\n      const enterCount = enterAutomationMetric ? Number(enterAutomationMetric.eventCount) : 0;\n      const meetCount = meetTacticSuccessCriteriaMetric ? Number(meetTacticSuccessCriteriaMetric.eventCount) : 0;\n      let successPercentage = 0;\n      if (enterCount > 0) {\n        successPercentage = meetCount / enterCount;\n      }\n      if (successPercentage >= 0.05) {\n        tacticsMeets += 1;\n      } else {\n        tacticsBelowExpectation += 1;\n      }\n    });\n\n    let subtitle = \"\";\n    let priority = \"\";\n    let badgeText = \"\";\n    if (tacticsMeets >= Math.ceil(totalTactics/2)) {\n      priority = \"success\";\n      badgeText = \"On track\";\n      subtitle = tacticsMeets + \" out of \" + totalTactics  + \" tactics meet expected success rates.\";\n    } else {\n      priority = \"warning\";\n      badgeText = \"Needs Review\";\n      subtitle =  tacticsBelowExpectation + \" out of \" + totalTactics  + \" tactics show below expected success rates.\";\n    } \n\n\n    return {\n      id: program.id,\n      name: program.name,\n      totalTactics: totalTactics,\n      tacticsMeets: tacticsMeets,\n      tacticsExceeds: tacticsExceeds,\n      tacticsBelowExpectation: tacticsBelowExpectation,\n      subtitle: subtitle,\n      priority: priority,\n      badgeText: badgeText\n    };\n  });\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765489924989"
          },
          "code": "REFINE_PROGRAM_DATA",
          "id": "1777323433667",
          "inputs": [],
