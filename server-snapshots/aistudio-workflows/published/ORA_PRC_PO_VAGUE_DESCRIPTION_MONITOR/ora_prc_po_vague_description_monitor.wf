          "convergenceTargetId": "hv_filter_semantic_vague_lines",
          "id": "1778491386733",
          "inputs": [
            {
              "id": "1778491386733_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.SELECT_HIGH_VALUE_CANDIDATES.$output.result.totalSemanticCandidateLines > 0}}"
