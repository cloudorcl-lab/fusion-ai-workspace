        {
          "metadata": {
            "name": "Classify Description Quality"
          },
          "outcomes": {
            "success": "hv_filter_semantic_vague_lines"
          },
          "code": "CLASSIFY_DESCRIPTION_QUALITY",
          "id": "hv_classify_description_quality",
          "inputs": [
            {
              "id": "hv_classify_description_quality_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a procurement risk classifier. Classify whether each high-value requisition line has a vague, generic, or insufficient item description.\n\nUse semantic judgment, not exact keyword matching. Customer production data may contain many different phrasing patterns. Examples such as \"Services\", \"Supplies\", \"Consulting\", \"Miscellaneous\", \"Project support\", and \"As discussed\" are illustrative only, not literal match rules.\n\nA description is vague when a procurement reviewer cannot reasonably understand what is being purchased, what deliverable/specification/scope is requested, or why the amount could be justified without relying on outside conversation or private context.\n\nUse these fields as context when available:\n- itemDescription\n- itemCategoryName\n- displayLineAmount and displayCurrency for the requisitioning BU functional amount\n- lineAmountUsd and targetCurrency for USD threshold/ranking context\n- quantity or unit price context if present\n- requisitioningBUName\n\nClassification guidance:\n- If the description merely repeats a broad category, department, or business area without the specific item/service/scope/deliverable, classify it as vague.\n- If a short description is still specific enough to identify the purchase, classify it as clear.\n- If category or requisitioning BU context makes the description specific enough for a reviewer to understand the purchase, classify it as clear.\n- When uncertain, use confidence \"low\" and avoid over-flagging.\n\nReturn ONLY valid JSON. Do not include markdown, prose, or code fences.\nReturn one result for every input candidate, using this exact shape:\n{\n  \"results\": [\n    {\n      \"requisitionLineId\": \"same value from input\",\n      \"isVague\": true,\n      \"confidence\": \"high | medium | low\",\n      \"reasonCategory\": \"generic | external_reference | missing_scope | insufficient_specs | clear\",\n      \"reason\": \"Short user-facing explanation\"\n    }\n  ]\n}\n\nIf there are no candidate lines, return {\"results\":[]}.\n\nCandidate lines:\n{{$context.$nodes.SELECT_HIGH_VALUE_CANDIDATES.$output.result.semanticCandidateLines}}"
            },
            {
              "id": "hv_classify_description_quality_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "description": "",
            "name": "Filter Semantic Vague Lines",
            "returnType": "object",
            "sourceCode": "function parseClassifierOutput(raw) {\n  const candidates = [raw, raw?.output, raw?.result, raw?.text, raw?.content];\n  for (const candidate of candidates) {\n    if (!candidate) continue;\n    if (typeof candidate === \"object\" && !Array.isArray(candidate)) return candidate;\n    if (typeof candidate !== \"string\") continue;\n\n    let text = candidate.trim();\n    const fence = String.fromCharCode(96, 96, 96);\n    if (text.toLowerCase().startsWith(fence + \"json\")) text = text.slice(7).trim();\n    if (text.startsWith(fence)) text = text.slice(3).trim();\n    if (text.endsWith(fence)) text = text.slice(0, -3).trim();\n\n    try {\n      const parsed = JSON.parse(text);\n      if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) return parsed;\n    } catch (e) {\n      const firstBrace = text.indexOf(\"{\");\n      const lastBrace = text.lastIndexOf(\"}\");\n      if (firstBrace >= 0 && lastBrace > firstBrace) {\n        try {\n          const parsed = JSON.parse(text.slice(firstBrace, lastBrace + 1));\n          if (parsed && typeof parsed === \"object\" && !Array.isArray(parsed)) return parsed;\n        } catch (_) {}\n      }\n    }\n  }\n  return { results: [] };\n}\n\nfunction asBoolean(value) {\n  if (value === true) return true;\n  if (value === false) return false;\n  const text = String(value ?? \"\").trim().toLowerCase();\n  return text === \"true\" || text === \"yes\" || text === \"y\";\n}\n\nfunction nonEmpty(value) {\n  return value != null && String(value).trim() !== \"\";\n}\n\nconst candidateData = $context.$nodes.SELECT_HIGH_VALUE_CANDIDATES.$output.result || {};\nconst deterministicFlaggedLines = candidateData.deterministicFlaggedLines || [];\nconst semanticCandidateLines = candidateData.semanticCandidateLines || [];\nconst classifierOutput = parseClassifierOutput($context.$nodes.CLASSIFY_DESCRIPTION_QUALITY.$output);\nconst classifierResults = Array.isArray(classifierOutput.results) ? classifierOutput.results : [];\n\nconst resultsByReqLineId = new Map();\nfor (const result of classifierResults) {\n  if (result?.requisitionLineId == null) continue;\n  resultsByReqLineId.set(String(result.requisitionLineId), result);\n}\n\nconst flagged = [];\nfor (const row of deterministicFlaggedLines) {\n  flagged.push({\n    ...row,\n    vagueReason: row.deterministicVagueReason,\n    vagueConfidence: \"high\",\n    reasonCategory: \"missing_or_malformed\",\n    semanticClassifierResult: null\n  });\n}\n\nfor (const row of semanticCandidateLines) {\n  const classification = resultsByReqLineId.get(String(row.requisitionLineId));\n  const isVague = asBoolean(classification?.isVague);\n  if (!isVague) continue;\n\n  flagged.push({\n    ...row,\n    vagueReason: classification?.reason || \"Description does not provide enough purchase detail for review\",\n    vagueConfidence: classification?.confidence || \"medium\",\n    reasonCategory: classification?.reasonCategory || \"insufficient_specs\",\n    semanticClassifierResult: classification || null\n  });\n}\n\nflagged.sort((a, b) => {\n  if (b.lineAmountUsd !== a.lineAmountUsd) return b.lineAmountUsd - a.lineAmountUsd;\n  return String(a.requisitionLineId ?? \"\").localeCompare(String(b.requisitionLineId ?? \"\"));\n});\n\nconst payload = {\n  riskType: \"highValueVagueDesc\",\n  prcBUId: $context.$variables.prcBUId\n};\n\nreturn {\n  selectedReqLines: flagged,\n  allFlaggedReqLines: flagged,\n  total: flagged.length,\n  totalCandidateLines: candidateData.totalCandidateLines || 0,\n  totalSemanticCandidateLines: candidateData.totalSemanticCandidateLines || semanticCandidateLines.length,\n  totalDeterministicFlaggedLines: candidateData.totalDeterministicFlaggedLines || deterministicFlaggedLines.length,\n  totalEligibleLines: candidateData.totalEligibleLines || 0,\n  totalAboveThreshold: candidateData.totalAboveThreshold || 0,\n  topTwentyPercentLineCount: candidateData.topTwentyPercentLineCount || 0,\n  classifierOutput,\n  baseWidgetData: {\n    severity: \"High\",\n    description: \"High-value line with vague description\",\n    total: flagged.length,\n    riskCode: \"highValueVagueDesc\",\n    payload\n  }\n};"
          },
          "outcomes": {
