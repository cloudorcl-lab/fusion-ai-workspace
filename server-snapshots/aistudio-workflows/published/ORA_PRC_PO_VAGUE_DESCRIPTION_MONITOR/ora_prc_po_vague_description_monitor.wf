        {
          "metadata": {
            "name": "Normalize Eligible Requisition Lines",
            "returnType": "object",
            "sourceCode": "function localizedText(value) {\n  if (value == null) return null;\n  if (typeof value === \"string\") return value.trim() || null;\n  if (typeof value === \"object\") {\n    const preferred = value.US || value.en || value.EN;\n    if (typeof preferred === \"string\" && preferred.trim()) return preferred.trim();\n    for (const item of Object.values(value)) {\n      if (typeof item === \"string\" && item.trim()) return item.trim();\n    }\n  }\n  return null;\n}\n\nfunction normalizeLine(hit) {\n  const src = hit?._source ?? hit ?? {};\n  const description = localizedText(src.itemDescription) || localizedText(src.description) || \"\";\n  const requisitionNumber = src.requisitionNumber ?? src.header?.requisitionNumber ?? null;\n  const lineNumber = src.lineNumber ?? null;\n\n  return {\n    requisitionHeaderId: src.requisitionHeaderId ?? src.requisitionHeaderID ?? src.requisitionId ?? src.header?.requisitionHeaderId ?? src.header?.requisitionId ?? src.RequisitionHeaderId ?? src.RequisitionId ?? null,\n    requisitionLineId: src.requisitionLineId ?? null,\n    requisitionNumber,\n    lineNumber,\n    requisitionLineDisplay: requisitionNumber == null || lineNumber == null ? \"-\" : String(requisitionNumber) + \" - \" + String(lineNumber),\n    requesterName: localizedText(src.requester?.name) || localizedText(src.requesterName) || null,\n    requisitioningBUName: localizedText(src.header?.requisitioningBU?.name) || localizedText(src.requisitioningBUName) || null,\n    categoryId: src.categoryId ?? null,\n    itemCategoryName: localizedText(src.itemCategory?.name) || localizedText(src.categoryName) || null,\n    itemDescription: description,\n    buyerEmailAddr: src.buyerEmail?.buyerEmailAddress?.buyerEmailAddr ?? src.buyerEmailAddr ?? src.buyerEmail ?? null,\n    buyerName: localizedText(src.buyer?.name) || localizedText(src.buyerName) || null,\n    reqsInPoolFlag: src.reqsInPoolFlag ?? null,\n    purchaseBasis: src.PurchaseBasis ?? src.purchaseBasis ?? null,\n    orderTypeLookupCode: src.OrderTypeLookupCode ?? src.orderTypeLookupCode ?? null,\n    currencyAmount: src.currencyAmount ?? src.CurrencyAmount ?? null,\n    amount: src.amount ?? src.Amount ?? null,\n    quantity: src.quantity ?? src.Quantity ?? null,\n    currencyUnitPrice: src.currencyUnitPrice ?? src.CurrencyUnitPrice ?? null,\n    Price: src.Price ?? src.price ?? null,\n    currencyCode: src.currencyCode ?? src.CurrencyCode ?? src.Currency ?? null,\n    functionalCurrencyCode: src.header?.functionalCurrencyCode ?? src.functionalCurrencyCode ?? src.FunctionalCurrencyCode ?? null,\n    creationDate: src.creationDate ? String(src.creationDate).split(\"T\")[0] : null,\n    lastUpdateDate: src.LastUpdateDate ? String(src.LastUpdateDate).split(\"T\")[0] : null\n  };\n}\n\nconst hits = $context.$nodes.GET_REQUISITION_LINES_FOR_VAGUE_DESC.$output?.hits?.hits ?? [];\nconst requisitionLines = [];\n\nfor (const hit of hits) {\n  requisitionLines.push(normalizeLine(hit));\n}\n\nreturn {\n  requisitionLines,\n  total: requisitionLines.length,\n  sourceTotal: hits.length\n};"
          },
          "outcomes": {
            "success": "hv_get_currencies_requiring_conversion"
          },
          "code": "NORMALIZE_ELIGIBLE_REQUISITION_LINES",
          "id": "hv_normalize_eligible_lines",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Derives display amount/currency once and collects unique non-USD currency conversion requests.",
            "name": "Prepare Line Values And Currency Conversion Requests",
            "returnType": "object",
            "sourceCode": "function toNumber(value) {\n  if (value == null || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(value);\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction firstNumber(...values) {\n  for (const value of values) {\n    const n = toNumber(value);\n    if (n != null) return n;\n  }\n  return null;\n}\n\nfunction normalizeCurrency(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction toDateOnly(value) {\n  if (value == null || value === \"\") return null;\n  const text = String(value).trim();\n  const isoDate = text.match(/^(\\d{4}-\\d{2}-\\d{2})/);\n  if (isoDate) return isoDate[1];\n\n  const parsed = new Date(text);\n  if (!Number.isNaN(parsed.getTime())) {\n    return parsed.toISOString().split(\"T\")[0];\n  }\n\n  return null;\n}\n\nfunction deriveLineValue(row, targetCurrency) {\n  const currencyCode = normalizeCurrency(row.currencyCode);\n  const functionalCurrencyCode = normalizeCurrency(row.functionalCurrencyCode);\n  const purchaseBasis = normalizeCurrency(row.purchaseBasis);\n  const orderTypeLookupCode = normalizeCurrency(row.orderTypeLookupCode);\n  const quantity = toNumber(row.quantity);\n  const currencyUnitPrice = toNumber(row.currencyUnitPrice);\n  const price = toNumber(row.Price);\n  const documentAmount = firstNumber(row.currencyAmount, row.amount);\n  const functionalAmount = toNumber(row.amount);\n  const isServiceLine = purchaseBasis === \"SERVICES\";\n  const isFixedPriceLine = orderTypeLookupCode === \"FIXED PRICE\";\n\n  let displayLineAmount = null;\n  let displayCurrency = functionalCurrencyCode || currencyCode || targetCurrency;\n  let comparisonSourceCurrency = displayCurrency;\n  let valueBasis = \"UNRESOLVED\";\n\n  if (isFixedPriceLine) {\n    if (functionalAmount != null && functionalCurrencyCode) {\n      displayLineAmount = functionalAmount;\n      displayCurrency = functionalCurrencyCode;\n      comparisonSourceCurrency = functionalCurrencyCode;\n      valueBasis = \"FUNCTIONAL_AMOUNT\";\n    } else if (documentAmount != null && currencyCode) {\n      displayLineAmount = documentAmount;\n      displayCurrency = currencyCode;\n      comparisonSourceCurrency = currencyCode;\n      valueBasis = \"DOCUMENT_AMOUNT\";\n    }\n  } else if (quantity != null) {\n    if (price != null && functionalCurrencyCode) {\n      displayLineAmount = quantity * price;\n      displayCurrency = functionalCurrencyCode;\n      comparisonSourceCurrency = functionalCurrencyCode;\n      valueBasis = \"FUNCTIONAL_QUANTITY_PRICE\";\n    } else if (currencyUnitPrice != null && currencyCode) {\n      displayLineAmount = quantity * currencyUnitPrice;\n      displayCurrency = currencyCode;\n      comparisonSourceCurrency = currencyCode;\n      valueBasis = \"DOCUMENT_QUANTITY_PRICE\";\n    }\n  }\n\n  if (displayLineAmount == null || !Number.isFinite(displayLineAmount)) return null;\n\n  return {\n    ...row,\n    lineType: isServiceLine ? \"SERVICE\" : \"QUANTITY\",\n    isFixedPriceLine,\n    valueBasis,\n    targetCurrency,\n    comparisonSourceCurrency,\n    lineAmount: displayLineAmount,\n    displayLineAmount,\n    displayCurrency\n  };\n}\n\nconst rows = $context.$nodes.NORMALIZE_ELIGIBLE_REQUISITION_LINES.$output.result.requisitionLines || [];\nconst targetCurrency = \"USD\";\nconst userSession = $context.$nodes.GET_USER_SESSION.$output.items?.[0] || {};\nconst conversionDate = toDateOnly(userSession.ServerTime) || toDateOnly(new Date().toISOString());\nconst preparedLines = [];\nconst seen = new Set();\nconst requests = [];\n\nfor (const row of rows) {\n  const preparedLine = deriveLineValue(row, targetCurrency);\n  if (!preparedLine) continue;\n\n  preparedLines.push(preparedLine);\n\n  const fromCurrency = normalizeCurrency(preparedLine.comparisonSourceCurrency);\n  if (!fromCurrency || fromCurrency === targetCurrency || seen.has(fromCurrency)) continue;\n\n  seen.add(fromCurrency);\n  requests.push({\n    fromCurrency,\n    toCurrency: targetCurrency,\n    startDate: conversionDate,\n    endDate: conversionDate\n  });\n}\n\nreturn {\n  requisitionLines: preparedLines,\n  total: preparedLines.length,\n  requests,\n  totalConversionRequests: requests.length,\n  targetCurrency,\n  conversionDate\n};"
          },
          "outcomes": {
            "success": "hv_initialize_currency_conversion_rates"
          },
          "code": "PREPARE_LINE_VALUES_AND_CURRENCY_CONVERSIONS",
          "id": "hv_get_currencies_requiring_conversion",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Initialize Currency Conversion Rates"
          },
          "outcomes": {
            "success": "hv_fetch_currency_conversion_rates"
          },
          "code": "INITIALIZE_CURRENCY_CONVERSION_RATES",
          "id": "hv_initialize_currency_conversion_rates",
          "inputs": [
            {
              "id": "hv_initialize_currency_conversion_rates_value",
              "name": "currencyConversionRates",
              "scope": "JOB",
              "type": "object",
              "value": "{}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Find Currency Conversions Needed"
          },
          "outcomes": {
            "success": "hv_calculate_line_values"
          },
          "code": "FETCH_CURRENCY_CONVERSION_RATES",
          "id": "hv_fetch_currency_conversion_rates",
          "inputs": [
            {
              "id": "hv_fetch_currency_conversion_rates_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            },
            {
              "id": "hv_fetch_currency_conversion_rates_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are given currency conversion requests:\n{{$context.$nodes.PREPARE_LINE_VALUES_AND_CURRENCY_CONVERSIONS.$output.result.requests}}\n\nTarget currency:\n{{$context.$nodes.PREPARE_LINE_VALUES_AND_CURRENCY_CONVERSIONS.$output.result.targetCurrency}}\n\nIf the request list is empty, return an empty JSON object {}.\n\nOtherwise, return ONLY a valid JSON object where each key is the source currency code and each value is the numeric conversion rate to the target currency.\n\nDo not include markdown, explanations, or extra text.\n\nExample:\n{\"CAD\":0.73,\"INR\":0.012}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Calculate Line Values",
            "returnType": "object",
            "sourceCode": "function toNumber(value) {\n  if (value == null || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(value);\n  return Number.isFinite(n) ? n : null;\n}\n\nfunction firstNumber(...values) {\n  for (const value of values) {\n    const n = toNumber(value);\n    if (n != null) return n;\n  }\n  return null;\n}\n\nfunction normalizeCode(value) {\n  return String(value || \"\").trim().toUpperCase();\n}\n\nfunction getRate(rates, fromCurrency, toCurrency) {\n  const from = normalizeCode(fromCurrency);\n  const to = normalizeCode(toCurrency);\n  return firstNumber(rates[from + \"->\" + to], rates[from]);\n}\n\nfunction stripCodeFence(text) {\n  let value = String(text || \"\").trim();\n  const fence = String.fromCharCode(96, 96, 96);\n  if (value.toLowerCase().startsWith(fence + \"json\")) value = value.slice(7).trim();\n  if (value.startsWith(fence)) value = value.slice(3).trim();\n  if (value.endsWith(fence)) value = value.slice(0, -3).trim();\n  return value.trim();\n}\n\nfunction parseJsonObject(value) {\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n  if (typeof value !== \"string\") return {};\n\n  const text = stripCodeFence(value);\n  if (!text) return {};\n\n  try {\n    const parsed = JSON.parse(text);\n    return parsed && typeof parsed === \"object\" && !Array.isArray(parsed) ? parsed : {};\n  } catch (e) {\n    const firstBrace = text.indexOf(\"{\");\n    const lastBrace = text.lastIndexOf(\"}\");\n    if (firstBrace >= 0 && lastBrace > firstBrace) {\n      try {\n        const parsed = JSON.parse(text.slice(firstBrace, lastBrace + 1));\n        return parsed && typeof parsed === \"object\" && !Array.isArray(parsed) ? parsed : {};\n      } catch (_) {}\n    }\n  }\n\n  return {};\n}\n\nfunction parseConversionMap(rawOutput) {\n  const candidates = [rawOutput, rawOutput?.result, rawOutput?.output, rawOutput?.text, rawOutput?.content];\n  for (const candidate of candidates) {\n    const parsed = parseJsonObject(candidate);\n    if (Object.keys(parsed).length > 0) return parsed;\n  }\n  return {};\n}\n\nfunction normalizeRates(conversionMap, requests) {\n  const rates = {};\n  const requestList = Array.isArray(requests) ? requests : [];\n\n  for (const [key, value] of Object.entries(conversionMap || {})) {\n    const rate = toNumber(value);\n    if (rate == null || rate <= 0) continue;\n\n    const sourceCurrency = normalizeCode(key);\n    if (!sourceCurrency) continue;\n\n    rates[sourceCurrency] = rate;\n    const request = requestList.find((item) => normalizeCode(item?.fromCurrency) === sourceCurrency);\n    const targetCurrency = normalizeCode(request?.toCurrency);\n    if (targetCurrency) {\n      rates[sourceCurrency + \"->\" + targetCurrency] = rate;\n    }\n  }\n\n  return rates;\n}\n\nconst preparedData = $context.$nodes.PREPARE_LINE_VALUES_AND_CURRENCY_CONVERSIONS.$output.result || {};\nconst rows = preparedData.requisitionLines || [];\nconst targetCurrency = preparedData.targetCurrency || \"USD\";\nconst conversionMap = parseConversionMap($context.$nodes.FETCH_CURRENCY_CONVERSION_RATES.$output);\nconst rates = normalizeRates(conversionMap, preparedData.requests || []);\nconst convertedRows = [];\n\nfor (const row of rows) {\n  const displayLineAmount = toNumber(row.displayLineAmount);\n  const comparisonSourceCurrency = normalizeCode(row.comparisonSourceCurrency || row.displayCurrency);\n  const currencyCode = normalizeCode(row.currencyCode);\n  const functionalCurrencyCode = normalizeCode(row.functionalCurrencyCode);\n\n  if (displayLineAmount == null || !comparisonSourceCurrency) continue;\n\n  let lineAmountUsd = null;\n  let conversionRate = null;\n  let valuePath = \"SKIP\";\n\n  if (comparisonSourceCurrency === targetCurrency) {\n    lineAmountUsd = displayLineAmount;\n    valuePath = comparisonSourceCurrency === functionalCurrencyCode\n      ? \"USE_FUNCTIONAL_CURRENCY_VALUE\"\n      : \"USE_CURRENCY_VALUE\";\n  } else {\n    conversionRate = getRate(rates, comparisonSourceCurrency, targetCurrency);\n    if (conversionRate != null && conversionRate > 0) {\n      lineAmountUsd = displayLineAmount * conversionRate;\n      valuePath = comparisonSourceCurrency === functionalCurrencyCode\n        ? \"CONVERT_FUNCTIONAL_CURRENCY_VALUE\"\n        : \"CONVERT_CURRENCY_VALUE\";\n    }\n  }\n\n  if (lineAmountUsd == null || !Number.isFinite(lineAmountUsd)) continue;\n\n  convertedRows.push({\n    ...row,\n    currencyCode,\n    functionalCurrencyCode,\n    valuePath,\n    targetCurrency,\n    conversionRate,\n    comparisonSourceCurrency,\n    lineAmountUsd\n  });\n}\n\nreturn {\n  requisitionLines: convertedRows,\n  total: convertedRows.length,\n  targetCurrency,\n  rates\n};"
          },
          "outcomes": {
            "success": "hv_select_high_value_candidates"
          },
          "code": "CALCULATE_LINE_VALUES",
          "id": "hv_calculate_line_values",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Select High Value Candidates",
            "returnType": "object",
            "sourceCode": "function toNumber(value, fallback = null) {\n  if (value == null || value === \"\") return fallback;\n  const n = typeof value === \"number\" ? value : Number(value);\n  return Number.isFinite(n) ? n : fallback;\n}\n\nfunction nonEmpty(value) {\n  return value != null && String(value).trim() !== \"\";\n}\n\nfunction normalizedDescription(value) {\n  return String(value || \"\").trim().replace(/\\s+/g, \" \");\n}\n\nfunction deterministicDescriptionIssue(description) {\n  const text = normalizedDescription(description);\n  if (!text) return \"Missing description\";\n\n  const lowerText = text.toLowerCase();\n  const compact = lowerText.replace(/[\\s._\\/-]+/g, \"\");\n  if ([\"na\", \"n/a\", \"none\", \"null\"].includes(lowerText)) return \"Malformed placeholder description\";\n  if (!/[a-z0-9]/i.test(text)) return \"Malformed placeholder description\";\n  if (compact.length <= 1) return \"Malformed placeholder description\";\n\n  return null;\n}\n\nconst rows = ($context.$nodes.CALCULATE_LINE_VALUES.$output.result.requisitionLines || [])\n  .map((row, index) => ({ ...row, _sequence: index, lineAmountUsd: toNumber(row.lineAmountUsd) }))\n  .filter((row) => row.lineAmountUsd != null);\n\nconst minimumAmountThreshold = toNumber($context.$variables.minimumAmountThreshold, 1000);\nconst candidatesAboveThreshold = rows.filter((row) => row.lineAmountUsd > minimumAmountThreshold);\nconst rankedCandidates = [...candidatesAboveThreshold].sort((a, b) => {\n  if (b.lineAmountUsd !== a.lineAmountUsd) return b.lineAmountUsd - a.lineAmountUsd;\n  return a._sequence - b._sequence;\n});\nconst topCount = rankedCandidates.length === 0 ? 0 : Math.max(1, Math.ceil(rankedCandidates.length * 0.2));\nconst highValueLineIds = new Set(rankedCandidates.slice(0, topCount).map((row) => String(row.requisitionLineId ?? row._sequence)));\n\nconst candidateLines = [];\nfor (const row of candidatesAboveThreshold) {\n  const key = String(row.requisitionLineId ?? row._sequence);\n  if (!highValueLineIds.has(key)) continue;\n\n  const { _sequence, ...cleanRow } = row;\n  candidateLines.push({\n    ...cleanRow,\n    deterministicVagueReason: deterministicDescriptionIssue(row.itemDescription)\n  });\n}\n\ncandidateLines.sort((a, b) => {\n  if (b.lineAmountUsd !== a.lineAmountUsd) return b.lineAmountUsd - a.lineAmountUsd;\n  return String(a.requisitionLineId ?? \"\").localeCompare(String(b.requisitionLineId ?? \"\"));\n});\n\nconst deterministicFlaggedLines = candidateLines.filter((row) => nonEmpty(row.deterministicVagueReason));\nconst semanticCandidateLines = candidateLines.filter((row) => !nonEmpty(row.deterministicVagueReason));\n\nreturn {\n  candidateLines,\n  deterministicFlaggedLines,\n  semanticCandidateLines,\n  totalCandidateLines: candidateLines.length,\n  totalSemanticCandidateLines: semanticCandidateLines.length,\n  totalDeterministicFlaggedLines: deterministicFlaggedLines.length,\n  totalEligibleLines: rows.length,\n  totalAboveThreshold: candidatesAboveThreshold.length,\n  topTwentyPercentLineCount: topCount,\n  minimumAmountThreshold,\n  targetCurrency: $context.$nodes.CALCULATE_LINE_VALUES.$output.result.targetCurrency\n};"
          },
          "outcomes": {
            "success": "1778491386733"
          },
          "code": "SELECT_HIGH_VALUE_CANDIDATES",
          "id": "hv_select_high_value_candidates",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
