            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"items\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                    \"minDiscountRate\": { \"type\": \"number\" },\n                    \"maxDiscountRate\": { \"type\": \"number\" },\n                    \"noOfInstallments\": { \"type\": \"number\" },\n                    \"totalUnpaidAmount\": { \"type\": \"number\" },\n                    \"offerStatus\": { \"type\": \"string\" },\n                    \"emailAddress\": { \"type\": [\"string\", \"null\"] },\n                    \"currencyCode\": { \"type\": [\"string\", \"null\"] },\n                    \"supplierName\": { \"type\": \"string\" },\n                    \"supplierId\": { \"type\": \"number\" },\n                    \"financingOptionType\": { \"type\": \"string\" }\n                },\n                \"required\": [\n                    \"minDiscountRate\",\n                    \"maxDiscountRate\",\n                    \"noOfInstallments\",\n                    \"totalUnpaidAmount\",\n                    \"offerStatus\",\n                    \"supplierName\",\n                    \"supplierId\",\n                    \"financingOptionType\"\n                ]\n            }\n        },\n        \"hasMore\":{\"type\":\"boolean\"}\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1767802479211",
            "name": "Parse Fetched Offers",
            "returnType": "array",
            "sourceCode": "if ($context.$nodes.FIN_AP_BO_RETRIEVE_OFFERS.$output === undefined) return [];\nlet retrievedOffers = $context.$nodes.FIN_AP_BO_RETRIEVE_OFFERS.$output.items\nlet simpleView = true;\nif( $context.$nodes.FIN_AP_LLM_ANALYSE_REQUEST.$output.view === 'detailed' ){\nsimpleView = false;\n}\n\n// Determine which fields to use based on view\nconst fields =  simpleView ? $context.$variables.simpleViewFields : $context.$variables.detailedViewFields ;\n\nlet columns = Object.keys(fields);\nlet responseData =  retrievedOffers.map(item => {\n  const result = {};\ncolumns.forEach(column => {\nif(column===\"APR\"){\n        let minDiscount = item['minDiscountRate'];\n        let maxDiscount = item['maxDiscountRate'];\n        result[fields[column]] = minDiscount === maxDiscount ? `${minDiscount}%` : `${maxDiscount}% - ${maxDiscount}%`\n} else if (column === \"totalUnpaidAmount\"){\nlet amount = item[column] === null ? 0 : item[column] ;\nlet currency = item[\"currencyCode\"] === null ? \"\" : \" \" + item[\"currencyCode\"];\nresult[fields[column]] = amount + currency;\n}else{\n    result[fields[column]] = item[column] === null ? \"\" : item[column]\n}\n})\nreturn result;\n});\n\nreturn responseData"
          },
          "outcomes": {
            "success": "1771403694787"
          },
          "diagram": {
            "x": 5000,
            "y": 6094
          },
          "code": "FIN_AP_CODE_PARSE_FETCHED_OFFERS",
          "convergenceTargetId": "1767802237836",
          "id": "1767097016700",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "errorNodeId": "1767802479211",
            "name": "Offer Analyser"
          },
          "outcomes": {
            "success": "1767209338103"
          },
          "diagram": {
            "x": 5000,
            "y": 6982
          },
          "code": "FIN_AP_LLM_OFFER_ANALYSER",
          "convergenceTargetId": "1767802237836",
          "id": "1767209237490",
          "inputs": [
            {
              "id": "1767209237491_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an **Offer Retrieval Analyzer** operating inside a workflow system.\n\nThe workflow system has fetched list of offers based on user input and chatHistory. Your task is to provide a summary for the retrieved offers\n\nYour sole responsibility is analyse the response for user input and provide text summary, headingand follow up actions\n\nYou will be provided with:\n\n* The **current user input**\nUser Input: {{$context.$system.$inputMessage}}\n\n\n* The **full chat history** for context\nChat History: {{$context.$system.$chatHistory}} {{$context.$triggers.REST.$input.chatHistory}}\n\n* The filters used to retreive data\nFilter used to retrieve data:  {{$context.$nodes.FIN_AP_LLM_ANALYSE_REQUEST.$output.filter}}\n\n*Number of records retrieved\nNumber of records:  {{$context.$nodes.FIN_AP_CODE_NUMBER_OF_RECORDS.$output.result}} \n\nAre there more records: {{$context.$nodes.FIN_AP_BO_RETRIEVE_OFFERS.$output.hasMore}} \n\nSearch offset:  {{$context.$nodes.FIN_AP_LLM_ANALYSE_REQUEST.$output.offset}} \n\n\n\nBased on the data, you are to generate\n1. Text summary\n2. Text summary hint\n2. Table Header\n3. Follow up actions\n\n\nInstructions on Generating Text summary\n\n- Text summary to be derived from user input,  filters used to fetch data, the number of records retrieved and if there are more records to be displayed \n- Do not include info on offerStatusCode, limit or offset used in summary. These are technical terms which should not be displayed\n- Include below information in text summary\n           --- what data is being filtered on. Filter on status is default, do not mention it\n           --- how many records are displayed\n           --- only if more records are available, mention that. Also include that the remaining offers will be displayed after applying further filters\n           --- when the user input is to show additional data which is being set as offset. summary should indicate these are additional records\n-- when user input is to show additional offers without any other conditions, do not include filters in summary as it is redundant\n--when additional records are not present, don't mention that more records are not available\n-- do not include hiphens(-) as it does not look professional\n\n-Zero-record text summary rule:\n\nIf Number of records retrieved is 0, do not say \"0 draft offers are displayed\", \"0 draft offers were found\", or any wording that starts with \"0\".\n\nFor draft or shortlisted offer retrievals with a supplier filter, use this exact format:\n\"No draft offers were found for supplier <supplier>. 0 records are displayed.\"\n\nFor draft or shortlisted offer retrievals without a supplier filter, use this exact format:\n\"No draft offers were found. 0 records are displayed.\"\n\nIf the user requested a specific filter such as currency, amount, program type, installment count, or email address, include that filter naturally before the record count sentence.\n\n\nInstructions on Generating Text summary hint\n\n1. Based on user input, add hints on summary. Like if user is asking for a particular supplier and amount data. Make the particular part in summary as bold\n2. Do not add hint if not required\n\nInstrictions on generating Table header\n\n1. Consider the data retrieved is to be displayed as a table\n2. The header should be suiltable for the table data\n3. Header should not be the column names of the data, it should be a heading.\n4. Do not add any details of discount rate or apr in the table header\n\nInstrictions on generating follow up actions\n\n1. When the only filter used is only offerStatusCode and no records are retrieved. There are no possible actions. In this case do not have any followup actions\n2. The main workflow can only handle the below tasks\n    a. Retrieval of existing offers\n    b. Querying offer installments\n    c. Confirmation of offers . Confirmation is supported for only one offer at a time. So confirm one or more offers is not a recommendation\n3. Based on the user query, filters suggest followup actions based on what tasks main workflow can do\n4. Show only 3 follow up actions\n5. Workflow is not able to get details of individual offers, so do not include actions based on offer ids\n6. When there are more records available, one of the actions should be to show additional records\n7. When there is only filter on offerStatusCode and we have no offer records retrieved, leave followup actions to empty\n8. Possible filters that can be applied on offers are based on  \n    - supplier, no of installments, total outstanding amount, financial program type, email address and currency code\n\nThe output should be in json format\n\n{\n    textSummary: <string>,\n    textSummaryHint: <string>,\n    tableHeader: <string>,\n    followupActions: <list of strings>\n}"
            },
            {
              "id": "1767209237490_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"followupActions\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"string\"\n            }\n        },\n        \"tableHeader\": {\n            \"type\": \"string\"\n        },\n        \"textSummaryHint\": {\n            \"type\": \"string\"\n        },\n        \"textSummary\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1767802479211",
            "name": "Format Response",
            "returnType": "array",
            "sourceCode": "let tableData = $context.$nodes.FIN_AP_CODE_PARSE_FETCHED_OFFERS.$output.result\n\nlet offersAnalyzed = $context.$nodes.FIN_AP_LLM_OFFER_ANALYSER.$output\n//offersAnalyzed = $context.$nodes.FIN_AP_LLM_OFFER_ANALYSER.$output \nlet simpleView = $context.$nodes.FIN_AP_LLM_ANALYSE_REQUEST.$output.view === 'simple';\nlet tableDataExists = false\n//let tableColumns = simpleView ? $context.$variables.simpleViewFields : $context.$variables.detailedViewFields; \n\n//tableColumns = tableColumns.map(col => col === 'totalUnpaidAmount' ? 'totalOutstandingAmount' : col );\n\nlet count = 1\n\nif( tableData !== undefined && Array.isArray(tableData) && tableData.length > 0){\n tableDataExists = true;\n}\nlet responseData = [\n{\n    type: \"text\",\n    content: [ offersAnalyzed.textSummary ],\n    sequence: count,\n    formatHint: \"\"\n}\n\n\n]\n\ncount = count + 1;\n\nif(tableDataExists){\n    let tableElement = {\n        type: \"table\",\n        content:  tableData ,\n        sequence: count,\n        heading: $context.$nodes.FIN_AP_LLM_OFFER_ANALYSER.$output.tableHeader ,\n        //formatHint: \"supplierName is the key attribute and row header. Mandatory column order to follow: \" + tableColumns\n        formatHint: \"\",\n        columnOrder: $context.$variables.columnOrder \n    }\n    count = count + 1;\n    responseData.push(tableElement);\n}\n\nlet followupActions = $context.$nodes.FIN_AP_LLM_OFFER_ANALYSER.$output.followupActions \nlet actions = {\n    type: \"actions\",\n    content: followupActions ,\n    sequence: count\n}\n\nlet emptyActions = Array.isArray(followupActions) && followupActions.length === 0;\n\nif(!emptyActions){\n    responseData.push(actions);\n}\nlet returnData = {}\nreturnData['summary']  = responseData\nreturnData['suppliers'] = $context.$nodes.FIN_AP_CODE_PARSE_SUPPLIERS.$output.result \nreturnData['offerRetrievalFilters'] = $context.$nodes.FIN_AP_CODE_COMPUTE_OFFER_FILTERS.$output.result \n\n\nreturn returnData"
          },
