            "sourceCode": "let knownSuppliers = $context.$triggers.REST.$input.suppliers || []\n\n\nlet offers = $context.$nodes.FIN_AP_CODE_PARSE_FETCHED_OFFERS.$output.result;\n\nlet parsedSuppliers = [... new Set(offers.map(offer => offer['Supplier']))]\n\nlet suppliers = [... new Set([... knownSuppliers,... parsedSuppliers])]\n\nreturn suppliers"
