          "inputs": [
            {
              "id": "1765520835725_1",
              "name": "filter",
              "value": "{{$context.$nodes.FIN_AP_LLM_ANALYSE_REQUEST.$output.filter}}",
              "required": true
            },
            {
              "id": "1765520835727_2",
              "name": "sortCriteria",
