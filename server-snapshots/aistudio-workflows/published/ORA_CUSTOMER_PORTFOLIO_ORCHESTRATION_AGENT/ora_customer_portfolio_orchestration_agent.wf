        {
          "metadata": {
            "name": "PrepareProfilerParameter",
            "returnType": "object",
            "sourceCode": "let accountBatchSizeLocal =  $context.$triggers.REST.$input?.action?.config?.accountBatchSize;\nlet productBatchSizeLocal =  $context.$triggers.REST.$input?.action?.config?.productBatchSize;\nlet listOfAccountIdsValue = $context.$nodes.LISTOFPARTIES1.$output.result;\nlet expansionFormulaLocal = $context.$nodes.EXPANSIONFORMULA.$output;\nlet riskFormulaLocal = $context.$nodes.RISKFORMULA.$output;\nlet myFilterCriteriaLocal = $context.$nodes.CONSTRUCTMYFILTER.$output.result;\n\naccountBatchSizeLocal = (accountBatchSizeLocal == null || accountBatchSizeLocal.toString().trim() === \"\")   ? 3   : accountBatchSizeLocal;\nproductBatchSizeLocal = (productBatchSizeLocal == null || productBatchSizeLocal.toString().trim() === \"\")    ? 20    : productBatchSizeLocal;\n\n\nvar output = {\n  config: {\n      accountBatchSize: accountBatchSizeLocal,\n      productBatchSize: productBatchSizeLocal,\n      listOfAccountIds: listOfAccountIdsValue,\n      riskFormula: riskFormulaLocal != null ? riskFormulaLocal : null,\n      expansionFormula: expansionFormulaLocal != null ? expansionFormulaLocal : null,\n      myFilterCriteria: myFilterCriteriaLocal != null ? myFilterCriteriaLocal : null\n  }\n};\n\nJSON.stringify(output);"
          },
          "outcomes": {
            "success": "1764716957846"
          },
