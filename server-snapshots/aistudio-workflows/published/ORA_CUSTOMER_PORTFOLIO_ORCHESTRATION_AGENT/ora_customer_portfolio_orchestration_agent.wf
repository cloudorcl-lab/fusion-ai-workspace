          "code": "VALIDATEPARAMETERS",
          "convergenceTargetId": "end",
          "id": "1764656253768",
          "inputs": [
            {
              "id": "1764656253769_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.action.name==null || $context.$triggers.REST.$input.action.name=='TOP_EXPANSION_ACCOUNTS'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "constructMYFilter",
            "returnType": "string",
            "sourceCode": "// Resolve my account filter\nvar accountFilterClause = \"\";\n\nvar filterConfig = $context.$triggers.REST.$input?.filterConfiguration;\n\n\nvar accountRecordset = filterConfig?.accountRecordSet;\n\nif (accountRecordset != null && accountRecordset !== \"\") {\n  var accountRecordSets = {\n    MYACCTS:\n      \"ownerResource.partyId = @faContext.partyId\",\n\n    MYSALESTEAMACCTS:\n      \"salesTeam[resource.partyId = @faContext.partyId]\",\n\n    MYSUBORDINATESACCTS:\n      \"ownerResource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]\",\n\n    MYSUBORDSSALESTEAMACCTS:\n      \"salesTeam[resource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]]\",\n\n    MYASSGTERRACCTS:\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]\",\n\n    MYASSGDESCTERRACCTS:\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId] or ancestorTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]]]\",\n\n    MYSALESTEAMTERRACCTS:\n      \"salesTeam[resource.partyId = @faContext.partyId] or salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]\",\n\n    MYSUBORDTEAMTERRACCTS:\n      \"salesTeam[resource[partyId = @faContext.partyId or managers[resourceManager.partyId = @faContext.partyId]]] or \" +\n      \"salesTerritories[territory[territoryResources[resource.partyId = @faContext.partyId] or \" +\n      \"ancestorTerritories[territory[territoryResources[resource.partyId = @faContext.partyId]]]]]\"\n  };\n\n  if (accountRecordSets[accountRecordset]) {\n    accountFilterClause =\n      \"(fusionAccount[\" + accountRecordSets[accountRecordset] + \"])\";\n  }\n}\n\n// Explicit account filter overrides recordset filter\nvar explicitAccountFilter = filterConfig?.accountFilter;\n\nif (explicitAccountFilter != null && explicitAccountFilter.trim() !== \"\") {\n  accountFilterClause = explicitAccountFilter;\n}\n\n\n// Resolve my product filter\nvar productFilter = \"\";\n\n// Default behavior → true unless explicitly false\nvar filterByTerritory = filterConfig?.filterProductByTerritory;\n\nif (filterByTerritory == null || filterByTerritory === true) {\n  productFilter =\n    \"((productType = 'PRODUCT_GROUP' and \" +\n    \"fusionProductGroup[parentProductGroupHierarchies[\" +\n    \"baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]) \" +\n    \"or (productType = 'Item' and fusionProduct[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]] \" +\n    \"or parentProductGroups[activeFlag = true and startDate < @currentDateTime \" +\n    \"and endDate > @currentDateTime and productGroup[\" +\n    \"parentProductGroupHierarchies[baseUsageFlag = true and firstProductGroup[\" +\n    \"territoryCoverages[territory[territoryResources[resource.partyId=@faContext.partyId]]]]]]]]))\";\n}\n\n\n// Construct MY filter\nvar MYFilter = \"\";\n\nif (accountFilterClause && productFilter) {\n  MYFilter = accountFilterClause + \" and \" + productFilter;\n} \nelse if (accountFilterClause) {\n  MYFilter = accountFilterClause;\n} \nelse if (productFilter) {\n  MYFilter = productFilter;\n} \nelse {\n  MYFilter = \"1=1\";\n}\n\nreturn MYFilter;"
          },
          "outcomes": {
            "success": "1764656253768"
          },
          "code": "CONSTRUCTMYFILTER",
          "id": "1765331544220",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
