": \"number\",\n            \"description\": \"Number of open priority one items\"\n          },\n          \"totalPriorityOneLastSixMonths\": {\n            \"type\": \"number\",\n            \"description\": \"Total priority one items in the last six months\"\n          },\n          \"ownedProducts\": {\n            \"type\": \"string\",\n            \"description\": \"Comma-separated list of products currently owned by the account\"\n          },\n          \"suggestedProducts\": {\n            \"type\": \"string\",\n            \"description\": \"Comma-separated list of suggested products for the account\"\n          }\n        },\n        \"required\": [\"accountId\", \"accountName\", \"registryIdentifier\"]\n      }\n    },\n    \"links\": {\n      \"type\": \"object\",\n      \"description\": \"Links for pagination or self-reference\",\n      \"properties\": {\n        \"$self\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"href\": {\n              \"type\": \"string\",\n              \"description\": \"URL of the current query or resource\"\n            }\n          },\n          \"required\": [\"href\"]\n        }\n      }\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\",\n      \"description\": \"Indicates if there are more items available beyond this response\"\n    }\n  },\n  \"required\": [\"items\", \"links\", \"hasMore\"]\n}",
