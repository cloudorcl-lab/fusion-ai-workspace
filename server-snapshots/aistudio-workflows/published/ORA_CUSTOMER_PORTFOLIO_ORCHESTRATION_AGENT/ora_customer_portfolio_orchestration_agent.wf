            "name": "PrepareListOfPartyIds",
            "returnType": "array",
            "sourceCode": "const list = $context?.$nodes?.GETACCOUNTIDS?.$output?.items ?? [];\n\nlet parties = [];\n\nfor (let i = 0; i < list.length; i++) {\n    if (list[i]?.accountId != null) {\n        parties.push(list[i].accountId);\n    }\n}\n\nparties = [...new Set(parties)];\n\nreturn parties;"
          },
