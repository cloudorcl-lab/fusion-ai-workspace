                {
                  "metadata": {
                    "businessObjectCode": "ORA_HCM_GLOBALHUMA_WORKERSINFORMAT",
                    "functionName": "workers_lov_api",
                    "processJson": true,
                    "name": "get personid info in loop"
                  },
                  "outcomes": {
                    "success": "1775650399548"
                  },
                  "code": "GET_PERSONID_INFO_IN_LOOP",
                  "id": "1775650078587",
                  "inputs": [
                    {
                      "id": "1775650113225_1",
                      "name": "searchTerms",
                      "type": "string",
                      "value": "{{$context.$nodes.ITERATE_ON_USERS.$currentItem}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "replace user details with person id info",
                    "returnType": "string",
                    "sourceCode": "var initialQuery = $context.$variables.txnQueryString;\n\nvar response =$context.$nodes.ITERATE_ON_USERS.GET_PERSONID_INFO_IN_LOOP.$output ;\nif(response['items'].length == 0) {\n     return \"NO_MATCHING_USER_FOUND\";\n}\nvar search = $context.$nodes.ITERATE_ON_USERS.$currentItem ;\nvar personId = response['items'][0]['PersonId'];\nvar items = response['items'];\n  for (var i = 0; i < items.length; i++) {\n    var item = items[i];\n\n    if (item && (item['DisplayName'].toLowerCase() === search.toLowerCase() || item['Username'].toLowerCase() === search.toLowerCase() )) {\n     personId = item['PersonId'];\n    }\n  }\n\n\nvar regex = new RegExp(search, \"gi\");\n  return initialQuery.replace(regex, personId);"
                  },
                  "outcomes": {
                    "success": "1775653172671"
                  },
