          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"PersonAssignmentLovItemsResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"PersonId\": { \"type\": \"string\" },\n          \"PersonNumber\": { \"type\": \"string\" },\n          \"DisplayName\": { \"type\": \"string\" },\n          \"ListName\": { \"type\": \"string\" },\n          \"WorkEmailAddress\": { \"type\": \"string\" },\n          \"ImageId\": { \"type\": \"string\" },\n          \"ImageOvn\": { \"type\": \"integer\" },\n          \"AssignmentId\": { \"type\": \"string\" },\n          \"AssignmentNumber\": { \"type\": \"string\" },\n          \"AssignmentType\": { \"type\": \"string\" },\n          \"AssignmentName\": { \"type\": \"string\" },\n          \"AssignmentStatusType\": { \"type\": \"string\" },\n          \"AssignmentUserStatus\": { \"type\": \"string\" },\n          \"AssignmentPrimaryFlag\": { \"type\": \"boolean\" },\n          \"Username\": { \"type\": \"string\" },\n          \"ManagerDisplayName\": { \"type\": [\"string\", \"null\"] },\n          \"ManagerListName\": { \"type\": [\"string\", \"null\"] },\n          \"JobName\": { \"type\": \"string\" },\n          \"DepartmentName\": { \"type\": [\"string\", \"null\"] },\n          \"LocationName\": { \"type\": \"string\" },\n          \"PositionName\": { \"type\": [\"string\", \"null\"] },\n          \"GradeName\": { \"type\": \"string\" },\n          \"BusinessUnitName\": { \"type\": [\"string\", \"null\"] },\n          \"LegalEmployerName\": { \"type\": \"string\" },\n          \"WorkerNumber\": { \"type\": [\"string\", \"null\"] },\n          \"PersonIdAsString\": { \"type\": \"string\" },\n          \"AssignmentIdAsString\": { \"type\": \"string\" },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": { \"type\": \"string\" }\n            },\n            \"required\": [\"key\"]\n          }\n        },\n        \"required\": [\n          \"PersonId\", \"PersonNumber\", \"DisplayName\", \"ListName\",\n          \"WorkEmailAddress\", \"ImageId\", \"ImageOvn\", \"AssignmentId\",\n          \"AssignmentNumber\", \"AssignmentType\", \"AssignmentName\",\n          \"AssignmentStatusType\", \"AssignmentUserStatus\",\n          \"AssignmentPrimaryFlag\", \"Username\", \"ManagerDisplayName\",\n          \"ManagerListName\", \"JobName\", \"DepartmentName\", \"LocationName\",\n          \"PositionName\", \"GradeName\", \"BusinessUnitName\",\n          \"LegalEmployerName\", \"WorkerNumber\", \"PersonIdAsString\",\n          \"AssignmentIdAsString\", \"@context\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n}",
          "type": "BO_FUNCTION"
