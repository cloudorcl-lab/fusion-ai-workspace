          "code": "CHECKIFACTIONVALID",
          "id": "1763031520768",
          "inputs": [
            {
              "id": "1763031520769_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an agent that checks if a particular action can be performed or not. \n\nTake this response as input {{$context.$nodes.TRANSACTIONS_MANAGEMENT_VALID_ACTIONS.$output}}\nThis response has several attributes whose value is either 1 or 0. If the value is 1 then action can be performed otherwise action can't be performed. \n\nThe name of the action is {{$context.$nodes.TRANSACTION_ACTION_IDENTIFIER.$output.action}} \n\nIf the action is ApplicableActions then simply return the action otherwise, you have to check the action if it is valid or not. If the action is valid then return the name of the action as it is in {{$context.$nodes.TRANSACTION_ACTION_IDENTIFIER.$output.action}}  otherwise set the name of action as \"NoAction\"."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"LLMActionNameResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"action\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"action\"]\n}",
          "type": "LLM"
        },
