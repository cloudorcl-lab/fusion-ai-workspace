        {
          "metadata": {
            "name": "validate tasks",
            "returnType": "boolean",
            "sourceCode": "var message = $context.$system.$inputMessage ;\nvar transactionId = $context.$nodes.TRANSACTION_ACTION_IDENTIFIER.$output.transactionId;\n\nvar response = {};\nvar result =$context.$nodes.TRANSACTIONS_FILTER_GET_TASK_ID.$output.result;\n\nfor (var key in result) {\n  if (Object.prototype.hasOwnProperty.call(result, key)) {\n    var tasks = result[key];\n    var assignedCount = 0;\n\n    for (var i = 0; i < tasks.length; i++) {\n      if (tasks[i] && tasks[i].State === \"ASSIGNED\" && tasks[i].Assignees !== null) {\n        assignedCount++;\n        if (assignedCount > 1) break; // early exit once we know it's parallel\n      }\n    }\n\n    response[key] = (assignedCount > 1);\n  }\n}\nreturn response[transactionId];"
          },
          "outcomes": {
            "success": "1774523107544"
          },
          "code": "VALIDATE_TASKS",
          "id": "1774520799066",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
