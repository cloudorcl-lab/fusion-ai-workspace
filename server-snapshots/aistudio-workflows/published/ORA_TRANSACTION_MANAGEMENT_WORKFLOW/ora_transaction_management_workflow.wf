          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"TaskArrayByTransactionIdResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"patternProperties\": {\n        \"^\\\\d+$\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"TaskId\": { \"type\": \"string\" },\n              \"VersionReason\": { \"type\": [\"string\", \"null\"] },\n              \"TaskNumber\": { \"type\": \"string\" },\n              \"Title\": { \"type\": \"string\" },\n              \"RootTaskId\": { \"type\": \"string\" },\n              \"IdentificationKey\": { \"type\": \"string\" },\n              \"AssigneesDisplayName\": { \"type\": [\"string\", \"null\"] },\n              \"Creator\": { \"type\": \"string\" },\n              \"SubState\": { \"type\": [\"string\", \"null\"] },\n              \"WorkFlowPattern\": { \"type\": [\"string\", \"null\"] },\n              \"AssignedDate\": { \"type\": \"string\" },\n              \"State\": { \"type\": \"string\" },\n              \"Outcome\": { \"type\": [\"string\", \"null\"] },\n              \"Approvers\": { \"type\": [\"string\", \"null\"] },\n              \"IsGroup\": { \"type\": \"string\" },\n              \"TaskNameSpace\": { \"type\": \"string\" },\n              \"TaskDefinitionName\": { \"type\": \"string\" },\n              \"AcquiredBy\": { \"type\": [\"string\", \"null\"] },\n              \"Ecid\": { \"type\": \"string\" },\n              \"CompositeInstanceId\": { \"type\": \"string\" },\n              \"Assignees\": { \"type\": [\"string\", \"null\"] },\n              \"AggregationTaskId\": { \"type\": [\"string\", \"null\"] },\n              \"FromUser\": { \"type\": \"string\" }\n            },\n            \"required\": [\n              \"TaskId\",\n              \"TaskNumber\",\n              \"Title\",\n              \"RootTaskId\",\n              \"IdentificationKey\",\n              \"Creator\",\n              \"AssignedDate\",\n              \"State\",\n              \"IsGroup\",\n              \"TaskNameSpace\",\n              \"TaskDefinitionName\",\n              \"Ecid\",\n              \"CompositeInstanceId\",\n              \"FromUser\"\n            ]\n          }\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\"result\"]\n}",
          "type": "BO_FUNCTION"
        },
