            "errorNodeId": "1770069717463",
            "name": "Summarize Employee Event Details"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SUMMARIZE_EMPLOYEE_EVENT_DETAILS",
          "convergenceTargetId": "1764950272851",
          "id": "1764948377194",
          "inputs": [
            {
              "id": "1764948377196_1",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the input JSON {{$context.$nodes.GET_EMPLOYEE_EVENT_DETAILS.$output}} and extract the necessary event details.\n\nEvent Start Date and Event End Date are in UTC time zone.\nConvert Event Start Date and Event End Date to {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}}, applying daylight savings if applicable.\nFormat both dates using the user’s date and time format ({{$context.$nodes.GET_SELF_DETAILS.$output.items[0].DateFormat}} <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeFormat}}  <space> {{$context.$nodes.GET_SELF_DETAILS.$output.items[0].TimeZone}}).\n\nDisplay each field on a single line with only the value for each field. Show only the following fields in the same order\n\nEvent Name: [Event Name]\nEvent Number: [Event Number]\nStart Date: [Formatted Start Date]\nEnd Date: [Formatted End Date]\nRegistrants: [RegisteredCount] of [MaximumCapacity] Registered\nEvent Format: [Event Format]\nDescription: [Event Description, decoded and plain text only]\nEvent Team: [Comma-separated owner display names]\n\nInlcude below fields if the values are not null\nMeeting Link: [WebConfLink]\nMeeting Details: [MeetingDetails]\nLocation Details: Generate it from using fields [LocationDetails, City, State, Country] in the same order. If any of the field value is null, do not consider that field while constructing the string\n\nDo not add any extra information, explanations, or formatting beyond what is specified above."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"EmpowerNurse Event Schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"event_name\": {\n      \"type\": \"string\",\n      \"description\": \"Name of the event\"\n    },\n \"event_number\": {\n      \"type\": \"string\",\n      \"description\": \"Event Number\"\n    },\n    \"start_date\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Event start date and time in UTC\"\n    },\n    \"end_date\": {\n      \"type\": \"string\",\n      \"format\": \"date-time\",\n      \"description\": \"Event end date and time in UTC\"\n    },\n       \"registrants\": {\n      \"type\": \"string\",\n      \"description\": \"number of registrants\"\n    },\n    \"event_format\": {\n      \"type\": \"string\",\n      \"enum\": [\"In Person\", \"Virtual\", \"Hybrid\"],\n      \"description\": \"Format of the event\"\n    },\n    \"description\": {\n      \"type\": \"string\",\n      \"description\": \"Detailed event description\"\n    },\n    \"event_team\": {\n        \"type\": \"string\",\n      \"description\": \"People organizing or leading the event\"\n    },\n    \"meeting_link\": {\n      \"type\": \"string\",\n      \"description\": \"Meeting link for virtual events\"\n    },\n    \"meeting_details\": {\n      \"type\": \"string\",\n      \"description\": \"Meeting details for virtual events\"\n    }\n\n  },\n  \"required\": [\n    \"eventName\",\n    \"startDate\",\n    \"endDate\",\n    \"registrants\",\n    \"eventFormat\",\n    \"description\",\n    \"eventTeam\"\n  ]\n}",
          "type": "LLM"
        },
