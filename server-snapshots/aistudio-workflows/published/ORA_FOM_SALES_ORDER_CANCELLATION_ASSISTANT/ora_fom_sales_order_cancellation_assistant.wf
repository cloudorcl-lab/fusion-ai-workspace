            "name": "CreateCancelOrderErrorResponse",
            "returnType": "string",
            "sourceCode": "let errorMessage  =null;\nlet orderNumber  = null;\nlet itemNumbers = [];\nlet lineNumbers = [];\n\nfunction formatArray(arr) {\n  if (!arr || arr.length === 0) return \"\";\n\n  if (arr.length === 1) {\n    return arr[0];\n  }\n\n  if (arr.length === 2) {\n    return arr[0] + \" and \" + arr[1];\n  }\n\n  return arr.slice(0, -1).join(\", \") + \" and \" + arr[arr.length - 1];\n}\n\nif($context.$nodes.CANCELORDERDATA.$output !=null && $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('details')){\n      const errorDetailsArray =   $context.$nodes.CANCELORDERDATA.$output.details;\n      if (Array.isArray(errorDetailsArray) && errorDetailsArray.length > 0) {\n            for (let i=0; i < errorDetailsArray.length; i++) {\n                  if(errorDetailsArray[i].ErrorCode == 'NO_ORDER_FOUND' ){\n                        errorMessage =\"We couldn\\'t find the order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or it is cancelled or a draft order. Please provide the correct order number.\";\n                        break;\n            }else if(errorDetailsArray[i].ErrorCode == 'MULTIPLE_ORDERS_FOUND'){\n                        errorMessage =\"We found multiple records for the order number \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\". Please provide the correct order number.\";\n                        break;\n            }else if(errorDetailsArray[i].ErrorCode == 'NO_LINE_FOUND'){\n                        lineNumbers.push( errorDetailsArray[i].SearchText );                  \n            }else if(errorDetailsArray[i].ErrorCode == 'NO_ITEM_FOUND'){\n                        itemNumbers.push( errorDetailsArray[i].SearchText);\n            }else if(errorDetailsArray[i].ErrorCode == 'MULTIPLE_ITEMS_FOUND'){\n                        itemNumbers.push( errorDetailsArray[i].SearchText );\n            }\t   \n            }\n\n           if(lineNumbers.length > 0 && itemNumbers.length > 0){\n                  errorMessage =\"We couldn\\'t locate the specified line and item in order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or the details provided may be invalid. Please verify and share the correct line number and item.\";\n            }else if(lineNumbers.length > 0){\n                  if(lineNumbers.length == 1){\n                        errorMessage =\"We couldn\\'t find line \"+formatArray(lineNumbers)+\" in order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or it appears to be invalid. Please provide the correct line number.\";\n                  }else{\n                        errorMessage =\"We couldn\\'t find lines \"+formatArray(lineNumbers)+\" in order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or they appear to be invalid. Please provide the correct line numbers.\";\n                  }\n            }else if(itemNumbers.length > 0){\n                  if(itemNumbers.length == 1){\n                        errorMessage =\"We couldn\\'t find item \"+formatArray(itemNumbers)+\" in order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or found multiple items with this name. Please provide the correct item to be canceled.\";\n                  }else{\n                        errorMessage =\"We couldn't find items \"+formatArray(itemNumbers)+\" in order \"+$context.$triggers.REST.$input.tPayload.OrderNumber+\", or found multiple items with these names. Please provide the correct items to be canceled.\";\n                  }\n            }\n      }\n\n}\n\nif($context.$nodes.CANCELORDERDATA.$output !=null &&  ($context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('cancelEligibleLines') || $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('nonEligibleLines'))){\n errorMessage = \"We\\'re unable to retrieve the data at the moment. Please try again.\" ;\n}\n\nif(errorMessage == null){\n      errorMessage = \"We are unable to process your request. Please try again.\" ;\n}\n\nreturn errorMessage;"
