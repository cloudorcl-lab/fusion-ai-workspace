            "name": "checkForValidReturnResponse",
            "returnType": "boolean",
            "sourceCode": "let isValidResponse ;\nisValidResponse = $context.$nodes.GETRETURNORDERDATA.$output.hasOwnProperty('eligibleLines')  || $context.$nodes.GETRETURNORDERDATA.$output.hasOwnProperty('nonEligibleLines')  ;\n\nfunction isEmpty(value) {\n    return value === null || value === undefined || value === '' || \n           (typeof value === 'string' && value.trim() === '');\n}\n\nif (isValidResponse && $context.$nodes.GETRETURNORDERDATA.$output.hasOwnProperty('eligibleLines')) {\n    let returnEligibleLines = $context.$nodes.GETRETURNORDERDATA.$output.eligibleLines;\n\n    if (Array.isArray(returnEligibleLines) && returnEligibleLines.length > 0) {\n        for (let i = 0; i < returnEligibleLines.length; i++) {\n\n            let line = returnEligibleLines[i];\n\n            if (\n                isEmpty(line.FulfillLineId) ||\n                isEmpty(line.ReturnableQuantity) ||\n                isEmpty(line.ReturnTypeCode) ||\n                isEmpty(line.OrderedUomCode) ||\n                isEmpty(line.DisplayLineNumber) ||\n                isEmpty(line.ReturnReasonCode) ||\n                isEmpty(line.ProductDescription) ||\n                isEmpty(line.ItemNumber) ||\n                isEmpty(line.LineAmount)\n            ) {\n                isValidResponse = false;\n                break;\n            }\n        }\n    }\n}\n\n\nreturn isValidResponse;"
          },
