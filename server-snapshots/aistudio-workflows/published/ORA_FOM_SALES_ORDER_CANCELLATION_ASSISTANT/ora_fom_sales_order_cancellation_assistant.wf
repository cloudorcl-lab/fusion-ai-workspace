            "sourceCode": "let cancelOrderData = $context.$nodes.CANCELORDERDATA.$output;\n\nif(cancelOrderData.returnEligibleLines !=null && cancelOrderData.returnEligibleLines.length > 0){\n\nlet policyValidationResponse = $context.$nodes.VALIDATERETURNORDERPOLICY1.$output.items;\nlet eligibilityMap = new Map();\npolicyValidationResponse.forEach(item => {\n  eligibilityMap.set(item.FulfillLineId, item.ReturnEligibleFlag);\n});\n\nlet removedSum = 0;\n\nlet filteredEligibleReturnLines = cancelOrderData.returnEligibleLines.filter(item => {\n  if (eligibilityMap.get(item.FulfillLineId) === \"No\") {\n    removedSum += item.LineAmount;\n   cancelOrderData.nonEligibleLines.push({\n        \"FulfillLineId\": item.FulfillLineId,\n        \"DisplayLineNumber\": item.DisplayLineNumber,\n        \"ItemNumber\": item.ItemNumber,\n        \"ProductDescription\": item.ProductDescription\n    });\n    return false; \n  }\n  return true; \n});\n\nlet filteredEligibleReturnLinesPayload = cancelOrderData.returnEligibleLinesPaylod.filter(item => {\n  if (eligibilityMap.get(item.FulfillLineId) === \"No\") {\n    return false; \n  }\n  return true; \n});\n\ncancelOrderData.TotalEligibleReturnAmount = cancelOrderData.TotalEligibleReturnAmount - removedSum;\ncancelOrderData.returnEligibleLines = filteredEligibleReturnLines;\ncancelOrderData.returnEligibleLinesPaylod = filteredEligibleReturnLinesPayload;\n\n}\nreturn cancelOrderData;"
