            "sourceCode": "let isValidResponse ;\nisValidResponse = $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('cancelEligibleLines')  || $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('nonEligibleLines')  || $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('returnEligibleLines') ;\n\nfunction isEmpty(value) {\n    return value === null || value === undefined || value === '' || \n           (typeof value === 'string' && value.trim() === '');\n}\n\nif (isValidResponse && $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('returnEligibleLines')) {\n    let returnEligibleLines = $context.$nodes.CANCELORDERDATA.$output.returnEligibleLines;\n\n    if (Array.isArray(returnEligibleLines) && returnEligibleLines.length > 0) {\n        for (let i = 0; i < returnEligibleLines.length; i++) {\n\n            let line = returnEligibleLines[i];\n\n            if (\n                isEmpty(line.FulfillLineId) ||\n                isEmpty(line.ReturnableQuantity) ||\n                isEmpty(line.OrderedUomCode) ||\n                isEmpty(line.DisplayLineNumber) ||\n                isEmpty(line.ProductDescription) ||\n                isEmpty(line.ItemNumber) ||\n                isEmpty(line.LineAmount)\n            ) {\n                isValidResponse = false;\n                break;\n            }\n        }\n    }\n}\n\nif (isValidResponse && $context.$nodes.CANCELORDERDATA.$output.hasOwnProperty('cancelEligibleLines')) {\n    let cancelEligibleLines = $context.$nodes.CANCELORDERDATA.$output.cancelEligibleLines;\n\n    if (Array.isArray(cancelEligibleLines) && cancelEligibleLines.length > 0) {\n        for (let i = 0; i < cancelEligibleLines.length; i++) {\n\n            let line = cancelEligibleLines[i];\n\n            if (\n                isEmpty(line.FulfillLineId) ||\n                isEmpty(line.OrderedQuantity) ||\n                isEmpty(line.DisplayLineNumber) ||\n                isEmpty(line.ProductDescription) ||\n                isEmpty(line.ItemNumber) ||\n                isEmpty(line.LineAmount) \n            ) {\n                isValidResponse = false;\n                break;\n            }\n        }\n    }\n}\n\nreturn isValidResponse;"
