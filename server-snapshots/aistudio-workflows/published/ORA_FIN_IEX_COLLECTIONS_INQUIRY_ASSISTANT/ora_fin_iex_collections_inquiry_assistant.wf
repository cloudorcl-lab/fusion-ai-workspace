guityReason\": \"\",\n  \"scopeReason\": \"\",\n  \"resolvedContext\": {\n    \"transactionNumber\": \"\",\n    \"accountNumber\": \"1001\",\n    \"customerAccountId\": \"\",\n    \"customerAccountIds\": [],\n    \"customerName\": \"\",\n    \"collectorId\": \"\"\n  }\n}\n\nUser: Which invoices for account 1001 are eligible for dunning?\nOutput:\n{\n  \"routeHint\": \"RESOLVED\",\n  \"rewrittenQuestion\": \"Show invoices for account number 1001 eligible for dunning\",\n  \"clarificationPrompt\": \"\",\n  \"ambiguityReason\": \"\",\n  \"scopeReason\": \"\",\n  \"resolvedContext\": {\n    \"transactionNumber\": \"\",\n    \"accountNumber\": \"1001\",\n    \"customerAccountId\": \"\",\n    \"customerAccountIds\": [],\n    \"customerName\": \"\",\n    \"collectorId\": \"\"\n  }\n}\n\nUser: When was the last dunning notice sent for invoice INV-100934?\nOutput:\n{\n  \"routeHint\": \"RESOLVED\",\n  \"rewrittenQuestion\": \"Show the last dunning notice date for invoice number INV-100934\",\n  \"clarificationPrompt\": \"\",\n  \"ambiguityReason\": \"\",\n  \"scopeReason\": \"\",\n  \"resolvedContext\": {\n    \"transactionNumber\": \"INV-100934\",\n    \"accountNumber\": \"\",\n    \"customerAccountId\": \"\",\n    \"customerAccountIds\": [],\n    \"customerName\": \"\",\n    \"collectorId\": \"\"\n  }\n}\n\nUser: Which accounts should receive the next dunning notice today?\nOutput:\n{\n  \"routeHint\": \"RESOLVED\",\n  \"rewrittenQuestion\": \"Show accounts with next dunning notice date today\",\n  \"clarificationPrompt\": \"\",\n  \"ambiguityReason\": \"\",\n  \"scopeReason\": \"\",\n  \"resolvedContext\": {\n    \"transactionNumber\": \"\",\n    \"accountNumber\": \"\",\n    \"customerAccountId\": \"\",\n    \"customerAccountIds\": [],\n    \"customerName\": \"\",\n    \"collectorId\": \"\"\n  }\n}\nUser: Show overdue invoices eligible for dunning\nApp context: {\"CUSTOMERACCOUNTID\":100107014082857,\"CUSTOMERNAME\":\"Acme Corp\",\"customerName\":null}\nOutput:\n{\n  \"r