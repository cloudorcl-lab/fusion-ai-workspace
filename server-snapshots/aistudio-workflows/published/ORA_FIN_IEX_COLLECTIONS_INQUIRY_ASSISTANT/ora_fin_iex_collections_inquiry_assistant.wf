            "sourceCode": "let contextValue = $context.$nodes.MERGECURRENTCONTEXT && $context.$nodes.MERGECURRENTCONTEXT.$output && $context.$nodes.MERGECURRENTCONTEXT.$output.result ? $context.$nodes.MERGECURRENTCONTEXT.$output.result.output : $context.$variables.CurrentContext;\nlet savedPaginationContext = $context.$variables.PaginationContext;\n\nlet timeout = false;\nlet error = '';\n\nif (typeof contextValue === 'string') {\n  try {\n    contextValue = JSON.parse(contextValue);\n  } catch (e) {\n    contextValue = {};\n  }\n}\n\nif (!contextValue || typeof contextValue !== 'object' || Array.isArray(contextValue)) {\n  contextValue = {};\n}\n\nif (typeof savedPaginationContext === 'string') {\n  try {\n    savedPaginationContext = JSON.parse(savedPaginationContext);\n  } catch (e) {\n    savedPaginationContext = null;\n  }\n}\n\nif (!savedPaginationContext || typeof savedPaginationContext !== 'object' || Array.isArray(savedPaginationContext)) {\n  savedPaginationContext = null;\n}\n\nfunction normalizeSqlText(value) {\n  let sql = String(value || '').trim();\n  while (sql.length >= 2 && sql.charAt(0) === '\"' && sql.charAt(sql.length - 1) === '\"') {\n    sql = sql.substring(1, sql.length - 1).trim();\n  }\n  return sql.replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').replace(/;+\\s*$/, '').trim();\n}\n\nfunction stripPaginationClause(value) {\n  let sql = normalizeSqlText(value);\n  sql = sql.replace(/\\s+OFFSET\\s+\\d+\\s+ROWS\\s+FETCH\\s+(FIRST|NEXT)\\s+\\d+\\s+ROWS\\s+ONLY\\s*$/i, '');\n  sql = sql.replace(/\\s+FETCH\\s+(FIRST|NEXT)\\s+\\d+\\s+ROWS\\s+ONLY\\s*$/i, '');\n  return sql.trim();\n}\n\nfunction positiveNumber(value, fallback) {\n  let n = Number(value);\n  if (!isFinite(n) || n <= 0) return fallback;\n  return Math.floor(n);\n}\n\nfunction capLimit(value) {\n  let n = positiveNumber(value, 10);\n  if (n > 50) return 50;\n  return n;\n}\n\nfunction configForIntent(intent) {\n  if (intent === 'PROMISE_PROFILE_QUERY') {\n    return {\n      activeExtract: $context.$variables.CustomerProfileMatchExtractFragment,\n      activeCatalog: $context.$variables.CustomerProfileMatchAttributeCatalog,\n      label: 'PROMISE_PROFILE_QUERY'\n    };\n  }\n  if (intent === 'CUSTOMER_PROFILE_QUERY') {\n    return {\n      activeExtract: $context.$variables.CustomerProfileExtractFragment,\n      activeCatalog: $context.$variables.CustomerProfileAttributeCatalog,\n      label: 'CUSTOMER_PROFILE_QUERY'\n    };\n  }\n  if (intent === 'DISPUTE_PAYMENT_SCHEDULE_QUERY') {\n    return {\n      activeExtract: $context.$variables.DisputePaymentScheduleMatchExtractFragment,\n      activeCatalog: $context.$variables.DisputePaymentScheduleMatchAttributeCatalog,\n      label: 'DISPUTE_PAYMENT_SCHEDULE_QUERY'\n    };\n  }\n  if (intent === 'DISPUTE_PROMISE_QUERY') {\n    return {\n      activeExtract: $context.$variables.DisputePromiseMatchExtractFragment,\n      activeCatalog: $context.$variables.DisputePromiseMatchAttributeCatalog,\n      label: 'DISPUTE_PROMISE_QUERY'\n    };\n  }\n  if (intent === 'PAYMENT_SCHEDULE_QUERY') {\n    return {\n      activeExtract: $context.$variables.PaymentScheduleExtractFragment,\n      activeCatalog: $context.$variables.PaymentScheduleAttributeCatalog,\n      label: 'PAYMENT_SCHEDULE_QUERY'\n    };\n  }\n  if (intent === 'TRANSACTION_DETAIL_QUERY') {\n    return {\n      activeExtract: $context.$variables.TransactionExtractFragment,\n      activeCatalog: $context.$variables.TransactionAttributeCatalog,\n      label: 'TRANSACTION_DETAIL_QUERY'\n    };\n  }\n  if (intent === 'DISPUTE_DETAIL_QUERY') {\n    return {\n      activeExtract: $context.$variables.DisputeExtractFragment,\n      activeCatalog: $context.$variables.DisputeAttributeCatalog,\n      label: 'DISPUTE_DETAIL_QUERY'\n    };\n  }\n  if (intent === 'RECEIPT_DETAIL_QUERY' || intent === 'RECEIPT_SUMMARY_QUERY') {\n    return {\n      activeExtract: $context.$variables.ReceiptExtractFragment,\n      activeCatalog: $context.$variables.ReceiptAttributeCatalog,\n      label: intent\n    };\n  }\n  if (intent === 'COLLECTIONS_DUNNING_QUERY') {\n    return {\n      activeExtract: $context.$variables.DunningExtractFragment,\n      activeCatalog: $context.$variables.DunningAttributeCatalog,\n      label: 'COLLECTIONS_DUNNING_QUERY'\n    };\n  }\n  if (intent === 'RECEIVABLES_BALANCES_QUERY') {\n    return {\n      activeExtract: $context.$variables.PaymentScheduleExtractFragment,\n      activeCatalog: $context.$variables.PaymentScheduleAttributeCatalog,\n      label: 'RECEIVABLES_BALANCES_QUERY'\n    };\n  }\n  return {\n    activeExtract: $context.$variables.PromiseExtractFragment,\n    activeCatalog: $context.$variables.PromiseAttributeCatalog,\n    label: 'PROMISE_QUERY'\n  };\n}\n\nlet paginationContext = savedPaginationContext || (contextValue.paginationContext && typeof contextValue.paginationContext === 'object' ? contextValue.paginationContext : null);\nlet paginationRequest = contextValue.paginationRequest && typeof contextValue.paginationRequest === 'object' ? contextValue.paginationRequest : {};\nlet output = null;\n\nif (!paginationContext || !paginationContext.baseSqlWithoutPagination) {\n  error = 'MISSING_PAGINATION_CONTEXT';\n} else {\n  let direction = paginationRequest.direction ? String(paginationRequest.direction).toUpperCase() : 'NEXT';\n  let priorLimit = positiveNumber(paginationContext.displayLimit, 10);\n  let limit = capLimit(paginationRequest.requestedLimit || priorLimit);\n  let currentOffset = positiveNumber(paginationContext.offset, 0);\n  let nextOffset = positiveNumber(paginationContext.nextOffset, currentOffset + priorLimit);\n  let offset = direction === 'PREVIOUS' ? Math.max(0, currentOffset - limit) : nextOffset;\n  let intent = paginationContext.intent || 'PROMISE_QUERY';\n  let config = configForIntent(intent);\n  let baseSql = stripPaginationClause(paginationContext.baseSqlWithoutPagination);\n\n  if (!/^select\\b/i.test(baseSql)) {\n    error = 'INVALID_PAGINATION_QUERY';\n  } else {\n    output = {\n      usePagination: true,\n      intent: intent,\n      label: config.label,\n      activeExtract: config.activeExtract,\n      activeCatalog: config.activeCatalog,\n      activeQuery: baseSql + ' OFFSET ' + offset + ' ROWS FETCH NEXT ' + limit + ' ROWS ONLY',\n      pagination: {\n        isPagination: true,\n        direction: direction,\n        displayLimit: limit,\n        offset: offset,\n        previousOffset: currentOffset,\n        baseSqlWithoutPagination: baseSql\n      }\n    };\n  }\n}\n\nlet result = {\n  output: output,\n  timeout: timeout,\n  error: error\n};\n\nreturn result;"
