|NEXT)\\s+\\d+\\s+ROWS\\s+ONLY\\s*$/i, '');\n  return sql.trim();\n}\n\nfunction inferFetchLimit(value) {\n  let sql = normalizeSqlText(value);\n  let match = sql.match(/\\s+FETCH\\s+(FIRST|NEXT)\\s+(\\d+)\\s+ROWS\\s+ONLY\\s*$/i);\n  return match ? Number(match[2]) : 0;\n}\n\nfunction inferOffset(value) {\n  let sql = normalizeSqlText(value);\n  let match = sql.match(/\\s+OFFSET\\s+(\\d+)\\s+ROWS\\s+FETCH\\s+(FIRST|NEXT)\\s+\\d+\\s+ROWS\\s+ONLY\\s*$/i);\n  return match ? Number(match[1]) : 0;\n}\n\nfunction positiveNumber(value, fallback) {\n  let n = Number(value);\n  if (!isFinite(n) || n < 0) return fallback;\n  return Math.floor(n);\n}\n\nfunction normalizeKey(value) {\n  return String(value || '').replace(/[^A-Za-z0-9]/g, '').toUpperCase();\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction addUnique(list, value) {\n  if (isBlank(value)) return;\n  let s = String(value).trim();\n  for (let i = 0; i < list.length; i++) {\n    if (String(list[i]).toUpperCase() === s.toUpperCase()) return;\n  }\n  if (list.length < 50) {\n    list.push(s);\n  }\n}\n\nfunction firstValue(row, matchFn) {\n  if (!row || typeof row !== 'object' || Array.isArray(row)) return '';\n  for (let key in row) {\n    if (!Object.prototype.hasOwnProperty.call(row, key)) continue;\n    if (matchFn(normalizeKey(key), key)) return row[key];\n  }\n  return '';\n}\n\nlet entities = {\n  transactionNumbers: [],\n  invoiceNumbers: [],\n  paymentScheduleIds: [],\n  customerTransactionIds: [],\n  customerAccountIds: [],\n  accountNumbers: [],\n  accountNames: [],\n  customerNames: [],\n  receiptNumbers: [],\n  receiptReferences: [],\n  promiseIds: [],\n  promiseStatuses: [],\n  disputeIds: [],\n  disputeStatuses: [],\n  disputeReasons: [],\n  dunningLevels: [],\n  dunningStatuses: [],\n  salesOrderNumbers: [],\n  lineNumbers: []\n};\n\nlet rowRefs = [];\n\nfor (let r = 0; r < rows.length; r++) {\n  let row = rows[r];\n  if (!row || typeof row !== 'object' || Array.isArray(row)) continue;\n\n  let transactionNumber = firstValue(row, function (key) {\n    return key === 'TRANSACTIONNUMBER' || key === 'INVOICENUMBER' || key === 'PAYMENTSCHEDULETRANSACTIONNUMBER' || key === 'ORIGINALTRANSACTIONNUMBER';\n  });\n  let paymentScheduleId = firstValue(row, function (key) {\n    return key === 'PAYMENTSCHEDULEID' || key === 'PAYMENTSCHEDULEIDENTIFIER';\n  });\n  let customerTransactionId = firstValue(row, function (key) {\n    return key === 'CUSTOMERTRANSACTIONID' || key === 'PAYMENTSCHEDULECUSTOMERTRANSACTIONID' || key === 'TRANSACTIONID';\n  });\n  let customerAccountId = firstValue(row, function (key) {\n    return key === 'CUSTOMERACCOUNTID' || key === 'PAYMENTSCHEDULECUSTOMERACCOUNTID' || key === 'BILLTOCUSTOMERACCOUNTID';\n  });\n  let accountNumber = firstValue(row, function (key) {\n    return key === 'ACCOUNTNUMBER' || key === 'CUSTOMERACCOUNTNUMBER' || key === 'BILLTOACCOUNTNUMBER' || key === 'PAYMENTSCHEDULEACCOUNTNUMBER';\n  });\n  let accountName = firstValue(row, function (key) {\n    return key === 'ACCOUNTNAME' || key === 'CUSTOMERACCOUNTNAME';\n  });\n  let customerName = firstValue(row, function (key) {\n    return key === 'CUSTOMERNAME' || key === 'PARTYNAME' || key === 'CUSTOMER';\n  });\n  let receiptNumber = firstValue(row, function (key) {\n    return key === 'RECEIPTNUMBER' || key === 'CASHRECEIPTNUMBER';\n  });\n  let receiptReference = firstValue(row, function (key) {\n    return key === 'RECEIPTREFERENCE' || key === 'BANKREFERENCE' || key === 'UNIQUEREFERENCE' || key === 'STRUCTUREDPAYMENTREFERENCE';\n  });\n  let promiseId = firstValue(row, function (key) {\n    return key === 'PROMISEDETAILID' || key === 'PROMISEID';\n  });\n  let promiseStatus = firstValue(row, function (key) {\n    return key === 'PROMISESTATUS' || key === 'STATUSMEANING' || key === 'STATUSLOOKUPCODE';\n  });\n  let disputeId = firstValue(row, function (key) {\n    return key === 'DISPUTEID' || key === 'DISPUTEDETAILID';\n  });\n  let disputeStatus = firstValue(row, function (key) {\n    return key === 'DISPUTESTATUS' || key === 'STATUSMEANING' || key === 'STATUSCODE';\n  });\n  let disputeReason = firstValue(row, function (key) {\n    return key === 'DISPUTEREASON' || key === 'CREDITMEMOREASONMEANING' || key === 'CREDITMEMOREASONCODE';\n  });\n  let dunningLevel = firstValue(row, function (key) {\n    return key === 'DUNNINGLEVEL' || key === 'PAYMENTSCHEDULEDUNNINGLEVEL';\n  });\n  let dunningStatus = firstValue(row, function (key) {\n    return key === 'DUNNINGSTATUS';\n  });\n  let salesOrderNumber = firstValue(row, function (key) {\n    return key === 'SALESORDERNUMBER' || key === 'SALESORDER';\n  });\n  let lineNumber = firstValue(row, function (key) {\n    return key === 'LINENUMBER' || key === 'TRANSACTIONLINENUMBER';\n  });\n\n  addUnique(entities.transactionNumbers, transactionNumber);\n  addUnique(entities.invoiceNumbers, transactionNumber);\n  addUnique(entities.paymentScheduleIds, paymentScheduleId);\n  addUnique(entities.customerTransactionIds, customerTransactionId);\n  addUnique(entities.customerAccountIds, customerAccountId);\n  addUnique(entities.accountNumbers, accountNumber);\n  addUnique(entities.accountNames, accountName);\n  addUnique(entities.customerNames, customerName);\n  addUnique(entities.receiptNumbers, receiptNumber);\n  addUnique(entities.receiptReferences, receiptReference);\n  addUnique(entities.promiseIds, promiseId);\n  addUnique(entities.promiseStatuses, promiseStatus);\n  addUnique(entities.disputeIds, disputeId);\n  addUnique(entities.disputeStatuses, disputeStatus);\n  addUnique(entities.disputeReasons, disputeReason);\n  addUnique(entities.dunningLevels, dunningLevel);\n  addUnique(entities.dunningStatuses, dunningStatus);\n  addUnique(entities.salesOrderNumbers, salesOrderNumber);\n  addUnique(entities.lineNumbers, lineNumber);\n\n  if (rowRefs.length < 25) {\n    let rowRef = { rowNumber: r + 1 };\n    if (!isBlank(transactionNumber)) rowRef.transactionNumber = String(transactionNumber).trim();\n    if (!isBlank(paymentScheduleId)) rowRef.paymentScheduleId = String(paymentScheduleId).trim();\n    if (!isBlank(customerTransactionId)) rowRef.customerTransactionId = String(customerTransactionId).trim();\n    if (!isBlank(customerAccountId)) rowRef.customerAccountId = String(customerAccountId).trim();\n    if (!isBlank(accountNumber)) rowRef.accountNumber = String(accountNumber).trim();\n    if (!isBlank(customerName)) rowRef.customerName = String(customerName).trim();\n    if (!isBlank(receiptNumber)) rowRef.receiptNumber = String(receiptNumber).trim();\n    if (!isBlank(receiptReference)) rowRef.receiptReference = String(receiptReference).trim();\n    if (!isBlank(promiseId)) rowRef.promiseId = String(promiseId).trim();\n    if (!isBlank(disputeId)) rowRef.disputeId = String(disputeId).trim();\n    if (!isBlank(dunningLevel)) rowRef.dunningLevel = String(dunningLevel).trim();\n    if (!isBlank(salesOrderNumber)) rowRef.salesOrderNumber = String(salesOrderNumber).trim();\n    if (!isBlank(lineNumber)) rowRef.lineNumber = String(lineNumber).trim();\n    rowRefs.push(rowRef);\n  }\n}\n\nfunction inferPrimaryEntityType(intentValue, entityMap) {\n  let normalizedIntent = String(intentValue || '').toUpperCase();\n  if (normalizedIntent === 'CUSTOMER_PROFILE_QUERY') return 'customerAccount';\n  if (normalizedIntent === 'PAYMENT_SCHEDULE_QUERY' || normalizedIntent === 'DISPUTE_PAYMENT_SCHEDULE_QUERY') return 'invoice';\n  if (normalizedIntent === 'PROMISE_QUERY' || normalizedIntent === 'PROMISE_PROFILE_QUERY' || normalizedIntent === 'DISPUTE_PROMISE_QUERY') return 'promise';\n  if (normalizedIntent === 'TRANSACTION_DETAIL_QUERY') return 'transactionLine';\n  if (normalizedIntent === 'DISPUTE_DETAIL_QUERY') return 'dispute';\n  if (normalizedIntent === 'RECEIPT_DETAIL_QUERY' || normalizedIntent === 'RECEIPT_SUMMARY_QUERY') return 'receipt';\n  if (normalizedIntent === 'COLLECTIONS_DUNNING_QUERY') return 'dunning';\n  if (normalizedIntent === 'RECEIVABLES_BALANCES_QUERY') return 'summary';\n  if (entityMap.transactionNumbers.length > 0) return 'invoice';\n  if (entityMap.customerNames.length > 0 || entityMap.accountNumbers.length > 0) return 'customerAccount';\n  if (entityMap.receiptNumbers.length > 0) return 'receipt';\n  return 'record';\n}\n\nlet referenceableEntityTypes = [];\nfor (let entityName in entities) {\n  if (Object.prototype.hasOwnProperty.call(entities, entityName) && entities[entityName].length > 0) {\n    referenceableEntityTypes.push(entityName);\n  }\n}\n\nlet routePagination = routedConfig && routedConfig.pagination && typeof routedConfig.pagination === 'object' ? routedConfig.pagination : null;\nlet activeQuery = routedConfig && routedConfig.activeQuery ? routedConfig.activeQuery : '';\nlet baseSqlWithoutPagination = routePagination && routePagination.baseSqlWithoutPagination ? String(routePagination.baseSqlWithoutPagination) : stripPaginationClause(activeQuery);\nlet pageLimit = routePagination && routePagination.displayLimit ? positiveNumber(routePagination.displayLimit, 10) : (inferFetchLimit(activeQuery) || rows.length || 10);\nlet pageOffset = routePagination && routePagination.offset !== undefined ? positiveNumber(routePagination.offset, 0) : inferOffset(activeQuery);\nlet nextOffset = pageOffset + rows.length;\nlet isPaginatedPage = !!(routePagination && routePagination.isPagination === true);\nlet pageStart = rows.length > 0 ? pageOffset + 1 : pageOffset;\nlet pageEnd = pageOffset + rows.length;\n\nlet currentDisplayContext = {\n  hasRecords: hasRecords,\n  rowCount: rows.length,\n  pageOffset: pageOffset,\n  pageLimit: pageLimit,\n  nextOffset: nextOffset,\n  isPaginatedPage: isPaginatedPage,\n  pageStart: pageStart,\n  pageEnd: pageEnd,\n  primaryEntityType: inferPrimaryEntityType(intent, entities),\n  intent: intent,\n  flowLabel: flowLabel,\n  entities: entities,\n  rowRefs: rowRefs,\n  updatedAt: $context.$system.$currentDateTime\n};\n\nlet paginationContext = null;\nif (baseSqlWithoutPagination && /^select\\b/i.test(baseSqlWithoutPagination)) {\n  paginationContext = {\n    enabled: true,\n    intent: intent,\n    flowLabel: flowLabel,\n    baseSqlWithoutPagination: baseSqlWithoutPagination,\n    displayLimit: pageLimit,\n    offset: pageOffset,\n    nextOffset: nextOffset,\n    isPaginatedPage: isPaginatedPage,\n    pageStart: pageStart,\n    pageEnd: pageEnd,\n    lastReturnedCount: rows.length,\n    hasRecords: hasRecords,\n    currentPageEntityRefs: entities,\n    updatedAt: $context.$system.$currentDateTime\n  };\n}\n\nlet lastResult = {\n  hasRecords: hasRecords,\n  rowCount: rows.length,\n  primaryEntityType: inferPrimaryEntityType(intent, entities),\n  intent: intent,\n  flowLabel: flowLabel,\n  isPaginatedPage: isPaginatedPage,\n  sourceQuestion: $context.$system.$inputMessage || '',\n  rewrittenQuestion: $context.$nodes.DISAMBIGUATIONREWRITE && $context.$nodes.DISAMBIGUATIONREWRITE.$output && $context.$nodes.DISAMBIGUATIONREWRITE.$output.rewrittenQuestion ? $context.$nodes.DISAMBIGUATIONREWRITE.$output.rewrittenQuestion : '',\n  entities: entities,\n  rowRefs: rowRefs,\n  currentDisplayContext: currentDisplayContext,\n  pagination: paginationContext,\n  referenceableEntityTypes: referenceableEntityTypes,\n  noDataMessage: noDataMessage,\n  updatedAt: $context.$system.$currentDateTime\n};\n\nlet output = {};\nfor (let existingKey in existing) {\n  if (Object.prototype.hasOwnProperty.call(existing, existingKey)) {\n    output[existingKey] = existing[existingKey];\n  }\n}\n\nlet history = Array.isArray(existing.resultHistory) ? existing.resultHistory.slice(0) : [];\nif (existing.lastResult && typeof existing.lastResult === 'object' && !Array.isArray(existing.lastResult)) {\n  history.unshift(existing.lastResult);\n}\nwhile (history.length > 3) {\n  history.pop();\n}\n\nfunction updateScalarFromList(fieldName, list) {\n  if (list.length === 1) {\n    output[fieldName] = list[0];\n  } else if (list.length > 1) {\n    output[fieldName] = '';\n  }\n}\n\nupdateScalarFromList('transactionNumber', entities.transactionNumbers);\nupdateScalarFromList('receiptNumber', entities.receiptNumbers);\noutput.transactionNumbers = entities.transactionNumbers;\noutput.paymentScheduleIds = entities.paymentScheduleIds;\noutput.customerTransactionIds = entities.customerTransactionIds;\noutput.customerAccountIds = entities.customerAccountIds;\noutput.receiptNumbers = entities.receiptNumbers;\noutput.receiptReferences = entities.receiptReferences;\noutput.accountNumbers = entities.accountNumbers;\noutput.customerNames = entities.customerNames;\noutput.promiseIds = entities.promiseIds;\noutput.disputeIds = entities.disputeIds;\noutput.salesOrderNumbers = entities.salesOrderNumbers;\noutput.lineNumbers = entities.lineNumbers;\noutput.dunningLevels = entities.dunningLevels;\noutput.dunningStatuses = entities.dunningStatuses;\noutput.promiseStatuses = entities.promiseStatuses;\noutput.disputeStatuses = entities.disputeStatuses;\noutput.disputeReasons = entities.disputeReasons;\noutput.currentDisplayContext = currentDisplayContext;\nif (paginationContext) output.paginationContext = paginationContext;\noutput.paginationRequest = {\n  isPaginationRequest: false,\n  direction: '',\n  requestedLimit: null,\n  hasPreviousPagination: !!paginationContext\n};\nupdateScalarFromList('customerName', entities.customerNames);\nupdateScalarFromList('accountNumber', entities.accountNumbers);\nupdateScalarFromList('salesOrderNumber', entities.salesOrderNumbers);\nupdateScalarFromList('dunningLevel', entities.dunningLevels);\nupdateScalarFromList('dunningStatus', entities.dunningStatuses);\nupdateScalarFromList('promiseStatus', entities.promiseStatuses);\nupdateScalarFromList('disputeStatus', entities.disputeStatuses);\nupdateScalarFromList('disputeReason', entities.disputeReasons);\n\noutput.lastResult = lastResult;\noutput.resultHistory = history;\noutput.updatedAt = $context.$system.$currentDateTime;\n\nlet result = {\n  output: output,\n  timeout: timeout,\n  error: error\n};\n\nreturn result;"
          },
