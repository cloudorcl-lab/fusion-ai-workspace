            "returnType": "object",
            "sourceCode": "let disambig = $context.$nodes.DISAMBIGUATIONREWRITE && $context.$nodes.DISAMBIGUATIONREWRITE.$output;\nlet existing = $context.$variables.CurrentContext;\nlet appContext = $context.$app && $context.$app.$OraAppContext;\n\nlet timeout = false;\nlet error = '';\n\nif (typeof existing === 'string') {\n  try {\n    existing = JSON.parse(existing);\n  } catch (e) {\n    existing = null;\n  }\n}\n\nif (!existing || typeof existing !== 'object' || Array.isArray(existing)) {\n  existing = {};\n}\n\nif (typeof appContext === 'string') {\n  try {\n    appContext = JSON.parse(appContext);\n  } catch (e) {\n    appContext = null;\n  }\n}\n\nif (typeof disambig === 'string') {\n  try {\n    disambig = JSON.parse(disambig);\n  } catch (e) {\n    disambig = null;\n  }\n}\n\nfunction isBlank(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction addUnique(list, value) {\n  if (isBlank(value)) return;\n  let item = String(value).trim();\n  for (let i = 0; i < list.length; i++) {\n    if (String(list[i]).toUpperCase() === item.toUpperCase()) return;\n  }\n  if (list.length < 50) list.push(item);\n}\n\nfunction toArray(value) {\n  let output = [];\n  if (Array.isArray(value)) {\n    for (let i = 0; i < value.length; i++) addUnique(output, value[i]);\n  } else if (!isBlank(value)) {\n    addUnique(output, value);\n  }\n  return output;\n}\n\nfunction copyArray(value) {\n  return toArray(value);\n}\n\nfunction singleFrom(list) {\n  return list.length === 1 ? list[0] : '';\n}\n\nfunction getAppCustomerAccountId() {\n  if (!appContext || typeof appContext !== 'object' || Array.isArray(appContext)) return '';\n  return appContext.customerAccountId || appContext.CUSTOMERACCOUNTID || '';\n}\n\nfunction normalizeContext(value) {\n  let result = {\n    transactionNumber: value.transactionNumber || '',\n    transactionNumbers: copyArray(value.transactionNumbers),\n    paymentScheduleIds: copyArray(value.paymentScheduleIds),\n    customerTransactionIds: copyArray(value.customerTransactionIds),\n    receiptNumber: value.receiptNumber || '',\n    receiptNumbers: copyArray(value.receiptNumbers),\n    receiptReferences: copyArray(value.receiptReferences),\n    customerName: value.customerName || '',\n    customerNames: copyArray(value.customerNames),\n    customerAccountId: value.customerAccountId || '',\n    accountNumber: value.accountNumber || '',\n    accountNumbers: copyArray(value.accountNumbers),\n    customerAccountIds: copyArray(value.customerAccountIds),\n    collectorId: value.collectorId || '',\n    salesOrderNumber: value.salesOrderNumber || '',\n    salesOrderNumbers: copyArray(value.salesOrderNumbers),\n    lineNumber: value.lineNumber || '',\n    lineNumbers: copyArray(value.lineNumbers),\n    dunningLevel: value.dunningLevel || '',\n    dunningLevels: copyArray(value.dunningLevels),\n    dunningStatus: value.dunningStatus || '',\n    dunningStatuses: copyArray(value.dunningStatuses),\n    promiseStatus: value.promiseStatus || '',\n    promiseStatuses: copyArray(value.promiseStatuses),\n    promiseState: value.promiseState || '',\n    promiseIds: copyArray(value.promiseIds),\n    disputeStatus: value.disputeStatus || '',\n    disputeStatuses: copyArray(value.disputeStatuses),\n    disputeReason: value.disputeReason || '',\n    disputeReasons: copyArray(value.disputeReasons),\n    disputeType: value.disputeType || '',\n    disputeTypes: copyArray(value.disputeTypes),\n    disputeSection: value.disputeSection || '',\n    disputeSections: copyArray(value.disputeSections),\n    disputeIds: copyArray(value.disputeIds),\n    updatedAt: value.updatedAt || '',\n    lastResult: value.lastResult && typeof value.lastResult === 'object' && !Array.isArray(value.lastResult) ? value.lastResult : null,\n    resultHistory: Array.isArray(value.resultHistory) ? value.resultHistory : [],\n    currentDisplayContext: value.currentDisplayContext && typeof value.currentDisplayContext === 'object' && !Array.isArray(value.currentDisplayContext) ? value.currentDisplayContext : null,\n    paginationContext: value.paginationContext && typeof value.paginationContext === 'object' && !Array.isArray(value.paginationContext) ? value.paginationContext : null,\n    paginationRequest: value.paginationRequest && typeof value.paginationRequest === 'object' && !Array.isArray(value.paginationRequest) ? value.paginationRequest : null\n  };\n\n  if (result.transactionNumbers.length === 0) addUnique(result.transactionNumbers, result.transactionNumber);\n  if (!result.transactionNumber) result.transactionNumber = singleFrom(result.transactionNumbers);\n  if (result.receiptNumbers.length === 0) addUnique(result.receiptNumbers, result.receiptNumber);\n  if (!result.receiptNumber) result.receiptNumber = singleFrom(result.receiptNumbers);\n  if (result.customerNames.length === 0) addUnique(result.customerNames, result.customerName);\n  if (!result.customerName) result.customerName = singleFrom(result.customerNames);\n  if (result.customerAccountIds.length === 0) addUnique(result.customerAccountIds, result.customerAccountId);\n  if (!result.customerAccountId) result.customerAccountId = singleFrom(result.customerAccountIds);\n  if (result.accountNumbers.length === 0) addUnique(result.accountNumbers, result.accountNumber);\n  if (!result.accountNumber) result.accountNumber = singleFrom(result.accountNumbers);\n  if (result.salesOrderNumbers.length === 0) addUnique(result.salesOrderNumbers, result.salesOrderNumber);\n  if (!result.salesOrderNumber) result.salesOrderNumber = singleFrom(result.salesOrderNumbers);\n  if (result.lineNumbers.length === 0) addUnique(result.lineNumbers, result.lineNumber);\n  if (!result.lineNumber) result.lineNumber = singleFrom(result.lineNumbers);\n  if (result.dunningLevels.length === 0) addUnique(result.dunningLevels, result.dunningLevel);\n  if (!result.dunningLevel) result.dunningLevel = singleFrom(result.dunningLevels);\n  if (result.dunningStatuses.length === 0) addUnique(result.dunningStatuses, result.dunningStatus);\n  if (!result.dunningStatus) result.dunningStatus = singleFrom(result.dunningStatuses);\n  if (result.promiseStatuses.length === 0) addUnique(result.promiseStatuses, result.promiseStatus);\n  if (!result.promiseStatus) result.promiseStatus = singleFrom(result.promiseStatuses);\n  if (result.disputeStatuses.length === 0) addUnique(result.disputeStatuses, result.disputeStatus);\n  if (!result.disputeStatus) result.disputeStatus = singleFrom(result.disputeStatuses);\n  if (result.disputeReasons.length === 0) addUnique(result.disputeReasons, result.disputeReason);\n  if (!result.disputeReason) result.disputeReason = singleFrom(result.disputeReasons);\n\n  return result;\n}\n\nfunction hasResolvedField(resolved, scalarName, arrayName) {\n  return !isBlank(resolved[scalarName]) || toArray(resolved[arrayName]).length > 0;\n}\n\nfunction applyResolved(output, resolved, scalarName, arrayName) {\n  if (!hasResolvedField(resolved, scalarName, arrayName)) return;\n  let values = toArray(resolved[arrayName]);\n  addUnique(values, resolved[scalarName]);\n  output[arrayName] = values;\n  output[scalarName] = singleFrom(values);\n}\n\nfunction numberOrNull(value) {\n  if (value === null || value === undefined || value === '') return null;\n  let n = Number(value);\n  if (!isFinite(n) || n <= 0) return null;\n  return Math.floor(n);\n}\n\nfunction detectPaginationRequest(disambigValue) {\n  let request = {\n    isPaginationRequest: false,\n    direction: '',\n    requestedLimit: null\n  };\n\n  if (disambigValue && disambigValue.pagination && typeof disambigValue.pagination === 'object') {\n    request.isPaginationRequest = disambigValue.pagination.isPaginationRequest === true || String(disambigValue.pagination.isPaginationRequest).toLowerCase() === 'true';\n    request.direction = disambigValue.pagination.direction ? String(disambigValue.pagination.direction).toUpperCase() : '';\n    request.requestedLimit = numberOrNull(disambigValue.pagination.requestedLimit);\n  }\n\n  let message = String($context.$system.$inputMessage || '').trim();\n  let normalized = message.toLowerCase();\n  let looksLikePagination =\n    /\\b(show|give|get|list|display)\\s+(me\\s+)?(the\\s+)?(next|more|another|previous|prior)\\b/.test(normalized) ||\n    /\\b(next|previous|prior)\\s+(page|set|batch|rows?|records?|items?)\\b/.test(normalized) ||\n    /\\b(next|previous|prior)\\s+\\d+\\b/.test(normalized) ||\n    /^\\s*(more|next|previous|prior)\\s*$/i.test(message);\n\n  if (looksLikePagination) {\n    request.isPaginationRequest = true;\n    if (/\\b(previous|prior|back)\\b/.test(normalized)) {\n      request.direction = 'PREVIOUS';\n    } else if (!request.direction) {\n      request.direction = 'NEXT';\n    }\n    if (!request.requestedLimit) {\n      let limitMatch = normalized.match(/\\b(\\d{1,3})\\b/);\n      if (limitMatch) request.requestedLimit = numberOrNull(limitMatch[1]);\n    }\n  }\n\n  if (request.direction !== 'PREVIOUS' && request.direction !== 'NEXT') {\n    request.direction = request.isPaginationRequest ? 'NEXT' : '';\n  }\n\n  return request;\n}\n\nlet output = normalizeContext(existing);\nlet paginationRequest = detectPaginationRequest(disambig);\noutput.paginationRequest = paginationRequest;\n\nlet routeHint = disambig && disambig.routeHint ? disambig.routeHint : '';\nlet resolved = disambig && disambig.resolvedContext && typeof disambig.resolvedContext === 'object' ? disambig.resolvedContext : null;\n\nif (!paginationRequest.isPaginationRequest && routeHint === 'RESOLVED' && resolved) {\n  applyResolved(output, resolved, 'transactionNumber', 'transactionNumbers');\n  applyResolved(output, resolved, 'receiptNumber', 'receiptNumbers');\n  applyResolved(output, resolved, 'customerName', 'customerNames');\n  applyResolved(output, resolved, 'customerAccountId', 'customerAccountIds');\n  applyResolved(output, resolved, 'accountNumber', 'accountNumbers');\n  applyResolved(output, resolved, 'salesOrderNumber', 'salesOrderNumbers');\n  applyResolved(output, resolved, 'lineNumber', 'lineNumbers');\n  applyResolved(output, resolved, 'dunningLevel', 'dunningLevels');\n  applyResolved(output, resolved, 'dunningStatus', 'dunningStatuses');\n  applyResolved(output, resolved, 'promiseStatus', 'promiseStatuses');\n  applyResolved(output, resolved, 'disputeStatus', 'disputeStatuses');\n  applyResolved(output, resolved, 'disputeReason', 'disputeReasons');\n  applyResolved(output, resolved, 'disputeType', 'disputeTypes');\n  applyResolved(output, resolved, 'disputeSection', 'disputeSections');\n\n  if (toArray(resolved.paymentScheduleIds).length > 0) output.paymentScheduleIds = toArray(resolved.paymentScheduleIds);\n  if (toArray(resolved.customerTransactionIds).length > 0) output.customerTransactionIds = toArray(resolved.customerTransactionIds);\n  if (toArray(resolved.customerAccountIds).length > 0) output.customerAccountIds = toArray(resolved.customerAccountIds);\n  if (toArray(resolved.receiptReferences).length > 0) output.receiptReferences = toArray(resolved.receiptReferences);\n  if (toArray(resolved.promiseIds).length > 0) output.promiseIds = toArray(resolved.promiseIds);\n  if (toArray(resolved.disputeIds).length > 0) output.disputeIds = toArray(resolved.disputeIds);\n\n  if (!isBlank(resolved.collectorId)) output.collectorId = String(resolved.collectorId).trim();\n  output.updatedAt = $context.$system.$currentDateTime;\n}\n\nlet appCustomerAccountId = getAppCustomerAccountId();\nif (!isBlank(appCustomerAccountId) && isBlank(output.customerAccountId)) {\n  output.customerAccountId = String(appCustomerAccountId).trim();\n}\nif (!isBlank(output.customerAccountId)) {\n  addUnique(output.customerAccountIds, output.customerAccountId);\n}\nif (isBlank(output.customerAccountId)) {\n  output.customerAccountId = singleFrom(output.customerAccountIds);\n}\n\nlet result = {\n  output: output,\n  timeout: timeout,\n  error: error\n};\n\nreturn result;"
