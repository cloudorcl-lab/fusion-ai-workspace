        {
          "metadata": {
            "errorNodeId": "1780552955889",
            "name": "Prepare Receipt Summary AV Payload",
            "returnType": "object",
            "sourceCode": "const boResponse = $context.$nodes.GET_AV_EXTRACT_FOR_RECEIPT_SUMMARY.$output ;\n\n// Collector ID from workflow variable\nconst collectorId = $context.$nodes.FETCH_COLLECTOR_ID.$output.result \n\nconst queries = boResponse.queries;\n\nconst cleanedQueries = queries.map(queryObj => {\n\n  const av = queryObj.analyticViews;\n  const avKey = Object.keys(av)[0];\n  const avObj = av[avKey];\n\n  const aliasToSemantic = {};\n  const depthAliases = new Set();\n\n  const measureAliases = avObj.measureAliases || {};\n  for (const [semanticName, cAlias] of Object.entries(measureAliases)) {\n    aliasToSemantic[cAlias] = semanticName;\n  }\n\n  const dimensions = avObj.dimensions || {};\n  for (const dimKey of Object.values(dimensions)) {\n    for (const hierObj of Object.values(dimKey)) {\n      const aliases = hierObj.aliases || {};\n      for (const [attrName, cAlias] of Object.entries(aliases)) {\n        if (attrName === \"$depth\") {\n          depthAliases.add(cAlias);\n        } else {\n          aliasToSemantic[cAlias] = attrName;\n        }\n      }\n    }\n  }\n\n  const selectStr = queryObj.select;\n  const selectMatch = selectStr.match(/^select\\s+(.*?)\\s+from\\s+(.*)/i);\n  const colsPart = selectMatch[1];\n  const fromPart = selectMatch[2];\n\n  const newCols = colsPart\n    .split(\",\")\n    .map(c => c.trim())\n    .filter(c => !depthAliases.has(c))\n    .map(c => aliasToSemantic[c] || c)\n    .join(\",\");\n\n  const newSelect = `select ${newCols} from ${fromPart}`;\n\n  for (const dimKey of Object.values(avObj.dimensions)) {\n    for (const hierObj of Object.values(dimKey)) {\n      const aliases = hierObj.aliases || {};\n      const newAliases = {};\n      for (const [attrName, cAlias] of Object.entries(aliases)) {\n        if (attrName === \"$depth\") {\n          newAliases[attrName] = cAlias;\n        } else {\n          newAliases[attrName] = attrName;\n        }\n      }\n      hierObj.aliases = newAliases;\n    }\n  }\n\n  avObj.dimensions.collector = {\n    collectorHierarchy: {\n      aliases: {\n        customerCollectorId: \"customerCollectorId\"\n      }\n    }\n  };\n\n  avObj.filter = avObj.filter + ` AND collectorHierarchy.customerCollectorId = '${collectorId}'`;\n\n  const newMeasureAliases = {};\n  for (const [semanticName] of Object.entries(measureAliases)) {\n    newMeasureAliases[semanticName] = semanticName;\n  }\n  avObj.measureAliases = newMeasureAliases;\n\n  return {\n    ...queryObj,\n    select: newSelect,\n    analyticViews: {\n      [avKey]: avObj\n    }\n  };\n});\n\nreturn queries.length === 1 ? cleanedQueries[0] : cleanedQueries;"
          },
          "outcomes": {
            "success": "1779184950569"
          },
          "diagram": {
            "x": 10007,
