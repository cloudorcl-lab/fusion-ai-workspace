            "sourceCode": "let routedConfig = $context.$nodes.ROUTEACTIVECONFIG &&\n    $context.$nodes.ROUTEACTIVECONFIG.$output &&\n    $context.$nodes.ROUTEACTIVECONFIG.$output.result\n    ? $context.$nodes.ROUTEACTIVECONFIG.$output.result.output\n    : null;\n\n  let inputJson = routedConfig ? routedConfig.activeExtract : null;\n  let selectQuery = routedConfig ? routedConfig.activeQuery : null;\n\n  let continueProcess = 1;\n  let timeout = false;\n  let error = '';\n  let output = null;\n  let sql = null;\n\n  // Parse activeExtract if it is a JSON string\n  if (typeof inputJson === 'string') {\n    try {\n      inputJson = JSON.parse(inputJson);\n    } catch (e) {\n      continueProcess = 0;\n      error = 'INVALID_INPUT_JSON_STRING: activeExtract must be valid JSON.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    if (!inputJson || typeof inputJson !== 'object' || Array.isArray(inputJson)) {\n      continueProcess = 0;\n      error = 'MISSING_INPUT_JSON: input must be a JSON object.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    if (!inputJson.viewQueries || typeof inputJson.viewQueries !== 'object' || Array.isArray(inputJson.viewQueries)) {\n      continueProcess = 0;\n      error = 'INVALID_INPUT_JSON: viewQueries object is required.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    if (typeof selectQuery !== 'string') {\n      continueProcess = 0;\n      error = 'MISSING_SELECT_QUERY: selectQuery must be a string.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    sql = selectQuery.trim();\n\n    // Strip all outer double-quote layers\n    while (sql.length >= 2 && sql.charAt(0) === '\"' && sql.charAt(sql.length - 1) === '\"') {\n      sql = sql.substring(1, sql.length - 1).trim();\n    }\n\n    if (!sql || sql.length === 0) {\n      continueProcess = 0;\n      error = 'MISSING_SELECT_QUERY: selectQuery must be a non-empty SQL string.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    sql = sql.replace(/[\\r\\n]+/g, ' ').replace(/\\s+/g, ' ').trim();\n  }\n\n  if (continueProcess === 1) {\n    if (!/^select\\b/i.test(sql)) {\n      continueProcess = 0;\n      error = 'INVALID_SELECT_QUERY: SQL must start with SELECT.';\n    }\n  }\n\n  if (continueProcess === 1) {\n    output = inputJson;\n    output.select = sql;\n    $context.$variables.updatedViewQueryConfig = output;\n  } else {\n    output = null;\n  }\n\n  let result = {\n    output: output,\n    timeout: timeout,\n    error: error\n  };\n\n  return result;"
