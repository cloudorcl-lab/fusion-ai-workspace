          "code": "GET_AV_EXTRACT_FOR_RECEIPT_SUMMARY",
          "id": "1779184506437",
          "inputs": [
            {
              "id": "1779184506437_nlQuestion",
              "name": "nlQuestion",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1779184506437_moduleName",
              "name": "moduleName",
              "value": "oraErpCoreReceivablesPayments"
