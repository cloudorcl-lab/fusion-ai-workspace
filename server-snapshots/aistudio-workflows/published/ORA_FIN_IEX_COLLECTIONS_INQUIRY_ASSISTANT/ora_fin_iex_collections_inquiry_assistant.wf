            "name": "formatExtractLabels",
            "returnType": "object",
            "sourceCode": "let inputJson = $context.$nodes.EXTRACT_DATA.$output;\nlet routedConfig = $context.$nodes.ROUTEACTIVECONFIG && $context.$nodes.ROUTEACTIVECONFIG.$output && $context.$nodes.ROUTEACTIVECONFIG.$output.result ? $context.$nodes.ROUTEACTIVECONFIG.$output.result.output : null;\nlet attributeCatalogJson = routedConfig ? routedConfig.activeCatalog : null;\nlet currencyResourceJson = $context.$variables.CurrencyResource;\nlet userSessionDetails = $context.$nodes.GET_USER_SESSION_DETAILS && $context.$nodes.GET_USER_SESSION_DETAILS.$output && $context.$nodes.GET_USER_SESSION_DETAILS.$output.items && $context.$nodes.GET_USER_SESSION_DETAILS.$output.items[0] ? $context.$nodes.GET_USER_SESSION_DETAILS.$output.items[0] : {};\n\nlet continueProcess = 1;\nlet timeout = false;\nlet error = '';\nlet output = null;\nlet rows = null;\nlet isNoData = false;\n\nfunction isEmptyObject(obj) {\n  return obj && typeof obj === 'object' && !Array.isArray(obj) && Object.keys(obj).length === 0;\n}\n\nif (continueProcess === 1) {\n  if (Array.isArray(inputJson)) {\n    rows = inputJson;\n  } else if (\n    inputJson === null ||\n    inputJson === undefined ||\n    inputJson === '' ||\n    isEmptyObject(inputJson)\n  ) {\n    isNoData = true;\n    output = {\n      message: \"There are no records corresponding to the request made.\"\n    };\n  } else {\n    continueProcess = 0;\n    error = 'INVALID_INPUT: extract output must be an array of objects.';\n  }\n}\n\nlet labelMap = {};\nlet dataTypeMap = {};\nlet attrs = null;\nlet currencyFormatMap = {};\nlet userDateFormat = userSessionDetails.DateFormat || 'MM/dd/yy';\nlet userDecimalSeparator = userSessionDetails.DecimalSeparator || '.';\nlet userGroupingSeparator = userSessionDetails.GroupingSeparator || ',';\n\nif (continueProcess === 1 && !isNoData) {\n  if (attributeCatalogJson && attributeCatalogJson.attributeCatalog && Array.isArray(attributeCatalogJson.attributeCatalog.attributes)) {\n    attrs = attributeCatalogJson.attributeCatalog.attributes;\n  } else {\n    continueProcess = 0;\n    error = 'MISSING_ATTRIBUTE_CATALOG: attributeCatalog.attributes array is required.';\n  }\n}\n\nif (continueProcess === 1 && !isNoData) {\n  for (let i = 0; i < attrs.length; i++) {\n    let a = attrs[i];\n    if (!a || !a.attribute) continue;\n    let attrKey = String(a.attribute).toUpperCase();\n    let lbl = (a.label !== undefined && a.label !== null) ? String(a.label).trim() : '';\n    if (!lbl) lbl = String(a.attribute);\n    labelMap[attrKey] = lbl;\n    dataTypeMap[String(lbl).toUpperCase()] = a.dataType ? String(a.dataType).trim().toUpperCase() : '';\n  }\n}\n\nif (continueProcess === 1) {\n  if (typeof currencyResourceJson === 'string') {\n    try {\n      currencyResourceJson = JSON.parse(currencyResourceJson);\n    } catch (e) {\n      currencyResourceJson = null;\n    }\n  }\n\n  if (Array.isArray(currencyResourceJson)) {\n    for (let c = 0; c < currencyResourceJson.length; c++) {\n      let currencyItem = currencyResourceJson[c];\n      if (!currencyItem || !currencyItem.currency_code) continue;\n\n      let currencyCodeKey = String(currencyItem.currency_code).trim().toUpperCase();\n      currencyFormatMap[currencyCodeKey] = {\n        symbol: currencyItem.symbol,\n        placement: currencyItem.format && currencyItem.format.symbol_placement ? currencyItem.format.symbol_placement : 'prefix',\n        decimalSeparator: currencyItem.format && currencyItem.format.decimal_separator ? String(currencyItem.format.decimal_separator) : '.',\n        thousandsSeparator: currencyItem.format && currencyItem.format.thousands_separator ? String(currencyItem.format.thousands_separator) : 'comma'\n      };\n    }\n  }\n}\n\nlet labeledRows = null;\nlet finalRows = null;\n\nfunction isBlankValue(value) {\n  return value === null || value === undefined || String(value).trim() === '';\n}\n\nfunction normalizeCurrencyCode(value) {\n  if (isBlankValue(value)) return '';\n  return String(value).trim().toUpperCase();\n}\n\nfunction parseAmountValue(value) {\n  if (typeof value === 'number') {\n    return isFinite(value) ? value : null;\n  }\n\n  if (isBlankValue(value)) return null;\n\n  let normalizedValue = String(value).trim().replace(/,/g, '');\n  if (!normalizedValue) return null;\n\n  let parsedValue = Number(normalizedValue);\n  return isFinite(parsedValue) ? parsedValue : null;\n}\n\nfunction getCurrencyFormat(currencyCode) {\n  let normalizedCurrencyCode = normalizeCurrencyCode(currencyCode);\n  if (!normalizedCurrencyCode) return null;\n\n  return currencyFormatMap[normalizedCurrencyCode] || null;\n}\n\nfunction resolveThousandsSeparator(separatorValue) {\n  let normalizedSeparator = String(separatorValue || '').trim().toLowerCase();\n  if (normalizedSeparator === 'comma') return ',';\n  if (normalizedSeparator === 'dot' || normalizedSeparator === 'period') return '.';\n  if (normalizedSeparator === 'space') return ' ';\n  if (normalizedSeparator === 'apostrophe') return \"'\";\n  if (normalizedSeparator.length === 1) return normalizedSeparator;\n  return ',';\n}\n\nfunction normalizeSeparator(separatorValue, fallbackValue) {\n  if (separatorValue === null || separatorValue === undefined) return fallbackValue;\n  let normalizedSeparator = String(separatorValue).trim().toLowerCase();\n  if (normalizedSeparator === 'comma') return ',';\n  if (normalizedSeparator === 'dot' || normalizedSeparator === 'period') return '.';\n  if (normalizedSeparator === 'space') return ' ';\n  if (normalizedSeparator === 'apostrophe') return \"'\";\n  let rawSeparator = String(separatorValue);\n  if (rawSeparator.length > 0) return rawSeparator;\n  return fallbackValue;\n}\n\nfunction addGroupingToIntegerPart(integerPart, separator) {\n  let sign = '';\n  let digits = integerPart;\n\n  if (digits.charAt(0) === '-') {\n    sign = '-';\n    digits = digits.substring(1);\n  }\n\n  return sign + digits.replace(/\\B(?=(\\d{3})+(?!\\d))/g, separator);\n}\n\nfunction splitAmountPar