          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"routeHint\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"RESOLVED\",\n        \"NEEDS_CLARIFICATION\",\n        \"OUT_OF_SCOPE\"\n      ]\n    },\n    \"rewrittenQuestion\": {\n      \"type\": \"string\"\n    },\n    \"clarificationPrompt\": {\n      \"type\": \"string\"\n    },\n    \"ambiguityReason\": {\n      \"type\": \"string\"\n    },\n    \"scopeReason\": {\n      \"type\": \"string\"\n    },\n    \"resolvedContext\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"transactionNumber\": {\n          \"type\": \"string\"\n        },\n        \"transactionNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"paymentScheduleIds\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"customerTransactionIds\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"accountNumber\": {\n          \"type\": \"string\"\n        },\n        \"accountNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"customerName\": {\n          \"type\": \"string\"\n        },\n        \"customerNames\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"receiptNumber\": {\n          \"type\": \"string\"\n        },\n        \"receiptNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"receiptReferences\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"promiseIds\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"disputeIds\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"salesOrderNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"lineNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"collectorId\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"transactionNumber\",\n        \"accountNumber\",\n        \"customerName\",\n        \"collectorId\"\n      ],\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"routeHint\",\n    \"rewrittenQuestion\",\n    \"clarificationPrompt\",\n    \"ambiguityReason\",\n    \"scopeReason\",\n    \"resolvedContext\"\n  ],\n  \"additionalProperties\": false\n}",
