              "value": "{    \"attributeCatalog\": {        \"_meta\": {            \"contractVersion\": \"1.0\",            \"source\": \"ReceivablesReceiptDetailBO\",            \"view\": \"receivablesReceiptDetail\"        },        \"attributes\": [            {                \"attribute\": \"cashReceiptId\",                \"label\": \"Cash Receipt ID\",                \"dataType\": \"NUMBER\",                \"description\": \"Unique identifier of the receipt record.\",                \"synonyms\": [                    \"cash receipt id\"                ]            },            {                \"attribute\": \"receiptDate\",                \"label\": \"Receipt Date\",                \"dataType\": \"DATE\",                \"description\": \"Date when the receipt was recorded.\",                \"synonyms\": [                    \"receipt date\"                ]            },            {                \"attribute\": \"depositDate\",                \"label\": \"Deposit Date\",                \"dataType\": \"DATE\",                \"description\": \"Date when the receipt was deposited.\",                \"synonyms\": [                    \"deposit date\"                ]            },            {                \"attribute\": \"receiptNumber\",                \"label\": \"Receipt Number\",                \"dataType\": \"STRING\",                \"description\": \"Business receipt number used to identify the payment.\",                \"synonyms\": [                    \"receipt number\",                    \"receipt #\"                ]            },            {                \"attribute\": \"receiptType\",                \"label\": \"Receipt Type\",                \"dataType\": \"STRING\",                \"description\": \"Receipt type classification.\",                \"synonyms\": [                    \"receipt type\"                ]            },            {                \"attribute\": \"conversionRate\",                \"label\": \"Conversion Rat