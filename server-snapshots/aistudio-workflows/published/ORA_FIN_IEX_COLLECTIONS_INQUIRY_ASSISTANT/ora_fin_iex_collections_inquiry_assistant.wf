              "id": "1777000000001_DisputeAttributeCatalog",
              "name": "DisputeAttributeCatalog",
              "value": "{    \"attributeCatalog\": {        \"_meta\": {            \"contractVersion\": \"1.0\",            \"source\": \"ReceivablesDisputeDetailBO\"        },        \"attributes\": [            {                \"attribute\": \"requestId\",                \"label\": \"Request ID\",                \"dataType\": \"NUMBER\",                \"description\": \"Unique dispute request identifier.\"            },            {                \"attribute\": \"customerTransactionId\",                \"label\": \"Customer Transaction ID\",                \"dataType\": \"NUMBER\",                \"description\": \"Customer transaction identifier linked to the dispute request.\"            },            {                \"attribute\": \"lineAmount\",                \"label\": \"Line Amount\",                \"dataType\": \"DECIMAL\",                \"description\": \"Dispute line amount.\"            },            {                \"attribute\": \"taxAmount\",                \"label\": \"Tax Amount\",                \"dataType\": \"DECIMAL\",                \"description\": \"Tax amount under dispute.\"            },            {                \"attribute\": \"freightAmount\",                \"label\": \"Freight Amount\",                \"dataType\": \"DECIMAL\",                \"description\": \"Freight amount under dispute.\"            },            {                \"attribute\": \"totalAmount\",                \"label\": \"Total Amount\",                \"dataType\": \"DECIMAL\",                \"description\": \"Total dispute amount.\"            },            {                \"attribute\": \"approvalDate\",                \"label\": \"Approval Date\",                \"dataType\": \"DATE\",                \"description\": \"Date the dispute was approved.\"            },            {                \"attribute\": \"originalTransactionNumber\",                \"label\": \"Original Transaction Number\",                \"dataType\": \"STRING\",            