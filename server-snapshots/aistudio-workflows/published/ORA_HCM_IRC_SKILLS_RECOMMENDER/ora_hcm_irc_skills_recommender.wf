            "name": "Get Last Updated Date",
            "returnType": "object",
            "sourceCode": "const latestPublicSkillNode = $context.$nodes.GET_LATEST_PUBLIC_SKILL;\nconst data = latestPublicSkillNode && latestPublicSkillNode.$output && Array.isArray(latestPublicSkillNode.$output.items)\n    ? latestPublicSkillNode.$output.items\n    : [];\nlet latestDate = null;\n\nif (data.length > 0 && data[0] && data[0].LastUpdateDate != null) {\n    latestDate = data[0].LastUpdateDate;\n}\n\nreturn latestDate;"
          },
