        {
          "metadata": {
            "name": "Collate Output",
            "returnType": "object",
            "sourceCode": "const coursesNode = $context.$nodes.GET_SKILLS_FROM_ALL_LEARNINGS;\nconst gigsNode = $context.$nodes.GET_SKILLS_FROM_ALL_GIGS;\nconst skillsLastUpdatedNode = $context.$nodes.GET_LAST_UPDATED_DATE;\nconst courses = coursesNode && coursesNode.$output ? coursesNode.$output : [];\nconst gigs = gigsNode && gigsNode.$output ? gigsNode.$output : [];\nconst skillsLastUpdated = skillsLastUpdatedNode && skillsLastUpdatedNode.$output ? skillsLastUpdatedNode.$output.result : null;\nconst output = {\n    \"courses\": courses,\n    \"gigs\": gigs,\n    \"skillsLastUpdateDate\": skillsLastUpdated\n};\n\nreturn output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COLLATE_OUTPUT",
          "id": "1767696882991",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
