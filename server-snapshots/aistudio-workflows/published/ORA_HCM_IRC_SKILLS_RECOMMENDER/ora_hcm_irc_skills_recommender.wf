                  "id": "1767097295442",
                  "inputs": [
                    {
                      "id": "1767097316172_1",
                      "name": "recruitingOppMktGigDetails_Id",
                      "type": "string",
                      "value": "{{$context.$nodes.GET_SKILLS_FROM_ALL_GIGS.$currentItem.GigId}}"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"Gig\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"GigId\": {\n      \"type\": \"integer\"\n    },\n    \"GigNumber\": {\n      \"type\": \"string\"\n    },\n    \"Title\": {\n      \"type\": \"string\"\n    },\n    \"gigSkills\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SkillId\": { \"type\": \"integer\" },\n          \"Skills\": { \"type\": [ \"string\", \"null\" ] },\n          \"ProfileId\": { \"type\": \"integer\" },\n          \"SectionId\": { \"type\": \"integer\" },\n          \"ContentItemId\": { \"type\": \"integer\" },\n          \"SkillName\": { \"type\": \"string\" },\n          \"Source\": { \"type\": [ \"string\", \"null\" ] }\n        },\n        \"required\": [\n          \"SkillId\",\n          \"Skills\",\n          \"ProfileId\",\n          \"SectionId\",\n          \"ContentItemId\",\n          \"SkillName\",\n          \"Source\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"GigId\",\n    \"GigNumber\",\n    \"Title\",\n    \"gigSkills\"\n  ]\n}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Extract Skill Names",
                    "returnType": "object",
                    "sourceCode": "const gigSkills = $context.$nodes.GET_SKILLS_FROM_ALL_GIGS.GET_GIG_SKILLS.$output.gigSkills;\nconst title = $context.$nodes.GET_SKILLS_FROM_ALL_GIGS.GET_GIG_SKILLS.$output.Title;\nlet skillNames = [];\nconst obj = {};\nif (gigSkills && Array.isArray(gigSkills.items)) {\n    skillNames = gigSkills.items.map(skill => skill.SkillName).filter(name => name !== null);\n}\n\nobj.title = title;\nobj.type = 'Gig';\nobj.skills = skillNames;\n\nreturn obj;"
                  },
                  "outcomes": {
                    "success": "end_1767016257197"
                  },
                  "code": "EXTRACT_SKILL_NAMES",
                  "id": "1767101737300",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
              ],
              "rootNode": "start_1767016257197"
