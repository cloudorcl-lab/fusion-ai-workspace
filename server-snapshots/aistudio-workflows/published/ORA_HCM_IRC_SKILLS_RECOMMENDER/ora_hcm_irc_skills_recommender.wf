                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"learningItemId\": { \"type\": \"string\" },\n    \"learningItemNumber\": { \"type\": \"string\" },\n    \"learningItemType\": { \"type\": \"string\" },\n    \"learningItemTitle\": { \"type\": \"string\" },\n    \"learningItemDescription\": { \"type\": \"string\" },\n    \"liShortDescription\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"learningItemId\",\n    \"learningItemNumber\",\n    \"learningItemType\",\n    \"learningItemTitle\",\n    \"learningItemDescription\",\n    \"liShortDescription\"\n  ]\n}",
