ingItemType\",\n              \"assignmentSubStatus\",\n              \"assignedOnDate\",\n              \"learningItemTitle\",\n              \"assignmentType\",\n              \"assignmentRecordId\",\n              \"assignmentStateMeaning\",\n              \"learningItemStartDateUTC\",\n              \"learningItemTypeMeaning\",\n              \"assignmentDueDate\",\n              \"assignmentSubType\",\n              \"learningItemSubType\",\n              \"assignmentStateSeverity\",\n              \"completionDate\",\n              \"learningItemId\"\n            ]\n          }\n        }\n      },\n      \"required\": [\"items\"]\n    }\n  },\n  \"required\": [\"result\"]\n}",
          "type": "BO_FUNCTION"
        },
