          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"PublicSkills\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"SkillId\": { \"type\": \"string\" },\n          \"Skill\": { \"type\": [\"string\", \"null\"] },\n          \"SkillName\": { \"type\": [\"string\", \"null\"] },\n          \"LastUpdateDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": { \"type\": \"string\" },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": { \"type\": \"string\" }\n                },\n                \"required\": [\"ETag\"]\n              }\n            },\n            \"required\": [\"key\", \"headers\"]\n          }\n        },\n        \"required\": [\n          \"SkillId\",\n          \"LastUpdateDate\",\n          \"@context\"\n        ]\n      }\n    },\n    \"count\": { \"type\": \"number\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"number\" },\n    \"offset\": { \"type\": \"number\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"rel\": { \"type\": \"string\" },\n          \"href\": { \"type\": \"string\" },\n          \"name\": { \"type\": \"string\" },\n          \"kind\": { \"type\": \"string\" }\n        },\n        \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n      }\n    }\n  },\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"]\n}",
