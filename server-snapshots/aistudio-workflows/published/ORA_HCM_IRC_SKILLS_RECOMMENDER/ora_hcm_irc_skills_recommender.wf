                {
                  "metadata": {
                    "modelConfiguration": {
                      "modelProperties": {
                        "k": 0,
                        "max_tokens": 32000,
                        "p": 0.75
                      },
                      "code": "ORA_LLM_PREMIUM",
                      "model": "OPEN_AI_GPT_4_1_MINI",
                      "modelName": "GPT-4.1 mini",
                      "provider": "CERT_PREMIUM"
                    },
                    "name": "Suggest Skill Names"
                  },
                  "outcomes": {
                    "success": "end_1767016310733"
                  },
                  "code": "SUGGEST_SKILL_NAMES",
                  "id": "1767104886095",
                  "inputs": [
                    {
                      "id": "1767104886097_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are an expert in curriculum design and skills mapping. Given the following learning item:\n{{$context.$nodes.GET_SKILLS_FROM_ALL_LEARNINGS.GET_LEARNING_DESCRIPTION.$output}}\n\nSuggest up to two or three skill names strictly and only based on the information found in the learningItemTitle, learningItemDescription, and liShortDescription.\nDo NOT include generic skills that are not clearly connected to the provided text. Do NOT recommend unknown skills for words that might be found in these fields, only recommend well-known skills available in your knowledge.\nAvoid assuming implicit skills; derive each skill directly from specific wording or clear concepts in these fields.\nReturn your response as a JSON object with title property as the value of learningItemTitle, type property as 'Course' and skills property as an array of strings.\nDo not include any explanations or commentary: just the object."
                    }
                  ],
                  "outputSpecification": "{\n  \"title\": \"Course\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": {\n      \"type\": \"string\",\n      \"description\": \"Title of the course\"\n    },\n    \"type\": {\n      \"type\": \"string\",\n      \"description\": \"Indicates that this is a course\"\n    },\n    \"skills\": {\n      \"type\": \"array\",\n      \"description\": \"List of skill names\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\"title\", \"type\", \"skills\"],\n  \"additionalProperties\": false\n}",
