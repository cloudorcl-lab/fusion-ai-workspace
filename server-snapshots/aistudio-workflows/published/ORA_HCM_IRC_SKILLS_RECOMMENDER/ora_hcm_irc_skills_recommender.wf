          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"GigApplicationId\": { \"type\": \"string\" },\n          \"GigApplicationStatus\": { \"type\": \"string\" },\n          \"PersonId\": { \"type\": \"string\" },\n          \"GigId\": { \"type\": \"string\" },\n          \"GigCreatorId\": { \"type\": \"string\" },\n          \"GigManagerId\": { \"type\": \"string\" },\n          \"GigTitle\": { \"type\": \"string\" },\n          \"PostedDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"StartDate\": { \"type\": \"string\", \"format\": \"date\" },\n          \"EndDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date\" },\n          \"GigStatus\": { \"type\": \"string\" },\n          \"GigNumber\": { \"type\": \"string\" },\n          \"TimeCommitment\": { \"type\": [\"string\", \"null\"] },\n          \"ApplicationDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n          \"GigCreatorName\": { \"type\": \"string\" },\n          \"GigCreatorEmail\": { \"type\": [\"string\", \"null\"], \"format\": \"email\" },\n          \"RemoteOpportunity\": { \"type\": \"string\" },\n          \"Location\": { \"type\": \"string\" }\n        },\n        \"required\": [\n          \"GigApplicationId\",\n          \"GigApplicationStatus\",\n          \"PersonId\",\n          \"GigId\",\n          \"GigCreatorId\",\n          \"GigManagerId\",\n          \"GigTitle\",\n          \"PostedDate\",\n          \"StartDate\",\n          \"GigStatus\",\n          \"GigNumber\",\n          \"ApplicationDate\",\n          \"GigCreatorName\",\n          \"RemoteOpportunity\",\n          \"Location\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"links\"\n  ]\n}",
