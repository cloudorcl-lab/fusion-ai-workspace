          "metadata": {
            "businessObjectCode": "ORA_SCM_MANUFACTUR_KSAKANBANPULLSEQUENCESPOUBO",
            "functionName": "get_kanbanPullSequences",
            "processJson": true,
            "name": "Get pull Sequence details"
          },
          "outcomes": {
            "success": "1774266510169"
          },
          "code": "GET_PULL_SEQUENCE_DETAILS",
          "id": "1773822965914",
          "inputs": [
            {
              "id": "1773824304913_1",
              "name": "kanbanPullSequences_Id",
              "type": "string",
              "value": "{{$context.$nodes.CHECK.$output.result.pullSequenceId}}"
            }
          ],
          "outputSpecification": "{}",
