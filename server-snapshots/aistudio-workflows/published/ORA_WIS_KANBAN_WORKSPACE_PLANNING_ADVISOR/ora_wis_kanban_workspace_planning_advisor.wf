          "code": "GET_DEVIATED_PULL_SEQUENCE_FOR_QUERY",
          "id": "1773738332652",
          "inputs": [
            {
              "id": "1773738384781_1",
              "name": "pOrganizationId",
              "type": "string",
              "value": "{{$context.$variables.organizationId}}"
            },
            {
              "id": "1773738384782_2",
              "name": "pThreshold",
              "type": "string",
