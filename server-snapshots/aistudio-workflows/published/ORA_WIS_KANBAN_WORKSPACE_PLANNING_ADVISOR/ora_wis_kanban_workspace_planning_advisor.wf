              "value": "{{$context.$variables.days}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD",
                "ORA_LAYOUT_RECORD"
              ],
              "enableActions": true,
              "enableCommunications": false,
              "customNotes": "## Goal\nRender a single multiRecordWidget from:\n{{$context.$nodes.FIND_TOP_3.$output.result}}\n\n## Strict Output Rules\n- Output ONLY the multiRecordWidget OR, if there are no rows, output exactly:\nNo items to show\n- Do not output any other text.\n- Show all input rows.\n\n## Columns (EXACT order)\n1) Item Number\n2) Kanban Plan Code\n3) Point of Use (Subinv:Locator)\n4) Method\n5) Calculated\n6) Current\n7) % Change\n\n## Column Value Rules\n- Item Number: use the row’s item number field.\n- Kanban Plan Code: use the row’s kanban plan code field.\n- Point of Use (Subinv:Locator):\n  - If Locator present: SubinventoryCode:Locator\n  - Else: SubinventoryCode\n- Method: exactly \"Cards\" if the row’s calculation method indicates cards; else \"Size\".\n- Calculated:\n- If Method = Cards: use ceil(CalculatedCards) (round up to next highest integer).\n- If Method = Size: use ceil(CalculatedSize) (round up to next highest integer).\n- Current: if Method=Cards use current cards; else current size.\n- % Change: use the row’s diff percentage value.\n\n## Conditional formatting (% Change only)\n- >= +20%(positive) : green\n- <= -20% (negative): red\n\n- else: default\n\nAdd a row level action for multiRecordWidget for each row:\n{\n  \"title\": \"Update Pull Sequences - <item>\",\n  \"shortDescription\": \"updates the number of kanban cards in pull sequences\",\n  \"actionText\": \"Update Pull Sequences\",\n  \"followUpCommand\": ora.Invoke(updatePullSequences, updatePullSequences-<pullSequenceId>-<numberOfRequiredCards>),\n  \"Prioritize\": false\n}\n\nReplace:\n- <item> with the Item Number for that row\n- <pullSequenceId> with that row’s pullSequenceId\n- <numberOfRequiredCards> ceil(CalculatedCards) when Method=Cards, else ceil(CalculatedSize)\nJust output one line saying the default safety threshold used is 20%."
            }
          },
          "metadata": {
            "name": "Format Final Answer For Init"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_FINAL_ANSWER_FOR_INIT",
          "id": "1773738415795",
          "inputs": [
            {
              "id": "1773738415796_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given an array of pull sequence records:\n{{$context.$nodes.FIND_TOP_3.$output.result}}\n\nEach object in this array represents one pull sequence row. Use only these records and do not infer missing fields."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableActions": true,
              "enableCommunications": false
            }
          },
          "metadata": {
            "name": "Format Final Answer for query"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FORMAT_FINAL_ANSWER_FOR_QUERY",
          "id": "1773738476987",
          "inputs": [
            {
              "id": "1773738476989_1",
              "name": "prompt",
              "type": "string",
              "value": "You are the final response generator for a pull-sequence deviation query.\n\nINPUT ROWS (authoritative):\n{{$context.$nodes.GET_FINAL_ARRAY.$output.result.items}}\n\nUSER QUERY:\n{{$context.$system.$inputMessage}}\n\nTASK:\n- If input rows are empty, output exactly:\nNo items to show\n- Otherwise, output exactly one multiRecordWidget.\n\nSTRICT RULES:\n- Output ONLY the multiRecordWidget (or exactly \"No items to show\" when empty).\n- Let N = number of input rows.\n- Widget row count must be exactly N (1:1 mapping).\n- Preserve input order exactly.\n- Do not summarize, merge, rank, deduplicate, omit, or add rows.\n- Do not show IDs in visible columns/text.\n- IDs are allowed only inside followUpCommand.\n\nCOLUMNS (exact order):\n1) Item Number\n2) Kanban Plan Code\n3) Point of Use (Subinv:Locator)\n4) Method\n5) Calculated\n6) Current\n7) % Change\n\nVALUE RULES:\n- Item Number = ItemNumber\n- Kanban Plan Code = KanbanPlanCode\n- Point of Use = SubinventoryCode:Locator if Locator exists, else SubinventoryCode\n- Method = \"Cards\" if KanbanCalculationMethod == \"CALCULATE_KANBAN_CARDS\", else \"Size\"\n- Calculated = ceil(CalculatedCards) if Method=Cards, else ceil(CalculatedSize)\n- Current = NumberOfCards if Method=Cards, else KanbanSize\n- % Change = CalculatedDiffPercentage\n\nCONDITIONAL FORMATTING (% Change):\n- >= 20: green\n- <= -20: red\n- else: default\n\nROW ACTION (required for every row):\n{\n  \"title\": \"Update Pull Sequences - <item>\",\n  \"shortDescription\": \"updates the number of kanban cards in pull sequences\",\n  \"actionText\": \"Update Pull Sequences\",\n  \"followUpCommand\": \"ora.Invoke(updatePullSequences,{\\\"agent\\\":\\\"ORA_WIS_KANBAN_PLANNING_AGENT\\\",\\\"pullSequenceId\\\":\\\"<pullSequenceId>\\\",\\\"numberOfRequiredCards\\\":\\\"<numberOfRequiredCards>\\\"})\",\n  \"Prioritize\": false\n}\n\nREPLACE:\n- <item> = ItemNumber\n- <pullSequenceId> = PullSequenceId\n- <numberOfRequiredCards> = ceil(CalculatedCards) if Method=Cards, else ceil(CalculatedSize)\n"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Find top 3",
            "returnType": "array",
            "sourceCode": "let payload= $context.$nodes.GET_ALL_DEVIATED_PULL_SEQUENCES.$output;\nconst top3 = (payload?.items ?? [])\n  .filter(i => i && i.CalculatedDiffPercentage != null)\n  .filter(i => Math.abs(Number(i.CalculatedDiffPercentage) || 0) >=20)\n  .sort((a, b) => (Number(b.CalculatedDiffPercentage)||0) - (Number(a.CalculatedDiffPercentage)||0))\n  .slice(0, 3);\n\nreturn top3;"
          },
          "outcomes": {
            "success": "1773817800981"
          },
          "code": "FIND_TOP_3",
          "id": "1773743055168",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Decide Intent"
          },
          "outcomes": {
            "success": "1773816016206"
          },
          "code": "DECIDE_INTENT",
          "id": "1773814198548",
          "inputs": [
            {
              "id": "1773814198549_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent-and-parameter extraction assistant for a pull-sequence deviation query API.\n\n[TASK]\nGiven a user’s natural-language query: {{$context.$system.$inputMessage}}, extract any of the following parameters if explicitly present:\n- threshold (optional): a numeric percentage that represents the deviation threshold above/below which pull sequences should be returned.\n- days (optional): a non-negative integer representing how many days from today may be added for the plan start date window.\n- itemNumbers (optional): one or more item identifiers if the user specifies item number(s).\n- pointsOfUse (optional): one or more point-of-use/subinventory/locator values if the user specifies them.\n\n[OUTPUT REQUIREMENTS — STRICT]\n- Output only a single JSON object.\n- The JSON must have exactly these keys (always present):\n  - \"threshold\" (number)\n  - \"days\" (number)\n  - \"itemNumbers\" (array)\n  - \"pointsOfUse\" (array)\n- If a field is not provided in the query, set:\n  - threshold: 0\n  - days: 0\n  - itemNumbers: []\n  - pointsOfUse: []\n- Do not include any extra keys, commentary, or formatting.\n\n[EXTRACTION RULES]\n\n1) Threshold\n- If the user states a percent like: 20%, +20%, -20%, 20 percent, 20 pct\n  -> extract the numeric value as a positive number (absolute value).\n  Example: “over -20%” -> \"threshold\": 20\n- If the user says “show all”, “no threshold”, “any deviation”, or provides no percentage\n  -> \"threshold\": 0\n\n2) Days\n- If the user says “next N days”, “within N days”, “for N days”, “N-day window”\n  -> extract \"days\" = N (non-negative integer).\n- If not mentioned -> \"days\": 0\n\n3) Item numbers (array)\n- Extract when the user clearly references item number(s)\n  (e.g., “item 12345”, “ItemNumber 12345”, “for items ABC-123 and XYZ-9”).\n- Return all detected item numbers in \"itemNumbers\" as an array of strings.\n- Preserve each item number exactly as written (trim surrounding quotes/spaces).\n- Do not invent values. If none explicitly provided, return [].\n\n4) Points of use (array)\n- Extract when the user names point(s) of use / subinventory / locator\n  (e.g., “point of use A1”, “Subinv FG”, “locator L-01”, “FG:L-01”).\n- Return all detected values in \"pointsOfUse\" as an array of strings.\n- Preserve each value as provided by the user (trim surrounding quotes/spaces); do not reformat.\n- Do not invent values. If none explicitly provided, return [].\n\n[DISAMBIGUATION / MISSING INFO]\n- If multiple thresholds/days are mentioned, pick the most specific filtering instruction\n  (usually the largest stated threshold for filtering, and the most recent/explicit days window).\n- If the query is ambiguous and does not explicitly provide a value, default to 0/[] as specified (do not guess).\n\n[EXAMPLES — FOLLOW THESE PATTERNS; DO NOT OUTPUT THESE]\nUser: \"Show deviations above 20% for the next 7 days\"\nOutput: {\"threshold\":20,\"days\":7,\"itemNumbers\":[],\"pointsOfUse\":[]}\n\nUser: \"Find pull sequences for items ABC-123 and XYZ-9 at FG:L-01 and RM:LOC2\"\nOutput: {\"threshold\":0,\"days\":0,\"itemNumbers\":[\"ABC-123\",\"XYZ-9\"],\"pointsOfUse\":[\"FG:L-01\",\"RM:LOC2\"]}\n\nUser: \"Any deviations for Subinv FG within 3 days\"\nOutput: {\"threshold\":0,\"days\":3,\"itemNumbers\":[],\"pointsOfUse\":[\"FG\"]}\n\n[NOW PERFORM EXTRACTION]\nUSER QUERY:\n{{$context.$system.$inputMessage}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Threshold and Days"
          },
          "outcomes": {
            "success": "1773738332652"
          },
          "code": "SET_THRESHOLD_AND_DAYS",
          "id": "1773816016206",
          "inputs": [
            {
              "id": "1773816045560",
              "name": "days",
              "scope": "JOB",
              "type": "number",
              "value": "{{$context.$nodes.DECIDE_INTENT.$output.days}}"
            },
            {
              "id": "1773816021125",
              "name": "threshold",
              "scope": "JOB",
              "type": "number",
              "value": "{{$context.$nodes.DECIDE_INTENT.$output.threshold}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Get Final Array",
            "returnType": "object",
            "sourceCode": "const source = $context.$nodes.GET_DEVIATED_PULL_SEQUENCE_FOR_QUERY.$output;\nconst items = Array.isArray(source?.items) ? source.items : [];\n\nconst itemNumbers = Array.isArray($context.$nodes.DECIDE_INTENT.$output?.itemNumbers)\n  ? $context.$nodes.DECIDE_INTENT.$output.itemNumbers\n  : [];\n\nconst pointsOfUse = Array.isArray($context.$nodes.DECIDE_INTENT.$output?.pointsOfUse)\n  ? $context.$nodes.DECIDE_INTENT.$output.pointsOfUse\n  : [];\n\nconst norm = (v) => String(v ?? \"\").trim().toUpperCase();\n\nconst itemSet = new Set(itemNumbers.map(norm).filter(Boolean));\nconst pouSet = new Set(pointsOfUse.map(norm).filter(Boolean));\n\nconst filteredItems = items.filter((row) => {\n  const matchesItem = itemSet.size === 0 ? true : itemSet.has(norm(row?.ItemNumber));\n\n  let matchesPou = true;\n  if (pouSet.size > 0) {\n    const subinv = norm(row?.SubinventoryCode);\n    const loc = norm(row?.Locator);\n\n    const candidates = [];\n    if (subinv) candidates.push(subinv);\n    if (subinv && loc) candidates.push(`${subinv}:${loc}`);\n    if (loc) candidates.push(loc);\n\n    matchesPou = candidates.some((c) => pouSet.has(c));\n  }\n\n  const pct = Number(String(row?.CalculatedDiffPercentage ?? \"\").replace(\"%\", \"\").trim());\n  const calc = Number(\n    row?.CalculatedCards ?? row?.CalculatedSize ?? row?.CalculatedValue ?? row?.Calculated\n  );\n  const curr = Number(\n    row?.CurrentCards ?? row?.CurrentSize ?? row?.CurrentValue ?? row?.Current\n  );\n\n  const noDeviation =\n    (!Number.isNaN(pct) && pct === 0) ||\n    (!Number.isNaN(calc) && !Number.isNaN(curr) && calc === curr);\n\n  return matchesItem && matchesPou && !noDeviation;\n});\n\nconst resultJson = {\n  ...source,\n  items: filteredItems,\n  count: filteredItems.length\n};\n\nreturn resultJson;\n"
          },
          "outcomes": {
            "success": "1773738476987"
          },
          "code": "GET_FINAL_ARRAY",
          "id": "1773816674040",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Decide Answer"
          },
          "outcomes": {
