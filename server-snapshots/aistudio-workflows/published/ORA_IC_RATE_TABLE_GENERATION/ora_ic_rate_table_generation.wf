{
  "workflowId": "300000331067454",
  "workflowCode": "ORA_IC_RATE_TABLE_GENERATION",
  "name": "Incentive Rate Table Generation",
  "description": "Uses Generative AI to convert both natural language rate table descriptions AND tabular data into structured JSON format.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1779381771174"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "End of data pipeline",
