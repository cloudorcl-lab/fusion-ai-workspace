          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PrepareMessageHint",
            "returnType": "string",
            "sourceCode": "let hint;\n\nif ($context.$app && $context.$app.$OraMessageHint) {\n  hint = $context.$app.$OraMessageHint;\n} else {\n  let inputStr = $context.$triggers.REST.$input.Dummy;\n  let inputObj = typeof inputStr === \"string\" ? JSON.parse(inputStr) : inputStr;\n  hint = inputObj && inputObj[\"$OraMessageHint\"];\n}\n\nif (hint === null || hint === \"InitDisplay\" || hint === \"Summary\")\n  hint = \"Init\";\nreturn hint;"
          },
          "outcomes": {
            "success": "1769793905088"
          },
