          "code": "PREPARE_UOM_INPUT_STAGE_1",
          "id": "1767409273349",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "prepare Batch payload to derive Supply Sources",
            "returnType": "object",
            "sourceCode": "const selectedItems = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItems;\nconst selectedItemsInternalOrExternal = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItemsInternalOrExternal;\nconst destinationType = ($context.$variables.UserPreference[0].DestinationTypeCode  === 'MANUFACTURING' ? 'EXPENSE' :  $context.$variables.UserPreference[0].DestinationTypeCode);\nconst quantity = $context.$variables.derivedQuantity;\nconst destOrgCode = $context.$variables.UserPreference[0].DestinationOrganizationCode;\nconst requisitioningOptions = $context.$variables.UserPreference[0]['requisitioningOptions'];\nconst strDate = requisitioningOptions[0].RequestedDateInLocalTimeOptinFlag ? requisitioningOptions[0].InventoryOrganizationSystemDate : requisitioningOptions[0].LESystemDate;\nconst increment = requisitioningOptions[0].RequestedDeliveryDateOffset != null ? requisitioningOptions[0].RequestedDeliveryDateOffset : 7;\nlet requestedDeliveryDate = '';\n\nif (strDate == null || increment == null) { //Any issue when calling profile options, default offset to 7 days\n      var newDateAux = new Date();\n      newDateAux.setDate(newDateAux.getDate() + 7);\n      requestedDeliveryDate = newDateAux.toISOString().substring(0, 10);\n}else{\n      var parts = strDate.split('-');\n      var currentDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), 0, 0, 0, 0);\n      currentDate.setDate(currentDate.getDate() + parseInt(increment));\n      var year = currentDate.getFullYear();\n      var month = '' + (currentDate.getMonth() + 1);\n      var day = '' + currentDate.getDate();\n      if (month.length < 2) {\n        month = '0' + month;\n      }\n      if (day.length < 2) {\n        day = '0' + day;\n      }\n      requestedDeliveryDate = [year, month, day].join('-');\n }\n\n\nlet batchIMTItemsArray = [];\n\nfor(let i=0 ; i < selectedItemsInternalOrExternal.length ; i++){\n   if(selectedItemsInternalOrExternal[i][0]){\n      const { document_type, item_type, item_id, item, agreement_line} = selectedItems[i];\n      let itemNumber = item?.item_number;\n      let uomCode = ``;\n      if (document_type === 'BLANKET') {\n          const  {agreement_uom} = agreement_line;\n          if (item_id === -2 && agreement_line != null) {\n             const {uom_code,price} = agreement_line;\n            if (uom_code == null && price == null) {\n                uomCode = null;\n            }\n       }\n        if(uomCode != null){\n            uomCode = agreement_uom ? agreement_uom.uom_code : null;\n       }\n     } else {\n    const {item_uom_info} = item;\n    uomCode = item_uom_info ? item_uom_info.uom_code : null\n     }\n\n      let imtObject = {};\n      imtObject['id'] = \"imt_\"+(i+1);\n      imtObject['operation'] = \"get\";\n      imtObject['payload'] = {};\n      imtObject['path'] = `/availableSupplySources?finder=findBestAvailableSupplySource;ItemNumber=${itemNumber},UOMCode=${uomCode},ApplicationCode=POR,Quantity=${quantity},NeedByDate=${requestedDeliveryDate},RetrieveAvailableOnhandQuantityFlag=false,DestinationOrganizationCode=${destOrgCode},DestinationType=${destinationType}&fields=SourceOrganizationCode&onlyData=true`;\n      batchIMTItemsArray.push(imtObject);\n  }\n}\n\nlet result = {\"parts\" : batchIMTItemsArray};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774891535728"
          },
          "code": "PREPARE_BATCH_PAYLOAD_TO_DERIVE_SUPPLY_SOURCES",
          "id": "1774889389104",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "UOM Pre Validation",
