        {
          "metadata": {
            "name": "Update Final Payload",
            "returnType": "object",
            "sourceCode": "const payload=JSON.parse($context.$nodes.GENERATE_LINE_PAYLOAD.$output.result.GeneratedPayload);\nconst functionalCurrencyCode = $context.$nodes.PROCESS_RESPONSE.$output.result.activePreferences.items[0].requisitioningOptions[0].FunctionalCurrencyCode;\nconst currentNcrData = $context.$variables.currentNcrData;\nconst LineTypeId = $context.$variables.derivedLineTypeId;\nconst supplierName = $context.$variables.derivedSupplierName;\nconst budgetDate = $context.$nodes.PROCESS_RESPONSE.$output.result.activePreferences.items[0].requisitioningOptions[0].LESystemDate;\n\ndelete payload.attachments;\nif(payload.lines[0]){\npayload.lines[0].UOM = $context.$variables.currentNcrData['UOM'];\nif($context.$variables.currentNcrData['Category'] != null){\n  delete payload.lines[0].CategoryId;\n  payload.lines[0]['CategoryName'] = $context.$variables.currentNcrData['Category'];\n}\nif(supplierName != null){\n  delete payload.lines[0].SupplierId;\n  payload.lines[0]['Supplier'] = supplierName;\n}\nif(LineTypeId == 6){\n   payload.lines[0]['CurrencyAmount'] = currentNcrData['Amount'];\n   payload.lines[0].distributions[0].CurrencyAmount = currentNcrData['Amount'];\n   payload.lines[0].UOM = null;\n}\nif(payload.lines[0]['CurrencyCode'] != functionalCurrencyCode){\n   payload.lines[0]['ConversionRateType'] = \"Corporate\";\n   payload.lines[0]['ConversionRateDate'] = $context.$system.$currentDate;\n}\nif(payload.lines[0]. distributions[0]){\n payload.lines[0]. distributions[0]['BudgetDate'] = budgetDate;\n}\n}\npayload.ActiveRequisitionFlag=true;\npayload.SourceApplicationCode=\"AGENT:PR_CREATION_GUIDE\";\nreturn JSON.stringify(payload)"
          },
          "outcomes": {
            "success": "1762595581239"
          },
