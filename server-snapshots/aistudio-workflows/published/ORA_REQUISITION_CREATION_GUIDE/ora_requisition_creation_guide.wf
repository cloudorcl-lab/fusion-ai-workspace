        {
          "metadata": {
            "name": "Requisition Details Deep Link",
            "returnType": "string",
            "sourceCode": "const requisitionDeepLink = $context.$nodes.FSCMUI_LINK_ASSISTANT.$output.deeplink + \"/redwood/procurement/requisitions/tabbar/shopping/requisitiondetails?requisitionHeaderId=\" + $context.$variables.updateOrCreatedReqHeaderId;\n\nreturn requisitionDeepLink;"
          },
