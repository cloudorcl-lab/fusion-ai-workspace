        },
        {
          "metadata": {
            "errorNodeId": "1762470112537",
            "name": "prepare submit confirmation String",
            "returnType": "string",
            "sourceCode": "const DeliverToLocation = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToLocationCode;\nconst RequisitionApprovalAmount = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].RequisitionApprovalAmount;\nconst allCurrencies = $context.$variables.allCurrencies;\nconst functionalCurrencyCode = $context.$variables.UserPreference[0].requisitioningOptions[0].FunctionalCurrencyCode;\nconst functionalCurrencySymbol = allCurrencies[functionalCurrencyCode];\nconst shoppingCartDeepLink = $context.$nodes.SHOPPING_CART_DEEP_LINK.$output.result;\nconst linesData = $context.$nodes.FETCH_LINES_DATA.$output.items;\nconst DeliverToLocationCode = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToLocationCode;\nconst PartialSourceTypeSummary = $context.$nodes.PREPARE_PARTIAL_SOURCE_TYPE_SUMMARY_STRING.$output?.result;\n\nconst DeliverToAddress = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToLocationId != null ? linesData[0].DeliverToAddress : ($context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToOneTimeLocationId != null ? $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToOneTimeLocationAddress : 'Varies by line');\n\nconst DeliveryAddress = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].DeliverToLocationId != null ? `${DeliverToLocationCode}<br>${DeliverToAddress}` : DeliverToAddress;\n\nconst Requester = $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].Requester != null ? $context.$nodes.FETCH_SUMMARY_ATTRIBUTES.$output.items[0].Requester : 'Varies by line';\n\nconst formatPrice = (input , currencyCode) => {\nif (input == null || isNaN(input)) return (0).toFixed($context.$variables.allPrecisions[currencyCode]);\nconst num = Number(input);\nconst str = String(input);\nvar parts = str.split('.');\nvar decimalLength = parts[1] ? parts[1].length : 0;\nif (Number.isInteger(num) || decimalLength <= $context.$variables.allPrecisions[currencyCode]) {\nreturn formatNumber(num.toFixed($context.$variables.allPrecisions[currencyCode]));\n}\nif (decimalLength > 10) return formatNumber(num.toFixed(10));\nreturn formatNumber(num);\n};\n\nconst formatAmount = (input , currencyCode) => {\nif (input == null || isNaN(input)) return (0).toFixed($context.$variables.allPrecisions[currencyCode]);\nconst num = Number(input);\nreturn formatNumber(num.toFixed($context.$variables.allPrecisions[currencyCode]));\n};\n\nconst formatQuantity = (input) => {\nif (input == null || isNaN(input)) return input;\nconst num = Number(input);\nconst str = String(input);\nif (Number.isInteger(num)) return formatNumber(num);\nvar parts = str.split('.');\nvar decimalLength = parts[1].length;\nif (decimalLength > 12) return formatNumber(num.toFixed(12));\nreturn formatNumber(num);\n};\n\nconst formatNumber = (input) => {\nconst parts = String(input).split('.');\nconst integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, $context.$variables.userSelfDetails.GroupingSeparator);\nreturn parts[1] ? `${integerPart}${$context.$variables.userSelfDetails.DecimalSeparator}${parts[1]}` : `${integerPart}`;\n};\n\nif(linesData.length == 0){ const error = linesData[0].DeliverToAddress; }\n\nlet TotalAmount = `${functionalCurrencySymbol}${formatAmount(RequisitionApprovalAmount,functionalCurrencyCode)}`;\n\nlet linesSummaryString = `<div><table style=\"margin-bottom:5px;padding:15px;border-collapse:separate;border-spacing:0;width:100%;border-radius:10px;overflow:hidden;border:1px solid #ddd;table-layout:auto;background-color:#fbf9f8;color: black;\"><tbody><tr><td style=\"padding-bottom:10px;\" colspan=\"2\"><div style=\"display:flex;justify-content:space-between;width:100%\"><div style=\"font-weight:bold;white-space:nowrap;\">Requester:</div><div style=\"flex:1;min-width:500px;white-space:normal;word-break:break-word;overflow-wrap:anywhere;margin-left:10px;\">${Requester}</div></div></td></tr><tr><td style=\"padding-bottom:20px;border-bottom:1px solid #ddd\" colspan=\"2\"><div style=\"display:flex;justify-content:space-between;width:100%\"><div style=\"font-weight:bold;white-space:nowrap;\">Delivery Address:</div><div style=\"flex:1;min-width:400px;white-space:normal;word-break:break-word;overflow-wrap:anywhere;margin-left:10px;\">${DeliveryAddress}</div></div></td></tr><tr><td style=\"width:100%;border-bottom:1px solid #ddd\">`;\n\nlet itemsContent = '<div style=\"margin-top:2px;margin-bottom:2px\">';\n\nfor (let i = 0; i < linesData.length; i++) {\n\nconst index = i + 1;\n\nlet description = linesData[i].ItemDescription || '';\n\nif (linesData[i].SourceTypeCode === 'EXTERNAL' && linesData[i].Supplier) description += ` (Sold by ${linesData[i].Supplier})`;\nelse if (linesData[i].SourceTypeCode === 'INTERNAL' && linesData[i].SourceOrganization) description += ` (Transfer from ${linesData[i].SourceOrganization})`;\n\nconst shortDescription = description;\n\nlet Price = linesData[i].Quantity != null ? linesData[i].Price : linesData[i].CurrencyAmount;\nconst currencyCode = linesData[i].CurrencyCode;\nPrice = Price > 0 ? `${formatPrice(Price , currencyCode)}` : null;\n\nconst Uom = linesData[i].UOM;\nconst Quantity = formatQuantity(linesData[i].Quantity);\n\nitemsContent += `<div style=\"padding-bottom:5px;display:flex;width:100%;justify-content:space-between\"><div title=\"${description}\" style=\"width:450px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;color:rgba(22,21,19,0.7)\">${index}. ${shortDescription}</div><div style=\"color:rgba(22,21,19,0.7)\">${ Price != null ? (Quantity != null ? `${allCurrencies[currencyCode]}${Price} x ${Quantity} ${Uom}` : `${allCurrencies[currencyCode]}${Price}`) : `${Quantity} ${Uom}`}</div></div>`;\n}\n\nitemsContent += '</div>';\nlinesSummaryString += itemsContent;\n\nlinesSummaryString += `<\\/td><\\/tr><tr><td style=\"width:100%;padding-top:5px\"><div style=\"display:flex;width:100%;justify-content:space-between\"><div style=\"width:450px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap\"><span style=\"font-weight:bold\">Total in ${functionalCurrencyCode}</span> (inclusive of taxes)</div><div style=\"font-weight:normal\">${TotalAmount}</div></div></td></tr></tbody></table></div><br>`;\n\nlet hasSubmissionFeedback = $context.$nodes.CONFIRM_SUBMIT_REQUISITION.$feedbackRecieved != null ? true : false;\n\nlet itemPrefix = !hasSubmissionFeedback ? (PartialSourceTypeSummary == null ? ($context.$variables.RequisitionPayload.lines.length > 1 ? `Items have been added to cart. ` : `Item has been added to cart. `) : PartialSourceTypeSummary) : ``;\n\nif(hasSubmissionFeedback){\nif($context.$variables.isLinesDeleteSucceeded){\nconst linesCount = $context.$variables.linesDeleteCount;\nitemPrefix = linesCount > 1 ? `Removed ${linesCount} lines. ` : `Removed ${linesCount} line. `;\n}\n\nif($context.$nodes.PROCESS_CART_EDIT_OUTPUT.$output.result.isInternalLocationUpdated || $context.$nodes.PROCESS_CART_EDIT_OUTPUT.$output.result.isLineQuantitiesUpdated || $context.$nodes.PROCESS_CART_EDIT_OUTPUT.$output.result.isRequesterUpdated){\nitemPrefix = ($context.$nodes.PROCESS_CART_EDIT_OUTPUT.$output.result.isLocationDefaulted && !$context.$nodes.PROCESS_CART_EDIT_OUTPUT.$output.result.isInternalLocationUpdated) ? `Cart details have been updated. Since you updated the requester, the delivery address was also updated to the requester’s default address. ` : `Cart details have been updated. `;\n}\n}\n\nlet submissionString = `${itemPrefix}Below is the summary:<br><br>`;\nsubmissionString += linesSummaryString;\nsubmissionString += `Click <b>Approve</b> to submit the requisition.<br><br>Click <b>Request Change</b> to edit cart details.<br><br>Click <b><a href=\"${shoppingCartDeepLink}\" target='_blank'>here</a></b> if you want to view or edit the cart in the application.<br><br>`;\n\nif($context.$variables.IsEditCartFailed) submissionString = $context.$variables.editCartFailureMessage;\n\nreturn `<div>`+submissionString+`</div>`;"
          },
          "outcomes": {
            "success": "1765360167015"
          },
