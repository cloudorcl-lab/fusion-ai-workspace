              "name": "message",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_NCR_INPUT_VALIDATION_STAGE_FINAL.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Apply feedback analyser data Last Stage",
            "returnType": "object",
            "sourceCode": "const workflowResponse =  (JSON.parse($context.$nodes.NCR_FEEDBACK_VALIDATION_LAST_STAGE.$output.output)).result;  \nconst categorymatchRecords = workflowResponse.categoryMatchRecords ;\nconst categoryVectorDBRecords = workflowResponse.CategoryVectorDbRecords ;\nconst uomMatchRecords = workflowResponse.uomMatchRecords ;\nconst uomContainsRecords = workflowResponse.uomContainsRecords ;\nconst allCurrencies  = $context.$variables.allCurrencies;\nconst derivedLineTypeId = $context.$variables.derivedLineTypeId;\nconst derivedLineType = $context.$variables.lineTypes[derivedLineTypeId]; \n \n\n//formate price function\nconst formatPrice = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n\n  if (Number.isInteger(num) || decimalLength <= $context.$variables.allPrecisions[currencyCode]) {\n    return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] )); \n  }\n \n\n  if (decimalLength > 10) {\n    return formatNumber(num.toFixed(10));\n  }\n  return formatNumber(num);\n};\n\n//formate amount function\nconst formatAmount = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return (0).toFixed($context.$variables.allPrecisions[currencyCode] );\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n  return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] ));\n};\n\nconst formatQuantity = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return formatNumber(num); \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 12) {\n    return formatNumber(num.toFixed(12));\n  }\n\n  return formatNumber(num);\n};\n\nconst formatNumber = (input) => {\n  const parts = String(input).split('.');\n  const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, $context.$variables.userSelfDetails.GroupingSeparator);\n  let result = parts[1] ? `${integerPart}${$context.$variables.userSelfDetails.DecimalSeparator}${parts[1]}` : `${integerPart}`;\n  \n  return result;\n};\n\nconst userProvidedData = workflowResponse.userProvidedData ;\nlet currentNcrData = $context.$variables.currentNcrData;\nlet derivedUOM = currentNcrData['UOM'];\nlet derivedCategory = currentNcrData['Category'];\nlet isNewUom = false;\nlet isNewCategory = false;\n\nif(userProvidedData['LineTypeId'] == -1){\n    userProvidedData['UOM']  = null;\n    userProvidedData['Quantity'] = null;\n    userProvidedData['Price'] = null;\n   userProvidedData['Currency'] = null;\n}\n\n//Category derivation if user provides it in feedback.\nif(userProvidedData.Category != null){\n   if(categorymatchRecords.length > 0){\n       derivedCategory = categorymatchRecords[0].CategoryName;\n       isNewCategory = true;\n   }else if(categoryVectorDBRecords.length > 0){\n      if(categoryVectorDBRecords[0]. vectorSearchScore >= 0.8){\n          derivedCategory = categoryVectorDBRecords[0]. CategoryName;\n          isNewCategory = true;\n       }\n   }\n}\n\n//UOM derivation if user provides it in feedback.\nif(userProvidedData.UOM != null){\n  if(uomMatchRecords.length > 0){\n      derivedUOM = uomMatchRecords[0].UOM;\n      isNewUom = true;\n   }else if(uomContainsRecords.length > 0){\n     derivedUOM = uomContainsRecords[0].UOM;\n     isNewUom = true;\n  }\n}\n\ncurrentNcrData['Description'] = userProvidedData['Description'] != null ? userProvidedData['Description'] : currentNcrData['Description'] ;\n\n//if user provided quantity is not valid, then just set it to the current existing value\nif(userProvidedData['Quantity'] != null){\n  const input = userProvidedData['Quantity'];\n  let isValidQuantity = !isNaN(input) && input.trim() !== '' && !isNaN(parseFloat(input)) && (Number(input) > 0);\n  if(isValidQuantity){\n     currentNcrData['Quantity'] = Number(input);\n  }\n}\n\n//If user provide price is not valid, then set it to the current existing value\nif(userProvidedData['Price'] != null){\n    const input = userProvidedData['Price'];\n    let isValidPrice = !isNaN(input) && input.trim() !== '' && !isNaN(parseFloat(input)) && (Number(input) >= 0);\n    if(isValidPrice){\n       if(derivedLineTypeId == 1 || derivedLineTypeId == 7){\n              currentNcrData['Price'] = Number(input);\n              currentNcrData['Amount'] = null;\n       }else if(derivedLineTypeId == 6){\n            currentNcrData['Amount'] = Number(input);\n            currentNcrData['Price'] = null;  \n       }\n  }\n}\n\n//if user provided currency is not valid, then set it to functional currency code.\nif(userProvidedData['Currency'] != null ){\n  let userCurrency = userProvidedData['Currency']; \n  if(allCurrencies[userCurrency] != null){\n       currentNcrData['Currency'] = userCurrency;\n   }\n}\n\nlet SuggestedSupplierName = $context.$variables.derivedSupplierName;\n//check for suggested supplier names \nif( derivedCategory != $context.$variables.derivedCategoryName ){\n  if($context.$variables.SuggestedSuppliersForNCR[ derivedCategory ]){\n  SuggestedSupplierName = $context.$variables.SuggestedSuppliersForNCR[derivedCategory];\n  }else {\n  SuggestedSupplierName = null;\n }\n}\n\ncurrentNcrData['Category'] = derivedCategory;\ncurrentNcrData['UOM'] = derivedUOM;\n\n\nconst description = currentNcrData['Description'];\nconst categoryName = currentNcrData['Category'];\nconst Quantity = currentNcrData['Quantity'];\nconst UOM = currentNcrData['UOM'];\nconst currencyCode = currentNcrData['Currency'];\nconst Price = currentNcrData['Price'];\nconst Amount = currentNcrData['Amount'];\n\nlet ncrPromptString = ``;\n\nif((userProvidedData.Category != null && !isNewCategory) || (userProvidedData.UOM != null && !isNewUom) || (userProvidedData['LineTypeId'] != null)){\n   ncrPromptString += `I found some issues with the data you provided:<br>`;\n   \n   if(userProvidedData.UOM != null && !isNewUom){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Couldn't find a UOM matching <span style=\"color:red;\"><strong>${userProvidedData.UOM}</strong></span>.<br>`;\n   }\n\n   if(userProvidedData.Category != null && !isNewCategory){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Couldn't find a purchasing category matching <span style=\"color:red;\"><strong>${userProvidedData.Category}</strong></span>.<br>`;\n   }\n\n   if(userProvidedData['LineTypeId'] != null){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Item type can't be modified at this stage. To order with a different item type, please initiate a new request.<br>`;\n   }\n  \n  ncrPromptString +=`<br>`;\n}\n\nncrPromptString += `Here are the request details which have been captured:<br><br>`;\n\nncrPromptString += description != null ? `Description: ${description}<br>` : ``;\nncrPromptString += derivedLineTypeId != null  ? `Item Type: ${derivedLineType}<br>` : ``;\nncrPromptString += categoryName != null ? `Category: ${categoryName}<br>` : ``;\nncrPromptString += Quantity != null && (derivedLineTypeId == 1 || derivedLineTypeId == 7)? `Quantity: ${formatQuantity(Quantity)}<br>` : ``;\nncrPromptString += UOM != null && (derivedLineTypeId == 1 || derivedLineTypeId == 7)? `UOM: ${UOM}<br>` : ``;\nncrPromptString += Price != null && (derivedLineTypeId == 1 || derivedLineTypeId == 7)? `Price: ${formatPrice(Price , currentNcrData['Currency'] )}<br>` : ``;\nncrPromptString += Amount != null && derivedLineTypeId == 6 ? `Amount: ${formatAmount(Amount , currentNcrData['Currency'] )}<br>` : ``;\nncrPromptString += currencyCode != null ? `Currency: ${currencyCode}<br>` : ``;\nncrPromptString += SuggestedSupplierName != null ? `Supplier: ${SuggestedSupplierName} (Defaulted based on category as per procurement policies)<br>` : ``;\n\nncrPromptString += `<br>Click <b>Approve</b> to accept these values and proceed with the noncatalog request.<br><br>Click <b>Request Change</b> to modify these values.<br><br>`;\n\nlet finalresult = {\"currentNcrData\":currentNcrData,\"ncrPrompt\":ncrPromptString, \"Description\":description,\"Category\":categoryName,\"Quantity\":Quantity,\"UOM\":UOM,\"Currency\":currencyCode,\"Price\":Price, \"Amount\":Amount, \"SupplierName\": SuggestedSupplierName};\n\nreturn finalresult;"
          },
          "outcomes": {
            "success": "1765468731946"
          },
