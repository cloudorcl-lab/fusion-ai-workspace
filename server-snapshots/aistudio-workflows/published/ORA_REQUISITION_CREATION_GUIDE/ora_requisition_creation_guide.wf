              "id": "1764840653071_1",
              "name": "payload_body",
              "type": "string",
              "value": "{{$context.$variables.RequisitionPayload}}"
            }
          ],
          "outputSpecification": "\"$schema\": \"http://json-schema.org/draft-07/schema# \",\n\"type\": \"object\",\n\"properties\": {\n\"RequisitionHeaderId\": {\n\"type\": \"number\"\n},\n\"Requisition\": {\n\"type\": \"string\"\n}\n},\n\"required\": [\"RequisitionHeaderId\", \"Requisition\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "prepare Add to Req Batch Payload",
            "returnType": "object",
            "sourceCode": "const maxLineNumber = Number($context.$nodes.FETCH_MAX_LINENUMBER_OF_REQ.$output.items[0]?.LineNumber);\nconst requisitionHeaderId = $context.$variables.updateOrCreatedReqHeaderId;\n\n//let linesList = $context.$variables.RequisitionPayload['lines']['items'];\nlet linesList = $context.$variables.RequisitionPayload['lines'];\nlet batchLinesArray = [];\n\nfor(let i=0 ; i < linesList.length ; i++){\n   let lineObject = {};\n   let line = linesList[i];\n\n   // Ensure _PROJECT_ID is the first key in projectDFF\n   if(line?.distributions?.items){\n      for(let j = 0; j < line.distributions.items.length; j++){\n         let dist = line.distributions.items[j];\n\n         if(dist.projectDFF && dist.projectDFF.length > 0){\n            let dff = dist.projectDFF[0];\n\n            if(dff && dff[\"_PROJECT_ID\"] != null){\n               let orderedDFF = { \"_PROJECT_ID\": dff[\"_PROJECT_ID\"] };\n\n               for(const key of Object.keys(dff)){\n                  if(key !== \"_PROJECT_ID\"){\n                     orderedDFF[key] = dff[key];\n                  }\n               }\n\n               dist.projectDFF[0] = orderedDFF;\n            }\n         }\n      }\n   }\n\n   line['LineNumber'] = maxLineNumber + (i+1);\n   lineObject['id'] = \"Part\"+(i+1);\n   lineObject['operation'] = \"create\";\n   lineObject['payload'] = line;\n   lineObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/child/lines`;\n\n   batchLinesArray.push(lineObject);\n}\n\nreturn JSON.stringify({\"parts\" : batchLinesArray});"
          },
          "outcomes": {
            "success": "1764864497492"
          },
          "code": "PREPARE_ADD_TO_REQ_BATCH_PAYLOAD",
          "id": "1764862377077",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
