        {
          "metadata": {
            "name": "NCR feedback validation stage 2",
            "workflowCode": "ORA_NCR_VALIDATION_AND_CART_MODIFICATION_ASSISTANT"
          },
          "outcomes": {
            "success": "1765445851527"
          },
          "code": "NCR_FEEDBACK_VALIDATION_STAGE_2",
          "id": "1767422084944",
          "inputs": [
            {
              "id": "1767774585870_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_NCR_INPUT_VALIDATION_STAGE_2.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "set item quantities and prepare Req payload",
            "returnType": "object",
            "sourceCode": "const selectedItems = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItems;\nconst selectedIndexes = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedIndexes;\nconst selectedItemsSourceTypeandSourceOrg = $context.$nodes.SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS.$output.result.selectedItemsSourceTypeandSourceOrg \nconst userPreference = $context.$variables.UserPreference[0];\nconst requisitioningOptions = userPreference['requisitioningOptions'];\nconst strDate = requisitioningOptions[0].RequestedDateInLocalTimeOptinFlag ? requisitioningOptions[0].InventoryOrganizationSystemDate : requisitioningOptions[0].LESystemDate;\nconst increment = requisitioningOptions[0].RequestedDeliveryDateOffset != null ? requisitioningOptions[0].RequestedDeliveryDateOffset : 7;\nconst derivedQuantity = $context.$variables.derivedQuantity;\nconst budgetDate = requisitioningOptions[0].LESystemDate;\n\nconst formatQuantity = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return num; \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 12) {\n    return num.toFixed(12);\n  }\n\n  return num;\n};\n\nlet requestedDeliveryDate = '';\n\nif (strDate == null || increment == null) { //Any issue when calling profile options, default offset to 7 days\n      var newDateAux = new Date();\n      newDateAux.setDate(newDateAux.getDate() + 7);\n      requestedDeliveryDate = newDateAux.toISOString().substring(0, 10);\n}else{\n      var parts = strDate.split('-');\n      var currentDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), 0, 0, 0, 0);\n      currentDate.setDate(currentDate.getDate() + parseInt(increment));\n      var year = currentDate.getFullYear();\n      var month = '' + (currentDate.getMonth() + 1);\n      var day = '' + currentDate.getDate();\n      if (month.length < 2) {\n        month = '0' + month;\n      }\n      if (day.length < 2) {\n        day = '0' + day;\n      }\n      requestedDeliveryDate = [year, month, day].join('-');\n }\n\n//prepare quantities list\nlet selectedItemsQuantities = [];\nfor(let i=0 ; i<selectedItems.length ; i++){\n   selectedItemsQuantities.push(formatQuantity(derivedQuantity));\n}\n\nlet addToCartWithHeaderPayload = {};\nlet linesArray = []; \n\nfor(let i=0 ; i < selectedItems.length ; i++){\n  if(selectedItemsSourceTypeandSourceOrg[i].SourceType != 'ERROR'){\n  const currentData = selectedItems[i];\n  const { document_type, item_id, item, agreement_line, agreement_line_id, agreement_header_id} = currentData;\n  let SourceTypeCode = selectedItemsSourceTypeandSourceOrg[i].SourceType;\n  let SourceOrganizationCode = selectedItemsSourceTypeandSourceOrg[i].SourceOrganizationCode;\n  let lineTypeCode = 'Goods';\n\n  let description = null;\n  if (document_type === 'BLANKET') {\n    description = (item_id != -2 && item.allow_item_desc_update_flag === 'N') ? item.description : agreement_line.description;\n  } else {\n    description = item.description;\n  }\n\n  if(document_type === 'BLANKET'){\n    if (item_id === -2 && agreement_line != null) {\n      const { uom_code, price } = agreement_line;\n      if (uom_code == null && price == null) {\n        lineTypeCode = 'Services';\n      }\n    }\n  }\n\n  let itemId = (lineTypeCode === 'Services' || item_id === -2) ? undefined : item_id;\n  let line = {};\n  line['ItemDescription'] = SourceOrganizationCode == null ? description : undefined;\n  line['Quantity'] =  (lineTypeCode === 'Services') ? undefined : selectedItemsQuantities[i];\n  line['LineNumber'] = i+1;\n  line['LineTypeCode'] = lineTypeCode;\n  line['RequisitionLineSource'] = \"CATALOG\";\n  line['SourceTypeCode'] = SourceTypeCode;\n  line['SourceOrganizationCode'] = SourceOrganizationCode;\n  line['DeliverToLocationId'] = userPreference.DeliverToLocationId;\n  line['DeliverToCustomerLocationId'] = userPreference.DeliverToCustomerLocationId;\n  line['DestinationOrganizationId'] = userPreference.DestinationOrganizationId;\n  line['RequesterId'] = userPreference.RequesterId;\n  line['DestinationTypeCode'] = (((itemId === -2 || itemId === null || itemId === undefined) && userPreference.DestinationTypeCode != 'MANUFACTURING') || (SourceTypeCode === 'INTERNAL' && userPreference.DestinationTypeCode === 'MANUFACTURING')) ? 'EXPENSE' : userPreference.DestinationTypeCode;\n  line['DestinationSubinventory'] = (itemId === -2 || itemId === null || itemId === undefined) ? null : userPreference.DestinationSubinventory;\n  line['ItemId'] = (lineTypeCode === 'Services') ? undefined : itemId;\n  line['SourceAgreementHeaderId'] = (SourceOrganizationCode == null ? (document_type === 'BLANKET' ? agreement_header_id : undefined) : undefined);\n  line['SourceAgreementLineId'] = (SourceOrganizationCode == null ? (document_type === 'BLANKET' ? agreement_line_id : undefined) : undefined);\n  line['UOMCode'] = document_type === 'BLANKET' ? (lineTypeCode === 'Services' ? undefined : agreement_line.agreement_uom.uom_code) : item.item_uom_info.uom_code\n  line['RequestedDeliveryDate'] = requestedDeliveryDate;\n  line['distributions'] = {\"items\":[{\"DistributionNumber\": \"1\",\"Quantity\": (lineTypeCode === 'Services') ? undefined : selectedItemsQuantities[i] , \"CurrencyAmount\":   (lineTypeCode === 'Services') ? agreement_line. amount : undefined, \"BudgetDate\":budgetDate  }]};\n  \n  linesArray.push(line);\n }\n}\naddToCartWithHeaderPayload['RequisitioningBUId'] = userPreference.RequisitioningBUId; \naddToCartWithHeaderPayload['PreparerId'] = userPreference.PersonId; \naddToCartWithHeaderPayload['ActiveRequisitionFlag'] = true; \naddToCartWithHeaderPayload['SourceApplicationCode'] = 'AGENT:PR_CREATION_GUIDE';\naddToCartWithHeaderPayload['ExternallyManagedFlag'] = false;\n//addToCartWithHeaderPayload['lines'] = {};\n//addToCartWithHeaderPayload['lines']['items'] = linesArray;\naddToCartWithHeaderPayload['lines'] = linesArray;\n\nreturn addToCartWithHeaderPayload;"
          },
          "outcomes": {
            "success": "1764757431002"
          },
          "code": "SET_ITEM_QUANTITIES_AND_PREPARE_REQ_PAYLOAD",
          "id": "1764755249252",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "source Type Error Notification"
          },
          "outcomes": {},
          "code": "SOURCE_TYPE_ERROR_NOTIFICATION",
          "convergenceTargetId": "1764755249252",
          "id": "1774941671727",
          "inputs": [
            {
              "id": "1774941671728_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_LINES_SOURCE_TYPE_FAILURE_ERROR.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "apply feedback analyser data and prepare user prompt 1",
            "returnType": "object",
            "sourceCode": "const workflowResponse =  (JSON.parse($context.$nodes.NCR_FEEDBACK_VALIDATION_STAGE_2.$output.output)).result;  \nconst categorymatchRecords = workflowResponse.categoryMatchRecords ;\nconst categoryVectorDBRecords = workflowResponse.CategoryVectorDbRecords ;\nconst uomMatchRecords = workflowResponse.uomMatchRecords ;\nconst uomContainsRecords = workflowResponse.uomContainsRecords ;\nconst allCurrencies  = $context.$variables.allCurrencies;\nconst functionalyCurrencyCode = $context.$nodes.PROCESS_RESPONSE.$output.result.activePreferences.items[0].requisitioningOptions[0].FunctionalCurrencyCode;\nlet derivedLineTypeId = $context.$variables.derivedLineTypeId;\nlet derivedLineType = $context.$variables.lineTypes[derivedLineTypeId]; \n\n//formate price function\nconst formatPrice = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n\n  if (Number.isInteger(num) || decimalLength <= $context.$variables.allPrecisions[currencyCode]) {\n    return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] )); \n  }\n \n\n  if (decimalLength > 10) {\n    return formatNumber(num.toFixed(10));\n  }\n  return formatNumber(num);\n};\n\n//formate amount function\nconst formatAmount = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return (0).toFixed($context.$variables.allPrecisions[currencyCode] );\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n  return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] ));\n};\n\nconst formatQuantity = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return formatNumber(num); \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 12) {\n    return formatNumber(num.toFixed(12));\n  }\n\n  return formatNumber(num);\n};\n\nconst formatNumber = (input) => {\n  const parts = String(input).split('.');\n  const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, $context.$variables.userSelfDetails.GroupingSeparator);\n  let result = parts[1] ? `${integerPart}${$context.$variables.userSelfDetails.DecimalSeparator}${parts[1]}` : `${integerPart}`;\n  \n  return result;\n};\n\nconst userProvidedData = workflowResponse.userProvidedData ;\nlet currentNcrData = $context.$variables.currentNcrData;\nlet derivedUOM = currentNcrData['UOM'];\nlet derivedCategory = currentNcrData['Category'];\nlet isNewUom = false;\nlet isNewCategory = false;\n\nif(userProvidedData['LineTypeId'] == -1){\n    userProvidedData['UOM']  = null;\n    userProvidedData['Quantity'] = null;\n    userProvidedData['Price'] = null;\n   userProvidedData['Currency'] = null;\n}\n\n//Category derivation if user provides it in feedback.\nif(userProvidedData.Category != null){\n   if(categorymatchRecords.length > 0){\n       derivedCategory = categorymatchRecords[0].CategoryName;\n       isNewCategory = true;\n   }else if(categoryVectorDBRecords.length > 0){\n      if(categoryVectorDBRecords[0]. vectorSearchScore >= 0.8){\n          derivedCategory = categoryVectorDBRecords[0]. CategoryName;\n          isNewCategory = true;\n       }\n   }\n}\n\n//UOM derivation if user provides it in feedback.\nif(userProvidedData.UOM != null){\n  if(uomMatchRecords.length > 0){\n      derivedUOM = uomMatchRecords[0].UOM;\n      isNewUom = true;\n   }else if(uomContainsRecords.length > 0){\n     derivedUOM = uomContainsRecords[0].UOM;\n     isNewUom = true;\n  }\n}\n\ncurrentNcrData['Description'] = userProvidedData['Description'] != null ? userProvidedData['Description'] : currentNcrData['Description'] ;\n\n//if user provided quantity is not valid, then just set it to the current existing value\nif(userProvidedData['Quantity'] != null){\n  const input = userProvidedData['Quantity'];\n  let isValidQuantity = !isNaN(input) && input.trim() !== '' && !isNaN(parseFloat(input)) && (Number(input) > 0);\n  if(isValidQuantity){\n     currentNcrData['Quantity'] = Number(input);\n  }\n}\n\n//if user provided currency is not valid, then set it to functional currency code.\nif(userProvidedData['Currency'] != null ){\n  let userCurrency = userProvidedData['Currency']; \n  if(allCurrencies[userCurrency] != null){\n       currentNcrData['Currency'] = userCurrency;\n   }else{\n       currentNcrData['Currency'] = functionalyCurrencyCode;\n   }\n}\n\n//check if user provided LineTypeId\nif(userProvidedData['LineTypeId'] != null && userProvidedData['LineTypeId'] != -1){\n    currentNcrData['LineTypeId'] = userProvidedData['LineTypeId'];\n    derivedLineTypeId = userProvidedData['LineTypeId'];\n    derivedLineType = $context.$variables.lineTypes[derivedLineTypeId]; \n}\n\n//If user provide price is not valid, then set it to the current existing value\nif(userProvidedData['Price'] != null){\n    const input = userProvidedData['Price'];\n    let isValidPrice = !isNaN(input) && input.trim() !== '' && !isNaN(parseFloat(input)) && (Number(input) >= 0);\n    if(isValidPrice){\n       if(derivedLineTypeId == 1 || derivedLineTypeId == 7){\n              currentNcrData['Price'] = Number(input);\n              currentNcrData['Amount'] = null;\n       }else if(derivedLineTypeId == 6){\n            currentNcrData['Amount'] = Number(input);\n            currentNcrData['Price'] = null;  \n       }\n  }\n}\n\ncurrentNcrData['Category'] = derivedCategory;\ncurrentNcrData['UOM'] = derivedUOM;\n\n\nconst description = currentNcrData['Description'];\nconst categoryName = currentNcrData['Category'];\nconst Quantity = currentNcrData['Quantity'];\nconst UOM = currentNcrData['UOM'];\nconst currencyCode = currentNcrData['Currency'];\nconst Price = currentNcrData['Price'];\nconst Amount = currentNcrData['Amount'];\n\nlet SuggestedSupplierName = $context.$variables.derivedSupplierName;\n//check for suggested supplier names \nif( categoryName != $context.$variables.derivedCategoryName ){\n  if($context.$variables.SuggestedSuppliersForNCR[categoryName]){\n  SuggestedSupplierName = $context.$variables.SuggestedSuppliersForNCR[categoryName];\n}else {\n  SuggestedSupplierName = null;\n }\n}\n\nlet ncrPromptString = ``;\n\nif((userProvidedData.Category != null && !isNewCategory) || (userProvidedData.UOM != null && !isNewUom) || (userProvidedData['LineTypeId'] != null && userProvidedData['LineTypeId'] == -1)){\n   ncrPromptString += `I found some issues with the data you provided:<br>`;\n   \n   if(userProvidedData.UOM != null && !isNewUom){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Couldn't find a UOM matching <span style=\"color:red;\"><strong>${userProvidedData.UOM}</strong></span>.<br>`;\n   }\n\n   if(userProvidedData.Category != null && !isNewCategory){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Couldn't find a purchasing category matching <span style=\"color:red;\"><strong>${userProvidedData.Category}</strong></span>.<br>`;\n   }\n\n   if(userProvidedData['LineTypeId'] != null && userProvidedData['LineTypeId'] == -1){\n      ncrPromptString += `<span style=\"font-size: 24px;\">•</span> Couldn't find the item type. Available item types are: Goods billed by quantity, Services billed by amount and Services billed by quantity.<br>`;\n   }\n  \n  ncrPromptString +=`<br>`;\n}\n\nncrPromptString += `Here are the request details which have been captured:<br><br>`;\n\nncrPromptString += description != null ? `Description: ${description}<br>` : ``;\nncrPromptString += derivedLineTypeId != null  ? `Item Type: ${derivedLineType}<br>` : ``;\nncrPromptString += categoryName != null ? `Category: ${categoryName}<br>` : ``;\nncrPromptString += Quantity != null  && (derivedLineTypeId == 1 || derivedLineTypeId == 7) ? `Quantity: ${formatQuantity(Quantity)}<br>` : ``;\nncrPromptString += UOM != null && (derivedLineTypeId == 1 || derivedLineTypeId == 7) ? `UOM: ${UOM}<br>` : ``;\nncrPromptString += Price != null && (derivedLineTypeId == 1 || derivedLineTypeId == 7)? `Price: ${formatPrice(Price , currentNcrData['Currency'] )}<br>` : ``;\nncrPromptString += Amount != null && derivedLineTypeId == 6 ? `Amount: ${formatAmount(Amount , currentNcrData['Currency'] )}<br>` : ``;\nncrPromptString += currencyCode != null ? `Currency: ${currencyCode}<br>` : ``;\nncrPromptString += SuggestedSupplierName != null ? `Supplier: ${SuggestedSupplierName} (Defaulted based on category as per procurement policies)<br>` : ``;\n\nncrPromptString += `<br>Click <b>Approve</b> to accept these values and proceed with the noncatalog request.<br><br>Click <b>Request Change</b> to modify these values.<br><br>`;\n\nlet result = {\"currentNcrData\":currentNcrData,\"ncrPrompt\":ncrPromptString, \"Description\":description,\"Category\":categoryName,\"Quantity\":Quantity,\"UOM\":UOM,\"Currency\":currencyCode,\"Price\":Price, \"Amount\":Amount,\"derivedLineTypeId\":derivedLineTypeId, \"SupplierName\": SuggestedSupplierName};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1765295781076"
          },
