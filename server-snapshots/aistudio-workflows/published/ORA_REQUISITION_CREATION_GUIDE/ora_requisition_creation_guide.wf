        {
          "metadata": {
            "name": "prepare Search Assistant Input Object",
            "returnType": "object",
            "sourceCode": "let response = {};\nlet result = {};\nresponse['userInputMessage'] = $context.$variables.userInputMessage;\nresponse['isIMTEnabled'] = $context.$variables.isIMTEnabled;\n\nif($context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output?.POLICY_RESULT == \"RESTRICT\"){\nlet filterData = {};\ntry {\n    filterData = JSON.parse($context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output.SEARCH_FILTERS);\n  } catch (e) {\n     filterData = $context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output.SEARCH_FILTERS;\n  }\n\nresponse = {\n    ...response,\n    ...filterData\n  };\n\nresult = response;\n\n}else{\n  result = response;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1764486904196"
          },
          "code": "PREPARE_SEARCH_ASSISTANT_INPUT_OBJECT",
          "id": "1774952929134",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
