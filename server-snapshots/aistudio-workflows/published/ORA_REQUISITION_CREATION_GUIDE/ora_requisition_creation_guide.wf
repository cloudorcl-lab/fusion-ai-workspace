        {
          "metadata": {
            "name": "process Response",
            "returnType": "object",
            "sourceCode": "let response = (JSON.parse($context.$nodes.CATALOG_SEARCH_ASSISTANT.$output.output)).result;\nconst allowedDocTypes = [\"BLANKET\", \"MASTER_ITEM\",\"SMART_FORM\"];\nlet searchResults = [];\nlet smartFormsResults = [];\nlet isSmartFormBestMatch = false;\n\nfor(let i=0 ; i<response.searchResults.items.length ; i++){\n     let item = response.searchResults.items[i];\n     if(allowedDocTypes.includes(item['document_type'] )){\n         if(item['document_type'] != 'SMART_FORM'){\n             searchResults.push(item);\n         }else{\n             if(i == 0){\n                isSmartFormBestMatch = true;\n             }\n             smartFormsResults.push(item);\n         }\n     }\n}\n\nconst itemDetailsLink = $context.$nodes.FSCMUI_LINK_ASSISTANT.$output.deeplink + \"/redwood/procurement/requisitions/tabbar/shopping/itemdetails?fetchInternalBuyingOptio%6Es=true&searchObjectId=\";\nconst smartFormPageLink = $context.$nodes.FSCMUI_LINK_ASSISTANT.$output.deeplink + \"/redwood/procurement/requisitions/tabbar/shopping/create_noncatalog_request?smartFormId=\";\n\n//add the itemDetails page deep link property to each search result\nfor(let i=0 ; i<searchResults.length ; i++){\n      searchResults[i]['itemLink'] = itemDetailsLink + searchResults[i]['document_id']; \n      if(searchResults[i]?.agreement_line?.thumbnail_image){\n         searchResults[i]['thumbnailImage']  =  searchResults[i]['agreement_line']['thumbnail_image'].replace(/HTPPS/g, \"https://\").replace(/HTTP/g, \"http://\");\n     }\n}\n\n//add the smartform creation page deeplink property to each smartform result\nfor(let i=0 ; i<smartFormsResults.length ; i++){\n      smartFormsResults[i]['itemLink'] = smartFormPageLink + smartFormsResults[i]['smart_form_id']; \n}\n\nlet smartformObject = {}\nsmartformObject['items'] = smartFormsResults;\n\nresponse.searchResults.items = searchResults;\nresponse['smartFormResults'] = smartformObject;\nresponse['isSmartFormBestMatch'] = isSmartFormBestMatch;\n\nreturn response;"
          },
          "outcomes": {
            "success": "1770132236252"
          },
          "code": "PROCESS_RESPONSE",
          "id": "1763528492053",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
