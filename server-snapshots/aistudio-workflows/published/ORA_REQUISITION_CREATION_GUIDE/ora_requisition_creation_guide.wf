        {
          "metadata": {
            "name": "Generate SmartForms Html",
            "returnType": "string",
            "sourceCode": "const searchItems = $context.$variables.smartFormResults.items; \nconst catalogSearchResults = $context.$variables.CatalogSearchResults.items;\nconst SmartFormLineTypes = $context.$variables.smartFormLineTypes; \n\nconst showBestMatch = !catalogSearchResults || catalogSearchResults.length === 0;\n \nlet tableHTML = showBestMatch \n? `Here are the most relevant results for your search. I have tagged the best match.<br><br><div>`\n: `<div>`;\n\nsearchItems.forEach((searchItem, idx) => {\n\nconst {document_type, itemLink, smart_form, category} = searchItem;\n\nlet description = null;\nlet categoryName = null;\nlet agreement = null;\nlet lineType = null;\nlet imageSrc = null;\n\nif (document_type === 'SMART_FORM') {     \n   description = smart_form?.smart_form_name;\n   categoryName = category?.category_name;\n   agreement = smart_form?.agreement_number;\n   let lineTypeId = smart_form?.product_type_details?.line_type_id;\n   lineType = lineTypeId ? SmartFormLineTypes[lineTypeId] : null;\n   imageSrc = (smart_form?.image_url && smart_form?.image_url.trim() !== \"\") ? smart_form.image_url : \"\";\n}\n\nlet detailsHTML = \"\";\n\nconst hasBadge = showBestMatch && idx === 0;\n\nif (description) {\n    detailsHTML += itemLink\n        ? `<div style=\"margin:${hasBadge ? '10px' : '0px'} 0 2px 0;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;\"><a href=\"${itemLink}\" target=\"_blank\" style=\"color:rgb(0,104,140);text-decoration:none;\">${description}</a></div>`\n        : `<div style=\"margin:${hasBadge ? '10px' : '0px'} 0 2px 0;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;\">${description}</div>`;\n}\n\nif (categoryName)\n    detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;\">${categoryName}</span>`;\n\nif (lineType)\n    detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;\">Line Type: ${lineType}</span>`;\n\nif (agreement)\n    detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;\">Agreement: ${agreement}</span>`;\n\nif (document_type === 'SMART_FORM' && itemLink)\n    detailsHTML += `<div style=\"margin-top:16px;\"><a href=\"${itemLink}\" target=\"_blank\" style=\"display:inline-block;background-color:#fbf9f8;color:#000;text-decoration:none;padding:6px 12px;font-size:12px;font-weight:bold;border-radius:6px;border:1px solid #000;cursor:pointer;\">Create Request</a></div>`;\n\nconst badgeHTML = hasBadge\n? `<div style=\"margin-left:0px;display:inline-block;padding:2px 4px;background-color:#5F9EA0;color:#fff;font-size:11px;font-weight:bold;border-radius:5px;white-space:nowrap;\">Best Match</div>`\n: ``;\n\nconst badgeContainer = badgeHTML\n? `<div style=\"font-weight:normal\">${badgeHTML}</div>`\n: ``;\n\ntableHTML += `<table style=\"margin-bottom:5px;padding:15px;border-collapse:separate;border-spacing:0;width:100%;border-radius:10px;overflow:hidden;border:1px solid #ddd;table-layout:auto;background-color:#fbf9f8\"><tbody><tr><td>${badgeContainer}${detailsHTML}</td><td style=\"width:100px;height:100px;padding:2px;text-align:center;vertical-align:middle;\"><img src=\"${imageSrc}\" style=\"max-width:100%;max-height:100%;object-fit:contain;display:block;margin:auto;\"></td></tr></tbody></table>`;\n\n});\n\ntableHTML += `</div>`;\n\nreturn tableHTML;"
          },
          "outcomes": {
            "success": "1764679744085"
          },
          "code": "GENERATE_SMARTFORMS_HTML",
          "id": "1773065879616",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate all items html",
            "returnType": "string",
            "sourceCode": "const searchItems = $context.$variables.CatalogSearchResults.items;\nconst smartFormItems = $context.$variables.smartFormResults.items;\nconst showSmartForms = smartFormItems.length > 0 && searchItems.length > 0;\nconst allCurrencies = $context.$variables.allCurrencies;\nconst functionalCurrencyCode = allCurrencies[$context.$variables.UserPreference[0].requisitioningOptions[0].FunctionalCurrencyCode];\nconst destinationType = ($context.$variables.UserPreference[0].DestinationTypeCode  === 'MANUFACTURING' ? 'EXPENSE' :  $context.$variables.UserPreference[0].DestinationTypeCode);\nconst destinationOrgId = $context.$variables.UserPreference[0].DestinationOrganizationId;\nconst hasIMTPermission = $context.$variables.isIMTEnabled;\nconst isIMToptinEnabled = $context.$variables.UserPreference[0].requisitioningOptions[0].InternalMaterialTransfersOptinFlag;\nconst sourceAgreementlinesInternallyForExpenseDest = $context.$variables.UserPreference[0].requisitioningOptions[0].ExpenseAgreementLinesFromInternalSourcesOptinFlag;\n\n//formate price function\nconst formatPrice = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n\n  if (Number.isInteger(num) || decimalLength <= $context.$variables.allPrecisions[currencyCode]) {\n    return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] )); \n  }\n \n\n  if (decimalLength > 10) {\n    return formatNumber(num.toFixed(10));\n  }\n  return formatNumber(num);\n};\n\n//format number function\nconst formatNumber = (input) => {\n  const parts = String(input).split('.');\n  const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, $context.$variables.userSelfDetails.GroupingSeparator);\n  let result = parts[1] ? `${integerPart}${$context.$variables.userSelfDetails.DecimalSeparator}${parts[1]}` : `${integerPart}`;\n  \n  return result;\n};\n\n// method to check if the agreement line can be internally ordered in the context of user preferenced destination organization.\n    const isAgreementLineInternal = (prefDestOrgId, agreementInventoryOrgsList) => {\n      var isInternalLine = false;\n      if (agreementInventoryOrgsList != null) {\n        for (var i = 0; i < agreementInventoryOrgsList.length; i++) {\n          if (agreementInventoryOrgsList[i].organization_id == prefDestOrgId && agreementInventoryOrgsList[i].internally_transferable_item_flag == 'Y' && agreementInventoryOrgsList[i].internal_transfer_order_enabled_flag == 'Y') {\n            isInternalLine = true;\n            break;\n          }\n        }\n      }\n      return isInternalLine;\n    }\n\n\n//method to check if the masteritem or agreementline can be internally or externally orderable or both in the context of user preferenced destination organization or destination type.\n  const isInternallyOrderableLineOrExternal = (documentType, itemType, itemId, agreementLineItemInventoryOrgs, userPrefDestOrgId, userPrefDestType, hasIMTPermission, isIMToptinEnabled, sourceAgreementlinesInternallyForExpenseDest) => {\n\n    var isInternallyOrderable = false;\n    var isExternallyOrderable = false;\n\n    //To check if the item/line is internally orderable or not.\n    if (itemId != -2 && hasIMTPermission && isIMToptinEnabled) {\n      if (documentType === 'MASTER_ITEM'  && (itemType == 'INTERNAL' || itemType == 'INTERNAL_AND_PURCHASE')) {\n        isInternallyOrderable = true;\n      }\n      else if (documentType === 'BLANKET' && isAgreementLineInternal(userPrefDestOrgId, agreementLineItemInventoryOrgs) && sourceAgreementlinesInternallyForExpenseDest && userPrefDestType === 'EXPENSE') {\n       isInternallyOrderable = true;\n      }\n    }\n\n    //To check if the item/line is externally orderable or not.\n    if (itemType != null && itemType != 'INTERNAL') {\n      isExternallyOrderable = true;\n    }\n\n    return [isInternallyOrderable, isExternallyOrderable];\n  };\n\n\n\nlet tableHTML = '';\n\nif($context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output?.POLICY_RESULT == \"INFO\" || $context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output?.POLICY_RESULT == \"RESTRICT\"){\nlet uniqueId = Math.floor(Math.random() * 900);\ntableHTML += `<br>\n<div style=\"width: 100%;box-sizing: border-box;border: 1px solid #cce5ff;background-color: #e9f5ff;color: #004085;padding: 12px 16px;border-radius: 6px;font-family: Arial, sans-serif;font-size: 15px;\">\n   <input type=\"checkbox\" id=\"toggleNote_${uniqueId}\" style=\"position:absolute; opacity:0;  pointer-events:none;\">\n   <div class=\"content\">\n    <span style=\"color: #004085;margin-right: 4px;font-size: 17px;font-weight:bold;vertical-align: middle;\">ⓘ</span>${$context.$nodes.PROCUREMENT_POLICY_ENFORCEMENT.$output.MESSAGE}\n\n  </div>\n  <label for=\"toggleNote_${uniqueId}\" class=\"toggle\"></label>\n  <style>\n    .content {position: relative;line-height: 1.5em;max-height: calc(1.5em * 2); overflow: hidden;transition: max-height 0.3s ease;}\n    #toggleNote_${uniqueId}:checked ~ .content { max-height: 500px;}\n    .toggle {display: inline-block;margin-top: 6px;color: #0056b3;cursor: pointer;font-weight: 500;}\n    .toggle::before {content: \"See more\";}\n    #toggleNote_${uniqueId}:checked ~ .toggle::before {content: \"See less\";}\n  </style>\n</div>\n<br>`;\n}\n\ntableHTML += `Here are the most relevant results for your search. I have tagged the best match.<br>`; \n\ntableHTML += showSmartForms ? `Results also include smart forms. Click <b>Create Request</b> to open a smart form.<br><br>`: `<br>`;\n\ntableHTML += `<div>`;\n\nsearchItems.forEach((searchItem, idx) => {\n\n    let description = null;\n    const { document_type, item_type, item_id, item, agreement_line, category, thumbnailImage, itemLink, smart_form, agreement_line_item_inventory_orgs, signed_image_url} = searchItem;\n\n   let internalOrExternalSourceItem = isInternallyOrderableLineOrExternal(document_type, item_type, item_id, agreement_line_item_inventory_orgs, destinationOrgId, destinationType, hasIMTPermission, isIMToptinEnabled, sourceAgreementlinesInternallyForExpenseDest);\n\n   let isInternallyOrderable = internalOrExternalSourceItem[0];\n\n    if (document_type === 'BLANKET') {\n        description = (item_id != -2 && item.allow_item_desc_update_flag === 'N')\n            ? item.description\n            : agreement_line.description;\n    } else if (document_type === 'SMART_FORM'){\n       description = smart_form?.smart_form_name\n    }else {\n        description = item.description;\n    }\n\n let priceString = null;\n//derive Price and currencyCode\n    \nif (document_type === 'BLANKET') {\n\n   priceString = (agreement_line && agreement_line.currency_code && agreement_line.price) ? `${allCurrencies[agreement_line.currency_code]}${formatPrice(agreement_line.price, agreement_line.currency_code)}`: ( (agreement_line && agreement_line.currency_code && agreement_line. amount) ? `${allCurrencies[agreement_line.currency_code]}${formatPrice(agreement_line. amount, agreement_line.currency_code)}`: \"\");\n\n} else {\n     priceString = (item && item.price) ? `${functionalCurrencyCode}${formatPrice(item.price,$context.$variables.UserPreference[0].requisitioningOptions[0].FunctionalCurrencyCode)}` : \"\";\n} \n\nlet uom = ``;\nif (document_type === 'BLANKET') {\n    const  {agreement_uom} = agreement_line;\n    if (item_id === -2 && agreement_line != null) {\n        const {uom_code,price} = agreement_line;\n        if (uom_code == null && price == null) {\n            uom = null;\n        }\n    }\n    if (uom != null) {\n        uom = agreement_uom ? agreement_uom.uom : null;\n    }\n} else {\n    const {item_uom_info} = item;\n    uom = item_uom_info ? item_uom_info.uom : null\n}\n\n    if (priceString && uom) priceString = `${priceString} ${uom}`;\n\n    const itemNumber = item?.item_number;\n    const categoryName = category?.category_name;\n    const agreementText = agreement_line?.agreement;\n    const supplier = smart_form?.smart_form_supplier?.smart_form_supplier_name?.party_name;\n\n    let imageSrc = \"\";\n     if( document_type === 'MASTER_ITEM') {\n    imageSrc = ( signed_image_url != null ? signed_image_url : item.image_url);\n  } else {\n    if( item_id == - 2 || thumbnailImage != null ) {\n      imageSrc = thumbnailImage;\n    } else if( signed_image_url != null ) {\n      imageSrc = signed_image_url;\n    } else {\n      imageSrc = item.image_url;\n    }\n  }\n\nif(imageSrc == null){\nimageSrc = \"\";\n}\n\n    let detailsHTML = \"\";\n\n    if (description) {\n        detailsHTML += itemLink\n            ? `<div style=\"margin:10px 0 2px 0;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;\"><a href=\"${itemLink}\" target=\"_blank\" style=\"color:rgb(0,104,140);text-decoration:none;\">${description}</a></div>`\n            : `<div style=\"margin:10px 0 2px 0;white-space:normal;word-wrap:break-word;overflow-wrap:break-word;\">${description}</div>`;\n    }\n\n    if (itemNumber)\n        detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;color: black;\">${itemNumber}</span>`;\n\n    if (priceString)\n        detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;color: black;\">${priceString}</span>`;\n\n    if (categoryName)\n        detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;color: black;\">${categoryName}</span>`;\n\n    if (agreementText)\n        detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;color: black;\">Agreement: ${agreementText}</span>`;\n\n    if (supplier)\n        detailsHTML += `<span style=\"font-size:0.75em;display:block;margin:0 0 2px 0;color: black;\">Sold By ${supplier}</span>`;\n\n   if (document_type === 'SMART_FORM' && itemLink)\n        detailsHTML += `<div style=\"margin-top:16px;\"><a href=\"${itemLink}\" target=\"_blank\" style=\"display:inline-block;background-color:#fbf9f8;color:#000;text-decoration:none;padding:6px 12px;font-size:12px;font-weight:bold;border-radius:6px;border:1px solid #000;cursor:pointer;\">Create Request</a></div>`;\n\n    const badgeHTML = (isInternallyOrderable ? `<div style=\"margin-left:10px;display:inline-block;padding:2px 4px;background-color:#00688C;color:#fff;font-size:11px;font-weight:bold;border-radius:5px;white-space:nowrap;\">Internally Orderable</div>` : \"\") + (idx === 0 ? `<div style=\"margin-left:6px;display:inline-block;padding:2px 4px;background-color:#5F9EA0;color:#fff;font-size:11px;font-weight:bold;border-radius:5px;white-space:nowrap;\">Best Match</div>`: \"\");\n\n    tableHTML += `<table style=\"margin-bottom:5px;padding:15px;border-collapse:separate;border-spacing:0;width:100%;border-radius:10px;overflow:hidden;border:1px solid #ddd;table-layout:auto;background-color:#fbf9f8\"><tbody><tr><td><div style=\"font-weight:normal;color:black;\">#${idx + 1} ${badgeHTML}</div>${detailsHTML}</td><td style=\"width:100px;height:100px;padding:2px;text-align:center;vertical-align:middle;\"><img src=\"${imageSrc}\" style=\"max-width:100%;max-height:100%;object-fit:contain;display:block;margin:auto;\"></td></tr></tbody></table>`;\n});\n\ntableHTML += `</div>`;\n\nif(showSmartForms){\n    const smartFormsHtmlString = $context.$nodes.GENERATE_SMARTFORMS_HTML.$output.result;\n     tableHTML += `<br><b>Smart Forms</b><br><br>`;\n     tableHTML += smartFormsHtmlString;\n}\n\ntableHTML += `<br>`;\n\ntableHTML += `Click <b>Approve</b> to select the best match and add it to the requisition.<br><br>`;\n\ntableHTML += showSmartForms ? `Click <b>Request Change</b> to select items other than smart forms.<br><br>` : `Click <b>Request Change</b> to select other items.<br><br>`;\n\ntableHTML += `Key in new criteria to start a new search.<br><br>`;\n\nreturn `<div>` +tableHTML+ `<div>`;"
          },
          "outcomes": {
            "success": "1776138660826"
          },
