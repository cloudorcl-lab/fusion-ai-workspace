        {
          "metadata": {
            "name": "Set Source Type and Source Org of selected Items",
            "returnType": "object",
            "sourceCode": "const fetchedSupplySources = $context.$nodes.FETCH_IMT_LINES_SUPPLY_SOURCES.$output?.parts;\nconst selectedItems = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItems;\nconst selectedItemsInternalOrExternal = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItemsInternalOrExternal;\n\nconst selectedItemsSourceTypeandSourceOrg = [];\n\nlet j = 0;\nlet errorCount = 0;\n\nfor (let i = 0; i < selectedItems.length; i++) {\n\n    const isInternal = selectedItemsInternalOrExternal?.[i]?.[0];\n    const isExternal = selectedItemsInternalOrExternal?.[i]?.[1];\n\n    if (isInternal) {\n\n        const sourceOrg =\n            fetchedSupplySources?.[j]?.payload?.items?.[0]?.SourceOrganizationCode;\n\n        if (sourceOrg) {\n\n            selectedItemsSourceTypeandSourceOrg.push({\n                SourceType: 'INTERNAL',\n                SourceOrganizationCode: sourceOrg\n            });\n\n        } else if (isExternal) {\n\n            selectedItemsSourceTypeandSourceOrg.push({\n                SourceType: 'EXTERNAL',\n                SourceOrganizationCode: null\n            });\n\n        } else {\n\n            selectedItemsSourceTypeandSourceOrg.push({\n                SourceType: 'ERROR',\n                SourceOrganizationCode: null\n            });\n\n            errorCount++;\n\n        }\n\n        j++;\n\n    } else {\n\n        selectedItemsSourceTypeandSourceOrg.push({\n            SourceType: 'EXTERNAL',\n            SourceOrganizationCode: null\n        });\n\n    }\n\n}\n\n\n// Failure flags logic\n\nlet AllLinesSourceTypeFailure = false;\nlet PartialLinesSourceTypeFailure = false;\n\nif (errorCount === selectedItems.length && selectedItems.length > 0) {\n\n    AllLinesSourceTypeFailure = true;\n\n} else if (errorCount > 0) {\n\n    PartialLinesSourceTypeFailure = true;\n\n}\n\n\n// Final structured output\nlet result = {\"selectedItemsSourceTypeandSourceOrg\": selectedItemsSourceTypeandSourceOrg,\"AllLinesSourceTypeFailure\": AllLinesSourceTypeFailure,\"PartialLinesSourceTypeFailure\": PartialLinesSourceTypeFailure, \"errorCount\":errorCount};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1774941619360"
          },
          "code": "SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS",
          "convergenceTargetId": "1764755249252",
