            "name": "populate partial NCR fields error",
            "returnType": "string",
            "sourceCode": "const derivedUOM = $context.$variables.derivedUOM;\nconst derivedPrice = $context.$variables.derivedPrice;\nlet errorString = null;\n\nif(derivedUOM == null && derivedPrice == null){\n   errorString = `Price and UOM have not been provided. Cannot create the non catalog request.<br>Please start a new search.`;\n}else if(derivedPrice == null){\n   errorString = `Price have not been provided. Cannot create the non catalog request.<br>Please start a new search.`;\n}else if(derivedUOM == null){\n  errorString = `UOM have not been provided. Cannot create the non catalog request.<br>Please start a new search.`;\n}\n\nreturn errorString;"
          },
