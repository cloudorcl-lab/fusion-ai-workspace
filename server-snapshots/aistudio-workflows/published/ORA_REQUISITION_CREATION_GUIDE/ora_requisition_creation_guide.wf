        {
          "metadata": {
            "name": "prepare Generate payload",
            "returnType": "object",
            "sourceCode": "const userPreference = $context.$variables.UserPreference[0];\nconst currentNcrData = $context.$variables.currentNcrData;\nconst LineTypeId = $context.$variables.derivedLineTypeId; \nvar LineTypeCode = null;\n\nif(LineTypeId == 1){\n   LineTypeCode = \"Goods\";\n}else if(LineTypeId == 6){\n   LineTypeCode = \"Fixed Price Services\";\n}else if(LineTypeId == 7){\n   LineTypeCode = \"ORA_Rate Based Services\";\n}\n\nconst formatQuantity = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return num; \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 12) {\n    return num.toFixed(12);\n  }\n\n  return num;\n};\n\nconst formatPrice = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return num; \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 10) {\n    return num.toFixed(10);\n  }\n\n  return num;\n};\n\n\nlet addToCartWithHeaderPayload = {};\n\nlet header = {};\nheader['PreparerId'] = userPreference.PersonId;\nheader['Description'] = currentNcrData['Description'];\nheader['CurrencyCode'] = currentNcrData['Currency'];\n\n  let linesArray = []; \n  let line = {};\n  line['LineNumber'] = 1;\n  line['ItemDescription'] = currentNcrData['Description'];\n  line['Quantity'] = (LineTypeId == 1 || LineTypeId == 7) ? formatQuantity(currentNcrData['Quantity']) : null;\n  line['UOM'] = (LineTypeId == 1 || LineTypeId == 7) ? currentNcrData['UOM'] : null;\n  line['Price'] =  (LineTypeId == 1 || LineTypeId == 7) ? formatPrice(currentNcrData['Price']) : null;\n  line['CurrencyAmount'] =  (LineTypeId == 6) ? formatPrice(currentNcrData['Amount']) : null;\n  //line['LineTypeId'] = LineTypeId;\n  line['LineTypeCode'] = LineTypeCode;\n  line['RequisitionLineSource'] = \"NONCATALOG\";\n  line['RequesterId'] = userPreference.RequesterId;\n  \n  linesArray.push(line);\n\naddToCartWithHeaderPayload['header']= header;\naddToCartWithHeaderPayload['lines']= linesArray;\n\nreturn addToCartWithHeaderPayload;"
          },
          "outcomes": {
            "success": "1762468697935"
          },
