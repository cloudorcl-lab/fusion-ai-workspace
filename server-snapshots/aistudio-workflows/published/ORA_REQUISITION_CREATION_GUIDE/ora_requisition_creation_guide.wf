              "value": "{{($context.$nodes.CONFIRM_BEST_MATCH_OR_REQUEST_CHANGE.$feedbackRecieved != null && $context.$nodes.PROCESS_CONFIRM_BEST_MATCH_OR_REQUEST_CHANGE.$output.result.Status == 'VALID') || $context.$nodes.NCR_STARTER_HUMAN_APPROVAL_NODE.$feedbackRecieved != null || ($context.$nodes.CONFIRM_NCR_OR_NEW_SEARCH.$feedbackRecieved != null && $context.$nodes.CONFIRM_NCR_OR_NEW_SEARCH.$feedbackRecieved.toLowerCase() == \"ncr\")}}"
