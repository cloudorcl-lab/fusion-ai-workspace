            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Process UOM and Price in PU 1",
            "returnType": "object",
            "sourceCode": "const workflowResponse =  (JSON.parse($context.$nodes.UOM_AND_PRICE_FEEDBACK_VALIDATION_ATTEMPT_1.$output.output)).result;\nconst uomMatchRecords = workflowResponse.uomMatchRecords ;\nconst uomContainsRecords = workflowResponse.uomContainsRecords ;\nconst userProvidedData = workflowResponse.userProvidedData ;\nconst derivedLineTypeId = $context.$variables.derivedLineTypeId; \n\n//formate price function\nconst formatPrice = (input , currencyCode) => {\n  if (input == null || isNaN(input)) return (0).toFixed($context.$variables.allPrecisions[currencyCode]);\n  const num = Number(input);\n  const str = String(input);\n  var parts = str.split('.');\n  var decimalLength = parts[1] ? parts[1].length : 0;\n\n  if (Number.isInteger(num) || decimalLength <= $context.$variables.allPrecisions[currencyCode]) {\n    return formatNumber(num.toFixed( $context.$variables.allPrecisions[currencyCode] )); \n  }\n \n\n  if (decimalLength > 10) {\n    return formatNumber(num.toFixed(10));\n  }\n  return formatNumber(num);\n};\n\nconst formatNumber = (input) => {\n  const parts = String(input).split('.');\n  const integerPart = parts[0].replace(/\\B(?=(\\d{3})+(?!\\d))/g, $context.$variables.userSelfDetails.GroupingSeparator);\n  let result = parts[1] ? `${integerPart}${$context.$variables.userSelfDetails.DecimalSeparator}${parts[1]}` : `${integerPart}`;\n  \n  return result;\n};\n\nlet derivedUOM = $context.$variables.derivedUOM;\nlet derivedPrice = $context.$variables.derivedPrice;\nlet derivedAmount = $context.$variables.derivedAmount;\nlet userProvidedUOM = userProvidedData.UOM;\nlet userProvidedPrice = userProvidedData.Price;\nlet currentNcrData = $context.$variables.currentNcrData;\nlet displayString = ``;\nlet requestChangeString = ``;\nlet isNewUom = false;\nlet isNewPrice = false;\n\nif(userProvidedUOM != null){\nif(uomMatchRecords.length > 0){\n      derivedUOM = uomMatchRecords[0].UOM;\n     isNewUom = true;\n   }else if(uomContainsRecords.length > 0){\n     derivedUOM = uomContainsRecords[0].UOM;\n     isNewUom = true;\n  }\n}\n\nif(userProvidedPrice != null){\n    const input = userProvidedPrice;\n    let isValidPrice = !isNaN(input) && input.trim() !== '' && !isNaN(parseFloat(input)) && (Number(input) >= 0);\n    if(isValidPrice){\n     derivedPrice = Number(input);\n     isNewPrice = true;\n  }\n}\n\ncurrentNcrData['Price'] = (derivedLineTypeId == 1 || derivedLineTypeId == 7) ? derivedPrice:null;\ncurrentNcrData['UOM'] = derivedUOM;\ncurrentNcrData['Amount'] = (derivedLineTypeId == 6) ? derivedPrice:null;\n\nconst hasInvalidUom = userProvidedUOM != null && !isNewUom;\nconst hasInvalidPrice = userProvidedPrice != null && !isNewPrice;\nconst isQuantityType = derivedLineTypeId == 1 || derivedLineTypeId == 7;\nconst isAmountType = derivedLineTypeId == 6;\n\nif (hasInvalidUom || hasInvalidPrice) {\n    if (isQuantityType) {\n        displayString += `I found some issues with the data you provided:<br>`;\n    }\n\n    if (hasInvalidPrice) {\n        if (isQuantityType) {\n            displayString += `<span style=\"font-size: 24px;\">•</span> <span style=\"color:red;\"><strong>${userProvidedPrice}</strong></span> provided for price, is not a valid number.<br>`;\n        } else if (isAmountType) {\n            displayString += `I found some issues with the data you provided:<br>`;\n            displayString += `<span style=\"font-size: 24px;\">•</span> <span style=\"color:red;\"><strong>${userProvidedPrice}</strong></span> provided for amount, is not a valid number.<br>`;\n        }\n    }\n\n    if (hasInvalidUom) {\n        if (isQuantityType) {\n            displayString += `<span style=\"font-size: 24px;\">•</span> Couldn't find a UOM matching <span style=\"color:red;\"><strong>${userProvidedUOM}</strong></span>.<br>`;\n        } else if (!hasInvalidPrice) {\n            displayString += `Couldn't understand the input.<br>`;\n        }\n    }\n\n    displayString += `<br>`;\n}\n\n if(isNewPrice || isNewUom){\n   if(derivedLineTypeId == 1 || derivedLineTypeId == 7){\n     displayString += `I have captured:     <br><br>`;\n     if(isNewUom){\n       displayString +=`UOM: ${derivedUOM}<br>`;\n     }\n     if(isNewPrice){\n      displayString +=`Price: ${formatPrice(derivedPrice , currentNcrData['Currency'] )} ${currentNcrData['Currency']}<br>`;\n     }\n     displayString += `<br>`;\n    }\n  }\n\nif((userProvidedUOM != null && !isNewUom) || (userProvidedPrice != null && !isNewPrice)){\n     if((userProvidedUOM != null && !isNewUom) && (userProvidedPrice != null && !isNewPrice) && (derivedLineTypeId == 1 || derivedLineTypeId == 7)){\n         displayString += `Enter a valid Price and UOM.<br>`;\n     }\n     else if(userProvidedPrice != null && !isNewPrice){\n      displayString += (derivedLineTypeId == 1 || derivedLineTypeId == 7) ?`Enter a valid Price.<br>` :  `Enter a valid Amount.<br>`;\n   }\n    else{\n      displayString += (derivedLineTypeId == 1 || derivedLineTypeId == 7) ?`Enter a valid UOM.<br>` :  `Enter a valid Amount.<br>`;\n   }\n}else{\n      if(isNewUom){\n       displayString += isQuantityType ?`Enter Price.<br>` : `Couldn't understand the input.<br><br> Enter a valid Amount.<br>`;\n     }\n     if(isNewPrice){\n      displayString +=`Enter UOM.<br>`;\n     }\n     if(!(isNewUom || isNewPrice)){\n        displayString += `Couldn't understand the input.<br><br>`;\n       if(derivedLineTypeId == 1 || derivedLineTypeId == 7){\n            if(derivedUOM != null){\n            displayString +=`Enter a valid Price.<br>`;\n            }else if(derivedPrice != null){\n           displayString +=`Enter a valid UOM.<br>`;\n           }else{\n           displayString +=`Enter a valid Price and UOM.<br>`;\n           }\n       }else{\n           displayString +=`Enter a valid Amount.<br>`;\n       }\n\n    }\n}\n\nif(derivedUOM == null && derivedPrice == null){\n    requestChangeString += `Enter Price and UOM.`;\n}else if(derivedUOM == null){\n   requestChangeString += `Enter UOM.`;\n}else if(derivedPrice == null){\n   requestChangeString += `Enter Price.`;\n}\n\nderivedAmount = (derivedLineTypeId == 6) ? derivedPrice : null;\nderivedPrice = (derivedLineTypeId == 1 || derivedLineTypeId == 7) ? derivedPrice : null;\n\nlet result = {\"currentNcrData\" : currentNcrData, \"derivedPrice\" : derivedPrice,  \"derivedAmount\" : derivedAmount, \"derivedUOM\" : derivedUOM, \"displayString\" : displayString, \"requestChangeString\" : requestChangeString};\n\nreturn result;"
          },
