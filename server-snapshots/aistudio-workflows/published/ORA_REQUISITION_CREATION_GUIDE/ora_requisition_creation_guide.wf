        {
          "metadata": {
            "name": "prepare ask price and UOM_1",
            "returnType": "object",
            "sourceCode": "const derivedUOM = $context.$variables.derivedUOM;\nconst derivedPrice = $context.$variables.derivedPrice;\nconst derivedAmount = $context.$variables.derivedPrice;\nconst derivedLineTypeId = $context.$variables.derivedLineTypeId;\nlet displayString = null;\nlet requestChangeString = null;\nlet response = {};\n\nif(derivedLineTypeId == 1 || derivedLineTypeId == 7){\n  if(derivedUOM == null && derivedPrice == null){\n   displayString = `Enter Price and UOM for your request.<br>`;\n   requestChangeString = `Enter Price and UOM.`;\n   }else if(derivedPrice == null){\n  displayString = `Enter Price for your request.<br>`;\n  requestChangeString = `Enter Price.`;\n  }else{\n  displayString = `Enter UOM for your request.<br>`;\n  requestChangeString = `Enter UOM.`;\n  }\n}else if(derivedLineTypeId == 6){\n   displayString = `Enter Amount for your request.<br>`;\n   requestChangeString = `Enter Amount.`;\n}\n\nresponse['displayString'] = displayString;\nresponse['requestChangeString'] = requestChangeString;\n\nreturn response;"
          },
