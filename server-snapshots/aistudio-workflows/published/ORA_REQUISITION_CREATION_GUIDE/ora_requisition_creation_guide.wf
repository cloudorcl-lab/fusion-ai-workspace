            "name": "Prepare NCR Input Validation Stage 2",
            "returnType": "object",
            "sourceCode": "let response = {};\nresponse['NcrFeedback'] = $context.$nodes.CONFIRM_NCR_DATA_OR_REQUEST_CHANGE.$feedbackRecieved != null ? $context.$nodes.CONFIRM_NCR_DATA_OR_REQUEST_CHANGE.$feedbackRecieved : $context.$nodes.NCR_STARTER_HUMAN_APPROVAL_NODE.$feedbackRecieved;\nresponse['Stage'] = 2;\nresponse['Topic'] = 1;\nresponse['GroupingSeparator'] =  $context.$variables.userSelfDetails.GroupingSeparator;\nresponse['DecimalSeparator'] =  $context.$variables.userSelfDetails.DecimalSeparator ;\n \nreturn response;"
