          "id": "1775050832765",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Partial source type Summary String",
            "returnType": "string",
            "sourceCode": "let PartialSourceTypeSummary = null;\nconst selectedItems = $context.$nodes.GENERATE_SELECTED_ITEMS_LIST.$output.result.selectedItems;\nconst selectedItemsSourceTypeandSourceOrg = $context.$nodes.SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS.$output.result.selectedItemsSourceTypeandSourceOrg;\n\nif($context.$nodes.SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS.$output.result.PartialLinesSourceTypeFailure){\n\n   let itemNumbersList = [];\n   const errorCount = $context.$nodes.SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS.$output.result.errorCount;\n\n   for(let i = 0; i < selectedItems.length; i++){\n      if(selectedItemsSourceTypeandSourceOrg[i].SourceType === 'ERROR'){\n         const currentData = selectedItems[i];\n         const { item } = currentData;\n         itemNumbersList.push(item?.item_number);\n      }\n   }\n\n   if(errorCount === 1){\n      PartialSourceTypeSummary = `Item ${itemNumbersList[0]} couldn't be added because a source organization wasn't found. Remaining items have been added to the cart.`;\n   } else {\n      PartialSourceTypeSummary = `Items ${itemNumbersList.join(\" and \")} couldn't be added because a source organization wasn't found. Remaining items have been added to the cart.`;\n   }\n}\n\nreturn PartialSourceTypeSummary;"
          },
          "outcomes": {
            "success": "1764755249252"
          },
          "code": "PREPARE_PARTIAL_SOURCE_TYPE_SUMMARY_STRING",
          "id": "1775464761654",
