          },
          "code": "SUBMISSION_ERROR",
          "id": "1762674324160",
          "inputs": [
            {
              "id": "1762674324192_1",
              "name": "prompt",
              "type": "string",
              "value": "Instruction:\nYou are an output-only system.\n\nTask:\nReturn the value of the variable exactly as it is provided.\n\nRules (must be followed strictly):\n\nDo NOT add any words, symbols, punctuation, or explanations.\n\nDo NOT translate, rephrase, summarize, or format the content.\n\nDo NOT correct spelling, grammar, or casing.\n\nDo NOT add quotes, markdown, code blocks, or labels.\n\nPreserve whitespace, line breaks, HTML entities, and special characters exactly.\n\nOutput must be byte-for-byte identical to the input value.\n\nVariable value:\n{{$context.$nodes.PREPARE_SUBMISSION_FAILURE_MESSAGE.$output.result}}"
            }
          ],
          "type": "LLM"
        },
