        {
          "metadata": {
            "name": "get Quantity",
            "returnType": "number",
            "sourceCode": "//let rawQuantity = $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.RawQuantity != null ? //$context.$nodes.DEFAULT_VALUE_GENERATOR.$output.RawQuantity : 1;\n\n//let quantity = $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.Quantity != null ? $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.Quantity : 1;\n\nlet rawQuantity = $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.RawQuantity != null ? $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.RawQuantity : 1;\n\nlet quantity = $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.Quantity != null ? $context.$nodes.DEFAULT_VALUE_GENERATOR.$output.Quantity : 1;\n\nconst parts = String(rawQuantity).split( $context.$nodes.GET_USER_SELF_DETAILS.$output.items[0].DecimalSeparator );\nconst integerPart = parts[0].replaceAll( $context.$nodes.GET_USER_SELF_DETAILS.$output.items[0].GroupingSeparator , \"\");\nlet result = parts[1]  ? `${integerPart}.${parts[1]}`  : `${integerPart}`;\n\nlet finalValue;\n\nif (isNaN(result)) {\n  finalValue = Number(quantity) > 0 ? quantity : 1;\n} else {\n  finalValue = Number(result) > 0 ? result : 1;\n}\n\nreturn finalValue;"
          },
          "outcomes": {
            "success": "1762691881468"
          },
