        },
        {
          "metadata": {
            "name": "Get Suggested Suppliers For NCR",
            "toolCode": "ORA_PURCHASE_REQUISITION_CREATION_POLICY_DOCUMENT"
          },
          "outcomes": {
            "success": "1776406625572"
          },
          "code": "GET_SUGGESTED_SUPPLIERS_FOR_NCR",
          "convergenceTargetId": "1776681557599",
          "id": "1776362588245",
          "inputs": [
            {
              "id": "1776362588245_1",
              "name": "question",
              "type": "string",
              "value": "You are a Non-Catalog Request Policy Suggested Suppliers Extractor.\n\nUse the tool \"Purchase Requisition Creation Policy Document\" and extract only non-catalog / non-standard procurement policy content.\n\nYour task is to return category-to-supplier mappings exactly as stated in the policy.\n\nStrict rules:\n- Consider only policy sections related to \"non-catalog\", \"non-standard\", \"free text request\", or similar procurement flows.\n- Ignore all catalog, standard item, punchout, or search-related policy content.\n- Extract mappings only when BOTH category and supplier are explicitly mentioned in the same policy statement.\n- Extract only when the policy explicitly suggests, recommends, mandates, or allows a supplier.\n- Ignore suppliers mentioned in a negative or prohibited context (e.g., \"do not use\", \"not allowed\").\n- Do not infer, guess, normalize, or invent category names or supplier names.\n- Preserve exact category and supplier values as written in the policy.\n- For each category:\n  - Return only ONE supplier.\n  - If multiple suppliers are listed, choose the FIRST supplier in policy order.\n- If no valid category-to-supplier mapping exists, return {}.\n- Output must be valid JSON only, with no explanations, notes, or extra text.\n\nOutput format:\n{\n  \"<ExactCategoryFromPolicy>\": \"<ExactSupplierFromPolicy>\"\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"title\": \"AnswerWithCitations\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"value\": {\n      \"type\": \"string\",\n      \"description\": \"The answer text.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"List of citations relevant to the answer.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"citedText\": {\n            \"type\": \"string\",\n            \"description\": \"The cited text.\"\n          }\n        },\n        \"required\": [\n          \"citedText\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"value\",\n    \"citations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "RAG_DOCUMENT_TOOL"
        },
        {
          "metadata": {
            "name": "Set Suggest Suppliers For NCR"
          },
          "outcomes": {
            "success": "1763528492053"
          },
          "code": "SET_SUGGEST_SUPPLIERS_FOR_NCR",
          "convergenceTargetId": "1776681557599",
          "id": "1776406625572",
          "inputs": [
            {
              "id": "1776407289126",
              "name": "IsSuggestedSuppliersDerived",
              "scope": "JOB",
              "type": "boolean",
              "value": "true"
            },
            {
              "id": "1776406671374",
              "name": "SuggestedSuppliersForNCR",
              "scope": "JOB",
              "type": "object",
              "value": "{{JSON.parse($context.$nodes.GET_SUGGESTED_SUPPLIERS_FOR_NCR.$output.value)}}"
            }
          ],
          "type": "SET_FIELDS"
        },
