        {
          "metadata": {
            "name": "prepare Default Info Templates payload",
            "returnType": "object",
            "sourceCode": "const requisitionHeaderId = $context.$variables.updateOrCreatedReqHeaderId;\nlet batchOpArray = [];\nlet updateattributes = {\"CreateDefaultInfoTemplates\": \"Y\"};\nlet infoTemplateObject = {};\n\n\ninfoTemplateObject['id'] = \"part1\";\ninfoTemplateObject['operation'] = \"invoke\";\ninfoTemplateObject['payload'] = {\"updateAttributes\": updateattributes};\ninfoTemplateObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/action/updateAllLines`;\nbatchOpArray.push(infoTemplateObject);\n\nlet result = {\"parts\": batchOpArray};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768299838392"
          },
          "code": "PREPARE_DEFAULT_INFO_TEMPLATES_PAYLOAD",
          "id": "1768299347847",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_PRC_SSP_FSCMRESTENDPOINT",
            "errorNodeId": "1773490419225",
            "functionName": "batch_creation_of_requisition_lines",
            "name": "default Info Templates"
          },
          "outcomes": {
            "success": "1773490419225"
          },
          "code": "DEFAULT_INFO_TEMPLATES",
          "id": "1768299838392",
          "inputs": [
            {
              "id": "1768299864875_1",
              "name": "batch_payload",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_DEFAULT_INFO_TEMPLATES_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "prepare ProjectDFF defaulting",
            "returnType": "object",
            "sourceCode": "const userPreference = $context.$variables.UserPreference[0];\nconst requisitioningOptions = userPreference['requisitioningOptions'];\nconst strDate = requisitioningOptions[0].RequestedDateInLocalTimeOptinFlag ? requisitioningOptions[0].InventoryOrganizationSystemDate : requisitioningOptions[0].LESystemDate;\nconst increment = requisitioningOptions[0].RequestedDeliveryDateOffset != null ? requisitioningOptions[0].RequestedDeliveryDateOffset : 7;\nconst derivedQuantity = $context.$variables.derivedQuantity;\nconst ProjectCostingFeatureOptinFlag = requisitioningOptions[0].ProjectCostingFeatureOptinFlag;\nconst projectDFFofPref = userPreference['projectDFF'].items[0];\n\nconst getProjectDFF = (dffOptin, projectDFF)  => {\n      if (dffOptin && projectDFF[\"_PROJECT_ID\"] != null) {\n        delete projectDFF[\"@context\"];\n        delete projectDFF[\"__FLEX_Context\"];\n        delete projectDFF[\"UserPreferenceId\"];\n        for (var key of Object.keys(projectDFF)) {\n          if (key.endsWith(\"_Display\") || key.endsWith(\"_DisplayValue\")) {\n            delete projectDFF[key];\n          }\n        }\n        return projectDFF;\n      }\n    }\n\nlet requestedDeliveryDate = '';\n\nif (strDate == null || increment == null) { //Any issue when calling profile options, default offset to 7 days\n      var newDateAux = new Date();\n      newDateAux.setDate(newDateAux.getDate() + 7);\n      requestedDeliveryDate = newDateAux.toISOString().substring(0, 10);\n}else{\n      var parts = strDate.split('-');\n      var currentDate = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]), 0, 0, 0, 0);\n      currentDate.setDate(currentDate.getDate() + parseInt(increment));\n      var year = currentDate.getFullYear();\n      var month = '' + (currentDate.getMonth() + 1);\n      var day = '' + currentDate.getDate();\n      if (month.length < 2) {\n        month = '0' + month;\n      }\n      if (day.length < 2) {\n        day = '0' + day;\n      }\n      requestedDeliveryDate = [year, month, day].join('-');\n }\n\n\n\nlet projDFF = (getProjectDFF(ProjectCostingFeatureOptinFlag,projectDFFofPref)) || {};\nif(projDFF[\"_PROJECT_ID\"] != null){\n  projDFF['_EXPENDITURE_ITEM_DATE'] =  requestedDeliveryDate;\n  projDFF['PJC_FLEX_Context'] = \"POR_Requisition\";\n}\n\n\nconst requisitionHeaderId = $context.$variables.updateOrCreatedReqHeaderId;\n\nlet batchOpArray = [];\nlet updateattributes = projDFF;\nlet infoTemplateObject = {};\n\n\ninfoTemplateObject['id'] = \"part1\";\ninfoTemplateObject['operation'] = \"invoke\";\ninfoTemplateObject['payload'] = {\"updateAttributes\": updateattributes};\ninfoTemplateObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/action/updateAllLines`;\nbatchOpArray.push(infoTemplateObject);\n\nlet result = {\"parts\": batchOpArray};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773490517003"
          },
          "code": "PREPARE_PROJECTDFF_DEFAULTING",
          "id": "1773490419225",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
