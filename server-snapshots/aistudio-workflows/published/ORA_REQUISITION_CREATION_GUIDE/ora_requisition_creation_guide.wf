\n  \"NZD\": \"$\",\n  \"OMR\": \"ر.ع.\",\n  \"PAB\": \"B/.\",\n  \"PEN\": \"S/\",\n  \"PGK\": \"K\",\n  \"PHP\": \"₱\",\n  \"PKR\": \"₨\",\n  \"PLN\": \"zł\",\n  \"PYG\": \"₲\",\n  \"QAR\": \"ر.ق\",\n  \"RON\": \"lei\",\n  \"RSD\": \"дин\",\n  \"RUB\": \"₽\",\n  \"RWF\": \"FRw\",\n  \"SAR\": \"﷼\",\n  \"SBD\": \"$\",\n  \"SCR\": \"₨\",\n  \"SDG\": \"ج.س.\",\n  \"SEK\": \"kr\",\n  \"SGD\": \"$\",\n  \"SHP\": \"£\",\n  \"SLE\": \"Le\",\n  \"SLL\": \"Le\",\n  \"SOS\": \"Sh\",\n  \"SRD\": \"$\",\n  \"SSP\": \"£\",\n  \"STN\": \"Db\",\n  \"SYP\": \"£\",\n  \"SZL\": \"L\",\n  \"THB\": \"฿\",\n  \"TJS\": \"ЅМ\",\n  \"TMT\": \"m\",\n  \"TND\": \"د.ت\",\n  \"TOP\": \"T$\",\n  \"TRY\": \"₺\",\n  \"TTD\": \"$\",\n  \"TWD\": \"$\",\n  \"TZS\": \"Sh\",\n  \"UAH\": \"₴\",\n  \"UGX\": \"Sh\",\n  \"USD\": \"$\",\n  \"UYU\": \"$\",\n  \"UZS\": \"soʻm\",\n  \"VES\": \"Bs.\",\n  \"VND\": \"₫\",\n  \"VUV\": \"Vt\",\n  \"WST\": \"T\",\n  \"XAF\": \"FCFA\",\n  \"XCD\": \"$\",\n  \"XOF\": \"CFA\",\n  \"XPF\": \"₣\",\n  \"YER\": \"﷼\",\n  \"ZAR\": \"R\",\n  \"ZMW\": \"ZK\",\n  \"ZWL\": \"$\"\n}"
