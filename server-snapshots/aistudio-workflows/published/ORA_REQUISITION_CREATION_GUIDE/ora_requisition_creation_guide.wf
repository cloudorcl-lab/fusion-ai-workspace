            "name": "prepare Edit cart Input payload",
            "returnType": "object",
            "sourceCode": "let response = {};\nresponse['editCartFeedback'] = $context.$nodes.CONFIRM_SUBMIT_REQUISITION.$feedbackRecieved;\nresponse['requisitionHeaderId'] = $context.$variables.updateOrCreatedReqHeaderId;\nresponse['destinationOrganizationId'] = $context.$variables.UserPreference[0].DestinationOrganizationId;\nresponse['Topic'] = 2;\nresponse['TotalLines'] = $context.$variables.FetchLinesData.items.length;\nresponse['GroupingSeparator'] =  $context.$variables.userSelfDetails.GroupingSeparator;\nresponse['DecimalSeparator'] =  $context.$variables.userSelfDetails.DecimalSeparator;\n\nreturn response;"
          },
          "outcomes": {
