          "inputs": [
            {
              "id": "1764843551229_1",
              "name": "prompt",
              "type": "string",
              "value": "You present a message to user confirming requisition submission.\n\nExtract deep link from  {{$context.$nodes.REQUISITION_DETAILS_DEEP_LINK.$output.result}} \n\nPresent message: <span>Requisition <a href='{deep link here}' target='_blank'>{{$context.$variables.updatedOrCreatedRequisition}}</a> Submitted.</span><br><br>You can continue shopping or close the chat if you're done.\n\nDO not change message."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Submission Error"
          },
          "outcomes": {
