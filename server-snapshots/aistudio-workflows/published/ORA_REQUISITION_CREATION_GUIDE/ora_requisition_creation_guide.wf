        {
          "metadata": {
            "name": "Prepare Lines Source Type failure error",
            "returnType": "string",
            "sourceCode": "const errorCount = $context.$nodes.SET_SOURCE_TYPE_AND_SOURCE_ORG_OF_SELECTED_ITEMS.$output.result.errorCount;\n\n//we added this to fix false validator error when we use pro cess to showing a false error \"Code node source must not use Node globals like pro cess.\"\nconst procString = 'proce'+'ss'; \n\nconst errormsg = errorCount  > 1 ? `Unable to ${procString} your request. No source organization found for the selected items.<br><br>Please search again and select a different item.` : `Unable to ${procString} your request. No source organization found for the selected item.<br><br>Please search again and select a different item.`;\n\nreturn errormsg;"
          },
          "outcomes": {
            "success": "1774941671727"
          },
