        {
          "metadata": {
            "name": "prepare submission failure message",
            "returnType": "string",
            "sourceCode": "const shoppingCartDeepLink = $context.$nodes.SHOPPING_CART_DEEP_LINK.$output.result;\nconst errorDetails = JSON.parse($context.$nodes.SUBMIT_REQUISITION.$error.$info)['o:errorDetails'];\nlet isTemplateOrDffError = false;\nlet issuesString = errorDetails.length > 1 ? `issues`:`issue`;\nlet errorsString = errorDetails.length > 1 ? `errors`:`error`;\n\nlet failureMessage= `<span style=\"display:inline-block;width:15px;height:15px;border-radius:50%;background:#800000;color:#fff;font-weight:900;font-size:8px;line-height:15px;text-align:center;transform:rotate(-135deg);vertical-align:middle;\">━</span>  We encountered some ${issuesString} while submitting the requisition. Requisition submission failed due to below ${errorsString}:<br><br>`;\n\nfor(let i=0 ; i < errorDetails.length ; i++){\n  let error = errorDetails[i]['detail'];\n  if(error.includes(\"POR-2011238\") || error.includes(\"POR-2010769\") || error.includes(\"POR-2010770\")){\n       isTemplateOrDffError = true;\n  }\n  failureMessage += `<span style=\"font-size: 24px;\">•</span> ${error}<br>`;\n}\nfailureMessage += `<br>`;\n\nif(isTemplateOrDffError){\n   failureMessage += `It seems you need to provide additional information before submitting this requisition. Click <b><a href=\"${shoppingCartDeepLink}\" target='_blank'>here</a></b> to navigate to the application to fill in the required information and submit the requisition.<br>`;\n}else{\n   failureMessage += `Click <b><a href=\"${shoppingCartDeepLink}\" target='_blank'>here</a></b> to navigate to the application to correct the ${errorsString} and submit the requisition.<br>`;\n}\n\nreturn failureMessage;"
          },
          "outcomes": {
            "success": "1762674324160"
          },
          "code": "PREPARE_SUBMISSION_FAILURE_MESSAGE",
