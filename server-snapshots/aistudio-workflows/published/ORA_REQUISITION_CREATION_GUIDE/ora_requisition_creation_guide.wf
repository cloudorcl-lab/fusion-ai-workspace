        {
          "metadata": {
            "name": "Generate selected items list",
            "returnType": "object",
            "sourceCode": "const actionPerformed = $context.$nodes.CONFIRM_BEST_MATCH_OR_REQUEST_CHANGE.$actionPerformed;\nconst destinationType = $context.$variables.UserPreference[0].DestinationTypeCode;\nconst destinationOrgId = $context.$variables.UserPreference[0].DestinationOrganizationId;\nconst hasIMTPermission = $context.$variables.isIMTEnabled;\nconst isIMToptinEnabled = $context.$variables.UserPreference[0].requisitioningOptions[0].InternalMaterialTransfersOptinFlag;\nconst sourceAgreementlinesInternallyForExpenseDest = $context.$variables.UserPreference[0].requisitioningOptions[0].ExpenseAgreementLinesFromInternalSourcesOptinFlag;\nlet selectedItems = [];\nlet selectedIndexes = [];\nlet selectedItemsInternalOrExternal = [];\nlet response = {};\n\nif(actionPerformed == 'APPROVED'){\n    selectedItems.push($context.$variables.CatalogSearchResults.items[0]);\n    selectedIndexes.push(1); \n}else{\n   let requestChangeFeedback = $context.$nodes.PROCESS_CONFIRM_BEST_MATCH_OR_REQUEST_CHANGE.$output.result.itemsList;\n   selectedIndexes = requestChangeFeedback.split(\",\").map(Number);\n   for(let i=0 ; i < selectedIndexes.length ; i++){\n      selectedItems.push($context.$variables.CatalogSearchResults.items[selectedIndexes[i]-1]);\n   }   \n}\n\n// method to check if the agreement line can be internally ordered in the context of user preferenced destination organization.\n    const isAgreementLineInternal = (prefDestOrgId, agreementInventoryOrgsList) => {\n      var isInternalLine = false;\n      if (agreementInventoryOrgsList != null) {\n        for (var i = 0; i < agreementInventoryOrgsList.length; i++) {\n          if (agreementInventoryOrgsList[i].organization_id == prefDestOrgId && agreementInventoryOrgsList[i].internally_transferable_item_flag == 'Y' && agreementInventoryOrgsList[i].internal_transfer_order_enabled_flag == 'Y') {\n            isInternalLine = true;\n            break;\n          }\n        }\n      }\n      return isInternalLine;\n    }\n\n\n//method to check if the masteritem or agreementline can be internally or externally orderable or both in the context of user preferenced destination organization or destination type.\n  const isInternallyOrderableLineOrExternal = (documentType, itemType, itemId, agreementLineItemInventoryOrgs, userPrefDestOrgId, userPrefDestType, hasIMTPermission, isIMToptinEnabled, sourceAgreementlinesInternallyForExpenseDest) => {\n\n    var isInternallyOrderable = false;\n    var isExternallyOrderable = false;\n\n    //To check if the item/line is internally orderable or not.\n    if (itemId != -2 && hasIMTPermission && isIMToptinEnabled) {\n      if (documentType === 'MASTER_ITEM'  && (itemType == 'INTERNAL' || itemType == 'INTERNAL_AND_PURCHASE')) {\n        isInternallyOrderable = true;\n      }\n      else if (documentType === 'BLANKET' && isAgreementLineInternal(userPrefDestOrgId, agreementLineItemInventoryOrgs) && sourceAgreementlinesInternallyForExpenseDest && userPrefDestType === 'EXPENSE') {\n       isInternallyOrderable = true;\n      }\n    }\n\n    //To check if the item/line is externally orderable or not.\n    if (itemType != null && itemType != 'INTERNAL') {\n      isExternallyOrderable = true;\n    }\n\n    return [isInternallyOrderable, isExternallyOrderable];\n  };\n\n  for(let i=0 ; i < selectedItems.length ; i++){\n      const { document_type, item_type, item_id, agreement_line_item_inventory_orgs} = selectedItems[i];\n      let isInternalOrExternallyOrderItem = isInternallyOrderableLineOrExternal(document_type, item_type, item_id, agreement_line_item_inventory_orgs, destinationOrgId, destinationType, hasIMTPermission, isIMToptinEnabled, sourceAgreementlinesInternallyForExpenseDest);\n      selectedItemsInternalOrExternal.push(isInternalOrExternallyOrderItem);\n   }   \n\n\nresponse.selectedItems = selectedItems;\nresponse.selectedIndexes = selectedIndexes;\nresponse.selectedItemsInternalOrExternal = selectedItemsInternalOrExternal;\n\nreturn response;"
          },
          "outcomes": {
            "success": "1774889389104"
          },
          "code": "GENERATE_SELECTED_ITEMS_LIST",
          "id": "1764683648401",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
