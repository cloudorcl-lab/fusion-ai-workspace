        },
        {
          "metadata": {
            "name": "perform cart Edit",
            "workflowCode": "ORA_NCR_VALIDATION_AND_CART_MODIFICATION_ASSISTANT"
          },
          "outcomes": {
            "success": "1767605170240"
          },
          "code": "PERFORM_CART_EDIT",
          "id": "1767544939801",
          "inputs": [
            {
              "id": "1767775987939_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_EDIT_CART_INPUT_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "process cart Edit output",
            "returnType": "object",
            "sourceCode": "const editCartOutput = (JSON.parse($context.$nodes.PERFORM_CART_EDIT.$output.output)).result;\n\nlet isEditCartFailed = false;\nlet editCartFailureMessage = `I found some issues with the data you provided:<br>`;\nlet isLinesDeleteSucceeded = false;\nlet linesDeleteCount = null;\nlet isInternalLocationUpdated = false;\nlet isLineQuantitiesUpdated = false;\nlet isRequesterUpdated = false;\nlet isLocationDefaulted = false;\n\nconst locationStatus = editCartOutput.LocationChangeStatus?.updateLocationStatus;\nconst quantityStatus = editCartOutput.QuantityUpdates?.quantityUpdateStatus;\nconst requesterStatus = editCartOutput.RequesterChangeStatus?.updateRequesterStatus;\n\nconst quantitiesList = editCartOutput.userProvidedData?.QuantityUpdates;\n\n\n// LOCATION FAILURE\nif(locationStatus === 'FAILURE'){\n\n    const userLocation = editCartOutput.userProvidedData?.InternalLocation;\n\n    isEditCartFailed = true;\n    //we have false validator error when we use this string so did woarkaround to fix it \n    const locationString = 'locat'+'ion';\n\n    editCartFailureMessage += `<div style=\"padding-left:15px;\"><span style=\"font-size:24px;\">•</span> Couldn't find a delivery ${locationString} matching <span style=\"color:red;\">${userLocation}</span>.</div>`;\n}\n\n\n// QUANTITY FAILURE\nif(quantityStatus === 'FAILURE'){\n\n    isEditCartFailed = true;\n\n    const errorLines = editCartOutput.QuantityUpdates?.TotalLines;\n\n    editCartFailureMessage += `<div style=\"padding-left:15px;\">`;\n\n    if(errorLines?.length){\n\n        for(let i=0;i<errorLines.length;i++){\n\n            let lineNumber = Object.keys(errorLines[i])[0];\n            let quantity = Object.values(errorLines[i])[0];\n\n            editCartFailureMessage += `<span style=\"font-size:24px;\">•</span> <span style=\"color:red;\">${quantity}</span> provided for quantity at line ${lineNumber} is not valid.<br>`;\n        }\n    }\n\n    editCartFailureMessage += `</div>`;\n}\n\n\n// REQUESTER FAILURE\nif(requesterStatus === 'FAILURE'){\n\n    const requesterName = editCartOutput.userProvidedData?.Requester;\n\n    isEditCartFailed = true;\n\n    editCartFailureMessage += `<div style=\"padding-left:15px;\"><span style=\"font-size:24px;\">•</span> Couldn't find requester matching <span style=\"color:red;\">${requesterName}</span>.</div>`;\n}\n\n\n// SUCCESS SUMMARY (single block)\nif(\n    locationStatus === 'SUCCESS' ||\n    quantityStatus === 'SUCCESS' ||\n    requesterStatus === 'SUCCESS'\n){\n\n    editCartFailureMessage += `<br>Here are the updated fields:<br><div style=\"padding-left:15px;padding-top:5px;\">`;\n\n    if(locationStatus === 'SUCCESS'){\n\n        editCartFailureMessage += `Delivery Address: ${editCartOutput.LocationChangeStatus.LocationName} : ${editCartOutput.LocationChangeStatus.LocationCode}<br>`;\n    }\n\n    if(quantityStatus === 'SUCCESS' && quantitiesList?.length){\n\n        for(let i=0;i<quantitiesList.length;i++){\n\n            let lineNumber = Object.keys(quantitiesList[i])[0];\n            let quantity = Object.values(quantitiesList[i])[0];\n\n            editCartFailureMessage += `Line ${lineNumber}, Quantity: ${quantity}<br>`;\n        }\n    }\n\n    if(requesterStatus === 'SUCCESS'){\n\n        const requesterName =\n        editCartOutput.RequesterChangeStatus?.RequesterName ||\n        editCartOutput.userProvidedData.Requester;\n\n        editCartFailureMessage += `Requester: ${requesterName}<br>`;\n    }\n\n    editCartFailureMessage += `</div><br>`;\n}\n\n\n// footer buttons\nif(isEditCartFailed){\n\n    editCartFailureMessage += `Click <b>Approve</b> to submit requisition with current values.<br><br>Click <b>Request Change</b> to provide new values.<br><br>`;\n}\n\n\n// DELETE SUCCESS\nif(\neditCartOutput.userProvidedData?.DeleteLines &&\neditCartOutput.LinesDelete?.DeleteLinesStatus === 'SUCCESS'\n){\n\n    linesDeleteCount = editCartOutput.LinesDelete.TotalLines;\n    isLinesDeleteSucceeded = true;\n}\n\n\n// FLAGS\nif(locationStatus === 'SUCCESS')\nisInternalLocationUpdated = true;\n\nif(quantityStatus === 'SUCCESS')\nisLineQuantitiesUpdated = true;\n\nif(requesterStatus === 'SUCCESS')\nisRequesterUpdated = true;\n\nif(editCartOutput.RequesterChangeStatus?.locationDefaulted)\nisLocationDefaulted = true;\n\nlet finalresult = {\"isEditCartFailed\" : isEditCartFailed,\"editCartFailureMessage\" : editCartFailureMessage,\"isLinesDeleteSucceeded\": isLinesDeleteSucceeded,\"linesDeleteCount\" : linesDeleteCount,\"isInternalLocationUpdated\" : isInternalLocationUpdated,\"isLineQuantitiesUpdated\" : isLineQuantitiesUpdated,\"isRequesterUpdated\" : isRequesterUpdated, \"isLocationDefaulted\" : isLocationDefaulted};\n\nreturn finalresult;"
          },
          "outcomes": {
            "success": "1767605219676"
          },
