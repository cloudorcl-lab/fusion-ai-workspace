          "inputs": [
            {
              "id": "1776507683223_1",
              "name": "condition",
              "type": "string",
              "value": "{{!$context.$variables.IsSuggestedSuppliersDerived && !$context.$variables.disablePRCreationPolicyAssistant}}"
            }
          ],
