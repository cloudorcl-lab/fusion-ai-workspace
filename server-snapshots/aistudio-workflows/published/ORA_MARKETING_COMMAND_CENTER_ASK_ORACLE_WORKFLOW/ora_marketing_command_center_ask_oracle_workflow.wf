        {
          "id": "1780983852387",
          "code": "PREPARE_QUERY_DATES",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Query Dates",
            "sourceCode": "let result = { startDate: '', endDate: '' };\ntry {\n  const rawQueryParameters = $context.$nodes?.NORMALIZE_QUERY_PARAMETERS?.$output?.result || {};\n  const renewalDaysValue = Number(rawQueryParameters.renewalDays ?? 180);\n  const renewalDays = Number.isFinite(renewalDaysValue) ? Math.min(365, Math.max(1, Math.trunc(renewalDaysValue))) : 180;\n\n  const currentDateStr = $context.$system?.$currentDate || new Date().toISOString().slice(0, 10);\n  const currentDate = new Date(currentDateStr);\n  const validCurrentDate = Number.isNaN(currentDate.getTime()) ? new Date() : currentDate;\n  const endDateObj = new Date(validCurrentDate);\n  endDateObj.setDate(endDateObj.getDate() + renewalDays);\n\n  const formatDate = date => {\n    const year = date.getFullYear();\n    const month = String(date.getMonth() + 1).padStart(2, '0');\n    const day = String(date.getDate()).padStart(2, '0');\n    return `${year}-${month}-${day}`;\n  };\n\n  result = {\n    startDate: formatDate(validCurrentDate),\n    endDate: formatDate(endDateObj),\n    renewalDays\n  };\n} catch (error) {\n  result = { startDate: '', endDate: '', renewalDays: 180 };\n}\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "12"
          },
          "inputs": [],
          "diagram": {
            "x": 8978,
            "y": 7870
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
