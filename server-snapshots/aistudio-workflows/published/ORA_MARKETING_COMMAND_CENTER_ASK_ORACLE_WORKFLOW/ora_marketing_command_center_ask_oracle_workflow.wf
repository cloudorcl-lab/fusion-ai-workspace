            },
            {
              "id": "7_parentProductName",
              "name": "parentProductName",
              "value": "{{$context.$nodes.RETRIEVE_PARENT_PRODUCT_NAME_AND_ID.$output.result.parentProductName}}"
            },
            {
              "id": "7_targetProductId",
              "name": "targetProductId",
              "value": "{{$context.$nodes.RETRIEVE_PARENT_PRODUCT_NAME_AND_ID.$output.result.targetProductId}}"
            },
            {
              "id": "7_targetProductName",
              "name": "targetProductName",
              "value": "{{$context.$nodes.RETRIEVE_PARENT_PRODUCT_NAME_AND_ID.$output.result.targetProductName}}"
            },
            {
              "id": "7_appContextMode",
              "name": "appContextMode",
              "value": "{{$context.$nodes.RETRIEVE_PARENT_PRODUCT_NAME_AND_ID.$output.result.appContextMode}}"
            }
          ],
          "diagram": {
            "x": 8978,
            "y": 5428
          }
        },
        {
          "id": "9",
          "code": "GET_CHILD_PRODUCTS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Child Products",
            "businessObjectCode": "ORA_CX_MARKETING_EXTRACTIONQUERIES",
            "functionName": "getChildProducts"
          },
          "outcomes": {
            "success": "10"
          },
          "inputs": [
            {
              "id": "9_parentProductId",
              "name": "parentProductId",
              "value": "{{$context.$nodes.SET_PARENT_PRODUCT_ID.$output.result}}",
              "required": true,
              "type": "string"
            }
          ],
          "diagram": {
            "x": 8528,
            "y": 6316
          }
        },
        {
          "id": "10",
          "code": "SET_CHILD_IDS",
          "type": "CODE",
          "metadata": {
            "name": "Set Child Ids",
            "sourceCode": "let result = '';\ntry {\n  const items = $context.$nodes?.GET_CHILD_PRODUCTS?.$output?.items || [];\n  if (Array.isArray(items) && items.length > 0) {\n    const productResult = items[0]?.productResult;\n    if (typeof productResult === 'string') {\n      const parsedProductResult = JSON.parse(productResult);\n      const childProducts = parsedProductResult?.childProducts;\n      if (Array.isArray(childProducts)) {\n        result = childProducts\n          .map(child => child?.childProductId)\n          .filter(id => typeof id === 'string' && id.length > 0)\n          .map(id => `'${id}'`)\n          .join(',');\n      }\n    }\n  }\n} catch (error) {\n  result = '';\n}\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 8528,
            "y": 6538
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "11",
          "code": "ROUTE_QUERY_AREA",
          "type": "CODE",
          "metadata": {
            "name": "Route Query Area",
            "sourceCode": "let result = 'unsupported';\ntry {\n  const normalizedParams = $context.$nodes?.NORMALIZE_QUERY_PARAMETERS?.$output?.result || {};\n  const knownAreas = [\n    'activePrograms',\n    'crossSellAccounts',\n    'renewalAccounts',\n    'renewalsAdvisor',\n    'renewalsAdvisorAccounts',\n    'renewalsAdvisorBuyingGroups',\n    'renewalsAdvisorContentTypes',\n    'renewalsAdvisorPrograms',\n    'renewalsAdvisorCombined',\n    'combined',\n    'unsupported'\n  ];\n\n  if (knownAreas.includes(normalizedParams.workflowAreaOverride)) {\n    result = normalizedParams.workflowAreaOverride;\n    return result;\n  }\n\n  const appContextMode = $context.$variables?.appContextMode || 'marketingStrategyAdvisor';\n  const normalizeActionText = value => {\n    if (value == null) return '';\n    if (typeof value === 'object') value = value.OraAction || value.oraAction || JSON.stringify(value);\n    let textValue = String(value || '').trim();\n    for (let i = 0; i < 3; i += 1) textValue = textValue.replace(/\\\\\"/g, '\"');\n    return textValue;\n  };\n\n  const rawInputMessage = String($context.$system?.$inputMessage || '').trim();\n  const hasFreshTypedQuestion = rawInputMessage !== '' && !/displayAccountsPage|accountDisplayPage/i.test(rawInputMessage);\n  const currentMessage = String(normalizedParams.originalQuestion || rawInputMessage || '');\n  const actionText = hasFreshTypedQuestion || normalizedParams.ignoredStaleActionPayload\n    ? ''\n    : normalizeActionText($context.$app?.$OraAction || $context.$triggers?.REST?.$input?.OraAction || '');\n  const appContextText = [\n    $context.$app?.$OraAppContext,\n    $context.$app?.$OraAppDisplayDiscriminator\n  ].filter(Boolean).join(' ');\n\n  const addScore = (scores, area, terms, weight = 1, text) => {\n    terms.forEach(term => {\n      if (text.includes(term)) {\n        scores[area] += weight;\n      }\n    });\n  };\n\n  const routeWithText = textValue => {\n    const text = String(textValue || '').toLowerCase();\n    if (appContextMode === 'renewalsAdvisor') {\n      const scores = {\n        renewalsAdvisorAccounts: 0,\n        renewalsAdvisorBuyingGroups: 0,\n        renewalsAdvisorContentTypes: 0,\n        renewalsAdvisorPrograms: 0\n      };\n\n      addScore(scores, 'renewalsAdvisorAccounts', [\n        'renewal account', 'renewal accounts', 'renewal date', 'renewal window', 'upcoming renewal',\n        'at-risk', 'at risk', 'risk account', 'risk accounts', 'risk classification', 'risk reason',\n        'retention', 'churn', 'arr', 'revenue exposure', 'usage level', 'open opportunit',\n        'customer', 'customers', 'csm', 'send to sales', 'send for review', 'add account to program',\n        'account', 'accounts', 'critical accounts', 'stable accounts', 'medium risk', 'low risk',\n        'display accounts', 'show accounts', 'list accounts', 'next accounts', 'previous accounts'\n      ], 3, text);\n      addScore(scores, 'renewalsAdvisorAccounts', ['renewal', 'risk', 'revenue', 'usage', 'opportunity'], 1, text);\n\n      addScore(scores, 'renewalsAdvisorBuyingGroups', [\n        'buying group', 'buying groups', 'buying group definition', 'buyer role', 'buyer roles',\n        'persona', 'personas', 'stakeholder', 'stakeholders', 'decision maker', 'decision makers',\n        'influencer', 'influencers', 'purchasing decision', 'purchase decision'\n      ], 3, text);\n      addScore(scores, 'renewalsAdvisorBuyingGroups', ['buyer', 'buyers'], 1, text);\n\n      addScore(scores, 'renewalsAdvisorContentTypes', [\n        'content and messaging', 'content strategy', 'messaging strategy', 'content type', 'content types',\n        'content', 'messaging', 'message', 'messages', 'asset', 'assets', 'collateral', 'ebook', 'e-book',\n        'demo video', 'video', 'success story', 'analyst report', 'case study', 'launch content'\n      ], 3, text);\n\n      addScore(scores, 'renewalsAdvisorPrograms', [\n        'program health', 'program status', 'program performance', 'programs widget', 'programs area',\n        'active program', 'active programs', 'campaign', 'campaigns', 'tactic', 'tactics', 'automation',\n        'automations', 'engagement', 'on track', 'needs review', 'launch program', 'navigate to program'\n      ], 3, text);\n      addScore(scores, 'renewalsAdvisorPrograms', ['program', 'programs'], 1, text);\n\n      const combinedIntent = [\n        'compare', 'comparison', 'overall', 'overview', 'across', 'all areas', 'all workflows', 'all widgets',\n        'combined', 'together', 'everything', 'entire app', 'whole app', 'summary', 'summarize'\n      ].some(term => text.includes(term));\n      const positiveAreas = Object.entries(scores).filter(([, score]) => score > 0);\n\n      if (positiveAreas.length === 0) {\n        return combinedIntent ? 'renewalsAdvisorCombined' : 'unsupported';\n      }\n      if (combinedIntent && positiveAreas.length > 1) {\n        return 'renewalsAdvisorCombined';\n      }\n      if (combinedIntent && ['all widgets', 'all workflows', 'all areas', 'entire app', 'whole app', 'everything'].some(term => text.includes(term))) {\n        return 'renewalsAdvisorCombined';\n      }\n      positiveAreas.sort((a, b) => b[1] - a[1]);\n      const top = positiveAreas[0];\n      const second = positiveAreas[1];\n      return second && top[1] === second[1] ? 'renewalsAdvisorCombined' : top[0];\n    }\n\n    const scores = {\n      activePrograms: 0,\n      crossSellAccounts: 0,\n      renewalAccounts: 0\n    };\n\n    addScore(scores, 'activePrograms', ['active program', 'active programs', 'program status', 'program health', 'campaign', 'campaigns', 'milestone', 'milestones', 'tactic', 'tactics', 'ongoing program', 'program performance'], 2, text);\n    addScore(scores, 'activePrograms', ['program', 'programs', 'initiative', 'initiatives', 'status', 'health', 'next step'], 1, text);\n\n    addScore(scores, 'crossSellAccounts', ['cross-sell', 'cross sell', 'cross-sell account', 'cross sell account', 'cross-sell accounts', 'cross sell accounts', 'target account', 'target accounts', 'existing product', 'owned product', 'product alignment', 'expansion opportunity', 'sales ready', 'display accounts', 'show accounts', 'list accounts', 'next accounts', 'previous accounts'], 3, text);\n    addScore(scores, 'crossSellAccounts', ['industry', 'industries', 'opportunity', 'opportunities', 'potential revenue', 'fit', 'accounts represented', 'represented'], 2, text);\n    addScore(scores, 'crossSellAccounts', ['account count', 'accounts', 'revenue opportunity'], 1, text);\n\n    addScore(scores, 'renewalAccounts', ['renewal', 'renewals', 'renewal account', 'renewal accounts', 'renewal date', 'renewal window', 'at-risk', 'at risk', 'risk account', 'risk accounts', 'retention', 'churn'], 3, text);\n    addScore(scores, 'renewalAccounts', ['arr', 'revenue exposure', 'risk', 'renew'], 1, text);\n\n    const combinedIntent = ['compare', 'comparison', 'overall', 'across', 'both', 'all areas', 'all workflows', 'combined', 'together'].some(term => text.includes(term));\n    const positiveAreas = Object.entries(scores).filter(([, score]) => score > 0);\n\n    if (positiveAreas.length === 0) {\n      return combinedIntent ? 'combined' : 'unsupported';\n    }\n    if (combinedIntent && positiveAreas.length > 1) {\n      return 'combined';\n    }\n    positiveAreas.sort((a, b) => b[1] - a[1]);\n    const top = positiveAreas[0];\n    const second = positiveAreas[1];\n    return second && top[1] === second[1] ? 'combined' : top[0];\n  };\n\n  const currentRoutingText = [currentMessage, actionText, appContextText].filter(Boolean).join(' ');\n  result = routeWithText(currentRoutingText);\n\n  const followUpPattern = /\b(it|that|those|them|they|same|previous|prior|earlier|above|first|second|third|also|too|more|details|why|next)\b|\b(what about|how about|tell me more|show me more)\b/i;\n  const wordCount = currentMessage.trim().split(/s+/).filter(Boolean).length;\n  const useHistoryForRouting = result === 'unsupported' && (followUpPattern.test(currentMessage) || wordCount <= 5);\n  if (useHistoryForRouting) {\n    const historyRoutingText = [currentRoutingText, $context.$system?.$chatHistory].filter(Boolean).join(' ');\n    result = routeWithText(historyRoutingText);\n  }\n} catch (error) {\n  result = 'unsupported';\n}\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1780983852387"
          },
          "inputs": [],
          "diagram": {
            "x": 8978,
            "y": 7648
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "12",
          "code": "QUERY_AREA_SWITCH",
          "type": "SWITCH",
          "metadata": {
            "name": "Query Area Switch"
          },
          "outcomes": {
            "activePrograms": "13",
            "crossSellAccounts": "14",
            "renewalAccounts": "15",
            "renewalsAdvisor": "1780983852388",
            "renewalsAdvisorAccounts": "1780983852388",
