        {
          "id": "1780983852394",
          "code": "GET_RENEWALS_ADVISOR_PROGRAMS_FOR_QUERY",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Get Renewals Advisor Programs For Query",
            "businessObjectCode": "ORA_CX_MARKETING_DATAOBJECTS",
            "functionName": "getProgramsListForSingleProduct"
          },
          "outcomes": {
            "success": "1780983852395"
          },
          "inputs": [
            {
              "id": "1780983852394_childProductIds",
              "name": "childProductIds",
              "value": "{{$context.$variables.targetProductId}}",
