            "success": "6"
          },
          "inputs": [],
          "diagram": {
            "x": 9100,
            "y": 5000
          }
        },
        {
          "id": "1",
          "code": "AI_APP_MESSAGE_ROUTER",
          "type": "SWITCH",
          "metadata": {
            "name": "AI App Message Router"
          },
          "outcomes": {
            "Summary": "3",
            "InitDisplay": "4",
            "Query": "1780983852384",
            "InvokeAction": "1782123212381"
          },
          "inputs": [
            {
              "id": "1_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$app.$OraMessageHint}}"
            }
          ],
