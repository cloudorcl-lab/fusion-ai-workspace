        {
          "id": "1780983852395",
          "code": "PREPARE_RENEWALS_ADVISOR_PROGRAMS_FOR_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Renewals Advisor Programs For Query",
            "sourceCode": "let result = [];\ntry {\n  const programs = $context.$nodes?.GET_RENEWALS_ADVISOR_PROGRAMS_FOR_QUERY?.$output?.items || [];\n  result = programs.map(program => {\n    const automations = program?.automations?.items || [];\n    const totalTactics = automations.length;\n    let tacticsMeets = 0;\n    let tacticsBelowExpectation = 0;\n\n    automations.forEach(tactic => {\n      const metrics = tactic?.metrics?.items || [];\n      const enterAutomationMetric = metrics.find(m => m?.eventType === 'enterAutomation');\n      const meetTacticSuccessCriteriaMetric = metrics.find(m => m?.eventType === 'meetTacticSuccessCriteria');\n      const enterCount = enterAutomationMetric ? Number(enterAutomationMetric.eventCount) : 0;\n      const meetCount = meetTacticSuccessCriteriaMetric ? Number(meetTacticSuccessCriteriaMetric.eventCount) : 0;\n      const successPercentage = enterCount > 0 ? meetCount / enterCount : 0;\n      if (successPercentage >= 0.05) {\n        tacticsMeets += 1;\n      } else {\n        tacticsBelowExpectation += 1;\n      }\n    });\n\n    let priority = '';\n    let badgeText = '';\n    let subtitle = '';\n    if (tacticsMeets >= Math.ceil(totalTactics / 2)) {\n      priority = 'success';\n      badgeText = 'On track';\n      subtitle = tacticsMeets + ' out of ' + totalTactics + ' tactics meet expected success rates.';\n    } else {\n      priority = 'warning';\n      badgeText = 'Needs Review';\n      subtitle = tacticsBelowExpectation + ' out of ' + totalTactics + ' tactics show below expected success rates.';\n    }\n\n    return {\n      id: program?.id,\n      name: program?.name,\n      totalTactics,\n      tacticsMeets,\n      tacticsBelowExpectation,\n      subtitle,\n      priority,\n      badgeText\n    };\n  });\n} catch (error) {\n  result = [];\n}\nreturn result;",
            "returnType": "array"
          },
          "outcomes": {
            "success": "19"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 8812
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1782122075518",
          "code": "NORMALIZE_QUERY_PARAMETERS",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Query Parameters",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const extractorOutput = $context.$nodes?.EXTRACT_QUERY_PARAMETERS?.$output || {};\n  const extracted = extractorOutput?.result && typeof extractorOutput.result === 'object' ? extractorOutput.result : extractorOutput;\n\n  const positiveInteger = (value, fallback) => {\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n  };\n\n  const clampInteger = (value, fallback, min, max) => {\n    const parsed = Number.parseInt(value, 10);\n    if (!Number.isFinite(parsed)) return fallback;\n    return Math.min(max, Math.max(min, parsed));\n  };\n\n  const cleanString = value => String(value ?? '').trim();\n\n  const normalizeActionText = value => {\n    if (value == null) return '';\n    if (typeof value === 'object') {\n      value = value.OraAction || value.oraAction || value.action || JSON.stringify(value);\n    }\n    let text = String(value || '').trim();\n    try {\n      const parsed = JSON.parse(text);\n      if (parsed && typeof parsed === 'object') {\n        text = String(parsed.OraAction || parsed.oraAction || parsed.action || text).trim();\n      }\n    } catch (error) {\n    }\n    for (let i = 0; i < 3; i += 1) {\n      text = text.replace(/\\\\\"/g, '\"');\n    }\n    return text;\n  };\n\n  const parseDisplayActionPayload = () => {\n    const candidates = [\n      $context.$app?.$OraAction,\n      $context.$triggers?.REST?.$input?.OraAction,\n      $context.$triggers?.REST?.$input?.oraAction,\n      $context.$system?.$inputMessage\n    ];\n\n    let actionText = '';\n    for (const candidate of candidates) {\n      const normalized = normalizeActionText(candidate);\n      if (!normalized) continue;\n\n      const inlineJsonStart = normalized.indexOf('{');\n      const inlineJsonEnd = normalized.lastIndexOf('}');\n      if (inlineJsonStart !== -1 && inlineJsonEnd > inlineJsonStart) {\n        const inlinePayloadText = normalized.slice(inlineJsonStart, inlineJsonEnd + 1)\n          .replace(/\"\"(\\w+)\"\"/g, '\"$1\"')\n          .replace(/:\\s*\"\"([^\"]+)\"\"/g, ': \"$1\"');\n\n        try {\n          let parsed = JSON.parse(inlinePayloadText);\n          if (typeof parsed === 'string') parsed = JSON.parse(parsed);\n          if (parsed && typeof parsed === 'object' && (\n            parsed.displayAccounts ||\n            parsed.accountDisplayIntent ||\n            parsed.workflowArea ||\n            parsed.area ||\n            /displayAccountsPage|accountDisplayPage/i.test(normalized)\n          )) {\n            return parsed;\n          }\n        } catch (error) {\n        }\n      }\n\n      if (/displayAccountsPage|accountDisplayPage/i.test(normalized)) {\n        actionText = normalized;\n        break;\n      }\n    }\n\n    if (!actionText) return {};\n    const jsonStart = actionText.indexOf('{');\n    const jsonEnd = actionText.lastIndexOf('}');\n    if (jsonStart === -1 || jsonEnd <= jsonStart) return {};\n\n    const payloadText = actionText.slice(jsonStart, jsonEnd + 1)\n      .replace(/\"\"(\\w+)\"\"/g, '\"$1\"')\n      .replace(/:\\s*\"\"([^\"]+)\"\"/g, ': \"$1\"');\n\n    try {\n      let parsed = JSON.parse(payloadText);\n      if (typeof parsed === 'string') parsed = JSON.parse(parsed);\n      return parsed && typeof parsed === 'object' ? parsed : {};\n    } catch (error) {\n      return {};\n    }\n  };\n\n  const rawActionPayload = parseDisplayActionPayload();\n  const pageSizeDefault = positiveInteger($context.$variables?.accountDisplayPageSize, 10);\n  const currentInputMessage = cleanString($context.$system?.$inputMessage || '');\n  const actionText = normalizeActionText($context.$app?.$OraAction || $context.$triggers?.REST?.$input?.OraAction || '');\n  const hasFreshTypedQuestion = currentInputMessage !== '' && !/displayAccountsPage|accountDisplayPage/i.test(currentInputMessage);\n  const actionPayload = hasFreshTypedQuestion ? {} : rawActionPayload;\n  const userQuestion = cleanString(currentInputMessage || actionPayload.queryText || rawActionPayload.queryText || '');\n  const intentText = [userQuestion, hasFreshTypedQuestion ? '' : actionText].filter(Boolean).join(' ');\n\n  const findRenewalWindow = textValue => {\n    const text = cleanString(textValue).toLowerCase();\n    if (!text) return null;\n\n    const match = text.match(/\\b(?:next|within|in|over|during|for)?\\s*(\\d{1,3})\\s*(day|days|week|weeks|month|months|year|years)\\b/i);\n    if (!match) return null;\n\n    const amount = Number.parseInt(match[1], 10);\n    if (!Number.isFinite(amount) || amount <= 0) return null;\n\n    const unit = match[2].toLowerCase();\n    const multiplier = unit.startsWith('year') ? 365 : unit.startsWith('week') ? 7 : unit.startsWith('month') ? 30 : 1;\n    return {\n      renewalDays: Math.min(365, Math.max(1, amount * multiplier)),\n      matchedText: match[0].trim()\n    };\n  };\n\n  const currentRequestText = [userQuestion, hasFreshTypedQuestion ? '' : actionText].filter(Boolean).join(' ');\n  const explicitRenewalWindow = findRenewalWindow(currentInputMessage) ||\n    findRenewalWindow(actionPayload.queryText) ||\n    findRenewalWindow(hasFreshTypedQuestion ? '' : actionText);\n\n  const currentTextHasExplicitRecordLimit = /\\b(?:limit|show|display|list|view|first|top|give|provide)\\s+(?:me\\s+)?\\d{1,3}\\s+(?:records?|rows?|items?|results?|accounts?|customers?|programs?|products?|opportunit(?:y|ies)|renewals?)\\b/i.test(currentRequestText) ||\n    /\\b\\d{1,3}\\s+(?:records?|rows?|items?|results?|accounts?|customers?|programs?|products?|opportunit(?:y|ies)|renewals?)\\b/i.test(currentRequestText) ||\n    /\\blimit\\s+(?:set\\s+to\\s+)?\\d{1,3}\\b/i.test(currentRequestText);\n\n  const displayTerms = /\\b(show|display|list|view|see|provide|give|pull|bring|next|previous|more|which|what)\\b/i;\n  const accountTerms = /\\b(account|accounts|customer|customers|opportunit(?:y|ies)|renewal|renewals|critical|moderate|high risk|medium risk|low risk|stable|at[-\\s]?risk|sales ready|sales-ready|cross[-\\s]?sell|target account|target accounts)\\b/i;\n  const accountDisplayIntent = Boolean(\n    actionPayload.displayAccounts ||\n    actionPayload.workflowArea ||\n    (/displayAccountsPage|accountDisplayPage/i.test(actionText)) ||\n    (displayTerms.test(intentText) && accountTerms.test(intentText)) ||\n    (/\\b(accounts?|customers?)\\b/i.test(intentText) && /\\?\\s*$/.test(intentText))\n  );\n\n  const actionRequestedLimit = actionPayload.requestedLimit ?? actionPayload.limit;\n  const hasActionRequestedLimit = actionRequestedLimit !== undefined && actionRequestedLimit !== null && cleanString(actionRequestedLimit) !== '';\n  const hasExplicitLimit = currentTextHasExplicitRecordLimit || hasActionRequestedLimit || (Boolean(extracted.hasExplicitLimit) && !explicitRenewalWindow);\n  const defaultRequestedLimit = accountDisplayIntent && !hasExplicitLimit ? 100 : 10;\n  const requestedLimit = clampInteger(actionRequestedLimit ?? extracted.limit ?? extracted.pageLimit, defaultRequestedLimit, 1, 100);\n\n  let pageLimit = clampInteger(actionPayload.pageLimit ?? actionPayload.pageSize, pageSizeDefault, 1, 100);\n  if (!accountDisplayIntent && actionPayload.pageLimit == null && actionPayload.pageSize == null) {\n    pageLimit = clampInteger(extracted.pageLimit ?? extracted.limit, requestedLimit, 1, 100);\n  }\n  if (accountDisplayIntent) {\n    pageLimit = pageSizeDefault;\n  }\n\n  let pageOffset = clampInteger(actionPayload.pageOffset ?? extracted.pageOffset, 0, 0, 10000);\n  const actionPageNumber = positiveInteger(actionPayload.pageNumber, 0);\n  if (actionPayload.pageOffset == null && actionPageNumber > 0) {\n    pageOffset = Math.max(0, (actionPageNumber - 1) * pageLimit);\n  }\n\n  const renewalDays = clampInteger(explicitRenewalWindow?.renewalDays ?? actionPayload.renewalDays ?? extracted.renewalDays, 180, 1, 365);\n  const knownAreas = [\n    'activePrograms',\n    'crossSellAccounts',\n    'renewalAccounts',\n    'renewalsAdvisor',\n    'renewalsAdvisorAccounts',\n    'renewalsAdvisorBuyingGroups',\n    'renewalsAdvisorContentTypes',\n    'renewalsAdvisorPrograms',\n    'renewalsAdvisorCombined',\n    'combined',\n    'unsupported'\n  ];\n  const requestedArea = cleanString(actionPayload.workflowArea || actionPayload.area || '');\n  const workflowAreaOverride = knownAreas.includes(requestedArea) ? requestedArea : '';\n  const fetchOffset = accountDisplayIntent ? 0 : pageOffset;\n  const fetchLimit = accountDisplayIntent ? requestedLimit : requestedLimit;\n\n  result = {\n    limit: requestedLimit,\n    requestedLimit,\n    pageLimit,\n    pageOffset,\n    fetchLimit,\n    fetchOffset,\n    renewalDays,\n    pageNumber: Math.floor(pageOffset / Math.max(pageLimit, 1)) + 1,\n    hasExplicitLimit,\n    hasExplicitRenewalDays: Boolean(explicitRenewalWindow || actionPayload.renewalDays != null || extracted.hasExplicitRenewalDays),\n    matchedLimitText: hasExplicitLimit ? cleanString(extracted.matchedLimitText || '') : '',\n    matchedRenewalDaysText: explicitRenewalWindow?.matchedText || cleanString(extracted.matchedRenewalDaysText || ''),\n    accountDisplayIntent,\n    workflowAreaOverride,\n    hasActionPayload: Object.keys(actionPayload).length > 0,\n    actionPayload,\n    ignoredStaleActionPayload: hasFreshTypedQuestion && Object.keys(rawActionPayload).length > 0,\n    originalQuestion: userQuestion,\n    queryText: userQuestion\n  };\n} catch (error) {\n  result = {\n    limit: 10,\n    requestedLimit: 10,\n    pageLimit: 10,\n    pageOffset: 0,\n    fetchLimit: 10,\n    fetchOffset: 0,\n    renewalDays: 180,\n    pageNumber: 1,\n    hasExplicitLimit: false,\n    hasExplicitRenewalDays: false,\n    matchedLimitText: '',\n    matchedRenewalDaysText: '',\n    accountDisplayIntent: false,\n    workflowAreaOverride: '',\n    hasActionPayload: false,\n    actionPayload: {},\n    originalQuestion: String($context.$system?.$inputMessage || ''),\n    queryText: String($context.$system?.$inputMessage || ''),\n    error: String(error?.message || error)\n  };\n}\nreturn result;"
          },
          "diagram": {
            "x": 8978,
            "y": 7426
          },
          "outcomes": {
            "success": "11"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1782122202333",
          "code": "PREPARE_ACCOUNT_DISPLAY_PAGE",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Account Display Page",
            "returnType": "object",
            "sourceCode": "let result = {\n  responseType: 'text',\n  rows: [],\n  displayedCount: 0,\n  hasNext: false,\n  hasPrevious: false\n};\n\ntry {\n  const context = $context.$nodes?.PREPARE_QUERY_CONTEXT?.$output?.result || {};\n  const params = $context.$nodes?.NORMALIZE_QUERY_PARAMETERS?.$output?.result || context.queryParameters || {};\n  const sources = context.sources || {};\n  const selectedAreas = Array.isArray(context.selectedAreas) ? context.selectedAreas : [];\n  const route = context.workflowArea || $context.$nodes?.ROUTE_QUERY_AREA?.$output?.result || '';\n  const queryText = String(params.queryText || params.originalQuestion || $context.$system?.$inputMessage || '');\n  const appContextMode = context.appContextMode || $context.$variables?.appContextMode || 'marketingStrategyAdvisor';\n\n  const positiveInteger = (value, fallback) => {\n    const parsed = Number.parseInt(value, 10);\n    return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;\n  };\n  const pageSizeDefault = positiveInteger($context.$variables?.accountDisplayPageSize, 10);\n  const pageLimit = Math.min(100, positiveInteger(params.pageLimit, pageSizeDefault));\n  const requestedLimit = Math.min(100, positiveInteger(params.requestedLimit || params.limit, pageLimit));\n  const pageOffset = Math.max(0, Number.parseInt(params.pageOffset, 10) || 0);\n  const renewalDays = positiveInteger(params.renewalDays, 180);\n  const pageNumber = Math.floor(pageOffset / Math.max(pageLimit, 1)) + 1;\n  const isRiskFocused = /at[-\\s]?risk|critical|high risk|moderate|medium risk|risk|churn|retention/i.test(queryText);\n  const accountSourceKeys = ['crossSellAccounts', 'renewalAccounts', 'renewalsAdvisorAccounts', 'renewalsAdvisorRiskSummary'];\n\n  const chooseSourceKey = () => {\n    if (route === 'crossSellAccounts') return 'crossSellAccounts';\n    if (route === 'renewalAccounts') return 'renewalAccounts';\n    if (route === 'renewalsAdvisorAccounts' || route === 'renewalsAdvisor') {\n      if (isRiskFocused && Array.isArray(sources.renewalsAdvisorRiskSummary?.items) && sources.renewalsAdvisorRiskSummary.items.length > 0) {\n        return 'renewalsAdvisorRiskSummary';\n      }\n      return 'renewalsAdvisorAccounts';\n    }\n    for (const key of selectedAreas) {\n      if (accountSourceKeys.includes(key)) return key;\n    }\n    return '';\n  };\n\n  const sourceKey = chooseSourceKey();\n  const source = sources[sourceKey] || {};\n  const allSourceItems = Array.isArray(source.items) ? source.items : [];\n  const pageEndOffset = Math.min(pageOffset + pageLimit, requestedLimit);\n  const sourceItems = allSourceItems.slice(pageOffset, pageEndOffset);\n  const displayIntent = Boolean(params.accountDisplayIntent);\n  const isAccountArea = Boolean(sourceKey);\n\n  const cleanString = value => String(value ?? '').replace(/\\s+/g, ' ').trim();\n  const firstValue = (row, keys) => {\n    for (const key of keys) {\n      const value = row?.[key];\n      if (value !== undefined && value !== null && cleanString(value) !== '') return value;\n    }\n    return '';\n  };\n  const compactText = (value, maxLength) => {\n    const text = cleanString(value);\n    if (!text) return '';\n    const firstSentenceMatch = text.match(/^(.{20,}?[.!?])\\s/);\n    let shortened = firstSentenceMatch ? firstSentenceMatch[1] : text;\n    if (shortened.length <= maxLength) return shortened;\n    shortened = shortened.slice(0, maxLength - 1);\n    const lastSpace = shortened.lastIndexOf(' ');\n    if (lastSpace > 40) shortened = shortened.slice(0, lastSpace);\n    return shortened + '...';\n  };\n  const toNumber = value => {\n    if (typeof value === 'number' && Number.isFinite(value)) return value;\n    if (value == null) return 0;\n    const parsed = Number.parseFloat(String(value).replace(/[^0-9.-]/g, ''));\n    return Number.isFinite(parsed) ? parsed : 0;\n  };\n  const formatAmount = value => {\n    const numeric = toNumber(value);\n    if (!numeric) return '';\n    const abs = Math.abs(numeric);\n    if (abs >= 1000000000) return (numeric / 1000000000).toFixed(2) + 'B';\n    if (abs >= 1000000) return (numeric / 1000000).toFixed(2) + 'M';\n    if (abs >= 1000) return (numeric / 1000).toFixed(0) + 'K';\n    return String(Math.round(numeric));\n  };\n  const escapeJsonValue = value => cleanString(value).replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"');\n  const buildAction = row => {\n    const accountId = cleanString(firstValue(row, ['accountId', 'accountIdentifier', 'partyId', 'id', 'accountNumber']));\n    const targetProductId = cleanString(context.targetProductId || $context.$variables?.targetProductId || firstValue(row, ['targetProductId', 'productIdentifier', 'productId', 'childProductId']));\n    const targetProductName = cleanString(context.targetProductName || $context.$variables?.targetProductName || firstValue(row, ['targetProductName', 'productName', 'childProductName']));\n    if (appContextMode === 'renewalsAdvisor' && accountId) {\n      return 'ora.Invoke(\"launchAccount\",{\"targetProductId\":\"' + escapeJsonValue(targetProductId) + '\",\"targetProductName\":\"' + escapeJsonValue(targetProductName) + '\",\"accountId\":\"' + escapeJsonValue(accountId) + '\"})';\n    }\n    if (sourceKey === 'renewalAccounts' && accountId) {\n      return 'ora.Invoke(\"launchRenewalAccount\",{\"targetProductId\":\"' + escapeJsonValue(targetProductId) + '\",\"targetProductName\":\"' + escapeJsonValue(targetProductName) + '\",\"accountId\":\"' + escapeJsonValue(accountId) + '\"})';\n    }\n    if (sourceKey === 'crossSellAccounts' && targetProductId) {\n      return 'ora.Invoke(\"launchCrossSellProduct\",{\"targetProductId\":\"' + escapeJsonValue(targetProductId) + '\",\"targetProductName\":\"' + escapeJsonValue(targetProductName) + '\"})';\n    }\n    return '';\n  };\n  const buildSubtitle = row => {\n    const arr = firstValue(row, ['arr', 'ARR', 'annualRecurringRevenue', 'revenueExposure']);\n    const potentialRevenue = firstValue(row, ['potentialRevenueAmount', 'potentialRevenue', 'revenueOpportunity', 'revenueAmount']);\n    const renewalDate = firstValue(row, ['renewalDate', 'RenewalDate', 'contractEndDate', 'subscriptionEndDate']);\n    const accountsRepresented = firstValue(row, ['accountsRepresented', 'accountCount', 'numberOfAccounts']);\n    if (renewalDate && arr) return 'Renewal: ' + cleanString(renewalDate) + ' · ARR: ' + formatAmount(arr);\n    if (renewalDate) return 'Renewal: ' + cleanString(renewalDate);\n    if (arr) return 'ARR: ' + formatAmount(arr);\n    if (potentialRevenue) return 'Potential Revenue: ' + formatAmount(potentialRevenue);\n    if (accountsRepresented) return 'Accounts: ' + cleanString(accountsRepresented);\n    return '';\n  };\n  const buildSummary = row => {\n    const riskReason = firstValue(row, ['riskDetailedExplainer', 'riskReason', 'reason']);\n    const industry = firstValue(row, ['industry', 'Industry']);\n    const region = firstValue(row, ['region', 'Region']);\n    const usage = firstValue(row, ['usageLevel', 'usage', 'adoptionLevel']);\n    if (isRiskFocused && riskReason) return compactText(riskReason, 95);\n    const parts = [];\n    if (industry) parts.push('Industry: ' + cleanString(industry));\n    if (region) parts.push('Region: ' + cleanString(region));\n    if (usage) parts.push('Usage: ' + cleanString(usage));\n    return compactText(parts.join(' · '), 95);\n  };\n  const buildPriority = row => {\n    const risk = cleanString(firstValue(row, ['riskClassification', 'riskLevel', 'risk', 'badgeText'])).toLowerCase();\n    if (/critical|high|at[-\\s]?risk/.test(risk)) return 'alert';\n    if (/moderate|medium/.test(risk)) return 'warning';\n    return 'medium';\n  };\n\n  const normalizedRows = sourceItems.map(row => {\n    const title = cleanString(firstValue(row, ['accountName', 'customerName', 'partyName', 'name', 'account', 'productName', 'targetProductName']));\n    const riskClassification = cleanString(firstValue(row, ['riskClassification', 'riskLevel', 'risk']));\n    const badgeText = riskClassification || cleanString(firstValue(row, ['badgeText', 'fit', 'fitScore', 'status', 'stage'])) || (sourceKey === 'crossSellAccounts' ? 'Opportunity' : 'Account');\n    const summary = buildSummary(row);\n    const accountId = cleanString(firstValue(row, ['accountId', 'accountIdentifier', 'partyId', 'id', 'accountNumber']));\n    return {\n      title: title || accountId || 'Account',\n      subtitle: buildSubtitle(row),\n      summary,\n      badgeText,\n      priority: buildPriority(row),\n      action: buildAction(row),\n      accountId,\n      raw: row\n    };\n  }).filter(row => cleanString(row.title) !== '');\n\n  const availableTotal = Math.min(requestedLimit, Number(source.recordCount || allSourceItems.length || 0));\n  const displayedCount = normalizedRows.length;\n  const hasPrevious = pageOffset > 0;\n  const hasNext = pageOffset + displayedCount < availableTotal;\n  const nextPageOffset = pageOffset + pageLimit;\n  const previousPageOffset = Math.max(0, pageOffset - pageLimit);\n  const startIndex = displayedCount ? pageOffset + 1 : 0;\n  const endIndex = pageOffset + displayedCount;\n  const titleBySource = {\n    crossSellAccounts: 'Cross-Sell Accounts',\n    renewalAccounts: 'Renewal Accounts',\n    renewalsAdvisorAccounts: 'Renewal Accounts',\n    renewalsAdvisorRiskSummary: 'At-Risk Renewal Accounts'\n  };\n  const emptyTitleBySource = {\n    crossSellAccounts: 'No Cross-Sell Accounts Found',\n    renewalAccounts: 'No Renewal Accounts Found',\n    renewalsAdvisorAccounts: 'No Renewal Accounts Found',\n    renewalsAdvisorRiskSummary: 'No At-Risk Renewal Accounts Found'\n  };\n  const workflowArea = sourceKey === 'renewalsAdvisorRiskSummary' ? 'renewalsAdvisorAccounts' : sourceKey;\n  const buildPageCommand = offset => {\n    const payload = {\n      displayAccounts: true,\n      workflowArea,\n      pageOffset: String(offset),\n      pageLimit: String(pageLimit),\n      requestedLimit: String(requestedLimit),\n      limit: String(requestedLimit),\n      renewalDays: String(renewalDays),\n      queryText: cleanString(queryText) || 'display accounts'\n    };\n    return 'ora.Invoke(\"displayAccountsPage\",' + JSON.stringify(payload) + ')';\n  };\n\n  const titlePrefix = titleBySource[sourceKey] || 'Accounts';\n  const titleSuffix = availableTotal ? ' of ' + availableTotal : '';\n  const selectedProductName = context.targetProductName || context.parentProductName || 'the selected product';\n\n  result = {\n    responseType: displayIntent && isAccountArea ? 'accountDisplay' : 'text',\n    appContextMode,\n    workflowArea,\n    sourceKey,\n    title: displayedCount > 0 ? titlePrefix + ' ' + startIndex + '-' + endIndex + titleSuffix : (emptyTitleBySource[sourceKey] || 'No Accounts Found'),\n    emptyTitle: emptyTitleBySource[sourceKey] || 'No Accounts Found',\n    description: displayedCount > 0 ? 'Page ' + pageNumber + ' for ' + selectedProductName + '. Showing ' + displayedCount + ' accounts.' : 'No matching accounts were returned for this page.',\n    subtitle: 'Page ' + pageNumber + ' · ' + displayedCount + ' accounts',\n    rows: normalizedRows,\n    displayedCount,\n    pageLimit,\n    requestedLimit,\n    pageOffset,\n    pageNumber,\n    startIndex,\n    endIndex,\n    availableTotal,\n    nextPageOffset,\n    previousPageOffset,\n    hasPrevious,\n    hasNext,\n    previousFollowUpCommand: hasPrevious ? buildPageCommand(previousPageOffset) : '',\n    nextFollowUpCommand: hasNext ? buildPageCommand(nextPageOffset) : '',\n    targetProductId: context.targetProductId || '',\n    targetProductName: context.targetProductName || '',\n    parentProductId: context.parentProductId || '',\n    parentProductName: context.parentProductName || '',\n    renewalDays,\n    queryText,\n    selectedAreas,\n    sourceRecordCount: availableTotal\n  };\n} catch (error) {\n  result = {\n    responseType: 'text',\n    rows: [],\n    displayedCount: 0,\n    hasNext: false,\n    hasPrevious: false,\n    error: String(error?.message || error)\n  };\n}\nreturn result;"
          },
