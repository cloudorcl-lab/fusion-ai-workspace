{
  "workflowId": "300000332873621",
  "workflowCode": "ORA_MARKETING_COMMAND_CENTER_ASK_ORACLE_WORKFLOW",
  "name": "Marketing Command Center Ask Oracle Workflow",
  "description": "Shared Ask Oracle query workflow for Marketing Strategy Advisor and Renewals Advisor. It routes questions by app context and user intent, answers Marketing Strategy Advisor questions across active programs, cross-sell accounts, and renewal summaries, and answers Renewals Advisor questions across renewal accounts, buying groups, content and messaging strategy, and programs using the matching BO data paths.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
