        {
          "id": "19",
          "code": "PREPARE_QUERY_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare Query Context",
            "sourceCode": "let result = {};\ntry {\n  const route = $context.$nodes?.ROUTE_QUERY_AREA?.$output?.result || 'combined';\n  const appContextMode = $context.$variables?.appContextMode || 'marketingStrategyAdvisor';\n  const normalizerOutput = $context.$nodes?.NORMALIZE_QUERY_PARAMETERS?.$output || {};\n  const rawQueryParameters = normalizerOutput?.result && typeof normalizerOutput.result === 'object' ? normalizerOutput.result : normalizerOutput;\n  const clampInteger = (value, fallback, min, max) => {\n    const numericValue = Number(value);\n    if (!Number.isFinite(numericValue)) return fallback;\n    return Math.min(max, Math.max(min, Math.trunc(numericValue)));\n  };\n\n  const limit = clampInteger(rawQueryParameters.limit ?? rawQueryParameters.requestedLimit, 10, 1, 100);\n  const requestedLimit = clampInteger(rawQueryParameters.requestedLimit ?? limit, limit, 1, 100);\n  const pageLimit = clampInteger(rawQueryParameters.pageLimit, 10, 1, 100);\n  const pageOffset = clampInteger(rawQueryParameters.pageOffset, 0, 0, 10000);\n  const fetchLimit = clampInteger(rawQueryParameters.fetchLimit ?? requestedLimit, requestedLimit, 1, 100);\n  const fetchOffset = clampInteger(rawQueryParameters.fetchOffset, 0, 0, 10000);\n  const renewalDays = clampInteger(rawQueryParameters.renewalDays, 180, 1, 365);\n  const queryParameters = {\n    limit,\n    requestedLimit,\n    pageLimit,\n    pageOffset,\n    fetchLimit,\n    fetchOffset,\n    renewalDays,\n    hasExplicitLimit: Boolean(rawQueryParameters.hasExplicitLimit),\n    hasExplicitRenewalDays: Boolean(rawQueryParameters.hasExplicitRenewalDays),\n    matchedLimitText: rawQueryParameters.matchedLimitText || '',\n    matchedRenewalDaysText: rawQueryParameters.matchedRenewalDaysText || '',\n    accountDisplayIntent: Boolean(rawQueryParameters.accountDisplayIntent),\n    hasActionPayload: Boolean(rawQueryParameters.hasActionPayload),\n    ignoredStaleActionPayload: Boolean(rawQueryParameters.ignoredStaleActionPayload),\n    originalQuestion: rawQueryParameters.originalQuestion || '',\n    queryText: rawQueryParameters.queryText || rawQueryParameters.originalQuestion || ''\n  };\n\n  const getOutput = code => $context.$nodes?.[code]?.$output || {};\n  const getItems = (...codes) => {\n    for (const code of codes) {\n      const output = getOutput(code);\n      if (Array.isArray(output?.items)) return output.items;\n      if (Array.isArray(output?.result)) return output.result;\n      if (Array.isArray(output?.result?.items)) return output.result.items;\n      if (Array.isArray(output)) return output;\n    }\n    return [];\n  };\n  const limitItems = items => Array.isArray(items) ? items.slice(0, limit) : [];\n  const accountItems = items => Array.isArray(items) ? items.slice(0, fetchLimit) : [];\n  const accountRecordCount = items => {\n    const count = Array.isArray(items) ? items.length : 0;\n    if (!queryParameters.accountDisplayIntent) return count;\n    return Math.min(requestedLimit, count);\n  };\n  const buildAccountSource = (items, extra = {}) => {\n    const cappedItems = accountItems(items);\n    return {\n      ...extra,\n      recordCount: accountRecordCount(cappedItems),\n      returnedCount: cappedItems.length,\n      limitApplied: limit,\n      requestedLimitApplied: requestedLimit,\n      pageLimitApplied: pageLimit,\n      pageOffsetApplied: pageOffset,\n      fetchLimitApplied: fetchLimit,\n      fetchOffsetApplied: fetchOffset,\n      items: cappedItems\n    };\n  };\n\n  const activeItems = getItems('GET_ACTIVE_PROGRAMS_FOR_QUERY', 'GET_ACTIVE_PROGRAMS_COMBINED');\n  const crossSellItems = getItems('GET_CROSS_SELL_PRODUCTS_FOR_QUERY', 'GET_CROSS_SELL_PRODUCTS_COMBINED');\n  const renewalItems = getItems('GET_RENEWAL_ACCOUNTS_FOR_QUERY', 'GET_RENEWAL_ACCOUNTS_COMBINED');\n  const renewalsAdvisorAccountItems = getItems('GET_RENEWALS_ADVISOR_ACCOUNTS_FOR_QUERY');\n  const renewalsAdvisorRiskItems = getItems('GET_RENEWALS_ADVISOR_ACCOUNTS_BY_RISK_FOR_QUERY');\n  const renewalsAdvisorBuyingGroupItems = getItems('GET_RENEWALS_ADVISOR_BUYING_GROUPS_FOR_QUERY');\n  const renewalsAdvisorContentTypeItems = getItems('GET_RENEWALS_ADVISOR_CONTENT_TYPES_FOR_QUERY');\n  const renewalsAdvisorRawProgramItems = getItems('GET_RENEWALS_ADVISOR_PROGRAMS_FOR_QUERY');\n  const renewalsAdvisorProgramItems = getItems('PREPARE_RENEWALS_ADVISOR_PROGRAMS_FOR_QUERY');\n  const sortedContentTypes = [...renewalsAdvisorContentTypeItems].sort((a, b) => String(a?.name || '').localeCompare(String(b?.name || '')));\n\n  const selectedAreasByRoute = {\n    combined: ['activePrograms', 'crossSellAccounts', 'renewalAccounts'],\n    renewalsAdvisor: ['renewalsAdvisorAccounts', 'renewalsAdvisorRiskSummary'],\n    renewalsAdvisorAccounts: ['renewalsAdvisorAccounts', 'renewalsAdvisorRiskSummary'],\n    renewalsAdvisorBuyingGroups: ['renewalsAdvisorBuyingGroups'],\n    renewalsAdvisorContentTypes: ['renewalsAdvisorContentTypes'],\n    renewalsAdvisorPrograms: ['renewalsAdvisorPrograms'],\n    renewalsAdvisorCombined: ['renewalsAdvisorAccounts', 'renewalsAdvisorRiskSummary', 'renewalsAdvisorBuyingGroups', 'renewalsAdvisorContentTypes', 'renewalsAdvisorPrograms']\n  };\n  const selectedAreas = selectedAreasByRoute[route] || [route];\n\n  result = {\n    appContextMode,\n    workflowArea: route,\n    selectedAreas,\n    queryParameters,\n    parentProductId: $context.$variables?.parentProductId || '',\n    parentProductName: $context.$variables?.parentProductName || '',\n    targetProductId: $context.$variables?.targetProductId || '',\n    targetProductName: $context.$variables?.targetProductName || '',\n    normalizedParentProductId: $context.$nodes?.SET_PARENT_PRODUCT_ID?.$output?.result || '',\n    childProductIds: $context.$nodes?.SET_CHILD_IDS?.$output?.result || '',\n    renewalDateRange: $context.$nodes?.PREPARE_QUERY_DATES?.$output?.result || {},\n    sources: {\n      activePrograms: {\n        workflowCode: 'ACTIVE_PROGRAMS_WORKFLOW',\n        businessObjectCode: 'CX_MARKETING_DATAOBJECTS',\n        functionName: 'getActivePrograms',\n        recordCount: activeItems.length,\n        returnedCount: limitItems(activeItems).length,\n        limitApplied: limit,\n        items: limitItems(activeItems)\n      },\n      crossSellAccounts: buildAccountSource(crossSellItems, {\n        workflowCode: 'CROSS_SELL_ACCOUNTS_WORKFLOW',\n        businessObjectCode: 'CX_MARKETING_EXTRACTIONQUERIES',\n        functionName: 'getCrossSellForChildProducts'\n      }),\n      renewalAccounts: buildAccountSource(renewalItems, {\n        workflowCode: 'RENEWAL_ACCOUNTS_WORKFLOW',\n        businessObjectCode: 'CX_MARKETING_EXTRACTIONQUERIES',\n        functionName: 'getRenewalByProduct',\n        renewalDaysApplied: renewalDays\n      }),\n      renewalsAdvisorAccounts: buildAccountSource(renewalsAdvisorAccountItems, {\n        workflowCode: 'RENEWALS_ADVISOR',\n        businessObjectCode: 'CX_MARKETING_DATAOBJECTS',\n        functionName: 'getAccountProductIntelligences',\n        dateRangeApplied: $context.$nodes?.PREPARE_QUERY_DATES?.$output?.result || {}\n      }),\n      renewalsAdvisorRiskSummary: buildAccountSource(renewalsAdvisorRiskItems, {\n        workflowCode: 'RENEWALS_ADVISOR',\n        businessObjectCode: 'CX_MARKETING_EXTRACTIONQUERIES',\n        functionName: 'getRenewalAccountsByRisk',\n        renewalDaysApplied: renewalDays\n      }),\n      renewalsAdvisorBuyingGroups: {\n        workflowCode: 'BUYING_GROUP_WORKFLOW',\n        businessObjectCode: 'CX_MARKETING_EXTRACTIONQUERIES',\n        functionName: 'buyingGroupByOwnedProductSummaries',\n        recordCount: renewalsAdvisorBuyingGroupItems.length,\n        returnedCount: limitItems(renewalsAdvisorBuyingGroupItems).length,\n        limitApplied: limit,\n        items: limitItems(renewalsAdvisorBuyingGroupItems)\n      },\n      renewalsAdvisorContentTypes: {\n        workflowCode: 'PROGRAM_ADVISOR_CONTENT_WORKFLOW',\n        businessObjectCode: 'ORA_CX_MARKETING_PROGRAMKNOWLEDGEMANAGEMENTTOOL',\n        functionName: 'getContentTypes',\n        recordCount: sortedContentTypes.length,\n        returnedCount: limitItems(sortedContentTypes).length,\n        limitApplied: limit,\n        items: limitItems(sortedContentTypes)\n      },\n      renewalsAdvisorPrograms: {\n        workflowCode: 'PROGRAMS_AGENT_WORKFLOW',\n        businessObjectCode: 'CX_MARKETING_DATAOBJECTS',\n        functionName: 'getProgramsListForSingleProduct',\n        recordCount: renewalsAdvisorRawProgramItems.length,\n        returnedCount: limitItems(renewalsAdvisorProgramItems).length,\n        limitApplied: limit,\n        rawItems: limitItems(renewalsAdvisorRawProgramItems),\n        items: limitItems(renewalsAdvisorProgramItems)\n      }\n    }\n  };\n} catch (error) {\n  result = { appContextMode: 'unknown', workflowArea: 'combined', selectedAreas: [], queryParameters: { limit: 10, requestedLimit: 10, pageLimit: 10, pageOffset: 0, fetchLimit: 10, fetchOffset: 0, renewalDays: 180 }, sources: {}, error: String(error?.message || error) };\n}\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1782122202333"
          },
          "inputs": [],
          "diagram": {
            "x": 8978,
            "y": 9034
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1780983852382",
          "code": "SET_PARENT_PRODUCT_ID",
          "type": "CODE",
          "metadata": {
            "name": "Set Parent Product ID",
            "sourceCode": "let result = '';\ntry {\n  const parentProductIdRaw = $context.$variables?.parentProductId || $context.$nodes?.RETRIEVE_PARENT_PRODUCT_NAME_AND_ID?.$output?.result?.parentProductId || '';\n  if (typeof parentProductIdRaw === 'string') {\n    const parentProductIdUpper = parentProductIdRaw.toUpperCase();\n    if (parentProductIdUpper.startsWith('FUSION_')) {\n      result = parentProductIdRaw.substring('FUSION_'.length);\n    } else {\n      result = parentProductIdRaw;\n    }\n  }\n} catch (error) {\n  result = '';\n}\nreturn result;",
            "returnType": "object"
          },
          "diagram": {
            "x": 8528,
            "y": 6094
          },
          "outcomes": {
            "success": "9"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
