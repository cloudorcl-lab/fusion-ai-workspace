        {
          "metadata": {
            "name": "Get Recent Skill Growth",
            "workflowCode": "ORA_HCM_IRC_SKILLS_RECOMMENDER"
          },
          "outcomes": {
            "success": "1767621980520"
          },
          "code": "GET_RECENT_SKILL_GROWTH",
          "id": "1767519401564",
          "inputs": [
            {
              "id": "1767519411242_1",
              "name": "message",
              "type": "string",
              "value": "Retrieve recent skill growth for the employee."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Check for Recent Skill Growth",
            "returnType": "boolean",
            "sourceCode": "const agentOut = $context.$nodes.GET_RECENT_SKILL_GROWTH.$output.output;\nlet allSkills = [];\ntry {\n    const parsedOut = JSON.parse(agentOut);\n    const gigs = parsedOut.result.gigs ?? [];\n    const courses = parsedOut.result?.courses ?? [];\n    const items = [...gigs, ...courses];\n\n    items.forEach(item => {\n        let itemObj = item;\n        if (typeof item === 'string') {\n            try {\n                itemObj = JSON.parse(item);\n            } catch (e) {\n                // skip if parsing fails\n                return;\n            }\n        }\n        if (Array.isArray(itemObj.skills)) {\n            allSkills = allSkills.concat(itemObj.skills);\n        }\n    });\n} catch (error) {\n    allSkills = [];\n}\n\nreturn allSkills && allSkills.length > 0;"
          },
          "outcomes": {
            "success": "1767625666761"
          },
          "code": "CHECK_FOR_RECENT_SKILL_GROWTH",
          "id": "1767621980520",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check If Skills Acquired Recently"
          },
          "outcomes": {
            "true": "1767626039167",
            "false": "1767629352144"
          },
          "code": "CHECK_IF_SKILLS_ACQUIRED_RECENTLY",
          "convergenceTargetId": "end",
          "id": "1767625666761",
          "inputs": [
            {
              "id": "1767625666764_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.CHECK_FOR_RECENT_SKILL_GROWTH.$output.result}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Recommend Skills"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RECOMMEND_SKILLS",
          "id": "1767626039167",
          "inputs": [
            {
              "id": "1767626039169_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given two data objects:\n\nCurrent employee profile: {{$context.$nodes.GET_EMPLOYEE_PROFILE_SUMMARY.$output.output}} \nRecent activity data (skills acquired through gigs or completed learning courses): {{$context.$nodes.GET_RECENT_SKILL_GROWTH.$output.output}} \nTask:\nCompare the two lists and identify any skills that appear in the recent activity data but are not present in the current employee profile. Output only the current role, skills last update date, current skills list and only the missing (new) skills along with the source and type if it is gig or a course as a concise list in JSON"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Skills for Favorite Career Roles",
