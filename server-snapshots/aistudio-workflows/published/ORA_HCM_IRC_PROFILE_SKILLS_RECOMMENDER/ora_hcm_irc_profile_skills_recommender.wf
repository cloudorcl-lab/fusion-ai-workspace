            "name": "Recommend Skills for Current Role"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RECOMMEND_SKILLS_FOR_CURRENT_ROLE",
          "id": "1767629482931",
          "inputs": [
            {
              "id": "1767629482932_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given two data objects:\n\nCurrent employee profile: {{$context.$nodes.GET_EMPLOYEE_PROFILE_SUMMARY.$output.output}} \nSkills required for aspirational roles: {{$context.$nodes.GET_SKILLS_FOR_FAVORITE_CAREER_ROLES.$output.output}} \nRecent activity data: {{$context.$nodes.GET_RECENT_SKILL_GROWTH.$output.output}} \nTask:\nGiven the current role of the user from employee profile and any required skills for aspirational career roles, output some skills that the user would like to add to their profile if they've already acquired the skills. Output only the current role, skills last update date from recent activity, current skills list and new skill recommendations with associated role so that the user could add to the profile if they've acquired the skills. Do not include any skills which are already on the user's profile in the missing skill recommendations and include the skills even if those are not marked as mandatory for the roles. Output the result as JSON."
            }
          ],
          "type": "LLM"
        }
      ],
