                {
                  "metadata": {
                    "name": "Add Demands to Item Map",
                    "returnType": "object",
                    "sourceCode": "const demandHeader = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.DemandSourceHeaderNumber;\nconst demandLine = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.DemandSourceLineNumber ?? \"\";\nconst operationSequence = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.OperationSequenceNumber ?? \"\";\nconst demandType = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.DemandSourceTypeId ?? \"\";\nconst requestedQuantity = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.RequestedQuantity ?? \"\";\nconst reservationId = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.ReservationId ?? \"\";\n\nconst demand = {\n  demandHeader,\n  demandLine,\n  demandType,\n  operationSequence,\n  requestedQuantity,\n  reservationId\n};\n\nconst itemMap = $context.$variables.ItemMap;\nconst item = $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.ItemNumber;\nif (Object.hasOwn(itemMap, item)) {\n  itemMap[item].demands = itemMap[item].demands ?? [];\n  itemMap[item].demands.push(demand);\n}\n\nreturn itemMap;\n"
                  },
                  "outcomes": {
                    "success": "1773793206859"
                  },
                  "code": "ADD_DEMANDS_TO_ITEM_MAP",
                  "id": "1773792954079",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
