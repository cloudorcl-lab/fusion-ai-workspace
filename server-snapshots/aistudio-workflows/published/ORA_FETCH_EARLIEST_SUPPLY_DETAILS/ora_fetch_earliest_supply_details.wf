                      "type": "string",
                      "value": "{{$context.$nodes.BULK_ITEM_PROCESSOR.SUPPLY_LINE_PARAM_BUILDER.$output.result}}"
                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Consolidate Data",
                    "returnType": "object",
                    "sourceCode": "const lines = $context.$nodes.BULK_ITEM_PROCESSOR.FETCH_SUPPLY_LINES_DETAILS.$output;\nconst supplyLines = lines.items.map(line => {\n  return {\n    \"SupplySourceHeaderNumber\": line.SupplySourceHeaderNumber,\n    \"SupplySourceLineNumber\": line.SupplySourceLineNumber ?? null,\n    \"TotalAtr\": line.TotalAtr,\n    \"ItemNumber\": line.ItemNumber,\n    \"InventoryItemId\": line.InventoryItemId,\n    \"SupplySourceTypeId\": line.SupplySourceTypeId,\n    \"ExpectedDeliveryDate\": line.ExpectedDeliveryDate,\n  };\n});\nconst item = {\n  ItemNumber: $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.ItemNumber,\n  UOM: $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.UOM ?? \"\"\n};\nconst availability = $context.$nodes.BULK_ITEM_PROCESSOR.FETCH_SUPPLY_LINES.$output;\nconst onhand = availability.items.find(avail => avail.Meaning == \"On hand\")?.AvailableToReserve ?? 0;\n\nconst response = {\n  supplyLines,\n  onhand,\n  item\n}\n\nlet itemMap = $context.$variables.ItemMap;\n\nif (typeof itemMap === \"string\") {\n  try { itemMap = JSON.parse(itemMap); } catch (e) { itemMap = {}; }\n}\n\nif (!itemMap || typeof itemMap !== \"object\" || Array.isArray(itemMap)) {\n  itemMap = {};\n}\n\nconst key = String(item.ItemNumber);\nitemMap[key] = response;\n\nreturn itemMap;"
                  },
                  "outcomes": {
                    "success": "1773793565046"
                  },
                  "code": "CONSOLIDATE_DATA",
                  "convergenceTargetId": "1773793602564",
                  "id": "1773184528064",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
