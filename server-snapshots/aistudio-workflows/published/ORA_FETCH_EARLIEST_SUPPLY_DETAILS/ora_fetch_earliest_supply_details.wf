                {
                  "metadata": {
                    "name": "Supply Line Param Builder",
                    "returnType": "object",
                    "sourceCode": "const orgId = $context.$triggers.REST.$input.OrganizationId;\nconst orgFilter = \"OrganizationId=\" + orgId;\nconst itemFilter = \"InventoryItemId=\" + $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.ItemId;\nconst today = $context.$system.$currentDate;\nconst expFilter = \"ExpectedDeliveryDate > \" + \"'\" + today + \"'\";\nconst orderBy = \"&orderBy=ExpectedDeliveryDate:asc\"\nconst supplyFilter = \"SupplySourceTypeId!=1\";\nconst qtyFilter = \"TotalAtr >= \" + $context.$nodes.BULK_ITEM_PROCESSOR.$currentItem.RequestedQuantity;\nconst filters = [orgFilter, expFilter, supplyFilter, qtyFilter, itemFilter];\nconst query = \"q=\" + filters.join(\" and \") + orderBy;\nreturn query;"
                  },
                  "outcomes": {
                    "success": "1773093369161"
                  },
                  "code": "SUPPLY_LINE_PARAM_BUILDER",
                  "convergenceTargetId": "1773793602564",
                  "id": "1773100128776",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "businessObjectCode": "ORA_SCM_INVENTORYM_GETSUPPLYDOCUMENTLINESBYTYPES",
