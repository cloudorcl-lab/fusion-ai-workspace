{
  "workflowId": "300000331068165",
  "workflowCode": "ORA_TRANSACTION_ANALYTICS_WORKFLOW",
  "name": "Transaction Analytics Workflow",
  "description": "This agent takes the user query and pass it to Transaction Management Analytics to get the Analytical insights.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
