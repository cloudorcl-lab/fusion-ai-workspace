        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_GLOBALHUMA_TRANSACTIONMANA",
            "functionName": "get_tac_analytics_insights",
            "name": "Transaction Management Analytics"
          },
          "outcomes": {
            "success": "1763111409955"
          },
          "code": "TRANSACTION_MANAGEMENT_ANALYTICS",
          "id": "1763111010114",
          "inputs": [
            {
              "id": "1763111044940_1",
              "name": "userQuery",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"AggregateDataInsightResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"AI_ROUTING_INPUT\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"AI_RESPONSE\": { \"type\": \"string\" }\n            },\n            \"required\": [\"AI_RESPONSE\"]\n          }\n        },\n        \"AI_GRAPH_RECOMMENDATION\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"chart_type\": { \"type\": \"string\" },\n              \"x-axis\": { \"type\": \"string\" },\n              \"y-axis\": { \"type\": \"string\" }\n            },\n            \"required\": [\"chart_type\", \"x-axis\", \"y-axis\"]\n          }\n        },\n        \"AI_RESPONSE\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"COUNT_OF_TXN\": { \"type\": \"string\" },\n              \"STATUS_CATEGORY\": { \"type\": \"string\" }\n            },\n            \"required\": [\"COUNT_OF_TXN\", \"STATUS_CATEGORY\"]\n          }\n        },\n        \"AI_TEXT_SUMMARY\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"AI_RESPONSE\": { \"type\": \"string\" }\n            },\n            \"required\": [\"AI_RESPONSE\"]\n          }\n        }\n      },\n      \"required\": [\n        \"AI_ROUTING_INPUT\",\n        \"AI_GRAPH_RECOMMENDATION\",\n        \"AI_RESPONSE\",\n        \"AI_TEXT_SUMMARY\"\n      ]\n    }\n  },\n  \"required\": [\"result\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Transaction Analytics Output"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "TRANSACTION_ANALYTICS_OUTPUT",
          "id": "1763111409955",
          "inputs": [
            {
              "id": "1763111409956_1",
              "name": "prompt",
              "type": "string",
              "value": "Take this response as input {{$context.$nodes.TRANSACTION_MANAGEMENT_ANALYTICS.$output.result.AI_TEXT_SUMMARY}}\n\nFollow the following instructions to format the output-\nSummarize the analytical response recieved from the agent in a paragraph.\nList the key features from the summary in bullet points.\nDo not provide any recommendation to perform action.\nDo not add the details about graph recommendation.\n*Important*: If the user input had a mention of any dates, then append the following line in the output as footnote:\nThe dates are interpreted in DD/MM/YY format\neg: 09/03/25 will be interpreted as 9th March 2025"
            }
          ],
          "type": "LLM"
        }
      ],
      "rootNode": "start",
      "variables": [],
      "errorHandlers": [
        {
          "type": "EMAIL",
