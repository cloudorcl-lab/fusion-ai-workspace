        {
          "metadata": {
            "name": "Get Ambiguous Entity List",
            "returnType": "object",
            "sourceCode": "const empty = { ambiguousEntities: [], unresolvedEntities: [] };\nconst resultOf = (code) => $context.$nodes[code]?.$output?.result || empty;\nconst arr = (value) => (Array.isArray(value) ? value : []);\n\nconst ppr = resultOf(\"FIN_AP_CODE_VERIFY_NER_RESULT_PPR\");\nconst template = resultOf(\"FIN_AP_CODE_VERIFY_NER_RESULT_PPR_TEMPLATE\");\nconst paymentOptions = resultOf(\"FIN_AP_CODE_VERIFY_NER_RESULT_PAYMENT_OPTION\");\n\nconst identifiedEntities = [\n  ...arr(ppr.identifiedPPRs),\n  ...arr(template.identifiedPPRTemplates),\n  ...arr(paymentOptions.identifiedBusinessUnits),\n  ...arr(paymentOptions.identifiedSuppliers),\n  ...arr(paymentOptions.identifiedPaymentTerms),\n  ...arr(paymentOptions.identifiedLegalEntities),\n];\n\nconst ambiguousEntities = [\n  ...arr(ppr.ambiguousEntities),\n  ...arr(template.ambiguousEntities),\n  ...arr(paymentOptions.ambiguousEntities),\n];\n\nconst unresolvedEntities = [\n  ...arr(ppr.unresolvedEntities),\n  ...arr(template.unresolvedEntities),\n  ...arr(paymentOptions.unresolvedEntities),\n];\n\nconst keywords = (value) => {\n  if (!value) return [];\n  return (Array.isArray(value) ? value : [value])\n    .map((item) => String(item).trim().toLowerCase())\n    .filter(Boolean);\n};\n\nconst resolvedKeywords = new Set(\n  identifiedEntities.flatMap((entity) => keywords(entity.keyword)),\n);\n\nconst isAlreadyResolved = (entity) =>\n  keywords(entity.keyword).some((keyword) => resolvedKeywords.has(keyword));\n\nconst filteredAmbiguousEntities = ambiguousEntities.filter(\n  (entity) => !isAlreadyResolved(entity),\n);\n\nconst filteredUnresolvedEntities = unresolvedEntities.filter(\n  (entity) => !isAlreadyResolved(entity),\n);\n\nreturn {\n  ambiguousEntities: filteredAmbiguousEntities,\n  unresolvedEntities: filteredUnresolvedEntities,\n};"
          },
          "outcomes": {
            "success": "1774964675200"
          },
