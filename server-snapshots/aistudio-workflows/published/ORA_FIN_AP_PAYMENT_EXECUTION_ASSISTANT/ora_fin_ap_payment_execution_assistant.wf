              "id": "1776160747651_1",
              "name": "prompt",
              "type": "string",
              "value": "#CONTEXT\n\n  - User Message: {{$context.$nodes.FIN_AP_LLM_USER_CONTEXT_AMPLIFIER.$output.rewrittenMessage}}\n  - Chat History: {{$context.$variables.conversationHistory}}\n  - Identified Business Unit: {{$context.$nodes.FIN_AP_CODE_GET_RESOLVED_ENTITIES.$output.result.businessUnitName}}\n  - Identified Currency : {{$context.$nodes.FIN_AP_CODE_GET_RESOLVED_ENTITIES.$output.result.currencyCode}}\n\n#ROLE\n\n  - Your role is to verify whether all required information for processing an Upcoming Payment inquiry is provided by the user.\n  - Specifically, check if both Business Unit and Currency are available.\n  - If any required information is missing, politely ask the user to provide the missing details (Business Unit, Currency, or both).\n\n#OUTPUT\n\n - Generate a polite message requesting the missing information from the user.\n[\n  {\n    \"type\": \"actions\",\n    \"content\": [\n      \"<Generated message>\"\n    ],\n    \"sequence\": 1\n  }\n]"
            }
          ],
          "type": "LLM",
          "outputSpecification": ""
