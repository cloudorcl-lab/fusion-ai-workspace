        {
          "metadata": {
            "name": "Verify NER Result PPR",
            "returnType": "object",
            "sourceCode": "const nerResult = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_NAMED_ENTITY_RECOGNITION_SERVICE_FOR_PPR.$output || {};\nconst result = {\n  hasNERError: false,\n  identifiedPPRs: Array.isArray($context.$variables.identifiedPPRs) ? [...$context.$variables.identifiedPPRs] : [],\n  ambiguousEntities: [],\n  unresolvedEntities: []\n};\n\nconst addResolved = (entity, keyword) => {\n  if (entity.entity === \"Payment Process Request\") {\n    result.identifiedPPRs.push({ ...entity, keyword });\n  }\n};\n\nif (nerResult.status === \"NO_MATCHES\" || nerResult.status === \"not_found\" || !Array.isArray(nerResult.matches)) {\n  result.hasNERError = true;\n  result.unresolvedEntities.push({ entity: \"Payment Process Request\", keyword: nerResult.extractedKeywords || [] });\n  return result;\n}\n\nfor (const match of nerResult.matches) {\n  if (match.matchStatus === \"unique\") {\n    for (const entity of match.entities || []) addResolved(entity, match.keyword);\n  } else if (match.matchStatus === \"ambiguous\") {\n    for (const entity of match.entities || []) {\n      if (entity.score === 100) addResolved(entity, match.keyword);\n      else {\n        result.hasNERError = true;\n        result.ambiguousEntities.push({ ...entity, keyword: match.keyword });\n      }\n    }\n  } else if (match.matchStatus === \"NO_MATCHES\" || match.matchStatus === \"not_found\") {\n    result.hasNERError = true;\n    result.unresolvedEntities.push({ entity: \"Payment Process Request\", keyword: match.keyword });\n  }\n}\n\nreturn result;"
          },
