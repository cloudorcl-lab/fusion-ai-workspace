            "sourceCode": "let agentResponse = $context.$nodes.FIN_AP_LLM_CONTENT_SUMMARIZER_FOR_NER_RESOLUTION_AGENT.$output;\nagentResponse = JSON.stringify(agentResponse);\nagentResponse = \"Agent: \"+ agentResponse;\n\nlet conversationHistory = Array.isArray($context.$variables.conversationHistory) ? [...$context.$variables.conversationHistory] : [];\nconversationHistory.push(agentResponse);  \nreturn conversationHistory;"
          },
