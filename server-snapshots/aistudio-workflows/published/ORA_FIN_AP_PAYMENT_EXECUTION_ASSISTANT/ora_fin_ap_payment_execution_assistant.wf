            "name": "Verify NER Result Payment Option",
            "returnType": "object",
            "sourceCode": "const nerResult = $context.$nodes.FIN_AP_BUSINESS_OBJECT_FUNCTION_NAMED_ENTITY_RECOGNITION_SERVICE_FOR_PAYMENT_OPTIONS.$output || {};\nconst copy = (name) => Array.isArray($context.$variables[name]) ? [...$context.$variables[name]] : [];\n\nconst result = {\n  hasNERError: false,\n  identifiedBusinessUnits: copy(\"identifiedBusinessUnits\"),\n  identifiedSuppliers: copy(\"identifiedSuppliers\"),\n  identifiedPaymentTerms: copy(\"identifiedPaymentTerms\"),\n  identifiedLegalEntities: copy(\"identifiedLegalEntities\"),\n  ambiguousEntities: [],\n  unresolvedEntities: []\n};\n\nconst targetByEntity = {\n  \"Business unit\": \"identifiedBusinessUnits\",\n  Supplier: \"identifiedSuppliers\",\n  \"Payment Term\": \"identifiedPaymentTerms\",\n  \"Legal Entity\": \"identifiedLegalEntities\"\n};\n\nconst addResolved = (entity, keyword) => {\n  const target = targetByEntity[entity.entity];\n  if (target) result[target].push({ ...entity, keyword });\n};\n\nif (nerResult.status === \"NO_MATCHES\" || nerResult.status === \"not_found\" || !Array.isArray(nerResult.matches)) {\n  result.hasNERError = true;\n  result.unresolvedEntities.push({ entity: \"Payment Option\", keyword: nerResult.extractedKeywords || [] });\n  return result;\n}\n\nfor (const match of nerResult.matches) {\n  if (match.matchStatus === \"unique\") {\n    for (const entity of match.entities || []) addResolved(entity, match.keyword);\n  } else if (match.matchStatus === \"ambiguous\") {\n    for (const entity of match.entities || []) {\n      if (entity.score === 100) addResolved(entity, match.keyword);\n      else {\n        result.hasNERError = true;\n        result.ambiguousEntities.push({ ...entity, keyword: match.keyword });\n      }\n    }\n  } else if (match.matchStatus === \"NO_MATCHES\" || match.matchStatus === \"not_found\") {\n    result.hasNERError = true;\n    result.unresolvedEntities.push({ entity: \"Payment Option\", keyword: match.keyword });\n  }\n}\n\nreturn result;"
          },
