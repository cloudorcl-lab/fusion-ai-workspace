        {
          "metadata": {
            "name": "Navigation Deep Link Assigner",
            "returnType": "array",
            "sourceCode": "const navigationOutput = $context.$nodes.FIN_AP_LLM_NAVIGATION_DETECTOR.$output || {};\n\nconst isNavigation = navigationOutput.navigation === true;\nconst navigateIntent = navigationOutput.navigateIntent;\n\nlet envName  = $context.$variables.envName  ||  '';\n\nfunction fallbackObject() {\n  return [\n    {\n      type: \"text\",\n      sequence: 1,\n      content: \"Sorry, I cannot help with that requirement.Please go to: {relativeLink:{url:faces/FndOverview?fndTaskItemNodeId=PaymentLandingMainArea&pageParams=fndGlobalItemNodeId=itemNode_payables_payables_payments&fromApPaymentsOverview=true,text:Payables Payments,family:FSCM}}\"\n    }\n  ];\n}\n\nlet object = [];\n\nif (navigateIntent == \"Schedule Reports\" || navigateIntent == \"Payments Task\") {\n  if (navigateIntent == \"Payments Task\") {\n    object = [\n      {\n        type: \"list\",\n        heading: \"Please provide the specific report name so I can take you directly to the appropriate page\",\n        content: [\n          \"Submit Payment Process Request\",\n          \"Manage Payment Process Request\",\n          \"Manage Payment Process Request Templates\",\n          \"Create Payment\",\n          \"Manage Payment\",\n          \"Create Electronic Payment Files\",\n          \"Create Printed Payment Files\",\n          \"Manage Payment Files\",\n          \"Apply Missing Conversion Rates\",\n          \"Create Positive Pay File\",\n          \"Send Separate Remittance Advice\",\n          \"Payment File Accompanying Letter\",\n          \"Retrieve Disbursement Acknowledgments\"\n        ],\n        sequence: 1\n      }\n    ];\n    return object;\n  }\n\n  if (navigateIntent == \"Schedule Reports\") {\n    object = [\n      {\n        type: \"list\",\n        heading: \"Please provide the specific report name so I can take you directly to the appropriate page\",\n        content: [\n          \"Payables Cash Requirement Report\",\n          \"Disbursement Payment Process Request Report\",\n          \"Disbursement Payment File Register Format Report\",\n          \"Payables Payment Register Report\"\n        ],\n        sequence: 1\n      }\n    ];\n    return object;\n  }\n}\n\nconst reportDeepLinkMap = {\n  \"Schedule Payables Cash Requirement Report\": {\n    reportName: \"Payables Cash Requirement Report\",\n    jobDefinitionName: \"APXCRRCR\",\n    jobDefinitionPackageName: \"/oracle/apps/ess/financials/payables/payments\"\n  },\n  \"Schedule Payables Payment Register\": {\n    reportName: \"Payables Payment Register\",\n    jobDefinitionName: \"APXMTDCR\",\n    jobDefinitionPackageName: \"/oracle/apps/ess/financials/payables/payments\"\n  },\n  \"Schedule Disbursement Payment Process Request\": {\n    reportName: \"Disbursement Payment Process Request Report\",\n    jobDefinitionName: \"IBY_FD_PPR_STATUS_RPT\",\n    jobDefinitionPackageName: \"/oracle/apps/ess/financials/payments/shared/runFormat\"\n  },\n  \"Schedule Disbursement Payment File Register Format\": {\n    reportName: \"Disbursement Payment File Register Format\",\n    jobDefinitionName: \"IBY_FD_FINAL_PMT_REGISTER\",\n    jobDefinitionPackageName: \"/oracle/apps/ess/financials/payments/shared/runFormat\"\n  }\n};\n\nfunction buildReportLink(reportConfig) {\n  const url =\n    \"faces/adf.task-flow?_id=SRSProxyCallWrapper-taskflow\" +\n    \"&_document=/WEB-INF/oracle/apps/fnd/applcp/srs/ui/flow/SRSProxyCallWrapper-taskflow.xml\" +\n    \"&jobdefinitionname=\" +\n    reportConfig.jobDefinitionName +\n    \"&jobdefinitionpackagename=\" +\n    reportConfig.jobDefinitionPackageName +\n    \"&proxyTaskflowURL=\" +\n    envName +\n    \"/fscmUI\";\n\n  return \"{relativeLink:{url:\" + url + \",text:\" + reportConfig.reportName + \",family:FSCM}}\";\n}\n\nif (!isNavigation || !navigateIntent) {\n  return fallbackObject();\n}\n\nconst selectedReportDeepLink = reportDeepLinkMap[navigateIntent];\n\nif (selectedReportDeepLink) {\n  if (!envName) {\n    return fallbackObject();\n  }\n\n  object = [\n    {\n      type: \"text\",\n      sequence: 1,\n      content:\n        \"You selected \" +\n        selectedReportDeepLink.reportName +\n        \". This report can be scheduled from the report submission page. Use the link to navigate directly to the report and complete the scheduling process. Please go to: \" +\n        buildReportLink(selectedReportDeepLink)\n    }\n  ];\n  return object;\n}\n\nconst deepLinkMap = {\n  \"Submit Payment Process Request Task\": {\n    message:\n      \"I found the Submit Payment Process Request task. Use the link to navigate directly to the Submit Payment Process Request page, where you can submit a payment run using payment selection criteria or a payment process request template.\",\n    link:\n      \"{relativeLink:{text:Submit Payment Process Request,url:faces/deeplink?objType=AP_SUBMITPPR&action=CREATE,family:FSCM}}\"\n  },\n  \"Manage Payment Process Requests Task\": {\n    message:\n      \"I found the Manage Payment Process Requests task. Use the link to navigate directly to the Manage Payment Process Requests page, where you can search, review, monitor, and take action on payment process requests.\",\n    link:\n      \"{relativeLink:{text:Manage Payment Process Request,url:faces/deeplink?objType=AP_MANAGEPPR&action=MANAGE,family:FSCM}}\"\n  },\n  \"Manage Payment Process Request Templates Task\": {\n    message:\n      \"I found the Manage Payment Process Request Templates task. Use the link to navigate directly to the Manage Payment Process Request Templates page, where you can create and maintain templates used to submit payment process requests.\",\n    link:\n      \"{relativeLink:{text:Manage Payment Process Request Templates,url:faces/deeplink?objType=AP_MANAGEPPRTEMPLATE&action=MANAGE,family:FSCM}}\"\n  },\n  \"Create Payment Task\": {\n    message:\n      \"I found the Create Payment task. Use the link to navigate directly to the Create Payment page, where you can review payment details, enter the required information, and create a payment.\",\n    link:\n      \"{relativeLink:{text:Create Payment,url:faces/deeplink?objType=AP_PAYINVOICE&action=CREATE,family:FSCM}}\"\n  },\n  \"Manage Payments Task\": {\n    message:\n      \"I found the Manage Payments task. Use the link to navigate directly to the Manage Payments page, where you can search for payments, review payment details and status, and take available payment actions.\",\n    link:\n      \"{relativeLink:{text:Manage Payment,url:faces/deeplink?objType=AP_MANAGEPAYMENT&action=MANAGE,family:FSCM}}\"\n  },\n  \"Create Electronic Payment Files Task\": {\n    message:\n      \"I found the Create Electronic Payment Files task. Use the link to navigate directly to the Create Electronic Payment Files page, where you can generate electronic payment files for eligible payments.\",\n    link:\n      \"{relativeLink:{text:Create Electronic Payment Files,url:faces/deeplink?objType=IBY_CREATEPFELE&action=EDIT,family:FSCM}}\"\n  },\n  \"Create Printed Payment Files Task\": {\n    message:\n      \"I found the Create Printed Payment Files task. Use the link to navigate directly to the Create Printed Payment Files page, where you can groups payments into payment files, validate, format and print the payment files.\",\n    link:\n      \"{relativeLink:{text:Create Printed Payment Files,url:faces/deeplink?objType=IBY_CREATEPFPRINTED&action=EDIT,family:FSCM}}\"\n  },\n  \"Manage Payment Files Task\": {\n    message:\n      \"I found the Manage Payment Files task. Use the link to navigate directly to the Manage Payment Files page, where you can search, review, monitor, and take action on payment files.\",\n    link:\n      \"{relativeLink:{text:Manage Payment Files,url:faces/deeplink?objType=IBY_MANAGEPAYMENTFILE&action=MANAGE,family:FSCM}}\"\n  },\n  \"Apply Missing Conversion Rates Task\": {\n    message:\n      \"I found the Apply Missing Conversion Rates task. Use the link to navigate directly to the Apply Missing Conversion Rates page, where you can apply missing conversion rates to foreign currency invoices and payments.\",\n    link:\n      \"{relativeLink:{text:Apply Missing Conversion Rates,url:faces/deeplink?objType=AP_APPLYMISSINGCONVRATE&action=EDIT,family:FSCM}}\"\n  },\n  \"Create Positive Pay File Task\": {\n    message:\n      \"I found the Create Positive Pay File task. Use the link to navigate directly to the Create Positive Pay File page, where you can create a positive pay file for payment validation with your bank.\",\n    link:\n      \"{relativeLink:{text:Create Positive Pay File,url:faces/deeplink?objType=IBY_CREATEPOSPAY&action=EDIT,family:FSCM}}\"\n  },\n  \"Send Separate Remittance Advice Task\": {\n    message:\n      \"I found the Send Separate Remittance Advice task. Use the link to navigate directly to the Send Separate Remittance Advice page, where you can create remittance advices that notify payees that payments have been made to them.\",\n    link:\n      \"{relativeLink:{text:Send Separate Remittance Advice,url:faces/deeplink?objType=IBY_SENDSRA&action=EDIT,family:FSCM}}\"\n  },\n  \"Payment File Accompanying Letter Task\": {\n    message:\n      \"I found the Payment File Accompanying Letter task. Use the link to navigate directly to the Payment File Accompanying Letter page, where you can create the accompanying letter for a payment file.\",\n    link:\n      \"{relativeLink:{text:Payment File Accompanying Letter,url:faces/deeplink?objType=IBY_PFACMPLETTER&action=EDIT,family:FSCM}}\"\n  },\n  \"Retrieve Disbursement Acknowledgments Task\": {\n    message:\n      \"I found the Retrieve Disbursement Acknowledgments task. Use the link to navigate directly to the Retrieve Disbursement Acknowledgments page, where you can retrieve funds disbursement acknowledgments from payment system or bank.\",\n    link:\n      \"{relativeLink:{text:Retrieve Disbursement Acknowledgments Task,url:faces/deeplink?objType=IBY_RETRIEVEFDACK&action=EDIT,family:FSCM}}\"\n  },\n  \"Scheduled Processes\": {\n    message:\n      \"You selected Scheduled Processes. Use the link to navigate to scheduled processing page\",\n    link:\n      \"Please go to: {relativeLink:{url:faces/FuseOverview?fndGlobalItemNodeId=itemNode_tools_scheduled_processes_fuse_plus,text:Scheduled Processes,family:FSCM}}\"\n  }\n};\n\nif (!deepLinkMap[navigateIntent]) {\n  return fallbackObject();\n}\n\nconst selectedDeepLink = deepLinkMap[navigateIntent];\n\nobject = [\n  {\n    type: \"text\",\n    sequence: 1,\n    content: selectedDeepLink.message + \" Please go to: \" + selectedDeepLink.link\n  }\n];\n\nreturn object;\n"
          },
