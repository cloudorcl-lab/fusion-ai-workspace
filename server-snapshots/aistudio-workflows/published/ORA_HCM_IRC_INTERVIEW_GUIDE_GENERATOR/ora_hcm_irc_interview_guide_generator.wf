            "sourceCode": "var restInput = {};\nif ($context && $context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    restInput = $context.$triggers.REST.$input;\n}\n\nvar interviewData = [];\nif (restInput.InterviewData && Array.isArray(restInput.InterviewData.result)) {\n    interviewData = restInput.InterviewData.result;\n}\n\nvar ids = [];\nvar seen = {};\n\nfor (var i = 0; i < interviewData.length; i++) {\n    var record = interviewData[i] || {};\n    var recordIds = record.interviewerPersonIds;\n\n    if (typeof recordIds === \"string\") {\n        recordIds = recordIds.split(\",\");\n    }\n    if (!Array.isArray(recordIds)) {\n        recordIds = [];\n    }\n\n    for (var j = 0; j < recordIds.length; j++) {\n        var id = recordIds[j];\n        if (id !== null && id !== undefined && String(id) !== \"\") {\n            var idKey = String(id);\n            if (!seen[idKey]) {\n                seen[idKey] = true;\n                ids.push(id);\n            }\n        }\n    }\n}\n\nreturn ids;"
          },
