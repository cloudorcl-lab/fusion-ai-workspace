        {
          "metadata": {
            "name": "Response",
            "returnType": "object",
            "sourceCode": "var restInput = {};\nif ($context && $context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    restInput = $context.$triggers.REST.$input;\n}\n\nvar interviewDetails = [];\nif (restInput.InterviewData && Array.isArray(restInput.InterviewData.result)) {\n    interviewDetails = restInput.InterviewData.result;\n}\n\nvar reqDetailArray = [];\nif ($context.$nodes.REQDETAILS && $context.$nodes.REQDETAILS.$output && Array.isArray($context.$nodes.REQDETAILS.$output.items)) {\n    reqDetailArray = $context.$nodes.REQDETAILS.$output.items;\n}\n\nvar jobApplicationsArray = [];\nif ($context.$nodes.JOBAPPLICATIONDETAILS && $context.$nodes.JOBAPPLICATIONDETAILS.$output && Array.isArray($context.$nodes.JOBAPPLICATIONDETAILS.$output.items)) {\n    jobApplicationsArray = $context.$nodes.JOBAPPLICATIONDETAILS.$output.items;\n}\n\nvar personIdOrder = [];\nvar seenPersonIds = {};\nfor (var pd = 0; pd < interviewDetails.length; pd++) {\n    var personIds = interviewDetails[pd] ? interviewDetails[pd].interviewerPersonIds : [];\n    if (typeof personIds === \"string\") {\n        personIds = personIds.split(\",\");\n    }\n    if (!Array.isArray(personIds)) {\n        personIds = [];\n    }\n    for (var pi = 0; pi < personIds.length; pi++) {\n        if (personIds[pi] !== null && personIds[pi] !== undefined && String(personIds[pi]) !== \"\") {\n            var orderKey = String(personIds[pi]);\n            if (!seenPersonIds[orderKey]) {\n                seenPersonIds[orderKey] = true;\n                personIdOrder.push(personIds[pi]);\n            }\n        }\n    }\n}\n\nvar emailOutput = [];\nif ($context.$nodes.GET_ALL_INTERVIEWER_EMAIL && $context.$nodes.GET_ALL_INTERVIEWER_EMAIL.$output) {\n    emailOutput = $context.$nodes.GET_ALL_INTERVIEWER_EMAIL.$output;\n}\nif (typeof emailOutput === \"string\") {\n    try {\n        emailOutput = JSON.parse(emailOutput);\n    } catch (ignoreEmailOutputParse) {\n        emailOutput = [];\n    }\n}\nif (!Array.isArray(emailOutput)) {\n    emailOutput = [emailOutput];\n}\n\nvar emailByPersonId = {};\n\nfor (var e = 0; e < emailOutput.length; e++) {\n    var row = emailOutput[e];\n    if (typeof row === \"string\") {\n        try {\n            row = JSON.parse(row);\n        } catch (ignoreRowParse) {\n            row = {};\n        }\n    }\n\n    if (row && row.result !== undefined) {\n        row = row.result;\n        if (typeof row === \"string\") {\n            try {\n                row = JSON.parse(row);\n            } catch (ignoreResultParse) {\n                row = {};\n            }\n        }\n    }\n\n    var candidateRows = [];\n    if (Array.isArray(row)) {\n        candidateRows = row;\n    } else if (row && Array.isArray(row.items)) {\n        candidateRows = row.items;\n    } else if (row) {\n        candidateRows = [row];\n    }\n\n    for (var cr = 0; cr < candidateRows.length; cr++) {\n        var worker = candidateRows[cr];\n        if (typeof worker === \"string\") {\n            try {\n                worker = JSON.parse(worker);\n            } catch (ignoreWorkerParse) {\n                worker = {};\n            }\n        }\n        if (worker && worker.result !== undefined) {\n            worker = worker.result;\n            if (typeof worker === \"string\") {\n                try {\n                    worker = JSON.parse(worker);\n                } catch (ignoreWorkerResultParse) {\n                    worker = {};\n                }\n            }\n        }\n\n        var foundPersonId = \"\";\n        var foundEmail = \"\";\n\n        if (worker) {\n            if (worker.PersonId !== undefined && worker.PersonId !== null) {\n                foundPersonId = String(worker.PersonId);\n            } else if (worker.personId !== undefined && worker.personId !== null) {\n                foundPersonId = String(worker.personId);\n            } else if (worker.PERSON_ID !== undefined && worker.PERSON_ID !== null) {\n                foundPersonId = String(worker.PERSON_ID);\n            }\n\n            if (worker.EmailAddress && String(worker.EmailAddress).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.EmailAddress);\n            } else if (worker.emailAddress && String(worker.emailAddress).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.emailAddress);\n            } else if (worker.Email && String(worker.Email).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.Email);\n            } else if (worker.email && String(worker.email).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.email);\n            } else if (worker.WorkEmail && String(worker.WorkEmail).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.WorkEmail);\n            } else if (worker.workEmail && String(worker.workEmail).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.workEmail);\n            } else if (worker.WorkEmailAddress && String(worker.WorkEmailAddress).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.WorkEmailAddress);\n            } else if (worker.PrimaryEmailAddress && String(worker.PrimaryEmailAddress).indexOf(\"@\") !== -1) {\n                foundEmail = String(worker.PrimaryEmailAddress);\n            }\n\n            for (var fieldName in worker) {\n                var fieldValue = worker[fieldName];\n                var lowerFieldName = String(fieldName).toLowerCase();\n\n                if (foundPersonId === \"\" && (lowerFieldName === \"personid\" || lowerFieldName === \"person_id\")) {\n                    if (fieldValue !== null && fieldValue !== undefined) {\n                        foundPersonId = String(fieldValue);\n                    }\n                }\n\n                if (foundEmail === \"\" && lowerFieldName.indexOf(\"email\") !== -1 && typeof fieldValue === \"string\" && fieldValue.indexOf(\"@\") !== -1) {\n                    foundEmail = fieldValue;\n                }\n\n                if (foundEmail === \"\" && fieldValue && typeof fieldValue === \"object\") {\n                    var nestedRows = [];\n                    if (Array.isArray(fieldValue)) {\n                        nestedRows = fieldValue;\n                    } else {\n                        nestedRows = [fieldValue];\n                    }\n\n                    for (var nr = 0; nr < nestedRows.length; nr++) {\n                        var nested = nestedRows[nr];\n                        if (nested && typeof nested === \"object\") {\n                            for (var nestedFieldName in nested) {\n                                var nestedFieldValue = nested[nestedFieldName];\n                                var lowerNestedFieldName = String(nestedFieldName).toLowerCase();\n                                if (foundEmail === \"\" && lowerNestedFieldName.indexOf(\"email\") !== -1 && typeof nestedFieldValue === \"string\" && nestedFieldValue.indexOf(\"@\") !== -1) {\n                                    foundEmail = nestedFieldValue;\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        if (foundPersonId === \"\" && e < personIdOrder.length) {\n            foundPersonId = String(personIdOrder[e]);\n        }\n\n        if (foundPersonId !== \"\" && foundEmail !== \"\") {\n            emailByPersonId[foundPersonId] = foundEmail;\n        }\n    }\n}\n\nvar GenInterviewData = [];\n\nfor (var i = 0; i < interviewDetails.length; i++) {\n    var interview = interviewDetails[i] || {};\n\n    var matchedReqDetail = null;\n    for (var r = 0; r < reqDetailArray.length; r++) {\n        var req = reqDetailArray[r] || {};\n        if (String(req.requisitionId || \"\") === String(interview.requisitionId || \"\")) {\n            matchedReqDetail = req;\n            break;\n        }\n    }\n\n    var matchedJobApplication = null;\n    for (var a = 0; a < jobApplicationsArray.length; a++) {\n        var app = jobApplicationsArray[a] || {};\n        if (String(app.submissionId || \"\") === String(interview.submissionId || \"\")) {\n            matchedJobApplication = app;\n            break;\n        }\n    }\n\n    var interviewPersonIds = interview.interviewerPersonIds;\n    if (typeof interviewPersonIds === \"string\") {\n        interviewPersonIds = interviewPersonIds.split(\",\");\n    }\n    if (!Array.isArray(interviewPersonIds)) {\n        interviewPersonIds = [];\n    }\n\n    var interviewerNames = interview.interviewerNames;\n    if (typeof interviewerNames === \"string\") {\n        interviewerNames = interviewerNames.split(\",\");\n    }\n    if (!Array.isArray(interviewerNames)) {\n        interviewerNames = [];\n    }\n\n    var emailList = [];\n    var recipientList = [];\n    var recipientEmailSeen = {};\n\n    for (var ip = 0; ip < interviewPersonIds.length; ip++) {\n        var pid = interviewPersonIds[ip];\n        var emailForPerson = emailByPersonId[String(pid)] || \"\";\n        if (emailForPerson !== \"\" && !recipientEmailSeen[emailForPerson]) {\n            recipientEmailSeen[emailForPerson] = true;\n            emailList.push(emailForPerson);\n            var recipientName = \"\";\n            if (interviewerNames[ip]) {\n                recipientName = String(interviewerNames[ip]);\n            } else {\n                recipientName = emailForPerson;\n            }\n            recipientList.push({\n                name: recipientName,\n                email: emailForPerson\n            });\n        }\n    }\n\n    var existingEmails = interview.interviewerEmails;\n    if (typeof existingEmails === \"string\") {\n        existingEmails = existingEmails.split(\",\");\n    }\n    if (!Array.isArray(existingEmails)) {\n        existingEmails = [];\n    }\n    for (var ee = 0; ee < existingEmails.length; ee++) {\n        var existingEmail = String(existingEmails[ee] || \"\");\n        if (existingEmail.indexOf(\"@\") !== -1 && !recipientEmailSeen[existingEmail]) {\n            recipientEmailSeen[existingEmail] = true;\n            emailList.push(existingEmail);\n            recipientList.push({\n                name: existingEmail,\n                email: existingEmail\n            });\n        }\n    }\n\n    var interviewData = {\n        interviewTitle: interview.interviewTitle,\n        candidateName: interview.candidateName,\n        interviewerNames: interview.interviewerNames,\n        interviewerPersonIds: interview.interviewerPersonIds,\n        interviewerEmails: emailList,\n        interviewerRecipients: recipientList,\n        date: interview.date,\n        time: interview.time,\n        submissionId: interview.submissionId\n    };\n\n    var reqData = null;\n    if (matchedReqDetail) {\n        var skills = [];\n        if (Array.isArray(matchedReqDetail.skills)) {\n            for (var s = 0; s < matchedReqDetail.skills.length; s++) {\n                var skill = matchedReqDetail.skills[s] || {};\n                var skillName = null;\n                if (skill.skillContentItems && Array.isArray(skill.skillContentItems) && skill.skillContentItems.length > 0) {\n                    skillName = skill.skillContentItems[0].name || null;\n                }\n                skills.push({\n                    skillName: skillName\n                });\n            }\n        }\n\n        var hiringManagerDisplayName = null;\n        if (matchedReqDetail.hiringManagerDetails && Array.isArray(matchedReqDetail.hiringManagerDetails) && matchedReqDetail.hiringManagerDetails.length > 0) {\n            hiringManagerDisplayName = matchedReqDetail.hiringManagerDetails[0].displayName || null;\n        }\n\n        var recruiterDisplayName = null;\n        if (matchedReqDetail.recruiterDetails && Array.isArray(matchedReqDetail.recruiterDetails) && matchedReqDetail.recruiterDetails.length > 0) {\n            recruiterDisplayName = matchedReqDetail.recruiterDetails[0].displayName || null;\n        }\n\n        reqData = {\n            requisitionId: matchedReqDetail.requisitionId,\n            title: matchedReqDetail.title,\n            skills: skills,\n            externalDesc: matchedReqDetail.externalDesc,\n            internalDesc: matchedReqDetail.internalDesc,\n            externalResponsibilities: matchedReqDetail.externalResponsibilities,\n            externalQualifications: matchedReqDetail.externalQualifications,\n            hiringManagerDisplayName: hiringManagerDisplayName,\n            recruiterDisplayName: recruiterDisplayName\n        };\n    }\n\n    var jobAppData = null;\n    if (matchedJobApplication) {\n        var experience = [];\n        if (Array.isArray(matchedJobApplication.jobApplicationExperience)) {\n            for (var ex = 0; ex < matchedJobApplication.jobApplicationExperience.length; ex++) {\n                var exp = matchedJobApplication.jobApplicationExperience[ex] || {};\n                experience.push({\n                    jobTitle: exp.jobTitle,\n                    employerName: exp.employerName,\n                    prevEmploymentId: exp.prevEmploymentId\n                });\n            }\n        }\n\n        var education = [];\n        if (Array.isArray(matchedJobApplication.jobApplicationEducation)) {\n            for (var ed = 0; ed < matchedJobApplication.jobApplicationEducation.length; ed++) {\n                var edu = matchedJobApplication.jobApplicationEducation[ed] || {};\n                var schoolName = edu.schoolFreeText;\n                if (edu.schoolContentItems && edu.schoolContentItems.schoolName) {\n                    schoolName = edu.schoolContentItems.schoolName;\n                }\n                education.push({\n                    schoolName: schoolName,\n                    schoolFreeText: edu.schoolFreeText,\n                    degreeFreeText: edu.degreeFreeText\n                });\n            }\n        }\n\n        var displayName = null;\n        if (matchedJobApplication.names) {\n            displayName = matchedJobApplication.names.displayName || null;\n        }\n\n        jobAppData = {\n            candidateName: displayName,\n            jobApplicationExperience: experience,\n            jobApplicationEducation: education,\n            jobApplicationSkills: matchedJobApplication.jobApplicationSkills || [],\n            applicantScore: matchedJobApplication.applicantScore || null,\n            resumeAttachments: matchedJobApplication._fndAttachments || [],\n            currentState: matchedJobApplication.currentState || null,\n            currentPhase: matchedJobApplication.currentPhase || null\n        };\n    }\n\n    GenInterviewData.push({\n        interviewDetails: interviewData,\n        reqDetail: reqData,\n        jobApplication: jobAppData\n    });\n}\n\nreturn GenInterviewData;"
          },
