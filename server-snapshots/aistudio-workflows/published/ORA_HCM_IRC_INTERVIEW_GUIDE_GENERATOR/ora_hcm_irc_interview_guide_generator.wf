            "sourceCode": "var input = {};\nif ($context && $context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) {\n    input = $context.$triggers.REST.$input;\n}\n\nvar interviews = [];\nif (input.InterviewData && Array.isArray(input.InterviewData.result)) {\n    interviews = input.InterviewData.result;\n}\n\nvar submissionIds = [];\nfor (var i = 0; i < interviews.length; i++) {\n    if (interviews[i] && interviews[i].submissionId !== null && interviews[i].submissionId !== undefined) {\n        submissionIds.push(interviews[i].submissionId);\n    }\n}\n\nvar result = submissionIds.join(\",\");\nreturn result;"
