        {
          "metadata": {
            "name": "Parse App Context",
            "returnType": "object",
            "sourceCode": "const raw = String($context.$app.$OraAppContext || '').trim();\n\nconst result = {\n  learnerId: '',\n  learnerName: ''\n};\n\nconst decodeValue = (value) => {\n  const normalized = String(value || '').replace(/\\+/g, ' ').trim();\n  try {\n    return decodeURIComponent(normalized);\n  } catch {\n    return normalized;\n  }\n};\n\nif (raw) {\n  for (const pair of raw.split('&')) {\n    const eqIndex = pair.indexOf('=');\n    const rawKey = eqIndex >= 0 ? pair.slice(0, eqIndex) : pair;\n    const rawValue = eqIndex >= 0 ? pair.slice(eqIndex + 1) : '';\n\n    const key = decodeValue(rawKey);\n    const value = decodeValue(rawValue);\n\n    if (key === 'learnerId') {\n      result.learnerId = value;\n    } else if (key === 'learnerName') {\n      result.learnerName = value;\n    }\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766720334446"
          },
          "code": "PARSE_APP_CONTEXT",
          "id": "1766719675557",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
