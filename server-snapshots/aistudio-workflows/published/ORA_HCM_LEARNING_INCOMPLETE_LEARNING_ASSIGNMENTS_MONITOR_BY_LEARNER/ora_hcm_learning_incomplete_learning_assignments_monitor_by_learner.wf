        {
          "metadata": {
            "name": "Prepare Incomplete Assignments Model",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GET_INCOMPLETE_ASSIGNMENTS.$output;\nconst nowIso = $context.$system.$currentDateTime || new Date().toISOString();\nconst now = new Date(nowIso);\n\nconst parseMaybe = (value) => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch {\n    return value;\n  }\n};\n\nconst unwrapArray = (value) => {\n  let current = parseMaybe(value);\n  for (let i = 0; i < 6; i += 1) {\n    if (Array.isArray(current)) return current;\n    if (!current || typeof current !== 'object') return [];\n    const next = [current.items, current.records, current.data, current.result, current.output]\n      .map(parseMaybe)\n      .find((candidate) => candidate != null);\n    if (next == null || next === current) return [];\n    current = next;\n  }\n  return Array.isArray(current) ? current : [];\n};\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst parseDate = (value) => {\n  const text = clean(value);\n  if (!text) return null;\n  const date = new Date(text);\n  return Number.isNaN(date.getTime()) ? null : date;\n};\n\nconst startOfDay = (date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());\nconst formatDate = (value) => {\n  const date = parseDate(value);\n  return date ? date.toISOString().slice(0, 10) : '—';\n};\n\nconst normalizeBadgeKey = (badgeText) => {\n  const normalizedText = clean(badgeText).toLowerCase();\n  if (normalizedText === 'overdue') {\n    return 'overdue';\n  }\n  if (normalizedText === 'due within 30 days' || normalizedText === 'due soon') {\n    return 'dueSoon';\n  }\n  return '';\n};\n\nconst asOfDate = startOfDay(now).toISOString().slice(0, 10);\nconst records = unwrapArray(raw);\nconst preparedRows = [];\nconst overdueTitles = [];\nconst dueSoonTitles = [];\nlet learnerName = clean($context.$variables.learnerName);\nlet toEmail = '';\nlet nextDueDate = null;\n\nfor (const record of records) {\n  const statusMeaning = clean(record.assignmentSubStatusMeaning || record.assignmentStatusMeaning || record.assignmentSubStatus || record.assignmentStatus || record.badgeText);\n  const completedDate = parseDate(record.completedDate);\n  const completed = Boolean(completedDate) || /\\bcomplete pending approval\\b|\\bcompleted\\b|\\bcomplete\\b/i.test(statusMeaning);\n  if (completed) continue;\n\n  if (!learnerName) {\n    learnerName = clean(record.assignedToDisplayName);\n  }\n  if (!toEmail) {\n    toEmail = clean(record.WorkEmail || record.assignedToPersonPrimaryEmailAddress);\n  }\n\n  const statusBadgeText = clean(record.badgeText);\n  const statusKey = normalizeBadgeKey(statusBadgeText);\n  if (!statusKey) continue;\n\n  const hasExplicitDueDate = Boolean(clean(record.assignmentDueDate)) || clean(record.dateText).toLowerCase() === 'due date';\n  if (!hasExplicitDueDate) continue;\n\n  const dueSource = record.assignmentDueDate\n    || (clean(record.dateText).toLowerCase() === 'due date' ? record.dateValue : '')\n    || '';\n  if (!clean(dueSource)) continue;\n\n  const dueDate = parseDate(dueSource);\n  if (!dueDate) continue;\n\n  const dueDay = startOfDay(dueDate);\n  const learningTitle = clean(record.learningItemTitle);\n  const assignerName = clean(record.assignerDisplayName) || 'Self Enrolled';\n  const statusBadgePriority = statusKey === 'overdue' ? 'alert' : 'warning';\n  const statusText = statusBadgeText;\n\n  if (statusKey === 'overdue' && learningTitle) overdueTitles.push(learningTitle);\n  if (statusKey === 'dueSoon' && learningTitle) {\n    dueSoonTitles.push(learningTitle);\n    if (!nextDueDate || dueDay < nextDueDate) {\n      nextDueDate = dueDay;\n    }\n  }\n\n  preparedRows.push({\n    learningTitle,\n    assignerName,\n    dueDate: formatDate(dueSource),\n    statusKey,\n    statusText,\n    statusBadgeText,\n    statusBadgePriority,\n    sortPrimary: statusKey === 'overdue' ? 0 : 1,\n    sortSecondary: dueDay.getTime(),\n    sortTitle: learningTitle.toLowerCase()\n  });\n}\n\npreparedRows.sort((left, right) => {\n  if (left.sortPrimary !== right.sortPrimary) return left.sortPrimary - right.sortPrimary;\n  if (left.sortSecondary !== right.sortSecondary) return left.sortSecondary - right.sortSecondary;\n  return left.sortTitle.localeCompare(right.sortTitle);\n});\n\nconst rows = preparedRows.map(({ learningTitle, assignerName, dueDate, statusText, statusBadgeText, statusBadgePriority }) => ({\n  learningTitle,\n  assignerName,\n  dueDate,\n  statusText,\n  statusBadgeText,\n  statusBadgePriority\n}));\n\nconst totalAssignments = rows.length;\nconst overdueCount = preparedRows.filter((row) => row.statusKey === 'overdue').length;\nconst dueSoonCount = preparedRows.filter((row) => row.statusKey === 'dueSoon').length;\nconst percentOverdue = Math.round((overdueCount / Math.max(totalAssignments, 1)) * 100);\nconst senderName = clean($context.$app?.$OraUserContext?.fullName);\nconst emailPlans = [];\n\nif (overdueCount > 0) {\n  emailPlans.push({\n    title: 'Send Overdue Notification',\n    shortDescription: 'Notifies the learner about overdue assignments.',\n    subject: `Overdue training: ${overdueCount} assignment(s) pending`,\n    introText: `Our records show ${overdueCount} training assignment(s) are overdue. Please complete them as soon as possible to remain compliant.`,\n    itemTitles: overdueTitles\n  });\n}\n\nif (dueSoonCount > 0) {\n  const nextDueClause = nextDueDate ? ` Next due: ${formatDate(nextDueDate.toISOString())}.` : '';\n  emailPlans.push({\n    title: 'Send Due Soon Notification',\n    shortDescription: 'Gently reminds the learner about assignments due within 30 days.',\n    subject: `Upcoming training due within 30 days: ${dueSoonCount} item(s)`,\n    introText: `You have ${dueSoonCount} training assignment(s) due within the next 30 days. Please plan time to complete them on schedule.${nextDueClause}`,\n    itemTitles: dueSoonTitles\n  });\n}\n\nconst result = {\n  asOfDate,\n  learnerId: clean($context.$variables.learnerId),\n  learnerName,\n  toEmail,\n  senderName,\n  totalAssignments,\n  overdueCount,\n  dueSoonCount,\n  otherCount: 0,\n  percentOverdue,\n  nextDueDate: nextDueDate ? formatDate(nextDueDate.toISOString()) : '',\n  displayTitle: totalAssignments > 0\n    ? `${totalAssignments} assignments: ${overdueCount} overdue, ${dueSoonCount} due soon`\n    : 'No overdue or due soon assignments',\n  displaySubtitle: `Prioritized by urgency • Updated ${asOfDate}`,\n  rows,\n  emailPlans\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766441452432"
          },
          "code": "PREPARE_INCOMPLETE_ASSIGNMENTS_MODEL",
