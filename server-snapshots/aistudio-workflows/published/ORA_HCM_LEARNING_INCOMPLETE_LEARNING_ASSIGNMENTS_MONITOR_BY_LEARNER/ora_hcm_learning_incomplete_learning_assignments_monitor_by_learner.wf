            "sourceCode": "let hint = $context.$app.$OraMessageHint; \n\nif (hint === \"InitDisplay\" || hint === \"InitCommunications\" || hint === \"Summary\" ) {\n  hint = \"Init\";\n} else if (hint === \"Query\" || hint == null) {\n  hint = \"Query\";\n} \n\nreturn hint;"
