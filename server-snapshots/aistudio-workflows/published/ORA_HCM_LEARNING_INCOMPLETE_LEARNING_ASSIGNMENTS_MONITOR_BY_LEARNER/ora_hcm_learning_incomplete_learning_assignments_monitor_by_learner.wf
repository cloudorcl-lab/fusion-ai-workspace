        {
          "metadata": {
            "name": "Build Query Assignments Payload",
            "returnType": "string",
            "sourceCode": "const learnerId = String($context.$variables.learnerId || '').trim();\n\nconst result = JSON.stringify({\n  securityFilters: {\n    type: 'MANAGER'\n  },\n  offset: 0,\n  limit: 100,\n  filters: [\n    {\n      name: 'reports',\n      value: 'DIRECT_REPORTS'\n    },\n    {\n      name: 'enrollments',\n      value: 'CURRENT'\n    },\n    {\n      name: 'assignedToId',\n      term: learnerId\n    }\n  ]\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767828816657"
          },
          "code": "BUILD_QUERY_ASSIGNMENTS_PAYLOAD",
          "id": "1773000000003",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
