                {
                  "metadata": {
                    "name": "Construct Payload to Check Existing Promise",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FIN_IEX_LOOP_ITERATE_PROMISED_INSTALLMENTS_TO_CHECK_EXISTING_PROMISES.$currentItem || {};\nvar paymentScheduleId = currentItem.PAYMENTSCHEDULEID || null;\n\nvar result = {\n  parameters: {\n    bindPaymentScheduleId: paymentScheduleId\n  },\n  viewQueries: {\n    collectionsPaymentPromise: {\n      view: \"collectionsPaymentPromise\",\n      businessObject: \"CustomerPromiseDetail\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"promiseDate\": \"promiseDate\",\n        \"promiseAmount\": \"promiseAmount\",\n        \"remainingAmount\": \"remainingAmount\",\n        \"statusLookup.lookupCode\": \"status\",\n        \"delinquency.delinquencyId\": \"delinquencyId\",\n        \"delinquency.paymentSchedule.paymentScheduleId\": \"paymentScheduleId\"\n      }\n    },\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\"\n      }\n    }\n  },\n  select: \"select to_char(collectionsPaymentPromise.promiseDate,'YYYY-MM-DD') promiseDate, \" +\n    \"collectionsPaymentPromise.promiseAmount promiseAmount, \" +\n    \"collectionsPaymentPromise.remainingAmount remainingAmount, \" +\n    \"collectionsPaymentPromise.status status, \" +\n    \"collectionsPaymentPromise.delinquencyId delinquencyId, \" +\n    \"collectionsPaymentPromise.paymentScheduleId paymentScheduleId, \" +\n    \"null customerTransactionId, \" +\n    \"null processingStatusCode, \" +\n    \"null intentCode, \" +\n    \"null requestData \" +\n    \"from collectionsPaymentPromise \" +\n    \"where collectionsPaymentPromise.paymentScheduleId = :bindPaymentScheduleId \" +\n    \"and collectionsPaymentPromise.status = 'COLLECTABLE' \" +\n    \"union all \" +\n    \"select null promiseDate, \" +\n    \"null promiseAmount, \" +\n    \"null remainingAmount, \" +\n    \"'UNACTIONED_EMAIL_PROMISE' status, \" +\n    \"null delinquencyId, \" +\n    \"collectionsCustomerMessageDetails.paymentScheduleId paymentScheduleId, \" +\n    \"collectionsCustomerMessageDetails.customerTransactionId customerTransactionId, \" +\n    \"collectionsCustomerMessageDetails.processingStatusCode processingStatusCode, \" +\n    \"collectionsCustomerMessageDetails.intentCode intentCode, \" +\n    \"collectionsCustomerMessageDetails.requestData requestData \" +\n    \"from collectionsCustomerMessageDetails \" +\n    \"where collectionsCustomerMessageDetails.paymentScheduleId = :bindPaymentScheduleId \" +\n    \"and collectionsCustomerMessageDetails.intentCode = 'ORA_PROMISE_TO_PAY' \" +\n    \"and collectionsCustomerMessageDetails.processingStatusCode in ('ORA_REVIEW_PENDING','ORA_ACTION_PENDING')\"\n};\n\nreturn result;"
