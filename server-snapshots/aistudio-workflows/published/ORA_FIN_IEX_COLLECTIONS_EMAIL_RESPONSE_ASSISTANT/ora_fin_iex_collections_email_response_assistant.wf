            {
              "id": "1771764959189_1",
              "name": "condition",
              "type": "string",
              "value": "{{(($context.$nodes.FIN_IEX_LLM_EXTRACT_DISPUTE_INFORMATION.$output.dispute.invoices || []).length === 0)}}"
