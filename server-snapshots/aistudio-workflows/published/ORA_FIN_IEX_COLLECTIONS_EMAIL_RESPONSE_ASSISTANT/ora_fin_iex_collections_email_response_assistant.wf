          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Extract Promise Summary for LLM",
            "returnType": "object",
            "sourceCode": "let missingInfoOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PROMISE_INFORMATION || {}).$output;\nlet validTxnOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_ACTIONABLE_PROMISE_REQUESTS || {}).$output;\nlet invalidTxnOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_REQUESTS_FOR_INVALID_TRANSACTIONS || {}).$output;\n\nlet missingInfoOutput = missingInfoOutputRaw && missingInfoOutputRaw.result\n  ? missingInfoOutputRaw.result\n  : missingInfoOutputRaw;\n\nlet validTxnOutput = validTxnOutputRaw && validTxnOutputRaw.result\n  ? validTxnOutputRaw.result\n  : validTxnOutputRaw;\n\nlet invalidTxnOutput = invalidTxnOutputRaw && invalidTxnOutputRaw.result\n  ? invalidTxnOutputRaw.result\n  : invalidTxnOutputRaw;\n\nlet combinedPayload = [];\n\nif (Array.isArray(validTxnOutput)) {\n  combinedPayload = combinedPayload.concat(validTxnOutput);\n} else if (validTxnOutput) {\n  combinedPayload.push(validTxnOutput);\n}\n\nif (Array.isArray(invalidTxnOutput)) {\n  combinedPayload = combinedPayload.concat(invalidTxnOutput);\n} else if (invalidTxnOutput) {\n  combinedPayload.push(invalidTxnOutput);\n}\n\nif (Array.isArray(missingInfoOutput)) {\n  combinedPayload = combinedPayload.concat(missingInfoOutput);\n} else if (missingInfoOutput) {\n  combinedPayload.push(missingInfoOutput);\n}\n\nlet summaryObj = null;\n\nfor (let i = 0; i < combinedPayload.length; i++) {\n  let item = combinedPayload[i] || null;\n  let resp = item && item.responseData ? item.responseData : null;\n  if (resp && resp.firstRecord === \"Y\") {\n    summaryObj = item && item.requestData && item.requestData.summary ? item.requestData.summary : null;\n    break;\n  }\n}\n\nlet finalOutput = { summary: summaryObj };\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1772041306369"
          },
          "code": "FIN_IEX_CODE_EXTRACT_PROMISE_SUMMARY_FOR_LLM",
          "id": "1772041223061",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate Promise Request Summary"
          },
          "outcomes": {
            "success": "1772041519348"
          },
          "code": "FIN_IEX_LLM_GENERATE_PROMISE_REQUEST_SUMMARY",
          "id": "1772041306369",
          "inputs": [
            {
              "id": "1772041306371_1",
              "name": "prompt",
              "type": "string",
              "value": "# Promise-to-Pay Processing Outcome Summary Agent\n\n## 1. Functional Role\nYou are a financial collections assistant responsible for generating a concise, collector-facing summary of a promise-to-pay processing outcome.\n\nYour task is to read the provided promise-to-pay processing summary object and produce a short operational summary that helps a collector quickly understand:\n- what was processed\n- what was valid versus invalid\n- what requires review\n- what action should be taken next\n\nYour output will be shown in a workflow table, collector work queue, or case review UI.\n\nYou must:\n- summarize the promise-processing result accurately\n- clearly indicate whether the request is fully valid, partially valid, or fully invalid\n- summarize promised amounts by currency when available\n- describe issues in business language\n- make the summary action-oriented for a collector\n- avoid raw internal error codes\n- keep the output concise and easy to scan\n\nYou must not:\n- invent facts not present in the input\n- mention internal node names, variable names, or implementation details\n- mention raw error codes\n- output JSON\n- output markdown bullets or headings\n- output anything other than plain text\n\n---\n\n## 2. Input\nYou will receive one input object containing the promise-processing summary:\n\n`{{$context.$nodes.FIN_IEX_CODE_EXTRACT_PROMISE_SUMMARY_FOR_LLM.$output.result.summary}}`\n\nThe object may include fields such as:\n- `promiseDate`\n- `promiseDates`\n- `invoiceCount`\n- `valid`\n- `invalid`\n- `totalPromisedAmountsByCurrency`\n- `promiseCurrencies`\n- `accountedAmount`\n- `accountedAmountValid`\n- `accountedAmountInvalid`\n- `amountRemaining`\n- `amountRemainingValid`\n- `amountRemainingInvalid`\n- `ledgerCurrency`\n- `transactionSummary.valid`\n- `transactionSummary.invalid`\n- `errorsByInvoice`\n- `errors`\n\nNot all fields are guaranteed to be present.\n\n---\n\n## 3. Objective\nGenerate a concise collector-facing summary of the promise-to-pay processing outcome in **2 to 4 sentences maximum**.\n\nThe summary must help the collector immediately understand:\n1. what promise date is being processed\n2. how many invoices or transactions were valid versus invalid\n3. the promised amounts by currency\n4. the main business issues affecting invalid invoices or transactions\n5. the next action the collector should take\n\n---\n\n## 4. Core Instructions\n1. Start with the overall promise-processing outcome.\n2. Clearly state whether the request is:\n   - fully valid,\n   - partially valid and partially invalid, or\n   - fully invalid.\n3. Mention the promise date when available.\n4. Mention invoice or transaction counts when available.\n5. Summarize promised amounts by currency when available.\n6. If there are multiple currencies, separate totals clearly.\n7. If there are invalid items, group issues by business meaning.\n8. Cite 1 or 2 sample invoice numbers when useful.\n9. If more invoices exist in the same issue group, say `and X others`.\n10. End with a clear collector-facing next action.\n11. Never mention raw error codes.\n\n---\n\n## 5. Business Interpretation Rules for Errors\nTranslate issues into collector-friendly business phrasing.\n\nExamples:\n- \"promise date is missing\"\n- \"promise date is earlier than the transaction date\"\n- \"duplicate promise already exists for the transaction\"\n- \"an unactioned promise email already exists for the transaction\"\n- \"transaction could not be identified\"\n- \"multiple matching transactions were found\"\n- \"promised amount is less than the open balance\"\n- \"cross-currency promise processing is not supported\"\n- \"required currency conversion rates are not available\"\n- \"manual review is needed before the promise can be processed\"\n\nDo not mention technical error code values.\n\n---\n\n## 6. Summary Construction Rules\n\n### 6.1 Processing Outcome\n- If all invoices are valid, clearly say the promise request is ready for processing.\n- If some invoices are valid and some invalid, clearly state that only part of the request can proceed and the rest needs review.\n- If all invoices are invalid, clearly state that the request requires manual review.\n- If no invoice details could be identified, clearly state that no actionable promise could be created.\n\n### 6.2 Promise Date\n- If a single `promiseDate` exists, mention it directly.\n- If multiple dates exist in `promiseDates`, summarize that multiple promise dates were identified and mention the overall outcome briefly.\n- If no promise date is available, clearly say that the promise date could not be determined.\n\n### 6.3 Invoice / Transaction Counts\n- Mention `invoiceCount`, `valid`, and `invalid` when available.\n- If total is unavailable but valid and invalid are present, infer total only when safe.\n- Do not invent counts.\n\n### 6.4 Amounts by Currency\n- If `totalPromisedAmountsByCurrency` exists, summarize promised amounts by currency.\n- If only one currency exists, mention it directly.\n- If multiple currencies exist, clearly separate totals by currency.\n- If useful in a multi-currency case, you may refer to ledger/accounted context in plain business language.\n- Do not invent amounts.\n\n### 6.5 Issue Grouping\n- If `errorsByInvoice` exists, group issues by business meaning, not by technical code.\n- For each major issue group:\n  - mention affected invoice count\n  - cite 1 or 2 sample invoice numbers\n  - if additional invoices exist, say `and X others`\n- Avoid long invoice lists.\n- Do not repeat the same issue unnecessarily.\n\n### 6.6 Next Action\nAlways end with a short, explicit next action for the collector.\nExamples:\n- `Suggested action: proceed with the valid promises and review the invalid transactions.`\n- `Suggested action: review the duplicate promise records before retrying.`\n- `Suggested action: correct the missing transaction details and reprocess the request.`\n- `Suggested action: review the invalid promise date or amount details before reprocessing.`\n\n---\n\n## 7. Output Style Rules\n- Output must be plain text only.\n- Do not output JSON.\n- Do not output markdown.\n- Do not use bullets.\n- Do not use headings.\n- Write **2 to 4 sentences maximum**.\n- Use concise, professional, collector-friendly language.\n- Keep the summary suitable for a work-queue or case-management UI.\n- Prefer short sentences over long, complex sentences.\n\n---\n\n## 8. Preferred Narrative Patterns\n\n### Fully valid\n`Promise date 2026-04-05 was identified and all 3 invoices are ready for processing. Total promised amount is USD 2,500. Suggested action: proceed with the promise request.`\n\n### Partially valid\n`Promise date 2026-04-05 was identified for 5 invoices, of which 3 are ready for processing and 2 require review. Total promised amounts are USD 2,500 and EUR 900. Key issues include duplicate promise records for INV-101 and an existing unactioned promise email for INV-204. Suggested action: process the valid promises and review the invalid invoices.`\n\n### Fully invalid\n`Promise date 2026-04-05 was identified, but all 3 invoices require review before processing. Total promised amount is USD 1,800. Key issues include existing duplicate promises for INV-101 and promise date validation issues for INV-309. Suggested action: review the invalid invoices and correct the request before retrying.`\n\n### No actionable promise\n`No actionable promise records were created because transaction identifiers could not be extracted from the request. Suggested action: review the request manually and identify the affected transactions before reprocessing.`\n\n---\n\n## 9. Special Constraints\n- Never mention raw error codes.\n- Never mention internal workflow node names.\n- Never mention implementation details.\n- Never output more than 4 sentences.\n- Never invent invoice numbers, currencies, totals, or counts.\n- If summary data is limited, provide the best possible concise business summary based only on the available facts.\n\n---\n\n## 10. Final Instruction\nReturn only the final plain-text collector-facing summary."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Insert Promise Summary Text",
            "returnType": "array",
            "sourceCode": "// INPUTS\nlet missingInfoOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PROMISE_INFORMATION || {}).$output;\nlet validTxnOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_ACTIONABLE_PROMISE_REQUESTS || {}).$output;\nlet invalidTxnOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_REQUESTS_FOR_INVALID_TRANSACTIONS || {}).$output;\nlet summaryText = (($context.$nodes || {}).FIN_IEX_LLM_GENERATE_PROMISE_REQUEST_SUMMARY || {}).$output || \"\";\n\nlet missingInfoOutput = missingInfoOutputRaw && missingInfoOutputRaw.result\n  ? missingInfoOutputRaw.result\n  : missingInfoOutputRaw;\n\nlet validTxnOutput = validTxnOutputRaw && validTxnOutputRaw.result\n  ? validTxnOutputRaw.result\n  : validTxnOutputRaw;\n\nlet invalidTxnOutput = invalidTxnOutputRaw && invalidTxnOutputRaw.result\n  ? invalidTxnOutputRaw.result\n  : invalidTxnOutputRaw;\n\nlet payload = [];\n\nif (Array.isArray(validTxnOutput)) {\n  payload = payload.concat(validTxnOutput);\n} else if (validTxnOutput) {\n  payload.push(validTxnOutput);\n}\n\nif (Array.isArray(invalidTxnOutput)) {\n  payload = payload.concat(invalidTxnOutput);\n} else if (invalidTxnOutput) {\n  payload.push(invalidTxnOutput);\n}\n\nif (Array.isArray(missingInfoOutput)) {\n  payload = payload.concat(missingInfoOutput);\n} else if (missingInfoOutput) {\n  payload.push(missingInfoOutput);\n}\n\nfor (let i = 0; i < payload.length; i++) {\n  let item = payload[i] || {};\n  let resp = item.responseData || {};\n  if (resp.firstRecord === \"Y\") {\n    if (!item.requestData) item.requestData = {};\n    if (!item.requestData.summary) item.requestData.summary = {};\n    item.requestData.summary.summaryText = summaryText;\n    break;\n  }\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1772047457029"
          },
          "code": "FIN_IEX_CODE_INSERT_PROMISE_SUMMARY_TEXT",
          "id": "1772041519348",
