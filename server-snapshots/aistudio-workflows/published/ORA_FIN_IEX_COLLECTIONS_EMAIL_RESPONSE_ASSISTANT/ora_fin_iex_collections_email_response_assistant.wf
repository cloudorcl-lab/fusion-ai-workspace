          "code": "FIN_IEX_IF_CONDITION_CHECK_MISSING_INFORMATION_FOR_PROMISE_REQUEST",
          "convergenceTargetId": "1772038381369",
          "id": "1771179330922",
          "inputs": [
            {
              "id": "1771179330923_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_IDENTIFY_MANDATORY_INFORMATION_FOR_PROMISE_REQUEST.$output.result.FLOW === \"REJECT\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Construct Payload For Missing Promise Information",
            "returnType": "array",
            "sourceCode": "let promiseData = $context.$nodes.FIN_IEX_EXTRACT_PROMISE_INFORMATION.$output;\nlet messageId = $context.$variables.messageId;\n\nlet mandatoryInfoOutput = (($context.$nodes || {}).FIN_IEX_CODE_IDENTIFY_MANDATORY_INFORMATION_FOR_PROMISE_REQUEST || {}).$output || {};\nlet mandatoryInfoResult = mandatoryInfoOutput.result || mandatoryInfoOutput || {};\nlet requestDataRaw = mandatoryInfoResult.REQUEST_DATA;\nlet requestDataObj = requestDataRaw;\nif (typeof requestDataRaw === \"string\") {\n  try {\n    requestDataObj = JSON.parse(requestDataRaw);\n  } catch (e) {\n    requestDataObj = {};\n  }\n}\n\nlet ERROR_REASON =\n  (requestDataObj || {}).ERROR_REASON ||\n  (mandatoryInfoResult || {}).ERROR_REASON ||\n  \"\";\n\n/* Define error code + error text globally using variables */\nlet ERROR_CODE = \"\";\nlet ERROR_TEXT = \"\";\n\nlet ERROR_CODE_INVOICE_DETAILS_NOT_FOUND = \"INVOICE_DETAILS_NOT_FOUND\";\nlet ERROR_TEXT_INVOICE_DETAILS_NOT_FOUND = \"Transaction identifiers could not be extracted from the email.\";\n\n/* Populate error text based on ERROR_REASON (no custom functions; assignment-friendly) */\nERROR_CODE =\n  (ERROR_REASON === \"INVOICE_DETAILS_NOT_FOUND\")\n    ? ERROR_CODE_INVOICE_DETAILS_NOT_FOUND\n    : ERROR_CODE;\n\nERROR_TEXT =\n  (ERROR_REASON === \"INVOICE_DETAILS_NOT_FOUND\")\n    ? ERROR_TEXT_INVOICE_DETAILS_NOT_FOUND\n    : ERROR_TEXT;\n\nlet rejectedPromiseRequest = {\n  message: { messageId: messageId },\n  requestData: {\n    promiseData: promiseData,\n    summary: {\n      errors: [\n        {\n          errorCode: ERROR_CODE,\n          errorText: ERROR_TEXT\n        }\n      ]\n    }\n  },\n  responseData: { firstRecord: \"Y\" },\n  intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" },\n  processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n};\n\nlet requestPayload = [rejectedPromiseRequest];\nreturn requestPayload;"
          },
          "outcomes": {
            "success": "1772038381369"
