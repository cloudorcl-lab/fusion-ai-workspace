        {
          "metadata": {
            "name": "Create Partial Valid Error Message Extract Payload",
            "returnType": "string",
            "sourceCode": "const input = $context.$variables.FilteredMessageDetailsArray;\nconst processingStatus = $context.$nodes.FIN_IEX_CODE_DERIVE_CATEGORY_CODE.$output.result;\n\nconst arr = Array.isArray(input) ? input : [];\nconst messageIds = arr.map(x => x?.messageId).filter(Boolean).join(\",\");\n\nlet payload = \"\";\n\nif (messageIds) {\n  payload = {\n    parameters: {\n      bindMessageIds: messageIds\n    },\n    viewQueries: {\n      CollectionsCustomerMsgDetails: {\n        module: \"oraErpCoreAdvancedCollections\",\n        businessObject: \"CollectionsCustomerMessage\",\n        view: \"collectionsCustomerMessageDetails\",\n        fieldAliases: {\n          \"customerMessageDetailId\": \"customerMessageDetailId\",\n          \"emailMessage.messageId\": \"messageId\"\n        }\n      }\n    },\n    select:\n      \"SELECT ccmd.customerMessageDetailId \" +\n      \"FROM CollectionsCustomerMsgDetails ccmd \" +\n      \"WHERE INSTR(',' || :bindMessageIds || ',', ',' || TO_CHAR(ccmd.messageId) || ',') > 0\"\n  };\n}\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1775630723227"
          },
          "code": "FIN_IEX_CODE_CREATE_PARTIAL_VALID_ERROR_MESSAGE_EXTRACT_PAYLOAD",
          "id": "1775569773170",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
