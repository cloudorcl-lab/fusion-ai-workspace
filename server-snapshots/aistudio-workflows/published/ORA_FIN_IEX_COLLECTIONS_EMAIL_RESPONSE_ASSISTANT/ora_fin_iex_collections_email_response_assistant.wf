            "default": "1772038381369"
          },
          "code": "FIN_IEX_SWITCH_CLASSIFY_PROMISE_INTENT",
          "convergenceTargetId": "1772038381369",
          "id": "1771659365891",
          "inputs": [
            {
              "id": "1771659365894_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.currentProcessingIntent.subIntent}}"
