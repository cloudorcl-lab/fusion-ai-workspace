          "code": "FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK",
          "id": "1775491505545",
          "inputs": [
            {
              "id": "1775491505547_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_FILTER_VALID_DISPUTE_TRANSACTIONS.$output.result.validInvoicesObject}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Flatten Duplicate Checked Dispute Transactions",
            "returnType": "object",
            "sourceCode": "const rawResults = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK.$output;\n\nlet flattened = [];\nlet headerLevelValidInvoiceObject = [];\nlet lineLevelValidInvoiceObject = [];\nlet validInvoicesObject = [];\n\nif (Array.isArray(rawResults)) {\n  for (let i = 0; i < rawResults.length; i++) {\n    let item = rawResults[i];\n    let parsed = item;\n\n    try {\n      if (typeof item === \"string\") {\n        parsed = JSON.parse(item);\n      }\n    } catch (e) {\n      parsed = null;\n    }\n\n    if (!parsed) {\n      continue;\n    }\n\n    if (Array.isArray(parsed)) {\n      for (let j = 0; j < parsed.length; j++) {\n        let arrItem = parsed[j];\n        if (arrItem && arrItem.result) {\n          flattened.push(arrItem.result);\n        } else if (arrItem) {\n          flattened.push(arrItem);\n        }\n      }\n    } else if (parsed.result) {\n      flattened.push(parsed.result);\n    } else {\n      flattened.push(parsed);\n    }\n  }\n} else if (typeof rawResults === \"string\") {\n  try {\n    let parsedSingle = JSON.parse(rawResults);\n    if (Array.isArray(parsedSingle)) {\n      for (let i = 0; i < parsedSingle.length; i++) {\n        let singleArrItem = parsedSingle[i];\n        if (singleArrItem && singleArrItem.result) {\n          flattened.push(singleArrItem.result);\n        } else if (singleArrItem) {\n          flattened.push(singleArrItem);\n        }\n      }\n    } else if (parsedSingle && parsedSingle.result) {\n      flattened.push(parsedSingle.result);\n    } else if (parsedSingle) {\n      flattened.push(parsedSingle);\n    }\n  } catch (e2) {\n    flattened = [];\n  }\n} else if (rawResults && typeof rawResults === \"object\") {\n  if (rawResults.result) {\n    flattened.push(rawResults.result);\n  } else {\n    flattened.push(rawResults);\n  }\n}\n\nfor (let i = 0; i < flattened.length; i++) {\n  let invoice = flattened[i] || {};\n  validInvoicesObject.push(invoice);\n\n  if (invoice.disputeSectionCode === \"SPECIFIC_INVOICE_LINES\") {\n    lineLevelValidInvoiceObject.push(invoice);\n  } else {\n    headerLevelValidInvoiceObject.push(invoice);\n  }\n}\n\nreturn {\n  validInvoicesObject: validInvoicesObject,\n  headerLevelValidInvoiceObject: headerLevelValidInvoiceObject,\n  lineLevelValidInvoiceObject: lineLevelValidInvoiceObject\n};"
          },
          "outcomes": {
            "success": "1771827502176"
          },
          "code": "FIN_IEX_CODE_FLATTEN_DUPLICATE_CHECKED_DISPUTE_TRANSACTIONS",
