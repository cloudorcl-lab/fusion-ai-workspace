          },
          "outcomes": {
            "PromiseToPay": "1771659365891",
            "UnsupportedIntent": "1774433670467",
            "DisputeRequest": "1771659756560",
            "InvoiceCopyRequest": "1773030955943",
            "POUpdate": "1773593944618"
          },
          "code": "FIN_IEX_SWITCH_INTENT_ROUTER",
          "convergenceTargetId": "1774434471672",
          "id": "1771150581150",
          "inputs": [
            {
              "id": "1771150581152_1",
              "name": "caseExpression",
