            "name": "Create Payload For Processing Status Update To Manual Review",
            "returnType": "array",
            "sourceCode": "const partialValidIds=$context.$nodes.FIN_IEX_BO_OBTAIN_PARTIAL_VALID_ERROR_MESSAGE_DETAILS.$output;\n\nconst processingStatusCode=\"ORA_MANUAL_PROCESSED\";\n\nconst partialArr=Array.isArray(partialValidIds)?partialValidIds:[];\n\nconst messageDetailIds=[...new Set(\n  partialArr\n    .map((r)=>r?.CUSTOMERMESSAGEDETAILID??r?.customerMessageDetailId??r?.messageDetailId)\n    .filter((id)=>id!==null&&id!==undefined)\n)];\n\nconst output=messageDetailIds.map((messageDetailId)=>({\n  messageDetailId,\n  payload:JSON.stringify({\n    processingStatus:{\n      lookupCode:processingStatusCode\n    }\n  })\n}));\n\nreturn output;"
          },
          "outcomes": {
            "success": "1775712114690"
          },
