        {
          "metadata": {
            "name": "Extract Dispute Summary for LLM",
            "returnType": "object",
            "sourceCode": "let invoicesNotFoundOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_DISPUTE_INVOICES_NOT_FOUND_PAYLOAD || {}).$output;\nlet disputePayloadOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_DISPUTE_PAYLOAD || {}).$output;\n\nlet invoicesNotFoundOutput = invoicesNotFoundOutputRaw && invoicesNotFoundOutputRaw.result\n  ? invoicesNotFoundOutputRaw.result\n  : invoicesNotFoundOutputRaw;\n\nlet disputePayloadOutput = disputePayloadOutputRaw && disputePayloadOutputRaw.result\n  ? disputePayloadOutputRaw.result\n  : disputePayloadOutputRaw;\n\nlet combinedPayload = [];\n\nif (Array.isArray(disputePayloadOutput)) {\n  combinedPayload = combinedPayload.concat(disputePayloadOutput);\n} else if (disputePayloadOutput) {\n  combinedPayload.push(disputePayloadOutput);\n}\n\nif (Array.isArray(invoicesNotFoundOutput)) {\n  combinedPayload = combinedPayload.concat(invoicesNotFoundOutput);\n} else if (invoicesNotFoundOutput) {\n  combinedPayload.push(invoicesNotFoundOutput);\n}\n\nlet summaryObj = null;\n\nfor (let i = 0; i < combinedPayload.length; i++) {\n  let item = combinedPayload[i] || null;\n  let resp = item && item.responseData ? item.responseData : null;\n  if (resp && resp.firstRecord === \"Y\") {\n    summaryObj = item && item.requestData && item.requestData.summary ? item.requestData.summary : null;\n    break;\n  }\n}\n\nlet finalOutput = { summary: summaryObj };\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1771952144526"
          },
          "code": "FIN_IEX_CODE_EXTRACT_DISPUTE_SUMMARY_FOR_LLM",
          "id": "1772299589634",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Generate Summary for Dispute Email"
          },
          "outcomes": {
            "success": "1772299754396"
          },
          "code": "FIN_IEX_LLM_GENERATE_SUMMARY_FOR_DISPUTE_EMAIL",
          "convergenceTargetId": "1772299754396",
          "id": "1771952144526",
          "inputs": [
            {
              "id": "1771952144532_1",
              "name": "prompt",
              "type": "string",
              "value": "# Dispute Processing Outcome Summary Agent\n\n## 1. Functional Role\nYou are a financial collections assistant responsible for generating a concise, collector-facing summary of a dispute-processing outcome.\n\nYour task is to read the provided dispute-processing summary object and produce a short operational summary that helps a collector quickly understand:\n- what was processed\n- what was valid versus invalid\n- what requires review\n- what action should be taken next\n\nYour output will be shown in a workflow table, collector work queue, or case review UI.\n\nYou must:\n- summarize the dispute-processing result accurately\n- clearly indicate whether the request is fully valid, partially valid, or fully invalid\n- summarize disputed amounts by currency when available\n- describe issues in business language\n- make the summary action-oriented for a collector\n- avoid raw internal error codes\n- keep the output concise and easy to scan\n\nYou must not:\n- invent facts not present in the input\n- mention internal node names, variable names, or implementation details\n- mention raw error codes\n- output JSON\n- output markdown bullets or headings\n- output anything other than plain text\n\n---\n\n## 2. Input\nYou will receive one input object containing the dispute-processing summary:\n\n`{{$context.$nodes.FIN_IEX_CODE_EXTRACT_DISPUTE_SUMMARY_FOR_LLM.$output.result.summary}}`\n\nThe object may include fields such as:\n- `totalInvoices`\n- `validInvoiceCount`\n- `invalidInvoiceCount`\n- `disputedAmountsByCurrency`\n- `errorsByInvoice`\n- `errors`\n- other summary fields when available\n\nNot all fields are guaranteed to be present.\n\n---\n\n## 3. Objective\nGenerate a concise collector-facing summary of the dispute-processing outcome in **2 to 4 sentences maximum**.\n\nThe summary must help the collector immediately understand:\n1. how many invoices were processed\n2. how many were valid versus invalid\n3. the total disputed amounts by currency when available\n4. the main business issues affecting invalid invoices or transactions\n5. the next action the collector should take\n\n---\n\n## 4. Core Instructions\n1. Start with the overall dispute-processing outcome.\n2. Clearly state whether the request is:\n   - fully valid,\n   - partially valid and partially invalid, or\n   - fully invalid.\n3. Mention total invoice count when available.\n4. Mention valid and invalid counts when available.\n5. Summarize disputed amounts by currency when available.\n6. If there are multiple currencies, separate totals clearly.\n7. If there are invalid items, group issues by business meaning.\n8. Cite 1 or 2 sample invoice numbers when useful.\n9. If more invoices exist in the same issue group, say `and X others`.\n10. End with a clear collector-facing next action.\n11. Never mention raw error codes.\n\n---\n\n## 5. Business Interpretation Rules for Errors\nTranslate issues into collector-friendly business phrasing.\n\nExamples of acceptable business phrasing:\n- \"invoice could not be identified\"\n- \"multiple matching invoices were found\"\n- \"required dispute details are missing\"\n- \"line-level dispute details require review\"\n- \"duplicate dispute already exists for the transaction\"\n- \"an unactioned dispute request already exists for the transaction\"\n- \"manual review is needed before the dispute can be processed\"\n\nDo not mention technical error code values.\n\n---\n\n## 6. Summary Construction Rules\n\n### 6.1 Outcome\n- If all invoices are valid, clearly say the dispute request is ready for processing.\n- If some invoices are valid and some invalid, clearly state that part of the request can proceed and the rest needs review.\n- If all invoices are invalid, clearly state that the case requires manual review.\n- If no invoice details could be identified, clearly state that no actionable dispute could be created.\n\n### 6.2 Counts\n- Mention `totalInvoices`, `validInvoiceCount`, and `invalidInvoiceCount` when available.\n- If total is unavailable but valid and invalid counts are present, infer total only when safe.\n- Do not invent counts.\n\n### 6.3 Disputed Amounts\n- If `disputedAmountsByCurrency` exists, summarize the disputed amounts by currency.\n- If one currency exists, mention it directly.\n- If multiple currencies exist, clearly separate totals by currency.\n- Do not invent amounts.\n\n### 6.4 Error Grouping\n- If `errorsByInvoice` exists, group issues by business meaning, not by technical code.\n- For each major issue group:\n  - mention affected invoice count\n  - cite 1 or 2 sample invoice numbers\n  - if more invoices exist, say `and X others`\n- Avoid long invoice lists.\n- Do not repeat the same issue unnecessarily.\n\n### 6.5 Next Action\nAlways end with an explicit collector-facing next action.\nExamples:\n- `Suggested action: proceed with the valid disputes and review the invalid invoices.`\n- `Suggested action: review the unmatched invoice references and resubmit the dispute.`\n- `Suggested action: review the duplicate dispute records before retrying.`\n- `Suggested action: review missing dispute details before reprocessing.`\n\n---\n\n## 7. Output Style Rules\n- Output must be plain text only.\n- Do not output JSON.\n- Do not output markdown.\n- Do not use bullets.\n- Do not use headings.\n- Write **2 to 4 sentences maximum**.\n- Use concise, professional, collector-friendly language.\n- Keep the summary suitable for a work-queue or case-management UI.\n- Prefer short sentences over long, complex sentences.\n\n---\n\n## 8. Preferred Narrative Patterns\n\n### Fully valid\n`3 dispute requests were identified and all 3 are ready for processing. Total disputed amount is USD 2,500. Suggested action: proceed with dispute processing.`\n\n### Partially valid\n`5 dispute requests were identified, of which 3 are ready for processing and 2 require review. Total disputed amounts are USD 2,500 and EUR 900. Key issues include invoice identification failures for INV-101 and duplicate dispute requests for INV-204. Suggested action: process the valid disputes and review the invalid invoices.`\n\n### Fully invalid\n`All 3 dispute requests require review before processing. Total disputed amount is USD 1,800. Key issues include duplicate dispute requests for INV-101 and missing dispute details for INV-309. Suggested action: review the invalid disputes and correct the case details before retrying.`\n\n### No actionable dispute\n`No actionable dispute records were created because invoice details could not be extracted from the request. Suggested action: review the request manually and identify the affected transaction references.`\n\n---\n\n## 9. Special Constraints\n- Never mention raw error codes.\n- Never mention internal workflow node names.\n- Never mention implementation details.\n- Never output more than 4 sentences.\n- Never invent invoice numbers, currencies, totals, or counts.\n- If summary data is limited, provide the best possible concise business summary based only on the available facts.\n\n---\n\n## 10. Final Instruction\nReturn only the final plain-text collector-facing summary."
            }
          ],
          "outputSpecification": "",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Insert Dispute Summary Text",
            "returnType": "object",
            "sourceCode": "// INPUTS\nlet constructDisputePayloadOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_DISPUTE_PAYLOAD || {}).$output;\nlet invoicesNotFoundPayloadOutputRaw = (($context.$nodes || {}).FIN_IEX_CODE_CONSTRUCT_DISPUTE_INVOICES_NOT_FOUND_PAYLOAD || {}).$output;\nlet llmSummaryOutput = (($context.$nodes || {}).FIN_IEX_LLM_GENERATE_SUMMARY_FOR_DISPUTE_EMAIL || {}).$output;\n\nlet constructDisputePayloadOutput = constructDisputePayloadOutputRaw && constructDisputePayloadOutputRaw.result\n  ? constructDisputePayloadOutputRaw.result\n  : constructDisputePayloadOutputRaw;\n\nlet invoicesNotFoundPayloadOutput = invoicesNotFoundPayloadOutputRaw && invoicesNotFoundPayloadOutputRaw.result\n  ? invoicesNotFoundPayloadOutputRaw.result\n  : invoicesNotFoundPayloadOutputRaw;\n\n// Normalize LLM summary output\nlet summaryText = \"\";\nif (typeof llmSummaryOutput === \"string\") {\n  summaryText = llmSummaryOutput;\n} else if (llmSummaryOutput && typeof llmSummaryOutput.summaryText === \"string\") {\n  summaryText = llmSummaryOutput.summaryText;\n} else if (llmSummaryOutput && llmSummaryOutput.result && typeof llmSummaryOutput.result.summaryText === \"string\") {\n  summaryText = llmSummaryOutput.result.summaryText;\n}\n\n// Normalize payload inputs to array and combine (works even if only one branch executed)\nlet payload = [];\n\nif (Array.isArray(constructDisputePayloadOutput)) {\n  payload = payload.concat(constructDisputePayloadOutput);\n} else if (constructDisputePayloadOutput) {\n  payload.push(constructDisputePayloadOutput);\n}\n\nif (Array.isArray(invoicesNotFoundPayloadOutput)) {\n  payload = payload.concat(invoicesNotFoundPayloadOutput);\n} else if (invoicesNotFoundPayloadOutput) {\n  payload.push(invoicesNotFoundPayloadOutput);\n}\n\n// Insert summary text into the firstRecord row\nfor (let i = 0; i < payload.length; i++) {\n  let item = payload[i] || {};\n  let resp = item.responseData || {};\n  if (resp.firstRecord === \"Y\") {\n    if (!item.requestData) item.requestData = {};\n    if (!item.requestData.summary) item.requestData.summary = {};\n    item.requestData.summary.summaryText = summaryText;\n    break;\n  }\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1772300552026"
          },
