          "inputs": [
            {
              "id": "1777956807805",
              "name": "PaginationVariables",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FIN_IEX_CODE_CREATE_PARTIAL_VALID_ERROR_PAGINATION_OBJECT.$output.result}}"
