          "metadata": {
            "name": "Obtain Successful and Errored Promise Counts",
            "returnType": "object",
            "sourceCode": "const records = $context.$variables.OutputArray; \nconst arr = Array.isArray(records) ? records : [records];\n\nconst result = {\n  totalRecords: arr.length,\n  processingErrorCount: arr.filter(\n    r => r?.processingStatusCode === \"ORA_PROCESSING_ERROR\"\n  ).length,\n  processedCount: arr.filter(\n    r => r?.processingStatusCode === \"ORA_PROCESSED\"\n  ).length\n};\n\nreturn result;"
          },
