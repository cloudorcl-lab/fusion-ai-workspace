 SITEUSEID: lineIns.SITEUSEID || null },\n                customerTransaction: { customerTransactionId: lineIns.CUSTOMERTRANSACTIONID || null },\n                paymentSchedule: { paymentScheduleId: lineIns.PAYMENTSCHEDULEID || null },\n                businessUnit: { id: lineIns.BUSINESSUNITID || null },\n                message: { messageId: messageId },\n                requestData: lineReqDataObj,\n                responseData: null,\n                intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" }\n            };\n\n            requestPayload.push(lineReqObj);\n        }\n    }\n}\n\n// ========== Allocation: HEADER ==========\nif (promiseAmountLevel === \"HEADER\") {\n    var headerInstallments = [];\n    for (k in installmentsByTxn) {\n        headerInstallments = headerInstallments.concat(installmentsByTxn[k]);\n    }\n\n    headerInstallments.sort(function(a, b) {\n        var d1 = \"\";\n        var d2 = \"\";\n        if (a && a.INSTALLMENTDUEDATE) {\n            d1 = a.INSTALLMENTDUEDATE;\n        }\n        if (b && b.INSTALLMENTDUEDATE) {\n            d2 = b.INSTALLMENTDUEDATE;\n        }\n        if (d1 === d2) {\n            return (a.SEQUENCE || 0) - (b.SEQUENCE || 0);\n        }\n        if (d1 < d2) {\n            return -1;\n        }\n        return 1;\n    });\n\n    var headerPromiseAmount = sumOpenInstallments;\n    if (promiseObj.totalPromiseAmount !== undefined && promiseObj.totalPromiseAmount !== null) {\n        if (!isNaN(Number(promiseObj.totalPromiseAmount))) {\n            headerPromiseAmount = Number(promiseObj.totalPromiseAmount);\n        }\n    }\n\n    var remainingPromise = headerPromiseAmount;\n    for (i = 0; i < headerInstallments.length; i++) {\n        var headerIns = headerInstallments[i];\n        if (!headerIns) {\n            headerIns = {};\n        }\n\n        var headerTxnId = \"\";\n        if (headerIns.CUSTOMERTRANSACTIONID !== undefined && headerIns.CUSTOMERTRANSACTIONID !== null) {\n            headerTxnId = String(headerIns.CUSTOMERTRANSACTIONID);\n        }\n\n        var headerEffectiveDate = summaryPromiseDate;\n        if (effectivePromiseDateByTxn[headerTxnId]) {\n            headerEffectiveDate = effectivePromiseDateByTxn[headerTxnId];\n        }\n\n        var headerAmtDue = Number(headerIns.AMOUNTREMAINING || 0);\n        var headerApplyAmt = 0;\n\n        if (remainingPromise > 0) {\n            if (headerAmtDue < remainingPromise) {\n                headerApplyAmt = headerAmtDue;\n            } else {\n                headerApplyAmt = remainingPromise;\n            }\n            remainingPromise = remainingPromise - headerApplyAmt;\n        }\n\n        if (headerApplyAmt <= 0) {\n            continue;\n        }\n\n        if (!appliedAmountByTxn[headerTxnId]) {\n            appliedAmountByTxn[headerTxnId] = 0;\n        }\n        appliedAmountByTxn[headerTxnId] = appliedAmountByTxn[headerTxnId] + Number(headerApplyAmt || 0);\n\n        var headerReqDataObj = {\n            originalPromiseTransactionRequest: validatedPromisesTransactions,\n            actionablePayload: {\n                PromiseDate: headerEffectiveDate,\n                BusinessUnit: headerIns.BUSINESSUNIT || null,\n                BillToCustomerAccount: headerIns.ACCOUNTNUMBER || null,\n                TransactionNumber: headerIns.TRANSACTIONNUMBER || null,\n                TransactionDate: headerIns.TRANSACTIONDATE || null,\n                InstallmentNumber: headerIns.SEQUENCE || null,\n                PromiseAmount: headerApplyAmt,\n                Currency: summaryPromiseCurrency || null\n            }\n        };\n\n        var headerReqObj = {\n            customer: { id: headerIns.PARTYID || null },\n            customerAccount: { customerAccountId: headerIns.CUSTOMERACCOUNTID || null },\n            customerSiteUse: { SITEUSEID: headerIns.SITEUSEID || null },\n            customerTransaction: { customerTransactionId: headerIns.CUSTOMERTRANSACTIONID || null },\n            paymentSchedule: { paymentScheduleId: headerIns.PAYMENTSCHEDULEID || null },\n            businessUnit: { id: headerIns.BUSINESSUNITID || null },\n            message: { messageId: messageId },\n            requestData: headerReqDataObj,\n            responseData: null,\n            intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" }\n        };\n\n        requestPayload.push(headerReqObj);\n    }\n}\n\n// ========== Allocation: FULL ==========\nif (promiseAmountLevel === \"FULL\") {\n    var fullInstallments = [];\n    for (k in installmentsByTxn) {\n        fullInstallments = fullInstallments.concat(installmentsByTxn[k]);\n    }\n\n    fullInstallments.sort(function(a, b) {\n        var d1 = \"\";\n        var d2 = \"\";\n        if (a && a.INSTALLMENTDUEDATE) {\n            d1 = a.INSTALLMENTDUEDATE;\n        }\n        if (b && b.INSTALLMENTDUEDATE) {\n            d2 = b.INSTALLMENTDUEDATE;\n        }\n        if (d1 === d2) {\n            return (a.SEQUENCE || 0) - (b.SEQUENCE || 0);\n        }\n        if (d1 < d2) {\n            return -1;\n        }\n        return 1;\n    });\n\n    for (i = 0; i < fullInstallments.length; i++) {\n        var fullIns = fullInstallments[i];\n        if (!fullIns) {\n            fullIns = {};\n        }\n\n        var fullTxnId = \"\";\n        if (fullIns.CUSTOMERTRANSACTIONID !== undefined && fullIns.CUSTOMERTRANSACTIONID !== null) {\n            fullTxnId = String(fullIns.CUSTOMERTRANSACTIONID);\n        }\n\n        var fullEffectiveDate = summaryPromiseDate;\n        if (effectivePromiseDateByTxn[fullTxnId]) {\n            fullEffectiveDate = effectivePromiseDateByTxn[fullTxnId];\n        }\n\n        var fullAmtDue = Number(fullIns.AMOUNTREMAINING || 0);\n\n        if (!appliedAmountByTxn[fullTxnId]) {\n            appliedAmountByTxn[fullTxnId] = 0;\n        }\n        appliedAmountByTxn[fullTxnId] = appliedAmountByTxn[fullTxnId] + Number(fullAmtDue || 0);\n\n        var fullReqDataObj = {\n            originalPromiseTransactionRequest: validatedPromisesTransactions,\n            actionablePayload: {\n                PromiseDate: fullEffectiveDate,\n                BusinessUnit: fullIns.BUSINESSUNIT || null,\n                BillToCustomerAccount: fullIns.ACCOUNTNUMBER || null,\n                TransactionNumber: fullIns.TRANSACTIONNUMBER || null,\n                TransactionDate: fullIns.TRANSACTIONDATE || null,\n                InstallmentNumber: fullIns.SEQUENCE || null,\n                PromiseBalanceAmount: \"Y\"\n            }\n        };\n\n        var fullReqObj = {\n            customer: { id: fullIns.PARTYID || null },\n            customerAccount: { customerAccountId: fullIns.CUSTOMERACCOUNTID || null },\n            customerSiteUse: { SITEUSEID: fullIns.SITEUSEID || null },\n            customerTransaction: { customerTransactionId: fullIns.CUSTOMERTRANSACTIONID || null },\n            paymentSchedule: { paymentScheduleId: fullIns.PAYMENTSCHEDULEID || null },\n            businessUnit: { id: fullIns.BUSINESSUNITID || null },\n            message: { messageId: messageId },\n            requestData: fullReqDataObj,\n            responseData: null,\n            intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" }\n        };\n\n        requestPayload.push(fullReqObj);\n    }\n}\n\n// --------- Promise amount < open balance (HEADER level) ---------\nif (promiseAmountLevel === \"HEADER\") {\n    for (var txnKey in invoiceOpenBalanceByTxn) {\n        var appliedAmount = appliedAmountByTxn[txnKey] || 0;\n        var openBalanceForTxn = invoiceOpenBalanceByTxn[txnKey] || 0;\n\n        if (appliedAmount <= 0 && openBalanceForTxn > 0) {\n            var invNumber = \"\";\n            if (invoiceNumberByTxn[txnKey]) {\n                invNumber = invoiceNumberByTxn[txnKey];\n            }\n\n            var _headerTxnLessErrText = ERROR_TEXT_PROM_LESS_THAN_OPEN;\n            _headerTxnLessErrText = _headerTxnLessErrText.replace(new RegExp(\"\\\\{promiseAmount\\\\}\", \"g\"), String(appliedAmount));\n            _headerTxnLessErrText = _headerTxnLessErrText.replace(new RegExp(\"\\\\{openBalance\\\\}\", \"g\"), String(openBalanceForTxn));\n            _headerTxnLessErrText = _headerTxnLessErrText.replace(new RegExp(\"\\\\{trxNumber\\\\}\", \"g\"), String(invNumber));\n\n            var headerTxnLessErrObj = {\n                errorCode: ERROR_CODE_PROM_LESS_THAN_OPEN,\n                errorText: _headerTxnLessErrText\n            };\n\n            if (txnKey) {\n                if (!errorsByTxn[txnKey]) {\n                    errorsByTxn[txnKey] = [];\n                }\n                errorsByTxn[txnKey].push(headerTxnLessErrObj);\n            }\n\n            if (invNumber) {\n                if (!errorsByInvoiceMap[invNumber]) {\n                    errorsByInvoiceMap[invNumber] = [];\n                }\n                errorsByInvoiceMap[invNumber].push(headerTxnLessErrObj);\n            }\n        }\n    }\n}\n\n// --------- Apply errors to request data and compute summary counts ---------\nvar validTransactionNumbersArr = [];\nvar firstErrorIndex = -1;\nvar firstValidIndex = -1;\n\nfor (i = 0; i < validatedInvoicesList.length; i++) {\n    var summaryInv = validatedInvoicesList[i];\n    if (!summaryInv) {\n        summaryInv = {};\n    }\n\n    var summaryTxnId = String(summaryInv.CustomerTransactionId || \"\");\n    var invNumber2 = summaryInv.invoiceNumber || \"\";\n    var invErrors = errorsByTxn[summaryTxnId] || [];\n\n    if (invErrors.length > 0) {\n        if (invNumber2 !== \"\") {\n            if (invalidTransactionNumbersArr.indexOf(invNumber2) === -1) {\n                invalidTransactionNumbersArr.push(invNumber2);\n            }\n        }\n    } else {\n        if (invNumber2 !== \"\") {\n            if (validTransactionNumbersArr.indexOf(invNumber2) === -1) {\n                validTransactionNumbersArr.push(invNumber2);\n            }\n        }\n    }\n}\n\nfor (i = 0; i < requestPayload.length; i++) {\n    var reqItem = requestPayload[i];\n    var reqTxnId = \"\";\n    if (reqItem.customerTransaction && reqItem.customerTransaction.customerTransactionId !== undefined && reqItem.customerTransaction.customerTransactionId !== null) {\n        reqTxnId = String(reqItem.customerTransaction.customerTransactionId);\n    }\n\n    var reqErrors = errorsByTxn[reqTxnId] || [];\n    if (reqErrors.length > 0) {\n        reqItem.requestData.errors = reqErrors;\n\n        var hasAmountApplyError = false;\n        for (var erIdx = 0; erIdx < reqErrors.length; erIdx++) {\n            if (reqErrors[erIdx] && reqErrors[erIdx].errorCode === ERROR_CODE_PROM_LESS_THAN_OPEN) {\n                hasAmountApplyError = true;\n            }\n        }\n\n        if (hasAmountApplyError) {\n            reqItem.processingStatus = statusErrorReviewPending;\n        } else {\n            reqItem.processingStatus = statusErrorReviewRequired;\n        }\n\n        if (firstErrorIndex === -1) {\n            firstErrorIndex = i;\n        }\n    } else {\n        reqItem.processingStatus = statusActionPending;\n        if (firstValidIndex === -1) {\n            firstValidIndex = i;\n        }\n    }\n}\n\nvar summaryValidCount = validTransactionNumbersArr.length;\nvar summaryInvalidCount = invalidTransactionNumbersArr.length;\nvar summaryInvoiceCount = summaryValidCount + summaryInvalidCount;\n\nvar totalPromisedAmountsByCurrencyMap = {};\nvar accountedAmountValid = 0;\nvar accountedAmountInvalid = 0;\nvar amountRemainingValid = 0;\nvar amountRemainingInvalid = 0;\n\nfor (i = 0; i < validatedInvoicesList.length; i++) {\n    var totalInv = validatedInvoicesList[i];\n    if (!totalInv) {\n        totalInv = {};\n    }\n\n    var totalTxnId = String(totalInv.CustomerTransactionId || \"\");\n    var totalTxnCurrency = invoiceCurrencyByTxn[totalTxnId] || totalInv.invoiceCurrency || summaryPromiseCurrency || \"\";\n    var appliedAmount2 = appliedAmountByTxn[totalTxnId] || 0;\n    var accountedAmount = invoiceAccountedByTxn[totalTxnId] || 0;\n    var amountRemaining = invoiceOpenBalanceByTxn[totalTxnId] || 0;\n    var totalErrors = errorsByTxn[totalTxnId] || [];\n\n    if (!totalPromisedAmountsByCurrencyMap[totalTxnCurrency]) {\n        totalPromisedAmountsByCurrencyMap[totalTxnCurrency] = {\n            currencyCode: totalTxnCurrency,\n            totalPromisedAmount: 0,\n            totalPromisedAmountValid: 0,\n            totalPromisedAmountInvalid: 0,\n            invoiceCount: 0,\n            validInvoiceCount: 0,\n            invalidInvoiceCount: 0\n        };\n    }\n\n    totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmount = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmount + appliedAmount2;\n    totalPromisedAmountsByCurrencyMap[totalTxnCurrency].invoiceCount = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].invoiceCount + 1;\n\n    if (totalErrors.length > 0) {\n        totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmountInvalid = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmountInvalid + appliedAmount2;\n        totalPromisedAmountsByCurrencyMap[totalTxnCurrency].invalidInvoiceCount = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].invalidInvoiceCount + 1;\n        accountedAmountInvalid = accountedAmountInvalid + accountedAmount;\n        amountRemainingInvalid = amountRemainingInvalid + amountRemaining;\n    } else {\n        totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmountValid = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].totalPromisedAmountValid + appliedAmount2;\n        totalPromisedAmountsByCurrencyMap[totalTxnCurrency].validInvoiceCount = totalPromisedAmountsByCurrencyMap[totalTxnCurrency].validInvoiceCount + 1;\n        accountedAmountValid = accountedAmountValid + accountedAmount;\n        amountRemainingValid = amountRemainingValid + amountRemaining;\n    }\n}\n\nvar totalPromisedAmountsByCurrency = [];\nvar promiseCurrencies = [];\nfor (var totalCurrKey in totalPromisedAmountsByCurrencyMap) {\n    if (totalPromisedAmountsByCurrencyMap.hasOwnProperty(totalCurrKey)) {\n        totalPromisedAmountsByCurrency.push(totalPromisedAmountsByCurrencyMap[totalCurrKey]);\n        promiseCurrencies.push(totalPromisedAmountsByCurrencyMap[totalCurrKey].currencyCode);\n    }\n}\n\nvar promiseDatesSummary = [];\nfor (i = 0; i < validatedInvoicesList.length; i++) {\n    var dateInv = validatedInvoicesList[i];\n    if (!dateInv) {\n        dateInv = {};\n    }\n\n    var dateTxn = String(dateInv.CustomerTransactionId || \"\");\n    var dateTxnCurrency = invoiceCurrencyByTxn[dateTxn] || dateInv.invoiceCurrency || summaryPromiseCurrency || \"\";\n    var effectiveDate = effectivePromiseDateByTxn[dateTxn];\n    if (!effectiveDate) {\n        continue;\n    }\n\n    var dateAmount = appliedAmountByTxn[dateTxn] || 0;\n    var dateErrors = errorsByTxn[dateTxn] || [];\n    var isDateInvalid = false;\n    if (dateErrors.length > 0) {\n        isDateInvalid = true;\n    }\n\n    var found = false;\n    for (var pd = 0; pd < promiseDatesSummary.length; pd++) {\n        if (promiseDatesSummary[pd].promiseDate === effectiveDate && promiseDatesSummary[pd].currencyCode === dateTxnCurrency) {\n            promiseDatesSummary[pd].totalPromisedAmount = promiseDatesSummary[pd].totalPromisedAmount + dateAmount;\n            promiseDatesSummary[pd].invoiceCount = promiseDatesSummary[pd].invoiceCount + 1;\n            if (isDateInvalid) {\n                promiseDatesSummary[pd].invalidInvoiceCount = promiseDatesSummary[pd].invalidInvoiceCount + 1;\n                promiseDatesSummary[pd].totalPromisedAmountInvalid = promiseDatesSummary[pd].totalPromisedAmountInvalid + dateAmount;\n            } else {\n                promiseDatesSummary[pd].validInvoiceCount = promiseDatesSummary[pd].validInvoiceCount + 1;\n                promiseDatesSummary[pd].totalPromisedAmountValid = promiseDatesSummary[pd].totalPromisedAmountValid + dateAmount;\n            }\n            found = true;\n            break;\n        }\n    }\n\n    if (!found) {\n        promiseDatesSummary.push({\n            promiseDate: effectiveDate,\n            currencyCode: dateTxnCurrency,\n            totalPromisedAmount: dateAmount,\n            invoiceCount: 1,\n            validInvoiceCount: isDateInvalid ? 0 : 1,\n            invalidInvoiceCount: isDateInvalid ? 1 : 0,\n            totalPromisedAmountValid: isDateInvalid ? 0 : dateAmount,\n            totalPromisedAmountInvalid: isDateInvalid ? dateAmount : 0\n        });\n    }\n}\n\nvar summaryErrorsByInvoice = [];\nfor (var invoiceNum in errorsByInvoiceMap) {\n    if (errorsByInvoiceMap.hasOwnProperty(invoiceNum)) {\n        summaryErrorsByInvoice.push({\n            invoiceNumber: invoiceNum,\n            errors: errorsByInvoiceMap[invoiceNum]\n        });\n    }\n}\n\nvar summaryObj = {\n    promiseDate: summaryPromiseDate,\n    promiseDates: promiseDatesSummary,\n    invoiceCount: summaryInvoiceCount,\n    valid: summaryValidCount,\n    invalid: summaryInvalidCount,\n    totalPromisedAmountsByCurrency: totalPromisedAmountsByCurrency,\n    promiseCurrencies: promiseCurrencies,\n    accountedAmount: accountedAmountValid + accountedAmountInvalid,\n    accountedAmountValid: accountedAmountValid,\n    accountedAmountInvalid: accountedAmountInvalid,\n    amountRemaining: amountRemainingValid + amountRemainingInvalid,\n    amountRemainingValid: amountRemainingValid,\n    amountRemainingInvalid: amountRemainingInvalid,\n    ledgerCurrency: summaryLedgerCurrency,\n    transactionSummary: {\n        valid: validTransactionNumbersArr.join(\",\"),\n        invalid: invalidTransactionNumbersArr.join(\",\")\n    },\n    errorsByInvoice: summaryErrorsByInvoice,\n    errors: globalErrors\n};\n\nif (requestPayload.length === 0 && invalidTransactionNumbersArr.length > 0) {\n    requestPayload.push({\n        customer: {},\n        customerAccount: {},\n        customerSiteUse: {},\n        customerTransaction: {},\n        businessUnit: {},\n        message: { messageId: messageId },\n        requestData: {\n            invalidTransactionReferences: invalidTransactionNumbersArr,\n            summary: summaryObj,\n            errors: globalErrors\n        },\n        responseData: { firstRecord: \"Y\" },\n        intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" },\n        processingStatus: statusErrorReviewPending\n    });\n}\n\nvar summaryIndex = -1;\nif (firstValidIndex !== -1) {\n    summaryIndex = firstValidIndex;\n} else {\n    summaryIndex = firstErrorIndex;\n}\n\nif (summaryIndex !== -1 && requestPayload.length > 0) {\n    requestPayload[summaryIndex].requestData.summary = summaryObj;\n    requestPayload[summaryIndex].responseData = { firstRecord: \"Y\" };\n\n    if (summaryValidCount > 0 && summaryInvalidCount > 0) {\n        requestPayload[summaryIndex].processingStatus = statusReviewPending;\n    } else if (summaryValidCount === 0 && summaryInvalidCount > 0) {\n        requestPayload[summaryIndex].processingStatus = statusErrorReviewPending;\n    } else if (summaryValidCount > 0 && summaryInvalidCount === 0) {\n        requestPayload[summaryIndex].processingStatus = statusActionPending;\n    }\n\n    var summaryRequiresReview = false;\n    if (requestPayload[summaryIndex].processingStatus && requestPayload[summaryIndex].processingStatus.lookupCode === \"ORA_REVIEW_PENDING\") {\n        summaryRequiresReview = true;\n    }\n\n    if (summaryRequiresReview) {\n        for (var r = 0; r < requestPayload.length; r++) {\n            var item = requestPayload[r];\n            var isFirstRecord = false;\n            var itemErrors = [];\n            var hasItemErrors = false;\n\n            if (item.responseData && item.responseData.firstRecord === \"Y\") {\n                isFirstRecord = true;\n            }\n            if (item.requestData && item.requestData.errors) {\n                itemErrors = item.requestData.errors;\n            }\n            if (itemErrors.length > 0) {\n                hasItemErrors = true;\n            }\n\n            if (!isFirstRecord && !hasItemErrors && item.processingStatus && item.processingStatus.lookupCode === \"ORA_ACTION_PENDING\") {\n                item.processingStatus = statusReviewPending;\n            }\n        }\n    }\n}\n\n// --------- FINAL RETURN ---------\nvar result = requestPayload;\nreturn result;"
