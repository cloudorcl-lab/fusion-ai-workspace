                {
                  "metadata": {
                    "name": "Check Invoice Copy Transactions",
                    "returnType": "object",
                    "sourceCode": "var transactionDetail = $context.$nodes.FIN_IEX_LOOP_ITERATE_INVOICE_COPY_REQUESTS.FIN_IEX_BO_SEARCH_INVOICE_COPY_TRANSACTIONS.$output || [];\nvar currentInvoice = $context.$nodes.FIN_IEX_LOOP_ITERATE_INVOICE_COPY_REQUESTS.$currentItem || {};\n\n/*\n  Status enrichment\n*/\nif (Array.isArray(transactionDetail) && transactionDetail.length === 1) {\n    currentInvoice.TransactionStatus = \"VALID\";\n    currentInvoice.customerTransactionId = transactionDetail[0].CUSTOMERTRANSACTIONID || null;\n} else if (Array.isArray(transactionDetail) && transactionDetail.length === 0) {\n    currentInvoice.TransactionStatus = \"INVOICE_NOT_FOUND\";\n    currentInvoice.customerTransactionId = null;\n} else if (Array.isArray(transactionDetail) && transactionDetail.length > 1) {\n    currentInvoice.TransactionStatus = \"MULTIPLE_INVOICES_FOUND\";\n    currentInvoice.customerTransactionId = transactionDetail[0] && transactionDetail[0].CUSTOMERTRANSACTIONID ? transactionDetail[0].CUSTOMERTRANSACTIONID : null;\n}\n\nreturn currentInvoice;"
                  },
