        {
          "metadata": {
            "name": "Filter Valid Invoice Copy Transactions",
            "returnType": "object",
            "sourceCode": "var rawInvoices = $context.$nodes.FIN_IEX_LOOP_ITERATE_INVOICE_COPY_REQUESTS.$output || []; \n\n/*\n  Output holders\n*/\nvar validInvoiceCount = 0;\nvar invalidInvoiceCount = 0;\nvar validInvoicesObject = [];\nvar invalidInvoicesObject = [];\n\n/*\n  Normalize and classify loop output\n*/\nvar i = 0;\nfor (i = 0; i < rawInvoices.length; i = i + 1) {\n    var rawItem = rawInvoices[i];\n    var parsedObj = rawItem;\n\n    if (typeof rawItem === \"string\") {\n        parsedObj = JSON.parse(rawItem);\n    }\n\n    var invoice = parsedObj.result || parsedObj;\n\n    if (invoice.TransactionStatus === \"VALID\") {\n        validInvoiceCount = validInvoiceCount + 1;\n        validInvoicesObject.push(invoice);\n    } else {\n        invalidInvoiceCount = invalidInvoiceCount + 1;\n        invalidInvoicesObject.push(invoice);\n    }\n}\n\n/*\n  Final result\n*/\nvar result = {\n    validInvoiceCount: validInvoiceCount,\n    invalidInvoiceCount: invalidInvoiceCount,\n    validInvoicesObject: validInvoicesObject,\n    invalidInvoicesObject: invalidInvoicesObject\n};\n\n \nreturn result;"
          },
          "outcomes": {
            "success": "1773338568978"
          },
          "code": "FIN_IEX_CODE_FILTER_VALID_INVOICE_COPY_TRANSACTIONS",
          "id": "1773330315769",
