        {
          "metadata": {
            "name": "Construct Dispute Invoices Not Found Payload",
            "returnType": "object",
            "sourceCode": "let messageId = $context.$variables.messageId;\nlet disputeData = $context.$nodes.FIN_IEX_LLM_EXTRACT_DISPUTE_INFORMATION.$output;\nlet ERROR_REASON = \"INVOICE_DETAILS_NOT_FOUND\";\n\n// ============================================================\n// ERROR CODE AND MESSAGE MAPPING\n// ============================================================\nlet ERROR_CODE = ERROR_REASON;\nlet ERROR_TEXT = \"\";\n\nlet ERROR_CODE_INVOICE_DETAILS_NOT_FOUND = \"INVOICE_DETAILS_NOT_FOUND\";\n\nERROR_CODE = (ERROR_REASON === \"INVOICE_DETAILS_NOT_FOUND\")\n  ? ERROR_CODE_INVOICE_DETAILS_NOT_FOUND\n  : ERROR_CODE;\n\nERROR_TEXT = (ERROR_REASON === \"INVOICE_DETAILS_NOT_FOUND\")\n  ? \"No invoice details could be extracted from the email. Please review and process this dispute manually.\"\n  : ERROR_TEXT;\n\n// ============================================================\n// CONSTRUCT REJECTED DISPUTE REQUEST\n// ============================================================\nlet rejectedDisputeRequest = {\n  message: {\n    messageId: messageId\n  },\n  requestData: {\n    disputeData: disputeData,\n    summary: {\n      errors: [\n        {\n          errorCode: ERROR_CODE,\n          errorText: ERROR_TEXT\n        }\n      ]\n    }\n  },\n  responseData: {\n    firstRecord: \"Y\"\n  },\n  intent: {\n    lookupType: \"ORA_IEX_MSG_INTENT\",\n    lookupCode: \"ORA_DISPUTE_REQUEST\"\n  },\n  processingStatus: {\n    lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n    lookupCode: \"ORA_ERROR_REVIEW_PENDING\"\n  }\n};\n\nlet requestPayload = [rejectedDisputeRequest];\nreturn requestPayload;"
          },
          "outcomes": {
            "success": "1772296127541"
          },
