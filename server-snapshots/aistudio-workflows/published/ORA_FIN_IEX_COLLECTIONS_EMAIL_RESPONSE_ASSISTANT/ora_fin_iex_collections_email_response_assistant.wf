            {
              "id": "1774449003273_1",
              "name": "condition",
              "type": "string",
              "value": "{{(Array.isArray($context.$nodes.FIN_IEX_CODE_CREATE_SUCCESSFUL_DISPUTE_PAYLOAD.$output.result)?$context.$nodes.FIN_IEX_CODE_CREATE_SUCCESSFUL_DISPUTE_PAYLOAD.$output.result:JSON.parse($context.$nodes.FIN_IEX_CODE_CREATE_SUCCESSFUL_DISPUTE_PAYLOAD.$output.result||\"[]\")).length===0}}"
            }
