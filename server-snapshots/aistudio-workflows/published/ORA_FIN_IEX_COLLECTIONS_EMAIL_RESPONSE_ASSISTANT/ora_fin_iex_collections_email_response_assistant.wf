        {
          "metadata": {
            "name": "Create Category Details Payload",
            "returnType": "string",
            "sourceCode": "const categoryCode = $context.$nodes.FIN_IEX_CODE_DERIVE_CATEGORY_CODE.$output.result;\nconst collectorId = $context.$variables.CollectorId;\n\nconst isReviewPending = categoryCode === \"ORA_REVIEW_PENDING\";\nconst isErrorReviewPending = categoryCode === \"ORA_ERROR_REVIEW_PENDING\";\n\nif (!isReviewPending && !isErrorReviewPending) {\n  return \"\";\n}\n\nconst statusCode = isReviewPending ? \"ORA_REVIEW_PENDING\" : \"ORA_ERROR_REVIEW_PENDING\";\nconst responseFilter = \" AND ccmd.responseData LIKE '%firstRecord%'\";\n\nconst viewQueries = {\n  CollectionsCustomerMsgDetails: {\n    module: \"oraErpCoreAdvancedCollections\",\n    businessObject: \"CollectionsCustomerMessage\",\n    view: \"collectionsCustomerMessageDetails\",\n    fieldAliases: {\n      \"intent.lookupCode\": \"intentCode\",\n      \"customerMessageDetailId\": \"customerMessageDetailId\",\n      \"processingStatus.lookupCode\": \"processingStatusCode\",\n      \"customer.id\": \"partyId\",\n      \"customerAccount.customerAccountId\": \"customerAccountId\",\n      \"accountSitePurpose.siteUseId\": \"siteUseId\",\n      \"emailMessage.messageId\": \"messageId\",\n      \"requestData\": \"requestData\",\n      \"responseData\": \"responseData\",\n      \"customer.name\": \"partyName\",\n      \"customerAccount.accountNumber\": \"accountNumber\",\n      \"accountSitePurpose.site\": \"site\",\n      \"accountSitePurpose.customerAccountSite.customerAccountSiteId\": \"customerAccountSiteId\",\n      \"timeCreated\": \"timeCreated\",\n      \"emailMessage.senderAddress\": \"senderAddress\",\n      \"emailMessage.messageBody\": \"messageBody\",\n      \"emailMessage.subject\": \"subject\",\n      \"intent.meaning\": \"intentMeaning\"\n    }\n  },\n  CustomerBillToAccountSite: {\n    module: \"oraErpCoreCustomerAccountSetup\",\n    businessObject: \"CustomerAccountSite\",\n    view: \"customerBillToAccountSiteList\",\n    fieldAliases: {\n      \"customerAccountSiteId\": \"customerAccountSiteId\",\n      \"customerAccount.customerAccountId\": \"customerAccountId\",\n      \"customerAccount.accountNumber\": \"accountNumber\",\n      \"customerAccount.customer.id\": \"partyId\",\n      \"customerAccount.customer.name\": \"partyName\",\n      \"customerAccount.customer.customerProfile.customerAccountProfileId\": \"partyProfile\",\n      \"customerAccount.customer.customerProfile.effectiveStartDate\": \"partyEffectiveStartDate\",\n      \"customerAccount.customer.customerProfile.effectiveEndDate\": \"partyEffectiveEndDate\",\n      \"customerAccount.customer.customerProfile.collector.collectorId\": \"partyCollectorId\",\n      \"customerAccount.customerAccountProfile.customerAccountProfileId\": \"accountProfile\",\n      \"customerAccount.customerAccountProfile.effectiveStartDate\": \"accountEffectiveStartDate\",\n      \"customerAccount.customerAccountProfile.effectiveEndDate\": \"accountEffectiveEndDate\",\n      \"customerAccount.customerAccountProfile.collector.collectorId\": \"accountCollectorId\",\n      \"billToAccountSitePurpose.siteUseId\": \"siteUseId\",\n      \"billToAccountSitePurpose.customerSiteProfile.customerAccountProfileId\": \"siteProfile\",\n      \"billToAccountSitePurpose.customerSiteProfile.effectiveStartDate\": \"siteEffectiveStartDate\",\n      \"billToAccountSitePurpose.customerSiteProfile.effectiveEndDate\": \"siteEffectiveEndDate\",\n      \"billToAccountSitePurpose.customerSiteProfile.collector.collectorId\": \"siteCollectorId\"\n    }\n  }\n};\n\nconst select = `\nSELECT q.customerMessageDetailId AS customerMessageDetailId, q.messageId AS messageId, q.intentCode AS intentCode, q.processingStatusCode AS processingStatusCode, q.partyName AS partyName, q.accountNumber AS accountNumber, q.site AS site, q.requestData AS requestData, q.timeCreated AS timeCreated, q.subject AS subject, q.intentMeaning AS intentMeaning, q.messageBody AS messageBody, q.senderAddress AS senderAddress\nFROM (\n  SELECT\n    cbas.accountProfile,\n    cbas.siteProfile,\n    ccmd.customerMessageDetailId,\n    ccmd.messageId,\n    ccmd.intentCode,\n    ccmd.processingStatusCode,\n    ccmd.partyName,\n    ccmd.accountNumber,\n    ccmd.site,\n    ccmd.requestData,\n    ccmd.timeCreated,\n    CASE\n      WHEN cbas.siteCollectorId IS NOT NULL AND cbas.siteCollectorId <> 1 THEN\n        CASE\n          WHEN cbas.siteCollectorId = :bindCollectorId\n           AND SYSDATE BETWEEN cbas.siteEffectiveStartDate AND cbas.siteEffectiveEndDate\n          THEN 1\n        END\n      WHEN cbas.accountCollectorId IS NOT NULL AND cbas.accountCollectorId <> 1 THEN\n        CASE\n          WHEN cbas.accountCollectorId = :bindCollectorId\n           AND SYSDATE BETWEEN cbas.accountEffectiveStartDate AND cbas.accountEffectiveEndDate\n          THEN 2\n        END\n      WHEN cbas.partyCollectorId IS NOT NULL AND cbas.partyCollectorId <> 1 THEN\n        CASE\n          WHEN cbas.partyCollectorId = :bindCollectorId\n           AND SYSDATE BETWEEN cbas.partyEffectiveStartDate AND cbas.partyEffectiveEndDate\n          THEN 3\n        END\n    END AS match_level,\n    ccmd.partyId,\n    ccmd.customerAccountId,\n    ccmd.customerAccountSiteId,\n    MAX(ccmd.timeCreated) OVER (\n      PARTITION BY ccmd.partyId, NVL(ccmd.customerAccountId,-1), NVL(ccmd.customerAccountSiteId,-1)\n    ) AS customer_latest_time_created,\n    ccmd.subject,\n    ccmd.intentMeaning,\n    ccmd.messageBody,\n    ccmd.senderAddress\n  FROM CollectionsCustomerMsgDetails ccmd, CustomerBillToAccountSite cbas\n  WHERE ccmd.partyId = cbas.partyId\n    AND ccmd.customerAccountId = cbas.customerAccountId\n    AND ccmd.customerAccountSiteId = cbas.customerAccountSiteId\n    AND ccmd.processingStatusCode = :bindCategoryCode\n    ${responseFilter}\n) q\nWHERE q.match_level IS NOT NULL\nORDER BY q.customer_latest_time_created DESC,\n         q.partyId,\n         NVL(q.customerAccountId,-1),\n         NVL(q.customerAccountSiteId,-1),\n         q.timeCreated DESC,\n         q.customerMessageDetailId DESC\n`.replace(/\\s+/g, \" \").trim();\n\nconst payload = {\n  parameters: {\n    bindCollectorId: collectorId,\n    bindCategoryCode: statusCode\n  },\n  viewQueries,\n  select\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1775394381554"
          },
          "code": "FIN_IEX_CODE_CREATE_CATEGORY_DETAILS_PAYLOAD",
          "id": "1775393904452",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Obtain Partial Valid and Error Records"
          },
          "outcomes": {
            "success": "1775456371264"
          },
          "code": "FIN_IEX_BO_OBTAIN_PARTIAL_VALID_AND_ERROR_RECORDS",
          "id": "1775394381554",
          "inputs": [
            {
              "id": "1775397541465_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_CREATE_CATEGORY_DETAILS_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Partial Valid Error Fields",
            "returnType": "array",
            "sourceCode": "const inputArray = $context.$nodes.FIN_IEX_BO_OBTAIN_PARTIAL_VALID_AND_ERROR_RECORDS.$output;\n\nconst output = (Array.isArray(inputArray) ? inputArray : [inputArray]).flatMap((rec) => {\n  let requestData = rec?.REQUESTDATA;\n  if (typeof requestData === \"string\") {\n    try {\n      requestData = JSON.parse(requestData);\n    } catch {\n      requestData = {};\n    }\n  }\n\n  const common = {\n    messageId: rec?.MESSAGEID ?? null,\n    messageDetailId : rec?.CUSTOMERMESSAGEDETAILID?? null,\n    intentCode: rec?.INTENTCODE ?? null,\n    partyName: rec?.PARTYNAME ?? null,\n    accountNumber: rec?.ACCOUNTNUMBER ?? null,\n    site: rec?.SITE ?? null,\n    subject: rec?.SUBJECT ?? rec?.subject ?? null,\n    intentMeaning: rec?.INTENTMEANING ?? rec?.intentMeaning ?? null,\n    senderAddress: rec?.SENDERADDRESS?? rec?.senderAddress?? null,\n    messageBody: rec?.MESSAGEBODY?? rec?.messageBody?? null\n  };\n\n  const errorsByInvoice = requestData?.summary?.errorsByInvoice;\n  if (!Array.isArray(errorsByInvoice) || errorsByInvoice.length === 0) {\n    return [{ ...common, invoiceNumber: null, errorText: null, errorCode: null }];\n  }\n\n  return errorsByInvoice.flatMap((inv) => {\n    const invoiceNumber = inv?.invoiceNumber ?? null;\n    const errors = Array.isArray(inv?.errors) ? inv.errors : [];\n\n    if (errors.length === 0) {\n      return [{ ...common, invoiceNumber, errorText: null, errorCode: null }];\n    }\n\n    return errors.map((err) => ({\n      ...common,\n      invoiceNumber,\n      errorText: err?.errorText ?? null,\n      errorCode: err?.errorCode ?? null\n    }));\n  });\n});\n\nreturn output;"
          },
          "outcomes": {
            "success": "1775726480434"
          },
          "code": "FIN_IEX_CODE_EXTRACT_PARTIAL_VALID_ERROR_FIELDS",
          "convergenceTargetId": "1775393531155",
          "id": "1775456371264",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
