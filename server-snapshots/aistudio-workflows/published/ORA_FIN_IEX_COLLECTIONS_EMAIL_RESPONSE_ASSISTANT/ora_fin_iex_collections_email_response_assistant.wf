          "code": "FIN_IEX_BO_OBTAIN_PROMISE_DETAILS",
          "id": "1773642084519",
          "inputs": [
            {
              "id": "1774519036694_1",
              "name": "extraction_query_json_object",
              "value": "{{$context.$nodes.FIN_IEX_CODE_CREATE_PROMISE_DETAILS_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Derive Promise Payload",
            "returnType": "string",
            "sourceCode": "const inputData = $context.$nodes.FIN_IEX_BO_OBTAIN_PROMISE_DETAILS.$output;\n\nconst output = inputData.map(item => {\n  const requestData =\n    typeof item.REQUESTDATA === \"string\" ? JSON.parse(item.REQUESTDATA) : item.REQUESTDATA;\n\n  return {\n    id: item.CUSTOMERMESSAGEDETAILID,\n    path: \"/collectionPromises\",\n    operation: \"create\",\n    payload: requestData.actionablePayload\n  };\n});\n\n// Return as a JSON string: `[{\"id\":...},{...},{...}]`\nreturn JSON.stringify(JSON.stringify(output));"
          },
          "outcomes": {
            "success": "1773643560610"
          },
          "code": "FIN_IEX_CODE_DERIVE_PROMISE_PAYLOAD",
          "id": "1772004451698",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
