        {
          "metadata": {
            "name": "Create Payload To Verify Feature And Lookup Enablement",
            "returnType": "string",
            "sourceCode": "const output = [\n  {\n    id: \"AR_STORE_PRINTED_TRANSACTIONS\",\n    path: \"/standardLookups/AR_FEATURES/child/lookupCodes/AR_STORE_PRINTED_TRANSACTIONS\",\n    operation: \"get\"\n  },\n  {\n    id: \"ORA_AR_STORE_PRINT_TRX_AS_ATTACHMENT\",\n    path: \"/features/ORA_AR_STORE_PRINT_TRX_AS_ATTACHMENT\",\n    operation: \"get\"\n  }\n];\n\nreturn JSON.stringify(JSON.stringify(output));"
          },
          "outcomes": {
            "success": "1783335115165"
          },
          "code": "CREATE_PAYLOAD_TO_VERIFY_FEATURE_AND_LOOKUP_ENABLEMENT",
          "id": "1783329044034",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBATCHEXECUTION",
            "functionName": "PerformCollectionBatchAction",
            "name": "Check Store Printed Trx Feature and Lookup Enabled"
          },
          "outcomes": {
            "success": "1783398924697"
          },
          "code": "FIN_IEX_BO_CHECK_STORE_PRINTED_TRX_FEATURE_AND_LOOKUP_ENABLED",
          "id": "1783335115165",
          "inputs": [
            {
              "id": "1783335115165_payload",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.CREATE_PAYLOAD_TO_VERIFY_FEATURE_AND_LOOKUP_ENABLEMENT.$output.result}}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Verify Feature And Lookup Enabled",
            "returnType": "boolean",
            "sourceCode": "const inputData = $context.$nodes.FIN_IEX_BO_CHECK_STORE_PRINTED_TRX_FEATURE_AND_LOOKUP_ENABLED.$output;\n\nconst parts = Array.isArray(inputData.parts)\n  ? inputData.parts\n  : JSON.parse(inputData.parts);\n\nconst lookupEnabled = parts.find(\n  part => part.id === \"AR_STORE_PRINTED_TRANSACTIONS\"\n)?.payload?.EnabledFlag === \"Y\";\n\nconst featureEnabled = parts.find(\n  part => part.id === \"ORA_AR_STORE_PRINT_TRX_AS_ATTACHMENT\"\n)?.payload?.EnabledFlag === \"Y\";\n\nreturn lookupEnabled && featureEnabled;"
          },
          "outcomes": {
            "success": "1773340023875"
          },
          "code": "FIN_IEX_CODE_VERIFY_FEATURE_AND_LOOKUP_ENABLED",
          "id": "1783398924697",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct Invoice Copy Request Payload",
            "returnType": "object",
            "sourceCode": "var messageId = $context.$variables.messageId;\nvar filteredOutput = $context.$nodes.FIN_IEX_CODE_FILTER_VALID_INVOICE_COPY_TRANSACTIONS.$output || {};\nvar filteredResult = filteredOutput.result || {};\nvar originalInvalidTransactions = filteredResult.invalidInvoicesObject || [];\nvar enrichedLoopOutput = $context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_VALID_INVOICE_COPY_REQUEST.$output || [];\n\nvar featureLookupEnabledOutput = $context.$nodes.FIN_IEX_CODE_VERIFY_FEATURE_AND_LOOKUP_ENABLED.$output.result;\nvar isFeatureAndLookupEnabled = featureLookupEnabledOutput === true || featureLookupEnabledOutput === \"true\";\n\n/*\n  Error definitions\n*/\nvar ERROR_CODE_TRX_NOT_VALID = \"EMAIL_AGENT_TRX_NOT_VALID\";\nvar ERROR_TEXT_TRX_NOT_VALID = \"Transaction number {trxNumbers} could not be found.\";\nvar ERROR_CODE_MUL_TRX_FOUND = \"EMAIL_AGENT_MUL_TRX_FOUND\";\nvar ERROR_TEXT_MUL_TRX_FOUND = \"More than one Transaction numbers identified for the given transaction reference {trxNumbers}.\";\nvar ERROR_CODE_INVOICE_NOT_PRINTED = \"EMAIL_AGENT_INV_NOT_PRINTED\";\nvar ERROR_TEXT_INVOICE_NOT_PRINTED = \"The transaction number {trxNumber} is not printed to regenerate.\";\nvar ERROR_CODE_DUPLICATE_REQUEST_EXISTS = \"INVOICE_COPY_DUPLICATE_REQUEST_EXISTS\";\nvar ERROR_TEXT_DUPLICATE_REQUEST_EXISTS = \"There already exists a pending invoice copy request for installment {installmentNumber} of transaction number {trxNumber}.\";\nvar ERROR_CODE_INVOICE_NOT_MARKED_FOR_PRINT = \"INVOICE_NOT_MARKED_FOR_PRINT\";\nvar ERROR_TEXT_INVOICE_NOT_MARKED_FOR_PRINT = \"The transaction number {trxNumber} is not marked for reprint at the profile.\";\nvar ERROR_CODE_FEATURE_LOOKUP_NOT_ENABLED = \"PRINT_TRX_FEATURE_LOOKUP_NOT_ENABLED\";\nvar ERROR_TEXT_FEATURE_LOOKUP_NOT_ENABLED = \"The feature ORA_AR_STORE_PRINT_TRX_AS_ATTACHMENT and lookup AR_STORE_PRINTED_TRANSACTIONS must be enabled to process invoice copy requests.\";\n\n/*\n  Summary holders\n*/\nvar summaryTotalInvoices = 0;\nvar summaryValidInvoiceCount = 0;\nvar summaryInvalidInvoiceCount = 0;\nvar summaryAmountsByCurrency = [];\nvar summaryErrorsByInvoice = [];\n\n/*\n  Working holders\n*/\nvar updatedValidTransactions = [];\nvar responseList = [];\nvar firstValidResponseIndex = -1;\nvar firstErrorResponseIndex = -1;\nvar overallHasValidInstallment = false;\nvar overallHasInvalidInstallment = false;\n\n/*\n  Normalize enriched loop output\n*/\nvar i = 0;\nfor (i = 0; i < enrichedLoopOutput.length; i = i + 1) {\n    var rawItem = enrichedLoopOutput[i];\n    var parsedItem = rawItem;\n    if (typeof rawItem === \"string\") {\n        parsedItem = JSON.parse(rawItem);\n    }\n    var enrichedInvoice = parsedItem.result || parsedItem;\n    updatedValidTransactions.push(enrichedInvoice);\n}\n\n/*\n  Process valid transactions per installment\n*/\nfor (i = 0; i < updatedValidTransactions.length; i = i + 1) {\n    var inv = updatedValidTransactions[i] || {};\n    var installments = inv.installments || [];\n    var transactionLevelErrors = [];\n    var transactionHasError = false;\n    var transactionHasValidInstallment = false;\n\n    summaryTotalInvoices = summaryTotalInvoices + 1;\n\n    var j = 0;\n    for (j = 0; j < installments.length; j = j + 1) {\n        var installment = installments[j] || {};\n        var errors = [];\n        var billTemplateName = installment.BILLTEMPLATENAME;\n        var generateBill = installment.GENERATEBILL;\n        var installmentClass = installment.INSTALLMENTCLASS || \"\";\n        var currencyCode = installment.CURRENCYCODE || inv.invoiceCurrency || \"\";\n        var amountRemaining = installment.AMOUNTREMAINING || null;\n        var ledgerCurrency = installment.LEDGERCURRENCY || \"\";\n        var accountedBalanceDue = installment.ACCOUNTEDBALANCEDUE || null;\n        var duplicateCount = Number(installment.DUPLICATECOUNT || 0);\n        var resolvedDeliveryMethod = installment.SITETRANSACTIONDELIVERYMETHOD || installment.ACCOUNTTRANSACTIONDELIVERYMETHOD || \"PRINT_INV\";\n        var printFlag = resolvedDeliveryMethod === \"EMAIL_INV\" ? \"A\" : \"J\";\n        var dunningMethod = printFlag === \"A\" ? \"EMAIL\" : \"PRINT\";\n\n        if (!isFeatureAndLookupEnabled) {\n            var featureLookupNotEnabledError = {\n                errorCode: ERROR_CODE_FEATURE_LOOKUP_NOT_ENABLED,\n                errorText: ERROR_TEXT_FEATURE_LOOKUP_NOT_ENABLED\n            };\n            errors.push(featureLookupNotEnabledError);\n            transactionLevelErrors.push(featureLookupNotEnabledError);\n            transactionHasError = true;\n        }\n\n        if (duplicateCount > 0) {\n            var duplicateError = {\n                errorCode: ERROR_CODE_DUPLICATE_REQUEST_EXISTS,\n                errorText: ERROR_TEXT_DUPLICATE_REQUEST_EXISTS\n                    .replace(\"{installmentNumber}\", String(installment.INSTALLMENTNUMBER || \"\"))\n                    .replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n            };\n            errors.push(duplicateError);\n            transactionLevelErrors.push(duplicateError);\n            transactionHasError = true;\n        }\n\n        if (billTemplateName === null || billTemplateName === undefined || billTemplateName === \"\") {\n            var printedError = {\n                errorCode: ERROR_CODE_INVOICE_NOT_PRINTED,\n                errorText: ERROR_TEXT_INVOICE_NOT_PRINTED.replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n            };\n            errors.push(printedError);\n            transactionLevelErrors.push(printedError);\n            transactionHasError = true;\n        }\n\n        if (generateBill !== \"PRI\" || (resolvedDeliveryMethod !== \"PRINT_INV\" && resolvedDeliveryMethod !== \"EMAIL_INV\")) {\n            var profilePrintError = {\n                errorCode: ERROR_CODE_INVOICE_NOT_MARKED_FOR_PRINT,\n                errorText: ERROR_TEXT_INVOICE_NOT_MARKED_FOR_PRINT.replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n            };\n            errors.push(profilePrintError);\n            transactionLevelErrors.push(profilePrintError);\n            transactionHasError = true;\n        }\n\n        var foundCurrency = false;\n        var c = 0;\n        for (c = 0; c < summaryAmountsByCurrency.length; c = c + 1) {\n            if (summaryAmountsByCurrency[c].currencyCode === currencyCode && summaryAmountsByCurrency[c].ledgerCurrency === ledgerCurrency) {\n                summaryAmountsByCurrency[c].transactionAmountRemaining = summaryAmountsByCurrency[c].transactionAmountRemaining + (amountRemaining || 0);\n                summaryAmountsByCurrency[c].ledgerAmount = summaryAmountsByCurrency[c].ledgerAmount + (accountedBalanceDue || 0);\n                foundCurrency = true;\n            }\n        }\n        if (!foundCurrency) {\n            summaryAmountsByCurrency.push({\n                currencyCode: currencyCode,\n                ledgerCurrency: ledgerCurrency,\n                transactionAmountRemaining: amountRemaining || 0,\n                ledgerAmount: accountedBalanceDue || 0\n            });\n        }\n\n        var bipInvoiceTemplate = installmentClass === \"INV\" ? (billTemplateName || \"#NULL\") : \"Default Invoice Template\";\n        var bipCreditMemoTemplate = installmentClass === \"CM\" ? (billTemplateName || \"#NULL\") : \"Default Credit Memo Template\";\n        var bipDebitMemoTemplate = installmentClass === \"DM\" ? (billTemplateName || \"#NULL\") : \"Default Debit Memo Template\";\n        var bipChargebackTemplate = installmentClass === \"CB\" ? (billTemplateName || \"#NULL\") : \"Default Chargeback Template\";\n\n        var essParametersArr = [\n            installment.BUSINESSUNITID || \"#NULL\",\n            \"#NULL\",\n            \"ANY\",\n            \"TRX_NUMBER\",\n            \"#NULL\",\n            \"#NULL\",\n            installment.CUSTOMERTRANSACTIONTYPESEQUENCEID || \"#NULL\",\n            \"#NULL\",\n            installment.PARTYNAME || \"#NULL\",\n            installment.PARTYNAME || \"#NULL\",\n            installment.ACCOUNTNUMBER || \"#NULL\",\n            installment.ACCOUNTNUMBER || \"#NULL\",\n            installment.TRANSACTIONNUMBER || \"#NULL\",\n            installment.TRANSACTIONNUMBER || \"#NULL\",\n            installment.INSTALLMENTNUMBER || \"#NULL\",\n            \"#NULL\",\n            \"#NULL\",\n            \"Y\",\n            \"#NULL\",\n            \"#NULL\",\n            \"#NULL\",\n            \"#NULL\",\n            \"#NULL\",\n            bipInvoiceTemplate,\n            bipCreditMemoTemplate,\n            bipDebitMemoTemplate,\n            bipChargebackTemplate,\n            \"N\",\n            \"#NULL\",\n            \"-1\",\n            \"#NULL\"\n        ];\n\n        var customerTrxId = inv.customerTransactionId || installment.CUSTOMERTRANSACTIONID || \"\";\n        var paymentScheduleId = installment.PAYMENTSCHEDULEID || \"\";\n\n        var invoiceCopyInstallments = [];\n\n        if (paymentScheduleId !== null && paymentScheduleId !== undefined && String(paymentScheduleId).trim() !== \"\") {\n            invoiceCopyInstallments.push({\n                InstallmentId: String(paymentScheduleId)\n            });\n        }\n\n        var actionablePayload = {\n            resend: {\n                installments: invoiceCopyInstallments\n            }\n        };\n\n        var reqDataObj = {\n            invoiceCopyExtractedInvoiceDetails: inv,\n            actionablePayload: actionablePayload,\n            transactionAmountRemaining: amountRemaining,\n            invoiceCurrency: currencyCode,\n            ledgerCurrency: ledgerCurrency,\n            ledgerAmount: accountedBalanceDue,\n            duplicateCount: duplicateCount,\n            accountTransactionDeliveryMethod: installment.ACCOUNTTRANSACTIONDELIVERYMETHOD || null,\n            siteTransactionDeliveryMethod: installment.SITETRANSACTIONDELIVERYMETHOD || null,\n            generateBill: generateBill || null,\n            resolvedTransactionDeliveryMethod: resolvedDeliveryMethod,\n            printFlag: printFlag\n        };\n\n        if (errors.length > 0) {\n            reqDataObj.errors = errors;\n        }\n\n        var currentProcessingStatus = errors.length > 0\n            ? { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n            : { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ACTION_PENDING\" };\n\n        responseList.push({\n            customer: { id: installment.PARTYID || \"\" },\n            customerAccount: { customerAccountId: installment.CUSTOMERACCOUNTID || \"\" },\n            customerSiteUse: { SITEUSEID: installment.SITEUSEID || \"\" },\n            customerTransaction: { customerTransactionId: inv.customerTransactionId || \"\" },\n            paymentSchedule: { paymentScheduleId: installment.PAYMENTSCHEDULEID || \"\" },\n            businessUnit: { id: installment.BUSINESSUNITID || \"\" },\n            message: { messageId: messageId },\n            requestData: reqDataObj,\n            responseData: null,\n            intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_INVOICE_REPRINT\" },\n            processingStatus: currentProcessingStatus\n        });\n\n        if (errors.length > 0) {\n            overallHasInvalidInstallment = true;\n            if (firstErrorResponseIndex === -1) {\n                firstErrorResponseIndex = responseList.length - 1;\n            }\n        } else {\n            overallHasValidInstallment = true;\n            transactionHasValidInstallment = true;\n            if (firstValidResponseIndex === -1) {\n                firstValidResponseIndex = responseList.length - 1;\n            }\n        }\n    }\n\n    if (transactionHasError) {\n        summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n        summaryErrorsByInvoice.push({\n            invoiceNumber: inv.invoiceNumber || \"\",\n            errors: transactionLevelErrors\n        });\n    }\n\n    if (transactionHasValidInstallment) {\n        summaryValidInvoiceCount = summaryValidInvoiceCount + 1;\n    }\n}\n\n/*\n  Process invalid transactions\n*/\nfor (i = 0; i < originalInvalidTransactions.length; i = i + 1) {\n    var invalidInv = originalInvalidTransactions[i] || {};\n    var trxRef = invalidInv.invoiceNumber || invalidInv.customerTransactionId || \"\";\n    var invalidErrorObj = null;\n\n    summaryTotalInvoices = summaryTotalInvoices + 1;\n    summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n    overallHasInvalidInstallment = true;\n\n    if (invalidInv.TransactionStatus === \"INVOICE_NOT_FOUND\") {\n        invalidErrorObj = {\n            errorCode: ERROR_CODE_TRX_NOT_VALID,\n            errorText: ERROR_TEXT_TRX_NOT_VALID.replace(\"{trxNumbers}\", trxRef)\n        };\n    } else if (invalidInv.TransactionStatus === \"MULTIPLE_INVOICES_FOUND\") {\n        invalidErrorObj = {\n            errorCode: ERROR_CODE_MUL_TRX_FOUND,\n            errorText: ERROR_TEXT_MUL_TRX_FOUND.replace(\"{trxNumbers}\", trxRef)\n        };\n    }\n\n    if (invalidErrorObj) {\n        summaryErrorsByInvoice.push({\n            invoiceNumber: invalidInv.invoiceNumber || \"\",\n            errors: [invalidErrorObj]\n        });\n    }\n\n    responseList.push({\n        customer: {},\n        customerAccount: {},\n        customerSiteUse: {},\n        customerTransaction: {},\n        paymentSchedule: {},\n        businessUnit: {},\n        message: { messageId: messageId },\n        requestData: {\n            invoiceCopyExtractedInvoiceDetails: invalidInv,\n            errors: invalidErrorObj ? [invalidErrorObj] : []\n        },\n        responseData: null,\n        intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_INVOICE_REPRINT\" },\n        processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n    });\n\n    if (firstErrorResponseIndex === -1) {\n        firstErrorResponseIndex = responseList.length - 1;\n    }\n}\n\n/*\n  Attach summary\n  Global rule across all installments of all transactions:\n  - if any valid row exists -> firstRecord goes to first valid row\n  - else goes to first error row\n*/\nvar summaryIndex = -1;\n\nif (firstValidResponseIndex !== -1) {\n    summaryIndex = firstValidResponseIndex;\n} else if (firstErrorResponseIndex !== -1) {\n    summaryIndex = firstErrorResponseIndex;\n} else if (responseList.length > 0) {\n    summaryIndex = 0;\n}\n\nif (summaryIndex !== -1 && responseList.length > 0) {\n    responseList[summaryIndex].requestData.summary = {\n        totalInvoices: summaryTotalInvoices,\n        validInvoiceCount: summaryValidInvoiceCount,\n        invalidInvoiceCount: summaryInvalidInvoiceCount,\n        amountsByCurrency: summaryAmountsByCurrency,\n        errorsByInvoice: summaryErrorsByInvoice,\n        validTransactions: updatedValidTransactions\n    };\n    responseList[summaryIndex].responseData = { firstRecord: \"Y\" };\n\n    if (overallHasValidInstallment && overallHasInvalidInstallment) {\n        var r = 0;\n        for (r = 0; r < responseList.length; r = r + 1) {\n            if (responseList[r].processingStatus && responseList[r].processingStatus.lookupCode === \"ORA_ACTION_PENDING\") {\n                responseList[r].processingStatus = {\n                    lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n                    lookupCode: \"ORA_REVIEW_PENDING\"\n                };\n            }\n        }\n    } else if (!overallHasValidInstallment && overallHasInvalidInstallment) {\n        responseList[summaryIndex].processingStatus = {\n            lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n            lookupCode: \"ORA_ERROR_REVIEW_PENDING\"\n        };\n    }\n}\n\nvar s = 0;\nfor (s = 0; s < responseList.length; s = s + 1) {\n    responseList[s].processingStatus = {\n        lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n        lookupCode: \"ORA_MANUAL_PROCESSED\"\n    };\n}\n\nvar result = responseList;\nreturn result;"
          },
          "outcomes": {
            "success": "1773515733074"
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_INVOICE_COPY_REQUEST_PAYLOAD",
          "id": "1773340023875",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "PO Update Intent Classification"
          },
          "outcomes": {
            "ACTION_NEW": "1773595095705",
            "default": "1774434471672"
          },
          "code": "FIN_IEX_SWITCH_PO_UPDATE_INTENT_CLASSIFICATION",
          "convergenceTargetId": "1774434471672",
          "id": "1773593944618",
          "inputs": [
            {
              "id": "1773593944619_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.currentProcessingIntent.subIntent}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Extract Purchase Order Update Details"
          },
          "outcomes": {
            "success": "1773595684626"
          },
          "code": "FIN_IEX_LLM_EXTRACT_PURCHASE_ORDER_UPDATE_DETAILS",
          "id": "1773595095705",
          "inputs": [
            {
              "id": "1773595095708_1",
              "name": "prompt",
              "type": "string",
              "value": "# PO Update Extraction Agent - Enterprise Version\n\n## 1. Functional Role\nYou are a structured data extraction agent operating within a finance or collections workflow.\n\nYour responsibility is to:\n- Format and analyze customer email conversations similar to Outlook-style threads.\n- Identify explicit PO update requests raised by the customer.\n- Extract structured PO update request details at header and request-item level.\n- Return strictly formatted JSON output.\n\nYou must:\n- Extract only explicit PO update requests.\n- Not infer missing data unless it can be reliably sourced from the preceding email thread.\n- Not execute external actions.\n- Not modify input data.\n- Not generate explanations or commentary outside JSON.\n\n---\n\n## 2. Input Specification\nYou will receive one input JSON object: `{{$context.$variables.email}}`\n\nSchema:\n```json\n{\n  \"from\": \"string\",\n  \"to\": [\"string\"],\n  \"cc\": [\"string\"],\n  \"subject\": \"string\",\n  \"content\": \"string\",\n  \"headers\": {},\n  \"attachments\": [\n    {\n      \"fileName\": \"string\",\n      \"mimeType\": \"string\",\n      \"context\": \"string\"\n    }\n  ]\n}\n```\n\n### Processing Scope\nAnalyze:\n- `subject`\n- `content`\n- `attachments.context`\n\nRules:\n- Consider the most recent customer reply as primary intent source.\n- Ignore quoted historical emails unless reaffirmed in latest customer reply.\n- If key identifiers are not in latest reply, retrieve from earlier thread context when clearly available.\n- Customer fields (`customerName`, `customerAccountNumber`, `location`) are best-effort from full thread.\n\n---\n\n## 3. Core Processing Instructions\n1. Identify explicit PO update request language.\n2. Extract only invoice/transaction references explicitly tied to updating, adding, correcting, or reflecting the purchase order on the invoice.\n3. Ignore invoices or transactions that are mentioned without PO update intent.\n4. Normalize dates when reasonably determinable (Section 9 rules).\n5. Populate all fields as per Section 7 rules.\n6. For each identified request, populate one invoice object.\n7. If no explicit PO update request exists, return the empty structure in Section 12.\n\n---\n\n## 4. Explicit PO Update Request Detection Rules\nA PO update request is explicit when the customer clearly asks to update, add, correct, revise, or reflect a purchase order number on an invoice and typically requests the invoice copy to be resent after that correction.\n\nTreat the following as valid PO-update request references when used in this intent:\n- invoice number\n- transaction number\n- debit memo number\n- credit memo number\n- chargeback number\n\nIf the customer refers to any of the above document numbers, populate them in:\n- `invoiceNumber`\n\nThis field is the common transaction-number field for PO update extraction, even when the actual transaction is a debit memo, credit memo, or chargeback.\n\nDo not create separate fields for debit memo, credit memo, or chargeback number.\n\nExamples of valid PO update scenarios include:\n- the invoice was rejected in a payables processing system because the PO is missing or incorrect\n- the payables team manually created the request, encountered a system failure, and asks for PO correction on the invoice\n- the customer explicitly asks to update the PO number on the invoice and resend the invoice copy\n\n---\n\n## 5. Identifier Extraction Rules\nExtract when explicitly present in latest reply or recoverable from thread:\n- `invoiceNumber`\n- `purchaseOrderNumber`\n- `purchaseOrderNumberToUpdate`\n- `salesOrderNumber`\n- `waybillNumber`\n- `contractNumber`\n- `transactionSource`\n- `transactionType`\n- `invoiceCurrency`\n- `transactionAmount`\n\n### Primary Identifier Population Rules\nPopulate supported specific identifier fields whenever the identifier clearly belongs to one of the known search fields:\n- invoice number  `invoiceNumber`\n- transaction number  `invoiceNumber`\n- debit memo number  `invoiceNumber`\n- credit memo number  `invoiceNumber`\n- chargeback number  `invoiceNumber`\n- existing purchase order reference  `purchaseOrderNumber`\n- purchase order to be newly added / corrected / updated on invoice  `purchaseOrderNumberToUpdate`\n- sales order  `salesOrderNumber`\n- waybill  `waybillNumber`\n- contract  `contractNumber`\n\n### Important Normalization Rule\nEven if the customer explicitly says:\n- \"transaction number\"\n- \"debit memo\"\n- \"credit memo\"\n- \"chargeback\"\n\nstore that document reference in:\n- `invoiceNumber`\n\nDo not populate `transactionIdentifier` for these known transaction-document references.\n\n### PO Update Interpretation Rule\n- If the email clearly identifies the PO number that should be added, corrected, reflected, or updated on the invoice, populate that value in `purchaseOrderNumberToUpdate`.\n- If the email also mentions an existing or incorrect PO already associated with the invoice, populate that value in `purchaseOrderNumber`.\n- If only one PO value is present and the context clearly indicates it is the new/corrected PO to apply, use `purchaseOrderNumberToUpdate`.\n\n### Fallback Identifier Rules\nPopulate `transactionIdentifierType` and `transactionIdentifier` only when **all** of the following are missing:\n- `invoiceNumber`\n- `purchaseOrderNumber`\n- `purchaseOrderNumberToUpdate`\n- `salesOrderNumber`\n- `waybillNumber`\n- `contractNumber`\n\nWhen fallback is used:\n- `transactionIdentifierType` should reflect the identifier category available in text.\n- `transactionIdentifier` must contain the exact corresponding identifier value.\n\nIf any supported specific identifier field is populated, always return:\n- `transactionIdentifierType = \"\"`\n- `transactionIdentifier = \"\"`\n\nDo not duplicate invoice number, transaction number, debit memo number, credit memo number, chargeback number, or any other supported identifier into `transactionIdentifier`.\n\n---\n\n## 6. Field Population Rules\n- Use `\"\"` for missing text fields.\n- Use `null` for missing numeric fields.\n- Always return full JSON structure.\n- Do not omit fields.\n- `customerRequestComments` must preserve customer wording and remain under 1500 characters.\n- `requestNeedsReview`:\n  - `\"Y\"` if request intent is ambiguous or key identifiers cannot be recovered.\n  - `\"N\"` otherwise.\n\n---\n\n## 7. JSON Output Format (Strict)\nReturn only valid JSON matching exactly:\n\n```json\n{\n  \"poUpdate\": {\n    \"invoices\": [\n      {\n        \"customerName\": \"\",\n        \"customerAccountNumber\": \"\",\n        \"location\": \"\",\n        \"invoiceNumber\": \"\",\n        \"contractNumber\": \"\",\n        \"waybillNumber\": \"\",\n        \"purchaseOrderNumber\": \"\",\n        \"purchaseOrderNumberToUpdate\": \"\",\n        \"salesOrderNumber\": \"\",\n        \"transactionIdentifier\": \"\",\n        \"transactionIdentifierType\": \"\",\n        \"transactionSource\": \"\",\n        \"transactionType\": \"\",\n        \"transactionAmount\": null,\n        \"invoiceDate\": \"\",\n        \"invoiceAmount\": null,\n        \"invoiceCurrency\": \"\",\n        \"outstandingAmount\": null,\n        \"dueDate\": \"\",\n        \"confidenceScore\": null,\n        \"customerRequestComments\": null,\n        \"requestNeedsReview\": \"\",\n        \"otherIdentifier\": {}\n      }\n    ]\n  }\n}\n```\n\n---\n\n## 8. Field Definitions\n- `customerName`: Customer name from latest reply or thread\n- `customerAccountNumber`: Account number/reference from thread\n- `location`: Customer site/city/location if available\n- `invoiceNumber`: Primary transaction-document number field. Use this for invoice number, transaction number, debit memo number, credit memo number, or chargeback number.\n- `contractNumber`: Contract reference if available\n- `waybillNumber`: Waybill/tracking number if available\n- `purchaseOrderNumber`: Existing, prior, or currently referenced PO number if available\n- `purchaseOrderNumberToUpdate`: The PO number that should be added, updated, corrected, or reflected on the invoice\n- `salesOrderNumber`: SO number if available\n- `transactionIdentifier`: Fallback primary identifier value only when none of the supported known search identifiers are present\n- `transactionIdentifierType`: Fallback identifier type only when none of the supported known search identifiers are present\n- `transactionSource`: Transaction source name/type if present\n- `transactionType`: Transaction type if present\n- `transactionAmount`: Transaction amount if present\n- `invoiceDate`: Invoice date from latest reply or thread\n- `invoiceAmount`: Invoice amount from latest reply or thread\n- `invoiceCurrency`: Invoice/transaction currency from latest reply or thread\n- `outstandingAmount`: Outstanding amount from latest reply or thread\n- `dueDate`: Due date from latest reply or thread\n- `customerRequestComments`: Customers wording for the request\n- `confidenceScore`: Numeric confidence per request or `null`\n- `requestNeedsReview`: `\"Y\"` or `\"N\"`\n- `otherIdentifier`: Any additional identifiers as key-value object\n\n---\n\n## 9. Date Normalization Rules\n- Convert clear date references to `YYYY-MM-DD` when reasonably determinable.\n- If ambiguous, preserve original phrase.\n- If no date/period reference exists, return `\"\"`.\n\nSystem date reference: `{{$context.$system.$currentDateTime}}`\n\n---\n\n## 10. Edge Case Handling\n1. Missing invoice number: recover from thread if clear; else keep `\"\"`.\n2. Multiple invoices/transactions in one email: return one invoice object per explicit invoice/transaction reference.\n3. If the email includes both an incorrect old PO and a corrected new PO, populate both `purchaseOrderNumber` and `purchaseOrderNumberToUpdate`.\n4. If only the corrected PO is available, populate `purchaseOrderNumberToUpdate` and leave `purchaseOrderNumber` empty.\n5. Ambiguous request text (e.g., \"update document\"): do not assume PO update unless context is explicit.\n6. High-noise threads: use latest customer reply for intent; use earlier thread only for identifiers.\n7. If no supported identifier is found and no usable period information is identified, return an empty invoices array.\n\n---\n\n## 11. Guardrails\n- Do not infer invoice numbers, transaction numbers, debit memo numbers, credit memo numbers, chargeback numbers, or other identifiers not present in thread.\n- Do not extract disputes or payment promises in this prompt.\n- Do not expose reasoning or chain-of-thought.\n- Do not add commentary outside JSON.\n- Do not populate `transactionIdentifier` when the value clearly belongs to one of the supported known identifier fields.\n- Do not treat a resend instruction by itself as sufficient for PO update unless the PO correction intent is explicit.\n\n---\n\n## 12. Error Handling\nReturn an empty invoices array when any of the following is true:\n- No explicit PO update request is found.\n- A PO update request is found but no supported identifier is present and no usable period information is identified.\n\nReturn:\n\n```json\n{\n  \"poUpdate\": {\n    \"invoices\": []\n  }\n}\n```\n\n---\n\n## 13. Validation Requirements\nBefore returning output:\n- Ensure JSON is valid and exactly matches Section 7 structure.\n- Ensure all numeric fields are numeric or `null`.\n- Ensure one invoice object per explicitly requested invoice/transaction reference.\n- Ensure `invoiceNumber` is used for invoice number, transaction number, debit memo number, credit memo number, and chargeback number.\n- Ensure `purchaseOrderNumberToUpdate` is populated when the email clearly specifies the PO number to be updated on the invoice.\n- Ensure `transactionIdentifier` and `transactionIdentifierType` are populated only as fallback fields.\n- Ensure they are blank when any supported identifier field is populated.\n- Ensure `invoices` is empty when neither identifiers nor usable period information are identified.\n- Ensure no prose appears outside JSON."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"POUpdateExtraction\",\n  \"type\": \"object\",\n  \"required\": [\"poUpdate\"],\n  \"properties\": {\n    \"poUpdate\": {\n      \"type\": \"object\",\n      \"required\": [\"invoices\"],\n      \"properties\": {\n        \"invoices\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"customerName\",\n              \"customerAccountNumber\",\n              \"location\",\n              \"invoiceNumber\",\n              \"contractNumber\",\n              \"waybillNumber\",\n              \"purchaseOrderNumber\",\n              \"purchaseOrderNumberToUpdate\",\n              \"salesOrderNumber\",\n              \"transactionIdentifier\",\n              \"transactionIdentifierType\",\n              \"transactionSource\",\n              \"transactionType\",\n              \"periodFrom\",\n              \"periodTo\",\n              \"transactionAmount\",\n              \"invoiceDate\",\n              \"invoiceAmount\",\n              \"invoiceCurrency\",\n              \"outstandingAmount\",\n              \"dueDate\",\n              \"confidenceScore\",\n              \"customerRequestComments\",\n              \"requestNeedsReview\",\n              \"otherIdentifier\"\n            ],\n            \"properties\": {\n              \"customerName\": { \"type\": \"string\" },\n              \"customerAccountNumber\": { \"type\": \"string\" },\n              \"location\": { \"type\": \"string\" },\n              \"invoiceNumber\": { \"type\": \"string\" },\n              \"contractNumber\": { \"type\": \"string\" },\n              \"waybillNumber\": { \"type\": \"string\" },\n              \"purchaseOrderNumber\": { \"type\": \"string\" },\n              \"purchaseOrderNumberToUpdate\": { \"type\": \"string\" },\n              \"salesOrderNumber\": { \"type\": \"string\" },\n              \"transactionIdentifier\": { \"type\": \"string\" },\n              \"transactionIdentifierType\": { \"type\": \"string\" },\n              \"transactionSource\": { \"type\": \"string\" },\n              \"transactionType\": { \"type\": \"string\" },\n              \"periodFrom\": { \"type\": \"string\" },\n              \"periodTo\": { \"type\": \"string\" },\n              \"transactionAmount\": { \"type\": [\"number\", \"null\"] },\n              \"invoiceDate\": { \"type\": \"string\" },\n              \"invoiceAmount\": { \"type\": [\"number\", \"null\"] },\n              \"invoiceCurrency\": { \"type\": \"string\" },\n              \"outstandingAmount\": { \"type\": [\"number\", \"null\"] },\n              \"dueDate\": { \"type\": \"string\" },\n              \"confidenceScore\": { \"type\": [\"number\", \"null\"] },\n              \"customerRequestComments\": { \"type\": [\"string\", \"null\"] },\n              \"requestNeedsReview\": { \"type\": \"string\", \"enum\": [\"Y\", \"N\", \"\"] },\n              \"otherIdentifier\": { \"type\": \"object\" }\n            },\n            \"additionalProperties\": false\n          }\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"additionalProperties\": false\n}",
          "type": "LLM"
