        {
          "metadata": {
            "name": "Obtain Intent",
            "returnType": "string",
            "sourceCode": "const intentArray = Array.isArray($context.$variables.IntentArray)\n  ? $context.$variables.IntentArray\n  : [];\n\nif (intentArray.length === 0) {\n  return \"ORA_UNSUPPORTED\";\n}\n\nconst intent = intentArray[0];\n \nconst supportedMap = {\n  Promise: \"ORA_PROMISE_TO_PAY\",\n  Dispute: \"ORA_DISPUTE_REQUEST\",\n  InvoiceCopy: \"ORA_INVOICE_REPRINT\",\n  POUpdate: \"ORA_PO_UPDATE\"\n};\n\nconst code = supportedMap[intent];\n\nreturn code;"
          },
          "outcomes": {
            "success": "1773379601179"
          },
          "code": "FIN_IEX_CODE_OBTAIN_INTENT",
          "id": "1773379122626",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Create Intent Details Payload",
            "returnType": "string",
            "sourceCode": "const intentCode = $context.$nodes.FIN_IEX_CODE_OBTAIN_INTENT.$output.result;\nconst categoryCode = $context.$nodes.FIN_IEX_CODE_DERIVE_CATEGORY_CODE.$output.result;\nconst collectorId = $context.$variables.CollectorId;\n\n// Bind value requested:\n// ORA_PROMISE_TO_PAY -> apply firstRecord filter\n// others -> bypass filter using '1==1'\nconst responseDataFilter =\n  (intentCode === \"ORA_PROMISE_TO_PAY\" || intentCode === \"ORA_INVOICE_REPRINT\")\n    ? \"%firstRecord%\"\n    : \"1==1\";\n\nconst payload = {\n  parameters: {\n    bindCollectorId: collectorId,\n    bindCategoryCode: categoryCode,\n    bindResponseDataFilter: responseDataFilter,\n    bindIntentCode : intentCode\n  },\n  viewQueries: {\n    CollectionsCustomerMsgDetails: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CollectionsCustomerMessage\",\n      view: \"collectionsCustomerMessageDetails\",\n      fieldAliases: {\n        \"intent.lookupCode\": \"intentCode\",\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"customer.id\": \"partyId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"customer.name\": \"partyName\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"accountSitePurpose.site\": \"site\",\n        \"accountSitePurpose.customerAccountSite.customerAccountSiteId\":\n          \"customerAccountSiteId\",\n        \"timeCreated\": \"timeCreated\"\n      }\n    },\n    CustomerBillToAccountSite: {\n      module: \"oraErpCoreCustomerAccountSetup\",\n      businessObject: \"CustomerAccountSite\",\n      view: \"customerBillToAccountSiteList\",\n      fieldAliases: {\n        \"customerAccountSiteId\": \"customerAccountSiteId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.id\": \"partyId\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.customer.customerProfile.customerAccountProfileId\":\n          \"partyProfile\",\n        \"customerAccount.customer.customerProfile.effectiveStartDate\":\n          \"partyEffectiveStartDate\",\n        \"customerAccount.customer.customerProfile.effectiveEndDate\":\n          \"partyEffectiveEndDate\",\n        \"customerAccount.customer.customerProfile.collector.collectorId\":\n          \"partyCollectorId\",\n        \"customerAccount.customerAccountProfile.customerAccountProfileId\":\n          \"accountProfile\",\n        \"customerAccount.customerAccountProfile.effectiveStartDate\":\n          \"accountEffectiveStartDate\",\n        \"customerAccount.customerAccountProfile.effectiveEndDate\":\n          \"accountEffectiveEndDate\",\n        \"customerAccount.customerAccountProfile.collector.collectorId\":\n          \"accountCollectorId\",\n        \"billToAccountSitePurpose.siteUseId\": \"siteUseId\",\n        \"billToAccountSitePurpose.customerSiteProfile.customerAccountProfileId\":\n          \"siteProfile\",\n        \"billToAccountSitePurpose.customerSiteProfile.effectiveStartDate\":\n          \"siteEffectiveStartDate\",\n        \"billToAccountSitePurpose.customerSiteProfile.effectiveEndDate\":\n          \"siteEffectiveEndDate\",\n        \"billToAccountSitePurpose.customerSiteProfile.collector.collectorId\":\n          \"siteCollectorId\"\n      }\n    }\n  },\n  select:\n    \"SELECT q.customerMessageDetailId, q.messageId, q.intentCode, q.processingStatusCode, q.partyName, q.accountNumber, q.site, q.requestData, q.timeCreated \" +\n    \"FROM ( \" +\n    \"SELECT cbas.accountProfile, cbas.siteProfile, ccmd.customerMessageDetailId, ccmd.messageId, ccmd.intentCode, ccmd.processingStatusCode, ccmd.partyName, ccmd.accountNumber, ccmd.site, ccmd.requestData, ccmd.timeCreated, \" +\n    \"CASE \" +\n    \"WHEN cbas.siteCollectorId IS NOT NULL AND cbas.siteCollectorId <> 1 THEN CASE WHEN cbas.siteCollectorId = :bindCollectorId AND SYSDATE BETWEEN cbas.siteEffectiveStartDate AND cbas.siteEffectiveEndDate THEN 1 END \" +\n    \"WHEN cbas.accountCollectorId IS NOT NULL AND cbas.accountCollectorId <> 1 THEN CASE WHEN cbas.accountCollectorId = :bindCollectorId AND SYSDATE BETWEEN cbas.accountEffectiveStartDate AND cbas.accountEffectiveEndDate THEN 2 END \" +\n    \"WHEN cbas.partyCollectorId IS NOT NULL AND cbas.partyCollectorId <> 1 THEN CASE WHEN cbas.partyCollectorId = :bindCollectorId AND SYSDATE BETWEEN cbas.partyEffectiveStartDate AND cbas.partyEffectiveEndDate THEN 3 END \" +\n    \"END AS match_level, \" +\n    \"ccmd.partyId, ccmd.customerAccountId, ccmd.customerAccountSiteId, \" +\n    \"MAX(ccmd.timeCreated) OVER (PARTITION BY ccmd.partyId, NVL(ccmd.customerAccountId,-1), NVL(ccmd.customerAccountSiteId,-1)) AS customer_latest_time_created \" +\n    \"FROM CollectionsCustomerMsgDetails ccmd, CustomerBillToAccountSite cbas \" +\n    \"WHERE ccmd.partyId = cbas.partyId \" +\n    \"AND ccmd.customerAccountId = cbas.customerAccountId \" +\n    \"AND ccmd.customerAccountSiteId = cbas.customerAccountSiteId \" +\n    \"AND ccmd.intentCode = :bindIntentCode \" +\n    \"AND ccmd.processingStatusCode = :bindCategoryCode \" +\n    \"AND ( :bindResponseDataFilter = '1==1' OR ccmd.responseData LIKE :bindResponseDataFilter ) \" +\n    \") q \" +\n    \"WHERE q.match_level IS NOT NULL \" +\n    \"ORDER BY q.customer_latest_time_created DESC, q.partyId, NVL(q.customerAccountId,-1), NVL(q.customerAccountSiteId,-1), q.timeCreated DESC, q.customerMessageDetailId DESC\"\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1772364144823"
          },
          "code": "FIN_IEX_CODE_CREATE_INTENT_DETAILS_PAYLOAD",
          "id": "1773379601179",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
