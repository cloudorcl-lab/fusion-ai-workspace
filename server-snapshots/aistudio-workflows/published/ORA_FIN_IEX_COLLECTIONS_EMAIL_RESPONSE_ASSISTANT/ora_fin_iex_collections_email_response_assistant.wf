                {
                  "metadata": {
                    "name": "Construct Dispute Transaction Query",
                    "returnType": "object",
                    "sourceCode": "// Test data retained as per instruction\nvar current = $context.$nodes.FIN_IEX_LOOP_ITERATE_EXTRACTED_DISPUTE_TRANSACTIONS.$currentItem;\n\n// Initialize for parameterized filtering\nvar parameters = {};\nvar filterClause = \" WHERE 1=1\";\nif (current.customerAccountNumber) {\n  parameters.bindAccountNumber = current.customerAccountNumber;\n  filterClause += \" AND ACCOUNTNUMBER = :bindAccountNumber\";\n}\nif (current.invoiceNumber) {\n  parameters.bindTransactionNumber = current.invoiceNumber;\n  filterClause += \" AND TRANSACTIONNUMBER = :bindTransactionNumber\";\n}\nelse if (current.purchaseOrderNumber) {\n  parameters.bindPurchaseOrderNumber = current.purchaseOrderNumber;\n  filterClause += \" AND PURCHASEORDERNUMBER = :bindPurchaseOrderNumber\";\n}\nelse if (current.contractNumber) {\n  parameters.bindCustomerTransactionReference = current.contractNumber;\n  filterClause += \" AND CUSTOMERTRANSACTIONREFERENCE = :bindCustomerTransactionReference\";\n}\nelse if (current.waybillNumber) {\n  parameters.bindWaybillNumber = current.waybillNumber;\n  filterClause += \" AND WAYBILLNUMBER = :bindWaybillNumber\";\n}\nif (current.invoiceDate) {\n  parameters.bindTransactionDate = current.invoiceDate;\n  filterClause += \" AND to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') = :bindTransactionDate\";\n}\nif (\n  current.invoiceAmount !== null &&\n  current.invoiceAmount !== undefined &&\n  current.invoiceAmount !== \"\"\n) {\n  parameters.bindOriginalAmount = current.invoiceAmount;\n  filterClause += \" AND ORIGINALAMOUNT = :bindOriginalAmount\";\n}\n\nvar result = {\n  \"parameters\": parameters,\n  \"viewQueries\": {\n    \"receivablesPaymentSchedule\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n      \"view\": \"receivablesPaymentSchedule\",\n      \"fieldAliases\": {\n        \"paymentScheduleId\": \"paymentScheduleId\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"transactionDate\": \"transactionDate\",\n        \"originalAmount\": \"originalAmount\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"freightBalanceDue\": \"freightBalanceDue\",\n        \"taxRemainingAmount\": \"taxRemainingAmount\",\n        \"lineItemRemainingAmount\": \"lineItemRemainingAmount\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"installmentStatus\": \"installmentStatus\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerSiteUse.siteUseId\": \"siteUseId\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.customer.id\": \"partyId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.dueDate\": \"dueDate\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\",\n        \"customerTransaction.businessUnit.id\": \"businessUnitId\"\n      }\n    }\n  },\n  \"select\": \"select receivablesPaymentSchedule.customerTransactionId, receivablesPaymentSchedule.TransactionNumber, to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') transactionDate, sum(originalAmount) originalAmount, sum(amountRemaining) amountRemaining,sum(freightBalanceDue) freightBalanceDue, sum(taxRemainingAmount) taxRemainingAmount, sum(lineItemRemainingAmount) lineItemRemainingAmount, receivablesPaymentSchedule.currencyCode, receivablesPaymentSchedule.accountNumber, receivablesPaymentSchedule.partyName, receivablesPaymentSchedule.businessUnit, receivablesPaymentSchedule.businessUnitId, receivablesPaymentSchedule.customerAccountId, receivablesPaymentSchedule.siteUseId,receivablesPaymentSchedule.partyId from receivablesPaymentSchedule\" + filterClause + \" GROUP BY receivablesPaymentSchedule.customerTransactionId, receivablesPaymentSchedule.TransactionNumber, to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD'), receivablesPaymentSchedule.currencyCode, receivablesPaymentSchedule.accountNumber, receivablesPaymentSchedule.partyName, receivablesPaymentSchedule.businessUnit, receivablesPaymentSchedule.businessUnitId, receivablesPaymentSchedule.customerAccountId, receivablesPaymentSchedule.siteUseId,receivablesPaymentSchedule.partyId\"\n};\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1771770588777"
                  },
