        },
        {
          "metadata": {
            "name": "Create Dispute Response Data",
            "returnType": "array",
            "sourceCode": "if($context.$nodes.FIN_IEX_IF_CHECK_FOR_NULL_DISPUTE_PAYLOAD.$output!=true){\n  const taskData=$context.$nodes.FIN_IEX_BO_CREATE_SUCCESSFUL_DISPUTES.$output;\n  const messageDetails=$context.$nodes.FIN_IEX_CODE_REMOVE_ERROR_DISPUTE_REQUESTS.$output.result||[];\n\n  let extractedDataArray=[];\n\n  function parseJsonObject(value){\n    if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n    if(typeof value===\"string\"){\n      const s=value.trim();\n      if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n        try{\n          const parsed=JSON.parse(s);\n          return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n        }catch(e){\n          return {};\n        }\n      }\n    }\n\n    return {};\n  }\n\n  (taskData.parts||[]).forEach((part,index)=>{\n    const disputePayload=part.payload||{};\n    const messageDetail=messageDetails[index]||{};\n\n    const existingResponseData=parseJsonObject(\n      messageDetail.responseData||messageDetail.RESPONSEDATA\n    );\n\n    const firstLine=\n      disputePayload.receivablesDisputeLines&&\n      Array.isArray(disputePayload.receivablesDisputeLines.items)&&\n      disputePayload.receivablesDisputeLines.items.length>0\n        ?disputePayload.receivablesDisputeLines.items[0]\n        :null;\n\n    const responseData={\n      ...existingResponseData,\n      RequestNumber:disputePayload.RequestNumber,\n      CustomerTransactionId:disputePayload.CustomerTransactionId,\n      CustomerComments:disputePayload.CustomerComments,\n      DisputeAmount:disputePayload.DisputeAmount,\n      DisputeType:disputePayload.DisputeType,\n      DisputeReason:disputePayload.DisputeReason,\n      DisputeSection:disputePayload.DisputeSection,\n      DisputePercentage:disputePayload.DisputePercentage,\n      AmountRemaining: messageDetail.amountRemaining ?? null,\n    TransactionCurrencyCode: messageDetail.transactionCurrencyCode ?? null,\n    TransactionNumber: messageDetail.invoiceNumber ?? null,\n    DisputeAmountLevel: messageDetail.disputeAmountLevel,\n    PartyName :  messageDetail.PARTYNAME,\n    AccountNumber : messageDetail.ACCOUNTNUMBER,\n    Site : messageDetail.SITE,\n    ReceivablesDisputeLines: messageDetail.receivablesDisputeLines,\n    DisputeReasonMeaning: messageDetail.disputeReasonMeaning,\n    DisputeSectionMeaning: messageDetail.disputeSectionMeaning,\n    DisputeTypeMeaning: messageDetail.disputeTypeMeaning,\n    MessageId: messageDetail.messageId\n    };\n\n    extractedDataArray.push({\n      messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID||null,\n      responseData,\n      processingStatusCode:\"ORA_PROCESSED\"\n    });\n  });\n\n  const errorData=$context.$nodes.FIN_IEX_CODE_EXTRACT_DISPUTE_ERROR.$output.result||[];\n  const combinedArray=extractedDataArray.concat(errorData);\n\n  return combinedArray;\n}\n\nreturn $context.$nodes.FIN_IEX_CODE_EXTRACT_DISPUTE_ERROR.$output.result||[];"
          },
          "outcomes": {
            "success": "1774501852872"
          },
