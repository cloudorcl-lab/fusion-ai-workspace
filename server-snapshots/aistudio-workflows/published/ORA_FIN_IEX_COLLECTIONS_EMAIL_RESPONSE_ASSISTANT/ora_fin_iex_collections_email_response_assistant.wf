            "returnType": "object",
            "sourceCode": "const pageSize = 10; \nconst page = 1; \nconst data = $context.$variables.MessageDetailsArray; \nconst pagination = {\n  pageSize: pageSize,\n  page: page,\n  start: (page - 1) * pageSize + 1,\n  end: Math.min(page * pageSize, data.length)\n};\n\nreturn pagination;"
          },
