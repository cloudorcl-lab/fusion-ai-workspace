                      "type": "string",
                      "value": "{{$context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_TO_CHECK_EXISTING_DISPUTE.$output.result}}"
