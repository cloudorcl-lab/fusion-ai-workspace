                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Check Transaction Status",
                    "returnType": "object",
                    "sourceCode": "// Ensure transactionDetail is always an array for uniform handling\nconst transactionDetail = $context.$nodes.FIN_IEX_LOOP_EXTRACTED_PROMISE_TRANSACTIONS.FIN_IEX_BO_SEARCH_PROMISED_TRANSACTION.$output || [];\nconst promiseDataExtraction = {};\nconst llmOutput = $context.$nodes.FIN_IEX_EXTRACT_PROMISE_INFORMATION.$output || {};\nconst currentInvoice = $context.$nodes.FIN_IEX_LOOP_EXTRACTED_PROMISE_TRANSACTIONS.$currentItem  || {};\nlet outputJson;\n\n// Always treat transactionDetail as an array\nif (transactionDetail.length === 1) {\n    let isPromiseDataExtractionEmpty = (\n        !promiseDataExtraction ||\n        Object.keys(promiseDataExtraction).length === 0 ||\n        !promiseDataExtraction.promise\n    );\n    if (isPromiseDataExtractionEmpty) {\n        outputJson = JSON.parse(JSON.stringify(llmOutput));\n        if (outputJson && outputJson.promise && Array.isArray(outputJson.promise.invoices)) {\n            outputJson.promise.invoices = [];\n        }\n    } else {\n        outputJson = JSON.parse(JSON.stringify(promiseDataExtraction));\n    }\n    // Add single invoice with VALID status\n    const transactionId = transactionDetail[0].CUSTOMERTRANSACTIONID;\n    let invoiceEntry = JSON.parse(JSON.stringify(currentInvoice));\n    invoiceEntry.CustomerTransactionId = String(transactionId);\n    invoiceEntry.TransactionStatus = \"VALID\";\n    if (outputJson && outputJson.promise) {\n        outputJson.promise.invoices = [invoiceEntry];\n    }\n} else if (transactionDetail.length === 0) {\n    // Single invoice not found: Copy all possible fields from currentInvoice, mark as invalid\n    let base =\n        promiseDataExtraction && Object.keys(promiseDataExtraction).length > 0 ?\n        promiseDataExtraction :\n        llmOutput;\n    outputJson = JSON.parse(JSON.stringify(base));\n    let invalidInvoiceEntry = JSON.parse(JSON.stringify(currentInvoice));\n    invalidInvoiceEntry.CustomerTransactionId = null;\n    invalidInvoiceEntry.TransactionStatus = \"INVOICE_NOT_FOUND\";\n    if (outputJson && outputJson.promise) {\n        outputJson.promise.invoices = [invalidInvoiceEntry];\n    }\n} else {\n    // Multiple transactions found: also copy full context, mark as invalid\n    let base =\n        promiseDataExtraction && Object.keys(promiseDataExtraction).length > 0 ?\n        promiseDataExtraction :\n        llmOutput;\n    outputJson = JSON.parse(JSON.stringify(base));\n    let multipleInvoiceEntry = JSON.parse(JSON.stringify(currentInvoice));\n    multipleInvoiceEntry.CustomerTransactionId = null;\n    multipleInvoiceEntry.TransactionStatus = \"MULTIPLE_INVOICES_FOUND\";\n    if (outputJson && outputJson.promise) {\n        outputJson.promise.invoices = [multipleInvoiceEntry];\n    }\n}\nreturn outputJson;"
                  },
