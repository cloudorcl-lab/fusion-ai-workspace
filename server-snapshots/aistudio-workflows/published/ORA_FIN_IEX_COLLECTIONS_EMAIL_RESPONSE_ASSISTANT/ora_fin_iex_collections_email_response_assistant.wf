                {
                  "metadata": {
                    "name": "Fetch Line Dispute Transaction",
                    "returnType": "object",
                    "sourceCode": "var customerTransactionId = $context.$nodes.FIN_IEX_LOOP_LINE_LEVEL_DISPUTE_TRANSACTIONS.$currentItem.customerTransactionId;\nvar receivablesTransactionDetailQuery = {\n    \"parameters\": { \"bindCustomerTransactionId\": customerTransactionId },\n    \"viewQueries\": {\n        \"receivablesTransactionDetail\": {\n            \"module\": \"oraErpCoreReceivablesBilling\",\n            \"businessObject\": \"ReceivablesTransactionLine\",\n            \"view\": \"receivablesTransactionDetail\",\n            \"fieldAliases\": {\n                \"customerTransactionLineId\": \"customerTransactionLineId\",\n                \"unitPrice\": \"unitPrice\",\n                \"unitStandardPrice\": \"unitStandardPrice\",\n                \"amountOriginal\": \"amountOriginal\",\n                \"amountDueRemaining\": \"amountDueRemaining\",\n                \"taxableAmount\": \"taxableAmount\",\n                \"freightCharge\": \"freightCharge\",\n                \"quantityInvoiced\": \"quantityInvoiced\",\n                \"quantityOrdered\": \"quantityOrdered\",\n                \"taxInvoiceNumber\": \"taxInvoiceNumber\",\n                \"contractEndDate\": \"contractEndDate\",\n                \"contractStartDate\": \"contractStartDate\",\n                \"description\": \"lineDescription\",\n                \"lineNumber\": \"lineNumber\",\n                \"lineType\": \"lineType\",\n                \"salesOrderNumber\": \"salesOrderNumber\",\n                \"salesOrderDate\": \"salesOrderDate\",\n                \"salesOrderLine\": \"salesOrderLine\",\n                \"productCategory\": \"productCategory\",\n                \"productFiscalClassification\": \"productFiscalClassification\",\n                \"productType\": \"productType\",\n                \"taxExemptionCertificateNumber\": \"taxExemptionCertificateNumber\",\n                \"amountIncludesTax\": \"amountIncludesTax\",\n                \"memoLine.description\": \"memoLineDescription\",\n                \"memoLine.name\": \"memoLineName\",\n                \"memoLine.lineType\": \"memoLineType\",\n                \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n                \"customerTransaction.transactionDate\": \"transactionDate\",\n                \"customerTransaction.dueDate\": \"dueDate\",\n                \"customerTransaction.transactionNumber\": \"transactionNumber\",\n                \"customerTransaction.fOB\": \"wayBillNumber\",\n                \"customerTransaction.pONumber\": \"purchaseOrderNumber\"\n            }\n        }\n    },\n    \"select\": \"select customerTransactionLineId, unitPrice, unitStandardPrice, amountOriginal, amountDueRemaining, taxableAmount, freightCharge, quantityInvoiced, quantityOrdered, taxInvoiceNumber, contractEndDate, contractStartDate, lineDescription, lineNumber, lineType, salesOrderNumber, salesOrderDate, salesOrderLine, productCategory, productFiscalClassification, productType, taxExemptionCertificateNumber, amountIncludesTax, memoLineDescription, memoLineName, memoLineType, customerTransactionId, to_char(transactionDate,'YYYY-MM-DD') transactionDate, to_char(dueDate,'YYYY-MM-DD') dueDate, transactionNumber, wayBillNumber, purchaseOrderNumber from receivablesTransactionDetail where customerTransactionId = :bindCustomerTransactionId\"\n};\nreturn receivablesTransactionDetailQuery;"
                  },
