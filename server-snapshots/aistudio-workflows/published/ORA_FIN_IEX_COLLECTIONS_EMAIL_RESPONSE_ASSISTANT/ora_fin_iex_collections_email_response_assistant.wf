                      "value": "{{$context.$nodes.FIN_IEX_LOOP_ITERATE_PROMISED_INSTALLMENTS_TO_CHECK_EXISTING_PROMISES.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_TO_CHECK_EXISTING_PROMISE.$output.result}}"
