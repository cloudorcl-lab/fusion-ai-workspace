        {
          "metadata": {
            "name": "Filter Valid Transactions",
            "returnType": "object",
            "sourceCode": "let transactionsStrings = $context.$nodes.FIN_IEX_LOOP_EXTRACTED_PROMISE_TRANSACTIONS.$output;\n\n// Handle both: array of strings OR direct object\nlet transactions = [];\nif (Array.isArray(transactionsStrings)) {\n  // Multiple: array of JSON strings, parse each\n  for (let i = 0; i < transactionsStrings.length; i++) {\n    let s = transactionsStrings[i];\n    try {\n      transactions.push(typeof s === \"string\" ? JSON.parse(s) : s);\n    } catch (e) { }\n  }\n} else if (transactionsStrings && typeof transactionsStrings === \"object\") {\n  // Single: object (not array), just use directly\n  transactions.push(transactionsStrings);\n} else if (typeof transactionsStrings === \"string\") {\n  try {\n    let parsed = JSON.parse(transactionsStrings);\n    if (Array.isArray(parsed)) {\n      // If parsed is actually array after all\n      for (let i = 0; i < parsed.length; i++) {\n        let s = parsed[i];\n        try {\n          transactions.push(typeof s === \"string\" ? JSON.parse(s) : s);\n        } catch (e) {}\n      }\n    } else if (parsed && typeof parsed === \"object\") {\n      transactions.push(parsed);\n    }\n  } catch (e) { }\n}\n\n// filter valid transaction structures\ntransactions = transactions.filter(\n  t => t && t.result && t.result.promise && t.result.promise.invoices\n);\n\nlet allInvoices = [].concat.apply([], transactions.map(t => t.result.promise.invoices));\nlet validInvoices = allInvoices.filter(inv => inv.TransactionStatus === \"VALID\");\nlet invalidInvoices = allInvoices.filter(inv => inv.TransactionStatus !== \"VALID\");\nlet validInvoiceCount = validInvoices.length;\nlet invalidInvoiceCount = invalidInvoices.length;\nlet validatedInvoicesObject = transactions.length > 0 ? {\n  promise: Object.assign({}, transactions[0].result.promise, { invoices: validInvoices }),\n  customerAccountNumber: transactions[0].result.customerAccountNumber,\n  customerName: transactions[0].result.customerName\n} : {};\nlet invalidInvoicesObject = transactions.length > 0 ? {\n  promise: Object.assign({}, transactions[0].result.promise, { invoices: invalidInvoices }),\n  customerAccountNumber: transactions[0].result.customerAccountNumber,\n  customerName: transactions[0].result.customerName\n} : {};\nlet validCustomerTransactionIdsString = validInvoices\n    .map(inv => \"'\" + inv.CustomerTransactionId + \"'\")\n    .join(',');\nlet validCustomerTransactionIds = validInvoices\n    .map(inv => inv.CustomerTransactionId)\n    .filter(id => id !== null && id !== undefined && id !== \"\");\nlet invoiceSummary = {\n  validInvoiceCount: validInvoiceCount,\n  invalidInvoiceCount: invalidInvoiceCount,\n  validatedInvoicesObject: validatedInvoicesObject,\n  invalidInvoicesObject: invalidInvoicesObject,\n  validCustomerTransactionIdsString: validCustomerTransactionIdsString,\n  validCustomerTransactionIds: validCustomerTransactionIds\n};\n\nreturn invoiceSummary;"
