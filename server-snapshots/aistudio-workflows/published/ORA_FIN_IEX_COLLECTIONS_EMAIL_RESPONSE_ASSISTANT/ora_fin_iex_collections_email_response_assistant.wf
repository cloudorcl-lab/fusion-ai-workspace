                {
                  "metadata": {
                    "name": "Construct Payload To Fetch Promised Installments",
                    "returnType": "object",
                    "sourceCode": "// Current item from loop\nconst customerTransactionId = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_PROMISED_TRANSACTION_IDENTIFIERS.$currentItem;\n\nconst payload = {\n  parameters: {\n    bindCustomerTransactionId: customerTransactionId\n  },\n  viewQueries: {\n    receivablesPaymentSchedule: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        paymentScheduleId: \"paymentScheduleId\",\n        sequence: \"sequence\",\n        accountedBalanceDue: \"accountedBalanceDue\",\n        conversionRate: \"conversionRate\",\n        installmentDueDate: \"installmentDueDate\",\n        transactionDate: \"transactionDate\",\n        originalAmount: \"originalAmount\",\n        amountRemaining: \"amountRemaining\",\n        transactionNumber: \"transactionNumber\",\n        installmentStatus: \"installmentStatus\",\n        overdueFlag: \"overdueFlag\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.customer.id\": \"partyId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.dueDate\": \"dueDate\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\",\n        \"customerTransaction.businessUnit.id\": \"businessUnitId\",\n        \"receivablesSystemOption.ledger.currency.currencyCode\": \"ledgerCurrency\",\n        \"receivablesSystemOption.ledger.currency.precision\": \"ledgerCurrencyPrecision\",\n        \"customerSiteUse.siteUseId\": \"siteUseId\"\n      }\n    }\n  },\n  select: \"select receivablesPaymentSchedule.paymentScheduleId, receivablesPaymentSchedule.CUSTOMERTRANSACTIONID, receivablesPaymentSchedule.businessUnit, receivablesPaymentSchedule.businessUnitId, receivablesPaymentSchedule.TransactionNumber, to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') transactionDate, receivablesPaymentSchedule.currencyCode, receivablesPaymentSchedule.accountNumber, receivablesPaymentSchedule.sequence, receivablesPaymentSchedule.conversionRate, to_char(receivablesPaymentSchedule.installmentDueDate,'YYYY-MM-DD') installmentDueDate, receivablesPaymentSchedule.accountedBalanceDue, receivablesPaymentSchedule.amountRemaining, receivablesPaymentSchedule.partyId, receivablesPaymentSchedule.siteUseId, receivablesPaymentSchedule.customerAccountId, receivablesPaymentSchedule.ledgerCurrency, receivablesPaymentSchedule.ledgerCurrencyPrecision from receivablesPaymentSchedule WHERE 1=1 AND receivablesPaymentSchedule.installmentStatus='OP' AND CUSTOMERTRANSACTIONID = :bindCustomerTransactionId ORDER BY installmentDueDate\"\n};\n\nreturn payload;"
