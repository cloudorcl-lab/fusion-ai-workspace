        {
          "metadata": {
            "name": "Flatten Promised Installments",
            "returnType": "object",
            "sourceCode": "// Input example: array of JSON strings OR array of objects\nconst rawResults = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_PROMISED_TRANSACTION_IDENTIFIERS.$output;\n\nlet flattened = [];\n\nif (Array.isArray(rawResults)) {\n  rawResults.forEach(item => {\n    try {\n      // If item is a JSON string like \"[{...},{...}]\"\n      if (typeof item === \"string\") {\n        const parsed = JSON.parse(item);\n        if (Array.isArray(parsed)) {\n          flattened = flattened.concat(parsed);\n        } else if (parsed && typeof parsed === \"object\") {\n          flattened.push(parsed);\n        }\n      } else if (Array.isArray(item)) {\n        // Already an array\n        flattened = flattened.concat(item);\n      } else if (item && typeof item === \"object\") {\n        // Single object\n        flattened.push(item);\n      }\n    } catch (e) {\n      // Ignore bad entries\n    }\n  });\n} else if (typeof rawResults === \"string\") {\n  // If everything is a single JSON string\n  try {\n    const parsed = JSON.parse(rawResults);\n    if (Array.isArray(parsed)) {\n      flattened = parsed;\n    } else if (parsed && typeof parsed === \"object\") {\n      flattened = [parsed];\n    }\n  } catch (e) {}\n} else if (rawResults && typeof rawResults === \"object\") {\n  flattened = [rawResults];\n}\n\nreturn flattened;"
          },
