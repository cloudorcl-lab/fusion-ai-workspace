          },
          "outcomes": {
            "success": "1777958293978"
          },
          "code": "FIN_IEX_CODE_EVALUATE_PARTIAL_VALID_ERROR_FILTER_PAGINATION",
          "id": "1777958235212",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Set Partial Valid Error Filter Pagination"
          },
          "outcomes": {
            "success": "1775470872694"
          },
          "code": "FIN_IEX_SET_PARTIAL_VALID_ERROR_FILTER_PAGINATION",
          "id": "1777958293978",
          "inputs": [
            {
              "id": "1777958324501",
              "name": "PaginationVariables",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FIN_IEX_CODE_EVALUATE_PARTIAL_VALID_ERROR_FILTER_PAGINATION.$output.result}}"
            },
            {
              "id": "1777958311029",
              "name": "PreviousIntent",
              "scope": "JOB",
