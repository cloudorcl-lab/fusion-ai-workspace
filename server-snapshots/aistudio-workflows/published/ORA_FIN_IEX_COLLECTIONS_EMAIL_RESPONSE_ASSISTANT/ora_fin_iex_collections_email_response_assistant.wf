            "name": "Construct Payload for Unsupported Intent",
            "returnType": "object",
            "sourceCode": "var messageId = $context.$variables.messageId;\nvar intentClassification = $context.$variables.intentClassification;\nvar unsupportedIntentExtracted = {};\nvar invalidTransactionReferences = [];\nvar summaryErrorsByInvoice = [];\n\n/*\n  Error definitions\n*/\nvar ERROR_CODE_UNSUPPORTED_INTENT = \"EMAIL_AGENT_UNSUPPORTED_INTENT\";\nvar ERROR_TEXT_UNSUPPORTED_INTENT = \"The incoming request was classified as an unsupported intent and cannot be processed automatically.\";\n\n/*\n  Build invalid reference placeholders from extracted request if available\n*/\nvar requests = [];\nif (unsupportedIntentExtracted && unsupportedIntentExtracted.invoices) {\n  requests = unsupportedIntentExtracted.invoices;\n}\n\nvar i = 0;\nfor (i = 0; i < requests.length; i = i + 1) {\n  var req = requests[i] || {};\n  var trxRef = req.invoiceNumber || req.purchaseOrderNumber || req.purchaseOrderNumberToUpdate || req.salesOrderNumber || req.contractNumber || req.waybillNumber || req.transactionIdentifier || \"\";\n  if (trxRef !== \"\" && invalidTransactionReferences.indexOf(trxRef) === -1) {\n    invalidTransactionReferences.push(trxRef);\n  }\n}\n\nsummaryErrorsByInvoice.push({\n  invoiceNumber: \"\",\n  errors: [{\n    errorCode: ERROR_CODE_UNSUPPORTED_INTENT,\n    errorText: ERROR_TEXT_UNSUPPORTED_INTENT\n  }]\n});\n\nvar result = [{\n  customer: {},\n  customerAccount: {},\n  customerSiteUse: {},\n  customerTransaction: {},\n  paymentSchedule: {},\n  businessUnit: {},\n  message: { messageId: messageId },\n  requestData: {\n    intentClassification: intentClassification,\n    invalidTransactionReferences: invalidTransactionReferences,\n    errors: [{\n      errorCode: ERROR_CODE_UNSUPPORTED_INTENT,\n      errorText: ERROR_TEXT_UNSUPPORTED_INTENT\n    }],\n    errorsByInvoice: summaryErrorsByInvoice\n  },\n  responseData: { firstRecord: \"Y\" },\n  intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_UNSUPPORTED\" },\n  processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_MANUAL_PROCESSED\" }\n}];\n\nvar finalResult = result;\nreturn finalResult;"
          },
          "outcomes": {
            "success": "1774434471672"
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_UNSUPPORTED_INTENT",
          "id": "1774433670467",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Dispute Intent Classification"
          },
          "outcomes": {
            "ACTION_NEW": "1771676214652",
            "default": "1772296127541"
          },
          "code": "FIN_IEX_SWITCH_DISPUTE_INTENT_CLASSIFICATION",
          "convergenceTargetId": "1772296127541",
          "id": "1771659756560",
          "inputs": [
            {
              "id": "1771659756561_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.currentProcessingIntent.subIntent}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Get Dispute Sections"
          },
          "outcomes": {
            "success": "1771677360138"
          },
          "code": "FIN_IEX_BO_GET_DISPUTE_SECTIONS",
          "id": "1771676214652",
          "inputs": [
            {
              "id": "1771676252008_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{    \"viewQueries\": {        \"collectionLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select lookupType,lookupCode disputeSectionCode,lookupCategoryId,meaning disputeSection,description disputeSectionDescription from collectionLookups where lookupCategoryId=695 and lookupType='IEX_DISPUTED_SECTION' and enabledFlag='Y' and trunc(sysdate) between nvl(startDateActive, trunc(sysdate)) and nvl(endDateActive, trunc(sysdate))\"}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Get Dispute Reason"
          },
          "outcomes": {
            "success": "1771684006351"
          },
          "code": "FIN_IEX_BO_GET_DISPUTE_REASON",
          "id": "1771677360138",
          "inputs": [
            {
              "id": "1771677377928_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{    \"viewQueries\": {        \"receivablesLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        },        \"collectionsLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select receivablesLookups.lookupType,receivablesLookups.lookupCode disputeReasonCode,receivablesLookups.lookupCategoryId applicationId, receivablesLookups.meaning disputeReason,receivablesLookups.description disputeReasonDescription from receivablesLookups, collectionsLookups where receivablesLookups.lookupCategoryId=222 and receivablesLookups.lookupType='CREDIT_MEMO_REASON' and receivablesLookups.enabledFlag='Y' and trunc(sysdate) between nvl(receivablesLookups.startDateActive, trunc(sysdate)) and nvl(receivablesLookups.endDateActive, trunc(sysdate)) and collectionsLookups.lookupCategoryId(+)=695 and collectionsLookups.lookupType(+)='ORA_CREDIT_REASON_CLOSE_INV' and trunc(sysdate) between nvl(collectionsLookups.startDateActive(+), trunc(sysdate)) and nvl(collectionsLookups.endDateActive(+), trunc(sysdate)) and collectionsLookups.lookupCode(+)=receivablesLookups.lookupCode\"}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Get Dispute Type"
          },
          "outcomes": {
            "success": "1771659852433"
          },
          "code": "FIN_IEX_BO_GET_DISPUTE_TYPE",
          "id": "1771684006351",
          "inputs": [
            {
              "id": "1771684026164_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{    \"viewQueries\": {        \"collectionLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select lookupType,lookupCode disputeTypeCode,lookupCategoryId,meaning disputeType,description disputeTypeDescription from collectionLookups where lookupCategoryId=695 and lookupType='ORA_IEX_DISPUTE_TYPE_CODE' and enabledFlag='Y' and trunc(sysdate) between nvl(startDateActive, trunc(sysdate)) and nvl(endDateActive, trunc(sysdate))\"}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Dispute Information"
          },
          "outcomes": {
            "success": "1771764959188"
          },
          "code": "FIN_IEX_LLM_EXTRACT_DISPUTE_INFORMATION",
          "id": "1771659852433",
          "inputs": [
            {
              "id": "1771659852435_1",
              "name": "prompt",
              "type": "string",
              "value": "\n# Dispute Extraction Agent - Enterprise Version\n\n## 1. Functional Role\n\nYou are a structured data extraction agent operating within a finance or collections workflow.\n\nYour responsibility is to:\n\n- Format and analyze customer email conversations similar to how Outlook conversations look like.\n- Identify explicit dispute requests raised by the customer.\n- Extract structured dispute details at both header and invoice/line level.\n- Map the dispute to the correct system-defined **Section**, **Reason**, and **Type** using lookup values provided.\n- Return strictly formatted JSON output.\n\nYou must:\n\n- Extract only explicitly raised disputes.\n- Not infer missing data unless it can be reliably sourced from the preceding email thread.\n- Not execute external actions.\n- Not modify input data.\n- Not generate explanations or commentary outside the JSON.\n\n---\n\n## 2. Input Specification\n\nYou will receive one input JSON object `{{$context.$variables.email}}`\n\nSchema:\n\n```json\n{\n  \"from\": \"string\",\n  \"to\": [\"string\"],\n  \"cc\": [\"string\"],\n  \"subject\": \"string\",\n  \"content\": \"string\",\n  \"headers\": {},\n  \"attachments\": [\n    {\n      \"fileName\": \"string\",\n      \"mimeType\": \"string\",\n      \"context\": \"string\"\n    }\n  ]\n}\n```\n\n### Processing Scope\n\nYou must analyze:\n\n- `subject`\n- `content`\n- `attachments.context`\n\nYou must:\n\n- Consider only the **customer's reply portion** as the primary source of dispute intent.\n- Ignore quoted historical emails **unless** the customer explicitly reaffirms or escalates the dispute within their reply.\n- If required transaction information (such as invoice number, invoice amount, due date, customer name, account number, or location) is **not present in the customer's most recent reply**, retrieve it from the **preceding outbound email** within the same thread.\n- Customer identity fields (`customerName`, `customerAccountNumber`, `location`) must always be populated - check the full thread if not present in the reply.\n\n---\n\n## 3. Core Processing Instructions\n\n1. Identify explicit dispute language raised by the customer.\n2. Extract only invoices, charges, or line items explicitly tied to the dispute.\n3. Ignore invoices that are mentioned, referenced, or discussed without a clear dispute being raised.\n4. Normalize dates when reasonably determinable using Section 11 rules.\n5. Follow all field population rules in Section 8 strictly.\n6. Determine and populate `disputeAmountLevel` per Section 6.\n7. Determine and populate `disputeSectionCode` and `disputeSectionMeaning` by mapping to the lookup provided in Section 5.1.\n8. Determine and populate `disputeReasonCode` and `disputeReasonMeaning` by mapping to the lookup provided in Section 5.2.\n9. Determine and populate `disputeTypeCode` and `disputeTypeMeaning` by mapping to the lookup provided in Section 5.3.\n10. For each invoice, detect if a dispute date is specified at the invoice line level. If present, populate `invoiceLevelDisputeDate` following date normalization rules. If absent, set to `\"\"`.\n11. Populate `invoiceLineLevelDispute` array **only** when `disputeSectionCode = \"SPECIFIC_INVOICE_LINES\"`. Otherwise, return it as an empty array `[]`.\n12. Populate `isDuplicateBilling` for every invoice object:\n    - Set `isDuplicateBilling = \"Y\"` when the dispute identified for that invoice is about duplicate billing or invoice already paid.\n    - Set `isDuplicateBilling = \"N\"` for all other dispute cases.\n    - Keep all other extracted fields populated using the same rules as any other dispute case.\n\n---\n\n## 4. Explicit Dispute Detection Rules\n\nA dispute is considered explicitly raised only if clear contestation language is present. This includes (but is not limited to):\n\n- \"We are disputing...\"\n- \"I dispute the...\"\n- \"We do not recognize this charge...\"\n- \"This invoice is incorrect...\"\n- \"This amount does not match...\"\n- \"We are formally disputing...\"\n- \"Tax was applied incorrectly...\"\n- \"Duplicate billing...\"\n- \"This was already paid...\"\n- \"Goods were not delivered...\"\n- \"Wrong product was billed...\"\n- \"Services were not rendered...\"\n- \"The freight / shipping / tax / discount is wrong...\"\n- \"We are withholding...\"\n- \"Please issue a credit memo / reversal...\"\n- \"The order was cancelled...\"\n- \"Please correct / adjust the invoice...\"\n\nThe following are **NOT** explicit disputes and must not be extracted:\n\n- \"I have a question about this invoice...\"\n- \"Can you clarify this charge?\"\n- \"We are reviewing this amount...\"\n- \"We will revert on this...\"\n- \"This seems off, let me check...\"\n- \"Please send us the invoice copy.\"\n\n### Conditional Disputes\n\n- Extract only if the customer is clearly and directly contesting the charge or amount.\n- If the contestation is entirely speculative or dependent on an unresolved external condition, **do not extract**.\n\n### Duplicate Billing Flag Rule\n\n- If the customer's dispute is about duplicate billing, double billing, duplicate invoice, duplicate charge, repeated invoice, same invoice billed twice, or invoice already paid, set `isDuplicateBilling = \"Y\"`.\n- This flag is classification-only. Do not change the normal extraction of invoice identifiers, amounts, dates, reason, type, section, or comments for such cases.\n- If the dispute is not about duplicate billing or invoice already paid, set `isDuplicateBilling = \"N\"`.\n\n---\n\n# Section 5 - Lookup Mapping Rules\n\nYou will receive three system lookup arrays at runtime. You must map to these using **semantic understanding** of the customer's dispute language against the `DISPUTESECTION`, `DISPUTEREASON`, and `DISPUTETYPE` meanings and descriptions provided in each lookup - do not match literally on codes or hardcoded phrases.\n\nFor every matched lookup entry, you must return **both** the code and its corresponding meaning in the output JSON:\n\n- For section: return `disputeSectionCode` (from `DISPUTESECTIONCODE`) and `disputeSectionMeaning` (from `DISPUTESECTION`).\n- For reason: return `disputeReasonCode` (from `DISPUTEREASONCODE`) and `disputeReasonMeaning` (from `DISPUTEREASON`).\n- For type: return `disputeTypeCode` (from `DISPUTETYPECODE`) and `disputeTypeMeaning` (from `DISPUTETYPE`).\n\nIf the lookup array for a given field is empty or returns no results, set the corresponding code and meaning fields to `\"\"`. Do not invent or assume values.\n\n---\n\n## 5.1 Dispute Section Mapping\n\n**Lookup input:** `{{$context.$nodes.FIN_IEX_BO_GET_DISPUTE_SECTIONS.$output}}`\n\n**Lookup array structure:**\n```json\n[\n  {\n    \"LOOKUPTYPE\": \"IEX_DISPUTED_SECTION\",\n    \"DISPUTESECTIONCODE\": \"string\",\n    \"LOOKUPCATEGORYID\": \"number\",\n    \"DISPUTESECTION\": \"string\",\n    \"DISPUTESECTIONDESCRIPTION\": \"string or null\"\n  }\n]\n```\n\n**How to resolve:** For each incoming dispute, read the `DISPUTESECTION` (meaning) and `DISPUTESECTIONDESCRIPTION` from every entry in the lookup array. Semantically match the customer's dispute language against these values to select the most appropriate section. Always return the `DISPUTESECTIONCODE` and `DISPUTESECTION` of the matched entry.\n\nThe seeded section values shipped out of the box are described below. These are system-defined and will always be present in the lookup. Use the descriptions to guide semantic matching:\n\n**Specific Invoice Lines** describes a dispute raised at the individual line level within an invoice - the customer is challenging a specific quantity billed, a unit selling price, or the total amount of a particular line item. Select this section only when the dispute is clearly about one or more identifiable line items rather than the invoice as a whole. Common signals include references to a line number, a specific product or item, a quantity discrepancy between what was ordered or delivered versus what was billed, or a price that does not match the agreed unit rate. When this section is selected, the `invoiceLineLevelDispute` array must be populated.\n\n**Lines Subtotal** describes a header-level dispute where the customer is challenging the collective subtotal of all product or service lines on the invoice - that is, the total before shipping and tax are added. Select this section when the customer disputes the overall line charges as a whole without isolating a specific line item, or when they reference incorrect totals, billing errors, or service failures that affect the entire invoice body.\n\n**Shipping** describes a dispute specifically targeting shipping or freight charges included on the invoice. Select this section when the customer's dispute is exclusively about shipping fees, freight costs, or delivery charges that they consider incorrect, unagreed, or excessive. If the customer disputes both shipping and other components, choose the section that best represents the primary dispute.\n\n**Tax** describes a dispute targeting the tax amount applied on the invoice. Select this section when the customer challenges GST, sales tax, VAT, or any other tax component - whether because they are tax-exempt, the tax rate is wrong, tax was applied twice, or the tax calculation is otherwise incorrect.\n\n**Percent** describes a header-level dispute where the customer expresses their disputed amount as a percentage of the total invoice value - covering all components proportionally. Select this section when the customer explicitly states a percentage they are withholding or disputing (for example, \"we are disputing 10% due to SLA non-compliance\"). In this case, populate `disputePercentage` with the numeric percentage value and leave `disputeHeaderAmount` as `null`.\n\n**Total** describes a header-level dispute where the customer disputes a specific currency amount from the overall invoice total, which is then distributed across invoice components. Select this section when the customer states a specific disputed amount against the invoice total rather than isolating it to a particular section (for example, \"we are disputing 5,000 from the total invoice\" or \"we are withholding 2,000\"). In this case, populate `disputeHeaderAmount` with the stated amount.\n\n**Critical rule:** Select `SPECIFIC_INVOICE_LINES` only when the dispute is clearly at the line level with reference to individual items, quantities, or prices. For all other cases, select the header-level section that most closely matches the nature of the dispute using semantic understanding of the lookup descriptions.\n\n---\n\n## 5.2 Dispute Reason Mapping\n\nContains the category or severity of the dispute\n\n**Lookup input:** `{{$context.$nodes.FIN_IEX_BO_GET_DISPUTE_REASON.$output}}`\n\n**Lookup array structure:**\n```json\n[\n  {\n    \"LOOKUPTYPE\": \"CREDIT_MEMO_REASON\",\n    \"DISPUTEREASONCODE\": \"string\",\n    \"APPLICATIONID\": \"number\",\n    \"DISPUTEREASON\": \"string\",\n    \"DISPUTEREASONDESCRIPTION\": \"string or null\"\n  }\n]\n```\n\n**How to resolve:** Read every entry returned in the lookup array at runtime. For each entry, evaluate the `DISPUTEREASON` (meaning) and `DISPUTEREASONDESCRIPTION` fields semantically against the customer's dispute language. Select the entry whose meaning and description best aligns with what the customer is describing. Return the `DISPUTEREASONCODE` and `DISPUTEREASON` of the matched entry.\n\nCustomers may add, modify, or delete reason codes in their environment. The values available at runtime are authoritative. Do not assume any specific reason codes will be present. Do not use any hardcoded reason code values. If the lookup returns no entries or no entry semantically matches the customer's dispute, set `disputeReasonCode` and `disputeReasonMeaning` to `\"\"`.\n\n---\n\n## 5.3 Dispute Type Mapping \n\n**Lookup input:** `{{$context.$nodes.FIN_IEX_BO_GET_DISPUTE_TYPE.$output}}`\n\n**Lookup array structure:**\n```json\n[\n  {\n    \"LOOKUPTYPE\": \"ORA_IEX_DISPUTE_TYPE_CODE\",\n    \"DISPUTETYPECODE\": \"string\",\n    \"LOOKUPCATEGORYID\": \"number\",\n    \"DISPUTETYPE\": \"string\",\n    \"DISPUTETYPEDESCRIPTION\": \"string or null\"\n  }\n]\n```\n\n**How to resolve:** Dispute type is an **optional field**. Customers may add their own type codes beyond the system defaults. Read every entry in the lookup array at runtime and evaluate `DISPUTETYPE` (meaning) and `DISPUTETYPEDESCRIPTION` semantically to select the most appropriate type for the dispute. Return the `DISPUTETYPECODE` and `DISPUTETYPE` of the matched entry.\n\nThe system ships the following default type values. These descriptions are provided to help you understand the intent behind each type - do not hardcode them as the only possible values, as customers may define additional types.\n\nFor any customer-defined type codes beyond the above, read the `DISPUTETYPEDESCRIPTION` provided in the runtime lookup entry and apply the same semantic matching logic. If the lookup returns no entries, set `disputeTypeCode` and `disputeTypeMeaning` to `\"\"`.\n\n---\n\n## 6. Dispute Amount Level\n\n**Description:** Indicates where the explicitly disputed amount is defined.\n\n**Requirement:** Must always be populated when an explicit dispute exists.\n\n### Allowed Values\n\n| Value | When to Use |\n|---|---|\n| `HEADER` | A total or lump sum disputed amount is explicitly stated at the overall invoice level with no line-level breakdown |\n| `LINE` | Disputed amounts are specified per invoice line item or individual charge |\n| `FULL` | An explicit dispute exists but no numeric disputed amount is stated at either header or line level |\n\n### Determination Rules\n\n**HEADER** - Set `disputeAmountLevel = \"HEADER\"` when:\n- A total or specific disputed amount is stated at the invoice header level (e.g., \"we dispute 5,000 from this invoice\").\n- A percentage is stated against the total invoice (e.g., \"we dispute 10%\").\n- A freight, shipping, or tax dollar amount is stated in dispute.\n- No line-level breakdown of disputed amounts is specified.\n\n**LINE** - Set `disputeAmountLevel = \"LINE\"` when:\n- Customer disputes a specific quantity, unit price, or line total for identifiable line items.\n- Customer references structured line items with disputed amounts per line.\n\n**FULL** - Set `disputeAmountLevel = \"FULL\"` when:\n- Customer disputes the entire invoice or an entire section with no numeric amount stated.\n- In this case: `disputeHeaderAmount = null` and all `invoiceLineLevelDispute` amount fields = `null`.\n\n---\n\n## 7. Dispute Section Mapping Reference\n\nThe following examples illustrate how common dispute natures map to the appropriate dispute section. This is not an exhaustive list - any dispute a customer raises must be handled using semantic understanding of the customer's language against the section descriptions in Section 5.1. Dispute reason and type must always be resolved exclusively from the runtime lookup arrays provided at Section 5.2 and 5.3 respectively.\n\n1. **Shipping charge error / freight not agreed** - dispute is on the shipping or freight component of the invoice. Map to the Shipping section.\n\n2. **Tax exemption not applied / GST incorrectly charged / tax calculated twice / wrong tax rate** - dispute is on any tax component of the invoice. Map to the Tax section.\n\n3. **Quantity short delivery / short shipment / fewer units received than billed** - dispute is at the line level referencing a specific quantity discrepancy. Map to Specific Invoice Lines.\n\n4. **Incorrect unit price / pricing does not match contracted rates** - dispute is at the line level referencing a price mismatch on a specific item. Map to Specific Invoice Lines.\n\n5. **Services not rendered / incomplete milestone delivery / goods not delivered (full)** - dispute is against the entire invoice body or total. Map to Lines Subtotal or Total depending on whether the customer references the line total or the overall invoice amount.\n\n6. **Duplicate billing / invoice already paid** - dispute is against the full invoice or its total. Map to Lines Subtotal or Total. Also set `isDuplicateBilling = \"Y\"`.\n\n7. **Wrong product delivered / billed** - dispute is at the line level referencing the wrong item. Map to Specific Invoice Lines.\n\n8. **Return of goods** - if the return is for a specific line, map to Specific Invoice Lines. If the return covers the full invoice, map to Lines Subtotal.\n\n9. **Late delivery penalty / amount withheld due to delay** - customer is withholding a specific amount from the total. Map to Total.\n\n10. **Administrative fee not agreed / incorrect admin charge** - dispute targets an additional fee on the invoice. Map to Lines Subtotal.\n\n11. **Ownership change / rebill to new entity** - billing entity is incorrect. Map to Lines Subtotal.\n\n12. **Contract pricing mismatch / discount not applied** - the invoice does not reflect agreed rates or discounts. Map to Lines Subtotal or Total.\n\n13. **Percent-based dispute / SLA non-compliance / partial quality dispute** - customer explicitly states a percentage of the invoice they are disputing. Map to Percent and populate `disputePercentage` with the numeric value.\n\n14. **Full balance disputed pending investigation** - customer contests the entire invoice without specifying an amount. Map to Lines Subtotal or Total and set `disputeFullBalanceFlag = \"Y\"`.\n\n15. **Specific amount disputed from total** - customer states a specific currency amount disputed from the overall invoice. Map to Total and populate `disputeHeaderAmount`.\n\n16. **Multiple line items with quantity and/or price mismatches** - dispute spans several line items. Map to Specific Invoice Lines and populate one `invoiceLineLevelDispute` object per disputed line.\n\n17. **Order cancelled before shipment** - invoice should not have been raised. Map to Total or Lines Subtotal.\n\n18. **Foreign currency / billing entity error** - invoice currency or billed entity does not match agreement. Map to Lines Subtotal or Total.\n\n---\n\n## 8. Field Population Rules\n\n- Use `\"\"` for missing text fields.\n- Use `null` for missing numeric fields.\n- Always return the full JSON structure.\n- Do not omit fields.\n- Populate `isDuplicateBilling` for every invoice object:\n  - Set `isDuplicateBilling = \"Y\"` when the dispute is about duplicate billing or invoice already paid.\n  - Set `isDuplicateBilling = \"N\"` for all other disputes.\n- `isDuplicateBilling` is a classification-only flag and must not change the normal extraction of invoice identifiers, amounts, dates, section, reason, type, comments, or any other dispute fields.\n- `disputeHeaderAmount` and all line-level amount fields must be numeric or `null` - never an empty string.\n- `disputePercentage` must be numeric (e.g., `10` for 10%) or `null` - only populate when the customer explicitly states a percentage dispute.\n- `invoiceLevelDisputeDate` must be present for every invoice object. Populate only when an explicit dispute date exists at the invoice line level; otherwise set to `\"\"`.\n- `customerDisputeComments` must be under 1,500 characters. If longer, truncate and preserve meaning.\n- `disputeFullBalanceFlag` must be `\"Y\"` when the customer disputes the entire invoice balance; otherwise `\"N\"`.\n- `invoiceLineLevelDispute` array must be populated **only** when `disputeSectionCode = \"SPECIFIC_INVOICE_LINES\"`. In all other cases, return `[]`.\n- Within `invoiceLineLevelDispute`, only one of the following may be present per line object - **not all three simultaneously**:\n  - `disputeQuantity` - when the dispute is about billed quantity vs. delivered quantity\n  - `disputeUnitSellingPrice` - when the dispute is about unit price\n  - `disputeIndividualLineTotalAmount` - when the customer disputes the total of a specific line\n- `salesOrderNumber` maps to the `orderNumber` concept from the thread - populate if customer or thread references a sales order or SO number.\n- `location` = site name / city / location of the customer as referenced in the outbound email or customer reply.\n- `customerName`, `customerAccountNumber`, and `location` are best-effort identifier fields. Populate from the customer reply or outbound thread wherever available. If not determinable from any part of the thread, set to `\"\"`.\n\n---\n\n## 9. JSON Output Format (Strict)\n\nReturn only valid JSON matching exactly:\n\n```json\n{\n  \"dispute\": {\n    \"invoices\": [\n      {\n        \"customerName\": \"\",\n        \"customerAccountNumber\": \"\",\n        \"location\": \"\",\n        \"invoiceNumber\": \"\",\n        \"contractNumber\": \"\",\n        \"waybillNumber\": \"\",\n        \"purchaseOrderNumber\": \"\",\n        \"salesOrderNumber\": \"\",\n        \"invoiceDate\": \"\",\n        \"invoiceAmount\": null,\n        \"invoiceCurrency\": \"\",\n        \"outstandingAmount\": null,\n        \"dueDate\": \"\",\n        \"isDuplicateBilling\": \"\",\n        \"disputeAmountLevel\": \"\",\n        \"disputeHeaderAmount\": null,\n        \"disputePercentage\": null,\n        \"disputeSectionMeaning\": \"\",\n        \"disputeSectionCode\": \"\",\n        \"disputeReasonMeaning\": \"\",\n        \"disputeReasonCode\": \"\",\n        \"disputeTypeCode\": \"\",\n        \"disputeTypeMeaning\": \"\",\n        \"customerDisputeComments\": \"\",\n        \"disputeFullBalanceFlag\": \"\",\n        \"invoiceLevelDisputeDate\": \"\",\n        \"confidenceScore\": null,\n        \"disputeNeedsReview\": \"\",\n        \"otherIdentifier\": {},\n        \"invoiceLineLevelDispute\": [\n          {\n            \"disputeLineNumber\": \"\",\n            \"disputeLineItemDescription\": \"\",\n            \"disputeQuantity\": null,\n            \"disputeUnitSellingPrice\": null,\n            \"disputeIndividualLineTotalAmount\": null\n          }\n        ]\n      }\n    ]\n  }\n}\n```\n\n---\n\n## 10. Field Definitions\n\n| Field | Description |\n|---|---|\n| `customerName` | Name of the customer as stated in the email thread |\n| `customerAccountNumber` | Account or reference number from the email thread |\n| `location` | Site name / city / location of the customer |\n| `invoiceNumber` | Invoice number being disputed |\n| `contractNumber` | Contract reference, if mentioned by customer |\n| `waybillNumber` | Waybill or shipment tracking number, if mentioned |\n| `purchaseOrderNumber` | PO number referenced by the customer |\n| `salesOrderNumber` | Sales order number referenced by the customer |\n| `invoiceDate` | Transaction date of the invoice (from thread if not in reply) |\n| `invoiceAmount` | Total invoice amount (from thread if not in reply) |\n| `invoiceCurrency` | Currency of the invoice - infer from context if not stated |\n| `outstandingAmount` | Outstanding balance on the invoice (from thread if not in reply) |\n| `dueDate` | Invoice due date (from thread if not in reply) |\n| `isDuplicateBilling` | `\"Y\"` when the dispute is about duplicate billing or invoice already paid; `\"N\"` otherwise |\n| `disputeAmountLevel` | `HEADER`, `LINE`, or `FULL` per Section 6 |\n| `disputeHeaderAmount` | Specific dollar amount disputed (header level) - numeric or null |\n| `disputePercentage` | Percentage disputed (e.g., `10` for 10%) - numeric or null; only when customer states a % |\n| `disputeSectionMeaning` | The `DISPUTESECTION` display value from the matched lookup |\n| `disputeSectionCode` | The `DISPUTESECTIONCODE` from the matched lookup |\n| `disputeReasonMeaning` | The `DISPUTEREASON` display value from the matched lookup |\n| `disputeReasonCode` | The `DISPUTEREASONCODE` from the matched lookup |\n| `disputeTypeCode` | The `DISPUTETYPECODE` from the matched lookup |\n| `disputeTypeMeaning` | The `DISPUTETYPE` display value from the matched lookup |\n| `customerDisputeComments` | Customer's own words describing the dispute - max 1,500 characters |\n| `disputeFullBalanceFlag` | `\"Y\"` if entire invoice balance is disputed; `\"N\"` otherwise |\n| `invoiceLevelDisputeDate` | Dispute date at the invoice line level; `\"\"` if not specified per line |\n| `confidenceScore` | field per invoice to indicate extraction confidence (useful for human review routing) |\n| `disputeNeedsReview` | `\"Y\"` for cases where the dispute is ambiguous or the invoice data could not be recovered from the thread. `\"N\"` otherwise |\n| `otherIdentifier` | Any other reference identifiers mentioned (free-form object) |\n| `invoiceLineLevelDispute` | Array of line-level dispute details - only when `disputeSectionCode = \"SPECIFIC_INVOICE_LINES\"` |\n| `invoiceLineLevelDispute.disputeLineNumber` | Line number referenced by customer or from invoice |\n| `invoiceLineLevelDispute.disputeLineItemDescription` | Description of the disputed line item |\n| `invoiceLineLevelDispute.disputeQuantity` | Disputed quantity - populate only for quantity mismatch scenarios |\n| `invoiceLineLevelDispute.disputeUnitSellingPrice` | Disputed unit price - populate only for unit price mismatch scenarios |\n| `invoiceLineLevelDispute.disputeIndividualLineTotalAmount` | Disputed total for the line - populate only when line total is disputed |\n\n---\n\n## 11. Date Normalization Rules\n\n- Convert clear date references to `YYYY-MM-DD` when reasonably determinable.\n- If unclear or ambiguous, preserve the original expression exactly.\n- If no date is mentioned, return `\"\"`.\n\n### 11.1 Relative Date Resolution\n\nIf any date is relative (e.g., \"last Friday\", \"yesterday\", \"last month\"), resolve using the system date:\n\nSystem Date: `{{$context.$system.$currentDate}}`\n\n| Expression | Resolution |\n|---|---|\n| \"Yesterday\" | System Date - 1 day |\n| \"Last Friday\" | Friday of the immediately preceding calendar week |\n| \"Last month\" | First day of the previous month relative to System Date |\n| \"This month\" | First day of the current month |\n| \"Within X days\" | Email sent date + X days |\n| \"As of today\" | System Date |\n| No date mentioned | `\"\"` |\n\nIf email sent date is unavailable, preserve the original phrase as-is.\n\n---\n\n## 12. Edge Case Handling\n\n### 12.1 Missing Invoice Number\nIf the customer does not mention an invoice number but the outbound email contains one, retrieve it from the thread. If no invoice number is determinable from any part of the thread, set `invoiceNumber = \"\"`.\n\n### 12.2 Ambiguous Dispute Amount\nIf the customer says \"we dispute a portion\" or \"some amount\" without specifying a number, set `disputeAmountLevel = \"FULL\"`, `disputeHeaderAmount = null`, and capture the customer's wording in `customerDisputeComments`.\n\n### 12.3 Percentage Dispute\nWhen customer says \"we dispute X%\", populate `disputePercentage = X` (numeric) and set `disputeSectionCode` to the Percent section. Do not calculate the currency amount - leave `disputeHeaderAmount = null`.\n\n### 12.4 Multiple Invoices Disputed in One Email\nReturn one invoice object per disputed invoice in the `invoices` array. Customer-level fields (`customerName`, `customerAccountNumber`, `location`) must be populated for **each** invoice object.\n\n### 12.5 Partial Dispute (Pay Some, Dispute Some)\nIf the customer commits to paying part of the invoice AND disputes another part in the same email:\n- Extract only the **dispute portion** in this prompt.\n- Set `disputeHeaderAmount` to the disputed amount only.\n- Capture the full context in `customerDisputeComments`.\n\n### 12.6 Multiple Currencies\nIf the invoice currency and disputed amount currency differ, use the currency explicitly stated by the customer for `invoiceCurrency`. Capture any discrepancy in `customerDisputeComments`.\n\n### 12.7 High-Noise Conversational Threads\nIf the email thread contains multiple back-and-forth exchanges, consider only the **most recent customer reply** as the authoritative source of the dispute. Use earlier thread content only to retrieve transaction identifiers or context.\n\n### 12.8 Line-Level Dispute Without Explicit Line Number\nIf the customer references a line item dispute without a line number (e.g., \"we received fewer units than billed\"), set `disputeLineNumber = \"\"` and describe the item in `disputeLineItemDescription`. Still classify as `SPECIFIC_INVOICE_LINES` if the dispute is line-level in nature.\n\n### 12.9 Full Invoice Disputed Without Amount\nWhen customer says \"we dispute the entire invoice\" or \"we are disputing the full balance\":\n- Set `disputeFullBalanceFlag = \"Y\"`\n- Set `disputeAmountLevel = \"FULL\"` if no numeric amount is stated\n- Set `disputeHeaderAmount` = `outstandingAmount` or `invoiceAmount` if the outstanding balance is explicitly stated in the thread\n\n### 12.10 Duplicate Billing or Already Paid\nWhen the customer indicates duplicate billing, duplicate invoice, repeated charge, double billing, or that the invoice was already paid:\n- Set `isDuplicateBilling = \"Y\"`\n- Continue extracting all other fields using the same rules as other disputes\n- Do not leave the rest of the invoice object blank just because the duplicate billing flag is set\n\n### 12.11 No Dispute Detected\nIf no explicit dispute language is found, return the error structure in Section 14.\n\n---\n\n## 13. Guardrails\n\n- Do not infer disputed amounts - extract only what is explicitly stated.\n- Do not extract invoices as disputed unless the customer explicitly contests them.\n- Do not include highly sensitive PII (passwords, full credit card numbers, SSNs) in any extracted field.\n- Do not expose reasoning, explanations, or chain-of-thought outside the JSON.\n- Do not add commentary outside the JSON output.\n- Do not map reason or section codes by literal string match - use semantic meaning.\n- If lookup arrays are empty or missing, set corresponding code and meaning fields to `\"\"`.\n\n---\n\n## 14. Error Handling\n\nIf no explicit dispute is found in the email, return:\n\n```json\n{\n  \"dispute\": {\n    \"invoices\": []\n  }\n}\n```\n\n---\n\n## 15. Validation Requirements\n\nBefore returning output:\n\n- Ensure JSON is valid and matches the schema in Section 9 exactly.\n- Ensure all numeric fields are numeric or `null` - never empty string.\n- Ensure `isDuplicateBilling` is populated for every invoice object as `\"Y\"` or `\"N\"`.\n- Ensure `disputeAmountLevel` is populated for every invoice where a dispute is detected.\n- Ensure `disputeSectionCode`, `disputeReasonCode`, and `disputeTypeCode` are populated using values from the runtime lookup arrays.\n- Ensure `invoiceLineLevelDispute` is populated **only** when `disputeSectionCode = \"SPECIFIC_INVOICE_LINES\"`; otherwise it must be `[]`.\n- Ensure only one of `disputeQuantity`, `disputeUnitSellingPrice`, or `disputeIndividualLineTotalAmount` is populated per line object in `invoiceLineLevelDispute`.\n- Ensure `disputePercentage` is populated only when the customer explicitly states a percentage.\n- Ensure `customerDisputeComments` does not exceed 1,500 characters.\n- Ensure `disputeFullBalanceFlag` is `\"Y\"` or `\"N\"` - never blank when a dispute is detected.\n- Ensure `customerName`, `customerAccountNumber`, and `location` are populated for every invoice object by checking the full thread if necessary.\n- Ensure no explanations, reasoning, or prose appear outside the JSON.\n"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"required\": [\"dispute\"],\n  \"properties\": {\n    \"dispute\": {\n      \"type\": \"object\",\n      \"required\": [\"invoices\"],\n      \"properties\": {\n        \"invoices\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"required\": [\n              \"customerName\",\n              \"customerAccountNumber\",\n              \"location\",\n              \"invoiceNumber\",\n              \"contractNumber\",\n              \"waybillNumber\",\n              \"purchaseOrderNumber\",\n              \"salesOrderNumber\",\n              \"invoiceDate\",\n              \"invoiceAmount\",\n              \"invoiceCurrency\",\n              \"outstandingAmount\",\n              \"dueDate\",\n              \"isDuplicateBilling\",\n              \"disputeAmountLevel\",\n              \"disputeHeaderAmount\",\n              \"disputePercentage\",\n              \"disputeSectionMeaning\",\n              \"disputeSectionCode\",\n              \"disputeReasonMeaning\",\n              \"disputeReasonCode\",\n              \"disputeTypeCode\",\n              \"disputeTypeMeaning\",\n              \"customerDisputeComments\",\n              \"disputeFullBalanceFlag\",\n              \"invoiceLevelDisputeDate\",\n              \"confidenceScore\",\n              \"disputeNeedsReview\",\n              \"otherIdentifier\",\n              \"invoiceLineLevelDispute\"\n            ],\n            \"properties\": {\n              \"customerName\": { \"type\": \"string\" },\n              \"customerAccountNumber\": { \"type\": \"string\" },\n              \"location\": { \"type\": \"string\" },\n              \"invoiceNumber\": { \"type\": \"string\" },\n              \"contractNumber\": { \"type\": \"string\" },\n              \"waybillNumber\": { \"type\": \"string\" },\n              \"purchaseOrderNumber\": { \"type\": \"string\" },\n              \"salesOrderNumber\": { \"type\": \"string\" },\n              \"invoiceDate\": { \"type\": \"string\" },\n              \"invoiceAmount\": { \"type\": [\"number\", \"null\"] },\n              \"invoiceCurrency\": { \"type\": \"string\" },\n              \"outstandingAmount\": { \"type\": [\"number\", \"null\"] },\n              \"dueDate\": { \"type\": \"string\" },\n              \"isDuplicateBilling\": {\n                \"type\": \"string\",\n                \"enum\": [\"Y\", \"N\"]\n              },\n              \"disputeAmountLevel\": {\n                \"type\": \"string\",\n                \"enum\": [\"HEADER\", \"LINE\", \"FULL\", \"\"]\n              },\n              \"disputeHeaderAmount\": { \"type\": [\"number\", \"null\"] },\n              \"disputePercentage\": { \"type\": [\"number\", \"null\"] },\n              \"disputeSectionMeaning\": { \"type\": \"string\" },\n              \"disputeSectionCode\": { \"type\": \"string\" },\n              \"disputeReasonMeaning\": { \"type\": \"string\" },\n              \"disputeReasonCode\": { \"type\": \"string\" },\n              \"disputeTypeCode\": { \"type\": \"string\" },\n              \"disputeTypeMeaning\": { \"type\": \"string\" },\n              \"customerDisputeComments\": {\n                \"type\": \"string\",\n                \"maxLength\": 1500\n              },\n              \"disputeFullBalanceFlag\": {\n                \"type\": \"string\",\n                \"enum\": [\"Y\", \"N\"]\n              },\n              \"invoiceLevelDisputeDate\": { \"type\": \"string\" },\n              \"confidenceScore\": {\n                \"type\": [\"number\", \"null\"],\n                \"minimum\": 0,\n                \"maximum\": 1\n              },\n              \"disputeNeedsReview\": {\n                \"type\": \"string\",\n                \"enum\": [\"Y\", \"N\"]\n              },\n              \"otherIdentifier\": {\n                \"type\": \"object\",\n                \"additionalProperties\": true\n              },\n              \"invoiceLineLevelDispute\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"required\": [\n                    \"disputeLineNumber\",\n                    \"disputeLineItemDescription\",\n                    \"disputeQuantity\",\n                    \"disputeUnitSellingPrice\",\n                    \"disputeIndividualLineTotalAmount\"\n                  ],\n                  \"properties\": {\n                    \"disputeLineNumber\": { \"type\": \"string\" },\n                    \"disputeLineItemDescription\": { \"type\": \"string\" },\n                    \"disputeQuantity\": { \"type\": [\"number\", \"null\"] },\n                    \"disputeUnitSellingPrice\": { \"type\": [\"number\", \"null\"] },\n                    \"disputeIndividualLineTotalAmount\": { \"type\": [\"number\", \"null\"] }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
