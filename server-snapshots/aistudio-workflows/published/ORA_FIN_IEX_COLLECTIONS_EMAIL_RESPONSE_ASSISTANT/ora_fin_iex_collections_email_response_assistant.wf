        {
          "metadata": {
            "name": "Extract Purchase Order Update Summary for LLM",
            "returnType": "object",
            "sourceCode": "var summary = {};\nvar rows = [];\nvar i = 0;\nvar found = \"N\"; \n\nif (\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD.$output &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD.$output.result &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD.$output.result.length > 0\n) {\n\n  rows = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD.$output.result;\n\n  for (i = 0; i < rows.length; i = i + 1) {\n    var actionableRow = rows[i] || {};\n    var actionableResponseData = actionableRow.responseData || {};\n    var actionableRequestData = actionableRow.requestData || {};\n\n    if (actionableResponseData.firstRecord === \"Y\") {\n      summary = actionableRequestData.summary || {};\n      found = \"Y\";\n    }\n  }\n\n}\n\nif (\n  found !== \"Y\" &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PO_UPDATE_INFORMATION &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PO_UPDATE_INFORMATION.$output &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PO_UPDATE_INFORMATION.$output.result &&\n  $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PO_UPDATE_INFORMATION.$output.result.length > 0\n) {\n  rows = $context.$nodes.FIN_IEX_CODE_CONSTRUCT_PAYLOAD_FOR_MISSING_PO_UPDATE_INFORMATION.$output.result;\n\n  for (i = 0; i < rows.length; i = i + 1) {\n    var notFoundRow = rows[i] || {};\n    var notFoundResponseData = notFoundRow.responseData || {};\n    var notFoundRequestData = notFoundRow.requestData || {};\n\n    if (notFoundResponseData.firstRecord === \"Y\") {\n      summary = notFoundRequestData.summary || {};\n      found = \"Y\";\n    }\n  }\n}\n\nvar result = {\n  summary: summary\n};\n\nreturn result;"
