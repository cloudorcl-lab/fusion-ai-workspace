                {
                  "metadata": {
                    "name": "Construct Transaction Filter Query",
                    "returnType": "object",
                    "sourceCode": "const current = $context.$nodes.FIN_IEX_LOOP_EXTRACTED_PROMISE_TRANSACTIONS.$currentItem;\nconst accountNumber = $context.$nodes.FIN_IEX_EXTRACT_PROMISE_INFORMATION.$output.customerAccountNumber;\n\n\nvar parameters = {};\nlet clauses = [];\n\nif (accountNumber) {\n  parameters.bindAccountNumber = accountNumber;\n  clauses.push(\"AND ACCOUNTNUMBER = :bindAccountNumber\");\n}\n\nif (current.invoiceNumber) {\n  parameters.bindTransactionNumber = current.invoiceNumber;\n  clauses.push(\" AND TRANSACTIONNUMBER = :bindTransactionNumber\");\n} else if (current.purchaseOrderNumber) {\n  parameters.bindPurchaseOrderNumber = current.purchaseOrderNumber;\n  clauses.push(\" AND PURCHASEORDERNUMBER = :bindPurchaseOrderNumber\");\n} else if (current.orderNumber) {\n  parameters.bindOrderNumber = current.orderNumber;\n  clauses.push(\" AND ORDERNUMBER = :bindOrderNumber\");\n} else if (current.transactionIdentifier) {\n  parameters.bindCustomerTransactionReference = current.transactionIdentifier;\n  clauses.push(\" AND CUSTOMERTRANSACTIONREFERENCE = :bindCustomerTransactionReference\");\n} else if (current.contractNumber) {\n  parameters.bindContractNumber = current.contractNumber;\n  clauses.push(\" AND CONTRACTNUMBER = :bindContractNumber\");\n} else if (current.waybillNumber) {\n  parameters.bindWaybillNumber = current.waybillNumber;\n  clauses.push(\" AND WAYBILLNUMBER = :bindWaybillNumber\");\n}\n\nlet filterClause = clauses.join(\" \");\nlet selectQuery = \"select receivablesPaymentSchedule.customerTransactionId, receivablesPaymentSchedule.TransactionNumber, to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') transactionDate, sum(originalAmount) originalAmount, receivablesPaymentSchedule.currencyCode, receivablesPaymentSchedule.accountNumber, receivablesPaymentSchedule.partyName,receivablesPaymentSchedule.businessUnit from receivablesPaymentSchedule WHERE 1=1 {bindDynamicFilter} GROUP BY receivablesPaymentSchedule.customerTransactionId, receivablesPaymentSchedule.TransactionNumber, to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD'),receivablesPaymentSchedule.currencyCode, receivablesPaymentSchedule.accountNumber, receivablesPaymentSchedule.partyName,receivablesPaymentSchedule.businessUnit\";\n\nvar result = {\n  \"parameters\": parameters,\n  \"viewQueries\": {\n    \"receivablesPaymentSchedule\": {\n      \"module\": \"oraErpCoreReceivablesBilling\",\n      \"businessObject\": \"ReceivablesTransactionPaymentSchedule\",\n      \"view\": \"receivablesPaymentSchedule\",\n      \"fieldAliases\": {\n        \"paymentScheduleId\": \"paymentScheduleId\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"transactionDate\": \"transactionDate\",\n        \"originalAmount\": \"originalAmount\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"installmentStatus\": \"installmentStatus\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.dueDate\": \"dueDate\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\"\n      }\n    }\n  },\n  \"select\": selectQuery.replace(\"{bindDynamicFilter}\", filterClause)\n};\n\nreturn result;"
                  },
