                  "inputs": [
                    {
                      "id": "1772210817182_1",
                      "name": "extraction_query_json_object",
                      "type": "string",
                      "value": "{{$context.$nodes.FIN_IEX_CODE_CONSTRUCT_TRANSACTION_FILTER_QUERY.$output.result}}"
