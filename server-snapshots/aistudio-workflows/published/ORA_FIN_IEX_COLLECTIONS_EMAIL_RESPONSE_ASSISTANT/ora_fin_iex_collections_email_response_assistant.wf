          },
          "code": "FIN_IEX_BO_FETCH_DISPUTE_SECTION",
          "id": "1782125194475",
          "inputs": [
            {
              "id": "1782125194475_extraction_query_json_object",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{    \"viewQueries\": {        \"collectionLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select lookupType,lookupCode dispuSectionCode,lookupCategoryId,meaning disputeSection,description disputeSectionDescription from collectionLookups where lookupCategoryId=695 and lookupType='IEX_DISPUTED_SECTION' and enabledFlag='Y' and trunc(sysdate) between nvl(startDateActive, trunc(sysdate)) and nvl(endDateActive, trunc(sysdate))\"}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Fetch Dispute Type"
          },
          "outcomes": {
            "success": "1772530967212"
          },
          "code": "FIN_IEX_BO_FETCH_DISPUTE_TYPE",
          "id": "1782125280148",
          "inputs": [
            {
              "id": "1782125280148_extraction_query_json_object",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{    \"viewQueries\": {        \"collectionLookups\": {            \"module\": \"oraErpCoreCommonObjects\",            \"businessObject\": \"ERPLookupCode\",            \"view\": \"lookupList\",            \"fieldAliases\": {                \"lookupType\": \"lookupType\",                \"lookupCode\": \"lookupCode\",                \"lookupCategoryId\": \"lookupCategoryId\",                \"meaning\": \"meaning\",                \"description\": \"description\",                \"enabledFlag\": \"enabledFlag\",                \"startDateActive\":\"startDateActive\",                \"endDateActive\":\"endDateActive\"            }        }    },    \"select\": \"select lookupType,lookupCode disputeTypeCode,lookupCategoryId,meaning disputeType,description disputeTypeDescription from collectionLookups where lookupCategoryId=695 and lookupType='ORA_IEX_DISPUTE_TYPE_CODE' and enabledFlag='Y' and trunc(sysdate) between nvl(startDateActive, trunc(sysdate)) and nvl(endDateActive, trunc(sysdate))\"}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Extract Required Fields",
            "returnType": "array",
            "sourceCode": "const intentCode = $context.$nodes.FIN_IEX_CODE_OBTAIN_INTENT.$output.result;\nconst categoryCode = $context.$nodes.FIN_IEX_CODE_DERIVE_CATEGORY_CODE.$output.result;\nlet array = $context.$nodes.FIN_IEX_BO_FETCH_INTENT_DETAILS.$output;\n\nconst result = [];\n\n// ----------------- helpers -----------------\nfunction toArray(value) {\n    if (value == null) return [];\n    if (Array.isArray(value)) return value;\n\n    if (typeof value === \"string\") {\n        const s = value.trim();\n        if (s.startsWith(\"{\") || s.startsWith(\"[\")) {\n            try {\n                const parsed = JSON.parse(s);\n                return Array.isArray(parsed) ? parsed : [parsed];\n            } catch (e) {\n                return [value];\n            }\n        }\n        return [value];\n    }\n\n    return [value];\n}\n\nfunction parseJsonObject(value) {\n    if (value && typeof value === \"object\") return value;\n\n    if (typeof value === \"string\") {\n        const s = value.trim();\n        if (s.startsWith(\"{\") || s.startsWith(\"[\")) {\n            try {\n                const parsed = JSON.parse(s);\n                return parsed && typeof parsed === \"object\" ? parsed : {};\n            } catch (e) {\n                return {};\n            }\n        }\n    }\n\n    return {};\n}\n\nfunction mapCommon(item) {\n    return {\n        CUSTOMERMESSAGEDETAILID: item.CUSTOMERMESSAGEDETAILID,\n        MESSAGEID: item.MESSAGEID,\n        INTENTCODE: item.INTENTCODE,\n        PROCESSINGSTATUSCODE: item.PROCESSINGSTATUSCODE,\n        PARTYNAME: item.PARTYNAME,\n        ACCOUNTNUMBER: item.ACCOUNTNUMBER,\n        SITE: item.SITE\n    };\n}\n\narray = toArray(array);\n\n// ----------------- main -----------------\n\nif (intentCode === \"ORA_PROMISE_TO_PAY\") {\n    array.forEach(obj => {\n        const requestData = parseJsonObject(obj.REQUESTDATA);\n\n        const promiseDates =\n            requestData &&\n                requestData.summary &&\n                requestData.summary.promiseDates\n                ? requestData.summary.promiseDates\n                : [];\n\n        promiseDates.forEach(promiseDate => {\n            result.push({\n                messageId: obj.MESSAGEID,\n                site: obj.SITE,\n                accountNumber: obj.ACCOUNTNUMBER,\n                partyName: obj.PARTYNAME,\n                processingStatusCode: obj.PROCESSINGSTATUSCODE,\n                intentCode: obj.INTENTCODE,\n                promiseDates: promiseDate\n            });\n        });\n    });\n}\n\nif (intentCode === \"ORA_DISPUTE_REQUEST\") {\n    let disputeReasonMeanings = toArray($context.$nodes.FIN_IEX_BO_FETCH_DISPUTE_REASON.$output);\n    let disputeSectionMeanings = toArray($context.$nodes.FIN_IEX_BO_GET_DISPUTE_SECTIONS.$output);\n    let disputeTypeMeanings = toArray($context.$nodes.FIN_IEX_BO_GET_DISPUTE_TYPE.$output);\n\n    const disputeReasonMap = disputeReasonMeanings.reduce((acc, x) => {\n        if (x && x.DISPUTEREASONCODE) acc[x.DISPUTEREASONCODE] = x.DISPUTEREASON;\n        return acc;\n    }, {});\n\n    const disputeSectionMap = disputeSectionMeanings.reduce((acc, x) => {\n        if (x && x.DISPUTESECTIONCODE) acc[x.DISPUTESECTIONCODE] = x.DISPUTESECTION;\n        return acc;\n    }, {});\n\n    const disputeTypeMap = disputeTypeMeanings.reduce((acc, x) => {\n        if (x && x.DISPUTETYPECODE) acc[x.DISPUTETYPECODE] = x.DISPUTETYPE;\n        return acc;\n    }, {});\n\n    array.forEach(item => {\n        const requestData = parseJsonObject(item.REQUESTDATA);\n\n        const disputeExtractedInvoiceDetails = requestData.disputeExtractedInvoiceDetails || {};\n        const actionablePayload = requestData.actionablePayload || {};\n        const reasonCode = disputeExtractedInvoiceDetails.disputeReasonCode;\n        const sectionCode = disputeExtractedInvoiceDetails.disputeSectionCode;\n        const typeCode = disputeExtractedInvoiceDetails.disputeTypeCode;\n\n        const mappedReasonMeaning =\n            (reasonCode && disputeReasonMap[reasonCode]) ||\n            disputeExtractedInvoiceDetails.disputeReasonMeaning ||\n            null;\n\n        const mappedSectionMeaning =\n            (sectionCode && disputeSectionMap[sectionCode]) ||\n            disputeExtractedInvoiceDetails.disputeSectionMeaning ||\n            null;\n\n        const mappedTypeMeaning =\n            (typeCode && disputeTypeMap[typeCode]) ||\n            disputeExtractedInvoiceDetails.disputeTypeMeaning ||\n            null;\n\n        result.push({\n            ...mapCommon(item),\n            actionablePayload: actionablePayload,\n            disputeAmountLevel: disputeExtractedInvoiceDetails.disputeAmountLevel,\n            disputeReasonCode: reasonCode,\n            disputeReasonMeaning: mappedReasonMeaning,\n            invoiceNumber: disputeExtractedInvoiceDetails.invoiceNumber,\n            amountRemaining: disputeExtractedInvoiceDetails.amountRemaining,\n            taxRemainingAmount: disputeExtractedInvoiceDetails.taxRemainingAmount,\n            disputeSectionCode: sectionCode,\n            disputeTypeMeaning: mappedTypeMeaning,\n            disputeSectionMeaning: mappedSectionMeaning,\n            disputeTypeCode: typeCode,\n            lineItemRemainingAmount: disputeExtractedInvoiceDetails.lineItemRemainingAmount,\n            currencyCode: disputeExtractedInvoiceDetails.currencyCode,\n            customerDisputeComments: disputeExtractedInvoiceDetails.customerDisputeComments,\n            DisputeAmount: actionablePayload.DisputeAmount,\n            CustomerComments: actionablePayload.CustomerComments,\n            DisputeSection: actionablePayload.DisputeSection,\n            DisputePercentage: actionablePayload.DisputePercentage,\n            CustomerTransactionId: actionablePayload.CustomerTransactionId,\n            BillToCustomerNumber: actionablePayload.BillToCustomerNumber,\n            DisputeType: actionablePayload.DisputeType,\n            DisputeReason: actionablePayload.DisputeReason,\n            receivablesDisputeLines: actionablePayload.receivablesDisputeLines\n        });\n    });\n}\n\nif (intentCode === \"ORA_PO_UPDATE\") {\n    array.forEach(item => {\n        const requestData = parseJsonObject(item.REQUESTDATA);\n        const poUpdate = requestData.poUpdateExtractedInvoiceDetails || {};\n\n        const firstInstallment =\n            Array.isArray(poUpdate.installments) && poUpdate.installments.length > 0\n                ? poUpdate.installments[0]\n                : {};\n\n        result.push({\n            ...mapCommon(item),\n            invoiceNumber: poUpdate.invoiceNumber || null,\n            purchaseOrderNumber: poUpdate.purchaseOrderNumberToUpdate || null,\n            customerTransactionId: poUpdate.customerTransactionId || null,\n            invoiceDate: poUpdate.invoiceDate || null,\n            transactionDate: firstInstallment.TRANSACTIONDATE || null,\n            transactionAmountRemaining: requestData.transactionAmountRemaining || null,\n            invoiceCurrency: requestData.invoiceCurrency || null,\n            customerRequestComments: poUpdate.customerRequestComments || null,\n            actionablePayload: requestData.actionablePayload || null\n        });\n    });\n}\n\nif (intentCode === \"ORA_INVOICE_REPRINT\") {\n    array.forEach(item => {\n        const requestData = parseJsonObject(item.REQUESTDATA);\n        const copyDetails = requestData.invoiceCopyExtractedInvoiceDetails || {};\n\n        const validTransactions =\n            requestData.summary && Array.isArray(requestData.summary.validTransactions)\n                ? requestData.summary.validTransactions\n                : [];\n\n        const installments = [];\n\n        validTransactions.forEach(txn => {\n            const ins = Array.isArray(txn.installments) ? txn.installments : [];\n\n            ins.forEach(x => {\n                installments.push({\n                    CUSTOMERTRANSACTIONID: x.CUSTOMERTRANSACTIONID || null,\n                    TRANSACTIONNUMBER: x.TRANSACTIONNUMBER || null,\n                    AMOUNTREMAINING: x.AMOUNTREMAINING || null,\n                    INSTALLMENTDUEDATE: x.INSTALLMENTDUEDATE || null,\n                    ORIGINALAMOUNT: x.ORIGINALAMOUNT || null,\n                    CURRENCYCODE: x.CURRENCYCODE || null,\n                    PAYMENTSCHEDULEID: x.PAYMENTSCHEDULEID || null,\n                    INSTALLMENTNUMBER: x.INSTALLMENTNUMBER || null\n                });\n            });\n        });\n\n        result.push({\n            ...mapCommon(item),\n            invoiceNumber: copyDetails.invoiceNumber || null,\n            purchaseOrderNumber: copyDetails.purchaseOrderNumber || null,\n            customerTransactionId: copyDetails.customerTransactionId || null,\n            invoiceDate: copyDetails.invoiceDate || null,\n            transactionAmountRemaining: requestData.transactionAmountRemaining || null,\n            invoiceCurrency: requestData.invoiceCurrency || null,\n            customerRequestComments: copyDetails.customerRequestComments || null,\n            actionablePayload: requestData.actionablePayload || null,\n            installments: installments\n        });\n    });\n}\n\n\nreturn result;"
          },
          "outcomes": {
            "success": "1773291555310"
          },
          "code": "FIN_IEX_CODE_EXTRACT_REQUIRED_FIELDS",
          "convergenceTargetId": "1772445129741",
