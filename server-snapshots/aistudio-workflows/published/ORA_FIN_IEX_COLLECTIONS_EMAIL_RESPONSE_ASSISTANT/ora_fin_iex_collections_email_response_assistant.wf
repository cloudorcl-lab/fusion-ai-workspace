        {
          "metadata": {
            "name": "Extract PO Update Error",
            "returnType": "array",
            "sourceCode": "let errorInfo=$context.$nodes.FIN_IEX_BO_UPDATE_PO_RECEIVABLES_INVOICE.$error.$info;\nconst messageDetailArray=$context.$variables.FilteredMessageDetailsArray||[];\n\nfunction parseJsonObject(value){\n  if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n  if(typeof value===\"string\"){\n    const s=value.trim();\n    if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n      try{\n        const parsed=JSON.parse(s);\n        return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n      }catch(e){\n        return {};\n      }\n    }\n  }\n\n  return {};\n}\n\nif(typeof errorInfo===\"string\"){\n  errorInfo=parseJsonObject(errorInfo);\n}\n\nlet resultObj=(errorInfo&&errorInfo.result!=null)?errorInfo.result:errorInfo;\n\nif(typeof resultObj===\"string\"){\n  resultObj=parseJsonObject(resultObj);\n}\n\nconst errorDetails=resultObj[\"o:errorDetails\"]||[];\n\nconst parts=errorDetails.map((error)=>{\n  const path=error[\"o:errorPath\"]||\"\";\n  const m=path.match(/\\/parts\\/(\\d+)/);\n  const partIndex=m?parseInt(m[1],10):null;\n\n  return{\n    index:partIndex,\n    errorCode:error[\"o:errorCode\"],\n    detail:error[\"detail\"]\n  };\n});\n\nreturn parts.map((item)=>{\n  const messageDetail=item.index!=null?messageDetailArray[item.index]||{}:{};\n\n  const existingResponseData=parseJsonObject(\n    messageDetail.responseData||messageDetail.RESPONSEDATA\n  );\n\n  return{\n    messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID||null,\n    responseData:{\n      ...existingResponseData,\n      TransactionNumber:messageDetail.invoiceNumber||null,\n      TransactionDate:messageDetail.transactionDate??null,\n      PurchaseOrder:messageDetail.PurchaseOrder??null,\n      PartyName: messageDetail.PARTYNAME,\n      AccountNumber: messageDetail.ACCOUNTNUMBER,\n      Site: messageDetail.SITE,\n      errorCode:item.errorCode,\n      detail:item.detail,\n      MessageId: messageDetail.messageId,\n      AmountRemaining : messageDetail.transactionAmountRemaining\n    },\n    processingStatusCode:\"ORA_PROCESSING_ERROR\"\n  };\n});"
          },
          "outcomes": {
            "success": "1776055246583"
          },
          "code": "FIN_IEX_CODE_EXTRACT_PO_UPDATE_ERROR",
          "id": "1776054664216",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Remove PO Update Request Errors",
            "returnType": "array",
            "sourceCode": "const arr = $context.$variables.FilteredMessageDetailsArray; \n\nconst errorRaw = $context.$nodes.FIN_IEX_CODE_EXTRACT_PO_UPDATE_ERROR.$output.result; \n\n// normalize errorRaw to an array\nconst errors = Array.isArray(errorRaw)\n  ? errorRaw\n  : (errorRaw ? [errorRaw] : []);\n\n// optionally build a fast lookup set\nconst errorIds = new Set(errors.map(e => e.messageDetailId).filter(Boolean));\n\n\nconst filteredArr = arr.filter(item => !errorIds.has(item.CUSTOMERMESSAGEDETAILID));\n\nreturn filteredArr;"
          },
