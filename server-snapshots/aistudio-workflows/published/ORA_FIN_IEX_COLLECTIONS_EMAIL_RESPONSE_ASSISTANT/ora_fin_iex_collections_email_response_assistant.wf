        {
          "metadata": {
            "name": "Create Promise Response Data",
            "returnType": "array",
            "sourceCode": "if($context.$nodes.FIN_IEX_IF_CHECK_FOR_NULL_PROMISE_PAYLOAD.$output!=true){\n  const taskData=$context.$nodes.FIN_IEX_BO_CREATE_SUCCESSFUL_PROMISES.$output;\n  const messageDetails=$context.$nodes.FIN_IEX_CODE_REMOVE_ERROR_PROMISE_REQUESTS.$output.result||[];\n\n  let extractedDataArray=[];\n\n  function parseJsonObject(value){\n    if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n    if(typeof value===\"string\"){\n      const s=value.trim();\n      if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n        try{\n          const parsed=JSON.parse(s);\n          return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n        }catch(e){\n          return {};\n        }\n      }\n    }\n\n    return {};\n  }\n\n  (taskData.parts||[]).forEach((part,index)=>{\n    const promisePayload=part.payload||{};\n    const messageDetail=messageDetails[index]||{};\n\n    const existingResponseData=parseJsonObject(\n      messageDetail.responseData||messageDetail.RESPONSEDATA\n    );\n\n    const responseData={\n      ...existingResponseData,\n      PromiseDetailId:promisePayload.PromiseDetailId,\n      PromiseDate:promisePayload.PromiseDate,\n      PromiseAmount:promisePayload.PromiseAmount,\n      Currency:promisePayload.Currency,\n      BusinessUnit:promisePayload.BusinessUnit,\n      BillToCustomerAccount:promisePayload.BillToCustomerAccount,\n      TransactionNumber:promisePayload.TransactionNumber,\n      TransactionDate:promisePayload.TransactionDate,\n      InstallmentNumber:promisePayload.InstallmentNumber,\n      PartyName:messageDetail.partyName||null,\n      AccountNumber:messageDetail.accountNumber||null,\n      Site:messageDetail.site||null,\n      MessageId: messageDetail.messageId\n    };\n\n    extractedDataArray.push({\n      messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID||null,\n      responseData,\n      processingStatusCode:\"ORA_PROCESSED\"\n    });\n  });\n\n  const errorData=$context.$nodes.FIN_IEX_CODE_EXTRACT_PROMISE_ERROR.$output.result||[];\n  const combinedArray=extractedDataArray.concat(errorData);\n\n  return combinedArray;\n}\n\nreturn $context.$nodes.FIN_IEX_CODE_EXTRACT_PROMISE_ERROR.$output.result||[];"
          },
