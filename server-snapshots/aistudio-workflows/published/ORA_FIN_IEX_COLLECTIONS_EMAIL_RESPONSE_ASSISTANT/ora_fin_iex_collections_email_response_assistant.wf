        {
          "metadata": {
            "name": "Create Promise Details Payload",
            "returnType": "string",
            "sourceCode": "const raw = $context.$variables.FilteredMessageDetailsArray;\n\nlet arr = [];\nif (Array.isArray(raw)) {\n  arr = raw;\n} else if (typeof raw === \"string\" && raw.trim()) {\n  try {\n    arr = JSON.parse(raw);\n  } catch (e) {\n    arr = [];\n  }\n}\n\nconst messageIds = arr.map(item => item?.messageId).filter(Boolean).join(\",\");\nlet payload = \"\";\n\nif(messageIds)\n{\n  payload = {\n  parameters: {\n    bindMessageIds: messageIds\n  },\n  viewQueries: {\n    CollectionsCustomerMsgDetails: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CollectionsCustomerMessage\",\n      view: \"collectionsCustomerMessageDetails\",\n      fieldAliases: {\n        \"intent.lookupCode\": \"intentCode\",\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"customer.id\": \"partyId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"customer.name\": \"partyName\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"accountSitePurpose.site\": \"site\"\n      }\n    }\n  },\n  select:  \"SELECT ccmd.customerMessageDetailId, ccmd.requestData, ccmd.responseData, ccmd.partyName, ccmd.accountNumber, ccmd.site FROM CollectionsCustomerMsgDetails ccmd WHERE INSTR(',' || :bindMessageIds || ',', ',' || TO_CHAR(ccmd.messageId) || ',') > 0 AND processingStatusCode IN ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING')\"\n};\n}\n\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1773642084519"
          },
          "code": "FIN_IEX_CODE_CREATE_PROMISE_DETAILS_PAYLOAD",
          "id": "1773724776669",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
