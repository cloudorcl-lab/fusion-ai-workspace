                {
                  "metadata": {
                    "name": "Construct Payload to Check Existing Dispute",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK.$currentItem || {};\nvar customerTransactionId = currentItem.customerTransactionId || currentItem.CUSTOMERTRANSACTIONID || null;\n\nvar result = {\n    parameters: {\n        bindCustomerTransactionId: customerTransactionId\n    },\n    viewQueries: {\n        receivablesDisputeDetails: {\n            view: \"receivablesDisputeDetail\",\n            businessObject: \"ReceivablesCreditMemoRequest\",\n            module: \"oraErpCoreReceivablesBilling\",\n            fieldAliases: {\n                \"requestId\": \"requestId\",\n                \"customerTransactionId\": \"customerTransactionId\",\n                \"lineAmount\": \"lineAmount\",\n                \"taxAmount\": \"taxAmount\",\n                \"freightAmount\": \"freightAmount\",\n                \"totalAmount\": \"totalAmount\",\n                \"approvalDate\": \"approvalDate\",\n                \"originalTransactionNumber\": \"originalTransactionNumber\",\n                \"comments\": \"comments\",\n                \"internalComments\": \"internalComments\",\n                \"creditEntireBalance\": \"creditEntireBalance\",\n                \"disputeSectionCode\": \"disputeSectionCode\",\n                \"statusName.lookupCode\": \"statusCode\",\n                \"statusName.meaning\": \"statusMeaning\",\n                \"creditMemoReasonName.lookupCode\": \"disputeReasonCode\",\n                \"creditMemoReasonName.meaning\": \"disputeReasonMeaning\",\n                \"disputeTypeName.lookupCode\": \"disputeTypeCode\",\n                \"disputeTypeName.meaning\": \"disputeTypeMeaning\"\n            }\n        },\n        collectionsCustomerMessageDetails: {\n            view: \"collectionsCustomerMessageDetails\",\n            businessObject: \"CollectionsCustomerMessage\",\n            module: \"oraErpCoreAdvancedCollections\",\n            fieldAliases: {\n                \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n                \"processingStatus.lookupCode\": \"processingStatusCode\",\n                \"intent.lookupCode\": \"intentCode\",\n                \"requestData\": \"requestData\"\n            }\n        }\n    },\n    select: \"select receivablesDisputeDetails.requestId requestId, \" +\n        \"receivablesDisputeDetails.customerTransactionId customerTransactionId, \" +\n        \"receivablesDisputeDetails.lineAmount lineAmount, \" +\n        \"receivablesDisputeDetails.taxAmount taxAmount, \" +\n        \"receivablesDisputeDetails.freightAmount freightAmount, \" +\n        \"receivablesDisputeDetails.totalAmount totalAmount, \" +\n        \"to_char(receivablesDisputeDetails.approvalDate,'YYYY-MM-DD') approvalDate, \" +\n        \"receivablesDisputeDetails.originalTransactionNumber originalTransactionNumber, \" +\n        \"receivablesDisputeDetails.comments comments, \" +\n        \"receivablesDisputeDetails.internalComments internalComments, \" +\n        \"receivablesDisputeDetails.creditEntireBalance creditEntireBalance, \" +\n        \"receivablesDisputeDetails.disputeSectionCode disputeSectionCode, \" +\n        \"receivablesDisputeDetails.statusCode statusCode, \" +\n        \"receivablesDisputeDetails.statusMeaning statusMeaning, \" +\n        \"receivablesDisputeDetails.disputeReasonCode disputeReasonCode, \" +\n        \"receivablesDisputeDetails.disputeReasonMeaning disputeReasonMeaning, \" +\n        \"receivablesDisputeDetails.disputeTypeCode disputeTypeCode, \" +\n        \"receivablesDisputeDetails.disputeTypeMeaning disputeTypeMeaning, \" +\n        \"null processingStatusCode, \" +\n        \"null intentCode, \" +\n        \"null requestData, \" +\n        \"'SYSTEM_DISPUTE' source \" +\n        \"from receivablesDisputeDetails \" +\n        \"where receivablesDisputeDetails.customerTransactionId = :bindCustomerTransactionId \" +\n        \"and receivablesDisputeDetails.statusCode = 'PENDING_APPROVAL' \" +\n        \"union all \" +\n        \"select null requestId, \" +\n        \"collectionsCustomerMessageDetails.customerTransactionId customerTransactionId, \" +\n        \"null lineAmount, \" +\n        \"null taxAmount, \" +\n        \"null freightAmount, \" +\n        \"null totalAmount, \" +\n        \"null approvalDate, \" +\n        \"null originalTransactionNumber, \" +\n        \"null comments, \" +\n        \"null internalComments, \" +\n        \"null creditEntireBalance, \" +\n        \"null disputeSectionCode, \" +\n        \"null statusCode, \" +\n        \"null statusMeaning, \" +\n        \"null disputeReasonCode, \" +\n        \"null disputeReasonMeaning, \" +\n        \"null disputeTypeCode, \" +\n        \"null disputeTypeMeaning, \" +\n        \"collectionsCustomerMessageDetails.processingStatusCode processingStatusCode, \" +\n        \"collectionsCustomerMessageDetails.intentCode intentCode, \" +\n        \"collectionsCustomerMessageDetails.requestData requestData, \" +\n        \"'UNACTIONED_EMAIL_DISPUTE' source \" +\n        \"from collectionsCustomerMessageDetails \" +\n        \"where collectionsCustomerMessageDetails.customerTransactionId = :bindCustomerTransactionId \" +\n        \"and collectionsCustomerMessageDetails.intentCode = 'ORA_DISPUTE_REQUEST' \" +\n        \"and collectionsCustomerMessageDetails.processingStatusCode in ('ORA_REVIEW_PENDING','ORA_ACTION_PENDING')\"\n};\n\nreturn result;"
                  },
