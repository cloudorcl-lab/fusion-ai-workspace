                {
                  "metadata": {
                    "name": "Evaluate Existing Dispute Check Result",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK.$currentItem || {};\nvar boOutput = $context.$nodes.FIN_IEX_LOOP_ITERATE_VALID_DISPUTE_TRANSACTIONS_FOR_DUPLICATE_CHECK.FIN_IEX_BO_CHECK_EXISTING_DISPUTE_FOR_TRANSACTION.$output || [];\n\nvar rows = [];\nvar i = 0;\n\nif (Array.isArray(boOutput)) {\n  rows = boOutput;\n} else if (typeof boOutput === \"string\") {\n  try {\n    rows = JSON.parse(boOutput);\n  } catch (e) {\n    rows = [];\n  }\n} else if (boOutput && typeof boOutput === \"object\") {\n  rows = [boOutput];\n}\n\nvar existingSystemDisputeRows = [];\nvar existingEmailDisputeRows = [];\nvar normalizedExistingDisputes = [];\nvar uniqueEmailDisputeKeys = {};\n\nfor (i = 0; i < rows.length; i = i + 1) {\n  var row = rows[i] || {};\n\n  var source = row.SOURCE || row.source || \"\";\n  var requestId = row.REQUESTID || row.requestId || null;\n  var customerTransactionId = row.CUSTOMERTRANSACTIONID || row.customerTransactionId || null;\n  var lineAmount = row.LINEAMOUNT;\n  var taxAmount = row.TAXAMOUNT;\n  var freightAmount = row.FREIGHTAMOUNT;\n  var totalAmount = row.TOTALAMOUNT;\n  var approvalDate = row.APPROVALDATE || row.approvalDate || \"\";\n  var originalTransactionNumber = row.ORIGINALTRANSACTIONNUMBER || row.originalTransactionNumber || \"\";\n  var comments = row.COMMENTS || row.comments || \"\";\n  var internalComments = row.INTERNALCOMMENTS || row.internalComments || \"\";\n  var creditEntireBalance = row.CREDITENTIREBALANCE || row.creditEntireBalance || \"\";\n  var disputeSectionCode = row.DISPUTESECTIONCODE || row.disputeSectionCode || \"\";\n  var statusCode = row.STATUSCODE || row.statusCode || \"\";\n  var statusMeaning = row.STATUSMEANING || row.statusMeaning || \"\";\n  var disputeReasonCode = row.DISPUTEREASONCODE || row.disputeReasonCode || \"\";\n  var disputeReasonMeaning = row.DISPUTEREASONMEANING || row.disputeReasonMeaning || \"\";\n  var disputeTypeCode = row.DISPUTETYPECODE || row.disputeTypeCode || \"\";\n  var disputeTypeMeaning = row.DISPUTETYPEMEANING || row.disputeTypeMeaning || \"\";\n  var processingStatusCode = row.PROCESSINGSTATUSCODE || row.processingStatusCode || \"\";\n  var intentCode = row.INTENTCODE || row.intentCode || \"\";\n  var requestData = row.REQUESTDATA || row.requestData || \"\";\n\n  if (source === \"SYSTEM_DISPUTE\") {\n    var systemDisputeObj = {\n      source: \"SYSTEM_DISPUTE\",\n      requestId: requestId,\n      customerTransactionId: customerTransactionId,\n      lineAmount: lineAmount,\n      taxAmount: taxAmount,\n      freightAmount: freightAmount,\n      totalAmount: totalAmount,\n      approvalDate: approvalDate,\n      originalTransactionNumber: originalTransactionNumber,\n      comments: comments,\n      internalComments: internalComments,\n      creditEntireBalance: creditEntireBalance,\n      disputeSectionCode: disputeSectionCode,\n      statusCode: statusCode,\n      statusMeaning: statusMeaning,\n      disputeReasonCode: disputeReasonCode,\n      disputeReasonMeaning: disputeReasonMeaning,\n      disputeTypeCode: disputeTypeCode,\n      disputeTypeMeaning: disputeTypeMeaning,\n      processingStatusCode: null,\n      intentCode: null,\n      requestData: null\n    };\n\n    existingSystemDisputeRows.push(systemDisputeObj);\n    normalizedExistingDisputes.push(systemDisputeObj);\n  }\n\n  if (\n    source === \"UNACTIONED_EMAIL_DISPUTE\" &&\n    intentCode === \"ORA_DISPUTE_REQUEST\" &&\n    (processingStatusCode === \"ORA_ACTION_PENDING\" ||\n     processingStatusCode === \"ORA_REVIEW_PENDING\" ||\n     processingStatusCode === \"ORA_ERROR_REVIEW_PENDING\")\n  ) {\n    var parsedRequestData = {};\n    try {\n      parsedRequestData = typeof requestData === \"string\" ? JSON.parse(requestData) : (requestData || {});\n    } catch (e2) {\n      parsedRequestData = {};\n    }\n\n    var disputeExtractedInvoiceDetails = parsedRequestData.disputeExtractedInvoiceDetails || {};\n    var actionablePayload = parsedRequestData.actionablePayload || {};\n\n    var emailDisputeAmount = null;\n    if (actionablePayload.DisputeAmount !== undefined && actionablePayload.DisputeAmount !== null && actionablePayload.DisputeAmount !== \"\") {\n      emailDisputeAmount = actionablePayload.DisputeAmount;\n    }\n\n    var emailDisputeSectionCode = actionablePayload.DisputeSection || disputeExtractedInvoiceDetails.disputeSectionCode || \"\";\n    var emailDisputeReasonCode = actionablePayload.DisputeReason || disputeExtractedInvoiceDetails.disputeReasonCode || \"\";\n    var emailDisputeTypeCode = actionablePayload.DisputeType || disputeExtractedInvoiceDetails.disputeTypeCode || \"\";\n    var emailInvoiceNumber = disputeExtractedInvoiceDetails.invoiceNumber || currentItem.invoiceNumber || \"\";\n\n    var derivedLineAmount = null;\n    var derivedTaxAmount = null;\n    var derivedFreightAmount = null;\n    var derivedTotalAmount = null;\n\n    if (emailDisputeSectionCode === \"TAX\") {\n      derivedTaxAmount = emailDisputeAmount;\n    } else if (emailDisputeSectionCode === \"SHIPPING\") {\n      derivedFreightAmount = emailDisputeAmount;\n    } else if (emailDisputeSectionCode === \"SPECIFIC_INVOICE_LINES\") {\n      derivedLineAmount = emailDisputeAmount;\n    } else if (emailDisputeSectionCode === \"LINES_SUBTOTAL\") {\n      derivedLineAmount = emailDisputeAmount;\n    } else if (emailDisputeSectionCode === \"TOTAL\") {\n      derivedTotalAmount = emailDisputeAmount;\n    }\n\n    var emailKey = [\n      customerTransactionId || \"\",\n      emailInvoiceNumber || \"\",\n      emailDisputeSectionCode || \"\",\n      emailDisputeReasonCode || \"\",\n      emailDisputeTypeCode || \"\",\n      emailDisputeAmount === null ? \"#NULL\" : String(emailDisputeAmount),\n      processingStatusCode || \"\"\n    ].join(\"|\");\n\n    if (!uniqueEmailDisputeKeys[emailKey]) {\n      uniqueEmailDisputeKeys[emailKey] = \"Y\";\n\n      var emailDisputeObj = {\n        source: \"UNACTIONED_EMAIL_DISPUTE\",\n        requestId: null,\n        customerTransactionId: customerTransactionId,\n        invoiceNumber: emailInvoiceNumber,\n        lineAmount: derivedLineAmount,\n        taxAmount: derivedTaxAmount,\n        freightAmount: derivedFreightAmount,\n        totalAmount: derivedTotalAmount,\n        approvalDate: null,\n        originalTransactionNumber: null,\n        comments: disputeExtractedInvoiceDetails.customerDisputeComments || actionablePayload.CustomerComments || \"\",\n        internalComments: null,\n        creditEntireBalance: disputeExtractedInvoiceDetails.disputeFullBalanceFlag || \"\",\n        disputeSectionCode: emailDisputeSectionCode,\n        statusCode: null,\n        statusMeaning: null,\n        disputeReasonCode: emailDisputeReasonCode,\n        disputeReasonMeaning: disputeExtractedInvoiceDetails.disputeReasonMeaning || \"\",\n        disputeTypeCode: emailDisputeTypeCode,\n        disputeTypeMeaning: disputeExtractedInvoiceDetails.disputeTypeMeaning || \"\",\n        processingStatusCode: processingStatusCode,\n        intentCode: intentCode,\n        requestData: requestData\n      };\n\n      existingEmailDisputeRows.push(emailDisputeObj);\n      normalizedExistingDisputes.push(emailDisputeObj);\n    }\n  }\n}\n\nvar hasSystemDispute = existingSystemDisputeRows.length > 0 ? \"Y\" : \"N\";\nvar hasPendingEmailDispute = existingEmailDisputeRows.length > 0 ? \"Y\" : \"N\";\nvar hasDuplicateDispute = (hasSystemDispute === \"Y\" || hasPendingEmailDispute === \"Y\") ? \"Y\" : \"N\";\n\nvar duplicateDisputeReason = \"\";\nif (hasSystemDispute === \"Y\" && hasPendingEmailDispute === \"Y\") {\n  duplicateDisputeReason = \"SYSTEM_DISPUTE_AND_UNACTIONED_EMAIL_DISPUTE_EXISTS\";\n} else if (hasSystemDispute === \"Y\") {\n  duplicateDisputeReason = \"SYSTEM_DISPUTE_EXISTS\";\n} else if (hasPendingEmailDispute === \"Y\") {\n  duplicateDisputeReason = \"UNACTIONED_EMAIL_DISPUTE_EXISTS\";\n}\n\nvar result = JSON.parse(JSON.stringify(currentItem));\nresult.hasDuplicateDispute = hasDuplicateDispute;\nresult.hasSystemDispute = hasSystemDispute;\nresult.hasPendingEmailDispute = hasPendingEmailDispute;\nresult.duplicateDisputeReason = duplicateDisputeReason;\nresult.existingSystemDisputeRows = existingSystemDisputeRows;\nresult.existingEmailDisputeRows = existingEmailDisputeRows;\nresult.duplicateDisputeDetails = normalizedExistingDisputes;\nresult.existingDisputeCheckRows = rows;\n\nreturn result;"
                  },
