                {
                  "metadata": {
                    "name": "Construct Purchase Order Update Transaction Query",
                    "returnType": "object",
                    "sourceCode": "var current = $context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_PO_UPDATE.$currentItem || {};\n\n/*\n  Header/account context\n*/\nvar accountNumber = current.customerAccountNumber || \"\";\n\n/*\n  Parameter and filter holders\n*/\nvar parameters = {};\nvar clauses = [];\n\n/*\n  Account filter\n*/\nif (accountNumber) {\n  parameters.bindAccountNumber = accountNumber;\n  clauses.push(\" AND accountNumber = :bindAccountNumber\");\n}\n\n/*\n  Primary transaction filter selection\n  Follows promises style: choose the first strongest identifier\n*/\nif (current.invoiceNumber) {\n  parameters.bindTransactionNumber = current.invoiceNumber;\n  clauses.push(\" AND transactionNumber = :bindTransactionNumber\");\n} else if (current.purchaseOrderNumber) {\n  parameters.bindPurchaseOrderNumber = current.purchaseOrderNumber;\n  clauses.push(\" AND purchaseOrderNumber = :bindPurchaseOrderNumber\");\n} else if (current.contractNumber) {\n  parameters.bindContractNumber = current.contractNumber;\n  clauses.push(\" AND contractNumber = :bindContractNumber\");\n} else if (current.waybillNumber) {\n  parameters.bindWaybillNumber = current.waybillNumber;\n  clauses.push(\" AND wayBillNumber = :bindWaybillNumber\");\n}\n\n/*\n  Optional installment filter\n*/\nif (current.installmentNumber) {\n  parameters.bindInstallmentNumber = current.installmentNumber;\n  clauses.push(\" AND installmentNumber = :bindInstallmentNumber\");\n}\n\n/*\n  Optional period filters\n*/\nif (current.periodFrom) {\n  parameters.bindPeriodFrom = current.periodFrom;\n  clauses.push(\" AND transactionDate >= to_date(:bindPeriodFrom,'YYYY-MM-DD')\");\n}\n\nif (current.periodTo) {\n  parameters.bindPeriodTo = current.periodTo;\n  clauses.push(\" AND transactionDate <= to_date(:bindPeriodTo,'YYYY-MM-DD')\");\n}\n\n/*\n  Optional amount filter\n*/\nif (current.transactionAmount !== null && current.transactionAmount !== undefined && current.transactionAmount !== \"\") {\n  parameters.bindTransactionAmount = current.transactionAmount;\n  clauses.push(\" AND amountRemaining = :bindTransactionAmount\");\n}\n\n/*\n  Dynamic extraction query\n*/\nvar filterClause = clauses.join(\" \");\n\nvar selectQuery = \"select receivablesPaymentSchedule.customerTransactionId, \" +\n  \"receivablesPaymentSchedule.transactionNumber, \" +\n  \"to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') transactionDate, \" +\n  \"sum(receivablesPaymentSchedule.originalAmount) originalAmount, \" +\n  \"sum(receivablesPaymentSchedule.amountRemaining) amountRemaining, \" +\n  \"receivablesPaymentSchedule.currencyCode, \" +\n  \"receivablesPaymentSchedule.accountNumber, \" +\n  \"receivablesPaymentSchedule.partyName, \" +\n  \"receivablesPaymentSchedule.businessUnit, \" +\n  \"receivablesPaymentSchedule.customerTransactionSource, \" +\n  \"receivablesPaymentSchedule.customerTransactionType  \" +\n  \"from receivablesPaymentSchedule \" +\n  \"WHERE receivablesPaymentSchedule.installmentStatus='OP' AND 1=1 {bindDynamicFilter} \" +\n  \"GROUP BY receivablesPaymentSchedule.customerTransactionId, \" +\n  \"receivablesPaymentSchedule.transactionNumber, \" +\n  \"to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD'), \" +\n  \"receivablesPaymentSchedule.currencyCode, \" +\n  \"receivablesPaymentSchedule.accountNumber, \" +\n  \"receivablesPaymentSchedule.partyName, \" +\n  \"receivablesPaymentSchedule.businessUnit, \" +\n  \"receivablesPaymentSchedule.customerTransactionSource, \" +\n  \"receivablesPaymentSchedule.customerTransactionType\";\n\n/*\n  Final result payload\n*/\nvar result = {\n  parameters: parameters,\n  viewQueries: {\n    receivablesPaymentSchedule: {\n      module: \"oraErpCoreReceivablesBilling\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      view: \"receivablesPaymentSchedule\",\n      fieldAliases: {\n        paymentScheduleId: \"paymentScheduleId\",\n        installmentDueDate: \"installmentDueDate\",\n        transactionDate: \"transactionDate\",\n        originalAmount: \"originalAmount\",\n        amountRemaining: \"amountRemaining\",\n        transactionNumber: \"transactionNumber\",\n        installmentStatus: \"installmentStatus\",\n        overdueFlag: \"overdueFlag\",\n        sequence: \"installmentNumber\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.dueDate\": \"dueDate\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\"\n      }\n    }\n  },\n  select: selectQuery.replace(\"{bindDynamicFilter}\", filterClause)\n};\n\nresult;"
                  },
                  "outcomes": {
                    "success": "1774271654170"
                  },
                  "diagram": {
                    "x": 8922.5,
                    "y": 9443
                  },
                  "code": "FIN_IEX_CODE_CONSTRUCT_PURCHASE_ORDER_UPDATE_TRANSACTION_QUERY",
                  "id": "1774270579247",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
