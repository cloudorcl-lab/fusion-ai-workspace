          "code": "FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_PO_UPDATE",
          "id": "1773645396343",
          "inputs": [
            {
              "id": "1773645396345_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_LLM_EXTRACT_PURCHASE_ORDER_UPDATE_DETAILS.$output.poUpdate.invoices}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Filter Valid PO Update Transactions",
            "returnType": "object",
            "sourceCode": "var rawInvoices =  $context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_PO_UPDATE.$output || []; \n\n/*\n  Output holders\n*/\nvar validInvoiceCount = 0;\nvar invalidInvoiceCount = 0;\nvar validInvoicesObject = [];\nvar invalidInvoicesObject = [];\n\n/*\n  Normalize and classify loop output\n*/\nvar i = 0;\nfor (i = 0; i < rawInvoices.length; i = i + 1) {\n    var rawItem = rawInvoices[i];\n    var parsedObj = rawItem;\n\n    if (typeof rawItem === \"string\") {\n        parsedObj = JSON.parse(rawItem);\n    }\n\n    var invoice = parsedObj.result || parsedObj;\n\n    if (invoice.TransactionStatus === \"VALID\") {\n        validInvoiceCount = validInvoiceCount + 1;\n        validInvoicesObject.push(invoice);\n    } else {\n        invalidInvoiceCount = invalidInvoiceCount + 1;\n        invalidInvoicesObject.push(invoice);\n    }\n}\n\n/*\n  Final result\n*/\nvar result = {\n    validInvoiceCount: validInvoiceCount,\n    invalidInvoiceCount: invalidInvoiceCount,\n    validInvoicesObject: validInvoicesObject,\n    invalidInvoicesObject: invalidInvoicesObject\n};\n\n \nreturn result;"
          },
          "outcomes": {
            "success": "1774273480362"
          },
          "code": "FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS",
          "id": "1774272748121",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Valid PO Update Transaction Exist"
          },
          "outcomes": {
            "true": "1774276347560",
            "false": "1774276471740"
          },
          "code": "FIN_IEX_CODE_CHECK_VALID_PO_UPDATE_TRANSACTION_EXIST",
          "convergenceTargetId": "1774276347560",
          "id": "1774273480362",
          "inputs": [
            {
              "id": "1774273480363_1",
              "name": "condition",
              "type": "string",
              "value": "{{!($context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS && $context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS.$output && $context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS.$output.result && $context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS.$output.result.validInvoicesObject && $context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS.$output.result.validInvoicesObject.length > 0)}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Construct PO Update Payload",
            "returnType": "object",
            "sourceCode": "var messageId = $context.$variables.messageId;\nvar filteredOutput = $context.$nodes.FIN_IEX_CODE_FILTER_VALID_PO_UPDATE_TRANSACTIONS.$output || {};\nvar filteredResult = filteredOutput.result || {};\nvar originalInvalidTransactions = filteredResult.invalidInvoicesObject || [];\nvar enrichedLoopOutput = $context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_VALID_PO_UPDATE.$output || [];\n\n/*\n  Error definitions\n*/\nvar ERROR_CODE_TRX_NOT_VALID = \"EMAIL_AGENT_TRX_NOT_VALID\";\nvar ERROR_TEXT_TRX_NOT_VALID = \"Transaction number {trxNumbers} could not be found.\";\nvar ERROR_CODE_MUL_TRX_FOUND = \"EMAIL_AGENT_MUL_TRX_FOUND\";\nvar ERROR_TEXT_MUL_TRX_FOUND = \"More than one Transaction numbers identified for the given transaction reference {trxNumbers}.\";\nvar ERROR_CODE_DUPLICATE_REQUEST_EXISTS = \"PO_UPDATE_DUPLICATE_REQUEST_EXISTS\";\nvar ERROR_TEXT_DUPLICATE_REQUEST_EXISTS = \"There already exists a pending PO update request for the transaction number {trxNumber}.\";\nvar ERROR_CODE_INVOICE_NOT_MARKED_FOR_PRINT = \"PO_UPDATE_INVOICE_NOT_MARKED_FOR_PRINT\";\nvar ERROR_TEXT_INVOICE_NOT_MARKED_FOR_PRINT = \"The transaction number {trxNumber} is not marked for reprint at the profile after updating the purchase order number.\";\nvar ERROR_CODE_INVOICE_NOT_PRINTED = \"EMAIL_AGENT_INV_NOT_PRINTED\";\nvar ERROR_TEXT_INVOICE_NOT_PRINTED = \"The transaction number {trxNumber} is not printed to regenerate after updating the purchase order number.\";\nvar ERROR_CODE_PO_MISSING_INV = \"EMAIL_AGENT_PO_MISSING_INV\";\nvar ERROR_TEXT_PO_MISSING_INV = \"The transaction number {trxNumber} is missing Purchase order number to update.\";\n\nfunction hasBlockingError(errors) {\n  for (var i = 0; i < errors.length; i = i + 1) {\n    var code = (errors[i] || {}).errorCode;\n    if (\n      code !== ERROR_CODE_INVOICE_NOT_PRINTED &&\n      code !== ERROR_CODE_INVOICE_NOT_MARKED_FOR_PRINT\n    ) {\n      return true;\n    }\n  }\n  return false;\n}\n\n/*\n  Summary holders\n*/\nvar summaryTotalInvoices = 0;\nvar summaryValidInvoiceCount = 0;\nvar summaryInvalidInvoiceCount = 0;\nvar summaryAmountsByCurrency = [];\nvar summaryErrorsByInvoice = [];\n\n/*\n  Working holders\n*/\nvar updatedValidTransactions = [];\nvar responseList = [];\nvar firstValidResponseIndex = -1;\nvar firstErrorResponseIndex = -1;\nvar overallHasValidTransaction = false;\nvar overallHasInvalidTransaction = false;\n\n/*\n  Normalize enriched loop output\n*/\nvar i = 0;\nfor (i = 0; i < enrichedLoopOutput.length; i = i + 1) {\n  var rawItem = enrichedLoopOutput[i];\n  var parsedItem = rawItem;\n  if (typeof rawItem === \"string\") {\n    parsedItem = JSON.parse(rawItem);\n  }\n  var enrichedInvoice = parsedItem.result || parsedItem;\n  updatedValidTransactions.push(enrichedInvoice);\n}\n\n/*\n  Process valid transactions at transaction/invoice level\n*/\nfor (i = 0; i < updatedValidTransactions.length; i = i + 1) {\n  var inv = updatedValidTransactions[i] || {};\n  var installments = inv.installments || [];\n  var transactionLevelErrors = [];\n\n  var firstInstallment = {};\n  if (installments.length > 0) {\n    firstInstallment = installments[0] || {};\n  }\n\n  // Count each invoice exactly once\n  summaryTotalInvoices = summaryTotalInvoices + 1;\n\n  var dunningTransactions = [];\n  var printTransactions = [];\n  var invoicePrintFlag = \"J\";\n\n  var j = 0;\n  for (j = 0; j < installments.length; j = j + 1) {\n    var installment = installments[j] || {};\n    var billTemplateName = installment.BILLTEMPLATENAME;\n    var generateBill = installment.GENERATEBILL;\n    var installmentClass = installment.INSTALLMENTCLASS || \"\";\n    var currencyCode = installment.CURRENCYCODE || inv.invoiceCurrency || \"\";\n    var amountRemaining = installment.AMOUNTREMAINING || 0;\n    var ledgerCurrency = installment.LEDGERCURRENCY || \"\";\n    var accountedBalanceDue = installment.ACCOUNTEDBALANCEDUE || 0;\n    var duplicateCount = Number(installment.DUPLICATECOUNT || 0);\n    var resolvedDeliveryMethod = installment.SITETRANSACTIONDELIVERYMETHOD || installment.ACCOUNTTRANSACTIONDELIVERYMETHOD || \"PRINT_INV\";\n    var printFlag = resolvedDeliveryMethod === \"EMAIL_INV\" ? \"A\" : \"J\";\n\n    // Since all installments under same invoice are expected to have same delivery method,\n    // retain one invoice-level print flag.\n    if (j === 0) {\n      invoicePrintFlag = printFlag;\n    }\n\n    if (duplicateCount > 0) {\n      var duplicateError = {\n        errorCode: ERROR_CODE_DUPLICATE_REQUEST_EXISTS,\n        errorText: ERROR_TEXT_DUPLICATE_REQUEST_EXISTS.replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n      };\n      transactionLevelErrors.push(duplicateError);\n      overallHasInvalidTransaction = true;\n    }\n\n    if (generateBill !== \"PRI\" || (resolvedDeliveryMethod !== \"PRINT_INV\" && resolvedDeliveryMethod !== \"EMAIL_INV\")) {\n      var profilePrintError = {\n        errorCode: ERROR_CODE_INVOICE_NOT_MARKED_FOR_PRINT,\n        errorText: ERROR_TEXT_INVOICE_NOT_MARKED_FOR_PRINT.replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n      };\n      transactionLevelErrors.push(profilePrintError);\n    }\n\n    if (billTemplateName === null || billTemplateName === undefined || billTemplateName === \"\") {\n      var printedError = {\n        errorCode: ERROR_CODE_INVOICE_NOT_PRINTED,\n        errorText: ERROR_TEXT_INVOICE_NOT_PRINTED.replace(\"{trxNumber}\", String(inv.invoiceNumber || installment.TRANSACTIONNUMBER || \"\"))\n      };\n      transactionLevelErrors.push(printedError);\n    }\n\n    var foundCurrency = false;\n    var c = 0;\n    for (c = 0; c < summaryAmountsByCurrency.length; c = c + 1) {\n      if (summaryAmountsByCurrency[c].currencyCode === currencyCode && summaryAmountsByCurrency[c].ledgerCurrency === ledgerCurrency) {\n        summaryAmountsByCurrency[c].transactionAmountRemaining = summaryAmountsByCurrency[c].transactionAmountRemaining + Number(amountRemaining || 0);\n        summaryAmountsByCurrency[c].ledgerAmount = summaryAmountsByCurrency[c].ledgerAmount + Number(accountedBalanceDue || 0);\n        foundCurrency = true;\n      }\n    }\n    if (!foundCurrency) {\n      summaryAmountsByCurrency.push({\n        currencyCode: currencyCode,\n        ledgerCurrency: ledgerCurrency,\n        transactionAmountRemaining: Number(amountRemaining || 0),\n        ledgerAmount: Number(accountedBalanceDue || 0)\n      });\n    }\n\n    dunningTransactions.push({\n      customerTransaction: {\n        customerTransactionId: inv.customerTransactionId || installment.CUSTOMERTRANSACTIONID || \"\"\n      },\n      paymentSchedule: {\n        paymentScheduleId: installment.PAYMENTSCHEDULEID || \"\"\n      },\n      businessUnit: {\n        id: installment.BUSINESSUNITID || \"\"\n      }\n    });\n\n    printTransactions.push({\n      updatedBy: \"PS\",\n      createdBy: installmentClass,\n      reportTypeCode: \"APRTT\",\n      workerNumber: j,\n      printed: invoicePrintFlag,\n      receivablesTransactionPaymentSchedule: {\n        paymentScheduleId: installment.PAYMENTSCHEDULEID || \"\"\n      }\n    });\n  }\n\n  if (\n    inv.purchaseOrderNumberToUpdate === null ||\n    inv.purchaseOrderNumberToUpdate === undefined ||\n    String(inv.purchaseOrderNumberToUpdate).trim() === \"\"\n  ) {\n    var missingPoError = {\n      errorCode: ERROR_CODE_PO_MISSING_INV,\n      errorText: ERROR_TEXT_PO_MISSING_INV.replace(\"{trxNumber}\", String(inv.invoiceNumber || \"\"))\n    };\n    transactionLevelErrors.push(missingPoError);\n    overallHasInvalidTransaction = true;\n  }\n\n  var uniqueErrors = [];\n  var e = 0;\n  for (e = 0; e < transactionLevelErrors.length; e = e + 1) {\n    var currErr = transactionLevelErrors[e];\n    var alreadyExists = false;\n    var u = 0;\n    for (u = 0; u < uniqueErrors.length; u = u + 1) {\n      if (\n        uniqueErrors[u].errorCode === currErr.errorCode &&\n        uniqueErrors[u].errorText === currErr.errorText\n      ) {\n        alreadyExists = true;\n      }\n    }\n    if (!alreadyExists) {\n      uniqueErrors.push(currErr);\n    }\n  }\n  transactionLevelErrors = uniqueErrors;\n\n  var dunningMethod = invoicePrintFlag === \"A\" ? \"EMAIL\" : \"PRINT\";\n\n  var regenerateInstallments = [];\n\n  for (var ps = 0; ps < installments.length; ps = ps + 1) {\n    var psId = (installments[ps] || {}).PAYMENTSCHEDULEID;\n    if (psId !== null && psId !== undefined && String(psId).trim() !== \"\") {\n      regenerateInstallments.push({\n        InstallmentId: String(psId)\n      });\n    }\n  }\n\n  var actionablePayload = {\n    poUpdate: {\n      PurchaseOrder: inv.purchaseOrderNumberToUpdate || \"\"\n    }\n  };\n\n  var totalInvoiceAmountRemaining = 0;\n  var totalLedgerAmount = 0;\n  for (j = 0; j < installments.length; j = j + 1) {\n    totalInvoiceAmountRemaining = totalInvoiceAmountRemaining + Number((installments[j] || {}).AMOUNTREMAINING || 0);\n    totalLedgerAmount = totalLedgerAmount + Number((installments[j] || {}).ACCOUNTEDBALANCEDUE || 0);\n  }\n\n  var reqDataObj = {\n    poUpdateExtractedInvoiceDetails: inv,\n    actionablePayload: actionablePayload,\n    transactionAmountRemaining: totalInvoiceAmountRemaining,\n    invoiceCurrency: firstInstallment.CURRENCYCODE || inv.invoiceCurrency || \"\",\n    ledgerCurrency: firstInstallment.LEDGERCURRENCY || \"\",\n    ledgerAmount: totalLedgerAmount\n  };\n\n  if (transactionLevelErrors.length > 0) {\n    reqDataObj.errors = transactionLevelErrors;\n  }\n\n  var hasStatusBlockingError = hasBlockingError(transactionLevelErrors);\n\n  var currentProcessingStatus = hasStatusBlockingError\n    ? { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n    : { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ACTION_PENDING\" };\n\n  responseList.push({\n    customer: { id: firstInstallment.PARTYID || \"\" },\n    customerAccount: { customerAccountId: firstInstallment.CUSTOMERACCOUNTID || \"\" },\n    customerSiteUse: { SITEUSEID: firstInstallment.SITEUSEID || firstInstallment.siteUseId || \"\" },\n    customerTransaction: { customerTransactionId: inv.customerTransactionId || \"\" },\n    paymentSchedule: { paymentScheduleId: (printTransactions.length > 0 && printTransactions[0].paymentSchedule) ? printTransactions[0].paymentSchedule.paymentScheduleId : \"\" },\n    businessUnit: { id: firstInstallment.BUSINESSUNITID || \"\" },\n    message: { messageId: messageId },\n    requestData: reqDataObj,\n    responseData: null,\n    intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PO_UPDATE\" },\n    processingStatus: currentProcessingStatus\n  });\n\n  if (transactionLevelErrors.length > 0) {\n    summaryErrorsByInvoice.push({\n      invoiceNumber: inv.invoiceNumber || \"\",\n      errors: transactionLevelErrors\n    });\n\n    if (hasStatusBlockingError) {\n      if (firstErrorResponseIndex === -1) {\n        firstErrorResponseIndex = responseList.length - 1;\n      }\n      summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n      overallHasInvalidTransaction = true;\n    } else {\n      if (firstValidResponseIndex === -1) {\n        firstValidResponseIndex = responseList.length - 1;\n      }\n      summaryValidInvoiceCount = summaryValidInvoiceCount + 1;\n      overallHasValidTransaction = true;\n    }\n  } else {\n    if (firstValidResponseIndex === -1) {\n      firstValidResponseIndex = responseList.length - 1;\n    }\n    summaryValidInvoiceCount = summaryValidInvoiceCount + 1;\n    overallHasValidTransaction = true;\n  }\n}\n\n/*\n  Process invalid transactions\n*/\nfor (i = 0; i < originalInvalidTransactions.length; i = i + 1) {\n  var invalidInv = originalInvalidTransactions[i] || {};\n  var trxRef = invalidInv.invoiceNumber || invalidInv.customerTransactionId || \"\";\n  var invalidErrorObj = null;\n\n  summaryTotalInvoices = summaryTotalInvoices + 1;\n  summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n  overallHasInvalidTransaction = true;\n\n  if (invalidInv.TransactionStatus === \"INVOICE_NOT_FOUND\") {\n    invalidErrorObj = {\n      errorCode: ERROR_CODE_TRX_NOT_VALID,\n      errorText: ERROR_TEXT_TRX_NOT_VALID.replace(\"{trxNumbers}\", trxRef)\n    };\n  } else if (invalidInv.TransactionStatus === \"MULTIPLE_INVOICES_FOUND\") {\n    invalidErrorObj = {\n      errorCode: ERROR_CODE_MUL_TRX_FOUND,\n      errorText: ERROR_TEXT_MUL_TRX_FOUND.replace(\"{trxNumbers}\", trxRef)\n    };\n  }\n\n  if (invalidErrorObj) {\n    summaryErrorsByInvoice.push({\n      invoiceNumber: invalidInv.invoiceNumber || \"\",\n      errors: [invalidErrorObj]\n    });\n  }\n\n  responseList.push({\n    customer: {},\n    customerAccount: {},\n    customerSiteUse: {},\n    customerTransaction: {},\n    paymentSchedule: {},\n    businessUnit: {},\n    message: { messageId: messageId },\n    requestData: {\n      poUpdateExtractedInvoiceDetails: invalidInv,\n      errors: invalidErrorObj ? [invalidErrorObj] : []\n    },\n    responseData: null,\n    intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PO_UPDATE\" },\n    processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n  });\n\n  if (firstErrorResponseIndex === -1) {\n    firstErrorResponseIndex = responseList.length - 1;\n  }\n}\n\n/*\n  Attach summary\n*/\nvar summaryIndex = -1;\n\nif (firstValidResponseIndex !== -1) {\n  summaryIndex = firstValidResponseIndex;\n} else if (firstErrorResponseIndex !== -1) {\n  summaryIndex = firstErrorResponseIndex;\n} else if (responseList.length > 0) {\n  summaryIndex = 0;\n}\n\nif (summaryIndex !== -1 && responseList.length > 0) {\n  for (var rr = 0; rr < responseList.length; rr = rr + 1) {\n    if (responseList[rr].responseData && responseList[rr].responseData.firstRecord === \"Y\") {\n      responseList[rr].responseData = null;\n    }\n  }\n\n  responseList[summaryIndex].requestData.summary = {\n    totalInvoices: summaryTotalInvoices,\n    validInvoiceCount: summaryValidInvoiceCount,\n    invalidInvoiceCount: summaryInvalidInvoiceCount,\n    amountsByCurrency: summaryAmountsByCurrency,\n    errorsByInvoice: summaryErrorsByInvoice,\n    validTransactions: updatedValidTransactions\n  };\n  responseList[summaryIndex].responseData = { firstRecord: \"Y\" };\n\n  if (overallHasValidTransaction && overallHasInvalidTransaction) {\n    var r = 0;\n    for (r = 0; r < responseList.length; r = r + 1) {\n      if (responseList[r].processingStatus && responseList[r].processingStatus.lookupCode === \"ORA_ACTION_PENDING\") {\n        responseList[r].processingStatus = {\n          lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n          lookupCode: \"ORA_REVIEW_PENDING\"\n        };\n      }\n    }\n  } else if (!overallHasValidTransaction && overallHasInvalidTransaction) {\n    responseList[summaryIndex].processingStatus = {\n      lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n      lookupCode: \"ORA_ERROR_REVIEW_PENDING\"\n    };\n  }\n}\n\nvar result = responseList;\nreturn result;"
          },
          "outcomes": {
            "success": "1773596869572"
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_PO_UPDATE_PAYLOAD",
          "id": "1774276347560",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1774281991071"
                  },
                  "diagram": {
