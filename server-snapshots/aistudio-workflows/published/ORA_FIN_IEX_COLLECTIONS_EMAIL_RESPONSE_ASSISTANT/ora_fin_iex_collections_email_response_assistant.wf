                    "sourceCode": "let item = $context.$nodes.FIN_IEX_LOOP_ITERATE_PROCESSED_TRANSACTION_COPY_PAYLOAD_REQUESTS.$currentItem;\n\nlet out = new Object();\n\n/*\n  Required fields\n*/\nout.requestData = item && item.requestData ? JSON.stringify(item.requestData) : null;\nlet isFirstRecord = item && item.responseData && item.responseData.firstRecord === \"Y\";\nout.responseData = isFirstRecord ? JSON.stringify(item.responseData) : null;\n\nlet intentObj = item && item.intent ? item.intent : null;\nlet procStatus = item && item.processingStatus ? item.processingStatus : null;\n\nout.intentCode = intentObj && intentObj.lookupCode ? intentObj.lookupCode : \"ORA_INVOICE_REPRINT\";\nout.processingStatusCode = procStatus && procStatus.lookupCode ? procStatus.lookupCode : \"\";\n\n/*\n  Optional objects only if values exist\n*/\nif (item && item.customer && item.customer.id) {\n  out.customer = new Object();\n  out.customer.id = item.customer.id;\n}\n\nif (item && item.customerAccount && item.customerAccount.customerAccountId) {\n  out.customerAccount = new Object();\n  out.customerAccount.customerAccountId = item.customerAccount.customerAccountId;\n}\n\nif (item && item.customerSiteUse && item.customerSiteUse.SITEUSEID) {\n  out.accountSitePurpose = new Object();\n  out.accountSitePurpose.siteUseId = item.customerSiteUse.SITEUSEID;\n}\n\nif (item && item.customerTransaction && item.customerTransaction.customerTransactionId) {\n  out.customerTransaction = new Object();\n  out.customerTransaction.customerTransactionId = item.customerTransaction.customerTransactionId;\n}\n\nif (item && item.businessUnit && item.businessUnit.id) {\n  out.businessUnit = new Object();\n  out.businessUnit.id = item.businessUnit.id;\n}\n\nif (item && item.paymentSchedule && item.paymentSchedule.paymentScheduleId) {\n  out.paymentSchedule = new Object();\n  out.paymentSchedule.paymentScheduleId = item.paymentSchedule.paymentScheduleId;\n}\n\nif (item && item.message && item.message.messageId) {\n  out.emailMessage = new Object();\n  out.emailMessage.messageId = item.message.messageId;\n}\n\nreturn out;"
