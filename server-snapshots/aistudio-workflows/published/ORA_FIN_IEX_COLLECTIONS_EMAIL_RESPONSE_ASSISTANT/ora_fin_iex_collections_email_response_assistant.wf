                  "inputs": [
                    {
                      "id": "1774271742216_1",
                      "name": "extraction_query_json_object",
                      "value": "{{$context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_PO_UPDATE.FIN_IEX_CODE_CONSTRUCT_PURCHASE_ORDER_UPDATE_TRANSACTION_QUERY.$output.result}}",
