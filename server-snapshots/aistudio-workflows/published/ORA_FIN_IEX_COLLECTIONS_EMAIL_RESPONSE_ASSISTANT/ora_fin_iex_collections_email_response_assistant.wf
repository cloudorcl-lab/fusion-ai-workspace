          },
          "code": "FIN_IEX_BO_UPDATE_SUCCESSFUL_PO_UPDATE_REQUESTS",
          "id": "1776055857253",
          "inputs": [
            {
              "id": "1776055900679_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_CREATE_SUCCESSFUL_PO_UPDATE_PAYLOAD.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Create Batch PO Update Response",
            "returnType": "array",
            "sourceCode": "const taskData=$context.$nodes.FIN_IEX_BO_UPDATE_PO_RECEIVABLES_INVOICE.$output;\nconst messageDetails=$context.$variables.FilteredMessageDetailsArray;\n\nfunction parseJsonObject(value){\n  if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n  if(typeof value===\"string\"){\n    const s=value.trim();\n    if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n      try{\n        const parsed=JSON.parse(s);\n        return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n      }catch(e){\n        return {};\n      }\n    }\n  }\n\n  return {};\n}\n\nconst parts=Array.isArray(taskData?.parts)?taskData.parts:[];\nconst msgArr=Array.isArray(messageDetails)?messageDetails:[];\n\nconst extractedDataArray=parts.map((part,index)=>{\n  const p=part?.payload||{};\n  const messageDetail=msgArr[index]||{};\n\n  const existingResponseData=parseJsonObject(\n    messageDetail.responseData||messageDetail.RESPONSEDATA\n  );\n\n  return{\n    messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID??null,\n    responseData:{\n      ...existingResponseData,\n      TransactionNumber:p.TransactionNumber??null,\n      TransactionDate:messageDetail.transactionDate??null,\n      PurchaseOrder:p.PurchaseOrder??null,\n      PartyName: messageDetail.PARTYNAME,\n      AccountNumber: messageDetail.ACCOUNTNUMBER,\n      Site: messageDetail.SITE,\n      AmountRemaining : messageDetail.transactionAmountRemaining,\n      MessageId: messageDetail.messageId\n    },\n    processingStatusCode:\"ORA_PROCESSED\"\n  };\n});\n\nreturn extractedDataArray;"
          },
          "outcomes": {
            "success": "1776078372270"
          },
          "code": "FIN_IEX_CODE_CREATE_BATCH_PO_UPDATE_RESPONSE",
          "id": "1776075247409",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
