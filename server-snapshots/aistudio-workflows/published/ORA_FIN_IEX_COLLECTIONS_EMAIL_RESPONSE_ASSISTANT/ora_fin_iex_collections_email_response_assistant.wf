                {
                  "metadata": {
                    "name": "Evaluate Existing Promise Result",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FIN_IEX_LOOP_ITERATE_PROMISED_INSTALLMENTS_TO_CHECK_EXISTING_PROMISES.$currentItem || {};\nvar boOutput = $context.$nodes.FIN_IEX_LOOP_ITERATE_PROMISED_INSTALLMENTS_TO_CHECK_EXISTING_PROMISES.FIN_IEX_BO_CHECK_EXISTING_PROMISE_FOR_INSTALLMENT.$output || [];\nvar systemDate = $context.$system.$currentDate || \"\";\n\nvar rows = [];\nvar i = 0;\n\nif (Array.isArray(boOutput)) {\n  rows = boOutput;\n} else if (typeof boOutput === \"string\") {\n  try {\n    rows = JSON.parse(boOutput);\n  } catch (e) {\n    rows = [];\n  }\n} else if (boOutput && typeof boOutput === \"object\") {\n  rows = [boOutput];\n}\n\nvar duplicatePromiseDetails = [];\nvar uniqueEmailPromiseKeys = {};\n\nfor (i = 0; i < rows.length; i = i + 1) {\n  var row = rows[i] || {};\n\n  var status = row.STATUS || row.status || \"\";\n  var promiseDate = row.PROMISEDATE || row.promiseDate || \"\";\n  var promiseAmount = row.PROMISEAMOUNT;\n  var remainingAmount = row.REMAININGAMOUNT;\n  var delinquencyId = row.DELINQUENCYID || row.delinquencyId || null;\n  var paymentScheduleId = row.PAYMENTSCHEDULEID || row.paymentScheduleId || null;\n  var customerTransactionId = row.CUSTOMERTRANSACTIONID || row.customerTransactionId || null;\n  var processingStatusCode = row.PROCESSINGSTATUSCODE || row.processingStatusCode || \"\";\n  var intentCode = row.INTENTCODE || row.intentCode || \"\";\n  var requestData = row.REQUESTDATA || row.requestData || \"\";\n\n  if (status === \"COLLECTABLE\") {\n    var promiseState = \"PROMISE\";\n    if (promiseDate && systemDate && promiseDate < systemDate) {\n      promiseState = \"BROKEN\";\n    }\n\n    duplicatePromiseDetails.push({\n      source: \"SYSTEM_PROMISE\",\n      promiseDate: promiseDate,\n      promiseAmount: promiseAmount,\n      remainingAmount: remainingAmount,\n      status: \"COLLECTABLE\",\n      promiseState: promiseState,\n      delinquencyId: delinquencyId,\n      paymentScheduleId: paymentScheduleId,\n      customerTransactionId: customerTransactionId,\n      processingStatusCode: null,\n      intentCode: null,\n      requestData: null\n    });\n  }\n\n  if (\n    status === \"UNACTIONED_EMAIL_PROMISE\" &&\n    intentCode === \"ORA_PROMISE_TO_PAY\" &&\n    (processingStatusCode === \"ORA_ACTION_PENDING\" ||\n     processingStatusCode === \"ORA_REVIEW_PENDING\" ||\n     processingStatusCode === \"ORA_ERROR_REVIEW_PENDING\")\n  ) {\n    var parsedRequestData = {};\n    try {\n      parsedRequestData = typeof requestData === \"string\" ? JSON.parse(requestData) : (requestData || {});\n    } catch (e2) {\n      parsedRequestData = {};\n    }\n\n    var actionablePayload = parsedRequestData.actionablePayload || {};\n    var emailPromiseDate = actionablePayload.PromiseDate || \"\";\n    var emailPromiseAmount = null;\n\n    if (actionablePayload.PromiseBalanceAmount === \"Y\") {\n      emailPromiseAmount = null;\n    } else if (\n      actionablePayload.PromiseAmount !== undefined &&\n      actionablePayload.PromiseAmount !== null &&\n      actionablePayload.PromiseAmount !== \"\"\n    ) {\n      emailPromiseAmount = actionablePayload.PromiseAmount;\n    }\n\n    var emailKey = [\n      paymentScheduleId || \"\",\n      customerTransactionId || \"\",\n      processingStatusCode,\n      emailPromiseDate || \"\",\n      emailPromiseAmount === null ? \"#NULL\" : String(emailPromiseAmount)\n    ].join(\"|\");\n\n    if (!uniqueEmailPromiseKeys[emailKey]) {\n      uniqueEmailPromiseKeys[emailKey] = \"Y\";\n\n      var emailPromiseState = \"PROMISE\";\n      if (emailPromiseDate && systemDate && emailPromiseDate < systemDate) {\n        emailPromiseState = \"BROKEN\";\n      }\n\n      duplicatePromiseDetails.push({\n        source: \"UNACTIONED_EMAIL_PROMISE\",\n        promiseDate: emailPromiseDate,\n        promiseAmount: emailPromiseAmount,\n        remainingAmount: null,\n        status: \"COLLECTABLE\",\n        promiseState: emailPromiseState,\n        delinquencyId: null,\n        paymentScheduleId: paymentScheduleId,\n        customerTransactionId: customerTransactionId,\n        processingStatusCode: processingStatusCode,\n        intentCode: intentCode,\n        requestData: requestData\n      });\n    }\n  }\n}\n\nvar result = JSON.parse(JSON.stringify(currentItem));\nresult.duplicatePromiseDetails = duplicatePromiseDetails;\nresult.hasDuplicatePromise = duplicatePromiseDetails.length > 0 ? \"Y\" : \"N\";\n\nreturn result;"
