              ],
              "rootNode": "start_1771827502176"
            },
            "loopType": "PARALLEL",
            "name": "Iterate Line Level Dispute Transactions"
          },
          "outcomes": {
            "success": "1771870850360"
          },
          "code": "FIN_IEX_LOOP_LINE_LEVEL_DISPUTE_TRANSACTIONS",
          "id": "1771827502176",
          "inputs": [
            {
              "id": "1771827502180_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_FLATTEN_DUPLICATE_CHECKED_DISPUTE_TRANSACTIONS.$output.result.lineLevelValidInvoiceObject}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Construct Dispute Payload",
            "returnType": "object",
            "sourceCode": "// --------- INPUTS ---------\nvar messageId = $context.$variables.messageId;\nvar validDisputeOutput = $context.$nodes.FIN_IEX_CODE_FLATTEN_DUPLICATE_CHECKED_DISPUTE_TRANSACTIONS.$output || {};\nvar validDisputeResult = validDisputeOutput.result || validDisputeOutput;\nvar headerLevelValidInvoiceObject = validDisputeResult.headerLevelValidInvoiceObject || [];\nvar lineLevelValidInvoiceObject = validDisputeResult.lineLevelValidInvoiceObject || [];\nvar invalidInvoicesObject = validDisputeResult.invalidInvoicesObject || [];\nvar lineLevelDetailsOutput = $context.$nodes.FIN_IEX_LOOP_LINE_LEVEL_DISPUTE_TRANSACTIONS.$output || [];\nvar normalizedLineDetailsOutput = [];\nvar n = 0;\nfor (n = 0; n < lineLevelDetailsOutput.length; n = n + 1) {\n  var rawLineDetail = lineLevelDetailsOutput[n];\n  var parsedLineDetail = rawLineDetail;\n  if (typeof rawLineDetail === \"string\") {\n    parsedLineDetail = JSON.parse(rawLineDetail);\n  }\n  normalizedLineDetailsOutput.push(parsedLineDetail);\n}\nvar combinedValidInvoices = headerLevelValidInvoiceObject.concat(lineLevelValidInvoiceObject);\n\n// --------- ERROR DEFINITIONS ---------\nvar ERROR_CODE_MISSING_FIELDS = \"EMAIL_AGENT_DISP_MISSING_FIELDS\";\nvar ERROR_TEXT_TEMPLATE = \"The [{missingFields}] fields are missing for transaction number {trxNumber} to automatically process dispute.\";\nvar ERROR_TEXT_LINE_DETAILS_MISSING = \"The line details could not be identified for the transaction reference {trxNumber}.\";\nvar ERROR_CODE_TRX_NOT_VALID = \"EMAIL_AGENT_TRX_NOT_VALID\";\nvar ERROR_TEXT_TRX_NOT_VALID = \"Transaction number {trxNumbers} could not be found.\";\nvar ERROR_CODE_MUL_TRX_FOUND = \"EMAIL_AGENT_MUL_TRX_FOUND\";\nvar ERROR_TEXT_MUL_TRX_FOUND = \"More than one Transaction numbers identified for the given transaction reference {trxNumbers}\";\nvar ERROR_CODE_PENDING_DISPUTE_EXISTS = \"DISPUTE_ALREADY_EXISTS\";\nvar ERROR_CODE_UNACTIONED_EMAIL_DISPUTE_EXISTS = \"UNACTIONED_EMAIL_DISPUTE_EXISTS\";\nvar ERROR_TEXT_PENDING_DISPUTE_EXISTS = \"There already exists a pending dispute approval for the transaction number {trxNumber}.\";\nvar ERROR_TEXT_UNACTIONED_EMAIL_DISPUTE_EXISTS = \"There already exists an unactioned email dispute request for the transaction number {trxNumber}.\";\n\n// --------- SUMMARY AGGREGATION ---------\nvar summaryTotalInvoices = 0;\nvar summaryValidInvoiceCount = 0;\nvar summaryInvalidInvoiceCount = 0;\nvar summaryDisputedAmountsByCurrency = [];\nvar summaryErrorsByInvoice = [];\n\n// --------- OUTPUT HOLDERS ---------\nvar responseList = [];\nvar firstErrorIndex = -1;\nvar firstValidIndex = -1;\n\n// --------- PROCESS TRANSACTIONS ---------\nvar i = 0;\nfor (i = 0; i < combinedValidInvoices.length; i = i + 1) {\n  var inv = combinedValidInvoices[i] || {};\n  summaryTotalInvoices = summaryTotalInvoices + 1;\n\n  var isLineLevel = inv.disputeAmountLevel === \"LINE\" || inv.disputeSectionCode === \"SPECIFIC_INVOICE_LINES\";\n  var errors = [];\n  var missingFields = [];\n\n  var disputeAmount = inv.disputeAmount;\n  var disputePercentage = inv.disputePercentage;\n\n  if (!isLineLevel) {\n    if ((disputeAmount === null || disputeAmount === undefined || disputeAmount === \"\") &&\n      (disputePercentage === null || disputePercentage === undefined || disputePercentage === \"\")) {\n      if (inv.disputeSectionCode === \"LINETOTAL\") {\n        disputeAmount = inv.lineItemRemainingAmount;\n      } else if (inv.disputeSectionCode === \"TAX\") {\n        disputeAmount = inv.taxRemainingAmount;\n      } else if (inv.disputeSectionCode === \"FREIGHT\") {\n        disputeAmount = inv.freightBalanceDue;\n      } else {\n        disputeAmount = inv.amountRemaining;\n      }\n    }\n\n    if ((disputeAmount === null || disputeAmount === undefined || disputeAmount === \"\") &&\n      (disputePercentage === null || disputePercentage === undefined || disputePercentage === \"\")) {\n      missingFields.push(\"DisputeAmount\");\n      missingFields.push(\"DisputePercentage\");\n    }\n  }\n\n  var receivablesDisputeLines = [];\n  if (isLineLevel) {\n    if (!inv.invoiceLineLevelDispute || inv.invoiceLineLevelDispute.length === 0) {\n      missingFields.push(\"Receivables Dispute Lines\");\n    }\n\n    var l = 0;\n    var matchedLineDetail = null;\n    for (l = 0; l < normalizedLineDetailsOutput.length; l = l + 1) {\n      var lineWrap = normalizedLineDetailsOutput[l] || {};\n      var lineRes = lineWrap.result || lineWrap;\n      if (lineRes && (lineRes.invoiceNumber === inv.invoiceNumber || lineRes.customerTransactionId === inv.customerTransactionId)) {\n        matchedLineDetail = lineRes;\n      }\n    }\n\n    if (matchedLineDetail && matchedLineDetail.mappedLineDetails && matchedLineDetail.mappedLineDetails.length > 0) {\n      var m = 0;\n      for (m = 0; m < matchedLineDetail.mappedLineDetails.length; m = m + 1) {\n        var mapLine = matchedLineDetail.mappedLineDetails[m] || {};\n        var lineDisputeAmount = mapLine.LineDisputeAmount;\n        var lineDisputeQty = mapLine.DisputeQuantity;\n        var lineNumber = mapLine.LineNumber;\n        var customerTransactionLineId = mapLine.CustomerTransactionLineId;\n\n        if ((!lineDisputeAmount || lineDisputeAmount === \"\") && (!lineDisputeQty || lineDisputeQty === \"\")) {\n          missingFields.push(\"LineDisputeAmount\");\n          missingFields.push(\"DisputeQuantity\");\n        }\n\n        var computedLineAmount = lineDisputeAmount;\n        if ((computedLineAmount === null || computedLineAmount === undefined || computedLineAmount === \"\") && lineDisputeQty) {\n          var linesArr = matchedLineDetail.lines || [];\n          var k = 0;\n          for (k = 0; k < linesArr.length; k = k + 1) {\n            var lineObj = linesArr[k] || {};\n            if ((customerTransactionLineId && lineObj.CUSTOMERTRANSACTIONLINEID == customerTransactionLineId) ||\n              (lineNumber && lineObj.LINENUMBER == lineNumber)) {\n              var unitPrice = lineObj.UNITPRICE || lineObj.UNITSTANDARDPRICE || 0;\n              computedLineAmount = unitPrice * lineDisputeQty;\n            }\n          }\n        }\n\n        if (computedLineAmount === null || computedLineAmount === undefined || computedLineAmount === \"\") {\n          computedLineAmount = inv.amountRemaining;\n        }\n\n        var disputeLine = {\n          \"CustomerTransactionLineId\": customerTransactionLineId,\n          \"LineNumber\": lineNumber,\n          \"DisputeQuantity\": lineDisputeQty,\n          \"LineDisputeAmount\": computedLineAmount\n        };\n        receivablesDisputeLines.push(disputeLine);\n      }\n    } else {\n      missingFields.push(\"lineDetails\");\n    }\n  }\n\n  // --------- Duplicate dispute validations ---------\n  if (inv.hasDuplicateDispute === \"Y\") {\n    var duplicateDisputeDetails = inv.duplicateDisputeDetails || [];\n    var seenDuplicateErrorKeys = {};\n\n    for (var dd = 0; dd < duplicateDisputeDetails.length; dd = dd + 1) {\n      var dup = duplicateDisputeDetails[dd] || {};\n      var dupSource = dup.source || \"\";\n      var dupTrxNumber = inv.invoiceNumber || \"\";\n      var dupErrorText = \"\";\n      var dupErrorCode = \"\";\n      var dupErrorKey = \"\";\n\n      if (dupSource === \"SYSTEM_DISPUTE\") {\n        dupErrorCode = ERROR_CODE_PENDING_DISPUTE_EXISTS;\n        dupErrorText = ERROR_TEXT_PENDING_DISPUTE_EXISTS.replace(\"{trxNumber}\", dupTrxNumber);\n        dupErrorKey = dupErrorCode + \"|\" + dupTrxNumber;\n      } else if (dupSource === \"UNACTIONED_EMAIL_DISPUTE\") {\n        dupErrorCode = ERROR_CODE_UNACTIONED_EMAIL_DISPUTE_EXISTS;\n        dupErrorText = ERROR_TEXT_UNACTIONED_EMAIL_DISPUTE_EXISTS.replace(\"{trxNumber}\", dupTrxNumber);\n        dupErrorKey = dupErrorCode + \"|\" + dupTrxNumber;\n      }\n\n      if (dupErrorText !== \"\" && !seenDuplicateErrorKeys[dupErrorKey]) {\n        seenDuplicateErrorKeys[dupErrorKey] = true;\n\n        var duplicateErrorObj = {\n          errorCode: dupErrorCode,\n          errorText: dupErrorText\n        };\n\n        errors.push(duplicateErrorObj);\n\n        var duplicateErrIndex = -1;\n        var de = 0;\n        for (de = 0; de < summaryErrorsByInvoice.length; de = de + 1) {\n          if (summaryErrorsByInvoice[de].invoiceNumber === inv.invoiceNumber) {\n            duplicateErrIndex = de;\n          }\n        }\n\n        if (duplicateErrIndex === -1) {\n          summaryErrorsByInvoice.push({\n            invoiceNumber: inv.invoiceNumber || \"\",\n            errors: [duplicateErrorObj]\n          });\n        } else {\n          summaryErrorsByInvoice[duplicateErrIndex].errors.push(duplicateErrorObj);\n        }\n      }\n    }\n  }\n\n  if (missingFields.length > 0) {\n    var missingText = missingFields.join(\",\");\n    var hasLineDisputeMissing = missingFields.indexOf(\"LineDisputeAmount\") !== -1 && missingFields.indexOf(\"DisputeQuantity\") !== -1;\n    var errText = hasLineDisputeMissing\n      ? ERROR_TEXT_LINE_DETAILS_MISSING.replace(\"{trxNumber}\", inv.invoiceNumber || \"\")\n      : ERROR_TEXT_TEMPLATE.replace(\"{missingFields}\", missingText).replace(\"{trxNumber}\", inv.invoiceNumber || \"\");\n    var errorObj = {\n      \"errorCode\": ERROR_CODE_MISSING_FIELDS,\n      \"errorText\": errText\n    };\n    errors.push(errorObj);\n    summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n    if (firstErrorIndex === -1) {\n      firstErrorIndex = i;\n    }\n\n    var errInvIndex = -1;\n    var e = 0;\n    for (e = 0; e < summaryErrorsByInvoice.length; e = e + 1) {\n      if (summaryErrorsByInvoice[e].invoiceNumber === inv.invoiceNumber) {\n        errInvIndex = e;\n      }\n    }\n    if (errInvIndex === -1) {\n      summaryErrorsByInvoice.push({\n        invoiceNumber: inv.invoiceNumber || \"\",\n        errors: [errorObj]\n      });\n    } else {\n      summaryErrorsByInvoice[errInvIndex].errors.push(errorObj);\n    }\n  } else if (errors.length > 0) {\n    summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n    if (firstErrorIndex === -1) {\n      firstErrorIndex = i;\n    }\n  } else {\n    summaryValidInvoiceCount = summaryValidInvoiceCount + 1;\n    if (firstValidIndex === -1) {\n      firstValidIndex = i;\n    }\n  }\n\n  var actionablePayload = {\n    \"BillToCustomerNumber\": inv.accountNumber || \"\",\n    \"CustomerComments\": inv.customerDisputeComments || \"\",\n    \"CustomerTransactionId\": inv.customerTransactionId || \"\",\n    \"DisputeAmount\": disputeAmount || \"\",\n    \"DisputePercentage\": disputePercentage || \"\",\n    \"DisputeReason\": inv.disputeReasonCode || \"\",\n    \"DisputeSection\": inv.disputeSectionCode || \"\",\n    \"DisputeType\": inv.disputeTypeCode || \"\"\n  };\n\n  if (isLineLevel) {\n    actionablePayload.receivablesDisputeLines = receivablesDisputeLines;\n    var sumLine = 0;\n    var s = 0;\n    for (s = 0; s < receivablesDisputeLines.length; s = s + 1) {\n      sumLine = sumLine + (receivablesDisputeLines[s].disputeAmount || 0);\n    }\n    disputeAmount = sumLine;\n    actionablePayload.DisputeAmount = disputeAmount;\n  }\n\n  var currencyCode = inv.currencyCode || inv.invoiceCurrency || \"\";\n  var foundCurrency = false;\n  var c = 0;\n  for (c = 0; c < summaryDisputedAmountsByCurrency.length; c = c + 1) {\n    if (summaryDisputedAmountsByCurrency[c].currencyCode === currencyCode) {\n      summaryDisputedAmountsByCurrency[c].disputedAmount = summaryDisputedAmountsByCurrency[c].disputedAmount + (disputeAmount || 0);\n      foundCurrency = true;\n    }\n  }\n  if (!foundCurrency) {\n    summaryDisputedAmountsByCurrency.push({\n      currencyCode: currencyCode,\n      disputedAmount: disputeAmount || 0\n    });\n  }\n\n  var reqDataObj = {\n    \"disputeExtractedInvoiceDetails\": inv,\n    \"actionablePayload\": actionablePayload\n  };\n\n  if (errors.length > 0) {\n    reqDataObj.errors = errors;\n  }\n\n  var respDataObj = null;\n  var statusVal = errors.length > 0\n    ? { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n    : { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ACTION_PENDING\" };\n\n  var reqObj = {\n    customer: { id: inv.partyId || inv.PARTYID },\n    customerAccount: { customerAccountId: inv.customerAccountId || inv.CUSTOMERACCOUNTID },\n    customerSiteUse: { SITEUSEID: inv.siteUseId || inv.SITEUSEID },\n    customerTransaction: { customerTransactionId: inv.customerTransactionId || inv.CUSTOMERTRANSACTIONID },\n    businessUnit: { id: inv.businessUnitId || inv.BUSINESSUNITID },\n    message: { messageId: messageId },\n    requestData: reqDataObj,\n    responseData: respDataObj,\n    intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_DISPUTE_REQUEST\" },\n    processingStatus: statusVal\n  };\n\n  responseList.push(reqObj);\n}\n\nvar invalidTransactionReferences = [];\nvar invalidInvoiceErrors = [];\nvar invalidNotFoundRefs = [];\nvar invalidMultipleRefs = [];\n\nfor (i = 0; i < invalidInvoicesObject.length; i = i + 1) {\n  var invalidInv = invalidInvoicesObject[i] || {};\n  var trxRef = invalidInv.invoiceNumber || invalidInv.customerTransactionId || invalidInv.customerTransactionNumber || \"\";\n  summaryTotalInvoices = summaryTotalInvoices + 1;\n  summaryInvalidInvoiceCount = summaryInvalidInvoiceCount + 1;\n  invalidTransactionReferences.push(trxRef);\n\n  var invalidStatus = invalidInv.TransactionStatus;\n  var invalidErrorObj = null;\n  if (invalidStatus === \"INVOICE_NOT_FOUND\") {\n    invalidNotFoundRefs.push(trxRef);\n    invalidErrorObj = {\n      \"errorCode\": ERROR_CODE_TRX_NOT_VALID,\n      \"errorText\": ERROR_TEXT_TRX_NOT_VALID.replace(\"{trxNumbers}\", trxRef)\n    };\n  } else if (invalidStatus === \"MULTIPLE_INVOICES_FOUND\") {\n    invalidMultipleRefs.push(trxRef);\n    invalidErrorObj = {\n      \"errorCode\": ERROR_CODE_MUL_TRX_FOUND,\n      \"errorText\": ERROR_TEXT_MUL_TRX_FOUND.replace(\"{trxNumbers}\", trxRef)\n    };\n  }\n\n  if (invalidErrorObj) {\n    var invalidErrIndex = -1;\n    var ie = 0;\n    for (ie = 0; ie < summaryErrorsByInvoice.length; ie = ie + 1) {\n      if (summaryErrorsByInvoice[ie].invoiceNumber === invalidInv.invoiceNumber) {\n        invalidErrIndex = ie;\n      }\n    }\n    if (invalidErrIndex === -1) {\n      summaryErrorsByInvoice.push({\n        invoiceNumber: invalidInv.invoiceNumber || \"\",\n        errors: [invalidErrorObj]\n      });\n    } else {\n      summaryErrorsByInvoice[invalidErrIndex].errors.push(invalidErrorObj);\n    }\n  }\n}\n\nif (invalidNotFoundRefs.length > 0) {\n  invalidInvoiceErrors.push({\n    \"errorCode\": ERROR_CODE_TRX_NOT_VALID,\n    \"errorText\": ERROR_TEXT_TRX_NOT_VALID.replace(\"{trxNumbers}\", invalidNotFoundRefs.join(\",\"))\n  });\n}\n\nif (invalidMultipleRefs.length > 0) {\n  invalidInvoiceErrors.push({\n    \"errorCode\": ERROR_CODE_MUL_TRX_FOUND,\n    \"errorText\": ERROR_TEXT_MUL_TRX_FOUND.replace(\"{trxNumbers}\", invalidMultipleRefs.join(\",\"))\n  });\n}\n\nif (combinedValidInvoices.length === 0 && invalidInvoicesObject.length > 0) {\n  var invalidReqData = {\n    invalidTransactionReferences: invalidTransactionReferences\n  };\n\n  if (invalidInvoiceErrors.length > 0) {\n    invalidReqData.errors = invalidInvoiceErrors;\n  }\n\n  invalidReqData.summary = {\n    totalInvoices: summaryTotalInvoices,\n    validInvoiceCount: summaryValidInvoiceCount,\n    invalidInvoiceCount: summaryInvalidInvoiceCount,\n    disputedAmountsByCurrency: summaryDisputedAmountsByCurrency,\n    errorsByInvoice: summaryErrorsByInvoice\n  };\n\n  responseList.push({\n    customer: {},\n    customerAccount: {},\n    customerSiteUse: {},\n    customerTransaction: {},\n    businessUnit: {},\n    message: { messageId: messageId },\n    requestData: invalidReqData,\n    responseData: { firstRecord: \"Y\" },\n    intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_DISPUTE_REQUEST\" },\n    processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n  });\n}\n\nvar summaryIndex = firstValidIndex !== -1 ? firstValidIndex : firstErrorIndex;\nif (summaryIndex !== -1 && responseList.length > 0 && !(combinedValidInvoices.length === 0 && invalidInvoicesObject.length > 0)) {\n  responseList[summaryIndex].requestData.summary = {\n    totalInvoices: summaryTotalInvoices,\n    validInvoiceCount: summaryValidInvoiceCount,\n    invalidInvoiceCount: summaryInvalidInvoiceCount,\n    disputedAmountsByCurrency: summaryDisputedAmountsByCurrency,\n    errorsByInvoice: summaryErrorsByInvoice\n  };\n  responseList[summaryIndex].responseData = { firstRecord: \"Y\" };\n  if (summaryValidInvoiceCount > 0 && summaryInvalidInvoiceCount > 0) {\n    responseList[summaryIndex].processingStatus = {\n      lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n      lookupCode: \"ORA_REVIEW_PENDING\"\n    };\n  } else if (summaryValidInvoiceCount === 0 && summaryInvalidInvoiceCount > 0) {\n    responseList[summaryIndex].processingStatus = {\n      lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\",\n      lookupCode: \"ORA_ERROR_REVIEW_PENDING\"\n    };\n  }\n}\n\n// Final output\nvar finalOutput = responseList;\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1772296127541"
          },
          "code": "FIN_IEX_CODE_CONSTRUCT_DISPUTE_PAYLOAD",
          "id": "1771870850360",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Invoice Copy Intent Classification"
          },
          "outcomes": {
            "ACTION_NEW": "1773031099987",
            "default": "1774434471672"
          },
          "code": "FIN_IEX_SWITCH_INVOICE_COPY_INTENT_CLASSIFICATION",
          "convergenceTargetId": "1774434471672",
          "id": "1773030955943",
          "inputs": [
            {
              "id": "1773030955944_1",
              "name": "caseExpression",
              "type": "string",
