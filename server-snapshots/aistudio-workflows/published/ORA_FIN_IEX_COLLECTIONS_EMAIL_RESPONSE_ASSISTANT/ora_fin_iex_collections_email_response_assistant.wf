        {
          "metadata": {
            "name": "Create Payload For Collector Retrieval",
            "returnType": "string",
            "sourceCode": "const personNumber = $context.$nodes.USER_SESSION_TOOL.$output.items[0].PersonNumber;\n\nlet payload = {\n  viewQueries: {\n    CollectionsCollector: {\n      view: \"collectionsCollector\",\n      businessObject: \"Collector\",\n      module: \"oraErpCoreAdvancedCollectionsSetup\",\n      fieldAliases: {\n        \"collectorId\": \"collectorId\",\n        \"employee.effectiveStartDate\": \"effectiveStartDate\",\n        \"employee.effectiveEndDate\": \"effectiveEndDate\",\n        \"employee.id\": \"id\",\n        \"employee.personNumber\": \"personNumber\"\n      }\n    }\n  },\n  parameters: {\n    bindPersonNumber: personNumber\n  },\n  select:\n    \"select collectorId \" +\n    \"from CollectionsCollector \" +\n    \"where sysdate between effectiveStartDate and effectiveEndDate \" +\n    \"and personNumber = :bindPersonNumber\"\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1777971177180"
          },
          "code": "FIN_IEX_CODE_CREATE_PAYLOAD_FOR_COLLECTOR_RETRIEVAL",
          "id": "1777971077808",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
