            "sourceCode": "const array = $context.$nodes.FIN_IEX_LLM_DERIVE_CATEGORY.$output;\n\nconst mappings = {\n\"Valid\": \"ORA_ACTION_PENDING\",\n\"PartialValid\": \"ORA_REVIEW_PENDING\",\n\"Invalid\": \"ORA_ERROR_REVIEW_PENDING\"\n};\nconst status = array && array.length ? array[0] : null;\nconst processingStatusCode = mappings[status];\n\nreturn processingStatusCode;"
