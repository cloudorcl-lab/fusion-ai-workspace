          "code": "FIN_IEX_IF_IDENTIFY_DISPUTE_INTENT",
          "convergenceTargetId": "1772530967212",
          "id": "1774341563015",
          "inputs": [
            {
              "id": "1774341563016_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_CODE_OBTAIN_INTENT.$output.result === 'ORA_DISPUTE_REQUEST'}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Create Fetch Dispute Reason Payload",
            "returnType": "string",
            "sourceCode": "let payload = \"\";\npayload = {\n    \"viewQueries\": {\n        \"receivablesLookups\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"ERPLookupCode\",\n            \"view\": \"lookupList\",\n            \"fieldAliases\": {\n                \"lookupType\": \"lookupType\",\n                \"lookupCode\": \"lookupCode\",\n                \"lookupCategoryId\": \"lookupCategoryId\",\n                \"meaning\": \"meaning\",\n                \"description\": \"description\",\n                \"enabledFlag\": \"enabledFlag\",\n                \"startDateActive\":\"startDateActive\",\n                \"endDateActive\":\"endDateActive\"\n            }\n        },\n        \"collectionsLookups\": {\n            \"module\": \"oraErpCoreCommonObjects\",\n            \"businessObject\": \"ERPLookupCode\",\n            \"view\": \"lookupList\",\n            \"fieldAliases\": {\n                \"lookupType\": \"lookupType\",\n                \"lookupCode\": \"lookupCode\",\n                \"lookupCategoryId\": \"lookupCategoryId\",\n                \"meaning\": \"meaning\",\n                \"description\": \"description\",\n                \"enabledFlag\": \"enabledFlag\",\n                \"startDateActive\":\"startDateActive\",\n                \"endDateActive\":\"endDateActive\"\n            }\n        }\n    },\n    \"select\":\"select receivablesLookups.lookupCode disputeReasonCode, receivablesLookups.meaning disputeReason from receivablesLookups, collectionsLookups where receivablesLookups.lookupCategoryId=222 and receivablesLookups.lookupType='CREDIT_MEMO_REASON' and receivablesLookups.enabledFlag='Y' and trunc(sysdate) between nvl(receivablesLookups.startDateActive, trunc(sysdate)) and nvl(receivablesLookups.endDateActive, trunc(sysdate)) and collectionsLookups.lookupCategoryId(+)=695 and collectionsLookups.lookupType(+)='ORA_CREDIT_REASON_CLOSE_INV' and trunc(sysdate) between nvl(collectionsLookups.startDateActive(+), trunc(sysdate)) and nvl(collectionsLookups.endDateActive(+), trunc(sysdate)) and collectionsLookups.lookupCode(+)=receivablesLookups.lookupCode\" \n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1774463793420"
          },
          "code": "FIN_IEX_CODE_CREATE_FETCH_DISPUTE_REASON_PAYLOAD",
          "id": "1774341697403",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
