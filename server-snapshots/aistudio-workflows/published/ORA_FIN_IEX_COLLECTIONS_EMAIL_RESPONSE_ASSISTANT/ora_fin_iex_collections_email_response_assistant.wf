        {
          "metadata": {
            "name": "Derive Summary Payload",
            "returnType": "string",
            "sourceCode": "const collectorId = $context.$variables.CollectorId;\n\nlet payload = {\n  parameters: {\n    bindCollectorId: collectorId\n  },\n  viewQueries: {\n    CollectionsCustomerMsgDetails: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CollectionsCustomerMessage\",\n      view: \"collectionsCustomerMessageDetails\",\n      fieldAliases: {\n        \"intent.lookupCode\": \"intentCode\",\n        \"customerMessageDetailId\": \"customerMessageDetailId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"customer.id\": \"partyId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"accountSitePurpose.siteUseId\": \"siteUseId\",\n        \"emailMessage.messageId\": \"messageId\",\n        \"requestData\": \"requestData\",\n        \"responseData\": \"responseData\",\n        \"accountSitePurpose.customerAccountSite.customerAccountSiteId\": \"customerAccountSiteId\"\n      }\n    },\n    CustomerBillToAccountSite: {\n      module: \"oraErpCoreCustomerAccountSetup\",\n      businessObject: \"CustomerAccountSite\",\n      view: \"customerBillToAccountSiteList\",\n      fieldAliases: {\n        \"customerAccountSiteId\": \"customerAccountSiteId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerAccount.customer.id\": \"partyId\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.customer.customerProfile.customerAccountProfileId\": \"partyProfile\",\n        \"customerAccount.customer.customerProfile.effectiveStartDate\": \"partyEffectiveStartDate\",\n        \"customerAccount.customer.customerProfile.effectiveEndDate\": \"partyEffectiveEndDate\",\n        \"customerAccount.customer.customerProfile.collector.collectorId\": \"partyCollectorId\",\n        \"customerAccount.customerAccountProfile.customerAccountProfileId\": \"accountProfile\",\n        \"customerAccount.customerAccountProfile.effectiveStartDate\": \"accountEffectiveStartDate\",\n        \"customerAccount.customerAccountProfile.effectiveEndDate\": \"accountEffectiveEndDate\",\n        \"customerAccount.customerAccountProfile.collector.collectorId\": \"accountCollectorId\",\n        \"billToAccountSitePurpose.siteUseId\": \"siteUseId\",\n        \"billToAccountSitePurpose.customerSiteProfile.customerAccountProfileId\": \"siteProfile\",\n        \"billToAccountSitePurpose.customerSiteProfile.effectiveStartDate\": \"siteEffectiveStartDate\",\n        \"billToAccountSitePurpose.customerSiteProfile.effectiveEndDate\": \"siteEffectiveEndDate\",\n        \"billToAccountSitePurpose.customerSiteProfile.collector.collectorId\": \"siteCollectorId\"\n      }\n    }\n  },\n    select:\n    \"select NVL(SUM(CASE WHEN t.processingStatusCode in ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING','ORA_ERROR_REVIEW_PENDING') THEN 1 ELSE 0 END),0) AS UnprocessedEmailCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ACTION_PENDING' THEN 1 ELSE 0 END), 0) AS ActionPendingCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ACTION_PENDING' AND t.intentCode = 'ORA_PROMISE_TO_PAY' THEN 1 ELSE 0 END), 0) AS PromiseToPayCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ACTION_PENDING' AND t.intentCode = 'ORA_DISPUTE_REQUEST' THEN 1 ELSE 0 END), 0) AS DisputeRequestCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ACTION_PENDING' AND t.intentCode = 'ORA_INVOICE_REPRINT' THEN 1 ELSE 0 END), 0) AS InvoiceReprintCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ACTION_PENDING' AND t.intentCode = 'ORA_PO_UPDATE' THEN 1 ELSE 0 END), 0) AS PoUpdateCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_REVIEW_PENDING' THEN 1 ELSE 0 END), 0) AS ReviewPendingCount, \" +\n    \"NVL(SUM(CASE WHEN t.processingStatusCode = 'ORA_ERROR_REVIEW_PENDING' THEN 1 ELSE 0 END), 0) AS ErrorReviewCount \" +\n    \"from ( \" +\n    \"select ccmd.intentCode, ccmd.processingStatusCode, \" +\n    \"CASE \" +\n    \"WHEN cbas.siteCollectorId = :bindCollectorId AND cbas.siteCollectorId <> 1 AND SYSDATE BETWEEN cbas.siteEffectiveStartDate AND cbas.siteEffectiveEndDate THEN 1 \" +\n    \"WHEN (cbas.siteCollectorId IS NULL OR cbas.siteCollectorId = 1) AND cbas.accountCollectorId = :bindCollectorId AND cbas.accountCollectorId <> 1 AND SYSDATE BETWEEN cbas.accountEffectiveStartDate AND cbas.accountEffectiveEndDate THEN 2 \" +\n    \"WHEN (cbas.siteCollectorId IS NULL OR cbas.siteCollectorId = 1) AND (cbas.accountCollectorId IS NULL OR cbas.accountCollectorId = 1) AND cbas.partyCollectorId = :bindCollectorId AND cbas.partyCollectorId <> 1 AND SYSDATE BETWEEN cbas.partyEffectiveStartDate AND cbas.partyEffectiveEndDate THEN 3 \" +\n    \"END AS match_level \" +\n    \"from CollectionsCustomerMsgDetails ccmd, CustomerBillToAccountSite cbas \" +\n    \"where ccmd.partyId = cbas.partyId \" +\n    \"and ccmd.customerAccountId = cbas.customerAccountId \" +\n    \"and ccmd.customerAccountSiteId = cbas.customerAccountSiteId \" +\n    \"and ccmd.intentCode in ('ORA_PROMISE_TO_PAY','ORA_DISPUTE_REQUEST','ORA_PO_UPDATE','ORA_INVOICE_REPRINT') \" +\n    \"and ccmd.responseData LIKE '%firstRecord%' \" +\n    \") t \" +\n    \"where t.match_level IS NOT NULL\"\n};\n\nreturn JSON.stringify(payload);"
          },
          "outcomes": {
            "success": "1772342275215"
          },
          "code": "FIN_IEX_CODE_DERIVE_SUMMARY_PAYLOAD",
          "id": "1774518500573",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
