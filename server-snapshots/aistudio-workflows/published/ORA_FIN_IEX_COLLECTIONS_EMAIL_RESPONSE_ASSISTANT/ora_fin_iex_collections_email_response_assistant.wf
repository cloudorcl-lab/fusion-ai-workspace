        {
          "metadata": {
            "name": "Remove Error Dispute Requests",
            "returnType": "array",
            "sourceCode": "const arr = $context.$variables.FilteredMessageDetailsArray; \n\nconst errorRaw = $context.$nodes.FIN_IEX_CODE_EXTRACT_DISPUTE_ERROR.$output.result;\n\n// normalize errorRaw to an array\nconst errors = Array.isArray(errorRaw)\n  ? errorRaw\n  : (errorRaw ? [errorRaw] : []);\n\n// optionally build a fast lookup set\nconst errorIds = new Set(errors.map(e => e.messageDetailId).filter(Boolean));\n\n\nconst filteredArr = arr.filter(item => !errorIds.has(item.CUSTOMERMESSAGEDETAILID));\n\nreturn filteredArr;"
          },
          "outcomes": {
            "success": "1774416156552"
          },
