        {
          "metadata": {
            "name": "Construct Requests for Invalid Transactions",
            "returnType": "array",
            "sourceCode": "// --------- Error code variables ---------\nlet ERROR_CODE_PROMISE_DATE_MISSING = \"PROMISE_DATE_MISSING\";\nlet ERROR_CODE_INVOICE_NOT_FOUND = \"INVOICE_NOT_FOUND\";\nlet ERROR_CODE_MULTIPLE_INVOICES_FOUND = \"MULTIPLE_INVOICES_FOUND\";\n\n// --------- Error Text Variables ---------\nlet ERROR_TEXT_PROMISE_DATE_MISSING = \"Promise date is missing at both header and invoice level for transaction number {trxNumber}.\";\nlet ERROR_TEXT_INVOICE_NOT_FOUND = \"Invoice number {trxNumber} is either incorrect or not present in the system.\";\nlet ERROR_TEXT_MULTIPLE_INVOICES_FOUND = \"Transaction number {trxNumber} has multiple invoices associated.\";\n\n// --------- Data Extraction ---------\nlet pMessageId = $context.$variables.messageId;\nlet validatedPromisesTransactions = $context.$nodes.FIN_IEX_CODE_FILTER_VALID_TRANSACTIONS.$output.result;\nlet invalidInvoicesArr = validatedPromisesTransactions.invalidInvoicesObject.promise.invoices;\nlet invalidTransactionNumbersArr = [];\nfor (let i = 0; i < invalidInvoicesArr.length; i++) {\n  if (invalidInvoicesArr[i].invoiceNumber)\n    invalidTransactionNumbersArr.push(invalidInvoicesArr[i].invoiceNumber);\n}\nlet invalidTransactionNumbers = invalidTransactionNumbersArr.join(\",\");\nlet validTransactionNumbers = \"\"; // Always blank for this flow\nlet totalPromiseAmount = Number(validatedPromisesTransactions.invalidInvoicesObject.promise.totalPromiseAmount || 0);\nlet promiseDate = validatedPromisesTransactions.invalidInvoicesObject.promise.promiseDate || \"\";\n\nlet statusActionPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ACTION_PENDING\" };\nlet statusReviewPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_REVIEW_PENDING\" };\nlet statusErrorReviewPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" };\n\n// --------- Error Arrays ---------\nlet errors = [];\nlet errorsByInvoiceMap = {};\n\nfor (let i = 0; i < invalidInvoicesArr.length; i++) {\n    let inv = invalidInvoicesArr[i] || {};\n    let code = \"\";\n    let errorText = \"\";\n    let invoiceRef = inv.invoiceNumber || \"\";\n\n    if (!errorsByInvoiceMap[invoiceRef]) {\n      errorsByInvoiceMap[invoiceRef] = [];\n    }\n\n    if (!inv.invoiceNumber || inv.invoiceNumber === \"\") {\n        code = ERROR_CODE_INVOICE_NOT_FOUND;\n        errorText = ERROR_TEXT_INVOICE_NOT_FOUND.replace(new RegExp(\"\\\\{trxNumber\\\\}\", \"g\"), \"\");\n    } else if (inv.TransactionStatus && inv.TransactionStatus === \"MULTIPLE_INVOICES_FOUND\") {\n        code = ERROR_CODE_MULTIPLE_INVOICES_FOUND;\n        errorText = ERROR_TEXT_MULTIPLE_INVOICES_FOUND.replace(new RegExp(\"\\\\{trxNumber\\\\}\", \"g\"), String(invoiceRef));\n    } else {\n        // General INVOICE_NOT_FOUND if not explicitly MULTIPLE_INVOICES_FOUND\n        code = ERROR_CODE_INVOICE_NOT_FOUND;\n        errorText = ERROR_TEXT_INVOICE_NOT_FOUND.replace(new RegExp(\"\\\\{trxNumber\\\\}\", \"g\"), String(invoiceRef));\n    }\n\n    let errObj = {\n        errorCode: code,\n        errorText: errorText\n    };\n    errors.push(errObj);\n    errorsByInvoiceMap[invoiceRef].push(errObj);\n}\n\nlet errorsByInvoice = [];\nfor (let invoiceNum in errorsByInvoiceMap) {\n  if (errorsByInvoiceMap.hasOwnProperty(invoiceNum)) {\n    errorsByInvoice.push({\n      invoiceNumber: invoiceNum,\n      errors: errorsByInvoiceMap[invoiceNum]\n    });\n  }\n}\n\nif (!promiseDate) {\n  errors.push({\n    errorCode: ERROR_CODE_PROMISE_DATE_MISSING,\n    errorText: ERROR_TEXT_PROMISE_DATE_MISSING.replace(new RegExp(\"\\\\{trxNumber\\\\}\", \"g\"), invalidTransactionNumbers || \"\")\n  });\n}\n\n// Build summary, add errorCode array if promiseDate is missing\nlet summaryObj = {\n  promiseDate: promiseDate,\n  invoiceCount: validatedPromisesTransactions.invalidInvoiceCount,\n  valid: validatedPromisesTransactions.validInvoiceCount,\n  invalid: validatedPromisesTransactions.invalidInvoiceCount,\n  totalPromisedAmount: totalPromiseAmount,\n  currency: validatedPromisesTransactions.invalidInvoicesObject.promise.promiseCurrency,\n  transactionSummary: {\n    valid: validTransactionNumbers,\n    invalid: invalidTransactionNumbers\n  },\n  errors: errors,\n  errorsByInvoice: errorsByInvoice\n};\n\nlet summaryValid = Number(validatedPromisesTransactions.validInvoiceCount || 0);\nlet summaryInvalid = Number(validatedPromisesTransactions.invalidInvoiceCount || 0);\nlet processingStatus = statusErrorReviewPending;\nif (summaryValid > 0 && summaryInvalid > 0) {\n  processingStatus = statusReviewPending;\n} else if (summaryValid > 0 && summaryInvalid === 0) {\n  processingStatus = statusActionPending;\n}\n\nlet reqObj = {\n  message: { messageId: pMessageId },\n  requestData: {\n    summary: summaryObj,\n    originalPromiseTransactionRequest: validatedPromisesTransactions,\n    actionablePayload: {}\n  },\n  responseData: { firstRecord: \"Y\" },\n  intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PROMISE_TO_PAY\" },\n  processingStatus: processingStatus\n};\nlet requestPayload = [ reqObj ];\n\nreturn requestPayload;"
