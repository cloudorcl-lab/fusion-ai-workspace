        {
          "metadata": {
            "name": "Flatten Promised Installments with Duplicate Check",
            "returnType": "object",
            "sourceCode": "var rawResults = $context.$nodes.FIN_IEX_LOOP_ITERATE_PROMISED_INSTALLMENTS_TO_CHECK_EXISTING_PROMISES.$output;\n\nvar flattened = [];\nvar i = 0;\n\nif (Array.isArray(rawResults)) {\n  for (i = 0; i < rawResults.length; i = i + 1) {\n    var item = rawResults[i];\n    var parsed = item;\n\n    try {\n      if (typeof item === \"string\") {\n        parsed = JSON.parse(item);\n      }\n    } catch (e) {\n      parsed = null;\n    }\n\n    if (!parsed) {\n      continue;\n    }\n\n    if (Array.isArray(parsed)) {\n      var j = 0;\n      for (j = 0; j < parsed.length; j = j + 1) {\n        var arrItem = parsed[j];\n        if (arrItem && arrItem.result) {\n          flattened.push(arrItem.result);\n        } else if (arrItem) {\n          flattened.push(arrItem);\n        }\n      }\n    } else if (parsed.result) {\n      flattened.push(parsed.result);\n    } else {\n      flattened.push(parsed);\n    }\n  }\n} else if (typeof rawResults === \"string\") {\n  try {\n    var parsedSingle = JSON.parse(rawResults);\n    if (Array.isArray(parsedSingle)) {\n      for (i = 0; i < parsedSingle.length; i = i + 1) {\n        var singleArrItem = parsedSingle[i];\n        if (singleArrItem && singleArrItem.result) {\n          flattened.push(singleArrItem.result);\n        } else if (singleArrItem) {\n          flattened.push(singleArrItem);\n        }\n      }\n    } else if (parsedSingle && parsedSingle.result) {\n      flattened.push(parsedSingle.result);\n    } else if (parsedSingle) {\n      flattened.push(parsedSingle);\n    }\n  } catch (e2) {\n    flattened = [];\n  }\n} else if (rawResults && typeof rawResults === \"object\") {\n  if (rawResults.result) {\n    flattened.push(rawResults.result);\n  } else {\n    flattened.push(rawResults);\n  }\n}\n\nreturn flattened;"
          },
