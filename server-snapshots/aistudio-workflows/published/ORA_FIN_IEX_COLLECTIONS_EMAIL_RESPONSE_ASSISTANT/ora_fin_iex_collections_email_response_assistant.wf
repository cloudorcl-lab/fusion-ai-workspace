          "code": "FIN_IEX_IF_CHECK_FOR_ERROR_STATUS",
          "convergenceTargetId": "1772104500335",
          "id": "1773643773167",
          "inputs": [
            {
              "id": "1773643773169_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_BO_CREATE_PROMISES.$status === \"failure\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Extract Promise Error",
            "returnType": "array",
            "sourceCode": "let errorInfo=$context.$nodes.FIN_IEX_BO_CREATE_PROMISES.$error.$info;\nconst messageDetailArray=$context.$nodes.FIN_IEX_BO_OBTAIN_PROMISE_DETAILS.$output||[];\n\nfunction parseJsonObject(value){\n  if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n  if(typeof value===\"string\"){\n    const s=value.trim();\n    if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n      try{\n        const parsed=JSON.parse(s);\n        return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n      }catch(e){\n        return {};\n      }\n    }\n  }\n\n  return {};\n}\n\nif(typeof errorInfo===\"string\"){\n  errorInfo=parseJsonObject(errorInfo);\n}\n\nlet resultObj=(errorInfo&&errorInfo.result!=null)?errorInfo.result:errorInfo;\n\nif(typeof resultObj===\"string\"){\n  resultObj=parseJsonObject(resultObj);\n}\n\nconst errorDetails=resultObj[\"o:errorDetails\"]||[];\n\nconst parts=errorDetails.map((error)=>{\n  const path=error[\"o:errorPath\"]||\"\";\n  const m=path.match(/\\/parts\\/(\\d+)\\/payload/);\n  const partIndex=m?parseInt(m[1],10):null;\n\n  return{\n    index:partIndex,\n    errorCode:error[\"o:errorCode\"],\n    detail:error[\"detail\"]\n  };\n});\n\nreturn parts.map((item)=>{\n  const messageDetail=item.index!=null?messageDetailArray[item.index]||{}:{};\n  const requestData=parseJsonObject(messageDetail.REQUESTDATA);\n  const existingResponseData=parseJsonObject(\n    messageDetail.responseData||messageDetail.RESPONSEDATA\n  );\n\n  return{\n    messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID||null,\n    responseData:{\n      ...existingResponseData,\n      TransactionNumber:requestData.actionablePayload?requestData.actionablePayload.TransactionNumber:null,\n      TransactionDate:requestData.actionablePayload?requestData.actionablePayload.TransactionDate:null,\n      PromiseDate: requestData.actionablePayload?requestData.actionablePayload.PromiseDate:null,\n       PromiseAmount: requestData.actionablePayload ? (requestData.actionablePayload.PromiseAmount ? requestData.actionablePayload.PromiseAmount : requestData.actionablePayload.PromiseBalanceAmount == 'Y' ? 'FULL' : null) : null,\n      Currency: requestData.actionablePayload?requestData.actionablePayload.Currency:null,\n      PartyName: messageDetail.partyName,\n      AccountNumber: messageDetail.accountNumber,\n      Site: messageDetail.site,\n      errorCode:item.errorCode,\n      detail:item.detail,\n      MessageId: messageDetail.messageId\n    },\n    processingStatusCode:\"ORA_PROCESSING_ERROR\"\n  };\n});"
          },
          "outcomes": {
            "success": "1773760697829"
          },
          "code": "FIN_IEX_CODE_EXTRACT_PROMISE_ERROR",
          "id": "1773644316592",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Remove Error Promise Requests",
            "returnType": "array",
            "sourceCode": "const arr = $context.$nodes.FIN_IEX_BO_OBTAIN_PROMISE_DETAILS.$output;\n\nconst errorRaw = $context.$nodes.FIN_IEX_CODE_EXTRACT_PROMISE_ERROR.$output.result;\n\n\n// normalize errorRaw to an array\nconst errors = Array.isArray(errorRaw)\n  ? errorRaw\n  : (errorRaw ? [errorRaw] : []);\n\n// optionally build a fast lookup set\nconst errorIds = new Set(errors.map(e => e?.messageDetailId).filter(Boolean));\n\nconst filteredArr = arr.filter(item => !errorIds.has(item?.CUSTOMERMESSAGEDETAILID));\n\nreturn filteredArr;"
          },
          "outcomes": {
            "success": "1773761367636"
          },
