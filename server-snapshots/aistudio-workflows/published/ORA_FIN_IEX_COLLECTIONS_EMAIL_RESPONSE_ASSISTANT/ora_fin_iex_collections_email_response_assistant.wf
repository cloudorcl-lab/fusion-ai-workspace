        {
          "metadata": {
            "name": "Filter Valid Dispute Transactions",
            "returnType": "object",
            "sourceCode": "const rawInvoices = $context.$nodes.FIN_IEX_LOOP_ITERATE_EXTRACTED_DISPUTE_TRANSACTIONS.$output || [];\n\nvar validInvoiceCount = 0;\nvar invalidInvoiceCount = 0;\nvar validInvoicesObject = [];\nvar headerLevelValidInvoiceObject = [];\nvar lineLevelValidInvoiceObject = [];\nvar invalidInvoicesObject = [];\n\nfor (var i = 0; i < rawInvoices.length; i++) {\n    var parsedObj = JSON.parse(rawInvoices[i]);\n    var invoice = parsedObj.result;\n\n    if (invoice.TransactionStatus === \"VALID\") {\n        validInvoiceCount++;\n        validInvoicesObject.push(invoice);\n\n        if (invoice.disputeSectionCode === \"SPECIFIC_INVOICE_LINES\") {\n            lineLevelValidInvoiceObject.push(invoice);\n        } else {\n            headerLevelValidInvoiceObject.push(invoice);\n        }\n    } else {\n        invalidInvoiceCount++;\n        invalidInvoicesObject.push(invoice);\n    }\n}\n\nvar result = {\n    validInvoiceCount: validInvoiceCount,\n    invalidInvoiceCount: invalidInvoiceCount,\n    validInvoicesObject: validInvoicesObject,\n    headerLevelValidInvoiceObject: headerLevelValidInvoiceObject,\n    lineLevelValidInvoiceObject: lineLevelValidInvoiceObject,\n    invalidInvoicesObject: invalidInvoicesObject\n};\nreturn result;"
          },
