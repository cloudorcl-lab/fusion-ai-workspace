                    "sourceCode": "const output = $context.$nodes.FIN_IEX_LOOP_UPDATE_DISPUTE_ACTION_OUTPUT.$currentItem; \nconst { messageDetailId, responseData, processingStatusCode } = output;\n\n  const updatePayload = {\n    responseData : JSON.stringify(responseData),\n    processingStatus: {\n    lookupCode: processingStatusCode // e.g. \"ORA_PROCESSING_ERROR\"\n  }\n  };\n\n  const updatePayloadString = JSON.stringify(updatePayload);\n  const getVersion = $context.$nodes.FIN_IEX_LOOP_UPDATE_DISPUTE_ACTION_OUTPUT.FIN_IEX_BO_GET_DISPUTES_OBJECT_VERSION_NUMBER.$output; \nconst etag='\"'+String(getVersion.$context.etag)+'\"';\n\n  const obj = {\n    messageDetailId: messageDetailId,\n    updatePayload: updatePayloadString,\n    etag: etag\n  };\n\n  return obj;"
