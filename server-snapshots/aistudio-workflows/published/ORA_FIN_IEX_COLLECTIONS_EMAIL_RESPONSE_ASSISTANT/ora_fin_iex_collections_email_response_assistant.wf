        {
          "metadata": {
            "name": "Construct Payload for Missing PO Update Information",
            "returnType": "object",
            "sourceCode": "var messageId = $context.$variables.messageId;\nvar poUpdateExtracted = $context.$variables.poUpdateExtracted || {};\nvar invalidTransactionReferences = [];\nvar summaryErrorsByInvoice = [];\nvar summaryTotalInvoices = 0;\nvar summaryValidInvoiceCount = 0;\nvar summaryInvalidInvoiceCount = 0;\n\n/*\n  Error definitions\n*/\nvar ERROR_CODE_TRX_NOT_IDENTIFIED = \"EMAIL_AGENT_PO_UPDATE_TRX_NOT_IDENTIFIED\";\nvar ERROR_TEXT_TRX_NOT_IDENTIFIED = \"No invoice number or supported transaction reference could be identified from the customer PO update request.\";\n\n/*\n  Build invalid reference placeholders from extracted request if available\n*/\nvar requests = [];\nif (poUpdateExtracted && poUpdateExtracted.poUpdate && poUpdateExtracted.poUpdate.invoices) {\n  requests = poUpdateExtracted.poUpdate.invoices;\n}\n\nvar i = 0;\nfor (i = 0; i < requests.length; i = i + 1) {\n  var req = requests[i] || {};\n  var trxRef = req.invoiceNumber || req.purchaseOrderNumber || req.purchaseOrderNumberToUpdate || req.salesOrderNumber || req.contractNumber || req.waybillNumber || req.transactionIdentifier || \"\";\n  if (trxRef !== \"\" && invalidTransactionReferences.indexOf(trxRef) === -1) {\n    invalidTransactionReferences.push(trxRef);\n  }\n}\n\nsummaryTotalInvoices = requests.length > 0 ? requests.length : 1;\nsummaryInvalidInvoiceCount = summaryTotalInvoices;\n\nsummaryErrorsByInvoice.push({\n  invoiceNumber: \"\",\n  errors: [{\n    errorCode: ERROR_CODE_TRX_NOT_IDENTIFIED,\n    errorText: ERROR_TEXT_TRX_NOT_IDENTIFIED\n  }]\n});\n\nvar result = [{\n  customer: {},\n  customerAccount: {},\n  customerSiteUse: {},\n  customerTransaction: {},\n  paymentSchedule: {},\n  businessUnit: {},\n  message: { messageId: messageId },\n  requestData: {\n    invalidTransactionReferences: invalidTransactionReferences,\n    errors: [{\n      errorCode: ERROR_CODE_TRX_NOT_IDENTIFIED,\n      errorText: ERROR_TEXT_TRX_NOT_IDENTIFIED\n    }],\n    summary: {\n      totalInvoices: summaryTotalInvoices,\n      validInvoiceCount: summaryValidInvoiceCount,\n      invalidInvoiceCount: summaryInvalidInvoiceCount,\n      amountsByCurrency: [],\n      errorsByInvoice: summaryErrorsByInvoice,\n      validTransactions: []\n    }\n  },\n  responseData: { firstRecord: \"Y\" },\n  intent: { lookupType: \"ORA_IEX_MSG_INTENT\", lookupCode: \"ORA_PO_UPDATE_REQUEST\" },\n  processingStatus: { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" }\n}];\n\nresult;"
          },
