                  },
                  "id": "start_1774276471740",
                  "code": "START_1774276471740",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "Fetch Customer Transaction Identifier for PO Update",
                    "returnType": "object",
                    "sourceCode": "var currentItem = $context.$nodes.FIN_IEX_LOOP_ITERATE_TRANSACTIONS_FOR_VALID_PO_UPDATE.$currentItem || {};\nvar customerTransactionId = currentItem.customerTransactionId || null;\nvar installmentNumber = currentItem.installmentNumber || null;\n\nvar parameters = {\n  bindCustomerTransactionId: customerTransactionId\n};\n\n/* This dynamic filter will normally not be applicable for PO update since PO is at transaction level,\n   but retained for compatibility if installmentNumber is present */\nvar dynamicFilter = \"\";\nif (installmentNumber !== null && installmentNumber !== undefined && installmentNumber !== \"\") {\n  parameters.bindInstallmentNumber = installmentNumber;\n  dynamicFilter = dynamicFilter + \" and receivablesPaymentSchedule.installmentNumber = :bindInstallmentNumber\";\n}\n\nvar result = {\n  parameters: parameters,\n  viewQueries: {\n    receivablesPaymentSchedule: {\n      view: \"receivablesPaymentSchedule\",\n      businessObject: \"ReceivablesTransactionPaymentSchedule\",\n      module: \"oraErpCoreReceivablesBilling\",\n      fieldAliases: {\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"customerTransaction.customerTransactionReference\": \"customerTransactionReference\",\n        \"customerTransaction.customerTransactionType.name\": \"customerTransactionType\",\n        \"customerTransaction.customerTransactionType.customerTransactionTypeSequenceId\": \"customerTransactionTypeSequenceId\",\n        \"customerTransaction.fOB\": \"fOB\",\n        \"customerTransaction.pONumber\": \"purchaseOrderNumber\",\n        \"customerTransaction.pODate\": \"purchaseOrderDate\",\n        \"customerTransaction.shippingReference\": \"wayBillNumber\",\n        \"customerTransaction.billTemplateName\": \"billTemplateName\",\n        \"customerTransaction.businessUnit.id\": \"businessUnitId\",\n        \"customerTransaction.businessUnit.name\": \"businessUnit\",\n        \"customerTransaction.batchSource.name\": \"customerTransactionSource\",\n        \"customerTransaction.generateBill\": \"generateBill\",\n        \"customerTransaction.paymentTerm.termId\": \"termId\",\n        \"invoiceCurrency.currencyCode\": \"currencyCode\",\n        \"receivablesSystemOption.ledger.currency.currencyCode\": \"ledgerCurrency\",\n        \"receivablesSystemOption.ledger.currency.precision\": \"ledgerCurrencyPrecision\",\n        \"amountRemaining\": \"amountRemaining\",\n        \"installmentStatus\": \"installmentStatus\",\n        \"installmentDueDate\": \"installmentDueDate\",\n        \"transactionNumber\": \"transactionNumber\",\n        \"transactionDate\": \"transactionDate\",\n        \"conversionRate\": \"conversionRate\",\n        \"originalAmount\": \"originalAmount\",\n        \"paymentScheduleId\": \"paymentScheduleId\",\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"customerAccount.customer.id\": \"partyId\",\n        \"customerAccount.customer.name\": \"partyName\",\n        \"customerAccount.accountNumber\": \"accountNumber\",\n        \"customerSiteUse.siteUseId\": \"siteUseId\",\n        \"overdueFlag\": \"overdueFlag\",\n        \"accountedBalanceDue\": \"accountedBalanceDue\",\n        \"sequence\": \"installmentNumber\",\n        \"installmentClass\": \"installmentClass\"\n      }\n    },\n    collectionsCustomerMessageDetails: {\n      view: \"collectionsCustomerMessageDetails\",\n      businessObject: \"CollectionsCustomerMessage\",\n      module: \"oraErpCoreAdvancedCollections\",\n      fieldAliases: {\n        \"paymentSchedule.paymentScheduleId\": \"paymentScheduleId\",\n        \"customerTransaction.customerTransactionId\": \"customerTransactionId\",\n        \"processingStatus.lookupCode\": \"processingStatusCode\",\n        \"intent.lookupCode\": \"intentCode\",\n        \"requestData\": \"requestData\"\n      }\n    },\n    customerAccountProfileDetail: {\n      view: \"customerAccountProfileDetail\",\n      businessObject: \"CustomerProfile\",\n      module: \"oraErpCoreCustomerAccountSetup\",\n      fieldAliases: {\n        \"customerAccount.customerAccountId\": \"customerAccountId\",\n        \"transactionDeliveryMethod\": \"transactionDeliveryMethod\",\n        \"effectiveStartDate\": \"effectiveStartDate\",\n        \"effectiveEndDate\": \"effectiveEndDate\"\n      }\n    },\n    customerBillToSiteProfileDetail: {\n      view: \"customerBillToSiteProfileDetail\",\n      businessObject: \"CustomerProfile\",\n      module: \"oraErpCoreCustomerAccountSetup\",\n      fieldAliases: {\n        \"customerSiteUse.siteUseId\": \"siteUseId\",\n        \"transactionDeliveryMethod\": \"transactionDeliveryMethod\",\n        \"effectiveStartDate\": \"effectiveStartDate\",\n        \"effectiveEndDate\": \"effectiveEndDate\"\n      }\n    }\n  },\n  select: \"select receivablesPaymentSchedule.customerTransactionId, \" +\n    \"receivablesPaymentSchedule.customerTransactionReference, \" +\n    \"receivablesPaymentSchedule.customerTransactionType, \" +\n    \"receivablesPaymentSchedule.customerTransactionTypeSequenceId, \" +\n    \"to_char(receivablesPaymentSchedule.installmentDueDate,'YYYY-MM-DD') dueDate, \" +\n    \"receivablesPaymentSchedule.fOB, \" +\n    \"receivablesPaymentSchedule.purchaseOrderNumber, \" +\n    \"to_char(receivablesPaymentSchedule.purchaseOrderDate,'YYYY-MM-DD') purchaseOrderDate, \" +\n    \"receivablesPaymentSchedule.wayBillNumber, \" +\n    \"receivablesPaymentSchedule.billTemplateName, \" +\n    \"receivablesPaymentSchedule.generateBill, \" +\n    \"receivablesPaymentSchedule.businessUnitId, \" +\n    \"receivablesPaymentSchedule.businessUnit, \" +\n    \"receivablesPaymentSchedule.customerTransactionSource, \" +\n    \"receivablesPaymentSchedule.currencyCode, \" +\n    \"receivablesPaymentSchedule.ledgerCurrency, \" +\n    \"receivablesPaymentSchedule.ledgerCurrencyPrecision, \" +\n    \"receivablesPaymentSchedule.amountRemaining, \" +\n    \"receivablesPaymentSchedule.installmentStatus, \" +\n    \"to_char(receivablesPaymentSchedule.installmentDueDate,'YYYY-MM-DD') installmentDueDate, \" +\n    \"receivablesPaymentSchedule.transactionNumber, \" +\n    \"to_char(receivablesPaymentSchedule.transactionDate,'YYYY-MM-DD') transactionDate, \" +\n    \"receivablesPaymentSchedule.conversionRate, \" +\n    \"receivablesPaymentSchedule.originalAmount, \" +\n    \"receivablesPaymentSchedule.paymentScheduleId, \" +\n    \"receivablesPaymentSchedule.customerAccountId, \" +\n    \"receivablesPaymentSchedule.partyId, \" +\n    \"receivablesPaymentSchedule.partyName, \" +\n    \"receivablesPaymentSchedule.accountNumber, \" +\n    \"receivablesPaymentSchedule.siteUseId, \" +\n    \"receivablesPaymentSchedule.overdueFlag, \" +\n    \"receivablesPaymentSchedule.accountedBalanceDue, \" +\n    \"receivablesPaymentSchedule.installmentNumber, \" +\n    \"receivablesPaymentSchedule.installmentClass, \" +\n    \"(SELECT COUNT(1) FROM collectionsCustomerMessageDetails where receivablesPaymentSchedule.customerTransactionId = collectionsCustomerMessageDetails.customerTransactionId and collectionsCustomerMessageDetails.intentCode = 'ORA_PO_UPDATE' and collectionsCustomerMessageDetails.processingStatusCode IN ('ORA_ACTION_PENDING','ORA_REVIEW_PENDING')) duplicateCount, \" +\n    \"customerAccountProfileDetail.transactionDeliveryMethod accountTransactionDeliveryMethod, \" +\n    \"customerBillToSiteProfileDetail.transactionDeliveryMethod siteTransactionDeliveryMethod \" +\n    \"from receivablesPaymentSchedule, customerAccountProfileDetail, customerBillToSiteProfileDetail \" +\n    \"where receivablesPaymentSchedule.installmentStatus = 'OP' \" +\n    \"and receivablesPaymentSchedule.CUSTOMERTRANSACTIONID = :bindCustomerTransactionId \" +\n    \"and customerAccountProfileDetail.customerAccountId = receivablesPaymentSchedule.customerAccountId \" +\n    \"and trunc(receivablesPaymentSchedule.transactionDate) between customerAccountProfileDetail.effectiveStartDate and nvl(customerAccountProfileDetail.effectiveEndDate, sysdate) \" +\n    \"and customerBillToSiteProfileDetail.siteUseId(+) = receivablesPaymentSchedule.siteUseId \" +\n    \"and trunc(receivablesPaymentSchedule.transactionDate) >= customerBillToSiteProfileDetail.effectiveStartDate(+) \" +\n    \"and trunc(receivablesPaymentSchedule.transactionDate) <= customerBillToSiteProfileDetail.effectiveEndDate(+) \" +\n    dynamicFilter +\n    \" order by receivablesPaymentSchedule.installmentDueDate\"\n};\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1774282402838"
                  },
                  "diagram": {
                    "x": 9513.5,
                    "y": 11549
                  },
                  "code": "FIN_IEX_CODE_FETCH_CUSTOMER_TRANSACTION_IDENTIFIER_FOR_PO_UPDATE",
                  "id": "1774281991071",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
