        {
          "metadata": {
            "name": "Evaluate Partial Valid Error Show More Pagination",
            "returnType": "object",
            "sourceCode": "const data = $context.$variables.FilteredMessageDetailsArray;\nconst pagination = $context.$variables.PaginationVariables; \nconst prevIntent = $context.$variables.PreviousIntent;\n\nlet newPage = pagination.page;\n\nif (prevIntent != null && prevIntent !== \"\") {\n  newPage = pagination.page + 1;\n}\n \nconst newPagination = {\n  pageSize: pagination.pageSize,\n  page: newPage,\n  start: (newPage  - 1) * pagination.pageSize + 1,\n  end: Math.min(newPage  * pagination.pageSize, data.length)\n};\n\nreturn newPagination;"
          },
          "outcomes": {
            "success": "1777958559299"
          },
          "code": "FIN_IEX_CODE_EVALUATE_PARTIAL_VALID_ERROR_SHOW_MORE_PAGINATION",
          "id": "1777958410318",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
