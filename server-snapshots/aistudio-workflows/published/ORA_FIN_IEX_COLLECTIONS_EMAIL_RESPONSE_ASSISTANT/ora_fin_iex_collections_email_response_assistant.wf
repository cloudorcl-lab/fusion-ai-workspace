                {
                  "metadata": {
                    "name": "Check Dispute Transaction Status",
                    "returnType": "object",
                    "sourceCode": "// Retain test data and structure as is.\nconst transactionDetail = $context.$nodes.FIN_IEX_LOOP_ITERATE_EXTRACTED_DISPUTE_TRANSACTIONS.FIN_IEX_BO_VALIDATE_DISPUTE_TRANSACTION.$output || [];\n\nconst currentInvoice = $context.$nodes.FIN_IEX_LOOP_ITERATE_EXTRACTED_DISPUTE_TRANSACTIONS.$currentItem || {};\n\n// Add TransactionStatus and customerTransactionId based on transactionDetail length\nif (Array.isArray(transactionDetail) && transactionDetail.length === 1) {\n    currentInvoice.TransactionStatus = \"VALID\";\n    // Add customerTransactionId from first detail, fallback to null if not present\n    currentInvoice.customerTransactionId = transactionDetail[0].CUSTOMERTRANSACTIONID || null;\n    currentInvoice.accountNumber= transactionDetail[0].ACCOUNTNUMBER || null;\n    currentInvoice.currencyCode = transactionDetail[0].CURRENCYCODE|| null;\n    currentInvoice.amountRemaining = transactionDetail[0].AMOUNTREMAINING || null;\n\n    // Add newly added attributes for valid transactions\n    currentInvoice.businessUnitId = transactionDetail[0].BUSINESSUNITID || null;\n    currentInvoice.customerAccountId = transactionDetail[0].CUSTOMERACCOUNTID || null;\n    currentInvoice.siteUseId = transactionDetail[0].SITEUSEID || null;\n    currentInvoice.partyId = transactionDetail[0].PARTYID || null;\n\n    currentInvoice.freightBalanceDue = transactionDetail[0].FREIGHTBALANCEDUE || null;\n    currentInvoice.taxRemainingAmount = transactionDetail[0].TAXREMAININGAMOUNT || null;\n    currentInvoice.lineItemRemainingAmount = transactionDetail[0].LINEITEMREMAININGAMOUNT || null;\n    \n} else if (Array.isArray(transactionDetail) && transactionDetail.length === 0) {\n    currentInvoice.TransactionStatus = \"INVOICE_NOT_FOUND\";\n    currentInvoice.customerTransactionId = null;\n} else if (Array.isArray(transactionDetail) && transactionDetail.length > 1) {\n    currentInvoice.TransactionStatus = \"MULTIPLE_INVOICES_FOUND\";\n    currentInvoice.customerTransactionId = transactionDetail[0] && transactionDetail[0].CUSTOMERTRANSACTIONID ? transactionDetail[0].CUSTOMERTRANSACTIONID : null;\n}\n\n// Your output will be the enriched currentInvoice\nreturn currentInvoice;"
                  },
