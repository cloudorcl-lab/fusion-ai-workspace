          },
          "code": "FIN_IEX_SET_INTENT_CLASSIFICATION",
          "id": "1771149745681",
          "inputs": [
            {
              "id": "1771149765803",
              "name": "intentClassification",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FIN_IEX_LLM_CLASSIFY_EMAIL_INTENT.$output}}"
            }
          ],
          "type": "SET_FIELDS"
