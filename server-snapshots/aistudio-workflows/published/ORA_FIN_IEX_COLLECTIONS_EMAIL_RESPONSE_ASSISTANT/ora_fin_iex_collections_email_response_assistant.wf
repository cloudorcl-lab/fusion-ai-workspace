          "code": "FIN_IEX_CODE_FLATTEN_PROMISED_INSTALLMENTS_WITH_DUPLICATE_CHECK",
          "id": "1775151207569",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Construct Actionable Promise Requests",
            "returnType": "array",
            "sourceCode": "// --------- ERROR DEFINITIONS ---------\nvar ERROR_CODE_PROMISE_DATE_MISSING = \"PROMISE_DATE_MISSING\";\nvar ERROR_CODE_DAILY_RATES_MISSING = \"DAILY_RATES_NOT_EXISTS_BETWEEN_PROMISE_TO_LEDGER_CURRENCY\";\nvar ERROR_CODE_PROM_LESS_THAN_OPEN = \"PROM_AMT_LESS_THAN_OPEN_BALANCE\";\nvar ERROR_CODE_PROMISE_CROSS_CURRENCY = \"PROMISE_CROSS_CURRENCY\";\nvar ERROR_CODE_INVOICE_NOT_FOUND = \"INVOICE_NOT_FOUND\";\nvar ERROR_CODE_MULTIPLE_INVOICES_FOUND = \"MULTIPLE_INVOICES_FOUND\";\nvar ERROR_CODE_PROMISE_DATE_LT_TRANSACTION_DATE = \"PROMISE_DATE_LESS_THAN_TRANSACTION_DATE\";\nvar ERROR_CODE_DUPLICATE_PROMISE_EXISTS = \"DUPLICATE_PROMISE_EXISTS\";\nvar ERROR_CODE_DUPLICATE_PROMISE_FOR_DATE = \"DUPLICATE_PROMISE_FOR_DATE\";\n\nvar ERROR_TEXT_PROMISE_DATE_MISSING = \"Promise date is missing at both header and invoice level for transaction number {trxNumber}.\";\nvar ERROR_TEXT_DAILY_RATES_MISSING = \"Daily rates are missing between promise currency {promiseCurrency} and ledger currency {ledgerCurrency}.\";\nvar ERROR_TEXT_PROMISE_CROSS_CURRENCY = \"Promise currency {promiseCurrency} does not match transaction currency {transactionCurrency}. Cross-currency promise processing is not supported.\";\nvar ERROR_TEXT_PROM_LESS_THAN_OPEN = \"Promised amount {promiseAmount} is less than open balance {openBalance} for transaction number {trxNumber}.\";\nvar ERROR_TEXT_HEADER_PROM_LESS_THAN_OPEN = \"Header-level promised amount {promiseAmount} is less than sum of open balance {openBalance}.\";\nvar ERROR_TEXT_INVOICE_NOT_FOUND = \"Invoice number {trxNumber} is either incorrect or not present in the system.\";\nvar ERROR_TEXT_MULTIPLE_INVOICES_FOUND = \"Transaction number {trxNumber} has multiple invoices associated.\";\nvar ERROR_TEXT_PROMISE_DATE_LT_TRANSACTION_DATE = \"Promise date {promiseDate} cannot be earlier than transaction date {transactionDate} for transaction number {trxNumber}.\";\nvar ERROR_TEXT_DUPLICATE_SYSTEM_PROMISE = \"There already exists a {promiseState} promise for {promiseAmount} amount on {promiseDate} date for the transaction number {trxNumber}.\";\nvar ERROR_TEXT_DUPLICATE_EMAIL_PROMISE = \"There already exists an unactioned email containing promise for the same transaction number {trxNumber}.\";\nvar ERROR_TEXT_DUPLICATE_PROMISE_FOR_DATE = \"There exists a promise for the given promise date {promiseDate} for transaction number {trxNumber}.\";\n\n// --------- INPUTS ---------\nvar statusActionPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ACTION_PENDING\" };\nvar statusErrorReviewRequired = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" };\nvar statusReviewPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_REVIEW_PENDING\" };\nvar statusErrorReviewPending = { lookupType: \"ORA_IEX_MSG_PROCESSING_STATUS\", lookupCode: \"ORA_ERROR_REVIEW_PENDING\" };\n\nvar installmentDetails = [];\nvar validatedPromisesTransactions = {};\nvar promiseObj = {};\nvar promiseAmountLevel = \"\";\nvar validatedInvoicesList = [];\nvar invalidInvoicesArr = [];\nvar promiseToLedgerConversionRate = 1;\nvar crossCurrencyFlag = \"N\";\nvar messageId = null;\n\nif ($context) {\n    if ($context.$nodes) {\n        if ($context.$nodes.FIN_IEX_CODE_FLATTEN_PROMISED_INSTALLMENTS_WITH_DUPLICATE_CHECK) {\n            if ($context.$nodes.FIN_IEX_CODE_FLATTEN_PROMISED_INSTALLMENTS_WITH_DUPLICATE_CHECK.$output) {\n                if ($context.$nodes.FIN_IEX_CODE_FLATTEN_PROMISED_INSTALLMENTS_WITH_DUPLICATE_CHECK.$output.result) {\n                    installmentDetails = $context.$nodes.FIN_IEX_CODE_FLATTEN_PROMISED_INSTALLMENTS_WITH_DUPLICATE_CHECK.$output.result;\n                }\n            }\n        }\n\n        if ($context.$nodes.FIN_IEX_CODE_FILTER_VALID_TRANSACTIONS) {\n            if ($context.$nodes.FIN_IEX_CODE_FILTER_VALID_TRANSACTIONS.$output) {\n                if ($context.$nodes.FIN_IEX_CODE_FILTER_VALID_TRANSACTIONS.$output.result) {\n                    validatedPromisesTransactions = $context.$nodes.FIN_IEX_CODE_FILTER_VALID_TRANSACTIONS.$output.result;\n                }\n            }\n        }\n    }\n\n    if ($context.$variables) {\n        if ($context.$variables.messageId !== undefined && $context.$variables.messageId !== null) {\n            messageId = $context.$variables.messageId;\n        }\n    }\n}\n\nif (validatedPromisesTransactions.validatedInvoicesObject) {\n    if (validatedPromisesTransactions.validatedInvoicesObject.promise) {\n        promiseObj = validatedPromisesTransactions.validatedInvoicesObject.promise;\n    }\n}\n\nif (promiseObj.promiseAmountLevel !== undefined && promiseObj.promiseAmountLevel !== null) {\n    promiseAmountLevel = promiseObj.promiseAmountLevel;\n}\n\nif (promiseObj.invoices) {\n    validatedInvoicesList = promiseObj.invoices;\n}\n\nif (validatedPromisesTransactions.invalidInvoicesObject) {\n    if (validatedPromisesTransactions.invalidInvoicesObject.promise) {\n        if (validatedPromisesTransactions.invalidInvoicesObject.promise.invoices) {\n            invalidInvoicesArr = validatedPromisesTransactions.invalidInvoicesObject.promise.invoices;\n        }\n    }\n}\n\nvar installmentsByTxn = {};\nvar invoiceOpenBalanceByTxn = {};\nvar invoiceAccountedByTxn = {};\nvar invoiceCurrencyByTxn = {};\nvar sumOpenInstallments = 0;\n\nvar i = 0;\nvar k = \"\";\n\nfor (i = 0; i < installmentDetails.length; i++) {\n    var ins = installmentDetails[i];\n    if (!ins) {\n        ins = {};\n    }\n\n    var txnId = \"\";\n    if (ins.CUSTOMERTRANSACTIONID !== undefined && ins.CUSTOMERTRANSACTIONID !== null) {\n        txnId = String(ins.CUSTOMERTRANSACTIONID);\n    }\n\n    if (!installmentsByTxn[txnId]) {\n        installmentsByTxn[txnId] = [];\n    }\n\n    installmentsByTxn[txnId].push(ins);\n\n    if (!invoiceOpenBalanceByTxn[txnId]) {\n        invoiceOpenBalanceByTxn[txnId] = 0;\n    }\n    invoiceOpenBalanceByTxn[txnId] = invoiceOpenBalanceByTxn[txnId] + Number(ins.AMOUNTREMAINING || 0);\n\n    if (!invoiceAccountedByTxn[txnId]) {\n        invoiceAccountedByTxn[txnId] = 0;\n    }\n    invoiceAccountedByTxn[txnId] = invoiceAccountedByTxn[txnId] + Number(ins.ACCOUNTEDBALANCEDUE || 0);\n\n    if (!invoiceCurrencyByTxn[txnId]) {\n        invoiceCurrencyByTxn[txnId] = ins.CURRENCYCODE || \"\";\n    }\n\n    sumOpenInstallments = sumOpenInstallments + Number(ins.AMOUNTREMAINING || 0);\n}\n\nfor (k in installmentsByTxn) {\n    installmentsByTxn[k].sort(function(a, b) {\n        var d1 = \"\";\n        var d2 = \"\";\n        if (a && a.INSTALLMENTDUEDATE) {\n            d1 = a.INSTALLMENTDUEDATE;\n        }\n        if (b && b.INSTALLMENTDUEDATE) {\n            d2 = b.INSTALLMENTDUEDATE;\n        }\n        if (d1 === d2) {\n            return (a.SEQUENCE || 0) - (b.SEQUENCE || 0);\n        }\n        if (d1 < d2) {\n            return -1;\n        }\n        return 1;\n    });\n}\n\n// --------- INDEX MAPS FOR SAFE OPTIMIZATION ---------\nvar transactionDateByTxn = {};\nvar transactionNumberByTxn = {};\nvar duplicatePromiseDetailsByTxn = {};\nvar hasDuplicatePromiseByTxn = {};\nvar invoiceNumberByTxn = {};\n\nfor (i = 0; i < installmentDetails.length; i++) {\n    var idxIns = installmentDetails[i];\n    if (!idxIns) {\n        idxIns = {};\n    }\n\n    var idxTxnId = \"\";\n    if (idxIns.CUSTOMERTRANSACTIONID !== undefined && idxIns.CUSTOMERTRANSACTIONID !== null) {\n        idxTxnId = String(idxIns.CUSTOMERTRANSACTIONID);\n    }\n\n    if (idxTxnId !== \"\") {\n        if (!transactionDateByTxn[idxTxnId] && idxIns.TRANSACTIONDATE) {\n            transactionDateByTxn[idxTxnId] = idxIns.TRANSACTIONDATE;\n        }\n\n        if (!transactionNumberByTxn[idxTxnId] && idxIns.TRANSACTIONNUMBER) {\n            transactionNumberByTxn[idxTxnId] = idxIns.TRANSACTIONNUMBER;\n        }\n\n        if (!duplicatePromiseDetailsByTxn[idxTxnId]) {\n            duplicatePromiseDetailsByTxn[idxTxnId] = idxIns.duplicatePromiseDetails || [];\n        }\n\n        if (!hasDuplicatePromiseByTxn[idxTxnId]) {\n            hasDuplicatePromiseByTxn[idxTxnId] = idxIns.hasDuplicatePromise || \"N\";\n        }\n    }\n}\n\nfor (i = 0; i < validatedInvoicesList.length; i++) {\n    var idxInv = validatedInvoicesList[i];\n    if (!idxInv) {\n        idxInv = {};\n    }\n\n    var idxInvTxnId = \"\";\n    if (idxInv.CustomerTransactionId !== undefined && idxInv.CustomerTransactionId !== null) {\n        idxInvTxnId = String(idxInv.CustomerTransactionId);\n    }\n\n    if (idxInvTxnId !== \"\") {\n        if (!invoiceNumberByTxn[idxInvTxnId] && idxInv.invoiceNumber) {\n            invoiceNumberByTxn[idxInvTxnId] = idxInv.invoiceNumber;\n        }\n    }\n}\n\n// --------- SUMMARY CONTEXT ---------\nvar summaryPromiseDate = \"\";\nvar summaryPromiseCurrency = \"\";\nvar summaryLedgerCurrency = \"\";\n\nif (promiseObj.promiseDate) {\n    summaryPromiseDate = promiseObj.promiseDate;\n}\n\nfor (i = 0; i < installmentDetails.length; i++) {\n    var summaryIns = installmentDetails[i];\n    if (!summaryIns) {\n        summaryIns = {};\n    }\n    if (!summaryPromiseCurrency && summaryIns.CURRENCYCODE) {\n        summaryPromiseCurrency = summaryIns.CURRENCYCODE;\n    }\n    if (!summaryLedgerCurrency && summaryIns.LEDGERCURRENCY) {\n        summaryLedgerCurrency = summaryIns.LEDGERCURRENCY;\n    }\n}\n\nif (promiseObj.promiseCurrency) {\n    summaryPromiseCurrency = promiseObj.promiseCurrency;\n}\n\nvar errorsByTxn = {};\nvar errorsByInvoiceMap = {};\nvar globalErrors = [];\nvar effectivePromiseDateByTxn = {};\n\n// --------- Cross-currency validation ---------\nvar transactionCurrency = \"\";\nif (installmentDetails.length > 0) {\n    if (installmentDetails[0] && installmentDetails[0].CURRENCYCODE) {\n        transactionCurrency = installmentDetails[0].CURRENCYCODE;\n    }\n}\n\nif ((!promiseObj.promiseCurrency || promiseObj.promiseCurrency === \"\") && transactionCurrency) {\n    promiseObj.promiseC