{
  "workflowId": "300000331058442",
  "workflowCode": "ORA_FIN_IEX_COLLECTIONS_EMAIL_RESPONSE_ASSISTANT",
  "name": "Collections Email Response Assistant",
  "description": "This agent receives the content of incoming customer email and then analyzes email content to identify the email intent (such as requesting an invoice copy, raising a dispute, or providing a Promise to Pay). Based on the detected intent, the system triggers the relevant actions in Receivables and sends an appropriate response.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1774435648094"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Check For Inbound Channel"
          },
          "outcomes": {
            "true": "1774435902811",
            "false": "1774435932498"
          },
          "code": "CHECK_FOR_INBOUND_CHANNEL",
          "convergenceTargetId": "end",
          "id": "1774435648094",
          "inputs": [
            {
              "id": "1774435648097_1",
              "name": "condition",
              "type": "string",
              "value": "{{($context.$system.$triggerType == 'EMAIL' || $context.$system.$triggerType == 'REST') && ($context.$system.$inputMessage == null || $context.$system.$inputMessage == '')}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Set Email Mode Start"
          },
          "outcomes": {
            "success": "1771137998891"
          },
          "code": "FIN_IEX_SET_START_EMAIL_MODE",
          "id": "1774435902811",
          "inputs": [],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Extract Email Metadata",
            "returnType": "object",
            "sourceCode": "// Consolidate Email details from Trigger or REST input\n// Return type: Object\nconst emailInput = $context.$triggers && $context.$triggers.EMAIL && $context.$triggers.EMAIL.$input ?\n    $context.$triggers.EMAIL.$input :\n    {};\nconst restInput = $context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input ?\n    $context.$triggers.REST.$input:\n    {};\n/* ---------- Source Selection ---------- */\nlet emailSource = null;\nif (\n    emailInput.fromAddress !== undefined &&\n    emailInput.fromAddress !== null &&\n    emailInput.fromAddress !== \"\"\n) {\n    emailSource = emailInput;\n} else {\n    emailSource = restInput;\n}\n/* ---------- Raw Value Extraction ---------- */\nlet fromAddress = (emailSource.fromAddress === undefined) ? null : emailSource.fromAddress;\nlet toValue = emailSource.toAddress || \"\";\nlet ccValue = emailSource.ccAddress || \"\";\nlet subject = emailSource.subject || \"\";\nlet content = (emailSource.content === undefined) ? null : emailSource.content;\nlet headers = emailSource.headers || {};\nlet attachments = emailSource.attachments || [];\n\n/* ---------- Header Extraction (MessageId, InReplyTo, RecipientEmailAddresses) ---------- */\nlet MessageId = null;\nlet InReplyTo = null;\nlet RecipientEmailAddresses = { to: [], cc: [], bcc: [] };\nlet headerExtractionErrors = [];\n\ntry {\n    if (headers != null && typeof headers === \"object\") {\n        // Normalize to case-insensitive multimap: lowerKey -> [stringValues]\n        let headerMap = {};\n        let headerKeys = Object.keys(headers);\n\n        for (let i = 0; i < headerKeys.length; i++) {\n            let hk = headerKeys[i];\n            if (hk == null) continue;\n\n            let lower = String(hk).trim().toLowerCase();\n            if (!lower) continue;\n\n            let hv = headers[hk];\n            if (!headerMap[lower]) headerMap[lower] = [];\n\n            if (Array.isArray(hv)) {\n                for (let j = 0; j < hv.length; j++) {\n                    let item = hv[j];\n                    if (item == null) continue;\n                    let s = String(item).trim();\n                    if (s) headerMap[lower].push(s);\n                }\n            } else if (typeof hv === \"string\") {\n                let s = hv.trim();\n                if (s) headerMap[lower].push(s);\n            } else if (hv != null) {\n                let s = String(hv).trim();\n                if (s) headerMap[lower].push(s);\n            }\n        }\n\n        // Message-ID\n        try {\n            let raw = (headerMap[\"message-id\"] && headerMap[\"message-id\"].length) ? headerMap[\"message-id\"][0] : null;\n            if (raw) {\n                let m = String(raw).match(/<[^<>]+>/);\n                let val = m ? m[0].trim() : String(raw).trim();\n                MessageId = val ? val : null;\n            }\n        } catch (e) {\n            headerExtractionErrors.push(\"Failed parsing Message-ID: \" + (e && e.message ? e.message : String(e)));\n        }\n\n        // In-Reply-To\n        try {\n            let raw = (headerMap[\"in-reply-to\"] && headerMap[\"in-reply-to\"].length) ? headerMap[\"in-reply-to\"][0] : null;\n            if (raw) {\n                let m = String(raw).match(/<[^<>]+>/);\n                let val = m ? m[0].trim() : String(raw).trim();\n                InReplyTo = val ? val : null;\n            }\n        } catch (e) {\n            headerExtractionErrors.push(\"Failed parsing In-Reply-To: \" + (e && e.message ? e.message : String(e)));\n        }\n\n        // Recipients: extract emails from To/Cc/Bcc header values (best-effort)\n        let emailRe = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/ig;\n\n        // To\n        try {\n            let vals = headerMap[\"to\"] || [];\n            let seen = {};\n            for (let i = 0; i < vals.length; i++) {\n                let s = String(vals[i] || \"\");\n                let matches = s.match(emailRe) || [];\n                for (let j = 0; j < matches.length; j++) {\n                    let em = String(matches[j]).toLowerCase();\n                    if (em && !seen[em]) {\n                        RecipientEmailAddresses.to.push(em);\n                        seen[em] = true;\n                    }\n                }\n            }\n        } catch (e) {\n            headerExtractionErrors.push(\"Failed parsing To: \" + (e && e.message ? e.message : String(e)));\n        }\n\n        // Cc\n        try {\n            let vals = headerMap[\"cc\"] || [];\n            let seen = {};\n            for (let i = 0; i < vals.length; i++) {\n                let s = String(vals[i] || \"\");\n                let matches = s.match(emailRe) || [];\n                for (let j = 0; j < matches.length; j++) {\n                    let em = String(matches[j]).toLowerCase();\n                    if (em && !seen[em]) {\n                        RecipientEmailAddresses.cc.push(em);\n                        seen[em] = true;\n                    }\n                }\n            }\n        } catch (e) {\n            headerExtractionErrors.push(\"Failed parsing Cc: \" + (e && e.message ? e.message : String(e)));\n        }\n\n        // Bcc (often not present in received messages)\n        try {\n            let vals = headerMap[\"bcc\"] || [];\n            let seen = {};\n            for (let i = 0; i < vals.length; i++) {\n                let s = String(vals[i] || \"\");\n                let matches = s.match(emailRe) || [];\n                for (let j = 0; j < matches.length; j++) {\n                    let em = String(matches[j]).toLowerCase();\n                    if (em && !seen[em]) {\n                        RecipientEmailAddresses.bcc.push(em);\n                        seen[em] = true;\n                    }\n                }\n            }\n        } catch (e) {\n            headerExtractionErrors.push(\"Failed parsing Bcc: \" + (e && e.message ? e.message : String(e)));\n        }\n    }\n} catch (e) {\n    headerExtractionErrors.push(\"Header extraction failed: \" + (e && e.message ? e.message : String(e)));\n}\n\n/* ---------- Keep Attachments with clear Content (Context priority; include CONTEXT if present) ---------- */\nlet processedAttachments = [];\nfor (let i = 0; i < attachments.length; i++) {\n    let att = attachments[i] || {};\n\n    let fileName = (att.fileName !== undefined && att.fileName !== null) ? att.fileName : null;\n    let contentType = (att.mimeType !== undefined && att.mimeType !== null) ? att.mimeType : null;\n\n    // Priority: context > encodedContent\n    let contextPresent = (att.context !== undefined && att.context !== null && String(att.context).trim() !== \"\");\n    let encodedPresent = (att.encodedContent !== undefined && att.encodedContent !== null && String(att.encodedContent).trim() !== \"\");\n\n    let contentBase64 = \"\";\n    let contextString = null;\n\n    if (contextPresent) {\n        contextString = String(att.context);\n\n        // Base64 encode context (Unicode-safe fallback)\n        try {\n            contentBase64 = btoa(contextString);\n        } catch (e) {\n            try {\n                contentBase64 = btoa(unescape(encodeURIComponent(contextString)));\n            } catch (e2) {\n                contentBase64 = \"\";\n            }\n        }\n    } else if (encodedPresent) {\n        contentBase64 = String(att.encodedContent).trim();\n    } else {\n        contentBase64 = \"\";\n    }\n\n    let outAtt = {\n        FILE_NAME: fileName,\n        CONTENT: contentBase64,\n        CONTENT_TYPE: contentType\n    };\n\n    // Explicitly include context when present\n    if (contextPresent) {\n        outAtt.CONTEXT = contextString;\n    }\n\n    processedAttachments.push(outAtt);\n}\n\n/* ---------- Ensure \"to\" as Array ---------- */\nlet toArray = [];\nif (Array.isArray(toValue)) {\n    toArray = toValue;\n} else if (toValue) {\n    toArray = [toValue];\n}\n/* ---------- Ensure \"cc\" as Array ---------- */\nlet ccArray = [];\nif (Array.isArray(ccValue)) {\n    ccArray = ccValue;\n} else if (ccValue) {\n    ccArray = [ccValue];\n}\n/* ---------- Final consolidated JSON (Single Flat Object) ---------- */\nconst emailMessage = {\n    fromAddress: fromAddress,\n    to: toArray,\n    cc: ccArray,\n    subject: subject,\n    content: content,\n    headers: headers,\n    // Explicit header extraction added (as requested)\n    MessageId: MessageId,\n    InReplyTo: InReplyTo,\n    RecipientEmailAddresses: RecipientEmailAddresses,\n    attachments: processedAttachments\n};\n/* ---------- Convert Entire Email Message to Base64 ---------- */\n// Step 1: Convert the email message object to JSON string\nconst emailMessageJSON = JSON.stringify(emailMessage);\n\nreturn emailMessage;"
          },
          "outcomes": {
            "success": "1771139525450"
          },
