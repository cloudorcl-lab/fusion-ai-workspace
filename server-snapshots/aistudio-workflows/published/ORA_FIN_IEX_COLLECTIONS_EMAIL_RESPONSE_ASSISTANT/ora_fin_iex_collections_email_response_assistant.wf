            "returnType": "string",
            "sourceCode": "const filteredArray = $context.$nodes.FIN_IEX_CODE_REMOVE_ERROR_DISPUTE_REQUESTS.$output.result; \n\nconst output = filteredArray.map(item => {\n  return {\n    \"id\": item.CUSTOMERMESSAGEDETAILID,\n    \"path\": \"/receivablesDisputes\",\n    \"operation\": \"create\",\n    \"payload\": item.actionablePayload\n  };\n});\n\nreturn JSON.stringify(JSON.stringify(output));"
          },
