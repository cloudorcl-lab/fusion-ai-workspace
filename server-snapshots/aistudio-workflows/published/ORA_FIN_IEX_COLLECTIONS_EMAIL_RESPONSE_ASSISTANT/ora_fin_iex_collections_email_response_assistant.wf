          "inputs": [
            {
              "id": "1774412682154_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_IEX_BO_CREATE_DISPUTES.$status === \"failure\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Extract Dispute Error",
            "returnType": "array",
            "sourceCode": "let errorInfo=$context.$nodes.FIN_IEX_BO_CREATE_DISPUTES.$error.$info;\nconst messageDetailArray=$context.$variables.FilteredMessageDetailsArray||[];\n\nfunction parseJsonObject(value){\n  if(value&&typeof value===\"object\"&&!Array.isArray(value))return value;\n\n  if(typeof value===\"string\"){\n    const s=value.trim();\n    if(s.startsWith(\"{\")||s.startsWith(\"[\")){\n      try{\n        const parsed=JSON.parse(s);\n        return parsed&&typeof parsed===\"object\"&&!Array.isArray(parsed)?parsed:{};\n      }catch(e){\n        return {};\n      }\n    }\n  }\n\n  return {};\n}\n\nif(typeof errorInfo===\"string\"){\n  errorInfo=parseJsonObject(errorInfo);\n}\n\nlet resultObj=(errorInfo&&errorInfo.result!=null)?errorInfo.result:errorInfo;\n\nif(typeof resultObj===\"string\"){\n  resultObj=parseJsonObject(resultObj);\n}\n\nconst errorDetails=resultObj[\"o:errorDetails\"]||[];\n\nconst parts=errorDetails.map((error)=>{\n  const path=error[\"o:errorPath\"]||\"\";\n  const m=path.match(/\\/parts\\/(\\d+)\\/payload/);\n  const partIndex=m?parseInt(m[1],10):null;\n\n  return{\n    index:partIndex,\n    errorCode:error[\"o:errorCode\"],\n    detail:error[\"detail\"]\n  };\n});\n\nreturn parts.map((item)=>{\n  const messageDetail=item.index!=null?messageDetailArray[item.index]||{}:{};\n\n  const existingResponseData=parseJsonObject(\n    messageDetail.responseData||messageDetail.RESPONSEDATA\n  );\n\n  return{\n    messageDetailId:messageDetail.CUSTOMERMESSAGEDETAILID||null,\n    responseData:{\n      ...existingResponseData,\n      transactionNumber:messageDetail.invoiceNumber||null,\n      errorCode:item.errorCode,\n      DisputeAmount:messageDetail.DisputeAmount,\n      DisputeType:messageDetail.DisputeType,\n      DisputeReason:messageDetail.DisputeReason,\n      DisputeSection:messageDetail.DisputeSection,\n      DisputePercentage:messageDetail.DisputePercentage,\n      TransactionAmount: messageDetail.amountRemaining ?? null,\n    TransactionCurrencyCode: messageDetail.transactionCurrencyCode ?? null,\n    TransactionNumber: messageDetail.invoiceNumber ?? null,\n    DisputeAmountLevel: messageDetail.disputeAmountLevel,\n      partyName: messageDetail.PARTYNAME,\n      accountNumber: messageDetail.ACCOUNTNUMBER,\n      site: messageDetail.SITE,\n      detail:item.detail,\n      ReceivablesDisputeLines: messageDetail.receivablesDisputeLines,\n    DisputeReasonMeaning: messageDetail.disputeReasonMeaning,\n    DisputeSectionMeaning: messageDetail.disputeSectionMeaning,\n    DisputeTypeMeaning: messageDetail.disputeTypeMeaning,\n    MessageId: messageDetail.messageId\n    },\n    processingStatusCode:\"ORA_PROCESSING_ERROR\"\n  };\n});"
          },
          "outcomes": {
            "success": "1774416034846"
          },
          "code": "FIN_IEX_CODE_EXTRACT_DISPUTE_ERROR",
