        {
          "metadata": {
            "name": "Construct Payload to Store Email Message",
            "returnType": "object",
            "sourceCode": "// Map Extracted Email Metadata -> REST API payload\n// Input source:\n// $context.$variables.email\n\nconst input = $context.$variables &&\n    $context.$variables.email\n    ? $context.$variables.email\n    : {};\n\nconst attachments = Array.isArray(input.attachments) ? input.attachments : [];\n\nlet mappedAttachments = [];\n\nfor (let i = 0; i < attachments.length; i++) {\n    const att = attachments[i] || {};\n\n    mappedAttachments.push({\n        fileName: att.FILE_NAME || null,\n        content: att.CONTENT || null,\n        contentType: att.CONTENT_TYPE || null,\n        fileSizeInBytes: null,\n        validationStatus: {\n            lookupCode: \"ORA_VALID\"\n        }\n    });\n}\n\nconst payload = {\n    externalMessageReference: input.MessageId || null,\n    conversationReference: input.InReplyTo || null,\n    emailTypeCode: \"ORA_INBOUND\",\n    messageHeader: input.headers ? JSON.stringify(input.headers) : null,\n    virtualAddress: \"ORA_FIN_IEX_COLLECTIONS_EMAIL_RESPONSE_ASSISTANT\",\n    senderAddress: input.fromAddress || null,\n    recipientAddress: input.RecipientEmailAddresses\n        ? JSON.stringify(input.RecipientEmailAddresses)\n        : null,\n    subject: input.subject || null,\n    messageBody: input.content || null,\n    emailFile: null,\n    messageStatusCode: \"ORA_PROCESSED\",\n    locale: null,\n    replyToMessageId: null,\n    emailMessageAttachments: {\n        items: mappedAttachments\n    }\n};\n\nreturn payload;"
          },
