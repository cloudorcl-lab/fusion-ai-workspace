          "metadata": {
            "name": "Get Hint",
            "returnType": "string",
            "sourceCode": "let hint= $context.$triggers.REST.$input.OraMessageHint;\nreturn hint"
          },
          "outcomes": {
            "success": "1773377635759"
          },
          "code": "GET_HINT",
          "id": "1773377464564",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "SET Variables",
            "returnType": "string",
            "sourceCode": "const raw = $context.$triggers.REST.$input.OraAction;\n\nif (!raw) {\n  return \"No OraAction found\";\n}\n\nlet payload = null;\n\n// If OraAction is a string → parse JSON\nif (typeof raw === \"string\") {\n  try {\n    payload = JSON.parse(raw);\n  } catch (e) {\n    return \"Failed to parse OraAction JSON\";\n  }\n}\n// If OraAction is already an object\nelse if (typeof raw === \"object\") {\n  payload = raw;\n}\n\n// Validate payload and extract model\nif (!payload || !payload.model) {\n  $context.$variables.ModelName = \"No model found in InvokeAction payload\";\n} else {\n  $context.$variables.ModelName = String(payload.model);\n}\n\nreturn $context.$variables.ModelName;"
          },
          "outcomes": {
            "success": "1773377822668"
          },
          "code": "SET_VARIABLES",
          "id": "1773377635759",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
