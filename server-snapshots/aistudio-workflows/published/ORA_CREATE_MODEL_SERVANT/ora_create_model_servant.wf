        {
          "metadata": {
            "name": "Decide Action",
            "returnType": "string",
            "sourceCode": "// Define algorithm groups\nconst InvokeAction1 = [\n  \"next best offer\",\"next best action\",\"fatigue segmentation\",\"account product fit\",\"churn propensity\",\"account lead scoring b2b\",\"customer lifetime value\",\"engagement propensity\",\"campaign revenue attribution\",\"channel campaign recommender\"\n];\n\nconst InvokeAction2 = [\n  \"look alike b2b\",\"look alike b2c\",\"next best promotion\",\"repurchase propensity\",\"recency, frequency and monetary\",\"predictive contact lead scoring b2b\",\"send time optimization\",\"product propensity\",\"title mapping\",\"potential revenue\"\n];\n\n// Input algorithm name\nconst algo = String( $context.$nodes.SET_VARIABLES.$output.result || \"\").toLowerCase();\n\n// Convert lists to lowercase for safe comparison\nconst list1 = InvokeAction1.map(a => a.toLowerCase());\nconst list2 = InvokeAction2.map(a => a.toLowerCase());\n\nlet action = \"\";\n\nif (list1.includes(algo)) {\n  action = \"InvokeAction1\";\n} else if (list2.includes(algo)) {\n  action = \"InvokeAction2\";\n} else {\n  action = \"Unknown\";\n}\n\nreturn action"
          },
          "outcomes": {
            "success": "1773377671554"
          },
          "code": "DECIDE_ACTION",
          "id": "1773404023792",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
