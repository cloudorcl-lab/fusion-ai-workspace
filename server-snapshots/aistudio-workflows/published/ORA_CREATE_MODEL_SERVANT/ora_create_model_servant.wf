        {
          "metadata": {
            "name": "Create Unique Date",
            "returnType": "string",
            "sourceCode": "const now = new Date();\nconst yy = String(now.getFullYear()).slice(2);\nconst mm = String(now.getMonth() + 1).padStart(2, \"0\");\nconst dd = String(now.getDate()).padStart(2, \"0\");\nconst ms = String(Date.now() % 10000).padStart(4, \"0\");\n\nreturn `${yy}${mm}${dd}${ms}`;"
          },
          "outcomes": {
            "success": "1773377985612"
          },
          "code": "CREATE_UNIQUE_DATE",
          "convergenceTargetId": "1773377671554",
          "id": "1773377822668",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Model Config",
            "returnType": "object",
            "sourceCode": "const modelConfig = {\n  \"customer lifetime value\": {\n    title: \"clv\",\n    training_query: \"qryDSCLTVTrain\",\n    scoring_query: \"qryDSCLTVScore\"\n  },\n\n  \"next best offer\": {\n    title: \"nbo\",\n    training_query: \"qryDSNextBestOfferTrain\",\n    scoring_query: \"qryDSNextBestOfferScore\",\n    offerName: \"Apparel offers\",\n    topN: 5\n  },\n\n  \"send time optimization\": {\n    title: \"sto\",\n    training_query: \"qryDSSTOTrain\",\n    scoring_query: \"qryDSSTOScore\",\n    lookBackWindow: 90\n  },\n\n  \"repurchase propensity\": {\n    title: \"repur\",\n    training_query: \"qryDSRepurchasePropensityTrain\",\n    scoring_query: \"qryDSRepurchasePropensityScore\",\n    repurchaseWindow: 90\n  },\n\n  \"product propensity\": {\n    title: \"product\",\n    training_query: \"qryDSProductPropensityTrain\",\n    scoring_query: \"qryDSProductPropensityScore\",\n    lookBackWindow: 90\n  },\n\n  \"churn propensity\": {\n    title: \"churn\",\n    training_query: \"qryDSChurnPropensityTrain\",\n    scoring_query: \"qryDSChurnPropensityScore\",\n    churnCriteria: \"Custom - Zero orders\",\n    churnWindow: 180\n  },\n\n  \"recency, frequency and monetary\": {\n    title: \"rfm\",\n    training_query: \"qryDSRFMTrain\",\n    scoring_query: \"qryDSRFMScore\",\n    lookBackWindow: 90,\n    dataAttribute: \"Behavioural and transactional attributes\"\n  },\n\n  \"fatigue segmentation\": {\n    title: \"fatigue\",\n    training_query: \"qryDSFatigueSegmentationTrain\",\n    scoring_query: \"qryDSFatigueSegmentationScore\"\n  },\n\n  \"account lead scoring b2b\": {\n    title: \"abpls\",\n    lookBackWindow: 90,\n    training_query: \"qryDSPredictiveAccountScoringTrain\",\n    scoring_query: \"qryDSPredictiveAccountScoringScore\"\n  },\n\n  \"predictive contact lead scoring b2b\": {\n    title: \"contact\",\n    lookBackWindow: 180,\n    min_positive_count: 500,\n    min_negative_count: 500,\n    training_query: \"qryDSPredictiveLeadTrain\",\n    scoring_query: \"qryDSPredictiveLeadScore\"\n  },\n\n  \"campaign revenue attribution\": {\n    title: \"campaign\",\n    lookBackWindow: 45,\n    type: \"multi-touch Revenue\",\n    training_query: \"qryDSCampaignAttributionTrain\",\n    scoring_query: \"qryDSCampaignAttributionScore\"\n  },\n\n  \"channel campaign recommender\": {\n    title: \"chan-rec\",\n    type: \"Channel recommender\",\n    training_query: \"qryDSChannelCampaignRecommenderTrain\",\n    scoring_query: \"qryDSChannelCampaignRecommenderScore\"\n  },\n\n  \"engagement propensity\": {\n    title: \"engage\",\n    conversion_str: \"Email click\",\n    training_query: \"qryDSEngagementTrain\",\n    scoring_query: \"qryDSEngagementScore\"\n  },\n\n  \"next best promotion\": {\n    title: \"nbp\",\n    training_query: \"qryDSNBPTrain\",\n    scoring_query: \"qryDSNBPScore\"\n  },\n\n  \"next best action\": {\n    title: \"nba\",\n    actionName: \"Apparel actions catalog\",\n    topN: 5,\n    training_query: \"qryDSNextBestActionTrain\",\n    scoring_query: \"qryDSNextBestActionScore\"\n  },\n\n  \"look alike b2c\": {\n    title: \"lal-b2c\",\n    lookaliketype: \"B2C Customer Lookalike\",\n    training_segment: \"Seed-b2c\",\n    scoring_segment: \"Target-b2c\"\n  },\n\n  \"look alike b2b\": {\n    title: \"lal-b2b\",\n    lookaliketype: \"B2B Account Lookalike\",\n    training_segment: \"LAL-Account-Purchaser1\",\n    scoring_segment: \"LAL-Account-Promising1\"\n  },\n\n  \"title mapping\": {\n    title: \"tit-map\",\n    training_query: \"qryDSPotentialRevenueTrain\",\n    scoring_query: \"qryDSPotentialRevenueScore\"\n  },\n\n  \"account product fit\": {\n    title: \"acc-pf\",\n    training_query: \"qryDSAccountProductFitTrain\",\n    scoring_query: \"qryDSAccountProductFitScore\"\n  },\n\n  \"potential revenue\": {\n    title: \"pot-rev\",\n    training_query: \"qryDSPotentialRevenueTrain\",\n    scoring_query: \"qryDSPotentialRevenueScore\"\n  }\n};\n\n// Input model name from previous node\nconst input_model = String($context.$nodes.SET_VARIABLES.$output.result || \"\").toLowerCase();\n\n// Fetch config\nconst config = modelConfig[input_model] || { title: \"model\" };\n\n// Copy config and remove short title from dynamic params\nconst dynamicParams = { ...config };\ndelete dynamicParams.title;\n\n// Return common + model-specific params\nreturn {\n  title: config.title + \"-\" + $context.$nodes.CREATE_UNIQUE_DATE.$output.result,\n  description: \"Created using Intelligence Advisor\",\n  ...dynamicParams\n};"
          },
          "outcomes": {
            "success": "1773404023792"
          },
          "code": "GET_MODEL_CONFIG",
          "convergenceTargetId": "1773377671554",
          "id": "1773377985612",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Branch Model Set 2"
          },
          "outcomes": {
            "Look Alike B2B": "1773404766243",
