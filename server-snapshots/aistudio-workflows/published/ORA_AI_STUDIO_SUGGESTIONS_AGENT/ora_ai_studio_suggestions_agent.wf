        {
          "id": "1774888407009",
          "code": "GET_CURRENT_BLUE_GREEN",
          "type": "VECTOR_DB_READER",
          "metadata": {
            "name": "Get Current Blue Green"
          },
          "diagram": {
            "x": 6217.75,
            "y": 5912
          },
          "outcomes": {
            "success": "1774887812831"
          },
          "inputs": [
            {
              "id": "1774888407009_indexName",
              "name": "indexName",
              "type": "string",
              "value": "AI_STUDIO_INDEX_METADATA"
            },
            {
              "id": "1774888407009_query",
              "name": "query",
              "type": "string",
              "value": "blue or green"
            },
            {
              "id": "1774888407009_documentId",
              "name": "documentId",
              "type": "string",
              "value": "current_index"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}"
        },
        {
          "id": "1774887812831",
          "code": "GENERATE_INDEX_DETAIL",
          "type": "CODE",
          "metadata": {
            "name": "Generate Index Detail",
            "returnType": "object",
            "sourceCode": "let indexName = \"\";\nlet filter= \"\";\nlet identifier = \"\";\nconst queryType = $context.$nodes.CLEAN_QUERY_TYPE.$output.result;\nconst currentActive = $context.$nodes.GET_CURRENT_BLUE_GREEN.$output;\nconst userFilter = $context.$triggers.REST.$input.FILTER;\n\nlet prefix;\nif (Array.isArray(currentActive) && currentActive.length > 0) {\n  prefix = currentActive[0].color;\n  prefix = prefix? prefix.trim(): prefix;\n}\nprefix = prefix ? prefix : \"BLUE\";\n\nif (userFilter) {\n  filter = {\n      \"operator\": \"and\",\n      \"criteria\": [\n        {\n          \"field\": userFilter.name,\n          \"operation\": \"eq\",\n          \"value\": userFilter.value\n        }\n      ]\n    }\n}\n\nif (queryType=== \"AGENTTEAMS\") {\n    indexName = \"ORA_AI_STUDIO_WORKFLOWS_\";\n    identifier = \"workflowCode\";\n} else if (queryType === \"BUSINESSOBJECTS\") {\n    indexName = \"ORA_AI_STUDIO_BO_\";\n    identifier = \"objectCode\"\n} else if (queryType=== \"TOOLS\") {\n    indexName = \"ORA_AI_STUDIO_TOOLS_\";\n    identifier = \"toolCode\"\n} else if (queryType=== \"AGENTS\") {\n    indexName = \"ORA_AI_STUDIO_AGENTS_\";\n    identifier = \"agentCode\"\n} else if (queryType=== \"TOPICS\") {\n    indexName = \"ORA_AI_STUDIO_TOPICS_\";\n    identifier = \"topicCode\"\n} else if (queryType=== \"DEEPLINKS\") {\n    indexName = \"ORA_AI_STUDIO_DEEPLINKS_\";\n    identifier = \"deepLinkCode\"\n} else if (queryType=== \"APPS\") {\n    indexName = \"ORA_AI_STUDIO_APPS_\";\n    identifier = \"code\"\n} else if (queryType=== \"POLICY\") {\n    indexName = \"ORA_AI_STUDIO_POLICY_\";\n    identifier = \"code\"\n}\nindexName= indexName + prefix;\nlet finalResult = {indexName: indexName, filter: filter, identifier: identifier};\n\nreturn finalResult;"
          },
          "diagram": {
            "x": 6217.75,
            "y": 6134
          },
          "outcomes": {
            "success": "1774889396972"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
