        {
          "id": "1774908284889",
          "code": "REORDER_BASED_ON_VECTOR_RESULTS",
          "type": "CODE",
          "metadata": {
            "name": "Reorder Based On Vector Results",
            "sourceCode": "let result = [];\nconst resultMap = new Map();\nlet identifier = $context.$nodes.GENERATE_INDEX_DETAIL.$output.result.identifier;\nconst resultSize = $context.$variables.responseSize;\nlet codeList = $context.$nodes.EXTRACT_CODES.$output.result ? $context.$nodes.EXTRACT_CODES.$output.result : \"\";\nif( typeof codeList === 'number') {\n  codeList = codeList + \"\";\n}\nif( $context.$variables.results && $context.$variables.results.items) {\n  let data = $context.$variables.results.items;\n  // Loop through the input data and processes each item\n  \n  for( let i = 0; i < data.length; i++) {\n    delete data[ i][ '$context'];\n    resultMap.set( data[ i][ identifier], data[ i]);\n  } // we need to re order the elements to match the order returned from vector database\n  \n  const reorderedArray = [];\n  codeList = codeList.split( ',').map( id => {\n    let val = id.trim();\n    if(( val.startsWith( \"'\") && val.endsWith( \"'\")) || ( val.startsWith( '\"') && val.endsWith( '\"'))) {\n      val = val.substring( 1, val.length - 1);\n    }\n    return val;\n  }).filter( Boolean);\n\n  for( const code of codeList) {\n    if( resultMap.has( code) && reorderedArray.length < resultSize) {\n      reorderedArray.push( resultMap.get( code));\n      resultMap.delete( code);\n    }\n  } result = reorderedArray;\n}\nconst finalResult = {\n  items: result\n};\nreturn finalResult;",
            "returnType": "object"
          },
          "diagram": {
            "x": 4976.635658914729,
            "y": 8185.875968992247
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
