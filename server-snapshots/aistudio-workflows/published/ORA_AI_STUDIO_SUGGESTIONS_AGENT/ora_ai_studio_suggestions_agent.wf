        {
          "id": "1774914697417",
          "code": "STANDARDIZE_RESULT",
          "type": "CODE",
          "metadata": {
            "name": "Standardize Result",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Safely access the results array from workflow variables\n  const data = $context.$variables.results?.items || [];\n\n  // Defensive copy to avoid mutating original data\n  const cleanedData = Array.isArray(data) ? data.map(item => {\n    // Create a shallow copy of each item\n    const newItem = { ...item };\n    // Remove any $context property if present\n    delete newItem['$context'];\n    return newItem;\n  }) : [];\n\n  // Return as object with items property\n  result = { items: cleanedData };\n} catch (error) {\n  // On error, return empty items array\n  result = { items: [] };\n}\n\nreturn result;"
          },
          "diagram": {
            "x": 6667.75,
            "y": 7244
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
