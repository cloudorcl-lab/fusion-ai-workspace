            "sourceCode": "let needVectorSearch = true;\nif (!$context.$triggers.REST.$input.QUERY || !$context.$triggers.REST.$input.QUERY.trim()==='') {\n    needVectorSearch = false;\n}\n\nreturn needVectorSearch;"
