        {
          "id": "1774898020380",
          "code": "EXTRACT_CODES",
          "type": "CODE",
          "metadata": {
            "name": "Extract Codes",
            "sourceCode": "let result = \"\";\ntry {\n  // Access the array output from the Read From Vector node\n  const vectorItems = $context.$nodes?.READ_FROM_VECTOR?.$output || [];\n\n  // Extract the 'id' from each element and join them into a single string maintaining order\n  // No duplicates assumed as per user statement\n  result = vectorItems.map(item => (\"'\"+item.code+ \"'\") || \"\").join(\",\");\n} catch (error) {\n  // In case of error, return empty string as per return type\n  result = \"\";\n}\n\nreturn result;",
            "returnType": "string"
          },
          "diagram": {
            "x": 5000,
            "y": 6800
          },
          "outcomes": {
            "success": "1774974740926"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
