        {
          "metadata": {
            "name": "validAttrListCode2",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FETCHADDRESSPROPSFROMVECTORDB.$output;\n\nconst variableNames = [];\n\ndata.forEach(item => {\n  try {\n    const parsed = JSON.parse(item.text); // Attempt to parse\n    const firstKey = Object.keys(parsed)[0];\n\n    if (firstKey && parsed[firstKey]) {\n      // Add the values of the first key\n      variableNames.push(...Object.values(parsed[firstKey]));\n    }\n\n  } catch (err) {\n    // Optionally skip or push a placeholder, but here we simply skip\n  }\n});\n\n// Append variable\nvariableNames.push($context.$variables.subDocCode);\n\nreturn variableNames;"
          },
          "outcomes": {
            "success": "1761813692953"
          },
          "code": "VALIDATTRLISTCODE2",
          "id": "1761300839828",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "validMenuValuesList",
            "returnType": "object",
            "sourceCode": "let inputArray = $context.$nodes.FETCHMENUVALUESFROMVECTORDB.$output;\nconst result = {};\n\ninputArray.forEach(item => {\n    let parsedText;\n\n    try {\n        // Attempt to parse the JSON string\n        parsedText = JSON.parse(item.text);\n    } catch (e) {\n        // Skip this item and continue with the next one\n        return;\n    }\n\n    // Iterate through the keys (addressType_t, accountType_t, etc.)\n    for (let key in parsedText) {\n        if (parsedText.hasOwnProperty(key)) {\n            // Check if the value is an array\n            if (Array.isArray(parsedText[key])) {\n                if (!result[key]) result[key] = [];\n                result[key] = result[key].concat(parsedText[key]);\n\n            } else if (typeof parsedText[key] === 'object' && parsedText[key] !== null) {\n                // If the value is an object, extract values as an array\n                if (!result[key]) result[key] = [];\n                result[key] = result[key].concat(Object.values(parsedText[key]));\n            }\n        }\n    }\n});\n\n// Remove duplicates from each array\nfor (let key in result) {\n    result[key] = [...new Set(result[key])];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1761817319806"
          },
          "code": "VALIDMENUVALUESLIST",
          "id": "1761813692953",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "validCountryStateAttrs",
            "returnType": "object",
            "sourceCode": "let countryData = $context.$nodes.FETCHCOUNTRYATTRS.$output;\nlet stateData = $context.$nodes.FETCHSTATEATTRS.$output;\n\nlet countryAttrs = {};\nlet stateAttrs = {};\n\n// Parse country attributes safely\ntry {\n  countryAttrs = JSON.parse(countryData[0].text);\n} catch (e) {\n\n}\n\n// Parse state attributes safely\ntry {\n  stateAttrs = JSON.parse(stateData[0].text);\n} catch (e) {\n\n}\n\nconst result = {\n  countries: countryAttrs,\n  states: stateAttrs\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1763638485993"
          },
          "code": "VALIDCOUNTRYSTATEATTRS",
          "id": "1761817319806",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "validCountryValuesList",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FETCHCOUNTRYVALUESFROMVECTORDB.$output;\n\nconst variableNames = [];\n\ndata.forEach(item => {\n  try {\n    const parsed = JSON.parse(item.text); // Attempt to parse\n    if (Array.isArray(parsed)) {\n        variableNames.push(...Object.values(parsed));\n    }\n    else{\n        const firstKey = Object.keys(parsed)[0];\n            \n        if (firstKey && parsed[firstKey]) {\n          // Add the values of the first key\n          variableNames.push(...Object.values(parsed[firstKey]));\n        }\n    }\n\n  } catch (err) {\n    // Optionally skip or push a placeholder, but here we simply skip\n  }\n});\n\n\nreturn variableNames;"
          },
          "outcomes": {
            "success": "1763638582232"
          },
          "code": "VALIDCOUNTRYVALUESLIST",
          "id": "1763638485993",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "validStateValuesList",
            "returnType": "object",
            "sourceCode": "const data = $context.$nodes.FETCHSTATEVALUESFROMVECTORDB.$output;\n\nconst variableNames = [];\n\ndata.forEach(item => {\n  try {\n    const parsed = JSON.parse(item.text); // Attempt to parse\n    if (Array.isArray(parsed)) {\n        variableNames.push(...Object.values(parsed));\n    }\n    else{\n        const firstKey = Object.keys(parsed)[0];\n            \n        if (firstKey && parsed[firstKey]) {\n          // Add the values of the first key\n          variableNames.push(...Object.values(parsed[firstKey]));\n        }\n    }\n\n  } catch (err) {\n    // Optionally skip or push a placeholder, but here we simply skip\n  }\n});\n\n\nreturn variableNames;"
          },
          "outcomes": {
            "success": "1760615560429"
          },
          "code": "VALIDSTATEVALUESLIST",
          "id": "1763638582232",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "setAddressProps2"
          },
          "outcomes": {
            "success": "1769166087733"
          },
          "code": "SETADDRESSPROPS2",
          "id": "1760615560429",
          "inputs": [
            {
              "id": "1761817555475",
              "name": "stateAttrs",
              "type": "object",
              "value": "{{$context.$nodes.VALIDCOUNTRYSTATEATTRS.$output.result.states}}"
            },
            {
              "id": "1761817517733",
