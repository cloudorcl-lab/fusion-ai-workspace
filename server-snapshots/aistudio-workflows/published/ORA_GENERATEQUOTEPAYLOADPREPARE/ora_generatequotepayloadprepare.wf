        {
          "metadata": {
            "name": "setValidAttrsList"
          },
          "outcomes": {
            "success": "1769166087733"
          },
          "code": "SETVALIDATTRSLIST",
          "id": "1763457484416",
          "inputs": [
            {
              "id": "1763457496824",
              "name": "validAttrList",
              "type": "string",
              "value": "{{[$context.$variables.subDocCode]}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "combineResult",
            "returnType": "object",
            "sourceCode": "let normalizedAddressProperties = $context.$variables.addressProperties;\n\nif (typeof normalizedAddressProperties === \"string\") {\n    try {\n        normalizedAddressProperties = JSON.parse(normalizedAddressProperties);\n    } catch (e) {\n        // Keep original when value is not a JSON string\n    }\n}\n\nconst addressPropertiesString = JSON.stringify(normalizedAddressProperties);\nconst replacedAddressPropertiesString = addressPropertiesString.replace(/Customer-contactinfo/g, \"Customer\");\n\ntry {\n    normalizedAddressProperties = JSON.parse(replacedAddressPropertiesString);\n} catch (e) {\n    normalizedAddressProperties = $context.$variables.addressProperties;\n}\n\n// If vector format: [{ index, text: \"{...}\" }, ...]\n// convert to: { \"Section\": [\"attr1\", \"attr2\", ...], ... }\n// and merge duplicate section keys across indexes.\nif (Array.isArray(normalizedAddressProperties)) {\n    const mergedAddressProperties = {};\n\n    normalizedAddressProperties.forEach((entry) => {\n        if (!entry || typeof entry !== \"object\") return;\n\n        let parsedText = entry.text;\n        if (typeof parsedText === \"string\") {\n            try {\n                parsedText = JSON.parse(parsedText);\n            } catch (e) {\n                return;\n            }\n        }\n\n        if (!parsedText || typeof parsedText !== \"object\" || Array.isArray(parsedText)) return;\n\n        Object.entries(parsedText).forEach(([sectionName, sectionValue]) => {\n            const mappedSectionName = sectionName === \"Customer properties\"\n                ? \"Customer Header\"\n                : sectionName === \"General Account Address\"\n                    ? \"Customer Address\"\n                    : sectionName;\n\n            if (!mergedAddressProperties[mappedSectionName]) {\n                mergedAddressProperties[mappedSectionName] = [];\n            }\n\n            if (Array.isArray(sectionValue)) {\n                mergedAddressProperties[mappedSectionName].push(...sectionValue);\n            } else if (sectionValue && typeof sectionValue === \"object\") {\n                const orderedValues = Object.keys(sectionValue)\n                    .sort((a, b) => Number(a) - Number(b))\n                    .map((k) => sectionValue[k]);\n                mergedAddressProperties[mappedSectionName].push(...orderedValues);\n            }\n        });\n    });\n\n    Object.keys(mergedAddressProperties).forEach((sectionName) => {\n        mergedAddressProperties[sectionName] = [...new Set(mergedAddressProperties[sectionName])];\n    });\n\n    normalizedAddressProperties = mergedAddressProperties;\n}\n\n//remove multi line from address. it causes problem\nlet customerAddress = $context.$variables.customerAddress;\n\nif (customerAddress && Array.isArray(customerAddress.items)) {\n    customerAddress.items.forEach(item => {\n        if (item && typeof item === 'object') {\n            for (let key in item) {\n                let value = item[key];\n\n                if (typeof value === 'string') {\n                    item[key] = value.replace(/<BR\\s*\\/?>/gi, '\\n');\n                } else if (Array.isArray(value)) {\n                    // Only replace strings directly inside arrays (no deep recursion)\n                    for (let i = 0; i < value.length; i++) {\n                        if (typeof value[i] === 'string') {\n                            value[i] = value[i].replace(/<BR\\s*\\/?>/gi, '\\n');\n                        }\n                    }\n                }\n            }\n        }\n    });\n}\n\n\n\nlet combinedResult = {\n    customerProperties: normalizedAddressProperties,\n    menuValues: $context.$variables.menuValues,\n    countryValues: $context.$variables.countryValues,\n    stateValues: $context.$variables.stateValues,\n    subDocCode: $context.$variables.subDocCode,\n    mainDocCode: $context.$variables.mainDocCode,\n    customerDetail: $context.$variables.customerDetail,\n    customerAddress: $context.$variables.customerAddress,\n    productSearchCompletion: $context.$variables.productSearchCompletion,\n    validAttrList: $context.$variables.validAttrList \n};\n\nreturn combinedResult;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "COMBINERESULT",
          "id": "1769166087733",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "sanitizeCustomerData",
            "returnType": "object",
            "sourceCode": "const detail = $context.$nodes.CUSTOMERINFOBO.$output;\nconst address = $context.$nodes.CUSTOMERADDRESSBO.$output;\n\nlet customerDetail = detail;\nif (detail && typeof detail === \"object\") {\n  customerDetail[\"partyUniqueName\"] = $context.$variables.partyUniqueName;\n  customerDetail = { ...detail };\n  delete customerDetail[\"@context\"];\n  delete customerDetail.links;\n}\n\nlet customerAddress = address;\nif (address && typeof address === \"object\") {\n  customerAddress = { ...address };\n  delete customerAddress[\"@context\"];\n  delete customerAddress.links;\n\n  if (Array.isArray(customerAddress.items)) {\n    customerAddress.items = customerAddress.items.map((item) => {\n      if (item && typeof item === \"object\") {\n        const sanitizedItem = { ...item };\n        delete sanitizedItem[\"@context\"];\n        delete sanitizedItem.links;\n        return sanitizedItem;\n      }\n      return item;\n    });\n  }\n}\n\nreturn {\n  customerDetail,\n  customerAddress\n};"
          },
          "outcomes": {
            "success": "1762169862431"
          },
          "code": "SANITIZECUSTOMERDATA",
          "id": "1774947917847",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
      ],
