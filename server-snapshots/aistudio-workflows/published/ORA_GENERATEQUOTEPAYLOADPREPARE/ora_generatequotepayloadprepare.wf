              "type": "string",
              "value": "{{$context.$nodes.VALIDATTRLISTCODE2.$output.result}}"
            },
            {
              "id": "1760615605050",
              "name": "addressProperties",
              "type": "string",
              "value": "{{JSON.stringify($context.$nodes.FETCHADDRESSPROPSFROMVECTORDB.$output)}}"
            },
