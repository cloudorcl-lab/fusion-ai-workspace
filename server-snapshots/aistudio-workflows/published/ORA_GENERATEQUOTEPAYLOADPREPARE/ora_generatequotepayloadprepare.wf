            "returnType": "string",
            "sourceCode": "if($context.$nodes.FILTERMENUATTRS.$output.result.length > 0){\n   return \"a\";\n}\nelse{\n  throw new Error(\"Routing\");\n}\nreturn \"a\";"
          },
          "outcomes": {
