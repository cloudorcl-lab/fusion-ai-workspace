        },
        {
          "metadata": {
            "agentCode": "ORA_ADDRESSPROP",
            "name": "identifyAddressAttrs"
          },
          "outcomes": {
            "success": "1760614174013"
          },
          "code": "IDENTIFYADDRESSATTRS",
          "id": "1760614084833",
          "inputs": [
            {
              "id": "1760614095245_1",
              "name": "message",
              "type": "string",
              "value": "{{$context.$variables.quoteVarName}}"
            },
            {
              "id": "1760614095246_2",
              "name": "documentVarName",
              "type": "string",
              "value": "{{$context.$variables.mainDocCode}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"Customer-contactinfo properties\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"General Account Address\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"Bill To Address\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"Ship To Address\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    },\n    \"Invoice To Address\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" }\n    }\n  },\n  \"required\": [\n    \"Customer-contactinfo properties\",\n    \"General Account Address\",\n    \"Bill To Address\",\n    \"Ship To Address\",\n    \"Invoice To Address\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "AGENT"
        },
        {
          "metadata": {
            "name": "extractJson",
            "sourceCode": "const text = $context.$nodes.IDENTIFYADDRESSATTRS.$output;\nlet result = text; // default return value\n\nif (typeof text === \"string\") {\n  const match = text.match(/\\{[\\s\\S]*\\}/); // matches first {...} block\n  if (match) {\n    try {\n      result = JSON.parse(match[0]);\n    } catch (err) {\n      // ignore parse errors silently\n    }\n  }\n}\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1760614192164"
          },
          "code": "EXTRACTJSON",
          "id": "1760614174013",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "removeInvalidAttrs",
            "sourceCode": "// Example data\nconst obj1 = $context.$nodes.EXTRACTJSON.$output.result; \n\nconst obj2 = $context.$nodes.POPULATEDOCATTRS.$output.result; \n\n// STEP 1: Extract all variableNames from obj2\nconst validProps = new Set(Object.keys(obj2));\n\n// STEP 2: Build a filtered version of obj1\nconst filteredObj1 = {};\n\nfor (const [section, props] of Object.entries(obj1)) {\n\n    if (section === \"Invoice To Address\") continue;\n\n    if (Array.isArray(props)) {\n      // keep only those props that are present in validProps\n      const filteredProps = props.filter(p => validProps.has(p));\n            \n      // only include if non-empty\n      if (filteredProps.length > 0) {\n        filteredObj1[section] = filteredProps;\n      }\n    }\n}\n\nreturn JSON.stringify(filteredObj1);"
          },
          "outcomes": {
            "success": "1760614212981"
          },
          "code": "REMOVEINVALIDATTRS",
          "id": "1760614192164",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "filterMenuAttrs",
            "sourceCode": "const obj1 = $context.$nodes.REMOVEINVALIDATTRS.$output.result; \n\nconst obj2 = $context.$nodes.POPULATEDOCATTRS.$output.result; \n\nconst menuKeys = new Set(\n  Object.entries(obj2)\n    .filter(([_, value]) => [\"Menu\"].includes(value))\n    .map(([key]) => key)\n);\n\n// STEP 2: Flatten all obj1 properties and filter by menuKeys\nconst menuAttributes = Object.values(obj1)\n  .flat()                          // combine all arrays into one\n  .filter(prop => menuKeys.has(prop)); // keep only those present in menuKeys\n\nreturn JSON.stringify(menuAttributes);"
          },
          "outcomes": {
            "success": "1760614227485"
          },
          "code": "FILTERMENUATTRS",
          "id": "1760614212981",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "filterCountryAttrs",
            "sourceCode": "const obj1 = $context.$nodes.REMOVEINVALIDATTRS.$output.result; \n\nconst obj2 =  $context.$nodes.POPULATEDOCATTRS.$output.result;\n\nconst menuKeys = new Set(\n  Object.entries(obj2)\n    .filter(([_, value]) => [\"Country\"].includes(value))\n    .map(([key]) => key)\n);\n\n// STEP 2: Flatten all obj1 properties and filter by menuKeys\nconst menuAttributes = Object.values(obj1)\n  .flat()                          // combine all arrays into one\n  .filter(prop => menuKeys.has(prop)); // keep only those present in menuKeys\n\nreturn JSON.stringify(menuAttributes);"
          },
          "outcomes": {
            "success": "1760614248112"
          },
          "code": "FILTERCOUNTRYATTRS",
          "id": "1760614227485",
          "inputs": [],
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "filterStateAttrs",
            "sourceCode": "const obj1 = $context.$nodes.REMOVEINVALIDATTRS.$output.result; \n\nconst obj2 =  $context.$nodes.POPULATEDOCATTRS.$output.result;\n\nconst menuKeys = new Set(\n  Object.entries(obj2)\n    .filter(([_, value]) => [\"State\"].includes(value))\n    .map(([key]) => key)\n);\n\n// STEP 2: Flatten all obj1 properties and filter by menuKeys\nconst menuAttributes = Object.values(obj1)\n  .flat()                          // combine all arrays into one\n  .filter(prop => menuKeys.has(prop)); // keep only those present in menuKeys\n\nreturn JSON.stringify(menuAttributes);"
          },
          "outcomes": {
            "success": "1768911682776"
          },
          "code": "FILTERSTATEATTRS",
          "id": "1760614248112",
          "inputs": [],
          "type": "CODE"
        },
