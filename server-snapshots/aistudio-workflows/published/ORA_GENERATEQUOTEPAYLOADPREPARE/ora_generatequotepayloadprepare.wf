        {
          "metadata": {
            "name": "populateDocAttrs",
            "sourceCode": "const obj = $context.$nodes.INVOKEDOCATTRS.$output; \n\n// Convert to desired format\nconst result = Object.fromEntries(\n  obj.items.map(item => [item.variableName, item.type.displayValue])\n);\n\nreturn JSON.stringify(result);"
          },
          "outcomes": {
            "success": "1760614084833"
