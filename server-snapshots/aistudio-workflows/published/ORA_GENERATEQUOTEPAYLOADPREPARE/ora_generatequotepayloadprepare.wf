        {
          "metadata": {
            "name": "setDocumentCodes1",
            "sourceCode": "let outputNode = $context.$nodes.GETDOCCODESFROMVECTORDB.$output[0].text;\nif (outputNode.output != null){\n   outputNode = outputNode.output;\n}\n\nconst mainDoc = outputNode.split('|')[0];\nconst subDoc = outputNode.split('|')[1];\n\nconst result = {\"mainDoc\" : mainDoc , \"subDoc\" : subDoc};\n\nreturn JSON.stringify(result);"
          },
