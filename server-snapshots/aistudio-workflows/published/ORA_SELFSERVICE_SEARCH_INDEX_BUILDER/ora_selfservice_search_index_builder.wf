{
  "workflowId": "300000331056453",
  "workflowCode": "ORA_SELFSERVICE_SEARCH_INDEX_BUILDER",
  "name": "SelfService Search Index Builder",
  "description": "An ingestion and indexing service that processes self-service agent configurations to power semantic search and routing. It retrieves agent descriptions via APIs, generates vector embeddings for both descriptions and supported user phrases, and stores them in optimized vector indexes. These indexes are used at query time to identify the most relevant agent through similarity search and weighted scoring.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
