        {
          "metadata": {
            "businessObjectCode": "ORA_CX_CPQCOMMERC_SELFSERVICEAIOUTCOMESTORE",
            "functionName": "getOutcomeBy_Object_Type",
            "processJson": true,
            "name": "Get SelfService Search Agent Map"
          },
          "outcomes": {
            "success": "1776630027589"
          },
          "code": "GET_SELFSERVICE_SEARCH_AGENT_MAP",
          "id": "1776629327571",
          "inputs": [
            {
              "id": "1776629363035_1",
              "name": "pFilter",
              "type": "string",
              "value": "primaryObjectType in ('SelfServiceSearchAgentMap')"
            },
            {
              "id": "1776629363036_2",
              "name": "pFields",
              "type": "string",
              "value": "payload"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Flattened Phrases",
            "returnType": "object",
            "sourceCode": "\nconst payload = JSON.parse($context.$nodes.GET_SELFSERVICE_SEARCH_AGENT_MAP.$output.items[0].payload);\nconst agentsObj = payload.what.facts.agents;\n\n// agentCodes\nconst agentCodes = Object.keys(agentsObj);\n\n// agentCodes as string\nconst agentCodesString = `(${agentCodes.map(a => `'${a}'`).join(\",\")})`;\n\n// flattened in required format\nconst flattened = Object.entries(agentsObj).flatMap(([agentCode, data]) =>\n  data.embeddingPhrases.map(phrase =>\n    `Agent=${agentCode} | ${phrase.trim()}`\n  )\n);\n\nreturn [agentCodes, agentCodesString, flattened];"
          },
          "outcomes": {
            "success": "1776630602929"
          },
          "code": "GET_FLATTENED_PHRASES",
          "id": "1776630027589",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_HCM_OTHER_GETAGENTSLISTS",
            "functionName": "getall_hcmAgentWorkflowsV2_by_workflowcode",
            "processJson": true,
            "name": "Get Agent Details"
          },
          "outcomes": {
            "success": "1776633249861"
          },
          "code": "GET_AGENT_DETAILS",
          "id": "1776630602929",
          "inputs": [
            {
              "id": "1776630937659_1",
              "name": "workflowcodes",
              "type": "string",
              "value": "{{$context.$nodes.GET_FLATTENED_PHRASES.$output.result[1]}}"
            },
            {
              "id": "1776630937660_2",
              "name": "limit",
              "type": "string"
            },
            {
              "id": "1776630937661_3",
              "name": "offset",
              "type": "string"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Flattened Agent Descriptions",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.GET_AGENT_DETAILS.$output;\n\nconst agentCodesSet = new Set($context.$nodes.GET_FLATTENED_PHRASES.$output.result[0]);\n\nconst items = response.items || [];\n\n// only PUBLISHED + matching WorkflowCode\nconst publishedAgents = items.filter(item =>\n  item.Status === \"PUBLISHED\" && agentCodesSet.has(item.WorkflowCode)\n);\n\n// flat structure in required format\nconst flattened = publishedAgents.map(item =>\n  `Agent=${item.WorkflowCode} | ${item.Description.trim()}`\n);\n\nreturn flattened;"
          },
          "outcomes": {
            "success": "1776634012801"
          },
          "code": "GET_FLATTENED_AGENT_DESCRIPTIONS",
          "id": "1776633249861",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
