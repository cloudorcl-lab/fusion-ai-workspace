        {
          "metadata": {
            "name": "create stockout table data",
            "returnType": "array",
            "sourceCode": "const response = $context.$nodes.TOP_STOCKOUTS_DATA.$output;\nconst TOP_N = $context.$nodes.CONSTRUCT_STOCKOUT_PAYLOAD.$output.result.topN;\n\nif (response && response.stockoutInsights && response.stockoutInsights.length > 0) {\n\n    const result = response.stockoutInsights\n        .filter(item => item.rank <= TOP_N)\n        .map(item => {\n            const firstStockoutValue = item.firstStockoutQty * item.price;\n\n            return {\n                Segment: item.segmentName,\n                Item: item.itemName,\n                Location: item.organizationCode,\n                \"Revenue at Risk\": item.revenueImpact,\n                \"First Stockout Date\": item.firstStockoutDate,\n                \"First Stockout Quantity\": item.firstStockoutQty,\n                \"First Stockout Value\": firstStockoutValue,\n                organizationId: item.orgLvlMemberId,\n                inventoryItemId: item.prdLvlMemberId\n            };\n        });\n\n    return result;\n}\n\nreturn [];"
          },
          "outcomes": {
            "success": "1776287490645"
          },
          "code": "CREATE_STOCKOUT_TABLE_DATA",
          "id": "1776287405876",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
