          "metadata": {
            "name": "construct context data",
            "returnType": "object",
            "sourceCode": "let contextData = $context.$nodes.GETITEMORGCONTEXT.$output.result;\n\n// Extract required fields directly from contextData\nconst PlanName = contextData.PlanName || \"\";\nconst itemName = contextData.ItemName || \"\";\nconst location = contextData.Location || \"\";\nconst SegmentName = contextData.SegmentName || \"\";\n\n// Create document identifier as JSON string\nconst documentIdentifier = JSON.stringify({\n    planName: PlanName,\n    itemName: itemName,\n    locationName: location,\n    segmentName: SegmentName\n});\n\n// Build final data object\nconst data = {\n    organizationId: contextData.organizationId,\n    inventoryItemId: contextData.inventoryItemId,\n    PlanId: contextData.PlanId\n};\n\n// Final object\nreturn {\n    documentIdentifier,\n    data\n};"
          },
