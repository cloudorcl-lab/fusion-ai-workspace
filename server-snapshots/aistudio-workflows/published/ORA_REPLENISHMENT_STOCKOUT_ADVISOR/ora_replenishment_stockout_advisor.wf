        },
        {
          "metadata": {
            "name": "getItemOrgContext",
            "returnType": "object",
            "sourceCode": "var oraAction = $context.$app.$OraAction;\nvar command = {};\n\nif (oraAction) {\n  if (typeof oraAction === \"string\") {\n    command = JSON.parse(oraAction);\n  } else {\n    command = oraAction;\n  }\n}\n\n\nvar inventoryItemId =command.inventoryItemId;\nvar organizationId =command. organizationId;\nvar SegmentName = command.SegmentName;\nvar ItemName = command.ItemName;\nvar Location = command.Location;\nvar PlanId = command.PlanId;\nvar PlanName = command.PlanName;\n\n\nreturn {\n inventoryItemId: inventoryItemId,\n organizationId: organizationId,\n SegmentName: SegmentName,\n ItemName: ItemName,\nlocationName:Location,\n Location: Location,\nPlanId: PlanId,\nPlanName: PlanName\n};"
          },
          "outcomes": {
            "success": "1775608441519"
          },
          "code": "GETITEMORGCONTEXT",
          "id": "1775608234987",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "generate commit payload",
            "returnType": "object",
            "sourceCode": "var rawOraAction = $context?.$app?.$OraAction ?? $context?.$app?.OraAction;\n\n// Helper to remove null/undefined\nconst clean = (obj) =>\n  Object.fromEntries(Object.entries(obj).filter(([_, v]) => v != null));\n\nconst normalizeJsonLikeString = (text) => {\n  if (typeof text !== \"string\") return text;\n\n  return text.replace(\n    /(:\\s*)([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*[,}\\]])/g,\n    (match, prefix, value) => {\n      if (/^(true|false|null)$/i.test(value)) return match;\n      if (/^[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$/.test(value)) return match;\n      return `${prefix}\"${value}\"`;\n    }\n  );\n};\n\nconst safeParse = (value) => {\n  if (value == null) return {};\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return {};\n\n  const text = value.trim();\n\n  // Handle <oraFormSubmit ...> payloads if they ever appear\n  if (text.includes(\"<oraFormSubmit\")) {\n    try {\n      const jsonMatch = text.match(/\\[.*\\]/s);\n      if (jsonMatch) {\n        const formData = JSON.parse(jsonMatch[0]);\n        const selectedPlan = formData.find((item) => item.id === \"plan\");\n\n        return {\n          command: \"ViewDetails\",\n          PlanId: selectedPlan?.value || null,\n        };\n      }\n    } catch (e) {\n      console.error(\"Error parsing oraFormSubmit payload:\", e);\n      return {};\n    }\n  }\n\n  // Try strict JSON first\n  try {\n    return JSON.parse(text);\n  } catch (e1) {\n    // Retry after repairing bareword values\n    try {\n      return JSON.parse(normalizeJsonLikeString(text));\n    } catch (e2) {\n      console.error(\"Error parsing oraAction:\", e1, e2);\n      return {};\n    }\n  }\n};\n\nlet command = safeParse(rawOraAction);\n\n// If wrapped like { OraAction: \"....\" }, parse the inner string too\nif (command && typeof command === \"object\" && typeof command.OraAction === \"string\") {\n  command = safeParse(command.OraAction);\n}\n\n// If the payload is wrapped deeper, unwrap common shapes\nif (command?.result?.payload) {\n  command = command.result.payload;\n} else if (command?.payload) {\n  command = command.payload;\n} else if (command?.result) {\n  command = command.result;\n}\n\nconst {\n  PlanName,\n  planId,\n  organizationId,\n  inventoryItemId,\n  SegmentName,\n  ItemName,\n  Location,\n  resolutions = {}\n} = command;\n\n// Root cause mapping\nconst mapRootCause = (val) => {\n  if (val === \"Supply Constraints\") return 1;\n  if (val === \"Lead Time Constraints\") return 2;\n  return val;\n};\n\n// Handle nested resolutions safely\nconst actualRes = resolutions.resolutions || resolutions;\n\nlet expedites = (actualRes.expedites || []).map((exp) => {\n  let updated = { ...exp };\n\n  if (\"orderQuantity\" in updated) {\n    updated.quantity = updated.orderQuantity;\n    delete updated.orderQuantity;\n  }\n\n  if (\"recommendedDueDate\" in updated) {\n    updated.dueDate = updated.recommendedDueDate;\n    delete updated.recommendedDueDate;\n  }\n\n  if (\"existingDueDate\" in updated) {\n    updated.oldDueDate = updated.existingDueDate;\n    delete updated.existingDueDate;\n  }\n\n  if (\"rootCause\" in updated) {\n    updated.rootCause = mapRootCause(updated.rootCause);\n  }\n\n  if (\"costImpact\" in updated) {\n    delete updated.costImpact;\n  }\n\n  return clean(updated);\n});\n\nlet creates = (actualRes.creates || []).map((cr) => {\n  let updated = { ...cr };\n\n  if (\"orderQuantity\" in updated) {\n    updated.quantity = updated.orderQuantity;\n    delete updated.orderQuantity;\n  }\n\n  if (\"recommendedDueDate\" in updated) {\n    updated.dueDate = updated.recommendedDueDate;\n    delete updated.recommendedDueDate;\n  }\n\n  if (\"orderType\" in updated) {\n    updated.sourceTypeText = updated.orderType;\n    delete updated.orderType;\n  }\n\n  if (\"rootCause\" in updated) {\n    updated.rootCause = mapRootCause(updated.rootCause);\n  }\n\n  if (\"costImpact\" in updated) {\n    delete updated.costImpact;\n  }\n\n  return clean(updated);\n});\n\nlet policyOverride = {};\n\nif (actualRes.policyEnhancements && typeof actualRes.policyEnhancements === \"object\") {\n  let updated = { ...actualRes.policyEnhancements };\n\n  if (\"minimumQuantity\" in updated) {\n    updated.oldMin = updated.minimumQuantity;\n    delete updated.minimumQuantity;\n  }\n\n  if (\"suggestedMinimumQuantity\" in updated) {\n    updated.minimumQuantityOverride = updated.suggestedMinimumQuantity;\n    delete updated.suggestedMinimumQuantity;\n  }\n\n  if (\"maximumQuantity\" in updated) {\n    updated.oldMax = updated.maximumQuantity;\n    delete updated.maximumQuantity;\n  }\n\n  if (\"suggestedMaximumQuantity\" in updated) {\n    updated.maximumQuantityOverride = updated.suggestedMaximumQuantity;\n    delete updated.suggestedMaximumQuantity;\n  }\n\n  if (\"ROPQuantity\" in updated) {\n    updated.oldROP = updated.ROPQuantity;\n    delete updated.ROPQuantity;\n  }\n\n  if (\"suggestedROPQuantity\" in updated) {\n    updated.ROPOverride = updated.suggestedROPQuantity;\n    delete updated.suggestedROPQuantity;\n  }\n\n  if (\"EOQQuantity\" in updated) {\n    updated.oldEOQ = updated.EOQQuantity;\n    delete updated.EOQQuantity;\n  }\n\n  if (\"suggestedEOQQuantity\" in updated) {\n    updated.EOQOverride = updated.suggestedEOQQuantity;\n    delete updated.suggestedEOQQuantity;\n  }\n\n  policyOverride = clean(updated);\n}\n\nconst advice = {\n  ...(expedites.length > 0 && { expedites }),\n  ...(creates.length > 0 && { creates }),\n  ...(Object.keys(policyOverride).length > 0 && { policyOverride })\n};\n\nreturn {\n  PlanName,\n  planId,\n  organizationId,\n  inventoryItemId,\n  SegmentName,\n  ItemName,\n  Location,\n  ...(Object.keys(advice).length > 0 && {\n    resolutions: {\n      advice\n    }\n  })\n};"
          },
          "outcomes": {
            "success": "1775683562135"
          },
          "code": "GENERATE_COMMIT_PAYLOAD",
          "id": "1775683535567",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
