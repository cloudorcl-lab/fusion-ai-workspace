          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "Reconstruct DB Data",
            "returnType": "object",
            "sourceCode": "var dbData = $context.$nodes.READ_CONTEXT.$output;\nvar plancontext = $context.$nodes.READ_PLANCONTEXT.$output;\n\nvar documentIdentifier = \"\";\nvar planName = \"\";\nvar segmentName = \"\";\nvar itemName = \"\";\nvar locationName = \"\";\nvar organizationId = \"\";\nvar inventoryItemId = \"\";\nvar PlanId = \"\";\n\nvar dataExists = false;\n\n// Read from dbData first\nfor (var i = 0; i < dbData.length; i++) {\n  var row = dbData[i];\n  var parsed = row && row.text ? JSON.parse(row.text) : row;\n\n  if (!parsed) continue;\n\n  var payload = parsed.result ? parsed.result : parsed;\n  if (!payload) continue;\n\n  if (!documentIdentifier) {\n    documentIdentifier =\n      row.documentIdentifier ||\n      parsed.documentIdentifier ||\n      payload.documentIdentifier ||\n      \"\";\n  }\n\n  if (!organizationId && payload.organizationId) {\n    organizationId = payload.organizationId;\n  }\n\n  if (!inventoryItemId && payload.inventoryItemId) {\n    inventoryItemId = payload.inventoryItemId;\n  }\n\n  if (!PlanId && payload.PlanId) {\n    PlanId = payload.PlanId;\n  }\n}\n\ndataExists = Boolean(documentIdentifier);\n\n// Parse documentIdentifier\nif (documentIdentifier) {\n  try {\n    var parsedDoc = JSON.parse(documentIdentifier);\n\n    planName = parsedDoc.planName || \"\";\n    itemName = parsedDoc.itemName || \"\";\n    locationName = parsedDoc.locationName || \"\";\n    segmentName = parsedDoc.segmentName || \"\";\n  } catch (e) {\n    // Fallback for old underscore-based format\n    var parts = documentIdentifier.split(\"_\");\n    planName = parts[0] || \"\";\n    itemName = parts[1] || \"\";\n    locationName = parts[2] || \"\";\n    segmentName = parts[3] || \"\";\n  }\n}\n\n// Only use plancontext if dbData did NOT produce dataExists\nif (!dataExists && plancontext && plancontext.length > 0) {\n  for (var j = 0; j < plancontext.length; j++) {\n    var ctxRow = plancontext[j];\n    var ctxText = ctxRow && ctxRow.text ? String(ctxRow.text).trim() : \"\";\n\n    if (!ctxText) continue;\n\n    try {\n      var ctxParsed = JSON.parse(ctxText);\n      if (ctxParsed && ctxParsed.PlanId) {\n        PlanId = String(ctxParsed.PlanId).trim();\n        dataExists = true;\n        break;\n      }\n    } catch (e) {\n      // Fallback: if text is already just the PlanId\n      PlanId = ctxText;\n      dataExists = true;\n      break;\n    }\n  }\n}\n\nreturn {\n  documentIdentifier: documentIdentifier,\n  planName: planName,\n  itemName: itemName,\n  locationName: locationName,\n  segmentName: segmentName,\n  organizationId: organizationId,\n  inventoryItemId: inventoryItemId,\n  PlanId: PlanId,\n  dataExists: dataExists\n};"
          },
          "outcomes": {
            "success": "1776393572782"
          },
