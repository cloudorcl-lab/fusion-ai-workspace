        {
          "metadata": {
            "name": "Generate Table Data",
            "returnType": "object",
            "sourceCode": "let beforeResponse = $context.$nodes.GET_BEFORE_PAB_DATA.$output;\nlet afterResponse  = $context.$nodes.GET_AFTER_PAB_DATA.$output;\n\nlet beforeResult = beforeResponse?.result || [];\nlet afterResult  = afterResponse?.result || [];\n\nlet dates = beforeResult.map(item => item.factDate);\n\nlet beforePab = beforeResult.map(item => item.pab);\nlet afterPab  = afterResult.map(item => item.pab);\n\nlet advice = afterResponse?.advice || {};\nlet summary = afterResponse?.summary || {};\n\nlet revenueImpact = afterResponse.summary.revenueImpact && afterResponse.summary.revenueImpact !== 0 ? afterResponse.summary.revenueImpact : beforeResponse.summary.revenueImpact;\n\nlet resExpedites = (advice.expedites || []).map(item => {\n  let { costImpact, ...rest } = item; // remove costImpact\n  return rest; // keep original rootCause (no transform)\n});\n\nlet resCreates = (advice.creates || []).map(item => {\n  let { costImpact, ...rest } = item; // remove costImpact\n  return rest;\n});\n\nlet resPolicyOverride = advice.policyOverride || [];\n\n\nlet advExpedites = (advice.expedites || []).map(item => ({\n  ...item,\n  rootCause: item.rootCause == 1 \n    ? \"Supply Constraints\" \n    : \"Lead Time Constraints\",\n  orderNumber: item.orderNumber ?? \"\",\n  costImpact: (summary.price || 0) * (item.quantity || 0)\n}));\n\nlet advCreates = (advice.creates || []).map(item => ({\n  ...item,\n  costImpact: (summary.price || 0) * (item.quantity || 0)\n}));\n\n// changed only this part\nlet advPolicyOverride = advice.policyOverride || {};\n\nlet isValid =\n  advExpedites.length > 0 ||\n  advCreates.length > 0 ||\n  Object.keys(advPolicyOverride).length > 0;\n\n\nreturn {\nrevenueImpact,\n  isValid,\n  dates,\n  beforePab,\n  afterPab,\n  resolutions: {\n    expedites: resExpedites,\n    creates: resCreates,\n    policyEnhancements: resPolicyOverride\n  },\n  advice: {\n    expedites: advExpedites,\n    creates: advCreates,\n    policyOverride: advPolicyOverride\n  }\n};"
          },
          "outcomes": {
            "success": "1779389019282"
          },
          "code": "GENERATE_TABLE_DATA",
