            "name": "get plan id",
            "returnType": "object",
            "sourceCode": "let raw = $context.$nodes.READ_PLAN_DETAILS.$output[0]?.text;\n\n// Safe parse helper\nconst safeParse = (str) => {\n  if (!str || typeof str !== \"string\") return {};\n\n  try {\n    // Trim and remove trailing spaces\n    let cleaned = str.trim();\n\n    // Fix double quotes wrapping issue if present\n    if (cleaned.startsWith('\"') && cleaned.endsWith('\"')) {\n      cleaned = cleaned.slice(1, -1);\n    }\n\n    return JSON.parse(cleaned);\n  } catch (e) {\n    console.error(\"Parse error:\", e);\n    return {};\n  }\n};\n\nlet parsed = safeParse(raw);\n\n// Extract planId\nlet planId = parsed?.planId ?? null;\n\nreturn {\n  planId\n};"
          },
