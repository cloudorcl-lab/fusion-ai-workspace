        {
          "metadata": {
            "name": "Action Resolver",
            "returnType": "object",
            "sourceCode": "let raw = $context?.$app?.$OraAction ?? $context?.$app?.OraAction;\n\nconsole.log(\"raw oraAction:\", raw);\n\nconst clean = (obj) =>\n  Object.fromEntries(Object.entries(obj).filter(([_, v]) => v != null));\n\nconst normalizeJsonLikeString = (text) => {\n  if (typeof text !== \"string\") return text;\n\n  let out = text;\n\n  out = out.replace(\n    /(:\\s*)([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*[,}\\]])/g,\n    (match, prefix, value) => {\n      if (/^(true|false|null)$/i.test(value)) return match;\n      if (/^[+-]?\\d+(\\.\\d+)?([eE][+-]?\\d+)?$/.test(value)) return match;\n      return `${prefix}\"${value}\"`;\n    }\n  );\n\n  return out;\n};\n\nconst safeParse = (value) => {\n  if (value == null) return {};\n  if (typeof value === \"object\") return value;\n  if (typeof value !== \"string\") return {};\n\n  const text = value.trim();\n\n  if (text.includes(\"<oraFormSubmit\")) {\n    try {\n      const jsonMatch = text.match(/\\[.*\\]/s);\n      if (jsonMatch) {\n        const formData = JSON.parse(jsonMatch[0]);\n        const selectedPlan = formData.find((item) => item.id === \"plan\");\n\n        return {\n          command: \"ViewDetails\",\n          PlanId: selectedPlan?.value || null,\n        };\n      }\n    } catch (e) {\n      console.error(\"Failed to parse oraFormSubmit payload:\", e);\n    }\n    return {};\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e1) {\n    try {\n      return JSON.parse(normalizeJsonLikeString(text));\n    } catch (e2) {\n      console.error(\"Failed to parse oraAction:\", e1, e2);\n      return {};\n    }\n  }\n};\n\nlet parsed = safeParse(raw);\n\n// If the outer wrapper contains OraAction as a string, parse that too\nif (parsed && typeof parsed === \"object\" && typeof parsed.OraAction === \"string\") {\n  parsed = safeParse(parsed.OraAction);\n}\n\n// Split into command + remaining payload\nlet { command: cmd, Command, ...payload } = parsed || {};\ncmd = cmd || Command || null;\n\nreturn clean({\n  command: cmd,\n  payload: clean(payload),\n});"
          },
          "outcomes": {
            "success": "1773618092858"
          },
