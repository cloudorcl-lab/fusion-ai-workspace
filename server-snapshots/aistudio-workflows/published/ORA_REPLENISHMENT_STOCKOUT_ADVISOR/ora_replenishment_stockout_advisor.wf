        {
          "metadata": {
            "name": "getplanIdcontext",
            "returnType": "object",
            "sourceCode": "var oraAction = $context.$app.$OraAction;\nvar command = {};\nvar planId = null;\n\nif (oraAction) {\n  try {\n    // Case 1: oraFormSubmit\n    if (typeof oraAction === \"string\" && oraAction.includes(\"<oraFormSubmit\")) {\n\n      const jsonMatch = oraAction.match(/\\[.*\\]/s);\n\n      if (jsonMatch) {\n        const formData = JSON.parse(jsonMatch[0]);\n\n        const selectedPlan = formData.find(item => \n          typeof item.value === \"string\" &&\n          /^\\d{10,}$/.test(item.value)\n        );\n\n        planId = selectedPlan?.value || null;\n      }\n\n    } \n    // Case 2: normal JSON\n    else if (typeof oraAction === \"string\") {\n      command = JSON.parse(oraAction);\n      planId = command.PlanId || null;\n    } \n    // Case 3: already object\n    else {\n      command = oraAction;\n      planId = command.PlanId || null;\n    }\n\n  } catch (e) {\n    console.error(\"Error parsing oraAction:\", e);\n  }\n}\n\nreturn planId;"
          },
          "outcomes": {
            "success": "1776392125655"
          },
          "code": "GETPLANIDCONTEXT",
