            "sourceCode": "let dbData = $context.$nodes.READ_SEARCH_CONTEXT.$output || [];\nlet docId = $context.$nodes.CONSTRUCT_CONTEXT_DATA.$output?.result?.documentIdentifier;\n\nlet unmatched = dbData\n  .filter((item) => item.documentIdentifier !== docId)\n  .map((item) => {\n    let parsed = item.text;\n\n    try {\n      parsed = typeof item.text === \"string\" ? JSON.parse(item.text) : item.text;\n    } catch (e) {\n      parsed = null;\n    }\n\n    return {\n      documentIdentifier: item.documentIdentifier,\n      data: parsed\n    };\n  });\n\nreturn unmatched;"
          },
