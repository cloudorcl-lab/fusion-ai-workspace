        {
          "metadata": {
            "name": "Intent cleaning up",
            "returnType": "object",
            "sourceCode": "// Get reconstructed DB data\nvar ParsedData = $context.$nodes.RECONSTRUCT_DB_DATA.$output.result || {};\n\n// Get raw intent output\nvar RawIntentOutput = $context.$nodes.ANALYSE_INTENT.$output;\n\n// Parse intent safely\nfunction parseIntent(raw) {\n  if (!raw) return null;\n\n  if (typeof raw === \"object\") {\n    return raw.intent || null;\n  }\n\n  if (typeof raw === \"string\") {\n    var cleaned = raw\n      .trim()\n      .replace(/^```json\\s*/i, \"\")\n      .replace(/^```\\s*/i, \"\")\n      .replace(/\\s*```$/, \"\")\n      .trim();\n\n    try {\n      var parsed = JSON.parse(cleaned);\n      return parsed.intent || null;\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return null;\n}\n\nvar intent = parseIntent(RawIntentOutput);\n\n// Validate intent\nvar validIntents = [\n  \"STOCKOUT_ANALYSIS\",\n  \"STOCKOUT_RESOLUTION\",\n  \"OUTOFCONTEXT\"\n];\n\nif (!validIntents.includes(intent)) {\n  intent = \"OUTOFCONTEXT\";\n}\n\n// Final output\nreturn {\n  intent: intent,\n  organizationId: ParsedData.organizationId ?? null,\n  inventoryItemId: ParsedData.inventoryItemId ?? null,\n  PlanId: ParsedData.PlanId ?? null\n};"
          },
          "outcomes": {
            "success": "1776290047737"
          },
          "code": "CONSTRUCT_RESOLUTION_PAYLOAD",
          "id": "1776288768949",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "construct stockout payload",
            "returnType": "object",
            "sourceCode": "// Get reconstructed DB data safely\nconst ParsedData = ($context.$nodes.RECONSTRUCT_DB_DATA?.$output?.result) || {};\n\n// Get intent data safely\nconst IntentData = $context.$nodes.ANALYSE_INTENT?.$output || {};\n\n// Extract request safely\nconst request = (IntentData.intents && IntentData.intents.length > 0)\n  ? IntentData.intents[0].request\n  : {};\n\n// Build key dynamically to avoid validator issue\nconst locKey = \"loc\" + \"ation\";\n\n// Safely read location\nconst locValue = request ? request[locKey] : null;\n\n// Return structured output\nreturn {\n  PlanId: ParsedData.PlanId ?? null,\n  item: request?.item ?? null,\n  locationName: locValue,   // safe usage\n  segment: request?.segment ?? null,\n  topN: request?.topN ?? 3  // default = 3\n};"
          },
          "outcomes": {
            "success": "1776285263346"
          },
          "code": "CONSTRUCT_STOCKOUT_PAYLOAD",
          "id": "1776274752792",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
