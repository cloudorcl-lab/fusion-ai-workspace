                {
                  "metadata": {
                    "name": "Parse AV Query Result",
                    "returnType": "array",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header;\n\nconst formatHint = \"\";\n\nvar apiUrl = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.shape.api;\n\n// Query context\nvar queryContext = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output || {}\n  : {};\n\n// 1) Raw rows from execution node\nvar rows = [];\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output &&\n  Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output.items)\n) {\n  rows = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output.items;\n}\n\n// 2) Technical fields + fieldAlias (DISPLAY -> TECHNICAL) from AVQUERY\nvar technicalFields = [];\nvar fieldAlias = {};\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output.avQuery\n) {\n  var avOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_AV_QUERY_BUILDER.$output;\n\n  if (typeof avOut.avQuery.fields === \"string\" && avOut.avQuery.fields.trim().length > 0) {\n    technicalFields = avOut.avQuery.fields\n      .split(\",\")\n      .map(function (f) { return f.trim(); });\n  }\n\n  if (avOut.fieldAlias && typeof avOut.fieldAlias === \"object\") {\n    fieldAlias = avOut.fieldAlias;\n  }\n}\n\nif (technicalFields.length === 0 && rows.length > 0) {\n  technicalFields = Object.keys(rows[0]);\n}\n\nfunction getValueByPath(obj, path) {\n  var parts = path.split(\".\");\n  var value = obj;\n\n  for (var i = 0; i < parts.length; i++) {\n    if (value && Object.prototype.hasOwnProperty.call(value, parts[i])) {\n      value = value[parts[i]];\n    } else {\n      value = \"\";\n      break;\n    }\n  }\n\n  return value === null || value === undefined ? \"\" : value;\n}\n\nfunction getDisplayName(technical) {\n  for (var display in fieldAlias) {\n    if (!fieldAlias.hasOwnProperty(display)) continue;\n    if (fieldAlias[display] === technical) {\n      return display;\n    }\n  }\n\n  return technical;\n}\n\nfunction identityFieldMapping(sourceName) {\n  return {\n    transformId: \"identity\",\n    sourceFields: {\n      colName: sourceName\n    }\n  };\n}\n\nfunction buildFieldMapping(technicalFields) {\n  var mapping = {};\n\n  for (var i = 0; i < technicalFields.length; i++) {\n    var technicalName = technicalFields[i];\n\n    if (technicalName === \"$id\" || technicalName === \"$context\") {\n      continue;\n    }\n\n    var displayName = getDisplayName(technicalName);\n    mapping[displayName] = identityFieldMapping(technicalName);\n  }\n\n  return mapping;\n}\n\nvar processedRows = [];\n\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t];\n    var displayName = getDisplayName(technicalName);\n\n    var value;\n    if (technicalName.indexOf(\".\") !== -1) {\n      value = getValueByPath(src, technicalName);\n    } else {\n      value = src.hasOwnProperty(technicalName) ? src[technicalName] : \"\";\n      if (value === null || value === undefined) {\n        value = \"\";\n      }\n    }\n\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\nvar columnOrder = technicalFields.map(function (technicalName) {\n  return getDisplayName(technicalName);\n});\n\nvar fieldMapping = buildFieldMapping(technicalFields);\n\nconst tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n  purpose: $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.purpose || \"\",\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  },\n  bossMetadata: $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_CODE_SET_AV_BOSS_METADATA.$output.result,\n  fieldMapping: fieldMapping\n};\n\nreturn tableBlock;"
