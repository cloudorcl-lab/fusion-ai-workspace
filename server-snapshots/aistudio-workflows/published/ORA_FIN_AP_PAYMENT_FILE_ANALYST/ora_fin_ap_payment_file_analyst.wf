tsRejected === null || item.installmentsRejected === undefined\n          ? 0\n          : item.installmentsRejected\n    };\n\n    if (flags.shouldRenderCompletionDate) {\n      row.completionDate = item.completionDate;\n    }\n\n    if (flags.shouldRenderPendingSince) {\n      row.pendingSince = item.pendingSince;\n    }\n\n    if (flags.shouldRenderTerminationDate) {\n      row.terminationDate = item.terminationDate;\n    }\n\n    if (shouldShowFileRequiringAttentionColumn) {\n      if (shouldRenderAdditionalItemPaymentFileActionDeeplink) {\n        row.fileRequiringAttention = isPaymentFileInFormattedOrTransmittedStatus\n          ? \"{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=\" +\n            item.paymentFileReference +\n            \",text:Payment File \" +\n            item.paymentFileReference +\n            \" - \" +\n            item.paymentFileStatus +\n            \"}}\"\n          : \"{deeplink:{objType:AP_PAYMENTFILEACTION,action:EDIT,objKey:paymentInstructionId=\" +\n            item.paymentFileReference +\n            \",text:Payment File \" +\n            item.paymentFileReference +\n            \" - \" +\n            item.paymentFileStatus +\n            \"}}\";\n      } else {\n        row.fileRequiringAttention = \"\";\n      }\n    }\n\n    result.push(row);\n  }\n\n  return result;\n}\n\nfunction enrichTableBlock(inputTableBlock) {\n  var tableBlock = cloneBlock(inputTableBlock);\n  var processedRows = tableBlock.content;\n  var columnOrder = Array.isArray(tableBlock.columnOrder)\n    ? tableBlock.columnOrder\n    : inferColumnOrder(processedRows);\n  var fieldAlias = getFieldAliasFromTable(tableBlock);\n  var rows = getRawRowsFromTable(tableBlock, processedRows);\n  var renderFlags = getOriginalRenderFlagsForTable(tableBlock, columnOrder, processedRows);\n\n  tableBlock.content = processedRows;\n  tableBlock.columnOrder = columnOrder;\n  ensureFieldMapping(tableBlock);\n\n  if (looksLikeRawOriginalPprItems(processedRows)) {\n    var formattedRows = formatOriginalPprItems(processedRows, getContextFlowFromTable(tableBlock));\n    tableBlock.content = formattedRows;\n    tableBlock.columnOrder = inferColumnOrder(formattedRows);\n\n    setColumnTransformFieldMapping(\n      tableBlock,\n      \"paymentProcessRequest\",\n      \"ppr.paymentProcessRequest.viewDeeplink\"\n    );\n\n    setColumnTransformFieldMapping(\n      tableBlock,\n      \"paymentProcessRequestStatus\",\n      \"ppr.paymentProcessRequestStatus.actionDeeplink\"\n    );\n\n    setColumnSourceTransformFieldMapping(\n      tableBlock,\n      \"installmentsSelected\",\n      \"ppr.defaultZero\"\n    );\n\n    setColumnSourceTransformFieldMapping(\n      tableBlock,\n      \"installmentsRejected\",\n      \"ppr.defaultZero\"\n    );\n\n    if (tableHasExactColumnOrKey(tableBlock.columnOrder, tableBlock.content, \"fileRequiringAttention\")) {\n      setColumnTransformFieldMapping(\n        tableBlock,\n        \"fileRequiringAttention\",\n        \"ppr.fileRequiringAttention.deeplink\"\n      );\n    }\n\n    return tableBlock;\n  }\n\n  var pprNameColumns = findPprNameColumns(fieldAlias, columnOrder, processedRows);\n  var paymentFileFocusedTable = isPaymentFileFocusedTable(\n    fieldAlias,\n    columnOrder,\n    processedRows\n  );\n  var shouldShowFileRequiringAttentionColumn = false;\n  var canShowFileRequiringAttentionColumn =\n    renderFlags.shouldRenderPendingSince && !paymentFileFocusedTable;\n  var didBuildPaymentFileDeeplink = false;\n\n  if (canShowFileRequiringAttentionColumn) {\n    for (var rf = 0; rf < rows.length; rf++) {\n      var rawFileRow = rows[rf] || {};\n      var displayFileRow = processedRows[rf] || {};\n      var requestStatusCode = getFirstValue(\n        rawFileRow,\n        displayFileRow,\n        requestStatusCodeCandidates\n      );\n\n      if (\n        codesEqual(requestStatusCode, \"REQUIRING_ATTENTION\") &&\n        hasValue(getFirstValue(rawFileRow, displayFileRow, paymentFileReferenceCandidates)) &&\n        hasValue(getFirstValue(rawFileRow, displayFileRow, paymentFileStatusCandidates))\n      ) {\n        shouldShowFileRequiringAttentionColumn = true;\n        break;\n      }\n    }\n  }\n\n  var fileRequiringAttentionColumn = getFileRequiringAttentionColumnName(\n    columnOrder,\n    processedRows\n  );\n\n  if (shouldShowFileRequiringAttentionColumn) {\n    setColumnTransformFieldMapping(\n      tableBlock,\n      fileRequiringAttentionColumn,\n      \"ppr.fileRequiringAttention.deeplink\"\n    );\n  }\n\n  for (var pr = 0; pr < processedRows.length; pr++) {\n    var rawRow = rows[pr] || {};\n    var outRow = processedRows[pr] || {};\n\n    defaultNullishColumnValue(outRow, [\n      \"installmentsSelected\",\n      \"Installments Selected\"\n    ], 0);\n\n    var installmentsSelectedColumn =\n      findActualKey(outRow, \"installmentsSelected\") ||\n      findActualKey(outRow, \"Installments Selected\");\n\n    if (installmentsSelectedColumn !== null) {\n      setColumnSourceTransformFieldMapping(\n        tableBlock,\n        installmentsSelectedColumn,\n        \"ppr.defaultZero\"\n      );\n    }\n\n    defaultNullishColumnValue(outRow, [\n      \"installmentsRejected\",\n      \"Installments Rejected\"\n    ], 0);\n\n    var installmentsRejectedColumn =\n      findActualKey(outRow, \"installmentsRejected\") ||\n      findActualKey(outRow, \"Installments Rejected\");\n\n    if (installmentsRejectedColumn !== null) {\n      setColumnSourceTransformFieldMapping(\n        tableBlock,\n        installmentsRejectedColumn,\n        \"ppr.defaultZero\"\n      );\n    }\n\n    var paymentProcessType = getFirstValue(\n      rawRow,\n      outRow,\n      paymentProcessTypeCandidates\n    );\n    var shouldUsePprDeeplink = !codesEqual(paymentProcessType, \"IMMEDIATE\");\n\n    for (var pc = 0; pc < pprNameColumns.length; pc++) {\n      var pprColumn = findActualKey(outRow, pprNameColumns[pc]);\n      if (pprColumn === null) continue;\n\n      setColumnTransformFieldMapping(\n        tableBlock,\n        pprColumn,\n        \"ppr.paymentProcessRequest.viewDeeplink\"\n      );\n\n      if (shouldUsePprDeeplink) {\n        outRow[pprColumn] = buildPprViewDeeplink(rawRow, outRow, outRow[pprColumn]);\n      }\n    }\n\n    var rowRequestStatusCode = getFirstValue(\n      rawRow,\n      outRow,\n      requestStatusCodeCandidates\n    );\n    var paymentFileReference = getPaymentFileReferenceScalar(rawRow, outRow);\n    var pprStatusCode = getFirstValue(rawRow, outRow, pprStatusCodeCandidates);\n    var shouldUseActionDeeplink =\n      codesEqual(rowRequestStatusCode, \"REQUIRING_ATTENTION\") &&\n      !hasValue(paymentFileReference) &&\n      !isPaymentsCreatedStatus(pprStatusCode);\n\n    if (paymentFileFocusedTable) {\n      var paymentFileReferenceColumn =\n        findActualKey(outRow, \"Payment File Reference\") ||\n        findActualKey(outRow, \"paymentFileReference\") ||\n        findActualKey(outRow, \"Payment File Id\") ||\n        findActualKey(outRow, \"Payment File ID\");\n\n      if (paymentFileReferenceColumn !== null) {\n        setColumnTransformFieldMapping(\n          tableBlock,\n          paymentFileReferenceColumn,\n          \"ppr.fileRequiringAttention.deeplink\"\n        );\n        outRow[paymentFileReferenceColumn] = buildPaymentFileReferenceDeeplink(\n          rawRow,\n          outRow,\n          outRow[paymentFileReferenceColumn],\n          paymentFileReference\n        );\n      }\n\n      var paymentFileStatusColumn =\n        findActualKey(outRow, \"Payment File Status\") ||\n        findActualKey(outRow, \"paymentFileStatus\") ||\n        findActualKey(outRow, \"Payment File Processing Status\") ||\n        findActualKey(outRow, \"Payment File Status Meaning\");\n\n      if (paymentFileStatusColumn !== null && codesEqual(rowRequestStatusCode, \"REQUIRING_ATTENTION\")) {\n        setColumnTransformFieldMapping(\n          tableBlock,\n          paymentFileStatusColumn,\n          \"ppr.fileRequiringAttention.deeplink\"\n        );\n        outRow[paymentFileStatusColumn] = buildPaymentFileStatusDeeplink(\n          rawRow,\n          outRow,\n          outRow[paymentFileStatusColumn],\n          paymentFileReference\n        );\n      }\n    }\n\n    var actionStatusColumn = findStatusColumn(outRow);\n    if (actionStatusColumn !== null) {\n      setColumnTransformFieldMapping(\n        tableBlock,\n        actionStatusColumn,\n        \"ppr.paymentProcessRequestStatus.actionDeeplink\"\n      );\n\n      if (shouldUseActionDeeplink) {\n        outRow[actionStatusColumn] = buildPprActionDeeplink(\n          rawRow,\n          outRow,\n          outRow[actionStatusColumn]\n        );\n      }\n    }\n\n    if (shouldShowFileRequiringAttentionColumn) {\n      var paymentFileDeeplink = buildPaymentFileDeeplink(rawRow, outRow);\n\n      if (hasValue(paymentFileDeeplink)) {\n        outRow[fileRequiringAttentionColumn] = paymentFileDeeplink;\n        didBuildPaymentFileDeeplink = true;\n      } else {\n        outRow[fileRequiringAttentionColumn] = \"\";\n      }\n    }\n  }\n\n  if (shouldShowFileRequiringAttentionColumn) {\n    var paymentFileAnchor = findAnchorPaymentFileStatusColumn(columnOrder);\n    addColumnAfter(\n      columnOrder,\n      paymentFileAnchor || \"Payment File Status\",\n      fileRequiringAttentionColumn\n    );\n  }\n\n  if (didBuildPaymentFileDeeplink) {\n    if (paymentFileFocusedTable) {\n      removeColumns(\n        columnOrder,\n        processedRows,\n        getTechnicalFieldRemovalNames(fieldAlias, [\n          \"paymentFileStatusCode\",\n          \"paymentFileProcessingStatusLookupCode\",\n          \"paymentFileProcessingStatus.lookupCode\"\n        ]),\n        tableBlock.fieldMapping\n      );\n    } else {\n      removeColumns(\n        columnOrder,\n        processedRows,\n        getPaymentFileStatusRemovalNames(fieldAlias),\n        tableBlock.fieldMapping\n      );\n    }\n  }\n\n  if (paymentFileFocusedTable) {\n    prioritizePaymentFileColumns(columnOrder);\n  }\n\n  removeSuppressedOriginalDateColumns(tableBlock, columnOrder, processedRows);\n\n  var cleanupColumns = [\n    \"PPR Id\",\n    \"PPR ID\",\n    \"Payables PPR Id\",\n    \"Payables PPR ID\",\n    \"Payments PPR Id\",\n    \"Payments PPR ID\",\n    \"Payment Process Type\",\n    \"Request Status Code\",\n    \"Detailed PPR Status Code\",\n    \"PPR Status Code\",\n    \"Payment File Status Code\",\n    \"Payment File Processing Status Code\"\n  ].concat(getTechnicalFieldRemovalNames(fieldAlias, [\n    \"payablesPaymentProcessRequestId\",\n    \"checkrunId\",\n    \"paymentProcessRequestId\",\n    \"paymentProcessType\",\n    \"requestStatusCode\",\n    \"paymentProcessRequestStatusCode\",\n    \"paymentProcessRequestStatusLookupCode\",\n    \"paymentFileStatusCode\",\n    \"paymentFileProcessingStatusLookupCode\",\n    \"paymentFileProcessingStatus.lookupCode\"\n  ]));\n\n  removeColumns(columnOrder, processedRows, cleanupColumns, tableBlock.fieldMapping);\n\n  return tableBlock;\n}\n\nfunction getCombinedResultBlocks(payload) {\n  var parsedPayload = parseMaybeJson(payload);\n\n  if (Array.isArray(parsedPayload)) return parsedPayload;\n  if (Array.isArray(payload)) return payload;\n  if (parsedPayload && Array.isArray(parsedPayload.result)) return parsedPayload.result;\n  if (parsedPayload && Array.isArray(parsedPayload.output)) return parsedPayload.output;\n\n  return [];\n}\n\nfunction getDirectItemsPayload(payload) {\n  var parsedPayload = parseMaybeJson(payload);\n\n  if (parsedPayload && Array.isArray(parsedPayload.items)) {\n    return parsedPayload.items;\n  }\n\n  if (parsedPayload && parsedPayload.result && Array.isArray(parsedPayload.result.items)) {\n    return parsedPayload.result.items;\n  }\n\n  if (parsedPayload && parsedPayload.output && Array.isArray(parsedPayload.output.items)) {\n    return parsedPayload.output.items;\n  }\n\n  return null;\n}\n\nfunction getOriginalBoItemsFallback() {\n  var nodeNames = [\n    \"FIN_AP_BO_GET_PPR_BY_NAME\",\n    \"FIN_AP_BO_GET_PPR_COMPLETED_WITH_DATE_RANGE\",\n    \"FIN_AP_BO_GET_PPR_TERMINATED_WITH_DATE_RANGE\",\n    \"FIN_AP_BO_GET_PPR_REQUIRING_ATTENTION_WITH_DATE_RANGE\",\n    \"FIN_AP_BO_GET_PPR_BY_PAYMENT_DATE\"\n  ];\n\n  for (var i = 0; i < nodeNames.length; i++) {\n    var output = getNodeOutput(nodeNames[i]);\n    var payload = getOutputPayload(output);\n    var items = getDirectItemsPayload(payload);\n    if (items !== null) return items;\n  }\n\n  return null;\n}\n\nvar combinedPayload = getCombinedResultPayload();\nvar directItems = getDirectItemsPayload(combinedPayload);\n\nif (directItems !== null) {\n  return formatOriginalPprItems(directItems, getGlobalContextFlow());\n}\n\nvar combinedBlocks = getCombinedResultBlocks(combinedPayload);\n\nif (combinedBlocks.length === 0) {\n  var fallbackItems = getOriginalBoItemsFallback();\n  if (fallbackItems !== null) {\n    return formatOriginalPprItems(fallbackItems, getGlobalContextFlow());\n  }\n}\n\nvar enrichedBlocks = [];\n\nfor (var blockIndex = 0; blockIndex < combinedBlocks.length; blockIndex++) {\n  var block = parseMaybeJson(combinedBlocks[blockIndex]);\n\n  if (isTableBlock(block)) {\n    enrichedBlocks.push(enrichTableBlock(block));\n  } else if (block && typeof block === \"object\") {\n    enrichedBlocks.push(cloneBlock(block));\n  }\n}\n\nreturn enrichedBlocks;\n"
