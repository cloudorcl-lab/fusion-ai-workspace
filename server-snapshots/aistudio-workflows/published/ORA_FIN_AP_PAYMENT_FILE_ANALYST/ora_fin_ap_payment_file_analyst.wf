ceNumber\",                  \"invoiceTypeDiscriminator\",                  \"invoiceType\",                  \"invoiceDate\",                  \"invoiceAmount\"                ],                \"accessors\": {                  \"invoiceTypeCode\": {                    \"fields\": [                      \"lookupCode\",                      \"lookupType\",                      \"meaning\"                    ]                  }                }              }            }          },          \"paymentsPayablesPaymentProcessRequest\": {            \"fields\": [              \"paymentProcessRequestId\",              \"paymentProcessRequestName\",              \"timeCreated\",              \"paymentProcessRequestStatusLookupCode\"            ],            \"accessors\": {              \"paymentProcessRequestStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentInitiation\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"bankAccount\": {                \"fields\": [                  \"id\"                ]              }            }          },          \"payablesDisbursementPayment\": {            \"fields\": [              \"paymentId\",              \"paymentProfileAccountName\",              \"paymentProfileSystemName\",              \"paymentReferenceNumber\",              \"paperDocumentNumber\",              \"paymentAmount\",              \"paymentDate\",              \"paymentCompleteFlag\",              \"bepErrorCode\",              \"bepErrorMessageText\",              \"maturityDate\",              \"paymentReasonComments\",              \"bankStatusCode\",              \"paymentSystemResponseIdentifier\",              \"issuerAuthorizationReference\",              \"acquirerTransactionReference\",              \"issuerProcessingTimestamp\",              \"voidDate\",              \"voidReason\",              \"invoiceDueDate\",              \"stopRequestPlacedBy\",              \"paymentStatusLookupCode\",              \"paymentFunctionLookupCode\"            ],            \"accessors\": {              \"paymentStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"fundsStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentFunction\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"payablesPayment\": {                \"fields\": [                  \"paymentId\",                  \"paymentDate\",                  \"paymentCurrencyCode\",                  \"supplierName\",                  \"paymentAmount\",                  \"remitToSupplierName\",                  \"remitToAddressName\",                  \"futurePayDueDate\",                  \"conversionRate\",                  \"conversionDate\",                  \"paymentBaseAmount\",                  \"positivePayStatusCode\",                  \"paymentNumber\",                  \"clearingAmount\",                  \"clearingDate\",                  \"clearingBaseAmount\",                  \"clearingConversionRate\",                  \"clearingConversionDate\",                  \"clearingConversionRateType\",                  \"reconciledFlag\",                  \"maturityConversionRate\",                  \"maturityConversionDate\",                  \"maturityConversionRateType\",                  \"releasedDate\",                  \"stopDate\"                ],                \"accessors\": {                  \"paymentType\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"paymentStatus\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"paymentCurrency\": {                    \"fields\": [                      \"currencyCode\",                      \"issuingTerritoryCode\"                    ]                  },                  \"paymentSettlementPriority\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  }                }              },              \"payablesPaymentFile\": {                \"fields\": [                  \"paymentInstructionId\",                  \"paymentCount\",                  \"transmissionDate\",                  \"processingDate\",                  \"bankStatusCode\",                  \"paymentFileProcessingStatusLookupCode\"                ],                \"accessors\": {                  \"paymentFileProcessingStatus\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"disbursementInboundFile\": {                    \"fields\": [                      \"id\",                      \"fileName\",                      \"timeCreated\",                      \"errorMessage\"                    ],                    \"accessors\": {                      \"paymentSystem\": {                        \"fields\": [                          \"id\",                          \"paymentSystemName\"                        ]                      },                      \"inboundFileProcessingStatus\": {                        \"fields\": [                          \"lookupType\",                          \"meaning\",                          \"lookupCode\"                        ]                      }                    }                  },                  \"paymentFileConfirmationStatus\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"paymentDocument\": {                    \"fields\": [                      \"id\",                      \"paymentDocument\",                      \"firstAvailableDocumentNumber\",                      \"lastAvailableDocumentNumber\",                      \"lastIssuedDocumentNumber\"                    ],                    \"accessors\": {                      \"paymentDocumentCategory\": {                        \"fields\": [                          \"code\",                          \"applicationId\",                          \"name\"                        ]                      }                    }                  }                }              }            }          }        },        \"fieldAlias\": {          \"Document Payable ID\": \"documentPayableId\",          \"Source Product Reference\": \"sourceProductReferenceNumber\",          \"Source Product Identifier 1\": \"sourceProductFirstUniqueIdentifier\",          \"Source Product Identifier 3\": \"sourceProductThirdUniqueIdentifier\",          \"Document Date\": \"documentDate\",          \"Document Currency\": \"documentCurrencyCode\",          \"Document Amount\": \"documentAmount\",          \"Document Currency Payment Amount\": \"documentCurrencyPaymentAmount\",          \"Interest Rate\": \"interestRate\",          \"Discount\": \"discount\",          \"Invoice Type Code\": \"invoiceTypeCode\",          \"Amount\": \"amountToBePaid\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payment Date\": \"paymentDate\",          \"Payment Due Date\": \"paymentDueDate\",          \"Withheld Amount\": \"withheldAmount\",          \"Supplier Pay Group\": \"supplierPayGroup\",          \"Payment Function Lookup Code\": \"paymentFunctionLookupCode\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Function Code\": \"paymentFunction.lookupCode\",          \"Payment Function\": \"paymentFunction.meaning\",          \"Payment Mode Code\": \"paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMode.meaning\",          \"Document Payable Status Code\": \"documentPayableStatus.lookupCode\",          \"Document Payable Status\": \"documentPayableStatus.meaning\",          \"Business Unit\": \"businessUnit.name\",          \"Legal Entity\": \"legalEntity.name\",          \"Supplier Site\": \"supplierSite.name\",          \"Supplier ID\": \"supplierSite.supplier.supplierId\",          \"Supplier Name\": \"supplierSite.supplier.name\",          \"Supplier Type Code\": \"supplierSite.supplier.supplierType.lookupCode\",          \"Supplier Type\": \"supplierSite.supplier.supplierType.meaning\",          \"Payee\": \"payeeParty.name\",          \"Disbursement Bank Account\": \"bankAccount.name\",          \"Disbursement Bank Account ID\": \"bankAccount.id\",          \"External Bank Account\": \"externalBankAccount.bankAccountName\",          \"External Bank Account ID\": \"externalBankAccount.id\",          \"External Bank Country\": \"externalBankAccount.countryCode\",          \"Payment Profile\": \"accountPaymentProfile.paymentProfileName\",          \"Payment Profile ID\": \"accountPaymentProfile.paymentProfileId\",          \"System Payment Profile\": \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",          \"Processing Type\": \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"Payment Format Code\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",          \"Payment Format\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",          \"SRA Document Count Limit\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.documentCountLimit\",          \"Automatic SRA Submit\": \"accountPaymentProfile.systemPaymentProfile.paymentRemitAdviceSetup.automaticSraSubmitFlag\",          \"Logical Group By Payment Date\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByPaymentDateFlag\",          \"Logical Group By Internal Bank Account\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByInternalBankAccountFlag\",          \"Logical Group By Service Level\": \"accountPaymentProfile.systemPaymentProfile.paymentLogicalGroupingRule.groupByServiceLevelFlag\",          \"Invoice ID\": \"payablesInvoiceInstallment.invoiceId\",          \"Installment Number\": \"payablesInvoiceInstallment.installmentNumber\",          \"Due Date\": \"payablesInvoiceInstallment.dueDate\",          \"Installment Amount\": \"payablesInvoiceInstallment.installmentAmount\",          \"Installment Unpaid Amount\": \"payablesInvoiceInstallment.unpaidAmount\",          \"Remit-To Supplier\": \"payablesInvoiceInstallment.remitToSupplierName\",          \"Invoice Number\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"Invoice Type\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceType\",          \"Invoice Date\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceDate\",          \"Invoice Amount\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceAmount\",          \"PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"PPR Created On\": \"paymentsPayablesPaymentProcessRequest.timeCreated\",          \"PPR Status Lookup Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatusLookupCode\",          \"PPR Status Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"PPR Status\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"PPR Initiation\": \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\",          \"Disbursement Payment ID\": \"payablesDisbursementPayment.paymentId\",          \"Disbursement Payment Reference\": \"payablesDisbursementPayment.paymentReferenceNumber\",          \"Payment Number\": \"payablesDisbursementPayment.paymentReferenceNumber\",          \"Disbursement Payment Amount\": \"payablesDisbursementPayment.paymentAmount\",          \"Disbursement Payment Date\": \"payablesDisbursementPayment.paymentDate\",          \"Disbursement Payment Function Lookup Code\": \"payablesDisbursementPayment.paymentFunctionLookupCode\",          \"Funds Status\": \"payablesDisbursementPayment.fundsStatus.meaning\",          \"Payment File ID\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"Payment File Processing Status Lookup Code\": \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatusLookupCode\",          \"Payment File Status Code\": \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"Payment File Status\": \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\",          \"AP Payment Number\": \"payablesDisbursementPayment.payablesPayment.paymentNumber\",          \"AP Payment Status\": \"payablesDisbursementPayment.payablesPayment.paymentStatus.meaning\",          \"Conversion Rate\": \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"Reconciled\": \"payablesDisbursementPayment.payablesPayment.reconciledFlag\",          \"Clearing Date\": \"payablesDisbursementPayment.payablesPayment.clearingDate\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"payablesInvoiceInstallment.installmentNumber\",          \"amountToBePaid\",          \"payablesInvoiceInstallment.dueDate\"        ],        \"optional\": [          \"documentPayableId\",          \"sourceProductReferenceNumber\",          \"paymentDate\",          \"paymentDueDate\",          \"documentAmount\",          \"paymentCurrencyCode\",          \"documentDate\",          \"documentCurrencyCode\",          \"interestRate\",          \"discount\",          \"invoiceTypeCode\",          \"documentCurrencyPaymentAmount\",          \"sourceProductFirstUniqueIdentifier\",          \"sourceProductThirdUniqueIdentifier\",          \"withheldAmount\",          \"bankAccount.id\",          \"externalBankAccount.id\",          \"accountPaymentProfile.paymentProfileName\",          \"paymentFunction.meaning\",          \"paymentsPayablesPaymentProcessRequest.timeCreated\",          \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"payablesDisbursementPayment.paymentReferenceNumber\",          \"payablesDisbursementPayment.paymentDate\",          \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\"        ]      },      \"sortableAttributes\": [        \"documentPayableId\",        \"paymentCurrencyCode\",        \"amountToBePaid\",        \"sourceProductReferenceNumber\",        \"bankAccount.id\",        \"externalBankAccount.id\",        \"accountPaymentProfile.paymentProfileName\",        \"paymentFunction.lookupCode\",        \"paymentFunction.meaning\",        \"paymentsPayablesPaymentProcessRequest.timeCreated\",        \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\"      ],      \"filterConditions\": [        {          \"name\": \"documentPayableId\",          \"attribute\": \"documentPayableId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the internal document payable identifier.\"        },        {          \"name\": \"sourceProductReferenceNumber\",          \"attribute\": \"sourceProductReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user refers to the source transaction or expense/reference number.\"        },        {          \"name\": \"payablesInvoiceInstallment.installmentNumber\",          \"attribute\": \"payablesInvoiceInstallment.installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about a specific installment number.\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceId\",          \"attribute\": \"payablesInvoiceInstallment.invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the invoice id is available.\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"attribute\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the invoice number for the installment.\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\"        },        {          \"name\": \"paymentDueDate\",          \"attribute\": \"paymentDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about due-date-oriented installment payment runs.\"        },        {          \"name\": \"amountToBePaid\",          \"attribute\": \"amountToBePaid\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for amount-threshold questions such as installments or proposed payments over 50000 or 100000.\"        },        {          \"name\": \"payeeParty.name\",          \"attribute\": \"payeeParty.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payee or supplier party name.\"        },        {          \"name\": \"supplierSite.name\",          \"attribute\": \"supplierSite.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier site.\"        },        {          \"name\": \"supplierSite.supplier.supplierId\",          \"attribute\": \"supplierSite.supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier resolves to an internal supplier identifier.\"        },        {          \"name\": \"supplierSite.supplier.supplierType.lookupCode\",          \"attribute\": \"supplierSite.supplier.supplierType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by supplier type.\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment mode.\"        },        {          \"name\": \"businessUnit.id\",          \"attribute\": \"businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by business unit.\"        },        {          \"name\": \"businessUnit.name\",          \"attribute\": \"businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters installments by business unit name.\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by legal entity.\"        },        {          \"name\": \"documentCurrencyCode\",          \"attribute\": \"documentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user compares the payable document currency to the payment currency.\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment currency or for document-versus-payment currency mismatches.\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"attribute\": \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use =null as the conversion-rate predicate when the user asks for currency mismatch rows with missing conversion rates.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"INSERTED\",            \"PENDING_REVIEW\",            \"INFORMATION_REQUIRED\",            \"DOCUMENTS_VALIDATED\",            \"PENDING_REVIEW_DOC_VAL_ERRORS\",            \"PENDING_REVIEW_PMT_VAL_ERRORS\",            \"VALIDATION_FAILED\",            \"FAILED_PAYMENT_VALIDATION\",            \"ORA_REQUIRE_APPROVAL\",            \"ORA_APPROVAL_INITIATED\",            \"ORA_APPROVED\",            \"ORA_APPROVAL_WITHDRAWN\",            \"ORA_APPROVAL_ERROR\",            \"PAYMENTS_INITIATED\",            \"PAYMENTS_CREATED\",            \"RETRY_DOCUMENT_VALIDATION\",            \"RETRY_PAYMENT_CREATION\",            \"COMPLETED\",            \"ASSIGNMENT_COMPLETE\"          ],          \"usage\": \"Use this IBY-source status filter when the user asks for installments under an Oracle Payments PPR status. For AP-only statuses such as MISSING RATES or MISSING_X_RATES, use selectedPaymentInstallments instead. For mixed-source statuses such as CANCELING or TERMINATED, use the deduplicated extraction shapes.\"        },        {          \"name\": \"bankAccount.name\",          \"attribute\": \"bankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account is paying the installment.\"        },        {          \"name\": \"bankAccount.id\",          \"attribute\": \"bankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters proposed payments by the disbursement bank account identifier.\"        },        {          \"name\": \"externalBankAccount.bankAccountName\",          \"attribute\": \"externalBankAccount.bankAccountName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which external bank account the installment is being paid to.\"        },        {          \"name\": \"externalBankAccount.id\",          \"attribute\": \"externalBankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants to isolate payments by the supplier bank account identifier.\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups installments by destination country.\"        },        {          \"name\": \"accountPaymentProfile.paymentProfileId\",          \"attribute\": \"accountPaymentProfile.paymentProfileId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment profile.\"        },        {          \"name\": \"accountPaymentProfile.paymentProfileName\",          \"attribute\": \"accountPaymentProfile.paymentProfileName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for proposed payments routed through a named payment profile.\"        },        {          \"name\": \"withheldAmount\",          \"attribute\": \"withheldAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installments have withholding tax or wants withheld totals in the payment run.\"        },        {          \"name\": \"discount\",          \"attribute\": \"discount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installments are carrying discount effects in the run.\"        },        {          \"name\": \"payablesDisbursementPayment.paymentId\",          \"attribute\": \"payablesDisbursementPayment.paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the resulting disbursement payment for the installment.\"        },        {          \"name\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by resulting payment file id.\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payment amount threshold or asks for high-value payments.\",          \"valueFromUser\": \"Payment amount provided by user\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"For broad acknowledgement-rejected installment questions without a payment file, supplier, date range, or active context, prefer `paymentRunInstallmentsExtraction` and its `acknowledgementFileCreatedOn` alias for the default last-30-days date axis. Do not build a direct BV filter on `payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated` for this broad REST path. Do not add a default date filter when the user provides a payment file id.\",        \"patterns\": [          {            \"userRequest\": \"show me installments that are in acknowledgement rejected status\",            \"clause\": \"Use `paymentRunInstallmentsExtraction` with `acknowledgementFileCreatedOn>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00'` when no payment file, supplier, date range, or active context is supplied.\"          },          {            \"userRequest\": \"show me installments in payment file <id> that are in acknowledgement rejected status\",            \"clause\": \"Do not add a default date filter because paymentInstructionId is the scope.\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"installmentByIdOrReference\",          \"description\": \"Retrieve a payment-run installment by document payable id or source reference number.\",          \"when\": \"User asks for one installment, one source transaction, or one document payable entry.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"sourceProductReferenceNumber\",            \"paymentDate\",            \"paymentDueDate\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"documentPayableStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or sourceProductReferenceNumber='<SOURCE_REFERENCE_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"installmentsByPpr\",          \"description\": \"Retrieve payment-run installments under a named or identified payment process request.\",          \"when\": \"User asks for installments in a PPR or payment run.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"amountToBePaid\",            \"paymentDate\",            \"payablesDisbursementPayment.paymentId\",            \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"bankAccountByInstallment\",          \"description\": \"Retrieve the paying bank account and the payee external bank account for a specific installment, with surrounding payment logistics.\",          \"when\": \"User asks which bank account is being used to pay for a specific installment in a payment run or PPR.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"bankAccount.name\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.countryCode\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.meaning\",            \"paymentCurrencyCode\",            \"payablesDisbursementPayment.paymentId\",            \"payablesDisbursementPayment.paymentReferenceNumber\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or payablesInvoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer combining installment number with invoice number or PPR context when the installment number alone is ambiguous.\"        },        {          \"name\": \"paymentSetupByInstallment\",          \"description\": \"Retrieve payment setup details for an installment, including payment method, payment mode, payment profile, processing type, and format.\",          \"when\": \"User asks about payment and processing options for a specific installment.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.meaning\",            \"accountPaymentProfile.paymentProfileName\",            \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or payablesInvoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"resultingPaymentTrace\",          \"description\": \"Trace a payment-run installment to the resulting disbursement payment and payment file.\",          \"when\": \"User asks which payment, payment file, or payment status resulted from a specific installment.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"payablesDisbursementPayment.paymentId\",            \"payablesDisbursementPayment.paymentReferenceNumber\",            \"payablesDisbursementPayment.paymentStatus.meaning\",            \"payablesDisbursementPayment.fundsStatus.meaning\",            \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",            \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or payablesInvoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\"          ],          \"notes\": \"Add invoice number or source reference when needed to disambiguate an installment.\"        },        {          \"name\": \"proposedPaymentsByPpr\",          \"description\": \"Review proposed payments in a payment run with the bank-account and payment-formation context needed before approval.\",          \"when\": \"User asks to review proposed payments for a PPR after the run has grouped installments into payments.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"amountToBePaid\",            \"paymentDate\",            \"bankAccount.name\",            \"externalBankAccount.bankAccountName\",            \"accountPaymentProfile.paymentProfileName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use this driver when the user explicitly wants the readable disbursement bank account name instead of only the internal bank account id.\"        },        {          \"name\": \"fundingCheckByBankAccount\",          \"description\": \"Review proposed payment totals by disbursement bank account for funding sufficiency.\",          \"when\": \"User asks to group payments by bank account to verify funds before approval or transmission.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"bankAccount.id\",            \"bankAccount.name\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"payeeParty.name\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Group externally by bankAccount.id or bankAccount.name and sum amountToBePaid.\"        },        {          \"name\": \"supplierValueConcentrationInRun\",          \"description\": \"Identify the suppliers or payees that account for most of the proposed payment value in the run.\",          \"when\": \"User asks which suppliers represent 80 percent of the total value in a PPR.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"amountToBePaid\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"bankAccount.name\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Aggregate by payeeParty.name, sort descending by summed amountToBePaid, and compute the running cumulative percentage outside the base fetch.\"        },        {          \"name\": \"highValueProposedPayments\",          \"description\": \"Surface high-value proposed payments with supplier, invoice, and bank-routing context for approval review.\",          \"when\": \"User asks for payments above a threshold that need manager approval within a named PPR or approval-review context. Do not use this generic driver for all-PPR proposed-payment questions with supplier details; use highValueProposedPaymentsWithSupplierDetails instead.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"amountToBePaid\",            \"paymentDate\",            \"bankAccount.name\",            \"accountPaymentProfile.paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\",            \"amountToBePaid > <AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"Use the companion EV PayablesPaymentProcessRequestDetails for the run-level approver and pending-since aging. Do not use this generic driver for all-PPR proposed-payment questions with supplier details; those require the highValueProposedPaymentsWithSupplierDetails driver and locked BV field-selection rule.\"        },        {          \"name\": \"documentsMissingDisbursementBankAccount\",          \"description\": \"Find non-virtual-card document payables in the run that do not yet have a disbursement bank account assigned.\",          \"when\": \"User asks which documents are missing the disbursement bank account during installment review.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"payeeParty.name\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.meaning\",            \"paymentDate\",            \"amountToBePaid\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\",            \"bankAccount.id=null\",            \"(paymentMode.lookupCode!='VIRTUAL_CARD' or paymentMode.lookupCode=null)\"          ],          \"notes\": \"For a named PPR, combine the exact PPR filter with bankAccount.id=null and the virtual-card exclusion. Do not omit the virtual-card exclusion and do not replace bankAccount.id with a different setup field.\"        },        {          \"name\": \"documentsMissingProcessingAttributes\",          \"description\": \"Find non-virtual-card document payables missing required payment setup such as disbursement bank account or payment profile.\",          \"when\": \"User asks which documents are missing attributes before the payment run can continue.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"payablesInvoiceInstallment.dueDate\",            \"paymentMethod.paymentMethodName\",            \"businessUnit.name\",            \"legalEntity.name\",            \"paymentCurrencyCode\",            \"amountToBePaid\",            \"bankAccount.name\",            \"externalBankAccount.bankAccountName\",            \"accountPaymentProfile.paymentProfileName\",            \"paymentMode.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\",            \"(bankAccount.id=null or accountPaymentProfile.paymentProfileId=null)\",            \"(paymentMode.lookupCode!='VIRTUAL_CARD' or paymentMode.lookupCode=null)\"          ],          \"notes\": \"For a named PPR, combine the exact PPR filter with the missing bank-account/payment-profile predicate and the virtual-card exclusion. This is supported for questions about missing attributes for processing a PPR. Detail output must include Payment Method, Business Unit, Legal Entity, and Currency.\"        },        {          \"name\": \"stuckDueToFailure\",          \"description\": \"List payment-run installments that are stuck because the PPR or related payment file is in a failure, validation, approval-error, or information-required state.\",          \"when\": \"User asks for all installments, documents, or rows stuck because of failure and needs the detail columns PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",            \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"payablesInvoiceInstallment.dueDate\"          ],          \"extraFilterExpressions\": [            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') or payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode in ('FORMATTING_FAILED','TRANSMISSION_FAILED','CREATION_ERROR'))\"          ],          \"notes\": \"Use this as the primary detail row-list path for broad all-installments-stuck-because-of-failure questions. Keep the visible detail columns limited to PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date unless the user explicitly asks for error, supplier, or setup context. Payment File Status is mandatory because payment-file failure statuses are part of the OR filter and may be the reason the installment is stuck. Return payment file status code as a helper field when available; it is not intended as a visible business column. Use paymentRunInstallmentExceptions or documentValidationErrors only to add attached error codes, messages, or status reasons. Missing-rate statuses are AP-source statuses and should route to selectedPaymentInstallments.\"        },        {          \"name\": \"currencyMismatchByDestinationCountry\",          \"description\": \"Review installments where the payable document currency differs from the payment currency and summarize them by destination country.\",          \"when\": \"User asks for currency mismatches grouped by destination country during installment review.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"documentCurrencyCode\",            \"paymentCurrencyCode\",            \"externalBankAccount.countryCode\",            \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",            \"amountToBePaid\"          ],          \"extraFilterExpressions\": [            \"documentCurrencyCode!=paymentCurrencyCode\",            \"payablesInvoiceInstallment.invoiceToPaymentConversionRate=null\"          ],          \"notes\": \"Use externalBankAccount.countryCode as the destination-country grouping dimension. For this combined query, apply both predicates together: DOCUMENT_CURRENCY_CODE != PAYMENT_CURRENCY_CODE and CONVERSION_RATE = null.\"        },        {          \"name\": \"highValueInstallmentsBySupplierType\",          \"description\": \"Find high-value installments in the Oracle Payments run branch for a supplier type or category.\",          \"when\": \"User asks for installments above a threshold for suppliers in a category such as manufacturing and the request is explicitly scoped to Oracle Payments, payment-run, formed-payment, IBY, payment-file, bank-account, or another payment-execution-only context.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"supplierSite.supplier.supplierType.meaning\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"paymentDate\"          ],          \"extraFilterExpressions\": [            \"amountToBePaid>=<AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_50000>\",            \"supplierSite.supplier.supplierType.lookupCode='<SUPPLIER_TYPE_CODE_FROM_USER>'\"          ],          \"notes\": \"Use supplierSite.supplier.supplierType when the organization-specific supplier category can be mapped to a supplier type code and the requested population is the Oracle Payments/payment-run branch. For generic installments under a PPR, use the deduplicated PPR installment extraction shapes instead.\"        },        {          \"name\": \"fundingBankForSupplierAmount\",          \"description\": \"Find the paying internal bank account for a supplier installment or proposed payment above a requested amount.\",          \"when\": \"User asks which internal bank account is funding a high-value installment for a supplier.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payeeParty.name\",            \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",            \"payablesInvoiceInstallment.installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"bankAccount.id\",            \"bankAccount.name\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.countryCode\"          ],          \"extraFilterExpressions\": [            \"payeeParty.name='<SUPPLIER_NAME_FROM_USER>'\",            \"amountToBePaid>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\"          ],          \"notes\": \"If no PPR is provided, use the supplier and amount threshold first, then ask for or infer the run context before presenting multiple matches.\"        },        {          \"name\": \"blockingValidationErrorsForUrgentPayments\",          \"description\": \"Show validation errors blocking overdue or high-impact document payables/installments so the user can fix the most urgent payment issues first.\",          \"when\": \"User asks for validation errors blocking high-priority, urgent, overdue, or must-fix-first payments/installments.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",            \"payeeParty.name\",            \"sourceProductReferenceNumber\",            \"paymentDueDate\",            \"paymentDate\",            \"paymentCurrencyCode\",            \"amountToBePaid\",            \"disbursementPaymentTransactionErrors.errorCode\",            \"disbursementPaymentTransactionErrors.errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS')\",            \"paymentDueDate < paymentDate\",            \"disbursementPaymentTransactionErrors.errorCode is not null\"          ],          \"sortBy\": [            {              \"attribute\": \"paymentDueDate\",              \"direction\": \"asc\"            },            {              \"attribute\": \"amountToBePaid\",              \"direction\": \"desc\"            }          ],          \"notes\": \"Map `paymentProcessRequestStatusCode` to `paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode`, alias `PPR Status Code`. For overdue logic, use `paymentDueDate < paymentDate`. Since this shape does not expose an explicit priority field, prioritize by overdue date first and amount second.\"        },        {          \"name\": \"highValueProposedPaymentsWithSupplierDetails\",          \"description\": \"Retrieve proposed payment-run installments above a requested amount threshold with supplier details across all PPRs.\",          \"when\": \"User asks for proposed payments over a threshold with supplier details for all PPRs.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"payeeParty.name\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"paymentMethod.paymentMethodName\",            \"bankAccount.name\",            \"supplierSite.supplier.supplierType.meaning\",            \"paymentDate\",            \"supplierSite.name\"          ],          \"extraFilterExpressions\": [            \"amountToBePaid > <AMOUNT_THRESHOLD_FROM_USER>\",            \"sortBy: amountToBePaid:desc\",            \"limit: 20\"          ],          \"notes\": \"Do not require a named PPR for all-PPR high-value proposed payment questions. Use paymentRunInstallments BV, not disbursementPayments, when the user says proposed payments with supplier details. Mandatory query contract: preserve the full fieldsToReturn list in the generated query context, including PPR Name, PPR ID, Payee, Payment Amount, Currency, Payment Method, Disbursement Bank Account, Supplier Type, Payment Date, and Supplier Site. Use a strict amountToBePaid > threshold filter for wording such as over, above, greater than, or exceeds; do not use >= unless the user explicitly says at least or greater than or equal to. A currency symbol in the threshold only denotes the numeric amount; do not add a paymentCurrencyCode filter unless the user explicitly supplies a separate currency constraint.\"        }      ],      \"additionalInstructions\": [        \"For broad all-installments-stuck-because-of-failure questions, use the stuckDueToFailure driver and keep detail columns limited to PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date unless the user asks for more context. Payment File Status is required because payment-file failure statuses are part of the stuck-condition OR filter.\",        \"Use the canonical resource `paymentRunInstallments`, and prefer the richer `paymentRunInstallments` expanded view when bank-account, PPR, payment, payment-file, or invoice-installment accessor details are needed.\",        \"Do not use paymentRunInstallments as the primary source for plain 'review installments for PPR' requests. Use pprInstallmentsDeduplicatedSummary for summary review and pprInstallmentsDeduplicatedDetails for line-level review unless the PPR status resolves to Oracle Payments or the user explicitly asks for IBY-source, payment-run, formed-payment, payment-file, bank-account, or other payment-execution-only context.\",        \"Do not replace the deduplicated PPR installment population with this source solely because this source exposes an extra classifier such as supplier type or category. If the deduplicated extraction exposes a branch-safe alias for the classifier, keep the deduplicated shape and let that shape apply the branch-scoped filter.\",        \"Use paymentRunInstallments only for IBY-source PPR statuses: INSERTED, PENDING_REVIEW, INFORMATION_REQUIRED, DOCUMENTS_VALIDATED, PENDING_REVIEW_DOC_VAL_ERRORS, PENDING_REVIEW_PMT_VAL_ERRORS, VALIDATION_FAILED, FAILED_PAYMENT_VALIDATION, ORA_REQUIRE_APPROVAL, ORA_APPROVAL_INITIATED, ORA_APPROVAL_WITHDRAWN, ORA_APPROVED, ORA_APPROVAL_ERROR, PAYMENTS_INITIATED, PAYMENTS_CREATED, RETRY_DOCUMENT_VALIDATION, RETRY_PAYMENT_CREATION, COMPLETED, and ASSIGNMENT_COMPLETE.\",        \"Do not use paymentRunInstallments for AP-only statuses such as MISSING RATES, MISSING_X_RATES, SELECTING, SELECTED, REVIEW, SUBMITTED, CALCULATING, ORA_REFRESH_INSTALLMENTS, CANCELED, or CANCELLED NO PAYMENTS; use selectedPaymentInstallments for those statuses.\",        \"For mixed-source statuses CANCELING and TERMINATED, or when the PPR status is unknown, use the deduplicated installment extraction shapes instead of this IBY-only shape.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases or attributes not present in the expanded view.\",        \"This is the best canonical BV when the user needs readable disbursement bank account names, supplier bank account names, or formed-payment context during proposed-payment review.\",        \"Use this shape for missing-attribute drill-down after installments are already in Oracle Payments, including bank-account and payment-profile gaps on non-virtual-card documents.\",        \"Use documentCurrencyCode as the payable-document currency when comparing it with paymentCurrencyCode in installment review.\",        \"For currency-mismatch queries that ask to highlight missing conversion rates by destination country, use documentCurrencyCode!=paymentCurrencyCode and payablesInvoiceInstallment.invoiceToPaymentConversionRate=null together; in source-column terms this is DOCUMENT_CURRENCY_CODE != PAYMENT_CURRENCY_CODE and CONVERSION_RATE = null.\",        \"For installment bank-account questions, return both `bankAccount.name` and `externalBankAccount.bankAccountName` together, since users usually need the paying account and the destination account in one answer.\",        \"When filtering by installment, prefer `documentPayableId` when available. If the user only gives an installment number, add invoice number, source reference, or PPR context to avoid ambiguous matches.\",        \"For payment and processing option questions, include `paymentMethod`, `paymentMode`, `accountPaymentProfile`, `systemPaymentProfile.processingType`, and `systemPaymentProfile.paymentFormat` together so the answer explains the setup driving the installment payment.\",        \"When the user asks for resulting payment or file context, follow the accessor chain through `payablesDisbursementPayment` and `payablesDisbursementPayment.payablesPaymentFile` instead of guessing from top-level installment fields.\",        \"For broad acknowledgement rejected installment or rejected-payment questions without a payment file, supplier, date range, or active context, use `paymentRunInstallmentsExtraction` with `acknowledgementFileCreatedOn` and Oracle ANSI TIMESTAMP literals. For payment-file-scoped bank-error questions without invoice/installment columns, use `disbursementPayments` or `disbursementPaymentsExtraction`. Do not build direct paymentRunInstallments BV filters or `$fields` using nested `payablesDisbursementPayment.bepErrorCode`, `payablesDisbursementPayment.bepErrorMessageText`, `payablesDisbursementPayment.paymentStatus.*`, or `payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated`.\",        \"When testing for missing bank-account or payment-profile attributes, use =null predicates in the outer filter and exclude `paymentMode.lookupCode='VIRTUAL_CARD'` when the setup rule is specific to disbursement bank accounts.\",        \"The source driver `payment mode mappings` only contributed the `VIRTUAL_CARD` branch, which is already modeled in the local missing-attribute drivers and instructions; keep using that canonical local handling instead of adding a duplicate driver.\",        \"This shape does not expose the timestamp of a recent supplier bank-account change, so fraud-risk review for recently changed bank accounts is only partial here and may require another source.\",        \"Questions asking what bank account is being used to pay a specific installment are supported. Filter by invoice number plus installment number when documentPayableId is not provided, and return both the paying bank account and payee external bank account.\",        \"For proposed payments over an amount threshold with supplier details for all PPRs, use paymentRunInstallments BV with the exact locked field set paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,paymentsPayablesPaymentProcessRequest.paymentProcessRequestId,payeeParty.name,amountToBePaid,paymentCurrencyCode,paymentMethod.paymentMethodName,bankAccount.name,supplierSite.supplier.supplierType.meaning,paymentDate,supplierSite.name; filter with amountToBePaid > threshold; sort amountToBePaid desc; limit 20; do not require a PPR name. Do not trim the generated queryContext fields to the visible answer table columns.\",        \"For proposed payments over a threshold with supplier details, do not infer paymentCurrencyCode from symbols such as $ in the amount. Use only amountToBePaid > threshold unless the user separately asks for a specific payment currency.\",        \"For 'Review proposed payments for all PPRs', this BV is the required detail query after the paymentRunInstallmentSummaries AV. Use filters null, sort amountToBePaid desc, limit 20; do not add PENDING_REVIEW.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request before using generic business drivers.\",        \"fields\": \"Use the matching fields value exactly and preserve order. For fieldOrderLocked rules, do not trim queryContext fields to only displayed answer-table columns.\",        \"paraphrases\": \"Use the same fields, filters, sort, and limit for paraphrased or equivalent requests.\",        \"filters\": \"If the matching rule provides filters, apply them exactly. For amount phrases such as over, above, greater than, or exceeds, use >, not >=. Use >= only when the user explicitly says at least or greater than or equal to.\",        \"sortAndLimit\": \"If the matching rule provides sortBy or limit, apply them unless the user explicitly asks for a different sort or limit.\",        \"queryContext\": \"The contextData.queryContext must retain the full matched fields, filters, sortBy, and limit even if the visible response table uses fewer columns.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Which documents are missing disbursement bank account\"          ],          \"queryType\": \"BV\",          \"shape\": \"paymentRunInstallments\",          \"fields\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,payablesInvoiceInstallment.invoiceTransaction.invoiceNumber,payablesInvoiceInstallment.installmentNumber,payeeParty.name,paymentMethod.paymentMethodName,paymentMode.meaning,paymentDate,amountToBePaid,paymentCurrencyCode\",          \"filters\": \"bankAccount.id = null and (paymentMode.lookupCode != 'VIRTUAL_CARD' or paymentMode.lookupCode = null)\",          \"sortBy\": \"amountToBePaid:desc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"notes\": \"Detail companion query for documents missing disbursement bank account. Do not omit virtual-card exclusion and do not replace bankAccount.id with a setup/account field.\"        },        {          \"questionExamples\": [            \"Show me all proposed payments over $100000 with supplier details for all PPRs\",            \"Show me all proposed payments over $100,000 with supplier details\"          ],          \"queryType\": \"BV\",          \"shape\": \"paymentRunInstallments\",          \"fields\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,paymentsPayablesPaymentProcessRequest.paymentProcessRequestId,payeeParty.name,amountToBePaid,paymentCurrencyCode,paymentMethod.paymentMethodName,bankAccount.name,supplierSite.supplier.supplierType.meaning,paymentDate,supplierSite.name\",          \"filters\": \"amountToBePaid > <AMOUNT_THRESHOLD_FROM_USER>\",          \"sortBy\": \"amountToBePaid:desc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"fieldAlias\": {            \"PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"Payee\": \"payeeParty.name\",            \"Payment Amount\": \"amountToBePaid\",            \"Currency\": \"paymentCurrencyCode\",            \"Payment Method\": \"paymentMethod.paymentMethodName\",            \"Disbursement Bank Account\": \"bankAccount.name\",            \"Supplier Type\": \"supplierSite.supplier.supplierType.meaning\",            \"Payment Date\": \"paymentDate\",            \"Supplier Site\": \"supplierSite.name\"          },          \"notes\": \"Mandatory exact query-context contract for all-PPR high-value proposed-payment questions: use this full fields list and aliases, apply amountToBePaid > <AMOUNT_THRESHOLD_FROM_USER>, sort by amountToBePaid:desc, and limit 20. Do not replace this with the generic highValueProposedPayments driver, do not use >= for over/exceeds wording, and do not trim queryContext fields to only Supplier Site, Payee, Amount, or Payment Currency. A currency symbol in the amount threshold is not a paymentCurrencyCode filter; do not add paymentCurrencyCode = 'USD' for $100000 unless the user separately asks for USD payments or payments in USD.\"        },        {          \"questionExamples\": [            \"Review proposed payments for all PPRs\"          ],          \"queryType\": \"BV\",          \"shape\": \"paymentRunInstallments\",          \"fields\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName,payablesDisbursementPayment.paymentReferenceNumber,payeeParty.name,amountToBePaid,paymentCurrencyCode,paymentMethod.paymentMethodName,bankAccount.name,supplierSite.supplier.supplierType.meaning,paymentDate,paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"filters\": null,          \"sortBy\": \"amountToBePaid:desc\",          \"limit\": 20,          \"fieldOrderLocked\": true,          \"fieldAlias\": {            \"PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"Payment Reference\": \"payablesDisbursementPayment.paymentReferenceNumber\",            \"Payee\": \"payeeParty.name\",            \"Payment Amount\": \"amountToBePaid\",            \"Currency\": \"paymentCurrencyCode\",            \"Payment Method\": \"paymentMethod.paymentMethodName\",            \"Disbursement Bank Account\": \"bankAccount.name\",            \"Supplier Type\": \"supplierSite.supplier.supplierType.meaning\",            \"Payment Date\": \"paymentDate\"          },          \"notes\": \"Second required query context for Review proposed payments for all PPRs. Use filters null, sort amountToBePaid desc, limit 20. Do not add PENDING_REVIEW and do not route to disbursementPayments.\"        }      ]    },    \"paymentRunInstallmentsExtraction\": {      \"key\": \"paymentRunInstallmentsExtraction\",      \"name\": \"paymentRunInstallmentsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDocumentPayable\",      \"description\": \"Runtime extraction wrapper for the paymentRunInstallments BV. Use this IBY-source wrapper when the PPR status is resolved to an Oracle Payments stage, when the user asks for the failure-type summary or row list of installments stuck because of failure, or when the user needs disbursement bank-account context, missing-attribute drill-down, supplier type and destination-country slicing, currency mismatch by destination country, or resulting payment and payment-file details. Do not use it as the primary wrapper for generic PPR installment review; use the deduplicated PPR installment extraction shapes first.\",      \"exampleQuestions\": [        \"What are all the installments that are stuck because of failure?\",        \"How many documents are missing disbursement bank account by supplier?\",        \"Which documents are missing attributes in this payment run?\",        \"What is the total IBY payment-run amount for payment process request PPR_123 by payment status?\",        \"How many installments are there where the payment currency is different from the invoice currency by destination country, and highlight any with missing conversion rates\",        \"What total payment amount is assigned to each bank account so I can verify we have sufficient funds in each?\",        \"Which suppliers represent 80% of the total payment value in this PPR after it entered Oracle Payments?\",        \"Show me all IBY payment-run installments over 100000 with supplier details and invoice references in this payment run\",        \"Which installment in PPR PPR_123 is being paid from which disbursement bank account and to which external bank account?\",        \"Which internal bank account is funding the 50000 installment for Supplier ABC?\",        \"Show the payment method, payment mode, and payment profile for installment 3 on invoice INV-1001\",        \"List installments in this payment run with resulting payment id, payment reference number, and payment file id\",        \"What bank account is being used to pay for Installment 1 for invoice <INVOICE_NUMBER>\",        \"Which documents are missing disbursement bank account for PPR <PPR_NAME>\",        \"Show me what attributes are missing for processing PPR <PPR_NAME>\"      ],      \"fields\": {        \"fields\": [          \"documentPayableId\",          \"paymentDate\",          \"documentDate\",          \"documentCurrencyCode\",          \"documentAmount\",          \"interestRate\",          \"discount\",          \"invoiceTypeCode\",          \"documentCurrencyPaymentAmount\",          \"paymentCurrencyCode\",          \"amountToBePaid\",          \"paymentDueDate\",          \"sourceProductReferenceNumber\",          \"sourceProductFirstUniqueIdentifier\",          \"sourceProductThirdUniqueIdentifier\",          \"withheldAmount\",          \"supplierPayGroup\",          \"bankAccountId\",          \"externalBankAccountId\",          \"paymentProfileName\",          \"paymentFunctionLookupCode\",          \"paymentFunctionMeaning\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestCreatedOn\",          \"paymentMethodCode\",          \"paymentMethodName\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"documentPayableStatusLookupCode\",          \"documentPayableStatusMeaning\",          \"businessUnitName\",          \"legalEntityName\",          \"supplierSiteName\",          \"supplierId\",          \"supplierName\",          \"supplierTypeLookupCode\",          \"supplierTypeMeaning\",          \"payeePartyName\",          \"bankAccountName\",          \"externalBankAccountBankAccountName\",          \"countryCode\",          \"paymentProfileId\",          \"systemProfileCode\",          \"processingTypeMeaning\",          \"paymentFormatCode\",          \"formatName\",          \"invoiceId\",          \"installmentNumber\",          \"dueDate\",          \"installmentAmount\",          \"unpaidAmount\",          \"conversionRate\",          \"remitToSupplierName\",          \"invoiceNumber\",          \"invoiceDate\",          \"invoiceAmount\",          \"paymentProcessRequestId\",          \"paymentProcessRequestName\",          \"paymentProcessRequestStatusMeaning\",          \"paymentInitiationMeaning\",          \"paymentId\",          \"paymentReferenceNumber\",          \"paymentAmount\",          \"payablesDisbursementPaymentPaymentDate\",          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentStatusLookupCode\",          \"paymentStatusMeaning\",          \"fundsStatusMeaning\",          \"paymentInstructionId\",          \"paymentFileProcessingStatusLookupCode\",          \"paymentFileProcessingStatusMeaning\",          \"acknowledgementFileCreatedOn\",          \"paymentNumber\",          \"payablesPaymentPaymentStatusMeaning\",          \"reconciledFlag\",          \"clearingDate\"        ],        \"fieldAlias\": {          \"Document Payable ID\": \"documentPayableId\",          \"Source Product Reference\": \"sourceProductReferenceNumber\",          \"Source Product Identifier 1\": \"sourceProductFirstUniqueIdentifier\",          \"Source Product Identifier 3\": \"sourceProductThirdUniqueIdentifier\",          \"Document Date\": \"documentDate\",          \"Document Currency\": \"documentCurrencyCode\",          \"Document Amount\": \"documentAmount\",          \"Document Currency Payment Amount\": \"documentCurrencyPaymentAmount\",          \"Interest Rate\": \"interestRate\",          \"Discount\": \"discount\",          \"Invoice Type Code\": \"invoiceTypeCode\",          \"Amount\": \"amountToBePaid\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payment Date\": \"paymentDate\",          \"Payment Due Date\": \"paymentDueDate\",          \"Withheld Amount\": \"withheldAmount\",          \"Supplier Pay Group\": \"supplierPayGroup\",          \"Payment Method Code\": \"paymentMethodCode\",          \"Payment Method\": \"paymentMethodName\",          \"Payment Function Code\": \"paymentFunctionLookupCode\",          \"Payment Function\": \"paymentFunctionMeaning\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Document Payable Status Code\": \"documentPayableStatusLookupCode\",          \"Document Payable Status\": \"documentPayableStatusMeaning\",          \"Business Unit\": \"businessUnitName\",          \"Legal Entity\": \"legalEntityName\",          \"Supplier Site\": \"supplierSiteName\",          \"Supplier ID\": \"supplierId\",          \"Supplier Name\": \"supplierName\",          \"Supplier Type Code\": \"supplierTypeLookupCode\",          \"Supplier Type\": \"supplierTypeMeaning\",          \"Payee\": \"payeePartyName\",          \"Disbursement Bank Account\": \"bankAccountName\",          \"Disbursement Bank Account ID\": \"bankAccountId\",          \"External Bank Account\": \"externalBankAccountBankAccountName\",          \"External Bank Account ID\": \"externalBankAccountId\",          \"External Bank Country\": \"countryCode\",          \"Payment Profile\": \"paymentProfileName\",          \"Payment Profile ID\": \"paymentProfileId\",          \"System Payment Profile\": \"systemProfileCode\",          \"Processing Type\": \"processingTypeMeaning\",          \"Payment Format Code\": \"paymentFormatCode\",          \"Payment Format\": \"formatName\",          \"Invoice ID\": \"invoiceId\",          \"Installment Number\": \"installmentNumber\",          \"Due Date\": \"dueDate\",          \"Installment Amount\": \"installmentAmount\",          \"Installment Unpaid Amount\": \"unpaidAmount\",          \"Remit-To Supplier\": \"remitToSupplierName\",          \"Invoice Number\": \"invoiceNumber\",          \"Invoice Date\": \"invoiceDate\",          \"Invoice Amount\": \"invoiceAmount\",          \"PPR ID\": \"paymentProcessRequestId\",          \"PPR Name\": \"paymentProcessRequestName\",          \"PPR Created On\": \"paymentProcessRequestCreatedOn\",          \"PPR Status Code\": \"paymentProcessRequestStatusLookupCode\",          \"PPR Status\": \"paymentProcessRequestStatusMeaning\",          \"Failure Type\": \"failureType\",          \"Installment Count\": \"installmentCount\",          \"Missing Attribute Type\": \"missingAttributeType\",          \"Document Count\": \"documentCount\",          \"Total Amount\": \"totalAmount\",          \"PPR Initiation\": \"paymentInitiationMeaning\",          \"Disbursement Payment ID\": \"paymentId\",          \"Disbursement Payment Reference\": \"paymentReferenceNumber\",          \"Payment Number\": \"paymentReferenceNumber\",          \"Disbursement Payment Amount\": \"paymentAmount\",          \"Disbursement Payment Date\": \"payablesDisbursementPaymentPaymentDate\",          \"BEP Error Code\": \"bepErrorCode\",          \"BEP Error Message\": \"bepErrorMessageText\",          \"Disbursement Payment Status Code\": \"paymentStatusLookupCode\",          \"Disbursement Payment Status\": \"paymentStatusMeaning\",          \"Funds Status\": \"fundsStatusMeaning\",          \"Payment File ID\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Payment File Status Code\": \"paymentFileProcessingStatusLookupCode\",          \"Payment File Status\": \"paymentFileProcessingStatusMeaning\",          \"Acknowledgement File Created On\": \"acknowledgementFileCreatedOn\",          \"AP Payment Number\": \"paymentNumber\",          \"AP Payment Status\": \"payablesPaymentPaymentStatusMeaning\",          \"Conversion Rate\": \"conversionRate\",          \"Reconciled\": \"reconciledFlag\",          \"Clearing Date\": \"clearingDate\"        }      },      \"supportedFilters\": [        {          \"name\": \"documentPayableId\",          \"attribute\": \"documentPayableId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the internal document payable identifier.\",          \"valueFromUser\": \"Document Payable ID\"        },        {          \"name\": \"sourceProductReferenceNumber\",          \"attribute\": \"sourceProductReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user refers to the source transaction or expense/reference number.\",          \"valueFromUser\": \"Source Product Reference\"        },        {          \"name\": \"payablesInvoiceInstallment.installmentNumber\",          \"attribute\": \"payablesInvoiceInstallment.installmentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about a specific installment number.\",          \"valueFromUser\": \"Installment Number\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceId\",          \"attribute\": \"payablesInvoiceInstallment.invoiceId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the invoice id is available.\",          \"valueFromUser\": \"Invoice ID\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"attribute\": \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the invoice number for the installment.\",          \"valueFromUser\": \"Invoice Number\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\",          \"valueFromUser\": \"Payment Date or date range\"        },        {          \"name\": \"paymentDueDate\",          \"attribute\": \"paymentDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about due-date-oriented installment payment runs.\",          \"valueFromUser\": \"Payment Due Date or date range\"        },        {          \"name\": \"amountToBePaid\",          \"attribute\": \"amountToBePaid\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use for amount-threshold questions such as installments or proposed payments over 50000 or 100000.\",          \"valueFromUser\": \"Amount To Be Paid threshold\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payment amount threshold or asks for high-value payments.\",          \"valueFromUser\": \"Payment amount provided by user\"        },        {          \"name\": \"payeeParty.name\",          \"attribute\": \"payeeParty.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payee or supplier party name.\",          \"valueFromUser\": \"Payee\"        },        {          \"name\": \"supplierSite.name\",          \"attribute\": \"supplierSite.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by supplier site.\",          \"valueFromUser\": \"Supplier Site\"        },        {          \"name\": \"supplierSite.supplier.supplierId\",          \"attribute\": \"supplierSite.supplier.supplierId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier resolves to an internal supplier identifier.\",          \"valueFromUser\": \"Supplier ID\"        },        {          \"name\": \"supplierSite.supplier.supplierType.lookupCode\",          \"attribute\": \"supplierSite.supplier.supplierType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by supplier type.\",          \"valueFromUser\": \"Supplier Type Code\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"paymentFunction.lookupCode\",          \"attribute\": \"paymentFunction.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters payment-run installments by payment function.\",          \"valueFromUser\": \"Payment Function Code\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment mode.\",          \"valueFromUser\": \"Payment Mode Code\"        },        {          \"name\": \"businessUnit.id\",          \"attribute\": \"businessUnit.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by business unit.\",          \"valueFromUser\": \"id\"        },        {          \"name\": \"businessUnit.name\",          \"attribute\": \"businessUnit.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters installments by business unit name.\",          \"valueFromUser\": \"Business Unit\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by legal entity.\",          \"valueFromUser\": \"legalEntityId\"        },        {          \"name\": \"documentCurrencyCode\",          \"attribute\": \"documentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user compares the payable document currency to the payment currency.\",          \"valueFromUser\": \"Document Currency\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment currency or for document-versus-payment currency mismatches.\",          \"valueFromUser\": \"Payment Currency\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.timeCreated\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.timeCreated\",          \"type\": \"dateTime\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters payment-run installments by PPR creation time.\",          \"valueFromUser\": \"PPR Created On\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"PENDING_REVIEW\",            \"ORA_REQUIRE_APPROVAL\",            \"ORA_APPROVAL_INITIATED\",            \"ORA_APPROVED\",            \"ORA_APPROVAL_WITHDRAWN\",            \"PAYMENTS_CREATED\"          ],          \"usage\": \"Use when the user scopes payment-run installments to proposed-payment review or approval statuses.\",          \"valueFromUser\": \"PPR Status Code\"        },        {          \"name\": \"bankAccount.name\",          \"attribute\": \"bankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account is paying the installment.\",          \"valueFromUser\": \"Disbursement Bank Account\"        },        {          \"name\": \"bankAccount.id\",          \"attribute\": \"bankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups or filters proposed payments by the disbursement bank account identifier.\",          \"valueFromUser\": \"Disbursement Bank Account ID\"        },        {          \"name\": \"externalBankAccount.bankAccountName\",          \"attribute\": \"externalBankAccount.bankAccountName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which external bank account the installment is being paid to.\",          \"valueFromUser\": \"External Bank Account\"        },        {          \"name\": \"externalBankAccount.id\",          \"attribute\": \"externalBankAccount.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants to isolate payments by the supplier bank account identifier.\",          \"valueFromUser\": \"External Bank Account ID\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user groups installments by destination country.\",          \"valueFromUser\": \"External Bank Country\"        },        {          \"name\": \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"attribute\": \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use payablesInvoiceInstallment.invoiceToPaymentConversionRate is null when the user asks for currency mismatch rows with missing conversion rates.\",          \"valueFromUser\": \"Conversion Rate\"        },        {          \"name\": \"accountPaymentProfile.paymentProfileId\",          \"attribute\": \"accountPaymentProfile.paymentProfileId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment profile.\",          \"valueFromUser\": \"Payment Profile ID\"        },        {          \"name\": \"accountPaymentProfile.paymentProfileName\",          \"attribute\": \"accountPaymentProfile.paymentProfileName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for proposed payments routed through a named payment profile.\",          \"valueFromUser\": \"Payment Profile\"        },        {          \"name\": \"withheldAmount\",          \"attribute\": \"withheldAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installments have withholding tax or wants withheld totals in the payment run.\",          \"valueFromUser\": \"Withheld Amount\"        },        {          \"name\": \"discount\",          \"attribute\": \"discount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which installments are carrying discount effects in the run.\",          \"valueFromUser\": \"Discount\"        },        {          \"name\": \"payablesDisbursementPayment.paymentId\",          \"attribute\": \"payablesDisbursementPayment.paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants the resulting disbursement payment for the installment.\",          \"valueFromUser\": \"Disbursement Payment ID\"        },        {          \"name\": \"payablesDisbursementPayment.bepErrorCode\",          \"attribute\": \"payablesDisbursementPayment.bepErrorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for bank acknowledgement rejection or BEP error details on installments.\",          \"valueFromUser\": \"BEP Error Code\"        },        {          \"name\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VOID\"          ],          \"usage\": \"Use paymentStatus.lookupCode='VOID' when the user asks for acknowledgement rejected installments. Display the status as Acknowledgment Rejected for this specific Payment File inquiry scenario.\",          \"valueFromUser\": \"Disbursement Payment Status Code\"        },        {          \"name\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes installments by resulting payment file id.\",          \"valueFromUser\": \"Payment File ID\"        },        {          \"name\": \"payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated\",          \"attribute\": \"payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated\",          \"type\": \"dateTime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for broad acknowledgement-rejected installment questions when the user does not provide a payment file, supplier, date range, or active context. Because this extraction generates Oracle SQL against a datetime field, emit ANSI TIMESTAMP literals such as `acknowledgementFileCreatedOn >= TIMESTAMP '2026-05-18 00:00:00'`; do not emit plain quoted date strings.\",          \"valueFromUser\": \"Acknowledgement File Created On\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"For broad acknowledgement-rejected installment questions without a payment file, supplier, date range, or active context, use acknowledgement inbound file `timeCreated` as the default date axis and default to the last 30 days. Extraction SQL must use Oracle ANSI TIMESTAMP literals for this datetime comparison. Do not add this default date filter when the user provides a payment file id.\",        \"patterns\": [          {            \"userRequest\": \"show me installments that are in acknowledgement rejected status\",            \"clause\": \"acknowledgementFileCreatedOn>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no payment file, supplier, date range, or active context is supplied\"          },          {            \"userRequest\": \"show me installments in payment file <id> that are in acknowledgement rejected status\",            \"clause\": \"Do not add a default date filter because paymentInstructionId is the scope.\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"paymentRunInstallments\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesDocumentPayable\",            \"view\": \"paymentRunInstallments\",            \"fieldAliases\": {              \"documentPayableId\": \"documentPayableId\",              \"paymentDate\": \"paymentDate\",              \"documentDate\": \"documentDate\",              \"documentCurrencyCode\": \"documentCurrencyCode\",              \"documentAmount\": \"documentAmount\",              \"interestRate\": \"interestRate\",              \"discount\": \"discount\",              \"invoiceTypeCode\": \"invoiceTypeCode\",              \"documentCurrencyPaymentAmount\": \"documentCurrencyPaymentAmount\",              \"paymentCurrencyCode\": \"paymentCurrencyCode\",              \"amountToBePaid\": \"amountToBePaid\",              \"paymentDueDate\": \"paymentDueDate\",              \"sourceProductReferenceNumber\": \"sourceProductReferenceNumber\",              \"sourceProductFirstUniqueIdentifier\": \"sourceProductFirstUniqueIdentifier\",              \"sourceProductThirdUniqueIdentifier\": \"sourceProductThirdUniqueIdentifier\",              \"withheldAmount\": \"withheldAmount\",              \"supplierPayGroup\": \"supplierPayGroup\",              \"bankAccount.id\": \"bankAccountId\",              \"externalBankAccount.id\": \"externalBankAccountId\",              \"accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"paymentFunction.lookupCode\": \"paymentFunctionLookupCode\",              \"paymentFunction.meaning\": \"paymentFunctionMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"paymentProcessRequestStatusLookupCode\",              \"paymentsPayablesPaymentProcessRequest.timeCreated\": \"paymentProcessRequestCreatedOn\",              \"paymentMethod.code\": \"paymentMethodCode\",              \"paymentMethod.paymentMethodName\": \"paymentMethodName\",              \"paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"paymentMode.meaning\": \"paymentModeMeaning\",              \"documentPayableStatus.lookupCode\": \"documentPayableStatusLookupCode\",              \"documentPayableStatus.meaning\": \"documentPayableStatusMeaning\",              \"businessUnit.name\": \"businessUnitName\",              \"legalEntity.name\": \"legalEntityName\",              \"supplierSite.name\": \"supplierSiteName\",              \"supplierSite.supplier.supplierId\": \"supplierId\",              \"supplierSite.supplier.name\": \"supplierName\",              \"supplierSite.supplier.supplierType.lookupCode\": \"supplierTypeLookupCode\",              \"supplierSite.supplier.supplierType.meaning\": \"supplierTypeMeaning\",              \"payeeParty.name\": \"payeePartyName\",              \"bankAccount.name\": \"bankAccountName\",              \"externalBankAccount.bankAccountName\": \"externalBankAccountBankAccountName\",              \"externalBankAccount.countryCode\": \"countryCode\",              \"accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\": \"systemProfileCode\",              \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\": \"processingTypeMeaning\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\": \"paymentFormatCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\": \"formatName\",              \"payablesInvoiceInstallment.invoiceId\": \"invoiceId\",              \"payablesInvoiceInstallment.installmentNumber\": \"installmentNumber\",              \"payablesInvoiceInstallment.dueDate\": \"dueDate\",              \"payablesInvoiceInstallment.installmentAmount\": \"installmentAmount\",              \"payablesInvoiceInstallment.unpaidAmount\": \"unpaidAmount\",              \"payablesInvoiceInstallment.invoiceToPaymentConversionRate\": \"conversionRate\",              \"payablesInvoiceInstallment.remitToSupplierName\": \"remitToSupplierName\",              \"payablesInvoiceInstallment.invoiceTransaction.invoiceNumber\": \"invoiceNumber\",              \"payablesInvoiceInstallment.invoiceTransaction.invoiceDate\": \"invoiceDate\",              \"payablesInvoiceInstallment.invoiceTransaction.invoiceAmount\": \"invoiceAmount\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\": \"paymentProcessRequestId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"paymentProcessRequestName\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"paymentProcessRequestStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\": \"paymentInitiationMeaning\",              \"payablesDisbursementPayment.paymentId\": \"paymentId\",              \"payablesDisbursementPayment.paymentReferenceNumber\": \"paymentReferenceNumber\",              \"payablesDisbursementPayment.paymentAmount\": \"paymentAmount\",              \"payablesDisbursementPayment.paymentDate\": \"payablesDisbursementPaymentPaymentDate\",              \"payablesDisbursementPayment.bepErrorCode\": \"bepErrorCode\",              \"payablesDisbursementPayment.bepErrorMessageText\": \"bepErrorMessageText\",              \"payablesDisbursementPayment.paymentStatus.lookupCode\": \"paymentStatusLookupCode\",              \"payablesDisbursementPayment.paymentStatus.meaning\": \"paymentStatusMeaning\",              \"payablesDisbursementPayment.fundsStatus.meaning\": \"fundsStatusMeaning\",              \"payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId\": \"paymentInstructionId\",              \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode\": \"paymentFileProcessingStatusLookupCode\",              \"payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.meaning\": \"paymentFileProcessingStatusMeaning\",              \"payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated\": \"acknowledgementFileCreatedOn\",              \"payablesDisbursementPayment.payablesPayment.paymentNumber\": \"paymentNumber\",              \"payablesDisbursementPayment.payablesPayment.paymentStatus.meaning\": \"payablesPaymentPaymentStatusMeaning\",              \"payablesDisbursementPayment.payablesPayment.reconciledFlag\": \"reconciledFlag\",              \"payablesDisbursementPayment.payablesPayment.clearingDate\": \"clearingDate\"            }          }        },        \"select\": \"{select_statement}\"      },      \"selectExamples\": [        {          \"key\": \"stuckInstallmentsFailureTypeSummary\",          \"name\": \"stuckDueToFailureSummary\",          \"intentSliceKey\": \"stuckInstallmentsFailureTypeSummary\",          \"description\": \"Aggregate installments stuck because of failure by failure type.\",          \"outputFields\": [            \"failureType\",            \"installmentCount\"          ],          \"select\": \"SELECT CASE WHEN paymentProcessRequestStatusLookupCode IN ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') THEN paymentProcessRequestStatusMeaning ELSE paymentFileProcessingStatusMeaning END AS failureType, COUNT(*) AS installmentCount FROM paymentRunInstallments WHERE (paymentProcessRequestStatusLookupCode IN ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') OR paymentFileProcessingStatusLookupCode IN ('FORMATTING_FAILED','TRANSMISSION_FAILED','CREATION_ERROR')) GROUP BY CASE WHEN paymentProcessRequestStatusLookupCode IN ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') THEN paymentProcessRequestStatusMeaning ELSE paymentFileProcessingStatusMeaning END\"        },        {          \"name\": \"summaryMissingBankAccount\",          \"description\": \"Aggregate non-virtual-card payment-run documents missing a disbursement bank account, grouped by payment currency.\",          \"select\": \"SELECT 'Missing Disbursement Bank Account' AS missingAttributeType, COUNT(DISTINCT documentPayableId) AS documentCount, SUM(amountToBePaid) AS totalAmount, paymentCurrencyCode FROM paymentRunInstallments WHERE bankAccountId IS NULL AND (paymentModeLookupCode != 'VIRTUAL_CARD' OR paymentModeLookupCode IS NULL) GROUP BY paymentCurrencyCode\"        },        {          \"key\": \"missingProcessingAttributesSummary\",          \"name\": \"missingProcessingAttributesInPpr\",          \"intentSliceKey\": \"missingProcessingAttributesSummary\",          \"description\": \"List installments in a PPR that are missing processing attributes.\",          \"outputFields\": [            \"paymentProcessRequestName\",            \"missingAttributeType\",            \"supplierSiteName\",            \"sourceProductReferenceNumber\",            \"paymentMethodName\",            \"businessUnitName\",            \"legalEntityName\",            \"paymentCurrencyCode\",            \"paymentProcessRequestStatusMeaning\"          ],          \"select\": \"SELECT paymentProcessRequestName AS paymentProcessRequestName, CASE WHEN bankAccountId IS NULL THEN 'Missing Disbursement Bank Account' WHEN paymentProfileId IS NULL THEN 'Missing Payment Profile' ELSE 'Other Missing Attribute' END AS missingAttributeType, supplierSiteName AS supplierSiteName, sourceProductReferenceNumber AS sourceProductReferenceNumber, paymentMethodName AS paymentMethodName, businessUnitName AS businessUnitName, legalEntityName AS legalEntityName, paymentCurrencyCode AS paymentCurrencyCode, paymentProcessRequestStatusMeaning AS paymentProcessRequestStatusMeaning FROM paymentRunInstallments WHERE (bankAccountId IS NULL OR paymentProfileId IS NULL) AND (paymentModeLookupCode != 'VIRTUAL_CARD' OR paymentModeLookupCode IS NULL)\"        },        {          \"key\": \"acknowledgementRejectedInstallmentsInPaymentFile\",          \"name\": \"acknowledgementRejectedInstallmentsInPaymentFile\",          \"intentSliceKey\": \"paymentFileRejectedPaymentDetails\",          \"description\": \"List acknowledgement-rejected installments and bank error detail for a specific payment file.\",          \"outputFields\": [            \"invoiceNumber\",            \"invoiceDate\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"supplierName\"          ],          \"select\": \"SELECT invoiceNumber, invoiceDate, installmentNumber, paymentReferenceNumber, payablesDisbursementPaymentPaymentDate, bepErrorCode, bepErrorMessageText, paymentStatusMeaning, paymentInstructionId, supplierName FROM paymentRunInstallments WHERE paymentInstructionId = <PAYMENT_FILE_ID_FROM_USER> AND paymentStatusLookupCode = 'VOID' AND bepErrorCode IS NOT NULL\"        },        {          \"key\": \"broadAcknowledgementRejectedInstallmentsLast30Days\",          \"name\": \"broadAcknowledgementRejectedInstallmentsLast30Days\",          \"intentSliceKey\": \"paymentFileRejectedPaymentDetails\",          \"description\": \"List acknowledgement-rejected installments with invoice detail for broad rejected-payment questions using acknowledgement file creation date.\",          \"outputFields\": [            \"invoiceNumber\",            \"invoiceDate\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"supplierName\"          ],          \"select\": \"SELECT invoiceNumber, invoiceDate, installmentNumber, paymentReferenceNumber, payablesDisbursementPaymentPaymentDate, bepErrorCode, bepErrorMessageText, paymentStatusMeaning, paymentInstructionId, supplierName FROM paymentRunInstallments WHERE paymentStatusLookupCode = 'VOID' AND bepErrorCode IS NOT NULL AND acknowledgementFileCreatedOn >= TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00'\"        }      ],      \"businessDrivers\": [        {          \"name\": \"installmentByIdOrReference\",          \"description\": \"Retrieve a payment-run installment by document payable id or source reference number.\",          \"when\": \"User asks for one installment, one source transaction, or one document payable entry.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"sourceProductReferenceNumber\",            \"paymentDate\",            \"paymentDueDate\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"documentPayableStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or sourceProductReferenceNumber='<SOURCE_REFERENCE_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"installmentsByPpr\",          \"description\": \"Retrieve payment-run installments under a named or identified payment process request.\",          \"when\": \"User asks for installments in a PPR or payment run.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"invoiceNumber\",            \"installmentNumber\",            \"amountToBePaid\",            \"paymentDate\",            \"paymentId\",            \"paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"\"        },        {          \"name\": \"bankAccountByInstallment\",          \"description\": \"Retrieve the paying bank account and the payee external bank account for a specific installment, with surrounding payment logistics.\",          \"when\": \"User asks which bank account is being used to pay for a specific installment in a payment run or PPR.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"invoiceNumber\",            \"installmentNumber\",            \"bankAccountName\",            \"externalBankAccountBankAccountName\",            \"countryCode\",            \"paymentMethodName\",            \"paymentModeMeaning\",            \"paymentCurrencyCode\",            \"paymentId\",            \"paymentReferenceNumber\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\",            \"invoiceNumber='<INVOICE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer documentPayableId when available. If the user asks by invoice and installment number, use extraction aliases invoiceNumber and installmentNumber in the SQL WHERE clause and SELECT bankAccountName. Do not use unsupported dotted paths and do not suppress query context when no rows are returned.\"        },        {          \"name\": \"paymentSetupByInstallment\",          \"description\": \"Retrieve payment setup details for an installment, including payment method, payment mode, payment profile, processing type, and format.\",          \"when\": \"User asks about payment and processing options for a specific installment.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentMethodName\",            \"paymentModeMeaning\",            \"paymentProfileName\",            \"systemProfileCode\",            \"processingTypeMeaning\",            \"paymentFormatCode\",            \"formatName\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or payablesInvoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"missingProcessingAttributesInPpr\",          \"description\": \"List payment-run installments in a PPR that are missing required processing attributes such as disbursement bank account or payment profile.\",          \"when\": \"User asks what attributes are missing for processing a named PPR, which installments are incomplete, or wants a missing-attribute drill-down for bank account or payment profile setup.\",          \"fieldsToReturn\": [            \"paymentProcessRequestName\",            \"missingAttributeType\",            \"supplierSiteName\",            \"sourceProductReferenceNumber\",            \"paymentMethodName\",            \"businessUnitName\",            \"legalEntityName\",            \"paymentCurrencyCode\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"(bankAccountId is null or paymentProfileId is null)\",            \"(paymentModeLookupCode!='VIRTUAL_CARD' or paymentModeLookupCode is null)\"          ],          \"notes\": \"Classify missingAttributeType in the SELECT using the CASE expression: Missing Disbursement Bank Account, Missing Payment Profile, or Other Missing Attribute. Do not add unrelated failure-status predicates; this driver is for missing setup attributes, not process failures. Use this as a detail-row driver, not a summary driver.\"        },        {          \"name\": \"resultingPaymentTrace\",          \"description\": \"Trace a payment-run installment to the resulting disbursement payment and payment file.\",          \"when\": \"User asks which payment, payment file, or payment status resulted from a specific installment.\",          \"fieldsToReturn\": [            \"documentPayableId\",            \"invoiceNumber\",            \"installmentNumber\",            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentStatusMeaning\",            \"fundsStatusMeaning\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"documentPayableId=<DOCUMENT_PAYABLE_ID_FROM_USER> or payablesInvoiceInstallment.installmentNumber=<INSTALLMENT_NUMBER_FROM_USER>\"          ],          \"notes\": \"Add invoice number or source reference when needed to disambiguate an installment.\"        },        {          \"name\": \"proposedPaymentsByPpr\",          \"description\": \"Review proposed payments in a payment run with the bank-account and payment-formation context needed before approval.\",          \"when\": \"User asks to review proposed payments for a PPR after the run has grouped installments into payments.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"amountToBePaid\",            \"paymentDate\",            \"bankAccountName\",            \"externalBankAccountBankAccountName\",            \"paymentProfileName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use this driver when the user explicitly wants the readable disbursement bank account name instead of only the internal bank account id.\"        },        {          \"name\": \"fundingCheckByBankAccount\",          \"description\": \"Review proposed payment totals by disbursement bank account for funding sufficiency.\",          \"when\": \"User asks to group payments by bank account to verify funds before approval or transmission.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"bankAccountId\",            \"bankAccountName\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"payeePartyName\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Group externally by bankAccount.id or bankAccount.name and sum amountToBePaid.\"        },        {          \"name\": \"supplierValueConcentrationInRun\",          \"description\": \"Identify the suppliers or payees that account for most of the proposed payment value in the run.\",          \"when\": \"User asks which suppliers represent 80 percent of the total value in a PPR.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"amountToBePaid\",            \"invoiceNumber\",            \"bankAccountName\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Aggregate by payeeParty.name, sort descending by summed amountToBePaid, and compute the running cumulative percentage outside the base fetch.\"        },        {          \"name\": \"highValueProposedPayments\",          \"description\": \"Surface high-value proposed payments with supplier, invoice, and bank-routing context for approval review.\",          \"when\": \"User asks for payments above a threshold that need manager approval.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"invoiceNumber\",            \"installmentNumber\",            \"amountToBePaid\",            \"paymentDate\",            \"bankAccountName\",            \"paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\",            \"amountToBePaid>=<AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_100000>\"          ],          \"notes\": \"\"        },        {          \"name\": \"summaryMissingBankAccount\",          \"description\": \"Summarize non-virtual-card payment-run documents that lack a disbursement bank account.\",          \"when\": \"User asks for a summary, document count, total amount, or missing-attribute grouping for documents missing disbursement bank account.\",          \"fieldsToReturn\": [            \"missingAttributeType\",            \"documentCount\",            \"totalAmount\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"bankAccount.id is null\",            \"(paymentMode.lookupCode!='VIRTUAL_CARD' or paymentMode.lookupCode is null)\"          ],          \"notes\": \"Return an aggregate result only: missingAttributeType, documentCount, totalAmount, and paymentCurrencyCode. Generate a grouped SELECT from paymentRunInstallments with COUNT(DISTINCT documentPayableId) AS documentCount, SUM(amountToBePaid) AS totalAmount, and paymentCurrencyCode. Because totalAmount is returned, paymentCurrencyCode is mandatory and must appear in GROUP BY. Do not return PPR name, PPR count, invoiceNumber, installmentNumber, supplier, due date, or other row-level detail in this summary slice. Do not apply ROWNUM <= 20 to this grouped summary.\"        },        {          \"name\": \"documentsMissingDisbursementBankAccount\",          \"description\": \"Find non-virtual-card document payables in the run that do not yet have a disbursement bank account assigned.\",          \"when\": \"User asks which documents are missing the disbursement bank account during installment review.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"invoiceNumber\",            \"installmentNumber\",            \"payeePartyName\",            \"paymentMethodName\",            \"paymentModeMeaning\",            \"paymentDate\",            \"amountToBePaid\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\",            \"bankAccountId is null\",            \"(paymentModeLookupCode!='VIRTUAL_CARD' or paymentModeLookupCode is null)\"          ],          \"notes\": \"For a named PPR, combine paymentProcessRequestName with bankAccountId is null and the virtual-card exclusion. Do not omit the virtual-card exclusion and do not replace bankAccountId with a different setup field.\"        },        {          \"name\": \"documentsMissingProcessingAttributes\",          \"description\": \"Find non-virtual-card document payables missing required payment setup such as disbursement bank account or payment profile.\",          \"when\": \"User asks which documents are missing attributes before the payment run can continue.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"invoiceNumber\",            \"installmentNumber\",            \"dueDate\",            \"paymentMethodName\",            \"businessUnitName\",            \"legalEntityName\",            \"paymentCurrencyCode\",            \"amountToBePaid\",            \"bankAccountName\",            \"externalBankAccountBankAccountName\",            \"paymentProfileName\",            \"paymentModeMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\",            \"(bankAccountId is null or paymentProfileId is null)\",            \"(paymentModeLookupCode!='VIRTUAL_CARD' or paymentModeLookupCode is null)\"          ],          \"notes\": \"For a named PPR, combine paymentProcessRequestName with the missing bank-account/payment-profile predicate and virtual-card exclusion. This driver supports missing-attribute drill-down for processing a PPR. Detail output must include Payment Method, Business Unit, Legal Entity, and Currency.\"        },        {          \"key\": \"stuckInstallmentsFailureTypeSummary\",          \"name\": \"stuckDueToFailureSummary\",          \"intentSliceKey\": \"stuckInstallmentsFailureTypeSummary\",          \"description\": \"Count payment-run installments by failure type for broad stuck-because-of-failure questions.\",          \"when\": \"User asks for a summary or an all-installments view of installments stuck because of failure and needs the count of installments under each failure type before the detail rows.\",          \"fieldsToReturn\": [            \"failureType\",            \"installmentCount\"          ],          \"extraFilterExpressions\": [            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') or payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode in ('FORMATTING_FAILED','TRANSMISSION_FAILED','CREATION_ERROR'))\"          ],          \"notes\": \"Return an aggregate result only: failureType and installmentCount. Generate a grouped SELECT with CASE WHEN paymentProcessRequestStatusLookupCode is in the PPR failure-status set THEN paymentProcessRequestStatusMeaning ELSE paymentFileProcessingStatusMeaning END AS failureType, COUNT(*) AS installmentCount from paymentRunInstallments, and repeat the same CASE expression in GROUP BY. Do not return PPR name, invoiceNumber, installmentNumber, amount, currency, due date, or any other row-level detail in this summary slice. Do not apply ROWNUM <= 20 to this grouped summary.\"        },        {          \"name\": \"stuckDueToFailure\",          \"description\": \"List payment-run installments that are stuck because the PPR or related payment file is in a failure, validation, approval-error, or information-required state.\",          \"when\": \"User asks for all installments, documents, or rows stuck because of failure and needs the detail columns PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"paymentProcessRequestStatusMeaning\",            \"paymentFileProcessingStatusLookupCode\",            \"paymentFileProcessingStatusMeaning\",            \"invoiceNumber\",            \"installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"dueDate\"          ],          \"extraFilterExpressions\": [            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','ORA_APPROVAL_ERROR') or payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode in ('FORMATTING_FAILED','TRANSMISSION_FAILED','CREATION_ERROR'))\",            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('INFORMATION_REQUIRED','PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','MISSING RATES','MISSING_X_RATES','ORA_APPROVAL_ERROR') or payablesDisbursementPayment.payablesPaymentFile.paymentFileProcessingStatus.lookupCode in ('FORMATTING_FAILED','TRANSMISSION_FAILED','CREATION_ERROR'))\"          ],          \"notes\": \"Use this as the primary detail row-list path for broad all-installments-stuck-because-of-failure questions. Keep the visible detail columns limited to PPR Name, PPR Status, Payment File Status, Invoice Number, Installment Number, Amount, Payment Currency, and Due Date unless the user explicitly asks for error, supplier, or setup context. Payment File Status is mandatory because payment-file failure statuses are part of the OR filter and may be the reason the installment is stuck. Return PPR ID, PPR status code, and payment file status code as helper fields for deeplink/status enrichment; these helper fields are not intended as visible business columns and are removed by the response enricher when used. Use paymentRunInstallmentExceptions or documentValidationErrors only to add attached error codes, messages, or status reasons. Missing-rate statuses are AP-source statuses and should route to selectedPaymentInstallments.\"        },        {          \"name\": \"currencyMismatchByDestinationCountry\",          \"description\": \"Review installments where the payable document currency differs from the payment currency and summarize them by destination country.\",          \"when\": \"User asks for currency mismatches grouped by destination country during installment review.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"invoiceNumber\",            \"installmentNumber\",            \"documentCurrencyCode\",            \"paymentCurrencyCode\",            \"countryCode\",            \"conversionRate\",            \"amountToBePaid\"          ],          \"extraFilterExpressions\": [            \"documentCurrencyCode!=paymentCurrencyCode\",            \"conversionRate is null\"          ],          \"notes\": \"Use externalBankAccount.countryCode as the destination-country grouping dimension. For this combined query, apply both predicates together: DOCUMENT_CURRENCY_CODE != PAYMENT_CURRENCY_CODE and CONVERSION_RATE is null.\"        },        {          \"name\": \"highValueInstallmentsBySupplierType\",          \"description\": \"Find high-value installments in the Oracle Payments run branch for a supplier type or category.\",          \"when\": \"User asks for installments above a threshold for suppliers in a category such as manufacturing and the request is explicitly scoped to Oracle Payments, payment-run, formed-payment, IBY, payment-file, bank-account, or another payment-execution-only context.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"supplierTypeMeaning\",            \"invoiceNumber\",            \"installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"paymentDate\"          ],          \"extraFilterExpressions\": [            \"amountToBePaid>=<AMOUNT_THRESHOLD_FROM_USER_OR_DEFAULT_50000>\",            \"supplierSite.supplier.supplierType.lookupCode='<SUPPLIER_TYPE_CODE_FROM_USER>'\"          ],          \"notes\": \"Use supplierSite.supplier.supplierType when the organization-specific supplier category can be mapped to a supplier type code and the requested population is the Oracle Payments/payment-run branch. For generic installments under a PPR, use the deduplicated PPR installment extraction shapes instead.\"        },        {          \"name\": \"fundingBankForSupplierAmount\",          \"description\": \"Find the paying internal bank account for a supplier installment or proposed payment above a requested amount.\",          \"when\": \"User asks which internal bank account is funding a high-value installment for a supplier.\",          \"fieldsToReturn\": [            \"paymentProcessRequestId\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"payeePartyName\",            \"invoiceNumber\",            \"installmentNumber\",            \"amountToBePaid\",            \"paymentCurrencyCode\",            \"bankAccountId\",            \"bankAccountName\",            \"externalBankAccountBankAccountName\",            \"countryCode\"          ],          \"extraFilterExpressions\": [            \"payeeParty.name='<SUPPLIER_NAME_FROM_USER>'\",            \"amountToBePaid>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>' when the user provides a PPR\"          ],          \"notes\": \"If no PPR is provided, use the supplier and amount threshold first, then ask for or infer the run context before presenting multiple matches.\"        },        {          \"name\": \"blockingValidationErrorsForUrgentPayments\",          \"description\": \"Show validation errors blocking overdue or high-impact document payables/installments so the user can fix the most urgent payment issues first.\",          \"when\": \"User asks for validation errors blocking high-priority, urgent, overdue, or must-fix-first payments/installments.\",          \"fieldsToReturn\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",            \"payeeParty.name\",            \"sourceProductReferenceNumber\",            \"paymentDueDate\",            \"paymentDate\",            \"paymentCurrencyCode\",            \"amountToBePaid\",            \"disbursementPaymentTransactionErrors.errorCode\",            \"disbursementPaymentTransactionErrors.errorMessage\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS')\",            \"paymentDueDate < paymentDate\",            \"disbursementPaymentTransactionErrors.errorCode is not null\"          ],          \"sortBy\": [            {              \"attribute\": \"paymentDueDate\",              \"direction\": \"asc\"            },            {              \"attribute\": \"amountToBePaid\",              \"direction\": \"desc\"            }          ],          \"notes\": \"Map `paymentProcessRequestStatusCode` to `paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode`, alias `PPR Status Code`. For overdue logic, use `paymentDueDate < paymentDate`. Since this shape does not expose an explicit priority field, prioritize by overdue date first and amount second.\"        },        {          \"name\": \"blockingValidationErrorsForHighPriorityItems\",          \"description\": \"Locate validation errors currently blocking high-priority or overdue payment items that are pending manual review before payment processing can continue.\",          \"when\": \"User asks for validation errors blocking high-priority items, overdue installments, urgent payments, or operationally critical payment exceptions requiring immediate remediation.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentProcessRequestName\",            \"paymentProcessRequestStatusLookupCode\",            \"sourceProductReferenceNumber\",            \"documentPayableId\",            \"payeePartyName\",            \"amountToBePaid\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusLookupCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS')\"          ],          \"notes\": \"Use this driver whenever the user asks for validation errors that are actively blocking payment processing or operationally important items. Always constrain the population to PPRs pending review for document or payment validation errors. Use this as the canonical blocking-condition filter for both summary and detail workflows so the same blocked population is preserved consistently across all planned steps.\"        },        {          \"name\": \"acknowledgementRejectedInstallmentsRecent\",          \"description\": \"List recent installments or rejected payments whose resulting payment was rejected by acknowledgement processing when no payment file is provided.\",          \"when\": \"User asks for acknowledgement rejected installments, rejected acknowledgements, rejected payments with invoice detail, or installments rejected by bank acknowledgement without providing a payment file, supplier, date range, or active context.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"invoiceNumber\",            \"invoiceDate\",            \"invoiceAmount\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusLookupCode\",            \"paymentStatusMeaning\",            \"payeePartyName\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"payablesDisbursementPayment.paymentStatus.lookupCode='VOID'\",            \"payablesDisbursementPayment.bepErrorCode is not null\",            \"acknowledgementFileCreatedOn>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00'\"          ],          \"notes\": \"Use this as the canonical driver for broad acknowledgement-rejected installment or rejected-payment questions that need invoice, supplier, error-code, and payment detail. Include invoiceAmount when invoice amount is requested or when returning invoice detail. Use acknowledgementFileCreatedOn as the default last-30-days date axis for broad acknowledgement-rejected installment questions. Because this extraction generates Oracle SQL against a datetime field, use an ANSI TIMESTAMP literal. For this Payment File inquiry scenario, display paymentStatusLookupCode='VOID' as `Acknowledgment Rejected`. Return the BEP error code and message when available. Display Payment Number from paymentReferenceNumber.\"        },        {          \"name\": \"acknowledgementRejectedInstallmentsInPaymentFile\",          \"description\": \"Payment-file-scoped acknowledgement-rejected installments with bank error, supplier, invoice, and payment context.\",          \"when\": \"User asks for acknowledgement-rejected installments, rejection reason, or bank-provided acknowledgement error for a specific payment file.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"invoiceDate\",            \"invoiceAmount\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"paymentStatusLookupCode='VOID'\",            \"bepErrorCode IS NOT NULL when supported\"          ],          \"notes\": \"Do not filter acknowledgement-rejected payments by inbound file processing status. Include invoiceAmount when invoice amount is requested or when returning invoice detail. Display paymentReferenceNumber as Payment Number and VOID as Acknowledgment Rejected.\"        },        {          \"name\": \"broadAcknowledgementRejectedInstallmentsLast30Days\",          \"description\": \"Broad acknowledgement-rejected installment search with invoice detail and default acknowledgement-file date window.\",          \"when\": \"User asks for rejected payments or acknowledgement-rejected installments with invoice detail and provides no payment file, supplier, date range, or active context.\",          \"fieldsToReturn\": [            \"invoiceNumber\",            \"invoiceDate\",            \"invoiceAmount\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"paymentStatusLookupCode='VOID'\",            \"bepErrorCode IS NOT NULL when supported\",            \"acknowledgementFileCreatedOn>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Use acknowledgementFileCreatedOn for the default date window and Oracle ANSI TIMESTAMP literals. Include invoiceAmount when invoice amount is requested or when returning invoice detail. Do not generate a direct BV filter on the deep inbound-file timestamp path for broad queries.\"        },        {          \"name\": \"rejectedPaymentsInPartiallyAcknowledgedFiles\",          \"description\": \"Rejected payments with supplier, invoice, and bank-error detail limited to parent payment files in partially acknowledged status.\",          \"when\": \"User asks for rejected payments within partially acknowledged files, optionally with error codes, suppliers, or invoice details, and does not provide a specific payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"invoiceNumber\",            \"invoiceDate\",            \"invoiceAmount\",            \"installmentNumber\",            \"paymentReferenceNumber\",            \"payablesDisbursementPaymentPaymentDate\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentStatusMeaning\",            \"supplierName\"          ],          \"extraFilterExpressions\": [            \"paymentFileProcessingStatusLookupCode='PARTIALLY_ACKNOWLEDGED'\",            \"paymentStatusLookupCode='VOID'\",            \"bepErrorCode IS NOT NULL when supported\",            \"acknowledgementFileCreatedOn>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Use this driver for the partially acknowledged parent-file scenario. Preserve the parent payment-file scope with paymentFileProcessingStatusLookupCode='PARTIALLY_ACKNOWLEDGED'. Display VOID as `Acknowledgment Rejected`, include BEP error code/message when available, and use acknowledgementFileCreatedOn for the default last-30-days window.\"        }      ],      \"additionalInstructions\": [        \"For broad all-installments-stuck-because-of-failure questions, use stuckDueToFailureSummary for the failure-type count summary and stuckDueToFailure for the detail rows. Detail rows must include Payment File Status because payment-file failure statuses are part of the stuck-condition OR filter.\",        \"For stuckDueToFailureSummary, return only failureType and installmentCount from a grouped aggregate query. Never reuse stuckDueToFailure detail fields, never include row-level columns, and never apply the detail row limit.\",        \"For summaryMissingBankAccount, return only missingAttributeType, documentCount, totalAmount, and paymentCurrencyCode from a grouped aggregate query. Never include PPR count, never reuse documentsMissingDisbursementBankAccount detail fields, never include row-level columns, and never apply the detail row limit.\",        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.paymentRunInstallments as the FROM source with alias consistent in the SQL (for example paymentRunInstallments).\",        \"The inner subselect should project all aliases used by the outer SELECT and WHERE.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"For detail row-list queries, limit the outer query to 20 rows using where ROWNUM<=20. Do not apply this row limit to grouped summary queries unless the user explicitly asks for top N groups and the query has a valid aggregate ORDER BY.\",        \"Use the canonical resource `paymentRunInstallments`, and prefer the richer `paymentRunInstallments` expanded view when bank-account, PPR, payment, payment-file, or invoice-installment accessor details are needed.\",        \"When any detail or grouped output returns the display column `PPR Name` or the runtime field `paymentProcessRequestName`, also return `paymentProcessRequestId` with alias `PPR ID` and `paymentProcessRequestStatusLookupCode` with alias `PPR Status Code` as deeplink support fields. When `PPR Status` or `paymentProcessRequestStatusMeaning` is returned without PPR Name, still return `paymentProcessRequestStatusLookupCode` with alias `PPR Status Code` when supported. These support fields are not visible business columns; the response deeplink enricher removes them after building links.\",        \"When a response explicitly needs payment-file deeplinks, return `paymentInstructionId`, `paymentFileProcessingStatusMeaning`, and `paymentFileProcessingStatusLookupCode` with their existing aliases so the response deeplink enricher can choose the correct payment-file view or action link.\",        \"Do not use paymentRunInstallmentsExtraction as the primary source for plain 'review installments for PPR' requests. Use pprInstallmentsDeduplicatedSummary for summary review and pprInstallmentsDeduplicatedDetails for line-level review unless the PPR status resolves to Oracle Payments or the user explicitly asks for IBY-source, payment-run, formed-payment, payment-file, bank-account, or other payment-execution-only context.\",        \"Do not replace the deduplicated PPR installment population with this source solely because this source exposes an extra classifier such as supplier type or category. If the deduplicated extraction exposes a branch-safe alias for the classifier, keep the deduplicated shape and let that shape apply the branch-scoped filter.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases or attributes not present in the expanded view.\",        \"This is the best canonical BV when the user needs readable disbursement bank account names, supplier bank account names, or formed-payment context during proposed-payment review.\",        \"Use this shape for missing-attribute drill-down after installments are already in Oracle Payments, including bank-account and payment-profile gaps on non-virtual-card documents.\",        \"Use documentCurrencyCode as the payable-document currency when comparing it with paymentCurrencyCode in installment review.\",        \"For currency-mismatch queries that ask to highlight missing conversion rates by destination country, use documentCurrencyCode!=paymentCurrencyCode and conversionRate is null together; in source-column terms this is DOCUMENT_CURRENCY_CODE != PAYMENT_CURRENCY_CODE and CONVERSION_RATE is null.\",        \"For installment bank-account questions, return both `bankAccount.name` and `externalBankAccount.bankAccountName` together, since users usually need the paying account and the destination account in one answer.\",        \"When filtering by installment, prefer `documentPayableId` when available. If the user only gives an installment number, add invoice number, source reference, or PPR context to avoid ambiguous matches.\",        \"For payment and processing option questions, include `paymentMethod`, `paymentMode`, `accountPaymentProfile`, `systemPaymentProfile.processingType`, and `systemPaymentProfile.paymentFormat` together so the answer explains the setup driving the installment payment.\",        \"When the user asks for resulting payment or file context, follow the accessor chain through `payablesDisbursementPayment` and `payablesDisbursementPayment.payablesPaymentFile` instead of guessing from top-level installment fields.\",        \"For broad acknowledgement rejected installment or rejected-payment questions without a payment file, supplier, date range, or active context, filter `payablesDisbursementPayment.paymentStatus.lookupCode='VOID'`, require `payablesDisbursementPayment.bepErrorCode is not null` when available, and default to the last 30 days using `acknowledgementFileCreatedOn` with an Oracle ANSI TIMESTAMP literal. This extraction path is the canonical route when the user asks for rejected payments with error codes, suppliers, and invoice details. For a single-day user request on this datetime field, use whole-day TIMESTAMP bounds. For payment-file-scoped acknowledgement rejected installment questions, filter by `payablesDisbursementPayment.payablesPaymentFile.paymentInstructionId` and do not add a default date filter. For rejected payments within partially acknowledged files, preserve the parent file scope with `paymentFileProcessingStatusLookupCode='PARTIALLY_ACKNOWLEDGED'`. Display VOID as `Acknowledgment Rejected`; include BEP error code/message when available. Display Payment Number from `paymentReferenceNumber`.\",        \"When testing for missing bank-account or payment-profile attributes, use is null predicates in the outer filter and exclude `paymentMode.lookupCode='VIRTUAL_CARD'` when the setup rule is specific to disbursement bank accounts.\",        \"The source driver `payment mode mappings` only contributed the `VIRTUAL_CARD` branch, which is already modeled in the local missing-attribute drivers and instructions; keep using that canonical local handling instead of adding a duplicate driver.\",        \"This shape does not expose the timestamp of a recent supplier bank-account change, so fraud-risk review for recently changed bank accounts is only partial here and may require another source.\",        \"Questions asking what bank account is being used to pay a specific installment are supported. Filter by invoice number plus installment number when documentPayableId is not provided, and return both the paying bank account and payee external bank account.\",        \"For 'Which documents are missing disbursement bank account', always generate the summaryMissingBankAccount extraction query context grouped by paymentCurrencyCode before any detail rows.\",        \"Questions asking what bank account is being used to pay a specific invoice installment are supported. For invoice/installment wording, generate SELECT bankAccountName FROM paymentRunInstallments WHERE invoiceNumber = '<INVOICE_NUMBER_FROM_USER>' AND installmentNumber = <INSTALLMENT_NUMBER_FROM_USER> AND ROWNUM <= 20.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Which documents are missing disbursement bank account\"          ],          \"queryType\": \"extraction\",          \"shape\": \"paymentRunInstallmentsExtraction\",          \"fields\": \"missingAttributeType,documentCount,totalAmount,paymentCurrencyCode\",          \"filters\": \"bankAccountId IS NULL AND (paymentModeLookupCode != 'VIRTUAL_CARD' OR paymentModeLookupCode IS NULL)\",          \"groupBy\": \"paymentCurrencyCode\",          \"sortBy\": \"totalAmount:desc\",          \"fieldOrderLocked\": true,          \"notes\": \"Use summaryMissingBankAccount. Select 'Missing Disbursement Bank Account' AS missingAttributeType, COUNT(DISTINCT documentPayableId) AS documentCount, SUM(amountToBePaid) AS totalAmount, paymentCurrencyCode. Do not omit query context and do not add a PPR filter unless supplied.\"        },        {          \"questionExamples\": [            \"Show me all proposed payments over $100,000 with supplier details\"          ],          \"queryType\": \"extraction\",          \"fields\": \"paymentProcessRequestName,paymentProcessRequestId,payeePartyName,amountToBePaid,paymentCurrencyCode,paymentMethodName,bankAccountName,supplierTypeMeaning,paymentDate,supplierSiteName\",          \"fieldOrderLocked\": true,          \"shape\": \"paymentRunInstallmentsExtraction\",          \"filters\": \"amountToBePaid > <AMOUNT_THRESHOLD_FROM_USER>\",          \"sortBy\": \"amountToBePaid:desc\",          \"limit\": 20,          \"notes\": \"Fallback extraction only; prefer paymentRunInstallments BV when the expected answer asks for proposed payments over a threshold with supplier details.\"        },        {          \"questionExamples\": [            \"show me what attributes are missing for processing PPR gapr_ppr_test_4\"          ],          \"queryType\": \"extraction\",          \"fields\": \"missingAttributeType,documentCount,totalAmount,paymentCurrencyCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"show me what attributes are missing for processing PPR gapr_ppr_test_4\"          ],          \"queryType\": \"extraction\",          \"fields\": \"paymentProcessRequestName,missingAttributeType,supplierSiteName,sourceProductReferenceNumber,paymentMethodName,businessUnitName,legalEntityName,paymentCurrencyCode,paymentProcessRequestStatusMeaning\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"What bank account is being used to pay for Installment 1 for invoice JPM01-INV01\"          ],          \"queryType\": \"extraction\",          \"fields\": \"bankAccountName\",          \"fieldOrderLocked\": true,          \"shape\": \"paymentRunInstallmentsExtraction\",          \"filters\": \"invoiceNumber = '<INVOICE_NUMBER_FROM_USER>' AND installmentNumber = <INSTALLMENT_NUMBER_FROM_USER> AND ROWNUM <= 20\",          \"notes\": \"Exact supported pattern: SELECT bankAccountName FROM paymentRunInstallments WHERE invoiceNumber = '<INVOICE_NUMBER_FROM_USER>' AND installmentNumber = <INSTALLMENT_NUMBER_FROM_USER> AND ROWNUM <= 20. Do not return narrative only when the result is empty.\"        }      ]    },    \"disbursementPayments\": {      \"key\": \"disbursementPayments\",      \"name\": \"disbursementPayments\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDisbursementPayment\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/disbursementPayments\",      \"description\": \"Business view for disbursement payment retrieval in Funds Disbursement. Use this shape for payment logistics, payment processing options, payment file and PPR context, virtual card payment identification, bank routing details, grouping-rule analysis, and payment status review.\",      \"exampleQuestions\": [        \"What bank account was used to pay Supplier X on 2026-01-15?\",        \"List payments for supplier Vision Operations with payment currency USD and amount exceeding 5000.\",        \"What payment file format was used for payment 14876?\",        \"What was the bank branch and bank for payment 14876?\",        \"What service level and delivery channel were used for payment 14876?\",        \"Show payments with maturity date falling in the next 10 days.\",        \"Show virtual card payments using alias RCN-7781 within the last two days\",        \"Show payments made to supplier Vision Operations using a virtual card.\",        \"Show virtual card payments for supplier Vision Operations in the last 30 days where the payment system status is Accepted but the payment status is not Cleared.\",        \"Show virtual card payments for program MC HSBC using aliases that contain MC Citibank\",        \"Show me the payments made using funding card account RCN-7781 from 2026-01-15 to today.\",        \"Show manual Electronic payments for Vision Operations last week over 10000 that are not reconciled.\",        \"Show me unreconciled payments older than 30 days from payment date.\",        \"Show payments in payment file 12345 with payment status and PPR details\",        \"Void payment 147884.\",        \"Re-issue payment 147884.\",        \"Print remittance for payment 147884.\",        \"Show me payments in Stop Initiated status for more than 7 days.\",        \"What is the payment status for expense report EXP-2025-001234 submitted by John Smith?\",        \"What is the status of the refund payment for credit memo CM-2025-001?\",        \"Show me the bank branch and country for all installments in this batch\",        \"What was the bank branch and bank for payment 2575\",        \"Show me the bank branch and country for Installments under PPR <PPR_NAME>\",        \"Show me all payments over 5000000 with supplier details\"      ],      \"fields\": {        \"fields\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"paymentReferenceNumber\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"paymentId\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"paymentDate\",          \"payeeName\",          \"payeePartyName\",          \"paymentBusinessUnit\",          \"paymentProcessRequestName\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"invoiceDueDate\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\",          \"paymentStatusLookupCode\",          \"paymentFunctionLookupCode\"        ],        \"accessors\": {          \"paymentStatus\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"paymentFunction\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"fundsStatus\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"accountPaymentProfile\": {            \"fields\": [              \"paymentProfileId\",              \"paymentProfileName\"            ],            \"accessors\": {              \"systemPaymentProfile\": {                \"fields\": [                  \"systemProfileCode\",                  \"declarationCurrencyExchangeRateType\",                  \"regulatoryReportFormatCode\"                ],                \"accessors\": {                  \"processingType\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  },                  \"paymentFormat\": {                    \"fields\": [                      \"paymentFormatCode\",                      \"formatTemplateCode\",                      \"formatName\"                    ],                    \"accessors\": {                      \"formatType\": {                        \"fields\": [                          \"code\",                          \"reportPath\",                          \"formatTypeName\",                          \"description\"                        ]                      }                    }                  },                  \"paymentCreationRule\": {                    \"fields\": [                      \"systemProfileCode\",                      \"groupByUltimateDebtorFlag\",                      \"groupByBankChargeBearerFlag\",                      \"groupByDeliveryChannelFlag\",                      \"groupByRemittanceMessageFlag\",                      \"groupByMaxDocumentsFlag\",                      \"groupByUniqueRemitIdFlag\",                      \"groupBySettlePriorityFlag\",                      \"groupByPaymentReasonFlag\",                      \"groupByDueDateFlag\",                      \"maxDocumentsPerPayment\"                    ]                  }                }              }            }          },          \"businessUnit\": {            \"fields\": [              \"id\",              \"name\",              \"effectiveStartDate\",              \"effectiveEndDate\"            ]          },          \"digitalPaymentAccount\": {            \"fields\": [              \"digitalPaymentAccountId\"            ],            \"accessors\": {              \"virtualCardProgram\": {                \"fields\": [                  \"id\",                  \"vcardProgramName\"                ]              }            }          },          \"paymentInstrument\": {            \"fields\": [              \"id\",              \"paymentInstrumentAlias\",              \"instrumentType\"            ]          },          \"externalBankAccount\": {            \"fields\": [              \"id\",              \"bankAccountName\",              \"maskedIban\",              \"maskedAccountNumber\",              \"eftSwiftCode\",              \"timeUpdated\",              \"timeCreated\",              \"countryCode\"            ]          },          \"paymentMethod\": {            \"fields\": [              \"code\",              \"paymentMethodName\"            ]          },          \"paymentMode\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"billsPayable\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"declarePayment\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"bankChargeBearer\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"settlementPriority\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"separateRemittanceAdviceRequired\": {            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"disbursementBankAccount\": {            \"fields\": [              \"id\",              \"name\",              \"timeUpdated\",              \"timeCreated\"            ],            \"accessors\": {              \"bank\": {                \"fields\": [                  \"id\",                  \"name\",                  \"countryCode\"                ]              },              \"bankBranch\": {                \"fields\": [                  \"id\",                  \"name\",                  \"bankHomeCountryCode\",                  \"bankId\",                  \"branchNumber\"                ]              }            }          },          \"legalEntity\": {            \"fields\": [              \"legalEntityId\",              \"name\"            ]          },          \"payablesPaymentFile\": {            \"fields\": [              \"paymentInstructionId\",              \"paymentRequestName\",              \"paymentFileProcessingStatusLookupCode\"            ],            \"accessors\": {              \"paymentFileProcessingStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentDocument\": {                \"fields\": [                  \"id\",                  \"paymentDocument\",                  \"firstAvailableDocumentNumber\",                  \"lastAvailableDocumentNumber\",                  \"lastIssuedDocumentNumber\"                ],                \"accessors\": {                  \"paymentDocumentCategory\": {                    \"fields\": [                      \"code\",                      \"applicationId\",                      \"name\"                    ]                  }                }              }            }          },          \"disbursementInboundFile\": {            \"fields\": [              \"id\",              \"fileName\",              \"timeCreated\",              \"errorMessage\"            ],            \"accessors\": {              \"paymentSystem\": {                \"fields\": [                  \"id\",                  \"paymentSystemName\"                ]              },              \"inboundFileProcessingStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              }            }          },          \"supplierSite\": {            \"fields\": [              \"id\",              \"name\"            ],            \"accessors\": {              \"supplier\": {                \"fields\": [                  \"supplierId\",                  \"name\"                ],                \"accessors\": {                  \"supplierType\": {                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  }                }              }            }          },          \"payablesPayment\": {            \"fields\": [              \"paymentId\",              \"paymentDate\",              \"paymentCurrencyCode\",              \"supplierName\",              \"paymentAmount\",              \"remitToSupplierName\",              \"remitToAddressName\",              \"futurePayDueDate\",              \"conversionRate\",              \"conversionDate\",              \"paymentBaseAmount\",              \"positivePayStatusCode\",              \"paymentNumber\",              \"clearingAmount\",              \"clearingDate\",              \"clearingBaseAmount\",              \"clearingConversionRate\",              \"clearingConversionDate\",              \"clearingConversionRateType\",              \"reconciledFlag\",              \"maturityConversionRate\",              \"maturityConversionDate\",              \"maturityConversionRateType\"            ],            \"accessors\": {              \"paymentType\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentCurrency\": {                \"fields\": [                  \"currencyCode\",                  \"issuingTerritoryCode\"                ]              },              \"paymentSettlementPriority\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              }            }          },          \"paymentsPayablesPaymentProcessRequest\": {            \"fields\": [              \"paymentProcessRequestId\",              \"paymentProcessRequestName\",              \"paymentProcessRequestStatusCode\",              \"timeCreated\",              \"paymentProcessRequestStatusLookupCode\"            ],            \"accessors\": {              \"paymentProcessRequestStatus\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentInitiation\": {                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              }            }          }        },        \"fieldAlias\": {          \"BEP Error Code\": \"bepErrorCode\",          \"BEP Error Message\": \"bepErrorMessageText\",          \"Payment Profile System\": \"paymentProfileSystemName\",          \"Payment Profile Account\": \"paymentProfileAccountName\",          \"Payment ID\": \"paymentId\",          \"Bank Assigned Reference\": \"bankAssignedReferenceCode\",          \"Unique Remittance Identifier\": \"uniqueRemittanceIdentifier\",          \"Payment Reason Comments\": \"paymentReasonComments\",          \"Created On\": \"timeCreated\",          \"Created By\": \"createdBy\",          \"Last Updated On\": \"timeUpdated\",          \"Last Updated By\": \"updatedBy\",          \"Payment Reference Number\": \"paymentReferenceNumber\",          \"Payment Date\": \"paymentDate\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payee\": \"payeeName\",          \"Payee Party Name\": \"payeePartyName\",          \"Invoice Payee Party Name\": \"invoicePayeePartyName\",          \"Payment Business Unit\": \"paymentBusinessUnit\",          \"Payment Process Request\": \"paymentProcessRequestName\",          \"Invoice Due Date\": \"invoiceDueDate\",          \"Maturity Date\": \"maturityDate\",          \"Anticipated Value Date\": \"anticipatedValueDate\",          \"Payment Complete\": \"paymentCompleteFlag\",          \"Service Level Code\": \"serviceLevelCode\",          \"Delivery Channel Code\": \"deliveryChannelCode\",          \"Bank Status Code\": \"bankStatusCode\",          \"Payment System Response Identifier\": \"paymentSystemResponseIdentifier\",          \"Issuer Authorization Reference\": \"issuerAuthorizationReference\",          \"Acquirer Transaction Reference\": \"acquirerTransactionReference\",          \"Issuer Processing Timestamp\": \"issuerProcessingTimestamp\",          \"Void Date\": \"voidDate\",          \"Void Reason\": \"voidReason\",          \"Stop Date\": \"stopDate\",          \"Stop Request Reason\": \"stopRequestReason\",          \"Payment Declaration Amount\": \"paymentDeclarationAmount\",          \"Bank Charge Amount\": \"bankChargeAmount\",          \"URI Check Digit\": \"uriCheckDigit\",          \"Remittance Message 1\": \"remittanceMessageOne\",          \"Remittance Message 2\": \"remittanceMessageTwo\",          \"Remittance Message 3\": \"remittanceMessageThree\",          \"Payment Text Message 1\": \"paymentTextMessageOne\",          \"Payment Text Message 2\": \"paymentTextMessageTwo\",          \"Payment Text Message 3\": \"paymentTextMessageThree\",          \"Stop Request Placed\": \"stopRequestPlacedFlag\",          \"Declaration Currency\": \"declarationCurrencyCode\",          \"Paper Document Number\": \"paperDocumentNumber\",          \"Stop Request Placed By\": \"stopRequestPlacedBy\",          \"Payment Status Lookup Code\": \"paymentStatusLookupCode\",          \"Payment Function Lookup Code\": \"paymentFunctionLookupCode\",          \"Payment Status Code\": \"paymentStatus.lookupCode\",          \"Payment Status\": \"paymentStatus.meaning\",          \"Funds Status Code\": \"fundsStatus.lookupCode\",          \"Funds Status\": \"fundsStatus.meaning\",          \"Payment Function Code\": \"paymentFunction.lookupCode\",          \"Payment Function\": \"paymentFunction.meaning\",          \"Payment Mode Code\": \"paymentMode.lookupCode\",          \"Payment Mode\": \"paymentMode.meaning\",          \"Payment Method Code\": \"paymentMethod.code\",          \"Payment Method\": \"paymentMethod.paymentMethodName\",          \"Payment Instrument Alias\": \"paymentInstrument.paymentInstrumentAlias\",          \"Payment Instrument Type\": \"paymentInstrument.instrumentType\",          \"Disbursement Bank Account\": \"disbursementBankAccount.name\",          \"Disbursement Bank\": \"disbursementBankAccount.bank.name\",          \"Disbursement Bank Country\": \"disbursementBankAccount.bank.countryCode\",          \"Disbursement Bank Branch\": \"disbursementBankAccount.bankBranch.name\",          \"Disbursement Bank Branch Number\": \"disbursementBankAccount.bankBranch.branchNumber\",          \"External Bank Account\": \"externalBankAccount.bankAccountName\",          \"External Bank Account Number\": \"externalBankAccount.maskedAccountNumber\",          \"External IBAN\": \"externalBankAccount.maskedIban\",          \"External Bank Country\": \"externalBankAccount.countryCode\",          \"Virtual Card Program\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"Payment Profile ID\": \"accountPaymentProfile.paymentProfileId\",          \"Payment Profile Name\": \"accountPaymentProfile.paymentProfileName\",          \"Processing Type\": \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"Processing Type Code\": \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"Payment Format Code\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",          \"Payment Format Name\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",          \"Payment Format Template\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\",          \"Format Type\": \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\",          \"Payment File ID\": \"payablesPaymentFile.paymentInstructionId\",          \"Payment File Reference\": \"payablesPaymentFile.paymentInstructionId\",          \"Payment File Request Name\": \"payablesPaymentFile.paymentRequestName\",          \"Payment File Processing Status Lookup Code\": \"payablesPaymentFile.paymentFileProcessingStatusLookupCode\",          \"Payment File Status Code\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"Payment File Status\": \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",          \"Acknowledgement File Name\": \"disbursementInboundFile.fileName\",          \"Acknowledgement File Created On\": \"disbursementInboundFile.timeCreated\",          \"Acknowledgement Error Message\": \"disbursementInboundFile.errorMessage\",          \"Acknowledgement Payment System\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"Acknowledgement Status Code\": \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\",          \"Acknowledgement Status\": \"disbursementInboundFile.inboundFileProcessingStatus.meaning\",          \"PPR ID\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"PPR Name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"PPR Status Lookup Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatusLookupCode\",          \"PPR Status Code\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"PPR Status\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",          \"PPR Initiation\": \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\",          \"Legal Entity ID\": \"legalEntity.legalEntityId\",          \"Legal Entity\": \"legalEntity.name\",          \"Supplier Site\": \"supplierSite.name\",          \"Supplier ID\": \"supplierSite.supplier.supplierId\",          \"Supplier Name\": \"supplierSite.supplier.name\",          \"Supplier Type Code\": \"supplierSite.supplier.supplierType.lookupCode\",          \"Supplier Type\": \"supplierSite.supplier.supplierType.meaning\",          \"AP Payment ID\": \"payablesPayment.paymentId\",          \"AP Payment Number\": \"payablesPayment.paymentNumber\",          \"AP Supplier Name\": \"payablesPayment.supplierName\",          \"Remit-To Supplier\": \"payablesPayment.remitToSupplierName\",          \"Remit-To Address\": \"payablesPayment.remitToAddressName\",          \"AP Payment Date\": \"payablesPayment.paymentDate\",          \"AP Payment Amount\": \"payablesPayment.paymentAmount\",          \"AP Payment Currency\": \"payablesPayment.paymentCurrency.currencyCode\",          \"AP Payment Status Code\": \"payablesPayment.paymentStatus.lookupCode\",          \"AP Payment Status\": \"payablesPayment.paymentStatus.meaning\",          \"Reconciled\": \"payablesPayment.reconciledFlag\",          \"Clearing Date\": \"payablesPayment.clearingDate\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentId\",          \"paymentReferenceNumber\",          \"paymentDate\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"payeePartyName\",          \"paymentProcessRequestName\",          \"paymentBusinessUnit\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"invoiceDueDate\"        ],        \"optional\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"payeeName\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\"        ]      },      \"sortableAttributes\": [        \"paymentDate\",        \"paymentReferenceNumber\",        \"bankAssignedReferenceCode\",        \"uniqueRemittanceIdentifier\",        \"timeCreated\",        \"timeUpdated\",        \"paymentId\",        \"paymentAmount\",        \"paymentCurrencyCode\",        \"paymentDate\",        \"payeeName\",        \"payeePartyName\",        \"paymentProcessRequestName\",        \"paymentCompleteFlag\",        \"bankStatusCode\",        \"paymentSystemResponseIdentifier\",        \"issuerAuthorizationReference\",        \"acquirerTransactionReference\",        \"voidDate\",        \"voidReason\",        \"stopDate\",        \"stopRequestReason\",        \"maturityDate\",        \"invoicePayeePartyName\",        \"invoiceDueDate\",        \"paperDocumentNumber\",        \"serviceLevelCode\",        \"deliveryChannelCode\"      ],      \"filterConditions\": [        {          \"name\": \"paymentId\",          \"attribute\": \"paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an internal disbursement payment identifier.\"        },        {          \"name\": \"paymentReferenceNumber\",          \"attribute\": \"paymentReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment reference number rather than the internal payment id.\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\"        },        {          \"name\": \"paymentAmount\",          \"attribute\": \"paymentAmount\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives a payment amount threshold or asks for high-value payments.\"        },        {          \"name\": \"paymentCurrencyCode\",          \"attribute\": \"paymentCurrencyCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency.\"        },        {          \"name\": \"payeePartyName\",          \"attribute\": \"payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user names the payee or supplier in payment logistics questions.\"        },        {          \"name\": \"payablesPayment.supplierName\",          \"attribute\": \"payablesPayment.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier name is available through the AP payment accessor.\"        },        {          \"name\": \"paymentBusinessUnit\",          \"attribute\": \"paymentBusinessUnit\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payments by business unit.\"        },        {          \"name\": \"payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment file identifier.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or requests a specific payment status code.\"        },        {          \"name\": \"paymentStatus.meaning\",          \"attribute\": \"paymentStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the display meaning of the payment status.\"        },        {          \"name\": \"bankStatusCode\",          \"attribute\": \"bankStatusCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payment-system or transmission-side acceptance or rejection status.\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method name.\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"VIRTUAL_CARD\"          ],          \"usage\": \"Use when the user asks about virtual card payments or other specific payment modes.\"        },        {          \"name\": \"paymentInstrument.paymentInstrumentAlias\",          \"attribute\": \"paymentInstrument.paymentInstrumentAlias\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an RCN or payment instrument alias.\"        },        {          \"name\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"attribute\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by virtual card program name.\"        },        {          \"name\": \"serviceLevelCode\",          \"attribute\": \"serviceLevelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment service levels.\"        },        {          \"name\": \"deliveryChannelCode\",          \"attribute\": \"deliveryChannelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment delivery channels.\"        },        {          \"name\": \"disbursementBankAccount.name\",          \"attribute\": \"disbursementBankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account was used.\"        },        {          \"name\": \"disbursementBankAccount.bank.name\",          \"attribute\": \"disbursementBankAccount.bank.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank name.\"        },        {          \"name\": \"disbursementBankAccount.bankBranch.name\",          \"attribute\": \"disbursementBankAccount.bankBranch.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank branch name.\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payee bank-country context.\"        },        {          \"name\": \"invoiceDueDate\",          \"attribute\": \"invoiceDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about invoice due dates tied to the payment.\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use legalEntity.legalEntityId=null when the user asks for payments in a payment file where legal entity is missing.\"        },        {          \"name\": \"disbursementInboundFile.id\",          \"attribute\": \"disbursementInboundFile.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use is not null when the user asks for payments linked to an inbound acknowledgement file.\"        },        {          \"name\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"attribute\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for acknowledgement-linked payments by payment system or bank such as JPM.\"        },        {          \"name\": \"voidDate\",          \"attribute\": \"voidDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about void timing or voided-payment aging.\"        },        {          \"name\": \"stopDate\",          \"attribute\": \"stopDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks how long a payment has remained stopped or stop initiated.\"        },        {          \"name\": \"payablesPayment.paymentNumber\",          \"attribute\": \"payablesPayment.paymentNumber\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the AP payment number for follow-up actions such as void, reissue, remittance, or status lookup.\"        },        {          \"name\": \"payablesPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user is asking for AP payment status rather than only the disbursement-side status. Use `VOIDED` for voided-payment inquiries, including JPM acknowledgement-linked voided payments.\"        },        {          \"name\": \"externalBankAccount.timeUpdated\",          \"attribute\": \"externalBankAccount.timeUpdated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks when the supplier external bank account was modified; for example externalBankAccount.timeUpdated>=2007-01-03T23:02:42Z.\"        },        {          \"name\": \"payablesPayment.reconciledFlag\",          \"attribute\": \"payablesPayment.reconciledFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            true,            false          ],          \"usage\": \"Use when the user asks whether matched payments are cleared or reconciled.\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentByIdOrReference\",          \"description\": \"Retrieve a specific disbursement payment by internal payment id or payment reference number.\",          \"when\": \"User asks for one payment, one payment reference, or one payment's processing details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER> or paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer `paymentId` when the user clearly gives the internal payment id.\"        },        {          \"name\": \"supplierPaymentLogisticsByDate\",          \"description\": \"Retrieve bank-account and payment-logistics details for a supplier or payee on a payment date.\",          \"when\": \"User asks which bank account was used to pay a supplier on a given payment date or asks for surrounding logistics.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\"          ],          \"extraFilterExpressions\": [            \"(payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>')\",            \"paymentDate=<PAYMENT_DATE_FROM_USER>\"          ],          \"notes\": \"Return bank account, bank, branch, and currency together so the answer includes the full logistics context.\"        },        {          \"name\": \"paymentFormatByPayment\",          \"description\": \"Retrieve the payment file format and related processing metadata for a specific payment.\",          \"when\": \"User asks what payment file format was used for a payment or asks for processing-option metadata.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"accountPaymentProfile.paymentProfileName\",            \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\",            \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"Use the payment-format accessor chain instead of trying to infer the format from payment method alone.\"        },        {          \"name\": \"bankRoutingByPayment\",          \"description\": \"Retrieve disbursement bank routing details for a specific payment.\",          \"when\": \"User asks for the bank, bank branch, or bank-country details for a payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"sort by paymentDate:asc\"        },        {          \"name\": \"bankBranchAndCountryByPprInstallments\",          \"description\": \"Retrieve disbursement bank branch, bank, and country details for payments/installments under a named PPR.\",          \"when\": \"User asks for the bank branch, bank, or country for installments or payments under a PPR.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccount.name\",            \"disbursementBankAccount.bank.name\",            \"disbursementBankAccount.bank.countryCode\",            \"disbursementBankAccount.bankBranch.name\",            \"disbursementBankAccount.bankBranch.branchNumber\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\",            \"sortBy: paymentDate:desc\",            \"limit: 20\"          ],          \"notes\": \"Use this for PPR-scoped bank branch/country questions. Sort by paymentDate desc and limit 20. Do not use paymentDate asc for this latest-results lookup.\"        },        {          \"name\": \"serviceLevelAndDeliveryChannelByPayment\",          \"description\": \"Retrieve service-level and delivery-channel attributes for a payment reference or payment id, with related payment-format context when requested.\",          \"when\": \"User asks for service level codes, delivery channels, or how a payment was configured for delivery.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"serviceLevelCode\",            \"deliveryChannelCode\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.meaning\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\",            \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\"          ],          \"extraFilterExpressions\": [            \"If the user says payment reference or payment reference number, use paymentReferenceNumber = '<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",            \"If the user says payment id or plain payment <number> without reference wording, use paymentId = <PAYMENT_ID_FROM_USER>\",            \"sortBy=paymentReferenceNumber:asc\",            \"limit=20\"          ],          \"notes\": \"Supported lookup. serviceLevelCode and deliveryChannelCode are returned fields, not filters. Explicit payment reference wording must use paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20; do not use paymentDate sorting or unsupported-response fallback.\"        },        {          \"name\": \"paymentsByPprOrFile\",          \"description\": \"Retrieve disbursement payments for a payment file or PPR, including file and PPR status details.\",          \"when\": \"User asks for payments within a payment file or payment process request and wants payment-processing context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the filter expression that matches the identifier the user actually provides. For external bank account for all payees selected in a PPR, use the locked field rule with externalBankAccount.bankAccountName,payeePartyName and paymentDate:asc.\"        },        {          \"name\": \"virtualCardPaymentsByAliasAndDate\",          \"description\": \"Retrieve virtual card payments by RCN alias in a date window.\",          \"when\": \"User asks how many payments were paid or are in process using a specific virtual card alias or RCN.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\",            \"paymentMode.lookupCode\",            \"paymentInstrument.paymentInstrumentAlias\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"paymentInstrument.paymentInstrumentAlias='<RCN_ALIAS_FROM_USER>'\",            \"paymentDate>=<START_DATE>\",            \"paymentDate<=<END_DATE>\"          ],          \"notes\": \"Use this payment slice together with document-level shapes when the user also wants invoice or installment detail.\"        },        {          \"name\": \"virtualCardProgramReconciliation\",          \"description\": \"Retrieve virtual card payments where the virtual card program and payment instrument alias indicate a program mismatch or cross-program usage check.\",          \"when\": \"User asks for virtual card payments where the program name and instrument alias indicate a cross-program or mismatch scenario.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",            \"paymentInstrument.paymentInstrumentAlias\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName='<VCARD_PROGRAM_NAME_FROM_USER>'\",            \"paymentInstrument.paymentInstrumentAlias like '%<RCN_ALIAS_FRAGMENT_FROM_USER>%'\"          ],          \"notes\": \"Use a contains-style filter on the payment instrument alias when the user gives a program fragment rather than the full alias.\"        },        {          \"name\": \"manualHighValuePaymentReview\",          \"description\": \"Retrieve manual or operational-risk payments with business-unit, status, bank-account, and reconciliation context.\",          \"when\": \"User asks for manual electronic payments, user-selected payments, or high-value payment review scoped by business unit, supplier, date range, amount threshold, or reconciliation state.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentBusinessUnit\",            \"paymentMethod.paymentMethodName\",            \"paymentMode.lookupCode\",            \"disbursementBankAccount.name\",            \"paymentStatus.lookupCode\",            \"paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\"          ],          \"extraFilterExpressions\": [            \"paymentBusinessUnit='<BUSINESS_UNIT_NAME_FROM_USER>'\",            \"payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>'\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"paymentDate>=<START_DATE_FROM_USER>\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"payablesPayment.reconciledFlag=false\",            \"paymentMethod.paymentMethodName='<PAYMENT_METHOD_NAME_FROM_USER>' or paymentMode.lookupCode='<PAYMENT_MODE_CODE_FROM_USER>'\"          ],          \"notes\": \"Use this disbursement BV for Payments-flow operational review because it preserves bank account, payment file, PPR, and AP payment context in one fetch.\"        },        {          \"name\": \"highValuePaymentsWithSupplierDetails\",          \"description\": \"Retrieve payments above a requested amount threshold with supplier/payee and payment logistics details.\",          \"when\": \"User asks for all payments over a threshold with supplier details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"supplierSite.supplier.supplierType.meaning\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"paymentStatus.meaning\",            \"disbursementBankAccount.name\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentAmount > <AMOUNT_THRESHOLD_FROM_USER>\"          ],          \"notes\": \"Use this disbursement payment shape for generic high-value payment lists with supplier details. Do not mark the request unsupported; default to limit 20 and sort by paymentAmount desc when supported.\"        },        {          \"name\": \"paymentAgingAndFollowUp\",          \"description\": \"Retrieve aged unreconciled, stopped, voided, or action-targeted payments for follow-up.\",          \"when\": \"User asks for unreconciled payments older than a threshold, stop-initiated payments older than a threshold, or identifies a payment number for void, reissue, or remittance follow-up.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.lookupCode\",            \"paymentStatus.meaning\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"payablesPayment.reconciledFlag\",            \"stopDate\",            \"voidDate\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPayment.paymentNumber=<PAYMENT_NUMBER_FROM_USER>\",            \"payablesPayment.reconciledFlag=false\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"paymentStatus.lookupCode='<PAYMENT_STATUS_CODE_FROM_USER>' or paymentStatus.meaning='<PAYMENT_STATUS_MEANING_FROM_USER>'\",            \"payablesPayment.paymentStatus.lookupCode='<AP_PAYMENT_STATUS_CODE_FROM_USER>'\",            \"stopDate<=<END_DATE_FROM_USER>\",            \"voidDate<=<END_DATE_FROM_USER>\"          ],          \"notes\": \"For action-oriented requests, use the AP payment number as the keyed lookup and return enough payment, file, and PPR context for the next routing step.\"        },        {          \"name\": \"crossShapePaymentStatusFollowUp\",          \"description\": \"Retrieve detailed payment status, payment-file, and PPR context once a payment id has been identified from another shape.\",          \"when\": \"User starts from an expense report, refund reference, invoice, or document and then wants the payment status and payment logistics for the matched payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"payablesPayment.reconciledFlag\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_UPSTREAM_SHAPE>\"          ],          \"notes\": \"Use paymentRunInstallments first when the user identifies the payment through an expense report number, refund reference, or invoice reference instead of a payment identifier.\"        },        {          \"name\": \"pprOrDisbursementExceptionReview\",          \"description\": \"Retrieve disbursement-side payments for exception review when the user asks for transmission failures, payment-file scoped issues, or bank-account scoped payment monitoring.\",          \"when\": \"User asks for payment execution exceptions, payment-file monitoring, disbursement bank account monitoring, or payment slices tied to PPR/process status.\",          \"fieldsToReturn\": [            \"payablesPayment.paymentNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"supplier.name\",            \"disbursementBankAccount.name\",            \"paymentMethod.paymentMethodName\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPayment.reconciledFlag\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS','VALIDATION_FAILED','FAILED_PAYMENT_VALIDATION','MISSING RATES','MISSING_X_RATES','ORA_APPROVAL_ERROR','TERMINATED')\",            \"disbursementBankAccount.name='<BANK_ACCOUNT_NAME_FROM_USER>'\",            \"paymentDate>=<START_DATE_FROM_USER>\",            \"paymentDate<=<END_DATE_FROM_USER>\",            \"paymentAmount>=<AMOUNT_THRESHOLD_FROM_USER>\",            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this BV for disbursement-oriented monitoring and exception screening. If the request needs comparison with another shape, instruction metadata, or exception detail enrichment, route to an extraction shape.\"        },        {          \"name\": \"pprPendingReviewPaymentReview\",          \"description\": \"Retrieve proposed disbursement payments for PPRs that are in pending review status, with optional filtering by PPR ID or PPR Name.\",          \"when\": \"User explicitly asks for proposed disbursement payments in PPRs that are pending review, pending proposed payment review, or awaiting review. Do not use for the generic request Review proposed payments for all PPRs.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\",            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use only when pending-review wording is explicit. For generic Review proposed payments for all PPRs, do not use disbursementPayments; use paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter.\"        },        {          \"name\": \"recentExternalBankAccountChangeRiskReview\",          \"description\": \"Retrieve payments whose supplier external bank account was recently updated, sorted by most recently updated first, for fraud-risk review.\",          \"when\": \"User asks for payments where the supplier's bank account was recently changed, with no supplier filter, and wants the most recently updated records first.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.maskedIban\",            \"externalBankAccount.maskedAccountNumber\",            \"externalBankAccount.eftSwiftCode\",            \"externalBankAccount.countryCode\",            \"externalBankAccount.timeCreated\",            \"externalBankAccount.timeUpdated\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"externalBankAccount.timeUpdated>=<TODAY_MINUS_30_DAYS>\",            \"externalBankAccount.timeUpdated >= '<CURRENT_DATE_MINUS_30_DAYS_T00:00:00Z>'\",            \"sortBy: paymentDate:desc\",            \"limit: 20\"          ],          \"notes\": \"Do not require a supplier filter. Do not Sort by externalBankAccount.timeUpdated as sorting is not supported on this field.Sort by paymentDate:desc Use this as a fraud-risk review slice for recent external bank account changes.\"        },        {          \"name\": \"pprPendingReviewPaymentReviewAll\",          \"description\": \"Retrieve proposed disbursement payments for all PPRs that are in pending review status.\",          \"when\": \"User explicitly asks for proposed disbursement payments in PPRs that are pending review, pending proposed payment review, or awaiting review. Do not use for the generic request Review proposed payments for all PPRs.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\"          ],          \"notes\": \"Use only when pending-review wording is explicit. For generic Review proposed payments for all PPRs, do not use disbursementPayments; use paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter.\"        },        {          \"name\": \"paymentsInPaymentFileMissingLegalEntity\",          \"description\": \"Retrieve payments in a payment file where legal entity is missing.\",          \"when\": \"User asks for payment-file payments with missing legal entity or asks why payments in a file are missing legal entity details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"legalEntity.legalEntityId\",            \"legalEntity.name\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"legalEntity.legalEntityId=null\"          ],          \"notes\": \"Taxpayer ID is not currently in scope for this inquiry.\"        },        {          \"name\": \"voidedJpmAcknowledgementLinkedPayments\",          \"description\": \"Retrieve voided payments linked to JPM acknowledgement files.\",          \"when\": \"User asks for voided JPM acknowledgement-linked payments or payments rejected through JPM acknowledgement context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentMethod.paymentMethodName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"disbursementBankAccount.bank.name\",            \"voidDate\",            \"voidReason\",            \"payablesPayment.paymentStatus.lookupCode\",            \"payablesPayment.paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.paymentSystem.paymentSystemName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"disbursementInboundFile.id is not null\",            \"payablesPayment.paymentStatus.lookupCode='VOIDED'\",            \"voidDate is not null\",            \"disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'\"          ],          \"notes\": \"Use explicit inbound-file linkage and payment system name. For voided-payment status, use the AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`; do not use disbursement-side `paymentStatus.lookupCode='VOID'` for this use case. Apply user-provided date windows to `voidDate`. Do not infer L1/L2/L3 file classification from file names.\"        },        {          \"name\": \"paymentFileBankAcknowledgementError\",          \"description\": \"Retrieve backend-safe bank-provided BEP error code and message for payments in a specific payment file.\",          \"when\": \"User asks for the bank-provided acknowledgement error, error code, or error message for a payment file and does not require invoice/installment columns.\",          \"fieldsToReturn\": [            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"payablesPaymentFile.paymentInstructionId\",            \"disbursementInboundFile.fileName\",            \"disbursementInboundFile.inboundFileProcessingStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"bepErrorCode!=null or bepErrorMessageText!=null\"          ],          \"notes\": \"Use this driver before paymentRunInstallments BV for payment-file bank-error questions because BEP fields are top-level on disbursementPayments. If the user asks for invoice or installment columns, use paymentRunInstallmentsExtraction instead.\"        },        {          \"name\": \"paymentFileContainedPayments\",          \"description\": \"List payment rows contained in a specific payment file using the payment-level disbursement view.\",          \"when\": \"User asks which payments are in a payment file or wants payment reference, payee, amount, method, status, and disbursement bank account for payments under one file.\",          \"fieldsToReturn\": [            \"payablesPaymentFile.paymentInstructionId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeeName\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatus.meaning\",            \"paymentMethod.paymentMethodName\",            \"disbursementBankAccount.name\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this driver instead of the `payablesDisbursementPayments` child accessor on disbursementPaymentInstructions. If invoice-level detail is requested, use paymentRunInstallmentsExtraction.\"        }      ],      \"additionalInstructions\": [        \"Use the canonical resource `payablesDisbursementPayments`, but request the richer `disbursementPayments` named view when the question needs service-level, delivery-channel, bank-branch, payment-format, virtual-card, payment-file, AP-payment, or PPR accessor details.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases such as `ApChecksAll` or unsupported shortcut fields.\",        \"For supplier-focused bank-account questions, filter with `payeePartyName` or `payablesPayment.supplierName` plus `paymentDate`, and return the surrounding logistics context from `disbursementBankAccount`, `disbursementBankAccount.bank`, and `disbursementBankAccount.bankBranch`.\",        \"For payment file format questions, read from `accountPaymentProfile.systemPaymentProfile.paymentFormat` and related processing/profile accessors rather than inferring from payment method alone.\",        \"For service-level and delivery-channel questions, return `serviceLevelCode` and `deliveryChannelCode` together with related payment-format or processing metadata when available; do not invent banking-standard descriptions not returned by the API.\",        \"For virtual card questions, combine `paymentMode.lookupCode='VIRTUAL_CARD'` with `paymentInstrument.paymentInstrumentAlias` and, when relevant, `digitalPaymentAccount.virtualCardProgram.vcardProgramName`.\",        \"For expense-report or refund-status questions, locate the payment id through paymentRunInstallments first, then use this shape to return payment status, payment file, reconciliation, and PPR context.\",        \"When the user also needs invoice or installment detail, use this shape to identify matching payment ids and then hand off to the corresponding document-level shape instead of overloading this BV with unsupported document attributes.\",        \"For payment-monitoring requests, return payment, supplier, disbursement bank account, payment method, and process status fields together so downstream exception handling or bank follow-up can be done without another fetch.\",        \"For Payments-flow operational review and payment-number follow-up, prefer this BV over `payablesPaymentDetails` because it preserves disbursement bank account, payment file, PPR, and AP payment context together.\",        \"For stop-initiated, failed, or rejected-payment review, surface both payment-level status and PPR/process status when available so the user can distinguish payment state from process state.\",        \"For missing legal entity in a payment file, filter `payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID>` and `legalEntity.legalEntityId=null`; Taxpayer ID is not in current scope.\",        \"For JPM acknowledgement-linked voided payments, require `disbursementInboundFile.id is not null`, AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`, `voidDate is not null`, and `disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'`; apply requested date windows to `voidDate` and do not infer unsupported L-level acknowledgement classifications.\",        \"If the request requires combining disbursement payments with supplier defaults, instruction metadata, or separate exception/error sources, do not force a single-BV answer; use an extraction shape instead.\",        \"When user asks for Bank acount/Bank branch/Country details sort by paymentDate:desc. Do not use bepErrorCode to sort in all cases\",        \"Bank branch/country questions for a specific payment id or for installments under a PPR are supported by disbursementPayments; do not classify them as unsupported.\",        \"For numeric phrasing like 'payment 2575', treat the number as paymentId unless the user explicitly says payment reference number.\",        \"For service-level and delivery-channel questions by payment reference, filter with paymentReferenceNumber = '<value>', sort by paymentReferenceNumber:asc before limit 20, and do not use paymentDate sorting. Explicit payment reference wording takes precedence over the generic numeric-payment rule.\",        \"Service-level and delivery-channel by payment reference is supported by this BV. Return serviceLevelCode and deliveryChannelCode, filter paymentReferenceNumber, sort paymentReferenceNumber ascending, and do not answer with an unsupported template.\",        \"For external bank account for all payees selected in a PPR, use fields externalBankAccount.bankAccountName,payeePartyName, filter paymentsPayablesPaymentProcessRequest.paymentProcessRequestName, sort paymentDate:asc, and limit 20. Do not add paymentProcessRequestId or use paymentDate:desc unless explicitly requested.\",        \"Do not use disbursementPayments for the generic request 'Review proposed payments for all PPRs'. That request requires paymentRunInstallmentSummaries AV plus paymentRunInstallments BV with no PENDING_REVIEW filter. Use disbursementPayments only when the user explicitly asks for disbursement-payment logistics or pending-review-only payments.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\",        \"filters\": \"If the matching rule provides filters, apply them and replace placeholders with user-provided values.\",        \"sortAndLimit\": \"If the matching rule provides sortBy or limit, apply them unless the user explicitly asks for a different sort or limit.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"List the 'External Bank Account' for all payees selected in PPR PPR05\"          ],          \"queryType\": \"BV\",          \"fields\": \"externalBankAccount.bankAccountName,payeePartyName\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName = '<PPR_NAME_FROM_USER>'\",          \"sortBy\": \"paymentDate:asc\",          \"limit\": 20,          \"notes\": \"For external bank account for all payees selected in a PPR, return only externalBankAccount.bankAccountName and payeePartyName unless the user asks for more fields. Sort paymentDate ascending and do not switch to paymentDate descending unless the user asks for latest/recent payments.\"        },        {          \"questionExamples\": [            \"Show are service level codes and delivery channels for payment reference 2562\",            \"Show service level codes and delivery channels for payment reference <PAYMENT_REFERENCE_NUMBER>\"          ],          \"queryType\": \"BV\",          \"fields\": \"serviceLevelCode,deliveryChannelCode\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentReferenceNumber = '<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",          \"sortBy\": \"paymentReferenceNumber:asc\",          \"limit\": 20,          \"notes\": \"This lookup is supported. serviceLevelCode and deliveryChannelCode are output fields, not filters. If the user says payment reference or payment reference number, filter by paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20 and do not use paymentDate sorting.\"        },        {          \"questionExamples\": [            \"Show me payments where the supplier's bank account was recently changed\"          ],          \"queryType\": \"BV\",          \"fields\": \"paymentId,paymentReferenceNumber,paymentDate,payeePartyName,payablesPayment.supplierName,paymentAmount,paymentCurrencyCode,paymentBusinessUnit,externalBankAccount.bankAccountName,externalBankAccount.maskedIban,externalBankAccount.maskedAccountNumber,externalBankAccount.eftSwiftCode,externalBankAccount.countryCode,externalBankAccount.timeCreated,externalBankAccount.timeUpdated,paymentStatus.meaning,payablesPaymentFile.paymentInstructionId,paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"externalBankAccount.timeUpdated >= '<CURRENT_DATE_MINUS_30_DAYS_T00:00:00Z>'\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 20,          \"notes\": \"Recently changed supplier bank account means externalBankAccount.timeUpdated in the last 30 days, formatted as UTC midnight, sorted by paymentDate desc.\"        },        {          \"questionExamples\": [            \"Show me the bank branch and country for Installments under PPR gapr_ppr_test_4\"          ],          \"queryType\": \"BV\",          \"fields\": \"disbursementBankAccount.bankBranch.name,disbursementBankAccount.bank.countryCode\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPayments\",          \"filters\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName = '<PPR_NAME_FROM_USER>'\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 20,          \"notes\": \"For bank branch and country for installments under a PPR, sort paymentDate desc before applying limit 20 so latest payments are returned.\"        },        {          \"questionExamples\": [            \"What was the bank branch and bank for the payment with paymentNumber 2345\"          ],          \"queryType\": \"BV\",          \"fields\": \"disbursementBankAccount.bank.name,disbursementBankAccount.bankBranch.name\",          \"fieldOrderLocked\": true        }      ]    },    \"disbursementPaymentsExtraction\": {      \"key\": \"disbursementPaymentsExtraction\",      \"name\": \"disbursementPaymentsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesDisbursementPayment\",      \"description\": \"Runtime extraction wrapper for the disbursementPayments BV. Business view for disbursement payment retrieval in Funds Disbursement. Use this shape primarily for summary queries about payment activity, such as counts and amounts by payment status, payment file, PPR, payment mode, bank account, service level, or virtual-card program, before drilling into individual payments.\",      \"exampleQuestions\": [        \"What bank account was used to pay Supplier X on 2026-01-15?\",        \"What payment file format was used for payment 14876?\",        \"What was the bank branch and bank for payment 14876?\",        \"What service level and delivery channel were used for payment 14876?\",        \"How many virtual card payments using alias RCN-7781 were there within the last two days by payment status?\",        \"How many virtual card payments were there for program MC HSBC using aliases that contain MC Citibank by payment status?\",        \"What is the total payment amount in payment file 12345 by payment status, with PPR details?\",        \"What is the payment status for expense report EXP-2025-001234 submitted by John Smith?\",        \"What is the status of the refund payment for credit memo CM-2025-001?\"      ],      \"fields\": {        \"fields\": [          \"bepErrorCode\",          \"bepErrorMessageText\",          \"paymentProfileSystemName\",          \"paymentProfileAccountName\",          \"paymentReferenceNumber\",          \"bankAssignedReferenceCode\",          \"uniqueRemittanceIdentifier\",          \"paymentReasonComments\",          \"timeCreated\",          \"updatedBy\",          \"timeUpdated\",          \"createdBy\",          \"paymentId\",          \"paymentAmount\",          \"paymentCurrencyCode\",          \"paymentDate\",          \"payeeName\",          \"payeePartyName\",          \"paymentBusinessUnit\",          \"paymentProcessRequestName\",          \"paymentCompleteFlag\",          \"bankStatusCode\",          \"paymentSystemResponseIdentifier\",          \"issuerAuthorizationReference\",          \"acquirerTransactionReference\",          \"issuerProcessingTimestamp\",          \"voidDate\",          \"voidReason\",          \"stopDate\",          \"stopRequestReason\",          \"paymentDeclarationAmount\",          \"bankChargeAmount\",          \"uriCheckDigit\",          \"maturityDate\",          \"remittanceMessageOne\",          \"remittanceMessageTwo\",          \"remittanceMessageThree\",          \"paymentTextMessageOne\",          \"paymentTextMessageTwo\",          \"paymentTextMessageThree\",          \"stopRequestPlacedFlag\",          \"anticipatedValueDate\",          \"declarationCurrencyCode\",          \"invoicePayeePartyName\",          \"invoiceDueDate\",          \"paperDocumentNumber\",          \"serviceLevelCode\",          \"deliveryChannelCode\",          \"stopRequestPlacedBy\",          \"paymentStatusLookupCode\",          \"paymentStatusMeaning\",          \"fundsStatusLookupCode\",          \"fundsStatusMeaning\",          \"paymentFunctionLookupCode\",          \"paymentFunctionMeaning\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"paymentMethodCode\",          \"paymentMethodName\",          \"paymentInstrumentAlias\",          \"disbursementBankAccountName\",          \"bankName\",          \"countryCode\",          \"bankBranchName\",          \"branchNumber\",          \"bankAccountName\",          \"maskedAccountNumber\",          \"maskedIban\",          \"externalBankAccountCountryCode\",          \"vcardProgramName\",          \"paymentProfileId\",          \"paymentProfileName\",          \"processingTypeMeaning\",          \"processingTypeLookupCode\",          \"paymentFormatCode\",          \"formatName\",          \"formatTemplateCode\",          \"formatTypeName\",          \"paymentInstructionId\",          \"paymentRequestName\",          \"paymentFileProcessingStatusLookupCode\",          \"paymentFileProcessingStatusMeaning\",          \"acknowledgementFileName\",          \"acknowledgementFileCreatedOn\",          \"acknowledgementErrorMessage\",          \"acknowledgementPaymentSystemName\",          \"acknowledgementStatusLookupCode\",          \"acknowledgementStatusMeaning\",          \"paymentProcessRequestId\",          \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestStatusMeaning\",          \"paymentInitiationMeaning\",          \"legalEntityId\",          \"legalEntityName\",          \"supplierSiteName\",          \"supplierId\",          \"supplierTypeLookupCode\",          \"supplierTypeMeaning\",          \"payablesPaymentPaymentId\",          \"paymentNumber\",          \"supplierName\",          \"remitToSupplierName\",          \"remitToAddressName\",          \"payablesPaymentPaymentDate\",          \"payablesPaymentPaymentAmount\",          \"paymentCurrencyCurrencyCode\",          \"payablesPaymentPaymentStatusLookupCode\",          \"payablesPaymentPaymentStatusMeaning\",          \"reconciledFlag\",          \"clearingDate\",          \"systemProfileCode\"        ],        \"fieldAlias\": {          \"BEP Error Code\": \"bepErrorCode\",          \"BEP Error Message\": \"bepErrorMessageText\",          \"Payment Profile System\": \"paymentProfileSystemName\",          \"Payment Profile Account\": \"paymentProfileAccountName\",          \"Payment ID\": \"paymentId\",          \"Bank Assigned Reference\": \"bankAssignedReferenceCode\",          \"Unique Remittance Identifier\": \"uniqueRemittanceIdentifier\",          \"Payment Reason Comments\": \"paymentReasonComments\",          \"Created On\": \"timeCreated\",          \"Created By\": \"createdBy\",          \"Last Updated On\": \"timeUpdated\",          \"Last Updated By\": \"updatedBy\",          \"Payment Reference Number\": \"paymentReferenceNumber\",          \"Payment Date\": \"paymentDate\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Currency\": \"paymentCurrencyCode\",          \"Payee\": \"payeeName\",          \"Payee Party Name\": \"payeePartyName\",          \"Invoice Payee Party Name\": \"invoicePayeePartyName\",          \"Payment Business Unit\": \"paymentBusinessUnit\",          \"Payment Process Request\": \"paymentProcessRequestName\",          \"Invoice Due Date\": \"invoiceDueDate\",          \"Maturity Date\": \"maturityDate\",          \"Anticipated Value Date\": \"anticipatedValueDate\",          \"Payment Complete\": \"paymentCompleteFlag\",          \"Service Level Code\": \"serviceLevelCode\",          \"Delivery Channel Code\": \"deliveryChannelCode\",          \"Bank Status Code\": \"bankStatusCode\",          \"Payment System Response Identifier\": \"paymentSystemResponseIdentifier\",          \"Issuer Authorization Reference\": \"issuerAuthorizationReference\",          \"Acquirer Transaction Reference\": \"acquirerTransactionReference\",          \"Issuer Processing Timestamp\": \"issuerProcessingTimestamp\",          \"Void Date\": \"voidDate\",          \"Void Reason\": \"voidReason\",          \"Stop Date\": \"stopDate\",          \"Stop Request Reason\": \"stopRequestReason\",          \"Payment Declaration Amount\": \"paymentDeclarationAmount\",          \"Bank Charge Amount\": \"bankChargeAmount\",          \"URI Check Digit\": \"uriCheckDigit\",          \"Remittance Message 1\": \"remittanceMessageOne\",          \"Remittance Message 2\": \"remittanceMessageTwo\",          \"Remittance Message 3\": \"remittanceMessageThree\",          \"Payment Text Message 1\": \"paymentTextMessageOne\",          \"Payment Text Message 2\": \"paymentTextMessageTwo\",          \"Payment Text Message 3\": \"paymentTextMessageThree\",          \"Stop Request Placed\": \"stopRequestPlacedFlag\",          \"Declaration Currency\": \"declarationCurrencyCode\",          \"Paper Document Number\": \"paperDocumentNumber\",          \"Stop Request Placed By\": \"stopRequestPlacedBy\",          \"Payment Status Code\": \"paymentStatusLookupCode\",          \"Payment Status\": \"paymentStatusMeaning\",          \"Funds Status Code\": \"fundsStatusLookupCode\",          \"Funds Status\": \"fundsStatusMeaning\",          \"Payment Function Code\": \"paymentFunctionLookupCode\",          \"Payment Function\": \"paymentFunctionMeaning\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Payment Method Code\": \"paymentMethodCode\",          \"Payment Method\": \"paymentMethodName\",          \"Payment Instrument Alias\": \"paymentInstrumentAlias\",          \"Disbursement Bank Account\": \"disbursementBankAccountName\",          \"Disbursement Bank\": \"bankName\",          \"Disbursement Bank Country\": \"countryCode\",          \"Disbursement Bank Branch\": \"bankBranchName\",          \"Disbursement Bank Branch Number\": \"branchNumber\",          \"External Bank Account\": \"bankAccountName\",          \"External Bank Account Number\": \"maskedAccountNumber\",          \"External IBAN\": \"maskedIban\",          \"External Bank Country\": \"externalBankAccountCountryCode\",          \"Virtual Card Program\": \"vcardProgramName\",          \"Payment Profile ID\": \"paymentProfileId\",          \"Payment Profile Name\": \"paymentProfileName\",          \"Processing Type\": \"processingTypeMeaning\",          \"Processing Type Code\": \"processingTypeLookupCode\",          \"Payment Format Code\": \"paymentFormatCode\",          \"Payment Format Name\": \"formatName\",          \"Payment Format Template\": \"formatTemplateCode\",          \"Format Type\": \"formatTypeName\",          \"Payment File ID\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Payment File Request Name\": \"paymentRequestName\",          \"Payment File Status Code\": \"paymentFileProcessingStatusLookupCode\",          \"Payment File Status\": \"paymentFileProcessingStatusMeaning\",          \"Acknowledgement File Name\": \"acknowledgementFileName\",          \"Acknowledgement File Created On\": \"acknowledgementFileCreatedOn\",          \"Acknowledgement Error Message\": \"acknowledgementErrorMessage\",          \"Acknowledgement Payment System\": \"acknowledgementPaymentSystemName\",          \"Acknowledgement Status Code\": \"acknowledgementStatusLookupCode\",          \"Acknowledgement Status\": \"acknowledgementStatusMeaning\",          \"PPR ID\": \"paymentProcessRequestId\",          \"PPR Name\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"PPR Status Code\": \"paymentProcessRequestStatusLookupCode\",          \"PPR Status\": \"paymentProcessRequestStatusMeaning\",          \"PPR Initiation\": \"paymentInitiationMeaning\",          \"Legal Entity ID\": \"legalEntityId\",          \"Legal Entity\": \"legalEntityName\",          \"Supplier Site\": \"supplierSiteName\",          \"Supplier ID\": \"supplierId\",          \"Supplier Type Code\": \"supplierTypeLookupCode\",          \"Supplier Type\": \"supplierTypeMeaning\",          \"AP Payment ID\": \"payablesPaymentPaymentId\",          \"AP Payment Number\": \"paymentNumber\",          \"AP Supplier Name\": \"supplierName\",          \"Remit-To Supplier\": \"remitToSupplierName\",          \"Remit-To Address\": \"remitToAddressName\",          \"AP Payment Date\": \"payablesPaymentPaymentDate\",          \"AP Payment Amount\": \"payablesPaymentPaymentAmount\",          \"AP Payment Currency\": \"paymentCurrencyCurrencyCode\",          \"AP Payment Status Code\": \"payablesPaymentPaymentStatusLookupCode\",          \"AP Payment Status\": \"payablesPaymentPaymentStatusMeaning\",          \"Reconciled\": \"reconciledFlag\",          \"Clearing Date\": \"clearingDate\"        }      },      \"supportedFilters\": [        {          \"name\": \"paymentId\",          \"attribute\": \"paymentId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an internal disbursement payment identifier.\",          \"valueFromUser\": \"Payment ID\"        },        {          \"name\": \"paymentReferenceNumber\",          \"attribute\": \"paymentReferenceNumber\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payment reference number rather than the internal payment id.\",          \"valueFromUser\": \"Payment Reference Number\"        },        {          \"name\": \"paymentDate\",          \"attribute\": \"paymentDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use for payment-date filters and date windows.\",          \"valueFromUser\": \"Payment Date or date range\"        },        {          \"name\": \"payeePartyName\",          \"attribute\": \"payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user names the payee or supplier in payment logistics questions.\",          \"valueFromUser\": \"Payee Party Name\"        },        {          \"name\": \"payablesPayment.supplierName\",          \"attribute\": \"payablesPayment.supplierName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the supplier name is available through the AP payment accessor.\",          \"valueFromUser\": \"AP Supplier Name\"        },        {          \"name\": \"paymentBusinessUnit\",          \"attribute\": \"paymentBusinessUnit\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payments by business unit.\",          \"valueFromUser\": \"Payment Business Unit\"        },        {          \"name\": \"payablesPaymentFile.paymentInstructionId\",          \"attribute\": \"payablesPaymentFile.paymentInstructionId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment file identifier.\",          \"valueFromUser\": \"Payment File ID\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request id.\",          \"valueFromUser\": \"PPR ID\"        },        {          \"name\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"attribute\": \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a payment process request name.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"paymentStatus.lookupCode\",          \"attribute\": \"paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides or requests a specific payment status code.\",          \"valueFromUser\": \"Payment Status Code\"        },        {          \"name\": \"paymentStatus.meaning\",          \"attribute\": \"paymentStatus.meaning\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user gives the display meaning of the payment status.\",          \"valueFromUser\": \"Payment Status\"        },        {          \"name\": \"payablesPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use AP checks-backed status `VOIDED` when the user asks for voided payments, including JPM acknowledgement-linked voided-payment inquiries. Do not use disbursement-side paymentStatus.lookupCode='VOID' for voided-payment status.\",          \"valueFromUser\": \"AP Payment Status Code\"        },        {          \"name\": \"paymentMethod.code\",          \"attribute\": \"paymentMethod.code\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method code.\",          \"valueFromUser\": \"Payment Method Code\"        },        {          \"name\": \"paymentMethod.paymentMethodName\",          \"attribute\": \"paymentMethod.paymentMethodName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method name.\",          \"valueFromUser\": \"Payment Method\"        },        {          \"name\": \"paymentMode.lookupCode\",          \"attribute\": \"paymentMode.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [            \"VIRTUAL_CARD\"          ],          \"usage\": \"Use when the user asks about virtual card payments or other specific payment modes.\",          \"valueFromUser\": \"Payment Mode Code\"        },        {          \"name\": \"paymentInstrument.paymentInstrumentAlias\",          \"attribute\": \"paymentInstrument.paymentInstrumentAlias\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides an RCN or payment instrument alias.\",          \"valueFromUser\": \"Payment Instrument Alias\"        },        {          \"name\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"attribute\": \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by virtual card program name.\",          \"valueFromUser\": \"Virtual Card Program\"        },        {          \"name\": \"serviceLevelCode\",          \"attribute\": \"serviceLevelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment service levels.\",          \"valueFromUser\": \"Service Level Code\"        },        {          \"name\": \"deliveryChannelCode\",          \"attribute\": \"deliveryChannelCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about payment delivery channels.\",          \"valueFromUser\": \"Delivery Channel Code\"        },        {          \"name\": \"disbursementBankAccount.name\",          \"attribute\": \"disbursementBankAccount.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks which disbursement bank account was used.\",          \"valueFromUser\": \"Disbursement Bank Account\"        },        {          \"name\": \"disbursementBankAccount.bank.name\",          \"attribute\": \"disbursementBankAccount.bank.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank name.\",          \"valueFromUser\": \"Disbursement Bank\"        },        {          \"name\": \"disbursementBankAccount.bankBranch.name\",          \"attribute\": \"disbursementBankAccount.bankBranch.name\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by disbursement bank branch name.\",          \"valueFromUser\": \"Disbursement Bank Branch\"        },        {          \"name\": \"externalBankAccount.countryCode\",          \"attribute\": \"externalBankAccount.countryCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for payee bank-country context.\",          \"valueFromUser\": \"External Bank Country\"        },        {          \"name\": \"invoiceDueDate\",          \"attribute\": \"invoiceDueDate\",          \"type\": \"date\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about invoice due dates tied to the payment.\",          \"valueFromUser\": \"Invoice Due Date or date range\"        },        {          \"name\": \"legalEntity.legalEntityId\",          \"attribute\": \"legalEntity.legalEntityId\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use legalEntity.legalEntityId is null when the user asks for payments in a payment file where legal entity is missing.\",          \"valueFromUser\": \"Legal Entity ID\"        },        {          \"name\": \"disbursementInboundFile.id\",          \"attribute\": \"disbursementInboundFile.id\",          \"type\": \"int64\",          \"possibleValues\": [],          \"usage\": \"Use is not null when the user asks for payments linked to an inbound acknowledgement file.\",          \"valueFromUser\": \"Acknowledgement File Id\"        },        {          \"name\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"attribute\": \"disbursementInboundFile.paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for acknowledgement-linked payments by payment system or bank such as JPM.\",          \"valueFromUser\": \"Acknowledgement Payment System\"        },        {          \"name\": \"payablesPayment.reconciledFlag\",          \"attribute\": \"payablesPayment.reconciledFlag\",          \"type\": \"boolean\",          \"possibleValues\": [            true,            false          ],          \"usage\": \"Use when the user asks whether matched payments are cleared or reconciled.\",          \"valueFromUser\": \"Reconciled\"        }      ],      \"dateFilterGuidance\": null,      \"extractionQuery\": {        \"viewQueries\": {          \"disbursementPayments\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"PayablesDisbursementPayment\",            \"view\": \"disbursementPayments\",            \"fieldAliases\": {              \"bepErrorCode\": \"bepErrorCode\",              \"bepErrorMessageText\": \"bepErrorMessageText\",              \"paymentProfileSystemName\": \"paymentProfileSystemName\",              \"paymentProfileAccountName\": \"paymentProfileAccountName\",              \"paymentReferenceNumber\": \"paymentReferenceNumber\",              \"bankAssignedReferenceCode\": \"bankAssignedReferenceCode\",              \"uniqueRemittanceIdentifier\": \"uniqueRemittanceIdentifier\",              \"paymentReasonComments\": \"paymentReasonComments\",              \"timeCreated\": \"timeCreated\",              \"updatedBy\": \"updatedBy\",              \"timeUpdated\": \"timeUpdated\",              \"createdBy\": \"createdBy\",              \"paymentId\": \"paymentId\",              \"paymentAmount\": \"paymentAmount\",              \"paymentCurrencyCode\": \"paymentCurrencyCode\",              \"paymentDate\": \"paymentDate\",              \"payeeName\": \"payeeName\",              \"payeePartyName\": \"payeePartyName\",              \"paymentBusinessUnit\": \"paymentBusinessUnit\",              \"paymentProcessRequestName\": \"paymentProcessRequestName\",              \"paymentCompleteFlag\": \"paymentCompleteFlag\",              \"bankStatusCode\": \"bankStatusCode\",              \"paymentSystemResponseIdentifier\": \"paymentSystemResponseIdentifier\",              \"issuerAuthorizationReference\": \"issuerAuthorizationReference\",              \"acquirerTransactionReference\": \"acquirerTransactionReference\",              \"issuerProcessingTimestamp\": \"issuerProcessingTimestamp\",              \"voidDate\": \"voidDate\",              \"voidReason\": \"voidReason\",              \"stopDate\": \"stopDate\",              \"stopRequestReason\": \"stopRequestReason\",              \"paymentDeclarationAmount\": \"paymentDeclarationAmount\",              \"bankChargeAmount\": \"bankChargeAmount\",              \"uriCheckDigit\": \"uriCheckDigit\",              \"maturityDate\": \"maturityDate\",              \"remittanceMessageOne\": \"remittanceMessageOne\",              \"remittanceMessageTwo\": \"remittanceMessageTwo\",              \"remittanceMessageThree\": \"remittanceMessageThree\",              \"paymentTextMessageOne\": \"paymentTextMessageOne\",              \"paymentTextMessageTwo\": \"paymentTextMessageTwo\",              \"paymentTextMessageThree\": \"paymentTextMessageThree\",              \"stopRequestPlacedFlag\": \"stopRequestPlacedFlag\",              \"anticipatedValueDate\": \"anticipatedValueDate\",              \"declarationCurrencyCode\": \"declarationCurrencyCode\",              \"invoicePayeePartyName\": \"invoicePayeePartyName\",              \"invoiceDueDate\": \"invoiceDueDate\",              \"paperDocumentNumber\": \"paperDocumentNumber\",              \"serviceLevelCode\": \"serviceLevelCode\",              \"deliveryChannelCode\": \"deliveryChannelCode\",              \"stopRequestPlacedBy\": \"stopRequestPlacedBy\",              \"paymentStatus.lookupCode\": \"paymentStatusLookupCode\",              \"paymentStatus.meaning\": \"paymentStatusMeaning\",              \"fundsStatus.lookupCode\": \"fundsStatusLookupCode\",              \"fundsStatus.meaning\": \"fundsStatusMeaning\",              \"paymentFunction.lookupCode\": \"paymentFunctionLookupCode\",              \"paymentFunction.meaning\": \"paymentFunctionMeaning\",              \"paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"paymentMode.meaning\": \"paymentModeMeaning\",              \"paymentMethod.code\": \"paymentMethodCode\",              \"paymentMethod.paymentMethodName\": \"paymentMethodName\",              \"paymentInstrument.paymentInstrumentAlias\": \"paymentInstrumentAlias\",              \"disbursementBankAccount.name\": \"disbursementBankAccountName\",              \"disbursementBankAccount.bank.name\": \"bankName\",              \"disbursementBankAccount.bank.countryCode\": \"countryCode\",              \"disbursementBankAccount.bankBranch.name\": \"bankBranchName\",              \"disbursementBankAccount.bankBranch.branchNumber\": \"branchNumber\",              \"externalBankAccount.bankAccountName\": \"bankAccountName\",              \"externalBankAccount.maskedAccountNumber\": \"maskedAccountNumber\",              \"externalBankAccount.maskedIban\": \"maskedIban\",              \"externalBankAccount.countryCode\": \"externalBankAccountCountryCode\",              \"digitalPaymentAccount.virtualCardProgram.vcardProgramName\": \"vcardProgramName\",              \"accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"accountPaymentProfile.systemPaymentProfile.processingType.meaning\": \"processingTypeMeaning\",              \"accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\": \"processingTypeLookupCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.paymentFormatCode\": \"paymentFormatCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatName\": \"formatName\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatTemplateCode\": \"formatTemplateCode\",              \"accountPaymentProfile.systemPaymentProfile.paymentFormat.formatType.formatTypeName\": \"formatTypeName\",              \"payablesPaymentFile.paymentInstructionId\": \"paymentInstructionId\",              \"payablesPaymentFile.paymentRequestName\": \"paymentRequestName\",              \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\": \"paymentFileProcessingStatusLookupCode\",              \"payablesPaymentFile.paymentFileProcessingStatus.meaning\": \"paymentFileProcessingStatusMeaning\",              \"disbursementInboundFile.fileName\": \"acknowledgementFileName\",              \"disbursementInboundFile.timeCreated\": \"acknowledgementFileCreatedOn\",              \"disbursementInboundFile.errorMessage\": \"acknowledgementErrorMessage\",              \"disbursementInboundFile.paymentSystem.paymentSystemName\": \"acknowledgementPaymentSystemName\",              \"disbursementInboundFile.inboundFileProcessingStatus.lookupCode\": \"acknowledgementStatusLookupCode\",              \"disbursementInboundFile.inboundFileProcessingStatus.meaning\": \"acknowledgementStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\": \"paymentProcessRequestId\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"paymentProcessRequestStatusLookupCode\",              \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"paymentProcessRequestStatusMeaning\",              \"paymentsPayablesPaymentProcessRequest.paymentInitiation.meaning\": \"paymentInitiationMeaning\",              \"legalEntity.legalEntityId\": \"legalEntityId\",              \"legalEntity.name\": \"legalEntityName\",              \"supplierSite.name\": \"supplierSiteName\",              \"supplierSite.supplier.supplierId\": \"supplierId\",              \"supplierSite.supplier.supplierType.lookupCode\": \"supplierTypeLookupCode\",              \"supplierSite.supplier.supplierType.meaning\": \"supplierTypeMeaning\",              \"payablesPayment.paymentId\": \"payablesPaymentPaymentId\",              \"payablesPayment.paymentNumber\": \"paymentNumber\",              \"payablesPayment.supplierName\": \"supplierName\",              \"payablesPayment.remitToSupplierName\": \"remitToSupplierName\",              \"payablesPayment.remitToAddressName\": \"remitToAddressName\",              \"payablesPayment.paymentDate\": \"payablesPaymentPaymentDate\",              \"payablesPayment.paymentAmount\": \"payablesPaymentPaymentAmount\",              \"payablesPayment.paymentCurrency.currencyCode\": \"paymentCurrencyCurrencyCode\",              \"payablesPayment.paymentStatus.lookupCode\": \"payablesPaymentPaymentStatusLookupCode\",              \"payablesPayment.paymentStatus.meaning\": \"payablesPaymentPaymentStatusMeaning\",              \"payablesPayment.reconciledFlag\": \"reconciledFlag\",              \"payablesPayment.clearingDate\": \"clearingDate\",              \"accountPaymentProfile.systemPaymentProfile.systemProfileCode\": \"systemProfileCode\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"paymentByIdOrReference\",          \"description\": \"Retrieve a specific disbursement payment by internal payment id or payment reference number.\",          \"when\": \"User asks for one payment, one payment reference, or one payment's processing details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER> or paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\"          ],          \"notes\": \"Prefer `paymentId` when the user clearly gives the internal payment id.\"        },        {          \"name\": \"supplierPaymentLogisticsByDate\",          \"description\": \"Retrieve bank-account and payment-logistics details for a supplier or payee on a payment date.\",          \"when\": \"User asks which bank account was used to pay a supplier on a given payment date or asks for surrounding logistics.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"disbursementBankAccountName\",            \"bankName\",            \"countryCode\",            \"bankBranchName\",            \"branchNumber\"          ],          \"extraFilterExpressions\": [            \"(payeePartyName='<SUPPLIER_NAME_FROM_USER>' or payablesPayment.supplierName='<SUPPLIER_NAME_FROM_USER>')\",            \"paymentDate=<PAYMENT_DATE_FROM_USER>\"          ],          \"notes\": \"Return bank account, bank, branch, and currency together so the answer includes the full logistics context.\"        },        {          \"name\": \"paymentFormatByPayment\",          \"description\": \"Retrieve the payment file format and related processing metadata for a specific payment.\",          \"when\": \"User asks what payment file format was used for a payment or asks for processing-option metadata.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentProfileName\",            \"systemProfileCode\",            \"processingTypeMeaning\",            \"paymentFormatCode\",            \"formatName\",            \"formatTemplateCode\",            \"formatTypeName\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"Use the payment-format accessor chain instead of trying to infer the format from payment method alone.\"        },        {          \"name\": \"bankRoutingByPayment\",          \"description\": \"Retrieve disbursement bank routing details for a specific payment.\",          \"when\": \"User asks for the bank, bank branch, or bank-country details for a payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"disbursementBankAccountName\",            \"bankName\",            \"countryCode\",            \"bankBranchName\",            \"branchNumber\",            \"paymentCurrencyCode\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_USER>\"          ],          \"notes\": \"\"        },        {          \"name\": \"serviceLevelAndDeliveryChannelByPayment\",          \"description\": \"Retrieve service-level and delivery-channel attributes for a payment reference or payment id, with related payment-format context when requested.\",          \"when\": \"User asks for service level codes, delivery channels, or how a payment was configured for delivery.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"serviceLevelCode\",            \"deliveryChannelCode\",            \"paymentMethodName\",            \"paymentModeMeaning\",            \"paymentFormatCode\",            \"formatName\"          ],          \"extraFilterExpressions\": [            \"If the user says payment reference or payment reference number, use paymentReferenceNumber='<PAYMENT_REFERENCE_NUMBER_FROM_USER>'\",            \"If the user says payment id or plain payment <number> without reference wording, use paymentId=<PAYMENT_ID_FROM_USER>\",            \"sortBy=paymentReferenceNumber:asc\",            \"limit=20\"          ],          \"notes\": \"The source exposes system codes directly; pair them with related format metadata only when requested. Explicit payment reference wording must use paymentReferenceNumber, not paymentId. Sort by paymentReferenceNumber:asc before limit 20; do not use paymentDate sorting for this lookup.\"        },        {          \"name\": \"paymentsByPprOrFile\",          \"description\": \"Retrieve disbursement payments for a payment file or PPR, including file and PPR status details.\",          \"when\": \"User asks for payments within a payment file or payment process request and wants payment-processing context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Use the filter expression that matches the identifier the user actually provides.\"        },        {          \"name\": \"virtualCardPaymentsByAliasAndDate\",          \"description\": \"Retrieve virtual card payments by RCN alias in a date window.\",          \"when\": \"User asks how many payments were paid or are in process using a specific virtual card alias or RCN.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"reconciledFlag\",            \"paymentModeLookupCode\",            \"paymentInstrumentAlias\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"paymentInstrument.paymentInstrumentAlias='<RCN_ALIAS_FROM_USER>'\",            \"paymentDate>=<START_DATE>\",            \"paymentDate<=<END_DATE>\"          ],          \"notes\": \"Use this payment slice together with document-level shapes when the user also wants invoice or installment detail.\"        },        {          \"name\": \"virtualCardProgramReconciliation\",          \"description\": \"Retrieve virtual card payments where the virtual card program and payment instrument alias indicate a program mismatch or cross-program usage check.\",          \"when\": \"User asks for virtual card payments where the program name and instrument alias indicate a cross-program or mismatch scenario.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"vcardProgramName\",            \"paymentInstrumentAlias\",            \"paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"paymentMode.lookupCode='VIRTUAL_CARD'\",            \"digitalPaymentAccount.virtualCardProgram.vcardProgramName='<VCARD_PROGRAM_NAME_FROM_USER>'\",            \"paymentInstrument.paymentInstrumentAlias like '%<RCN_ALIAS_FRAGMENT_FROM_USER>%'\"          ],          \"notes\": \"Use a contains-style filter on the payment instrument alias when the user gives a program fragment rather than the full alias.\"        },        {          \"name\": \"crossShapePaymentStatusFollowUp\",          \"description\": \"Retrieve detailed payment status, payment-file, and PPR context once a payment id has been identified from another shape.\",          \"when\": \"User starts from an expense report, refund reference, invoice, or document and then wants the payment status and payment logistics for the matched payment.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"reconciledFlag\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentId=<PAYMENT_ID_FROM_UPSTREAM_SHAPE>\"          ],          \"notes\": \"Use paymentRunInstallments first when the user identifies the payment through an expense report number, refund reference, or invoice reference instead of a payment identifier.\"        },        {          \"name\": \"pprPendingReviewPaymentReview\",          \"description\": \"Retrieve proposed disbursement payments for PPRs that are in pending review status, with optional filtering by PPR ID or PPR Name.\",          \"when\": \"User asks to review proposed payments for PPRs, pending review PPRs, or wants payment details tied to a PPR awaiting review.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\",            \"(paymentsPayablesPaymentProcessRequest.paymentProcessRequestId=<PPR_ID_FROM_USER> or paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>')\"          ],          \"notes\": \"Use this driver when the user wants proposed payments under PPR review. Apply the PENDING_REVIEW condition first, then narrow by PPR ID or PPR Name only when provided. If they want it for all PPR, then remove the PPR specific filter.\"        },        {          \"name\": \"recentExternalBankAccountChangeRiskReview\",          \"description\": \"Retrieve payments whose supplier external bank account was recently updated, sorted by most recently updated first, for fraud-risk review.\",          \"when\": \"User asks for payments where the supplier's bank account was recently changed, with no supplier filter, and wants the most recently updated records first.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeePartyName\",            \"payablesPayment.supplierName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentBusinessUnit\",            \"externalBankAccount.bankAccountName\",            \"externalBankAccount.maskedIban\",            \"externalBankAccount.maskedAccountNumber\",            \"externalBankAccount.eftSwiftCode\",            \"externalBankAccount.countryCode\",            \"externalBankAccount.timeCreated\",            \"externalBankAccount.timeUpdated\",            \"paymentStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"externalBankAccount.timeUpdated>=<TODAY_MINUS_30_DAYS>\"          ],          \"notes\": \"Do not require a supplier filter. Sort by externalBankAccount.timeUpdated descending so the most recently changed bank accounts appear first. Use this as a fraud-risk review slice for recent external bank account changes. Mandatory filter - externalBankAccount.timeUpdate\"        },        {          \"name\": \"pprPendingReviewPaymentReviewAll\",          \"description\": \"Retrieve proposed disbursement payments for all PPRs that are in pending review status.\",          \"when\": \"User asks to review proposed payments for all PPRs, pending review PPRs, or wants payment details tied to PPRs awaiting review without naming a specific PPR.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatus.meaning\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\",            \"payablesPaymentFile.paymentInstructionId\"          ],          \"extraFilterExpressions\": [            \"paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode='PENDING_REVIEW'\"          ],          \"notes\": \"Use this driver when the user wants proposed payments across all PPRs. Do not add a PPR ID or PPR Name filter unless the user explicitly supplies one.\"        },        {          \"name\": \"paymentsInPaymentFileMissingLegalEntity\",          \"description\": \"Retrieve payments in a payment file where legal entity is missing.\",          \"when\": \"User asks for payment-file payments with missing legal entity or asks why payments in a file are missing legal entity details.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"legalEntityId\",            \"legalEntityName\",            \"paymentInstructionId\",            \"paymentFileProcessingStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"legalEntity.legalEntityId is null\"          ],          \"notes\": \"Taxpayer ID is not currently in scope for this inquiry.\"        },        {          \"name\": \"voidedJpmAcknowledgementLinkedPayments\",          \"description\": \"Retrieve voided payments linked to JPM acknowledgement files.\",          \"when\": \"User asks for voided JPM acknowledgement-linked payments or payments rejected through JPM acknowledgement context.\",          \"fieldsToReturn\": [            \"paymentId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentMethodName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"bankName\",            \"voidDate\",            \"voidReason\",            \"payablesPaymentPaymentStatusLookupCode\",            \"payablesPaymentPaymentStatusMeaning\",            \"paymentInstructionId\",            \"acknowledgementFileName\",            \"acknowledgementPaymentSystemName\",            \"acknowledgementStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"disbursementInboundFile.id is not null\",            \"payablesPayment.paymentStatus.lookupCode='VOIDED'\",            \"voidDate is not null\",            \"disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'\"          ],          \"notes\": \"Use explicit inbound-file linkage and payment system name. For voided-payment status, use the AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`; do not use disbursement-side `paymentStatus.lookupCode='VOID'` for this use case. Apply user-provided date windows to `voidDate`. Do not infer L1/L2/L3 file classification from file names.\"        },        {          \"name\": \"paymentFileBankAcknowledgementError\",          \"description\": \"Retrieve backend-safe bank-provided BEP error code and message for payments in a specific payment file.\",          \"when\": \"User asks for the bank-provided acknowledgement error, error code, or error message for a payment file and does not require invoice/installment columns.\",          \"fieldsToReturn\": [            \"paymentReferenceNumber\",            \"paymentDate\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"payeePartyName\",            \"paymentStatusMeaning\",            \"bepErrorCode\",            \"bepErrorMessageText\",            \"paymentInstructionId\",            \"acknowledgementFileName\",            \"acknowledgementStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\",            \"bepErrorCode is not null or bepErrorMessageText is not null\"          ],          \"notes\": \"Use this extraction driver before paymentRunInstallments BV for payment-file bank-error questions because BEP aliases are top-level in this extraction shape. If the user asks for invoice or installment columns, use paymentRunInstallmentsExtraction instead.\"        },        {          \"name\": \"paymentFileContainedPayments\",          \"description\": \"List payment rows contained in a specific payment file using the payment-level disbursement extraction view.\",          \"when\": \"User asks which payments are in a payment file or wants payment reference, payee, amount, method, status, and disbursement bank account for payments under one file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"paymentReferenceNumber\",            \"paymentDate\",            \"payeeName\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentCurrencyCode\",            \"paymentStatusMeaning\",            \"paymentMethodName\",            \"disbursementBankAccountName\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Use this extraction driver instead of the 1-to-many `payablesDisbursementPayments` child accessor on disbursementPaymentInstructions. If invoice-level detail is requested, use paymentRunInstallmentsExtraction.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.disbursementPayments as the FROM source with alias consistent in the SQL (for example disbursementPayments).\",        \"Build the extraction SQL in a single query block where possible. Do not use an outer inline-view wrapper only to apply row limits or filter projected aliases.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"For detail row-list queries, append FETCH FIRST 20 ROWS ONLY in the same query block after ORDER BY when present. Do not use legacy row-number predicates.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"Use the canonical resource `payablesDisbursementPayments`, but request the richer `disbursementPayments` named view when the question needs service-level, delivery-channel, bank-branch, payment-format, virtual-card, payment-file, AP-payment, or PPR accessor details.\",        \"Use nested accessor paths exactly as defined in `fields.accessors`; do not invent flattened aliases such as `ApChecksAll` or unsupported shortcut fields.\",        \"For supplier-focused bank-account questions, filter with `payeePartyName` or `payablesPayment.supplierName` plus `paymentDate`, and return the surrounding logistics context from `disbursementBankAccount`, `disbursementBankAccount.bank`, and `disbursementBankAccount.bankBranch`.\",        \"For payment file format questions, read from `accountPaymentProfile.systemPaymentProfile.paymentFormat` and related processing/profile accessors rather than inferring from payment method alone.\",        \"For service-level and delivery-channel questions, return `serviceLevelCode` and `deliveryChannelCode` together with related payment-format or processing metadata when available; do not invent banking-standard descriptions not returned by the API.\",        \"For virtual card questions, combine `paymentMode.lookupCode='VIRTUAL_CARD'` with `paymentInstrument.paymentInstrumentAlias` and, when relevant, `digitalPaymentAccount.virtualCardProgram.vcardProgramName`.\",        \"For expense-report or refund-status questions, locate the payment id through paymentRunInstallments first, then use this shape to return payment status, payment file, reconciliation, and PPR context.\",        \"When the user also needs invoice or installment detail, use this shape to identify matching payment ids and then hand off to the corresponding document-level shape instead of overloading this BV with unsupported document attributes.\",        \"For missing legal entity in a payment file, filter `payablesPaymentFile.paymentInstructionId=<PAYMENT_FILE_ID>` and `legalEntity.legalEntityId is null`; Taxpayer ID is not in current scope.\",        \"For JPM acknowledgement-linked voided payments, require `disbursementInboundFile.id is not null`, AP checks-backed `payablesPayment.paymentStatus.lookupCode='VOIDED'`, `voidDate is not null`, and `disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'`; apply requested date windows to `voidDate` and do not infer unsupported L-level acknowledgement classifications.\",        \"When user asks for Bank acount details sort by paymentDate:desc. Do not use bepErrorCode\",        \"Do not ignore the extraFilterExpressions condition.\",        \"Treat business-driver filters as the required semantic core, not a closed-form query. When the user adds explicit constraints such as date or date range, PPR name/id, supplier, business unit, currency, amount, status, payment method, bank account, or payment file, add those filters when the selected shape exposes the field. A user-provided date filter overrides the default recency window. Do not drop required status, null-rate, source-shape, or sorting rules unless the user explicitly asks for a different lifecycle/source and the selected shape supports it.\",        \"If a requested filter, grouping, or output field is not exposed by the selected shape, do not invent a field or silently drop the constraint. Choose another supported shape that exposes it, or state the limitation while returning the closest supported query context.\",        \"For service-level and delivery-channel extraction questions by payment reference, filter with paymentReferenceNumber = '<value>', order by paymentReferenceNumber asc, append FETCH FIRST 20 ROWS ONLY in the same query block, and do not use paymentDate sorting.\"      ]    },    \"disbursementPaymentExceptions\": {      \"key\": \"disbursementPaymentExceptions\",      \"name\": \"disbursementPaymentExceptions\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"DisbursementPaymentTransactionError\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/disbursementPaymentExceptions\",      \"description\": \"Use this BV shape to inspect payment-level validation and processing exceptions in Oracle Payments. It is the right shape when the user asks which individual payments failed, whether the issue affects specific payments versus whole files, and which PPR and payee are impacted.\",      \"exampleQuestions\": [        \"Show me payment validation errors affecting individual payments.\",        \"Which payments in this PPR failed validation and why?\",        \"List payment exceptions by error code and payee.\",        \"Show me payment validation errors affecting individual payments in this payment process request.\",        \"Show rejected payments for terminated payment process requests in the last week.\"      ],      \"fields\": {        \"fields\": [          \"id\",          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"transactionType\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"errorType.lookupCode\",          \"errorType.meaning\",          \"errorStatus.lookupCode\",          \"errorStatus.meaning\",          \"payablesDisbursementPayment.paymentId\",          \"payablesDisbursementPayment.paymentReferenceNumber\",          \"payablesDisbursementPayment.paymentProcessRequestName\",          \"payablesDisbursementPayment.payeePartyName\",          \"payablesDisbursementPayment.paymentAmount\",          \"payablesDisbursementPayment.paymentDate\",          \"payablesDisbursementPayment.paperDocumentNumber\",          \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"payablesDisbursementPayment.paymentStatus.meaning\",          \"payablesDisbursementPayment.paymentMode.lookupCode\",          \"payablesDisbursementPayment.paymentMode.meaning\",          \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileId\",          \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileName\",          \"payablesDisbursementPayment.disbursementBankAccount.name\",          \"payablesDisbursementPayment.externalBankAccount.bankAccountName\",          \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"        ],        \"accessors\": {          \"errorType\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"errorStatus\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"payablesDisbursementPayment\": {            \"shape\": \"PayablesDisbursementPayment\",            \"fields\": [              \"paymentId\",              \"paymentReferenceNumber\",              \"paymentProcessRequestName\",              \"payeePartyName\",              \"paymentAmount\",              \"paymentDate\",              \"paperDocumentNumber\"            ],            \"accessors\": {              \"accountPaymentProfile\": {                \"shape\": \"AccountPaymentProfile\",                \"fields\": [                  \"paymentProfileId\",                  \"paymentProfileName\"                ]              },              \"externalBankAccount\": {                \"shape\": \"ExternalBankAccount\",                \"fields\": [                  \"id\",                  \"bankAccountName\"                ]              },              \"paymentStatus\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"paymentMode\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"disbursementBankAccount\": {                \"shape\": \"BankAccount\",                \"fields\": [                  \"id\",                  \"name\"                ]              },              \"paymentsPayablesPaymentProcessRequest\": {                \"shape\": \"PaymentsPayablesPaymentProcessRequest\",                \"fields\": [                  \"paymentProcessRequestId\",                  \"paymentProcessRequestName\",                  \"timeCreated\"                ],                \"accessors\": {                  \"paymentProcessRequestStatus\": {                    \"shape\": \"Lookup\",                    \"fields\": [                      \"lookupType\",                      \"meaning\",                      \"lookupCode\"                    ]                  }                }              }            }          }        },        \"fieldAlias\": {          \"Exception Id\": \"id\",          \"Error Code\": \"errorCode\",          \"Error Date\": \"errorDate\",          \"Error Message\": \"errorMessage\",          \"Transaction Type\": \"transactionType\",          \"Status Reason Code\": \"statusReasonCode\",          \"Status Reason Message\": \"statusReasonMessage\",          \"Error Type Code\": \"errorType.lookupCode\",          \"Error Type\": \"errorType.meaning\",          \"Error Status Code\": \"errorStatus.lookupCode\",          \"Error Status\": \"errorStatus.meaning\",          \"Payment Id\": \"payablesDisbursementPayment.paymentId\",          \"Payment Reference\": \"payablesDisbursementPayment.paymentReferenceNumber\",          \"PPR Name\": \"payablesDisbursementPayment.paymentProcessRequestName\",          \"Payee\": \"payablesDisbursementPayment.payeePartyName\",          \"Payment Amount\": \"payablesDisbursementPayment.paymentAmount\",          \"Payment Date\": \"payablesDisbursementPayment.paymentDate\",          \"Paper Document Number\": \"payablesDisbursementPayment.paperDocumentNumber\",          \"Payment Status Code\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"Payment Status\": \"payablesDisbursementPayment.paymentStatus.meaning\",          \"Payment Mode Code\": \"payablesDisbursementPayment.paymentMode.lookupCode\",          \"Payment Mode\": \"payablesDisbursementPayment.paymentMode.meaning\",          \"Payment Process Profile Id\": \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileId\",          \"Payment Process Profile\": \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileName\",          \"Disbursement Bank Account\": \"payablesDisbursementPayment.disbursementBankAccount.name\",          \"Payee Bank Account\": \"payablesDisbursementPayment.externalBankAccount.bankAccountName\",          \"PPR Id\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",          \"Linked PPR Name\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",          \"Linked PPR Status Code\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"Linked PPR Status\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"        }      },      \"fieldSelection\": {        \"base\": [          \"id\",          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"payablesDisbursementPayment.paymentReferenceNumber\",          \"payablesDisbursementPayment.paymentProcessRequestName\",          \"payablesDisbursementPayment.payeePartyName\"        ],        \"optional\": [          \"errorType.meaning\",          \"errorStatus.meaning\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"payablesDisbursementPayment.paymentAmount\",          \"payablesDisbursementPayment.paymentDate\",          \"payablesDisbursementPayment.paymentMode.meaning\",          \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileName\",          \"payablesDisbursementPayment.externalBankAccount.bankAccountName\"        ]      },      \"sortableAttributes\": [        \"id\",        \"errorCode\",        \"errorDate\",        \"errorMessage\",        \"transactionType\",        \"statusReasonCode\",        \"statusReasonMessage\",        \"errorType.lookupCode\",        \"errorType.meaning\",        \"errorStatus.lookupCode\",        \"errorStatus.meaning\",        \"payablesDisbursementPayment.paymentId\",        \"payablesDisbursementPayment.paymentReferenceNumber\",        \"payablesDisbursementPayment.paymentProcessRequestName\",        \"payablesDisbursementPayment.payeePartyName\",        \"payablesDisbursementPayment.paymentAmount\",        \"payablesDisbursementPayment.paymentDate\",        \"payablesDisbursementPayment.paperDocumentNumber\",        \"payablesDisbursementPayment.paymentStatus.lookupCode\",        \"payablesDisbursementPayment.paymentStatus.meaning\",        \"payablesDisbursementPayment.paymentMode.lookupCode\",        \"payablesDisbursementPayment.paymentMode.meaning\",        \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileId\",        \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileName\",        \"payablesDisbursementPayment.disbursementBankAccount.name\",        \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\",        \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",        \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",        \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"      ],      \"filterConditions\": [        {          \"name\": \"transactionType\",          \"attribute\": \"transactionType\",          \"type\": \"enum\",          \"possibleValues\": [            \"PAYMENT\"          ],          \"usage\": \"This resource is fixed to payment-level errors.\"        },        {          \"name\": \"errorCode\",          \"attribute\": \"errorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment error code.\"        },        {          \"name\": \"statusReasonCode\",          \"attribute\": \"statusReasonCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the seeded payment exception includes a status-reason code for the failure.\"        },        {          \"name\": \"errorType.lookupCode\",          \"attribute\": \"errorType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VALIDATION\",            \"BANK\"          ],          \"usage\": \"Use when the user distinguishes validation failures from bank-return or bank-processing failures.\"        },        {          \"name\": \"payablesDisbursementPayment.paymentProcessRequestName\",          \"attribute\": \"payablesDisbursementPayment.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payment exceptions to a single PPR.\"        },        {          \"name\": \"payablesDisbursementPayment.payeePartyName\",          \"attribute\": \"payablesDisbursementPayment.payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters payment exceptions to one supplier or payee.\"        },        {          \"name\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for failed, rejected, or other payment-status-specific exceptions.\"        },        {          \"name\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"FAILED_PAYMENT_VALIDATION\",            \"INFORMATION_REQUIRED\",            \"PENDING_REVIEW_PMT_VAL_ERRORS\",            \"TERMINATED\"          ],          \"usage\": \"Use when the user targets terminated runs or PPRs that are pending review or blocked for payment validation follow-up. These values come from the source-controlled IBY_REQUEST_STATUSES lookup snapshot.\"        },        {          \"name\": \"errorDate\",          \"attribute\": \"errorDate\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks to filter PP terminated in a particular date or period. example:  errorDate >= '2026-03-27' \"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `checkDate` when the user is asking about the intended payment date. Use `timeCreated` when the user is asking for recently created or historically created PPRs. \\nUse errorDate when user asks to see PPR terminated in a particular period. for errorDate use the yyyy-mm-dd format eg : errorDate >= '2026-04-27'\",        \"patterns\": [          {            \"userRequest\": \"today or tomorrow's payment runs\",            \"clause\": \"apply todays date to date field <date field> >= '2026-04-27'\"          },          {            \"userRequest\": \"recently created payment runs\",            \"example\": \"last 7 days\",            \"clause\": \"apply todays date to date field <date field> >= '<Date from 7 days ago>'\"          },          {            \"userRequest\": \"payment runs for a named date range\",            \"example\": \"next week or this month\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentsTerminated\",          \"description\": \"Find individual payment that are terminated.\",          \"when\": \"User asks for payment that are terminated\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentReferenceNumber\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentDate\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in('TERMINATED','FAILED_PAYMENT_VALIDATION') \"          ],          \"notes\": \"\"        },        {          \"name\": \"paymentLevelValidationFailures\",          \"description\": \"Find individual payment failures rather than file-level failures.\",          \"when\": \"User asks for payment validation errors affecting specific payments.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesDisbursementPayment.paymentReferenceNumber\",            \"payablesDisbursementPayment.payeePartyName\",            \"payablesDisbursementPayment.paymentAmount\",            \"payablesDisbursementPayment.paymentDate\",            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\"          ],          \"notes\": \"\"        },        {          \"name\": \"rejectedPaymentsForAffectedPprs\",          \"description\": \"Find individual payment failures inside runs that are already stalled or terminated because of payment validation problems.\",          \"when\": \"User asks for rejected or failed payments for terminated or payment-validation-error PPRs.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesDisbursementPayment.paymentReferenceNumber\",            \"payablesDisbursementPayment.payeePartyName\",            \"payablesDisbursementPayment.paymentStatus.meaning\",            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\"          ],          \"notes\": \"When the user asks for the comparison against whole-file failures, pair this driver with disbursementPaymentInstructionExceptions and compare grouped counts outside the base fetch.\"        },        {          \"name\": \"paymentConfirmationFailureByPpr\",          \"description\": \"Explain payment confirmation failures for a named payment process request at the individual payment level.\",          \"when\": \"User asks why payment confirmation failed for a PPR or wants the payment-level cause, impacted payees, and likely downstream impact.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"errorType.meaning\",            \"errorStatus.meaning\",            \"payablesDisbursementPayment.paymentReferenceNumber\",            \"payablesDisbursementPayment.payeePartyName\",            \"payablesDisbursementPayment.paymentAmount\",            \"payablesDisbursementPayment.paymentStatus.meaning\",            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\",            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\",            \"payablesDisbursementPayment.paymentProcessRequestName='<PPR_NAME_FROM_USER>' or payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Pair this result with PayablesPaymentProcessRequestDetails for run-level lifecycle context and use payablesPaymentDetails or disbursementPayments if the user needs payment logistics or settlement follow-up.\"        }      ],      \"additionalInstructions\": [        \"Use this shape for payment-level exceptions. For whole-file failures, use disbursementPaymentInstructionExceptions.\",        \"When the user asks to compare file-level versus payment-level validation errors, treat this shape as the payment-level side of the comparison and compute grouped counts after filtering by the same PPR scope or date window.\",        \"When the user asks why payment confirmation failed, use the payment-level error rows here to identify the exact failing payments, then explain the broader PPR state with PayablesPaymentProcessRequestDetails.\"      ]    },    \"disbursementPaymentExceptionsExtraction\": {      \"key\": \"disbursementPaymentExceptionsExtraction\",      \"name\": \"disbursementPaymentExceptionsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"DisbursementPaymentTransactionError\",      \"description\": \"Runtime extraction wrapper for the disbursementPaymentExceptions BV. Use this BV shape primarily for summary queries about payment-level validation and processing exceptions in Oracle Payments, such as grouped counts and amounts by error code, payee, payment status, or PPR. Use it to measure the scale and concentration of individual-payment failures before drilling into specific records.\",      \"exampleQuestions\": [        \"How many payment validation errors are affecting individual payments by error code?\",        \"Which payments in this PPR failed validation and why, grouped by payee?\",        \"List payment exceptions by error code and payee.\",        \"Show me payment validation errors affecting individual payments in this payment process request, grouped by payment status.\",        \"How many rejected payments are there for terminated payment process requests in the last week by payee?\"      ],      \"fields\": {        \"fields\": [          \"id\",          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"transactionType\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"errorTypeLookupCode\",          \"errorTypeMeaning\",          \"errorStatusLookupCode\",          \"errorStatusMeaning\",          \"paymentId\",          \"paymentReferenceNumber\",          \"paymentProcessRequestName\",          \"payeePartyName\",          \"paymentAmount\",          \"paymentDate\",          \"paperDocumentNumber\",          \"paymentStatusLookupCode\",          \"paymentStatusMeaning\",          \"paymentModeLookupCode\",          \"paymentModeMeaning\",          \"paymentProfileId\",          \"paymentProfileName\",          \"disbursementBankAccountName\",          \"bankAccountName\",          \"paymentProcessRequestId\",          \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"paymentProcessRequestStatusLookupCode\",          \"paymentProcessRequestStatusMeaning\"        ],        \"fieldAlias\": {          \"Exception Id\": \"id\",          \"Error Code\": \"errorCode\",          \"Error Date\": \"errorDate\",          \"Error Message\": \"errorMessage\",          \"Transaction Type\": \"transactionType\",          \"Status Reason Code\": \"statusReasonCode\",          \"Status Reason Message\": \"statusReasonMessage\",          \"Error Type Code\": \"errorTypeLookupCode\",          \"Error Type\": \"errorTypeMeaning\",          \"Error Status Code\": \"errorStatusLookupCode\",          \"Error Status\": \"errorStatusMeaning\",          \"Payment Id\": \"paymentId\",          \"Payment Reference\": \"paymentReferenceNumber\",          \"PPR Name\": \"paymentProcessRequestName\",          \"Payee\": \"payeePartyName\",          \"Payment Amount\": \"paymentAmount\",          \"Payment Date\": \"paymentDate\",          \"Paper Document Number\": \"paperDocumentNumber\",          \"Payment Status Code\": \"paymentStatusLookupCode\",          \"Payment Status\": \"paymentStatusMeaning\",          \"Payment Mode Code\": \"paymentModeLookupCode\",          \"Payment Mode\": \"paymentModeMeaning\",          \"Payment Process Profile Id\": \"paymentProfileId\",          \"Payment Process Profile\": \"paymentProfileName\",          \"Disbursement Bank Account\": \"disbursementBankAccountName\",          \"Payee Bank Account\": \"bankAccountName\",          \"PPR Id\": \"paymentProcessRequestId\",          \"Linked PPR Name\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",          \"Linked PPR Status Code\": \"paymentProcessRequestStatusLookupCode\",          \"Linked PPR Status\": \"paymentProcessRequestStatusMeaning\"        }      },      \"supportedFilters\": [        {          \"name\": \"transactionType\",          \"attribute\": \"transactionType\",          \"type\": \"enum\",          \"possibleValues\": [            \"PAYMENT\"          ],          \"usage\": \"This resource is fixed to payment-level errors.\",          \"valueFromUser\": \"Transaction Type\"        },        {          \"name\": \"errorCode\",          \"attribute\": \"errorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for a specific payment error code.\",          \"valueFromUser\": \"Error Code\"        },        {          \"name\": \"statusReasonCode\",          \"attribute\": \"statusReasonCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the seeded payment exception includes a status-reason code for the failure.\",          \"valueFromUser\": \"Status Reason Code\"        },        {          \"name\": \"errorType.lookupCode\",          \"attribute\": \"errorType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VALIDATION\",            \"BANK\"          ],          \"usage\": \"Use when the user distinguishes validation failures from bank-return or bank-processing failures.\",          \"valueFromUser\": \"Error Type Code\"        },        {          \"name\": \"payablesDisbursementPayment.paymentProcessRequestName\",          \"attribute\": \"payablesDisbursementPayment.paymentProcessRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes payment exceptions to a single PPR.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"payablesDisbursementPayment.payeePartyName\",          \"attribute\": \"payablesDisbursementPayment.payeePartyName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters payment exceptions to one supplier or payee.\",          \"valueFromUser\": \"Payee\"        },        {          \"name\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentStatus.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for failed, rejected, or other payment-status-specific exceptions.\",          \"valueFromUser\": \"Payment Status Code\"        },        {          \"name\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"attribute\": \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"FAILED_PAYMENT_VALIDATION\",            \"INFORMATION_REQUIRED\",            \"PENDING_REVIEW_PMT_VAL_ERRORS\",            \"TERMINATED\"          ],          \"usage\": \"Use when the user targets terminated runs or PPRs that are pending review or blocked for payment validation follow-up. These values come from the source-controlled IBY_REQUEST_STATUSES lookup snapshot.\",          \"valueFromUser\": \"Linked PPR Status Code\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Apply date filters in the same query block over the returned date columns. For general recent-PPR discovery, default to paymentProcessRequestCreationDate. If the user explicitly asks about payment date, pending since, completion date, termination date, acknowledgement processing date, or payment file creation date, use that returned date column instead.\",        \"patterns\": [          {            \"userRequest\": \"no date or time range specified for a discovery request\",            \"clause\": \"<date_column> >= TRUNC(SYSDATE) - 30\"          },          {            \"userRequest\": \"last <N> days\",            \"example\": \"last 7 days\",            \"clause\": \"<date_column> >= TRUNC(SYSDATE) - <N>\"          },          {            \"userRequest\": \"last <N> months\",            \"example\": \"last 2 months\",            \"clause\": \"<date_column> >= ADD_MONTHS(TRUNC(SYSDATE), -<N>)\"          },          {            \"userRequest\": \"between <start> and <end>\",            \"example\": \"between 2026-03-01 and 2026-03-31\",            \"clause\": \"<date_column> >= TO_DATE('<start_date>','YYYY-MM-DD') and <date_column> <= TO_DATE('<end_date>','YYYY-MM-DD')\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"disbursementPaymentExceptions\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"DisbursementPaymentTransactionError\",            \"view\": \"disbursementPaymentExceptions\",            \"fieldAliases\": {              \"id\": \"id\",              \"errorCode\": \"errorCode\",              \"errorDate\": \"errorDate\",              \"errorMessage\": \"errorMessage\",              \"transactionType\": \"transactionType\",              \"statusReasonCode\": \"statusReasonCode\",              \"statusReasonMessage\": \"statusReasonMessage\",              \"errorType.lookupCode\": \"errorTypeLookupCode\",              \"errorType.meaning\": \"errorTypeMeaning\",              \"errorStatus.lookupCode\": \"errorStatusLookupCode\",              \"errorStatus.meaning\": \"errorStatusMeaning\",              \"payablesDisbursementPayment.paymentId\": \"paymentId\",              \"payablesDisbursementPayment.paymentReferenceNumber\": \"paymentReferenceNumber\",              \"payablesDisbursementPayment.paymentProcessRequestName\": \"paymentProcessRequestName\",              \"payablesDisbursementPayment.payeePartyName\": \"payeePartyName\",              \"payablesDisbursementPayment.paymentAmount\": \"paymentAmount\",              \"payablesDisbursementPayment.paymentDate\": \"paymentDate\",              \"payablesDisbursementPayment.paperDocumentNumber\": \"paperDocumentNumber\",              \"payablesDisbursementPayment.paymentStatus.lookupCode\": \"paymentStatusLookupCode\",              \"payablesDisbursementPayment.paymentStatus.meaning\": \"paymentStatusMeaning\",              \"payablesDisbursementPayment.paymentMode.lookupCode\": \"paymentModeLookupCode\",              \"payablesDisbursementPayment.paymentMode.meaning\": \"paymentModeMeaning\",              \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"payablesDisbursementPayment.accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"payablesDisbursementPayment.disbursementBankAccount.name\": \"disbursementBankAccountName\",              \"payablesDisbursementPayment.externalBankAccount.bankAccountName\": \"bankAccountName\",              \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestId\": \"paymentProcessRequestId\",              \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName\": \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",              \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode\": \"paymentProcessRequestStatusLookupCode\",              \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.meaning\": \"paymentProcessRequestStatusMeaning\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"paymentsTerminated\",          \"description\": \"Find individual payment that are terminated.\",          \"when\": \"User asks for payment that are terminated\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentReferenceNumber\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentDate\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestStatus.lookupCode in('TERMINATED','FAILED_PAYMENT_VALIDATION') \"          ],          \"notes\": \"\"        },        {          \"name\": \"paymentLevelValidationFailures\",          \"description\": \"Find individual payment failures rather than file-level failures.\",          \"when\": \"User asks for payment validation errors affecting specific payments.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentReferenceNumber\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentDate\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\"          ],          \"notes\": \"\"        },        {          \"name\": \"rejectedPaymentsForAffectedPprs\",          \"description\": \"Find individual payment failures inside runs that are already stalled or terminated because of payment validation problems.\",          \"when\": \"User asks for rejected or failed payments for terminated or payment-validation-error PPRs.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentReferenceNumber\",            \"payeePartyName\",            \"paymentStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\"          ],          \"notes\": \"When the user asks for the comparison against whole-file failures, pair this driver with disbursementPaymentInstructionExceptions and compare grouped counts outside the base fetch.\"        },        {          \"name\": \"paymentConfirmationFailureByPpr\",          \"description\": \"Explain payment confirmation failures for a named payment process request at the individual payment level.\",          \"when\": \"User asks why payment confirmation failed for a PPR or wants the payment-level cause, impacted payees, and likely downstream impact.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"errorTypeMeaning\",            \"errorStatusMeaning\",            \"paymentReferenceNumber\",            \"payeePartyName\",            \"paymentAmount\",            \"paymentStatusMeaning\",            \"paymentsPayablesPaymentProcessRequestPaymentProcessRequestName\",            \"paymentProcessRequestStatusMeaning\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT'\",            \"payablesDisbursementPayment.paymentProcessRequestName='<PPR_NAME_FROM_USER>' or payablesDisbursementPayment.paymentsPayablesPaymentProcessRequest.paymentProcessRequestName='<PPR_NAME_FROM_USER>'\"          ],          \"notes\": \"Pair this result with PayablesPaymentProcessRequestDetails for run-level lifecycle context and use payablesPaymentDetails or disbursementPayments if the user needs payment logistics or settlement follow-up.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.disbursementPaymentExceptions as the FROM source with alias consistent in the SQL (for example disbursementPaymentExceptions).\",        \"Build the extraction SQL in a single query block where possible. Do not use an outer inline-view wrapper only to apply row limits or filter projected aliases.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution.\",        \"For detail row-list queries, append FETCH FIRST 20 ROWS ONLY in the same query block after ORDER BY when present. Do not use legacy row-number predicates.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"Use this shape for payment-level exceptions. For whole-file failures, use disbursementPaymentInstructionExceptions.\",        \"When the user asks to compare file-level versus payment-level validation errors, treat this shape as the payment-level side of the comparison and compute grouped counts after filtering by the same PPR scope or date window.\",        \"When the user asks why payment confirmation failed, use the payment-level error rows here to identify the exact failing payments, then explain the broader PPR state with PayablesPaymentProcessRequestDetails.\"      ]    },    \"countOfUnprocessedAcknowledgementFiles\": {      \"key\": \"countOfUnprocessedAcknowledgementFiles\",      \"name\": \"countOfUnprocessedAcknowledgementFiles\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"DisbursementInboundFile\",      \"description\": \"Runtime extraction wrapper for grouped counts of unprocessed acknowledgement files by inbound file processing status. Use this only for acknowledgement-file count summaries, not payment-file status counts.\",      \"exampleQuestions\": [        \"How many unprocessed acknowledgement files are there?\",        \"Count unprocessed acknowledgement files by status.\",        \"How many unprocessed acknowledgement files were received from Citibank in the last 30 days?\",        \"Count unprocessed acknowledgement files by payment system.\"      ],      \"fields\": {        \"fields\": [          \"inboundFileProcessingStatusLookupCode\",          \"inboundFileProcessingStatusMeaning\",          \"paymentSystemName\",          \"acknowledgementFileCount\"        ],        \"fieldAlias\": {          \"Inbound File Status Code\": \"inboundFileProcessingStatusLookupCode\",          \"Inbound File Status\": \"inboundFileProcessingStatusMeaning\",          \"Payment System\": \"paymentSystemName\",          \"Count\": \"acknowledgementFileCount\",          \"Acknowledgment File Count\": \"acknowledgementFileCount\"        }      },      \"supportedFilters\": [        {          \"name\": \"inboundFileProcessingStatus.lookupCode\",          \"attribute\": \"inboundFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"FETCHED\",            \"IMPORT_WARNING\",            \"IMPORT_ERROR\",            \"TRANSFORM_ERROR\"          ],          \"usage\": \"Default unprocessed acknowledgement status filter. Use all four values unless the user narrows to a specific status.\",          \"valueFromUser\": \"Inbound File Status Code\"        },        {          \"name\": \"timeCreated\",          \"attribute\": \"timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Default date filter. Use the last 30 days when the user does not provide a date range. Because this extraction generates Oracle SQL against a datetime field, emit ANSI TIMESTAMP literals such as `timeCreated >= TIMESTAMP '2026-05-18 00:00:00'`; do not emit plain quoted date strings such as `timeCreated >= '2026-05-18'`.\",          \"valueFromUser\": \"Date range\"        },        {          \"name\": \"paymentSystem.paymentSystemName\",          \"attribute\": \"paymentSystem.paymentSystemName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for counts by or for a payment system or bank.\",          \"valueFromUser\": \"Payment System\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `timeCreated` as the default acknowledgement date attribute. If the user asks for unprocessed acknowledgements and does not supply a window, use the last 30 days. Extraction SQL must use Oracle ANSI TIMESTAMP literals for `timeCreated` comparisons.\",        \"patterns\": [          {            \"userRequest\": \"count unprocessed acknowledgements\",            \"clause\": \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00'\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"paymentAcknowledgements\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"DisbursementInboundFile\",            \"view\": \"paymentAcknowledgements\",            \"fieldAliases\": {              \"id\": \"acknowledgementFileId\",              \"timeCreated\": \"timeCreated\",              \"inboundFileProcessingStatus.lookupCode\": \"inboundFileProcessingStatusLookupCode\",              \"inboundFileProcessingStatus.meaning\": \"inboundFileProcessingStatusMeaning\",              \"paymentSystem.paymentSystemName\": \"paymentSystemName\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"countUnprocessedAcknowledgementFilesByStatus\",          \"description\": \"Count unprocessed acknowledgement files grouped by inbound processing status.\",          \"when\": \"User asks how many acknowledgement files are unprocessed or wants a status count.\",          \"fieldsToReturn\": [            \"inboundFileProcessingStatusMeaning\",            \"acknowledgementFileCount\"          ],          \"extraFilterExpressions\": [            \"inboundFileProcessingStatusLookupCode in ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR')\",            \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Generate a grouped SELECT: SELECT inboundFileProcessingStatusMeaning, COUNT(*) AS acknowledgementFileCount FROM paymentAcknowledgements WHERE inboundFileProcessingStatusLookupCode in (...) AND <date filter> GROUP BY inboundFileProcessingStatusMeaning. For the default `timeCreated` date filter, use an Oracle ANSI TIMESTAMP literal. Do not include payablesPaymentFile aliases, paymentInstructionId, or paymentRequestName in this count extraction because unprocessed inbound rows can carry non-numeric trading partner file references.\"        },        {          \"name\": \"countUnprocessedAcknowledgementFilesByPaymentSystem\",          \"description\": \"Count unprocessed acknowledgement files grouped by payment system.\",          \"when\": \"User asks how many unprocessed acknowledgement files exist for each bank or payment system.\",          \"fieldsToReturn\": [            \"paymentSystemName\",            \"acknowledgementFileCount\"          ],          \"extraFilterExpressions\": [            \"inboundFileProcessingStatusLookupCode in ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR')\",            \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Generate a grouped SELECT by paymentSystemName. Do not use file name parsing to infer bank. Do not include payablesPaymentFile aliases, paymentInstructionId, or paymentRequestName in this count extraction because unprocessed inbound rows can carry non-numeric trading partner file references.\"        },        {          \"name\": \"unprocessedAcknowledgementFilesByStatus\",          \"description\": \"Grouped summary for unprocessed acknowledgement files by status.\",          \"when\": \"User asks how many acknowledgement files are unprocessed or asks for unprocessed acknowledgement files by status.\",          \"fieldsToReturn\": [            \"inboundFileProcessingStatusMeaning\",            \"acknowledgementFileCount\"          ],          \"extraFilterExpressions\": [            \"inboundFileProcessingStatusLookupCode IN ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR')\",            \"timeCreated>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' when no date range is supplied\"          ],          \"notes\": \"Always group by inboundFileProcessingStatusMeaning. Do not generate a total-only COUNT(*) for unprocessed acknowledgement count questions. Do not include payablesPaymentFile aliases, paymentInstructionId, or paymentRequestName in this count extraction because unprocessed inbound rows can carry non-numeric trading partner file references.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.paymentAcknowledgements as the FROM source with alias consistent in the SQL.\",        \"The confirmed unprocessed acknowledgement status set is FETCHED, IMPORT_WARNING, IMPORT_ERROR, and TRANSFORM_ERROR.\",        \"Default broad unprocessed acknowledgement count queries to the last 30 days on `timeCreated` when the user does not provide a date range. Use Oracle ANSI TIMESTAMP literals for `timeCreated`; never use plain quoted date strings. For a single-day user request on a datetime field, use whole-day bounds such as `timeCreated >= TIMESTAMP '2026-06-01 00:00:00' and timeCreated < TIMESTAMP '2026-06-02 00:00:00'`.\",        \"Do not apply a detail row limit to grouped count summaries unless the user explicitly asks for a top-N result with a valid aggregate ORDER BY.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"For unprocessed acknowledgement count questions, generate a grouped aggregate query by inboundFileProcessingStatusMeaning and return only Inbound File Status and Count unless the user asks for more grouping dimensions.\",        \"Do not include `payablesPaymentFile.paymentInstructionId`, `payablesPaymentFile.paymentRequestName`, `paymentInstructionId`, or `paymentRequestName` anywhere in viewQueries, SELECT, WHERE, GROUP BY, fields, or aliases for unprocessed acknowledgement count queries; the payment-file join can force numeric conversion of non-numeric trading partner file references such as AGENT-UNPROC-1 and cause ORA-01722.\",        \"Use Oracle ANSI TIMESTAMP literals for timeCreated filters. Do not emit plain quoted date strings.\"      ],      \"selectExamples\": [        {          \"key\": \"unprocessedAcknowledgementFilesByStatus\",          \"name\": \"unprocessedAcknowledgementFilesByStatus\",          \"intentSliceKey\": \"unprocessedAcknowledgementSummary\",          \"description\": \"Count unprocessed acknowledgement files by inbound file processing status for the requested or default acknowledgement time window.\",          \"outputFields\": [            \"inboundFileProcessingStatusMeaning\",            \"acknowledgementFileCount\"          ],          \"select\": \"SELECT inboundFileProcessingStatusMeaning AS inboundFileProcessingStatusMeaning, COUNT(*) AS acknowledgementFileCount FROM paymentAcknowledgements WHERE inboundFileProcessingStatusLookupCode IN ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR') AND timeCreated >= TIMESTAMP '<START_DATE_YYYY-MM-DD> 00:00:00' GROUP BY inboundFileProcessingStatusMeaning\"        }      ]    },    \"paymentInstructionAttachments\": {      \"key\": \"paymentInstructionAttachments\",      \"name\": \"paymentInstructionAttachments\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"PayablesPaymentFile\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/payablesPaymentFiles/$views/paymentInstructionAttachments\",      \"description\": \"Business view for payment-file attachment metadata exposed by the latest PayablesPaymentFile app package. Use this shape to list available files or attachment metadata for a payment file, including document title, file name, media type, size, category, and URL metadata. Do not use this shape to execute a download.\",      \"exampleQuestions\": [        \"Show attachment metadata for payment file 41698.\",        \"Which files are attached to payment file 41698?\",        \"List payment file 41698 attachment file names and media types.\",        \"Show available payment-file documents for payment instruction 41698.\"      ],      \"fields\": {        \"fields\": [          \"paymentInstructionId\",          \"$attachments.id\",          \"$attachments.category\",          \"$attachments.timeUpdated\",          \"$attachments.document.id\",          \"$attachments.document.title\",          \"$attachments.document.description\",          \"$attachments.document.timeUpdated\",          \"$attachments.document.type\",          \"$attachments.document.url\",          \"$attachments.document.fileName\",          \"$attachments.document.size\",          \"$attachments.document.mediaType\"        ],        \"accessors\": {          \"$attachments\": {            \"shape\": \"PaymentInstructionAttachment\",            \"fields\": [              \"id\",              \"category\",              \"timeUpdated\"            ],            \"accessors\": {              \"document\": {                \"shape\": \"Document\",                \"fields\": [                  \"id\",                  \"title\",                  \"description\",                  \"timeUpdated\",                  \"type\",                  \"url\",                  \"fileName\",                  \"size\",                  \"mediaType\"                ]              }            }          }        },        \"fieldAlias\": {          \"Payment File Id\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Attachment Id\": \"$attachments.id\",          \"Attachment Category\": \"$attachments.category\",          \"Attachment Updated On\": \"$attachments.timeUpdated\",          \"Document Id\": \"$attachments.document.id\",          \"Document Title\": \"$attachments.document.title\",          \"Document Description\": \"$attachments.document.description\",          \"Document Updated On\": \"$attachments.document.timeUpdated\",          \"Document Type\": \"$attachments.document.type\",          \"Document URL\": \"$attachments.document.url\",          \"File Name\": \"$attachments.document.fileName\",          \"File Size\": \"$attachments.document.size\",          \"Media Type\": \"$attachments.document.mediaType\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentInstructionId\",          \"$attachments.id\",          \"$attachments.document.fileName\",          \"$attachments.document.title\",          \"$attachments.category\",          \"$attachments.document.mediaType\"        ],        \"optional\": [          \"$attachments.document.description\",          \"$attachments.document.type\",          \"$attachments.document.size\",          \"$attachments.document.timeUpdated\",          \"$attachments.document.url\"        ]      },      \"sortableAttributes\": [        \"paymentInstructionId\",        \"$attachments.id\",        \"$attachments.timeUpdated\",        \"$attachments.document.title\",        \"$attachments.document.fileName\",        \"$attachments.document.mediaType\"      ],      \"filterConditions\": [        {          \"name\": \"paymentInstructionId\",          \"attribute\": \"paymentInstructionId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Required when listing attachments for a specific payment file or payment instruction.\"        },        {          \"name\": \"$attachments.category\",          \"attribute\": \"$attachments.category\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use only when the user asks for a particular attachment category.\"        },        {          \"name\": \"$attachments.document.fileName\",          \"attribute\": \"$attachments.document.fileName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides a specific payment-file attachment file name.\"        },        {          \"name\": \"$attachments.document.mediaType\",          \"attribute\": \"$attachments.document.mediaType\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters attachments by file type or media type.\"        }      ],      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"paymentFileAttachmentMetadata\",          \"description\": \"List available attachment metadata for a payment file from the refreshed paymentInstructionAttachments app-pkg view.\",          \"when\": \"User asks which files, documents, attachments, or downloadable artifacts are available for a payment file.\",          \"fieldsToReturn\": [            \"paymentInstructionId\",            \"$attachments.document.fileName\",            \"$attachments.document.title\",            \"$attachments.category\",            \"$attachments.document.mediaType\",            \"$attachments.document.size\",            \"$attachments.document.timeUpdated\"          ],          \"extraFilterExpressions\": [            \"paymentInstructionId=<PAYMENT_FILE_ID_FROM_USER>\"          ],          \"notes\": \"Return attachment metadata only. For a user request to download, open, transmit, send, or otherwise act on the payment file, route to paymentFile.navigatePaymentFileActions and do not claim execution.\"        }      ],      \"additionalInstructions\": [        \"This shape reflects the latest app-pkg view `payablesPaymentFiles/$views/paymentInstructionAttachments`.\",        \"Use this shape only for payment-file attachment metadata and availability questions.\",        \"Do not use the document URL as proof that a file was downloaded or opened; downloads/actions remain navigation-only in this Payment File Agent scope.\",        \"If a payment file id is missing and no active payment-file context exists, ask which payment file to inspect.\"      ]    }  }"
            },
            {
              "id": "1776062701897",
              "name": "businessIntent",
              "value": "[    {      \"key\": \"paymentFile.searchPaymentFiles\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Find Payment Files\",      \"intentDomainKnowledge\": \"Find Payment Files is the generic discovery and retrieval intent for payment files. It owns requestStatusCode-based inquiry and supported filters for fetching payment files. Dedicated lifecycle intents own their own stage statuses even when the user asks only to show, list, count, or filter payment files in that status. Payment mode, virtual card, VC, VCC, funding card account, RCN, and financing program are not accepted filter criteria for this intent.\",      \"description\": \"Finds payment files by generic discovery criteria, request lifecycle status, non-stage-owned payment-file status values, date, payment file reference, related payment process request, and curated file-level header or setup attributes such as payment method, disbursement bank account, payment process profile, payment file processing type, payments confirmed, payment system, payment system account, and format name.\",      \"nlpExamples\": [        \"Show me completed payment files.\",        \"Show me completed payment files in 2012.\",        \"Show completed payment files from January 2012 to December 2012.\",        \"Show completed payment files after 2026-01-01.\",        \"Show completed payment files in August 2026.\",        \"Show terminated payment files.\",        \"Show terminated payment files in 2012.\",        \"Show terminated payment files from 2025 to 2026.\",        \"Show payment file requiring attention.\",        \"Show payment files requiring attention within last 3 years.\",        \"Show payment file requiring attention in August 2026.\",        \"Show payment files requiring attention in the last 30 days.\",        \"Show payment files requiring attention since last month.\",        \"Show payment files requiring attention in August 2026.\",        \"Show payment files requiring attention after 2026-01-01.\",        \"Give me a payment file status overview for files requiring attention.\",        \"Show payment files for PPR PPR-1802.\",        \"Show payment files created on Dec 2012.\",        \"Show payment files created in December 2012.\",        \"Show me payment file whose creation date is after 2026-01-08.\",        \"Show payment files created after 2026-01-08.\",        \"Show payment files having payment date within last 2 weeks.\",        \"Show payment files with payment date in 2012.\",        \"Show me payment file whose payment date is after 2026-01-01.\",        \"Show me payment files paid in April 2026.\",        \"Show payment files paid after 2026-01-01.\",        \"Show payment files with payment method check.\",        \"Show payment files for disbursement bank account BofA-2040.\",        \"Group payment files by disbursement bank account and status.\",        \"Show payment files for payment process profile ACH Domestic.\",        \"Show payment files with payment file processing type Electronic.\",        \"Show payment files where payments are confirmed.\",        \"Show payment files for payment system JPM.\",        \"Show payment files for payment system account JPM USD.\",        \"Show payment files with format name ISO20022.\",        \"Show payment files in terminating status.\",        \"Show payment files in created status.\",        \"Show payment files in created and ready for formatting status.\",        \"Show payment files in formatted and ready for recording status.\",        \"Show payment files in formatted status.\",        \"Show payment files in failed formatting and pending action status.\",        \"What filters can I use to search payment files?\"      ],      \"data\": {        \"goal\": \"Return payment-file search results for the user's requested business criteria within the supported payment-file search scope.\",        \"slices\": [          \"Status-oriented payment-file search, including any supported payment-file processing status.\",          \"Date-oriented payment-file search.\",          \"Payment-file search using related payment process request.\",          \"Payment-file search using curated file-level header or setup attributes: Payment Method, Disbursement Bank Account, Payment Process Profile, Payment File Processing Type, Payments Confirmed, Payment System, Payment System Account, and Format Name.\",          \"Combined search using the supported status, date, and curated file-level header or setup filters together.\",          \"Unsupported-filter boundary: do not use this intent for payment-file searches filtered by payment mode, virtual card, VC, VCC, funding card account, RCN, or financing program.\"        ]      },      \"promptInstruction\": \"Status ownership: dedicated lifecycle intents own their stage statuses, including enquiry-only list, count, and status prompts. Use Find Payment Files only for generic discovery, request lifecycle status, non-stage-owned payment-file status values, and supported filters such as date, PPR, bank, and the curated file-level header or setup attributes Payment Method, Disbursement Bank Account, Payment Process Profile, Payment File Processing Type, Payments Confirmed, Payment System, Payment System Account, and Format Name. Payment mode, virtual card, VC, VCC, funding card account, RCN, and financing program are not accepted filter criteria for this intent. Do not use this intent to answer payment-file prompts filtered by payment mode, virtual card, VC, VCC, funding card account, RCN, or financing program, even though the mapped shape exposes those fields; treat those criteria as unsupported for this intent and do not build a query from the shape virtual-card, funding-card, or financing-program drivers. Use these curated file-level attributes only for broad payment-file list, filter, grouping, count, or display questions. For attribute-based payment-file searches, use a compact result layout anchored on Payment File Reference, Payment File Status, Payment Process Request Name, Payment File Creation Date, Payment Date, and Payments Recorded, then add only the user-requested filter attribute columns needed to explain why the row matched. Do not include unrelated attribute columns that are blank for all returned rows. If the user asks for one known payment file's value for one of these attributes, route to `paymentFile.viewPaymentFileDetails`. If the user asks about payment rows inside a file, such as which payments inside file X used a payment method or bank account, route to `paymentFile.drillDownOnPaymentFiles`. Creation and Validation owns CREATION_ERROR and RETRY_CREATION, plus supported creation-failure and validation-stage diagnosis. Transmission owns TRANSMISSION_FAILED, FORMATTED_READY_TO_TRANSMIT, TRANSMITTED, and TRANSMITTED_PENDING_ACK wording, plus transmission setup, protocol, readiness, and failure diagnosis. Printing owns CREATED_READY_FOR_PRINTING, FORMATTED_READY_FOR_PRINTING, SUBMITTED_FOR_PRINTING, and PRINTED wording, plus check printing, print/reprint status, payment document, and check-stock review. Disbursement Acknowledgement owns ACKNOWLEDGED, PARTIALLY_ACKNOWLEDGED, PENDING_ACK, PENDING_ACTION_ACK_FAILURE, PROCESSING_ACK, and REJECTED payment-file status wording, plus inbound acknowledgement-file processing. Formatting status wording does not have a dedicated bucket in this target taxonomy; keep CREATED_READY_FOR_FORMATTING, FORMATTED_ELECTRONIC, FORMATTED, and FORMATTING_FAILED as Find Payment Files status inquiries unless the user asks for another supported lifecycle investigation. Use this intent for supported generic payment-file list search and status-oriented retrieval after applying status ownership. Return only payment-file rows. When this intent uses `PayablesPaymentProcessRequestDetails` with request-lifecycle filtering, always add `paymentFileReference != null` so the result stays limited to true payment-file rows. Apply that guard to generic completed, terminated, and requiring-attention lifecycle searches, including explicit date-range filters and default-recency variants. Use requestStatusCode for generic completed, terminated, and requiring-attention searches only with that payment-file-reference guard. Treat generic `terminated` payment-file wording as a request-lifecycle search, not as `paymentFileStatusCode='TERMINATED'`, unless the user explicitly asks for the payment-file status code or exact status code `TERMINATED`. Use paymentFileStatusCode only for explicit payment-file statuses that are not owned by a dedicated lifecycle intent, including Terminating => CANCELING, Created => CREATED, Created and ready for formatting => CREATED_READY_FOR_FORMATTING, Formatted and ready for recording => FORMATTED_ELECTRONIC, Formatted => FORMATTED, and Failed formatting and pending action => FORMATTING_FAILED. For generic status-only search with no date, default to the last 30 days on payment process request creation date, except requiring-attention lifecycle searches with no date should default to the last 30 days on `pendingSince`. For completed, terminated, and requiring-attention searches that use requestStatusCode, use the matching lifecycle date as the date axis whenever the lifecycle wording appears with a date. For requiring-attention payment-file searches, singular and plural wording are equivalent, and `requiring attention` implies the `pendingSince` date axis. For example, `show payment file requiring attention`, `show payment files requiring attention in August 2026`, and `show payment files requiring attention after 2026-01-01` must use requestStatusCode='REQUIRING_ATTENTION', `paymentFileReference != null`, and `pendingSince` for date filtering, and must not ask whether the date is creation date or payment date. When the user explicitly asks for payment date, use payment date filtering. When the user explicitly asks for creation date, use creation-date filtering. If the user gives a date but does not make the date type clear and no lifecycle/status wording implies the date axis, ask for clarification. Do not ask this clarification when the wording includes completed, terminated, cancelled, or requiring attention because those lifecycle terms provide the date axis. Support combinations of the currently supported status, date, and curated file-level header or setup filters. If a prompt mixes a supported payment-file search with unsupported asks such as payment mode, virtual card, VC, VCC, funding card account, RCN, financing program, installment-level validation drilldown, payment-row drilldown, rescheduled-payment analysis, SWIFT beneficiary-delivery tracking, transmission or acknowledgement diagnosis, or direct acknowledgment file reference lookup, answer only the supported payment-file search portion and state the unsupported portion clearly instead of implying it was queried. If the user asks for a specific payment file's fields, status, or detailed view by reference, use paymentFile.viewPaymentFileDetails. If the user provides an impossible calendar date for any date filter, do not build a query; set clarificationRequired to Yes and ask for a valid date or date range.\",      \"summarizationGuidelines\": \"Lead with the business finding, not the search mechanics. State how many payment files matched the requested scope, what lifecycle stage or status pattern matters most, and whether the returned files indicate simple lookup, follow-up review, or no action. Use the returned status to explain the business meaning of the current stage when helpful, but avoid filler openings such as `Here are the ...` and avoid unnecessary meta commentary. When a default date window is auto-applied, state it explicitly in the opening answer sentence. Distinguish printed-file and electronic-file progression correctly; for example, a file ready for printing needs print follow-up, while a formatted electronic file may still be waiting for transmission or acknowledgment. For completed payment-file questions, keep the answer strictly on completed payment-file outcomes and do not switch into failed-validation or other requiring-attention PPR framing. For completed payment-file questions with no user-supplied date, explicitly state that the results use the default last-30-days completed window and that rows are ordered by completion date descending. For completed payment-file questions with an explicit date filter, mention the user-requested completion date window and state that results are ordered by completion date descending. For terminated payment-file questions with no user-supplied date, explicitly state that the results use the default last-30-days terminated window and that rows are ordered by termination date descending. For terminated payment-file questions with an explicit date filter, mention the user-requested terminated date window and keep the answer focused on the terminated outcome rather than generic status narration, and state that results are ordered by termination date descending. For requiring-attention payment-file questions with no user-supplied date, explicitly state that the results use the default last-30-days requiring-attention window and that rows are ordered by pending-since descending. For requiring-attention payment-file questions with an explicit date filter, mention the user-requested pending-since window and state that results are ordered by pending-since descending. For payment-date payment-file questions, mention the requested payment-date window and state that results are ordered by payment date descending. For requiring-attention, blocked, pending-action, or review questions, explain why the returned lifecycle stage matters in plain language. For no-result cases, answer directly with a clean business statement and do not show an empty table. For broad list or status-overview questions, summarize the dominant pattern instead of listing mechanics. Do not mention internal field names, source names, backend identifiers, `records found`, `matching your criteria`, or how the query was built. If part of the request is outside current scope, separate the supported answer from the unsupported portion in plain business language. If a table is shown for payment-file list results, lead with payment-file identifiers and payment-file status before PPR context. For status enquiries that belong to a dedicated lifecycle intent, do not answer from Find Payment Files; route to the owning lifecycle intent so list/status and diagnosis remain in the same functional bucket.\",      \"recommendationGuidelines\": \"Generate 1 to 3 concrete follow-up inquiries only when they are supported by the returned payment-file data or the user asks what to do next. Prefer contextual next steps such as narrowing by date, status, payment process request, payment method, disbursement bank account, payment process profile, payment file processing type, payments confirmed, payment system, payment system account, format name, or reviewing the most relevant returned payment file. When the returned lifecycle stage suggests acknowledgment, transmission, rejected-payment, or creation-failure follow-up, recommend the corresponding inquiry rather than an execution action. Do not recommend exports, spreadsheets, dashboards, rerunning a search, verifying filters, or repeating the original question. If part of the request is unsupported, do not suggest unsupported follow-up actions for that portion. For stage-owned statuses, recommendations must come from the owning lifecycle intent rather than this generic discovery intent.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks only to show payment files with no status, date, reference, PPR name, or active context.\",            \"question\": \"Please provide a few more details. You can search by status, creation date, payment date, PPR name, payment file reference, payment method, disbursement bank account, payment process profile, payment file processing type, payments confirmed, payment system, payment system account, or format name.\"          },          {            \"when\": \"The user provides only a date or date range without saying whether it is creation date or payment date and does not provide lifecycle wording that implies the date axis, such as completed, terminated, cancelled, or requiring attention.\",            \"question\": \"Should I use that date as the creation date or the payment date?\"          },          {            \"when\": \"The user asks to search by payment file reference but does not provide the reference.\",            \"question\": \"Please specify the payment file reference.\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentFileSearchSummary\",              \"description\": \"Use for grouped, counted, or status-overview payment-file search results.\",              \"title\": \"Payment File Search Summary\",              \"columns\": [                \"Grouping Value\",                \"Payment File Count\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileSearchResults\",              \"description\": \"Use for generic filtered payment-file list results that do not need attribute-specific expansion.\",              \"title\": \"Payment Files\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Process Request Name\",                \"Payment File Creation Date\",                \"Payment Date\",                \"Payments Recorded\"              ]            },            {              \"key\": \"paymentFileAttributeSearchResults\",              \"description\": \"Use for attribute-based filtered payment-file list results. Always show the base file columns and Payments Recorded, then include only the user-requested filter attribute columns that explain why the row matched.\",              \"title\": \"Payment Files\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Process Request Name\",                \"Payment File Creation Date\",                \"Payment Date\",                \"Payment Method\",                \"Disbursement Bank Account\",                \"Payment Process Profile\",                \"Payment File Processing Type\",                \"Payments Confirmed\",                \"Payment System\",                \"Payment System Account\",                \"Format Name\",                \"Payments Recorded\"              ]            }          ]        }      },      \"additionalInstructions\": \"Supported Find Payment Files scope includes generic request-lifecycle searches using requestStatusCode such as completed, terminated, and requiring-attention; non-stage-owned explicit paymentFileStatusCode searches; creation-date and payment-date searches; related payment process request search; and curated file-level header or setup attributes: Payment Method, Disbursement Bank Account, Payment Process Profile, Payment File Processing Type, Payments Confirmed, Payment System, Payment System Account, and Format Name. Explicitly unsupported filter criteria for this intent are Payment Mode, virtual card, VC, VCC, funding card account, RCN, and Financing Program. Do not use PayablesPaymentProcessRequestDetails virtual-card, funding-card-account, or financing-program shape drivers for this intent, and do not build queries for prompts such as Show virtual card payment files requiring attention, Show payment files with payment mode virtual card, Show payment files for funding card account ..., or Show payment files with financing program .... Use the curated attributes only for file-level list, filter, grouping, count, or display requests. For attribute-based file searches, the display contract is the compact file-identification set plus the searched attribute columns and Payments Recorded; omit unrelated all-empty attribute columns. Known-payment-file field questions belong to Review Payment File Details. Payment-row questions inside a file belong to Drill Down on Payment Files. Dedicated lifecycle intents own their stage statuses, including enquiry-only list, count, and status prompts. Creation and Validation owns CREATION_ERROR and RETRY_CREATION. Transmission owns TRANSMISSION_FAILED, FORMATTED_READY_TO_TRANSMIT, TRANSMITTED, and TRANSMITTED_PENDING_ACK. Printing owns CREATED_READY_FOR_PRINTING, FORMATTED_READY_FOR_PRINTING, SUBMITTED_FOR_PRINTING, and PRINTED. Disbursement Acknowledgement owns ACKNOWLEDGED, PARTIALLY_ACKNOWLEDGED, PENDING_ACK, PENDING_ACTION_ACK_FAILURE, PROCESSING_ACK, and REJECTED payment-file status wording. Formatting status wording does not have a dedicated bucket in this target taxonomy, so keep CREATED_READY_FOR_FORMATTING, FORMATTED_ELECTRONIC, FORMATTED, and FORMATTING_FAILED as Find Payment Files status inquiries unless the user asks for another supported lifecycle investigation. For lifecycle payment-file searches built on requestStatusCode, always add `paymentFileReference != null` so the EV result excludes PPR-only rows with no payment-file context. Apply this to completed, terminated, and requiring-attention payment-file searches, including date-scoped and default-recency variants. For generic status-only search with no date, default to the last 30 days using payment process request creation date. For lifecycle status searches with a supplied date, use the lifecycle date axis: completed uses completionDate, terminated/cancelled uses terminationDate, and requiring-attention uses pendingSince. Treat generic terminated as a request-lifecycle search unless the user explicitly asks for payment-file status or status code TERMINATED. Keep this intent list-oriented and search-oriented.\"    },    {      \"key\": \"paymentFile.viewPaymentFileDetails\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Review Payment File Details\",      \"intentDomainKnowledge\": \"Review Payment File Details is for the payment file as the primary object. It answers concise file-header and file-level field questions for a known payment file without drilling into payment, payee, invoice, or acknowledgement-file processing details.\",      \"description\": \"Reviews the file-level detail view for a known payment file, including current status, related payment process request, dates, payment method, disbursement bank account, payment process profile, processing type, payments confirmed, payment system, payment system account, format name, and returned file-level attributes.\",      \"nlpExamples\": [        \"Show payment file details having reference 1234.\",        \"Fetch payment file using payment file reference 40978.\",        \"Show payment file status for payment file reference 40978.\",        \"Show me the payment file for PPR PPR-1802.\",        \"Which payment method is used for payment file 439094?\",        \"Show the disbursement bank account for payment file 439094.\",        \"What payment process profile and format name are used for payment file 439094?\",        \"Show the payment system account for payment file 439094.\"      ],      \"data\": {        \"goal\": \"Return a focused payment-file detail view that answers the user's field-level or status question about a known payment file.\",        \"slices\": [          \"Payment-file detail by exact reference.\",          \"Payment-file detail by closely scoped payment process request context when the user is clearly asking for the related file.\",          \"Field-oriented payment-file detail such as status, dates, payment method, disbursement bank account, payment process profile, payment file processing type, payments confirmed, payment system, payment system account, format name, or other returned file-level attributes.\"        ]      },      \"promptInstruction\": \"Use `PayablesPaymentProcessRequestDetails` for file-level payment-file detail retrieval when the user identifies a specific payment file reference or asks for detailed fields about a known payment file. Prefer this intent over `paymentFile.searchPaymentFiles` when the question is about one payment file's status, fields, dates, or returned file-level attributes. Supported file-level detail attributes include Payment Method, Disbursement Bank Account, Payment Process Profile, Payment File Processing Type, Payments Confirmed, Payment System, Payment System Account, and Format Name. Answer the requested field first, then include the surrounding file context needed to make the answer useful. If the user asks for payment file details for a related payment process request, use the payment process request only as payment-file lookup context. If that related payment process request text is a quick-payment placeholder such as `Quick payment: ID=...`, treat it as a separate unsupported quick-payment flow rather than a true payment process request and do not attempt PPR lookup, payment-file lookup, or unrelated entity disambiguation. If the user asks to review rejected payments, acknowledgements, transmission issues, creation-failure diagnosis, or actions on the file, route to the corresponding payment-file child intent instead of overloading this detail intent. If the user identifies only a broad status, file-level attribute, or date filter and is asking for a list, grouping, or count, use `paymentFile.searchPaymentFiles` instead. If the user provides an impossible calendar date for any date filter, do not route unsupported and do not build a query; set clarificationRequired to Yes and ask for a valid date or date range. Use this intent for file-level detail only. If the user asks who or what is inside the file, route to paymentFile.drillDownOnPaymentFiles. If the user asks for a lifecycle-stage status or diagnosis owned by creation/validation, transmission, printing, or acknowledgement, route to that lifecycle intent.\",      \"summarizationGuidelines\": \"Lead directly with the payment file's status and the specific detail the user asked for. Explain what the current file status means operationally only when that helps answer the question. For a single matched file, name the payment file reference, related payment process request when returned, and the key status or dates that matter. Avoid procedural phrasing such as `Here are the results` or `one record was returned`. Keep the response file-level and concise; do not expand into payment, supplier, invoice, transmission, printing, or acknowledgement diagnosis unless the user asks for that functional bucket.\",      \"recommendationGuidelines\": \"Generate 1 to 3 follow-up inquiries that help the user continue investigating the same payment file. Prefer context-aware next steps such as reviewing acknowledgements, transmission details, rejected payments, or related payment process request context when the returned file status suggests those paths. Avoid broad unrelated searches. For unsupported quick-payment placeholder requests, do not generate payment-file follow-up recommendations.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for payment file details but does not identify a payment file reference, payment process request, or active payment-file context.\",            \"question\": \"Which payment file should I use? Please provide the payment file reference or the related payment process request.\"          },          {            \"when\": \"The user asks for payment file details by payment file reference but does not provide the reference.\",            \"question\": \"Please specify the payment file reference.\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileDetailsByReference\",              \"description\": \"Use for the primary payment-file detail view.\",              \"title\": \"Payment File Details\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Process Request Name\",                \"Payment File Creation Date\",                \"Payment Date\",                \"Payment Method\",                \"Disbursement Bank Account\",                \"Payment Process Profile\",                \"Payment File Processing Type\",                \"Payments Confirmed\",                \"Payment System\",                \"Payment System Account\",                \"Format Name\",                \"Payments Recorded\"              ]            }          ]        }      },      \"additionalInstructions\": \"Keep this intent focused on the detailed view of a known payment file using existing returned file-level fields. Payment-file detail output should lead with Payment File Reference and Payment File Status, use Payment Process Request Name for PPR context, and avoid showing Payment Process Creation Date unless the user explicitly asks for payment-process creation timing. It may answer field-specific questions about the file, including the curated file-level attributes Payment Method, Disbursement Bank Account, Payment Process Profile, Payment File Processing Type, Payments Confirmed, Payment System, Payment System Account, and Format Name, but it should not turn into a broad search flow or a specialized issue-diagnosis flow. This intent remains separate from Drill Down on Payment Files so file-level detail questions do not get confused with payment, payee, invoice, or rejected-item drill-down.\"    },    {      \"key\": \"paymentFile.drillDownOnPaymentFiles\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Drill Down on Payment Files\",      \"intentDomainKnowledge\": \"Drill Down on Payment Files owns payment-file contents and payment-level impact analysis. It absorbs the previous rejected-payment review behavior and keeps it focused on payments, payees, invoices, installments, rejected items, voids, and setup gaps inside a file. Payment-file rejected payment inquiries focus on payments or installments inside a payment file that were rejected by acknowledgement processing or returned by the bank. Rejected payments, acknowledgement failure bank error, and supported payment-file details inquiries map to this same rejected-payment review intent. For this Payment File Agent scope, disbursement-side paymentStatus.lookupCode = VOID with a payment error should be displayed as Acknowledgment Rejected when answering acknowledgement-rejection questions about installments or rejected payments. For voided-payment questions such as payments voided through JPM acknowledgement files, use the AP checks-backed payment status exposed through `payablesPayment.paymentStatus.lookupCode = 'VOIDED'`, not the disbursement-side `paymentStatus.lookupCode = 'VOID'`. Bank error detail can come from payment exceptions or disbursement payment error fields. Supplier, invoice, installment, and payment-file context can require composing Payment Run Installments, Disbursement Payments, and Payment Exceptions. Summaries should group repeated returned errors by error code, supplier, invoice/payment count, and payment file when those values are present. Taxpayer ID is not in scope. L1, L2, and L3 acknowledgement classification is not reliably exposed, so JPM acknowledgement-linked voided payments should be found using payment system, inbound file linkage, AP payment status, and void date rather than claiming true L2 classification.\",      \"description\": \"Explains who and what is inside a payment file, including payments, payees, suppliers, invoices, installments, rejected items, voided payments, bank error detail, and missing legal entity checks where supported.\",      \"nlpExamples\": [        \"Show payments inside payment file 236093.\",        \"Which suppliers and invoices are affected in payment file 236093?\",        \"Show rejected items in payment file 236093.\",        \"Show me installments that are in acknowledgment rejected status.\",        \"Show me installments in payment file 236093 that are in acknowledgment rejected status.\",        \"What is the reason of acknowledgment failure for payment file 236093?\",        \"What error did the bank provide for acknowledgment rejection of payment file 236093?\",        \"Show rejected payments within partially acknowledged files.\",        \"Show me rejected payments with error codes, suppliers, and invoice details.\",        \"Summarize rejected payments by bank error and supplier.\",        \"Which invoices are impacted by bank acknowledgement failure for payment file 236093?\",        \"Show me all payments that were voided through JPM L2 acknowledgment files in the last week.\",        \"Show me why, for payments in payment file 40925, legal entity is null for some suppliers?\"      ],      \"data\": {        \"goal\": \"Show the rejected payment or installment rows inside payment-file context with the error reason, supplier, invoice, payment, repeated-error grouping, and impacted setup details needed for operational triage.\",        \"slices\": [          \"Acknowledgement-rejected installment slice: use `paymentRunInstallmentsExtraction` first for broad acknowledgement-rejected installment or rejected-payment questions that need invoice detail and do not provide a payment file, supplier, date range, or active context; default those broad questions to the last 30 days using extraction alias `acknowledgementFileCreatedOn` with Oracle ANSI TIMESTAMP literals. Use direct `paymentRunInstallments` BV primarily for payment-file-scoped acknowledgement-rejected installment questions or as fallback when extraction is unavailable. Filter acknowledgement-rejected evidence with disbursement-side `paymentStatus.lookupCode = VOID` plus a payment error such as `bepErrorCode is not null` where available; do not use inbound-file processing status as the acknowledgement-rejected payment status and do not require literal REJECTED status. For payment-file-scoped acknowledgement-rejected installment questions, filter by payment file id and do not add a default date constraint. For the displayed Payment Number in installment output, use `payablesDisbursementPayment.paymentReferenceNumber`. Include invoice amount when the selected source exposes it; if invoice amount is unavailable, return the supported invoice, supplier, payment, status, and error fields instead of rejecting the whole request as unsupported.\",          \"Partially acknowledged file rejected-payment slice: when the user asks for rejected payments within partially acknowledged files, keep the same acknowledgement-rejected payment evidence and add parent payment-file status `PARTIALLY_ACKNOWLEDGED`. Prefer `paymentRunInstallmentsExtraction` when supplier, invoice, installment, or payment detail is requested. Default broad questions without a file, supplier, date range, or active context to the last 30 days using `acknowledgementFileCreatedOn` with Oracle ANSI TIMESTAMP literals.\",          \"Bank error slice: for payment-file-scoped acknowledgement failure or bank-provided error questions, use `disbursementPayments` or `disbursementPaymentsExtraction` when the user needs payment-level error code/message only, because BEP error fields are top-level and backend-safe there. Use `paymentRunInstallmentsExtraction` when invoice/installment context is required. Do not use direct `paymentRunInstallments` BV `$fields` for nested `payablesDisbursementPayment.*` BEP or status projections. Use `disbursementPaymentExceptions` only for payment-level exception rows. Return error code, error message, payment number, supplier, invoice when available, and file context. Group repeated bank errors by error code/message and affected supplier or invoice count when the rows support it. Do not answer a bank-error question from acknowledgement inbound-file status alone.\",          \"JPM acknowledgement-linked voided payment slice: use `disbursementPayments` and optional `paymentAcknowledgements` context filtered to AP payment status `payablesPayment.paymentStatus.lookupCode = 'VOIDED'`, inbound file linkage, JPM payment system, and requested `voidDate` range; do not use disbursement-side `paymentStatus.lookupCode = 'VOID'` for this voided-payment inquiry and do not claim reliable L2 classification.\",          \"Missing legal entity slice: use `disbursementPayments` filtered by payment file id and null legal entity id; omit taxpayer id because it is not in current scope.\"        ]      },      \"promptInstruction\": \"Use `paymentRunInstallmentsExtraction` first when the user asks broad rejected-payment or acknowledgment-rejected installment questions that need invoice numbers, invoice dates, invoice amount, installment numbers, supplier, or invoice detail and the user has not provided a payment file, supplier, date range, or active context. Treat rejected payments, acknowledgment failure bank error, and supported payment-file detail inquiries as aliases for this intent. Use `paymentRunInstallmentsExtraction` for payment-file-scoped acknowledgment-rejected installment queries when invoice/installment detail and BEP error fields are required. Do not use direct `paymentRunInstallments` BV to project nested `payablesDisbursementPayment.*` BEP or status fields; the backend can reject those nested accessor projections. Use direct `paymentRunInstallments` BV only for parser-safe installment context that does not require nested disbursement-payment BEP fields. For acknowledgment-rejected installment queries that use `paymentRunInstallmentsExtraction`, use the existing installments-in-payment-file field set and display Payment Number from extraction alias `paymentReferenceNumber`, which is sourced from the resulting disbursement payment reference; do not use AP payment number alias `payablesPayment.paymentNumber` for that display column. Use `disbursementPayments` or `disbursementPaymentsExtraction` for payment number, payment date, payment amount, payment method, supplier, bank account, legal entity, payment status, and payment-file reference. Use `disbursementPaymentExceptions` when bank or payment error message detail is needed. For acknowledgment-rejected rows, require disbursement-side `paymentStatus.lookupCode = 'VOID'` and a payment error such as `bepErrorCode is not null` in extraction SQL or `bepErrorCode != null` in BV filters when available; do not use `inboundFileProcessingStatus` as the rejected-payment status. Treat disbursement-side `paymentStatus.lookupCode = 'VOID'` as user-facing status `Acknowledgment Rejected`. Normalize the visible Payment Status field to `Acknowledgment Rejected` for acknowledgment-rejected and bank-error answers; preserve raw Void context only in prose when it helps clarify the returned data, such as `Acknowledgment Rejected (Void)`. For broad acknowledgment-rejected installment or rejected-payment questions without a payment file, supplier, date range, or active context, do not ask for clarification; use `paymentRunInstallmentsExtraction` and default to the last 30 days using acknowledgment inbound file alias `acknowledgementFileCreatedOn` with Oracle ANSI TIMESTAMP literals such as `acknowledgementFileCreatedOn >= TIMESTAMP '2026-05-18 00:00:00'`. Do not generate a direct `paymentRunInstallments` BV filter on `payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated`, because that deep path is not parser-safe for this broad REST filter. Do not emit plain quoted date strings for extraction datetime comparisons. When the user asks for rejected payments within partially acknowledged files, preserve the same rejected-payment evidence and add the parent payment-file filter `paymentFileProcessingStatusLookupCode='PARTIALLY_ACKNOWLEDGED'`. For broad partially acknowledged file questions without a payment file, supplier, date range, or active context, default to the last 30 days using `acknowledgementFileCreatedOn`. For payment-file-scoped acknowledgment-rejected installment questions, filter by the payment file id and do not add a default date constraint. For JPM acknowledgment-linked voided-payment questions, treat `JPM` as a payment-system or bank qualifier in this payment-file context, not as a supplier/site/entity-resolution request. Use `disbursementPayments` or `disbursementPaymentsExtraction` with `disbursementInboundFile.id is not null`, `disbursementInboundFile.paymentSystem.paymentSystemName like '%JPM%'`, and AP checks-backed `payablesPayment.paymentStatus.lookupCode = 'VOIDED'`; do not use disbursement-side `paymentStatus.lookupCode = 'VOID'` for this voided-payment use case. When the user gives a period for voided JPM acknowledgment-linked payments, apply it to `voidDate`; for example, if the response date is 2026-06-18 and the user asks for the last one week, use `voidDate >= '2026-06-11'` in BV filters or the equivalent date literal in extraction SQL. Return the AP payment status meaning when available and display it as the payment status. For rejected payment output, include invoice number, invoice date, invoice amount when exposed by the selected source, installment number, payment number, payment date, error code, error message, payment status, payment file reference, and supplier when available. If invoice amount is not exposed by the selected source, omit only invoice amount and continue with the supported rejected-payment fields; do not return a whole-query unsupported response for invoice amount alone. For bank-provided error questions, show the error code exactly as data returns it, such as NAAR when that is the stored value; do not normalize it. When the user only asks for the bank-provided error, error code, or error message for a payment file, prefer `disbursementPayments` or `disbursementPaymentsExtraction` because `bepErrorCode` and `bepErrorMessageText` are top-level backend-safe fields there; filter by `payablesPaymentFile.paymentInstructionId` in BV or `paymentInstructionId` in extraction. When invoice or installment context is required, use `paymentRunInstallmentsExtraction` with aliases `bepErrorCode` and `bepErrorMessageText`, not direct `paymentRunInstallments` nested BV `$fields`. Use payment exception rows only when they actually return matching payment-level exception evidence. When rows return repeated errors, summarize the dominant error code/message and affected suppliers or invoices before the detail table. If the prompt mixes supported rejected-payment review with unsupported asks such as a separate rejected payment-file list, accepted-versus-rejected payment breakout, or rescheduled-status analysis, answer only the supported rejected-payment portion and state the unsupported portion clearly. For missing legal entity questions, filter `legalEntity.legalEntityId = null` and return payment amount, legal entity id, creation date, disbursement bank account, inbound file status, payment date, payment system, payment number, supplier, and payment method; taxpayer id is not in scope. For JPM L2 acknowledgment questions, support JPM acknowledgment-linked voided payments by using payment system and inbound file linkage, but state that explicit L2 classification is not supported by current backend fields. If no acknowledgment exists for the payment file, say that directly rather than implying bank rejection. Use these headings where applicable: `Installments in Acknowledgment Rejected Status`, `Installment Summary for Payment File Reference <id>`, `Voided Payments Summary`, `Payment File Analysis for Instruction ID <id>`, and `Rejected Payments Summary`. If the user provides an impossible calendar date for any date filter, do not route unsupported and do not build a query; set clarificationRequired to Yes and ask for a valid date or date range. This intent is the owner for payment-level and invoice-level drill-down inside payment files. Keep rejected payments, acknowledgement-rejected installments, BEP bank error detail, JPM acknowledgement-linked voided payments, and missing legal entity checks here. Do not use this intent for file-level acknowledgement-file processing, pending acknowledgement aging, unprocessed acknowledgement counts, transmission status, print status, or creation/validation failure diagnosis unless those details are only needed as context for the contained payments.\",      \"summarizationGuidelines\": \"Open with the rejected payment count, voided-payment count, missing-legal-entity count, or the specific bank error reason. For file-scoped questions, include the payment file id in the first sentence. For broad acknowledgment-rejected installment or rejected-payment searches that return no rows, do not say `Results shown`; open with `No acknowledgment-rejected payments were found from <start date> onward based on acknowledgment file creation date` or equivalent. For rejected payments within partially acknowledged files, state that the result is limited to payment files whose parent file status is `Partially Acknowledged` before summarizing dominant errors or suppliers. For no-row bank-error, JPM voided-payment, or missing-legal-entity answers, name the exact applied basis such as the acknowledgment date window, Acknowledgment Rejected status, bank-error requirement, JPM payment-system scope, void date window, payment file reference, or null legal entity filter. Do not describe the default `acknowledgementFileCreatedOn` filter as payment-file creation date. For acknowledgment-rejected rows, describe the status as Acknowledgment Rejected and preserve the visible Void context when it helps clarify the raw data, such as `Acknowledgment Rejected (Void)`. For bank-error results, state the dominant returned error code/message and how many payments, invoices, suppliers, or payment files it affects when those fields are returned. For JPM acknowledgment-linked voided-payment rows, state the void date window and JPM payment-system scope, and use the AP payment status returned from `payablesPayment.paymentStatus` rather than the disbursement-side status. Group repeated bank errors when the same error applies to multiple invoices or installments, but keep invoice-level detail visible when requested. For missing legal entity rows, make the null legal entity count and affected supplier/payment context the lead finding, not a generic details statement. If the question also includes unsupported rejected-payment-file or rescheduled-payment asks, state that boundary separately rather than implying those details were returned as no rows. Frame answers as file-content or payment-impact drill-down, not as file lifecycle diagnosis.\",      \"recommendationGuidelines\": \"Recommend reviewing the bank-provided error, correcting supplier or payment setup that caused missing values, using the payment-file action path for retry or force acknowledge when appropriate, or reviewing affected invoices before reissue only when rows are returned with supporting error, supplier, invoice, or payment-file evidence. When a dominant bank error is returned, recommend addressing that shared error before reviewing one-off rows. When missing legal entity rows are returned, recommend correcting the impacted supplier/payment setup field that is actually absent in the data. For no-row results, omit the action block unless the user explicitly asks what to do next; if asked, use investigation-expansion next steps such as widening the acknowledgment date range or providing a payment file reference to check a specific file. Avoid taxpayer-id recommendations, unsupported rescheduled-payment follow-up, and claiming L2-specific remediation when L2 classification is unavailable.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for rejected payments without a payment file, date range, supplier, or active context, except broad acknowledgement-rejected installment questions, which default to the last 30 days.\",            \"question\": \"Which payment file or date range should I use for rejected payments?\"          },          {            \"when\": \"The user asks for a bank error for this payment file but there is no active payment-file context.\",            \"question\": \"Which payment file should I inspect for the bank acknowledgement error?\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentFileRejectedPaymentSummary\",              \"description\": \"Use for a high-level rejected payment count or grouped error summary.\",              \"title\": \"Rejected Payments Summary\",              \"columns\": [                \"Payment File\",                \"Rejected Payment Count\",                \"Dominant Error Code\",                \"Dominant Error Message\",                \"Affected Suppliers\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileRejectedPaymentDetails\",              \"description\": \"Use for rejected payment and acknowledgement-rejected installment detail.\",              \"title\": \"Installment Details\",              \"columns\": [                \"Invoice Number\",                \"Invoice Date\",                \"Invoice Amount\",                \"Installment Number\",                \"Payment Number\",                \"Payment Date\",                \"Error Code\",                \"Error Message\",                \"Payment Status\",                \"Payment File Reference\",                \"Supplier\"              ]            },            {              \"key\": \"paymentFileMissingLegalEntityPayments\",              \"description\": \"Use when legal entity is null for payments in a payment file.\",              \"title\": \"Payment File Analysis\",              \"columns\": [                \"Payment Amount (USD)\",                \"Legal Entity Id\",                \"Creation Date\",                \"Disbursement Bank Account\",                \"Inbound File Status\",                \"Payment Date\",                \"Payment System\",                \"Payment Number\",                \"Supplier\",                \"Payment Method\"              ]            },            {              \"key\": \"acknowledgementLinkedVoidedPayments\",              \"description\": \"Use for JPM acknowledgement-linked voided payments without claiming reliable L-level classification.\",              \"title\": \"Voided Payments Summary\",              \"columns\": [                \"Payment Number\",                \"Payment Date\",                \"Payment Method\",                \"Payment Amount\",                \"Supplier\",                \"Bank\",                \"Payment File Reference\",                \"Payment Status\",                \"Inbound File Name\",                \"Inbound File Status\",                \"Payment System\"              ]            }          ]        }      },      \"additionalInstructions\": \"Rejected payments and acknowledgement failure bank error are aliases for this supported rejected-payment and bank-error scope. Display disbursement-side `paymentStatus.lookupCode = VOID` as `Acknowledgment Rejected`, while preserving raw Void context such as `Acknowledgment Rejected (Void)` in summaries when helpful. Do not require literal REJECTED status for acknowledgement-rejected installment or bank-error questions; VOID with BEP/payment error evidence is the supported acknowledgement-rejected signal. For rejected payments within partially acknowledged files, add the parent payment-file filter `paymentFileProcessingStatusLookupCode='PARTIALLY_ACKNOWLEDGED'` in the selected extraction path and make that scope explicit in the summary. For JPM acknowledgement-linked voided payments, use AP checks-backed `payablesPayment.paymentStatus.lookupCode = 'VOIDED'` and date-filter on `voidDate`; do not use disbursement-side `paymentStatus.lookupCode = 'VOID'` for that voided-payment question and do not expand `JPM` into broad supplier, site, payment method, or legal-entity ambiguity. For acknowledgement-rejected installment rows, display Payment Number from extraction alias `paymentReferenceNumber`. Do not filter acknowledgement-rejected payments by inbound file processing status; the supported payment evidence is disbursement-side `paymentStatus.lookupCode = VOID` with BEP/payment error detail where available. Broad acknowledgement-rejected installment or rejected-payment queries that need invoice detail and have no payment file, supplier, date range, or active context must use `paymentRunInstallmentsExtraction` with `acknowledgementFileCreatedOn` and Oracle ANSI TIMESTAMP literals; do not use a direct BV filter on `payablesDisbursementPayment.payablesPaymentFile.disbursementInboundFile.timeCreated` for that broad REST path. Keep unsupported details-inquiry examples, such as taxpayer-id analysis, out of this intent until the shape coverage is added. Use `Installments in Acknowledgment Rejected Status` or `Installment Summary for Payment File Reference <id>` for acknowledgement-rejected installment answers, `Payment File Analysis for Instruction ID <id>` for missing-legal-entity answers, `Voided Payments Summary` for JPM acknowledgement-linked voided payment answers, and `Rejected Payments Summary` / `Installment Details` for rejected-payment detail. For payment-file bank acknowledgement error questions, do not generate direct `paymentRunInstallments` BV `$fields` using `payablesDisbursementPayment.bepErrorCode`, `payablesDisbursementPayment.bepErrorMessageText`, or nested payment status fields. Use `disbursementPayments` / `disbursementPaymentsExtraction` for payment-level BEP errors, and `paymentRunInstallmentsExtraction` only when invoice or installment columns are required. Payment-file status REJECTED as a file-level acknowledgement outcome belongs to Review Disbursement Acknowledgement Files; rejected payment, invoice, supplier, installment, and voided-payment rows belong here.\"    },    {      \"key\": \"paymentFile.reviewPaymentFileCreationAndValidation\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Review Payment File Creation and Validation\",      \"intentDomainKnowledge\": \"Payment file creation and validation is the part of the lifecycle before downstream formatting, transmission, printing, or acknowledgement processing. This intent owns supported creation/validation-stage status enquiries and diagnosis. Payment file creation is the stage where payments selected by a Payment Process Request are grouped into one or more payment files for further processing. This intent is for questions about payment files whose creation has started but ended in a supported creation-failure state. It helps the user understand the current payment-file creation state, the returned creation-failure reason, and the affected Payment Process Request context.\",      \"description\": \"Reviews payment-file creation and validation-stage issues, including why file creation failed, supported creation-failure statuses, related validation-stage context, and affected Payment Process Request context.\",      \"nlpExamples\": [        \"Show me why payment file creation has failed for PPR-1802.\",        \"Why did payment file creation fail for this payment request?\",        \"Show creation failure details for the payment file from PPR-1802.\",        \"Which error caused payment file creation to terminate?\",        \"Summarize the payment file creation failure and recommended next step.\",        \"Show payment files with payment validation errors in the last 10 days.\",        \"Show payment files in failed validation and pending action status.\",        \"Show payment files in retry payment file validation status.\"      ],      \"data\": {        \"goal\": \"Help the user understand the current payment file creation failure reason and the related Payment Process Request context within the supported creation-failure scope.\",        \"slices\": [          \"Payment Process Request resolver slice: use Payment Process Request context to locate the related payment-file creation failure when the user starts from a PPR.\",          \"Creation failure detail slice: use the supported creation-failure exception detail for payment file reference, error message, Payment Process Request name, and payment file status.\",          \"File-level payment validation error list slice: use `disbursementPaymentInstructions.paymentValidationErrorPaymentFiles` for prompts such as `show payment files with payment validation errors in the last 10 days`. This is supported as a file-level validation-stage list and must not be treated as the unsupported installment-level validation drilldown. Apply the requested rolling date window to payment-file `timeCreated`, keep the filter to file-level validation or retry-validation statuses, and return validation-stage columns such as payment count, processing type, payment file format, creation date, error code, and error message when available. Do not include transmission configuration, transmission protocol, or other transmission-only fields.\",          \"No-match slice: if supported exception-detail queries return no rows, report that no matching payment-file creation-failure exception detail was found for the supplied context rather than inferring failure from the attempted filter.\"        ]      },      \"promptInstruction\": \"Use `disbursementPaymentInstructionExceptions` and `disbursementPaymentInstructionExceptionsExtraction` as the primary sources for creation-failure detail. For broad file-level validation-error list prompts such as `show payment files with payment validation errors in the last 10 days`, use `disbursementPaymentInstructions.paymentValidationErrorPaymentFiles`; apply `paymentFileProcessingStatus.lookupCode in ('CREATION_ERROR','RETRY_CREATION')`, apply the requested rolling date window to payment-file `timeCreated`, and do not mark the request unsupported. Treat this as file-level validation-stage review only. Do not attempt installment-level validation drilldown unless the user explicitly asks for installment-level validation detail; if they do, answer the supported file-level portion and state directly that installment-level validation-failure detail is not supported in the current payment-file validation response. Treat identifiers explicitly introduced as Payment Process Requests, such as `PPR-1802`, as Payment Process Request context for this intent and do not broaden them into supplier, site, or other generic entity ambiguity. Filter by the related Payment Process Request name when provided, and apply only the supported creation-failure statuses `CREATION_ERROR`, `RETRY_CREATION`, and `TERMINATED` for creation-failure diagnosis. State that the file is in a creation-failure status only when an exception-detail row is actually returned with one of those supported creation-failure statuses. If exception-detail queries return no rows, say that no matching payment-file creation-failure exception detail was found for the supplied Payment Process Request context, and mention that the supplied Payment Process Request name may not match the source data, the file may not be in a supported creation-failure status, or exception detail may not be available. Use Payment Process Request context only to resolve or display the related Payment Process Request name when needed. Return payment file reference, error message, Payment Process Request name, and payment file status when available. Use the heading `Payment File Creation Summary for Payment Process Request '<PPR name>'` when the Payment Process Request name is known. If the user provides an impossible calendar date for any date filter, do not build a query; set clarificationRequired to Yes and ask for a valid date or date range. This intent owns creation/validation status enquiries as well as diagnosis. Route status-only list or count prompts for CREATION_ERROR and RETRY_CREATION here rather than to Find Payment Files. Keep the existing exception-first behavior for why/diagnosis questions and do not invent validation detail when the current shapes do not return it.\",      \"summarizationGuidelines\": \"Open with the specific creation-failure reason if an exception row returns one, followed by the payment file status and related Payment Process Request. If multiple creation-failure rows are returned, group them by returned status, Payment Process Request, and common error message before showing detail. If exception detail returns no rows, open by saying that no matching payment-file creation-failure exception detail was found for the supplied context; do not say the file is in a creation-failure status. Keep the wording focused on payment-file creation or validation, not on later acknowledgement or transmission lifecycle stages. For file-level validation-error lists, state the count, validation-stage statuses, and requested date window; show only validation-stage fields returned by the query. Do not include or mention transmission configuration or transmission protocol for validation-stage answers. Do not mention installment-level validation limitations unless the user asked for installment-level validation detail. For status-only creation/validation lists, summarize the returned file statuses and date window without implying an exception reason unless exception rows are returned.\",      \"recommendationGuidelines\": \"Recommend the next investigation step based on the returned creation-failure or validation-stage reason. If the error points to configuration or setup, recommend reviewing that setup before retrying. If the same error appears across multiple returned failures, recommend checking the shared setup before reviewing individual files. For file-level validation-error lists, ground recommendations only in returned error codes, error messages, statuses, processing types, payment file formats, or repeated patterns. Do not recommend unsupported installment-level validation queries, exports, reports, dashboards, spreadsheets, rerunning searches, or transmission setup review unless returned data explicitly shows transmission context. Do not claim that the agent can directly recreate the file.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks why payment file creation failed but does not provide a Payment Process Request or active context.\",            \"question\": \"Which Payment Process Request should I inspect for the payment file creation failure?\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileCreationFailureDetails\",              \"description\": \"Use for payment file creation failure diagnosis.\",              \"title\": \"Payment File Creation Summary\",              \"columns\": [                \"Payment File Reference\",                \"Error Message\",                \"Payment Process Request Name\",                \"Payment File Status\"              ]            },            {              \"key\": \"paymentFileValidationErrorDetails\",              \"description\": \"Use for file-level payment validation error lists. Do not use this table for installment-level validation drilldown.\",              \"title\": \"Payment Files with Validation Errors\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Count\",                \"Payment Process Request Name\",                \"Processing Type\",                \"Payment Format\",                \"Created On\",                \"Error Code\",                \"Error Message\"              ]            }          ]        }      },      \"additionalInstructions\": \"Supported creation-failure statuses in this intent are CREATION_ERROR, RETRY_CREATION, and TERMINATED. File-level payment validation error list prompts such as `show payment files with payment validation errors in the last 10 days` are supported through `disbursementPaymentInstructions.paymentValidationErrorPaymentFiles` with CREATION_ERROR and RETRY_CREATION status filters and a `timeCreated` date window. That support does not include installment-level validation-failure drilldown. Planning must remain exception-first for creation-failure diagnosis: use `disbursementPaymentInstructionExceptions` or `disbursementPaymentInstructionExceptionsExtraction` for creation-failure reason and status, and use Payment Process Request context only to resolve or display the related Payment Process Request name. Never infer a creation-failure status from an attempted filter, an empty exception response, status-only payment-file rows, or the user's phrasing alone; require returned exception rows for diagnosis answers. Use output label `Payment File Creation Summary for Payment Process Request '<PPR name>'` for diagnosis and `Payment Files with Validation Errors` for file-level validation-error lists. Creation/validation status ownership includes CREATION_ERROR and RETRY_CREATION. Generic terminated request lifecycle searches remain in Find Payment Files unless the returned evidence places the file in a supported creation-failure path.\"    },    {      \"key\": \"paymentFile.reviewPaymentFileTransmission\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Review Payment File Transmission\",      \"intentDomainKnowledge\": \"Payment file transmission is the step that sends a formatted electronic payment file to the configured payment system or bank channel. Transmission applies only to electronic payment files; printed payment files do not have a transmission stage. Transmission failure labels map to this supported transmission-review intent. Transmission inquiries can ask for failed transmissions, setup and protocol details for a specific file, files ready to transmit, or recent issues affecting the same transmission configurations. Summaries should group returned failures by transmission configuration, protocol, status, and recurring error when those fields are available so controllers can see whether the issue is isolated or setup-wide. Positive pay file transmission failures are not exposed by the current payment-file BV coverage and require log review or another backend source; do not represent positive pay failures as payment-file transmission rows. Transmission ID and transmit configuration ID are internal technical identifiers and should not be displayed to the user. Recent known issues in this scope means transmission issues only, not general payment-file or acknowledgement issues.\",      \"description\": \"Answers payment-file transmission questions, including transmission failure review, failed transmission lists, single-file failure detail, transmission configuration, ready-to-transmit files, and recent transmission setup issues.\",      \"nlpExamples\": [        \"Show me payment files that failed transmission.\",        \"Show payment files with transmission failed status between July 1st 2026 and today.\",        \"Show payment files with transmission failed status between a start date and today.\",        \"Show payment files where SFTP transmission failed, and identify whether the failure is due to an authentication error, an expired SFTP key, a host key mismatch, or a network connectivity issue.\",        \"Show me why transmission failed for payment file 41234.\",        \"Show me payment and positive pay files that failed transmission.\",        \"Show me transmission configuration of payment file 41234.\",        \"Show transmission details for all payment files ready to transmit.\",        \"Summarize payment file transmission failures by configuration and protocol.\",        \"Which transmission setup has the most failed payment files?\",        \"Are there any known issues with these setups affecting transmission recently?\",        \"Which payment files are ready to transmit?\",        \"Show payment files in formatted and ready for transmission status.\",        \"Show transmitted payment files.\",        \"Show payment files with payment file status code TRANSMITTED_PENDING_ACK.\",        \"Show payment files in transmission failed status.\",        \"Show transmission details for payment file 230085.\",        \"Is transmission applicable for payment file 230085?\"      ],      \"data\": {        \"goal\": \"Help the user triage transmission readiness and failures by showing file status, configuration, protocol, recurring error context, and grounded next actions.\",        \"slices\": [          \"Failed transmission list slice: use `disbursementPaymentInstructions` filtered to `paymentFileProcessingStatus.lookupCode = 'TRANSMISSION_FAILED'`, defaulting to the last 30 days on `timeCreated` when the user gives no date range. Explicit date-range prompts such as `show payment files with transmission failed status between July 1st 2026 and today` are supported; resolve `today` to the current date, apply the lower and upper bounds to payment-file `timeCreated`, and keep `unsupportedQuery` as No. Because `timeCreated` is datetime, generated BV filters must use full ISO datetime literals such as `timeCreated >= '2026-05-18T00:00:00Z'`, while extraction SQL must use Oracle ANSI TIMESTAMP literals such as `timeCreated >= TIMESTAMP '2026-05-18 00:00:00'`; never use date-only quoted strings. For this generic failed-transmission list slice, treat the BV as the authoritative source and do not run `disbursementPaymentInstructionsExtraction` as a secondary no-row fallback. When no rows are returned from the default recent window or supplied date range, say no failed-transmission payment files were found in that effective window. When multiple rows are returned, summarize the concentration by transmission configuration, protocol, and returned error/status when those fields are present.\",          \"Specific-file transmission applicability slice: for any specific-payment-file transmission detail, setup, readiness, or failure question, first return or verify Payment File Processing Type and Payment File Status from `disbursementPaymentInstructions` or extraction. If Processing Type is Printed, state that transmission is not applicable for the printed payment file, return its current payment-file status and relevant file context, and do not add a `TRANSMISSION_FAILED` filter unless the user explicitly asked for failed transmission rows.\",          \"Single-file transmission failure detail slice: use `disbursementPaymentInstructionExceptions` and `disbursementPaymentInstructionExceptionsExtraction` for file-level transmission error message, payment process request name, returned status, processing type, transmission configuration, and protocol.\",          \"Single-file no-match slice: if the exception-detail query returns no rows for a specific payment file, fall back to `disbursementPaymentInstructions` or `disbursementPaymentInstructionsExtraction` for the same payment file before answering. If the fallback shows `TRANSMISSION_FAILED`, return the file status, error code/message, payment process request name, transmission configuration, and protocol as status-level failure context. If both exception detail and fallback status evidence are absent, report that no matching failed-transmission detail was found.\",          \"Transmission configuration slice: use `disbursementPaymentInstructions` or extraction for payment file reference, processing type, transmission configuration name, start date, end date, and transmission protocol for a specified payment file. Use the dedicated `transmissionConfigurationDetails` output table and omit error message, payment system, and transmit configuration id unless the user explicitly asks for those fields.\",          \"Ready-to-transmit slice: use `disbursementPaymentInstructions` or `disbursementPaymentInstructionsExtraction` filtered to `paymentFileProcessingStatus.lookupCode = FORMATTED_READY_TO_TRANSMIT` and return only visible setup fields: payment file reference, processing type, transmission configuration name, start date, end date, and transmission protocol name. Do not include transmission ID, payment request name, error message, or payment system in the visible ready-to-transmit table unless the original user request explicitly asks for that context. Amplified or rewritten field lists must not widen this output contract.\",          \"Recent transmission issue slice: after a ready-to-transmit result or named setup is available, run a separate recent-exception query against `disbursementPaymentInstructionExceptions` or `disbursementPaymentInstructionExceptionsExtraction` for the relevant transmission configuration names and a default last-30-days `errorDate` window unless the user gives a date range. Only state that no recent issues were found after this exception query actually returns no rows. For no-row results, state the named configuration and effective date window without a separate action suggestion.\"        ]      },      \"promptInstruction\": \"Use `disbursementPaymentInstructions` as the primary source for payment-file transmission status, processing type, configuration, protocol, and ready-to-transmit lists. Treat transmission failure labels as aliases for this intent, but keep positive-pay and action boundaries intact. Transmission applies only to electronic payment files; printed payment files do not have a transmission stage. For any specific-payment-file transmission detail, setup, readiness, or failure question, first retrieve Payment File Processing Type and Payment File Status for the supplied `paymentInstructionId` or resolved payment file context. If the returned processing type is Printed, answer that transmission is not applicable for that printed payment file, show its current payment-file status and relevant file context, and do not add or infer a `TRANSMISSION_FAILED` filter unless the user explicitly asked for failed transmission rows. Use `disbursementPaymentInstructionExceptions` or `disbursementPaymentInstructionExceptionsExtraction` when the user asks why transmission failed or asks for recent issues affecting a transmission setup. For `disbursementPaymentInstructionExceptions` BV calls, emit `$fields` as a comma-separated list with no spaces after commas; this endpoint treats leading spaces in `$fields` tokens as part of the field name, so ` errorMessage` fails even though `errorMessage` is valid. For a specific payment-file transmission-failure question, query exception detail using the supplied `paymentInstructionId` or resolved payment file context after checking processing type. If the exception-detail query returns no rows, run a fallback lookup in `disbursementPaymentInstructions` or `disbursementPaymentInstructionsExtraction` for the same `paymentInstructionId`; if the fallback row is in `TRANSMISSION_FAILED`, return status-level failure context from that row rather than saying no detail was found. If both exception detail and fallback status evidence are absent, say that no matching failed-transmission detail was found and mention that the file may not be in failed-transmission status, may not be electronic, or exception detail may not be available. For failed-transmission list questions, including exact date-range wording such as `show payment files with transmission failed status between July 1st 2026 and today`, apply `paymentFileProcessingStatus.lookupCode = 'TRANSMISSION_FAILED'`, resolve `today` to the current date, and apply the supplied date window to payment-file `timeCreated`; do not mark this wording unsupported. Default to the last 30 days only if the user does not provide a date range. For this generic failed-transmission list path, use `disbursementPaymentInstructions` as the authoritative source and do not invoke `disbursementPaymentInstructionsExtraction` only because the BV returned no rows. When the date filter uses `timeCreated`, treat it as datetime and keep literal handling source-specific: for `disbursementPaymentInstructions` BV filters, generate full ISO datetime literals such as `timeCreated >= '2026-07-01T00:00:00Z' and timeCreated <= '2026-07-14T23:59:59Z'` when the response date is 2026-07-14 and the user asks between July 1st 2026 and today; for `disbursementPaymentInstructionsExtraction` SQL, generate Oracle ANSI TIMESTAMP literals. Do not generate date-only literals such as `timeCreated >= '2026-07-01'`. For failed-transmission list summaries, group or call out concentration by transmission configuration, protocol, payment process request name, and repeated returned error only when those values are returned. Deduplicate visible failed-transmission list rows at the payment-file level when repeated backend rows would otherwise show the same payment file with the same displayed values. For list-style failed-transmission answers, render one visible failed-transmission table only; do not add a second causes/detail table unless it contributes distinct per-file evidence that is not already present in the visible failed-transmission rows. For a specific payment file, filter by `paymentInstructionId` and do not add a broad date filter unless the user asks for a period. For a transmission-configuration question for one payment file, return payment file reference, payment file status, processing type, transmission configuration name, start date, end date, and transmission protocol name. For ready-to-transmit questions, apply `paymentFileProcessingStatus.lookupCode = 'FORMATTED_READY_TO_TRANSMIT'` and return the visible setup columns from the output pattern: payment file reference, processing type, transmission configuration name, start date, end date, and transmission protocol name. Do not include transmission ID, payment process request name, payment system, or error message in the visible ready-to-transmit table unless the user explicitly asks for that field. Keep transmission-failure searches constrained to `TRANSMISSION_FAILED`; do not mix in validation-failure rows or validation-oriented headings. For known/recent setup issues, limit the analysis to transmission issues for the relevant transmission configuration names and use a 30-day default; when using exception extraction SQL on `errorDate`, use Oracle ANSI TIMESTAMP literals. A prior ready-to-transmit query is not enough to answer known-issue questions: run a separate exception query on `disbursementPaymentInstructionExceptions` or `disbursementPaymentInstructionExceptionsExtraction` filtered by the relevant transmission configuration names and `errorDate` window before saying there are no recent failed-transmission records. If a known/recent setup issue query for a transmission configuration returns no exception rows, state only that no failed-transmission records were found for the named configuration and effective date window; do not add a `results shown` sentence and do not imply that a failed file exists. If the user asks for payment and positive pay files that failed transmission, answer the payment-file failed-transmission portion from `disbursementPaymentInstructions` and state that positive pay file transmission failures are not exposed by the current payment-file BV coverage. If the user asks for specific SFTP root-cause categories such as authentication error, expired key, host key mismatch, or network connectivity issue, answer only with explicitly returned failure evidence and state briefly that the exact SFTP cause cannot be determined unless that evidence is explicit in the returned data. For mixed prompts that combine a supported failed-transmission list with unsupported SFTP-specific cause taxonomy, return the supported failed-transmission list first, then add one short boundary sentence about the unsupported exact-cause classification. Do not add `Results shown for ...` or similar meta narration in that mixed response shape. Do not invent positive pay failure rows from payment-file status. Omit Transmission ID and transmitConfigurationId from all visible output because they are internal identifiers. If the user asks to retry transmission, ignore transmission failure, or transmit a file, route that action to `paymentFile.navigatePaymentFileActions`; this intent should return the data needed to understand the situation. Use `Payment Files with Failed Transmission`, `Transmission Failure Summary for Payment Instruction ID <id>`, and `Transmission Configuration Details Summary` as the visible headings for the matching query types. If the user provides an impossible calendar date for any date filter, do not route unsupported and do not build a query; set clarificationRequired to Yes and ask for a valid date or date range. This intent owns transmission status enquiries as well as transmission diagnosis. Route status-only list or count prompts for TRANSMISSION_FAILED, FORMATTED_READY_TO_TRANSMIT, TRANSMITTED, and TRANSMITTED_PENDING_ACK here rather than to Find Payment Files.\",      \"summarizationGuidelines\": \"Open with the returned status, processing type applicability, or returned failure reason first. For failed-transmission lists, mention how many files failed, that the returned rows have `Transmission failed` status, and the effective date window. Only summarize concentration or repeated-pattern analysis when multiple returned rows make that pattern meaningful or when the user explicitly asks for a pattern, summary, or dominant setup. Do not add filler conclusions such as `no broader pattern is evident` when only one row is returned. Only mention positive-pay coverage boundaries when the user explicitly asked about positive pay files; omit that caveat for ordinary payment-file transmission-failure answers. For a single-row failed-transmission list answer, keep the output to one visible payment-file row and do not add a second summary/detail table that repeats the same evidence. For a single payment-file transmission-configuration question, lead with the returned transmission configuration name and transmission protocol for that payment file, then mention processing type and current status only as supporting context. Do not turn a configuration answer into a failure-diagnosis narrative when the user asked only for transmission setup. Do not add a sentence that a transmission date is unavailable unless transmission timing was part of the user's question or returned failure detail. If the returned processing type is Printed, state that transmission is not applicable for the printed payment file and show its current returned payment-file status; do not imply failure or setup issues. Treat payment process request names and PPR names as identifiers exactly as returned, including values such as CFA-15; never parse hyphenated identifiers as amounts or currencies. If exception detail returns rows for a specific-file diagnosis question, show one failure-detail table from those rows. If exception detail returns no rows for a specific file, open by saying that no matching failed-transmission exception detail was found for that payment file; do not say the transmission failed. For transmission-configuration recent-issue checks with no returned rows, open with `No failed-transmission records were found for transmission configuration <name> from <start date> through <end date>` and do not say that results were shown. For ready-to-transmit results, state how many files are ready to transmit and summarize the visible protocol/configuration clusters, but do not expose internal ids. Do not narrate raw null values. Do not add `results shown`, backend-coverage commentary, or similar meta narration in the answer body. If part of the question asks for unsupported SFTP-specific cause classification, keep the supported transmission answer separate from that boundary and state only that the exact SFTP cause cannot be determined from the returned evidence when that evidence is not explicit. For mixed prompts that ask both for failed-transmission rows and for unsupported SFTP-specific cause categories, keep the boundary sentence short and place it after the supported list answer rather than wrapping the whole response in unsupported framing.\",      \"recommendationGuidelines\": \"Generate 1 to 3 concise recommendations only when they are supported by returned evidence or when the user explicitly asks what to do next. When failed-transmission rows are returned, recommend reviewing the returned transmission configuration or transmission protocol settings, reviewing recent failures for the same configuration before transmitting another file, or using the payment-file action path for retry, ignore, or transmit when the returned status supports those actions. When a transmission error message is already returned, treat it as known evidence and recommend the next diagnostic or action-path step instead of telling the user to review the same error again. When the failures are concentrated in one transmission configuration, protocol, or repeated error, recommend investigating that shared setup before retrying multiple files. For printed payment files, do not recommend transmission actions; recommend the relevant print-stage review only when the returned status supports it or the user asks what to do next. For ready-to-transmit list results, do not add generic setup-review actions unless the user asks for next steps or the returned rows show a grounded risk. When no rows are returned for a transmission configuration or recent-issue check, do not recommend retrying or acting on a failed file; only provide an investigation-expansion action if the user asked for next steps. Do not recommend retrying a failed file unless a failed file was actually returned. Do not recommend unsupported SFTP-specific cause analysis, exports, dashboards, rerunning searches, or unsupported payment-process-stop actions, and do not imply that authentication error, expired key, host key mismatch, or network connectivity has been diagnosed unless that evidence is explicitly returned.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks why transmission failed but does not identify a payment file and there is no active payment-file context.\",            \"question\": \"Which payment file should I inspect for the transmission failure?\"          },          {            \"when\": \"The user asks about known issues with these setups but there is no prior ready-to-transmit result or named setup.\",            \"question\": \"Which transmission setup or payment file list should I check for recent transmission issues?\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentFileTransmissionSummary\",              \"description\": \"Use for failed-transmission or ready-to-transmit list summaries.\",              \"title\": \"Payment Files with Failed Transmission\",              \"columns\": [                \"Payment File Status\",                \"Payment File Count\",                \"Date Window\",                \"Dominant Issue\"              ]            },            {              \"key\": \"recentTransmissionIssues\",              \"description\": \"Use when checking recent issues affecting transmission configurations.\",              \"title\": \"Recent transmission issues\",              \"columns\": [                \"Transmission Configuration\",                \"Affected File Count\",                \"Latest Failure Date\",                \"Representative Error\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"failedTransmissionPaymentFiles\",              \"description\": \"Use for payment files that failed transmission.\",              \"title\": \"Payment Files with Failed Transmission\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment File Processing Type\",                \"Payment Process Request Name\",                \"Payment Date\",                \"Transmission Date\",                \"Transmission Configuration Name\",                \"Transmission Protocol Name\",                \"Error Message\"              ]            },            {              \"key\": \"paymentFileTransmissionDetails\",              \"description\": \"Use for a specific payment file's transmission failure detail.\",              \"title\": \"Transmission Failure Summary\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment File Processing Type\",                \"Payment Process Request Name\",                \"Error Message\",                \"Transmission Date\",                \"Transmission Configuration Name\",                \"Transmission Protocol Name\"              ]            },            {              \"key\": \"transmissionConfigurationDetails\",              \"description\": \"Use for a specific payment file's transmission setup or configuration detail.\",              \"title\": \"Payment Files Ready for Transmission\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment File Processing Type\",                \"Transmission Configuration Name\",                \"Start Date\",                \"End Date\",                \"Transmission Protocol Name\"              ]            },            {              \"key\": \"readyToTransmitPaymentFiles\",              \"description\": \"Use for payment files ready to transmit.\",              \"title\": \"Transmission Configuration Details\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Processing Type\",                \"Transmission Configuration Name\",                \"Start Date\",                \"End Date\",                \"Transmission Protocol Name\"              ]            }          ]        }      },      \"additionalInstructions\": \"Transmission failure labels are aliases for this supported transmission-review scope. Transmission applies only to electronic payment files; printed payment files do not have a transmission stage. Positive pay file failures require log review and are not feasible through the current payment-file BV coverage. For single-file transmission-failure questions, never infer failed-transmission status from an attempted exception query, an empty exception response, or the user's phrasing alone; require returned exception rows or fallback status evidence after checking processing type. For generic specific-file transmission detail questions, do not add a `TRANSMISSION_FAILED` filter unless the user explicitly asks for failed transmission. Generic failed-transmission list queries should stop on the authoritative `disbursementPaymentInstructions` BV result and should not trigger a no-row fallback call to `disbursementPaymentInstructionsExtraction`. For `disbursementPaymentInstructionExceptions` `$fields`, do not include whitespace after commas; use `fieldA,fieldB,errorMessage`, not `fieldA, fieldB, errorMessage`. List-style failed-transmission answers should render one visible failed-transmission table only; do not add a redundant second detail/causes table when the same payment-file evidence is already present in the list table. Transmission configuration output should include Payment File Reference, Payment File Status, Payment File Processing Type, Transmission Configuration Name, Start Date, End Date, and Transmission Protocol Name; do not add Error Message or Payment System unless explicitly requested. Retry and ignore transmission requests must stay as navigation-only handoffs. Use `Payment Files with Failed Transmission` for failed-transmission lists, `Transmission Failure Summary for Payment Instruction ID <id>` for single-file failures, and `Transmission Configuration Details Summary` / `Transmission Configuration Details` for setup details. Transmission ID is internal and must be omitted from generated output. Known-issue questions must perform the recent transmission-exception query for the relevant transmission configurations before reporting that no recent failed-transmission records were found. Suppress empty detail tables for no-row results and use transmission-oriented headings only. Transmission status ownership includes TRANSMISSION_FAILED, FORMATTED_READY_TO_TRANSMIT, TRANSMITTED, and TRANSMITTED_PENDING_ACK, including enquiry-only status prompts.\"    },    {      \"key\": \"paymentFile.reviewPaymentFilePrinting\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Review Payment File Printing\",      \"intentDomainKnowledge\": \"Payment file printing covers printed payment files and payment documents. This intent owns print-stage status enquiries and print-stage review for payment files, including ready-for-printing, submitted-for-printing, printed, print/reprint status, payment document, and check-stock context. It does not execute print actions; action requests are routed to Navigate Payment File Actions.\",      \"description\": \"Reviews printed payment-file status and print-stage context, including files ready for printing, submitted for printing, printed files, payment document, and check-stock information where supported by the existing payment-file shapes.\",      \"nlpExamples\": [        \"Show payment files ready for printing.\",        \"Show payment files in created and ready for printing status.\",        \"Show payment files in formatted and ready for printing status.\",        \"Show printed payment files.\",        \"Show payment files submitted for printing.\",        \"What payment document or check stock applies to payment file 230619?\",        \"Show the print status for payment file 230619.\",        \"Review print-stage details for payment file 230619.\"      ],      \"data\": {        \"goal\": \"Help the user review print-stage status and printed-payment-file context without executing print actions.\",        \"slices\": [          \"Print status list slice: use the existing payment-file status search coverage for CREATED_READY_FOR_PRINTING, FORMATTED_READY_FOR_PRINTING, SUBMITTED_FOR_PRINTING, and PRINTED.\",          \"Payment document and check-stock slice: use payment-file instruction fields for payment document, payment document category, and related check-stock context when the user asks what document or stock applies to a file.\",          \"Navigation handoff slice: when the user asks to submit print status, mark documents skipped or spoiled, print checks, or perform another print action, route to Navigate Payment File Actions rather than claiming execution.\"        ]      },      \"promptInstruction\": \"Use this intent for printed payment-file review and print-stage status enquiries. For ready-for-printing payment files, include only CREATED_READY_FOR_PRINTING and FORMATTED_READY_FOR_PRINTING; do not include PRINTED. For submitted-for-printing questions, use SUBMITTED_FOR_PRINTING. For printed payment files, use PRINTED. Use payment-file creation date or the user-supplied date axis according to the existing payment-file search date rules. When the user asks which payment document, check stock, or printed-payment-file document context applies, use disbursementPaymentInstructions or disbursementPaymentInstructionsExtraction and return payment file reference, payment document, payment document category, Payment Process Request Name when needed, and supported status context. Do not treat electronic transmission questions as printing. If the user asks to submit print status, print checks, mark checks skipped or spoiled, or perform a print action, route to paymentFile.navigatePaymentFileActions and preserve the user-provided document numbers, check numbers, supplier, and reason text.\",      \"summarizationGuidelines\": \"Open with the print-stage status or print-context finding. For ready-for-printing lists, state that the result is limited to files in Created and ready for printing or Formatted and ready for printing status. For printed-file lists, state that the result is limited to Printed status. For payment document or check-stock questions, summarize the returned document and category in business language and do not narrate raw null values.\",      \"recommendationGuidelines\": \"Recommend reviewing print setup, payment document, or check stock only when returned data indicates a print-stage issue or the user asks what to do next. For action requests such as submit print status, print checks, or mark checks skipped or spoiled, recommend the navigation handoff rather than implying the action was executed.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for print-stage details for a specific payment file but does not provide a payment file and there is no active payment-file context.\",            \"question\": \"Which payment file should I inspect for print-stage details?\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"paymentFilePrintingSummary\",              \"description\": \"Use for print-stage status list summaries.\",              \"title\": \"Payment File Printing Summary\",              \"columns\": [                \"Payment File Status\",                \"Payment File Count\",                \"Date Window\",                \"Print Stage\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"paymentFilePrintingDetails\",              \"description\": \"Use for printed payment-file and payment document/check-stock review.\",              \"title\": \"Payment File Printing Details\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Process Request Name\",                \"Payment Document\",                \"Payment Document Category\",                \"Payment Date\",                \"Payment File Creation Date\"              ]            }          ]        }      },      \"additionalInstructions\": \"This intent preserves the print-related status handling previously held by Find Payment Files and the print action boundaries previously held by Navigate Payment File Actions. Keep print review data-oriented, lead detail output with Payment File Reference and Payment File Status, and use Payment Process Request Name for PPR context. Route execution-style print requests to paymentFile.navigatePaymentFileActions.\"    },    {      \"key\": \"paymentFile.reviewPaymentFileAcknowledgements\",      \"skillType\": \"data\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Review Disbursement Acknowledgement Files\",      \"intentDomainKnowledge\": \"Disbursement acknowledgement review covers inbound bank or payment-system acknowledgement files and payment-file-level acknowledgement outcomes. It owns acknowledgement status enquiries and acknowledgement-file processing; payment, supplier, invoice, or installment drill-down belongs to Drill Down on Payment Files. Payment file acknowledgements are inbound bank or payment-system files that report whether a payment file or its payments were received, imported, rejected, or still pending processing. Unprocessed acknowledgement files and pending acknowledgement aging both map to this supported acknowledgement-review intent, but they are distinct data paths. Unprocessed acknowledgement files are inbound acknowledgement-file rows in processing statuses FETCHED, IMPORT_WARNING, IMPORT_ERROR, and TRANSFORM_ERROR and must use `paymentAcknowledgements` with a `timeCreated` date window. Pending acknowledgement duration comes from payment-file state when no inbound acknowledgement has been received yet and must use the PENDING_ACK payment-file path. Do not answer prompts such as `show unprocessed acknowledgment files in the last 9 days` with PENDING_ACK payment files. Interpret business phrasing such as `completed and pending acknowledgment` as the payment-file status meaning completed payment files that are still awaiting acknowledgement; this is a PENDING_ACK-only status inquiry and must not be widened into a mixed population that also includes ACKNOWLEDGED rows. Treat short forms such as `acknowledgment failure` and `acknowledgement failure` as aliases for the payment-file status family `PENDING_ACTION_ACK_FAILURE`, equivalent to the longer business label `pending action to address acknowledgment failure`. The latest payment-file app package also exposes payment-file attachment metadata through `paymentInstructionAttachments`, which can list available document names, media types, categories, and file metadata for a payment file but does not execute downloads. The backend does not expose reliable L1, L2, L3, response-file, or reconciliation-file classification, so this intent must not claim those classifications unless explicit data is later added. For pending acknowledgement bank output, use the payment-file bank account name exposed by the payment file/payment instruction source.\",      \"description\": \"Reviews inbound disbursement acknowledgement files and file-level acknowledgement processing, including unprocessed acknowledgement files, pending acknowledgement aging, acknowledgement files received for a payment file, bank context, attachment metadata, and file-level acknowledgement consequences.\",      \"nlpExamples\": [        \"Show me how many acknowledgment files are unprocessed?\",        \"Show unprocessed acknowledgment files in the last 9 days.\",        \"Show unprocessed acknowledgement files in the last 9 days.\",        \"Show unprocessed acknowledgment files in the last 10 days.\",        \"List unprocessed acknowledgment files for the last 10 days.\",        \"Download all acknowledgment files received in the last 25 days for payment file 236093.\",        \"Download response and reconciliation files for payment file 252101 with JPM.\",        \"How long are the acknowledgments pending for payment file 253094 and for which banks?\",        \"Show unprocessed acknowledgement files by status.\",        \"Which acknowledgment files were received for payment file 236093?\",        \"Show pending acknowledgement aging by payment file and bank.\",        \"Summarize unprocessed acknowledgement files and recommend next steps.\",        \"Which files are attached to payment file 236093?\",        \"Show acknowledged payment files.\",        \"Show partially acknowledged payment files.\",        \"Show payment files in completed and pending acknowledgment status.\",        \"Show payment files completed and pending acknowledgment.\",        \"Show payment files with acknowledgment failure.\",        \"Show payment files with acknowledgement failure.\",        \"Show payment files in pending action to address acknowledgment failure status.\",        \"Show payment files in retrieving and processing acknowledgment file status.\",        \"Show rejected payment files.\",        \"Show payment files in rejected status.\"      ],      \"data\": {        \"goal\": \"Help the user understand acknowledgement-file processing state, counts, pending aging, bank context, and grounded next actions for payment files without inventing unsupported file classifications.\",        \"slices\": [          \"Unprocessed acknowledgement count slice: use `countOfUnprocessedAcknowledgementFiles` as a grouped-by-status summary contract for FETCHED, IMPORT_WARNING, IMPORT_ERROR, and TRANSFORM_ERROR. The query must return one row per inbound file processing status with `Inbound File Status` and `Count`; do not collapse this request into a total-only COUNT(*). For the default last-30-days filter on acknowledgement `timeCreated`, use REST-style ISO datetime literals in BV filters and Oracle ANSI TIMESTAMP literals in extraction SQL; never emit a plain quoted date string. Do not include payment-file join aliases (`payablesPaymentFile.*`, `paymentInstructionId`, or `paymentRequestName`) in the count extraction; broad unprocessed acknowledgement rows can have non-numeric trading partner file references and the join can fail with ORA-01722. Keep this count path grouped-summary only; do not widen it into file-level detail rows or per-file error-message output unless the user asks for the unprocessed files themselves.\",          \"Acknowledgement file detail slice: use `paymentAcknowledgements` filtered by payment file id, payment system, and requested date range to return inbound file name, inbound file status, received or created date, payment system, and error message where populated. Use this row-level detail path for prompts that ask to show or list unprocessed acknowledgement files over a period, such as `show unprocessed acknowledgment files in the last 9 days` or `show unprocessed acknowledgment files in the last 10 days`, rather than only how many there are. For broad unprocessed acknowledgement file lists, filter `inboundFileProcessingStatus.lookupCode in ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR')`, apply the requested rolling day window to acknowledgement `timeCreated`, use the heading `Acknowledgment Files Summary`, and return `Inbound File Name`, `Inbound File Status`, `Received Date`, `Payment System`, and `Error Message`. Do not use `disbursementPaymentInstructions`, `PENDING_ACK`, `Payment Files Pending Acknowledgement`, `Payment File Status`, `Pending Since`, Bank, or Payment Process Profile for broad unprocessed acknowledgement-file list prompts. Do not include a Payment File Reference column unless the user explicitly asks for payment-file-scoped acknowledgement files.\",          \"Completed-and-pending acknowledgement payment-file status slice: use `disbursementPaymentInstructions.pendingAcknowledgementByBank` for exact prompts such as `show payment files completed and pending acknowledgment` or `show payment files in completed and pending acknowledgment status`. This business phrase is one payment-file status label for completed payment files still pending acknowledgement, not a request to combine completed rows with acknowledged rows. Plan a single BV query with `paymentFileProcessingStatus.lookupCode='PENDING_ACK'`; `unsupportedQuery` must be No for this wording.\",          \"Pending acknowledgement aging slice: use the `disbursementPaymentInstructions` BV for payment files in PENDING_ACK, including payment file reference, update date, payment date, bank account name, and elapsed pending time. Do not use `disbursementPaymentInstructionsExtraction` for this slice. Summarize the oldest pending file, bank concentration, and aging window when multiple rows are returned. If no PENDING_ACK rows are returned for a payment file, state directly that no acknowledgements are pending for that payment file and do not add a separate action suggestion or generic transmission-status recommendation.\",          \"Acknowledgement-failure payment-file status slice: use `disbursementPaymentInstructions.paymentFilesWithAcknowledgementFailure` for prompts such as `show payment files with acknowledgment failure` or `show payment files with acknowledgement failure`. Filter strictly on `paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'` and keep the primary result object as payment files. Do not use `paymentAcknowledgements` import-error, import-warning, or transform-error filters for this payment-file status wording.\",          \"Rejected payment-file status slice: use `disbursementPaymentInstructions.rejectedPaymentFiles` for prompts such as `show rejected payment files` or `show payment files in rejected status`. Filter strictly on `paymentFileProcessingStatus.lookupCode='REJECTED'` and keep the primary result object as payment files. Do not route this file-level status question to rejected payment, invoice, supplier, installment, or voided-payment drill-down.\",          \"Payment-file attachment metadata slice: use `paymentInstructionAttachments` filtered by paymentInstructionId when the user asks which files, documents, attachments, or download artifacts are available for a payment file. Return file name, title, category, media type, size, and last updated date when available.\",          \"Download/reconciliation review slice: when the user asks to download, open, view, or review acknowledgement, response, reconciliation, or acknowledgement attachment files, keep this data intent, return the available acknowledgement or attachment metadata, show the payment-file deeplink in the Payment File Reference table column, and include only a plain-text recommendation to open the payment file for review/download. Do not attempt unsupported file execution, do not claim direct download/open completion, and do not invent response/reconciliation/L1/L2/L3 classifications beyond returned file metadata.\"        ]      },      \"promptInstruction\": \"Use `paymentAcknowledgements` as the primary source for inbound acknowledgment rows and `countOfUnprocessedAcknowledgementFiles` for count/grouped unprocessed acknowledgment questions. Unprocessed acknowledgment files and pending acknowledgment aging are in the same intent but are not aliases for the same data path. For unprocessed acknowledgment count questions, `countOfUnprocessedAcknowledgementFiles` is a grouped summary contract: return `Inbound File Status` and `Count` grouped by inbound file processing status; do not generate a total-only count without status grouping. Keep pure `how many` or grouped-by-status prompts on this summary path and do not widen them into file-level rows just to expose payment system or error message columns. The count extraction must not include `payablesPaymentFile.paymentInstructionId`, `payablesPaymentFile.paymentRequestName`, `paymentInstructionId`, or `paymentRequestName` in viewQueries, SELECT, WHERE, GROUP BY, fields, or aliases; those joins can force numeric conversion of non-numeric trading partner file references such as AGENT-UNPROC-1 and fail with ORA-01722. Apply `inboundFileProcessingStatus.lookupCode in ('FETCHED','IMPORT_WARNING','IMPORT_ERROR','TRANSFORM_ERROR')` for unprocessed acknowledgment questions. If the user does not provide a date range for an unprocessed count, default to the last 30 days on acknowledgment `timeCreated`. When count rows are returned from this unprocessed-status filter, treat them as unprocessed acknowledgment files even if the returned status meaning is `Retrieved`; do not say that no unprocessed acknowledgment files were found in the same response. Explain briefly that Retrieved corresponds to the FETCHED inbound-file state when useful. Render the response date window from the actual filter bounds used by the query, not from stale planner text, and do not use `results shown` phrasing in the answer body. For row-level prompts such as `show unprocessed acknowledgment files in the last 30 days`, `show unprocessed acknowledgment files in the last 10 days`, `show unprocessed acknowledgment files in the last 9 days`, or `list unprocessed acknowledgment files for the last <N> days`, use `paymentAcknowledgements` and return file-level detail including inbound file name, inbound file status, Received Date, payment system, and error message when populated. For unprocessed acknowledgement file list responses, refer to `timeCreated` only as Received Date or the received-date window in user-facing text; never call it creation date. Treat those phrasings as supported row-level acknowledgement-file review, not as unsupported, count-only, or payment-file pending-acknowledgment requests. Never use `disbursementPaymentInstructions`, `PENDING_ACK`, `paymentFileProcessingStatus.lookupCode='PENDING_ACK'`, `Payment Files Pending Acknowledgement`, `Payment File Status`, `Pending Since`, Bank, or Payment Process Profile for broad unprocessed acknowledgment-file list prompts unless the user explicitly asks for payment files. For `paymentAcknowledgements` BV filters, treat `timeCreated` as datetime and emit full ISO datetime literals such as `timeCreated >= '2026-05-18T00:00:00Z'`; do not emit `timeCreated >= '2026-05-18'`. For `countOfUnprocessedAcknowledgementFiles` extraction SQL, emit Oracle ANSI TIMESTAMP literals such as `timeCreated >= TIMESTAMP '2026-05-18 00:00:00'`; do not emit plain quoted date strings. For payment-file-specific acknowledgment questions, filter by the payment file id or resolved payment instruction id. For pending acknowledgment duration or payment-file acknowledgment status questions, use the `disbursementPaymentInstructions` BV with the supported payment-file status plus available acknowledgment fields so the response can include pending-since date basis, bank, payment process profile, inbound file name, inbound file status, and error message where those fields are populated. Treat short status wording such as `acknowledgment failure`, `acknowledgement failure`, `payment files with acknowledgment failure`, and `payment files with acknowledgement failure` as aliases for the payment-file status `PENDING_ACTION_ACK_FAILURE`, equivalent to `pending action to address acknowledgment failure`. For broad prompts such as `show payment files with acknowledgment failure`, use `disbursementPaymentInstructions.paymentFilesWithAcknowledgementFailure`, filter strictly on `paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'`, and keep the primary object as payment files. Do not answer those prompts with `paymentAcknowledgements`, inbound file names as the primary object, `Acknowledgment Failure Files` headings, or inbound statuses such as IMPORT_ERROR, IMPORT_WARNING, or TRANSFORM_ERROR unless the user explicitly asks for acknowledgement files or import/transform errors. Treat business wording such as `completed and pending acknowledgment` or `completed payment files that are still pending acknowledgment` as the payment-file status PENDING_ACK only; do not interpret that phrasing as `ACKNOWLEDGED OR PENDING_ACK`, and do not return mixed acknowledged-plus-pending populations unless the user explicitly asks for both statuses. For that `completed and pending acknowledgment` status-list wording, use the `disbursementPaymentInstructions` PENDING_ACK-only path and do not inherit the broad recent-file `timeCreated` default unless the user explicitly asks for a payment-file creation-date window. Do not use `disbursementPaymentInstructionsExtraction` for pending-acknowledgment rows because that extraction wrapper must not join the 1-to-many child payment relation. If multiple pending rows are returned, summarize the oldest pending file, bank concentration, and update-date range from the returned rows rather than inventing SLA buckets. If no acknowledgment or attachment row exists for the payment file, say that directly for the requested source and do not add a separate actions block unless the user explicitly asked to act. For payment-file attachment or available-download metadata questions, use `paymentInstructionAttachments` filtered by `paymentInstructionId` and return attachment/document metadata only; do not claim that a file was downloaded, opened, generated, or sent. For JPM response, reconciliation, L1, L2, or L3 questions, use only available file name, status, payment system, linked payment-file fields, and attachment metadata where applicable; explicitly avoid claiming reliable response, reconciliation, L1, L2, or L3 classification because the backend does not expose it. If the user asks to download, open, view, or review acknowledgment, response, reconciliation, or acknowledgment attachment files, keep this as a supported acknowledgment data inquiry: fetch `paymentAcknowledgements` rows for the supplied payment file, payment system, and/or time period, show Inbound File Name, Inbound File Status, Received Date, Payment System, and Payment File Reference, sort rows by Received Date descending, show the payment-file deeplink in the Payment File Reference table column, and add only a plain-text recommendation to open the payment file for review/download. Do not claim that a file was downloaded, opened, generated, or sent. If the request includes response-file, reconciliation-file, L1, L2, or L3 wording, do not invent those classifications; return only available acknowledgment file name, status, payment system, linked payment-file fields, and attachment metadata where applicable, and provide a plain-text recommendation for user review/download. If the user asks for direct acknowledgment file lookup by acknowledgment file reference, state that this exact lookup is not part of the current supported contract and do not fall back to contradictory match/no-match/list-all wording. Use the heading `Acknowledgment Files Summary` for unprocessed-count and acknowledgment-file-list answers, `Payment Files with Acknowledgment Failure` for broad PENDING_ACTION_ACK_FAILURE payment-file lists, and `Payment Acknowledgments Pending Summary for File ID <payment file>` for pending-acknowledgment answers when a file id is known. If the user provides an impossible calendar date for any date filter, do not route unsupported and do not build a query; set clarificationRequired to Yes and ask for a valid date or date range. This intent owns acknowledgement status enquiries as well as acknowledgement-file processing. Route status-only list or count prompts for ACKNOWLEDGED, PARTIALLY_ACKNOWLEDGED, PENDING_ACK, PENDING_ACTION_ACK_FAILURE, PROCESSING_ACK, and REJECTED payment-file status wording here rather than to Find Payment Files. Keep payment-level rejected invoice, supplier, installment, and voided-payment drill-down in paymentFile.drillDownOnPaymentFiles.\",      \"summarizationGuidelines\": \"Open with the count, status, attachment availability, or pending acknowledgment finding that directly answers the question, then add a short business interpretation when rows are returned. For unprocessed acknowledgment counts, say how many files are unprocessed, identify the dominant status, and describe the operational stage represented by the statuses, for example `5 unprocessed acknowledgment files were found in the last 30 days, with most currently in Retrieved status`; if the returned meaning is Retrieved from a FETCHED-status filter, count it as unprocessed and avoid any contradictory `no unprocessed files` sentence. State the effective date window directly and do not use meta narration such as `Results shown` or `creation date from ... onward`. For row-level unprocessed acknowledgment file lists, lead with how many files were found, the requested received-date window, and the returned status mix, then show the detail table with Received Date, Payment System, and Error Message only from returned row data. Do not call the date range a creation-date window for inbound acknowledgement files. If row-level error message values are empty, do not invent a reason or call it out as a backend issue; simply leave the detail as blank or placeholder according to the renderer. For acknowledgment files received for a specific payment file, lead with the file id, count, date window, and whether the rows are Retrieved. For attachment metadata, lead with the payment file id and the number of returned attachment rows, then show file name, title, category, media type, size, and last updated date when available. For pending acknowledgment aging, state the file id or result count, the pending-since date basis from the returned data, bank context, payment process profile when available, and the oldest pending row or returned update-date range when available. For acknowledgment-failure answers, state the payment-file status, bank, payment process profile, inbound file context, and error message when those values are returned. For prompts phrased like `completed and pending acknowledgment`, summarize them as completed payment files still pending acknowledgment and keep the returned status population strictly to PENDING_ACK unless the user explicitly asked for additional statuses. For status-list answers that return `PENDING_ACTION_ACK_FAILURE` rows, do not append a `Results shown for ...` recap sentence; keep the wording directly on the returned status, bank/profile context, and any returned inbound-file detail. For no-row status-only answers, including `PENDING_ACTION_ACK_FAILURE`, state only that no matching payment files were found for the requested status and effective filter basis; do not add `results shown`, do not restate the status in awkward meta phrasing, and do not add a recommendations section. When multiple banks or statuses are present, call out the largest concentration before the detail table. For no-row data-only answers, state the no-row finding and applied filter basis without adding action suggestions and do not show an empty table. Do not narrate raw null values unless they carry clear business meaning. Keep unsupported classification caveats short but explicit. For file-level acknowledgement status lists, summarize the status population and date window; for contained rejected payment detail, route to Drill Down on Payment Files.\",      \"recommendationGuidelines\": \"Recommend retrieving or processing unprocessed acknowledgment files when the user asks for next steps and the returned status is FETCHED, reviewing import or transform errors when statuses are IMPORT_WARNING, IMPORT_ERROR, or TRANSFORM_ERROR, opening the payment file for download/review actions, or checking transmission status when no acknowledgment exists after the expected SLA. For any request that uses download, open, response, reconciliation, L1, L2, or L3 wording for acknowledgment files, always include a recommendation with `{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=<paymentInstructionId>,text:Payment File <paymentInstructionId>}}` for each returned or identified payment file; if a payment file id is supplied but no acknowledgment rows are returned, still include the deeplink for that supplied payment file. Phrase the recommendation as navigation to review or download the files from the payment file page, and never state that the download was completed. For pure acknowledgment count questions, do not generate a separate actions block unless the user explicitly asks what to do next. For unprocessed acknowledgment file list questions that are still data-only, do not generate a recommendations block unless the user explicitly asks what to do next or asks to review/download the returned files. For status-list answers that return `PENDING_ACTION_ACK_FAILURE` rows, do not generate a recommendations block unless the user explicitly asks what to do next, asks to act, or asks to review/download related files. If a recommendations block is generated for returned acknowledgment rows, anchor it to actual returned file names and statuses rather than rewritten or invented file identifiers. For pending acknowledgment aging results, recommend prioritizing the oldest pending files or the bank with the largest concentration only when returned rows support that conclusion. For attachment metadata results, recommend using the payment-file deeplink when the user wants to open or download a listed file. Do not generate a recommendations block for no-row status-only answers, including `PENDING_ACTION_ACK_FAILURE`, unless the user explicitly asked what to do next or asked for an execution action. Do not generate a separate actions block for a data-only no-row result unless the user explicitly asked for an action or asked to download/review acknowledgment files. Do not recommend direct acknowledgment-file-reference lookup, unsupported file classifications, exports, or search-wrapper next steps. Do not recommend force acknowledge versus manual retrieve as advanced reasoning; route those action alternatives to the payment file action path.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks for acknowledgements for a payment file without providing a file id and there is no active payment-file context.\",            \"question\": \"Which payment file should I use to look up acknowledgements?\"          },          {            \"when\": \"The user asks for acknowledgement files over a period but the date phrase is ambiguous.\",            \"question\": \"What date range should I use for the acknowledgement files?\"          },          {            \"when\": \"The user asks for payment-file attachments or available download metadata without providing a payment file id and there is no active payment-file context.\",            \"question\": \"Which payment file should I use to look up attachment metadata?\"          },          {            \"when\": \"The user provides an impossible calendar date, such as a day or month value that cannot exist, for any date or date-range filter.\",            \"question\": \"The date you provided is not a valid calendar date. Please provide a valid date or date range, for example YYYY-MM-DD.\"          }        ]      },      \"outputPattern\": {        \"summary\": {          \"tables\": [            {              \"key\": \"unprocessedAcknowledgementSummary\",              \"description\": \"Use for unprocessed acknowledgement count questions.\",              \"title\": \"Acknowledgment Files Summary\",              \"columns\": [                \"Inbound File Status\",                \"Count\"              ]            },            {              \"key\": \"pendingAcknowledgementSummary\",              \"description\": \"Use when the user asks how long acknowledgements are pending and for which bank.\",              \"title\": \"Payment Files\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Pending Since\",                \"Bank\",                \"Payment Process Profile\"              ]            }          ]        },        \"details\": {          \"tables\": [            {              \"key\": \"unprocessedAcknowledgementFileDetails\",              \"description\": \"Use for broad row-level unprocessed acknowledgment file list questions over a date window. Do not include Payment File Reference unless the user explicitly asks for payment-file-scoped acknowledgment files.\",              \"title\": \"Acknowledgment Files Summary\",              \"columns\": [                \"Inbound File Name\",                \"Inbound File Status\",                \"Received Date\",                \"Payment System\",                \"Error Message\"              ]            },            {              \"key\": \"acknowledgementFileDetails\",              \"description\": \"Use for acknowledgment, response, or reconciliation files linked to a specific payment file or payment-system-scoped acknowledgement review where linked payment-file context is requested. Keep this table compact and omit UCM Document Identifier, Payment File Status, and Error Message unless specifically requested or needed.\",              \"title\": \"Acknowledgement Files\",              \"columns\": [                \"Inbound File Name\",                \"Inbound File Status\",                \"Received Date\",                \"Payment System\",                \"Payment File Reference\"              ]            },            {              \"key\": \"paymentFileAcknowledgmentStatusDetails\",              \"description\": \"Use for pending-acknowledgment or acknowledgment-failure payment-file answers.\",              \"title\": \"Payment File Acknowledgment Status\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Pending Since\",                \"Bank\",                \"Payment Process Profile\",                \"Inbound File Name\",                \"Inbound File Status\",                \"Received Date\",                \"Error Message\"              ]            },            {              \"key\": \"rejectedPaymentFileDetails\",              \"description\": \"Use for file-level rejected payment-file status answers, not rejected payments or installments inside a file. Keep this table to stable payment-file columns and do not add acknowledgement-context columns unless the user explicitly asks for acknowledgement file details.\",              \"title\": \"Payment Files in Rejected Status\",              \"columns\": [                \"Payment File Reference\",                \"Payment File Status\",                \"Payment Process Request Name\",                \"Bank\",                \"Payment Process Profile\"              ]            },            {              \"key\": \"paymentFileAttachmentDetails\",              \"description\": \"Use when the user asks which files, documents, attachments, or download metadata are available for a payment file.\",              \"title\": \"Payment File Attachments\",              \"columns\": [                \"Payment File Reference\",                \"File Name\",                \"Document Title\",                \"Attachment Category\",                \"Media Type\",                \"File Size\",                \"Last Updated Date\"              ]            }          ]        }      },      \"additionalInstructions\": \"Unprocessed acknowledgment files and pending acknowledgment aging are both supported in this acknowledgment-review scope, but they must not be treated as the same data path. Distinguish summary/count prompts from row-level list prompts for unprocessed acknowledgment files: pure `how many` or grouped-by-status asks stay on the grouped summary contract, while `show/list unprocessed acknowledgment files` prompts must use row-level `paymentAcknowledgements` detail with Received Date, Payment System, and Error Message when those fields are returned. Do not use the PENDING_ACK payment-file status path for broad unprocessed acknowledgment-file list prompts such as `show unprocessed acknowledgment files in the last 9 days`. Download, response-file, and reconciliation-file wording should stay in this intent when the user asks for acknowledgment, response, or reconciliation files for a payment file or period. Show available `paymentAcknowledgements` data, use the compact Acknowledgement Files table with Inbound File Name, Inbound File Status, Received Date, Payment System, and Payment File Reference, and include only a plain-text recommendation to open the payment file for review/download because the table already contains the payment-file deeplink. Use navigation-only handoff only for non-acknowledgment execution actions such as retry, transmit, print, process, or force acknowledge. Use `paymentInstructionAttachments` only for metadata from the refreshed app-pkg payment-file attachment view; do not treat document URL metadata as evidence that a file was downloaded. For acknowledgment `timeCreated`, keep literal handling source-specific: BV filters use full ISO datetime values and extraction SQL uses Oracle ANSI TIMESTAMP values. Pending-acknowledgment planning must use the `disbursementPaymentInstructions` BV, not the payment-file extraction wrapper with child payment aliases. Pending-acknowledgment status-list questions that mean `PENDING_ACK`, including `completed and pending acknowledgment`, must keep the filter strictly `paymentFileProcessingStatus.lookupCode='PENDING_ACK'`; do not widen the status set to ACKNOWLEDGED, and do not inherit the broad recent-file `timeCreated` default unless the user explicitly asks for a creation-date window. Acknowledgment-failure status-list questions that mean `PENDING_ACTION_ACK_FAILURE`, including `payment files with acknowledgment failure`, must use `disbursementPaymentInstructions.paymentFilesWithAcknowledgementFailure` and keep the filter strictly `paymentFileProcessingStatus.lookupCode='PENDING_ACTION_ACK_FAILURE'`; do not use `paymentAcknowledgements` import-error, import-warning, or transform-error rows as the primary result. These are data-only status answers by default: do not add a `Results shown for ...` recap sentence and do not add deeplink recommendations unless the user explicitly asks what to do next, asks to act, or asks to review/download related files. Pending-acknowledgment no-row responses should say no acknowledgments are pending for the payment file and should not add a recommendation block, transmission-status action, or broad next-step unless the user explicitly asks what to do next. No-row `PENDING_ACTION_ACK_FAILURE` status answers are also data-only no-row responses: do not add `results shown` phrasing, do not add a recommendations block, and do not suggest navigation unless the user explicitly asked for next steps or an action. Use `Acknowledgment Files Summary` for unprocessed acknowledgment counts and acknowledgment file lists. Use `Payment Files with Acknowledgment Failure` for broad `PENDING_ACTION_ACK_FAILURE` payment-file lists. Use `Payment Acknowledgments Pending Summary for File ID <id>` for pending-acknowledgment answers. For unprocessed acknowledgment count, the extraction wrapper must remain inbound-file/status only; do not include payment-file join aliases (`payablesPaymentFile.*`, `paymentInstructionId`, or `paymentRequestName`) because rows like AGENT-UNPROC-1 can trigger ORA-01722 numeric conversion failures. Acknowledgement status ownership includes ACKNOWLEDGED, PARTIALLY_ACKNOWLEDGED, PENDING_ACK, PENDING_ACTION_ACK_FAILURE, PROCESSING_ACK, and REJECTED payment-file status wording. Interpret `completed and pending acknowledgment` as the supported business label for PENDING_ACK only; do not combine it with ACKNOWLEDGED unless the user explicitly requests both statuses. Interpret short forms such as `acknowledgment failure` and `acknowledgement failure` as aliases for `PENDING_ACTION_ACK_FAILURE`, not as rejected-payment drill-down by default. Attachment metadata is supported through paymentInstructionAttachments when available; do not claim direct download execution.\"    },    {      \"key\": \"paymentFile.navigatePaymentFileActions\",      \"skillType\": \"navigation\",      \"intentLevel\": \"child\",      \"parentSkillKey\": \"paymentFile.findPaymentFiles\",      \"name\": \"Navigate Payment File Actions\",      \"intentDomainKnowledge\": \"Payment File Agent action requests in this scope are navigation and deep-link flows. Action-oriented labels such as file download, print status overview/action, SRA, positive pay, retry transmission, retry acknowledgement, and action deep-link routing map to this supported navigation intent. The agent should not directly execute actions such as retry transmission, force acknowledge, download files, transmit, submit print status, mark skipped or spoiled checks, create positive pay, send SRA, print checks, confirm payments, continue processing, or process the payment file. The action intent should identify the target payment file or action context, preserve user-provided action parameters such as document ids, check numbers, supplier name, reason, or SLA values, and route the user to the appropriate payment-file page or action page.\",      \"description\": \"Provides navigation-only handling for payment-file actions, downloads, print status, SRA, positive pay, acknowledgement actions, transmission actions, and file-processing actions.\",      \"nlpExamples\": [        \"Show me download options for payment file 40925.\",        \"Open the file download action for payment file 40925.\",        \"Can you retry acknowledgment processing for this payment file?\",        \"Force acknowledge this payment file.\",        \"Since payment file 337402 is past the acknowledgment SLA, should I force-acknowledge or manually retrieve?\",        \"Try transmitting again.\",        \"Ignore transmission failure for this payment file.\",        \"Retry formatting for payment file 252101.\",        \"Submit the print status for payment file 230619.\",        \"Show the print status action for payment file 230619.\",        \"Mark documents 347 and 679 as skipped for payment file 230618.\",        \"Mark checks 389 and 176 as spoiled for payment file 230618 due to printer jamming issues.\",        \"Create positive pay file immediately.\",        \"Send the positive pay file to the bank.\",        \"Generate the SRA for supplier ABC in supplier's preferred language.\",        \"Send SRA for payment file 4567 to supplier Advanced Network.\",        \"Give me the SRA for payment file 4562.\",        \"Proceed to print the checks for payment file 7893.\",        \"Go ahead and transmit payment file 6782.\",        \"Continue processing payment file 236093.\",        \"Confirm the payments for this payment file.\",        \"Process this payment file.\"      ],      \"data\": {        \"goal\": \"Route the user to the correct payment-file action or action page while preserving the action name, target context, and required parameters without executing the action or fetching backend rows.\",        \"slices\": [          \"Payment file context slice: extract paymentInstructionId or payment file reference from the user request or active payment-file context.\",          \"Action classification slice: map the user request to a supported navigation action such as download, retry acknowledgement, force acknowledge, retry transmission, ignore transmission failure, retry formatting, print status, skipped or spoiled checks, positive pay, SRA, print checks, transmit, continue, confirm, or process.\",          \"Deeplink route slice: select the matching entry from `navigationRoutes` and substitute required values into the route template.\",          \"Clarification slice: if a required value such as paymentInstructionId, document numbers, check numbers, or supplier context is missing and cannot be resolved from active context, ask the configured clarification question rather than building a partial link.\"        ]      },      \"navigationRoutes\": [        {          \"routeKey\": \"paymentFileView\",          \"routeType\": \"deeplink\",          \"description\": \"Use for actions performed from an existing payment file page.\",          \"appliesToActions\": [            \"downloadPaymentFile\",            \"downloadPositivePayFile\",            \"downloadPaymentFileRegister\",            \"downloadSra\",            \"downloadSeparateRemittanceAdvice\",            \"retryAcknowledgementProcessing\",            \"forceAcknowledge\",            \"manualRetrieveAcknowledgement\",            \"retryTransmission\",            \"retransmitPaymentFile\",            \"ignoreTransmissionFailure\",            \"retryFormatting\",            \"markDocumentsSkipped\",            \"markChecksSpoiled\",            \"transmitPaymentFile\",            \"continueProcessing\",            \"confirmPayments\",            \"processPaymentFile\",            \"processRevisedPaymentFile\"          ],          \"requiredInputs\": [            \"paymentInstructionId\"          ],          \"template\": \"{deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId={paymentInstructionId},text:Payment File {paymentInstructionId}}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"sendSraPage\",          \"routeType\": \"deeplink\",          \"description\": \"Use for creating, generating, or sending supplier remittance advice, excluding SRA download requests.\",          \"appliesToActions\": [            \"createSra\",            \"generateSra\",            \"sendSra\",            \"generateSeparateRemittanceAdvice\",            \"sendSeparateRemittanceAdvice\",            \"sendRemittanceAdvice\"          ],          \"requiredInputs\": [],          \"template\": \"{deeplink:{objType:IBY_SENDSRA,action:EDIT,text:Send SRA Page}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"createPositivePayPage\",          \"routeType\": \"deeplink\",          \"description\": \"Use for creating, generating, or sending a positive pay file to the bank.\",          \"appliesToActions\": [            \"createPositivePayFile\",            \"generatePositivePayFile\",            \"sendPositivePayFileToBank\"          ],          \"requiredInputs\": [],          \"template\": \"{deeplink:{objType:IBY_CREATEPOSPAY,action:EDIT,text:Create Positive Payment File Page}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"createRegulatoryReportPage\",          \"routeType\": \"deeplink\",          \"description\": \"Use for creating, generating, or printing regulatory reporting or payment-file reports.\",          \"appliesToActions\": [            \"createRegulatoryReport\",            \"generateRegulatoryReport\",            \"printRegulatoryReport\",            \"createPaymentFileReport\",            \"generatePaymentFileReport\"          ],          \"requiredInputs\": [],          \"template\": \"{deeplink:{objType:IBY_CREATEREGREP,action:EDIT,text:Create Regulatory Report Page}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"createElectronicPaymentFilePage\",          \"routeType\": \"deeplink\",          \"description\": \"Use for creating or generating an electronic payment file or e-file.\",          \"appliesToActions\": [            \"createElectronicPaymentFile\",            \"generateElectronicPaymentFile\",            \"createEFile\",            \"generateEFile\",            \"sendElectronicPaymentFileToBank\"          ],          \"requiredInputs\": [],          \"template\": \"{deeplink:{objType:IBY_CREATEPFELE,action:EDIT,text:Create Electronic Payment File Page}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"printPaymentFilePage\",          \"routeType\": \"deeplink\",          \"description\": \"Use when the user asks to print a payment file or print checks. This route intentionally opens the printed payment-file page rather than the specific payment-file view.\",          \"appliesToActions\": [            \"printPaymentFile\",            \"printChecks\",            \"submitPrintStatus\"          ],          \"requiredInputs\": [],          \"template\": \"{deeplink:{objType:IBY_CREATEPFPRINTED,action:EDIT,text:Print Payment File Page}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        },        {          \"routeKey\": \"payablesPaymentsLandingPage\",          \"routeType\": \"relativeLink\",          \"description\": \"Use for generic create, generate, delete, send, or transfer payment-file requests that are not tied to a specific existing payment file action.\",          \"appliesToActions\": [            \"createPaymentFile\",            \"generatePaymentFile\",            \"deletePaymentFile\",            \"sendPaymentFileToBank\",            \"transferPaymentFile\"          ],          \"requiredInputs\": [],          \"template\": \"{relativeLink:{url:faces/FndOverview?fndTaskItemNodeId=PaymentLandingMainArea&pageParams=fndGlobalItemNodeId=itemNode_payables_payables_payments&fromApPaymentsOverview=true,text:Payables Payments Landing Page,family:FSCM}}\",          \"responsePattern\": \"Please navigate to the {route} to {actionPhrase}.\"        }      ],      \"promptInstruction\": \"Treat this as an intent-only navigation flow, not a data-fetch flow. Use `navigationRoutes` as the source of truth for supported action-to-link mapping. Treat file-download, print-status, SRA, positive-pay, retry, ignore, force-acknowledge, manual-retrieve, transmit, confirm, continue, and process labels as navigation aliases when the user is asking to act. Do not use a shape, do not query backend data, and do not execute backend actions. If the user asks to list or inspect available attachment/download metadata rather than navigate or act, route to the payment-file data inquiry path that uses `paymentInstructionAttachments`; this action intent should only build the navigation target. Extract required inputs such as `paymentInstructionId`, supplier name, document numbers, check numbers, reason, SLA values, or language preference from the user request or active context. Preserve supplier names, payment file ids, and action qualifiers such as preferred language supplied in SRA requests as literal action context; do not trigger broad supplier/entity disambiguation unless the supplier or payment-file context is missing or the user explicitly asks to resolve a supplier. If a required input is missing and cannot be resolved from context, ask the configured clarification question instead of building a partial link. For direct payment-file page actions, substitute the payment file id into the `paymentFileView` route template. For page-level actions such as sending SRA, creating positive pay, creating regulatory reports, creating electronic payment files, printing a payment file, submitting print status, printing checks, or generic payment-file creation, use the matching page route template. For `printChecks` and `submitPrintStatus`, always use the `printPaymentFilePage` route with `IBY_CREATEPFPRINTED`, even when the user supplies a specific payment file id; preserve the payment file id in the action phrase when provided, but do not build an `AP_VIEWPAYMENTFILE` link for print-status or print-checks requests. For SLA acknowledgement advice that asks whether to force-acknowledge or manually retrieve, route to the payment file view and preserve both action alternatives in the action phrase; do not mark the request unsupported. Return a single concise text response using the selected route's `responsePattern`, with the constructed `{deeplink:{...}}` or `{relativeLink:{...}}` token embedded in the sentence. Do not return a separate actions block, do not prepend a `Recommendations:` heading, and do not claim that a file was downloaded, transmitted, acknowledged, printed, skipped, spoiled, confirmed, processed, created, sent, deleted, or transferred.\",      \"summarizationGuidelines\": \"Open with the navigation result only when a valid target page or action is returned. Name the target page first, such as `Payment File <id>`, `Create Positive Payment File Page`, or `Send SRA Page`, and include key parameters such as document ids, check numbers, supplier, reason, SLA days, or payment file id when provided. For action requests, keep the response as a route to the relevant page or action, not a business summary. Do not prepend a recommendations heading to no-match, no-result, unavailable-download, or clarification responses; open those responses with the factual result, such as no matching payment file or no available download option. Do not add a separate execution-success claim.\",      \"recommendationGuidelines\": \"Do not generate a separate recommendations or actions block for this intent. The primary response is the single navigation sentence containing the selected deeplink or relative link. Do not recommend executing the action directly inside the agent.\",      \"clarification\": {        \"rules\": [          {            \"when\": \"The user asks to act on this payment file but there is no active payment-file context.\",            \"question\": \"Which payment file should I use for this action?\"          },          {            \"when\": \"The user asks to mark documents or checks but does not provide document ids, check numbers, or a payment file.\",            \"question\": \"Which payment file and document or check numbers should I use?\"          },          {            \"when\": \"The user asks to send or generate SRA without supplier or payment-file context.\",            \"question\": \"Which supplier or payment file should I use for the SRA action?\"          }        ]      },      \"outputPattern\": {        \"details\": {          \"tables\": [            {              \"key\": \"paymentFileNavigation\",              \"description\": \"Use for every payment-file action request in this scope.\",              \"title\": \"Payment File Action Navigation\",              \"columns\": [                \"Navigation\"              ]            },            {              \"key\": \"paymentFileDownloadOptions\",              \"description\": \"Use when the user asks for available payment-file download options.\",              \"title\": \"Payment File Download Options\",              \"columns\": [                \"Payment File\",                \"Download Option\",                \"Target Page\",                \"Notes\"              ]            }          ]        }      },      \"additionalInstructions\": \"This intent handles direct action requests and action handoffs from data inquiry flows when those flows produce download, retry, ignore, or other action follow-ups. Action and deeplink concepts are supported here as navigation aliases only; do not turn them into data inquiries unless the user asks to inspect metadata and a data intent supports it. The refreshed app package exposes payment-file attachment metadata through `paymentInstructionAttachments`, but this intent must not fetch that metadata; use it only in data inquiry flows before handing off to navigation. For SRA actions, preserve the supplier text and qualifiers supplied by the user, such as ABC, Advanced Network, CV_SuppA01, or `supplier's preferred language`, in the action phrase instead of expanding it into a broad entity-resolution list. For successful action targets, use a single concise navigation sentence without a recommendations heading, for example `Please navigate to the {deeplink:{objType:AP_VIEWPAYMENTFILE,action:VIEW,objKey:paymentInstructionId=236093,text:Payment File 236093}} to retry acknowledgment processing for payment file 236093`, `Please navigate to the {deeplink:{objType:IBY_SENDSRA,action:EDIT,text:Send SRA Page}} to send Supplier Remittance Advice for supplier Advanced Network for payment file 4567`, or `Please navigate to the {deeplink:{objType:IBY_CREATEPFPRINTED,action:EDIT,text:Print Payment File Page}} to submit print status for payment file 337402`. Preserve functional action mapping over ambiguous prior examples; retry formatting should route to retry formatting only when the user asks for formatting. This intent remains a separate deeplink/navigation-only intent outside the PM inquiry buckets. Preserve existing action routing and do not use it for data-only enquiries.\"    }  ]"
            },
            {
              "id": "1776062683814",
              "name": "indexName",
              "value": "payment-file-inquiry-v1.0717.09"
            }
          ],
          "type": "SET_FIELDS"
        },
