        {
          "metadata": {
            "name": "Get Intent and Shapes",
            "returnType": "object",
            "sourceCode": "function parseMaybeJson(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction asObject(value) {\n  value = parseMaybeJson(value);\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction asArray(value) {\n  value = parseMaybeJson(value);\n  if (value == null) return [];\n  return Array.isArray(value) ? value : [value];\n}\n\nfunction cloneObject(value) {\n  value = asObject(value);\n  var out = {};\n  Object.keys(value).forEach(function (key) {\n    out[key] = value[key];\n  });\n  return out;\n}\n\nfunction getMappedShapeKeys(intentKey) {\n  var mapping = asObject($context && $context.$variables && $context.$variables.shapeMapping);\n  var resolved = asObject(mapping.resolved);\n  return asArray(mapping[intentKey] || resolved[intentKey]);\n}\n\nfunction findIntentByKey(intentKey) {\n  var intents = asArray($context && $context.$variables && $context.$variables.businessIntent);\n  for (var i = 0; i < intents.length; i++) {\n    var intent = asObject(intents[i]);\n    if (intent.key === intentKey) return intent;\n  }\n  return {};\n}\n\nfunction resolveShape(item, shapeDefs) {\n  item = parseMaybeJson(item);\n\n  if (typeof item === \"string\") {\n    return shapeDefs[item] || { key: item };\n  }\n\n  item = asObject(item);\n  var definition = cloneObject(item.definition || item);\n  var key = item.key || item.shapeKey || definition.key || definition.name || null;\n  if (!key) return null;\n\n  if (Object.keys(definition).length === 0 && shapeDefs[key]) {\n    definition = cloneObject(shapeDefs[key]);\n  }\n\n  definition.key = definition.key || key;\n  return definition;\n}\n\nvar variables = ($context && $context.$variables) || {};\nvar intentOutput = ($context && $context.$nodes && $context.$nodes.GET_BUSINESS_INTENT && $context.$nodes.GET_BUSINESS_INTENT.$output) || {};\nvar intentResult = asObject(intentOutput.result || intentOutput);\nvar intentKey = variables.intentKey || variables.selectedIntentKey || intentResult.intentKey || intentResult.key || null;\nvar intent = cloneObject(findIntentByKey(intentKey));\nvar shapeDefs = asObject(variables.shapeDefinition);\n\nvar shapeItems = getMappedShapeKeys(intentKey);\nvar seen = {};\nvar shapes = [];\nshapeItems.forEach(function (item) {\n  var shape = resolveShape(item, shapeDefs);\n  var shapeKey = shape && (shape.key || shape.name);\n  if (!shape || !shapeKey || seen[shapeKey]) return;\n  seen[shapeKey] = true;\n  shapes.push(shape);\n});\n\nintent.key = intent.key || intentKey;\n\nreturn {\n  intent: intent,\n  shapes: shapes\n};"
          },
          "outcomes": {
            "success": "1777456020781"
          },
          "diagram": {
            "x": 7510,
            "y": 7702
          },
          "code": "GET_INTENT_AND_SHAPES",
          "id": "1776106031699",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 1,
                "max_tokens": 32000,
                "p": 0.5,
                "temperature": 0.01,
                "reasoning_effort": "low"
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Identify Business Intent"
          },
          "outcomes": {
            "success": "1776105915535"
          },
          "diagram": {
            "x": 8410,
            "y": 7258
          },
          "code": "GET_BUSINESS_INTENT",
          "id": "1776104627398",
          "inputs": [
            {
              "id": "1776104627398_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert routing assistant for an Accounts Payable (AP) payments troubleshooting agent.\n\nObjective\nAnalyze the user's request and return:\n1. the correct flow:\n   - inquiry\n   - unsupported-flows\n2. the single best matching Business/Skill intent key from the provided catalog\n\nImportant Principle\nThe provided Business/Skill Intents are the ONLY source of truth.\n\nThe positive NLP examples in the provided catalog are the whitelist of supported request patterns.\n\nDo not invent, infer, generalize, or force-fit intents that are not represented by a positive NLP example in the provided catalog.\n\nHowever, end users may use words like \"details\", \"view\", \"show\", \"fetch\", or \"get\" in different ways. Before routing, determine whether the user is asking for:\n- a specific single-record detail view, or\n- a filtered list/search result with record-level details.\n\nInputs\n- User Question:\n  {{$context.$system.$inputMessage}}\n\n- Chat History:\n  {{$context.$triggers.conversationHistory}}\n\n- Business/Skill Intents:\nResult-1\n  {{$context.$nodes.FIN_AP_VECTOR_READ_BUSINESS_INTENT.$output}}\n\nResult-2\n  {{$context.$nodes.FIN_AP_VECTOR_READ_INDEXED_BUSINESS_INTENT.$output}}\n\nDecision Rules\n\n1. Resolve the user's request\n\nFirst evaluate the current user message on its own.\n\nUse chat history only when the current message is incomplete, referential, or ambiguous, and prior turns clearly complete the missing object, action, or filter.\n\nIf the current message is self-contained, ignore chat history.\n\nDo not infer a multi-step workflow.\n\nDo not choose an intent because it could be used as a first step.\n\nMatch only the user's actual requested outcome.\n\n2. Understand user context before routing\n\nClassify the user's requested outcome into one of these result-context types:\n\nA. Filtered record search / filtered record details\nUse this interpretation when the user asks to show, view, get, fetch, display, list, or see records using a broad filter, and does not identify one specific record by unique id or name.\n\nExamples:\n- \"Show PPRs in status Pending installments review\"\n- \"Show details of PPRs in status Pending installments review\"\n- \"Fetch all PPR details in status Pending installments review\"\n- \"View PPR records created after 2025\"\n- \"Show completed PPRs\"\n- \"Show payment process requests with payment validation errors\"\n\nIn this context, words like \"details\" or \"all details\" mean:\n\"return the matching records with available/detail columns.\"\n\nThey do not necessarily mean a single-record detail-view intent.\n\nB. Specific record detail view\nUse this interpretation when the user asks for details of one specific business object identified by a unique identifier, such as PPR name, PPR id, invoice number, payment reference, file id, or another unique key.\n\nExamples:\n- \"View details of PPR gapr_ppr_test_4\"\n- \"Show PPR details whose name is CPPRT_020015\"\n- \"What payment file format was used for PPR PPR05-009\"\n\nC. Analytical, diagnostic, or summary request\nUse this interpretation when the user asks to analyze, summarize, explain, troubleshoot, calculate impact, identify root cause, or provide remediation guidance.\n\nExamples:\n- \"Why did this PPR fail?\"\n- \"Summarize the top suppliers by value\"\n- \"What does a funds reservation failure mean?\"\n- \"Show me exceptions for all PPRs\"\n\nD. Mutation/action request\nUse this interpretation when the user asks to approve, reject, cancel, update, remove, create, submit, reschedule, or modify data.\n\nIf no matching mutation/action intent exists in the catalog, return unsupported-flows.\n\n3. Extract filters from the user request\n\nAfter resolving the user's context, identify explicit filters in the user request.\n\nCommon filter types include:\n- status or lifecycle stage\n- date or date range\n- creator/requestor\n- approver or assigned-to-me queue\n- supplier\n- business unit\n- currency\n- amount threshold\n- PPR name or id\n- invoice number\n- payment reference\n- payment method\n- bank account\n- validation error type\n- rejection reason\n- hold reason\n- exception category\n\nApply these filters only for routing comparison. Do not invent filters that the user did not provide.\n\n4. Match against positive NLP examples only\n\nCompare the resolved user request against the positive `nlpExamples` in the provided catalog.\n\nThe `description`, `name`, vector score, text score, shape name, and business object are not whitelist evidence.\n\nUse the description only after an NLP example match has already been found, and only to reject a candidate if the description contradicts the matched example or user request.\n\nNever select an intent based only on:\n- description similarity\n- vector similarity\n- keyword overlap\n- backend shape capability\n- AP-domain similarity\n- assumption that the backend can technically filter by a field\n\nAn intent is eligible only if at least one positive NLP example under that exact intent semantically matches the resolved user request after context classification.\n\n5. Semantic match definition\n\nA user request matches a positive NLP example when the normalized meaning has the same:\n\n- primary business action category\n- main business object\n- expected result context\n- supported filter pattern\n\nPrimary business action category:\nThe main operation requested by the user.\n\nExamples:\n- find/search/list/fetch records\n- view a specific record\n- review items within a record\n- count\n- group\n- summarize\n- analyze\n- troubleshoot\n- explain\n- approve\n- update\n- cancel\n\nMain business object:\nThe primary object being requested.\n\nExamples:\n- PPR\n- payment\n- invoice\n- installment\n- supplier\n- payment file\n- approval\n- rejection\n- validation error\n- conversion rate\n\nExpected result context:\nThe kind of result the user expects.\n\nExamples:\n- filtered list of records\n- filtered list with detail columns\n- specific record details\n- approval queue\n- rejected-item list\n- error diagnosis\n- summary\n- explanation\n- remediation guidance\n\nSupported filter pattern:\nThe filter type and business meaning shown in the positive NLP example.\n\nExamples:\n- exact seeded status filter\n- date filter\n- PPR name/id filter\n- supplier filter\n- amount threshold\n- currency filter\n- business unit filter\n- assigned-to-me approval filter\n- validation-error filter\n- rejection-reason filter\n\n6. Details wording normalization\n\nThe word \"details\" must be interpreted from context.\n\nDo not automatically treat every \"details\" request as a specific-record detail view.\n\nA. Treat \"details\" as filtered list/search when all of the following are true:\n- the user does not provide a unique PPR name/id or other unique record identifier;\n- the user provides a broad filter such as status, date, creator, supplier, business unit, currency, amount, or organization;\n- the user appears to want all matching records;\n- a positive NLP example under a list/search intent supports the same object and same filter pattern.\n\nExample:\nUser:\n\"show details of PPR in status 'Pending installments review'\"\n\nNormalize for routing context:\n\"show PPRs in status Pending installments review with available record details\"\n\nThis may match a positive NLP example such as:\n\"Show PPRs in status Pending installments review\"\n\nbecause:\n- primary action category: find/list/fetch records\n- object: PPR\n- result context: filtered PPR records\n- filter pattern: exact seeded status = Pending installments review\n\nB. Treat \"details\" as specific-record detail view when the user provides a unique record identifier.\n\nExample:\nUser:\n\"View details of PPR gapr_ppr_test_4\"\n\nThis may match:\n\"View details of PPR gapr_ppr_test_4\"\n\nbecause:\n- primary action category: view specific record\n- object: PPR\n- result context: single PPR detail view\n- filter pattern: PPR name/id\n\nC. Do not match filtered-list details to a specific-record detail intent unless a positive NLP example explicitly supports the same broad filter result shape.\n\nExample:\nUser:\n\"Show details of PPRs in status Pending installments review\"\n\nDo not match to:\n\"View details of PPR gapr_ppr_test_4\"\n\nbecause status-filtered multi-record details and one-PPR details are different result contexts.\n\n7. Allowed normalization\n\nYou may normalize surface-level differences only when the action category, object, result context, and filter pattern already match.\n\nAllowed abbreviations:\n- \"pmt\" = \"payment\"\n- \"inv\" = \"invoice\"\n- \"supp\" = \"supplier\"\n- \"PPR\" = \"Payment Process Request\"\n\nAllowed equivalent wording:\n- \"show\", \"list\", \"display\", \"get\", \"fetch\", \"view\", and \"see\" may match when they express the same result context.\n- \"show details\", \"fetch details\", \"view details\", and \"get details\" may match a filtered list/search example only when the user provides a broad filter and no unique record id/name.\n\nDate values:\n- Date values may vary only when the example already contains the same date-filter pattern.\n- Example: \"Show PPR completed after 2024\" can match \"Show PPR completed after 2025\".\n\nIdentifier values:\n- PPR names, PPR ids, invoice numbers, payment numbers, supplier names, and business unit names may vary only when the example contains that same identifier slot.\n- Example: \"View details of PPR ABC123\" can match \"View details of PPR gapr_ppr_test_4\".\n\nAmount and currency values:\n- Amounts and currencies may vary only when the example contains the same amount/currency filter pattern.\n- Example: \"Show payments over $50,000\" can match \"Show payments over $100,000\".\n\n8. Restricted normalization: statuses, stages, error types, and reasons\n\nDo not treat statuses, lifecycle stages, seeded workflow states, error types, rejection reasons, hold reasons, or exception types as freely interchangeable parameter values.\n\nThese values are business semantics, not generic variables.\n\nA user status, stage, error, reason, or exception matches an example only if one of these is true:\n\n- The example contains the same status, stage, error type, reason, or a clear synonym.\n- The example explicitly uses an open-ended pattern such as:\n  - \"by status\"\n  - \"with status X\"\n  - \"in status X\"\n  - \"for any status\"\n  - \"group by status\"\n  - \"which statuses\"\n- The example clearly supports that exact business category.\n\nDo not generalize from a broad status to a seeded status.\n\nExamples:\n- \"Show PPR completed after 2024\" can match \"Show PPR completed after 2025\" because the status is the same and only the date changed.\n- \"Show PPR pending since June\" can match \"Show PPR pending since last month\" because the broad pending status and date pattern are the same.\n- \"Show PPRs in Pending installments review status\" must not match \"Show PPR pending since last month\" because \"Pending installments review\" is a specific seeded workflow status.\n- \"Show PPRs in Pending installments review status\" can match only if a positive NLP example explicitly supports that status or an open-ended seeded-status pattern.\n- \"Show PPRs with document validation errors\" must not match \"Show PPRs stuck in failure\" unless the example explicitly supports document validation errors or an open-ended error-status pattern.\n- \"Show invoices on payment hold\" must not match \"Show invoices pending approval\" because the hold reason/status is different.\n\n9. Unsupported-by-default rule\n\nIf the user asks for a status, lifecycle stage, seeded state, error type, rejection reason, hold reason, or exception reason that is not represented in a positive NLP example or supported by an open-ended pattern in a positive NLP example, return unsupported-flows.\n\nDo not use the description to fill the gap.\nDo not use shape fields to fill the gap.\nDo not construct a filter because the field appears in the shape.\nDo not infer that the backend can support it.\nDo not route to a broader intent.\n\n10. Description usage\n\nDescriptions are not part of the whitelist.\n\nUse descriptions only after at least one positive NLP example has already matched.\n\nDescriptions may be used only to reject a candidate if the description contradicts the matched example or the user request.\n\nDescriptions must not be used to:\n- make an intent eligible\n- add supported statuses\n- add supported filters\n- add supported result shapes\n- add supported query patterns\n- resolve a missing example\n\nIf a description says an intent is list-oriented, that does not block phrases like \"show details\" when the user context is clearly filtered record search and a positive NLP example supports the same filter pattern.\n\nIf a description says an intent is only for specific-record details, do not use it for broad-filter record searches unless a positive NLP example explicitly supports that broad-filter details result shape.\n\n11. Matching quality bar\n\nA valid match requires all of the following:\n\n- same primary business action category\n- same main business object\n- compatible expected result context\n- same supported filter pattern\n- no unsupported status, stage, error, reason, or exception generalization\n\nValid examples:\n- User: \"Show details of PPR in status Pending installments review\"\n- Positive example: \"Show PPRs in status Pending installments review\"\n- Valid match if the selected intent is a list/search PPR intent, because \"details\" means filtered record details and the exact status-filter pattern is supported.\n\n- User: \"View details of PPR ABC123\"\n- Positive example: \"View details of PPR gapr_ppr_test_4\"\n- Valid match if the selected intent is a specific PPR detail intent, because the PPR identifier slot is supported.\n\nInvalid matches:\n- specific-record detail request matched to a broad list example\n- broad filtered-list request matched to a specific-record detail example\n- same object but different action category\n- same action but different object\n- same keyword but different outcome\n- same broad object but unsupported filter pattern\n- same status family but different seeded lifecycle state\n- analysis request matched to a lookup example\n- troubleshooting request matched to a list example\n- mutation/action request matched to an inquiry example\n- seeded status query matched to a broad status example\n- request selected because the backend shape has a possible filter field\n\n12. Catalog-first routing\n\nReturn inquiry only when at least one positive NLP example under the selected intent semantically matches the resolved user request according to these rules.\n\nIf one or more positive NLP examples match:\n- choose the intent with the closest matching positive NLP example\n- set contextFlow to \"inquiry\"\n- set intentKey to the exact matched catalog key\n\nIf no positive NLP example matches:\n- set contextFlow to \"unsupported-flows\"\n- set intentKey to null\n\nIf multiple examples appear partially related but none clearly match the same action category, object, result context, and filter pattern:\n- return unsupported-flows\n\n13. Continuation handling\n\nIf the user says things like \"show any one\", \"pick one\", \"choose one\", \"this one\", \"those\", \"continue\", \"show details\", or similar:\n- use chat history only if it clearly identifies the missing object, action context, result context, and filter pattern;\n- then apply the same positive NLP-example whitelist rules;\n- if no positive NLP example matches the resolved request, return unsupported-flows.\n\n14. Tie-breaking\n\nWhen multiple intents have matching positive NLP examples, choose the most specific matching intent using this order:\n\n1. Specific object-detail intent when the user provides a unique record identifier and asks for one record's details.\n2. Filtered list/search intent when the user provides broad filters and asks for all matching records or details.\n3. Stage-specific review intent when the user asks to review items inside a PPR stage, such as selected installments, rejected payments, proposed payments, approvals, or validation errors.\n4. Summary intent when the user asks for totals, summary, breakdown, or overview.\n5. Analysis intent when the user asks for why, impact, prioritization, root cause, or what-if analysis.\n\nDo not choose a stage-specific, summary, or analysis intent merely because the status name appears related. The positive NLP example must match the requested result context.\n\n15. Key-only output guardrail\n\nThe only valid intent identifier to return is the exact catalog key.\n\nNever return or copy the `name` field as the intentKey.\n\nTreat `name` as metadata only.\n\nNever invent an intent key.\n\nNever return a key that is not present in the provided catalog.\n\n16. Final self-check\n\nBefore returning inquiry, verify:\n\n- The selected intent key exists in the provided catalog.\n- A positive NLP example under that selected intent matches the user's primary business action category.\n- The same positive NLP example matches the user's main business object.\n- The same positive NLP example supports the user's expected result context.\n- The same positive NLP example supports the user's filter pattern.\n- The match does not rely on description text alone.\n- The match does not rely on vector score.\n- The match does not rely on unsupported status, stage, error, reason, or exception generalization.\n\nIf any statement is false, return:\n\n{\n  \"contextFlow\": \"unsupported-flows\",\n  \"intentKey\": null,\n  \"reason\": \"No supported business/skill intent matches the user request.\"\n}\n\nOutput Format\n\nReturn strictly a valid JSON object with exactly this schema and no extra text:\n\n{\n  \"contextFlow\": \"inquiry or unsupported-flows\",\n  \"intentKey\": \"exact catalog key only, never a name label, or null\",\n  \"reason\": \"concise plain-English explanation of why this route and intent were selected\"\n}\n\nFor inquiry:\n- The reason must mention that a positive NLP example matched.\n- The reason may mention whether \"details\" was interpreted as a filtered record-list or a specific-record detail view.\n- Do not say the intent matched because of the description.\n\nFor unsupported-flows:\n- Use the standard unsupported reason unless a concise specific reason is needed.\n\nIf no positive NLP example semantically matches the normalized user request, always return:\n\n{\n  \"contextFlow\": \"unsupported-flows\",\n  \"intentKey\": null,\n  \"reason\": \"No supported business/skill intent matches the user request.\"\n}"
            },
            {
              "id": "1776104627398_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You are a business intent identifier based on the user context and provided business intent definition."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"reason\": {\n      \"type\": \"string\"\n    },\n    \"intentKey\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"contextFlow\": {\n      \"type\": \"string\",\n      \"enum\": [\"inquiry\", \"unsupported-flows\"]\n    }\n  },\n  \"required\": [\"reason\", \"intentKey\", \"contextFlow\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Unsupported feature"
          },
          "outcomes": {},
          "diagram": {
            "x": 9105,
            "y": 9256
          },
          "code": "UNSUPPORTED_FEATURE",
          "convergenceTargetId": "1776676346112",
          "id": "1776147629545",
          "inputs": [
            {
              "id": "1776147629546_1",
              "name": "returnValue",
              "type": "string",
              "value": "This type of question isn't supported in the current release. For more information, please refer to the documentation or contact your system administrator."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Compact Data Planner Input",
            "returnType": "object",
            "sourceCode": "/*\n * Compact planner input for optimized LLM planning.\n *\n * Intended placement:\n * - Add this as a CODE node after intent-with-combined-shape and before 3a/3b.\n * - Point optimized planner prompts at this node's compact output.\n *\n * Contract:\n * - Keeps full shape definitions out of the planner LLM context.\n * - Preserves shapeKey/api/queryType so stage 4 can fetch the full shape by key.\n * - Returns only the compacted `intent` and compacted `shapes`.\n */\n\nvar MAX_TEXT = 900;\nvar MAX_LONG_TEXT = 1800;\nvar MAX_FIELDS = 180;\nvar MAX_FILTER_VALUES = 25;\nvar MAX_TABLES = 12;\nvar MAX_BUSINESS_DRIVERS = 40;\n\nfunction parseMaybeJson(value) {\n  if (value == null) return null;\n  if (typeof value === \"object\") return value;\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return value;\n    }\n  }\n  return value;\n}\n\nfunction asArray(value) {\n  if (value == null) return [];\n  if (Array.isArray(value)) return value;\n  if (typeof value === \"string\") {\n    if (value.trim() === \"\") return [];\n    return value.split(\",\").map(function (part) {\n      return part.trim();\n    }).filter(Boolean);\n  }\n  return [value];\n}\n\nfunction asObject(value) {\n  value = parseMaybeJson(value);\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\n\nfunction compactText(value, maxLen) {\n  if (value == null) return null;\n  var text = String(value).replace(/\\s+/g, \" \").trim();\n  if (!text) return null;\n  var limit = maxLen || MAX_TEXT;\n  return text.length > limit ? text.slice(0, limit - 3) + \"...\" : text;\n}\n\nfunction uniq(values, limit) {\n  var seen = {};\n  var out = [];\n  var max = limit || values.length;\n  for (var i = 0; i < values.length; i++) {\n    var value = values[i];\n    if (value == null) continue;\n    value = String(value).trim();\n    if (!value || seen[value]) continue;\n    seen[value] = true;\n    out.push(value);\n    if (out.length >= max) break;\n  }\n  return out;\n}\n\nfunction getNodeResult(nodeCode) {\n  var nodes = ($context && $context.$nodes) || {};\n  var node = nodes[nodeCode] || {};\n  var output = node.$output || node.output || {};\n  if (output && output.result !== undefined) return parseMaybeJson(output.result);\n  return parseMaybeJson(output);\n}\n\nfunction normalizeQueryType(shape) {\n  var type = shape.shapeType || shape.type || shape.queryType || \"\";\n  type = String(type);\n  if (type === \"analyticView\" || type === \"AV\") return \"AV\";\n  if (type === \"view\" || type === \"BV\") return \"BV\";\n  if (type === \"EXTRACTION\" || type === \"extraction\" || type === \"Extraction\") return \"Extraction\";\n  if (type === \"ev\" || type === \"EV\") return \"EV\";\n  return type || null;\n}\n\nfunction getFieldsObject(shape) {\n  return asObject(shape.fields);\n}\n\nfunction declaredFields(shape) {\n  var fieldsObj = getFieldsObject(shape);\n  if (Array.isArray(shape.fields)) return shape.fields;\n  if (fieldsObj.fields != null) return asArray(fieldsObj.fields);\n  if (shape.supportedFields && shape.supportedFields.base) {\n    return asArray(shape.supportedFields.base).concat(asArray(shape.supportedFields.optional));\n  }\n  return [];\n}\n\nfunction baseFields(shape) {\n  var fieldSelection = asObject(shape.fieldSelection);\n  if (fieldSelection.base != null) return asArray(fieldSelection.base);\n  if (shape.defaultFields != null) return asArray(shape.defaultFields);\n  return declaredFields(shape);\n}\n\nfunction filterCatalog(shape) {\n  return asArray(shape.filterConditions || shape.supportedFilters || shape.filters).map(function (filter) {\n    if (typeof filter === \"string\") {\n      return { attribute: filter };\n    }\n    filter = asObject(filter);\n    var attribute = filter.attribute || filter.name || filter.field;\n    if (!attribute) return null;\n    return {\n      attribute: attribute,\n      type: filter.type || filter.dataType || null,\n      operators: filter.operators || filter.operator || null,\n      possibleValues: asArray(filter.possibleValues).slice(0, MAX_FILTER_VALUES),\n      usage: compactText(filter.usage || filter.notes || filter.description, 260)\n    };\n  }).filter(Boolean);\n}\n\nfunction businessDrivers(shape) {\n  return asArray(shape.businessDrivers).slice(0, MAX_BUSINESS_DRIVERS).map(function (driver, index) {\n    driver = asObject(driver);\n    return {\n      key: driver.key || driver.name || (\"driver_\" + (index + 1)),\n      name: driver.name || null,\n      description: compactText(driver.description || driver.usage || driver.name, 360),\n      when: compactText(driver.when, 360),\n      fieldsToReturn: uniq(asArray(driver.fieldsToReturn), MAX_FIELDS),\n      filters: driver.filters || null,\n      extraFilterExpressions: asArray(driver.extraFilterExpressions).map(function (expression) {\n        return compactText(expression, 360);\n      }).filter(Boolean),\n      notes: compactText(driver.notes, 700),\n      intentSliceKey: driver.intentSliceKey || driver.sliceKey || null\n    };\n  });\n}\n\nfunction outputTables(outputPattern) {\n  var tables = [];\n  outputPattern = asObject(outputPattern);\n  [\"summary\", \"details\", \"actions\"].forEach(function (sectionName) {\n    var section = asObject(outputPattern[sectionName]);\n    asArray(section.tables).forEach(function (table) {\n      table = asObject(table);\n      if (!table.key && !table.title && !table.columns) return;\n      tables.push({\n        section: sectionName,\n        key: table.key || null,\n        title: table.title || null,\n        description: compactText(table.description, 260),\n        columns: asArray(table.columns)\n      });\n    });\n  });\n  return tables.slice(0, MAX_TABLES);\n}\n\nfunction compactIntent(intent, intentKey) {\n  intent = asObject(intent);\n  var data = asObject(intent.data);\n  var planningInstructions = compactText(\n    intent.dataPlanInstruction || intent.promptInstruction || intent.additionalInstructions,\n    MAX_LONG_TEXT\n  );\n  return {\n    key: intent.key || intentKey || null,\n    skillType: intent.skillType || null,\n    intentLevel: intent.intentLevel || null,\n    parentSkillKey: intent.parentSkillKey || null,\n    name: intent.name || null,\n    description: compactText(intent.description, MAX_TEXT),\n    domainKnowledge: compactText(intent.intentDomainKnowledge, MAX_TEXT),\n    dataGoal: compactText(data.goal, MAX_TEXT),\n    slices: asArray(data.slices).map(function (slice) {\n      return compactText(slice, 360);\n    }).filter(Boolean),\n    planningInstructions: planningInstructions,\n    promptInstruction: planningInstructions,\n    dataPlanInstruction: compactText(intent.dataPlanInstruction, MAX_LONG_TEXT),\n    additionalInstructions: compactText(intent.additionalInstructions, MAX_TEXT),\n    clarification: asArray(asObject(intent.clarification).rules).map(function (rule) {\n      rule = asObject(rule);\n      return {\n        when: compactText(rule.when, 260),\n        question: compactText(rule.question, 260)\n      };\n    }),\n    outputTables: outputTables(intent.outputPattern)\n  };\n}\n\nfunction compactAliasMap(shape, availableFields) {\n  var fieldsObj = getFieldsObject(shape);\n  var aliasMap = asObject(shape.fieldAlias);\n  var nestedAliasMap = asObject(fieldsObj.fieldAlias);\n  var allowed = {};\n  var out = {};\n  availableFields.forEach(function (field) {\n    allowed[field] = true;\n  });\n\n  function addMatchingAliases(map) {\n    Object.keys(map).forEach(function (label) {\n      var target = map[label];\n      if (typeof target !== \"string\") return;\n      if (allowed[target]) out[label] = target;\n    });\n  }\n\n  addMatchingAliases(aliasMap);\n  addMatchingAliases(nestedAliasMap);\n  return out;\n}\n\nfunction avSummary(shape) {\n  var dimensions = asArray(shape.dimensions).map(function (dimension) {\n    dimension = asObject(dimension);\n    return {\n      name: dimension.name || null,\n      attributes: asArray(dimension.attributes).map(function (attr) {\n        attr = asObject(attr);\n        return attr.name || attr.attribute || attr;\n      }).filter(Boolean),\n      hierarchies: asArray(dimension.hierarchies).map(function (hierarchy) {\n        hierarchy = asObject(hierarchy);\n        return {\n          name: hierarchy.name || null,\n          levels: asArray(hierarchy.levels)\n        };\n      })\n    };\n  });\n\n  return {\n    measures: asArray(shape.measures),\n    dimensions: dimensions\n  };\n}\n\nfunction compactDateGuidance(shape) {\n  var guidance = asObject(shape.dateFilterGuidance);\n  var out = {};\n  Object.keys(guidance).forEach(function (key) {\n    out[key] = compactText(guidance[key], 260);\n  });\n  return Object.keys(out).length ? out : null;\n}\n\nfunction inferSelectAliases(selectText) {\n  selectText = compactText(selectText, MAX_LONG_TEXT);\n  if (!selectText) return [];\n\n  var aliases = [];\n  var aliasPattern = /\\bAS\\s+([A-Za-z_][A-Za-z0-9_]*)/gi;\n  var match;\n  while ((match = aliasPattern.exec(selectText)) !== null) {\n    aliases.push(match[1]);\n  }\n\n  var groupMatch = /\\bGROUP\\s+BY\\s+([A-Za-z_][A-Za-z0-9_.,\\s]*)/i.exec(selectText);\n  if (groupMatch && groupMatch[1]) {\n    groupMatch[1].split(\",\").forEach(function (part) {\n      part = part.trim();\n      if (/^[A-Za-z_][A-Za-z0-9_]*$/.test(part)) {\n        aliases.push(part);\n      }\n    });\n  }\n\n  return uniq(aliases, MAX_FIELDS);\n}\n\nfunction compactSelectExamples(shape) {\n  return asArray(shape.selectExamples).map(function (example) {\n    example = asObject(example);\n    var outputFields = asArray(example.fieldsToReturn || example.outputFields || example.columns)\n      .concat(inferSelectAliases(example.select));\n    return {\n      key: example.key || example.name || null,\n      name: example.name || null,\n      description: compactText(example.description || example.usage, 360),\n      outputFields: uniq(outputFields, MAX_FIELDS),\n      intentSliceKey: example.intentSliceKey || example.sliceKey || null,\n      notes: compactText(example.notes, 700)\n    };\n  });\n}\n\nfunction compactExampleQuestions(shape) {\n  return asArray(shape.exampleQuestions).map(function (question) {\n    return compactText(question, 260);\n  }).filter(Boolean);\n}\n\nfunction compactShapeCard(shapeWrapper) {\n  var shape = shapeWrapper && shapeWrapper.definition ? shapeWrapper.definition : shapeWrapper;\n  shape = asObject(shape);\n  var queryType = normalizeQueryType(shape);\n  var drivers = businessDrivers(shape);\n  var filters = filterCatalog(shape);\n  var driverFields = [];\n  drivers.forEach(function (driver) {\n    driverFields = driverFields.concat(asArray(driver.fieldsToReturn));\n  });\n\n  var filterFields = filters.map(function (filter) {\n    return filter.attribute;\n  });\n\n  var availableFields = uniq(\n    baseFields(shape)\n      .concat(driverFields)\n      .concat(filterFields)\n      .concat(asArray(shape.sortableAttributes)),\n    MAX_FIELDS\n  );\n\n  if (queryType === \"Extraction\" && availableFields.length === 0) {\n    availableFields = uniq(declaredFields(shape), MAX_FIELDS);\n  }\n\n  var card = {\n    key: shape.key || (shapeWrapper && shapeWrapper.key) || null,\n    name: shape.name || null,\n    api: shape.api || (queryType === \"Extraction\" ? \"extraction/extract\" : null),\n    queryType: queryType,\n    shapeType: queryType,\n    type: queryType,\n    role: shape.shapeRole || shape.role || null,\n    shapeRole: shape.shapeRole || shape.role || null,\n    description: compactText(shape.description, MAX_TEXT),\n    additionalInstructions: compactText(shape.additionalInstructions, MAX_TEXT),\n    exampleQuestions: compactExampleQuestions(shape),\n    defaultFields: uniq(baseFields(shape), MAX_FIELDS),\n    availableFields: availableFields,\n    fieldHints: availableFields,\n    supportedFilters: filters,\n    filterHints: filters,\n    businessDrivers: drivers,\n    selectExamples: compactSelectExamples(shape),\n    dateFilterGuidance: compactDateGuidance(shape),\n    dateFilterHints: compactDateGuidance(shape),\n    fieldAlias: compactAliasMap(shape, availableFields)\n  };\n\n  if (queryType === \"AV\") {\n    card.analyticView = avSummary(shape);\n  }\n\n  return card;\n}\n\nfunction getFullPlannerInput() {\n  var intentWithShapes = getNodeResult(\"GET_INTENT_AND_SHAPES\");\n  var selectedIntent = asObject(intentWithShapes && intentWithShapes.intent);\n\n  return {\n    intentKey: selectedIntent.key || null,\n    intent: selectedIntent,\n    shapes: asArray(intentWithShapes && intentWithShapes.shapes)\n  };\n}\n\nvar fullPlannerInput = getFullPlannerInput();\nvar fullShapes = asArray(fullPlannerInput.shapes);\nvar compactShapes = fullShapes.map(compactShapeCard).filter(function (card) {\n  return !!card.key;\n});\n\n/*\n * Final output fields\n *\n * intent includes compacted fields from the selected business intent:\n * - key, skillType, intentLevel, parentSkillKey\n * - name, description, domainKnowledge\n * - dataGoal, slices\n * - planningInstructions, promptInstruction, dataPlanInstruction, additionalInstructions\n * - clarification rules with when/question\n * - outputTables with section/key/title/description/columns\n *\n * shapes[] includes compacted fields from each selected shape definition:\n * - key, name, api\n * - queryType, shapeType, type\n * - role, shapeRole\n * - description, additionalInstructions\n * - exampleQuestions\n * - defaultFields, availableFields, fieldHints\n * - supportedFilters/filterHints with attribute/type/operators/possibleValues/usage\n * - businessDrivers with key/name/description/when/fieldsToReturn/filters/\n *   extraFilterExpressions/notes/intentSliceKey\n * - selectExamples with key/name/description/outputFields/intentSliceKey/notes\n * - dateFilterGuidance, dateFilterHints\n * - fieldAlias\n * - analyticView for AV shapes with measures and dimensions\n */\nvar compactPlannerInput = {\n  intent: compactIntent(fullPlannerInput.intent, fullPlannerInput.intentKey),\n  shapes: compactShapes\n};\n\nreturn compactPlannerInput;"
          },
