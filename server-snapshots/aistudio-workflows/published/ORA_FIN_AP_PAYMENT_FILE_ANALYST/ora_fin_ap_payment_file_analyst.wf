                  "metadata": {
                    "name": "Parse Extract Query",
                    "returnType": "object",
                    "sourceCode": "var heading = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem.plan.header;\nvar sequence = 1; // from layout plan\nvar formatHint = \"\"; // or e.g. \"statusCounts\"\n\n// API URL\nvar apiUrl = \"/api/boss/extraction/extract\";\n\n// Query context from EXTRACTIONQUERY\nvar queryContext =\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n    ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n    : {};\n\nvar exOut = queryContext;\n\n// 1) Extract rows from EV output\nvar rows = Array.isArray($context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EXTRACT_DATA.$output)\n  ? $context.$nodes.FIN_AP_LOOP_EXECUTOR.GET_EXTRACT_DATA.$output\n  : [];\n\n// 2) fields + fieldAlias (DISPLAY -> TECHNICAL) from extraction query node (optional)\nvar fields = \"\";\nvar fieldAlias = {};\n\nif (\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER &&\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output\n) {\n  exOut = $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_LLM_EXTRACTION_QUERY_BUILDER.$output;\n\n  if (typeof exOut.fields === \"string\") {\n    fields = exOut.fields; // may be empty; handled below\n  }\n\n  if (exOut.fieldAlias && typeof exOut.fieldAlias === \"object\") {\n    // Expected shape: { DisplayLabel: \"TECHNICAL_FIELD\" }\n    fieldAlias = exOut.fieldAlias;\n  }\n}\n\n// 3) Build technicalFields from fields string or from row keys if fields is empty\nvar technicalFields = [];\nif (typeof fields === \"string\" && fields.trim().length > 0) {\n  technicalFields = fields.split(\",\").map(function (f) {\n    return f.trim();\n  });\n} else if (rows.length > 0) {\n  // No fields provided: show all columns present in the data\n  technicalFields = Object.keys(rows[0]);\n}\n\n// Helper: camelCase a TECHNICAL field name for default display when no alias exists\nfunction toCamelCase(name) {\n  return String(name)\n    .toLowerCase()\n    .replace(/[_\\s]+([a-z0-9])/g, function (_, g1) {\n      return g1.toUpperCase();\n    });\n}\n\n// Helper: resolve a field name on a row in a **case-insensitive** way\nfunction getValueCaseInsensitive(obj, technical) {\n  var techLower = String(technical).toLowerCase();\n\n  for (var key in obj) {\n    if (!Object.prototype.hasOwnProperty.call(obj, key)) continue;\n    if (String(key).toLowerCase() === techLower) {\n      var v = obj[key];\n      return v === null || v === undefined ? \"\" : v;\n    }\n  }\n\n  return \"\";\n}\n\n// Helper: given a technical column, find its display name (case-insensitive) if alias exists, else camelCase(technical)\nfunction getDisplayName(technical) {\n  var techLower = String(technical).toLowerCase();\n\n  for (var display in fieldAlias) {\n    if (!fieldAlias.hasOwnProperty(display)) continue;\n    var mapped = fieldAlias[display];\n    if (mapped != null && String(mapped).toLowerCase() === techLower) {\n      return display;\n    }\n  }\n\n  // No explicit alias match: generate a camelCase label\n  return toCamelCase(technical);\n}\n\nfunction identityFieldMapping(sourceName) {\n  return {\n    transformId: \"identity\",\n    sourceFields: {\n      colName: sourceName\n    }\n  };\n}\n\nfunction buildFieldMapping(technicalFields) {\n  var mapping = {};\n\n  for (var i = 0; i < technicalFields.length; i++) {\n    var technicalName = technicalFields[i];\n    var displayName = getDisplayName(technicalName);\n    mapping[displayName] = identityFieldMapping(technicalName);\n  }\n\n  return mapping;\n}\n\nfunction buildPayload(queryContext, paginationCondition) {\n  var extractionBody = queryContext && queryContext.extractionQuery;\n\n  if (typeof extractionBody === \"string\") {\n    extractionBody = JSON.parse(extractionBody);\n  }\n\n  extractionBody = JSON.parse(JSON.stringify(extractionBody || {}));\n\n  return {\n    extractionBody: extractionBody,\n    paginationCondition: paginationCondition,\n    paginationOffset: \"OFFSET $lowerlimit ROWS FETCH NEXT 50 ROWS ONLY\"\n  };\n}\n\n// 4) Build processed rows: keys = display names (or camelCase technical)\nvar processedRows = [];\nfor (var r = 0; r < rows.length; r++) {\n  var src = rows[r];\n  var dst = {};\n\n  for (var t = 0; t < technicalFields.length; t++) {\n    var technicalName = technicalFields[t]; // e.g. \"currency\" vs \"CURRENCY\"\n    var displayName = getDisplayName(technicalName);\n\n    var value = getValueCaseInsensitive(src, technicalName);\n    dst[displayName] = value;\n  }\n\n  processedRows.push(dst);\n}\n\n// 5) Column order = display names in same order as technicalFields\nvar columnOrder = technicalFields.map(function (technicalName) {\n  return getDisplayName(technicalName);\n});\n\nvar fieldMapping = buildFieldMapping(technicalFields);\nvar paginationCondition = queryContext && typeof queryContext.paginationCondition === \"string\"? queryContext.paginationCondition.trim(): \"\";\nvar payload = paginationCondition ? buildPayload(queryContext, paginationCondition) : null;\n\n// 6) Assemble the final table block\nvar tableBlock = {\n  type: \"table\",\n  heading: heading,\n  content: processedRows,\n  sequence: sequence,\n  formatHint: formatHint,\n  columnOrder: columnOrder,\n  fieldMapping: fieldMapping,\n  purpose: exOut.notes,\n  contextData: {\n    apiUrl: apiUrl,\n    queryContext: queryContext\n  }\n};\n\nif (payload) {\n  tableBlock.payload = payload;\n}\n\nreturn tableBlock;"
