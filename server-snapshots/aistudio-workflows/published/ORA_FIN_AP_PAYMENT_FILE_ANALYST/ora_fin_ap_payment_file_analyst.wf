              "id": "1776062788507",
              "name": "shapeDefinition",
              "value": "{    \"disbursementPaymentInstructionExceptions\": {      \"key\": \"disbursementPaymentInstructionExceptions\",      \"name\": \"disbursementPaymentInstructionExceptions\",      \"type\": \"BV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"DisbursementPaymentTransactionError\",      \"api\": \"objects/ora/erpCore/paymentsFundsDisbursement/v1/disbursementPaymentInstructionExceptions\",      \"description\": \"Use this BV shape for payment-file and instruction-level failures such as formatting, transmission, acknowledgement, and rejection issues affecting whole payment files or large parts of a payment run.\",      \"exampleQuestions\": [        \"Which payment files were rejected by the bank?\",        \"Show file-level transmission failures for the last week.\",        \"List payment instruction exceptions by payment file status and PPR.\",        \"Show me payment validation errors causing entire payment files to be rejected.\",        \"Which whole-batch payment validation errors should I fix first to unblock the most payments?\",        \"Why did payment confirmation for PPR EFT-Batch-45 fail?\"      ],      \"fields\": {        \"fields\": [          \"id\",          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"transactionType\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"errorType.lookupCode\",          \"errorType.meaning\",          \"errorStatus.lookupCode\",          \"errorStatus.meaning\",          \"payablesPaymentFile.paymentInstructionId\",          \"payablesPaymentFile.bankStatusCode\",          \"payablesPaymentFile.errorCode\",          \"payablesPaymentFile.errorMessage\",          \"payablesPaymentFile.timeCreated\",          \"payablesPaymentFile.paymentRequestName\",          \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",          \"payablesPaymentFile.accountPaymentProfile.paymentProfileId\",          \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.systemProfileCode\",          \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\"        ],        \"accessors\": {          \"errorType\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"errorStatus\": {            \"shape\": \"Lookup\",            \"fields\": [              \"lookupType\",              \"meaning\",              \"lookupCode\"            ]          },          \"payablesPaymentFile\": {            \"shape\": \"PayablesPaymentFile\",            \"fields\": [              \"paymentInstructionId\",              \"bankStatusCode\",              \"errorCode\",              \"errorMessage\",              \"timeCreated\",              \"paymentRequestName\"            ],            \"accessors\": {              \"paymentFileProcessingStatus\": {                \"shape\": \"Lookup\",                \"fields\": [                  \"lookupType\",                  \"meaning\",                  \"lookupCode\"                ]              },              \"accountPaymentProfile\": {                \"shape\": \"AccountPaymentProfile\",                \"fields\": [                  \"paymentProfileId\",                  \"paymentProfileName\"                ],                \"accessors\": {                  \"paymentTransmissionConfiguration\": {                    \"shape\": \"PaymentTransmissionConfiguration\",                    \"fields\": [                      \"transmitConfigurationId\",                      \"transmissionConfigurationName\"                    ],                    \"accessors\": {                      \"paymentTransmissionProtocol\": {                        \"shape\": \"PaymentTransmissionProtocol\",                        \"fields\": [                          \"transmitProtocolCode\",                          \"transmissionProtocolName\"                        ]                      }                    }                  },                  \"systemPaymentProfile\": {                    \"shape\": \"SystemPaymentProfile\",                    \"fields\": [                      \"systemProfileCode\"                    ],                    \"accessors\": {                      \"processingType\": {                        \"shape\": \"Lookup\",                        \"fields\": [                          \"lookupType\",                          \"meaning\",                          \"lookupCode\"                        ]                      }                    }                  }                }              }            }          }        },        \"fieldAlias\": {          \"Exception Id\": \"id\",          \"Error Code\": \"errorCode\",          \"Error Date\": \"errorDate\",          \"Error Message\": \"errorMessage\",          \"Transaction Type\": \"transactionType\",          \"Status Reason Code\": \"statusReasonCode\",          \"Status Reason Message\": \"statusReasonMessage\",          \"Error Type Code\": \"errorType.lookupCode\",          \"Error Type\": \"errorType.meaning\",          \"Error Status Code\": \"errorStatus.lookupCode\",          \"Error Status\": \"errorStatus.meaning\",          \"Payment File Id\": \"payablesPaymentFile.paymentInstructionId\",          \"Payment File Reference\": \"payablesPaymentFile.paymentInstructionId\",          \"Bank Status Code\": \"payablesPaymentFile.bankStatusCode\",          \"Payment File Error Code\": \"payablesPaymentFile.errorCode\",          \"Payment File Error Message\": \"payablesPaymentFile.errorMessage\",          \"Payment File Created On\": \"payablesPaymentFile.timeCreated\",          \"PPR Name\": \"payablesPaymentFile.paymentRequestName\",          \"Payment File Status Code\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"Payment File Status\": \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",          \"Payment Process Profile Id\": \"payablesPaymentFile.accountPaymentProfile.paymentProfileId\",          \"Payment Process Profile\": \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",          \"Transmission Configuration\": \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"Transmission Protocol Code\": \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",          \"Transmission Protocol\": \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"System Payment Profile Code\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.systemProfileCode\",          \"Processing Type Code\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"Processing Type\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\",          \"Payment Process Request Name\": \"payablesPaymentFile.paymentRequestName\"        }      },      \"fieldSelection\": {        \"base\": [          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"payablesPaymentFile.paymentInstructionId\",          \"payablesPaymentFile.paymentRequestName\",          \"payablesPaymentFile.paymentFileProcessingStatus.meaning\"        ],        \"optional\": [          \"errorType.meaning\",          \"errorStatus.meaning\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"payablesPaymentFile.bankStatusCode\",          \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",          \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",          \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\"        ]      },      \"sortableAttributes\": [        \"id\",        \"errorCode\",        \"errorDate\",        \"errorMessage\",        \"transactionType\",        \"statusReasonCode\",        \"statusReasonMessage\",        \"errorType.lookupCode\",        \"errorType.meaning\",        \"errorStatus.lookupCode\",        \"errorStatus.meaning\",        \"payablesPaymentFile.paymentInstructionId\",        \"payablesPaymentFile.bankStatusCode\",        \"payablesPaymentFile.errorCode\",        \"payablesPaymentFile.errorMessage\",        \"payablesPaymentFile.timeCreated\",        \"payablesPaymentFile.paymentRequestName\",        \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",        \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",        \"payablesPaymentFile.accountPaymentProfile.paymentProfileId\",        \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\",        \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.systemProfileCode\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",        \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\"      ],      \"filterConditions\": [        {          \"name\": \"errorDate\",          \"attribute\": \"errorDate\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for recent payment-file exception queries. Because this is a datetime field in a BV filter, emit full ISO datetime literals such as `errorDate >= '2026-05-18T00:00:00Z'`; do not emit date-only literals such as `errorDate >= '2026-05-18'`.\"        },        {          \"name\": \"payablesPaymentFile.timeCreated\",          \"attribute\": \"payablesPaymentFile.timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use only when the user explicitly asks about payment file creation timing. Because this is a datetime field in a BV filter, emit full ISO datetime literals.\"        },        {          \"name\": \"transactionType\",          \"attribute\": \"transactionType\",          \"type\": \"enum\",          \"possibleValues\": [            \"PAYMENT_INSTRUCTION\"          ],          \"usage\": \"This resource is fixed to payment-instruction or payment-file-level errors.\"        },        {          \"name\": \"payablesPaymentFile.paymentRequestName\",          \"attribute\": \"payablesPaymentFile.paymentRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes file-level failures to one payment process request.\"        },        {          \"name\": \"statusReasonCode\",          \"attribute\": \"statusReasonCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the seeded payment-instruction exception includes a status-reason code for the failure.\"        },        {          \"name\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REJECTED\",            \"TRANSMISSION_FAILED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"TRANSMITTED_PENDING_ACK\",            \"FORMATTING_FAILED\",            \"CREATION_ERROR\",            \"RETRY_CREATION\",            \"TERMINATED\"          ],          \"usage\": \"Use when the user asks for rejected, transmission-failed, or pending-acknowledgement files.\"        },        {          \"name\": \"errorCode\",          \"attribute\": \"errorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for one file-level error code or wants to group whole-batch failures by root cause.\"        },        {          \"name\": \"errorType.lookupCode\",          \"attribute\": \"errorType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VALIDATION\",            \"BANK\"          ],          \"usage\": \"Use when the user distinguishes file-generation validation issues from bank-return failures.\"        },        {          \"name\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"attribute\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user narrows to electronic versus printed processing flows or other system processing types.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `errorDate` for recent file-level exceptions and `payablesPaymentFile.timeCreated` when the user explicitly asks about file creation timing. These are datetime fields, so BV filters must use full ISO datetime literals rather than date-only literals.\",        \"patterns\": [          {            \"userRequest\": \"recent payment file failures\",            \"clause\": \"errorDate>='<TODAY_MINUS_30_DAYS>T00:00:00Z' unless the user supplies a different date range\"          }        ]      },      \"extractionQuery\": null,      \"businessDrivers\": [        {          \"name\": \"fileLevelFailures\",          \"description\": \"Find failures affecting payment files rather than individual payments.\",          \"when\": \"User asks which payment files were rejected, failed transmission, or await acknowledgement.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.bankStatusCode\",            \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"\"        },        {          \"name\": \"wholeBatchRejectionComparison\",          \"description\": \"Find whole-file failures that should be contrasted with individual payment errors for the same PPR or date range.\",          \"when\": \"User asks which validation errors rejected entire payment files versus only individual payments.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"Use this as the whole-file side of the comparison and pair it with disbursementPaymentExceptions to derive grouped counts.\"        },        {          \"name\": \"paymentConfirmationFailureRootCause\",          \"description\": \"Retrieve file-level exception details for a PPR whose payment confirmation did not complete.\",          \"when\": \"User asks why payment confirmation failed for a PPR or batch.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"payablesPaymentFile.paymentInstructionId\",            \"payablesPaymentFile.paymentRequestName\",            \"payablesPaymentFile.paymentFileProcessingStatus.meaning\",            \"payablesPaymentFile.bankStatusCode\",            \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\",            \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentRequestName='<PPR_NAME_FROM_USER_WITH_LEADING_PPR_PREFIX_REMOVED>'\",            \"transactionType='PAYMENT_INSTRUCTION'\",            \"paymentFileProcessingStatusLookupCode in ('FORMATTED_ELECTRONIC','TRANSMITTED','PRINTED','TRANSMISSION_FAILED','PENDING_ACTION_ACK_FAILURE','PENDING_ACK')\"          ],          \"notes\": \"Use PayablesPaymentProcessRequestDetails first when the user needs the run-level paymentsConfirmed value. Keep row limiting outside filter predicates; use the supported FETCH row-limit form only in generated SQL.\"        }      ],      \"additionalInstructions\": [        \"Use this shape for file-level failures. For individual payment failures, switch to disbursementPaymentExceptions.\",        \"When the user asks for file-level versus payment-level comparison, filter this shape and disbursementPaymentExceptions to the same PPR scope, status, or date range, then compare grouped counts outside the base fetch.\",        \"For payment-confirmation failure diagnosis, use the PPR name to fetch the instruction exception, then explain how the file status, bank status, error code, transmission configuration, and protocol relate to the run-level confirmation state.\"      ]    },    \"disbursementPaymentInstructionExceptionsExtraction\": {      \"key\": \"disbursementPaymentInstructionExceptionsExtraction\",      \"name\": \"disbursementPaymentInstructionExceptionsExtraction\",      \"type\": \"EXTRACTION\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": \"DisbursementPaymentTransactionError\",      \"description\": \"Runtime extraction wrapper for the disbursementPaymentInstructionExceptions BV. Use this BV shape primarily for summary queries about payment-file and instruction-level failures, such as grouped counts of formatting, transmission, acknowledgement, and rejection issues by file status, error code, transmission setup, or PPR. Use it to quantify whole-file impact before drilling into specific payment files.\",      \"exampleQuestions\": [        \"How many payment files were rejected by the bank by error code?\",        \"How many file-level transmission failures were there in the last week by payment file status?\",        \"List payment instruction exceptions by payment file status and PPR.\",        \"How many payment validation errors caused entire payment files to be rejected by error code?\",        \"Which whole-batch payment validation errors should I fix first to unblock the most payments?\",        \"Why did payment confirmation for PPR EFT-Batch-45 fail?\"      ],      \"fields\": {        \"fields\": [          \"id\",          \"errorCode\",          \"errorDate\",          \"errorMessage\",          \"transactionType\",          \"statusReasonCode\",          \"statusReasonMessage\",          \"errorTypeLookupCode\",          \"errorTypeMeaning\",          \"errorStatusLookupCode\",          \"errorStatusMeaning\",          \"paymentInstructionId\",          \"bankStatusCode\",          \"payablesPaymentFileErrorCode\",          \"payablesPaymentFileErrorMessage\",          \"timeCreated\",          \"paymentRequestName\",          \"paymentFileProcessingStatusLookupCode\",          \"paymentFileProcessingStatusMeaning\",          \"paymentProfileId\",          \"paymentProfileName\",          \"transmissionConfigurationName\",          \"transmitProtocolCode\",          \"transmissionProtocolName\",          \"systemProfileCode\",          \"processingTypeLookupCode\",          \"processingTypeMeaning\"        ],        \"fieldAlias\": {          \"Exception Id\": \"id\",          \"Error Code\": \"errorCode\",          \"Error Date\": \"errorDate\",          \"Error Message\": \"errorMessage\",          \"Transaction Type\": \"transactionType\",          \"Status Reason Code\": \"statusReasonCode\",          \"Status Reason Message\": \"statusReasonMessage\",          \"Error Type Code\": \"errorTypeLookupCode\",          \"Error Type\": \"errorTypeMeaning\",          \"Error Status Code\": \"errorStatusLookupCode\",          \"Error Status\": \"errorStatusMeaning\",          \"Payment File Id\": \"paymentInstructionId\",          \"Payment File Reference\": \"paymentInstructionId\",          \"Bank Status Code\": \"bankStatusCode\",          \"Payment File Error Code\": \"payablesPaymentFileErrorCode\",          \"Payment File Error Message\": \"payablesPaymentFileErrorMessage\",          \"Payment File Created On\": \"timeCreated\",          \"PPR Name\": \"paymentRequestName\",          \"Payment File Status Code\": \"paymentFileProcessingStatusLookupCode\",          \"Payment File Status\": \"paymentFileProcessingStatusMeaning\",          \"Payment Process Profile Id\": \"paymentProfileId\",          \"Payment Process Profile\": \"paymentProfileName\",          \"Transmission Configuration\": \"transmissionConfigurationName\",          \"Transmission Protocol Code\": \"transmitProtocolCode\",          \"Transmission Protocol\": \"transmissionProtocolName\",          \"System Payment Profile Code\": \"systemProfileCode\",          \"Processing Type Code\": \"processingTypeLookupCode\",          \"Processing Type\": \"processingTypeMeaning\",          \"Payment Process Request Name\": \"paymentRequestName\"        }      },      \"supportedFilters\": [        {          \"name\": \"errorDate\",          \"attribute\": \"errorDate\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use as the default date filter for recent payment-file exception queries. Because this extraction generates Oracle SQL against a datetime field, emit ANSI TIMESTAMP literals such as `errorDate >= TIMESTAMP '2026-05-18 00:00:00'`; do not emit plain quoted date strings.\",          \"valueFromUser\": \"Error Date\"        },        {          \"name\": \"payablesPaymentFile.timeCreated\",          \"attribute\": \"payablesPaymentFile.timeCreated\",          \"type\": \"datetime\",          \"possibleValues\": [],          \"usage\": \"Use only when the user explicitly asks about payment file creation timing. Because this extraction generates Oracle SQL against a datetime field, emit ANSI TIMESTAMP literals.\",          \"valueFromUser\": \"Payment File Created On\"        },        {          \"name\": \"paymentInstructionId\",          \"attribute\": \"paymentInstructionId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes a file-level exception query to one payment file or payment instruction id.\",          \"valueFromUser\": \"Payment File Reference\"        },        {          \"name\": \"transactionType\",          \"attribute\": \"transactionType\",          \"type\": \"enum\",          \"possibleValues\": [            \"PAYMENT_INSTRUCTION\"          ],          \"usage\": \"This resource is fixed to payment-instruction or payment-file-level errors.\",          \"valueFromUser\": \"Transaction Type\"        },        {          \"name\": \"payablesPaymentFile.paymentRequestName\",          \"attribute\": \"payablesPaymentFile.paymentRequestName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user scopes file-level failures to one payment process request.\",          \"valueFromUser\": \"PPR Name\"        },        {          \"name\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"attribute\": \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REJECTED\",            \"TRANSMISSION_FAILED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"TRANSMITTED_PENDING_ACK\",            \"FORMATTING_FAILED\",            \"CREATION_ERROR\",            \"RETRY_CREATION\",            \"TERMINATED\"          ],          \"usage\": \"Use when the user asks for rejected, transmission-failed, or pending-acknowledgement files.\",          \"valueFromUser\": \"Payment File Status Code\"        },        {          \"name\": \"errorCode\",          \"attribute\": \"errorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for one file-level error code or wants to group whole-batch failures by root cause.\",          \"valueFromUser\": \"Error Code\"        },        {          \"name\": \"transmissionConfigurationName\",          \"attribute\": \"transmissionConfigurationName\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for known or recent transmission issues by transmission configuration.\",          \"valueFromUser\": \"Transmission Configuration\"        },        {          \"name\": \"statusReasonCode\",          \"attribute\": \"statusReasonCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the seeded payment-instruction exception includes a status-reason code for the failure.\",          \"valueFromUser\": \"Status Reason Code\"        },        {          \"name\": \"errorType.lookupCode\",          \"attribute\": \"errorType.lookupCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VALIDATION\",            \"BANK\"          ],          \"usage\": \"Use when the user distinguishes file-generation validation issues from bank-return failures.\",          \"valueFromUser\": \"Error Type Code\"        },        {          \"name\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"attribute\": \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user narrows to electronic versus printed processing flows or other system processing types.\",          \"valueFromUser\": \"Processing Type Code\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Use `errorDate` for recent file-level exceptions and `payablesPaymentFile.timeCreated` when the user explicitly asks about file creation timing. Extraction SQL must use Oracle ANSI TIMESTAMP literals for datetime comparisons.\",        \"patterns\": [          {            \"userRequest\": \"recent payment file failures\",            \"clause\": \"errorDate>=TIMESTAMP '<TODAY_MINUS_30_DAYS> 00:00:00' unless the user supplies a different date range\"          }        ]      },      \"extractionQuery\": {        \"viewQueries\": {          \"disbursementPaymentInstructionExceptions\": {            \"module\": \"oraErpCorePaymentsFundsDisbursement\",            \"businessObject\": \"DisbursementPaymentTransactionError\",            \"view\": \"disbursementPaymentInstructionExceptions\",            \"fieldAliases\": {              \"id\": \"id\",              \"errorCode\": \"errorCode\",              \"errorDate\": \"errorDate\",              \"errorMessage\": \"errorMessage\",              \"transactionType\": \"transactionType\",              \"statusReasonCode\": \"statusReasonCode\",              \"statusReasonMessage\": \"statusReasonMessage\",              \"errorType.lookupCode\": \"errorTypeLookupCode\",              \"errorType.meaning\": \"errorTypeMeaning\",              \"errorStatus.lookupCode\": \"errorStatusLookupCode\",              \"errorStatus.meaning\": \"errorStatusMeaning\",              \"payablesPaymentFile.paymentInstructionId\": \"paymentInstructionId\",              \"payablesPaymentFile.bankStatusCode\": \"bankStatusCode\",              \"payablesPaymentFile.errorCode\": \"payablesPaymentFileErrorCode\",              \"payablesPaymentFile.errorMessage\": \"payablesPaymentFileErrorMessage\",              \"payablesPaymentFile.timeCreated\": \"timeCreated\",              \"payablesPaymentFile.paymentRequestName\": \"paymentRequestName\",              \"payablesPaymentFile.paymentFileProcessingStatus.lookupCode\": \"paymentFileProcessingStatusLookupCode\",              \"payablesPaymentFile.paymentFileProcessingStatus.meaning\": \"paymentFileProcessingStatusMeaning\",              \"payablesPaymentFile.accountPaymentProfile.paymentProfileId\": \"paymentProfileId\",              \"payablesPaymentFile.accountPaymentProfile.paymentProfileName\": \"paymentProfileName\",              \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.transmissionConfigurationName\": \"transmissionConfigurationName\",              \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmitProtocolCode\": \"transmitProtocolCode\",              \"payablesPaymentFile.accountPaymentProfile.paymentTransmissionConfiguration.paymentTransmissionProtocol.transmissionProtocolName\": \"transmissionProtocolName\",              \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.systemProfileCode\": \"systemProfileCode\",              \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.lookupCode\": \"processingTypeLookupCode\",              \"payablesPaymentFile.accountPaymentProfile.systemPaymentProfile.processingType.meaning\": \"processingTypeMeaning\"            }          }        },        \"select\": \"{select_statement}\"      },      \"businessDrivers\": [        {          \"name\": \"fileLevelFailures\",          \"description\": \"Find failures affecting payment files rather than individual payments.\",          \"when\": \"User asks which payment files were rejected, failed transmission, or await acknowledgement.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"bankStatusCode\",            \"paymentProfileName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"\"        },        {          \"name\": \"wholeBatchRejectionComparison\",          \"description\": \"Find whole-file failures that should be contrasted with individual payment errors for the same PPR or date range.\",          \"when\": \"User asks which validation errors rejected entire payment files versus only individual payments.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"transmissionConfigurationName\",            \"transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"transactionType='PAYMENT_INSTRUCTION'\"          ],          \"notes\": \"Use this as the whole-file side of the comparison and pair it with disbursementPaymentExceptions to derive grouped counts.\"        },        {          \"name\": \"paymentConfirmationFailureRootCause\",          \"description\": \"Retrieve file-level exception details for a PPR whose payment confirmation did not complete.\",          \"when\": \"User asks why payment confirmation failed for a PPR or batch.\",          \"fieldsToReturn\": [            \"errorCode\",            \"errorMessage\",            \"paymentInstructionId\",            \"paymentRequestName\",            \"paymentFileProcessingStatusMeaning\",            \"bankStatusCode\",            \"paymentProfileName\",            \"transmissionConfigurationName\",            \"transmissionProtocolName\"          ],          \"extraFilterExpressions\": [            \"paymentRequestName='<PPR_NAME_FROM_USER_WITH_LEADING_PPR_PREFIX_REMOVED>'\",            \"transactionType='PAYMENT_INSTRUCTION'\",            \"paymentFileProcessingStatusLookupCode in ('FORMATTED_ELECTRONIC','TRANSMITTED','PRINTED','TRANSMISSION_FAILED','PENDING_ACTION_ACK_FAILURE','PENDING_ACK')\"          ],          \"notes\": \"For payment confirmation failure, strip a leading literal 'PPR ' from the user's identifier before filtering paymentRequestName, and include PENDING_ACK in the status set.\"        }      ],      \"additionalInstructions\": [        \"Generate the full SELECT statement and place it into {select_statement} before execution.\",        \"Use viewQueries.disbursementPaymentInstructionExceptions as the FROM source with alias consistent in the SQL (for example disbursementPaymentInstructionExceptions).\",        \"Build the extraction SQL in a single query block where possible. Do not use an outer inline-view wrapper only to apply row limits or filter projected aliases.\",        \"Apply supported filters and date filters as needed, using supportedFilters and entity resolution. For datetime filters such as `errorDate` and `timeCreated`, use Oracle ANSI TIMESTAMP literals and never plain quoted date strings.\",        \"For detail row-list queries, append FETCH FIRST 20 ROWS ONLY in the same query block after ORDER BY when present. Do not use legacy row-number predicates.\",        \"Do not reference SELECT aliases in WHERE, HAVING, ORDER BY, GROUP BY, or outer query filters. If a calculated expression must be filtered, ordered, or grouped, repeat the full expression in that clause. Output aliases are allowed only as returned column names.\",        \"Use this shape for file-level failures. For individual payment failures, switch to disbursementPaymentExceptions.\",        \"When the user asks for file-level versus payment-level comparison, filter this shape and disbursementPaymentExceptions to the same PPR scope, status, or date range, then compare grouped counts outside the base fetch.\",        \"For payment-confirmation failure diagnosis, use the PPR name to fetch the instruction exception, then explain how the file status, bank status, error code, transmission configuration, and protocol relate to the run-level confirmation state.\",        \"For payment confirmation failure questions, normalize 'PPR <name>' to '<name>' for paymentRequestName filters and include PENDING_ACK in the paymentFileProcessingStatusLookupCode IN list.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"Why did payment confirmation for PPR EFT-Batch-45 fail?\"          ],          \"queryType\": \"extraction\",          \"shapeHint\": \"disbursementPaymentInstructionExceptionsExtraction\",          \"fields\": \"paymentRequestName,errorCode,errorMessage,paymentInstructionId,paymentFileProcessingStatusMeaning,bankStatusCode,paymentProfileName,transmissionConfigurationName,transmissionProtocolName\",          \"fieldOrderLocked\": true,          \"shape\": \"disbursementPaymentInstructionExceptionsExtraction\",          \"filters\": \"transactionType = 'PAYMENT_INSTRUCTION' AND paymentRequestName = '<PPR_NAME_FROM_USER_WITH_LEADING_PPR_PREFIX_REMOVED>' AND paymentFileProcessingStatusLookupCode IN ('FORMATTED_ELECTRONIC','TRANSMITTED','PRINTED','TRANSMISSION_FAILED','PENDING_ACTION_ACK_FAILURE','PENDING_ACK')\",          \"notes\": \"If the user says 'PPR CFA-6', filter paymentRequestName as 'CFA-6'. Include PENDING_ACK with the other payment-file processing statuses. Append FETCH FIRST 20 ROWS ONLY to detail row-list SQL in the same query block.\"        }      ]    },    \"PayablesPaymentProcessRequestDetails\": {      \"key\": \"PayablesPaymentProcessRequestDetails\",      \"name\": \"PayablesPaymentProcessRequestDetails\",      \"type\": \"EV\",      \"shapeRole\": \"detail\",      \"module\": \"oraErpCorePaymentsFundsDisbursement\",      \"businessObject\": null,      \"api\": \"queries/ora/erpCore/paymentsFundsDisbursement/v1/payablesPaymentProcessRequestDetails\",      \"description\": \"Use this seeded EV to retrieve end-to-end payment process request details across Payables selection, Oracle Payments funds-disbursement processing, payment file creation, acknowledgements, and bank follow-up. It is also the canonical run-level shape for proposed-payment approval review because it exposes approver, pending-since aging, lifecycle status, and payment-file context. It also exposes virtual-card payment context through paymentModeCode, paymentMode, fundingCardAccount, and financingProgram for PPR-level virtual-card inquiries.\",      \"exampleQuestions\": [        \"Show payment process request details for payment batch APR_2026_WEEKLY_01\",        \"Show me all PPRs pending approval\",        \"How long has this payment process request been pending approval?\",        \"Who is the approver for this reviewed payment run?\",        \"Which payment process requests are requiring attention and what payment file status do they have?\",        \"Show payment process requests with bank status and bank error code for the last 7 days\",        \"List completed and terminated payment process requests with payment file reference and payment system\",        \"Show immediate payment requests pending acknowledgement with payment system account details\",        \"Show me all PPRs completed\",        \"Show completed PPRs in the last 7 days\",        \"Show payment files completed on 2012\",        \"Show completed payment files in 2012\",        \"Show terminated PPRs\",        \"Show cancelled PPRs\",        \"Show PPRs requiring attention\",        \"Show PPRs by payment date last 30 days\",        \"Show PPR Paid In 2012\",        \"Show PPRs paid last month\",        \"Show PPRs paid between 2012-01-01 and 2012-12-31\",        \"Which PPRs are waiting for additional information/missing attributes right now?\",        \"How long has PPR <PPR_NAME> been pending approval\",        \"Show PPR pending in 2026-01-13\",        \"Show PPRs in status Pending action to address payment validation errors\",        \"Show PPRs in status Pending installments review\",        \"Show payment process requests with payment mode Virtual Card\",        \"Show virtual card payment files requiring attention\",        \"Show virtual card PPRs with funding card account and financing program\"      ],      \"fields\": {        \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,pendingSince,installmentsSelected,installmentsRejected,paymentFileReference,paymentFileStatus,completionDate,terminationDate,requestStatus,paymentsRecorded,earlyPaymentInvoices,paymentMethod,disbursementBankAccount,fundingCardAccount,paymentApprover,paymentProcessProfile,paymentFileProcessingType,paymentsConfirmed,paymentSystem,paymentSystemAccount,acknowledgementProcessingDate,bankStatusCode,bankErrorCode,paymentProcessRequestCreationDate,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentProcessRequestStatusCode,paymentFileStatusCode,paymentDocument,paymentCurrency,legalEntity,paymentBusinessUnit,formatName,paymentFileCreationDate,financingProgram,paymentMode,\",        \"fieldAlias\": {          \"PPR Name\": \"paymentProcessRequest\",          \"PPR Status\": \"paymentProcessRequestStatus\",          \"Payment Date\": \"paymentDate\",          \"Pending Since\": \"pendingSince\",          \"Installments Selected\": \"installmentsSelected\",          \"Installments Rejected\": \"installmentsRejected\",          \"Payment File Reference\": \"paymentFileReference\",          \"Payment File Status\": \"paymentFileStatus\",          \"Completion Date\": \"completionDate\",          \"Termination Date\": \"terminationDate\",          \"Request Status\": \"requestStatus\",          \"Payments Recorded\": \"paymentsRecorded\",          \"Early Payment Invoices\": \"earlyPaymentInvoices\",          \"Payment Method\": \"paymentMethod\",          \"Disbursement Bank Account\": \"disbursementBankAccount\",          \"Funding Card Account\": \"fundingCardAccount\",          \"Payment Approver\": \"paymentApprover\",          \"Payment Process Profile\": \"paymentProcessProfile\",          \"Payment File Processing Type\": \"paymentFileProcessingType\",          \"Payments Confirmed\": \"paymentsConfirmed\",          \"Payment System\": \"paymentSystem\",          \"Payment System Account\": \"paymentSystemAccount\",          \"Acknowledgement Processing Date\": \"acknowledgementProcessingDate\",          \"Bank Status Code\": \"bankStatusCode\",          \"Bank Error Code\": \"bankErrorCode\",          \"PPR Creation Date\": \"paymentProcessRequestCreationDate\",          \"Payables PPR Id\": \"payablesPaymentProcessRequestId\",          \"Payments PPR Id\": \"paymentProcessRequestId\",          \"Payment Process Type\": \"paymentProcessType\",          \"Request Status Code\": \"requestStatusCode\",          \"PPR Status Code\": \"paymentProcessRequestStatusCode\",          \"Payment File Status Code\": \"paymentFileStatusCode\",          \"Payment Document\": \"paymentDocument\",          \"Payment Currency\": \"paymentCurrency\",          \"Legal Entity\": \"legalEntity\",          \"Payment Business Unit\": \"paymentBusinessUnit\",          \"Format Name\": \"formatName\",          \"Payment File Creation Date\": \"paymentFileCreationDate\",          \"Financing Program\": \"financingProgram\",          \"Payment Mode\": \"paymentMode\"        }      },      \"fieldSelection\": {        \"base\": [          \"paymentProcessRequest\",          \"paymentProcessRequestStatus\",          \"paymentDate\",          \"pendingSince\",          \"installmentsSelected\",          \"installmentsRejected\",          \"paymentFileReference\",          \"paymentFileStatus\",          \"completionDate\",          \"terminationDate\",          \"requestStatus\",          \"paymentsRecorded\",          \"earlyPaymentInvoices\",          \"paymentMethod\",          \"paymentModeCode\",          \"paymentMode\",          \"disbursementBankAccount\",          \"fundingCardAccount\",          \"paymentApprover\",          \"paymentProcessProfile\",          \"paymentFileProcessingType\",          \"paymentsConfirmed\",          \"paymentSystem\",          \"paymentSystemAccount\",          \"acknowledgementProcessingDate\",          \"bankStatusCode\",          \"bankErrorCode\",          \"paymentProcessRequestCreationDate\",          \"payablesPaymentProcessRequestId\",          \"paymentProcessRequestId\",          \"paymentProcessType\",          \"requestStatusCode\",          \"paymentProcessRequestStatusCode\",          \"paymentFileStatusCode\",          \"paymentDocument\",          \"paymentCurrency\",          \"legalEntity\",          \"paymentBusinessUnit\",          \"formatName\",          \"paymentFileCreationDate\",          \"financingProgram\"        ],        \"optional\": []      },      \"sortableAttributes\": [        \"paymentProcessRequest\",        \"paymentProcessRequestStatus\",        \"paymentDate\",        \"pendingSince\",        \"installmentsSelected\",        \"installmentsRejected\",        \"paymentFileReference\",        \"paymentFileStatus\",        \"completionDate\",        \"terminationDate\",        \"requestStatus\",        \"paymentsRecorded\",        \"paymentMethod\",        \"paymentModeCode\",        \"paymentMode\",        \"disbursementBankAccount\",        \"fundingCardAccount\",        \"paymentApprover\",        \"paymentProcessProfile\",        \"paymentSystem\",        \"paymentSystemAccount\",        \"acknowledgementProcessingDate\",        \"paymentProcessRequestCreationDate\",        \"payablesPaymentProcessRequestId\",        \"paymentProcessRequestId\",        \"paymentProcessType\",        \"paymentDocument\",        \"paymentCurrency\",        \"legalEntity\",        \"paymentBusinessUnit\",        \"formatName\",        \"paymentFileCreationDate\",        \"financingProgram\"      ],      \"filterConditions\": [        {          \"name\": \"paymentProcessRequest\",          \"attribute\": \"paymentProcessRequest\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user identifies the payment batch by its visible payables payment process request name.\"        },        {          \"name\": \"payablesPaymentProcessRequestId\",          \"attribute\": \"payablesPaymentProcessRequestId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the payables-side payment process request id.\"        },        {          \"name\": \"paymentProcessRequestId\",          \"attribute\": \"paymentProcessRequestId\",          \"type\": \"number\",          \"possibleValues\": [],          \"usage\": \"Use when the user provides the Oracle Payments funds-disbursement request id. No need to return this\"        },        {          \"name\": \"requestStatusCode\",          \"attribute\": \"requestStatusCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"REQUIRING_ATTENTION\",            \"IN_PROCESS\",            \"COMPLETED\",            \"TERMINATED\"          ],          \"usage\": \"Use for high-level lifecycle buckets only when the matching business driver does not override the filter. Do not use requestStatusCode for terminated PPR list filters; use the pprTerminated driver with paymentProcessRequestStatusCode IN ('TERMINATED') and paymentFileReference = null. Do not use requestStatusCode='COMPLETED' for paid-date questions.\"        },        {          \"name\": \"paymentProcessRequestStatusCode\",          \"attribute\": \"paymentProcessRequestStatusCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ASSIGNMENT_COMPLETE\",            \"CALCULATING\",            \"CANCELED\",            \"CANCELING\",            \"CANCELLED NO PAYMENTS\",            \"COMPLETED\",            \"DOCUMENTS_VALIDATED\",            \"FAILED_PAYMENT_VALIDATION\",            \"INFORMATION_REQUIRED\",            \"INSERTED\",            \"MISSING RATES\",            \"MISSING_X_RATES\",            \"ORA_APPROVAL_ERROR\",            \"ORA_APPROVAL_INITIATED\",            \"ORA_APPROVAL_WITHDRAWN\",            \"ORA_APPROVED\",            \"ORA_REFRESH_INSTALLMENTS\",            \"ORA_REQUIRE_APPROVAL\",            \"PAYMENTS_CREATED\",            \"PAYMENTS_INITIATED\",            \"PENDING_REVIEW\",            \"PENDING_REVIEW_DOC_VAL_ERRORS\",            \"PENDING_REVIEW_PMT_VAL_ERRORS\",            \"RETRY_DOCUMENT_VALIDATION\",            \"RETRY_PAYMENT_CREATION\",            \"REVIEW\",            \"SELECTED\",            \"SELECTING\",            \"SUBMITTED\",            \"TERMINATED\",            \"UNSTARTED\",            \"VALIDATION_FAILED\",            \"ORA_SPLIT_INITIATED\"          ],          \"usage\": \"Use for PPR status-code filtering. For explicit status-name wording such as with status, having status, where status is, status equals, for status, in status, or in <status name> status, map a listed display label to paymentProcessRequestStatusCode = <LOOKUP_CODE>. Keep lifecycle drivers for completed, terminated/cancelled, generic pending, pending approval, requiring attention, waiting-for-information, and missing-rate intents unless the user explicitly uses exact status-name wording.\",          \"displayedFieldLookupCodes\": [            \"Waiting for installment split => ORA_SPLIT_INITIATED\",            \"Pending action to address document validation errors => PENDING_REVIEW_DOC_VAL_ERRORS\",            \"Pending action to address payment validation errors => PENDING_REVIEW_PMT_VAL_ERRORS\",            \"Pending installments review => REVIEW\",            \"Assignment complete => ASSIGNMENT_COMPLETE\",            \"Calculating withholding and interest => CALCULATING\",            \"Cancelled Payment => CANCELED\",            \"Terminating => CANCELING\",            \"No available installments => CANCELLED NO PAYMENTS\",            \"Payments completed => COMPLETED\",            \"Documents validated => DOCUMENTS_VALIDATED\",            \"Failed payment validation => FAILED_PAYMENT_VALIDATION\",            \"Pending action to complete information required => INFORMATION_REQUIRED\",            \"Pending => INSERTED\",            \"Missing payment conversion rates => MISSING RATES\",            \"Missing cross-currency rates => MISSING_X_RATES\",            \"Error in payments approval => ORA_APPROVAL_ERROR\",            \"Payments approval initiated => ORA_APPROVAL_INITIATED\",            \"Withdrawn from approval => ORA_APPROVAL_WITHDRAWN\",            \"Payments approved => ORA_APPROVED\",            \"Refreshing selected installments => ORA_REFRESH_INSTALLMENTS\",            \"Pending payments approval => ORA_REQUIRE_APPROVAL\",            \"Waiting for payment file processing => PAYMENTS_CREATED\",            \"Pending Payment File Completion => PAYMENTS_INITIATED\",            \"Pending proposed payment review => PENDING_REVIEW\",            \"Retry document validation => RETRY_DOCUMENT_VALIDATION\",            \"Retry payment creation => RETRY_PAYMENT_CREATION\",            \"Installments selected => SELECTED\",            \"Selecting installments => SELECTING\",            \"Submitted => SUBMITTED\",            \"Terminated => TERMINATED\",            \"Pending installments selection => UNSTARTED\",            \"Failed document validation => VALIDATION_FAILED\",            \"Cancelled => CANCELED\",            \"Canceled => CANCELED\",            \"Pending and installments selection => UNSTARTED\",            \"Pending installment selection => UNSTARTED\",            \"Waiting payment file processing => PAYMENTS_CREATED\"          ]        },        {          \"name\": \"completionDateRange\",          \"attribute\": \"completionDate\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use when the user explicitly asks for completed PPRs or completed payment files on, in, before, after, between, or within a relative date range. Wording such as `payment files completed on 2012`, `completed payment files in 2012`, or `PPRs completed last month` must use completionDateRange on completionDate and must not ask whether the date is creation date or payment date. If no date is provided for completed PPRs or completed payment files, default to completionDate >= '<current_date_minus_30_days_YYYY-MM-DD>'. Do not use completionDateRange for paid-date questions unless the user explicitly says completed.\"        },        {          \"name\": \"terminationDateRange\",          \"attribute\": \"terminationDate\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for terminated, cancelled, cancelled-no-payments, aborted, stopped, or ended-without-completing PPRs on, before, after, between, or within a relative date range. If no date is provided for terminated PPRs, default to terminationDate >= '<current_date_minus_30_days_YYYY-MM-DD>'.\"        },        {          \"name\": \"requiringAttentionDateRange\",          \"attribute\": \"pendingSince\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for PPRs requiring attention, blocked PPRs, or exception PPRs on, before, after, between, or within a relative date range. If no date is provided for requiring-attention PPRs, default to pendingSince >= '<current_date_minus_30_days_YYYY-MM-DD>'.\"        },        {          \"name\": \"paymentDateRange\",          \"attribute\": \"paymentDate\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks for PPRs by payment date, paid date, paid in a year, paid on a date, paid during a period, payment run date, or payment date range. For questions such as 'Show PPR Paid In 2012', generate only a paymentDate filter for the requested period. Do not add paymentProcessRequestStatusCode='COMPLETED', requestStatusCode='COMPLETED', or any lifecycle status filter unless the user explicitly asks for completed PPRs.\"        },        {          \"name\": \"pendingSinceRange\",          \"attribute\": \"pendingSince\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use for generic pending, in-process, pending-approval, validation-failure, waiting-for-information, or aging requests when pendingSince is the correct date axis.\"        },        {          \"name\": \"paymentProcessRequestCreationDateRange\",          \"attribute\": \"paymentProcessRequestCreationDate\",          \"type\": \"dateRange\",          \"possibleValues\": [],          \"usage\": \"Use for payment runs scheduled today, PPRs scheduled on a specific date, payment process requests created on a date, or generic PPR discovery requests with no explicit lifecycle status or date axis. For scheduled-payment-run questions, scheduled date means paymentProcessRequestCreationDate. Do not use this for completed, terminated, requiring-attention, or payment-date requests.\"        },        {          \"name\": \"paymentFileReference\",          \"attribute\": \"paymentFileReference\",          \"type\": \"number\",          \"possibleValues\": [],          \"supportsNullFilter\": true,          \"usage\": \"Use to focus the result on a specific payment file reference. For terminated PPRs, always generate the filter paymentFileReference = null together with paymentProcessRequestStatusCode IN ('TERMINATED'). Do not omit paymentFileReference = null for TERMINATED PPR requests.\"        },        {          \"name\": \"paymentFileReferenceIsNull\",          \"attribute\": \"paymentFileReference\",          \"type\": \"null\",          \"possibleValues\": [            null          ],          \"usage\": \"Mandatory for TERMINATED PPR queries. When the user asks for PPRs terminated, blocked PPRs, exception PPRs, or PPRs needing manual review, always include paymentFileReference = null in the generated filter.\"        },        {          \"name\": \"paymentFileReferenceIsNotNull\",          \"attribute\": \"paymentFileReference\",          \"type\": \"notNull\",          \"possibleValues\": [],          \"usage\": \"Mandatory for all payment-file list, search, filter, count, status, and lifecycle queries on this EV. When the user asks for payment files, always include paymentFileReference != null so PPR-only rows are excluded. Do not apply this guard to PPR or payment process request queries.\"        },        {          \"name\": \"paymentFileStatusCode\",          \"attribute\": \"paymentFileStatusCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"ACKNOWLEDGED\",            \"CANCELING\",            \"CREATED\",            \"CREATED_READY_FOR_FORMATTING\",            \"CREATED_READY_FOR_PRINTING\",            \"CREATION_ERROR\",            \"FORMATTED\",            \"FORMATTED_ELECTRONIC\",            \"FORMATTED_READY_FOR_PRINTING\",            \"FORMATTED_READY_TO_TRANSMIT\",            \"FORMATTING_FAILED\",            \"PARTIALLY_ACKNOWLEDGED\",            \"PENDING_ACK\",            \"PENDING_ACTION_ACK_FAILURE\",            \"PRINTED\",            \"PROCESSING_ACK\",            \"REJECTED\",            \"RETRY_CREATION\",            \"SUBMITTED_FOR_PRINTING\",            \"TERMINATED\",            \"TRANSMISSION_FAILED\",            \"TRANSMITTED\",            \"TRANSMITTED_PENDING_ACK\"          ],          \"usage\": \"Use when the user asks for payment files in a specific payment-file processing status, whether by exact IBY_PAY_INSTRUCTION_STATUSES lookup code or by supported business-facing label. Supported business-label mappings are: Acknowledged => ACKNOWLEDGED, Terminating => CANCELING, Created => CREATED, Created and ready for formatting => CREATED_READY_FOR_FORMATTING, Created and ready for printing => CREATED_READY_FOR_PRINTING, Failed validation and pending action => CREATION_ERROR, Formatted and ready for recording => FORMATTED_ELECTRONIC, Formatted => FORMATTED, Formatted and ready for printing => FORMATTED_READY_FOR_PRINTING, Formatted and ready for transmission => FORMATTED_READY_TO_TRANSMIT, Failed formatting and pending action => FORMATTING_FAILED, Partially acknowledged => PARTIALLY_ACKNOWLEDGED, Completed and pending acknowledgment => PENDING_ACK only, Pending action to address acknowledgment failure => PENDING_ACTION_ACK_FAILURE, Printed => PRINTED, Retrieving and processing acknowledgment file => PROCESSING_ACK, Rejected => REJECTED, Retry payment file validation => RETRY_CREATION, Submitted for printing => SUBMITTED_FOR_PRINTING, Terminated => TERMINATED, Transmission failed => TRANSMISSION_FAILED, Transmitted => TRANSMITTED. Also support exact code wording such as TRANSMITTED_PENDING_ACK when the user asks by status code.\"        },        {          \"name\": \"paymentsConfirmed\",          \"attribute\": \"paymentsConfirmed\",          \"type\": \"string\",          \"possibleValues\": [            \"YES\",            \"NO\"          ],          \"usage\": \"Use when the user asks whether the PPR payment file was confirmed or why confirmation did not complete.\"        },        {          \"name\": \"bankErrorCode\",          \"attribute\": \"bankErrorCode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user wants to isolate PPRs with a specific bank or payment-system rejection code.\"        },        {          \"name\": \"paymentMethod\",          \"attribute\": \"paymentMethod\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment method.\"        },        {          \"name\": \"paymentModeCode\",          \"attribute\": \"paymentModeCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"VIRTUAL_CARD\"          ],          \"usage\": \"Use for exact payment-mode filtering. Map virtual card, VC, funding-card payment mode, and card-funded payment process requests or payment files to paymentModeCode='VIRTUAL_CARD'. Do not substitute paymentMethod. Request paymentMode for the visible business-facing value when the user asks to see payment mode.\"        },        {          \"name\": \"paymentMode\",          \"attribute\": \"paymentMode\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use as the visible business-facing Payment Mode value for virtual-card result rows. Use paymentModeCode only in the exact filter, not as a result field, unless the user explicitly asks for the code.\"        },        {          \"name\": \"fundingCardAccount\",          \"attribute\": \"fundingCardAccount\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by funding card account, funding card, card account alias, RCN, or virtual-card account context. Preserve the full business value as one literal and do not split embedded currency or business-unit words into separate filters.\"        },        {          \"name\": \"paymentApprover\",          \"attribute\": \"paymentApprover\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks who is holding approval responsibility for a payment process request.\"        },        {          \"name\": \"paymentSystem\",          \"attribute\": \"paymentSystem\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by the payment system.\"        },        {          \"name\": \"paymentSystemAccount\",          \"attribute\": \"paymentSystemAccount\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by the payment system account.\"        },        {          \"name\": \"paymentProcessType\",          \"attribute\": \"paymentProcessType\",          \"type\": \"enum\",          \"possibleValues\": [            \"STANDARD\",            \"IMMEDIATE\",            \"MANUAL\"          ],          \"usage\": \"Use when the user distinguishes standard, immediate, or manual payment processing.\"        },        {          \"name\": \"paymentCurrency\",          \"attribute\": \"paymentCurrency\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment currency.\"        },        {          \"name\": \"legalEntity\",          \"attribute\": \"legalEntity\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by legal entity.\"        },        {          \"name\": \"paymentBusinessUnit\",          \"attribute\": \"paymentBusinessUnit\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user filters by payment business unit.\"        },        {          \"name\": \"approvalReviewStatusCode\",          \"attribute\": \"paymentProcessRequestStatusCode\",          \"type\": \"enum\",          \"possibleValues\": [            \"PENDING_REVIEW\",            \"ORA_REQUIRE_APPROVAL\",            \"ORA_APPROVAL_INITIATED\",            \"ORA_APPROVED\",            \"ORA_APPROVAL_WITHDRAWN\",            \"PAYMENTS_CREATED\"          ],          \"usage\": \"Use when the user is specifically asking about proposed-payment review or approval states rather than the full seeded status list.\"        },        {          \"name\": \"financingProgram\",          \"attribute\": \"financingProgram\",          \"type\": \"string\",          \"possibleValues\": [],          \"usage\": \"Use when the user asks about financing or virtual card program context.\"        }      ],      \"dateFilterGuidance\": {        \"description\": \"Apply date filters on the outer query over the returned date columns. Date defaulting is mandatory for list, count, status, summary, and discovery requests unless the user identifies a specific PPR name or PPR id. If the user does not specify a date or time window, always add a last-30-days filter on the correct date field for the intent. Resolve relative date context from the user's request using the LLM current date before building the filter, and emit only literal ISO date values in YYYY-MM-DD format. Do not emit SQL date functions such as TRUNC, SYSDATE, CURRENT_DATE, ADD_MONTHS, TO_DATE, or equivalent functions in filters.\",        \"intentDateAxis\": [          {            \"intent\": \"completed PPRs or completed payment files\",            \"dateRangeFilterName\": \"completionDateRange\",            \"dateColumn\": \"completionDate\",            \"defaultClause\": \"completionDate >= '<current_date_minus_30_days_YYYY-MM-DD>'\",            \"sortBy\": \"completionDate:desc\"          },          {            \"intent\": \"terminated or cancelled PPRs\",            \"dateRangeFilterName\": \"terminationDateRange\",            \"dateColumn\": \"terminationDate\",            \"defaultClause\": \"terminationDate >= '<current_date_minus_30_days_YYYY-MM-DD>'\",            \"sortBy\": \"terminationDate:desc\"          },          {            \"intent\": \"requiring-attention or Requiring-Action PPRs\",            \"dateRangeFilterName\": \"requiringAttentionDateRange\",            \"dateColumn\": \"pendingSince\",            \"defaultClause\": \"pendingSince >= '<current_date_minus_30_days_YYYY-MM-DD>'\",            \"sortBy\": \"pendingSince:desc\"          },          {            \"intent\": \"PPR Pending\",            \"dateRangeFilterName\": \"pprPendingDateRange\",            \"dateColumn\": \"pendingSince\",            \"defaultClause\": \"pendingSince >= '<current_date_minus_30_days_YYYY-MM-DD>'\",            \"sortBy\": \"pendingSince:desc\"          },          {            \"intent\": \"PPRs by payment date or paid date\",            \"dateRangeFilterName\": \"paymentDateRange\",            \"dateColumn\": \"paymentDate\",            \"defaultClause\": \"paymentDate >= '<current_date_minus_30_days_YYYY-MM-DD>'\",            \"sortBy\": \"paymentDate:desc\"          }        ],        \"patterns\": [          {            \"userRequest\": \"no date or time range specified for any PPR list, count, status, summary, or discovery request\",            \"example\": \"Show me all PPRs completed\",            \"clause\": \"<date_column> >= '<current_date_minus_30_days_YYYY-MM-DD>'\"          },          {            \"userRequest\": \"last <N> days\",            \"example\": \"last 7 days\",            \"clause\": \"<date_column> >= '<current_date_minus_N_days_YYYY-MM-DD>'\"          },          {            \"userRequest\": \"last <N> months\",            \"example\": \"last 2 months\",            \"clause\": \"<date_column> >= '<current_date_minus_N_months_YYYY-MM-DD>'\"          },          {            \"intent\": \"payment runs scheduled today or scheduled on a specific date\",            \"dateRangeFilterName\": \"paymentProcessRequestCreationDateRange\",            \"dateColumn\": \"paymentProcessRequestCreationDate\",            \"defaultClause\": \"paymentProcessRequestCreationDate >= '<current_date_YYYY-MM-DD>' and paymentProcessRequestCreationDate <= '<current_date_YYYY-MM-DD>'\",            \"sortBy\": \"paymentProcessRequestCreationDate:desc\"          },          {            \"userRequest\": \"between <start> and <end>\",            \"example\": \"between 2026-03-01 and 2026-03-31\",            \"clause\": \"<date_column> >= '<resolved_start_date_YYYY-MM-DD>' and <date_column> <= '<resolved_end_date_YYYY-MM-DD>'\"          },          {            \"userRequest\": \"on <date>\",            \"example\": \"on 2026-03-15\",            \"clause\": \"<date_column> >= '2026-03-15' and <date_column> <= '2026-03-15'\"          },          {            \"userRequest\": \"before <date>\",            \"example\": \"before 2026-03-15\",            \"clause\": \"<date_column> < '2026-03-15'\"          },          {            \"userRequest\": \"after <date>\",            \"example\": \"after 2026-03-15\",            \"clause\": \"<date_column> > '2026-03-15'\"          },          {            \"userRequest\": \"in <year>\",            \"example\": \"paid in 2012\",            \"clause\": \"<date_column> >= '2012-01-01' and <date_column> <= '2012-12-31'\"          }        ]      },      \"businessDrivers\": [        {          \"name\": \"pprsPendingProposedPaymentReview\",          \"description\": \"Use this driver to list PPRs that are still in approval-pending or proposed-payment review states.\",          \"when\": \"User asks for all PPRs pending approval or pending proposed-payment review.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"pendingSince\",            \"installmentsSelected\",            \"paymentApprover\",            \"paymentFileReference\",            \"paymentFileStatus\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode in ('PENDING_REVIEW')\"          ],          \"notes\": \"Keep the queue restricted to true approval-pending states only. Do not include ORA_APPROVED, ORA_APPROVAL_WITHDRAWN, or PAYMENTS_CREATED in this driver.\"        },        {          \"name\": \"pprApprovalPending\",          \"description\": \"Retrieve a payment process request and compute how long it has been pending approval using the PPR creation or pending-since timestamp.\",          \"when\": \"User asks how long a specific PPR has been pending approval/ Show me all PPRs pending approval\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"requestStatus\",            \"requestStatusCode\",            \"pendingSince\",            \"paymentProcessRequestCreationDate\",            \"paymentProcessRequestId\",            \"paymentApprover\",            \"installmentsSelected\",            \"paymentFileReference\",            \"paymentFileStatus\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED')\",            \"pendingSince >= '<user provided date / Default last 1 month>'\"          ],          \"notes\": \"Use pendingSince when present to measure approval aging. Always filter pending approval by paymentProcessRequestStatusCode, never requestStatusCode. If user does not provide a date filter default the date filter to last one month.\"        },        {          \"name\": \"approverForReviewedRun\",          \"description\": \"Use this driver to identify the approver and run context for a proposed-payment review.\",          \"when\": \"User asks who the approver is for a high-value run or for a specific PPR under review.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentApprover\",            \"paymentProcessRequestStatus\",            \"pendingSince\",            \"installmentsSelected\",            \"paymentBusinessUnit\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequest='<PPR_NAME_FROM_USER>' or payablesPaymentProcessRequestId=<PAYABLES_PPR_ID_FROM_USER> or paymentProcessRequestId=<PAYMENTS_PPR_ID_FROM_USER>\"          ],          \"notes\": \"This EV identifies the current approver only. Approval-chain depth, approval limits, and historical turnaround are not native columns here.\"        },        {          \"name\": \"paymentFileAndBankContext\",          \"description\": \"Use this driver when the user wants payment file, bank, payment system, currency, or financing-program context for a batch.\",          \"when\": \"User asks for payment file reference, payment document, bank account, payment system, payment currency, or financing details.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentDocument\",            \"disbursementBankAccount\",            \"fundingCardAccount\",            \"paymentProcessProfile\",            \"paymentSystem\",            \"paymentSystemAccount\",            \"paymentCurrency\",            \"financingProgram\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"\"        },        {          \"name\": \"paymentFilesCompleted\",          \"description\": \"Use this driver for payment files that have completed successfully.\",          \"when\": \"User asks for completed payment files, payment files completed on or in a date period, finished payment files, or successful payment-file lifecycle lists.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"completionDate\",            \"paymentDate\",            \"paymentFileCreationDate\",            \"paymentsRecorded\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='COMPLETED'\",            \"paymentFileReference != null\",            \"completionDate >= '<CURRENT_DATE_MINUS_30_DAYS>'\"          ],          \"notes\": \"This is a payment-file lifecycle query. Always include paymentFileReference != null so PPR-only rows are excluded. If the user gives a year, month, exact date, or relative period with completed wording, apply it to completionDate and sort by completionDate desc.\"        },        {          \"name\": \"paymentFilesRequiringAttention\",          \"description\": \"Use this driver for payment files that require attention.\",          \"when\": \"User asks for payment files requiring attention, payment files requiring action, payment files needing review, or payment-file exceptions needing follow-up.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"pendingSince\",            \"paymentDate\",            \"paymentFileCreationDate\",            \"paymentsRecorded\",            \"bankStatusCode\",            \"bankErrorCode\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='REQUIRING_ATTENTION'\",            \"paymentFileReference != null\",            \"pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\"          ],          \"notes\": \"This is a payment-file lifecycle query. Always include paymentFileReference != null so PPR-only rows are excluded. Use pendingSince for explicit date filters and default recency, and sort by pendingSince desc.\"        },        {          \"name\": \"paymentFilesTerminated\",          \"description\": \"Use this driver for payment files that have terminated or cancelled without completing.\",          \"when\": \"User asks for terminated payment files, cancelled payment files, stopped payment files, aborted payment files, or payment files that ended without completing.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"terminationDate\",            \"paymentDate\",            \"paymentFileCreationDate\",            \"paymentsRecorded\",            \"bankStatusCode\",            \"bankErrorCode\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='TERMINATED'\",            \"paymentFileReference != null\",            \"terminationDate >= '<CURRENT_DATE_MINUS_30_DAYS>'\"          ],          \"notes\": \"This is a payment-file lifecycle query. Always include paymentFileReference != null so PPR-only rows are excluded. Use terminationDate for explicit date filters and default recency, and sort by terminationDate desc.\"        },        {          \"name\": \"pprCompleted\",          \"description\": \"Use this driver for payment process requests that have finished successfully.\",          \"when\": \"User asks for completed PPRs, completed payment files, payment files completed on/in a date period, finished runs, successful payment batches, or all PPRs completed. Do not use this driver for paid-date questions such as 'Show PPR Paid In 2012'; use paymentDateRange instead.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"installmentsSelected\",            \"installmentsRejected\",            \"pendingSince\",            \"completionDate\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestStatusCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='COMPLETED'\"          ],          \"notes\": \"Use requestStatusCode=COMPLETED for explicit completed-PPR or completed-payment-file requests. If the user gives a year, month, exact date, or relative period with completed wording, apply it to completionDate and do not ask whether it is creation date or payment date. If no date filter is provided, default to last 30 days on completionDate. Return completionDate with the standard PPR list fields and sort by completionDate desc. Never sort completed PPR lists by paymentDate or paymentProcessRequestCreationDate.\"        },        {          \"name\": \"pprScheduledByCreationDate\",          \"description\": \"Use this driver to list payment process requests scheduled on a specific day, including payment runs scheduled today. For this intent, scheduled date means the PPR creation date.\",          \"when\": \"User asks for payment runs scheduled today, PPRs scheduled today, payment process requests scheduled on a date, or payment runs created on a date.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentProcessRequestStatusCode\",            \"paymentProcessRequestCreationDate\",            \"paymentDate\",            \"installmentsSelected\",            \"installmentsRejected\",            \"pendingSince\",            \"payablesPaymentProcessRequestId\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestCreationDate >= '<resolved_date_YYYY-MM-DD>'\",            \"paymentProcessRequestCreationDate <= '<resolved_date_YYYY-MM-DD>'\"          ],          \"notes\": \"Use paymentProcessRequestCreationDate as the date axis for payment runs scheduled today or scheduled on a specific date. Do not use paymentDate for this intent unless the user explicitly asks for payment date, paid date, or payment run date. For 'scheduled today', resolve today from the LLM current date and emit literal ISO date values only. Sort by paymentProcessRequestCreationDate desc.\"        },        {          \"name\": \"pprTerminated\",          \"description\": \"Use this driver for payment process requests that ended without completing, including terminated runs and cancelled-no-payments runs.\",          \"when\": \"User asks for terminated PPRs, cancelled PPRs, cancelled-no-payments PPRs, stopped runs, aborted runs, or batches that ended without completing.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"requestStatus\",            \"requestStatusCode\",            \"paymentProcessRequestStatus\",            \"paymentProcessRequestStatusCode\",            \"terminationDate\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"bankStatusCode\",            \"bankErrorCode\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode IN ('TERMINATED')\",            \"paymentFileReference = null\"          ],          \"notes\": \"For terminated PPRs, always include paymentProcessRequestStatusCode IN (TERMINATED) and paymentFileReference = null. Use terminationDate for filtering and sort by terminationDate desc. Never sort terminated PPR lists by paymentProcessRequestCreationDate.\"        },        {          \"name\": \"pprInProcess\",          \"description\": \"Use this driver for payment process requests that are still running and not yet finished.\",          \"when\": \"User asks for in-process PPRs or Pending PPR, open runs, or batches currently moving through the workflow.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"requestStatus\",            \"requestStatusCode\",            \"paymentProcessRequestStatus\",            \"pendingSince\",            \"paymentDate\",            \"paymentFileReference\",            \"paymentFileStatus\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='IN_PROCESS'\"          ],          \"notes\": \"Use this for active workflow monitoring. If the user does not provide a date filter, default to last 30 days on pendingSince. Sort by pendingSince desc unless the user requests a different date axis.\"        },        {          \"name\": \"pprRequiringAttention\",          \"description\": \"Use this driver for payment process requests that need manual review or follow-up.\",          \"when\": \"User asks for PPRs requiring attention or Requiring Action, blocked runs, exceptions needing action, PPRs needing manual review, or PPRs requiring user attention.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"requestStatus\",            \"requestStatusCode\",            \"paymentProcessRequestStatus\",            \"pendingSince\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"bankStatusCode\",            \"bankErrorCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='REQUIRING_ATTENTION'\",            \"pendingSince >= '<user provided date / Default last 1 month>'\"          ],          \"notes\": \"Always include both requestStatusCode='REQUIRING_ATTENTION' in the generated filter. . If the user does not provide a date filter, always default to last 30 days on pendingSince date field . Sort by pendingSince desc.\"        },        {          \"name\": \"pprByPaymentDate\",          \"description\": \"Use this driver when the user asks for PPRs by payment date, paid date, or paid period. Paid-date questions are date-axis questions, not completed-status questions.\",          \"when\": \"User asks for PPRs paid on a date, paid in a year, paid during a period, by payment date, by payment run date, payment date range, or payments made during a specific period.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"requestStatus\",            \"requestStatusCode\",            \"paymentProcessRequestStatus\",            \"paymentProcessRequestStatusCode\",            \"paymentDate\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentMethod\",            \"paymentCurrency\",            \"paymentBusinessUnit\"          ],          \"extraFilterExpressions\": [],          \"forbiddenFilterExpressions\": [            \"requestStatusCode='COMPLETED'\"          ],          \"notes\": \"Use paymentDateRange for the generated date filter placeholder. For paid-date questions, filter and sort on paymentDate only. Do not add requestStatusCode='COMPLETED', requestStatusCode='COMPLETED', or any lifecycle status filter unless the user explicitly says completed, completed PPRs, finished runs, or successful payment batches.There is no status for 'PAID' \"        },        {          \"name\": \"pprStuckInValidationFailure\",          \"description\": \"Use this driver to identify payment process requests stuck in document validation or payment validation review failure states, with aggregated visibility by payment document and drill-down capability by PPR name.\",          \"when\": \"User asks for all PPRs stuck in validation failures, document validation review errors, payment validation review errors, or operational queues requiring corrective action before payment processing can continue.\",          \"fieldsToReturn\": [            \"paymentDocument\",            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"requestStatus\",            \"requestStatusCode\",            \"paymentBusinessUnit\",            \"legalEntity\",            \"paymentCurrency\",            \"paymentMethod\",            \"paymentProcessProfile\",            \"pendingSince\",            \"installmentsSelected\",            \"installmentsRejected\",            \"paymentApprover\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"bankStatusCode\",            \"bankErrorCode\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode in ('PENDING_REVIEW_DOC_VAL_ERRORS','PENDING_REVIEW_PMT_VAL_ERRORS')\"          ],          \"notes\": \"Use aggregated grouping by paymentDocument and paymentProcessRequestStatusCode to identify concentration of validation failures across payment documents. Support drill-down by paymentProcessRequest to isolate impacted batches and operational owners. Use pendingSince to prioritize aging failures requiring intervention. Never substitute requestStatusCode='FAILED_PAYMENT_VALIDATION' or any other lifecycle failure code for this slice.\"        },        {          \"name\": \"paymentValidationErrorComparisonAnchor\",          \"description\": \"Use this driver to identify the affected PPRs and payment files before comparing whole-file failures with individual payment failures.\",          \"when\": \"User asks for payment validation errors causing entire payment files to be rejected versus those affecting individual payments.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"requestStatus\",            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentFileStatusCode\",            \"paymentsRecorded\",            \"bankStatusCode\",            \"bankErrorCode\"          ],          \"extraFilterExpressions\": [],          \"notes\": \"This EV does not expose native paymentErrorCount or paymentInstructionErrorCount columns. Derive those counts by grouping filtered results from disbursementPaymentExceptions and disbursementPaymentInstructionExceptions.\"        },        {          \"name\": \"pprsWaitingForAdditionalInformation\",          \"description\": \"List payment process requests that are waiting for additional information.\",          \"when\": \"User asks which PPRs are waiting for additional information, missing attributes, pending review, or stuck in INFORMATION_REQUIRED status.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentProcessRequestStatusCode\",            \"requestStatus\",            \"requestStatusCode\",            \"pendingSince\",            \"paymentBusinessUnit\",            \"paymentCurrency\",            \"payablesPaymentProcessRequestId\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode='INFORMATION_REQUIRED'\",            \"pendingSince >= <GENERATED_START_DATE_OR_DEFAULT_LAST_30_DAYS>\"          ],          \"notes\": \"Use this EV for run-level PPRs that are waiting on additional information or missing attributes in INFORMATION_REQUIRED status. Do not mark these requests unsupported. Do not add validation-failure or payment-file failure predicates. If the user does not provide a date window, default to pendingSince in the last 30 days. Sort by pendingSince desc and limit to 20.\"        },        {          \"name\": \"pprPending\",          \"description\": \"Use this driver for generic pending PPRs.\",          \"when\": \"User asks for pending PPRs or pending PPRs by date.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"installmentsSelected\",            \"installmentsRejected\",            \"pendingSince\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestStatusCode\"          ],          \"extraFilterExpressions\": [            \"requestStatusCode='IN_PROCESS'\",            \"pendingSince >= '<current_date_minus_30_days_YYYY-MM-DD>'\"          ],          \"notes\": \"Use pendingSince as the date axis. For requests such as 'Show PPR pending in YYYY-MM-DD', apply the exact date to pendingSince, not paymentProcessRequestCreationDate. If the user does not provide a date window, default to the last 30 days. Sort by pendingSince desc.\"        },        {          \"name\": \"virtualCardPprs\",          \"description\": \"Use this driver for payment process requests funded through the virtual-card payment mode.\",          \"when\": \"User asks for virtual-card, VC, VCC, funding-card, or card-funded payment process requests. Do not use for prompts that ask for payment files.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"paymentMode\",            \"paymentMethod\",            \"fundingCardAccount\",            \"financingProgram\",            \"pendingSince\",            \"payablesPaymentProcessRequestId\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\"          ],          \"notes\": \"Use paymentModeCode for the exact filter and paymentMode for the visible business-facing value. If the request also asks for a lifecycle state such as requiring attention, combine this driver with that lifecycle driver's status, date, and sort rules. For payment-file prompts, use the payment-file virtual-card drivers instead so Payment File Reference, Payment File Status, and paymentFileReference != null are preserved.\"        },        {          \"name\": \"virtualCardPprsByFundingCardAccount\",          \"description\": \"Use this driver when the user identifies a funding card account or RCN for a virtual-card PPR search.\",          \"when\": \"User asks for PPRs for a named funding card account, funding card, card account alias, or RCN. Do not use for prompts that ask for payment files.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"paymentMode\",            \"paymentMethod\",            \"fundingCardAccount\",            \"financingProgram\",            \"payablesPaymentProcessRequestId\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"fundingCardAccount='<FUNDING_CARD_ACCOUNT_FROM_USER>'\"          ],          \"notes\": \"Preserve the complete funding-card-account value as one literal, including words that resemble a currency or business unit. Do not split an account such as AutoIBY RCN12 USD Vision Ops into separate filters. For payment-file prompts, use virtualCardPaymentFilesByFundingCardAccount instead.\"        },        {          \"name\": \"virtualCardPprsByFinancingProgram\",          \"description\": \"Use this driver when the user identifies a financing program for a virtual-card PPR search.\",          \"when\": \"User asks for PPRs for a named virtual-card financing program. Do not use for prompts that ask for payment files.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"paymentMode\",            \"paymentMethod\",            \"fundingCardAccount\",            \"financingProgram\",            \"payablesPaymentProcessRequestId\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"financingProgram='<FINANCING_PROGRAM_FROM_USER>'\"          ],          \"notes\": \"Use the financing-program value exactly as resolved from the user request. Do not substitute paymentMethod or fundingCardAccount for this filter. For payment-file prompts, use virtualCardPaymentFilesByFinancingProgram instead.\"        },        {          \"name\": \"virtualCardPaymentFiles\",          \"description\": \"Use this driver for payment files funded through the virtual-card payment mode.\",          \"when\": \"User asks for virtual-card, VC, VCC, funding-card, or card-funded payment files.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"paymentFileCreationDate\",            \"paymentDate\",            \"paymentMode\",            \"fundingCardAccount\",            \"financingProgram\",            \"paymentsRecorded\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"paymentFileReference != null\"          ],          \"notes\": \"Use this instead of PPR virtual-card drivers when the user asks for payment files. The visible output must stay payment-file focused: Payment File Reference, Payment File Status, Payment Process Request Name, Payment File Creation Date, Payment Date, Payment Mode, Funding Card Account, Financing Program, and Payments Recorded. Use business labels for visible columns; do not expose raw field names such as paymentFileReference or paymentMode.\"        },        {          \"name\": \"virtualCardPaymentFilesRequiringAttention\",          \"description\": \"Use this driver for virtual-card payment files that require attention.\",          \"when\": \"User asks for virtual-card, VC, VCC, funding-card, or card-funded payment files requiring attention.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"paymentFileCreationDate\",            \"paymentDate\",            \"paymentMode\",            \"fundingCardAccount\",            \"financingProgram\",            \"paymentsRecorded\",            \"pendingSince\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"requestStatusCode='REQUIRING_ATTENTION'\",            \"paymentFileReference != null\",            \"pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\"          ],          \"notes\": \"This is supported. Use this instead of PPR virtual-card drivers when the user asks for virtual-card payment files requiring attention. The output must stay payment-file focused and must not use PPR Status as Payment File Status. Use business labels for visible columns; do not expose raw field names such as paymentFileReference or paymentMode.\"        },        {          \"name\": \"virtualCardPaymentFilesByFundingCardAccount\",          \"description\": \"Use this driver when the user identifies a funding card account or RCN for a virtual-card payment-file search.\",          \"when\": \"User asks for payment files for a named funding card account, funding card, card account alias, or RCN.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"paymentFileCreationDate\",            \"paymentDate\",            \"paymentMode\",            \"fundingCardAccount\",            \"financingProgram\",            \"paymentsRecorded\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"fundingCardAccount='<FUNDING_CARD_ACCOUNT_FROM_USER>'\",            \"paymentFileReference != null\"          ],          \"notes\": \"Preserve the complete funding-card-account value as one literal and keep the output payment-file focused. Do not use PPR status fields for this payment-file prompt. Use business labels for visible columns; do not expose raw field names such as paymentFileReference or paymentMode.\"        },        {          \"name\": \"virtualCardPaymentFilesByFinancingProgram\",          \"description\": \"Use this driver when the user identifies a financing program for a virtual-card payment-file search.\",          \"when\": \"User asks for payment files for a named virtual-card financing program.\",          \"fieldsToReturn\": [            \"paymentFileReference\",            \"paymentFileStatus\",            \"paymentProcessRequest\",            \"paymentFileCreationDate\",            \"paymentDate\",            \"paymentMode\",            \"fundingCardAccount\",            \"financingProgram\",            \"paymentsRecorded\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestId\",            \"paymentProcessType\",            \"requestStatusCode\",            \"paymentFileStatusCode\"          ],          \"extraFilterExpressions\": [            \"paymentModeCode='VIRTUAL_CARD'\",            \"financingProgram='<FINANCING_PROGRAM_FROM_USER>'\",            \"paymentFileReference != null\"          ],          \"notes\": \"Use the financing-program value exactly as resolved from the user request and keep the output payment-file focused. Do not use PPR status fields for this payment-file prompt. Use business labels for visible columns; do not expose raw field names such as paymentFileReference or paymentMode.\"        },        {          \"name\": \"pprsByStatusDisplayName\",          \"description\": \"Use this driver to list payment process requests by a user-facing PPR status name from the PPR_STATUS lookup list.\",          \"when\": \"User asks for PPRs or payment process requests with explicit status-name wording such as with status, having status, for status, in status, where status is, status equals, status set to, or in <status name> status followed by a status display name from displayedFieldLookupCodes. This driver must win before generic lifecycle, approval, installment-selection, validation-error, payment-file, or unsupported drivers for exact non-missing-rate labels including Cancelled Payment, Waiting for payment file processing, Submitted, Pending installments selection, No available installments, Pending payments approval, Installments selected, Selecting installments, Failed document validation. Missing-rate questions remain eligible for the missing-rate review flows.\",          \"fieldsToReturn\": [            \"paymentProcessRequest\",            \"paymentProcessRequestStatus\",            \"paymentDate\",            \"installmentsSelected\",            \"installmentsRejected\",            \"pendingSince\",            \"payablesPaymentProcessRequestId\",            \"paymentProcessRequestStatusCode\"          ],          \"extraFilterExpressions\": [            \"paymentProcessRequestStatusCode = '<LOOKUP_CODE_FROM_STATUS_NAME>'\"          ],          \"notes\": \"Resolve the user-supplied status name using paymentProcessRequestStatusCode.displayedFieldLookupCodes and generate the status predicate on paymentProcessRequestStatusCode only. Preserve the full status label as one lookup phrase. Required exact mappings: Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. Do not filter with paymentProcessRequestStatus, requestStatusCode, requestStatus, or the display text itself. Do not treat exact status labels as approval review, installment-selection clarification, document-validation detail review, payment-file detail, or unsupported requests. Do not add a default date filter unless the user explicitly asks for a date or date range; add only user-supplied extra filters exposed by this EV. Missing-rate questions are intentionally excluded from this precedence because they may use missing-rate review flows.\"        }      ],      \"additionalInstructions\": [        \"Use the seeded EV query resource referenced by api instead of reconstructing the underlying seeded SQL in the shape contract.\",        \"Exact status mapping overrides for non-missing-rate PPR_STATUS labels: Cancelled Payment => CANCELED; Waiting for payment file processing => PAYMENTS_CREATED; Submitted => SUBMITTED; Pending installments selection => UNSTARTED; No available installments => CANCELLED NO PAYMENTS; Pending payments approval => ORA_REQUIRE_APPROVAL; Installments selected => SELECTED; Selecting installments => SELECTING; Failed document validation => VALIDATION_FAILED. If the user uses explicit status-name wording such as \\\"Show PPR with Status <label>\\\", preserve the full status label as one lookup phrase and generate only paymentProcessRequestStatusCode = <LOOKUP_CODE> plus explicit user filters. Do not reinterpret exact labels as generic lifecycle, approval, installment-selection, validation-error, payment-file, or unsupported flows. Missing payment conversion rates and Missing cross-currency rates may continue to use the missing-rate review behavior.\",        \"Exact status mapping overrides for non-missing-rate PPR_STATUS labels: Cancelled Payment maps to CANCELED; Waiting for payment file processing maps to PAYMENTS_CREATED and is not a payment-file detail request; Submitted maps to SUBMITTED exactly, not the display text; Pending installments selection maps to UNSTARTED, and rewritten wording like Pending and installments selection must not map to INSERTED. Missing payment conversion rates and Missing cross-currency rates may continue to use the missing-rate review behavior.\",        \"Exact status-name requests are PPR_STATUS lookup filters: for wording such as 'with status <status name>', 'having status <status name>', 'where status is <status name>', 'status equals <status name>', 'status set to <status name>', 'for status <status name>', 'in status <status name>', or 'in <status name> status', use pprsByStatusDisplayName and map the display name from paymentProcessRequestStatusCode.displayedFieldLookupCodes to paymentProcessRequestStatusCode = '<LOOKUP_CODE>'. Do not use requestStatusCode, paymentProcessRequestStatus, or the display text itself for this exact pattern, and do not add a default date unless requested.\",        \"Use the returned column names in fields.fields for projections, filtering, sorting, and aggregation.\",        \"paymentProcessRequest is the user-facing payables payment batch or checkrun name.\",        \"payablesPaymentProcessRequestId is the payables-side checkrun id, while paymentProcessRequestId is the Oracle Payments funds-disbursement request id.\",        \"Use requestStatusCode for high-level lifecycle buckets only when the matching business driver does not override the filter. For generated completed PPR actions, use requestStatusCode as specified by pprCompleted. For generated terminated PPR actions, use paymentProcessRequestStatusCode IN ('TERMINATED') as specified by pprTerminated.\",        \"For completed PPR requests and completed payment-file requests such as `Show payment files completed on 2012`, always use requestStatusCode='COMPLETED', filter using completionDateRange on completionDate, and sort by completionDate desc. Do not ask whether the supplied date is creation date or payment date because completed wording supplies the lifecycle date axis.\",        \"For paid-date questions such as 'Show PPR Paid In 2012', 'Show PPRs paid last month', or 'Show PPRs paid between two dates', use paymentDateRange on paymentDate only. Do not add paymentProcessRequestStatusCode='COMPLETED', requestStatusCode='COMPLETED', or any lifecycle status filter unless the user explicitly asks for completed PPRs.\",        \"When the user says 'paid in <year>', resolve the date range to paymentDate >= '<year>-01-01' and paymentDate <= '<year>-12-31'.\",        \"For terminated PPR requests, always include `paymentProcessRequestStatusCode IN ('TERMINATED')`, mandatory `paymentFileReference = null`, the termination date filter using `terminationDateRange` on `terminationDate`, and sort by `terminationDate DESC`; never use `requestStatusCode` for terminated PPR filters.\",        \"For PPRs requiring attention, always include paymentFileReference in the selected fields.\",        \"For PPRs requiring attention, filter using requiringAttentionDateRange on pendingSince and sort by pendingSince desc.\",        \"For PPRs by payment date, paid date, or paid period, filter using paymentDateRange on paymentDate and sort by paymentDate desc. Do not add a lifecycle status filter unless the user explicitly asks for one.\",        \"When the user provides an exact PPR name, payablesPaymentProcessRequestId, or paymentProcessRequestId, use the exact identifier filter and do not add the default last-30-days date filter unless the user also asks for a date range, lifecycle list, count, summary, or discovery request.\",        \"Use this EV for approver, pendingSince, and approval-queue questions. Use selectedPaymentInstallments or paymentRunInstallments when the user needs the underlying proposed payment rows.\",        \"The approval-review statuses used in this area are PENDING_REVIEW, ORA_REQUIRE_APPROVAL, ORA_APPROVAL_INITIATED, ORA_APPROVED, ORA_APPROVAL_WITHDRAWN, and PAYMENTS_CREATED.\",        \"Approval-chain depth, approval limits, approval history, and expected approval turnaround are not exposed natively by this EV.\",        \"This EV is the anchoring shape for payment-validation-error comparisons because it provides the PPR, lifecycle, and payment-file context for the affected run.\",        \"If the user asks for paymentErrorCount or paymentInstructionErrorCount, derive them by grouping filtered rows from disbursementPaymentExceptions and disbursementPaymentInstructionExceptions; they are not native columns in this seeded EV resource.\",        \"For payment-confirmation failure questions, use paymentsConfirmed with paymentFileStatusCode to establish the run state, then pivot to disbursementPaymentInstructionExceptions for the technical error and setup context.\",        \"For count or summary requests, aggregate over the filtered EV result set without changing the seeded resource contract.\",        \"Unless the user explicitly requests more, limit detail results to 20 rows in the outer query.\",        \"When the user asks to 'view all the PPRs stuck in failure', do not use FAILED_PAYMENT_VALIDATION.\",        \"For date filters on this EV, generate the required date from the LLM current date and the user's filter context, then use only literal ISO date values in the filter; never use SQL functions such as TRUNC, SYSDATE, CURRENT_DATE, ADD_MONTHS, or TO_DATE.\",        \"If the user does not provide any date or time range for a list, count, status, summary, or discovery request, always add the correct default date filter based on the intent: completionDate for completed PPRs or completed payment files, terminationDate for terminated PPRs or terminated payment files, pendingSince for requiring-attention, in-process, pending-approval, stuck-in-failure, or waiting-for-information PPRs/payment files, paymentDate for payment-date or paid-date requests, and paymentProcessRequestCreationDate only for generic discovery queries with no explicit status or date axis.\",        \"Do not skip date filtering for completed, terminated, in-process, requiring-attention, pending-approval, stuck-in-failure, waiting-for-information, count, status, summary, or list requests unless the user provided an exact PPR name or PPR id and did not ask for a lifecycle list.\",        \"Ensure to follow dateFilterGuidance for the sorting based on context\",        \" Mandatory - Ensure for all questions related to pending approval, the driver pprApprovalPending is applied.\",        \"Pending approval questions must use `paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED')`; never use `requestStatusCode` for pending approval filters.\",        \"For pending PPR questions tied to a specific date, filter on `pendingSince`, not `paymentProcessRequestCreationDate`.\",        \"Questions such as 'Which PPRs are waiting for additional information/missing attributes right now?' are supported by pprsWaitingForAdditionalInformation with paymentProcessRequestStatusCode='INFORMATION_REQUIRED' and a pendingSince recency filter.\",        \"UI PPR status display text is a lookup aid, not a business-driver override. Do not use the UI status lookup for completed, terminated/cancelled, generic pending, pending approval, requiring attention, waiting-for-information, or missing-rate intents because those are handled by existing business drivers and may require combination filters. For pure 'PPR in status <display text>' requests that match paymentProcessRequestStatusCode.displayedFieldLookupCodes, translate only the paymentProcessRequestStatusCode predicate. Examples: 'Pending action to address payment validation errors' -> PENDING_REVIEW_PMT_VAL_ERRORS; 'Pending installments review' -> REVIEW.\",        \"For PPR pending approval, filter by paymentProcessRequestStatusCode and pendingSince. For pending since last month, compute the first calendar day of the previous month, not a rolling 30-day date. For terminated PPRs, use paymentProcessRequestStatusCode IN (TERMINATED) plus paymentFileReference = null and sort by terminationDate desc.\",        \"For questions such as 'show the payment runs scheduled today' or 'show PPRs scheduled today', compare the requested date with paymentProcessRequestCreationDate. Do not use paymentDate for scheduled-today questions unless the user explicitly asks for payment date or paid date.\",        \"For completed PPR lists and completed payment-file lists, return the standard PPR list fields paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,completionDate,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode. Use completionDate for explicit date filtering, default recency filtering, display, and completionDate:desc sorting. For terminated PPR/payment-file lists, sort by terminationDate:desc before applying limit. Never substitute paymentDate or paymentProcessRequestCreationDate for these lifecycle-specific sorts.\",        \"For explicit PPR status-name requests, use paymentProcessRequestStatusCode lookup labels and generate only the paymentProcessRequestStatusCode predicate plus any explicit user filters. Preserve multi-word status labels as one phrase and do not filter status display text with requestStatusCode or paymentProcessRequestStatus.\",        \"For virtual-card, VC, VCC, funding-card, or card-funded PPR requests, apply paymentModeCode='VIRTUAL_CARD' as a filter and select paymentMode as the visible business-facing value. Do not include paymentModeCode in result fields unless the user explicitly asks for the code.\",        \"For a funding-card-account or RCN PPR request, preserve the full account value as one literal and combine fundingCardAccount='<FUNDING_CARD_ACCOUNT_FROM_USER>' with paymentModeCode='VIRTUAL_CARD'.\",        \"For a virtual-card financing-program PPR request, combine financingProgram='<FINANCING_PROGRAM_FROM_USER>' with paymentModeCode='VIRTUAL_CARD'.\",        \"For payment-file prompts that mention virtual card, funding card account, RCN, or financing program, use payment-file fields rather than PPR fields: paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentMode,fundingCardAccount,financingProgram,paymentsRecorded plus deeplink support ids. Always add paymentFileReference != null for payment-file virtual-card searches so PPR-only rows are excluded.\",        \"For payment-file funding-card-account and financing-program searches, do not add a pendingSince or default requiring-attention date filter unless the user explicitly asks for requiring attention. Summaries must describe only filters present in the executed query.\",        \"PPR status names are lookup labels, not free-text filter values. For wording such as 'with status <status name>', 'having status <status name>', 'where status is <status name>', 'status equals <status name>', 'status set to <status name>', 'for status <status name>', 'in status <status name>', or 'in <status name> status', use the pprsByStatusDisplayName driver, resolve the status name from paymentProcessRequestStatusCode.displayedFieldLookupCodes, and generate only the paymentProcessRequestStatusCode predicate for that status plus any user-supplied filters. Existing business-driver intents still take precedence for non-exact lifecycle or workflow requests such as completed PPRs, terminated/cancelled PPRs, generic pending PPRs, pending approval, requiring attention, waiting-for-information, and missing-rate questions because those may require combination filters. Examples: 'Show PPRs with status Payments approval initiated' -> paymentProcessRequestStatusCode = 'ORA_APPROVAL_INITIATED'; 'List PPRs where status is Waiting for payment file processing' -> paymentProcessRequestStatusCode = 'PAYMENTS_CREATED'; 'Show payment process requests having status Pending action to address payment validation errors' -> paymentProcessRequestStatusCode = 'PENDING_REVIEW_PMT_VAL_ERRORS'; 'Show PPR completed' -> use the completed business driver, not the status-name driver.\"      ],      \"fieldSelectionRuleUsage\": {        \"match\": \"Choose the closest questionExamples entry for the user request.\",        \"fields\": \"Use the matching fields value exactly and preserve order.\",        \"paraphrases\": \"Use the same fields for paraphrased or equivalent requests.\",        \"addFieldsOnlyWhen\": \"The user explicitly asks for more displayed columns, or the field is required for filter, sort, group, key, or deeplink handling.\"      },      \"fieldSelectionRules\": [        {          \"questionExamples\": [            \"How long has PPR PPR05-009 been pending approval\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentProcessRequestCreationDate,pendingSince,paymentApprover,paymentsRecorded,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentProcessRequest = '<PPR_NAME_FROM_USER>' AND paymentProcessRequestStatusCode in ('ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED','PENDING_REVIEW') AND pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"pendingSince:desc\",          \"limit\": 20,          \"notes\": \"Approval-pending questions must filter on paymentProcessRequestStatusCode, never requestStatusCode. Use pendingSince for aging.\"        },        {          \"questionExamples\": [            \"I want to view all the PPRs stuck in failure\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentDocument,paymentProcessRequest,paymentProcessRequestStatus,,requestStatus,requestStatusCode,paymentBusinessUnit,legalEntity,paymentCurrency,paymentMethod,paymentProcessProfile,pendingSince,installmentsSelected,installmentsRejected,paymentApprover,paymentFileReference,paymentFileStatus,bankStatusCode,bankErrorCode,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show me all PPRs pending approval\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentProcessRequestCreationDate,pendingSince,paymentApprover,installmentsSelected,,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentProcessRequestStatusCode in ('PENDING_REVIEW','ORA_REQUIRE_APPROVAL','ORA_APPROVAL_INITIATED') AND pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"pendingSince:desc\",          \"limit\": 20,          \"notes\": \"All pending-approval PPRs use paymentProcessRequestStatusCode and pendingSince; do not use requestStatusCode.\"        },        {          \"questionExamples\": [            \"Show me the PPR requiring action\",            \"Show PPR requiring attention in the last 30 days\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,payablesPaymentProcessRequestId,paymentProcessRequestStatusCodepaymentProcessRequest,paymentProcessRequestCreationDate,paymentDate,paymentProcessRequestStatus,requestStatusCode,paymentFileReference,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show PPR pending since last month\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"requestStatusCode = 'IN_PROCESS' AND pendingSince >= '<FIRST_DAY_OF_PREVIOUS_MONTH>'\",          \"sortBy\": \"pendingSince:desc\",          \"limit\": 20,          \"notes\": \"Since last month means from the first calendar day of the previous month, not a rolling 30-day threshold. Use pendingSince, not paymentProcessRequestCreationDate.\"        },        {          \"questionExamples\": [            \"Show PPR terminated in 2012\",            \"Show PPR terminated from 2025 to 2026\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,pendingSince,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentProcessRequestStatusCode IN ('TERMINATED') AND paymentFileReference = null AND terminationDate within <USER_DATE_RANGE>\",          \"sortBy\": \"terminationDate:desc\",          \"limit\": 20,          \"notes\": \"Terminated PPR queries always use paymentProcessRequestStatusCode IN (TERMINATED), paymentFileReference = null, terminationDate filtering, and terminationDate:desc sorting. Never sort by paymentProcessRequestCreationDate.\"        },        {          \"questionExamples\": [            \"Show PPR completed after 2025\",            \"Show PPR completed\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,completionDate,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"requestStatusCode = 'COMPLETED' AND completionDate >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"completionDate:desc\",          \"limit\": 20,          \"notes\": \"Completed PPR list queries use completionDate for explicit date filtering, default recency filtering, display, and sorting. Return completionDate with the standard PPR list fields. Do not return paymentProcessRequestCreationDate unless the user explicitly asks for creation date. Never sort by paymentDate or paymentProcessRequestCreationDate.\"        },        {          \"questionExamples\": [            \"Show payment files completed on 2012\",            \"Show completed payment files in 2012\",            \"Show completed payment files\",            \"Show payment files completed in the last 30 days\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,completionDate,paymentDate,paymentFileCreationDate,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"requestStatusCode = 'COMPLETED' AND paymentFileReference != null AND completionDate >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"completionDate:desc\",          \"limit\": 20,          \"notes\": \"Completed payment-file list queries must include paymentFileReference != null so PPR-only rows are excluded. Use completionDate for explicit date filtering, default recency filtering, display, and sorting.\"        },        {          \"questionExamples\": [            \"Show payment files requiring attention\",            \"Show payment file requiring attention\",            \"Show payment files requiring attention in the last 30 days\",            \"Show payment files requiring attention since last month\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,pendingSince,paymentDate,paymentFileCreationDate,paymentsRecorded,bankStatusCode,bankErrorCode,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"requestStatusCode = 'REQUIRING_ATTENTION' AND paymentFileReference != null AND pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"pendingSince:desc\",          \"limit\": 20,          \"notes\": \"Requiring-attention payment-file list queries must include paymentFileReference != null so PPR-only rows are excluded. Use pendingSince for explicit date filtering, default recency filtering, display, and sorting.\"        },        {          \"questionExamples\": [            \"Show terminated payment files\",            \"Show payment files terminated in 2012\",            \"Show cancelled payment files\",            \"Show payment files that ended without completing\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,terminationDate,paymentDate,paymentFileCreationDate,paymentsRecorded,bankStatusCode,bankErrorCode,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"requestStatusCode = 'TERMINATED' AND paymentFileReference != null AND terminationDate >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"terminationDate:desc\",          \"limit\": 20,          \"notes\": \"Terminated payment-file list queries must include paymentFileReference != null so PPR-only rows are excluded. Use terminationDate for explicit date filtering, default recency filtering, display, and sorting.\"        },        {          \"questionExamples\": [            \"Show payment files with payment method check\",            \"Show payment files by using payment method Check\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentMethod,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentMethod = '<PAYMENT_METHOD_FROM_USER>' AND paymentFileReference != null\",          \"sortBy\": \"paymentFileCreationDate:desc\",          \"limit\": 20,          \"notes\": \"For payment-method payment-file searches, use the compact payment-file search field set: file reference, file status, PPR name, file creation date, payment date, the searched payment method, and payments recorded, plus the technical ids needed for deeplink enrichment. Do not request unrelated file-level attribute columns.\"        },        {          \"questionExamples\": [            \"Show me payment file whose payment date is after 2026-01-01\",            \"Show payment files having payment date within last 2 weeks\",            \"Show payment files with payment date in 2012\",            \"Show me payment files paid in April 2026\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentDate within <USER_DATE_RANGE> AND paymentFileReference != null\",          \"sortBy\": \"paymentDate:desc\",          \"limit\": 20,          \"notes\": \"For payment-date payment-file searches, use the compact payment-file search field set and sort by paymentDate:desc. Do not add unrelated file-level attribute columns unless the user explicitly asked for them.\"        },        {          \"questionExamples\": [            \"Show PPR details whose name is CPPRT_020015\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentDate,installmentsSelected,installmentsRejected,completionDate,pendingSince,terminationDate,payablesPaymentProcessRequestId,paymentProcessRequestStatusCode\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show PPR paid in 2012\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest, paymentProcessRequestCreationDate, paymentDate, paymentProcessRequestStatus, paymentProcessRequestStatusCode,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"View details of PPR PPR_DD_Test3\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest, paymentProcessRequestStatus, paymentDate, installmentsSelected, installmentsRejected, completionDate, pendingSince, terminationDate,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"What payment file format was used for PPR PPR05-009\"          ],          \"queryType\": \"EV\",          \"fields\": \"formatName\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Which PPRs are waiting for additional information\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentProcessRequestStatusCode,requestStatus,requestStatusCode,pendingSince,paymentBusinessUnit,paymentCurrency,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"show the payment runs scheduled today\",            \"Show PPRs scheduled today\",            \"Show payment process requests scheduled tomorrow\",            \"Show payment runs created yesterday\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentProcessRequest,paymentProcessRequestStatus,paymentProcessRequestStatusCode,paymentProcessRequestCreationDate,paymentDate,installmentsSelected,installmentsRejected,pendingSince,payablesPaymentProcessRequestId\",          \"fieldOrderLocked\": true        },        {          \"questionExamples\": [            \"Show payment files with payment mode Virtual Card\",            \"Show virtual card payment files\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentMode,fundingCardAccount,financingProgram,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentModeCode='VIRTUAL_CARD' AND paymentFileReference != null\",          \"sortBy\": \"paymentFileCreationDate:desc\",          \"limit\": 20,          \"notes\": \"Use this payment-file field set for virtual-card payment-file searches. Do not use PPR virtual-card fields or show PPR Status as the payment-file status.\"        },        {          \"questionExamples\": [            \"Show virtual card payment files requiring attention\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentMode,fundingCardAccount,financingProgram,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode,pendingSince\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentModeCode='VIRTUAL_CARD' AND requestStatusCode='REQUIRING_ATTENTION' AND paymentFileReference != null AND pendingSince >= '<CURRENT_DATE_MINUS_30_DAYS>'\",          \"sortBy\": \"pendingSince:desc\",          \"limit\": 20,          \"notes\": \"This is a payment-file query, so paymentFileReference != null is mandatory. Include pendingSince only because requiring-attention lifecycle wording supplies that date axis.\"        },        {          \"questionExamples\": [            \"Show payment files for funding card account AutoIBY RCN12 USD Vision Ops\",            \"Show payment files for funding card account old-AutoIBY RCN12 USD Vision Ops\"          ],          \"queryType\": \"EV\",          \"fields\": \"paymentFileReference,paymentFileStatus,paymentProcessRequest,paymentFileCreationDate,paymentDate,paymentMode,fundingCardAccount,financingProgram,paymentsRecorded,payablesPaymentProcessRequestId,paymentProcessRequestId,paymentProcessType,requestStatusCode,paymentFileStatusCode\",          \"fieldOrderLocked\": true,          \"shape\": \"PayablesPaymentProcessRequestDetails\",          \"filters\": \"paymentModeCode='VIRTUAL_CARD' AND fundingCardAccount='<FUNDING_CARD_ACCOUNT_FROM_USER>' AND paymentFileReference != null\",          