                {
                  "metadata": {
                    "name": "Error handler",
                    "sourceCode": "/*\n * Structured retry feedback for query-builder retries.\n * Keeps retry prompts short and actionable.\n */\n\nvar counter = Number($context && $context.$variables ? $context.$variables.retryCount : 0);\nif (Number.isNaN(counter)) {\n  counter = 0;\n}\n\nvar rawError = \"\";\nif ($context && $context.$error && $context.$error.$errorMessage) {\n  rawError = String($context.$error.$errorMessage);\n}\n\nfunction add(errors, code, message) {\n  errors.push({\n    code: code,\n    message: message\n  });\n}\n\nfunction classifyError(text) {\n  var lower = String(text || \"\").toLowerCase();\n  var errors = [];\n\n  if (/select\\s+\\*/i.test(text)) {\n    add(errors, \"SELECT_STAR_FORBIDDEN\", \"Do not use SELECT *. Enumerate explicit output aliases.\");\n  }\n\n  if (lower.indexOf(\"namedselect\") >= 0 || lower.indexOf(\"named select\") >= 0 || lower.indexOf(\"namedselects\") >= 0) {\n    add(errors, \"NAMED_SELECT_REFERENCE_ERROR\", \"If SQL references a named select, the extractionQuery.namedSelects prereference must be present when the selected shape declares it.\");\n  }\n\n  if (lower.indexOf(\"invalid identifier\") >= 0 || lower.indexOf(\"unknown field\") >= 0 || lower.indexOf(\"invalid field\") >= 0 || lower.indexOf(\"unknown column\") >= 0) {\n    add(errors, \"INVALID_FIELD_OR_ALIAS\", \"Use only fields, aliases, and source names declared in promptInput.\");\n  }\n\n  if (lower.indexOf(\"syntax\") >= 0 || lower.indexOf(\"parse\") >= 0 || lower.indexOf(\"parser\") >= 0) {\n    add(errors, \"QUERY_SYNTAX_ERROR\", \"Fix only query syntax. Preserve the selected shape, sources, filters, and business slice.\");\n  }\n\n  if (lower.indexOf(\"date\") >= 0 && (lower.indexOf(\"sysdate\") >= 0 || lower.indexOf(\"current_date\") >= 0 || lower.indexOf(\"trunc\") >= 0 || lower.indexOf(\"add_months\") >= 0 || lower.indexOf(\"to_date\") >= 0)) {\n    add(errors, \"UNSUPPORTED_DATE_FUNCTION\", \"Use literal ISO dates only. Do not emit SYSDATE, CURRENT_DATE, TRUNC, ADD_MONTHS, TO_DATE, or equivalent date functions.\");\n  }\n\n  if (lower.indexOf(\"sort\") >= 0 || lower.indexOf(\"orderby\") >= 0 || lower.indexOf(\"order by\") >= 0) {\n    add(errors, \"INVALID_SORT\", \"Use an empty sort string or a field declared in promptInput.shape.sortableAttributes.\");\n  }\n\n  if (errors.length === 0) {\n    add(errors, \"BACKEND_QUERY_ERROR\", rawError.slice(0, 800));\n  }\n\n  return errors;\n}\n\nlet errorNode = $context.$error.$errorNode;\n\nreturn {\n  retry: true,\n  counter: counter + 1,\n  errors: classifyError(rawError),\n  rawError: rawError.slice(0, 1200),\n  instruction: \"Fix only the listed errors. Preserve selected shape, query type, business slice, source names, filters, and intended output unless the error explicitly requires removing an invalid item.\",\n   errorNode: errorNode\n};",
