        {
          "metadata": {
            "name": "Combine Result",
            "returnType": "array",
            "sourceCode": "let blocks = [];\nlet sequence = 1;\nlet skillType = $context.$nodes.REQUIRES_DATA_FETCH.$output;\n\nfunction parseMaybeJson(value) {\n  if (value == null) return null;\n\n  if (typeof value === \"object\") return value;\n\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      return null;\n    }\n  }\n\n  return null;\n}\n\nfunction parseNestedOutput(output) {\n  if (Array.isArray(output) && output.length > 0) {\n    return parseMaybeJson(output[0]);\n  }\n\n  return parseMaybeJson(output);\n}\n\nlet intentOutput = parseNestedOutput($context.$nodes.GET_BUSINESS_INTENT.$output) || {};\nlet intentKey = intentOutput.intentKey || (intentOutput.result && intentOutput.result.intentKey) || \"\";\n\nfunction buildContextData(contextData) {\n  let data = parseMaybeJson(contextData);\n\n  if (!data || typeof data !== \"object\" || Array.isArray(data)) {\n    data = {};\n  }\n\n  data.intentKey = intentKey;\n  return data;\n}\n\nfunction getFieldText(field) {\n  if (field == null) return \"\";\n\n  if (typeof field === \"object\") {\n    return [\n      field.name,\n      field.key,\n      field.field,\n      field.fieldName,\n      field.columnName,\n      field.label,\n      field.header,\n      field.title,\n      field.semanticType\n    ]\n      .filter(function (value) {\n        return value != null;\n      })\n      .join(\" \")\n      .toLowerCase();\n  }\n\n  return String(field).toLowerCase();\n}\n\nfunction shouldDisableAmountIdentification(tbl) {\n  let fields = [];\n\n  if (Array.isArray(tbl.columnOrder) && tbl.columnOrder.length > 0) {\n    fields = tbl.columnOrder;\n  } else if (\n    Array.isArray(tbl.content) &&\n    tbl.content.length > 0 &&\n    tbl.content[0] &&\n    typeof tbl.content[0] === \"object\" &&\n    !Array.isArray(tbl.content[0])\n  ) {\n    fields = Object.keys(tbl.content[0]);\n  }\n\n  let currencyFieldCount = fields.filter(function (field) {\n    let text = getFieldText(field);\n    return text.indexOf(\"currency\") !== -1 || text.indexOf(\"currcode\") !== -1 || text.indexOf(\"curr_code\") !== -1;\n  }).length;\n\n  let amountFieldCount = fields.filter(function (field) {\n    let text = getFieldText(field);\n    return text.indexOf(\"amount\") !== -1 || text.indexOf(\"amt\") !== -1;\n  }).length;\n\n  return currencyFieldCount === 1 && amountFieldCount > 1;\n}\n\nfunction getSummaryText(summary) {\n  if (\n    !summary ||\n    summary.type !== \"text\" ||\n    !Array.isArray(summary.content) ||\n    summary.content.length === 0\n  ) {\n    return \"\";\n  }\n\n  return summary.content.join(\" \").toLowerCase();\n}\n\nfunction getSummaryState(summary) {\n  let text = getSummaryText(summary);\n\n  if (!text) return \"results\";\n\n  if (\n    text.indexOf(\"unsupported\") !== -1 ||\n    text.indexOf(\"out of scope\") !== -1 ||\n    text.indexOf(\"not supported\") !== -1\n  ) {\n    return \"unsupported\";\n  }\n\n  if (\n    text.indexOf(\"ambiguous\") !== -1 ||\n    text.indexOf(\"multiple matching\") !== -1 ||\n    text.indexOf(\"more than one matching\") !== -1\n  ) {\n    return \"ambiguous\";\n  }\n\n  if (\n    text.indexOf(\"could not find\") !== -1 ||\n    text.indexOf(\"no matching\") !== -1 ||\n    text.indexOf(\"no payment\") !== -1 ||\n    text.indexOf(\"no acknowledgement\") !== -1 ||\n    text.indexOf(\"no acknowledgment\") !== -1 ||\n    text.indexOf(\"no results\") !== -1 ||\n    text.indexOf(\"were found\") === -1 && text.indexOf(\"no \") === 0\n  ) {\n    return \"noData\";\n  }\n\n  return \"results\";\n}\n\nfunction shouldSuppressTables(summaryState) {\n  return summaryState === \"unsupported\" || summaryState === \"ambiguous\" || summaryState === \"noData\";\n}\n\nif (skillType == \"DataOnly\") {\n  let rawActionOutput = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$output;\n  let action = parseNestedOutput(rawActionOutput);\n\n  if (\n    action &&\n    action.type === \"text\" &&\n    Array.isArray(action.content) &&\n    action.content.length > 0\n  ) {\n    blocks.push({\n      type: \"text\",\n      content: action.content,\n      sequence: sequence++,\n      formatHint: action.formatHint || \"\"\n    });\n  }\n\n  return blocks;\n}\n\nlet summary = $context.$nodes.FIN_AP_LLM_GENERATE_SUMMARY.$output;\nlet summaryState = getSummaryState(summary);\n\nif (\n  summary &&\n  typeof summary === \"object\" &&\n  summary.type === \"text\" &&\n  Array.isArray(summary.content) &&\n  summary.content.length > 0\n) {\n  let pushableBlock = {\n    type: \"text\",\n    content: summary.content,\n    sequence: sequence++,\n    formatHint: summary.formatHint || \"\"\n  };\n  if ($context.$triggers.REST.$input.executionMode == \"DEBUG\") {\n    pushableBlock.contextData = { errors: $context.$variables.dataFetchErrors };\n  }\n  blocks.push(pushableBlock);\n}\n\nlet tableStrings = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$output;\n\nif (!shouldSuppressTables(summaryState) && Array.isArray(tableStrings)) {\n  tableStrings.forEach(function (item) {\n    let wrapper;\n    try {\n      wrapper = typeof item === \"string\" ? JSON.parse(item) : item;\n    } catch (e) {\n      return;\n    }\n\n    if (!wrapper || !wrapper.result) return;\n\n    let tbl = wrapper.result;\n    if (tbl.type !== \"table\" || !Array.isArray(tbl.content) || ($context.$triggers.REST.$input.executionMode != \"DEBUG\" && tbl.content.length === 0)) return;\n\n    let tableBlock = {\n      type: \"table\",\n      heading: tbl.heading || \"\",\n      content: tbl.content,\n      sequence: sequence++,\n      formatHint: tbl.formatHint || \"\",\n      columnOrder: Array.isArray(tbl.columnOrder) ? tbl.columnOrder : [],\n      purpose: tbl.purpose || \"\",\n      contextData: buildContextData(tbl.contextData),\n      bossMetadata: tbl.bossMetadata,\n      payload: tbl.payload,\n      fieldMapping: tbl.fieldMapping || {}\n    };\n\n    if (shouldDisableAmountIdentification(tbl)) {\n      // Disabled due to regression in non-PPR review cases\n      tableBlock.disableAmountIdentification = false;\n    }\n\n    blocks.push(tableBlock);\n  });\n}\n\nlet recommendation = $context.$nodes.FIN_AP_LLM_GENERATE_RECOMENDATION.$output;\nlet recObj = parseNestedOutput(recommendation);\n\nif (\n  recObj &&\n  recObj.type === \"actions\" &&\n  Array.isArray(recObj.content) &&\n  recObj.content.length > 0\n) {\n  blocks.push({\n    type: \"actions\",\n    content: recObj.content,\n    sequence: sequence++\n  });\n} else if (\n  recObj &&\n  recObj.type === \"text\" &&\n  Array.isArray(recObj.content) &&\n  recObj.content.length > 0\n) {\n  blocks.push({\n    type: \"text\",\n    content: recObj.content,\n    sequence: sequence++,\n    formatHint: recObj.formatHint || \"\"\n  });\n}\n\nreturn blocks;\n"
