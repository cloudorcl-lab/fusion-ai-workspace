                  "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/schemas/pprUnselectedInstallmentsAggregation.schema.json\",\n  \"title\": \"PPR Unselected Installments Aggregation (Extraction Query)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"shapeKey\", \"queryType\", \"extractionQuery\", \"fields\", \"fieldAlias\"],\n  \"properties\": {\n    \"shapeKey\": {\n      \"type\": \"string\"\n    },\n    \"queryType\": {\n      \"type\": \"string\",\n      \"const\": \"extraction\"\n    },\n    \"extractionQuery\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"viewQueries\", \"select\"],\n      \"properties\": {\n        \"viewQueries\": {\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": {\n            \"$ref\": \"#/$defs/viewQuery\"\n          }\n        },\n        \"select\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"description\": \"SQL-like select statement used by the extraction framework.\"\n        }\n      }\n    },\n    \"fields\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$\",\n      \"description\": \"Comma-separated list of output fields.\"\n    },\n    \"fieldAlias\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\",\n        \"minLength\": 1\n      },\n      \"description\": \"Display label to field-name mapping (e.g., 'Installment Count' -> 'installmentCount').\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    }\n  },\n  \"$defs\": {\n    \"viewQuery\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"view\", \"businessObject\", \"module\", \"fieldAliases\"],\n      \"properties\": {\n        \"view\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"businessObject\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"module\": {\n          \"type\": \"string\",\n          \"minLength\": 1\n        },\n        \"fieldAliases\": {\n          \"type\": \"object\",\n          \"minProperties\": 1,\n          \"additionalProperties\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"description\": \"Source field path -> alias mapping used in the extraction query.\"\n        }\n      }\n    }\n  }\n}",
