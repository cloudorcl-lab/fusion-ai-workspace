                {
                  "metadata": {
                    "name": "Set BV BOSS Metadata",
                    "returnType": "object",
                    "sourceCode": "const path = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem?.shape?.api || \"\";\n\nconst output = {\n  link: buildBasePath(\"/api/boss/data\", path),\n  parameters: {\n    \"$fields\": \"\",\n    \"$filter\": \"\",\n    \"$filterfact\": \"\",\n    \"$offset\": \"\",\n    \"$sortBy\": \"\",\n    \"bossBusinessObject\": \"\"\n  }\n};\n\nfunction buildBasePath(prefix, pathValue) {\n  if (!pathValue) return \"\";\n\n  let cleanPath = String(pathValue).trim();\n\n  if (cleanPath.indexOf(\"?\") >= 0) {\n    cleanPath = cleanPath.split(\"?\")[0];\n  }\n\n  if (cleanPath.charAt(0) !== \"/\") {\n    cleanPath = \"/\" + cleanPath;\n  }\n\n  return prefix + cleanPath;\n}\n\nfunction normalizeParam(value) {\n  if (value === null || value === undefined) return \"\";\n\n  if (typeof value === \"string\") {\n    return value;\n  }\n\n  if (typeof value === \"number\" || typeof value === \"boolean\") {\n    return String(value);\n  }\n\n}\n\nconst bvBuilderOutput =\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR?.FIN_AP_LLM_BV_QUERY_BUILDER?.$output || {};\n\nconst bvQuery = bvBuilderOutput.bvQuery || {};\n\noutput.parameters[\"$fields\"] = normalizeParam(bvQuery.fields);\noutput.parameters[\"$filter\"] = normalizeParam(bvQuery.filters || bvQuery.filter);\noutput.parameters[\"$sortBy\"] = normalizeParam(bvQuery.sortBy);\n\n\nreturn output;"
