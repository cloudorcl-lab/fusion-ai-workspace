                {
                  "metadata": {
                    "name": "Set AV BOSS Metadata",
                    "sourceCode": "const path = $context.$nodes.FIN_AP_LOOP_EXECUTOR.$currentItem?.shape?.api || \"\";\n\nconst output = {\n  link: buildBasePath(\"/api/boss/extraction\", path),\n  parameters: {\n    \"$fields\": \"\",\n    \"$filter\": \"\",\n    \"$filterfact\": \"\",\n    \"$offset\": \"\",\n    \"$sortBy\": \"\",\n    \"bossBusinessObject\": \"\"\n  }\n};\n\nfunction buildBasePath(prefix, pathValue) {\n  if (!pathValue) return \"\";\n\n  let cleanPath = String(pathValue).trim();\n\n  if (cleanPath.indexOf(\"?\") >= 0) {\n    cleanPath = cleanPath.split(\"?\")[0];\n  }\n\n  if (cleanPath.charAt(0) !== \"/\") {\n    cleanPath = \"/\" + cleanPath;\n  }\n\n  return prefix + cleanPath;\n}\n\nfunction decodeValue(value) {\n  if (value === null || value === undefined) return \"\";\n\n  try {\n    return decodeURIComponent(String(value).replace(/\\+/g, \" \"));\n  } catch (e) {\n    return String(value);\n  }\n}\n\nfunction getQueryString(href) {\n  if (typeof href !== \"string\" || href.trim() === \"\") return \"\";\n\n  const queryStartIndex = href.indexOf(\"?\");\n  if (queryStartIndex < 0 || queryStartIndex >= href.length - 1) return \"\";\n\n  return href.substring(queryStartIndex + 1).split(\"#\")[0];\n}\n\nconst href =\n  $context.$nodes.FIN_AP_LOOP_EXECUTOR.FIN_AP_BO_GET_AV_DATA.$output?.links?.$self?.href || \"\";\n\nconst queryString = getQueryString(href);\n\nif (queryString) {\n  const pairs = queryString.split(\"&\");\n\n  for (const pair of pairs) {\n    if (!pair) continue;\n\n    const equalsIndex = pair.indexOf(\"=\");\n    const rawKey = equalsIndex >= 0 ? pair.substring(0, equalsIndex) : pair;\n    const rawValue = equalsIndex >= 0 ? pair.substring(equalsIndex + 1) : \"\";\n\n    const key = decodeValue(rawKey);\n    const value = decodeValue(rawValue);\n\n    if (Object.prototype.hasOwnProperty.call(output.parameters, key)) {\n      output.parameters[key] = value;\n    }\n  }\n}\n\nreturn output;",
                    "returnType": "object"
