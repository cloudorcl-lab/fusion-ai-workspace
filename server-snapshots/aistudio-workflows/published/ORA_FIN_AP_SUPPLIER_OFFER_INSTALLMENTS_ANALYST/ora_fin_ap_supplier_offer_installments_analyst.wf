            "errorNodeId": "1765715409538",
            "name": "Parse Offer Installment Result",
            "returnType": "object",
            "sourceCode": "// Read tool outputs\nconst installments = $context.$nodes.FIN_AP_BO_OFFER_INSTALLMENT.$output ||\n  [];\n\n// Prepare metadata for LLM (even if empty)\nconst summaryInput = {\n  supplier: $context.$nodes.FIN_AP_LLM_CHECK_INTENT.$output.supplier ,\n  businessUnits: [...new Set(installments.map(i => i.businessUnitName).filter(Boolean))],\n  offerStatuses: [...new Set(installments.map(i => i.offerStatus).filter(Boolean))],\n  totalInstallments: installments.length\n};\n\n// Expose variables to next nodes\nconst result = {\n  installments,\n  summaryInput\n};\n\nreturn result;"
          },
