        {
          "metadata": {
            "name": "Refine Response from Assistant",
            "returnType": "object",
            "sourceCode": "let result = { type: \"text\", message: {} };\ntry {\n  const assistantOutput = JSON.parse($context.$nodes.INVOKE_OPPORTUNITY_ASSISTANT.$output.output);\n\n  if (assistantOutput && typeof assistantOutput === \"object\") {\n\n    const responseType = assistantOutput.type;\n    if (responseType === \"text\") {\n      result = { type: \"text\", message: { messageString: \"No Results found\" } };\n    } else {\n      const primaryText = assistantOutput.primaryText || \"\";\n      const secondaryText = assistantOutput.secondaryText || \"\";\n      const postback = assistantOutput.postback || \"\";\n\n      const messageString = `# ${primaryText}\\n## ${secondaryText}\\n${postback}`;\n\n      result = {\n        type: responseType,\n        message: {\n          primaryText: primaryText,\n          secondaryText: secondaryText,\n          postback: postback,\n          messageString: messageString\n        }\n      };\n    }\n  } else {\n    // If output is not object or missing, default to text with messageString \"No Results found\"\n    result = { type: \"text\", message: { messageString: \"No Results found\" } };\n  }\n} catch (error) {\n  result = { type: \"text\", message: { messageString: \"No Results found\" } };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776452312415"
          },
          "code": "REFINE_RESPONSE_FROM_ASSISTANT",
          "id": "1776452715643",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Email Content",
            "returnType": "object",
            "sourceCode": "let retObj;\ntry {\n  let payload = [];\n  // TODO: Inferred 'messageString' from 'message.messageString' as per schema\n  let message = $context.$nodes.REFINE_RESPONSE_FROM_ASSISTANT.$output.result.message.message || \"\";\n\n  retObj = {\n    draftFlag: true,\n    subject: payload.find(p => p.id === \"subject\")?.value || \"\",\n    body: message,\n    trackConversationFlag: true,\n    providerCode: \"EXCHANGE\",\n    toAddress: payload.find(p => p.id === \"email\")?.value || \"\",\n    ccAddress: payload.find(p => p.id === \"cc\")?.value || \"\",\n    conversationReferences: `ORA_MOO_OPTY.${payload.find(p => p.id === \"optyid\")?.value || \"\"}`,\n    msgTemplateObjectId: payload.find(p => p.id === \"optyid\")?.value || \"\",\n    messageTemplateObjTypeCd: \"ORA_MOO_OPTY\"\n  };\n} catch (error) {\n  retObj = {\n    draftFlag: true,\n    subject: \"\",\n    body: \"\",\n    trackConversationFlag: true,\n    providerCode: \"EXCHANGE\",\n    toAddress: \"\",\n    ccAddress: \"\",\n    conversationReferences: \"\",\n    msgTemplateObjectId: \"\",\n    messageTemplateObjTypeCd: \"ORA_MOO_OPTY\"\n  };\n}\n\nreturn retObj;"
          },
          "outcomes": {
            "success": "1776463026330"
          },
          "code": "PREPARE_EMAIL_CONTENT",
