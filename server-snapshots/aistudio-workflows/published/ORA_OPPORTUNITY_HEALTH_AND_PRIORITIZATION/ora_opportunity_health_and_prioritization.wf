          "code": "GENERATE_SUMMARY",
          "id": "1770659847584",
          "inputs": [
            {
              "id": "1770659847585_1",
              "name": "prompt",
              "type": "string",
              "value": "Provided with the below list of opportunities that are owned and being worked upon by the user, provide a brief, 2 line summary based on the below details with current status and what needs immediate attention.\n\n**Critical** Provide  one consolidated summary in just 2 lines for all the opportunities provided. DO NOT provide summary for each opportunity separately. \nInclude only Opportunities that are in Critical Status. If not opportunities are in High Risk Status, then choose the opportunities with other status.\n\ninput: {{$context.$nodes.COMBINE_THE_PRIORITIZED_OUTPUT.$output.result}}"
            }
          ],
          "type": "LLM"
        },
        {
