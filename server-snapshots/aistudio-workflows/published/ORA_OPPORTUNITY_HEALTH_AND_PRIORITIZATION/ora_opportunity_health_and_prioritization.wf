            "name": "get Recommendation payload",
            "returnType": "object",
            "sourceCode": "let optyDetails = $context.$nodes.GET_OWNED_OPPORTUNITIES.$output??[];\n\nconst objectAltKeys = optyDetails\n  .map((optyDetail) => optyDetail?.OptyNumber)\n  .filter((value) => value !== null && value !== undefined)\n  .map((value) => String(value).trim())\n  .filter((value) => value.length > 0);\n\nreturn {\n  objectType: \"OPPORTUNITY\",\n  objectAltKeys\n};"
          },
