          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_CXOBJECTSEARCHB",
            "functionName": "SEARCH_OBJECTS",
            "name": "Get Owned Opportunities"
          },
          "outcomes": {
            "success": "1770186551591"
          },
          "code": "GET_OWNED_OPPORTUNITIES",
          "convergenceTargetId": "1770555835046",
          "id": "1770186748233",
          "inputs": [
            {
              "id": "1770186771930_1",
              "name": "object",
              "value": "Opportunity"
            },
            {
              "id": "1770186771930_2",
              "name": "q",
              "value": "{\"op\":\"$and\",\"criteria\":[{\"op\":\"$in\",\"attribute\":\"StatusCode\",\"values\":[\"OPEN\"]},{\"op\":\"$or\",\"criteria\":[{\"op\":\"$eq\",\"attribute\":\"RecordSet\",\"value\":\"ORA_MYSUBORDINATESOPTIES\"}]},{\"op\":\"$or\",\"criteria\":[{\"op\":\"$wi\",\"attribute\":\"EffectiveDate\",\"value1\":\"now/q+1q\",\"value2\":\"now/q+2q\"},{\"op\":\"$wi\",\"attribute\":\"EffectiveDate\",\"value1\":\"now/q\",\"value2\":\"now/q+1q\"}]}]}"
            },
            {
              "id": "1770186771931_3",
              "name": "sort",
              "value": "[{\"attribute\":\"EffectiveDate\",\"direction\":\"ascending\"}]",
              "type": "string"
            },
            {
              "id": "1770186771931_4",
              "name": "limit",
              "value": "25",
              "type": "integer"
            },
            {
              "id": "1770186771932_5",
              "name": "fields",
              "value": "[\"OptyId\", \"OptyNumber\"]"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Run in Parallel"
          },
          "outcomes": {
            "0": "1770187563837",
            "1": "1770189068707",
            "2": "1780303098376"
          },
          "code": "PARALLEL_1770186551592",
          "convergenceTargetId": "1770635568573",
          "id": "1770186551591",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "name": "Consolidate Output",
            "returnType": "array",
            "sourceCode": "let items = $context.$nodes.GET_OPPORTUNITY_SUMMARY.$output?.items ??[];\nlet optyDetails = $context.$nodes.GET_OPPORTUNITY_DETAILS.$output ?? [];\nlet recommendationList = $context.$nodes.GET_RECOMMENDATION_FROM_OUTCOME.$output?.items ?? [];\nlet optySummary = [];\nlet retunArray = [];\n// Build optySummary\nitems.forEach(( item) => {\n  let progressionSummary = JSON.parse( item?.payload ?? \"{}\");\n  optySummary.push( {\n    summary: JSON.stringify( progressionSummary?.what?.summary),\n    opportunityId: item.primaryObjectKey\n  });\n});\n// iterate summaries and only include when matching detail exists\noptySummary.forEach(( summaryObj) => {\n  // find corresponding detail  \n  let opty = optyDetails.find(( d) => d?.OptyId == summaryObj?.opportunityId);\n  if( ! opty)\n  return;\n  // no detail => skip entirely\n  \n  let obj = {\n    opportunity: opty,\n    opportunitySummary: summaryObj?.summary,\n    recommendations: []\n  };\n  // add recommendations for this opportunity\n  \n  let recommendationArr = recommendationList.filter(( recom) => recom?.primaryObjectKey == opty?.OptyId);\n  recommendationArr.forEach(( recom) => {\n    let parsedSugg = JSON.parse( recom?.payload ?? \"{}\");\n    let actions = parsedSugg?.next?.actions;\n    obj.recommendations = actions.map(action => ( {\n      type: action?.type ?? \"\",\n      suggestionTitle: action?.label ?? \"\",\n      suggestionTask: action?.description ?? \"\",\n      explainability: action?.explainability ?? \"\"\n    }))\n  });\n  retunArray.push( obj);\n});\nreturn retunArray;"
          },
          "outcomes": {
            "success": "1770653172246"
          },
          "code": "CONSOLIDATE_OUTPUT",
          "id": "1770635568573",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
