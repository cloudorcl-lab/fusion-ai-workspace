            {
              "id": "1772120260253_1",
              "name": "prompt",
              "type": "string",
              "value": "Create a high priority OraInsight action for each item in the array {{$context.$nodes.PREPARE_SUGGESTIONS.$output.result}}.\nFor every row, use the following properties:\n- title: the Title field from the row\n- shortDescription:  <OpprotunityName>: followed by the Task field from the row. Replace <OpprotunityName> with value from attribute Opportunity.Name. Map the opportunityNumber in {{$context.$variables.ListofOpportunities}} \n- actionText: Generate one or two Words which represents an action based on the Title and Task\n- followUpCommand: ora.Invoke(\"invokeSuggestedTask\", {opportunityId: <opportunityId>, opportunityNumber: <opportunityNumber>, task: <Task>, title: <Title>})\nReplace <opportunityId>, <opportunityNumber>, <Title> and <Task> with the respective values from the row.\nOutput the list of actions accordingly."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Generate Opportunity Payload",
            "returnType": "object",
            "sourceCode": "let optyDetails = $context.$nodes.GET_OWNED_OPPORTUNITIES.$output??[]; \nlet optyId = optyDetails.map(opty =>opty.OptyId);\n\nlet payload = {\n    \"limit\": 50,\n    \"offset\": 0,\n    \"sort\": [],\n    \"entity\": \"Opportunity\",\n    \"q\": {\n        \"op\": \"$and\",\n        \"criteria\": [\n            {\n                \"op\": \"$in\",\n                \"attribute\": \"OptyId\",\n                \"values\": optyId\n            }\n        ]\n    },\n    \"fields\": [\n        \"PrCmptPartyId\",\n        \"PrimaryCampaignId.CampaignName\",\n        \"PrimaryCampaignId.CampaignId\",\n        \"PrimaryCampaignId.CampaignNumber\",\n        \"PrimaryRevenue.RevnAmountCurcyCode\",\n        \"ReasonWonLostCode\",\n        \"OptyId\",\n        \"OptyNumber\",\n        \"Owner.PartyId\",\n        \"SalesMethodId\",\n        \"SalesStage.StgOrderEnum\",\n        \"StatusCode\",\n        \"PrConPartyId.PartyId\",\n        \"PrConPartyId.PartyName\",\n        \"CustomerAccount.PartyId\",\n        \"CustomerAccount.PartyUniqueName\",\n        \"EffectiveDate\",\n        \"PrimaryRevenue.RevnAmount\",\n        \"PrimaryRevenue.WinProb\",\n        \"LastUpdatedBy\",\n        \"CreatedBy\",\n        \"CreationDate\",\n        \"LastUpdateDate\",\n        \"Name\",\n        \"CustomerAccount.PartyNumber\",\n        \"ListOfLeads.LeadId.LeadId\",\n        \"ListOfResourcesForTheTeam.OptyResourceId\",\n        \"ListOfResourcesForTheTeam.ResourceId.PartyId\",\n        \"ListOfResourcesForTheTeam.ResourceId.PartyName\",\n        \"ListOfResourcesForTheTeam.ResourceId.PrimaryEmail.EmailAddress\",\n        \"ListOfResourcesForTheTeam.ResourceId.PrimaryPhone.FormattedPhone\",\n        \"ListOfRevenues.Quantity\",\n        \"ListOfRevenues.RevnAmount\",\n        \"ListOfRevenues.RevnAmountCurcyCode\",\n        \"ListOfRevenues.Primary\",\n        \"ListOfRevenues.RevnNumber\",\n        \"ListOfRevenues.ProdGroupId.ProductGroupId\",\n        \"ListOfRevenues.ProdGroupId.Name\",\n        \"ListOfRevenues.CrmCurcyCode\",\n        \"ListOfRevenues.RevnId\",\n        \"ListOfRevenues.UnitPrice\",\n        \"ListOfRevenues.InventoryItemId.InventoryItemId\",\n        \"ListOfRevenues.InventoryItemId.Name\",\n        \"ListOfContacts.OptyConId\",\n        \"ListOfContacts.PerPartyId.PartyId\",\n        \"ListOfContacts.PerPartyId.PartyName\",\n        \"ListOfContacts.PerPartyId.JobTitle\",\n        \"ListOfContacts.PerPartyId.PrimaryEmail.EmailAddress\",\n        \"ListOfContacts.PerPartyId.PrimaryPhone.FormattedPhone\",\n        \"ListOfContacts.PerPartyId.PrimaryAddress.FormattedAddress\",\n        \"ListOfContacts.PerPartyId.DoNotContactFlag\",\n        \"ListOfContacts.RoleCd\"\n    ]\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1770187596259"
          },
