        {
          "metadata": {
            "name": "Prioritize Opportunities",
            "referenceableBlockId": "OPPORTUNITY_PRIORITIZATION_BLOCK"
          },
          "outcomes": {
            "success": "1770659482865"
          },
          "code": "PRIORITIZE_OPPORTUNITIES",
          "id": "1776663707005",
          "inputs": [
            {
              "id": "1776663707005_listOfOpportunities",
              "name": "listOfOpportunities",
              "type": "array",
              "value": "{{$context.$variables.ListofOpportunities}}"
            }
          ],
          "type": "REFERENCE"
        },
        {
          "metadata": {
            "name": "Combine the Prioritized Output",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  \n  let prioritizedOutput = $context.$nodes.PRIORITIZE_OPPORTUNITIES.$output;\n\n  if (typeof prioritizedOutput === \"string\") {\n    try {\n      prioritizedOutput = JSON.parse(prioritizedOutput);\n    } catch (parseError) {\n      prioritizedOutput = [];\n    }\n  }\n\n  if (!Array.isArray(prioritizedOutput)) {\n    prioritizedOutput = [];\n  }\n\n\n  const allOpportunities = $context.$variables.ListofOpportunities || [];\n\n  const opportunityMap = new Map();\n  for (const opp of allOpportunities) {\n    const optyId = opp.opportunity.OptyId;\n    if (optyId !== undefined && optyId !== null) {\n      opportunityMap.set(optyId, opp);\n    }\n  }\n  for (const prioritizedRow of prioritizedOutput) {\n    const oppId = prioritizedRow.opportunityId;\n    const baseOpportunity = opportunityMap.get(oppId);\n    if (baseOpportunity) {\n      const combined = {\n        ...baseOpportunity,\n        priorityTier: prioritizedRow.priorityTier,\n        scoreRationale: prioritizedRow.scoreRationale,\n        priorityScore: prioritizedRow.priorityOrder,\n        recommendedAction: prioritizedRow.recommendedAction\n      };\n      result.push(combined);\n    }\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1779916431531"
          },
          "code": "COMBINE_THE_PRIORITIZED_OUTPUT",
          "id": "1770659482865",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
