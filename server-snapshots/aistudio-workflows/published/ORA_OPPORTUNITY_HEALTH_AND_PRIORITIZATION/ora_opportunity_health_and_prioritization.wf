                {
                  "metadata": {
                    "name": "Refine the top 5 Opportunities",
                    "returnType": "array",
                    "sourceCode": "let result = [];\ntry {\n  const prioritizedOpportunities = $context.$nodes?.PRIORITIZE_OPPORTUNITY?.$output || [];\n  if (Array.isArray(prioritizedOpportunities)) {\n    prioritizedOpportunities.sort((a, b) => (b.priorityOrder || 0) - (a.priorityOrder || 0));\n    result = prioritizedOpportunities.slice(0, 5);\n  } else {\n    result = [];\n  }\n} catch (error) {\n  result = [];\n}\nreturn result;"
                  },
