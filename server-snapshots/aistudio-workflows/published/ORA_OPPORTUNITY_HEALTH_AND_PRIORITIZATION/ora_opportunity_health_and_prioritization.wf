          "id": "1779919922650",
          "inputs": [
            {
              "id": "1779919922650_Outcome_Standard_Parameters",
              "name": "Outcome_Standard_Parameters",
              "value": "{{$context.$nodes.GENERATE_PAYLOAD_FOR_RECOMMENDATIONS.$output.result.standardParameters}}"
            },
            {
              "id": "1779919922650_Outcome_Optional_Parameters",
