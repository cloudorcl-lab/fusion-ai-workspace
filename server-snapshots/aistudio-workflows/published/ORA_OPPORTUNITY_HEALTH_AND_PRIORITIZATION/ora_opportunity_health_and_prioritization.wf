        {
          "metadata": {
            "name": "Prepare Suggestions",
            "returnType": "array",
            "sourceCode": "let result = [];\ntry {\n  // Access the items array safely\n  const recommendationItems = $context.$nodes?.GET_RECOMMENDATIONS?.$output?.items || [];\n\n  // Loop through each recommendation item with index\n  for (let index = 0; index < recommendationItems.length; index++) {\n    const item = recommendationItems[index];\n\n    // Parse the payload JSON string safely\n    const payloadStr = item?.payload;\n    if (!payloadStr) continue;\n\n    let payloadObj;\n    try {\n      payloadObj = JSON.parse(payloadStr);\n    } catch (e) {\n      // Skip this item if payload is not valid JSON\n      continue;\n    }\n\n    const actions = payloadObj?.next?.actions || [];\n\n\n    for (const action of actions) {\n      const title = action?.label || \"\"; \n      const task = action?.description || \"\"; \n      const opportunityId = item?.primaryObjectKey || \"\"; \n      const opportunityNumber = item?.primaryObjectAltKey || \"\"; \n\n      result.push({ opportunityId: opportunityId, opportunityNumber: opportunityNumber, Title: title, Task: task });\n    }\n  }\n} catch (error) {\n  result = [];\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1772120260250"
          },
          "code": "PREPARE_SUGGESTIONS",
