        {
          "metadata": {
            "name": "Build Insight Query",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const oraActionRaw = $context.$app?.$OraAction || \"\";\n  let oraAction = {};\n  try {\n    oraAction = JSON.parse(oraActionRaw);\n  } catch (parseError) {\n    oraAction = {};\n  }\n\n  const opportunityId = oraAction.opportunityId || null;\n  const opportunityNumber = oraAction.opportunityNumber || null;\n  const task = oraAction.task || null;\n  const title = oraAction.title || null;\n\n  result = { opportunityId, opportunityNumber, task, title};\n} catch (error) {\n  result = { opportunityId: null, opportunityNumber: null, task: null, title: null };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776406819312"
          },
          "code": "BUILD_INSIGHT_QUERY",
          "id": "1776406643431",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_CX_SALESFORCE_ENGAGEMENT_INSIGHTS",
            "errorNodeId": "1776407907444",
            "functionName": "engagement_Insights_for_given_sourceObjectrec",
            "name": "Get Insight Data"
          },
          "outcomes": {
            "success": "1776407300532"
          },
          "code": "GET_INSIGHT_DATA",
          "id": "1776406819312",
          "inputs": [
            {
              "id": "1776406819312_sourceObjectId",
              "name": "sourceObjectId",
              "value": "{{$context.$nodes.BUILD_INSIGHT_QUERY.$output.result.opportunityId}}"
            }
          ],
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build Payload for Assistant",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  // Access BUILD_INSIGHT_QUERY output result safely\n  const insightQueryResult = $context.$nodes?.BUILD_INSIGHT_QUERY.$output.result || {};\n\n  // Initialize assistantPayload with required properties\n  const assistantPayload = {\n    opportunityId: insightQueryResult.opportunityId || null,\n    opportunityNumber: insightQueryResult.opportunityNumber || null,\n    task: insightQueryResult.task || null,\n    title: insightQueryResult.title || null\n  };\n\n  // Access GET_INSIGHT_DATA output safely\n  const insightDataOutput = $context.$nodes.GET_INSIGHT_DATA.$output.items || null;\n\n  // Determine if insightDataOutput is array or object\n  let insightRow = null;\n  if (Array.isArray(insightDataOutput)) {\n    insightRow = insightDataOutput.length > 0 ? insightDataOutput[0] : null;\n  } else if (insightDataOutput && typeof insightDataOutput === 'object') {\n    insightRow = insightDataOutput;\n  }\n\n  if (insightRow) {\n    // Extract properties from insightRow\n    assistantPayload.insightId = insightRow.id || null;\n    assistantPayload.insightNumber = insightRow.engagementInsightNumber || null;\n\n    // Parse additionalInsightData JSON string safely\n    let additionalInsightDataObj = {};\n    try {\n      additionalInsightDataObj = insightRow.additionalInsightData ? JSON.parse(insightRow.additionalInsightData) : {};\n    } catch (parseError) {\n      additionalInsightDataObj = {};\n    }\n\n    // Extract salesPlay from additionalInsightData.salesPlays.all\n    assistantPayload.salesPlay = additionalInsightDataObj.salesPlays?.all || null;\n  }\n\n  result = assistantPayload;\n} catch (error) {\n  // In case of error, return empty object\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776407907444"
          },
          "code": "BUILD_PAYLOAD_FOR_ASSISTANT",
          "id": "1776407300532",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
