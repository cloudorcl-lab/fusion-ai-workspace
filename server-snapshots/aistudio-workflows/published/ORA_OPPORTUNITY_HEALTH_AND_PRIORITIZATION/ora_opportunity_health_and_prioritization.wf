{
  "workflowId": "300000326919672",
  "workflowCode": "ORA_OPPORTUNITY_HEALTH_AND_PRIORITIZATION",
  "name": "Opportunity Health and Prioritization Agent",
  "description": "Retrieves the opportunities you or your team owns, ranks them by expected impact, and recommends next actions and communication ideas.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
