{
  "workflowId": "300000331068166",
  "workflowCode": "ORA_TRANSACTION_ASSIGNMENT_CONFLICT_DETECT_WORKFLOW",
  "name": "Transaction Assignment Conflict Detect Workflow",
  "description": "This agent checks if there are any pending transactions for a given name.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
