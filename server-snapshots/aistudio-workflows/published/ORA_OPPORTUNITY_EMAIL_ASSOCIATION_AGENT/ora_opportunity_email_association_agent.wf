                {
                  "metadata": {
                    "name": "Parse attachment metadata",
                    "sourceCode": "const attachmentMetadataResponse = $context.$nodes.FOR_EACH_MESSAGES.GET_EMAIL_ATTACHMENT_METADATA.$output;\nconst items = Array.isArray(attachmentMetadataResponse.items) ? attachmentMetadataResponse.items : [];\n\nconst attachments = items\n  .map((item) => {\n    const attachmentUid = item && item[\"@context\"] ? item[\"@context\"].key : null;\n    const uploadedFileContentType = String(item?.UploadedFileContentType || \"\").toLowerCase().trim();\n\n    if (typeof attachmentUid !== \"string\" || attachmentUid.trim().length === 0) {\n      return null;\n    }\n\n    const isImage = uploadedFileContentType.startsWith(\"image/\");\n\n    return {\n      attachmentUid,\n      isImage\n    };\n  })\n  .filter((entry) => entry !== null);\n\nreturn attachments;",
                    "returnType": "array"
                  },
                  "diagram": {
