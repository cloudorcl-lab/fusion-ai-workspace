{
  "workflowId": "300000331067537",
  "workflowCode": "ORA_OPPORTUNITY_EMAIL_ASSOCIATION_AGENT",
  "name": "Opportunity Email Association Agent",
  "description": "Automatically analyzes inbound email content and context to identify the most relevant CRM opportunity, then associates the email to the correct Opportunity record - keeping the deal timeline complete, reducing manual logging, and improving pipeline accuracy.",
  "specification": {
    "dataPipeline": {
