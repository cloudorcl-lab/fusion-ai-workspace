        {
          "metadata": {
            "name": "Get adaptive payload for opportunity",
            "returnType": "object",
            "sourceCode": "const engagementContext =\n  $context.$triggers.REST.$input.engagementContext || {};\n\nconst accountPartyNumbers = Array.isArray(engagementContext.association?.accounts)\n  ? engagementContext.association.accounts\n      .map(acc => acc?.accountPartyNumber)\n      .filter((num, idx, arr) => typeof num === 'string' && num && arr.indexOf(num) === idx)\n  : [];\n\nconst salesUserEmails = $context.$triggers.REST.$input.engagementContext?.salesUserEmails || [];\n\nconst payload = {\n  \"limit\": 50,\n  \"offset\": 0,\n  \"sort\": [],\n  \"entity\": \"Opportunity\",\n  \"q\": {\n    \"op\": \"$and\",\n    \"criteria\": [\n      {\n        \"op\": \"$in\",\n        \"attribute\": \"StatusCode\",\n        \"values\": [\"OPEN\"]\n      },\n      {\n        \"op\": \"$in\",\n        \"attribute\": \"CustomerAccount.PartyNumber\",\n        \"values\": accountPartyNumbers \n      },\n      {\n        \"op\": \"$in\",\n        \"attribute\": \"ListOfResourcesForTheTeam.ResourceId.ResourceEmailAddress\",\n        \"values\": salesUserEmails \n      }\n    ]\n  },\n  \"fields\": [\"OptyId\", \"OptyNumber\", \"Name\", \"CustomerAccount.PartyId\"]\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1774353464929"
          },
          "diagram": {
            "x": 5258,
            "y": 5206
          },
          "code": "GET_ADAPTIVE_PAYLOAD_FOR_OPPORTUNITY",
          "convergenceTargetId": "1774352693068",
          "id": "1774353199800",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
