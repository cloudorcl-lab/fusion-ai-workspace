        {
          "metadata": {
            "name": "Get payload for opportunity summary",
            "returnType": "object",
            "sourceCode": "const items = Array.isArray($context.$nodes.GET_OPPORTUNITIES.$output)\n  ? $context.$nodes.GET_OPPORTUNITIES.$output\n  : [];\n\nconst objectAltKeys = items\n  .map(item => item?.OptyNumber)\n  .filter(num => typeof num === 'string' && num.trim().length > 0);\n\nconst payload = {\n  outcomeStandardParameters: {\n    objectType: 'OPPORTUNITY',\n    objectAltKeys\n  },\n  outcomeOptionalParameters:\n    \"outcomeReferences[primaryRef='Y'] and outcomeType = 'SUMMARY' and outcomeSubtype = 'STATE_SUMMARY' and category = 'ENGAGEMENT'\"\n};\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1775189249598"
          },
          "diagram": {
            "x": 5525,
            "y": 5872
          },
          "code": "GET_PAYLOAD_FOR_OPPORTUNITY_SUMMARY",
          "id": "1775197150675",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get content to match"
          },
          "outcomes": {
            "0": "1775191685788",
            "1": "1775191685790"
          },
          "diagram": {
            "x": 5049,
            "y": 6094,
            "width": 802,
            "height": 3342
          },
          "code": "GET_CONTENT_TO_MATCH",
          "convergenceTargetId": "1774354083760",
          "id": "1775189249598",
          "inputs": [],
          "type": "PARALLEL"
        },
        {
          "metadata": {
            "name": "Build LLM input for opportunity matching",
            "returnType": "object",
            "sourceCode": "const outcomes = Array.isArray($context.$nodes.GET_ENGAGEMENT_INSIGHTS.$output?.items)\n  ? $context.$nodes.GET_ENGAGEMENT_INSIGHTS.$output.items\n  : [];\n\nconst sourceOpportunities = Array.isArray($context.$nodes.GET_OPPORTUNITIES.$output)\n  ? $context.$nodes.GET_OPPORTUNITIES.$output\n  : [];\n\nconst opportunities = outcomes.map(item => {\n  const matchedOpportunity = sourceOpportunities.find(\n    opportunity => opportunity?.OptyNumber === item?.primaryObjectAltKey\n  );\n\n  let payload = {};\n\n  try {\n    payload = JSON.parse(item.payload || '{}');\n  } catch (e) {\n    payload = {};\n  }\n\n  return {\n    optyId: matchedOpportunity?.OptyId ?? null,\n    optyNumber: item.primaryObjectAltKey ?? null,\n    optyName: matchedOpportunity?.Name ?? matchedOpportunity?.OptyName ?? 'Unknown',\n    summary: payload?.what?.summary ?? ''\n  };\n});\n\nconst attachmentSummaries = Array.isArray($context.$variables.attachmentSummaries)\n  ? $context.$variables.attachmentSummaries\n  : [];\n\nconst llmInput = {\n  emailContent: $context.$nodes.NORMALIZE_EMAIL_HTML.$output.result ?? '',\n  attachmentSummaries,\n  opportunities\n};\n\nreturn llmInput;"
          },
          "outcomes": {
            "success": "1776327329073"
          },
          "diagram": {
            "x": 5240,
            "y": 9586
          },
          "code": "BUILD_LLM_INPUT_FOR_OPPORTUNITY_MATCHING",
          "id": "1774354083760",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
