    "triggers": [
      {
        "type": "REST",
        "inputs": [
          {
            "id": "1774976938880",
            "name": "engagementContext",
            "scope": "JOB",
            "type": "object",
            "typeSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"EngagementContext\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"conversationId\": {\n      \"type\": [\"integer\", \"null\"],\n      \"description\": \"CRM conversation identifier.\"\n    },\n    \"conversationNumber\": {\n      \"type\": \"string\",\n      \"description\": \"Readable conversation number.\",\n      \"default\": \"\"\n    },\n    \"association\": {\n      \"type\": \"object\",\n      \"description\": \"Current linkage flags plus referenced accounts.\",\n      \"properties\": {\n        \"isAssociated\": { \"type\": \"boolean\", \"default\": false },\n        \"isAcntAssociated\": { \"type\": \"boolean\", \"default\": false },\n        \"isOptyAssociated\": { \"type\": \"boolean\", \"default\": false },\n        \"accounts\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"accountPartyId\": { \"type\": [\"integer\", \"null\"] },\n              \"accountPartyNumber\": { \"type\": \"string\" }\n            },\n            \"required\": [\"accountPartyNumber\"],\n            \"additionalProperties\": false\n          },\n          \"default\": []\n        }\n      },\n      \"additionalProperties\": false,\n      \"default\": {}\n    },\n    \"recentMessage\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Most recent conversation message metadata.\",\n      \"properties\": {\n        \"messageId\": { \"type\": [\"integer\", \"string\", \"null\"] },\n        \"messageNumber\": { \"type\": \"string\" },\n        \"messageTitle\": { \"type\": \"string\", \"default\": \"\" },\n        \"direction\": { \"type\": \"string\", \"description\": \"Raw MessageTypeCd value.\" },\n        \"senderEmail\": { \"type\": \"string\", \"default\": \"\" },\n        \"sentDate\": { \"type\": [\"string\", \"null\"], \"description\": \"ISO timestamp.\" }\n      },\n      \"required\": [\"messageNumber\", \"direction\", \"senderEmail\"],\n      \"additionalProperties\": false\n    },\n    \"messageChain\": {\n      \"type\": \"array\",\n      \"description\": \"All messages in the conversation thread, ordered by CreationDate asc.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"messageId\": { \"type\": [\"integer\", \"string\", \"null\"] },\n          \"messageNumber\": { \"type\": \"string\", \"default\": \"\" }\n        },\n        \"required\": [\"messageNumber\"],\n        \"additionalProperties\": false\n      },\n      \"default\": []\n    },\n    \"customerContactEmails\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"default\": []\n    },\n    \"salesUserEmails\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\" },\n      \"default\": []\n    }\n  },\n  \"required\": [\n    \"association\",\n    \"messageChain\",\n    \"customerContactEmails\",\n    \"salesUserEmails\"\n  ],\n  \"additionalProperties\": false\n}"
          }
        ]
      }
