        {
          "metadata": {
            "description": "Normalize Email HTML To Plain Text",
            "name": "Normalize Email HTML",
            "returnType": "string",
            "sourceCode": "// Email body HTML\nconst inputHtmlString = $context.$nodes.GET_AN_EMAIL_MESSAGE_CONTENT.$output || \"\";\n\n// Subject from recent message\nconst inputSubject =\n  $context.$triggers.REST.$input.engagementContext.recentMessage.messageTitle || \"\";\n\n// Remove non-content blocks\nlet outputPlainTextString = inputHtmlString\n  .replace(/<!--[\\s\\S]*?-->/g, \" \")\n  .replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n  .replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n  .replace(/<meta\\b[^>]*\\/?>/gi, \" \")\n  .replace(/<link\\b[^>]*\\/?>/gi, \" \")\n  .replace(/<xml\\b[^>]*>[\\s\\S]*?<\\/xml>/gi, \" \")\n  .replace(/<o:p\\b[^>]*>[\\s\\S]*?<\\/o:p>/gi, \" \");\n\n// Preserve structure as readable text\noutputPlainTextString = outputPlainTextString\n  .replace(/<\\s*br\\s*\\/?\\s*>/gi, \"\\n\")\n  .replace(/<\\s*hr\\b[^>]*\\/?\\s*>/gi, \"\\n----------------------------------------\\n\")\n  .replace(/<\\s*\\/\\s*(p|div|tr|li|h1|h2|h3|h4|h5|h6)\\s*>/gi, \"\\n\")\n  .replace(/<\\s*\\/\\s*td\\s*>/gi, \"\\t\");\n\n// Remove common HTML tags (explicit list only)\noutputPlainTextString = outputPlainTextString\n  .replace(/<\\s*\\/?\\s*(html|head|body|title|section|article|main|header|footer|aside|nav)\\b[^>]*>/gi, \" \")\n  .replace(/<\\s*\\/?\\s*(p|div|span|pre|code|blockquote|strong|b|em|i|u|small|sup|sub)\\b[^>]*>/gi, \" \")\n  .replace(/<\\s*\\/?\\s*(table|thead|tbody|tfoot|tr|td|th|ul|ol|li|dl|dt|dd)\\b[^>]*>/gi, \" \")\n  .replace(/<\\s*\\/?\\s*font\\b[^>]*>/gi, \" \");\n\n// Decode HTML entities\noutputPlainTextString = outputPlainTextString\n  .replace(/&nbsp;/gi, \" \")\n  .replace(/&amp;/gi, \"&\")\n  .replace(/&lt;/gi, \"<\")\n  .replace(/&gt;/gi, \">\")\n  .replace(/&quot;/gi, '\"')\n  .replace(/&#39;/gi, \"'\");\n\n// Normalize whitespace\noutputPlainTextString = outputPlainTextString\n  .replace(/[ \\t]+\\n/g, \"\\n\")\n  .replace(/\\n[ \\t]+/g, \"\\n\")\n  .replace(/[ \\t]{2,}/g, \" \")\n  .replace(/\\n{3,}/g, \"\\n\\n\")\n  .trim();\n\n// Prepend Subject\nconst subject = String(inputSubject).trim();\n\nif (subject) {\n  outputPlainTextString = `Subject: ${subject}\\n\\n${outputPlainTextString}`;\n}\n\n// String output\nreturn outputPlainTextString;"
          },
          "outcomes": {
            "success": "1775724260660"
          },
          "diagram": {
            "x": 5300,
            "y": 6557
          },
          "code": "NORMALIZE_EMAIL_HTML",
