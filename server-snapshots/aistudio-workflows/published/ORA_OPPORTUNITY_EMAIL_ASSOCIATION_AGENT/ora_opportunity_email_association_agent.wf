        {
          "metadata": {
            "name": "Build association result",
            "returnType": "object",
            "sourceCode": "const { conversationId, conversationNumber } =\n  $context.$triggers.REST.$input.engagementContext || {};\n\nconst STRONG_MATCH_THRESHOLD = 7;\n\nconst llmMatchScores = Array.isArray($context.$nodes.MATCH_EMAIL_WITH_OPPORTUNITIES.$output)\n  ? $context.$nodes.MATCH_EMAIL_WITH_OPPORTUNITIES.$output\n  : [];\n\nconst normalizeScore = value => {\n  const parsed = Number(value);\n  if (Number.isNaN(parsed)) {\n    return 0;\n  }\n\n  return Math.max(0, Math.min(10, Math.round(parsed)));\n};\n\nconst strongMatches = llmMatchScores\n  .filter(match => match?.optyId !== undefined && match.optyId !== null)\n  .map(match => ({\n    optyId: String(match.optyId),\n    score: normalizeScore(match.score)\n  }))\n  .filter(match => match.optyId.trim() !== '' && match.score >= STRONG_MATCH_THRESHOLD)\n  .sort((a, b) => b.score - a.score);\n\nconst opportunitiesList = strongMatches.map(match => ({\n  id: match.optyId\n}));\n\nconst matchType = opportunitiesList.length > 0 ? 'strong' : 'none';\nconst matchScope =\n  opportunitiesList.length === 0\n    ? 'none'\n    : opportunitiesList.length === 1\n      ? 'single'\n      : 'multiple';\n\nconst conversationAssociation = {\n  type: 'email',\n  matchType,\n  matchScope,\n  conversationId,\n  conversationNumber,\n  opportunities: opportunitiesList\n};\n\nreturn {\n  llmMatchScores,\n  conversationAssociation\n};"
          },
          "outcomes": {
            "success": "1775135415055"
          },
          "diagram": {
            "x": 5300,
            "y": 10252
          },
          "code": "BUILD_ASSOCIATION_RESULT",
          "id": "1776001000002",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
