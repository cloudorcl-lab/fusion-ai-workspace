(token === '}') {\n          const objectIndex = findNearestObjectAfterValue();\n\n          if (objectIndex !== -1) {\n            while (stack.length - 1 > objectIndex) {\n              fixedTokens.push(stack.pop().type === 'object' ? '}' : ']');\n            }\n\n            fixedTokens.push('}');\n            stack.pop();\n\n            if (stack.length) {\n              stack[stack.length - 1].state = 'after_value';\n            }\n\n            shouldReprocess = true;\n            continue;\n          }\n\n          fixedTokens.push(']');\n          stack.pop();\n\n          if (stack.length) {\n            stack[stack.length - 1].state = 'after_value';\n            }\n\n          shouldReprocess = true;\n        } else if (token !== ':') {\n          fixedTokens.push(',');\n          context.state = 'value_or_end';\n          shouldReprocess = true;\n        }\n      }\n    }\n  }\n\n  match = tokenPattern.exec(repairedInput);\n}\n\nwhile (stack.length > 0) {\n  fixedTokens.push(stack.pop().type === 'object' ? '}' : ']');\n}\n\nlet fixedJson = fixedTokens.join('');\nlet parsedJson;\nlet parseError;\n\nconst normalizeReversedStringPairs = (jsonText) => {\n  let normalized = jsonText;\n  let previous = null;\n\n  while (normalized !== previous) {\n    previous = normalized;\n    normalized = normalized.replace(\n      /\\{:\"((?:\\\\.|[^\"\\\\])*)\",\"((?:\\\\.|[^\"\\\\])*)\":/g,\n      '{\"$1\":\"$2\",',\n    );\n    normalized = normalized.replace(\n      /,\"((?:\\\\.|[^\"\\\\])*)\",\"((?:\\\\.|[^\"\\\\])*)\":/g,\n      ',\"$1\":\"$2\",',\n    );\n  }\n\n  return normalized;\n};\n\nfixedJson = normalizeReversedStringPairs(fixedJson);\nfixedJson = fixedJson.replace(\n  /,\"((?:\\\\.|[^\"\\\\])*)\",\\[:\\{/g,\n  ',\"$1\":[{',\n);\nfixedJson = fixedJson.replace(\n  /(\"properties\":\\{\\})(\\])/g,\n  '$1}$2',\n);\nfixedJson = fixedJson.replaceAll(\n  '\"properties\":{}]',\n  '\"properties\":{}}]',\n);\nfixedJson = fixedJson.replace(\n  /\\}\\}\\](?=,\"(?:node_t