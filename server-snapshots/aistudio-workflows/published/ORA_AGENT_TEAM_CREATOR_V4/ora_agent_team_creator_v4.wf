          "metadata": {
            "errorNodeId": "1774565013028",
            "name": "throw if plan changes",
            "returnType": "object",
            "sourceCode": "if ($context.$variables.retries < $context.$variables.maxRetries) {\n  if ( $context.$nodes.PLAN.$output.result.planChanges && $context.$nodes.PLAN.$output.result.planChanges.length) {\n    throw new Error('err');\n  }\n}"
          },
          "outcomes": {
            "success": "1770410123259"
          },
          "code": "THROW_2",
          "id": "1775172452078",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check For Invalid Input/Outputs",
            "returnType": "object",
            "sourceCode": "let plan = $context.$nodes.PARSE_PLAN.$output.result.plan;\nif ($context.$nodes.PARSE_PLAN.$output.result.incorrectJson) {\n  plan = $context.$nodes.PARSE_FIXED_JSON.$output.result ;\n}\nlet nodesToParse = [];\n\nif (!plan || !plan.nodes) {\n  throw new Error('Invalid plan');\n}\n\nfor (let node of plan.nodes) {\n  nodesToParse.push(node);\n}\nlet invalidInputOutput = false;\nconst invalid = [];\nconst nodeToCodes = {};\nconst nodesToCheck = [];\n\nwhile (nodesToParse.length) {\n  const node = nodesToParse.shift();\n  if (!node || typeof node === 'string' || !node.node_type) {\n    continue;\n  }\n  nodesToCheck.push({node_type: node.node_type, code: node.code, inputs: node.inputs, outputs: node.outputs});\n  nodeToCodes[node.code] = node;\n  const characteristic = node.characteristic;\n  if (node.inputs) {\n    for (const item of node.inputs) {\n      if (item.source === 'node') {\n        if (item.code && nodeToCodes[item.code] && nodeToCodes[item.code].outputs) {\n          let found;\n          const outputNode = nodeToCodes[item.code];\n          const isHa = outputNode.node_type === $context.$variables.nodeTypes.HA;\n          for (const nodeOutput of nodeToCodes[item.code].outputs) {\n            if (isHa) {\n              found = nodeOutput;\n              break;\n            }\n            if (nodeOutput.name === 'restResults' && item.name  === 'restResults.items') {\n              found = nodeOutput;\n              break;\n            }\n            if (nodeOutput.name === item.name || nodeOutput.name === item.outputName) {\n              found = nodeOutput;\n              if (item.value && nodeOutput.name !== item.name) {\n                item.source = 'combination';\n                const splitVal = item.value.split('.');\n                const lastInput = splitVal[splitVal.length - 1];\n                if (nodeOutput && nodeOutput.properties && nodeOutput.properties[lastInput] && nodeOutput.properties[lastInput].type) {\n                  item.type = nodeOutput.properties[lastInput].type;\n                }\n              }\n              break;\n            }\n            if (nodeToCodes[item.code].is_collection && nodeOutput.properties) {\n              for (const [childName, child] of Object.entries(nodeOutput.properties)) {\n                if (typeof child === 'object' && childName == 'items' && child.properties) {\n                  for (const [innerChildName, innerChild] of Object.entries(child.properties)) {\n                    if (innerChildName === item.name || innerChildName === item.outputName) {\n                      // Change this the output to match the input \n                      found = nodeOutput;\n                      item.source = 'combination';\n                      if (innerChild.type) {\n                        item.type = innerChild.type\n                      }\n                      item.value = `node.${outputNode.code}.items[0].${innerChildName}`;\n                      break;\n                    }\n                  }\n                } else {\n                  if (childName === item.name || (item.outputName && (childName === item.outputName || childName === `items.${item.outputName}`))) { \n                    found = nodeOutput;\n                    item.source = 'combination';\n                    if (child.type) {\n                      item.type = child.type\n                    }\n                    item.value = `node.${outputNode.code}.items[0].${childName}`;\n                    break;\n                  }\n                }\n              }\n            }\n          }\n          if (!found) {\n            invalidInputOutput = true;\n            invalid.push(item);\n          }\n        } else {\n          invalidInputOutput = true;\n          invalid.push(item);\n        }\n      }\n    }\n  }\n  \n  if (node.node_type === $context.$variables.nodeTypes.SWITCH || node.node_type === $context.$variables.nodeTypes.PARALLEL) {\n    for (const childIndex of Object.keys(node.characteristic)) {\n      const children = node.characteristic[childIndex] ? (node.characteristic[childIndex].nodes ? node.characteristic[childIndex].nodes : node.characteristic[childIndex]) : [];\n      for (const innerNode of children) {\n        nodesToParse.push(innerNode);\n      }\n    }\n  } else if (node.node_type === $context.$variables.nodeTypes.LOOP || node.node_type === $context.$variables.nodeTypes.WHILE) {\n    const children = characteristic && characteristic.nodes ? characteristic.nodes : characteristic;\n    for (const innerNode of children) {\n      nodesToParse.push(innerNode);\n    }\n  } else  if (node.node_type === $context.$variables.nodeTypes.IF) {\n    if (characteristic && characteristic.true) {\n      const trueChildren =  characteristic.true &&  characteristic.true.nodes ? characteristic.true.nodes  :  characteristic.true;\n      for (const innerNode of trueChildren) {\n        nodesToParse.push(innerNode);\n      }\n    }\n    if (characteristic && characteristic.false) {\n      const falseChildren =  characteristic.false &&  characteristic.false.nodes ? characteristic.false.nodes  :  characteristic.false;\n      for (const innerNode of falseChildren) {\n        nodesToParse.push(innerNode);\n      }\n    }\n  }\n}\n\nconst ret = {invalidInputOutput, invalid, nodesToCheck, plan};\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1775587650224"
          },
          "code": "CHECK_FOR_INVALID_INPUTOUTPUTS",
          "id": "1775586854329",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
