        {
          "metadata": {
            "name": "Make Changes after Find choice",
            "returnType": "object",
            "sourceCode": "let nodeIndex = $context.$variables.nodeIndex || 0;\nconst plan = $context.$variables.plan ;\nconst planChanges = $context.$variables.planChanges ;\nlet retryPlan = false;\nconst choiceFeedback = $context.$variables.choiceFeedback;\nif (choiceFeedback.length) {\n  const feedbackToCode = {};\n  for (const choice of choiceFeedback) {\n    feedbackToCode[choice.code] = choice;\n  }\n  const processNodes = [...plan.nodes];\n  while (processNodes.length) {\n    const node = processNodes.shift();\n    const feedback =  feedbackToCode[node.code] ? feedbackToCode[node.code].feedback : null;\n    if (feedback) {\n      if (node.node_type == $context.$variables.nodeTypes.EMAIL) {\n        node.email = feedback;\n        planChanges.push(`For node with code ${node.code}, set email to ${feedback}`);\n        node.characteristic.toList = feedback;\n        if (node.inputs) {\n          for (const input of node.inputs) {\n            if (input.name === 'to' || input.name === 'toList') {\n              input.value = feedback;\n              input.source = 'static';\n            }\n          }\n        }\n      } else if (node.ragTool) {\n        if (feedback.toLowerCase() == 'none') {\n          node.ragTool= {}; \n          planChanges.push(`For node with code ${node.code}, leave rag tool blank`);\n        } else {\n          let newTool;\n          for (const aTool of node.ragTool.alternatives) {\n            if (aTool.ToolCode && aTool.ToolCode.toLowerCase() == feedback.toLowerCase()) {\n              newTool = aTool;\n            }\n          }\n          if (newTool) {\n            node.ragTool = newTool;\n            planChanges.push(`For node with code ${node.code}, use rag tool with ToolCode ${newTool.ToolCode}`);\n          } else {\n            retryPlan = true;\n            planChanges.push(`For node with code ${node.code}, make these changes: ${feedback}`)\n          }\n        }\n      }\n    }\n    if (node.true) {\n      processNodes.push(...node.true);\n    }\n    if (node.false) {\n      processNodes.push(...node.false);\n    }\n    if (node.children) {\n      processNodes.push(...node.children);\n    }\n    if (node.childrenObject) {\n      for (const childrenIndex of Object.keys(node.childrenObject)) {\n        const children = node.childrenObject[childrenIndex];\n        processNodes.push(...children);\n      }\n    }\n  }\n}\n\nconst ret = {plan, planChanges, retryPlan};\nreturn ret;"
          },
          "outcomes": {
            "success": "1776477210561"
          },
