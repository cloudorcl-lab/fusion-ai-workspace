                    "name": "ToolForRet",
                    "returnType": "object",
                    "sourceCode": "let tool = null;\nif ($context.$nodes.FOREACH_RAG.TOOL.$output && $context.$nodes.FOREACH_RAG.TOOL.$output.items && $context.$nodes.FOREACH_RAG.TOOL.$output.items.length) {\n  let mainTool;\n  for (const innerTool of $context.$nodes.FOREACH_RAG.TOOL.$output.items) {\n    if (innerTool.ToolCode === $context.$nodes.FOREACH_RAG.MATCH_RAG_TOOLS.$output.ToolCode) {\n      mainTool = innerTool;\n    }\n  }\n  tool = mainTool || $context.$nodes.FOREACH_RAG.TOOL.$output.items[0];\n  tool._suggested = $context.$nodes.FOREACH_RAG.MATCH_RAG_TOOLS.$output ;\n  tool.alternatives = [];\n  for (const innerTool of $context.$nodes.FOREACH_RAG.TOOL.$output.items) {\n    if (innerTool.ToolCode != $context.$nodes.FOREACH_RAG.MATCH_RAG_TOOLS.$output.ToolCode) {\n      tool.alternatives.push({ToolCode: innerTool.ToolCode, Name: innerTool.Name, Description: innerTool.Description});\n    }\n  }\n  delete tool[\"@context\"];\n}\nreturn tool;"
                  },
                  "outcomes": {
                    "success": "end_1770157646333"
                  },
