        {
          "metadata": {
            "name": "findBoDesc",
            "returnType": "object",
            "sourceCode": "const plan = $context.$variables.plan ;\nconst flattenedNodes = $context.$nodes.PARSE_NODES_2.$output.result.flattenedNodes;\n\nconst externalRestTools = $context.$variables.externalRestTools || [];\nconst minBusinessObjectFunctions = $context.$variables.minBusinessObjectFunctionsAll || {};\n\nconst externalRestToolsByFunctionToolCode = {};\n\nif (externalRestTools) {\n  for (const externalRestToolFunction of externalRestTools) {\n    if (externalRestToolFunction) {\n      externalRestToolsByFunctionToolCode[externalRestToolFunction.FunctionName +  ':' + externalRestToolFunction.ToolCode] = externalRestToolFunction;\n    }\n  }\n}\n\nconst boNodesForKB = [];\nconst boNodesForKBExisting = [];\nconst ragNodes = [];\nconst invalidNodeTypes = [];\nconst validNodeTypes = Object.values($context.$variables.nodeTypes);\n\nlet nodeCount = 0;\nlet hasExisting = false;\nfor (const node of flattenedNodes) {\n  if (validNodeTypes.indexOf(node.node_type) === -1) {\n    invalidNodeTypes.push(node);\n  } else {\n    nodeCount++;\n  }\n  if (node.node_type == $context.$variables.nodeTypes.BOF || node.node_type == $context.$variables.nodeTypes.ETOOL) {\n    let characteristic = node.characteristic;\n    const boNode = {\n      characteristic,\n      inputs: node.inputs, \n      outputs: node.outputs, \n      code: node.code,\n      businessObjectFunctionName: node.businessObjectFunctionName,\n      businessObjectObjectCode: node.businessObjectObjectCode,\n      ToolCode: node.ToolCode,\n      toolFunctionName: node.toolFunctionName,\n      excludeBusinessObjectFunction: node.excludeBusinessObjectFunction,\n    };\n\n    if (node.businessObjectFunctionName && node.businessObjectObjectCode && minBusinessObjectFunctions[node.businessObjectObjectCode +  ':' + node.businessObjectFunctionName]) {\n      boNode.kbBo = minBusinessObjectFunctions[node.businessObjectObjectCode +  ':' + node.businessObjectFunctionName];\n      boNodesForKBExisting.push(boNode);\n    } else if (node.ToolCode && node.FunctionName && externalRestToolsByFunctionToolCode[node.FunctionName +  ':' + node.ToolCode]) {\n      boNode.externalRestTool = externalRestToolsByFunctionToolCode[node.FunctionName +  ':' + node.ToolCode];\n      boNodesForKBExisting.push(boNode);\n    } else {\n      boNodesForKB.push(boNode);\n    }\n  } \n  if (node.node_type == $context.$variables.nodeTypes.RAG) { \n    if (node.characteristic && node.characteristic.tool) {\n      ragNodes.push(node.characteristic.tool);\n    } else if (typeof node.characteristic === 'string') {\n      ragNodes.push(node.characteristic);\n    }\n  } \n}\nconst bofsForAllMatching = boNodesForKBExisting.length && boNodesForKB.length ?  $context.$variables.minBusinessObjectFunctionsAllString : \"\"  ;\nconst minBusinessObjectFunctionsLength = Object.values(minBusinessObjectFunctions).length;\nconst ret = {ragNodes, invalidNodes: invalidNodeTypes.length > 0, invalidNodeTypes, boNodesForKBExisting, boNodesForKB, bofsForAllMatching};\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1767830039437"
          },
          "code": "FINDBODESC",
          "id": "1767829968618",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1774565013028",
            "name": "Retry if no nodes",
            "returnType": "string",
            "sourceCode": "if ($context.$nodes.FINDBODESC.$output.result.invalidNodes ||  !$context.$variables.plan.nodes.length) {\n  throw new Error('retry');\n}\nconst str = \"\";\nstr;"
          },
          "outcomes": {
            "success": "1770237608614"
          },
          "code": "RETRY_IF_NO_NODES",
          "id": "1767830039437",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767831677478",
            "name": "plan",
            "returnType": "object",
            "sourceCode": "const businessObjects = {};\nconst minBusinessObjectFunctions = $context.$variables.minBusinessObjectFunctions || {};\nconst minBusinessObjectFunctionsAll = $context.$variables.minBusinessObjectFunctionsAll|| {};\nlet minBusinessObjectFunctionsAllString = '';\nlet minBusinessObjectFunctionsString = '';\nconst existingBusinessObjectFunctions = $context.$variables.businessObjectFunctions ;\nconst businessObjectFunctions = []\nlet businessObjectFunctionsByCode = {};\nconst codeTokbNode = {};\nconst ragToolsByCharateristics = {};\nconst planChanges = [];\nconst minExternalRestToolsSelected = {};\nconst minExternalRestTools = $context.$variables.minExternalRestTools ;\n\n\nconst existingBoNodes =  $context.$nodes.PROCESS_EXISTING_MATCHES.$output ? $context.$nodes.PROCESS_EXISTING_MATCHES.$output.result.nodes : [];\n\nif ($context.$nodes.FINDBODESC.$output.result.boNodesForKBExisting.length > 0) {\n  for (const kbNode of existingBoNodes) {\n    codeTokbNode[kbNode.code] = kbNode;\n  }\n}\nlet kbOutput;\nif ($context.$nodes.FINDBODESC.$output.result.boNodesForKB.length > 0 && $context.$nodes.KNOWLEDGE_BASE_BOF.$output && $context.$nodes.KNOWLEDGE_BASE_BOF.$output.output) {\n  try {\n    kbOutput = JSON.parse($context.$nodes.KNOWLEDGE_BASE_BOF.$output.output);\n  } catch {}\n  if (kbOutput && kbOutput.nodes) {\n    for (const kbNode of kbOutput.nodes) {\n      codeTokbNode[kbNode.code] = kbNode;\n      if (kbNode.parametersMapping) {\n        if (kbNode.businessObjectFunction) {\n          kbNode.businessObjectFunction.parametersMapping = kbNode.parametersMapping;\n        } else if (kbNode.externalRestTool) {\n          kbNode.externalRestTool.parametersMapping = kbNode.parametersMapping;\n        }\n        delete kbNode.parametersMapping;\n      }\n    }\n  }\n  if (kbOutput && kbOutput.boFunctions) {\n    businessObjectFunctionsByCode = kbOutput.boFunctions;\n  }\n  if (kbOutput && kbOutput.suggestions) {\n     planChanges.push(...kbOutput.suggestions);\n  }\n}\nif (existingBusinessObjectFunctions) {\n  for (const boFunction of existingBusinessObjectFunctions) {\n    businessObjectFunctionsByCode[boFunction.MatchKey] = boFunction;\n  }\n}\nbusinessObjectFunctions.push(...Object.values(businessObjectFunctionsByCode));\nconst clonedBusinessObjectFunctions = JSON.parse(JSON.stringify(businessObjectFunctions));\nfor (const boFunction of clonedBusinessObjectFunctions) {\n\n  minBusinessObjectFunctionsAll[boFunction.MatchKey] = boFunction;\n  let boString = `${boFunction.BusinessObjectCode}/${boFunction.FunctionName}/${boFunction.BusinessObjectDescription}/${boFunction.FunctionDescription}`\n  if (boFunction.InputParmeters && boFunction.InputParmeters.length) {\n    boString += `InputParmeters:`;\n    for (const param of boFunction.InputParmeters) {\n      delete param.Sources;\n      boString += `${param.Name},${param.DataType}/`;\n    }\n  }\n  if (boFunction.OutputAttributes && boFunction.OutputAttributes.length) {\n    boString += `OutputAttributes:`;\n    for (const param of boFunction.OutputAttributes) {\n      delete param.Sources;\n      boString += `${param.Name},${param.DataType}/`;\n    }\n  }\n  boString += '::';\n  minBusinessObjectFunctionsAllString += boString;\n  businessObjectFunctionsByCode[boFunction.MatchKey].boString = boString;\n}\n\nconst ragInputs = $context.$nodes.FINDBODESC.$output.result.ragNodes;\nconst ragOutput = $context.$nodes.FOREACH_RAG.$output;\nif (ragInputs && ragOutput) {\n  for (const index in ragOutput) {\n    const ragOut = ragOutput[index];\n    \n    let res;\n    try {\n      res = ragOut ?  JSON.parse(ragOut)  : {};\n    } catch {}\n    if (res && res.result) {\n      const characteristic = ragInputs[index]; \n      ragToolsByCharateristics[characteristic] = res.result;\n    } \n  }\n}\n\nconst plan = $context.$variables.plan;\n\nlet previousNode = null;\n\nlet nodesToProces = [];\nfor (const node of plan.nodes) {\n  nodesToProces.push({node, parent: plan.nodes});\n}\nconst codeToNode = {};\nwhile (nodesToProces.length) {\n  const nodeWrapper = nodesToProces.shift();\n  const node = nodeWrapper.node;\n  const parent = nodeWrapper.parent;\n  codeToNode[node.code] = node;\n  if (node.node_type == $context.$variables.nodeTypes.EMAIL && previousNode && previousNode.node_type === $context.$variables.nodeTypes.LLM) {\n    previousNode.isForHaOrEmail = true; \n  }\n  const wasBof = node.node_type == $context.$variables.nodeTypes.BOF;\n  if (node.node_type == $context.$variables.nodeTypes.BOF || node.node_type == $context.$variables.nodeTypes.ETOOL) {\n    const boNode = codeTokbNode[node.code];\n    const businessObjectFunction = boNode ? boNode.businessObjectFunction : null;\n    if (businessObjectFunction) { \n      node.businessObjectFunction = businessObjectFunction;\n    }\n    let parameters;\n    let restObj;\n    if (node.businessObjectFunction) {\n      const matchKey = node.businessObjectFunction.BusinessObjectCode + ':' + node.businessObjectFunction.FunctionName;\n      if (businessObjectFunctionsByCode[matchKey]) {\n        minBusinessObjectFunctionsString += businessObjectFunctionsByCode[matchKey].boString;\n        minBusinessObjectFunctions[matchKey] = businessObjectFunctionsByCode[matchKey];\n      }\n    }\n    if (boNode && boNode.externalRestTool) {\n      node.node_type = $context.$variables.nodeTypes.ETOOL;\n      node.externalRestTool = boNode.externalRestTool;\n      parameters = [];\n      for (const param of node.externalRestTool.parameterDefinitions) {\n        parameters.push({name: param.name, type: param.dataType});\n      }\n      restObj = node.externalRestTool;\n    } else if (!node.businessObjectFunction) {\n      if ( $context.$variables.retries  > 1) {\n        planChanges.push(`For node with code ${node.code}, no relavent business object was found. Please create the plan without that ${node.code} or calling a similar Business Object Function. `)\n      } else {\n        planChanges.push(`For node with code ${node.code}, no relavent business object was found. Please create the plan without ${node.code}. `)\n      }\n    } else if (node.is_collection && node.businessObjectFunction.OutputType && node.businessObjectFunction.OutputType === 'OBJECT') {\n      planChanges.push(`For node with code ${node.code}, the request was for a business function that is a collection. However, there is only a business function that fetches a single object. Please instead switch the plan include a loop that calls the business function individually (identify with name ${node.businessObjectFunction.FunctionName} and objectCode ${node.businessObjectFunction.BusinessObjectCode}. `)\n    } else if (boNode.outputMissing && boNode.missingOutputs && node.businessObjectFunction.OutputAttributes && node.businessObjectFunction.OutputAttributes.length) {\n      const missingFields = []\n      for (const output of boNode.missingOutputs) {\n        missingFields.push(`${output.name} (${output.type})`);\n      }\n      planChanges.push(`For node with code ${node.code}, the request was for a business function, which has been identified with name ${node.businessObjectFunction.FunctionName} and objectCode ${node.businessObjectFunction.BusinessObjectCode}. These output restResults.children fields do not exist as an output of the business object: ${missingFields.join(', ')}. Redo the plan to not need the missing fields.`)\n    } else {\n      delete node.businessObjectFunction.kbObject;\n      delete businessObjectFunction.OutputAttributes\n      parameters = businessObjectFunction.parameters;\n      restObj = businessObjectFunction;\n      // Set data for previous LLM node\n    }\n    if (parameters && restObj) {\n      node.inputs_has_combined_attribute = false;\n      if (node && node.inputs && node.inputs[0] &&  node.inputs[0].type == 'object' &&  node.inputs[0].source == 'node' && restObj.parameters)  {\n        node.inputs_has_combined_attribute = true;\n        const input = node.inputs[0];\n        input.items = parameters;\n        restObj.parametersMapping = [];\n        for (const param of restObj.parameters) {\n          restObj.parametersMapping.push({\n            name: `${input.name}.${param.name}`, \n            code: input.code, \n            source: 'node',\n            param_name: param.name,\n            type: param.type\n          });\n        }\n        const sourceNode = codeToNode[node.inputs[0].code];\n        if (sourceNode && sourceNode.outputs) {\n          for (const output of sourceNode.outputs) {\n            if (input.name === output.name) {\n              output.items = input.items;\n              node.input_source = output;\n              break;\n            }\n          }\n        }\n      }\n      if (boNode.inputMissing && boNode.missingInputs) {\n        const missingFields = []\n        for (const input of boNode.missingInputs) {\n          missingFields.push(`${input.param_name} (${input.type})`);\n        }\n        if (node.businessObjectFunction) {\n          planChanges.push(`For node with code ${node.code}, the request was for a business function, which has been identified with name ${node.businessObjectFunction.FunctionName} and objectCode ${node.businessObjectFunction.BusinessObjectCode}. These parameters of the business object has entry/ies that are missing from the plan : ${missingFields.join(', ')}. Redo the plan to provide the missing inputs.`);\n        } else {\n          if (wasBof) {\n            planChanges.push(`For node with code ${node.code}, the request was for a business function. We have instead identified an External Rest Tool,  which has been identified with ToolCode ${restObj.ToolCode} and functionName ${restObj.FunctionName}. These parameters of the external Rest Tool has entry/ies that are missing from the plan: ${missingFields.join(', ')}. Redo the plan to switch the node type to external rest tool, include ToolCode and functionName in characteristic, and provide the missing inputs.`);\n          } else {\n            planChanges.push(`For node with code ${node.code}, an External Rest Tool has been identified with ToolCode ${restObj.ToolCode} and functionName ${restObj.FunctionName}. These parameters of the external Rest Tool has entry/ies that are missing from the plan: ${missingFields.join(', ')}. Redo the node by including ToolCode and functionName in characteristic and provide the missing inputs.`);\n\n          }\n          minExternalRestToolsSelected[restObj.ToolCode + ':' + restObj.FunctionName ] = minExternalRestTools;\n        }\n      }\n      node.boParams = restObj.parametersMapping;\n    }\n  } else if (node.node_type == $context.$variables.nodeTypes.RAG) {\n    const toolChar = node.characteristic && node.characteristic.tool ? node.characteristic.tool : node.characteristic;\n    node.ragTool = ragToolsByCharateristics[toolChar] ;\n  }\n  if (node.childrenObject) {\n    for (const childrenIndex of Object.keys(node.childrenObject)) {\n      const children = node.childrenObject[childrenIndex];\n      for (const childNode of children) {\n        nodesToProces.push({node: childNode, parent: children});\n      }\n    }\n  }\n  if (node.children) {\n    for (const childNode of node.children) {\n      nodesToProces.push({node: childNode, parent: node.children});\n    }\n  }\n  if (node.true) {\n    for (const childNode of node.true) {\n      nodesToProces.push({node: childNode, parent: node.true});\n    }\n  }\n  if (node.false) {\n    for (const childNode of node.false) {\n      nodesToProces.push({node: childNode, parent: node.false});\n    }\n  }\n  previousNode = node;\n}\nreturn {planChanges, plan, minBusinessObjectFunctions, minBusinessObjectFunctionsAll, businessObjectFunctions, minExternalRestToolsSelected, minBusinessObjectFunctionsString, minBusinessObjectFunctionsAllString};"
          },
          "outcomes": {
            "success": "1775711483054"
          },
          "code": "PLAN",
          "id": "1767830449452",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "specification",
            "returnType": "object",
            "sourceCode": "const pipeline = $context.$nodes.CREATE_PIPELINE.$output.result.pipeline;\nconst chatExpLocalFileUploadEnabledFlag = $context.$nodes.CREATE_PIPELINE.$output.result.chatExpLocalFileUploadEnabledFlag;\nconst variables = $context.$nodes.CREATE_PIPELINE.$output.result.variables || {};\nconst includeEmailTrigger = $context.$nodes.CREATE_PIPELINE.$output.result.includeEmailTrigger;\nconst restTriggers = $context.$nodes.CREATE_PIPELINE.$output.result.restTriggers;\nconst triggers = [\n  {\n    \"type\": \"REST\",\n    \"inputs\": Object.values(restTriggers),\n  }\n];\nif (includeEmailTrigger) {\n  triggers.push({\n    \"type\": \"EMAIL\",\n    \"inputs\": [\n      {\n        \"dirtyFlag\": true,\n        \"name\": \"emailConfigCode\",\n        \"newVariableFlag\": true,\n        \"value\": \"INBOUNDMAILEXPENSE\"\n      },\n      {\n        \"name\": \"emailAccountMappingRowId\",\n        \"value\": \"300100650242121\"\n      }\n    ]\n  });\n}\n\nconst specification = {\n    \"modelConfiguration\": {\n      \"modelProperties\": {},\n      \"code\": \"ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI\",\n      \"model\": \"OCI_GPT_5_MINI\",\n      \"provider\": \"CERT_PREMIUM\"\n    },\n  \"jsonSchemaVersion\": 1,\n  \"chatExpLocalFileUploadEnabledFlag\": chatExpLocalFileUploadEnabledFlag,\n  \"dataPipeline\": {\n    \"pipelineNodes\": pipeline,\n    \"rootNode\": \"start\",\n    \"variables\": Object.values(variables),\n    \"errorHandlers\": [\n      {\n        \"type\": \"EMAIL\",\n        \"inputs\": [\n          {\n            \"name\": \"toList\",\n            \"type\": \"string\",\n            \"value\": \"\"\n          },\n          {\n            \"name\": \"ccList\",\n            \"type\": \"string\",\n            \"value\": \"\"\n          },\n          {\n            \"name\": \"subject\",\n            \"type\": \"string\",\n            \"value\": \"\"\n          },\n          {\n            \"name\": \"body\",\n            \"type\": \"string\",\n            \"value\": \"\"\n          }\n        ]\n      }\n    ]\n  },\n  \"humanApprovalFlag\": false,\n  \"chatExpThirdPartyDetails\": [],\n  \"outputSpecification\": \" \",\n  \"inputs\": [],\n  \"agentsValueMappings\": [],\n  \"policyIds\": [],\n  \"jsonSchemaName\": \"Workflow.spec\",\n  \"triggers\": triggers,\n  \"chatExpTPFileUploadEnabledFlag\": false\n};\n\nreturn specification;"
          },
