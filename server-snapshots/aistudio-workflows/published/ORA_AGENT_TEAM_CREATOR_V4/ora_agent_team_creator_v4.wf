        {
          "metadata": {
            "name": "find choice",
            "returnType": "object",
            "sourceCode": "const plan = $context.$variables.plan ;\n\nconst flattenedNodes = [];\nconst processNodes = [...plan.nodes];\nwhile (processNodes.length) {\n  const node = processNodes.shift();\n  flattenedNodes.push(node);\n  if (node.true) {\n    processNodes.push(...node.true);\n  }\n  if (node.false) {\n    processNodes.push(...node.false);\n  }\n  if (node.children) {\n    processNodes.push(...node.children);\n  }\n  if (node.childrenObject) {\n    for (const childrenIndex of Object.keys(node.childrenObject)) {\n      const children = node.childrenObject[childrenIndex];\n      processNodes.push(...children);\n    }\n  }\n}\n\nconst changes = []\nfor (const node of flattenedNodes) {\n  let characteristic = node.characteristic;\n  if (node.node_type == $context.$variables.nodeTypes.RAG && node.ragTool && node.ragTool.alternatives) {\n    let alts = '';\n    for (const index in node.ragTool.alternatives) {\n      const tool = node.ragTool.alternatives[index];\n      alts += `Choice ${index + 1}: ${tool.Name} (ToolCode: ${tool.ToolCode}), description:${tool.Description}  \\n <br> `;\n    }\n    const ragTool = node.characteristic && node.characteristic.tool ? node.characteristic.tool : node.characteristic;\n    const choice = `To implement your agent team, we have identified the need for a node that does ${ragTool}. We have picked the tool ${node.ragTool.Name} (ToolCode: ${node.ragTool.ToolCode}), description:${node.ragTool.Description} for you. We also have these alternatives that you can choose:  <br><br>  ${alts} <br>Either approve the current tool, or request change and provide what ToolCode you want to use instead; \"NONE\" to leave tool blank; or alternatively describe what changes you want (like \"use a business object/external rest tool\" instead).`;\n    const choiceRequestChange = 'Provide ToolCode';\n    changes.push({\n      code: node.code,\n      choice,\n      choiceRequestChange,\n    });\n  } else if (node.node_type == $context.$variables.nodeTypes.EMAIL) {\n    const keys = characteristic ? Object.keys(characteristic) : [];\n    let str = '';\n    for (const key of keys) {\n      if (key === 'toList') {\n        continue;\n      }\n      str += `${key} : ${characteristic[key]} \\n`;\n    }\n    characteristic = str;\n    if (!node.characteristic || !node.characteristic.toList) {\n      continue;\n    }\n    const isUserChoice = node.characteristic.toList === 'user_choice' || node.characteristic.toList.indexOf('user_choice') > -1;\n    if (!isUserChoice) {\n      continue;\n    }\n    const choice = `To implement your agent team, we have identified the need for an email node that does <br><br><code>${characteristic}</code><br>\\n Approve to leave blank. Request change to provide a \"TO\" email address.`;\n    const choiceRequestChange = 'Provide email address';\n    changes.push({\n      code: node.code,\n      choice,\n      choiceRequestChange,\n    });\n  }\n} \n\nreturn {changes};"
          },
          "outcomes": {
            "success": "1776472947280"
          },
          "code": "FIND_CHOICE",
