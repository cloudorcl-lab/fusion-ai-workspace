        {
          "metadata": {
            "name": "Parse Nodes 2",
            "returnType": "object",
            "sourceCode": "const plan = $context.$variables.plan;\nconst inputOutputFixes = $context.$nodes.FIX_INPUTOUTPUT.$output;\nlet nodesToParse = []; \nconst language = $context.$nodes.PARSE_USER_REQUEST.$output.language ;\nconst hasInvalidOutput = $context.$nodes.CHECK_FOR_INVALID_INPUTOUTPUTS.$output.result ? $context.$nodes.CHECK_FOR_INVALID_INPUTOUTPUTS.$output.result.invalidInputOutput : null;\n\nif (!plan || !plan.nodes) {\n  throw new Error('Invalid Plan');\n}\n\nconst inputOutputFixesByCode = {};\nif (inputOutputFixes && inputOutputFixes.nodes) {\n  for (const node of inputOutputFixes.nodes) {\n    inputOutputFixesByCode[node.code] = node;\n  }\n}\n\nfor (let node of plan.nodes) {\n  nodesToParse.push({parent: null, node});\n}\nconst failedNodes = [];\nconst flattenedNodes = [];\nconst nodes = [];\nlet index = 0;\nconst nodeNames = {};\nconst nodeCodes = {};\nconst codesToNode = {};\nconst codesToNodeParent = {};\n\nconst nodeTypesArray = Object.values($context.$variables.nodeTypes);\nconst planChanges = [];\nwhile (nodesToParse.length) {\n  const nodeWrapper = nodesToParse.shift();\n  const node = nodeWrapper.node;\n  const parent = nodeWrapper.parent;\n  const hasLoop = nodeWrapper.hasLoop || false;\n  const nextNodeWrapper = nodesToParse[0] && nodesToParse[0].parent === parent ? nodesToParse[0] : null;;\n \n  if (!node || typeof node === 'string' || !node.node_type) {\n    failedNodes.push(node);\n    continue;\n  }\n  flattenedNodes.push(node);\n  node.id = `17647127445${index}`;\n  index++;\n  node.node_type = node.node_type.toUpperCase();\n  if (nodeTypesArray.indexOf(node.node_type) === -1) {\n    failedNodes.push(node);\n    continue;\n  }\n  const nodeTypesRequiredCharateristic = [\n    $context.$variables.nodeTypes.BOF,\n    $context.$variables.nodeTypes.LLM,\n    $context.$variables.nodeTypes.RAG,\n    $context.$variables.nodeTypes.EMAIL,\n    $context.$variables.nodeTypes.IF,\n    $context.$variables.nodeTypes.HA,\n    $context.$variables.nodeTypes.LOOP,\n    $context.$variables.nodeTypes.WHILE,\n    $context.$variables.nodeTypes.SWITCH,\n    $context.$variables.nodeTypes.PARALLEL,\n  ];\n  if (nodeTypesRequiredCharateristic.indexOf(node.node_type) > -1 && !node.characteristic) {\n    planChanges.push(`Node with code ${node.code} has empty node.characteristic, please fix.`);\n    continue;\n  }\n\n  const characteristic = node.characteristic;\n  if (!node.name) {\n    const label = $context.$variables.nodeTypesLabels[node.node_type];\n    const name = (label || node.node_type);\n    node.name = name;\n    let nameIndex = 1;\n    while (nodeNames[node.name]) {\n      node.name = name + ' (' + nameIndex + ')';\n      nameIndex += 1;\n    }\n    nodeNames[node.name] = node.name;\n  }\n  if (!node.code) {\n    const code = node.name.replace(/[^a-zA-Z0-9 _]/g, '').replace(/\\s/g, \"_\").toUpperCase();\n    node.code = code;\n    let codeIndex = 0;\n    while (nodeCodes[node.code]) {\n      node.code = code + '_' + codeIndex;\n      codeIndex += 1;\n    }\n    nodeCodes[node.code] = node.code;\n  }\n  codesToNode[node.code] = node;\n  codesToNodeParent[node.code] = parent;\n  node.referencePath = node.parentReferencePath ?  node.parentReferencePath + '.' + node.code : node.code;\n  if (hasInvalidOutput && inputOutputFixesByCode[node.code]) {\n    if (inputOutputFixesByCode[node.code].inputs) {\n      node.inputs = inputOutputFixesByCode[node.code].inputs;\n    }\n    if (inputOutputFixesByCode[node.code].outputs) {\n      node.outputs = inputOutputFixesByCode[node.code].outputs;\n    }\n  }\n  if (node.node_type == $context.$variables.nodeTypes.BOF) {\n    // If next node is not IF, add IF\n    if (nextNodeWrapper && nextNodeWrapper.node.node_type !== $context.$variables.nodeTypes.IF && !hasLoop) {\n      const falseBranch = [{\n          \"name\": \"Inform of failure:\"  + node.name,\n          \"node_type\": $context.$variables.nodeTypes.LLM,\n          \"characteristic\": `Inform the user that failed to call \"${node.name} with intent to ${node.characteristic}.`,\n          \"inputs\": node.outputs,\n          \"is_return_node\": true\n        }];\n      const ifNode = {\n        node_type: $context.$variables.nodeTypes.IF,\n        name:  `IF ${node.name} succesful - IF CONDITION`,\n        parent_node: node.code,\n        condition: `!!node.${node.code}.restResults `,\n        characteristic: {true: [], false: falseBranch}\n      }\n      const nodesToParseTemp  = [];\n      while (nodesToParse.length) {\n        const innerNodeWrapper = nodesToParse.shift();\n        if (innerNodeWrapper.parent === parent) {\n          ifNode.characteristic.true.push(innerNodeWrapper.node);\n        } else {\n          nodesToParseTemp.push(innerNodeWrapper);\n        }\n      }\n      while (nodesToParseTemp.length) {\n        nodesToParse.push(nodesToParseTemp.shift());\n      }\n      nodesToParse.unshift({node: ifNode, parent});\n    }\n  }\n  if (node.node_type == $context.$variables.nodeTypes.LLM) {\n    if (node.is_return_node && parent) { // Return nodes most have parents\n      const returnNode = {\n        node_type: $context.$variables.nodeTypes.RETURN,\n        name: 'Return: ' + node.name,\n        description: `Return ${node.characteristic}`\n      }\n      nodesToParse.push({node: returnNode, parent});\n       // Zero out outputs if can't have return, assume last node\n    } else if (node.is_return_node ) {\n      node.outputs = [];    \n    }\n  } else if (node.node_type == $context.$variables.nodeTypes.EMAIL) {\n    const useParent = parent || nodes;\n    const llmInputs = [];\n    if (node.inputs) {\n      for (const input of node.inputs) {\n        if ((input.name === 'to' || input.name == 'toList') &&  input.value && input.value.indexOf('user_choice') > -1) {\n          continue;\n        }\n        llmInputs.push(input);\n      }\n    }\n    let strForLlmNode = '';\n    for (const key of Object.keys(node.characteristic)) {\n      if (key === 'toList' && node.characteristic.toList.indexOf('user_choice') > -1) {\n        continue;\n      }\n      strForLlmNode += `${key}: \"${node.characteristic[key]}\"\\n`\n    }\n    const llmNode = {\n      node_type: $context.$variables.nodeTypes.LLM,\n      characteristic: `Generate body, subject, toList, ccList for the email described, make any necessary replacements \\n${strForLlmNode}`,\n      name:  `LLM Call for email: ${node.name}`,\n      isForHaOrEmail: true,\n      inputs: llmInputs,\n      code: 'LLM_FOR_' + node.code,\n      outputs: [\n        {name: 'body', type: 'string'},\n        {name: 'subject', type: 'string'},\n        {name: 'toList', type: 'string'},\n        {name: 'ccList', type: 'string'},\n      ],\n    };\n    node.sourceLLmNode = llmNode.code;\n    useParent.push(llmNode);\n    nodesToParse.push({node: llmNode, hasLoop, parent: ['blank']}); // add code but blank parent to prevent dups\n  } else if (node.node_type == $context.$variables.nodeTypes.HA) {\n    const useParent = parent || nodes;\n    const llmNode = {\n      node_type: $context.$variables.nodeTypes.LLM,\n      characteristic: `Generate a message requesting for approval described by: \"${node.characteristic.message ? node.characteristic.message: node.characteristic}\"`,\n      name: 'LLM Call for human approval: ' + node.name,\n      isForHaOrEmail: true,\n      inputs: node.inputs,\n      code: 'LLM_FOR_' + node.code,\n    };\n    node.sourceLLmNode = llmNode.code;\n    const loopCode = node.characteristic ? node.characteristic.loopBackNodeCode : null;\n    if (loopCode && codesToNode[loopCode]) {\n      const loopNode = codesToNode[loopCode];\n      const varName =  `${loopNode.code}_OUTPUT`;\n      if (!loopNode.haFeedbackPaths) {\n        loopNode.haFeedbackPaths = [];\n        const setVarsNode = {\n          node_type: $context.$variables.nodeTypes.VARS,\n          name: `Set Fields for ${loopNode.name}`,\n          inputs: [{\n            source: 'node',\n            name: varName,\n            code: loopNode.code,\n          }],\n          description: 'Set output of prior node',\n          code: 'SET_VARS_FOR_' + loopNode.code,\n          skipFix: true,\n        };\n        const parentOfLoopbackNode = codesToNodeParent[loopNode.code] || nodes;\n        const strPos = parentOfLoopbackNode.indexOf(loopNode);\n        parentOfLoopbackNode.splice(strPos + 1 , 0, setVarsNode);\n        nodesToParse.push({node: setVarsNode, hasLoop, parent: ['blank']});\n      }\n      codesToNode[loopCode].haFeedbackPaths.push(node.referencePath);\n    }\n    useParent.push(llmNode);\n    nodesToParse.push({node: llmNode, hasLoop, parent: ['blank']}); // add code but blank parent to prevent dups\n  }\n\n  \n  if (node.node_type === $context.$variables.nodeTypes.SWITCH || node.node_type === $context.$variables.nodeTypes.PARALLEL) {\n    node.childrenObject = {};\n    for (const childIndex of Object.keys(node.characteristic)) {\n      const children = node.characteristic[childIndex] ? (node.characteristic[childIndex].nodes ? node.characteristic[childIndex].nodes : node.characteristic[childIndex]) : [];\n      node.childrenObject[childIndex] = [];\n      for (const innerNode of children) {\n        if (innerNode && innerNode.node_type) {\n          innerNode.parentReferencePath = node.referencePath;\n          nodesToParse.push({parent: node.childrenObject[childIndex] , node: innerNode, hasLoop});\n        }\n      }\n    }\n  } else if (node.node_type === $context.$variables.nodeTypes.LOOP || node.node_type === $context.$variables.nodeTypes.WHILE) {\n    node.children = [];\n    const children = characteristic && characteristic.nodes ? characteristic.nodes : (characteristic && characteristic.value ? characteristic.value : characteristic);\n    // For some reason,\n    for (const innerNode of children) {\n      if (innerNode && innerNode.node_type) {\n        innerNode.parentReferencePath = node.referencePath;\n        nodesToParse.push({parent: node.children, node: innerNode, hasLoop: true});\n      }\n    }\n  } else  if (node.node_type === $context.$variables.nodeTypes.IF) {\n    if (characteristic && characteristic.true) {\n      node.true = [];\n      const trueChildren =  characteristic.true &&  characteristic.true.nodes ? characteristic.true.nodes  :  characteristic.true;\n      for (const innerNode of trueChildren) {\n        if (innerNode && innerNode.node_type) {\n          nodesToParse.push({parent: node.true, node: innerNode, hasLoop});\n        }\n      }\n    }\n    if (characteristic && characteristic.false) {\n      node.false = [];\n      const falseChildren =  characteristic.false &&  characteristic.false.nodes ? characteristic.false.nodes  :  characteristic.false;\n      for (const innerNode of falseChildren) {\n        if (innerNode && innerNode.node_type) {\n          nodesToParse.push({parent: node.false, node: innerNode, hasLoop});\n        }\n      }\n    }\n    delete node.characteristic;\n  }\n  if (parent) {\n    parent.push(node);\n  } else {\n    nodes.push(node)\n  }\n}\n\nconst newPlan = {\n  nodes,\n  language: language ? language.toLowerCase() : 'english',\n}\nnewPlan.isEnglish = newPlan.language == 'english';\nconst ret = {plan: newPlan, flattenedNodes, failedNodes, codesToNode, planChanges};\n\nret;"
          },
          "outcomes": {
            "success": "1770324929204"
          },
