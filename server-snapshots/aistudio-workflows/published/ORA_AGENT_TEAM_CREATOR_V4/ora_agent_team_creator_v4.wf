          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1767831677478",
            "name": "create pipeline",
            "returnType": "object",
            "sourceCode": "const canBeTranslated = $context.$nodes.PLANNER_LLM.$output.canBeTranslated ;\n\nconst defualtVariables = $context.$variables.defaultVariables ;\nlet pipeline = null;\nlet processPipelines = [];\nconst plan = $context.$variables.plan ;\n\nif (!plan || !plan.nodes) {\n  throw new Error('Invalid plan');\n}\n\nlet includeEmailTrigger = false;\n\npipeline = [\n  {\n    \"metadata\": {\n      \"name\": \"Start\",\n      \"description\": \"Start of data pipeline\"\n    },\n    \"code\": \"START\",\n    \"outcomes\": {\n      \"success\": \"end\"\n    },\n    \"inputs\": [],\n    \"id\": \"start\",\n    \"type\": \"START\"\n  }\n];\n// For condition, IF conditions are alergic to having requested node.inputs\nconst fileNodeName = \"FILES_AS_ARRAY\"; // New UI errors due to this node not existing in this workflow cause it scams strings... \nconst rawValue = `$context.$nodes.${fileNodeName}.$output.result`;\nconst rawValueUM = '$context.$system.$inputMessage';\nconst outputsReplacements = {\n  \"files.files\" : {\n    label: \"Files\",\n    rawValue,\n    codeValue: '\"' + rawValue + '\"',\n    value: `{{${rawValue}}}`,\n    replacementKey: \"files.files\",\n  },\n  \"user.inputMessage\" : {\n    skipAddingToLLM: true,\n    label: \"Input Message\",\n    rawValue,\n    codeValue: '\"' + rawValueUM + '\"',\n    value: `{{${rawValueUM}}}`,\n    replacementKey: \"user.inputMessage\",\n  }\n};\nfor (const emailInput of [\"subject\", \"fromAddress\", \"content\", \"attachments\", \"headers\"]) {\n  const rawValue = `$context.$triggers.EMAIL.$input.${emailInput}`;\n  const key = `email.${emailInput}`;\n  outputsReplacements[key] = {\n    label: `Email ${emailInput}`,\n    rawValue,\n    codeValue: '\"' + rawValue + '\"',\n    value: `{{${rawValue}}}`,\n  };\n  outputsReplacements[key].replacementKey = key;\n}\nconst variables = [];\nlet variableIndex = 0;\n// Is there default variables?\nif (defualtVariables && defualtVariables.length) {\n  pipeline[0].outcomes.success = \"1771538262762\";\n  pipeline.push({\n    \"metadata\": {\n      \"name\": \"Set Default Variables\"\n    },\n    \"outcomes\": {\n      \"success\": \"end\"\n    },\n    \"code\": \"SET_DEFAULT_VARIABLES\",\n    \"id\": \"1771538262762\",\n    \"inputs\": [\n    ],\n    \"type\": \"SET_FIELDS\"\n  });\n  for (const defaultVariable of defualtVariables)  {\n    const key = 'variable.' + defaultVariable.name;\n    const rawValue = `$context.$variables.${defaultVariable.name}`;\n    outputsReplacements[key] = {\n      label: 'variable.' + defaultVariable.name,\n      rawValue,\n      codeValue: rawValue,\n      value: `{{${rawValue}}}`,\n    };\n    outputsReplacements[key].replacementKey = key;\n    let defaultVariableValue = defaultVariable.default;\n    if (!defaultVariableValue) {\n      if (defaultVariable.type === 'object') {\n        defaultVariableValue = '{}';\n      } else if (defaultVariable.type === 'array') {\n        defaultVariableValue = '[]';\n      }\n    }\n    pipeline[1].inputs.push({\n      \"id\": `1771538314359${variableIndex++}`,\n      \"name\": defaultVariable.name,\n      \"scope\": \"JOB\",\n      \"type\": defaultVariable.type,\n      \"value\": defaultVariableValue\n    });\n    variables.push({\n      \"id\": `1774546683412${variableIndex++}`,\n      \"name\": defaultVariable.name,\n      \"scope\": \"JOB\",\n      \"type\": defaultVariable.type,\n      \"typeSpecification\": \"\"\n    });\n  }\n}\n\n\nconst mainPipelineInfo = {\n  nodes: [...plan.nodes],\n  prefixIndex: null,\n  endNode: 'end', \n  parentNode: null,\n  pipeline,\n}\nprocessPipelines.push(mainPipelineInfo);\nlet idIndex = 0;\n\nlet chatExpLocalFileUploadEnabledFlag = false;\nlet addToLLM = '';\n\nlet nodes;\nlet childPipeline;\nlet prefixIndex;\nlet endNode = 'end';\nlet currentPipeline;\nlet parentVariables;\nlet errorNodeId;\nlet hasParentLoop;\nconst errorNodeIds = [];\nconst pipelineNodesToSetErrorNode = [];\nconst codesToNodes = {};\nconst restTriggers = {};\nconst usedIds = {};\nlet usedIdsTries = 0;\n  \nwhile (processPipelines.length) {\n  childPipeline = processPipelines.shift();\n  hasParentLoop = childPipeline.hasParentLoop || false;\n  nodes = childPipeline.nodes; \n  prefixIndex = childPipeline.prefixIndex;\n  endNode = childPipeline.endNode;\n  currentPipeline = childPipeline.pipeline;\n  parentVariables = childPipeline.parentVariables;\n\n  let pipeLineNode;\n  let previousPipelineEntry = currentPipeline ? currentPipeline[currentPipeline.length - 1] : null\n  let previousNode = null;\n\n  for (const index in nodes) {\n    const intIndex = parseInt(index); // Why did this turn into a string...\n    let nextNode = nodes[intIndex + 1];\n    const node = nodes[index];\n    const isRestType = node.node_type === $context.$variables.nodeTypes.BOF || node.node_type === $context.$variables.nodeTypes.ETOOL;\n    const characteristic = node.characteristic;\n    codesToNodes[node.code] = node;\n    let pipelineId = node.id || `17647127445${idIndex}`;\n    while (usedIds[pipelineId]) {\n      pipelineId = pipelineId + usedIdsTries;\n      usedIdsTries++;\n    }\n    usedIds[pipelineId] = true;\n    node.id = pipelineId;\n    idIndex++;\n    const uniqueNodeIndex = prefixIndex ? `${prefixIndex}_${index}` : index;\n\n    const inputToVal = {};\n    let firstInputValue;\n    let condition = node.condition;\n    if (node.inputs) {\n      for (const input of node.inputs) {\n        const sourceNode = input.code ? codesToNodes[input.code] : null;\n        const key = input.code ? `${input.source}.${input.code}.${input.name}` : `${input.source}.${input.name}` ;\n\n        input.key = key;\n        //outputName\n\n        if (input.source === 'email') {\n          inputToVal[key] = outputsReplacements[key];\n          includeEmailTrigger = true;\n        } else if (input.source === 'rest') {\n          const rawValue = `$context.$triggers.REST.$input.${input.name}`\n          inputToVal[key] = {\n            label: input.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n          const splitField = input.name.split('.');\n          const head = splitField.shift();\n          if (head !== input.name) {\n            if (!restTriggers[head]) {\n              restTriggers[head] = {\n                \"id\": \"1775158118364\",\n                \"name\": head,\n                \"scope\": \"JOB\",\n                \"type\": \"object\"\n              }\n            }\n          } else if(!restTriggers[input.name]) {\n            restTriggers[input.name] = {\n              \"id\": \"1775158118364\",\n              \"name\": input.name,\n              \"scope\": \"JOB\",\n              \"type\": input.type\n            };\n          }\n        } else if (input.source === 'static') {\n          inputToVal[key] = {\n            codeValue: typeof input.value === 'string' ? '\"' + input.value + '\"' : input.value,\n            label: input.name + `(static value static.${input.name})`,\n            rawValue: input.value,\n            value: input.value,\n          };\n        } else if (input.source === 'loop' && sourceNode) {\n          const rawValue = `$context.$nodes.${sourceNode.referencePath}.$currentItem`;\n          inputToVal[key] = {\n            label: 'Loop current item node.' + input.code +  '.' + input.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (input.source === 'combination') {\n          let rawValue = input.value;\n          for (const output of Object.values(outputsReplacements)) {\n            rawValue = rawValue.replaceAll(output.replacementKey, output.codeValue);\n          }\n          inputToVal[key] = {\n            name: input.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (outputsReplacements[key]) {\n          inputToVal[key] = outputsReplacements[key];\n        }  else {\n          // Check outputs ignoring caps\n          for (const [key2, item] of Object.entries(outputsReplacements)) {\n            if (key2.toLowerCase() === key.toLowerCase()) {\n              inputToVal[key] = item;\n              break;\n            }\n          }\n        }\n        if (input.items && sourceNode) {\n          for (const item of input.items) {\n            const keyInner = `node.${input.code}.${input.name}.${item.name}`;\n            let rawValueInner = inputToVal[key] ? inputToVal[key].rawValue : null;\n            if (rawValueInner) {\n              rawValueInner += `.${item.name}`;\n            } else {\n              rawValueInner = `$context.$nodes.${sourceNode.referencePath}.$output.${input.name}.${item.name}`;\n            }\n            inputToVal[keyInner] = {\n              label: 'node.' + input.code +  '.' + input.name + '.' + item.name,\n              rawValue: rawValueInner,\n              value: `{{${rawValueInner}}}`,\n              replacementKey: keyInner,\n            };\n          }\n        }\n        if (inputToVal[key]) {\n          if (!inputToVal[key].codeValue) {\n            inputToVal[key].codeValue = inputToVal[key].rawValue;\n          }\n          inputToVal[key].key = key;\n          if (!firstInputValue) {\n            firstInputValue = inputToVal[key].value;\n          }\n          if (condition) {\n            condition = condition.replaceAll(key, inputToVal[key].codeValue);\n          }\n        }\n        const outputkey = input.code && input.outputName ? `${input.source}.${input.code}.${input.outputName}` : null ;\n        if (outputkey && outputsReplacements[outputkey]) {\n          inputToVal[outputkey] = outputsReplacements[outputkey];\n          inputToVal[outputkey].key = outputkey;\n          if (!firstInputValue) {\n            firstInputValue = inputToVal[outputkey].value;\n          }\n        }\n      }\n    }\n    let outputsToParse =  node.outputs || [];\n    if (node.node_type == $context.$variables.nodeTypes.LLM) {\n      outputsToParse = outputsToParse.concat([{name: `${node.code}_OUTPUT`, isFullOutput: true}]);\n    }\n    if (outputsToParse) {\n      for (const output of outputsToParse) {\n        const key = `node.${node.code}.${output.name}`;\n        if (isRestType) {\n          let rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          if (node.is_collection) {\n            for (const field of ['items', 'hasMore', 'count']) {\n              const rawValueInner = rawValue + '.' + field;\n              outputsReplacements[key + '.' + field] = {\n                label: 'node.' + node.code +  '.' + output.name + '.' + field,\n                rawValue: rawValueInner,\n                codeValue: rawValueInner,\n                value: `{{${rawValueInner}}}`,\n                replacementKey: key + '.' + field,\n              };\n            }\n          } else if (output.items) {\n            for (const item of output.items) {\n              const keyInner = `node.${node.code}.${output.name}.${item.name}`;\n              let rawValueInner = `$context.$nodes.${node.referencePath}.$output.${item.name}`;\n              outputsReplacements[keyInner] = {\n                label: 'node.' + node.code +  '.' + output.name + '.' + item.name,\n                rawValue: rawValueInner,\n                codeValue: rawValueInner,\n                value: `{{${rawValueInner}}}`,\n                replacementKey: keyInner,\n              };\n            }\n          }\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (node.node_type === $context.$variables.nodeTypes.HA) {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (node.node_type === $context.$variables.nodeTypes.RAG) {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (node.node_type === $context.$variables.nodeTypes.CODE) {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output.result`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (node.node_type === $context.$variables.nodeTypes.FILE_ATTACHMENT) {\n          const rawValue = `$context.$nodes.${fileNodeName}.$output.result`;\n          outputsReplacements[key] = {\n            label: 'Files',\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (output.isFullOutput) {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        } else if (output.name === 'loop_results') {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n\n        } else {\n          const rawValue = `$context.$nodes.${node.referencePath}.$output.${output.name}`;\n          outputsReplacements[key] = {\n            label: 'node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        }\n        outputsReplacements[key].replacementKey = key;\n        if (!outputsReplacements[key].codeValue) {\n          outputsReplacements[key].codeValue = outputsReplacements[key].rawValue;\n        }\n        if (node.node_type === $context.$variables.nodeTypes.LOOP) {\n          const key2 = `loop_results.${node.code}.${output.name}`;\n          const rawValue = `$context.$nodes.${node.referencePath}.$output`;\n          outputsReplacements[key2] = {\n            label:  'Loop results node.' + node.code +  '.' + output.name,\n            rawValue,\n            value: `{{${rawValue}}}`,\n          };\n        }\n      }\n    }\n    if (condition) {\n      for (const output of Object.values(outputsReplacements)) {\n        const replacementKey = output.replacementKey;\n        //condition += `(replacementKey=${replacementKey}, ${ output.codeValue})`\n        condition = condition.replaceAll(replacementKey, output.codeValue);\n      }\n      condition = `{{${condition.trim()}}}`\n    }\n    if (isRestType) {\n      const bof = node.businessObjectFunction;\n      const externalRestTool = node.externalRestTool;\n      pipeLineNode = {\n        \"metadata\": {\n          \"errorNodeId\": \"\",\n          \"name\": node.name || 'BOF node',\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [],\n        \"outputSpecification\": \"{}\",\n      }\n      if (bof) {\n        pipeLineNode.metadata.businessObjectCode = bof && bof.BusinessObjectCode ? bof.BusinessObjectCode : '';\n        pipeLineNode.metadata.functionName = bof ? bof.FunctionName : '';\n        pipeLineNode.type = \"BO_FUNCTION\";\n      } else {\n        pipeLineNode.metadata.externalRestToolCode = externalRestTool.ToolCode;\n        pipeLineNode.metadata.functionName = externalRestTool.FunctionName;\n        pipeLineNode.type = \"EXTERNAL_REST\";\n      }\n\n      if (node.boParams && node.boParams.length) {\n        let bofIndex = 0;\n        for (const field of node.boParams) {\n          const key = field.code ? `${field.source}.${field.code}.${field.name}` : `${field.source}.${field.name}`;\n          const inputInfo = inputToVal[key] || outputsReplacements[key];\n          const fieldType = field.type || \"string\";\n          const defualtName = field.name || field.param_name;\n          let value = fieldType === 'string' ? `{{$context.$variables.${defualtName} ? $context.$variables.${defualtName} : null}}` : `{{$context.$variables.${defualtName}}}`;\n          if (inputInfo) {\n            value = inputInfo.value;\n          }\n          if (field.source === 'kb_static' || field.source === 'static') {\n            value = field.value;\n          }\n          pipeLineNode.inputs.push({\n            id: `${pipelineId}_${bofIndex++}`,\n            name: field.param_name,\n            type: fieldType,\n            value,\n          });\n        }\n      }\n      // See if there's an if conditon next.\n      // @todo figure out if condtion is valid\n      if (nextNode && nextNode.node_type == $context.$variables.nodeTypes.IF && nextNode.false && nextNode.false.length && nextNode.false[0]) {\n        pipeLineNode.metadata.errorNodeId = nextNode.false[0].id;\n        errorNodeIds.push(nextNode.false[0].id);\n      } else if (hasParentLoop && nextNode) {\n        pipeLineNode.metadata.errorNodeId = nextNode.id;\n      } else if (!hasParentLoop) {\n        if (!pipeLineNode.metadata.errorNodeId) {\n          pipelineNodesToSetErrorNode.push(pipeLineNode);\n        }\n      } else {\n        pipeLineNode.metadata.noNextNode = true; // todo\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.LLM) {\n      let boParams = node.boParams;\n      let isForHaOrEmail = node.isForHaOrEmail\n      const outputParams = {};\n      let finalJson = {};\n\n      let prompt = node.characteristic.prompt ? node.characteristic.prompt : node.characteristic;\n      let addOutputs = false;\n      node.outputsMap = {};\n      if (node.outputs && node.outputs.length) {\n        addOutputs = true;\n        for (const field of node.outputs) {\n          node.outputsMap[field.name] = field;\n          if (field.name.indexOf('.') > 1) {\n            const splitField = field.name.split('.');\n            const lastName = splitField.pop();\n            let outputItem = outputParams;\n            let finalJsonItem = finalJson;\n            for (const name of splitField) {\n                if (!outputItem[name] || !outputItem[name].properties) {\n                  outputItem[name] = {type: 'object', properties: {}}; \n                }\n                outputItem = outputItem[name].properties;\n                finalJsonItem[name] = {};\n                finalJsonItem = finalJsonItem[name];\n            }\n            outputItem[lastName] = {type: field.type}; \n            finalJsonItem[lastName] = field.type;\n          }\n          if (field.items) {\n            if (field.type === 'array') {\n              outputParams[field.name] = {\"type\": \"array\", \"items\": field.items};\n            } else {\n              outputParams[field.name] = {\"type\": \"object\", \"properties\": {}};\n              finalJson[field.name] = {}\n              if (Array.isArray(field.items)) {\n                for (const item of field.items) {\n                  finalJson[field.name][item.name] = item.dataType;\n                  outputParams[field.name].properties[item.name] = {type: item.dataType};\n                }\n              } else {\n                outputParams[field.name].items = field.items;\n              }\n            }\n          }\n          if (field.properties) {\n            if (!outputParams[field.name]) {\n              outputParams[field.name] = field; // Should already be in correct format\n              finalJson[field.name] = {}\n            }\n          }\n          if (!finalJson[field.name]) {\n            outputParams[field.name] = {type: field.type}; \n            finalJson[field.name] = field.type;\n          }\n          if (outputParams[field.name] && outputParams[field.name].type == 'array') {\n            if (!outputParams[field.name].properties) {\n              outputParams[field.name].properties = {};\n            }\n            outputParams[field.name].properties.length = {\"type\": \"number\"};\n          }\n        }\n      }\n      if (addOutputs) {\n        prompt = prompt + `\\n\\n  Return this JSON format below and only this JSON format -- IGNORE any previous instructions on format of JSON: ${JSON.stringify(finalJson, null, 2)}`;\n      }\n      if (canBeTranslated && node.output_language) { \n          if (node.output_language != 'input_language') {\n          prompt += `\\n\\n\\n Translate the output based of language determed by: \"${node.output_language}\"\\n\\n`\n        } else {\n          prompt += `\\n\\nFigure out what language \"Input Message\" is in, and if not English, translate the output to that language. Do not inform user that you are translating..`;\n        }\n      }\n      node._outputParams = boParams;\n      // Loop over current variables.\n      \n      let varText = '# Variables \\nInput Message: \\n\"{{$context.$system.$inputMessage}}\"\\n\\n';\n      let addParentVars = true;\n      if (node.inputs && node.inputs.length) {\n        for (const input of node.inputs) {\n          const inputInfo = inputToVal[input.key];\n          if (inputInfo && !inputInfo.skipAddingToLLM) {\n            varText += `${inputInfo.label}: ${inputInfo.value}\\n`;\n            if (input.source === 'loop') {\n              addParentVars = false;\n            }\n          }\n        }\n        varText += '\\nDo Not directly the names of these variables in the output unless requested.\\n';\n      }\n      if (addParentVars && parentVariables) {\n        for (const parentVariable of parentVariables) {\n          varText += `${parentVariable.name}: ${parentVariable.value}\\n`;\n        }\n      } else if (variables && (!node.inputs || !node.inputs.length)) {\n        const variableValues = Object.values(variables);\n        for (const field of variableValues) {\n          varText += `${field.name}:  {{$context.$variables.${field.name}}}\\n`;\n        }\n      }\n      if (node.haFeedbackPaths) {\n        const haVars = []\n        for (const haReferencePath of node.haFeedbackPaths) {\n          haVars.push(`{{$context.$nodes.${haReferencePath}.$feedbackRecieved || ''}}`);\n        }\n        varText += `Change Requests (if not blank, alter the output based of the what the request asks): \"${haVars.join(' ')}\"\\n\\n`;\n        varText += `Prior output from this call (use if \"Change Requests\" is not blank: \"{{$context.$variables.${node.code}_OUTPUT}}\"\\n\\n`;\n      }\n\n      if (errorNodeIds.indexOf(pipelineId) > -1) {\n        varText += 'Error Message if prior node has errored: {{$context.$error.$errorMessage}}\\n';\n      }\n      varText += '\\n\\n';\n      prompt = varText + '# Prompt \\n\\n' + prompt;\n\n      if (addToLLM) {\n        prompt = prompt +  '\\n\\n' + addToLLM;\n      }\n\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || 'LLM Call'\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"id\": \"1765399047989_1\",\n            \"name\": \"prompt\",\n            \"type\": \"string\",\n            value: prompt,\n          }\n        ],\n        outputSpecification: addOutputs ? JSON.stringify({\n            \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n            \"type\": \"object\",\n            \"properties\": outputParams,\n            \"required\": []\n        }, null, 2) : \"\",\n        \"type\": \"LLM\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.RAG) {\n      const toolCode = node.ragTool ? node.ragTool.ToolCode : null ;\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || 'Rag node',\n          \"toolCode\": toolCode\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"id\": `${pipelineId}_1`,\n            \"name\": \"question\",\n            \"type\": \"string\",\n            \"value\": firstInputValue || `{{$context.$system.$inputMessage}}`,\n          }\n        ],\n        \"outputSpecification\": \"{\\n  \\\"$schema\\\": \\\"https://json-schema.org/draft/2020-12/schema\\\",\\n  \\\"title\\\": \\\"AnswerWithCitations\\\",\\n  \\\"type\\\": \\\"object\\\",\\n  \\\"properties\\\": {\\n    \\\"value\\\": {\\n      \\\"type\\\": \\\"string\\\",\\n      \\\"description\\\": \\\"The answer text.\\\"\\n    },\\n    \\\"citations\\\": {\\n      \\\"type\\\": \\\"array\\\",\\n      \\\"description\\\": \\\"List of citations relevant to the answer.\\\",\\n      \\\"items\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"properties\\\": {\\n          \\\"citedText\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"description\\\": \\\"The cited text.\\\"\\n          }\\n        },\\n        \\\"required\\\": [\\n          \\\"citedText\\\"\\n        ],\\n        \\\"additionalProperties\\\": false\\n      }\\n    }\\n  },\\n  \\\"required\\\": [\\n    \\\"value\\\",\\n    \\\"citations\\\"\\n  ],\\n  \\\"additionalProperties\\\": false\\n}\",\n        \"type\": \"RAG_DOCUMENT_TOOL\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.FILE_ATTACHMENT) {\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": \"Read File\",\n          \"toolCode\": \"ORA_MULTI_FILE_PROCESSOR_TOOL\",\n          \"parseFiles\": true,\n          \"makeRawFilesAvailable\": false\n        },\n        \"outcomes\": {\n          \"success\": \"1770752276642\"\n        },\n        \"code\": \"READ_FILES\",\n        \"id\": \"1770752276641\",\n        \"inputs\": [\n          {\n            \"id\": \"1770752280237\",\n            \"name\": \"conversationId\",\n            \"type\": \"string\",\n            \"value\": \"{{$context.$workflow.$conversationId}}\"\n          }\n        ],\n        \"type\": \"TOOL\"\n      }\n      chatExpLocalFileUploadEnabledFlag = true;\n      currentPipeline.push(pipeLineNode);\n      if (pipeLineNode && previousPipelineEntry) {\n        previousPipelineEntry.outcomes = {\"success\": pipeLineNode.id};\n      }\n      previousPipelineEntry = pipeLineNode;\n      const readFiles = 'READ_FILES';\n      const fileCodeNodeContents = `const files = [];\nif ($context.$nodes.${readFiles}.$output) {\n  for (const [key, value] of Object.entries($context.$nodes.${readFiles}.$output)) {\n    files.push({fileName: key, fileContents: value});\n  }\n}\nfiles;`\n      pipeLineNode = {\n          \"metadata\": {\n            \"name\": \"Files as Array\",\n            \"returnType\": \"array\",\n            \"sourceCode\": fileCodeNodeContents, \n          },\n          \"outcomes\": {\n            \"success\": endNode\n          },\n          \"code\": fileNodeName,\n          \"id\": \"1770752276642\",\n          \"inputs\": [],\n          \"outputSpecification\": \"{\\n  \\\"$schema\\\": \\\"http://json-schema.org/draft-04/schema#\\\",\\n  \\\"type\\\": \\\"object\\\",\\n  \\\"properties\\\": {\\n    \\\"result\\\": {\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"timeout\\\": {\\n      \\\"type\\\": \\\"boolean\\\"\\n    },\\n    \\\"error\\\": {\\n      \\\"type\\\": \\\"string\\\"\\n    }\\n  },\\n  \\\"required\\\": [\\n    \\\"output\\\",\\n    \\\"timeout\\\",\\n    \\\"error\\\"\\n  ]\\n}\",\n          \"type\": \"CODE\"\n        }\n\n      addToLLM += `File Upload Data: {{$context.$nodes.${fileNodeName}.$output.result}}`;\n    } else if (node.node_type == $context.$variables.nodeTypes.CODE) {\n\n      let sCode = '';\n      if (node.codeNodeUseCase === 'COMBINE_OBJECT' && firstInputValue) {\n\n        for (const input of node.inputs) {\n          if (inputToVal[input.key]) {\n            if (!sCode) {\n              sCode = `const obj = ${inputToVal[input.key].codeValue};\\n`;\n            } else {\n              sCode += `obj.${input.name} = ${inputToVal[input.key].codeValue};\\n`;\n            }\n          }\n        }\n        if (sCode) {\n          sCode += '\\nobj;'\n        }\n      } else if (node.codeNodeUseCase === 'PARSE_JSON' && firstInputValue) {\n        const input = node.inputs[0];\n        const inputVal = inputToVal[input.key].rawValue;\n        sCode = `let obj;try {\\nobj =  JSON.parse(${inputVal});\\n} \\ncatch(err) {console.log(err);}\\nobj;\\n`\n      }\n\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || 'Code node',\n          \"returnType\": \"object\",\n          \"sourceCode\": sCode,\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"outputSpecification\": \"{\\n  \\\"$schema\\\": \\\"http://json-schema.org/draft-04/schema#\\\",\\n  \\\"type\\\": \\\"object\\\",\\n  \\\"properties\\\": {\\n    \\\"result\\\": {\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"timeout\\\": {\\n      \\\"type\\\": \\\"boolean\\\"\\n    },\\n    \\\"error\\\": {\\n      \\\"type\\\": \\\"string\\\"\\n    }\\n  },\\n  \\\"required\\\": [\\n    \\\"output\\\",\\n    \\\"timeout\\\",\\n    \\\"error\\\"\\n  ]\\n}\",\n        \"inputs\": [],\n        \"type\": \"CODE\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.VARS) {\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || 'Set Variables',\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [],\n        \"type\": \"SET_FIELDS\"\n      }\n      for (const input of node.inputs)  {\n        let value = input.value;\n        if (inputToVal[input.key] && input.source === 'combination') {\n          value = inputToVal[input.key].value; // already replaced\n        } else if (!input.is_static && value && typeof value === 'string') { // todo probably can be removed\n          for (const output of Object.values(outputsReplacements)) {\n            const replacementKey = output.replacementKey;\n            value = value.replaceAll(replacementKey, output.codeValue);\n          }\n          value = `{{${value}}}`;\n        } else if (inputToVal[input.key]) {\n          value = inputToVal[input.key].value;\n        }\n        if (!value) {\n          value = `Missing value ${input.key}`;\n          pipeLineNode.inputToVal = inputToVal;\n          pipeLineNode.outputsReplacements = outputsReplacements;\n        }\n        let varFound = false;\n        for (const varia of variables) {\n          if (varia.name === input.name) {\n            varFound = true;\n            break;\n          }\n        }\n        if (!varFound) {\n          variables.push({\n            \"id\": `1774546683412${variableIndex++}`,\n            \"name\": input.name,\n            \"scope\": \"JOB\",\n            \"type\": input.type,\n            \"typeSpecification\": \"\"\n          });\n        }\n        pipeLineNode.inputs.push({\n          \"id\": `1771538314359${variableIndex++}`,\n          \"name\": input.name,\n          \"scope\": \"JOB\",\n          \"type\": input.type,\n          \"value\": value,\n        });\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.WAIT) {\n      pipeLineNode = {\n        \"metadata\": {\n          \"loopBackNodeId\": null,\n          \"maxIterations\": 0,\n          \"name\": node.name || 'Wait node',\n          \"waitTimeUnits\": \"MINUTES\",\n          \"waitTimeValue\":  node.characteristic && node.characteristic.waitTimeValue ? node.characteristic.waitTimeValue : 1\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"id\": `${pipelineId}_1`,\n            \"name\": \"message\",\n            \"type\": \"string\",\n            \"value\": node.characteristic && node.characteristic.message ? node.characteristic.message :  'Waiting'\n          }\n        ],\n        \"type\": \"WAIT\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.RETURN) {\n      const code = node.code || 'RETURN_TO_USER';\n      let returnValue = firstInputValue || (previousNode ? `{{$context.$nodes.${previousNode.referencePath}.$output}}` : 'Done');\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || 'Return to User',\n          \"type\": \"GENERIC\"\n        },\n        \"code\": code,\n        \"id\": pipelineId,\n        \"inputs\": [{\n          \"id\": `${pipelineId}_1`,\n          \"name\": \"returnValue\",\n          \"type\": \"string\",\n          \"value\": returnValue,\n        }],\n        \"type\": \"RETURN\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.EMAIL) {\n      const code = node.code || 'SEND_EMAIL';\n      const params = {\n        toList: node.characteristic.toList,\n        ccList: node.characteristic.ccList,\n        body: node.characteristic.body,\n        subject: node.characteristic.subject,\n      }\n      const keyPrefix = previousNode ? `node.${previousNode.code}` : '';\n      const previousNodeOutputsMap = previousNode  ? previousNode.outputsMap : null;\n      for (const inputName of Object.keys(params)) {\n        let input;\n        if (node.inputs) {\n          for (const innerInput of node.inputs) {\n            if (innerInput.name === inputName || inputName.toLowerCase().indexOf(innerInput.name) === 0) { // indexOf to cover to, ToList\n              input = innerInput;\n              break;\n            }\n          }\n        }\n        if (input && input.source === 'static' && inputToVal[input.key]) {\n          params[inputName] =  Array.isArray(inputToVal[input.key].value) ? inputToVal[input.key].value.join(',') : inputToVal[input.key].value;\n        } else if (previousNodeOutputsMap && previousNodeOutputsMap[inputName] && outputsReplacements[`${keyPrefix}.${inputName}`] ) {\n          params[inputName] = outputsReplacements[`${keyPrefix}.${inputName}`].value;\n        }\n      }\n      pipeLineNode = {\n        params,\n        inputsNode: node.inputs,\n        outputsMap: previousNode ? previousNode.outputsMap : null,\n        hasPreviousNode: !!previousNode,\n        hasPreviousNodeOutputsMap: previousNode ? !!previousNode.outputsMap : null,\n        previousNodeType: previousNode ? previousNode.node_type : null,\n        \"metadata\": {\n          \"name\": node.name || 'Email',\n          \"type\": \"GENERIC\"\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": code,\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"id\": \"1770840873213_1\",\n            \"name\": \"toList\",\n            \"type\": \"string\",\n            \"value\": params.toList ||  node.email,\n          },\n          {\n            \"id\": \"1770840873214_2\",\n            \"name\": \"ccList\",\n            \"type\": \"string\",\n            \"value\": params.ccList || '',\n          },\n          {\n            \"id\": \"1770840873215_3\",\n            \"name\": \"subject\",\n            \"type\": \"string\",\n            \"value\": params.subject || '',\n          },\n          {\n            \"id\": \"1770840873216_4\",\n            \"name\": \"body\",\n            \"type\": \"string\",\n            \"value\": params.body ||  '',\n          },\n          {\n            \"id\": \"1770840873217_5\",\n            \"name\": \"attachments\",\n            \"type\": \"object\"\n          }\n        ],\n        \"type\": \"EMAIL\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.HA) {\n      const feedbackEnabledFlag =  characteristic.feedbackEnabledFlag || false;\n      let loopbackNodeId = null;\n      if (feedbackEnabledFlag && characteristic.channelType === 'CHAT') {\n        if (characteristic.loopBackNodeCode && codesToNodes[characteristic.loopBackNodeCode]) {\n          loopbackNodeId = codesToNodes[characteristic.loopBackNodeCode].id;\n        } else {\n          loopbackNodeId = pipeline.length > 1 ? pipeline[1].id : null;\n        }\n      }\n      const sourceNode = node.sourceLLmNode ? codesToNodes[node.sourceLLmNode] : null;\n      let message = sourceNode ? `{{$context.$nodes.${sourceNode.referencePath}.$output}}` : (characteristic && characteristic.message ? characteristic.message : \"\");\n\n      pipeLineNode = {\n        \"metadata\": {\n          \"channelType\": characteristic && characteristic.channelType ? characteristic.channelType : \"CHAT\",\n          \"feedbackEnabledFlag\": feedbackEnabledFlag,\n          \"approvalEnabledFlag\": characteristic && Object.hasOwn(characteristic, 'approvalEnabledFlag') ? characteristic.approvalEnabledFlag : true,\n          \"loopBackNodeId\": loopbackNodeId,\n          \"maxIterations\":  characteristic && characteristic.maxIterations ? characteristic.maxIterations : 0,\n          \"name\": node.name || \"Human Approval\"\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code || 'HA_NODE',\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"value\": {\n              \"messageTemplate\": {\n                \"message\": message,\n              },\n              \"requestChangeMessage\": characteristic && characteristic.requestChangeMessage ? characteristic.requestChangeMessage : \"\"\n            },\n            \"name\": \"chatChannelInput\",\n            \"type\": \"object\"\n          }\n        ],\n        \"type\": \"HUMAN\"\n      }\n    } else if (node.node_type == $context.$variables.nodeTypes.LOOP || node.node_type == $context.$variables.nodeTypes.WHILE) {    \n      const endNodeId = `end_17647127445${uniqueNodeIndex}`;\n      const startNodeId = `start_17647127445${uniqueNodeIndex}`;\n      const name = node.name || 'Loop node';\n      const isLoop = node.node_type == $context.$variables.nodeTypes.LOOP;\n      pipeLineNode = {\n        \"metadata\": {\n          \"dataPipeline\": {\n            \"pipelineNodes\": [],\n            \"rootNode\": startNodeId\n          },\n          \"loopType\": characteristic && characteristic.loopType ? characteristic.loopType : \"SEQUENTIAL\",\n          \"name\": name,\n        },\n        \"outcomes\": {\n          \"success\": endNode\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"inputs\": [\n          {\n            \"id\": `${pipelineId}_1`,\n            \"name\": isLoop ?  \"collection\" : \"condition\",\n            \"type\": \"string\",\n            \"value\": isLoop ? (firstInputValue ? firstInputValue : \"{{[]}}\") : condition,\n          }\n        ],\n        \"type\": node.node_type\n      }\n      const varName = `Current item for loop \"${name}\"`;\n      const newParentVariables = (parentVariables || []) .concat([{name: varName, value: `{{$context.$nodes.${node.referencePath}.$currentItem}}`}]);\n\n      const newPipeline = [ {\n        \"metadata\": {\n          \"name\": \"Start\",\n          \"description\": \"Start of data pipeline\"\n        },\n        \"outcomes\": {\n          \"success\": endNodeId, //update\n        },\n        \"id\": startNodeId,\n        \"code\": \"START_1771619386325\",\n        \"type\": \"START\",\n      }];\n      processPipelines.push({\n        nodes: node.children,\n        prefixIndex: `LOOP_${uniqueNodeIndex}`,\n        endNode: endNodeId, \n        pipeLineNode,\n        parentNode: node,\n        hasParentLoop: true,\n        parentPipeline: newPipeline, // To pass to true/false for parentage\n        pipeline: newPipeline,\n        parentVariables: newParentVariables,\n        endPipeline: {\n          \"metadata\": {\n            \"name\": \"End\",\n            \"description\": \"End of data pipeline\"\n          },\n          \"id\": endNodeId,\n          \"code\": \"END_1771619386325\",\n          \"type\": \"END\"\n        },\n      });\n\n    } else if (node.node_type == $context.$variables.nodeTypes.IF) {\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || `If node ${uniqueNodeIndex}`,\n        },\n        \"outcomes\": {\n          \"true\": \"\",\n          \"false\": \"\"\n        },\n        \"code\": node.code || `if_node_${uniqueNodeIndex}`,\n        \"id\": pipelineId,\n        \"convergenceTargetId\": endNode,\n        \"inputs\": [\n          {\n            \"id\": `${pipelineId}_1`,\n            \"name\": \"condition\",\n            \"type\": \"string\",\n            \"value\": condition,\n          }\n        ],\n        \"type\": \"CONDITION\"\n      }\n      currentPipeline.push(pipeLineNode);\n      node.updateEndNode = [];\n      node.childPipelines = [];\n      if (node.false && node.false.length) {\n        const falsePipeline = {\n          nodes: node.false,\n          prefixIndex: `FALSE_${uniqueNodeIndex}`,\n          endNode: endNode, \n          pipeLineNode,\n          parentNode: node,\n          hasParentLoop,\n          parentPipeline: childPipeline.parentPipeline || pipeline,\n          pipeline: [ ],\n          isTrue: false,\n        };\n        processPipelines.push(falsePipeline);\n        node.childPipelines.push(falsePipeline);\n      } else {\n        currentPipeline.push({\n          \"metadata\": {\n            \"description\": \"Add node for false branch\",\n            \"name\": \"Add (False Branch)\"\n          },\n          \"outcomes\": {\n            \"success\": endNode\n          },\n          \"id\": `add_false_17647127445${uniqueNodeIndex}`,\n          \"inputs\": [],\n          \"type\": \"ADD\"\n        });\n        node.updateEndNode.push(currentPipeline[currentPipeline.length - 1]);\n        pipeLineNode.outcomes.false = `add_false_17647127445${uniqueNodeIndex}`;\n      }\n      if (node.true && node.true.length) {\n        const truePipeline = {\n          nodes: node.true,\n          prefixIndex: `TRUE_${uniqueNodeIndex}`,\n          endNode: endNode, \n          pipeLineNode,\n          parentNode: node,\n          hasParentLoop,\n          parentPipeline: childPipeline.parentPipeline || pipeline,\n          pipeline: [ ],\n          isTrue: true,\n        };\n        processPipelines.push(truePipeline); \n        node.childPipelines.push(truePipeline);\n      } else {\n        currentPipeline.push({\n          \"metadata\": {\n            \"description\": \"Add node for true branch\",\n            \"name\": \"Add (True Branch)\"\n          },\n          \"outcomes\": {\n            \"success\": endNode\n          },\n          \"id\": `add_true_17647127445${uniqueNodeIndex}`,\n          \"inputs\": [],\n          \"type\": \"ADD\"\n        });\n        node.updateEndNode.push(currentPipeline[currentPipeline.length - 1]);\n        pipeLineNode.outcomes.true = `add_true_17647127445${uniqueNodeIndex}`;\n      }\n\n    } else if (node.node_type == $context.$variables.nodeTypes.SWITCH || node.node_type == $context.$variables.nodeTypes.PARALLEL) {\n      const isSwitch = node.node_type == $context.$variables.nodeTypes.SWITCH;\n      pipeLineNode = {\n        \"metadata\": {\n          \"name\": node.name || (isSwitch ? 'Switch' : 'Parallel'),\n        },\n        \"outcomes\": {\n        },\n        \"code\": node.code,\n        \"id\": pipelineId,\n        \"convergenceTargetId\": endNode,\n        \"inputs\": isSwitch ? [\n          {\n            \"id\": `${pipelineId}_1`,\n            \"name\": \"caseExpression\",\n            \"type\": \"string\",\n            \"value\": firstInputValue || \"{{}}\"\n          }\n        ] : [],\n        \"type\": node.node_type,\n      }\n      currentPipeline.push(pipeLineNode);\n      \n      node.updateEndNode = [];\n      node.childPipelines = [];\n      for (const childIndex of Object.keys(node.childrenObject)) {\n        const children = node.childrenObject[childIndex];\n        if (children.length) {\n          const childObjectPipeline = {\n            nodes: children,\n            prefixIndex: `CHILD_${childIndex}_${uniqueNodeIndex}`,\n            endNode: endNode, \n            pipeLineNode,\n            parentNode: node,\n            hasParentLoop,\n            parentPipeline: childPipeline.parentPipeline || pipeline,\n            pipeline: [ ],\n            isTrue: false,\n            childIndex,\n          };\n          processPipelines.push(childObjectPipeline);\n          node.childPipelines.push(childObjectPipeline);\n        } else {\n          const addNode = {\n            \"metadata\": {\n              \"description\": \"Add node\",\n              \"name\": \"Add\"\n            },\n            \"outcomes\": {\n              \"success\": endNode\n            },\n            \"id\": `add_switch_17647127445${uniqueNodeIndex}`,\n            \"inputs\": [],\n            \"type\": \"ADD\"\n          };\n          currentPipeline.push(addNode);\n          node.updateEndNode.push(addNode);\n          pipeLineNode.outcomes[childIndex] = addNode.id;\n        }\n      }\n\n    }\n\n\n    // Set true/false outcomes\n    node.pipeLineNode = pipeLineNode;\n    const multiConditionTypes = ['CONDITION', 'SWITCH', 'PARALLEL'];\n    const previousIsNotMultiConditionType = previousPipelineEntry && multiConditionTypes.indexOf(previousPipelineEntry.type) === -1;\n    if (multiConditionTypes.indexOf(pipeLineNode.type) === -1) {\n      currentPipeline.push(pipeLineNode);\n    }\n    if (pipeLineNode && previousPipelineEntry && previousIsNotMultiConditionType) {\n      previousPipelineEntry.outcomes = {\"success\": pipeLineNode.id};\n    }\n    if (previousNode && !previousIsNotMultiConditionType) {\n      previousNode.pipeLineNode.convergenceTargetId = pipeLineNode.id;\n      for (const innerPipeline of previousNode.childPipelines) {\n        innerPipeline.endNode = pipeLineNode.id;\n      }\n      for (const updateEndNode of previousNode.updateEndNode) {\n        updateEndNode.outcomes.success = pipeLineNode.id;\n      }\n    }\n    previousPipelineEntry = pipeLineNode;\n    previousNode = node; \n  }\n  /**\n   *  Insert the pipeline into the correct place in the parent pipeline. \n   * \n   * If Loop, insert into the metadata\n   * If IF condition, insert it after the parent node of parent pipeline\n   */\n  const parentPipelineNode = childPipeline.pipeLineNode;\n  const parentNode = childPipeline.parentNode;\n  if (childPipeline && parentPipelineNode) {\n    if (childPipeline && (parentNode.node_type == $context.$variables.nodeTypes.LOOP || parentNode.node_type == $context.$variables.nodeTypes.WHILE)) {\n      currentPipeline.push(childPipeline.endPipeline);\n      parentPipelineNode.metadata.dataPipeline.pipelineNodes = currentPipeline;\n    }\n    if (parentPipelineNode && childPipeline && childPipeline.parentNode.node_type == $context.$variables.nodeTypes.IF) {\n      // If Node, set success\n      if (childPipeline.isTrue) {\n        parentPipelineNode.outcomes.true = currentPipeline[0].id;\n      } else {\n        parentPipelineNode.outcomes.false = currentPipeline[0].id;\n      }\n      if (parentPipelineNode.outcomes.true === parentPipelineNode.outcomes.false) {\n        parentPipelineNode.broken = true;\n        parentPipelineNode.temptitle =currentPipeline[0]; // todo temp \n      }\n      const parentPipeline = childPipeline.parentPipeline;\n      let pipelinePlace = parentPipeline.indexOf(parentPipelineNode);\n      for (const newItem of currentPipeline) {\n        parentPipeline.splice(pipelinePlace + 1 , 0, newItem);\n        pipelinePlace++;\n      }\n    } else if (parentPipelineNode && childPipeline && (childPipeline.parentNode.node_type === $context.$variables.nodeTypes.SWITCH || childPipeline.parentNode.node_type === $context.$variables.nodeTypes.PARALLEL)) {\n      parentPipelineNode.outcomes[childPipeline.childIndex] = currentPipeline[0].id;\n      const parentPipeline = childPipeline.parentPipeline;\n      let pipelinePlace = parentPipeline.indexOf(parentPipelineNode);\n      for (const newItem of currentPipeline) {\n        parentPipeline.splice(pipelinePlace + 1 , 0, newItem);\n        pipelinePlace++;\n      }\n    }\n  }\n}\n\nconst lastNode = pipeline[pipeline.length - 1];\nif (lastNode) {\n  if (lastNode.type === 'BO_FUNCTION') {\n    errorNodeId = '1767727720773';\n    lastNode.outcomes.success = '1767727606282';\n    lastNode.metadata.errorNodeId = errorNodeId;\n    pipeline.push({\n      \"metadata\": {\n        \"name\": \"If Valid Response\"\n      },\n      \"outcomes\": {\n        \"true\": \"1767727657170\",\n        \"false\": \"1767727720773\",\n      },\n      \"code\": \"IF_VALID_RESPONSE\",\n      \"convergenceTargetId\": \"end\",\n      \"id\": \"1767727606282\",\n      \"inputs\": [\n        {\n          \"id\": \"1767727606286_1\",\n          \"name\": \"condition\",\n          \"type\": \"string\",\n          \"value\": `{{!!$context.$nodes.${lastNode.code}.$output}}`\n        }\n      ],\n      \"type\": \"CONDITION\"\n    });\n    pipeline.push({\n      \"metadata\": {\n        \"modelConfiguration\": {\n          \"modelProperties\": {},\n          \"code\": \"ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI\",\n          \"model\": \"OCI_GPT_5_MINI\",\n          \"provider\": \"CERT_PREMIUM\"\n        },\n        \"name\": 'Final output'\n      },\n      \"outcomes\": {\n        \"success\": \"end\"\n      },\n      \"code\": 'final_output',\n      \"id\": \"1767727657170\",\n      \"inputs\": [\n        {\n          \"id\": \"1765399047989_1\",\n          \"name\": \"prompt\",\n          \"type\": \"string\",\n          value: `Take this output: {{$context.$nodes.${lastNode.code}.$output}} \\nProvide a human readable summary.`,\n        }\n      ],\n      \"type\": \"LLM\"\n    });\n\n\n    pipeline.push({\n      \"metadata\": {\n        \"name\": \"Error Handler\"\n      },\n      \"outcomes\": {\n        \"success\": \"end\"\n      },\n      \"code\": \"ERROR_HANDLER\",\n      \"id\": errorNodeId,\n      \"inputs\": [\n        {\n          \"id\": \"1767727720776_1\",\n          \"name\": \"prompt\",\n          \"type\": \"string\",\n          \"value\": \"Format error for user, keep it fairly simple.  \\n\\n error: {{$context.$error.$errorMessage}} \"\n        }\n      ],\n      \"type\": \"LLM\"\n    });\n\n  } else if (lastNode.type == $context.$variables.nodeTypes.LOOP || lastNode.type == $context.$variables.nodeTypes.WHILE) {\n\n    lastNode.outcomes.success = '1767727606282';\n    pipeline.push({\n      \"metadata\": {\n        \"modelConfiguration\": {\n          \"modelProperties\": {},\n          \"code\": \"ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI\",\n          \"model\": \"OCI_GPT_5_MINI\",\n          \"provider\": \"CERT_PREMIUM\"\n        },\n        \"name\": 'Final output'\n      },\n      \"outcomes\": {\n        \"success\": \"end\"\n      },\n      \"code\": 'final_output',\n      \"id\": \"1767727606282\",\n      \"inputs\": [\n        {\n          \"id\": \"1765399047989_1\",\n          \"name\": \"prompt\",\n          \"type\": \"string\",\n          \"value\": `Iterate over the results of  {{$context.$nodes.${lastNode.code}.$output}}  and provide a human readable summary.`,\n        }\n      ],\n      \"type\": \"LLM\"\n    });\n  }\n  if (!errorNodeId && pipelineNodesToSetErrorNode.length) {\n    \n    errorNodeId = '1767727720773';\n    pipeline.push({\n      \"metadata\": {\n        \"name\": \"Error Handler\"\n      },\n      \"outcomes\": {\n        \"success\": \"end\"\n      },\n      \"code\": \"ERROR_HANDLER\",\n      \"id\": errorNodeId,\n      \"inputs\": [\n        {\n          \"id\": \"1767727720776_1\",\n          \"name\": \"prompt\",\n          \"type\": \"string\",\n          \"value\": \"Format error for user, keep it fairly simple.  \\n\\n error: {{$context.$error.$errorMessage}} \"\n        }\n      ],\n      \"type\": \"LLM\"\n    });\n  }\n}\n\nfor (const pipeNode of pipelineNodesToSetErrorNode) {\n  pipeNode.metadata.errorNodeId = errorNodeId;\n}\n\npipeline.push(\n  {\n    \"metadata\": {\n      \"name\": \"End\",\n      \"description\": \"End of data pipeline\"\n    },\n    \"code\": \"END\",\n    \"outcomes\": {},\n    \"inputs\": [],\n    \"id\": \"end\",\n    \"type\": \"END\"\n});\n\nconst ret = {restTriggers, pipeline, chatExpLocalFileUploadEnabledFlag, variables, includeEmailTrigger, outputsReplacements};\n\nret;"
          },
