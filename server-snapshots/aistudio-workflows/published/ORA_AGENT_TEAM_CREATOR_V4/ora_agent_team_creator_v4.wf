        {
          "metadata": {
            "name": "Process External Rest Toys",
            "returnType": "array",
            "sourceCode": "let toolsFromRest;\ntry {\n  toolsFromRest = JSON.parse($context.$nodes.EXTERNAL_REST_TOOLS.$output.output );\n} catch(err) {\n\n}\n\nconst minExternalRestTools = {};\nconst toolsByToolCode = {};\nif (toolsFromRest && toolsFromRest) {\n  for (const tool of toolsFromRest) {\n    try {\n      tool.Specification = JSON.parse(tool.Specification);\n    } catch (err) {\n    }\n    toolsByToolCode[tool.ToolCode] = tool;\n    tool.functionByName = {};\n    const minTool = {\n      ToolCode: tool.ToolCode,\n      ToolId: tool.ToolId,\n      Description: tool.Description,\n      Name: tool.Name,\n      Functions: [],\n    }\n    if (tool.Specification && tool.Specification.externalRestMetadata && tool.Specification.externalRestMetadata.endpoints) {\n      for (const endpoint of tool.Specification.externalRestMetadata.endpoints) {\n        minTool.Functions.push({\n          name: endpoint.name,\n          description: endpoint.description,\n          operationType: endpoint.operationType,\n          parameterDefinitions: endpoint.parameterDefinitions,\n        });\n        tool.functionByName[endpoint.name] = endpoint;\n        const matchKey = tool.ToolCode + ':' + endpoint.name;\n        minExternalRestTools[tool.ToolCode + ':' + endpoint.name] = {\n          matchKey,\n          name: endpoint.name,\n          description: endpoint.description,\n          operationType: endpoint.operationType,\n          parameterDefinitions: endpoint.parameterDefinitions,\n          tool: {\n            ToolCode: tool.ToolCode,\n            ToolId: tool.ToolId,\n            Description: tool.Description,\n            Name: tool.Name,\n          }\n        }\n      }\n    } \n    if (minTool.Functions.length) {\n    }\n  }\n}\nconst ret = {minExternalRestTools, toolsByToolCode};\n\nreturn ret;"
          },
          "outcomes": {
            "success": "1778269301038"
          },
          "code": "PROCESS_EXTERNAL_REST_TOYS",
          "convergenceTargetId": "1778269301038",
          "id": "1778269098486",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
