        {
          "metadata": {
            "name": "humanReadablePipeline",
            "returnType": "string",
            "sourceCode": "let txt = '<ol>';\nconst plan = $context.$variables.plan ;\nconst includeEmailTrigger = $context.$nodes.CREATE_PIPELINE.$output.result.includeEmailTrigger;\n\nconst nodes = JSON.parse(JSON.stringify(plan.nodes));\nconst codeToPipelineNode = {};\nconst process = [...$context.$nodes.CREATE_PIPELINE.$output.result.pipeline];\nwhile (process.length) {\n  const pipeLineNode = process.shift();\n  codeToPipelineNode[pipeLineNode.code] = pipeLineNode;\n  if (pipeLineNode.metadata && pipeLineNode.metadata.dataPipeline && pipeLineNode.metadata.dataPipeline.pipelineNodes ) {\n    process.push(...pipeLineNode.metadata.dataPipeline.pipelineNodes );\n  }\n}\n\nif (includeEmailTrigger) {\n  txt += 'Email triggers steps (Set up email account prior to using) \\n'\n}\n\nwhile (nodes.length) {\n  const node = nodes.shift();\n  const description = node.description || node.characteristic;\n  if (node.isFirstNode) {\n    if (node.stepLabel) {\n      txt += `<br><p>${node.stepLabel}</p>`;\n    }\n    txt += '<ol>';\n  }\n  txt += '<li>';\n  let skipEndLi = false;\n  if (node.node_type == $context.$variables.nodeTypes.BOF) {\n    const bof = node.businessObjectFunction;\n\n    const boName = bof && bof.BusinessObjectName ? bof.BusinessObjectName : '';\n    const name = bof && bof.FunctionName ? bof.FunctionName : ' unknown';\n    txt += `Call to business object ${boName} Function ${name} \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.ETOOL) {\n    txt += `External Rest Call: ${description} \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.LLM) {\n    txt += `LLM Call: ${description} \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.VARS) {\n    txt += `Set Variables: ${description} \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.WAIT) {\n    txt += `Wait  \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.HA) {\n    txt += `Human Approval: ${description}\\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.RETURN) {\n    txt += `Return to user: ${description}\\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.EMAIL) {\n    if (node.email) { \n      txt += ` Send an email to ${node.email}  \\n`;\n    } else {\n      txt += ` Send an email: ${description} \\n`;\n     }\n  } else if (node.node_type == $context.$variables.nodeTypes.RAG) {\n    const ragTool = node.ragTool;\n\n    const name = ragTool && ragTool.Name ? ragTool.Name : ' [blank]';\n    txt += `Call to Rag Document processor ${name} \\n`;\n\n  } else if (node.node_type == $context.$variables.nodeTypes.CODE) {\n    const purpose = node.codeNodeUseCase === 'COMBINE_OBJECT' ? 'combine object' : 'parse JSON';\n    txt += `Code node to ${purpose} \\n`;\n\n  } else if (node.node_type == $context.$variables.nodeTypes.FILE_ATTACHMENT) {\n    txt += ` Process File Upload \\n`;\n  } else if (node.node_type == $context.$variables.nodeTypes.SWITCH || node.node_type == $context.$variables.nodeTypes.PARALLEL) {\n    const isSwitch =  node.node_type == $context.$variables.nodeTypes.SWITCH;\n    const label = node.node_type == $context.$variables.nodeTypes.SWITCH ? \"Switch\" : \"Parallel\";\n    if (isSwitch && codeToPipelineNode[node.code]) {\n      txt += `${label} ${codeToPipelineNode[node.code].inputs[0].value}\\n`; \n    } else {\n      txt += `${label}\\n`; \n    }\n    skipEndLi = true;\n    const childrenIndexes = Object.keys(node.childrenObject);\n    for (const childIndex of childrenIndexes) {\n      const children = node.childrenObject[childIndex];\n      const reverseNodes =  children.reverse();\n      children[0].isFirstNode = true;\n      children[children.length - 1].isLastNode = true;\n      for (const index in reverseNodes) {\n        const innerNode = reverseNodes[index];\n        innerNode.index = reverseNodes.length - index;\n        nodes.unshift(innerNode);\n      }\n    }\n    if (node.isLastNode) {\n      const lastKey = childrenIndexes[0]; // revesered\n      const lastChildObject = node.childrenObject[lastKey];\n      lastChildObject[lastChildObject.length - 1].endOlNumber = (node.endOlNumber || 0) + 1;\n      node.isLastNode = false;\n    }\n  } else if (node.node_type == $context.$variables.nodeTypes.IF) {\n    skipEndLi = true;\n    if (codeToPipelineNode[node.code]) {\n      txt += ` IF Condition. ${codeToPipelineNode[node.code].inputs[0].value} \\n`; \n    } else {\n      txt += ` IF Condition.  \\n`; \n    }\n    if (node.false && node.false.length) { \n      node.false[0].isFirstNode = true;\n      node.false[0].stepLabel = 'If False';\n      node.false[node.false.length - 1].isLastNode = true;\n      if (node.isLastNode) {\n        node.false[node.false.length - 1].endOlNumber = (node.endOlNumber || 0) + 1;\n        node.isLastNode = false;\n      }\n\n      const reverseNodes =  node.false.reverse();\n      for (const index in reverseNodes) {\n        const innerNode = reverseNodes[index];\n        innerNode.index = reverseNodes.length - index;\n        nodes.unshift(innerNode);\n      }\n    } \n    if (node.true && node.true.length) { \n      node.true[0].isFirstNode = true;\n      node.true[0].stepLabel = 'If True';\n      node.true[node.true.length - 1].isLastNode = true;\n      const reverseNodes =  node.true.reverse();\n      for (const index in reverseNodes) {\n        const innerNode = reverseNodes[index];\n        innerNode.index = reverseNodes.length -index;\n        nodes.unshift(innerNode);\n      }\n      if (!node.false || !node.false.length) { \n        node.true[node.true.length - 1].endOlNumber = (node.endOlNumber || 0) + 1;\n        node.isLastNode = false;\n      }\n    }\n  }\n  else if (node.node_type == $context.$variables.nodeTypes.LOOP || node.node_type == $context.$variables.nodeTypes.WHILE) {\n    const label = node.node_type == $context.$variables.nodeTypes.LOOP ? 'Loop' : 'While';\n    txt += ` ${label} Condition.  \\n`; \n    skipEndLi = true;\n    if (node.children && node.children.length) { \n      node.children[0].isFirstNode = true;\n      node.children[0].stepLabel = 'Children';\n      const lastNode = node.children[node.children.length - 1];\n      const reverseNodes =  node.children.reverse();\n\n      lastNode.isLastNode = true;\n      for (const index in reverseNodes) {\n        const innerNode = reverseNodes[index];\n        innerNode.index = reverseNodes.length - index;\n        nodes.unshift(innerNode);\n      }\n      if (node.isLastNode) {\n        lastNode.endOlNumber = (node.endOlNumber || 0) + 1;\n        node.isLastNode = false;\n      }\n    }\n  } \n  if (!skipEndLi) {\n    txt += '</li>';\n  }\n  if (node.isLastNode) {\n    txt += `</ol></li>`;\n    if (node.endOlNumber) {\n      for (let i = 0; i < node.endOlNumber; i++) {\n        txt += `</ol></li>`;\n      }\n    }\n  }\n}\ntxt += '</ol>';\n\nconst lastNode = plan.nodes[plan.nodes.length - 1];\nif (lastNode && lastNode.node_type == $context.$variables.nodeTypes.BOF) {\n  txt += `<li>Output results if successful otherwise output error </li>`;\n}\nif (lastNode && (lastNode.node_type == $context.$variables.nodeTypes.LOOP || lastNode.node_type == $context.$variables.nodeTypes.WHILE)) {\n  txt += `<li>Summarize results</li>`;\n}\ntxt += '</ol>'\nreturn txt;"
          },
