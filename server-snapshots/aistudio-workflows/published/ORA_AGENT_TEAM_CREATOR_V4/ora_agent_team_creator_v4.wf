n        /\\]\\}\\}\\]\\},\\{/g,\n        ']}}],\"false\":[{',\n      ),\n    ];\n    const trimOptions = [0, 1, 2, 3, 4];\n    const suffixOptions = ['', ']', '}', ']}', '}}', '}]', ']}}', '}]}', '}}]', '}]}}]'];\n\n    for (const candidateNodesSource of nodesCandidates) {\n      for (const trimCount of trimOptions) {\n        const trimmedNodes = candidateNodesSource.slice(0, Math.max(0, candidateNodesSource.length - trimCount));\n\n        for (const suffix of suffixOptions) {\n          try {\n            const nodes = JSON.parse(trimmedNodes + suffix);\n            return {\n              nodes,\n              ...rootFields,\n            };\n          } catch (error) {\n            // Try the next candidate repair.\n          }\n        }\n      }\n    }\n  } catch (error) {\n    return null;\n  }\n\n  return null;\n};\n\nfor (let attempt = 0; attempt < 10; attempt += 1) {\n  try {\n    parsedJson = JSON.parse(fixedJson);\n    parseError = null;\n    break;\n  } catch (error) {\n    parseError = error;\n    const positionMatch = String(error.message).match(/position (\\d+)/);\n    const errorPosition = positionMatch ? Number(positionMatch[1]) : -1;\n\n    if (\n      errorPosition >= 0 &&\n      fixedJson[errorPosition] === '{' &&\n      fixedJson.slice(Math.max(0, errorPosition - 2), errorPosition) === ']}'\n    ) {\n      fixedJson = fixedJson.slice(0, errorPosition) + '},' + fixedJson.slice(errorPosition);\n      continue;\n    }\n\n    if (\n      errorPosition >= 0 &&\n      fixedJson[errorPosition] === ']' &&\n      fixedJson.slice(errorPosition, errorPosition + 18) === '],\"characteristic\"'\n    ) {\n      fixedJson = fixedJson.slice(0, errorPosition) + '}' + fixedJson.slice(errorPosition);\n      continue;\n    }\n\n    if (errorPosition >= 0 && fixedJson[errorPosition] === ']') {\n      fixedJson = fixedJson.slice(0, errorPosition) + '}' + fixedJson.slice(errorPosition);\n      continue;\n    }\n\n    if (errorPosition >= 0) {\n      try {\n        const parsedPrefix = JSON.parse(fixedJson.slice(0, errorPosition));\n        const suffix = fixedJson.slice(errorPosition).replace(/^,/, '');\n        const rootFieldIndexes = [\n          suffix.indexOf(',\"variables\":'),\n          suffix.indexOf(',\"canBeTranslated\":'),\n        ].filter((index) => index !== -1).sort((left, right) => left - right);\n        const firstRootFieldIndex = rootFieldIndexes.length ? rootFieldIndexes[0] : -1;\n\n        if (\n          parsedPrefix &&\n          Array.isArray(parsedPrefix.nodes) &&\n          suffix.startsWith('{\"node_type\"') &&\n          suffix.endsWith(']}')\n        ) {\n          const trailingNode = JSON.parse(suffix.slice(0, -2));\n          parsedPrefix.nodes.push(trailingNode);\n          parsedJson = parsedPrefix;\n          parseError = null;\n          break;\n        }\n\n        if (\n          parsedPrefix &&\n          Array.isArray(parsedPrefix.nodes) &&\n          suffix.startsWith('{') &&\n          firstRootFieldIndex !== -1\n        ) {\n          const trailingNode = JSON.parse(\n            suffix\n              .slice(0, firstRootFieldIndex)\n              .replace(/\\]+$/, '')\n              .replace(/,+$/, '')\n              .replace(/\\}$/, '')\n            + '}',\n          );\n          const trailingRootFields = JSON.parse('{' + suffix.slice(firstRootFieldIndex + 1));\n\n          parsedPrefix.nodes.push(trailingNode);\n          Object.assign(parsedPrefix, trailingRootFields);\n          parsedJson = parsedPrefix;\n          parseError = null;\n          break;\n        }\n      } catch (innerError) {\n        // Continue to the original error when this fallback does not apply.\n      }\n    }\n\n    const salvagedRootObject = salvageRootObject(fixedJson);\n    if (salvagedRootObject) {\n      parsedJson = salvagedRootObject;\n      parseError = null;\n      break;\n    }\n\n    throw error;\n  }\n}\n\nif (parseError) {\n  throw parseError;\n}\n\nconst normalizeBranches = (value) => {\n  if (!value || typeof value !== 'object') {\n    return;\n  }\n\n  if (Array.isArray(value)) {\n    for (const item of value) {\n      normalizeBranches(item);\n    }\n\n    return;\n  }\n\n  if (value.characteristic && typeof value.characteristic === 'object' && !Array.isArray(value.characteristic)) {\n    for (const branchName of ['true', 'false']) {\n      if (Array.isArray(value[branchName]) && !Array.isArray(value.characteristic[branchName])) {\n        value.characteristic[branchName] = value[branchName];\n        delete value[branchName];\n      }\n    }\n  }\n\n  for (const nestedValue of Object.values(value)) {\n    normalizeBranches(nestedValue);\n  }\n};\n\nnormalizeBranches(parsedJson);\n\nreturn parsedJson;"
