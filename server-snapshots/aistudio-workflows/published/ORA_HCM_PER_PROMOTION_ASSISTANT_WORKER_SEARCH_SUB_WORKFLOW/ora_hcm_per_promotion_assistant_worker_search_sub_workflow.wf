        {
          "metadata": {
            "name": "analyseWorkerSearchResponse",
            "returnType": "object",
            "sourceCode": "var itemsArray = $context.$nodes.SEARCH_WORKER_BY_NAME.$output.items;\nvar targetName = $context.$variables.DisplayName;\n\nvar returnObject = {\n  singleMatchPresent: false,\n  noRecordsFound: false,\n  partialMatchesPresent: false\n};\n\nif (!itemsArray || itemsArray.length === 0) {\n  returnObject.noRecordsFound = true;\n  return returnObject;\n}\n\n// Exact matches\nvar exactMatches = itemsArray.filter(function(item) {\n  return item.DisplayName === targetName;\n});\n\nif (exactMatches.length === 1) {\n  returnObject.singleMatchPresent = true;\n  returnObject.singleMatchingRecord = exactMatches[0];\n}\nelse if (exactMatches.length > 1) {\n  returnObject.partialMatchesPresent = true;\n  returnObject.partialMatchingRecords = exactMatches;\n}\nelse {\n    returnObject.partialMatchesPresent = true;\n    returnObject.partialMatchingRecords = itemsArray;\n}\n\nreturn returnObject;"
          },
          "outcomes": {
            "success": "1765799014811"
          },
          "code": "ANALYSEWORKERSEARCHRESPONSE",
          "id": "1776239416269",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Analyse Response For Assignment Number",
            "returnType": "object",
            "sourceCode": "var response = $context.$nodes.SEARCH_BY_ASSIGNMENT_NUMBER.$output;\nvar targetAssignmentNumber = $context.$variables.AssignmentNumber;\n\nvar returnObject = {\n  singleMatchPresent: false\n};\n\nvar itemsArray = response && response.items ? response.items : [];\n\n// Filter exact matches\nvar matches = itemsArray.filter(function(item) {\n  return item.AssignmentNumber === targetAssignmentNumber;\n});\n\n// Check if exactly one match exists\nif (matches.length === 1) {\n  returnObject.singleMatchPresent = true;\n  returnObject.singleMatchingRecord = matches[0];\n}\n\nreturn returnObject;"
          },
          "outcomes": {
            "success": "1765799065576"
          },
          "code": "ANALYSE_RESPONSE_FOR_ASSIGNMENT_NUMBER",
          "id": "1776247096556",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
