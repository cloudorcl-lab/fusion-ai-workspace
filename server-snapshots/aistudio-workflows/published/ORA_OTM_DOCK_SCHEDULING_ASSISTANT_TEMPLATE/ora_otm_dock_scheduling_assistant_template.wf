        {
          "metadata": {
            "name": "Get byType",
            "returnType": "string",
            "sourceCode": "var shipmentGid = $context.$variables.shipmentGid; \nvar stopNum = $context.$variables.stopNum;\nvar locationGid = $context.$variables.locationGid;\nvar shipmentReferenceNumber = $context.$variables.shipmentReferenceNumber;\nvar shipmentReferenceQualifier = $context.$variables.shipmentReferenceQualifier;\nvar locationResourceGroupGid = $context.$variables.locationResourceGroup;\nvar primaryResource = $context.$variables.resourceGidFromPrimaryResourceType;\nvar localStart = $context.$variables.localStart;\nvar localEnd = $context.$variables.localEnd;\n\n// ---- helpers ----\nconst present = (value) => value !== null && value !== undefined && value !== \"\";\n\nconst referencePresent =\n  present(shipmentReferenceNumber) && present(shipmentReferenceQualifier);\n\nconst timeWindowPresent =\n  present(localStart) && present(localEnd);\n\nconst resourceGroupPresent =\n  present(locationResourceGroupGid);\n\nconst primaryResourcePresent = present(primaryResource);\n\n// ---- STEP 1: BASE TYPE ----\nlet base;\n\nif (present(shipmentGid) && present(stopNum)) {\n  base = \"ID_STOPNUM\";\n} else if (referencePresent && present(stopNum)) {\n  base = \"REFERENCE_STOPNUM\";\n} else if (referencePresent && present(locationGid)) {\n  base = \"REFERENCE_LOCATION\";\n} else if (referencePresent) {\n  base = \"REFERENCE_LOCATION\";\n} else {\n  base = \"ID_STOPNUM\";\n}\n\n// ---- STEP 2: MODIFIER ----\nif (primaryResourcePresent) { // always requires time window, so check separately\n  return base; // this is a separate check in the code, so no need to add modifier\n}\nelse if (resourceGroupPresent) { // always requires time window, so check separately\n  return `${base}_RESOURCEGROUP`;\n}\nelse if (timeWindowPresent) {\n  return `${base}_TIMEWINDOW`;\n} else {\n  return base;\n}"
          },
          "outcomes": {
            "success": "1777041290342"
          },
          "code": "GET_BYTYPE",
          "id": "1776972216286",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If Includes Location Resource Type GID"
          },
          "outcomes": {
            "true": "1777045845889",
            "false": "1773770722365"
          },
          "code": "IF_INCLUDES_LOCATION_RESOURCE_TYPE_GID",
