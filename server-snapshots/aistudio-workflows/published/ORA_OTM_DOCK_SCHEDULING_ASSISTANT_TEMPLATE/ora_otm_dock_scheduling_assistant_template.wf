                      "value": "Extract the following info from the returned JSON:\n\n{{$context.$nodes.WHILE_SEARCHING_THRU_EACH_STOP.GET_CURR_STOP_LOCATION.$output.locationXid}}"
                    }
                  ],
                  "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"locationXid\": {\n            \"type\": \"string\"\n        }\n    }\n}",
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Set All Stopnum Locations",
                    "returnType": "array",
                    "sourceCode": "var loc_arr = $context.$variables.stopNumsWithLocation;\nvar curr_loc = $context.$nodes.WHILE_SEARCHING_THRU_EACH_STOP.EXTRACT_LOCATION_INFO.$output.locationXid;\n\nconst shipment = $context.$variables.shipmentGid;\nconst domain = shipment.substring(0, shipment.indexOf(\".\"));\n\nvar curr_loc = domain + \".\" + curr_loc;\n\nif (loc_arr == null || loc_arr.length === 0) {\n        var loc_arr = [ curr_loc ];\n}  else {\n        loc_arr.push(curr_loc );\n}\n\nreturn loc_arr;"
                  },
                  "outcomes": {
                    "success": "1775239563570"
                  },
                  "code": "SET_LOCATION_STOPNUMS",
