          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Add domain to primaryResourceTypeGid",
            "returnType": "string",
            "sourceCode": "var primaryResource = $context.$variables.resourceGidFromPrimaryResourceType;\nvar shipmentGid = $context.$variables.shipmentGid;\nvar referenceQual = $context.$variables.shipmentReferenceQualifier\nvar locationResourceGroup  = $context.$variables.locationResourceGroup ;\nif (primaryResource.includes(\".\")) {\n    return primaryResource\n}\nif (shipmentGid) {\n    var domain = shipmentGid.substring(0, shipmentGid.indexOf(\".\"));\n    return domain + \".\" + primaryResource\n}\nif (referenceQual) {\n    var domain = referenceQual.substring(0, referenceQual.indexOf(\".\"));\n    return domain + \".\" + primaryResource\n}\nif (locationResourceGroup) {\n    var domain = locationResourceGroup.substring(0, locationResourceGroup.indexOf(\".\"));\n    return domain + \".\" + primaryResource\n}"
          },
          "outcomes": {
            "success": "1777046148871"
          },
          "code": "ADD_DOMAIN_TO_PRIMARYRESOURCETYPEGID",
          "id": "1777045845889",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
