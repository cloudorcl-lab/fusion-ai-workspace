{
  "workflowId": "300000331058567",
  "workflowCode": "ORA_OTM_DOCK_SCHEDULING_ASSISTANT_TEMPLATE",
  "name": "OTM Dock Scheduling Assistant",
  "description": "Assists dock appointment scheduling, modification, cancellation, and lookup for OTM/GTM shipments by extracting and reconciling shipment/appointment identifiers, prompting for missing details, resolving stop-location ambiguities, validating identifier strategy, requesting approval before changes, and presenting appointment options and details in a clear, user-friendly format.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
