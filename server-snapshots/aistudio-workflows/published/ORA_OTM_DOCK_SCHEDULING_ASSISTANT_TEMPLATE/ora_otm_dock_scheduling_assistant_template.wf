        {
          "metadata": {
            "name": "Check Provided Info",
            "returnType": "boolean",
            "sourceCode": "const intent = $context.$variables.intent;\nconst appt_gid = $context.$variables.appointmentGid;\nconst shipment_gid = $context.$variables.shipmentGid;\nconst stop_num = $context.$variables.stopNum;\nconst location_gid = $context.$variables.locationGid;\nconst ref_qualifier = $context.$variables.shipmentReferenceQualifier;\nconst ref_number = $context.$variables.shipmentReferenceNumber;\nconst appt_start = $context.$variables.localStart;\nconst appt_end = $context.$variables.localEnd;\nconst location_resource_group = $context.$variables.locationResourceGroup;\nconst primary_resource = $context.$variables.resourceGidFromPrimaryResourceType;\n\n// add the required variables to each array for each intent type\nconst FIND_DETAILS = [\n    [appt_gid],\n    [shipment_gid, stop_num]\n];\n\nconst FIND_OPTIONS = [\n    [shipment_gid, stop_num],\n    [ref_number, ref_qualifier, stop_num],\n    [ref_number, ref_qualifier, location_gid]\n];\n\nif (location_resource_group || primary_resource) {\n    // user required to include time window with location_resource_group or primary_resource\n    var SCHEDULE = [\n        [shipment_gid, stop_num, appt_start, appt_end],\n        [ref_number, ref_qualifier, stop_num, appt_start, appt_end],\n        [ref_number, ref_qualifier, location_gid, appt_start, appt_end]\n    ];\n} else if (appt_start || appt_end) {\n    // if the user submits a time window, they must include both start and end of the time window\n    var SCHEDULE = [\n        [shipment_gid, stop_num, appt_start, appt_end],\n        [ref_number, ref_qualifier, stop_num, appt_start, appt_end],\n        [ref_number, ref_qualifier, location_gid, appt_start, appt_end]\n    ];\n} else {\n    var SCHEDULE = [\n        [shipment_gid, stop_num],\n        [ref_number, ref_qualifier, stop_num],\n        [ref_number, ref_qualifier, location_gid]\n    ];\n}\n\n\nconst MODIFY = [\n    [shipment_gid, stop_num, appt_start, appt_end],\n    [ref_number, ref_qualifier, stop_num, appt_start, appt_end],\n    [ref_number, ref_qualifier, location_gid, appt_start, appt_end]\n];\n\nconst CANCEL = [\n    [appt_gid],\n    [shipment_gid, stop_num],\n    [ref_number, ref_qualifier, stop_num],\n    [ref_number, ref_qualifier, location_gid]\n];\n\n// create a dictionary linking each of the intent types\nconst all_options = {\n    \"FIND_DETAILS\" : FIND_DETAILS,\n    \"FIND_OPTIONS\": FIND_OPTIONS,\n    \"SCHEDULE\": SCHEDULE,\n    \"MODIFY\": MODIFY,\n    \"CANCEL\": CANCEL\n};\n\n// find the required variables we need for this specific intent type\nconst required_variables = all_options[intent]\n\nfor (let i = 0; i < required_variables.length; i++) {\n    // since required_vars are broken up by multiple constraints it could fit\n    const variable_constraints = required_variables[i];\n    const has_null = variable_constraints.some(element => element == null);\n    if (has_null) continue;\n    return true;\n}\nreturn false;"
          },
          "outcomes": {
            "success": "1773765482718"
          },
          "code": "CHECK_PROVIDED_INFO",
