        {
          "metadata": {
            "name": "Get Stop Numbers",
            "returnType": "array",
            "sourceCode": "var stoplocations = $context.$variables.stopNumsWithLocation;\nvar locationGid = $context.$variables.locationGid;\nconst shipment = $context.$variables.shipmentGid;\nconst domain = shipment.substring(0, shipment.indexOf(\".\"));\n\nvar locationStopNums = []\n\nfor (const [index, value] of stoplocations.entries()) {\n    if (locationGid == value) {\n        locationStopNums.push(index+1)\n    } else if ((domain + \".\" + locationGid) == value) {\n        locationStopNums.push(index+1)\n    }\n}\n\nreturn locationStopNums"
          },
          "outcomes": {
            "success": "1776967266350"
          },
          "code": "GET_STOP_NUMBERS",
          "id": "1775245161551",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
