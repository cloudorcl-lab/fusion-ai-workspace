                    "returnType": "object",
                    "sourceCode": "var topObject = $context.$variables.topQuestionnairesObject;\nvar currentTierData = topObject[$context.$nodes.GETTINGTOPQUESTIONNAIRES.$currentItem];\nif (currentTierData)\n{\n    currentTierData.sort((a, b) => new Date(a.DueDate) - new Date(b.Date));\n    topObject[$context.$nodes.GETTINGTOPQUESTIONNAIRES.$currentItem] = currentTierData;\n}\nreturn topObject;"
