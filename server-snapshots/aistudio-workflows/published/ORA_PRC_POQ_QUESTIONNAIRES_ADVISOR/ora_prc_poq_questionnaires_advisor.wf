                    "sourceCode": "var allQs = $context.$variables.final6;\n\nvar supplierQs= allQs.filter(questnaire => (questnaire.QuestionnaireTypeCode === 'SUPPLIER') && \n(questnaire.SupplierId === $context.$nodes.FORLOOPOVERSUPPLIERCONTACTIDANDSUPPLIERIDTUPLE.$currentItem.SupplierId) &&  \n(questnaire.InitiativeSuppContactId === $context.$nodes.FORLOOPOVERSUPPLIERCONTACTIDANDSUPPLIERIDTUPLE.$currentItem.InitiativeSuppContactId));\n\nsupplierQs.forEach(obj => {\n  obj.SupplierContactEmail = $context.$nodes.FORLOOPOVERSUPPLIERCONTACTIDANDSUPPLIERIDTUPLE.GETSUPPLIERCONTACTEMAILSBASEDONSUPPCONTACTANDSUPP.$output.Email;\n});\n\nreturn allQs;"
