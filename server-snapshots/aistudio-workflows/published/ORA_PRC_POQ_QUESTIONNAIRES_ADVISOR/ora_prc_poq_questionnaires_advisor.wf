        {
          "metadata": {
            "name": "Determine distinct tiers",
            "returnType": "array",
            "sourceCode": "let distinctTiers = [];\n\nlet supplierData = $context.$nodes.PROCESS_SUPPLIER_DATA_FROM_CSV.$output.result;\n\ndistinctTiers = [...new Set(supplierData.map(supplier => supplier.SupplierTier))];\n\nreturn distinctTiers;"
          },
          "outcomes": {
            "success": "1776296519365"
          },
          "code": "DETERMINE_DISTINCT_TIERS",
          "id": "1776484022078",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5478.5,
            "y": 6800
          }
        },
        {
          "metadata": {
            "name": "CreateSupplierTiersMap",
            "returnType": "object",
            "sourceCode": "let supplierCSVData = $context.$nodes.PROCESS_SUPPLIER_DATA_FROM_CSV.$output.result;\nlet distinctTiers = $context.$nodes.DETERMINE_DISTINCT_TIERS.$output.result;\nlet allTierData ={};\nfor (const distinctTier of distinctTiers){\n    let tierSupplierData = supplierCSVData.filter(supplier => supplier.SupplierTier == distinctTier);\n    allTierData[distinctTier] = tierSupplierData;\n}\nreturn allTierData;\n\n\n//let tierASupplierData = supplierCSVData.filter(supplier => supplier.SupplierTier == 'Tier A');\n//let tierBSupplierData = supplierCSVData.filter(supplier => supplier.SupplierTier == 'Tier B');\n//let tierCSupplierData = supplierCSVData.filter(supplier => supplier.SupplierTier == 'Tier C');\n//let allTierData ={};\n//allTierData.tierASupplierData=tierASupplierData;\n//allTierData.tierBSupplierData=tierBSupplierData;\n//allTierData.tierCSupplierData=tierCSupplierData;"
          },
          "outcomes": {
            "success": "1776298383241"
          },
          "code": "CREATESUPPLIERTIERSMAP",
          "id": "1776296519365",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5478.5,
            "y": 7022
          }
        },
        {
          "metadata": {
            "name": "ChunkifyAndConstructInStings",
            "returnType": "object",
            "sourceCode": "let supplierObject = $context.$nodes.CREATESUPPLIERTIERSMAP.$output.result;\nlet distinctTiers = $context.$nodes.DETERMINE_DISTINCT_TIERS.$output.result;\nlet queryString='';\nvar result={};\nvar tierXStrings= [];\nconst chunkSize = 25;\n\nfor (const distinctTier of distinctTiers){\nvar tierXSuppliers = supplierObject[distinctTier];\nqueryString='';\ntierXStrings= [];\nfor (let i = 0; i < tierXSuppliers.length; i+= chunkSize) {\n    var chunk = tierXSuppliers.slice(i, i + chunkSize);\n    queryString = chunk.map(indiv => `'${indiv.Supplier}'`).join(\", \");\n    tierXStrings.push(queryString);\n}\nresult[distinctTier]= tierXStrings;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776323570479"
          },
          "code": "CHUNKIFYANDCONSTRUCTINSTINGS",
          "id": "1776298383241",
          "inputs": [],
