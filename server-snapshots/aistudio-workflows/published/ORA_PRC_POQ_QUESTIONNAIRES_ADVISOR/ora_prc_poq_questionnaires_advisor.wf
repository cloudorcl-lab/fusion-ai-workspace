        {
          "metadata": {
            "name": "Assign Questionnaire Link To Each Displayed Record",
            "returnType": "array",
            "sourceCode": "var finalArray = $context.$variables.final6;\nvar hostName = $context.$nodes.GETCURRENTHOSTNAME.$output.result;\nvar internalResponseUrl = \"/fscmUI/redwood/supplier-qualifications/responses/edit-questionnaire-response?QuestionnaireResponseHeaderId=\";\nvar externalResponseUrl= \"/fscmUI/redwood/supplier-qualifications-external/responses/edit-questionnaire-response?QuestionnaireResponseHeaderId=\";\nvar internalQs = [];\nvar supplierQs = [];\n\ninternalQs= finalArray.filter(questnaire => (questnaire.QuestionnaireTypeCode == 'INTERNAL'));\ninternalQs.forEach(obj => {\n  obj.QuestionnaireURL= hostName + internalResponseUrl + obj.QuestionnaireRespHeaderId;\n});\n\nsupplierQs= finalArray.filter(questnaire => (questnaire.QuestionnaireTypeCode == 'SUPPLIER'));\nsupplierQs.forEach(obj => {\n  obj.QuestionnaireURL= hostName + externalResponseUrl + obj.QuestionnaireRespHeaderId;\n});\n\nreturn finalArray;"
          },
