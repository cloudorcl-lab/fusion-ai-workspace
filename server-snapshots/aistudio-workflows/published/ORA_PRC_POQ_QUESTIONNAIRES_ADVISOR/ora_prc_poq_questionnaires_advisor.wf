        {
          "metadata": {
            "name": "GetDistinctInternalResponderIdsAndSupplierContactIds",
            "returnType": "object",
            "sourceCode": "//To reduce REST calls, first getting distinct internal and supplier contact ids\n//var allQs = $context.$nodes.COMPRESSTO6AGAIN.$output.result;\nvar allQs = $context.$variables.final6;\nvar distinctIntIdsString = '';\nvar distinctSupContIdsString = '';\nvar returnObject = {};\n\n//Filter Internal\nvar internalQs= allQs.filter(questnaire => questnaire.QuestionnaireTypeCode === 'INTERNAL');\nvar distinctInternalQIds = [...new Set(internalQs.map(item => item.InternalRespondentId))];\n\n//Filter Supplier\nvar supplierQs= allQs.filter(questnaire => questnaire.QuestionnaireTypeCode === 'SUPPLIER');\n//var distinctSupplierQIds = [...new Set(supplierQs.map(item => item.InitiativeSuppContactId))];\n\nvar distinctSupplierQIdsCombo = [...new Map(supplierQs.map(item => [item.InitiativeSuppContactId, { InitiativeSuppContactId: item.InitiativeSuppContactId, SupplierId: item.SupplierId}])).values()];\n\n\nif (distinctInternalQIds){\ndistinctIntIdsString = distinctInternalQIds.join(',');\n}\n\nreturnObject.SupContIdsPlusSuppIds=distinctSupplierQIdsCombo;\nreturnObject.IntContIds=distinctIntIdsString;\n\nreturn returnObject;"
          },
          "outcomes": {
            "success": "1776737324631"
          },
