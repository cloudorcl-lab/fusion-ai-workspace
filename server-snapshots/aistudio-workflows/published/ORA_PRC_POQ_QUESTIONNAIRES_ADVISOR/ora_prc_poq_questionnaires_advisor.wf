            "name": "AssignEmailIdsToIntRespRecords",
            "returnType": "array",
            "sourceCode": "var op = $context.$nodes.GETINTERNALRESPEMAIL.$output.items;\nvar allQs=$context.$variables.final6;\nvar internalQs = [];\n\nfor (const rec of op){\ninternalQs= allQs.filter(questnaire => (questnaire.QuestionnaireTypeCode == 'INTERNAL') && (questnaire.InternalRespondentId == rec.PersonId));\ninternalQs.forEach(obj => {\n  obj.InternalRespondentEmail = rec.WorkEmail;\n  //testing\n  //obj.InternalRespondentEmail ='anirudh.kabde123@oracle.com';\n});\n}\n\nreturn allQs;\n\n//testing\n//return internalQs;"
          },
          "outcomes": {
            "success": "1776775064883"
          },
