          "code": "GETTINGTOPQUESTIONNAIRES",
          "id": "1776492244022",
          "inputs": [
            {
              "id": "1776492244023_1",
              "name": "collection",
              "type": "string",
              "value": "{{ Object.keys($context.$nodes.CHUNKIFYANDCONSTRUCTINSTINGS.$output.result) }}"
            }
          ],
          "type": "LOOP",
          "diagram": {
            "x": 3459.1557707753714,
            "y": 7354.745716749052,
            "width": 1717.7524375968287,
            "height": 2679.9604772493185
          }
        },
        {
          "metadata": {
            "name": "CompressTo6Again",
            "returnType": "array",
            "sourceCode": "//We have already optimised to ensure just the required REST calls are made (to get 6 questionnaire Response, sometimes it can be more as for a single tier, we need to get all for sure based on data retrieved in batches). Since we are querying using suppliers, for a given tier, we got all the questionnaire response headers and sorted based on response date //tier wise, so that the prioritized info is shown/acted upon first\n\n//Now, we are making sure we take just top 6, nothing more than that\n//Assuming earlier derived distinct keys is ordered based on tier priority, going further\n\nvar distinctTiers = $context.$nodes.DETERMINE_DISTINCT_TIERS.$output.result;\nvar newArr=[];\nfor (const tierX of distinctTiers){\n    var tierXData = $context.$variables.topQuestionnairesObject[tierX];\n     //Inserting Tier Info in each object element\n     if (tierXData){\n          for (const elm of tierXData){\n            elm.supplierTier = tierX;\n           }\n          //Pushing the sub array into newArr\n          if (newArr.length<=6){\n             var ln = newArr.length;\n             newArr.push(...tierXData.slice(0,6-ln));\n           }\n     }\n}\nreturn newArr;"
          },
          "outcomes": {
            "success": "1776771868442"
          },
          "code": "COMPRESSTO6AGAIN",
