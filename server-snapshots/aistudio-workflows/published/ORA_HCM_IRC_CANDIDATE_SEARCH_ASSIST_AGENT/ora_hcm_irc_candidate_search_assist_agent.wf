          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Check Search Type"
          },
          "outcomes": {
            "true": "1769031684080",
            "false": "1769109088215"
          },
          "code": "CHECK_SEARCH_TYPE",
          "convergenceTargetId": "end",
          "id": "1769031599992",
          "inputs": [
            {
              "id": "1769031599994_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.searchType === 'query_assist'}}"
