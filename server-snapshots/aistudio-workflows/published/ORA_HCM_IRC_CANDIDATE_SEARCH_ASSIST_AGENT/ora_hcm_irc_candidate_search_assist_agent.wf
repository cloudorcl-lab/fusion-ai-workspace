{
  "workflowId": "300000331058104",
  "workflowCode": "ORA_HCM_IRC_CANDIDATE_SEARCH_ASSIST_AGENT",
  "name": "Candidate Search Assist Agent",
  "description": "Converts natural-language input into structured candidate search filters, applying Recruiting-supported synonyms and terminology mappings.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
