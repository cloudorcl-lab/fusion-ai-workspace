        },
        {
          "metadata": {
            "errorNodeId": "1769923362014",
            "name": "Get Response",
            "returnType": "array",
            "sourceCode": "// Offer data (post-query)\nconst offers = Array.isArray(\n  $context.$nodes.FIN_AP_BO_GET_OFFER_STATUS.$output\n)\n  ? $context.$nodes.FIN_AP_BO_GET_OFFER_STATUS.$output\n  : [];\n\n// Base summary text generated from filters\nconst baseSummaryText =\n  $context.$nodes.FIN_AP_CODE_GENERATE_FILTER?.$output?.result?.summaryText || \"\";\n\n\n\nlet normalizedSummary = \"\";\n\nif (typeof baseSummaryText === \"string\") {\n  normalizedSummary = baseSummaryText.trim();\n}\n\n// Ensure summary always attaches grammatically to \"offers\"\nif (normalizedSummary !== \"\" && !normalizedSummary.startsWith(\"for \")) {\n  normalizedSummary = \" for \" + normalizedSummary;\n}\n\n\n\nconst prefixedSummaryText =\n  (offers.length === 0\n    ? \"No offers were found\"\n    : \"Showing offers\") +\n  normalizedSummary +\n  \".\";\n\n/* ===============================\n   BUILD FINAL OUTPUT\n================================ */\n\nlet finalOutput;\n\n// Case: no offers returned\nif (offers.length === 0) {\n  finalOutput = [\n    {\n      type: \"text\",\n      sequence: 1,\n      content: [prefixedSummaryText]\n    }\n  ];\n} else {\n  // Build table rows (max 10)\n  const tableContent = offers.slice(0, 10).map(o => {\n    let formattedSentDate = \"\";\n\n    if (o.sendDate) {\n      let d;\n\n      if (o.sendDate instanceof Date) {\n        d = o.sendDate;\n      } else if (typeof o.sendDate === \"number\") {\n        d = new Date(o.sendDate);\n      } else if (typeof o.sendDate === \"string\") {\n        d = new Date(o.sendDate.replace(\" \", \"T\"));\n      }\n\n      if (d && !isNaN(d.getTime())) {\n        formattedSentDate =\n          d.getFullYear() +\n          \"-\" +\n          String(d.getMonth() + 1).padStart(2, \"0\") +\n          \"-\" +\n          String(d.getDate()).padStart(2, \"0\");\n      }\n    }\n\n\n\n    let programTypeText = \"\";\n\n    if (o.financingOptionType === \"DYNAMIC_DISCOUNTING\") {\n      programTypeText = \"Dynamic Discounting\";\n    } else if (o.financingOptionType === \"VIRTUAL_CREDIT_CARD\") {\n      programTypeText = \"Virtual Card\";\n    } else if (o.financingOptionType === \"SUPPLY_CHAIN_FINANCING\") {\n      programTypeText = \"Supply Chain Finance\";\n    }\n\n    return {\n      supplier: o.supplierName || \"\",\n      programType: programTypeText,\n      offerSentDate: formattedSentDate,\n       discountRate: o.discountRate,\n      offerStatus: o.offerStatus || \"\"\n    };\n  });\n\n  finalOutput = [\n    {\n      type: \"text\",\n      sequence: 1,\n      content: [prefixedSummaryText]\n    },\n    {\n      type: \"table\",\n      sequence: 2,\n      heading: \"Offer Status Details\",\n      content: tableContent,\n      columnOrder: [\n        \"supplier\",\n        \"programType\",\n        \"offerSentDate\",\n        \"discountRate\",\n        \"offerStatus\"\n      ]\n    },\n    {\n      type: \"actions\",\n      sequence: 3,\n      content: [\n        \"Show the offers sent out for a time period\",\n        \"Show the draft offers\"\n      ]\n    }\n  ];\n}\n\n\n\nreturn finalOutput;"
          },
