        {
          "metadata": {
            "name": "Payload Constructor ",
            "returnType": "object",
            "sourceCode": "let result = $context.$nodes.FIN_AP_SEEDED_PROMPT_INTENT_IDENTIFIER.$output;\n\nif (typeof result === \"string\") {\n  result = JSON.parse(result);\n}\n\nlet filter = \"\";\n\nif (result.seededPrompt === true) {\n  const days = Number(result.parameter.timeFrame);\n\n  if (result.seededPromptType === \"AcceptanceRatePrompt\") {\n    filter =\n      \"sendDate <= sysdate - \" +\n      days +\n      \" and offerStatusCode in ('ORA_CE_COMMUNICATED','ORA_CE_ONE_TIME_ACCEPTED')\";\n  }\n\n  if (result.seededPromptType === \"LossOfBenefitPrompt\") {\n    filter =\n      \"sendDate <= sysdate - 14 + \" +\n      days +\n      \" and offerStatusCode in ('ORA_CE_COMMUNICATED')\";\n  }\n\n  if (result.seededPromptType === \"SupplierCommunication\") {\n    filter = {\n      viewQueries: {\n        financingProgramOfferDetails: {\n          module: \"oraErpCoreFinancingProgramSetup\",\n          businessObject: \"FinancingProgramOffer\",\n          fieldAliases: {\n            financingProgramOfferId: \"financingProgramOfferId\",\n            discountRate: \"discountRate\",\n            \"thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name\": \"supplierName\",\n            \"offerStatus.meaning\": \"offerStatus\",\n            \"offerStatus.lookupCode\": \"offerStatusCode\",\n            emailAddress: \"emailAddress\",\n            sendDate: \"sendDate\",\n            \"currency.currencyCode\": \"currencyCode\"\n          }\n        },\n        payablesInvoiceInstallments: {\n          module: \"oraErpCorePayablesInvoices\",\n          businessObject: \"PayablesInvoiceInstallment\",\n          view: \"payablesPaymentScheduleDetail\",\n          fieldAliases: {\n            invoiceId: \"invoiceId\",\n            installmentNumber: \"installmentNumber\",\n            dueDate: \"dueDate\",\n            \"invoiceCurrencyGrossAmount\": \"unpaidAmount\",\n            \"invoiceTransaction.invoiceCurrency.currencyCode\": \"currencyCode\",\n            \"financeProgramOffer.financingProgramOfferId\": \"financingProgramOfferId\"\n          },\n          filter: \"financeProgramOffer.financingProgramOfferId != null\"\n        }\n      },\n      select:\n        \"select fp.supplierName as supplier, \" +\n        \"to_char(TRUNC(fp.sendDate), 'YYYY-MM-DD') as offerSentDate, \" +\n        \"to_char(trunc(sysdate) - trunc(fp.sendDate)) as daysSinceCommunication, \" +\n        \"to_char(count(pi.installmentNumber)) as numberOfInstallments, \" +\n        \"trim(to_char(round(nvl(sum(pi.unpaidAmount), 0), 0), 'FM999999999999999990.00') || ' ' || coalesce(fp.currencyCode, pi.currencyCode)) as outstandingAmount, \" +\n        \"trim(to_char(nvl(sum(((fp.discountRate / 100) * pi.unpaidAmount * (trunc(pi.dueDate) - trunc(sysdate))) / 360), 0), 'FM999999999999999990.00') || ' ' || coalesce(fp.currencyCode, pi.currencyCode)) as discountLost, \" +\n        \"fp.emailAddress as recipient, \" +\n        \"fp.offerStatus as status \" +\n        \"from financingProgramOfferDetails fp \" +\n        \"left join payablesInvoiceInstallments pi on fp.financingProgramOfferId = pi.financingProgramOfferId \" +\n        \"where fp.offerStatusCode = 'ORA_CE_OFFER_COMMUNICATED' \" +\n        \"AND (trunc(sysdate) - trunc(fp.sendDate) > \" + days + \") \" +\n        \"group by fp.supplierName, fp.sendDate, fp.emailAddress, fp.offerStatus, fp.financingProgramOfferId, fp.currencyCode, pi.currencyCode FETCH FIRST 20 ROWS ONLY\",\n      return: [\n        { name: \"supplier\", type: \"string\" },\n        { name: \"offerSentDate\", type: \"string\" },\n        { name: \"daysSinceCommunication\", type: \"string\" },\n        { name: \"numberOfInstallments\", type: \"string\" },\n        { name: \"outstandingAmount\", type: \"string\" },\n        { name: \"discountLost\", type: \"string\" },\n        { name: \"recipient\", type: \"string\" },\n        { name: \"status\", type: \"string\" }\n      ]\n    };\n  }\n}\n\nreturn filter;"
          },
          "outcomes": {
