          },
          "code": "FIN_AP_BO_DATA_EXTRACT_FOR_SEEDED_PROMPTS",
          "id": "1780688787579",
          "inputs": [
            {
              "id": "1780712563063_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_PAYLOAD_CONSTRUCTOR.$output.result}}"
