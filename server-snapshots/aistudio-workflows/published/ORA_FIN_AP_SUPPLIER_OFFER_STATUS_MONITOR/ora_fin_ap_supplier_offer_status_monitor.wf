          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Construct Data Parser",
            "returnType": "object",
            "sourceCode": "let intentOutput = $context.$nodes.FIN_AP_SEEDED_PROMPT_INTENT_IDENTIFIER.$output;\n\nif (intentOutput && intentOutput.result !== undefined) {\n  intentOutput = intentOutput.result;\n}\n\nif (typeof intentOutput === \"string\") {\n  try {\n    intentOutput = JSON.parse(intentOutput);\n  } catch (e) {\n    intentOutput = {};\n  }\n}\n\nlet seededPrompt = intentOutput.seededPromptType || \"\";\nlet timeFrame = intentOutput.parameter.timeFrame;\n\nlet dataOutput = $context.$nodes.FIN_AP_BO_DATA_EXTRACT_FOR_SEEDED_PROMPTS.$output;\n\nif (dataOutput && dataOutput.result !== undefined) {\n  dataOutput = dataOutput.result;\n}\n\nif (typeof dataOutput === \"string\") {\n  try {\n    dataOutput = JSON.parse(dataOutput);\n  } catch (e) {\n    dataOutput = [];\n  }\n}\n\nif (!Array.isArray(dataOutput)) {\n  if (dataOutput && Array.isArray(dataOutput.data)) {\n    dataOutput = dataOutput.data;\n  } else if (dataOutput && Array.isArray(dataOutput.records)) {\n    dataOutput = dataOutput.records;\n  } else if (dataOutput && Array.isArray(dataOutput.offers)) {\n    dataOutput = dataOutput.offers;\n  } else {\n    dataOutput = [];\n  }\n}\n\nlet finalOutput;\n\nif (seededPrompt === \"SupplierCommunication\") {\n  let summaryText =\n    dataOutput.length === 0\n      ? \"No communicated offers were found that have not received a supplier response in over \" + timeFrame + \" days.\"\n      : \"Here are the communicated offers that have not received a supplier response in over \" + timeFrame + \" days.\";\n\n  if (dataOutput.length === 0) {\n    finalOutput = [\n      {\n        type: \"text\",\n        sequence: 1,\n        content: [summaryText]\n      }\n    ];\n  } else {\n    let tableContent = [];\n\n    for (let i = 0; i < dataOutput.length && i < 10; i++) {\n      let row = dataOutput[i] || {};\n\n      tableContent.push({\n        supplier: row.supplier || row.supplierName || \"\",\n        offerSentDate: row.offerSentDate || row.sendDate || row.sentDate || row.communicationDate || \"\",\n        daysSinceCommunication: row.daysSinceCommunication || row.daysSinceLastCommunication || row.daysSinceOfferSent || row.daysSinceSent || \"\",\n        numberOfInstallments: row.numberOfInstallments || row.installmentCount || row.numInstallments || row.numberInstallments || \"\",\n        outstandingAmount: row.outstandingAmount || row.totalOutstandingAmount || row.amountOutstanding || \"\",\n        discountLost: row.discountLost || row.estimatedDiscountLost || row.lostDiscount || row.estimatedLossOfBenefit || \"\",\n        recipient: row.recipient !== undefined ? row.recipient : null,\n        status:\n          row.status === \"OFFER_COMMUNICATED\" || row.offerStatus === \"OFFER_COMMUNICATED\"\n            ? \"Offer communicated\"\n            : row.status || row.offerStatus || \"\"\n      });\n    }\n\n    finalOutput = [\n      {\n        type: \"text\",\n        sequence: 1,\n        content: [summaryText]\n      },\n      {\n        type: \"table\",\n        sequence: 2,\n        heading: \"Supplier Communication Details\",\n        content: tableContent,\n        columnOrder: [\n          \"supplier\",\n          \"offerSentDate\",\n          \"daysSinceCommunication\",\n          \"numberOfInstallments\",\n          \"outstandingAmount\",\n          \"discountLost\",\n          \"recipient\",\n          \"status\"\n        ]\n      },\n      {\n        type: \"text\",\n        sequence: 3,\n        content: \"These offers may require follow-up to avoid delays in acceptance or expiry of discount benefits.\"\n      }\n    ];\n  }\n} else {\n  finalOutput = [\n    {\n      type: \"text\",\n      sequence: 1,\n      content: [\"No matching offers were found\"]\n    }\n  ];\n}\n\nreturn finalOutput;"
          },
          "outcomes": {
            "success": "1780716669453"
          },
