          "code": "RETIREMENTSTATUS",
          "id": "1776873117513",
          "inputs": [
            {
              "id": "1776873117515_1",
              "name": "prompt",
              "type": "string",
              "value": "Analyze the asset retirement transaction results from the output\n\n{{$context.$nodes.POSTTRANSACTIONS.$output}}\n\nReturn  one short sentence.\n\nDetermine success or failure using transactionHeaderId as the primary check:\n- Treat a transaction as successful if transactionHeaderId is present and not empty, even if errorMessage exists.\n- Treat a transaction as failed only if transactionHeaderId is null, empty, or missing.\n- Use returnStatus only as supporting information.\n\nThen classify the overall result:\n- If all transactions are successful, return:\nAll asset retirement transactions have been successfully completed. If youÃ¢â‚¬â„¢d like to continue with another retirement, please share the asset details. You can upload a CSV file or enter the information as free text.\n- If all transactions failed, return:\nAll transactions could not be completed. Please review the Exception Transactions section, identify the issues, make the necessary corrections, and try processing them again.\n- If some succeeded and some failed, return:\nSome transactions were completed successfully, while others could not be processed. Please review the Exception Transactions section, fix the issues for the failed transactions, and reprocess them when ready.\n\nReturn only the final sentence."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Build Posting Table",
            "returnType": "string",
            "sourceCode": "var data = $context.$nodes.POSTTRANSACTIONS.$output;\nvar topMessage = \"\";\nvar bottomMessage = $context.$nodes.RETIREMENTSTATUS.$output || \"\";\n\n// user preferences\nvar userPreferencesResponse = $context.$nodes.GETUSERPREFERENCES.$output || {};\nvar userPref = (userPreferencesResponse.items && userPreferencesResponse.items.length > 0) ? userPreferencesResponse.items[0] : {};\n\nvar dateFormat = userPref.DateFormat || \"MM/dd/yy\";\nvar decimalSeparator = userPref.DecimalSeparator || \".\";\nvar groupingSeparator = userPref.GroupingSeparator || \",\";\n\n// currency precision output\nvar currencyResponse = $context.$nodes.PARSEUNIQUECURRENCYPRECISION.$output|| {};\n\n// ---------------- ROW EXTRACTION ----------------\nvar rows = [];\n\nif (data && Array.isArray(data)) {\n  for (var i = 0; i < data.length; i++) {\n    var item = data[i];\n\n    if (typeof item === \"string\") {\n      try { item = JSON.parse(item); } catch (e) { item = {}; }\n    }\n\n    if (item && item.draftRetirements && Array.isArray(item.draftRetirements)) {\n      for (var j = 0; j < item.draftRetirements.length; j++) {\n        rows.push(item.draftRetirements[j]);\n      }\n    }\n  }\n}\n\nif (rows.length === 0 && data && data.draftRetirements) {\n  if (Array.isArray(data.draftRetirements)) {\n    rows = data.draftRetirements;\n  }\n}\n\nif (!Array.isArray(rows)) rows = [];\n\nfunction esc(v) {\n  if (v === null || v === undefined || v === \"\") return \"-\";\n  return String(v)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\n// ---------------- SUMMARY BY BOOK ----------------\nvar summaryByBook = {};\nfor (var s = 0; s < rows.length; s++) {\n  var obj = rows[s];\n\n  if (typeof obj === \"string\") {\n    try { obj = JSON.parse(obj); } catch (e2) { obj = {}; }\n  } else if (!obj || typeof obj !== \"object\") {\n    obj = {};\n  }\n\n  var book = (obj.bookName === null || obj.bookName === undefined || obj.bookName === \"\") ? \"(Blank Book)\" : String(obj.bookName);\n  var status = (obj.returnStatus === null || obj.returnStatus === undefined) ? \"\" : String(obj.returnStatus).trim();\n  var ok = (status === \"S\");\n\n  if (!summaryByBook[book]) summaryByBook[book] = { posted: 0, errored: 0, total: 0 };\n  summaryByBook[book].total += 1;\n  if (ok) summaryByBook[book].posted += 1;\n  else summaryByBook[book].errored += 1;\n}\n\nvar books = Object.keys(summaryByBook).sort();\nvar totalPosted = 0;\nvar totalErrored = 0;\nvar totalTxns = 0;\n\nfor (var bi = 0; bi < books.length; bi++) {\n  totalPosted += summaryByBook[books[bi]].posted;\n  totalErrored += summaryByBook[books[bi]].errored;\n  totalTxns += summaryByBook[books[bi]].total;\n}\n\n// ---------------- HTML ----------------\nvar html = \"\";\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f;'>\";\n\n// OUTER BORDERED CONTAINER\nhtml += \"<div style='border:1px solid #e0e0e0;'>\";\n\n// MAIN TITLE + TOP MESSAGE\nhtml += \"<table style='width:100%; border-collapse:collapse; table-layout:fixed;'>\";\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<td colspan='6' style='padding:10px; font-size:15px; font-weight:600; color:#1f1f1f; border-bottom:1px solid #e0e0e0;'>\";\nhtml += \"Asset Retirement Transaction Details\";\nhtml += \"</td>\";\nhtml += \"</tr>\";\n\nif (topMessage) {\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<td colspan='6' style='padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>\";\n  html += topMessage;\n  html += \"</td>\";\n  html += \"</tr>\";\n}\nhtml += \"</table>\";\n\n// NO DATA\nif (rows.length === 0) {\n  html += \"<div style='padding:10px;'>No Asset Retirement Transactions found.</div>\";\n\n  if (bottomMessage) {\n    html += \"<table style='width:100%; border-collapse:collapse; table-layout:fixed; margin-top:12px;'>\";\n    html += \"<tr style='background:#f5f5f5;'>\";\n    html += \"<td colspan='6' style='padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-top:1px solid #e0e0e0;'>\";\n    html += bottomMessage;\n    html += \"</td>\";\n    html += \"</tr>\";\n    html += \"</table>\";\n  }\n\n  html += \"</div>\";\n  html += \"</div>\";\n  return html;\n}\n\n// ---------------- SUMMARY SECTION ----------------\nhtml += \"<table style='width:100%; border-collapse:collapse; table-layout:fixed; margin-top:10px;'>\";\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<td colspan='4' style='padding:10px; font-size:14px; font-weight:600; color:#1f1f1f; border-top:1px solid #e0e0e0; border-bottom:1px solid #e0e0e0;'>\";\nhtml += \"Summary by Asset Book\";\nhtml += \"</td>\";\nhtml += \"</tr>\";\n\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th style='padding:6px; border:1px solid #e0e0e0; text-align:left; width:50%;'>Asset Book</th>\";\nhtml += \"<th style='padding:6px; border:1px solid #e0e0e0; text-align:center; width:16%;'>Posted</th>\";\nhtml += \"<th style='padding:6px; border:1px solid #e0e0e0; text-align:center; width:17%;'>Exceptions</th>\";\nhtml += \"<th style='padding:6px; border:1px solid #e0e0e0; text-align:center; width:17%;'>Total</th>\";\nhtml += \"</tr>\";\n\nfor (var sb = 0; sb < books.length; sb++) {\n  var bookName = books[sb];\n  var ss = summaryByBook[bookName];\n  var bg = (sb % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n\n  html += \"<tr style='background:\" + bg + \";'>\";\n  html += \"<td style='padding:6px; border:1px solid #f0f0f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(bookName) + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center; color:#1a7f37; font-weight:600;'>\" + ss.posted + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center; color:#d1242f; font-weight:600;'>\" + ss.errored + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center; font-weight:600;'>\" + ss.total + \"</td>\";\n  html += \"</tr>\";\n}\n\nhtml += \"<tr style='background:#fffbe6; font-weight:700;'>\";\nhtml += \"<td style='padding:6px; border:1px solid #f0f0f0;'>Total Transactions Processed</td>\";\nhtml += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center; color:#1a7f37;'>\" + totalPosted + \"</td>\";\nhtml += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center; color:#d1242f;'>\" + totalErrored + \"</td>\";\nhtml += \"<td style='padding:6px; border:1px solid #f0f0f0; text-align:center;'>\" + totalTxns + \"</td>\";\nhtml += \"</tr>\";\nhtml += \"</table>\";\n\n// ---------------- TRANSACTION SECTION ----------------\nhtml += \"<table style='width:100%; border-collapse:collapse; table-layout:fixed; margin-top:12px;'>\";\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<td colspan='6' style='padding:10px; font-size:14px; font-weight:600; color:#1f1f1f; border-top:1px solid #e0e0e0; border-bottom:1px solid #e0e0e0;'>\";\nhtml += \"Transaction Details\";\nhtml += \"</td>\";\nhtml += \"</tr>\";\n\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:left; width:20px;'>Row</th>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:left; width:35%;'>Book</th>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:left; width:30%;'>Asset Number</th>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:left; width:30%;'>Description</th>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:right; width:15%;'>Cost</th>\";\nhtml += \"<th style='padding:6px 8px; border:1px solid #e0e0e0; text-align:left; width:20%;'>Status</th>\";\nhtml += \"</tr>\";\n\nfor (var r = 0; r < rows.length; r++) {\n  var row = rows[r];\n\n  if (typeof row === \"string\") {\n    try { row = JSON.parse(row); } catch (e3) { row = {}; }\n  } else if (!row || typeof row !== \"object\") {\n    row = {};\n  }\n\n  var bgColor = (r % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n  var status = (row.returnStatus === null || row.returnStatus === undefined) ? \"\" : String(row.returnStatus).trim();\n  var isSuccess = (status === \"S\");\n  var statusText = isSuccess ? \"Posted Successfully\" : \"Posting Error\";\n  var statusColor = isSuccess ? \"#1a7f37\" : \"#d1242f\";\n\n  var rowCurrencyCodeRaw = row.currencyCode != null ? row.currencyCode : row.CurrencyCode;\n  var rowCurrencyCode = (rowCurrencyCodeRaw === null || rowCurrencyCodeRaw === undefined || rowCurrencyCodeRaw === \"\") ? \"\" : String(rowCurrencyCodeRaw);\n\n  var rowPrecision = 2;\n  if (currencyResponse.result && Array.isArray(currencyResponse.result)) {\n    for (var p = 0; p < currencyResponse.result.length; p++) {\n      var cf = currencyResponse.result[p] && currencyResponse.result[p].currencyFormat ? currencyResponse.result[p].currencyFormat : {};\n      if ((cf.CurrencyCode || \"\") === rowCurrencyCode) {\n        rowPrecision = Number(cf.Precision);\n        if (isNaN(rowPrecision)) {\n          rowPrecision = 2;\n        }\n        break;\n      }\n    }\n  }\n\n  var costDisplay = \"-\";\n  if (row.costRetired !== null && row.costRetired !== undefined && row.costRetired !== \"\") {\n    var n = Number(row.costRetired);\n    if (!isNaN(n)) {\n      var fixed = n.toFixed(rowPrecision);\n      var parts = fixed.split(\".\");\n      var intPart = parts[0];\n      var decPart = parts.length > 1 ? parts[1] : \"\";\n      var sign = \"\";\n\n      if (intPart.charAt(0) === \"-\") {\n        sign = \"-\";\n        intPart = intPart.slice(1);\n      }\n\n      intPart = intPart.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n      costDisplay = sign + intPart + (rowPrecision > 0 ? decimalSeparator + decPart : \"\");\n    } else {\n      costDisplay = esc(row.costRetired);\n    }\n  }\n\n  var headerId = \"\";\n  if (row.transactionHeaderId !== null && row.transactionHeaderId !== undefined && row.transactionHeaderId !== \"\") headerId = row.transactionHeaderId;\n  else if (row.transactionHeaderID !== null && row.transactionHeaderID !== undefined && row.transactionHeaderID !== \"\") headerId = row.transactionHeaderID;\n  else if (row.headerId !== null && row.headerId !== undefined && row.headerId !== \"\") headerId = row.headerId;\n  else if (row.headerID !== null && row.headerID !== undefined && row.headerID !== \"\") headerId = row.headerID;\n\n  var errorMsg = \"\";\n  if (row.errorMessage !== null && row.errorMessage !== undefined && row.errorMessage !== \"\") {\n    var em = String(row.errorMessage).replace(/\\r\\n/g, \"\\n\");\n    var partsErr = em.split(\"\\n\");\n    errorMsg = partsErr.length > 0 ? String(partsErr[0]).trim() : em.trim();\n\n    if (!errorMsg) {\n      for (var k = 0; k < partsErr.length; k++) {\n        var line = String(partsErr[k]).trim();\n        if (line) {\n          errorMsg = line;\n          break;\n        }\n      }\n    }\n  }\n  if (!errorMsg) {\n    if (row.errorMsg !== null && row.errorMsg !== undefined && row.errorMsg !== \"\") errorMsg = String(row.errorMsg).trim();\n    else if (row.returnMessage !== null && row.returnMessage !== undefined && row.returnMessage !== \"\") errorMsg = String(row.returnMessage).trim();\n    else if (row.message !== null && row.message !== undefined && row.message !== \"\") errorMsg = String(row.message).trim();\n  }\n\n  html += \"<tr style='background:\" + bgColor + \";'>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0;'>\" + (r + 1) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(row.bookName) + \" - \" + esc(row.currencyCode) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(row.assetNumber) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(row.assetDescription) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0; text-align:right; white-space:nowrap;'>\" + costDisplay + \"</td>\";\n  html += \"<td style='padding:6px 8px; border:1px solid #f0f0f0; color:\" + statusColor + \"; font-weight:600;'>\" + statusText + \"</td>\";\n  html += \"</tr>\";\n\n  html += \"<tr style='background:\" + bgColor + \";'>\";\n  html += \"<td colspan='6' style='padding:6px 10px; border:1px solid #f0f0f0; border-left:3px solid #d6d6d6; font-size:12px; color:#444; line-height:1.6;'>\";\n  if (isSuccess) {\n    html += \"<div><b>Transaction Id:</b> \" + esc(headerId) + \"</div>\";\n  } else {\n    html += \"<div style='color:#d1242f;'><b>Error Message:</b> \" + esc(errorMsg ? errorMsg : \"Posting error\") + \"</div>\";\n  }\n  html += \"</td>\";\n  html += \"</tr>\";\n}\n\nhtml += \"</table>\";\n\n// ---------------- BOTTOM MESSAGE ----------------\nif (bottomMessage) {\n  html += \"<table style='width:100%; border-collapse:collapse; table-layout:fixed; margin-top:12px;'>\";\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<td colspan='6' style='padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-top:1px solid #e0e0e0;'>\";\n  html += bottomMessage;\n  html += \"</td>\";\n  html += \"</tr>\";\n  html += \"</table>\";\n}\n\nhtml += \"</div>\";\nhtml += \"</div>\";\n\nreturn html;"
