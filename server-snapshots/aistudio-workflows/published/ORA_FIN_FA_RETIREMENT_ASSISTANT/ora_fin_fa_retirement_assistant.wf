        {
          "metadata": {
            "name": "Extract IDs - Proceed",
            "returnType": "object",
            "sourceCode": "var rawInput = $context.$variables.retirementChangeRequestJson;\nvar rawMessage = $context.$system.$inputMessage || \"\";\n\nfunction s(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction normalizeDate(value) {\n  var text = s(value).trim();\n  if (!text) return \"\";\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(text)) return text;\n  var m = text.match(/^(\\d{1,2})[\\/\\-](\\d{1,2})[\\/\\-](\\d{2,4})$/);\n  if (m) {\n    var dd = m[1].padStart(2, \"0\");\n    var mm = m[2].padStart(2, \"0\");\n    var yyyy = m[3].length === 2 ? \"20\" + m[3] : m[3];\n    return yyyy + \"-\" + mm + \"-\" + dd;\n  }\n  return text;\n}\nfunction queryFilterForType(type) {\n  var t = s(type).toLowerCase();\n  if (t.indexOf(\"serial\") > -1) return \"P_SERIAL_NUMBER\";\n  if (t.indexOf(\"tag\") > -1) return \"P_TAG_NUMBER\";\n  return \"P_ASSET_NUMBER\";\n}\nfunction cleanIdentifierValue(value, queryFilter) {\n  var v = s(value).trim();\n  v = v.replace(/[.,;]+$/g, \"\").trim();\n  v = v.replace(/\\s+and\\s*$/i, \"\").trim();\n  v = v.replace(/\\s+(please|thanks|thank you)$/i, \"\").trim();\n  v = v.replace(/^(?:add|include)\\s+/i, \"\").trim();\n  v = v.replace(/^another\\s+/i, \"\").trim();\n  v = v.replace(/^with\\s+/i, \"\").trim();\n  var q = s(queryFilter).toUpperCase();\n  if (q.indexOf(\"TAG\") > -1) {\n    v = v.replace(/^tag\\s+number\\s+/i, \"\").trim();\n    var mt = v.match(/\\btag\\s+number\\s+(.+)$/i);\n    if (mt && mt[1]) v = mt[1].trim();\n  } else if (q.indexOf(\"SERIAL\") > -1) {\n    v = v.replace(/^serial\\s+number\\s+/i, \"\").trim();\n    var ms = v.match(/\\bserial\\s+number\\s+(.+)$/i);\n    if (ms && ms[1]) v = ms[1].trim();\n  } else {\n    v = v.replace(/^asset\\s+with\\s+asset\\s+number\\s+/i, \"\").trim();\n    v = v.replace(/^asset\\s+number\\s+/i, \"\").trim();\n    v = v.replace(/^asset\\s+no\\.?\\s+/i, \"\").trim();\n    v = v.replace(/^asset\\s+#\\s*/i, \"\").trim();\n    var ma = v.match(/\\basset\\s+number\\s+(.+)$/i);\n    if (ma && ma[1]) v = ma[1].trim();\n  }\n  v = v.replace(/[.,;]+$/g, \"\").trim();\n  return v;\n}\nfunction cleanRow(row, defaultBook, defaultReason, defaultDate) {\n  row = row || {};\n  var queryFilter = s(row.queryFilter).trim() || queryFilterForType(row.type || row.identifierType || (row.serialNumber || row.SerialNumber ? \"serial\" : (row.tagNumber || row.TagNumber ? \"tag\" : \"asset\")));\n  var parameter = cleanIdentifierValue(row.parameter || row.assetNumber || row.AssetNumber || row.serialNumber || row.SerialNumber || row.tagNumber || row.TagNumber, queryFilter);\n  if (!parameter) return null;\n  return {\n    queryFilter: queryFilter,\n    parameter: parameter,\n    costRetired: row.costRetired !== undefined && row.costRetired !== null ? row.costRetired : \"\",\n    retirementReason: s(row.retirementReason || row.RetirementReason || defaultReason).trim(),\n    retirementDate: normalizeDate(row.retirementDate || row.dateRetired || row.RetirementDate || defaultDate)\n  };\n}\nfunction addRow(groups, book, row) {\n  if (!row) return;\n  var bookCode = s(book).trim();\n  if (!groups[bookCode]) groups[bookCode] = { BookTypeCode: bookCode, ParameterList: [] };\n  var list = groups[bookCode].ParameterList;\n  for (var i = 0; i < list.length; i++) {\n    if (list[i].queryFilter === row.queryFilter && s(list[i].parameter).trim().toUpperCase() === s(row.parameter).trim().toUpperCase()) return;\n  }\n  list.push(row);\n}\nfunction firstMatch(text, regexes) {\n  for (var i = 0; i < regexes.length; i++) {\n    var m = text.match(regexes[i]);\n    if (m && m[1]) return s(m[1]).trim();\n  }\n  return \"\";\n}\nfunction fallbackFromMessage(message) {\n  var defaultReason = firstMatch(message, [\n    /effective\\s+retirement\\s+reason\\s+for\\s+all\\s+items\\s+is\\s+([A-Za-z0-9 _\\-]+?)(?=\\s*,|\\s*\\.|\\s+and\\b|\\r|\\n|$)/i,\n    /Retirement\\s+Reason\\s*:\\s*([^\\r\\n]+)/i\n  ]).replace(/[.,;:]\\s*$/, \"\").trim();\n  var defaultBook = firstMatch(message, [/Book\\s*:\\s*([^\\r\\n]+)/i]).replace(/[.,;:]\\s*$/, \"\").trim();\n  var defaultDate = normalizeDate(firstMatch(message, [/Retirement\\s+Date\\s*:\\s*([^\\r\\n]+)/i]));\n  var groups = {};\n  var lines = s(message).split(/\\r?\\n/);\n  var inTable = false;\n  for (var i = 0; i < lines.length; i++) {\n    var line = s(lines[i]).trim();\n    if (!line) continue;\n    if (/Asset\\s+Number/i.test(line) && /Book/i.test(line)) {\n      inTable = true;\n      continue;\n    }\n    if (inTable && /^(Summary|Kindly|Thank|Thanks|Requested\\s+By)\\b/i.test(line)) break;\n    if (!inTable) continue;\n    var parts = line.split(/\\s{2,}/).filter(function (p) { return p !== \"\"; });\n    if (parts.length >= 1 && /^\\d+[A-Za-z0-9 _\\-]*$/.test(parts[0])) {\n      var assetNumber = parts[0].trim();\n      var rowBook = parts.length >= 2 ? parts[1].trim() : defaultBook;\n      var rowReason = parts.length >= 3 ? parts.slice(2).join(\" \").trim() : defaultReason;\n      if (!defaultBook && rowBook) defaultBook = rowBook;\n      addRow(groups, rowBook || defaultBook, cleanRow({ queryFilter: \"P_ASSET_NUMBER\", parameter: assetNumber, retirementReason: rowReason }, rowBook || defaultBook, rowReason || defaultReason, defaultDate));\n    }\n  }\n  return Object.keys(groups).map(function (k) { return groups[k]; });\n}\n\nvar input = parseMaybe(rawInput);\nif (input && input.result) input = input.result;\nif (!input || typeof input !== \"object\") input = {};\n\nvar transactions = Array.isArray(input.assetRetirementTransactions) ? input.assetRetirementTransactions : [];\nvar groups = {};\n\nfor (var i = 0; i < transactions.length; i++) {\n  var tx = transactions[i] || {};\n  var book = s(tx.BookTypeCode || tx.bookTypeCode || tx.book || tx.Book).trim();\n  var rows = Array.isArray(tx.ParameterList) ? tx.ParameterList : [];\n  for (var j = 0; j < rows.length; j++) {\n    addRow(groups, book, cleanRow(rows[j], book, \"\", \"\"));\n  }\n}\n\n// Accept a few common alternate LLM shapes instead of failing.\nvar alternateRows = [];\nif (Array.isArray(input.assets)) alternateRows = input.assets;\nelse if (Array.isArray(input.items)) alternateRows = input.items;\nelse if (Array.isArray(input.assetRetirements)) alternateRows = input.assetRetirements;\nfor (var a = 0; a < alternateRows.length; a++) {\n  var alt = alternateRows[a] || {};\n  var altBook = s(alt.BookTypeCode || alt.bookTypeCode || alt.book || alt.Book).trim();\n  addRow(groups, altBook, cleanRow(alt, altBook, alt.retirementReason || alt.RetirementReason || \"\", alt.retirementDate || alt.RetirementDate || alt.dateRetired || \"\"));\n}\n\nvar normalizedTransactions = Object.keys(groups).map(function (k) { return groups[k]; });\nif (normalizedTransactions.length === 0) normalizedTransactions = fallbackFromMessage(rawMessage);\n\nvar assetNumbersList = [];\nfor (var t = 0; t < normalizedTransactions.length; t++) {\n  var parameterRows = Array.isArray(normalizedTransactions[t].ParameterList) ? normalizedTransactions[t].ParameterList : [];\n  for (var p = 0; p < parameterRows.length; p++) {\n    var parameter = s(parameterRows[p].parameter).trim();\n    var queryFilter = s(parameterRows[p].queryFilter).trim();\n    if (!parameter || !queryFilter) continue;\n    var exists = false;\n    for (var e = 0; e < assetNumbersList.length; e++) {\n      if (assetNumbersList[e].queryFilter === queryFilter && s(assetNumbersList[e].parameter).trim().toUpperCase() === s(parameter).trim().toUpperCase()) {\n        exists = true;\n        break;\n      }\n    }\n    if (!exists) assetNumbersList.push({ queryFilter: queryFilter, parameter: parameter });\n  }\n}\n\nreturn {\n  assetNumbersList: assetNumbersList,\n  normalizedRetirementRequest: {\n    assetRetirementTransactions: normalizedTransactions\n  }\n};"
