          "metadata": {
            "name": "Apply Txn Edit",
            "returnType": "object",
            "sourceCode": "var currentDraftVar = $context.$variables.draftRetirementTransactions || {};\nvar previousDraftVar = $context.$variables.previousDraftRetirementTransactions || {};\nvar retirementNodeOutput = ($context.$nodes.RETIREMENTTRANSACTIONS && $context.$nodes.RETIREMENTTRANSACTIONS.$output) ? $context.$nodes.RETIREMENTTRANSACTIONS.$output : {};\n\nvar feedbackTx = unwrapTransactionArray(currentDraftVar);\nvar previousTx = unwrapTransactionArray(previousDraftVar);\nvar draftTx = unwrapTransactionArray(retirementNodeOutput);\nvar base = (feedbackTx && feedbackTx.length > 0) ? feedbackTx : ((previousTx && previousTx.length > 0) ? previousTx : draftTx);\nvar intent = unwrapIntent($context.$nodes.CHANGEUPDATES && $context.$nodes.CHANGEUPDATES.$output);\nif (!intent || !intent.action) { intent = { action: \"UNKNOWN\" }; }\nif (isProtectedFieldUpdateMessage($context.$system && $context.$system.$inputMessage)) { intent = { action: \"UNKNOWN\" }; }\nvar userMessage = s($context.$system && $context.$system.$inputMessage);\n\nvar reasonNodeOutput = ($context.$nodes.PARSERETIREMENTREASONLIST && $context.$nodes.PARSERETIREMENTREASONLIST.$output) ? $context.$nodes.PARSERETIREMENTREASONLIST.$output : {};\nvar conventionNodeOutput = ($context.$nodes.PARSERETIREMENTCONVENTIONLIST && $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output) ? $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output : {};\nvar retirementReasonResp = reasonNodeOutput.result || reasonNodeOutput || {};\nvar retirementConventionResp = conventionNodeOutput.result || conventionNodeOutput || {};\n\nfunction parseLooseJson(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n  }\n}\nfunction unwrapIntent(v) {\n  v = parseLooseJson(v);\n  if (!v || typeof v !== \"object\") return {};\n  if (v.result !== undefined) return unwrapIntent(v.result);\n  if (v.output !== undefined) return unwrapIntent(v.output);\n  if (v.retirementTransactionChangeIntent !== undefined) return unwrapIntent(v.retirementTransactionChangeIntent);\n  return v;\n}\nfunction unwrapTransactionArray(v) {\n  v = parseLooseJson(v);\n  if (!v) return [];\n  if (Array.isArray(v)) return v;\n  if (v.result !== undefined) return unwrapTransactionArray(v.result);\n  if (v.output !== undefined) return unwrapTransactionArray(v.output);\n  if (Array.isArray(v.items)) return v.items;\n  if (Array.isArray(v.collection)) return v.collection;\n  return [];\n}\nfunction s(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction key(v) { return s(v).trim().toUpperCase(); }\nfunction arr(v) { return Array.isArray(v) ? v : []; }\nfunction normalizeRowNumbers(v) {\n  var out = [];\n  function add(n) {\n    n = Number(n);\n    if (!isNaN(n) && n > 0 && out.indexOf(n) === -1) out.push(n);\n  }\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) add(v[i]);\n  } else if (typeof v === \"number\") {\n    add(v);\n  } else {\n    var textValue = s(v);\n    var m;\n    var re = /d+/g;\n    while ((m = re.exec(textValue)) !== null) add(m[0]);\n  }\n  return out;\n}\nfunction extractRowNumbersFromMessage(message) {\n  var rows = [];\n  var m = s(message);\n  var re = /\brows?s*(?:numbers*)?(?:#s*)?([0-9]+(?:s*(?:,|and)s*[0-9]+)*)/ig;\n  var match;\n  while ((match = re.exec(m)) !== null) {\n    rows = rows.concat(normalizeRowNumbers(match[1]));\n  }\n  return normalizeRowNumbers(rows);\n}\nfunction messageTargetsAllRows(message) {\n  return /\b(?:all|every|each)s+(?:assets?|transactions?|rows?)\b/i.test(s(message));\n}\nfunction numberValue(v) {\n  var n = Number(s(v).replace(/,/g, \"\"));\n  return isNaN(n) ? null : n;\n}\nfunction isoDate(v) {\n  var raw = s(v).trim();\n  if (!raw) return \"\";\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(raw)) return raw;\n  var d = new Date(raw);\n  if (isNaN(d.getTime())) return \"\";\n  return d.toISOString().slice(0, 10);\n}\nfunction listContains(values, actualValues) {\n  values = arr(values);\n  if (values.length === 0) return true;\n  var actualKeys = [];\n  for (var a = 0; a < actualValues.length; a++) {\n    var k = key(actualValues[a]);\n    if (k) actualKeys.push(k);\n  }\n  for (var i = 0; i < values.length; i++) {\n    if (actualKeys.indexOf(key(values[i])) !== -1) return true;\n  }\n  return false;\n}\nfunction listContainsExact(values, actualValues) {\n  values = arr(values);\n  if (values.length === 0) return true;\n  var actual = [];\n  for (var a = 0; a < actualValues.length; a++) {\n    var v = s(actualValues[a]).trim();\n    if (v) actual.push(v);\n  }\n  for (var i = 0; i < values.length; i++) {\n    if (actual.indexOf(s(values[i]).trim()) !== -1) return true;\n  }\n  return false;\n}\nfunction compareCost(actual, condition) {\n  var n = numberValue(actual);\n  if (n === null || !condition) return false;\n  var op = condition.operator;\n  var val = condition.value;\n  if (op === \">\") return n > Number(val);\n  if (op === \">=\") return n >= Number(val);\n  if (op === \"<\") return n < Number(val);\n  if (op === \"<=\") return n <= Number(val);\n  if (op === \"=\") return n === Number(val);\n  if (op === \"between\" && Array.isArray(val)) return n >= Number(val[0]) && n <= Number(val[1]);\n  return false;\n}\nfunction isProtectedFieldUpdateMessage(message) {\n  var m = s(message).toLowerCase();\n  if (!/\\b(update|change|set|fix|revise|correct)\\b/.test(m)) return false;\n  var protectedPattern = /(tag\\s*number|serial\\s*number|asset\\s*book|\\bbook\\b|asset\\s*description|\\bdescription\\b|asset\\s*number)/;\n  var editablePattern = /(comments?|retirement\\s*date|retirement\\s*reason|retirement\\s*convention|cost\\s*retired|proceeds\\s*of\\s*sale|cost\\s*of\\s*removal)/;\n  if (editablePattern.test(m)) return false;\n  return protectedPattern.test(m);\n}\nfunction normalizeCommentUpdate(value) {\n  var comment = s(value).trim();\n  comment = comment.replace(/^update\\s+comments?\\s+(to|as|with)\\s+/i, \"\");\n  comment = comment.replace(/^comments?\\s+(to|as|with)\\s+/i, \"\");\n  comment = comment.replace(/^comments?\\s*:\\s*/i, \"\");\n  comment = comment.replace(/\\s+for\\s+asset\\s+number\\s+.+$/i, \"\");\n  return comment.trim();\n}\nfunction updateValue(updates, keys) {\n  updates = updates || {};\n  for (var ui = 0; ui < keys.length; ui++) {\n    if (updates[keys[ui]] !== undefined) return updates[keys[ui]];\n  }\n  return undefined;\n}\nfunction compareDate(actual, condition) {\n  var actualIso = isoDate(actual);\n  if (!actualIso || !condition) return false;\n  if (typeof condition === \"string\") return actualIso === condition;\n  var op = condition.operator;\n  var val = condition.value;\n  if (op === \"between\" && Array.isArray(val)) return actualIso >= val[0] && actualIso <= val[1];\n  if (op === \">\") return actualIso > val;\n  if (op === \">=\") return actualIso >= val;\n  if (op === \"<\") return actualIso < val;\n  if (op === \"<=\") return actualIso <= val;\n  return false;\n}\n\nvar reasonByBook = {};\nvar reasonList = retirementReasonResp && retirementReasonResp.retirementReasonList ? retirementReasonResp.retirementReasonList : [];\nfor (var r = 0; r < reasonList.length; r++) {\n  var reasonBook = reasonList[r] || {};\n  var reasonBookCode = s(reasonBook.bookTypeCode);\n  var reasons = arr(reasonBook.retirementReason);\n  reasonByBook[reasonBookCode] = [];\n  for (var rr = 0; rr < reasons.length; rr++) {\n    reasonByBook[reasonBookCode].push({\n      code: s(reasons[rr].retirementReasonCode),\n      meaning: s(reasons[rr].retirementReasonMeaning)\n    });\n  }\n}\n\nvar conventionLookup = {};\nvar conventionLookupByBook = {};\nvar conventionBookBucketCount = 0;\nvar hasAnyConventionValues = false;\nvar conventionList = retirementConventionResp && retirementConventionResp.retirementConvention ? retirementConventionResp.retirementConvention : [];\nfunction conventionBookKey(v) { return key(v); }\nfunction putConvention(map, convCode, convId, convEntry) {\n  map[convCode] = convEntry;\n  if (convId !== null && convId !== undefined && convId !== \"\") map[String(convId)] = convEntry;\n}\nfor (var c = 0; c < conventionList.length; c++) {\n  var convRow = conventionList[c] || {};\n  var convCode = s(convRow.retirementConventionCode || convRow.conventionCode || convRow.code || convRow.X_CONVENTION_TYPE_CODE).trim();\n  var convId = convRow.retirementConventionId !== undefined ? convRow.retirementConventionId : (convRow.conventionId !== undefined ? convRow.conventionId : (convRow.id !== undefined ? convRow.id : convRow.X_CONVENTION_TYPE_ID));\n  var convBookKey = conventionBookKey(convRow.bookTypeCode || convRow.BookTypeCode || convRow.bookName || convRow.Book);\n  if (convCode) {\n    hasAnyConventionValues = true;\n    var convEntry = { code: convCode, id: convId, bookKey: convBookKey };\n    putConvention(conventionLookup, convCode, convId, convEntry);\n    if (!conventionLookupByBook[convBookKey]) {\n      conventionLookupByBook[convBookKey] = {};\n      if (convBookKey) conventionBookBucketCount++;\n    }\n    putConvention(conventionLookupByBook[convBookKey], convCode, convId, convEntry);\n  }\n}\nfunction findConventionForBook(bookValue, desiredValue) {\n  desiredValue = s(desiredValue).trim();\n  if (!desiredValue) return null;\n  var rowBookKey = conventionBookKey(bookValue);\n  var byBook = conventionLookupByBook[rowBookKey] || {};\n  if (byBook.hasOwnProperty(desiredValue)) return byBook[desiredValue];\n  if (conventionBookBucketCount === 0 && conventionLookup.hasOwnProperty(desiredValue)) return conventionLookup[desiredValue];\n  return null;\n}\n\nvar result = [];\nvar displayRowNumber = 0;\nbase = arr(base);\n\nfor (var i = 0; i < base.length; i++) {\n  if (!base[i] || !base[i].items || !base[i].items[0]) continue;\n  var row = JSON.parse(JSON.stringify(base[i].items[0]));\n  var p = row.ParameterList || {};\n  if (!p || Object.keys(p).length === 0) continue;\n\n  var newParams = {};\n  for (var keyName in p) newParams[keyName] = [];\n  if (!newParams.X_PROCEEDS_OF_SALE_TBL) newParams.X_PROCEEDS_OF_SALE_TBL = [];\n  if (!newParams.X_COST_OF_REMOVAL_TBL) newParams.X_COST_OF_REMOVAL_TBL = [];\n\n  var length = 0;\n  for (var lenKey in p) {\n    if (Array.isArray(p[lenKey])) length = Math.max(length, p[lenKey].length);\n  }\n\n  for (var rowIndex = 0; rowIndex < length; rowIndex++) {\n    var asset = p.X_ASSET_NUMBER_TBL && p.X_ASSET_NUMBER_TBL[rowIndex] !== undefined ? p.X_ASSET_NUMBER_TBL[rowIndex] : null;\n    var book = p.X_BOOK_TYPE_CODE_TBL && p.X_BOOK_TYPE_CODE_TBL[rowIndex] !== undefined ? p.X_BOOK_TYPE_CODE_TBL[rowIndex] : null;\n    var date = p.X_DATE_RETIRED_TBL && p.X_DATE_RETIRED_TBL[rowIndex] !== undefined ? p.X_DATE_RETIRED_TBL[rowIndex] : null;\n    var cost = p.X_COST_RET_TBL && p.X_COST_RET_TBL[rowIndex] !== undefined ? p.X_COST_RET_TBL[rowIndex] : null;\n    var reason = p.X_RETIREMENT_TYPE_CODE_TBL && p.X_RETIREMENT_TYPE_CODE_TBL[rowIndex] !== undefined ? p.X_RETIREMENT_TYPE_CODE_TBL[rowIndex] : null;\n    var reasonMeaning = p.X_RETIREMENT_REASON_TBL && p.X_RETIREMENT_REASON_TBL[rowIndex] !== undefined ? p.X_RETIREMENT_REASON_TBL[rowIndex] : null;\n    var txn = p.X_TRANSACTION_NAME_TBL && p.X_TRANSACTION_NAME_TBL[rowIndex] !== undefined ? p.X_TRANSACTION_NAME_TBL[rowIndex] : null;\n    var convCode = p.X_RET_CONV_TBL && p.X_RET_CONV_TBL[rowIndex] !== undefined ? p.X_RET_CONV_TBL[rowIndex] : null;\n    var convId = p.X_RET_CONV_CODE_TBL && p.X_RET_CONV_CODE_TBL[rowIndex] !== undefined ? p.X_RET_CONV_CODE_TBL[rowIndex] : null;\n    var proceedsSale = p.X_PROCEEDS_OF_SALE_TBL && p.X_PROCEEDS_OF_SALE_TBL[rowIndex] !== undefined ? p.X_PROCEEDS_OF_SALE_TBL[rowIndex] : (p.X_PROCEEDS_SALE_TBL && p.X_PROCEEDS_SALE_TBL[rowIndex] !== undefined ? p.X_PROCEEDS_SALE_TBL[rowIndex] : null);\n    var costRemoval = p.X_COST_OF_REMOVAL_TBL && p.X_COST_OF_REMOVAL_TBL[rowIndex] !== undefined ? p.X_COST_OF_REMOVAL_TBL[rowIndex] : null;\n\n    displayRowNumber++;\n\n    var match = true;\n    var criteria = intent.criteria || {};\n    var rowNumbers = normalizeRowNumbers(criteria.rowNumbers || criteria.rowNumber || intent.rowNumbers || intent.rowNumber);\n    if (rowNumbers.length === 0) rowNumbers = extractRowNumbersFromMessage(userMessage);\n    var applyToAllRows = intent.applyToAll === true || criteria.applyToAll === true || criteria.allAssets === true || messageTargetsAllRows(userMessage);\n\n    if (!applyToAllRows && rowNumbers.length > 0 && rowNumbers.indexOf(displayRowNumber) === -1) match = false;\n\n    if (criteria.assetNumber && criteria.assetNumber.length > 0 && !listContains(criteria.assetNumber, [asset])) match = false;\n    if (criteria.assetNumberExcept && criteria.assetNumberExcept.length > 0 && listContains(criteria.assetNumberExcept, [asset])) match = false;\n    if (criteria.book && criteria.book.length > 0 && !listContains(criteria.book, [book])) match = false;\n    if (criteria.retirementReason && criteria.retirementReason.length > 0 && !listContainsExact(criteria.retirementReason, [reason, reasonMeaning])) match = false;\n    if (criteria.retirementConvention && criteria.retirementConvention.length > 0 && !listContainsExact(criteria.retirementConvention, [convCode, convId])) match = false;\n    if (criteria.costRetired && !compareCost(cost, criteria.costRetired)) match = false;\n    if (criteria.dateRetired && !compareDate(date, criteria.dateRetired)) match = false;\n\n    if (intent.action === \"DEFER\" && match) continue;\n    if (intent.action === \"FILTER\" && !match) continue;\n\n    if (intent.action === \"UPDATE\" && match && intent.updates) {\n      if (intent.updates.costRetired !== undefined) cost = intent.updates.costRetired;\n      if (intent.updates.dateRetired) date = intent.updates.dateRetired;\n      if (intent.updates.comments !== undefined) {\n        var normalizedComment = normalizeCommentUpdate(intent.updates.comments);\n        if (isProtectedFieldUpdateMessage(normalizedComment)) {\n          normalizedComment = txn;\n        }\n        txn = normalizedComment;\n      }\n      var proceedsSaleUpdate = updateValue(intent.updates, [\"proceedsofSale\", \"proceedsOfSale\", \"proceedsOfSales\", \"proceedsSale\", \"proceeds\", \"saleProceeds\"]);\n      var costRemovalUpdate = updateValue(intent.updates, [\"costofRemoval\", \"costOfRemoval\", \"costRemoval\", \"removalCost\"]);\n      if (proceedsSaleUpdate !== undefined) proceedsSale = proceedsSaleUpdate;\n      if (costRemovalUpdate !== undefined) costRemoval = costRemovalUpdate;\n\n      if (intent.updates.retirementReason !== undefined) {\n        var desiredReason = s(intent.updates.retirementReason);\n        var foundReason = null;\n        var bookReasons = reasonByBook[s(book)] || [];\n        var desiredReasonKey = s(desiredReason).trim();\n        for (var rr2 = 0; rr2 < bookReasons.length; rr2++) {\n          if (s(bookReasons[rr2].code).trim() === desiredReasonKey || s(bookReasons[rr2].meaning).trim() === desiredReasonKey) {\n            foundReason = bookReasons[rr2];\n            break;\n          }\n        }\n        if (foundReason) {\n          reason = foundReason.code;\n          reasonMeaning = foundReason.meaning;\n          p.X_RETIREMENT_TYPE_CODE_TBL[rowIndex] = foundReason.code;\n          if (p.X_RETIREMENT_REASON_TBL) p.X_RETIREMENT_REASON_TBL[rowIndex] = foundReason.meaning;\n        } else {\n          reason = desiredReason;\n          reasonMeaning = desiredReason;\n          p.X_RETIREMENT_TYPE_CODE_TBL[rowIndex] = desiredReason;\n          if (p.X_RETIREMENT_REASON_TBL) p.X_RETIREMENT_REASON_TBL[rowIndex] = desiredReason;\n        }\n      }\n\n      if (intent.updates.retirementConvention !== undefined) {\n        var desiredConv = s(intent.updates.retirementConvention).trim();\n        var matchedConvention = findConventionForBook(book, desiredConv);\n        if (matchedConvention) {\n          convCode = matchedConvention.code;\n          convId = matchedConvention.id;\n          p.X_RET_CONV_TBL[rowIndex] = matchedConvention.code;\n          p.X_RET_CONV_CODE_TBL[rowIndex] = matchedConvention.id;\n        } else if (desiredConv && !hasAnyConventionValues) {\n          convCode = desiredConv;\n          p.X_RET_CONV_TBL[rowIndex] = desiredConv;\n          if (p.X_RET_CONV_CODE_TBL && (convId === null || convId === undefined)) p.X_RET_CONV_CODE_TBL[rowIndex] = \"\";\n        }\n      }\n    }\n\n    for (var key3 in newParams) {\n      if (key3 === \"X_ASSET_NUMBER_TBL\") newParams[key3].push(asset);\n      else if (key3 === \"X_BOOK_TYPE_CODE_TBL\") newParams[key3].push(book);\n      else if (key3 === \"X_DATE_RETIRED_TBL\") newParams[key3].push(date);\n      else if (key3 === \"X_COST_RET_TBL\") newParams[key3].push(cost);\n      else if (key3 === \"X_RETIREMENT_TYPE_CODE_TBL\") newParams[key3].push(reason);\n      else if (key3 === \"X_RETIREMENT_REASON_TBL\") newParams[key3].push(reasonMeaning);\n      else if (key3 === \"X_TRANSACTION_NAME_TBL\") newParams[key3].push(txn);\n      else if (key3 === \"X_RET_CONV_CODE_TBL\") newParams[key3].push(convId);\n      else if (key3 === \"X_RET_CONV_TBL\") newParams[key3].push(convCode);\n      else if (key3 === \"X_PROCEEDS_OF_SALE_TBL\") newParams[key3].push(proceedsSale);\n      else if (key3 === \"X_COST_OF_REMOVAL_TBL\") newParams[key3].push(costRemoval);\n      else newParams[key3].push(p[key3] && p[key3][rowIndex] !== undefined ? p[key3][rowIndex] : \"\");\n    }\n  }\n\n  var retainedLength = 0;\n  for (var retainedKey in newParams) {\n    if (Array.isArray(newParams[retainedKey])) retainedLength = Math.max(retainedLength, newParams[retainedKey].length);\n  }\n\n  if (retainedLength > 0) {\n    row.ParameterList = newParams;\n    result.push({ items: [row] });\n  }\n}\n\nreturn result;"
