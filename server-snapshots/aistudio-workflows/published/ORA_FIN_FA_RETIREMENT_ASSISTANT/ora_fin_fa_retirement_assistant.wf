            "name": "Parse Conventions",
            "returnType": "object",
            "sourceCode": "var output = $context.$nodes.OBTAINRETIREMENTCONVENTIONLIST.$output;\nvar sourceBooksOutput = ($context.$nodes.GETPRORATEASSETBOOK && $context.$nodes.GETPRORATEASSETBOOK.$output) ? $context.$nodes.GETPRORATEASSETBOOK.$output : {};\n\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction asArray(v) {\n  if (Array.isArray(v)) return v;\n  if (v === null || v === undefined || v === \"\") return [];\n  if (typeof v === \"string\") {\n    var raw = v.trim();\n    if (!raw) return [];\n    if (raw.charAt(0) === \"[\" || raw.charAt(0) === \"{\") {\n      try {\n        var parsed = JSON.parse(raw);\n        return Array.isArray(parsed) ? parsed : [parsed];\n      } catch (e) {}\n    }\n    return raw.split(\",\").map(function(x){ return x.trim(); }).filter(function(x){ return x !== \"\"; });\n  }\n  return [v];\n}\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction bookFromAny(v) {\n  v = parseMaybe(v);\n  if (!v || typeof v !== \"object\") return \"\";\n  var direct = text(v.bookTypeCode || v.BookTypeCode || v.bookName || v.Book || v.BookName || v.assetBook || \"\").trim();\n  if (direct) return direct;\n  var currentItem = v.currentItem || v.$currentItem || v.loopItem || v.item;\n  if (currentItem && typeof currentItem === \"object\") {\n    return text(currentItem.bookTypeCode || currentItem.BookTypeCode || currentItem.bookName || currentItem.Book || currentItem.BookName || \"\").trim();\n  }\n  return \"\";\n}\nfunction collectSourceBooks(v) {\n  v = parseMaybe(v);\n  if (!v) return [];\n  if (Array.isArray(v)) {\n    var all = [];\n    for (var i = 0; i < v.length; i++) {\n      if (bookFromAny(v[i])) all.push(v[i]);\n      else all = all.concat(collectSourceBooks(v[i]));\n    }\n    return all;\n  }\n  if (v.result !== undefined) return collectSourceBooks(v.result);\n  if (v.output !== undefined) return collectSourceBooks(v.output);\n  if (v.ProrateAssetBook !== undefined) return collectSourceBooks(v.ProrateAssetBook);\n  if (v.prorateAssetBook !== undefined) return collectSourceBooks(v.prorateAssetBook);\n  if (v.collection !== undefined) return collectSourceBooks(v.collection);\n  if (v.items !== undefined) return collectSourceBooks(v.items);\n  if (bookFromAny(v)) return [v];\n  return [];\n}\nvar sourceBooks = collectSourceBooks(sourceBooksOutput);\nfunction sourceBookAt(index) {\n  if (index === null || index === undefined) return \"\";\n  return bookFromAny(sourceBooks[index] || {});\n}\n\nvar result = { retirementConvention: [] };\nvar seen = {};\n\nfunction addRow(bookTypeCode, code, id) {\n  bookTypeCode = text(bookTypeCode).trim();\n  code = text(code).trim();\n  id = text(id).trim();\n  if (!code && !id) return;\n  var key = [bookTypeCode, code, id].join(\"||\");\n  if (seen[key]) return;\n  seen[key] = true;\n  result.retirementConvention.push({\n    bookTypeCode: bookTypeCode,\n    retirementConventionCode: code,\n    retirementConventionId: id\n  });\n}\nfunction addFromTableArrays(container, inheritedBook) {\n  container = container || {};\n  var bookTypeCode = text(bookFromAny(container) || inheritedBook || \"\").trim();\n  var codeValues = asArray(container.X_CONVENTION_TYPE_CODE_TBL || container.X_CONVENTION_TYPE_CODE || container.retirementConventionCode || container.conventionCode || container.code);\n  var idValues = asArray(container.X_CONVENTION_TYPE_ID_TBL || container.X_CONVENTION_TYPE_ID || container.retirementConventionId || container.conventionId || container.id);\n  var max = Math.max(codeValues.length, idValues.length);\n  for (var i = 0; i < max; i++) addRow(bookTypeCode, codeValues[i], idValues[i]);\n}\nfunction visit(v, inheritedBook, sourceIndex) {\n  v = parseMaybe(v);\n  if (!v) return;\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) visit(v[i], inheritedBook || sourceBookAt(i), i);\n    return;\n  }\n  var bookTypeCode = text(bookFromAny(v) || inheritedBook || sourceBookAt(sourceIndex) || \"\").trim();\n  if (v.result !== undefined) visit(v.result, bookTypeCode, sourceIndex);\n  if (v.output !== undefined) visit(v.output, bookTypeCode, sourceIndex);\n  if (Array.isArray(v.retirementConvention)) {\n    for (var j = 0; j < v.retirementConvention.length; j++) {\n      var row = v.retirementConvention[j] || {};\n      addRow(bookFromAny(row) || bookTypeCode, row.retirementConventionCode || row.conventionCode || row.code || row.X_CONVENTION_TYPE_CODE, row.retirementConventionId || row.conventionId || row.id || row.X_CONVENTION_TYPE_ID);\n    }\n  }\n  addFromTableArrays(v, bookTypeCode);\n}\n\nvisit(output, \"\", null);\n\nif (result.retirementConvention.length > 0) return result;\nreturn parseMaybe(output);"
          },
