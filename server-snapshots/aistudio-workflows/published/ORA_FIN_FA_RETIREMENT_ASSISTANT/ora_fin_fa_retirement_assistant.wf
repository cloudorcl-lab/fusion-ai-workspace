        {
          "metadata": {
            "name": "Validate Required Txn Fields",
            "returnType": "object",
            "sourceCode": "var data = ($context.$nodes.DRAFTRETIREMENTSDATA_POST_PROCEED && $context.$nodes.DRAFTRETIREMENTSDATA_POST_PROCEED.$output) || {};\nif (data && data.result !== undefined) data = data.result;\nvar rows = (data && Array.isArray(data.pendingRetirements)) ? data.pendingRetirements : [];\nvar state = $context.$variables.conversationRetirementFlowState || {};\nif (typeof state === \"string\") {\n  try { state = JSON.parse(state); } catch (e) { state = {}; }\n}\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction isBlank(v) {\n  var s = text(v).trim();\n  return s === \"\" || s === \"-\" || s.toLowerCase() === \"null\" || s.toLowerCase() === \"undefined\";\n}\nfunction esc(v) {\n  return text(v)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\nvar missingRows = [];\nfor (var i = 0; i < rows.length; i++) {\n  var row = rows[i] || {};\n  var missing = [];\n  if (isBlank(row.dateRetired || row.retirementDate)) missing.push(\"Retirement Date\");\n  if (isBlank(row.retirementConvention)) missing.push(\"Retirement Convention\");\n  if (missing.length > 0) {\n    missingRows.push({\n      row: i + 1,\n      assetNumber: text(row.assetNumber || row.AssetNumber),\n      bookName: text(row.bookName || row.bookTypeCode || row.BookTypeCode),\n      missingFields: missing\n    });\n  }\n}\nif (missingRows.length === 0) {\n  return { hasMissingRequiredFields: false, missingRows: [], message: \"\", html: \"\" };\n}\nvar message = \"Cannot proceed yet. Retirement Date and Retirement Convention are mandatory before posting.\";\nvar html = \"\";\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%;'>\";\nhtml += \"<div style='border:1px solid #d93025; background:#fff7f5; padding:10px 12px; margin-bottom:10px;'>\";\nhtml += \"<div style='font-weight:600; color:#b3261e; margin-bottom:6px;'>\" + esc(message) + \"</div>\";\nhtml += \"<div style='margin-bottom:6px;'>Please update the missing values, then reply with proceed again.</div>\";\nhtml += \"<table style='width:100%; border-collapse:collapse; margin-top:6px;'>\";\nhtml += \"<thead><tr style='background:#f5f5f5;'>\";\nhtml += \"<th style='text-align:left; padding:6px; border:1px solid #e0e0e0;'>Row</th>\";\nhtml += \"<th style='text-align:left; padding:6px; border:1px solid #e0e0e0;'>Asset Number</th>\";\nhtml += \"<th style='text-align:left; padding:6px; border:1px solid #e0e0e0;'>Book</th>\";\nhtml += \"<th style='text-align:left; padding:6px; border:1px solid #e0e0e0;'>Missing Values</th>\";\nhtml += \"</tr></thead><tbody>\";\nfor (var j = 0; j < missingRows.length; j++) {\n  var item = missingRows[j];\n  html += \"<tr>\";\n  html += \"<td style='padding:6px; border:1px solid #e0e0e0;'>\" + esc(item.row) + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #e0e0e0;'>\" + esc(item.assetNumber || \"-\") + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #e0e0e0;'>\" + esc(item.bookName || \"-\") + \"</td>\";\n  html += \"<td style='padding:6px; border:1px solid #e0e0e0;'>\" + esc(item.missingFields.join(\", \")) + \"</td>\";\n  html += \"</tr>\";\n}\nhtml += \"</tbody></table>\";\nhtml += \"<div style='margin-top:8px;'>Examples: Update Retirement Date to 31/03/2007 for Asset Number ASSET 001. Update Retirement Convention to MID-MONTH for Asset Number ASSET 001.</div>\";\nhtml += \"<div style='margin-top:4px;'>You can also ask: Provide the list of Retirement Convention for Book OPS CORP.</div>\";\nhtml += \"</div>\";\nvar lastReviewHtml = text(state.lastReviewHtml).trim();\nif (lastReviewHtml) {\n  html += lastReviewHtml;\n} else {\n  html += \"<div>The transaction review remains active. Please update the missing mandatory values and proceed again.</div>\";\n}\nhtml += \"</div>\";\nreturn { hasMissingRequiredFields: true, missingRows: missingRows, message: message, html: html };"
          },
