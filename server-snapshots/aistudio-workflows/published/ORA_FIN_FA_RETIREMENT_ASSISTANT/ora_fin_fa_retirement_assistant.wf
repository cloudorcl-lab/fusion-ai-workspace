            "sourceCode": "var draftTx = $context.$nodes.FORMATINGRETIREMENTTRANSACTION.$output.result;\n\n\nif (draftTx && !Array.isArray(draftTx) && Array.isArray(draftTx.result)) {\n  draftTx = draftTx.result;\n}\n\nvar assetIdList = [];\nvar seen = {};\n\nif (Array.isArray(draftTx)) {\n  for (var r = 0; r < draftTx.length; r++) {\n    var items = draftTx[r] && draftTx[r].items ? draftTx[r].items : [];\n\n    for (var j = 0; j < items.length; j++) {\n      var params = items[j] && items[j].ParameterList ? items[j].ParameterList : null;\n\n      if (params && Array.isArray(params.X_BOOK_TYPE_CODE_TBL)) {\n        for (var i = 0; i < params.X_BOOK_TYPE_CODE_TBL.length; i++) {\n          var bookCode = params.X_BOOK_TYPE_CODE_TBL[i];\n          var assetId = (params.X_ASSET_ID_TBL && params.X_ASSET_ID_TBL.length > i)\n            ? params.X_ASSET_ID_TBL[i]\n            : null;\n\n          var key = String(bookCode || \"\") + \"|\" + String(assetId || \"\");\n\n          if (bookCode && !seen[key]) {\n            seen[key] = true;\n            assetIdList.push({\n              BookTypeCode: bookCode,\n              AssetId: assetId\n            });\n          }\n        }\n      }\n    }\n  }\n}\n\nreturn {\n  assetIdList: assetIdList\n};"
