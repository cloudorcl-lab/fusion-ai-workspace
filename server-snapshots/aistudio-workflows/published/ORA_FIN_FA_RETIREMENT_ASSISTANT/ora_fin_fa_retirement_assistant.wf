        {
          "metadata": {
            "name": "Format Txn Rows",
            "returnType": "object",
            "sourceCode": "var input = $context.$nodes.PENDINGRETIREMENTTRANSACTIONS.$output;\n\n// unwrap result if present\nif (input && input.result) {\n    input = input.result;\n}\n\nvar draftTransactions = [];\n\nif (input && !Array.isArray(input) && Array.isArray(input.assetRetirements)) {\n\n    // NEW TRANSACTIONS\n    for (var i = 0; i < input.assetRetirements.length; i++) {\n        var row = input.assetRetirements[i] || {};\n\n        if (!row.BookTypeCode || !row.ParameterList) {\n            continue;\n        }\n\n        var params = {};\n        if (typeof row.ParameterList === \"object\") {\n            params = row.ParameterList;\n        } else if (typeof row.ParameterList === \"string\") {\n            try {\n                params = JSON.parse(row.ParameterList);\n            } catch (e) {\n                continue;\n            }\n        } else {\n            continue;\n        }\n\n        var cleanParams = {};\n        for (var key in params) {\n            if (Object.prototype.hasOwnProperty.call(params, key)) {\n                if (typeof params[key] === \"string\") {\n                    cleanParams[key] = params[key] === \"\" ? [] : params[key].split(\",\");\n                } else {\n                    cleanParams[key] = [];\n                }\n            }\n        }\n\n        draftTransactions.push({\n            items: [\n                {\n                    BookTypeCode: row.BookTypeCode,\n                    CurrencyCode: row.CurrencyCode || \"\",\n                    ParameterList: cleanParams\n                }\n            ]\n        });\n    }\n\n} else if (Array.isArray(input)) {\n\n    // PENDING TRANSACTIONS\n    for (var a = 0; a < input.length; a++) {\n        var item = input[a];\n\n        if (typeof item === \"string\") {\n            try {\n                item = JSON.parse(item);\n            } catch (e1) {\n                try {\n                    item = JSON.parse(JSON.parse(input[a]));\n                } catch (e2) {\n                    continue;\n                }\n            }\n        }\n\n        if (item && item.result) {\n            item = item.result;\n        }\n\n        if (!item || !Array.isArray(item.assetRetirements)) {\n            continue;\n        }\n\n        for (var b = 0; b < item.assetRetirements.length; b++) {\n            var row2 = item.assetRetirements[b] || {};\n\n            if (!row2.BookTypeCode || !row2.ParameterList) {\n                continue;\n            }\n\n            var params2 = {};\n            if (typeof row2.ParameterList === \"object\") {\n                params2 = row2.ParameterList;\n            } else if (typeof row2.ParameterList === \"string\") {\n                try {\n                    params2 = JSON.parse(row2.ParameterList);\n                } catch (e3) {\n                    continue;\n                }\n            } else {\n                continue;\n            }\n\n            var cleanParams2 = {};\n            for (var key2 in params2) {\n                if (Object.prototype.hasOwnProperty.call(params2, key2)) {\n                    if (typeof params2[key2] === \"string\") {\n                        cleanParams2[key2] = params2[key2] === \"\" ? [] : params2[key2].split(\",\");\n                    } else {\n                        cleanParams2[key2] = [];\n                    }\n                }\n            }\n\n            draftTransactions.push({\n                items: [\n                    {\n                        BookTypeCode: row2.BookTypeCode,\n                        CurrencyCode: row2.CurrencyCode || \"\",\n                        ParameterList: cleanParams2\n                    }\n                ]\n            });\n        }\n    }\n}\n\ndraftTransactions;"
          },
          "outcomes": {
            "success": "1775753932619"
          },
