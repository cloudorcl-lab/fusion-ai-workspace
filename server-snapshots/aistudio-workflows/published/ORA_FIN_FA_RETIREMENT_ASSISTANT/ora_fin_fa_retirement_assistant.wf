                  "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"defaultConvention\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"bookTypeCode\": {\n          \"type\": \"string\"\n        },\n        \"assetId\": {\n          \"type\": \"string\"\n        },\n        \"conventionId\": {\n          \"type\": \"string\"\n        },\n        \"conventionCode\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"book\",\n        \"assetId\",\n        \"conventionId\",\n        \"conventionCode\"\n      ],\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"defaultConvention\"\n  ],\n  \"additionalProperties\": false\n}",
