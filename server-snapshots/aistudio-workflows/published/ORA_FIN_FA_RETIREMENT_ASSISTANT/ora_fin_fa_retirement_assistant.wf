            "returnType": "object",
            "sourceCode": "var input = $context.$nodes.GETCURRENCYPRECISION_NEW_LANE.$output ;\n\nvar parsedOutput = [];\n\n// Case 1: output is already an array\nif (Array.isArray(input)) {\n  for (var i = 0; i < input.length; i++) {\n    var item = input[i];\n\n    if (typeof item === \"string\") {\n      try {\n        parsedOutput.push(JSON.parse(item));\n      } catch (e) {\n        // skip invalid JSON string\n      }\n    } else if (item && typeof item === \"object\") {\n      parsedOutput.push(item);\n    }\n  }\n} else if (typeof input === \"string\") {\n  // Case 2: output is a single JSON string\n  try {\n    var parsed = JSON.parse(input);\n\n    if (Array.isArray(parsed)) {\n      parsedOutput = parsed;\n    } else {\n      parsedOutput.push(parsed);\n    }\n  } catch (e) {\n    parsedOutput = [];\n  }\n} else if (input && typeof input === \"object\") {\n  // Case 3: already parsed object\n  parsedOutput.push(input);\n}\n\nreturn parsedOutput;"
