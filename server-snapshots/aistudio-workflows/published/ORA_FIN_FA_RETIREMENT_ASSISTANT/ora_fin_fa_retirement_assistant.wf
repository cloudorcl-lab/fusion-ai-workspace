          "code": "RETIREMENTREQUESTHTML_REQ_CHANGE",
          "id": "1881000000010",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Save Request State - Edit",
            "returnType": "object",
            "sourceCode": "var prior = $context.$variables.conversationRetirementFlowState || {};\nvar extractOutput = ($context.$nodes.EXTRACTASSETNUMBERLIST_REQ_CHANGE && $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_CHANGE.$output) ? $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_CHANGE.$output : {};\nvar request = (extractOutput.result && extractOutput.result.normalizedRetirementRequest) ? extractOutput.result.normalizedRetirementRequest : (extractOutput.normalizedRetirementRequest || $context.$variables.retirementChangeRequestJson || {});\nvar assetInfoInput = $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.$output || [];\n\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction uniqueKey(parts) { return parts.join(\"||\"); }\nfunction collectRetirementReasons(src) {\n  var out = [];\n  var seen = {};\n  function addBook(bookObj) {\n    bookObj = bookObj || {};\n    var bookCode = text(bookObj.bookTypeCode || bookObj.BookTypeCode || bookObj.bookName || bookObj.Book || \"\").trim();\n    var reasons = asArray(bookObj.retirementReason || bookObj.retirementReasons || bookObj.reasons);\n    var rows = [];\n    for (var i = 0; i < reasons.length; i++) {\n      var r = reasons[i] || {};\n      var code = text(r.retirementReasonCode || r.code || r.lookupCode || r.X_LOOKUP_CODE || \"\").trim();\n      var meaning = text(r.retirementReasonMeaning || r.meaning || r.description || r.X_MEANING || \"\").trim();\n      if (!code && !meaning) continue;\n      var rowKey = uniqueKey([bookCode, code, meaning]);\n      if (seen[rowKey]) continue;\n      seen[rowKey] = true;\n      rows.push({ retirementReasonCode: code, retirementReasonMeaning: meaning });\n    }\n    if (rows.length > 0) out.push({ bookTypeCode: bookCode, retirementReason: rows });\n  }\n  function visit(v) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i]); return; }\n    if (v.result) visit(v.result);\n    if (Array.isArray(v.retirementReasonList)) { for (var j = 0; j < v.retirementReasonList.length; j++) addBook(v.retirementReasonList[j]); return; }\n    if (v.bookTypeCode && Array.isArray(v.retirementReason)) addBook(v);\n  }\n  visit(src);\n  return out;\n}\nfunction collectRetirementConventions(src) {\n  var out = [];\n  var seen = {};\n  function addConv(v, inheritedBook) {\n    v = v || {};\n    var code = text(v.retirementConventionCode || v.conventionCode || v.code || v.X_CONVENTION_TYPE_CODE || \"\").trim();\n    var id = text(v.retirementConventionId || v.conventionId || v.id || v.X_CONVENTION_TYPE_ID || \"\").trim();\n    var bookCode = text(v.bookTypeCode || v.BookTypeCode || inheritedBook || \"\").trim();\n    if (!code && !id) return;\n    var rowKey = uniqueKey([bookCode, code, id]);\n    if (seen[rowKey]) return;\n    seen[rowKey] = true;\n    out.push({ bookTypeCode: bookCode, retirementConventionCode: code, retirementConventionId: id });\n  }\n  function visit(v, inheritedBook) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i], inheritedBook); return; }\n    if (v.result) visit(v.result, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n    if (Array.isArray(v.retirementConvention)) { for (var j = 0; j < v.retirementConvention.length; j++) addConv(v.retirementConvention[j], inheritedBook || v.bookTypeCode || v.BookTypeCode); return; }\n    if (v.retirementConventionCode || v.conventionCode || v.X_CONVENTION_TYPE_CODE) addConv(v, inheritedBook);\n  }\n  visit(src, \"\");\n  return out;\n}\nfunction activeBookList(rows) {\n  var seenBooks = {};\n  var books = [];\n  rows = asArray(rows);\n  for (var i = 0; i < rows.length; i++) {\n    var b = text(rows[i].bookTypeCode || rows[i].bookName || rows[i].BookTypeCode || \"\").trim();\n    if (b && !seenBooks[b]) { seenBooks[b] = true; books.push(b); }\n  }\n  return books;\n}\nfunction applySingleBookToConventions(conventions, books) {\n  conventions = asArray(conventions);\n  books = asArray(books);\n  if (books.length !== 1) return conventions;\n  for (var i = 0; i < conventions.length; i++) {\n    if (!text(conventions[i].bookTypeCode).trim()) conventions[i].bookTypeCode = books[0];\n  }\n  return conventions;\n}\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction flattenAssetInfo(input) {\n  var rows = [];\n  var seenAssetRows = {};\n\n  function parseLoopJson(v) {\n    if (typeof v !== \"string\") return v;\n    try { return JSON.parse(v); } catch (e1) {\n      try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n    }\n  }\n\n  function addAssetRow(row) {\n    if (!row || typeof row !== \"object\") return;\n    var key;\n    try { key = JSON.stringify(row); } catch (e) { key = String(rows.length); }\n    if (seenAssetRows[key]) return;\n    seenAssetRows[key] = true;\n    rows.push(row);\n  }\n\n  function collectAssetRows(value, depth) {\n    if (depth > 12 || value === null || value === undefined) return;\n    value = parseLoopJson(value);\n    if (Array.isArray(value)) {\n      for (var i = 0; i < value.length; i++) collectAssetRows(value[i], depth + 1);\n      return;\n    }\n    if (!value || typeof value !== \"object\") return;\n    if (isAssetInfoRow(value)) {\n      addAssetRow(value);\n      return;\n    }\n    if (Array.isArray(value.assetInfoList)) {\n      for (var r = 0; r < value.assetInfoList.length; r++) addAssetRow(value.assetInfoList[r]);\n    }\n    var keys = Object.keys(value);\n    for (var k = 0; k < keys.length; k++) {\n      if (keys[k] !== \"assetInfoList\") collectAssetRows(value[keys[k]], depth + 1);\n    }\n  }\n\n  collectAssetRows(input, 0);\n  return rows;\n}\n\nfunction isAssetInfoRow(row) {\n  if (!row || typeof row !== \"object\") return false;\n  var keys = [\n    \"assetNumber\", \"AssetNumber\", \"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\",\n    \"bookTypeCode\", \"BookTypeCode\", \"bookName\", \"X_CORP_BOOK_TYPE_CODE\", \"X_BOOK_TYPE_CODE\",\n    \"description\", \"assetDescription\", \"Description\", \"X_DESCRIPTION_TBL\", \"X_ASSET_DESCRIPTION_TBL\",\n    \"assetId\", \"AssetId\", \"X_ASSET_ID\", \"X_ASSET_ID_TBL\",\n    \"TagNumber\", \"tagNumber\", \"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\",\n    \"serialNumber\", \"SerialNumber\", \"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\",\n    \"cost\", \"costRetired\", \"X_COST\", \"X_COST_TBL\",\n    \"valid\", \"comments\", \"CurrencyCode\", \"currencyCode\"\n  ];\n  for (var i = 0; i < keys.length; i++) {\n    if (row[keys[i]] !== null && row[keys[i]] !== undefined && String(row[keys[i]]).trim() !== \"\") return true;\n  }\n  return false;\n}\n\n\nfunction fallbackRowsFromRequestForState(request, prior) {\n  request = parseAny(request) || {};\n  if (request.result) request = parseAny(request.result) || {};\n  if (request.normalizedRetirementRequest) request = parseAny(request.normalizedRetirementRequest) || {};\n  prior = parseAny(prior) || {};\n  var priorAssets = asArray(prior.activeAssets);\n  function first(values) {\n    for (var i = 0; i < values.length; i++) {\n      if (values[i] !== null && values[i] !== undefined && text(values[i]).trim() !== \"\") return values[i];\n    }\n    return \"\";\n  }\n  function findPrior(type, parameter) {\n    var needle = text(parameter).trim().toUpperCase();\n    for (var i = 0; i < priorAssets.length; i++) {\n      var a = priorAssets[i] || {};\n      var candidates = [];\n      if (type === \"asset\") candidates.push(a.assetNumber, a.AssetNumber);\n      if (type === \"tag\") candidates.push(a.tagNumber, a.TagNumber);\n      if (type === \"serial\") candidates.push(a.serialNumber, a.SerialNumber);\n      candidates.push(a.assetNumber, a.AssetNumber, a.tagNumber, a.TagNumber, a.serialNumber, a.SerialNumber);\n      for (var c = 0; c < candidates.length; c++) {\n        if (text(candidates[c]).trim().toUpperCase() === needle) return a;\n      }\n    }\n    return {};\n  }\n  function rowIdentifier(row) {\n    row = row || {};\n    var queryFilter = text(row.queryFilter).toUpperCase();\n    var type = queryFilter.indexOf(\"TAG\") > -1 ? \"tag\" : (queryFilter.indexOf(\"SERIAL\") > -1 ? \"serial\" : \"asset\");\n    var parameter = first([row.parameter, row.assetNumber, row.AssetNumber, row.tagNumber, row.TagNumber, row.serialNumber, row.SerialNumber]);\n    return { type: type, parameter: parameter };\n  }\n  var txs = asArray(request.assetRetirementTransactions);\n  var out = [];\n  for (var t = 0; t < txs.length; t++) {\n    var tx = txs[t] || {};\n    var book = first([tx.BookTypeCode, tx.bookTypeCode, tx.book, tx.Book]);\n    var list = asArray(tx.ParameterList);\n    for (var r = 0; r < list.length; r++) {\n      var reqRow = list[r] || {};\n      var id = rowIdentifier(reqRow);\n      if (!id.parameter) continue;\n      var priorRow = findPrior(id.type, id.parameter);\n      out.push({\n        assetId: text(priorRow.assetId),\n        bookTypeCode: text(first([priorRow.bookTypeCode, priorRow.bookName, book])),\n        bookName: text(first([priorRow.bookName, priorRow.bookTypeCode, book])),\n        CurrencyCode: text(priorRow.currencyCode || priorRow.CurrencyCode),\n        currencyCode: text(priorRow.currencyCode || priorRow.CurrencyCode),\n        assetNumber: text(id.type === \"asset\" ? id.parameter : first([priorRow.assetNumber, priorRow.AssetNumber])),\n        description: text(first([priorRow.description, priorRow.assetDescription])),\n        TagNumber: text(id.type === \"tag\" ? id.parameter : first([priorRow.TagNumber, priorRow.tagNumber])),\n        tagNumber: text(id.type === \"tag\" ? id.parameter : first([priorRow.TagNumber, priorRow.tagNumber])),\n        serialNumber: text(id.type === \"serial\" ? id.parameter : priorRow.serialNumber),\n        cost: text(first([priorRow.costRetired, priorRow.cost, \"1\"])),\n        costRetired: text(first([priorRow.costRetired, priorRow.cost, \"\"])),\n        retirementDate: text(first([reqRow.retirementDate, reqRow.dateRetired, priorRow.retirementDate])),\n        retirementReason: text(first([reqRow.retirementReason, reqRow.RetirementReason, priorRow.retirementReason])),\n        retirementConvention: text(priorRow.retirementConvention),\n        valid: priorRow.assetNumber || priorRow.tagNumber || priorRow.serialNumber ? \"Y\" : \"N\",\n        comments: priorRow.assetNumber || priorRow.tagNumber || priorRow.serialNumber ? \"\" : (\"Asset validation did not return details for \" + id.parameter + \".\")\n      });\n    }\n  }\n  return out;\n}\n\nfunction stateRowIdentityParts(item) {\n  item = item || {};\n  var source = text(item.queryFilter || \"\").toUpperCase();\n  var type = source.indexOf(\"TAG\") > -1 ? \"tag\" : (source.indexOf(\"SERIAL\") > -1 ? \"serial\" : \"asset\");\n  var parameter = text(item.parameter).trim().toUpperCase();\n  var asset = text(item.assetNumber || item.AssetNumber).trim().toUpperCase();\n  var tag = text(item.tagNumber || item.TagNumber).trim().toUpperCase();\n  var serial = text(item.serialNumber || item.SerialNumber).trim().toUpperCase();\n  var value = text(item.parameter || item.assetNumber || item.AssetNumber || item.tagNumber || item.TagNumber || item.serialNumber || item.SerialNumber).trim().toUpperCase();\n  return { type: type, parameter: parameter, asset: asset, tag: tag, serial: serial, value: value };\n}\nfunction stateRowIdentityKey(item) {\n  var p = stateRowIdentityParts(item);\n  return p.type + \"|\" + p.value;\n}\nfunction sameStateResolvedAssetOrRequestedIdentifier(left, right) {\n  var a = stateRowIdentityParts(left);\n  var b = stateRowIdentityParts(right);\n  if (a.asset && b.asset && a.asset === b.asset) return true;\n  if (a.tag && b.tag && a.tag === b.tag) return true;\n  if (a.serial && b.serial && a.serial === b.serial) return true;\n  if (a.type === \"tag\" && a.parameter && (a.parameter === b.tag || a.parameter === b.value)) return true;\n  if (b.type === \"tag\" && b.parameter && (b.parameter === a.tag || b.parameter === a.value)) return true;\n  if (a.type === \"serial\" && a.parameter && (a.parameter === b.serial || a.parameter === b.value)) return true;\n  if (b.type === \"serial\" && b.parameter && (b.parameter === a.serial || b.parameter === a.value)) return true;\n  return false;\n}\nfunction mergeMissingStateFallbackRows(rows) {\n  var fallbackRows = fallbackRowsFromRequestForState(request, prior);\n  var seen = {};\n  rows = asArray(rows);\n  for (var i = 0; i < rows.length; i++) {\n    var key = stateRowIdentityKey(rows[i]);\n    if (key !== \"asset|\") seen[key] = true;\n  }\n  for (var j = 0; j < fallbackRows.length; j++) {\n    var fkey = stateRowIdentityKey(fallbackRows[j]);\n    if (fkey === \"asset|\" || seen[fkey]) continue;\n    var duplicate = false;\n    for (var r = 0; r < rows.length; r++) {\n      if (sameStateResolvedAssetOrRequestedIdentifier(rows[r], fallbackRows[j])) {\n        duplicate = true;\n        break;\n      }\n    }\n    if (duplicate) continue;\n    rows.push(fallbackRows[j]);\n    seen[fkey] = true;\n  }\n  return rows;\n}\nvar rows = flattenAssetInfo(assetInfoInput);\nif (rows.length === 0) rows = fallbackRowsFromRequestForState(request, prior);\nelse rows = mergeMissingStateFallbackRows(rows);\nvar activeAssets = [];\nfor (var i = 0; i < rows.length; i++) {\n  var a = rows[i] || {};\n  var valid = text(a.valid).toUpperCase() === \"Y\";\n  activeAssets.push({\n    assetId: text(a.assetId),\n    bookTypeCode: text(a.bookTypeCode),\n    bookName: text(a.bookName || a.bookTypeCode),\n    currencyCode: text(a.CurrencyCode || a.currencyCode),\n    assetNumber: text(a.assetNumber),\n    description: text(a.description || a.assetDescription),\n    tagNumber: text(a.TagNumber || a.tagNumber),\n    serialNumber: text(a.serialNumber),\n    costRetired: text(a.cost || a.costRetired),\n    retirementDate: text(a.retirementDate || a.dateRetired),\n    retirementReason: text(a.retirementReason),\n    retirementConvention: text(a.retirementConvention),\n    status: valid ? \"ready_for_request_review\" : \"invalid_or_unavailable\",\n    validationMessage: text(a.comments)\n  });\n}\n\nvar availableRetirementReasons = collectRetirementReasons($context.$nodes.PARSERETIREMENTREASONLIST && $context.$nodes.PARSERETIREMENTREASONLIST.$output);\nif (availableRetirementReasons.length === 0) availableRetirementReasons = asArray(prior.availableRetirementReasons);\nvar availableRetirementConventions = collectRetirementConventions($context.$nodes.PARSERETIREMENTCONVENTIONLIST && $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output);\navailableRetirementConventions = applySingleBookToConventions(availableRetirementConventions, activeBookList(activeAssets.length ? activeAssets : rows));\nif (availableRetirementConventions.length === 0) availableRetirementConventions = asArray(prior.availableRetirementConventions);\nvar events = asArray(prior.events).slice(0);\nevents.push({ action: \"request_review_ready\", stage: \"RETIREMENT_REQUEST_REVIEW\", assetCount: activeAssets.length });\n\nreturn {\n  schemaVersion: \"1.0\",\n  stage: \"RETIREMENT_REQUEST_REVIEW\",\n  source: \"CHAT_RETIREMENT_REQUEST\",\n  lastUserMessage: text($context.$system.$inputMessage),\n  activeAssets: activeAssets,\n  removedAssets: asArray(prior.removedAssets),\n  pendingRequest: request,\n  availableRetirementReasons: availableRetirementReasons,\n  availableRetirementConventions: availableRetirementConventions,\n  draftTransactions: asArray(prior.draftTransactions),\n  postResults: asArray(prior.postResults),\n  lastReviewHtml: text($context.$nodes.RETIREMENTREQUESTHTML_REQ_CHANGE.$output.result),\n  events: events\n};"
          },
