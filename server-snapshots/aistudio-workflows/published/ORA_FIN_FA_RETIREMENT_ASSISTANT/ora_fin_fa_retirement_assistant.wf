            "returnType": "object",
            "sourceCode": "var currentDraftVar = $context.$variables.draftRetirementTransactions || {};\nvar previousDraftVar = $context.$variables.previousDraftRetirementTransactions || {};\nvar retirementNodeOutput = ($context.$nodes.RETIREMENTTRANSACTIONS && $context.$nodes.RETIREMENTTRANSACTIONS.$output) ? $context.$nodes.RETIREMENTTRANSACTIONS.$output : {};\n\nvar feedbackTx = unwrapTransactionArray(currentDraftVar);\nvar previousTx = unwrapTransactionArray(previousDraftVar);\nvar draftTx = unwrapTransactionArray(retirementNodeOutput);\nvar base = (feedbackTx && feedbackTx.length > 0) ? feedbackTx : ((previousTx && previousTx.length > 0) ? previousTx : draftTx);\nvar intent = unwrapIntent($context.$nodes.CHANGEUPDATES_TX_CHANGE_EXISTING && $context.$nodes.CHANGEUPDATES_TX_CHANGE_EXISTING.$output);\nif (!intent || !intent.action) { intent = { action: \"UNKNOWN\" }; }\nif (isProtectedFieldUpdateMessage($context.$system && $context.$system.$inputMessage)) { intent = { action: \"UNKNOWN\" }; }\nvar userMessage = s($context.$system && $context.$system.$inputMessage);\n\nvar priorState = parseLooseJson($context.$variables.conversationRetirementFlowState || {}) || {};\nvar reasonNodeOutput = ($context.$nodes.PARSERETIREMENTREASONLIST && $context.$nodes.PARSERETIREMENTREASONLIST.$output) ? $context.$nodes.PARSERETIREMENTREASONLIST.$output : {};\nvar conventionNodeOutput = ($context.$nodes.PARSERETIREMENTCONVENTIONLIST && $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output) ? $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output : {};\nvar retirementReasonResp = reasonNodeOutput.result || reasonNodeOutput || {};\nvar retirementConventionResp = conventionNodeOutput.result || conventionNodeOutput || {};\nif (!retirementReasonResp.retirementReasonList && Array.isArray(priorState.availableRetirementReasons) && priorState.availableRetirementReasons.length > 0) retirementReasonResp = { retirementReasonList: priorState.availableRetirementReasons };\nif (!retirementConventionResp.retirementConvention && Array.isArray(priorState.availableRetirementConventions) && priorState.availableRetirementConventions.length > 0) retirementConventionResp = { retirementConvention: priorState.availableRetirementConventions };\n\nfunction parseLooseJson(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n  }\n}\nfunction unwrapIntent(v) {\n  v = parseLooseJson(v);\n  if (!v || typeof v !== \"object\") return {};\n  if (v.result !== undefined) return unwrapIntent(v.result);\n  if (v.output !== undefined) return unwrapIntent(v.output);\n  if (v.retirementTransactionChangeIntent !== undefined) return unwrapIntent(v.retirementTransactionChangeIntent);\n  return v;\n}\nfunction unwrapTransactionArray(v) {\n  v = parseLooseJson(v);\n  if (!v) return [];\n  if (Array.isArray(v)) return v;\n  if (v.result !== undefined) return unwrapTransactionArray(v.result);\n  if (v.output !== undefined) return unwrapTransactionArray(v.output);\n  if (Array.isArray(v.items)) return v.items;\n  if (Array.isArray(v.collection)) return v.collection;\n  return [];\n}\nfunction s(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction key(v) { return s(v).trim().toUpperCase(); }\nfunction arr(v) { return Array.isArray(v) ? v : []; }\nfunction normalizeRowNumbers(v) {\n  var out = [];\n  function add(n) {\n    n = Number(n);\n    if (!isNaN(n) && n > 0 && out.indexOf(n) === -1) out.push(n);\n  }\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) add(v[i]);\n  } else if (typeof v === \"number\") {\n    add(v);\n  } else {\n    var textValue = s(v);\n    var m;\n    var re = /d+/g;\n    while ((m = re.exec(textValue)) !== null) add(m[0]);\n  }\n  return out;\n}\nfunction extractRowNumbersFromMessage(message) {\n  var rows = [];\n  var m = s(message);\n  var re = /\brows?s*(?:numbers*)?(?:#s*)?([0-9]+(?:s*(?:,|and)s*[0-9]+)*)/ig;\n  var match;\n  while ((match = re.exec(m)) !== null) {\n    rows = rows.concat(normalizeRowNumbers(match[1]));\n  }\n  return normalizeRowNumbers(rows);\n}\nfunction messageTargetsAllRows(message) {\n  return /\b(?:all|every|each)s+(?:assets?|transactions?|rows?)\b/i.test(s(message));\n}\nfunction numberValue(v) {\n  var n = Number(s(v).replace(/,/g, \"\"));\n  return isNaN(n) ? null : n;\n}\nfunction isoDate(v) {\n  var raw = s(v).trim();\n  if (!raw) return \"\";\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(raw)) return raw;\n  var d = new Date(raw);\n  if (isNaN(d.getTime())) return \"\";\n  return d.toISOString().slice(0, 10);\n}\nfunction listContains(values, actualValues) {\n  values = arr(values);\n  if (values.length === 0) return true;\n  var actualKeys = [];\n  for (var a = 0; a < actualValues.length; a++) {\n    var k = key(actualValues[a]);\n    if (k) actualKeys.push(k);\n  }\n  for (var i = 0; i < values.length; i++) {\n    if (actualKeys.indexOf(key(values[i])) !== -1) return true;\n  }\n  return false;\n}\nfunction listContainsExact(values, actualValues) {\n  values = arr(values);\n  if (values.length === 0) return true;\n  var actual = [];\n  for (var a = 0; a < actualValues.length; a++) {\n    var v = s(actualValues[a]).trim();\n    if (v) actual.push(v);\n  }\n  for (var i = 0; i < values.length; i++) {\n    if (actual.indexOf(s(values[i]).trim()) !== -1) return true;\n  }\n  return false;\n}\nfunction compareCost(actual, condition) {\n  var n = numberValue(actual);\n  if (n === null || !condition) return false;\n  var op = condition.operator;\n  var val = condition.value;\n  if (op === \">\") return n > Number(val);\n  if (op === \">=\") return n >= Number(val);\n  if (op === \"<\") return n < Number(val);\n  if (op === \"<=\") return n <= Number(val);\n  if (op === \"=\") return n === Number(val);\n  if (op === \"between\" && Array.isArray(val)) return n >= Number(val[0]) && n <= Number(val[1]);\n  return false;\n}\nfunction isProtectedFieldUpdateMessage(messa