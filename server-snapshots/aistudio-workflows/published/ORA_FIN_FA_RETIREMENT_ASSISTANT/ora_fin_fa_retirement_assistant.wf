          "inputs": [
            {
              "id": "1776269712122_1",
              "name": "prompt",
              "type": "string",
              "value": "========================\nINPUT\n========================\nUser message:\n{{$context.$system.$inputMessage}}\n\nActive stage:\n{{$context.$variables.retirementConversationStage}}\n\nCurrent request JSON:\n{{$context.$variables.retirementChangeRequestJson}}\n\n========================\nGUARDRAIL\n========================\nIf Active stage is not RETIREMENT_REQUEST_REVIEW, or the user message is empty, or the user only approves/proceeds/cancels, return this valid no-op JSON:\n{\"retirementRequestChangeIntent\":{\"action\":\"modify_retirement_request\",\"operations\":{\"add\":[],\"remove\":[],\"removeRows\":[],\"updateFields\":[]}}}\n\n========================\nTASK\n========================\nConvert the user message into changes for the currently displayed asset retirement request.\n\nMeaning rules:\n- include, add -> add\n- add another asset means add the new identifier only; do not remove existing identifiers unless the user explicitly says remove, defer, exclude, skip, or replace\n- defer, remove, exclude, skip -> remove by identifier, or removeRows when the user says Row/Rows\n- replace old asset with new asset -> remove old and add new\n- update/change/set/fix cost, reason, or date -> updateFields\n\nIdentifier types:\n- assetNumber\n- serialNumber\n- tagNumber\n\nEditable fields in updateFields:\n- costRetired\n- retirementReason\n- retirementDate\n\nReturn ONLY valid JSON:\n{\n  \"retirementRequestChangeIntent\": {\n    \"action\": \"modify_retirement_request\",\n    \"operations\": {\n      \"add\": [],\n      \"remove\": [],\n      \"removeRows\": [],\n      \"updateFields\": []\n    }\n  }\n}\n\nExamples:\n- \"Add Asset with Tag Number TAG001\" -> operations.add contains {\"type\":\"tagNumber\",\"value\":\"TAG001\"}.\n- \"Add Asset with Serial Number SER001\" -> operations.add contains {\"type\":\"serialNumber\",\"value\":\"SER001\"}.\n- \"Remove Tag Number TAG001\" -> operations.remove contains {\"type\":\"tagNumber\",\"value\":\"TAG001\"}.\n\n- \"Remove Row 2\" -> operations.removeRows contains 2.\n- \"Remove rows 2 and 3\" -> operations.removeRows contains 2 and 3.\n- Row numbers mean the rows currently displayed in the Asset Retirement Details table."
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"required\": [\n    \"retirementRequestChangeIntent\"\n  ],\n  \"properties\": {\n    \"retirementRequestChangeIntent\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"action\",\n        \"operations\"\n      ],\n      \"properties\": {\n        \"action\": {\n          \"type\": \"string\",\n          \"enum\": [\n            \"modify_retirement_request\"\n          ]\n        },\n        \"operations\": {\n          \"type\": \"object\",\n          \"required\": [\n            \"add\",\n            \"remove\",\n            \"updateFields\"\n          ],\n          \"properties\": {\n            \"add\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"required\": [\n                  \"type\",\n                  \"value\"\n                ],\n                \"properties\": {\n                  \"type\": {\n                    \"type\": \"string\",\n                    \"enum\": [\n                      \"assetNumber\",\n                      \"serialNumber\",\n                      \"tagNumber\"\n                    ]\n                  },\n                  \"value\": {\n                    \"type\": \"string\"\n                  }\n                }\n              }\n            },\n            \"remove\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"required\": [\n                  \"type\",\n                  \"value\"\n                ],\n                \"properties\": {\n                  \"type\": {\n                    \"type\": \"string\",\n                    \"enum\": [\n                      \"assetNumber\",\n                      \"serialNumber\",\n                      \"tagNumber\"\n                    ]\n                  },\n                  \"value\": {\n                    \"type\": \"string\"\n                  }\n                }\n              }\n            },\n            \"updateFields\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"required\": [\n                  \"type\",\n                  \"value\"\n                ],\n                \"properties\": {\n                  \"type\": {\n                    \"type\": \"string\",\n                    \"enum\": [\n                      \"assetNumber\",\n                      \"serialNumber\",\n                      \"tagNumber\"\n                    ]\n                  },\n                  \"value\": {\n                    \"type\": \"string\"\n                  },\n                  \"costRetired\": {\n                    \"type\": \"string\"\n                  },\n                  \"retirementReason\": {\n                    \"type\": \"string\"\n                  },\n                  \"retirementDate\": {\n                    \"type\": \"string\"\n                  }\n                }\n              }\n            },\n            \"removeRows\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"integer\",\n                \"minimum\": 1\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Apply Request Edit",
            "returnType": "object",
            "sourceCode": "function s(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction rowCount(req) {\n  req = req || {};\n  var txs = asArray(req.assetRetirementTransactions);\n  var count = 0;\n  for (var i = 0; i < txs.length; i++) count += asArray(txs[i] && txs[i].ParameterList).length;\n  return count;\n}\nfunction normalizeReq(req) {\n  req = parseMaybe(req);\n  if (req && req.result) req = parseMaybe(req.result);\n  if (req && req.normalizedRetirementRequest) req = parseMaybe(req.normalizedRetirementRequest);\n  if (!req || typeof req !== \"object\") req = {};\n  if (!Array.isArray(req.assetRetirementTransactions)) {\n    req.assetRetirementTransactions = [{ BookTypeCode: \"\", ParameterList: [] }];\n  }\n  if (req.assetRetirementTransactions.length === 0) {\n    req.assetRetirementTransactions.push({ BookTypeCode: \"\", ParameterList: [] });\n  }\n  for (var i = 0; i < req.assetRetirementTransactions.length; i++) {\n    var tx = req.assetRetirementTransactions[i] || {};\n    if (!Array.isArray(tx.ParameterList)) tx.ParameterList = [];\n    if (tx.BookTypeCode === undefined) tx.BookTypeCode = tx.bookTypeCode || tx.book || tx.Book || \"\";\n    for (var pr = 0; pr < tx.ParameterList.length; pr++) {\n      var existingRow = tx.ParameterList[pr] || {};\n      var existingQueryFilter = s(existingRow.queryFilter).trim() || queryFilterForType(existingRow.type || existingRow.identifierType || (existingRow.serialNumber || existingRow.SerialNumber ? \"serial\" : (existingRow.tagNumber || existingRow.TagNumber ? \"tag\" : \"asset\")));\n      existingRow.queryFilter = existingQueryFilter;\n      existingRow.parameter = cleanIdentifierValue(existingRow.parameter || existingRow.assetNumber || existingRow.AssetNumber || existingRow.serialNumber || existingRow.SerialNumber || existingRow.tagNumber || existingRow.TagNumber);\n      tx.ParameterList[pr] = existingRow;\n    }\n    req.assetRetirementTransactions[i] = tx;\n  }\n  return req;\n}\nfunction queryFilterForType(type) {\n  var t = s(type).toLowerCase();\n  if (t.indexOf(\"serial\") > -1) return \"P_SERIAL_NUMBER\";\n  if (t.indexOf(\"tag\") > -1) return \"P_TAG_NUMBER\";\n  return \"P_ASSET_NUMBER\";\n}\nfunction getFirstTx(req) {\n  if (!req.assetRetirementTransactions[0]) req.assetRetirementTransactions[0] = { BookTypeCode: \"\", ParameterList: [] };\n  if (!Array.isArray(req.assetRetirementTransactions[0].ParameterList)) req.assetRetirementTransactions[0].ParameterList = [];\n  return req.assetRetirementTransactions[0];\n}\nfunction cleanIdentifierValue(value) {\n  var v = s(value).trim();\n  v = v.replace(/[.,;]+$/g, \"\").trim();\n  v = v.replace(/\\s+and\\s*$/i, \"\").trim();\n  v = v.replace(/\\s+(please|thanks|thank you)$/i, \"\").trim();\n  v = v.replace(/^(?:add|include)\\s+/i, \"\").trim();\n  v = v.replace(/^another\\s+/i, \"\").trim();\n  v = v.replace(/^with\\s+/i, \"\").trim();\n  v = v.replace(/^asset\\s+with\\s+asset\\s+number\\s+/i, \"\").trim();\n  v = v.replace(/^asset\\s+number\\s+/i, \"\").trim();\n  v = v.replace(/^asset\\s+no\\.?\\s+/i, \"\").trim();\n  v = v.replace(/^asset\\s+#\\s*/i, \"\").trim();\n  v = v.replace(/^tag\\s+number\\s+/i, \"\").trim();\n  v = v.replace(/^serial\\s+number\\s+/i, \"\").trim();\n  var m = v.match(/\\basset\\s+number\\s+(.+)$/i) || v.match(/\\btag\\s+number\\s+(.+)$/i) || v.match(/\\bserial\\s+number\\s+(.+)$/i);\n  if (m && m[1]) v = m[1].trim();\n  v = v.replace(/[.,;]+$/g, \"\").trim();\n  return v;\n}\nfunction sameIdentifier(row, queryFilter, parameter) {\n  return s(row.queryFilter).trim() === queryFilter && cleanIdentifierValue(row.parameter).toUpperCase() === cleanIdentifierValue(parameter).toUpperCase();\n}\n\nfunction normalizeRowNumbers(v) {\n  var out = [];\n  function add(n) {\n    n = Number(n);\n    if (!isNaN(n) && n > 0 && out.indexOf(n) === -1) out.push(n);\n  }\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) add(v[i]);\n  } else if (typeof v === \"number\") {\n    add(v);\n  } else {\n    var textValue = s(v);\n    var m;\n    var re = /d+/g;\n    while ((m = re.exec(textValue)) !== null) add(m[0]);\n  }\n  return out;\n}\nfunction extractRowNumbersFromMessage(message) {\n  var m = s(message);\n  if (!/\b(remove|defer|exclude|skip)\b/i.test(m)) return [];\n  var rows = [];\n  var re = /\brows?s*(?:numbers*)?(?:#s*)?([0-9]+(?:s*(?:,|and)s*[0-9]+)*)/ig;\n  var match;\n  while ((match = re.exec(m)) !== null) {\n    rows = rows.concat(normalizeRowNumbers(match[1]));\n  }\n  return normalizeRowNumbers(rows);\n}\nfunction removeRowsByNumber(req, rowNumbers) {\n  rowNumbers = normalizeRowNumbers(rowNumbers);\n  if (rowNumbers.length === 0) return;\n  var targets = {};\n  for (var r = 0; r < rowNumbers.length; r++) targets[rowNumbers[r]] = true;\n  var displayRow = 0;\n  for (var t = 0; t < req.assetRetirementTransactions.length; t++) {\n    var list = asArray(req.assetRetirementTransactions[t].ParameterList);\n    var kept = [];\n    for (var i = 0; i < list.length; i++) {\n      displayRow++;\n      if (!targets[displayRow]) kept.push(list[i]);\n    }\n    req.assetRetirementTransactions[t].ParameterList = kept;\n  }\n}\nfunction addIdentifier(req, op) {\n  op = op || {};\n  var queryFilter = queryFilterForType(op.type || op.identifierType || op.queryFilter);\n  var parameter = cleanIdentifierValue(op.value || op.parameter || op.assetNumber || op.serialNumber || op.tagNumber);\n  if (!queryFilter || !parameter) return;\n  var tx = getFirstTx(req);\n  var list = tx.ParameterList;\n  for (var i = 0; i < list.length; i++) {\n    if (sameIdentifier(list[i], queryFilter, parameter)) return;\n  }\n  list.push({\n    queryFilter: queryFilter,\n    parameter: parameter,\n    costRetire