                {
                  "metadata": {
                    "name": "Extract Asset Details",
                    "returnType": "object",
                    "sourceCode": "var loopNode = ($context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED || {});\nvar raw = (loopNode.GETASSETINFO_REQ_PROCEED && loopNode.GETASSETINFO_REQ_PROCEED.$output) || (($context.$nodes.GETASSETINFO_REQ_PROCEED && $context.$nodes.GETASSETINFO_REQ_PROCEED.$output) || {});\nvar currentItem = loopNode.$currentItem || {};\nvar requestOutput = (($context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED && $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output) ? $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output : {});\nvar request = (requestOutput.result && requestOutput.result.normalizedRetirementRequest) ? requestOutput.result.normalizedRetirementRequest : (requestOutput.normalizedRetirementRequest || $context.$variables.retirementChangeRequestJson || {});\n\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n  }\n}\nfunction first(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && text(values[i]).trim() !== \"\") return values[i];\n  }\n  return \"\";\n}\nfunction valueAt(obj, keys, index) {\n  obj = obj || {};\n  for (var k = 0; k < keys.length; k++) {\n    var val = obj[keys[k]];\n    if (val === undefined || val === null) continue;\n    val = parseAny(val);\n    if (Array.isArray(val)) return val[index] !== undefined && val[index] !== null ? val[index] : \"\";\n    if (index === 0) return val;\n  }\n  return \"\";\n}\nfunction maxFieldCount(obj) {\n  var max = 0;\n  obj = obj || {};\n  var keys = Object.keys(obj);\n  for (var i = 0; i < keys.length; i++) {\n    var val = parseAny(obj[keys[i]]);\n    if (Array.isArray(val) && val.length > max) max = val.length;\n  }\n  return max || 1;\n}\nfunction hasAssetField(obj) {\n  obj = obj || {};\n  var names = [\"X_CORP_BOOK_TYPE_CODE\", \"X_CORP_BOOK_TYPE_CODE_TBL\", \"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\", \"X_DESCRIPTION_TBL\", \"X_ASSET_ID\", \"X_ASSET_ID_TBL\", \"X_COST\", \"X_COST_TBL\", \"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\", \"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\", \"bookTypeCode\", \"assetNumber\", \"AssetNumber\", \"assetId\", \"cost\", \"serialNumber\", \"tagNumber\", \"TagNumber\"];\n  for (var i = 0; i < names.length; i++) if (obj[names[i]] !== undefined && obj[names[i]] !== null && text(obj[names[i]]).trim() !== \"\") return true;\n  return false;\n}\nfunction rowFromObject(obj, index) {\n  obj = obj || {};\n  var row = {\n    assetId: text(first([valueAt(obj, [\"X_ASSET_ID\", \"X_ASSET_ID_TBL\", \"assetId\", \"AssetId\"], index)])),\n    bookTypeCode: text(first([valueAt(obj, [\"X_CORP_BOOK_TYPE_CODE\", \"X_CORP_BOOK_TYPE_CODE_TBL\", \"X_BOOK_TYPE_CODE\", \"X_BOOK_TYPE_CODE_TBL\", \"bookTypeCode\", \"BookTypeCode\", \"bookName\"], index)])),\n    assetNumber: text(first([valueAt(obj, [\"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\", \"assetNumber\", \"AssetNumber\"], index)])),\n    description: text(first([valueAt(obj, [\"X_DESCRIPTION_TBL\", \"X_ASSET_DESCRIPTION_TBL\", \"description\", \"assetDescription\", \"Description\"], index)])),\n    cost: first([valueAt(obj, [\"X_COST\", \"X_COST_TBL\", \"X_COST_RET_TBL\", \"cost\", \"costRetired\"], index)]),\n    serialNumber: text(first([valueAt(obj, [\"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\", \"serialNumber\", \"SerialNumber\"], index)])),\n    retirementReason: \"\",\n    TagNumber: text(first([valueAt(obj, [\"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\", \"tagNumber\", \"TagNumber\"], index)])),\n    valid: \"\",\n    comments: \"\"\n  };\n  return row;\n}\nfunction addRowsFromObject(obj, rows, seen) {\n  if (!obj || typeof obj !== \"object\" || !hasAssetField(obj)) return;\n  var count = maxFieldCount(obj);\n  for (var i = 0; i < count; i++) {\n    var row = rowFromObject(obj, i);\n    if (!row.assetNumber && !row.bookTypeCode && !row.assetId && !row.TagNumber && !row.serialNumber) continue;\n    var key = [row.assetId, row.bookTypeCode, row.assetNumber, row.TagNumber, row.serialNumber].join(\"|\").toUpperCase();\n    if (seen[key]) continue;\n    seen[key] = true;\n    rows.push(row);\n  }\n}\nfunction collectRows(v, rows, seen, depth) {\n  if (depth > 12 || v === null || v === undefined) return;\n  v = parseAny(v);\n  if (typeof v === \"string\") {\n    if (/nos+matching|nos+data|nots+found/i.test(v)) return;\n    return;\n  }\n  if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) collectRows(v[i], rows, seen, depth + 1); return; }\n  if (!v || typeof v !== \"object\") return;\n  addRowsFromObject(v, rows, seen);\n  var keys = Object.keys(v);\n  for (var k = 0; k < keys.length; k++) collectRows(v[keys[k]], rows, seen, depth + 1);\n}\nfunction identifierType(queryFilter) {\n  var q = text(queryFilter).toUpperCase();\n  if (q.indexOf(\"TAG\") > -1) return \"tag\";\n  if (q.indexOf(\"SERIAL\") > -1) return \"serial\";\n  return \"asset\";\n}\nfunction matchingRows(rows) {\n  var type = identifierType(currentItem.queryFilter);\n  var needle = text(currentItem.parameter).trim().toUpperCase();\n  if (!needle) return rows;\n  var matched = [];\n  for (var i = 0; i < rows.length; i++) {\n    var r = rows[i] || {};\n    var candidates = [];\n    if (type === \"asset\") candidates.push(r.assetNumber, r.AssetNumber);\n    if (type === \"tag\") candidates.push(r.TagNumber, r.tagNumber);\n    if (type === \"serial\") candidates.push(r.serialNumber, r.SerialNumber);\n    candidates.push(r.assetNumber, r.AssetNumber, r.TagNumber, r.tagNumber, r.serialNumber, r.SerialNumber);\n    for (var c = 0; c < candidates.length; c++) {\n      if (text(candidates[c]).trim().toUpperCase() === needle) { matched.push(r); break; }\n    }\n  }\n  return matched.length > 0 ? matched : rows;\n}\nfunction reasonForCurrentItem() {\n  var q = text(currentItem.queryFilter).trim();\n  var p = text(currentItem.parameter).trim().toUpperCase();\n  request = parseAny(request) || {};\n  if (request.result) request = parseAny(request.result) || {};\n  if (request.normalizedRetirementRequest) request = parseAny(request.normalizedRetirementRequest) || {};\n  var txs = asArray(request.assetRetirementTransactions);\n  for (var t = 0; t < txs.length; t++) {\n    var list = asArray(txs[t] && txs[t].ParameterList);\n    for (var i = 0; i < list.length; i++) {\n      var row = list[i] || {};\n      var rowParam = text(row.parameter || row.assetNumber || row.AssetNumber || row.tagNumber || row.TagNumber || row.serialNumber || row.SerialNumber).trim().toUpperCase();\n      if (text(row.queryFilter).trim() === q && rowParam === p) return text(row.retirementReason || row.RetirementReason);\n    }\n  }\n  return \"\";\n}\n\nvar rows = [];\ncollectRows(raw, rows, {}, 0);\nrows = matchingRows(rows);\nvar reason = reasonForCurrentItem();\nfor (var i = 0; i < rows.length; i++) rows[i].retirementReason = reason || rows[i].retirementReason || \"\";\nreturn { assetInfoList: rows };"
