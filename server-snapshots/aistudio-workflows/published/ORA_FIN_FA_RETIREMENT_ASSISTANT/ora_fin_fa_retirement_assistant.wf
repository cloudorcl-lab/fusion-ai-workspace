            "name": "Build Draft Txns - New",
            "returnType": "object",
            "sourceCode": "var draftTx = $context.$nodes.FORMATINGRETIREMENTTRANSACTION_NEW_LANE.$output.result;\nvar retirementReasonResp = $context.$nodes.PARSERETIREMENTREASONLIST_NEW_LANE.$output.result;\nvar retirementConventionResp = $context.$nodes.PARSERETIREMENTCONVENTIONLIST_NEW_LANE.$output.result;\nvar defaultRetirementConventionCode = $context.$nodes.PARSEDEFAULTRETIREMENTCONVENTION_NEW_LANE.$output.result;\n\nvar draftTxRows = [];\n\nif (draftTx && Array.isArray(draftTx.result)) {\n  draftTxRows = draftTx.result;\n} else if (Array.isArray(draftTx)) {\n  draftTxRows = draftTx;\n}\n\nvar reasonLookup = {};\nvar reasonCodeLookup = {};\nfunction reasonMapKey(book, value) { return String(book || \"\").trim().toUpperCase() + \"||\" + String(value || \"\").trim(); }\nfunction addReasonLookup(book, value, code) {\n  value = String(value || \"\").trim();\n  code = String(code || \"\").trim();\n  if (!value || !code) return;\n  reasonCodeLookup[reasonMapKey(book, value)] = code;\n  reasonCodeLookup[reasonMapKey(\"*\", value)] = code;\n}\nvar reasonList = retirementReasonResp && retirementReasonResp.retirementReasonList\n  ? retirementReasonResp.retirementReasonList\n  : [];\n\nfor (var r = 0; r < reasonList.length; r++) {\n  var book = reasonList[r];\n  var bookCode = String(book.bookTypeCode || \"\").trim();\n  var reasons = book.retirementReason || [];\n\n  for (var j = 0; j < reasons.length; j++) {\n    var reasonCode = String(reasons[j].retirementReasonCode || \"\").trim();\n    var reasonMeaning = reasons[j].retirementReasonMeaning || \"\";\n\n    if (bookCode && reasonCode) {\n      reasonLookup[bookCode + \"||\" + reasonCode] = reasonMeaning;\n      reasonLookup[bookCode.toUpperCase() + \"||\" + reasonCode] = reasonMeaning;\n      addReasonLookup(bookCode, reasonCode, reasonCode);\n      addReasonLookup(bookCode, reasonMeaning, reasonCode);\n    }\n  }\n}\n\nvar conventionLookup = {};\nvar conventionList = retirementConventionResp && retirementConventionResp.retirementConvention\n  ? retirementConventionResp.retirementConvention\n  : [];\n\nfor (var c = 0; c < conventionList.length; c++) {\n  var convCode = String(conventionList[c].retirementConventionCode || \"\").trim();\n  var convId = conventionList[c].retirementConventionId;\n\n  if (convCode !== \"\") {\n    conventionLookup[convCode] = convId;\n  }\n}\n\nvar defaultConventionByAsset = {};\nvar defaultConventionByBookAndAsset = {};\nvar defaultConventionList = [];\nvar defaultConventionSource = defaultRetirementConventionCode;\n\nif (typeof defaultConventionSource === \"string\") {\n  try {\n    defaultConventionSource = JSON.parse(defaultConventionSource);\n  } catch (e) {\n    defaultConventionSource = null;\n  }\n}\n\nif (\n  defaultConventionSource &&\n  defaultConventionSource.result &&\n  Array.isArray(defaultConventionSource.result.result)\n) {\n  defaultConventionList = defaultConventionSource.result.result;\n} else if (defaultConventionSource && Array.isArray(defaultConventionSource.result)) {\n  defaultConventionList = defaultConventionSource.result;\n} else if (Array.isArray(defaultConventionSource)) {\n  defaultConventionList = defaultConventionSource;\n}\n\nfor (var d = 0; d < defaultConventionList.length; d++) {\n  var defaultConventionRow = defaultConventionList[d];\n\n  var defaultConvention = defaultConventionRow && defaultConventionRow.defaultConvention\n    ? defaultConventionRow.defaultConvention\n    : defaultConventionRow;\n\n  if (defaultConvention) {\n    var defaultBookTypeCode = String(defaultConvention.bookTypeCode || \"\").trim();\n    var defaultAssetId = String(defaultConvention.assetId || \"\").trim();\n\n    if (defaultAssetId) {\n      defaultConventionByAsset[defaultAssetId] = defaultConvention;\n\n      if (defaultBookTypeCode) {\n        defaultConventionByBookAndAsset[defaultBookTypeCode + \"||\" + defaultAssetId] = defaultConvention;\n      }\n    }\n  }\n}\n\nfor (var tx = 0; tx < draftTxRows.length; tx++) {\n  var items = draftTxRows[tx] && draftTxRows[tx].items ? draftTxRows[tx].items : [];\n\n  for (var it = 0; it < items.length; it++) {\n    var item = items[it];\n    var params = item ? item.ParameterList : null;\n\n    if (params) {\n      var rowCount = 0;\n      var keys = Object.keys(params);\n\n      for (var k = 0; k < keys.length; k++) {\n        var val = params[keys[k]];\n        if (Array.isArray(val) && val.length > rowCount) {\n          rowCount = val.length;\n        }\n      }\n\n      if (!Array.isArray(params.X_RETIREMENT_TYPE_CODE_TBL)) {\n        params.X_RETIREMENT_TYPE_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RETIREMENT_REASON_TBL)) {\n        params.X_RETIREMENT_REASON_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RET_CONV_TBL)) {\n        params.X_RET_CONV_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RET_CONV_CODE_TBL)) {\n        params.X_RET_CONV_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_BOOK_TYPE_CODE_TBL)) {\n        params.X_BOOK_TYPE_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_ASSET_ID_TBL)) {\n        params.X_ASSET_ID_TBL = Array(rowCount).fill(\"\");\n      }\n\n      for (var i = 0; i < rowCount; i++) {\n        var bookTypeCode = String(params.X_BOOK_TYPE_CODE_TBL[i] || \"\").trim();\n        var retirementTypeCode = String(params.X_RETIREMENT_TYPE_CODE_TBL[i] || \"\").trim();\n        var retirementReasonDisplay = String(params.X_RETIREMENT_REASON_TBL[i] || \"\").trim();\n        var retirementConvCode = String(params.X_RET_CONV_TBL[i] || \"\").trim();\n        var assetId = String(params.X_ASSET_ID_TBL[i] || \"\").trim();\n\n        if (!retirementTypeCode && retirementReasonDisplay) {\n          var mappedReasonCode = reasonCodeLookup[reasonMapKey(bookTypeCode, retirementReasonDisplay)] || reasonCodeLookup[reasonMapKey(\"*\", retirementReasonDisplay)] || \"\";\n          if (mappedReasonCode) {\n            retirementTypeCode = mappedReasonCode;\n            params.X_RETIREMENT_TYPE_CODE_TBL[i] = mappedReasonCode;\n          }\n        }\n\n        if (bookTypeCode && retirementTypeCode) {\n          var mappedReasonMeaning = reasonLookup[bookTypeCode + \"||\" + retirementTypeCode] || reasonLookup[String(bookTypeCode).trim().toUpperCase() + \"||\" + retirementTypeCode] || \"\";\n          if (mappedReasonMeaning) {\n            params.X_RETIREMENT_REASON_TBL[i] = mappedReasonMeaning;\n          } else if (!retirementReasonDisplay) {\n            params.X_RETIREMENT_REASON_TBL[i] = retirementTypeCode;\n          }\n        }\n\n        var defaultConventionForAsset = null;\n\n        if (bookTypeCode && assetId) {\n          defaultConventionForAsset =\n            defaultConventionByBookAndAsset[bookTypeCode + \"||\" + assetId];\n        }\n\n        if (!defaultConventionForAsset && assetId) {\n          defaultConventionForAsset = defaultConventionByAsset[assetId];\n        }\n\n        if (defaultConventionForAsset) {\n          var defaultConventionCode = String(defaultConventionForAsset.conventionCode || \"\").trim();\n          var defaultConventionId = defaultConventionForAsset.conventionId;\n\n          params.X_RET_CONV_TBL[i] = defaultConventionCode;\n          params.X_RET_CONV_CODE_TBL[i] =\n            defaultConventionId !== undefined && defaultConventionId !== null\n              ? defaultConventionId\n              : conventionLookup[defaultConventionCode] !== undefined\n                ? conventionLookup[defaultConventionCode]\n                : \"\";\n        } else if (retirementConvCode) {\n          params.X_RET_CONV_CODE_TBL[i] =\n            conventionLookup[retirementConvCode] !== undefined\n              ? conventionLookup[retirementConvCode]\n              : \"\";\n        }\n      }\n    }\n  }\n}\n\nreturn draftTx;"
