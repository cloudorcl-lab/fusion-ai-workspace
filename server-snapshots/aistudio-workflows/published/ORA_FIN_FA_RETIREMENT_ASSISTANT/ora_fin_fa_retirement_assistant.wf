            "name": "Build Review Rows - New",
            "returnType": "object",
            "sourceCode": "var source = $context.$variables.draftRetirementTransactions || $context.$nodes.RETIREMENTTRANSACTIONS_NEW_LANE.$output || $context.$nodes.FORMATINGRETIREMENTTRANSACTION_NEW_LANE.$output || {};\n\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction unwrap(v) {\n  v = parseAny(v);\n  if (v && v.result !== undefined) v = parseAny(v.result);\n  if (v && v.result !== undefined && Array.isArray(v.result)) v = v.result;\n  return v;\n}\nfunction firstDefined(values) {\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== null && values[i] !== undefined && values[i] !== \"\") return values[i];\n  }\n  return \"\";\n}\nfunction valueAt(params, keys, index) {\n  for (var k = 0; k < keys.length; k++) {\n    var key = keys[k];\n    if (!params || params[key] === undefined || params[key] === null) continue;\n    var val = params[key];\n    if (Array.isArray(val)) return val[index] !== undefined && val[index] !== null ? val[index] : \"\";\n    if (index === 0) return val;\n  }\n  return \"\";\n}\nfunction maxRowCount(params) {\n  var count = 0;\n  params = params || {};\n  for (var key in params) {\n    if (Array.isArray(params[key]) && params[key].length > count) count = params[key].length;\n  }\n  return count || 1;\n}\nfunction pushRowsFromParams(rows, params, item) {\n  params = params || {};\n  item = item || {};\n  var count = maxRowCount(params);\n  for (var i = 0; i < count; i++) {\n    var assetNumber = firstDefined([\n      valueAt(params, [\"X_ASSET_NUMBER_TBL\", \"assetNumber\", \"AssetNumber\"], i),\n      item.assetNumber,\n      item.AssetNumber\n    ]);\n    var bookName = firstDefined([\n      valueAt(params, [\"X_BOOK_TYPE_CODE_TBL\", \"BookTypeCode\", \"bookName\", \"bookTypeCode\"], i),\n      item.BookTypeCode,\n      item.bookTypeCode,\n      item.bookName\n    ]);\n    if (!text(assetNumber).trim() && !text(bookName).trim()) continue;\n    rows.push({\n      bookName: text(bookName),\n      bookTypeCode: text(bookName),\n      currencyCode: text(firstDefined([valueAt(params, [\"X_CURRENCY_CODE_TBL\", \"CurrencyCode\", \"currencyCode\"], i), item.CurrencyCode, item.currencyCode])),\n      assetNumber: text(assetNumber),\n      assetDescription: text(firstDefined([valueAt(params, [\"X_ASSET_DESCRIPTION_TBL\", \"X_DESCRIPTION_TBL\", \"assetDescription\", \"description\"], i), item.assetDescription, item.description])),\n      dateRetired: text(firstDefined([valueAt(params, [\"X_DATE_RETIRED_TBL\", \"dateRetired\", \"retirementDate\"], i), item.dateRetired, item.retirementDate])),\n      costRetired: firstDefined([valueAt(params, [\"X_COST_RET_TBL\", \"costRetired\", \"cost\"], i), item.costRetired, item.cost]),\n      retirementReason: text(firstDefined([valueAt(params, [\"X_RETIREMENT_REASON_TBL\", \"retirementReason\"], i), item.retirementReason])),\n      retirementTypeCode: text(firstDefined([valueAt(params, [\"X_RETIREMENT_TYPE_CODE_TBL\", \"retirementTypeCode\"], i), item.retirementTypeCode])),\n      retirementConvention: text(firstDefined([valueAt(params, [\"X_RET_CONV_TBL\", \"X_CONVENTION_TYPE_CODE_TBL\", \"retirementConvention\"], i), item.retirementConvention])),\n      retirementConventionId: firstDefined([valueAt(params, [\"X_RET_CONV_CODE_TBL\", \"X_CONVENTION_TYPE_ID_TBL\", \"retirementConventionId\"], i), item.retirementConventionId]),\n      costofRemoval: firstDefined([valueAt(params, [\"X_COST_OF_REMOVAL_TBL\", \"costofRemoval\", \"costOfRemoval\"], i), item.costofRemoval, item.costOfRemoval, 0]),\n      proceedsofSale: firstDefined([valueAt(params, [\"X_PROCEEDS_OF_SALE_TBL\", \"proceedsofSale\", \"proceedsOfSale\"], i), item.proceedsofSale, item.proceedsOfSale, 0]),\n      createdBy: text(firstDefined([valueAt(params, [\"X_CREATED_BY_TBL\", \"createdBy\"], i), item.createdBy])),\n      creationDate: text(firstDefined([valueAt(params, [\"X_CREATION_DATE_TBL\", \"creationDate\"], i), item.creationDate])),\n      transactionName: text(firstDefined([valueAt(params, [\"X_TRANSACTION_NAME_TBL\", \"transactionName\"], i), item.transactionName, \"\"])),\n      errorMessage: text(firstDefined([valueAt(params, [\"X_MSG_DATA\", \"X_ERROR_MESSAGE_TBL\", \"errorMessage\"], i), item.errorMessage])),\n      assetId: firstDefined([valueAt(params, [\"X_ASSET_ID_TBL\", \"assetId\"], i), item.assetId]),\n      tagNumber: text(firstDefined([valueAt(params, [\"X_TAG_NUMBER_TBL\", \"tagNumber\", \"TagNumber\"], i), item.tagNumber, item.TagNumber])),\n      serialNumber: text(firstDefined([valueAt(params, [\"X_SERIAL_NUMBER_TBL\", \"serialNumber\"], i), item.serialNumber])),\n      retirementInterfaceId: firstDefined([valueAt(params, [\"X_RET_INTERFACE_ID_TBL\", \"retirementInterfaceId\"], i), item.retirementInterfaceId, 0])\n    });\n  }\n}\n\nvar data = unwrap(source);\nvar rows = [];\nif (data && data.pendingRetirements && Array.isArray(data.pendingRetirements)) {\n  rows = data.pendingRetirements;\n} else {\n  var txRows = Array.isArray(data) ? data : [];\n  for (var t = 0; t < txRows.length; t++) {\n    var tx = txRows[t] || {};\n    var items = Array.isArray(tx.items) ? tx.items : (tx.ParameterList ? [tx] : []);\n    for (var it = 0; it < items.length; it++) {\n      var item = items[it] || {};\n      pushRowsFromParams(rows, item.ParameterList || item.parameterList || {}, item);\n    }\n  }\n}\n\nfunction normalizedRequestRows() {\n  var request = parseAny($context.$variables.retirementChangeRequestJson || {});\n  if (request && request.result !== undefined) request = parseAny(request.result);\n  if (request && request.normalizedRetirementRequest !== undefined) request = parseAny(request.normalizedRetirementRequest);\n  var map = {};\n  var txs = asArray(request && request.assetRetirementTransactions);\n  function identifierType(row) {\n    var q = text(row && row.queryFilter).toUpperCase();\n    if (q.indexOf(\"SERIAL\") > -1) return \"SERIAL_NUMBER\";\n    if (q.indexOf(\"TAG\") > -1) return \"TAG_NUMBER\";\n    return \"ASSET_NUMBER\";\n  }\n  for (var t = 0; t < txs.length; t++) {\n    var tx = txs[t] || {};\n    var list = asArray(tx.ParameterList);\n    for (var r = 0; r < list.length; r++) {\n      var row = list[r] || {};\n      var param = text(firstDefined([row.parameter, row.assetNumber, row.AssetNumber, row.tagNumber, row.TagNumber, row.serialNumber, row.SerialNumber])).trim();\n      if (!param) continue;\n      var type = identifierType(row);\n      map[type + \"|\" + param.toUpperCase()] = row;\n    }\n  }\n  return map;\n}\nfunction fallbackRowsFromRequestState() {\n  var state = parseAny($context.$variables.conversationRetirementFlowState || {});\n  var activeAssets = asArray(state && state.activeAssets);\n  var requestMap = normalizedRequestRows();\n  var out = [];\n  function requestForAsset(asset) {\n    asset = asset || {};\n    var candidates = [\n      [\"ASSET_NUMBER\", asset.assetNumber || asset.AssetNumber],\n      [\"TAG_NUMBER\", asset.tagNumber || asset.TagNumber],\n      [\"SERIAL_NUMBER\", asset.serialNumber]\n    ];\n    for (var c = 0; c < candidates.length; c++) {\n      var value = text(candidates[c][1]).trim();\n      if (!value) continue;\n      var row = requestMap[candidates[c][0] + \"|\" + value.toUpperCase()];\n      if (row) return row;\n    }\n    return {};\n  }\n  for (var i = 0; i < activeAssets.length; i++) {\n    var asset = activeAssets[i] || {};\n    var status = text(asset.status).toUpperCase();\n    var message = text(asset.validationMessage || asset.comments).trim();\n    var hasIdentifier = text(firstDefined([asset.assetNumber, asset.AssetNumber, asset.tagNumber, asset.TagNumber, asset.serialNumber])).trim() !== \"\";\n    if (!hasIdentifier) continue;\n    if (status.indexOf(\"INVALID\") > -1 || status.indexOf(\"UNAVAILABLE\") > -1 || message.indexOf(\"Asset doesn't exist\") === 0) continue;\n    var req = requestForAsset(asset);\n    out.push({\n      bookName: text(firstDefined([asset.bookName, asset.bookTypeCode, asset.BookTypeCode])),\n      bookTypeCode: text(firstDefined([asset.bookTypeCode, asset.bookName, asset.BookTypeCode])),\n      currencyCode: text(firstDefined([asset.currencyCode, asset.CurrencyCode])),\n      assetNumber: text(firstDefined([asset.assetNumber, asset.AssetNumber])),\n      assetDescription: text(firstDefined([asset.assetDescription, asset.description])),\n      dateRetired: text(firstDefined([req.retirementDate, req.dateRetired, asset.retirementDate, asset.dateRetired])),\n      costRetired: firstDefined([req.costRetired, req.cost, asset.costRetired, asset.cost]),\n      retirementReason: text(firstDefined([req.retirementReason, req.RetirementReason, asset.retirementReason])),\n      retirementTypeCode: text(firstDefined([req.retirementReason, req.RetirementReason, asset.retirementTypeCode, asset.retirementReason])),\n      retirementConvention: text(firstDefined([asset.retirementConvention, req.retirementConvention])),\n      retirementConventionId: firstDefined([asset.retirementConventionId, req.retirementConventionId]),\n      costofRemoval: firstDefined([req.costofRemoval, req.costOfRemoval, asset.costofRemoval, asset.costOfRemoval, 0]),\n      proceedsofSale: firstDefined([req.proceedsofSale, req.proceedsOfSale, asset.proceedsofSale, asset.proceedsOfSale, 0]),\n      createdBy: text(firstDefined([asset.createdBy, req.createdBy])),\n      creationDate: text(firstDefined([asset.creationDate, req.creationDate])),\n      transactionName: text(firstDefined([asset.transactionName, req.transactionName, \"\"])),\n      errorMessage: text(firstDefined([asset.errorMessage, message])),\n      assetId: firstDefined([asset.assetId, req.assetId]),\n      tagNumber: text(firstDefined([asset.tagNumber, asset.TagNumber, req.tagNumber, req.TagNumber])),\n      serialNumber: text(firstDefined([asset.serialNumber, req.serialNumber])),\n      retirementInterfaceId: firstDefined([asset.retirementInterfaceId, req.retirementInterfaceId, 0])\n    });\n  }\n  return out;\n}\nif (rows.length === 0) {\n  rows = fallbackRowsFromRequestState();\n}\n\nreturn { pendingRetirements: rows };"
