                },
                {
                  "metadata": {
                    "name": "Validate Asset",
                    "returnType": "object",
                    "sourceCode": "var dataNode = $context.$nodes.OBTAINASSETINFORMATION.EXTRACTASSETDETAILS.$output || {};\nvar data = dataNode.result || dataNode;\nvar access = $context.$nodes.OBTAINASSETINFORMATION.CHECKBOOKACCESS.$output;\nvar currentItem = $context.$nodes.OBTAINASSETINFORMATION.$currentItem || {};\n\nfunction getAccessCurrencyCode(access) {\n  if (access && Array.isArray(access.items) && access.items.length > 0) {\n    var item = access.items[0] || {};\n    return item.CurrencyCode || item.currencyCode || \"\";\n  }\n\n  return \"\";\n}\n\nif (typeof data === \"string\") {\n  try { data = JSON.parse(data); } catch (e) { data = {}; }\n}\n\nif (typeof access === \"string\") {\n  try { access = JSON.parse(access); } catch (e2) { access = {}; }\n}\n\nfunction getIdentifierLabel(queryFilter, row) {\n  var source = queryFilter === null || queryFilter === undefined ? \"\" : String(queryFilter).toUpperCase();\n\n  if (source.indexOf(\"TAG\") > -1) return \"Tag Number\";\n  if (source.indexOf(\"SERIAL\") > -1) return \"Serial Number\";\n  if (source.indexOf(\"ASSET\") > -1) return \"Asset Number\";\n\n  if (row) {\n    if (row.TagNumber !== null && row.TagNumber !== undefined && String(row.TagNumber).trim() !== \"\") return \"Tag Number\";\n    if (row.tagNumber !== null && row.tagNumber !== undefined && String(row.tagNumber).trim() !== \"\") return \"Tag Number\";\n    if (row.serialNumber !== null && row.serialNumber !== undefined && String(row.serialNumber).trim() !== \"\") return \"Serial Number\";\n  }\n\n  return \"Asset Number or Tag Number or Serial Number\";\n}\n\nfunction getIdentifierValue(row) {\n  if (currentItem.parameter !== null && currentItem.parameter !== undefined && String(currentItem.parameter).trim() !== \"\") {\n    return String(currentItem.parameter).trim();\n  }\n\n  if (row) {\n    if (row.assetNumber !== null && row.assetNumber !== undefined && String(row.assetNumber).trim() !== \"\") return String(row.assetNumber).trim();\n    if (row.TagNumber !== null && row.TagNumber !== undefined && String(row.TagNumber).trim() !== \"\") return String(row.TagNumber).trim();\n    if (row.tagNumber !== null && row.tagNumber !== undefined && String(row.tagNumber).trim() !== \"\") return String(row.tagNumber).trim();\n    if (row.serialNumber !== null && row.serialNumber !== undefined && String(row.serialNumber).trim() !== \"\") return String(row.serialNumber).trim();\n  }\n\n  return \"\";\n}\n\nfunction invalidAssetMessage(row) {\n  var label = getIdentifierLabel(currentItem.queryFilter, row);\n  var value = getIdentifierValue(row);\n\n  if (value) {\n    return \"Asset doesn't exist with \" + label + \" \" + value;\n  }\n\n  return \"Asset doesn't exist with Asset Number or Tag Number or Serial Number\";\n}\n\nfunction normalizeLegacyComment(text, row) {\n  if (text === null || text === undefined || text === \"\") return \"\";\n\n  var value = String(text);\n  var lower = value.toLowerCase();\n\n  if (lower.indexOf(\"cost\") > -1 && lower.indexOf(\"missing\") > -1 && lower.indexOf(\"invalid\") > -1) {\n    return invalidAssetMessage(row);\n  }\n\n  if (lower.indexOf(\"already\") > -1 && lower.indexOf(\"retired\") > -1) {\n    return \"This asset has already been fully retired.\";\n  }\n\n  return value;\n}\n\nvar rows = data && Array.isArray(data.assetInfoList) ? data.assetInfoList : [];\nvar hasBookAccess = access && Array.isArray(access.items) && access.items.length > 0;\nvar currencyCode = getAccessCurrencyCode(access);\n\nif (rows.length === 0) {\n  var queryFilter = currentItem.queryFilter === null || currentItem.queryFilter === undefined ? \"\" : String(currentItem.queryFilter).toUpperCase();\n  var parameter = currentItem.parameter === null || currentItem.parameter === undefined ? \"\" : String(currentItem.parameter).trim();\n  var emptyRow = {\n    bookTypeCode: \"\",\n    assetNumber: queryFilter.indexOf(\"ASSET\") > -1 ? parameter : \"\",\n    description: \"\",\n    assetId: \"\",\n    cost: \"\",\n    serialNumber: queryFilter.indexOf(\"SERIAL\") > -1 ? parameter : \"\",\n    TagNumber: queryFilter.indexOf(\"TAG\") > -1 ? parameter : \"\",\n    retirementReason: \"\",\n    valid: \"N\",\n    comments: \"\",\n    CurrencyCode: currencyCode,\n    queryFilter: currentItem.queryFilter || \"\",\n    parameter: parameter\n  };\n  emptyRow.comments = invalidAssetMessage(emptyRow);\n  rows.push(emptyRow);\n}\n\nfor (var i = 0; i < rows.length; i++) {\n  rows[i].queryFilter = rows[i].queryFilter || currentItem.queryFilter || \"\";\n  rows[i].parameter = rows[i].parameter || currentItem.parameter || \"\";\n  rows[i].CurrencyCode = rows[i].CurrencyCode || rows[i].currencyCode || currencyCode || \"\";\n\n  var rawCost = rows[i].cost === null || rows[i].cost === undefined\n    ? \"\"\n    : String(rows[i].cost).replace(/,/g, \"\").trim();\n\n  var cost = Number(rawCost);\n  var book = rows[i].bookTypeCode === null || rows[i].bookTypeCode === undefined || rows[i].bookTypeCode === \"\"\n    ? \"asset book\"\n    : String(rows[i].bookTypeCode);\n\n  if (!rawCost || isNaN(cost)) {\n    rows[i].valid = \"N\";\n    rows[i].comments = invalidAssetMessage(rows[i]);\n  } else if (!hasBookAccess) {\n    rows[i].valid = \"N\";\n    rows[i].comments = \"User doesnt have access to the \" + book;\n  } else if (cost === 0) {\n    rows[i].valid = \"N\";\n    rows[i].comments = \"This asset has already been fully retired.\";\n  } else {\n    rows[i].valid = \"Y\";\n    rows[i].comments = \"\";\n  }\n\n  rows[i].comments = normalizeLegacyComment(rows[i].comments, rows[i]);\n}\n\nreturn { assetInfoList: rows };"
                  },
                  "outcomes": {
                    "success": "end_1775867765709"
                  },
                  "code": "APPLYASSETVALIDATION",
                  "id": "1777605000002",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"assetInfoList\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"assetId\": {\n                \"type\": \"string\"\n              },\n              \"bookTypeCode\": {\n                \"type\": \"string\"\n              },\n              \"assetNumber\": {\n                \"type\": \"string\"\n              },\n              \"description\": {\n                \"type\": \"string\"\n              },\n              \"cost\": {\n                \"type\": \"string\"\n              },\n              \"serialNumber\": {\n                \"type\": \"string\"\n              },\n              \"retirementReason\": {\n                \"type\": \"string\"\n              },\n              \"TagNumber\": {\n                \"type\": \"string\"\n              },\n              \"valid\": {\n                \"type\": \"string\"\n              },\n              \"comments\": {\n                \"type\": \"string\"\n              },\n              \"CurrencyCode\": {\n                \"type\": \"string\"\n              }\n            }\n          }\n        }\n      }\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
