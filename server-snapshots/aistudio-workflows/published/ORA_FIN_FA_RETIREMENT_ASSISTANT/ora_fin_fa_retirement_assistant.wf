        {
          "metadata": {
            "name": "Get Prorate Book",
            "returnType": "array",
            "sourceCode": "var draftTx = $context.$nodes.FORMATINGRETIREMENTTRANSACTION.$output.result;\n\nvar uniqueBookTypes = [];\n\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction addBook(code) {\n  code = text(code).trim();\n  if (code && uniqueBookTypes.indexOf(code) === -1) uniqueBookTypes.push(code);\n}\nfunction visit(v) {\n  if (!v) return;\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) visit(v[i]);\n    return;\n  }\n  if (typeof v !== \"object\") return;\n  if (v.items) visit(v.items);\n  if (v.ParameterList) {\n    var params = v.ParameterList;\n    if (Array.isArray(params.X_BOOK_TYPE_CODE_TBL)) {\n      for (var b = 0; b < params.X_BOOK_TYPE_CODE_TBL.length; b++) addBook(params.X_BOOK_TYPE_CODE_TBL[b]);\n    }\n    addBook(params.X_BOOK_TYPE_CODE);\n    addBook(params.BookTypeCode);\n    addBook(params.bookTypeCode);\n  }\n  addBook(v.BookTypeCode);\n  addBook(v.bookTypeCode);\n  addBook(v.bookName);\n}\n\nvisit(draftTx);\n\nreturn {\n  ProrateAssetBook: uniqueBookTypes.map(function(code) {\n    return { BookTypeCode: code };\n  })\n};"
          },
          "outcomes": {
            "success": "1775758235887"
          },
