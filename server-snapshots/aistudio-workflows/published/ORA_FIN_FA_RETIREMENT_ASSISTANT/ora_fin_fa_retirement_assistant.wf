          "code": "RETIREMENTREQUESTHTML",
          "id": "1776320378138",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Save Request State",
            "returnType": "object",
            "sourceCode": "var prior = $context.$variables.conversationRetirementFlowState || {};\nvar request = ($context.$nodes.EXTRACTASSETNUMBERLIST && $context.$nodes.EXTRACTASSETNUMBERLIST.$output && $context.$nodes.EXTRACTASSETNUMBERLIST.$output.result && $context.$nodes.EXTRACTASSETNUMBERLIST.$output.result.normalizedRetirementRequest) ? $context.$nodes.EXTRACTASSETNUMBERLIST.$output.result.normalizedRetirementRequest : ($context.$variables.retirementChangeRequestJson || {});\nvar assetInfoInput = $context.$nodes.OBTAINASSETINFORMATION.$output || [];\n\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction uniqueKey(parts) { return parts.join(\"||\"); }\nfunction collectRetirementReasons(src) {\n  var out = [];\n  var seen = {};\n  function addBook(bookObj) {\n    bookObj = bookObj || {};\n    var bookCode = text(bookObj.bookTypeCode || bookObj.BookTypeCode || bookObj.bookName || bookObj.Book || \"\").trim();\n    var reasons = asArray(bookObj.retirementReason || bookObj.retirementReasons || bookObj.reasons);\n    var rows = [];\n    for (var i = 0; i < reasons.length; i++) {\n      var r = reasons[i] || {};\n      var code = text(r.retirementReasonCode || r.code || r.lookupCode || r.X_LOOKUP_CODE || \"\").trim();\n      var meaning = text(r.retirementReasonMeaning || r.meaning || r.description || r.X_MEANING || \"\").trim();\n      if (!code && !meaning) continue;\n      var rowKey = uniqueKey([bookCode, code, meaning]);\n      if (seen[rowKey]) continue;\n      seen[rowKey] = true;\n      rows.push({ retirementReasonCode: code, retirementReasonMeaning: meaning });\n    }\n    if (rows.length > 0) out.push({ bookTypeCode: bookCode, retirementReason: rows });\n  }\n  function visit(v) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i]); return; }\n    if (v.result) visit(v.result);\n    if (Array.isArray(v.retirementReasonList)) { for (var j = 0; j < v.retirementReasonList.length; j++) addBook(v.retirementReasonList[j]); return; }\n    if (v.bookTypeCode && Array.isArray(v.retirementReason)) addBook(v);\n  }\n  visit(src);\n  return out;\n}\nfunction collectRetirementConventions(src) {\n  var out = [];\n  var seen = {};\n  function addConv(v, inheritedBook) {\n    v = v || {};\n    var code = text(v.retirementConventionCode || v.conventionCode || v.code || v.X_CONVENTION_TYPE_CODE || \"\").trim();\n    var id = text(v.retirementConventionId || v.conventionId || v.id || v.X_CONVENTION_TYPE_ID || \"\").trim();\n    var bookCode = text(v.bookTypeCode || v.BookTypeCode || inheritedBook || \"\").trim();\n    if (!code && !id) return;\n    var rowKey = uniqueKey([bookCode, code, id]);\n    if (seen[rowKey]) return;\n    seen[rowKey] = true;\n    out.push({ bookTypeCode: bookCode, retirementConventionCode: code, retirementConventionId: id });\n  }\n  function visit(v, inheritedBook) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i], inheritedBook); return; }\n    if (v.result) visit(v.result, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n    if (Array.isArray(v.retirementConvention)) { for (var j = 0; j < v.retirementConvention.length; j++) addConv(v.retirementConvention[j], inheritedBook || v.bookTypeCode || v.BookTypeCode); return; }\n    if (v.retirementConventionCode || v.conventionCode || v.X_CONVENTION_TYPE_CODE) addConv(v, inheritedBook);\n  }\n  visit(src, \"\");\n  return out;\n}\nfunction activeBookList(rows) {\n  var seenBooks = {};\n  var books = [];\n  rows = asArray(rows);\n  for (var i = 0; i < rows.length; i++) {\n    var b = text(rows[i].bookTypeCode || rows[i].bookName || rows[i].BookTypeCode || \"\").trim();\n    if (b && !seenBooks[b]) { seenBooks[b] = true; books.push(b); }\n  }\n  return books;\n}\nfunction applySingleBookToConventions(conventions, books) {\n  conventions = asArray(conventions);\n  books = asArray(books);\n  if (books.length !== 1) return conventions;\n  for (var i = 0; i < conventions.length; i++) {\n    if (!text(conventions[i].bookTypeCode).trim()) conventions[i].bookTypeCode = books[0];\n  }\n  return conventions;\n}\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction flattenAssetInfo(input) {\n  var rows = [];\n  var seenAssetRows = {};\n\n  function parseLoopJson(v) {\n    if (typeof v !== \"string\") return v;\n    try { return JSON.parse(v); } catch (e1) {\n      try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n    }\n  }\n\n  function addAssetRow(row) {\n    if (!row || typeof row !== \"object\") return;\n    var key;\n    try { key = JSON.stringify(row); } catch (e) { key = String(rows.length); }\n    if (seenAssetRows[key]) return;\n    seenAssetRows[key] = true;\n    rows.push(row);\n  }\n\n  function collectAssetRows(value, depth) {\n    if (depth > 12 || value === null || value === undefined) return;\n    value = parseLoopJson(value);\n    if (Array.isArray(value)) {\n      for (var i = 0; i < value.length; i++) collectAssetRows(value[i], depth + 1);\n      return;\n    }\n    if (!value || typeof value !== \"object\") return;\n    if (isAssetInfoRow(value)) {\n      addAssetRow(value);\n      return;\n    }\n    if (Array.isArray(value.assetInfoList)) {\n      for (var r = 0; r < value.assetInfoList.length; r++) addAssetRow(value.assetInfoList[r]);\n    }\n    var keys = Object.keys(value);\n    for (var k = 0; k < keys.length; k++) {\n      if (keys[k] !== \"assetInfoList\") collectAssetRows(value[keys[k]], depth + 1);\n    }\n  }\n\n  collectAssetRows(input, 0);\n  return rows;\n}\n\nfunction isAssetInfoRow(row) {\n  if (!row || typeof row !== \"object\") return false;\n  var keys = [\n    \"assetNumber\", \"AssetNumber\", \"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\",\n    \"bookTypeCode\", \"BookTypeCode\", \"bookName\", \"X_CORP_BOOK_TYPE_CODE\", \"X_BOOK_TYPE_CODE\",\n    \"description\", \"assetDescription\", \"Description\", \"X_DESCRIPTION_TBL\", \"X_ASSET_DESCRIPTION_TBL\",\n    \"assetId\", \"AssetId\", \"X_ASSET_ID\", \"X_ASSET_ID_TBL\",\n    \"TagNumber\", \"tagNumber\", \"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\",\n    \"serialNumber\", \"SerialNumber\", \"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\",\n    \"cost\", \"costRetired\", \"X_COST\", \"X_COST_TBL\",\n    \"valid\", \"comments\", \"CurrencyCode\", \"currencyCode\"\n  ];\n  for (var i = 0; i < keys.length; i++) {\n    if (row[keys[i]] !== null && row[keys[i]] !== undefined && String(row[keys[i]]).trim() !== \"\") return true;\n  }\n  return false;\n}\n\nvar rows = flattenAssetInfo(assetInfoInput);\nvar activeAssets = [];\nfor (var i = 0; i < rows.length; i++) {\n  var a = rows[i] || {};\n  var valid = text(a.valid).toUpperCase() === \"Y\";\n  activeAssets.push({\n    assetId: text(a.assetId),\n    bookTypeCode: text(a.bookTypeCode),\n    bookName: text(a.bookName || a.bookTypeCode),\n    currencyCode: text(a.CurrencyCode || a.currencyCode),\n    assetNumber: text(a.assetNumber),\n    description: text(a.description || a.assetDescription),\n    tagNumber: text(a.TagNumber || a.tagNumber),\n    serialNumber: text(a.serialNumber),\n    costRetired: text(a.cost || a.costRetired),\n    retirementDate: text(a.retirementDate || a.dateRetired),\n    retirementReason: text(a.retirementReason),\n    retirementConvention: text(a.retirementConvention),\n    status: valid ? \"ready_for_request_review\" : \"invalid_or_unavailable\",\n    validationMessage: text(a.comments)\n  });\n}\n\nvar availableRetirementReasons = collectRetirementReasons($context.$nodes.PARSERETIREMENTREASONLIST && $context.$nodes.PARSERETIREMENTREASONLIST.$output);\nif (availableRetirementReasons.length === 0) availableRetirementReasons = asArray(prior.availableRetirementReasons);\nvar availableRetirementConventions = collectRetirementConventions($context.$nodes.PARSERETIREMENTCONVENTIONLIST && $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output);\navailableRetirementConventions = applySingleBookToConventions(availableRetirementConventions, activeBookList(activeAssets.length ? activeAssets : rows));\nif (availableRetirementConventions.length === 0) availableRetirementConventions = asArray(prior.availableRetirementConventions);\nvar events = asArray(prior.events).slice(0);\nevents.push({ action: \"request_review_ready\", stage: \"RETIREMENT_REQUEST_REVIEW\", assetCount: activeAssets.length });\n\nreturn {\n  schemaVersion: \"1.0\",\n  stage: \"RETIREMENT_REQUEST_REVIEW\",\n  source: \"CHAT_RETIREMENT_REQUEST\",\n  lastUserMessage: text($context.$system.$inputMessage),\n  activeAssets: activeAssets,\n  removedAssets: asArray(prior.removedAssets),\n  pendingRequest: request,\n  availableRetirementReasons: availableRetirementReasons,\n  availableRetirementConventions: availableRetirementConventions,\n  draftTransactions: asArray(prior.draftTransactions),\n  postResults: asArray(prior.postResults),\n  lastReviewHtml: text($context.$nodes.RETIREMENTREQUESTHTML.$output.result),\n  events: events\n};"
          },
