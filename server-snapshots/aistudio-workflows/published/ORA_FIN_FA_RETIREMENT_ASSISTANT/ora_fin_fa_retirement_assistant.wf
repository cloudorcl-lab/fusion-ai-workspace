            "name": "Get Current Table",
            "returnType": "string",
            "sourceCode": "var state = $context.$variables.conversationRetirementFlowState || {};\nif (typeof state === \"string\") {\n  try { state = JSON.parse(state); } catch (e) { state = {}; }\n}\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nvar stage = text($context.$variables.retirementConversationStage || state.stage).trim();\nvar html = text(state.lastReviewHtml).trim();\n\nif ((stage === \"RETIREMENT_REQUEST_REVIEW\" || stage === \"TRANSACTION_REVIEW\") && html) {\n  return html;\n}\n\nif (stage === \"POSTING_COMPLETE\") {\n  return \"Posting is already complete for the previous retirement transaction. There are no active retirement transactions right now. Start with Retire Assets, Show Retirement Requests, or Show Exception Transactions.\";\n}\n\nif (stage === \"RETIREMENT_REQUEST_REVIEW\") {\n  return \"I do not have the asset retirement request table in context yet. Please provide or re-enter the asset details, and I will show the request review table again.\";\n}\n\nif (stage === \"TRANSACTION_REVIEW\") {\n  return \"I do not have the transaction review table in context yet. Please show retirement requests again or continue from the current review.\";\n}\n\nreturn \"There are no active retirement transactions right now. Start with Retire Assets, Show Retirement Requests, or Show Exception Transactions.\";"
          },
