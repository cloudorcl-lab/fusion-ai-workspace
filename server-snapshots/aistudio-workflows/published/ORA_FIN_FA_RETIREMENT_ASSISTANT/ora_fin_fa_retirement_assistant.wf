            "OUT_OF_SCOPE": "1778255528169",
            "TRANSACTION_REVIEW_PROCEED": "1779000010003",
            "TRANSACTION_REVIEW_CHANGE": "1779000010006",
            "TRANSACTION_REVIEW_CANCEL": "1779000010013",
            "TRANSACTION_REVIEW_CLARIFY": "1779000010015",
            "RETIREMENT_REQUEST_PROCEED": "1779000010010",
            "RETIREMENT_REQUEST_CHANGE": "1779000010012",
            "RETIREMENT_REQUEST_CANCEL": "1779210000001",
            "RETIREMENT_REQUEST_CLARIFY": "1779000010016",
            "ASSET_CONTEXT_QUERY": "1779100000001",
            "SHOW_RETIREMENT_DETAILS_TABLE": "1779300000001",
