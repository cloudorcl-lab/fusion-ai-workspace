                    "sourceCode": "var input = $context.$nodes.POSTTRANSACTIONS.EXTRACTPOSTINGSTATUS.$output;\n\n// Parse if string\nif (typeof input === \"string\") {\n    input = JSON.parse(input);\n}\n\nvar errorMsg = input?.assetRetirementTransactionStatus?.[0]?.errorMessage || \"\";\n\nvar firstLine = errorMsg ? errorMsg.split(\"\\n\")[0] : \"POSTING ERROR\";\n\n\n\nreturn firstLine;"
                  },
