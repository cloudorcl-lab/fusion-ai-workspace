            "returnType": "string",
            "sourceCode": "var data = $context.$nodes.DRAFTRETIREMENTSDATA_NEW_LANE.$output || {};\nif (data && data.result) data = data.result;\nvar rows = (data && data.pendingRetirements) ? data.pendingRetirements : [];\nvar source = $context.$variables.source;\nvar topMessage = $context.$nodes.MESSAGE_NEW_LANE.$output || \"\";\nvar bottomMessage = $context.$nodes.NEXTSTEPS_NEW_LANE.$output || \"\";\nvar userPreferencesResponse = $context.$nodes.GETUSERPREFERENCES.$output || {};\nvar userPref = (userPreferencesResponse.items && userPreferencesResponse.items.length > 0) ? userPreferencesResponse.items[0] : {};\nfunction parseStateForPrecision(v) {\n  if (typeof v !== \"string\") return v || {};\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nvar savedStateForPrecision = parseStateForPrecision($context.$variables.conversationRetirementFlowState || {});\nvar currencyResponse = {};\nif ($context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE && $context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE.$output) {\n  currencyResponse = $context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE.$output;\n} else if ($context.$nodes.PARSEUNIQUECURRENCYPRECISION && $context.$nodes.PARSEUNIQUECURRENCYPRECISION.$output) {\n  currencyResponse = $context.$nodes.PARSEUNIQUECURRENCYPRECISION.$output;\n} else if (savedStateForPrecision && savedStateForPrecision.currencyPrecision) {\n  currencyResponse = { result: savedStateForPrecision.currencyPrecision };\n}\nif (Array.isArray(currencyResponse)) { currencyResponse = { result: currencyResponse }; }\n\nvar dateFormat = userPref.DateFormat || \"MM/dd/yy\";\nvar decimalSeparator = userPref.DecimalSeparator || \".\";\nvar groupingSeparator = userPref.GroupingSeparator || \",\";\n\nvar heading = \"Asset Retirement Details\";\n\nif (source === \"ORA_REQUEST_AGENT\") {\n  heading = \"Retirement Request Details\";\n} else if (source === \"ORA_INGESTION_AGENT\") {\n  heading = \"Asset Retirement Transaction Details\";\n} else if (source === \"ERROR\") {\n  heading = \"Asset Retirement Exception Transaction Details\";\n}\n\nvar html = \"\";\n\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%; overflow-x:auto;'>\";\n\nif (!rows || rows.length === 0) {\n  html += \"<div>No Pending Asset Retirement Transaction for review</div>\";\n  html += \"</div>\";\n  return html;\n}\n\nhtml += \"<table style='width:100%; max-width:100%; border-collapse:collapse; border:1px solid #e0e0e0; table-layout:fixed;'>\";\n\nhtml += \"<colgroup>\";\nhtml += \"<col style='width:4%;'>\";\nhtml += \"<col style='width:14%;'>\";\nhtml += \"<col style='width:16%;'>\";\nhtml += \"<col style='width:18%;'>\";\nhtml += \"<col style='width:12%;'>\";\nhtml += \"<col style='width:10%;'>\";\nhtml += \"<col style='width:12%;'>\";\nhtml += \"<col style='width:16%;'>\";\nhtml += \"</colgroup>\";\n\nhtml += \"<thead>\";\n\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th colspan='8' style='text-align:left; padding:10px; font-size:15px; font-weight:600; border-bottom:1px solid #e0e0e0;'>\";\nhtml += heading;\nhtml += \"</th>\";\nhtml += \"</tr>\";\n\nif (topMessage) {\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<th colspan='8' style='text-align:left; padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>\";\n  html += topMessage;\n  html += \"</th>\";\n  html += \"</tr>\";\n}\n\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Row</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Book</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Asset Number</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Description</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'><span style='color:red;'>*</span> Retirement Date</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:right;'><span style='color:red;'>*</span> Cost Retired</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'><span style='color:red;'>*</span> Convention</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Retirement Reason</th>\";\nhtml += \"</tr>\";\n\nhtml += \"</thead>\";\nhtml += \"<tbody>\";\n\nfor (var i = 0; i < rows.length; i++) {\n\n  var item = rows[i] || {};\n  var bgColor = (i % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n\n  var bookName = (item.bookName === null || item.bookName === undefined || item.bookName === \"\") ? \"\" : String(item.bookName)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var rowCurrencyCodeRaw = item.currencyCode != null ? item.currencyCode : item.CurrencyCode;\n\n  var rowCurrencyCode = (rowCurrencyCodeRaw === null || rowCurrencyCodeRaw === undefined || rowCurrencyCodeRaw === \"\") ? \"\" : String(rowCurrencyCodeRaw)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var rowPrecision = 1;\n\n  if (currencyResponse.result && currencyResponse.result.length > 0) {\n\n    for (var p = 0; p < currencyResponse.result.length; p++) {\n\n      var cf = currencyResponse.result[p].currencyFormat || {};\n\n      if ((cf.CurrencyCode || \"\") === (item.currencyCode || item.CurrencyCode || \"\")) {\n\n        rowPrecision = Number(cf.Precision);\n\n        if (isNaN(rowPrecision)) {\n          rowPrecision = 1;\n        }\n\n        break;\n      }\n    }\n  }\n\n  var bookDisplay = bookName;\n\n  if (rowCurrencyCode) {\n    bookDisplay = bookName ? (bookName + \" - \" + rowCurrencyCode) : rowCurrencyCode;\n  }\n\n  var assetNumber = (item.assetNumber === null || item.assetNumber === undefined || item.assetNumber === \"\") ? \"\" : String(item.assetNumber)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var assetDescription = (item.assetDescription === null || item.assetDescription === undefined || item.assetDescription === \"\") ? \"\" : String(item.assetDescription)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n   var dateRetired = \"\";\n\nif (item.dateRetired !== null && item.dateRetired !== undefined && item.dateRetired !== \"\") {\n  var d = new Date(item.dateRetired);\n\n  if (!isNaN(d.getTime())) {\n    var yyyy = String(d.getFullYear());\n    var yy = yyyy.slice(-2);\n\n    var M = String(d.getMonth() + 1);\n    var MM = M.padStart(2, \"0\");\n\n    var day = String(d.getDate());\n    var dd = day.padStart(2, \"0\");\n\n    dateRetired = dateFormat.replace(/yyyy|yy|MM|M|dd|d/g, function (token) {\n      return {\n        yyyy: yyyy,\n        yy: yy,\n        MM: MM,\n        M: M,\n        dd: dd,\n        d: day\n      }[token];\n    });\n\n  } else {\n    dateRetired = String(item.dateRetired)\n      .replace(/&/g, \"&amp;\")\n      .replace(/</g, \"&lt;\")\n      .replace(/>/g, \"&gt;\")\n      .replace(/\\\"/g, \"&quot;\")\n      .replace(/'/g, \"&#39;\");\n  }\n}\n\n  var costRetired = \"-\";\n\n  if (item.costRetired !== null && item.costRetired !== undefined && item.costRetired !== \"\") {\n\n    var n1 = Number(item.costRetired);\n\n    if (!isNaN(n1)) {\n\n      var fixed1 = n1.toFixed(rowPrecision);\n      var parts1 = fixed1.split(\".\");\n      var int1 = parts1[0];\n      var dec1 = parts1.length > 1 ? parts1[1] : \"\";\n      var sign1 = \"\";\n\n      if (int1.charAt(0) === \"-\") {\n        sign1 = \"-\";\n        int1 = int1.slice(1);\n      }\n\n      int1 = int1.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n      costRetired = sign1 + int1 + (rowPrecision > 0 ? decimalSeparator + dec1 : \"\");\n\n    } else {\n\n      costRetired = String(item.costRetired)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\\\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n    }\n  }\n\n  var proceedsOfSale = \"-\";\n\n  if (item.proceedsofSale !== null && item.proceedsofSale !== undefined && item.proceedsofSale !== \"\") {\n\n    var n2 = Number(item.proceedsofSale);\n\n    if (!isNaN(n2)) {\n\n      var fixed2 = n2.toFixed(rowPrecision);\n      var parts2 = fixed2.split(\".\");\n      var int2 = parts2[0];\n      var dec2 = parts2.length > 1 ? parts2[1] : \"\";\n      var sign2 = \"\";\n\n      if (int2.charAt(0) === \"-\") {\n        sign2 = \"-\";\n        int2 = int2.slice(1);\n      }\n\n      int2 = int2.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n      proceedsOfSale = sign2 + int2 + (rowPrecision > 0 ? decimalSeparator + dec2 : \"\");\n\n    } else {\n\n      proceedsOfSale = String(item.proceedsofSale)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\\\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n    }\n  }\n\n  var costOfRemoval = \"-\";\n\n  if (item.costofRemoval !== null && item.costofRemoval !== undefined && item.costofRemoval !== \"\") {\n\n    var n3 = Number(item.costofRemoval);\n\n    if (!isNaN(n3)) {\n\n      var fixed3 = n3.toFixed(rowPrecision);\n      var parts3 = fixed3.split(\".\");\n      var int3 = parts3[0];\n      var dec3 = parts3.length > 1 ? parts3[1] : \"\";\n      var sign3 = \"\";\n\n      if (int3.charAt(0) === \"-\") {\n        sign3 = \"-\";\n        int3 = int3.slice(1);\n      }\n\n      int3 = int3.replace(/\\B(?=(\\d{3})+(?!\\d))/g, groupingSeparator);\n\n      costOfRemoval = sign3 + int3 + (rowPrecision > 0 ? decimalSeparator + dec3 : \"\");\n\n    } else {\n\n      costOfRemoval = String(item.costofRemoval)\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\")\n        .replace(/\\\"/g, \"&quot;\")\n        .replace(/'/g, \"&#39;\");\n    }\n  }\n\n  var retirementReason = (item.retirementReason === null || item.retirementReason === undefined || item.retirementReason === \"\") ? \"\" : String(item.retirementReason)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var retirementConvention = (item.retirementConvention === null || item.retirementConvention === undefined || item.retirementConvention === \"\") ? \"\" : String(item.retirementConvention)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var tagNumber = (item.tagNumber != null ? item.tagNumber : \"\");\n  tagNumber = (tagNumber === null || tagNumber === undefined || tagNumber === \"\") ? \"\" : String(tagNumber)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var serialNumber = (item.serialNumber != null ? item.serialNumber : \"\");\n  serialNumber = (serialNumber === null || serialNumber === undefined || serialNumber === \"\") ? \"\" : String(serialNumber)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var createdBy = (item.createdBy === null || item.createdBy === undefined || item.createdBy === \"\") ? \"\" : String(item.createdBy)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n\n  var creationDate = (item.creationDate === null || item.creationDate === undefined || item.creationDate === \"\") ? \"\" : String(item.c