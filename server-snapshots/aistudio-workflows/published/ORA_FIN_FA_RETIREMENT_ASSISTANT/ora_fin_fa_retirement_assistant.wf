          "id": "1881000000103",
          "inputs": [],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"BookTypeCode\": {\n            \"type\": \"string\"\n          },\n          \"CurrencyCode\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"BookTypeCode\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Build Book Access Table",
            "returnType": "string",
            "sourceCode": "var response = ($context.$nodes.GETASSETBOOKS_BOOK_ACCESS && $context.$nodes.GETASSETBOOKS_BOOK_ACCESS.$output) || {};\nvar items = [];\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction esc(v) {\n  return text(v)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\\\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\nif (Array.isArray(response)) {\n  items = response;\n} else if (Array.isArray(response.items)) {\n  items = response.items;\n} else if (response.result && Array.isArray(response.result.items)) {\n  items = response.result.items;\n} else if (response.result && Array.isArray(response.result)) {\n  items = response.result;\n}\nvar rows = [];\nvar seen = {};\nfor (var i = 0; i < items.length; i++) {\n  var item = items[i] || {};\n  var book = text(item.BookTypeCode || item.bookTypeCode || item.bookName || item.BookName || item.Book || item.book || item.value || item.name).trim();\n  var currency = text(item.CurrencyCode || item.currencyCode || item.Currency || item.currency).trim();\n  if (!book) continue;\n  var key = (book + \"||\" + currency).toUpperCase();\n  if (seen[key]) continue;\n  seen[key] = true;\n  rows.push({ book: book, currency: currency });\n}\nrows.sort(function(a, b) { return a.book.localeCompare(b.book); });\nvar html = \"\";\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%; overflow-x:auto;'>\";\nhtml += \"<table style='width:100%; max-width:100%; border-collapse:collapse; border:1px solid #e0e0e0; table-layout:fixed;'>\";\nhtml += \"<colgroup><col style='width:70%;'><col style='width:30%;'></colgroup>\";\nhtml += \"<thead>\";\nhtml += \"<tr style='background:#f5f5f5;'><th colspan='2' style='text-align:left; padding:10px; font-size:15px; font-weight:600; border-bottom:1px solid #e0e0e0;'>Accessible Asset Books</th></tr>\";\nif (rows.length > 0) {\n  html += \"<tr style='background:#f5f5f5;'><th colspan='2' style='text-align:left; padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>These are the asset books you can access for retirement transactions.</th></tr>\";\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<th style='padding:6px 8px; text-align:left;'>Book</th>\";\n  html += \"<th style='padding:6px 8px; text-align:left;'>Currency</th>\";\n  html += \"</tr>\";\n}\nhtml += \"</thead>\";\nhtml += \"<tbody>\";\nif (rows.length === 0) {\n  html += \"<tr><td colspan='2' style='padding:10px;'>No accessible asset books were returned for retirement transactions.</td></tr>\";\n} else {\n  for (var r = 0; r < rows.length; r++) {\n    var bg = (r % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n    html += \"<tr style='background:\" + bg + \";'>\";\n    html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(rows[r].book) + \"</td>\";\n    html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(rows[r].currency || \"-\") + \"</td>\";\n    html += \"</tr>\";\n  }\n}\nhtml += \"</tbody></table>\";\nhtml += \"<div style='margin-top:8px;'>To return to the current Retirement Transaction, type Show Retirement Details.</div>\";\nhtml += \"</div>\";\nreturn html;"
          },
