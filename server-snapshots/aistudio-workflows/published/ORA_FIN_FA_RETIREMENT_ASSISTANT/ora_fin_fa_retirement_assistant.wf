                      "value": "{{($context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.result && $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.result.assetInfoList && $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.result.assetInfoList[0] && $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.result.assetInfoList[0].bookTypeCode) || ($context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.assetInfoList && $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.assetInfoList[0] && $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.EXTRACTASSETDETAILS_REQ_PROCEED.$output.assetInfoList[0].bookTypeCode) || \"\"}}"
