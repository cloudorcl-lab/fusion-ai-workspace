          "code": "CONFIRMATIONMESSAGE",
          "id": "1776275223035",
          "inputs": [
            {
              "id": "1776275223039_1",
              "name": "prompt",
              "type": "string",
              "value": "========================\nINPUT\n========================\nUser change message:\n{{$context.$system.$inputMessage}}\n\nPrevious request, if this was a change to an existing review:\n{{$context.$variables.previousRetirementChangeRequestJson.assetRetirementTransactions}}\n\nUpdated request:\n{{$context.$variables.retirementChangeRequestJson.assetRetirementTransactions}}\n\n========================\nTASK\n========================\nIf Previous request is missing, empty, or unchanged, return exactly:\nI've gathered all the asset details for you. Review them and reply with \"proceed\" when you are ready, or tell me what to change.\n\nOtherwise compare Previous request with Updated request and summarize only what changed.\n\nDetect:\n- added assets\n- removed assets\n- updated costRetired, retirementReason, or retirementDate\n\nRules:\n- Preserve identifier values exactly, including underscores, spaces, and casing.\n- Match records using queryFilter + parameter.\n- Use human labels: Asset Number, Serial Number, Tag Number, Cost retired, Retirement reason, Retirement date.\n- Keep it short and conversational.\n- End with: Review the updated list and reply with \"proceed\" when you are ready, or tell me what else to change.\n- Do not mention approval buttons or clicking."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Build Request Table",
            "returnType": "string",
            "sourceCode": "let data = $context.$nodes.OBTAINASSETINFORMATION.$output || [];\nlet topMessage = $context.$nodes.CONFIRMATIONMESSAGE.$output || \"\";\nlet bottomMessage = \"Reply with Proceed to capture retirement details for these assets, or add additional assets or remove assets before proceeding.<br><span style='font-weight:600;'>Note:</span> Invalid assets will be removed automatically from processing.\";\nlet html = \"\";\n\n// ---------------- PARSE VALIDATED LOOP OUTPUT ----------------\nlet rows = [];\nlet seenAssetRows = {};\n\nfunction parseLoopJson(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n  }\n}\n\nfunction addAssetRow(row) {\n  if (!row || typeof row !== \"object\") return;\n  let key;\n  try { key = JSON.stringify(row); } catch (e) { key = String(rows.length); }\n  if (seenAssetRows[key]) return;\n  seenAssetRows[key] = true;\n  rows.push(row);\n}\n\nfunction isAssetInfoRow(row) {\n  if (!row || typeof row !== \"object\") return false;\n  let keys = [\n    \"assetNumber\", \"AssetNumber\", \"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\",\n    \"bookTypeCode\", \"BookTypeCode\", \"bookName\", \"X_CORP_BOOK_TYPE_CODE\", \"X_BOOK_TYPE_CODE\",\n    \"description\", \"assetDescription\", \"Description\", \"X_DESCRIPTION_TBL\", \"X_ASSET_DESCRIPTION_TBL\",\n    \"assetId\", \"AssetId\", \"X_ASSET_ID\", \"X_ASSET_ID_TBL\",\n    \"TagNumber\", \"tagNumber\", \"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\",\n    \"serialNumber\", \"SerialNumber\", \"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\",\n    \"cost\", \"costRetired\", \"X_COST\", \"X_COST_TBL\",\n    \"valid\", \"comments\", \"CurrencyCode\", \"currencyCode\"\n  ];\n  for (let i = 0; i < keys.length; i++) {\n    if (row[keys[i]] !== null && row[keys[i]] !== undefined && String(row[keys[i]]).trim() !== \"\") return true;\n  }\n  return false;\n}\n\nfunction collectAssetRows(value, depth) {\n  if (depth > 12 || value === null || value === undefined) return;\n  value = parseLoopJson(value);\n  if (Array.isArray(value)) {\n    for (let i = 0; i < value.length; i++) collectAssetRows(value[i], depth + 1);\n    return;\n  }\n  if (!value || typeof value !== \"object\") return;\n  if (isAssetInfoRow(value)) {\n    addAssetRow(value);\n    return;\n  }\n  if (Array.isArray(value.assetInfoList)) {\n    for (let r = 0; r < value.assetInfoList.length; r++) addAssetRow(value.assetInfoList[r]);\n  }\n  let keys = Object.keys(value);\n  for (let k = 0; k < keys.length; k++) {\n    if (keys[k] !== \"assetInfoList\") collectAssetRows(value[keys[k]], depth + 1);\n  }\n}\n\ncollectAssetRows(data, 0);\n\nlet totalRows = rows.length;\n\nfunction esc(v) {\n  if (v === null || v === undefined || v === \"\") return \"-\";\n  return String(v)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\n\nfunction getIdentifierLabel(item) {\n  let source = item && item.queryFilter !== null && item.queryFilter !== undefined\n    ? String(item.queryFilter).toUpperCase()\n    : \"\";\n\n  if (source.indexOf(\"TAG\") > -1) return \"Tag Number\";\n  if (source.indexOf(\"SERIAL\") > -1) return \"Serial Number\";\n  if (source.indexOf(\"ASSET\") > -1) return \"Asset Number\";\n\n  if (item) {\n    if (item.TagNumber !== null && item.TagNumber !== undefined && String(item.TagNumber).trim() !== \"\") return \"Tag Number\";\n    if (item.tagNumber !== null && item.tagNumber !== undefined && String(item.tagNumber).trim() !== \"\") return \"Tag Number\";\n    if (item.serialNumber !== null && item.serialNumber !== undefined && String(item.serialNumber).trim() !== \"\") return \"Serial Number\";\n    if (item.assetNumber !== null && item.assetNumber !== undefined && String(item.assetNumber).trim() !== \"\") return \"Asset Number\";\n  }\n\n  return \"Asset Number or Tag Number or Serial Number\";\n}\n\nfunction getIdentifierValue(item) {\n  if (!item) return \"\";\n\n  if (item.parameter !== null && item.parameter !== undefined && String(item.parameter).trim() !== \"\") return String(item.parameter).trim();\n  if (item.assetNumber !== null && item.assetNumber !== undefined && String(item.assetNumber).trim() !== \"\") return String(item.assetNumber).trim();\n  if (item.TagNumber !== null && item.TagNumber !== undefined && String(item.TagNumber).trim() !== \"\") return String(item.TagNumber).trim();\n  if (item.tagNumber !== null && item.tagNumber !== undefined && String(item.tagNumber).trim() !== \"\") return String(item.tagNumber).trim();\n  if (item.serialNumber !== null && item.serialNumber !== undefined && String(item.serialNumber).trim() !== \"\") return String(item.serialNumber).trim();\n\n  return \"\";\n}\n\nfunction invalidAssetMessage(item) {\n  let label = getIdentifierLabel(item);\n  let value = getIdentifierValue(item);\n\n  if (value) {\n    return \"Asset doesn't exist with \" + label + \" \" + value;\n  }\n\n  return \"Asset doesn't exist with Asset Number or Tag Number or Serial Number\";\n}\n\nfunction invalidHtml(text) {\n  return \"<div style='text-align:left;'><span style='color:#d1242f; font-weight:700;' title='Invalid'>&#10007;</span> \" + esc(text) + \"</div>\";\n}\n\nfunction normalizeLegacyComment(text, item) {\n  if (text === null || text === undefined || text === \"\") return \"\";\n\n  let value = String(text);\n  let lower = value.toLowerCase();\n\n  if (lower.indexOf(\"cost\") > -1 && lower.indexOf(\"missing\") > -1 && lower.indexOf(\"invalid\") > -1) {\n    return invalidAssetMessage(item);\n  }\n\n  if (lower.indexOf(\"already\") > -1 && lower.indexOf(\"retired\") > -1) {\n    return \"This asset has already been fully retired.\";\n  }\n\n  return value;\n}\n\nfunction commentHtml(item) {\n  let validFlag = item && item.valid !== null && item.valid !== undefined\n    ? String(item.valid).trim().toUpperCase()\n    : \"N\";\n  let commentText = item && item.comments !== null && item.comments !== undefined\n    ? String(item.comments).trim()\n    : \"\";\n  let rawCost = item && item.cost !== null && item.cost !== undefined\n    ? String(item.cost).replace(/,/g, \"\").trim()\n    : \"\";\n  let cost = Number(rawCost);\n\n  commentText = normalizeLegacyComment(commentText, item);\n\n  if (commentText.indexOf(\"User doesnt have access to the \") === 0) {\n    return invalidHtml(commentText);\n  }\n\n  if (!rawCost || isNaN(cost)) {\n    return invalidHtml(invalidAssetMessage(item));\n  }\n\n  if (cost === 0) {\n    return invalidHtml(\"This asset has already been fully retired.\");\n  }\n\n  if (validFlag === \"Y\") {\n    return \"<span style='display:block; width:100%; text-align:center; color:#1a7f37; font-weight:700;' title='Valid'>&#10003;</span>\";\n  }\n\n  if (!commentText) {\n    commentText = invalidAssetMessage(item);\n  }\n\n  return invalidHtml(commentText);\n}\n\n// ---------------- CONTAINER ----------------\nhtml += \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f;'>\";\n\n// TABLE\nhtml += \"<table style='width:100%; border-collapse:collapse; border:1px solid #e0e0e0; table-layout:fixed;'>\";\n\nhtml += \"<colgroup>\";\nhtml += \"<col style='width:60px;'>\";\nhtml += \"<col style='width:140px;'>\";\nhtml += \"<col style='width:160px;'>\";\nhtml += \"<col style='width:220px;'>\";\nhtml += \"<col style='width:140px;'>\";\nhtml += \"<col style='width:160px;'>\";\nhtml += \"<col style='width:160px;'>\";\nhtml += \"<col style='width:260px;'>\";\nhtml += \"</colgroup>\";\n\nhtml += \"<thead>\";\n\n// TITLE ROW\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th colspan='8' style='text-align:left; padding:10px; font-size:15px; font-weight:600; border-bottom:1px solid #e0e0e0;'>\";\nhtml += \"Asset Retirement Details\";\nhtml += \"</th>\";\nhtml += \"</tr>\";\n\n// TOP MESSAGE ROW\nif (topMessage) {\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<th colspan='8' style='text-align:left; padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>\";\n  html += topMessage;\n  html += \"</th>\";\n  html += \"</tr>\";\n}\n\n// SUBTEXT ROW\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th colspan='8' style='text-align:left; padding:6px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>\";\nhtml += \"Total rows: \" + totalRows;\nhtml += \"</th>\";\nhtml += \"</tr>\";\n\n// COLUMN HEADERS\nhtml += \"<tr style='background:#f5f5f5;'>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Row</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Book</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Asset Number</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Description</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Tag Number</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Serial Number</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:left;'>Retirement Reason</th>\";\nhtml += \"<th style='padding:6px 8px; text-align:center;'>Validation Status</th>\";\nhtml += \"</tr>\";\n\nhtml += \"</thead>\";\n\n// ROWS\nhtml += \"<tbody>\";\nfor (let i = 0; i < rows.length; i++) {\n  let item = rows[i] || {};\n  let bg = (i % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n\n  html += \"<tr style='background:\" + bg + \";'>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6;'>\" + (i + 1) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(item.bookTypeCode) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(item.assetNumber) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; word-break:break-word; white-space:normal;'>\" + esc(item.description) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(item.TagNumber) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(item.serialNumber) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; word-break:break-word; white-space:normal;'>\" + esc(item.retirementReason) + \"</td>\";\n  html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; word-break:break-word; white-space:normal; text-align:center;'>\" + commentHtml(item) + \"</td>\";\n  html += \"</tr>\";\n}\nhtml += \"</tbody>\";\n\n// BOTTOM MESSAGE ROW\nif (bottomMessage) {\n  html += \"<tfoot>\";\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<td colspan='8' style='padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-top:1px solid #e0e0e0;'>\";\n  html += bottomMessage;\n  html += \"</td>\";\n  html += \"</tr>\";\n  html += \"</tfoot>\";\n}\n\nhtml += \"</table>\";\nhtml += \"<div style='margin-top:30px;'></div>\";\nhtml += \"</div>\";\n\nreturn html;"
          },
          "outcomes": {
            "success": "1779100000000"
