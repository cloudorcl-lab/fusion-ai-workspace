            "sourceCode": "var prior = $context.$variables.conversationRetirementFlowState || {};\nvar data = $context.$nodes.DRAFTRETIREMENTSDATA_NEW_LANE.$output || {};\nif (data && data.result) data = data.result;\nvar rows = Array.isArray(data.pendingRetirements) ? data.pendingRetirements : [];\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction uniqueKey(parts) { return parts.join(\"||\"); }\nfunction collectRetirementReasons(src) {\n  var out = [];\n  var seen = {};\n  function addBook(bookObj) {\n    bookObj = bookObj || {};\n    var bookCode = text(bookObj.bookTypeCode || bookObj.BookTypeCode || bookObj.bookName || bookObj.Book || \"\").trim();\n    var reasons = asArray(bookObj.retirementReason || bookObj.retirementReasons || bookObj.reasons);\n    var rows = [];\n    for (var i = 0; i < reasons.length; i++) {\n      var r = reasons[i] || {};\n      var code = text(r.retirementReasonCode || r.code || r.lookupCode || r.X_LOOKUP_CODE || \"\").trim();\n      var meaning = text(r.retirementReasonMeaning || r.meaning || r.description || r.X_MEANING || \"\").trim();\n      if (!code && !meaning) continue;\n      var rowKey = uniqueKey([bookCode, code, meaning]);\n      if (seen[rowKey]) continue;\n      seen[rowKey] = true;\n      rows.push({ retirementReasonCode: code, retirementReasonMeaning: meaning });\n    }\n    if (rows.length > 0) out.push({ bookTypeCode: bookCode, retirementReason: rows });\n  }\n  function visit(v) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i]); return; }\n    if (v.result) visit(v.result);\n    if (Array.isArray(v.retirementReasonList)) { for (var j = 0; j < v.retirementReasonList.length; j++) addBook(v.retirementReasonList[j]); return; }\n    if (Array.isArray(v.retirementReason)) addBook(v);\n  }\n  visit(src);\n  return out;\n}\nfunction collectRetirementConventions(src) {\n  var out = [];\n  var seen = {};\n  function valueArray(v) {\n    if (Array.isArray(v)) return v;\n    if (v === null || v === undefined || v === \"\") return [];\n    if (typeof v === \"string\") {\n      var raw = v.trim();\n      if (!raw) return [];\n      if (/^[\\[{]/.test(raw)) {\n        try {\n          var parsed = JSON.parse(raw);\n          return Array.isArray(parsed) ? parsed : [parsed];\n        } catch (e) {}\n      }\n      return raw.split(\",\").map(function(x){ return x.trim(); }).filter(function(x){ return x !== \"\"; });\n    }\n    return [v];\n  }\n  function addConvValues(bookCode, code, id) {\n    code = text(code).trim();\n    id = text(id).trim();\n    bookCode = text(bookCode).trim();\n    if (!code && !id) return;\n    var rowKey = uniqueKey([bookCode, code, id]);\n    if (seen[rowKey]) return;\n    seen[rowKey] = true;\n    out.push({ bookTypeCode: bookCode, retirementConventionCode: code, retirementConventionId: id });\n  }\n  function addConv(v, inheritedBook) {\n    v = v || {};\n    var bookCode = text(v.bookTypeCode || v.BookTypeCode || inheritedBook || \"\").trim();\n    var codes = valueArray(v.retirementConventionCode || v.conventionCode || v.code || v.X_CONVENTION_TYPE_CODE || v.X_CONVENTION_TYPE_CODE_TBL);\n    var ids = valueArray(v.retirementConventionId || v.conventionId || v.id || v.X_CONVENTION_TYPE_ID || v.X_CONVENTION_TYPE_ID_TBL);\n    var max = Math.max(codes.length, ids.length);\n    for (var c = 0; c < max; c++) addConvValues(bookCode, codes[c], ids[c]);\n  }\n  function visit(v, inheritedBook) {\n    v = parseAny(v);\n    if (!v) return;\n    if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i], inheritedBook); return; }\n    if (v.result !== undefined) visit(v.result, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n    if (v.output !== undefined) visit(v.output, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n    if (Array.isArray(v.retirementConvention)) { for (var j = 0; j < v.retirementConvention.length; j++) addConv(v.retirementConvention[j], inheritedBook || v.bookTypeCode || v.BookTypeCode); }\n    addConv(v, inheritedBook);\n  }\n  visit(src, \"\");\n  return out;\n}\nfunction activeBookList(rows) {\n  var seenBooks = {};\n  var books = [];\n  rows = asArray(rows);\n  for (var i = 0; i < rows.length; i++) {\n    var b = text(rows[i].bookTypeCode || rows[i].bookName || rows[i].BookTypeCode || \"\").trim();\n    if (b && !seenBooks[b]) { seenBooks[b] = true; books.push(b); }\n  }\n  return books;\n}\nfunction applySingleBookToConventions(conventions, books) {\n  conventions = asArray(conventions);\n  books = asArray(books);\n  if (books.length !== 1) return conventions;\n  for (var i = 0; i < conventions.length; i++) {\n    if (!text(conventions[i].bookTypeCode).trim()) conventions[i].bookTypeCode = books[0];\n  }\n  return conventions;\n}\nfunction applySingleBookToReasons(reasons, books) {\n  reasons = asArray(reasons);\n  books = asArray(books);\n  if (books.length !== 1) return reasons;\n  for (var i = 0; i < reasons.length; i++) {\n    if (!text(reasons[i].bookTypeCode).trim()) reasons[i].bookTypeCode = books[0];\n  }\n  return reasons;\n}\nfunction collectCurrencyPrecision() {\n  var src = {};\n  if ($context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE && $context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE.$output) src = $context.$nodes.PARSEUNIQUECURRENCYPRECISION_NEW_LANE.$output;\n  else if ($context.$nodes.PARSEUNIQUECURRENCYPRECISION && $context.$nodes.PARSEUNIQUECURRENCYPRECISION.$output) src = $context.$nodes.PARSEUNIQUECURRENCYPRECISION.$output;\n  var out = asArray(src && src.result !== undefined ? src.result : src);\n  if (out.length === 0) out = asArray(prior.currencyPrecision);\n  return out;\n}\nvar currencyPrecision = collectCurrencyPrecision();\nvar activeAssets = [];\nfor (var i = 0; i < rows.length; i++) {\n  var r = rows[i] || {};\n  activeAssets.push({\n    assetId: text(r.assetId),\n    retirementInterfaceId: text(r.retirementInterfaceId),\n    bookTypeCode: text(r.bookName || r.bookTypeCode),\n    bookName: text(r.bookName || r.bookTypeCode),\n    currencyCode: text(r.currencyCode || r.CurrencyCode),\n    assetNumber: text(r.assetNumber),\n    description: text(r.assetDescription || r.description),\n    tagNumber: text(r.tagNumber || r.TagNumber),\n    serialNumber: text(r.serialNumber),\n    costRetired: text(r.costRetired),\n    proceedsOfSale: text(r.proceedsofSale || r.proceedsOfSale),\n    costOfRemoval: text(r.costofRemoval || r.costOfRemoval),\n    retirementDate: text(r.dateRetired || r.retirementDate),\n    retirementReason: text(r.retirementReason || r.retirementTypeCode),\n    retirementTypeCode: text(r.retirementTypeCode),\n    retirementConvention: text(r.retirementConvention),\n    retirementConventionId: text(r.retirementConventionId),\n    transactionComments: text(r.transactionName || r.comments || r.transactionComments),\n    status: \"ready_for_posting_review\",\n    validationMessage: \"\"\n  });\n}\nvar availableRetirementReasons = collectRetirementReasons($context.$nodes.PARSERETIREMENTREASONLIST_NEW_LANE && $context.$nodes.PARSERETIREMENTREASONLIST_NEW_LANE.$output);\navailableRetirementReasons = applySingleBookToReasons(availableRetirementReasons, activeBookList(activeAssets.length ? activeAssets : rows));\nif (availableRetirementReasons.length === 0) availableRetirementReasons = asArray(prior.availableRetirementReasons);\nvar availableRetirementConventions = collectRetirementConventions($context.$nodes.PARSERETIREMENTCONVENTIONLIST_NEW_LANE && $context.$nodes.PARSERETIREMENTCONVENTIONLIST_NEW_LANE.$output);\navailableRetirementConventions = applySingleBookToConventions(availableRetirementConventions, activeBookList(activeAssets.length ? activeAssets : rows));\nif (availableRetirementConventions.length === 0) availableRetirementConventions = asArray(prior.availableRetirementConventions);\nvar events = asArray(prior.events).slice(0);\nevents.push({ action: \"transaction_review_ready\", stage: \"TRANSACTION_REVIEW\", assetCount: activeAssets.length });\nreturn {\n  schemaVersion: \"1.1\",\n  stage: \"TRANSACTION_REVIEW\",\n  source: text($context.$variables.source || \"DRAFT_RETIREMENT_TRANSACTIONS\"),\n  lastUserMessage: text($context.$system.$inputMessage),\n  activeAssets: activeAssets,\n  removedAssets: asArray(prior.removedAssets),\n  pendingRequest: prior.pendingRequest || {},\n  availableRetirementReasons: availableRetirementReasons,\n  availableRetirementConventions: availableRetirementConventions,\n  currencyPrecision: currencyPrecision,\n  draftTransactions: rows,\n  draftTransactionPayload: asArray($context.$variables.draftRetirementTransactions && ($context.$variables.draftRetirementTransactions.result || $context.$variables.draftRetirementTransactions)),\n  postResults: asArray(prior.postResults),\n  lastReviewHtml: text($context.$nodes.RETIREMENTDATAHTML_NEW_LANE.$output.result),\n  events: events\n};"
          },
