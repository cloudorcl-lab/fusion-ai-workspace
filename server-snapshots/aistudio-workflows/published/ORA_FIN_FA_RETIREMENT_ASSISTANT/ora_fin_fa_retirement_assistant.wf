{
  "workflowId": "300000331058398",
  "workflowCode": "ORA_FIN_FA_RETIREMENT_ASSISTANT",
  "name": "Retirement Assistant",
  "description": "Automates fixed asset retirements by capturing retirement request details entered directly in chat. It interprets documents, extracts required details (e.g., asset number, book, retirement date, proceeds, cost retired, reason code), and maps them to the correct asset records for accurate, efficient processing. It processes requests from asset custodians or business users via the Retirement Request Assistant agent.",
