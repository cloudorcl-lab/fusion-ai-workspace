          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"pendingRetirements\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"bookName\": {\n            \"type\": \"string\"\n          },\n          \"currencyCode\": {\n            \"type\": \"string\"\n          },\n          \"assetNumber\": {\n            \"type\": \"string\"\n          },\n          \"assetDescription\": {\n            \"type\": \"string\"\n          },\n          \"dateRetired\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"costRetired\": {\n            \"type\": \"number\"\n          },\n          \"retirementReason\": {\n            \"type\": \"string\"\n          },\n          \"retirementTypeCode\": {\n            \"type\": \"string\"\n          },\n          \"retirementConvention\": {\n            \"type\": \"string\"\n          },\n          \"retirementConventionId\": {\n            \"type\": \"number\"\n          },\n          \"costofRemoval\": {\n            \"type\": \"number\"\n          },\n          \"proceedsofSale\": {\n            \"type\": \"number\"\n          },\n          \"createdBy\": {\n            \"type\": \"string\"\n          },\n          \"creationDate\": {\n            \"type\": \"string\",\n            \"format\": \"date\"\n          },\n          \"transactionName\": {\n            \"type\": \"string\"\n          },\n          \"errorMessage\": {\n            \"type\": \"string\"\n          },\n          \"assetId\": {\n            \"type\": \"number\"\n          },\n          \"tagNumber\": {\n            \"type\": \"string\"\n          },\n          \"serialNumber\": {\n            \"type\": \"string\"\n          },\n          \"retirementInterfaceId\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\n          \"bookName\",\n          \"assetNumber\",\n          \"