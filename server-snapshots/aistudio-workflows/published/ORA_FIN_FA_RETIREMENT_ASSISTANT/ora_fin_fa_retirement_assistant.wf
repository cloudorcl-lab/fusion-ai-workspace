          "metadata": {
            "name": "Parse Reasons - New",
            "returnType": "object",
            "sourceCode": "var output = $context.$nodes.OBTAINRETIREMENTREASONLIST_NEW_LANE.$output;\n\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction asArray(v) {\n  if (Array.isArray(v)) return v;\n  if (v === null || v === undefined || v === \"\") return [];\n  if (typeof v === \"string\") {\n    var raw = v.trim();\n    if (!raw) return [];\n    if (/^[\\[{]/.test(raw)) {\n      try { var parsed = JSON.parse(raw); return Array.isArray(parsed) ? parsed : [parsed]; } catch (e) {}\n    }\n    return raw.split(\",\").map(function(x){ return x.trim(); }).filter(function(x){ return x !== \"\"; });\n  }\n  return [v];\n}\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nvar result = { retirementReasonList: [] };\nvar seen = {};\nfunction addBookRows(bookCode, codes, meanings) {\n  bookCode = text(bookCode).trim();\n  codes = asArray(codes);\n  meanings = asArray(meanings);\n  var max = Math.max(codes.length, meanings.length);\n  if (max === 0) return;\n  var rows = [];\n  for (var i = 0; i < max; i++) {\n    var code = text(codes[i]).trim();\n    var meaning = text(meanings[i]).trim();\n    if (!code && !meaning) continue;\n    var key = [bookCode, code, meaning].join(\"||\").toUpperCase();\n    if (seen[key]) continue;\n    seen[key] = true;\n    rows.push({ retirementReasonCode: code, retirementReasonMeaning: meaning });\n  }\n  if (rows.length > 0) result.retirementReasonList.push({ bookTypeCode: bookCode, retirementReason: rows });\n}\nfunction visit(v, inheritedBook) {\n  v = parseMaybe(v);\n  if (!v) return;\n  if (Array.isArray(v)) { for (var i = 0; i < v.length; i++) visit(v[i], inheritedBook); return; }\n  if (v.result !== undefined) visit(v.result, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n  if (v.output !== undefined) visit(v.output, inheritedBook || v.bookTypeCode || v.BookTypeCode);\n  var bookCode = text(v.bookTypeCode || v.BookTypeCode || v.bookName || v.Book || inheritedBook || \"\").trim();\n  if (Array.isArray(v.retirementReasonList)) visit(v.retirementReasonList, bookCode);\n  if (Array.isArray(v.retirementReason)) {\n    var codes = [];\n    var meanings = [];\n    for (var r = 0; r < v.retirementReason.length; r++) {\n      var row = v.retirementReason[r] || {};\n      codes.push(row.retirementReasonCode || row.code || row.lookupCode || row.X_LOOKUP_CODE || \"\");\n      meanings.push(row.retirementReasonMeaning || row.meaning || row.description || row.X_MEANING || \"\");\n    }\n    addBookRows(bookCode, codes, meanings);\n  }\n  addBookRows(bookCode, v.X_LOOKUP_CODE_TBL || v.X_LOOKUP_CODE || v.retirementReasonCode || v.lookupCode || v.code, v.X_MEANING_TBL || v.X_MEANING || v.retirementReasonMeaning || v.meaning || v.description);\n}\nvisit(output, \"\");\nif (result.retirementReasonList.length > 0) return result;\nreturn parseMaybe(output);"
          },
