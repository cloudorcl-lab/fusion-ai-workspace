          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"object\"},\"timeout\":{\"type\":\"boolean\"},\"error\":{\"type\":\"string\"}},\"required\":[\"output\",\"timeout\",\"error\"]}",
