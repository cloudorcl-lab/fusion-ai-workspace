          "code": "OBTAINASSETINFORMATION_REQ_PROCEED",
          "id": "1881000000016",
          "inputs": [
            {
              "id": "1881000000016_collection",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output.result.assetNumbersList}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Transform Request Rows",
            "returnType": "object",
            "sourceCode": "var input = ($context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED && $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output && $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output.result && $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output.result.normalizedRetirementRequest) ? $context.$nodes.EXTRACTASSETNUMBERLIST_REQ_PROCEED.$output.result.normalizedRetirementRequest : $context.$variables.retirementChangeRequestJson;\nvar assetInfoInput = $context.$nodes.OBTAINASSETINFORMATION_REQ_PROCEED.$output;\n\nvar assetRetirements = [];\nvar assetInfoMap = {};\nvar groupedByBook = {};\n\n/* -----------------------------\n   Build Asset Info Map from validated loop output\n----------------------------- */\nfunction parseLoopJson(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return v; }\n  }\n}\n\nfunction isValidatedAssetRow(row) {\n  if (!row || typeof row !== \"object\") return false;\n  var keys = [\n    \"assetNumber\", \"AssetNumber\", \"X_ASSET_NUMBER\", \"X_ASSET_NUMBER_TBL\",\n    \"bookTypeCode\", \"BookTypeCode\", \"bookName\", \"X_CORP_BOOK_TYPE_CODE\", \"X_BOOK_TYPE_CODE\",\n    \"description\", \"assetDescription\", \"Description\", \"X_DESCRIPTION_TBL\", \"X_ASSET_DESCRIPTION_TBL\",\n    \"assetId\", \"AssetId\", \"X_ASSET_ID\", \"X_ASSET_ID_TBL\",\n    \"TagNumber\", \"tagNumber\", \"X_TAG_NUMBER\", \"X_TAG_NUMBER_TBL\",\n    \"serialNumber\", \"SerialNumber\", \"X_SERIAL_NUMBER\", \"X_SERIAL_NUMBER_TBL\",\n    \"cost\", \"costRetired\", \"X_COST\", \"X_COST_TBL\",\n    \"valid\", \"comments\", \"CurrencyCode\", \"currencyCode\"\n  ];\n  for (var i = 0; i < keys.length; i++) {\n    if (row[keys[i]] !== null && row[keys[i]] !== undefined && String(row[keys[i]]).trim() !== \"\") return true;\n  }\n  return false;\n}\n\nfunction collectValidatedAssetRows(value, depth, rows, seen) {\n  if (depth > 12 || value === null || value === undefined) return;\n  value = parseLoopJson(value);\n  if (Array.isArray(value)) {\n    for (var i = 0; i < value.length; i++) collectValidatedAssetRows(value[i], depth + 1, rows, seen);\n    return;\n  }\n  if (!value || typeof value !== \"object\") return;\n  if (isValidatedAssetRow(value)) {\n    var directKey;\n    try { directKey = JSON.stringify(value); } catch (eDirect) { directKey = String(rows.length); }\n    if (!seen[directKey]) {\n      seen[directKey] = true;\n      rows.push(value);\n    }\n    return;\n  }\n  if (Array.isArray(value.assetInfoList)) {\n    for (var r = 0; r < value.assetInfoList.length; r++) {\n      var row = value.assetInfoList[r];\n      if (!row || typeof row !== \"object\") continue;\n      var key;\n      try { key = JSON.stringify(row); } catch (e) { key = String(rows.length); }\n      if (!seen[key]) {\n        seen[key] = true;\n        rows.push(row);\n      }\n    }\n  }\n  var keys = Object.keys(value);\n  for (var k = 0; k < keys.length; k++) {\n    if (keys[k] !== \"assetInfoList\") collectValidatedAssetRows(value[keys[k]], depth + 1, rows, seen);\n  }\n}\n\nvar validatedAssetRows = [];\ncollectValidatedAssetRows(assetInfoInput, 0, validatedAssetRows, {});\n\nfor (var b = 0; b < validatedAssetRows.length; b++) {\n  var asset = validatedAssetRows[b] || {};\n\n  var assetNumber =\n    asset.assetNumber === null || asset.assetNumber === undefined\n      ? \"\"\n      : String(asset.assetNumber).trim();\n\n  var serialNumber =\n    asset.serialNumber === null || asset.serialNumber === undefined\n      ? \"\"\n      : String(asset.serialNumber).trim();\n\n  var tagRaw =\n    asset.TagNumber !== undefined\n      ? asset.TagNumber\n      : asset.tagNumber;\n\n  var tagNumber =\n    tagRaw === null || tagRaw === undefined\n      ? \"\"\n      : String(tagRaw).trim();\n\n  function addAssetInfoMapKey(type, value, assetRow) {\n    if (!value) return;\n    var cleanValue = String(value).trim();\n    if (!cleanValue) return;\n    assetInfoMap[type + \"|\" + cleanValue] = assetRow;\n    assetInfoMap[type + \"|\" + cleanValue.toUpperCase()] = assetRow;\n  }\n\n  addAssetInfoMapKey(\"ASSET_NUMBER\", assetNumber, asset);\n  addAssetInfoMapKey(\"SERIAL_NUMBER\", serialNumber, asset);\n  addAssetInfoMapKey(\"TAG_NUMBER\", tagNumber, asset);\n}\n\n/* -----------------------------\n   Process Retirement Transactions\n----------------------------- */\nvar txns = Array.isArray(input && input.assetRetirementTransactions)\n  ? input.assetRetirementTransactions\n  : [];\n\nfor (var i = 0; i < txns.length; i++) {\n  var bookEntry = txns[i] || {};\n  var rows = Array.isArray(bookEntry.ParameterList)\n    ? bookEntry.ParameterList\n    : [];\n\n  for (var j = 0; j < rows.length; j++) {\n    var row = rows[j] || {};\n\n    var queryFilter =\n      row.queryFilter === null || row.queryFilter === undefined\n        ? \"\"\n        : String(row.queryFilter).trim();\n\n    var parameter =\n      row.parameter === null || row.parameter === undefined\n        ? \"\"\n        : String(row.parameter).trim();\n\n    var lookupType = \"\";\n\n    var queryFilterUpper = queryFilter.toUpperCase();\n    if (queryFilterUpper.indexOf(\"SERIAL\") > -1) {\n      lookupType = \"SERIAL_NUMBER\";\n    } else if (queryFilterUpper.indexOf(\"TAG\") > -1) {\n      lookupType = \"TAG_NUMBER\";\n    } else if (queryFilterUpper.indexOf(\"ASSET\") > -1) {\n      lookupType = \"ASSET_NUMBER\";\n    }\n\n    var lookupKey = lookupType + \"|\" + parameter;\n    var assetInfo = assetInfoMap[lookupKey] || assetInfoMap[lookupType + \"|\" + parameter.toUpperCase()] || {};\n\n    var validFlag =\n      assetInfo.valid === null || assetInfo.valid === undefined\n        ? \"N\"\n        : String(assetInfo.valid).trim().toUpperCase();\n\n    if (validFlag !== \"Y\") {\n      continue;\n    }\n\n    var bookTypeCode =\n      assetInfo.bookTypeCode !== undefined &&\n      assetInfo.bookTypeCode !== null\n        ? String(assetInfo.bookTypeCode).trim()\n        : \"\";\n\n    var currencyCode =\n      assetInfo.CurrencyCode !== undefined &&\n      assetInfo.CurrencyCode !== null\n        ? String(assetInfo.CurrencyCode).trim()\n        : assetInfo.currencyCode !== undefined &&\n          assetInfo.currencyCode !== null\n        ? String(assetInfo.currencyCode).trim()\n        : \"\";\n\n    /* -----------------------------\n       Initialize Book Group\n    ----------------------------- */\n    if (!groupedByBook[bookTypeCode]) {\n      groupedByBook[bookTypeCode] = {\n        BookTypeCode: bookTypeCode,\n        CurrencyCode: currencyCode,\n        seenAssets: {},\n\n        X_BOOK_TYPE_CODE_TBL: [],\n        X_CURRENCY_CODE_TBL: [],\n        X_RETIREMENT_TYPE_CODE_TBL: [],\n        X_COST_OF_REMOVAL_TBL: [],\n        X_ASSET_NUMBER_TBL: [],\n        X_RET_INTERFACE_ID_TBL: [],\n        X_POSTING_STATUS_TBL: [],\n        X_ASSET_DESCRIPTION_TBL: [],\n        X_PROCEEDS_OF_SALE_TBL: [],\n        X_DATE_RETIRED_TBL: [],\n        X_RET_CONV_TBL: [],\n        X_TRANSACTION_NAME_TBL: [],\n        X_RETIREMENT_REASON_TBL: [],\n        X_RET_CONV_CODE_TBL: [],\n        X_COST_RET_TBL: [],\n        X_ASSET_ID_TBL: [],\n        X_TAG_NUMBER_TBL: [],\n        X_SERIAL_NUMBER_TBL: []\n      };\n    }\n\n    var group = groupedByBook[bookTypeCode];\n\n    if (!group.CurrencyCode && currencyCode) {\n      group.CurrencyCode = currencyCode;\n    }\n\n    /* -----------------------------\n       Prevent Duplicate Assets\n    ----------------------------- */\n    var uniqueKey =\n      assetInfo.assetId !== undefined &&\n      assetInfo.assetId !== null &&\n      String(assetInfo.assetId).trim() !== \"\"\n        ? String(assetInfo.assetId).trim()\n        : assetInfo.assetNumber !== undefined &&\n          assetInfo.assetNumber !== null &&\n          String(assetInfo.assetNumber).trim() !== \"\"\n        ? String(assetInfo.assetNumber).trim()\n        : parameter;\n\n    if (group.seenAssets[uniqueKey]) {\n      continue;\n    }\n\n    group.seenAssets[uniqueKey] = true;\n\n    /* -----------------------------\n       Prepare Output Values\n    ----------------------------- */\n    var assetNumberOut =\n      assetInfo.assetNumber !== undefined &&\n      assetInfo.assetNumber !== null\n        ? String(assetInfo.assetNumber).trim()\n        : parameter;\n\n    var descriptionOut =\n      assetInfo.description !== undefined &&\n      assetInfo.description !== null\n        ? String(assetInfo.description).trim()\n        : \"\";\n\n    var assetIdOut =\n      assetInfo.assetId !== undefined &&\n      assetInfo.assetId !== null\n        ? String(assetInfo.assetId).trim()\n        : \"\";\n\n    var costOut =\n      row.costRetired !== undefined &&\n      row.costRetired !== null &&\n      String(row.costRetired).trim() !== \"\"\n        ? String(row.costRetired).trim()\n        : assetInfo.cost !== undefined &&\n          assetInfo.cost !== null &&\n          String(assetInfo.cost).trim() !== \"\"\n        ? String(assetInfo.cost).trim()\n        : \"\";\n\n    var retirementReasonOut =\n      row.retirementReason !== undefined &&\n      row.retirementReason !== null\n        ? String(row.retirementReason).trim()\n        : \"\";\n\n    var retirementDateOut =\n      row.retirementDate !== undefined &&\n      row.retirementDate !== null\n        ? String(row.retirementDate).trim()\n        : \"\";\n\n    /* -----------------------------\n       Populate Arrays\n    ----------------------------- */\n    group.X_BOOK_TYPE_CODE_TBL.push(bookTypeCode);\n    group.X_CURRENCY_CODE_TBL.push(currencyCode);\n    group.X_RETIREMENT_TYPE_CODE_TBL.push(retirementReasonOut);\n    group.X_COST_OF_REMOVAL_TBL.push(\"0.00\");\n    group.X_ASSET_NUMBER_TBL.push(assetNumberOut);\n    group.X_RET_INTERFACE_ID_TBL.push(\"\");\n    group.X_POSTING_STATUS_TBL.push(\"AGENT_NEW\");\n    group.X_ASSET_DESCRIPTION_TBL.push(descriptionOut);\n    group.X_PROCEEDS_OF_SALE_TBL.push(\"0.00\");\n    group.X_DATE_RETIRED_TBL.push(retirementDateOut);\n    group.X_RET_CONV_TBL.push(\"\");\n    group.X_TRANSACTION_NAME_TBL.push(\n      \"\"\n    );\n    group.X_RETIREMENT_REASON_TBL.push(retirementReasonOut);\n    group.X_RET_CONV_CODE_TBL.push(\"\");\n    group.X_COST_RET_TBL.push(costOut);\n    group.X_ASSET_ID_TBL.push(assetIdOut);\n    group.X_TAG_NUMBER_TBL.push(assetInfo.TagNumber || \"\");\n    group.X_SERIAL_NUMBER_TBL.push(\n      assetInfo.serialNumber || \"\"\n    );\n  }\n}\n\n/* -----------------------------\n   Build Final Output\n----------------------------- */\nfor (var bookCode in groupedByBook) {\n  if (\n    !Object.prototype.hasOwnProperty.call(\n      groupedByBook,\n      bookCode\n    )\n  ) {\n    continue;\n  }\n\n  var g = groupedByBook[bookCode];\n\n  assetRetirements.push({\n    BookTypeCode: bookCode,\n    CurrencyCode: g.CurrencyCode || \"\",\n\n    ParameterList: {\n      X_BOOK_TYPE_CODE_TBL:\n        g.X_BOOK_TYPE_CODE_TBL.join(\",\"),\n\n      X_CURRENCY_CODE_TBL:\n        g.X_CURRENCY_CODE_TBL.join(\",\"),\n\n      X_FEEDER_SYSTEM_NAME_TBL: \"\",\n\n      X_RETIREMENT_TYPE_CODE_TBL:\n        g.X_RETIREMENT_TYPE_CODE_TBL.join(\",\"),\n\n      X_RETURN_STATUS: \"S\",\n\n      X_COST_OF_REMOVAL_TBL:\n        g.X_COST_OF_REMOVAL_TBL.join(\",\"),\n\n      X_ASSET_NUMBER_TBL:\n        g.X_ASSET_NUMBER_TBL.join(\",\"),\n\n      X_RET_INTERFACE_ID_TBL:\n        g.X_RET_INTERFACE_ID_TBL.join(\",\"),\n\n      X_POSTING_STATUS_TBL:\n        g.X_POSTING_STATUS_TBL.join(\",\"),\n\n      X_ASSET_DESCRIPTION_TBL:\n        g.X_ASSET_DESCRIPTION_TBL.join(\",\"),\n\n      X_PROCEEDS_OF_SALE_TBL:\n        g.X_PROCEEDS_OF_SALE_TBL.join(\",\"),\n\n      X_DATE_RETIRED_TBL:\n        g.X_DATE_RETIRED_TBL.join(\",\"),\n\n      X_RET_CONV_TBL:\n        g.X_RET_CONV_TBL.join(\",\"),\n\n      X_TRANSACTION_NAME_TBL:\n        g.X_TRANSACTION_NAME_TBL.join(\",\"),\n\n      X_RETIREMENT_REASON_TBL:\n        g.X_RETIREMENT_REASON_TBL.join(\",\"),\n\n      X_RET_CONV_CODE_TBL:\n        g.X_RET_CONV_CODE_TBL.join(\",\"),\n\n      X_COST_RET_TBL:\n        g.X_COST_RET_TBL.join(\",\"),\n\n      X_ASSET_ID_TBL:\n        g.X_ASSET_ID_TBL.join(\",\"),\n\n      X_TAG_NUMBER_TBL:\n        g.X_TAG_NUMBER_TBL.join(\",\"),\n\n      X_SERIAL_NUMBER_TBL:\n        g.X_SERIAL_NUMBER_TBL.join(\",\")\n    }\n  });\n}\n\n/* -----------------------------\n   Final Result\n----------------------------- */\nvar result = {\n  assetRetirements: assetRetirements\n};\n\nreturn result;"
          },
