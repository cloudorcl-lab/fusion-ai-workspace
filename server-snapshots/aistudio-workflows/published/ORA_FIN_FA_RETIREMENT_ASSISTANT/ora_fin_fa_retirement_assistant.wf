          "code": "PARSEDEFAULTRETIREMENTCONVENTION",
          "id": "1777543977557",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Build Draft Txns",
            "returnType": "object",
            "sourceCode": "var draftTx = $context.$nodes.FORMATINGRETIREMENTTRANSACTION.$output.result;\nvar retirementReasonResp = $context.$nodes.PARSERETIREMENTREASONLIST.$output.result;\nvar retirementConventionResp = $context.$nodes.PARSERETIREMENTCONVENTIONLIST.$output.result;\nvar defaultRetirementConventionCode = $context.$nodes.PARSEDEFAULTRETIREMENTCONVENTION.$output.result;\n\nvar draftTxRows = [];\n\nif (draftTx && Array.isArray(draftTx.result)) {\n  draftTxRows = draftTx.result;\n} else if (Array.isArray(draftTx)) {\n  draftTxRows = draftTx;\n}\n\nvar reasonLookup = {};\nvar reasonCodeLookup = {};\nfunction reasonMapKey(book, value) { return String(book || \"\").trim().toUpperCase() + \"||\" + String(value || \"\").trim(); }\nfunction addReasonLookup(book, value, code) {\n  value = String(value || \"\").trim();\n  code = String(code || \"\").trim();\n  if (!value || !code) return;\n  reasonCodeLookup[reasonMapKey(book, value)] = code;\n  reasonCodeLookup[reasonMapKey(\"*\", value)] = code;\n}\nvar reasonList = retirementReasonResp && retirementReasonResp.retirementReasonList\n  ? retirementReasonResp.retirementReasonList\n  : [];\n\nfor (var r = 0; r < reasonList.length; r++) {\n  var book = reasonList[r];\n  var bookCode = String(book.bookTypeCode || \"\").trim();\n  var reasons = book.retirementReason || [];\n\n  for (var j = 0; j < reasons.length; j++) {\n    var reasonCode = String(reasons[j].retirementReasonCode || \"\").trim();\n    var reasonMeaning = reasons[j].retirementReasonMeaning || \"\";\n\n    if (bookCode && reasonCode) {\n      reasonLookup[bookCode + \"||\" + reasonCode] = reasonMeaning;\n      reasonLookup[bookCode.toUpperCase() + \"||\" + reasonCode] = reasonMeaning;\n      addReasonLookup(bookCode, reasonCode, reasonCode);\n      addReasonLookup(bookCode, reasonMeaning, reasonCode);\n    }\n  }\n}\n\nvar conventionLookup = {};\nvar conventionList = retirementConventionResp && retirementConventionResp.retirementConvention\n  ? retirementConventionResp.retirementConvention\n  : [];\n\nfor (var c = 0; c < conventionList.length; c++) {\n  var convCode = String(conventionList[c].retirementConventionCode || \"\").trim();\n  var convId = conventionList[c].retirementConventionId;\n\n  if (convCode !== \"\") {\n    conventionLookup[convCode] = convId;\n  }\n}\n\nvar defaultConventionByAsset = {};\nvar defaultConventionByBookAndAsset = {};\nvar defaultConventionList = [];\nvar defaultConventionSource = defaultRetirementConventionCode;\n\nif (typeof defaultConventionSource === \"string\") {\n  try {\n    defaultConventionSource = JSON.parse(defaultConventionSource);\n  } catch (e) {\n    defaultConventionSource = null;\n  }\n}\n\nif (\n  defaultConventionSource &&\n  defaultConventionSource.result &&\n  Array.isArray(defaultConventionSource.result.result)\n) {\n  defaultConventionList = defaultConventionSource.result.result;\n} else if (defaultConventionSource && Array.isArray(defaultConventionSource.result)) {\n  defaultConventionList = defaultConventionSource.result;\n} else if (Array.isArray(defaultConventionSource)) {\n  defaultConventionList = defaultConventionSource;\n}\n\nfor (var d = 0; d < defaultConventionList.length; d++) {\n  var defaultConventionRow = defaultConventionList[d];\n\n  var defaultConvention = defaultConventionRow && defaultConventionRow.defaultConvention\n    ? defaultConventionRow.defaultConvention\n    : defaultConventionRow;\n\n  if (defaultConvention) {\n    var defaultBookTypeCode = String(defaultConvention.bookTypeCode || \"\").trim();\n    var defaultAssetId = String(defaultConvention.assetId || \"\").trim();\n\n    if (defaultAssetId) {\n      defaultConventionByAsset[defaultAssetId] = defaultConvention;\n\n      if (defaultBookTypeCode) {\n        defaultConventionByBookAndAsset[defaultBookTypeCode + \"||\" + defaultAssetId] = defaultConvention;\n      }\n    }\n  }\n}\n\nfor (var tx = 0; tx < draftTxRows.length; tx++) {\n  var items = draftTxRows[tx] && draftTxRows[tx].items ? draftTxRows[tx].items : [];\n\n  for (var it = 0; it < items.length; it++) {\n    var item = items[it];\n    var params = item ? item.ParameterList : null;\n\n    if (params) {\n      var rowCount = 0;\n      var keys = Object.keys(params);\n\n      for (var k = 0; k < keys.length; k++) {\n        var val = params[keys[k]];\n        if (Array.isArray(val) && val.length > rowCount) {\n          rowCount = val.length;\n        }\n      }\n\n      if (!Array.isArray(params.X_RETIREMENT_TYPE_CODE_TBL)) {\n        params.X_RETIREMENT_TYPE_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RETIREMENT_REASON_TBL)) {\n        params.X_RETIREMENT_REASON_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RET_CONV_TBL)) {\n        params.X_RET_CONV_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_RET_CONV_CODE_TBL)) {\n        params.X_RET_CONV_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_BOOK_TYPE_CODE_TBL)) {\n        params.X_BOOK_TYPE_CODE_TBL = Array(rowCount).fill(\"\");\n      }\n\n      if (!Array.isArray(params.X_ASSET_ID_TBL)) {\n        params.X_ASSET_ID_TBL = Array(rowCount).fill(\"\");\n      }\n\n      for (var i = 0; i < rowCount; i++) {\n        var bookTypeCode = String(params.X_BOOK_TYPE_CODE_TBL[i] || \"\").trim();\n        var retirementTypeCode = String(params.X_RETIREMENT_TYPE_CODE_TBL[i] || \"\").trim();\n        var retirementReasonDisplay = String(params.X_RETIREMENT_REASON_TBL[i] || \"\").trim();\n        var retirementConvCode = String(params.X_RET_CONV_TBL[i] || \"\").trim();\n        var assetId = String(params.X_ASSET_ID_TBL[i] || \"\").trim();\n\n        if (!retirementTypeCode && retirementReasonDisplay) {\n          var mappedReasonCode = reasonCodeLookup[reasonMapKey(bookTypeCode, retirementReasonDisplay)] || reasonCodeLookup[reasonMapKey(\"*\", retirementReasonDisplay)] || \"\";\n          if (mappedReasonCode) {\n            retirementTypeCode = mappedReasonCode;\n            params.X_RETIREMENT_TYPE_CODE_TBL[i] = mappedReasonCode;\n          }\n        }\n\n        if (bookTypeCode && retirementTypeCode) {\n          var mappedReasonMeaning = reasonLookup[bookTypeCode + \"||\" + retirementTypeCode] || reasonLookup[String(bookTypeCode).trim().toUpperCase() + \"||\" + retirementTypeCode] || \"\";\n          if (mappedReasonMeaning) {\n            params.X_RETIREMENT_REASON_TBL[i] = mappedReasonMeaning;\n          } else if (!retirementReasonDisplay) {\n            params.X_RETIREMENT_REASON_TBL[i] = retirementTypeCode;\n          }\n        }\n\n        var defaultConventionForAsset = null;\n\n        if (bookTypeCode && assetId) {\n          defaultConventionForAsset =\n            defaultConventionByBookAndAsset[bookTypeCode + \"||\" + assetId];\n        }\n\n        if (!defaultConventionForAsset && assetId) {\n          defaultConventionForAsset = defaultConventionByAsset[assetId];\n        }\n\n        if (defaultConventionForAsset) {\n          var defaultConventionCode = String(defaultConventionForAsset.conventionCode || \"\").trim();\n          var defaultConventionId = defaultConventionForAsset.conventionId;\n\n          params.X_RET_CONV_TBL[i] = defaultConventionCode;\n          params.X_RET_CONV_CODE_TBL[i] =\n            defaultConventionId !== undefined && defaultConventionId !== null\n              ? defaultConventionId\n              : conventionLookup[defaultConventionCode] !== undefined\n                ? conventionLookup[defaultConventionCode]\n                : \"\";\n        } else if (retirementConvCode) {\n          params.X_RET_CONV_CODE_TBL[i] =\n            conventionLookup[retirementConvCode] !== undefined\n              ? conventionLookup[retirementConvCode]\n              : \"\";\n        }\n      }\n    }\n  }\n}\n\nreturn draftTx;"
          },
          "outcomes": {
            "success": "1774285815030"
          },
          "code": "RETIREMENTTRANSACTIONS",
          "id": "1774533197058",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Read Txn Edit"
          },
          "outcomes": {
            "success": "1774531393699"
          },
          "code": "CHANGEUPDATES",
          "id": "1774285815030",
          "inputs": [
            {
              "id": "1774285815032_1",
              "name": "prompt",
              "type": "string",
              "value": "========================\nINPUT\n========================\nUser message:\n{{$context.$system.$inputMessage}}\n\nActive stage:\n{{$context.$variables.retirementConversationStage}}\n\n========================\nGUARDRAIL\n========================\nIf Active stage is not TRANSACTION_REVIEW, or the user message is empty, or the user only approves/proceeds/cancels, return exactly:\n{\"action\":\"UNKNOWN\"}\n\n========================\nGOAL\n========================\nConvert the user message into structured intent JSON for the currently displayed retirement transactions.\n\nUnsupported update guard:\n- If the user tries to update/change/set/fix Asset Number, Tag Number, Serial Number, Book, Asset Book, Description, or Asset Description, return exactly {\"action\":\"UNKNOWN\"}.\n- These fields are protected asset identity/reference fields and must not be mapped to comments.\n- The words \"for Asset Number <value>\" are criteria only and are allowed.\n\nSupported actions:- DEFER: remove matching transactions from processing.\n- UPDATE: update matching transactions. UPDATE requires explicit target criteria: assetNumber, rowNumbers, or applyToAll=true when the user says all assets/all rows.\n- FILTER: keep only matching transactions for review or processing.\n- UNKNOWN: unclear or invalid change request.\n\nIntent priority:\n1. If the message says only, show only, return only, or filter, use FILTER.\n2. Else if it says defer, hold, remove, exclude, skip, or stop with explicit criteria, use DEFER.\n3. Else if it says update, change, set, modify, correct, fix, revise, or adjust with asset number, row number, all assets/all rows, and update values, use UPDATE.\n4. Otherwise UNKNOWN.\n\nCriteria fields:\n- Asset Number -> assetNumber array.\n- Asset Number exceptions -> assetNumberExcept array.\n- Book -> book array.\n- Retirement Date -> dateRetired.\n- Retirement Reason -> retirementReason array. Values may be either reason code or displayed reason meaning.\n- Retirement Convention -> retirementConvention array. Values may be convention code, displayed convention text, or convention id when the user provides it.\n- Cost Retired -> costRetired.\n- Row Number -> rowNumbers array. Row numbers are the rows currently displayed in the transaction review table.\n- All assets, every asset, each asset, or all rows -> applyToAll true. This means all rows currently displayed in the transaction review table, not all assets in the database.\n\nUpdate fields:\n- costRetired\n- dateRetired as YYYY-MM-DD\n- retirementReason\n- retirementConvention\n- proceedsofSale (for user phrases Proceeds of Sale, Sale Proceeds, Proceed of Sale)\n- costofRemoval (for user phrases Cost of Removal, Removal Cost)\n- comments (maps to transactionName; comments must not be used as a fallback for protected fields like Tag Number, Serial Number, Book, Description, or Asset Number)\n\nRules:\n- For UPDATE, include criteria.assetNumber whenever the user identifies a specific asset.\n- If the user says Row 2, Row Number 2, or rows 2 and 3, include criteria.rowNumbers.\n- If the user says all assets, every asset, each asset, or all rows, include criteria.applyToAll=true and do not invent asset numbers.\n- For comments updates, return only the comment value. Do not include the words \"Update\", \"Comments\", \"Comment\", \"to\", \"as\", or \"for Asset Number\" in updates.comments.\n- Example: \"Update Comments to Agent for Asset Number ASSET 003\" must return updates.comments = \"Agent\".\n- Example: \"Set Comments as Retired after sale for Asset Number 107586\" must return updates.comments = \"Retired after sale\".\n- Preserve asset numbers, reason codes, convention codes, and comments exactly as the user typed them.\n- Use dateRetired for retirement date.\n- Use comments for user comments or transaction comments.\n- Use retirementConvention for retirement convention updates.\n- Use retirementReason for retirement reason updates.\n- Use proceedsofSale for Proceeds of Sale updates.\n- Use costofRemoval for Cost of Removal updates.\n\nCost conditions: greater than >, less than <, equal =, at least >=, at most <=, between X and Y as {\"operator\":\"between\",\"value\":[X,Y]}.\nDate conditions: use YYYY-MM-DD; month/year-only ranges should become between start and end dates.\n\nReturn ONLY valid JSON matching one of these shapes:\n{\"action\":\"DEFER\",\"criteria\":{}}\n{\"action\":\"UPDATE\",\"criteria\":{\"assetNumber\":[],\"rowNumbers\":[],\"applyToAll\":false},\"updates\":{}}\n{\"action\":\"FILTER\",\"criteria\":{}}\n{\"action\":\"UNKNOWN\"}"
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"action\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"DEFER\",\n        \"UPDATE\",\n        \"FILTER\",\n        \"UNKNOWN\"\n      ]\n    },\n    \"criteria\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"assetNumber\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"book\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"retirementReason\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"retirementConvention\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"costRetired\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"operator\": {\n              \"type\": \"string\",\n              \"enum\": [\n                \">\",\n                \"<\",\n                \"=\",\n                \">=\",\n                \"<=\",\n                \"between\"\n              ]\n            },\n            \"value\": {\n              \"oneOf\": [\n                {\n                  \"type\": \"number\"\n                },\n                {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"type\": \"number\"\n                  },\n                  \"minItems\": 2,\n                  \"maxItems\": 2\n                }\n              ]\n            }\n          },\n          \"required\": [\n            \"operator\",\n            \"value\"\n          ]\n        },\n        \"dateRetired\": {\n          \"oneOf\": [\n            {\n              \"type\": \"string\",\n              \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"\n            },\n            {\n              \"type\": \"object\",\n              \"properties\": {\n                \"operator\": {\n                  \"type\": \"string\",\n                  \"enum\": [\n                    \">\",\n                    \"<\",\n                    \">=\",\n                    \"<=\",\n                    \"between\"\n                  ]\n                },\n                \"value\": {\n                  \"oneOf\": [\n                    {\n                      \"type\": \"string\",\n                      \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"\n                    },\n                    {\n                      \"type\": \"array\",\n                      \"items\": {\n                        \"type\": \"string\",\n                        \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"\n                      },\n                      \"minItems\": 2,\n                      \"maxItems\": 2\n                    }\n                  ]\n                }\n              },\n              \"required\": [\n                \"operator\",\n                \"value\"\n              ]\n            }\n          ]\n        },\n        \"assetNumberExcept\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"string\"\n          }\n        },\n        \"rowNumbers\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"integer\",\n            \"minimum\": 1\n          }\n        },\n        \"applyToAll\": {\n          \"type\": \"boolean\"\n        }\n      },\n      \"additionalProperties\": false\n    },\n    \"updates\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"dateRetired\": {\n          \"type\": \"string\",\n          \"pattern\": \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"\n        },\n        \"costRetired\": {\n          \"type\": \"number\"\n        },\n        \"retirementReason\": {\n          \"type\": \"string\"\n        },\n        \"retirementConvention\": {\n          \"type\": \"string\"\n        },\n        \"proceedsofSale\": {\n          \"type\": \"number\"\n        },\n        \"costofRemoval\": {\n          \"type\": \"number\"\n        },\n        \"comments\": {\n          \"type\": \"string\"\n        }\n      },\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\n    \"action\"\n  ],\n  \"additionalProperties\": false\n}",
