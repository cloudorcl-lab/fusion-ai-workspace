        {
          "metadata": {
            "name": "Get Books",
            "returnType": "array",
            "sourceCode": "var draftTx = $context.$nodes.FORMATINGRETIREMENTTRANSACTION.$output.result || [];\n\nvar seen = {};\nvar assetBookList = [];\n\nfor (var i = 0; i < draftTx.length; i++) {\n  var group = draftTx[i];\n  var items = group && group.items ? group.items : [];\n\n  for (var j = 0; j < items.length; j++) {\n    var params = items[j] && items[j].ParameterList ? items[j].ParameterList : null;\n\n    if (params && Array.isArray(params.X_BOOK_TYPE_CODE_TBL)) {\n      for (var k = 0; k < params.X_BOOK_TYPE_CODE_TBL.length; k++) {\n        var code = params.X_BOOK_TYPE_CODE_TBL[k];\n        var key = String(code || \"\").trim();\n\n        if (key && !seen[key]) {\n          seen[key] = true;\n          assetBookList.push({\n            BookTypeCode: code\n          });\n        }\n      }\n    }\n  }\n}\n\nreturn {\n  assetBookList: assetBookList\n};"
          },
          "outcomes": {
            "success": "1778072417084"
          },
          "code": "EXTRACTUNIQUEASSETBOOKS",
          "id": "1775753932619",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
