          },
          "code": "ROUTEBASEDONINTENT",
          "convergenceTargetId": "end",
          "id": "1771838992651",
          "inputs": [
            {
              "id": "1771838992655_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$variables.userIntent}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "Build Help",
            "returnType": "string",
            "sourceCode": "let retirementHtml = `<div style=\"background:#f9fafb; padding-left:12px;\">\n\n&nbsp;\n<div style=\"font-size:14px; line-height:1.5; color:#111827;\">\n\n  <div style=\"font-size:16px; font-weight:600; margin-bottom:6px;\">\n    Retirement Assistant\n  </div>\n\n  <div style=\"margin-bottom:12px; color:#4b5563;\">\n    Use this assistant to retire assets, review retirement requests, review exception transactions, update retirement details, and post retirement transactions through conversation.\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:4px;\">Before you start</div>\n\n  <div style=\"margin-bottom:12px; color:#374151;\">\n    For the best user experience, manually resize the assistant window to full screen.\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px;\">\n    Find books you can access\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    To see which asset books you have access to in this assistant, use this command:\n  </div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"show me the books I have access to\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px;\">How to use this agent</div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    1. Retire Assets\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    Provide the asset number, tag number, or serial number.\n  </div>\n\n  <div style=\"margin-bottom:4px;\">Examples</div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Retire Assets with Asset Number &lt;asset number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Retire Assets with Tag Number &lt;tag number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Retire Assets with Serial Number &lt;serial number&gt;\"\n  </div>\n\n  <div style=\"margin-bottom:12px; color:#374151;\">\n    You can also paste an email or table containing Asset Number, Book, Retirement Reason, and Retirement Date.\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    Review the selected assets. You can also add more assets or remove assets.\n  </div>\n\n  <div style=\"margin-bottom:4px;\">Examples</div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Add Asset with Asset Number &lt;asset number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Add Asset with Tag Number &lt;tag number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Add Asset with Serial Number &lt;serial number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Remove Asset with Asset Number &lt;asset number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Remove Row &lt;row number&gt;\"\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    You can update transaction details such as Retirement Date, Retirement Reason, Retirement Convention, Cost Retired, Proceeds of Sale, Cost of Removal, and Comments.\n  </div>\n\n  <div style=\"margin-bottom:4px;\">Examples</div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Retirement Date to &lt;Date&gt; for Asset Number &lt;asset number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Retirement Date to &lt;Date&gt; for Row &lt;row number&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Retirement Reason to &lt;Reason&gt; for all assets\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Retirement Reason to &lt;Reason&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Retirement Convention to &lt;Convention&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Cost Retired to &lt;Cost&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Proceeds of Sale to &lt;Amount&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Cost of Removal to &lt;Amount&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Update Comments to &lt;Comments&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Defer Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    2. Show Retirement Requests\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    You can review and approve asset retirement requests from the Retirement Request Assistant. You can also update the details if needed.\n  </div>\n\n  <div style=\"margin-bottom:4px;\">Example</div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Update Retirement Reason to &lt;Reason&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    3. Review Exception Transactions\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    You can review exception transactions and update the details as required.\n  </div>\n\n  <div style=\"margin-bottom:4px;\">Example</div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Update Retirement Date to &lt;Date&gt; for Asset Number &lt;AssetNumber&gt;\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    4. Find List of Values\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    You can use the commands below to find list of values for Retirement Reason and Retirement Convention.\n  </div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Show Retirement Reasons\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Show Retirement Reasons for Book &lt;Book&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Show Retirement Conventions\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"Show Retirement Conventions for Book &lt;Book&gt;\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:6px;\">\n    \"What retirement reason can I use for Asset Number &lt;AssetNumber&gt;?\"\n  </div>\n\n  <br>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"What retirement convention can I use for Asset Number &lt;AssetNumber&gt;?\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    5. Current Retirement Transaction\n  </div>\n\n  <div style=\"margin-bottom:6px; color:#374151;\">\n    To return to the current Retirement Transaction, use this command:\n  </div>\n\n  <div style=\"font-size:12px; border:1px solid #d1d5db; background:#f9fafb; padding:4px 6px; border-radius:4px; display:inline-block; margin-bottom:12px;\">\n    \"Show Retirement Details\"\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    6. Fields That Cannot Be Updated\n  </div>\n\n  <div style=\"margin-bottom:12px; color:#374151;\">\n    Asset Number, Tag Number, Serial Number, Book, and Description cannot be changed in the retirement review. They are asset identity and reference fields.\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px; color:#111827;\">\n    7. After Posting\n  </div>\n\n  <div style=\"margin-bottom:12px; color:#374151;\">\n    The previous review table is closed. To continue, start a new retirement request or use Show Retirement Requests / Show Exception Transactions.\n  </div>\n\n  <div style=\"font-weight:600; margin-bottom:6px;\">\n    Functionality Supported\n  </div>\n\n  <ul style=\"margin-top:4px; margin-bottom:10px; padding-left:20px; color:#374151;\">\n    <li>Retire assets in the books to which access is available</li>\n    <li>Review and approve retirement requests from the Retirement Request Assistant</li>\n    <li>Review exception transactions</li>\n  </ul>\n\n  <div style=\"font-weight:600; margin-bottom:6px;\">\n    Functionality Not Supported\n  </div>\n\n  <ul style=\"margin-top:4px; margin-bottom:10px; padding-left:20px; color:#374151;\">\n    <li>Partial cost retirement is not allowed</li>\n    <li>Unit retirement, source line retirement, and reinstatement are not allowed</li>\n    <li>The assistant does not support displaying alternate ledger currencies</li>\n    <li>No workflow approvals are triggered when retirement transactions are processed through this assistant, even if the asset book is enabled for Retirement Approvals. This behavior applies to both retirements created directly within the assistant and retirements originating from the Retirement Request Assistant</li>\n    <li>Entry of Descriptive Flexfield (DFF) details is not supported when performing retirements through this assistant</li>\n    <li>Retire up to ten assets in a single interaction. Create additional interactions if you have more than ten assets to retire</li>\n    <li>Non-English natural language conversations are not supported</li>\n  </ul>\n\n  <br>&nbsp;\n</div>\n</div>`;\n\nreturn retirementHtml;"
          },
          "outcomes": {
            "success": "1771840446016"
          },
          "code": "HELP_USER",
          "convergenceTargetId": "1771840385904",
          "id": "1769877192456",
          "inputs": [],
          "outputSpecification": "{\"$schema\":\"http://json-schema.org/draft-04/schema#\",\"type\":\"object\",\"properties\":{\"result\":{\"type\":\"string\"},\"timeout\":{\"type\":\"boolean\"},\"error\":{\"type\":\"string\"}},\"required\":[\"output\",\"timeout\",\"error\"]}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Show Help"
          },
          "outcomes": {},
          "code": "SHOWHELPRESPONSE",
          "convergenceTargetId": "end",
          "id": "1771840446016",
          "inputs": [
            {
              "id": "1771840446016_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.HELP_USER.$output.result}}"
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Ask Asset Details"
          },
          "outcomes": {},
          "code": "RETIREASSETSMESSAGE",
          "convergenceTargetId": "end",
          "id": "1776469519119",
          "inputs": [
            {
              "id": "1776469519119_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "Please provide the assets you would like to retire. You can upload a CSV file or enter details in free text using Asset Number, Serial Number, or Tag Number."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Show Out Of Scope"
          },
          "outcomes": {},
          "code": "OUT_OFSCOPEMESSAGE",
          "convergenceTargetId": "end",
          "id": "1778255528169",
          "inputs": [
            {
              "id": "1778255528169_returnValue",
              "name": "returnValue",
              "type": "string",
              "value": "This request is beyond my scope. Supported capabilities are: retire assets, show retirement requests, show exception transactions, show book access, update retirement review attributes, proceed, cancel, and ask questions about the current retirement context.\n\nTo return to the current Retirement Transaction, type Show Retirement Details."
            }
          ],
          "type": "RETURN"
        },
        {
          "metadata": {
            "name": "Build Context Lookup Response",
            "returnType": "string",
            "sourceCode": "function text(v) { return v === null || v === undefined ? \"\" : String(v); }\nfunction parseAny(v) {\n  if (typeof v !== \"string\") return v || {};\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction esc(v) {\n  return text(v)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#39;\");\n}\nfunction uniquePush(arr, val) {\n  val = text(val).trim();\n  if (!val) return;\n  for (var i = 0; i < arr.length; i++) {\n    if (arr[i] === val) return;\n  }\n  arr.push(val);\n}\nfunction normalizeBook(v) { return text(v).trim(); }\nfunction key(v) { return text(v).trim().toUpperCase(); }\nfunction extractAssetNumber(message) {\n  var m = text(message).match(/\\basset\\s*number\\b\\s*(?:is|=|:)?\\s+([A-Za-z0-9][A-Za-z0-9_.\\-\\/]*(?:\\s+[A-Za-z0-9][A-Za-z0-9_.\\-\\/]*){0,3})/i);\n  return m && m[1] ? m[1].replace(/[.,;]+$/g, \"\").trim() : \"\";\n}\nfunction extractBook(message) {\n  var m = text(message).match(/\\b(?:for\\s+)?book\\b\\s*(?:is|=|:)?\\s+([A-Za-z0-9][A-Za-z0-9 _\\-\\/]*(?=\\s+(?:and|with|for|asset\\s*number)\\b|[.,;]|$))/i);\n  return m && m[1] ? m[1].replace(/[.,;]+$/g, \"\").trim() : \"\";\n}\nfunction allRowsFromState(state) {\n  var rows = [];\n  rows = rows.concat(asArray(state.activeAssets));\n  rows = rows.concat(asArray(state.draftTransactions));\n  rows = rows.concat(asArray(state.postResults));\n  return rows;\n}\nfunction bookForAsset(state, assetNumber) {\n  var rows = allRowsFromState(state);\n  var needle = key(assetNumber);\n  for (var i = 0; i < rows.length; i++) {\n    var r = rows[i] || {};\n    if (key(r.assetNumber || r.AssetNumber) === needle) return normalizeBook(r.bookTypeCode || r.bookName || r.BookTypeCode || r.Book);\n  }\n  return \"\";\n}\nfunction activeBooks(state) {\n  var out = [];\n  var rows = allRowsFromState(state);\n  for (var i = 0; i < rows.length; i++) {\n    var r = rows[i] || {};\n    var b = normalizeBook(r.bookTypeCode || r.bookName || r.BookTypeCode || r.Book);\n    uniquePush(out, b);\n  }\n  return out;\n}\nfunction filterBooksFromMessage(state, message) {\n  var books = [];\n  var explicitBook = extractBook(message);\n  if (explicitBook) uniquePush(books, explicitBook);\n  var asset = extractAssetNumber(message);\n  if (asset) uniquePush(books, bookForAsset(state, asset));\n  return books;\n}\nfunction acceptsBook(book, filters) {\n  if (!filters || filters.length === 0) return true;\n  if (!book) return false;\n  for (var i = 0; i < filters.length; i++) {\n    if (key(book) === key(filters[i])) return true;\n  }\n  return false;\n}\nfunction addReasonGroups(groups, reasons, filters) {\n  reasons = asArray(reasons);\n  for (var i = 0; i < reasons.length; i++) {\n    var bookObj = reasons[i] || {};\n    var book = normalizeBook(bookObj.bookTypeCode || bookObj.BookTypeCode || bookObj.bookName || bookObj.Book);\n    if (!acceptsBook(book, filters)) continue;\n    if (!groups[book]) groups[book] = [];\n    var vals = asArray(bookObj.retirementReason || bookObj.retirementReasons || bookObj.reasons);\n    for (var j = 0; j < vals.length; j++) {\n      var row = vals[j] || {};\n      uniquePush(groups[book], row.retirementReasonMeaning || row.meaning || row.description || row.X_MEANING || row.retirementReasonCode || row.code || row.lookupCode || row.X_LOOKUP_CODE);\n    }\n  }\n}\nfunction addConventionGroups(groups, conventions, filters, fallbackBooks) {\n  conventions = asArray(conventions);\n  for (var i = 0; i < conventions.length; i++) {\n    var row = conventions[i] || {};\n    var book = normalizeBook(row.bookTypeCode || row.BookTypeCode || row.bookName || row.Book);\n    if (!book && fallbackBooks.length === 1) book = fallbackBooks[0];\n    if (!acceptsBook(book, filters)) continue;\n    if (!groups[book]) groups[book] = [];\n    uniquePush(groups[book], row.retirementConventionCode || row.conventionCode || row.code || row.X_CONVENTION_TYPE_CODE || row.retirementConvention);\n  }\n}\nfunction table(title, valueHeader, groups) {\n  var books = Object.keys(groups).filter(function(b){ return groups[b] && groups[b].length > 0; }).sort();\n  if (books.length === 0) return \"\";\n  var html = \"\";\n  html += \"<table style='width:100%; max-width:100%; border-collapse:collapse; border:1px solid #e0e0e0; table-layout:fixed;'>\";\n  html += \"<colgroup><col style='width:30%;'><col style='width:70%;'></colgroup>\";\n  html += \"<thead>\";\n  html += \"<tr style='background:#f5f5f5;'><th colspan='2' style='text-align:left; padding:10px; font-size:15px; font-weight:600; border-bottom:1px solid #e0e0e0;'>\" + esc(title) + \"</th></tr>\";\n  html += \"<tr style='background:#f5f5f5;'><th colspan='2' style='text-align:left; padding:8px 10px; font-size:13px; font-weight:normal; color:#4a4a4a; border-bottom:1px solid #e0e0e0;'>These are the available values for the current retirement context.</th></tr>\";\n  html += \"<tr style='background:#f5f5f5;'>\";\n  html += \"<th style='padding:6px 8px; text-align:left;'>Book</th>\";\n  html += \"<th style='padding:6px 8px; text-align:left;'>\" + esc(valueHeader) + \"</th>\";\n  html += \"</tr>\";\n  html += \"</thead><tbody>\";\n  for (var i = 0; i < books.length; i++) {\n    var b = books[i];\n    var bg = (i % 2 === 0) ? \"#ffffff\" : \"#fafafa\";\n    html += \"<tr style='background:\" + bg + \";'>\";\n    html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;'>\" + esc(b || \"-\") + \"</td>\";\n    html += \"<td style='padding:6px 8px; border-bottom:1px solid #e6e6e6; word-break:break-word; white-space:normal;'>\" + esc(groups[b].join(\", \")) + \"</td>\";\n    html += \"</tr>\";\n  }\n  html += \"</tbody></table>\";\n  return html;\n}\nfunction followUp(stage) {\n  return \"<div style='margin-top:8px;'>To return to the current Retirement Transaction, type Show Retirement Details.</div>\";\n}\nfunction lookupResponse(state, message) {\n  var m = text(message);\n  var wantsReason = /\\b(reason|reasons)\\b/i.test(m);\n  var wantsConvention = /\\b(convention|conventions|prorate)\\b/i.test(m);\n  var filters = filterBooksFromMessage(state, m);\n  var books = activeBooks(state);\n  var reasonGroups = {};\n  var conventionGroups = {};\n  if (wantsReason) addReasonGroups(reasonGroups, state.availableRetirementReasons, filters);\n  if (wantsConvention) addConventionGroups(conventionGroups, state.availableRetirementConventions, filters, books);\n  var html = \"<div style='font-family:Segoe UI, Arial, sans-serif; font-size:13px; color:#2f2f2f; width:100%; overflow-x:auto;'>\";\n  var body = \"\";\n  if (wantsReason) body += table(\"Available Retirement Reasons\", \"Available Retirement Reasons\", reasonGroups);\n  if (wantsConvention) body += table(\"Available Retirement Conventions\", \"Available Retirement Conventions\", conventionGroups);\n  if (!body) {\n    var label = wantsReason && wantsConvention ? \"retirement reason and retirement convention values\" : (wantsReason ? \"retirement reason values\" : \"retirement convention values\");\n    var bookText = filters.length > 0 ? \" for \" + filters.join(\", \") : \"\";\n    body += \"<div style='padding:10px; border:1px solid #e0e0e0; background:#ffffff;'>The available \" + esc(label) + esc(bookText) + \" are not loaded yet. Please continue to the transaction review table first to load the valid values.</div>\";\n  }\n  html += body + followUp(text($context.$variables.retirementConversationStage || state.stage)) + \"</div>\";\n  return html;\n}\nfunction currentAssetResponse(state, message) {\n  var asset = extractAssetNumber(message);\n  var rows = allRowsFromState(state);\n  var selected = [];\n  for (var i = 0; i < rows.length; i++) {\n    var r = rows[i] || {};\n    if (!asset || key(r.assetNumber || r.AssetNumber) === key(asset)) selected.push(r);\n  }\n  if (selected.length === 0) return \"No matching retirement asset is currently in context. To return to the current Retirement Transaction, type Show Retirement Details.\";\n  var parts = [];\n  for (var j = 0; j < selected.length; j++) {\n    var a = selected[j] || {};\n    parts.push(\"Asset Number \" + text(a.assetNumber || a.AssetNumber || \"-\") + \", Book \" + text(a.bookTypeCode || a.bookName || a.BookTypeCode || \"-\") + \", Retirement Reason \" + text(a.retirementReason || \"-\") + \", Convention \" + text(a.retirementConvention || \"-\"));\n  }\n  return parts.join(\"; \") + \". To return to the current Retirement Transaction, type Show Retirement Details.\";\n}\nfunction cleanOldReturnCue(value) {\n  var out = text(value);\n  out = out.replace(/To return to the current Retirement Transaction, type:\\s*(?:<span[^>]*>)?Show Retirement Details(?:<\\/span>)?\\.?(?:\\s*You can also say proceed(?: to post)? or describe changes\\.)?/gi, \"To return to the current Retirement Transaction, type Show Retirement Details.\");\n  out = out.replace(/To return to the current Retirement Transaction, type:\\s*Show Retirement Details\\.?/g, \"To return to the current Retirement Transaction, type Show Retirement Details.\");\n  return out;\n}\nvar state = parseAny($context.$variables.conversationRetirementFlowState || {});\nvar message = text($context.$system.$inputMessage);\nif (/\\b(reason|reasons|convention|conventions|prorate)\\b/i.test(message) && /\\b(what|which|show|list|available|valid|values|options|meaning|meanings|allowed|use)\\b/i.test(message)) {\n  return cleanOldReturnCue(lookupResponse(state, message));\n}\nreturn cleanOldReturnCue(currentAssetResponse(state, message));"
          },
          "outcomes": {
            "success": "1891000000000"
          },
