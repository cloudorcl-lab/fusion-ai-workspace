          "code": "OBTAINASSETINFORMATION",
          "id": "1775867765709",
          "inputs": [
            {
              "id": "1775867765712_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACTASSETNUMBERLIST.$output.result.assetNumbersList}}"
