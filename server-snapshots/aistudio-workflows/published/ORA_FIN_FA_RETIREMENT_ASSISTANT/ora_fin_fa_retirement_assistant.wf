                  "code": "CHECKBOOKACCESS_REQ_CHANGE",
                  "id": "1881000000007",
                  "inputs": [
                    {
                      "id": "1881000000007_book",
                      "name": "book",
                      "type": "string",
                      "value": "{{($context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.result && $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.result.assetInfoList && $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.result.assetInfoList[0] && $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.result.assetInfoList[0].bookTypeCode) || ($context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.assetInfoList && $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.assetInfoList[0] && $context.$nodes.OBTAINASSETINFORMATION_REQ_CHANGE.EXTRACTASSETDETAILS_REQ_CHANGE.$output.assetInfoList[0].bookTypeCode) || \"\"}}"
