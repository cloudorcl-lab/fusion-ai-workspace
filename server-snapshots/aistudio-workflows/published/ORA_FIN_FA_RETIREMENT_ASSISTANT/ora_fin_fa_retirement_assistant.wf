            "returnType": "array",
            "sourceCode": "var data = $context.$nodes.FORMATINGRETIREMENTTRANSACTION_NEW_LANE.$output;\n\nvar uniqueCurrencyCodes = [];\nvar exists = {};\n\nif (data && Array.isArray(data.result)) {\n  for (var i = 0; i < data.result.length; i++) {\n    var group = data.result[i] || {};\n    var items = Array.isArray(group.items) ? group.items : [];\n\n    for (var j = 0; j < items.length; j++) {\n      var item = items[j] || {};\n\n      var currencyCode =\n        item.CurrencyCode === null ||\n        item.CurrencyCode === undefined\n          ? \"\"\n          : String(item.CurrencyCode).trim();\n\n      // Skip null / empty values\n      if (!currencyCode) {\n        continue;\n      }\n\n      // Add only unique values\n      if (!exists[currencyCode]) {\n        exists[currencyCode] = true;\n\n        uniqueCurrencyCodes.push({\n          CurrencyCode: currencyCode\n        });\n      }\n    }\n  }\n}\n\nvar output = {\n  uniqueCurrencyCodes: uniqueCurrencyCodes\n};\n\noutput;"
