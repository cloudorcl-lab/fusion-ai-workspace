        {
          "metadata": {
            "name": "Parse Reasons",
            "returnType": "object",
            "sourceCode": "var output = $context.$nodes.OBTAINRETIREMENTREASONLIST.$output;\n\nfunction parseMaybe(v) {\n  if (typeof v !== \"string\") return v;\n  try { return JSON.parse(v); } catch (e1) {\n    try { return JSON.parse(JSON.parse(v)); } catch (e2) { return {}; }\n  }\n}\n\nvar result = { retirementReasonList: [] };\n\nfunction addBook(book) {\n  if (!book) return;\n  if (book.result) { visit(book.result); return; }\n  if (Array.isArray(book.retirementReasonList)) { visit(book.retirementReasonList); return; }\n  if (Array.isArray(book.retirementReason)) {\n    result.retirementReasonList.push({\n      bookTypeCode: book.bookTypeCode || book.BookTypeCode || book.bookName || book.Book || \"\",\n      retirementReason: book.retirementReason\n    });\n  }\n}\n\nfunction visit(v) {\n  v = parseMaybe(v);\n  if (!v) return;\n  if (Array.isArray(v)) {\n    for (var i = 0; i < v.length; i++) visit(v[i]);\n    return;\n  }\n  addBook(v);\n}\n\nvisit(output);\n\nif (result.retirementReasonList.length > 0) return result;\nreturn parseMaybe(output);"
          },
          "outcomes": {
            "success": "1775758059804"
          },
          "code": "PARSERETIREMENTREASONLIST",
          "id": "1775757101379",
