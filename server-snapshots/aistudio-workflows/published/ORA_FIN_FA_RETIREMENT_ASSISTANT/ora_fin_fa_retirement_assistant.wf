            "returnType": "object",
            "sourceCode": "var prior = $context.$variables.conversationRetirementFlowState || {};\nif (typeof prior === \"string\") {\n  try { prior = JSON.parse(prior); } catch (e) { prior = {}; }\n}\nfunction asArray(v) { return Array.isArray(v) ? v : []; }\nfunction text(v) { return v === null || v === undefined ? \"\" : String(v); }\nvar postResults = asArray($context.$nodes.POSTTRANSACTIONS.$output);\nvar events = asArray(prior.events).slice(0);\nevents.push({ action: \"posting_complete\", stage: \"POSTING_COMPLETE\", resultCount: postResults.length });\nreturn {\n  schemaVersion: \"1.1\",\n  stage: \"POSTING_COMPLETE\",\n  source: prior.source || \"POSTED_RETIREMENT_TRANSACTIONS\",\n  lastUserMessage: text($context.$system.$inputMessage),\n  activeAssets: asArray(prior.activeAssets),\n  removedAssets: asArray(prior.removedAssets),\n  pendingRequest: {},\n  availableRetirementReasons: asArray(prior.availableRetirementReasons),\n  availableRetirementConventions: asArray(prior.availableRetirementConventions),\n  draftTransactions: [],\n  draftTransactionPayload: [],\n  postResults: postResults,\n  lastReviewHtml: \"\",\n  events: events\n};"
          },
