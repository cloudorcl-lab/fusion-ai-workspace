                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"assetInfoList\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"assetId\": {\n            \"type\": \"string\"\n          },\n          \"bookTypeCode\": {\n            \"type\": \"string\"\n          },\n          \"assetNumber\": {\n            \"type\": \"string\"\n          },\n          \"description\": {\n            \"type\": \"string\"\n          },\n          \"cost\": {\n            \"type\": \"string\"\n          },\n          \"serialNumber\": {\n            \"type\": \"string\"\n          },\n          \"retirementReason\": {\n            \"type\": \"string\"\n          },\n          \"TagNumber\": {\n            \"type\": \"string\"\n          },\n          \"valid\": {\n            \"type\": \"string\"\n          },\n          \"comments\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    }\n  }\n}",
