          "metadata": {
            "name": "Parse Default Conv",
            "returnType": "object",
            "sourceCode": "var output = $context.$nodes.EXTRACTDEFAULTCONVENTION.$output;\n\nvar parsed = output;\n\nif (Array.isArray(output)) {\n  parsed = output.map(function (item) {\n    if (typeof item === \"string\") {\n      return JSON.parse(item);\n    }\n\n    return item;\n  });\n} else if (typeof output === \"string\") {\n  parsed = JSON.parse(output);\n}\n\nreturn parsed;"
