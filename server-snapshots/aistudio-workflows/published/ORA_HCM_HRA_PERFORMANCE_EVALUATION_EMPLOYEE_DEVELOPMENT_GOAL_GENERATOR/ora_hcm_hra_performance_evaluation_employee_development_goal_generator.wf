                      "model": "OCI_GPT_5_MINI",
                      "provider": "CERT_PREMIUM"
                    },
                    "agentCode": "ORA_PARTICIPANT_FEEDBACK_SUMMARY_OF_SUMMARY",
                    "name": "participantFeedbackSummaryOfSummary",
                    "type": "REUSABLE"
