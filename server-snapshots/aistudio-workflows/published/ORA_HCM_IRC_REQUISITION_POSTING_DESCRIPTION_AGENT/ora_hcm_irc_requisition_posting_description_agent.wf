{
  "workflowId": "300000331068669",
  "workflowCode": "ORA_HCM_IRC_REQUISITION_POSTING_DESCRIPTION_AGENT",
  "name": "Recruiting Job Requisition Posting Description Agent",
  "description": "Generates tailored job posting description for a requisition.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
