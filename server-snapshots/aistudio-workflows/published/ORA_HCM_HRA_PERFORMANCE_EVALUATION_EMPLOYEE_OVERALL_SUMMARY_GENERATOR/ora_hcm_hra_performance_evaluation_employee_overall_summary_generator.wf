            "name": "setDataToLocalVariableFromAgent",
            "returnType": "object",
            "sourceCode": "let localObject = $context.$variables.inputDataVariableTeam; \n\nlocalObject.participant_feedback_summary = $context.$nodes.PARTICIPANTFEEDBACKSUMMARYOFSUMMARY?.$output?.participantFeedbackOutput ? $context.$nodes.PARTICIPANTFEEDBACKSUMMARYOFSUMMARY.$output.participantFeedbackOutput : \"\";\nlocalObject.interim_feedback_summary = $context.$nodes.INTERIMFEEDBACKSUMMARYOFSUMMARY?.$output?.interimFeedbackSummary ? $context.$nodes.INTERIMFEEDBACKSUMMARYOFSUMMARY.$output.interimFeedbackSummary : \"\"; \nlocalObject.anytime_feedback_summary = $context.$nodes.ANYTIMEFEEDBACKSUMMARYOFSUMMARY?.$output?.anytimeFeedbackOutput ? $context.$nodes.ANYTIMEFEEDBACKSUMMARYOFSUMMARY.$output.anytimeFeedbackOutput : \"\";\nlocalObject.requested_feedback_summary = $context.$nodes.REQUESTEDFEEDBACKSUMMARYOFSUMMARY?.$output?.requestedFeedbackOutput ? $context.$nodes.REQUESTEDFEEDBACKSUMMARYOFSUMMARY.$output.requestedFeedbackOutput : \"\"; \nlocalObject.employee_checkin_summary = $context.$nodes.EMPLOYEECHECKINSUMMARYOFSUMMARY?.$output?.employeeCheckInDataOutput ? $context.$nodes.EMPLOYEECHECKINSUMMARYOFSUMMARY.$output.employeeCheckInDataOutput : \"\"; \nlocalObject.manager_checkin_summary = $context.$nodes.MANAGERCHECKINSUMMARYOFSUMMARY?.$output?.managerCheckInDataOutput ? $context.$nodes.MANAGERCHECKINSUMMARYOFSUMMARY.$output.managerCheckInDataOutput : \"\";  \n\nreturn localObject;"
          },
