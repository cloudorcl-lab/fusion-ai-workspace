          "metadata": {
            "name": "assignFinalSummaryGenerated",
            "returnType": "object",
            "sourceCode": "let returnObj = {};\n\nconst id = $context.$variables.inputDataVariableTeam.id;\nlet outputSummaryObject = $context.$nodes.OVERALLSUMMARYWORKERSECTIONSUMMARY.$output;\n\n// Wrap the string inside an object before assigning it to the ID\nreturnObj[id] = {\n    \"summary\": outputSummaryObject\n};\n\nreturn returnObj;"
          },
