          },
          "code": "GETATTENDEEFROMEXPENSEID",
          "convergenceTargetId": "1769514840183",
          "id": "1769494888271",
          "inputs": [
            {
              "id": "1769494908349_1",
              "name": "expenseId",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.expenseId}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"Name\": {\n            \"type\": \"string\"\n          },\n          \"AttendeeEmail\": {\n            \"type\": [\"string\", \"null\"]\n          },\n          \"Amount\": {\n            \"type\": \"number\"\n          }\n        },\n        \"required\": [\"Name\", \"Amount\"]\n      }\n    }\n  },\n  \"required\": [\"items\"]\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "updateAttendee ",
            "returnType": "array",
            "sourceCode": "let newAttendees = Array.isArray($context.$nodes.GETATTENDEESBYUSER?.$output?.result)\n    ? [...$context.$nodes.GETATTENDEESBYUSER.$output.result]\n    : [];\n\nlet loggedIn = $context.$nodes.GETLOGGEDINPERSON?.$output?.items?.[0] || {};\nlet existAttendees = Array.isArray($context.$nodes.GETATTENDEEFROMEXPENSEID?.$output?.items)\n    ? [...$context.$nodes.GETATTENDEEFROMEXPENSEID.$output.items]\n    : [];\n\nlet receiptAmount = Number($context.$triggers.REST?.$input?.receiptAmount) || 0;\n\nlet rawPrecision = Number($context.$triggers.REST?.$input?.precision);\nlet precision = Number.isInteger(rawPrecision) && rawPrecision >= 0 ? rawPrecision : 2;\nlet minorUnitFactor = Math.pow(10, precision);\n\nconst norm = v => (v || \"\").toString().trim().toLowerCase();\nconst toMinorUnits = value => Math.round(value * minorUnitFactor);\nconst fromMinorUnits = value => value / minorUnitFactor;\n\nconst attendeeKey = att => {\n    const email = norm(att?.emailAddress || att?.AttendeeEmail);\n    const name = norm(att?.name || att?.Name);\n\n    // Prefer email when present, otherwise fall back to name.\n    return email ? `email:${email}` : name ? `name:${name}` : \"\";\n};\n\nconst isEmployeeAttendee = att =>\n    norm(att?.emailAddress || att?.AttendeeEmail) === norm(loggedIn.WorkEmail) ||\n    norm(att?.name || att?.Name) === norm(loggedIn.DisplayName);\n\n// Add logged-in user only if they are not already in either list.\nif (loggedIn?.WorkEmail || loggedIn?.DisplayName) {\n    const loggedInKeyEmail = loggedIn.WorkEmail ? `email:${norm(loggedIn.WorkEmail)}` : \"\";\n    const loggedInKeyName = loggedIn.DisplayName ? `name:${norm(loggedIn.DisplayName)}` : \"\";\n\n    const alreadyExists = [\n        ...existAttendees,\n        ...newAttendees\n    ].some(att => {\n        const k = attendeeKey(att);\n        return k === loggedInKeyEmail || k === loggedInKeyName;\n    });\n\n    if (!alreadyExists) {\n        newAttendees.push({\n            emailAddress: loggedIn.WorkEmail || \"\",\n            name: loggedIn.DisplayName || \"\"\n        });\n    }\n}\n\n// Deduplicate existing attendees.\nlet uniqueExistingAttendees = [];\nlet seenExisting = new Set();\n\nfor (const att of existAttendees) {\n    const k = attendeeKey(att);\n    if (!k || seenExisting.has(k)) continue;\n    seenExisting.add(k);\n    uniqueExistingAttendees.push(att);\n}\n\n// Deduplicate new attendees.\nlet uniqueNewAttendees = [];\nlet seenNew = new Set();\n\nfor (const att of newAttendees) {\n    const k = attendeeKey(att);\n    if (!k || seenNew.has(k)) continue;\n    seenNew.add(k);\n    uniqueNewAttendees.push(att);\n}\n\n// Remove any new attendees that already exist in the expense.\nlet existingKeys = new Set(uniqueExistingAttendees.map(attendeeKey));\n\nlet filteredNewAttendees = uniqueNewAttendees.filter(att => !existingKeys.has(attendeeKey(att)));\n\nlet expenseAttendees = [];\n\nif (filteredNewAttendees.length > 0 || uniqueExistingAttendees.length > 0) {\n    let allAttendeesCount = uniqueExistingAttendees.length + filteredNewAttendees.length;\n    let receiptAmountMinorUnits = toMinorUnits(receiptAmount);\n    let baseAmountMinorUnits = allAttendeesCount > 0\n        ? Math.floor(receiptAmountMinorUnits / allAttendeesCount)\n        : 0;\n\n    let remainderMinorUnits =\n        receiptAmountMinorUnits - (baseAmountMinorUnits * allAttendeesCount);\n\n    let employeeRemainderAssigned = false;\n    let employeeExistsInNewAttendees = filteredNewAttendees.some(att => isEmployeeAttendee(att));\n\n    uniqueExistingAttendees.forEach(att => {\n        if (att.ExpenseAttendeeId) {\n            let amountMinorUnits = baseAmountMinorUnits;\n\n            if (!employeeRemainderAssigned && isEmployeeAttendee(att)) {\n                amountMinorUnits += remainderMinorUnits;\n                employeeRemainderAssigned = true;\n            }\n\n            expenseAttendees.push({\n                id: att.ExpenseAttendeeId,\n                amount: fromMinorUnits(amountMinorUnits)\n            });\n        }\n    });\n\n    filteredNewAttendees.forEach((att, index) => {\n        let amountMinorUnits = baseAmountMinorUnits;\n\n        let isFallbackEmployee =\n            !employeeRemainderAssigned &&\n            !employeeExistsInNewAttendees &&\n            remainderMinorUnits > 0 &&\n            index === 0;\n\n        if (!employeeRemainderAssigned && (isEmployeeAttendee(att) || isFallbackEmployee)) {\n            amountMinorUnits += remainderMinorUnits;\n            employeeRemainderAssigned = true;\n        }\n\n        expenseAttendees.push({\n            emailAddress: att.emailAddress || att.AttendeeEmail || \"\",\n            name: att.name || att.Name || \"\",\n            amount: fromMinorUnits(amountMinorUnits)\n        });\n    });\n}\n\nreturn { expenseAttendees };"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "CHECKEXISITING_ATTENDEE",
          "convergenceTargetId": "1769514840183",
          "id": "1769496265114",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
