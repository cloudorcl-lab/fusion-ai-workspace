        {
          "metadata": {
            "name": "IsAttendeeRequired",
            "returnType": "boolean",
            "sourceCode": "let input = $context.$triggers.REST.$input.resolvedEntities.resolvedEntities || [] ;\n\nif (Array.isArray(input)) {\n    for (let i = 0; i < input.length; i++) {\n        let entity = input[i];\n\n        if (\n            entity &&\n            (\n                entity.name === \"Attendee\" ||\n                entity.name === \"Attendees\" ||\n                entity.name === \"NonEmployeeAttendees\"\n            ) &&\n            Array.isArray(entity.resolvedValues) &&\n            entity.resolvedValues.length > 0\n        ) {\n            return true;\n        }\n    }\n}\n\nreturn false;"
          },
          "outcomes": {
            "success": "1770880268213"
          },
          "code": "ISATTENDEEREQUIRED",
          "id": "1769514652732",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "CallAttendeeFlow"
          },
          "outcomes": {
            "true": "1769506705966",
            "false": "1769885967619"
          },
          "code": "CALLATTENDEEFLOW",
          "convergenceTargetId": "end",
          "id": "1769514784356",
          "inputs": [
            {
              "id": "1769514784358_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.ISATTENDEEREQUIRED.$output.result || $context.$nodes.CHECKRESOLVEDATTENDEEOBECT.$output.result}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "AttendeeByuser",
            "returnType": "array",
            "sourceCode": "const validFields = new Set([\n    \"Attendee\",\n    \"Attendees\",\n    \"NonEmployeeAttendee\",\n    \"NonEmployeeAttendees\",\n    \"AmbiguousAttendees\",\n    \"AmbiguousAttendee\"\n]);\n\nlet input =\n    $context?.$triggers?.REST?.$input?.resolvedEntities?.resolvedEntities || [];\n\nlet raw =\n    $context?.$triggers?.REST?.$input?.userDecompositionOutput;\n\n// Step 1: ensure outer object\nif (typeof raw === \"string\") {\n  raw = JSON.parse(raw);\n}\n\n// Step 2: parse inner \"output\"\nlet output = raw;\n\nif (typeof output === \"string\") {\n  output = JSON.parse(output);\n}\n\n// Step 3: safely extract\nlet DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\n\nlet newAttendees = [];\n\n/* ---------- From resolvedEntities ---------- */\n\nif (Array.isArray(input)) {\n    input.forEach(entity => {\n        if (\n            entity &&\n            validFields.has(entity.name) &&\n            Array.isArray(entity.resolvedValues)\n        ) {\n            entity.resolvedValues.forEach(rv => {\n                if (\n                    rv?.status === \"ORA_EXACT_MATCH\" &&\n                    Array.isArray(rv.matches)\n                ) {\n                    rv.matches.forEach(match => {\n                        const id = match?.fieldValue?.id;\n                        const name = match?.fieldValue?.name;\n\n                        if (id && name) {\n                            newAttendees.push({\n                                emailAddress: id,\n                                name: name\n                            });\n                        }\n                    });\n                }\n            });\n        }\n    });\n}\n\n/* ---------- From DecomposedInstructions ---------- */\n\nif (Array.isArray(DecomposedInstructionsArray)) {\n    DecomposedInstructionsArray.forEach(instruction => {\n        const { type, field, value } = instruction || {};\n\n        if (\n            (type === \"resolved\" || type === \"rec_resolved\") &&\n            validFields.has(field) &&\n            value\n        ) {\n            let attendeeObj =\n                typeof value === \"string\"\n                    ? JSON.parse(value)\n                    : value;\n\n            if (attendeeObj?.id && attendeeObj?.name) {\n                newAttendees.push({\n                    emailAddress: attendeeObj.id,\n                    name: attendeeObj.name\n                });\n            }\n        }\n    });\n}\n\nreturn newAttendees;"
          },
          "outcomes": {
            "success": "1769508204644"
          },
          "code": "GETATTENDEESBYUSER",
          "convergenceTargetId": "1769514840183",
          "id": "1769506705966",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
