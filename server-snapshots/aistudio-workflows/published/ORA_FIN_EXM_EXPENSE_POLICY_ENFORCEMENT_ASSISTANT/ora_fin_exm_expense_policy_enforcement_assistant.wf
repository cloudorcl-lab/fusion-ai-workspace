        {
          "metadata": {
            "name": "checkResolvedAttendeeObect",
            "returnType": "boolean",
            "sourceCode": "let raw = $context.$triggers.REST.$input.userDecompositionOutput;\n\n//let raw = $context.$triggers.REST.$input.userDecompositionAgentOutput;\n\n// Step 1: ensure outer object\nif (typeof raw === \"string\") {\n  raw = JSON.parse(raw);\n}\n\n// Step 2: parse inner \"output\"\nlet output = raw;\n\nif (typeof output === \"string\") {\n  output = JSON.parse(output);\n}\n\n// Step 3: safely extract\nlet DecomposedInstructionsArray =\n  output?.result?.DecomposedInstructions || [];\n\nconst hasAttendee = DecomposedInstructionsArray.some((instruction) => {\n  const { type, field } = instruction;\n\n  return (\n    (type === \"resolved\" || type === \"rec_resolved\") &&\n    (\n      field === \"Attendee\" ||\n      field === \"Attendees\" ||\n      field === \"NonEmployeeAttendee\" ||\n      field === \"NonEmployeeAttendees\" ||\n      field=== \"AmbiguousAttendees\" ||\n      field=== \"AmbiguousAttendee\"\n    )\n  );\n});\n\nreturn hasAttendee;"
          },
          "outcomes": {
            "success": "1769514784356"
          },
