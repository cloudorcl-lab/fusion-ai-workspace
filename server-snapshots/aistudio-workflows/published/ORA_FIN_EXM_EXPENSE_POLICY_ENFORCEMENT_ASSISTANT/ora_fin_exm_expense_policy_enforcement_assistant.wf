{
  "workflowId": "100002355227092",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_POLICY_ENFORCEMENT_ASSISTANT",
  "name": "Expense Policy Enforcement Assistant",
  "description": "This agent enforces expense policies by applying policy validation rules and performing required adjustments before the expense is finally updated. It ensures attendee-related adjustments are processed correctly and applies policy-based corrections such as adjusting receipt amounts to comply with policy limits.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
