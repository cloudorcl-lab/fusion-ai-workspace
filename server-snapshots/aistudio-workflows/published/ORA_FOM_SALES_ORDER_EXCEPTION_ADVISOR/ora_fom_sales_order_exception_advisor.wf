          "code": "SET_CURATED_DATA",
          "id": "1772090311029",
          "inputs": [
            {
              "id": "1772090317404",
              "name": "pCuratedData",
              "scope": "JOB",
              "type": "object",
              "value": "{{$context.$nodes.FIX_CURATED_DATA.$output.result}}"
