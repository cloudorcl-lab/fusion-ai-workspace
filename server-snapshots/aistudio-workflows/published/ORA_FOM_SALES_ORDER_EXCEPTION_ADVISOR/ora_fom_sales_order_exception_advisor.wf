            "name": "Fetch FlineId",
            "returnType": "string",
            "sourceCode": "let fulfillLineId = null;\n\ntry {\n  const oraAction = $context.$app.$OraAction;\n\n  let parsed = null;\n\n  if (typeof oraAction === \"string\") {\n    parsed = JSON.parse(oraAction);\n  } else if (typeof oraAction === \"object\" && oraAction !== null) {\n    parsed = oraAction;\n  }\n\n  if (parsed) {\n    const value = parsed.FulfillLineId;\n\n    if (typeof value === \"number\") {\n      fulfillLineId = value;\n    } else if (typeof value === \"string\" && !isNaN(value)) {\n      fulfillLineId = Number(value);\n    }\n  }\n} catch (e) {\n  fulfillLineId = null;\n}\nreturn fulfillLineId;"
          },
          "outcomes": {
            "success": "1776247118514"
          },
          "code": "FETCH_FLINEID",
