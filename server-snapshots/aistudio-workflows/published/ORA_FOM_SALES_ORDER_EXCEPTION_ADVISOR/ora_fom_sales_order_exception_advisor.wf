            "sourceCode": "const pCuratedData = $context.$nodes.FETCH_EXCEPTIONS_RELATED_CURATED_DATA.$output ?? {};\n//const pCuratedData = $context.$variables.pCuratedData ;\n\nif (Array.isArray(pCuratedData.outputArray)) {\n  // Normalize existing outputArray to required shape\n  return {\n    outputArray: pCuratedData.outputArray.map((item) => ({\n      result: {\n        exceptionDetails: Array.isArray(item?.result?.exceptionDetails)\n          ? item.result.exceptionDetails\n          : [],\n      },\n    })),\n  };\n}\n\n// Build outputArray from top-level exceptionDetails (1 exception per item)\nconst exceptionDetails = Array.isArray(pCuratedData.exceptionDetails)\n  ? pCuratedData.exceptionDetails\n  : [];\n\nreturn {\n  outputArray: exceptionDetails.map((detail) => ({\n    result: {\n      exceptionDetails: [detail],\n    },\n  })),\n};"
          },
