            "sourceCode": "const item0 = $context.$nodes.GET_CUSTOMER_CONTACT_POINT_DETAILS.$output.items?.[0];\n\nconst customerEmail =\n  item0?.ContactPtTypeTransient === 'E-mail'\n    ? (item0?.Value ?? '')\n    : '';\n\nreturn customerEmail;"
