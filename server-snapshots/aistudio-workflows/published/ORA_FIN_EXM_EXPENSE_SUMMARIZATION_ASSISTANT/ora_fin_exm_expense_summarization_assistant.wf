        {
          "metadata": {
            "name": "Prepare Record System Summary",
            "returnType": "object",
            "sourceCode": "const partnerExpenseItems = $context.$nodes.GET_PREVIOUS_SUMMARIES.$output?.items || [];\nconst partnerExpenseSummary = partnerExpenseItems.reduce((summary, item) => {\n  if (item?.sourceTypeCode === \"RECEIPT\") summary.receipt = item;\n  if (item?.sourceTypeCode === \"MESSAGE\" ) summary.message = item;\n  return summary;\n}, { receipt: null, message: null });\n\nconst partnerExpenseMessage = partnerExpenseSummary.message || partnerExpenseItems[0] || {};\nconst etag = partnerExpenseMessage?.$context?.etag || \"1\";\nconst rawSystemInformation = partnerExpenseMessage?.systemInformation;\nlet summary = rawSystemInformation ? JSON.parse(atob(rawSystemInformation)) : {};\nconst summarizedData = $context.$nodes.SUMMARIZATIONOUTPUT.$output.result.summarizedData || {};\n\nsummary.systemSummary = {\n  openIssues: summarizedData?.openIssues?.summary ?? \"\",\n  recommendations: summarizedData?.recommendations?.summary ?? \"\",\n  ack: summarizedData?.acknowledgements?.summary ?? \"\",\n  failures: summarizedData?.failures?.summary ?? \"\",\n  defaults: summarizedData?.defaults?.summary ?? \"\"\n};\n\nsummary = btoa(JSON.stringify(summary));\n\nconst predictionItems = $context.$nodes.GETEXPENSEPREDICTIONS.$output?.items || [];\nconst recommendations = predictionItems.filter(\n  (item) => item?.predictionTypeCode === \"ORA_RECOMMENDATION\"\n);\nconst actionableExpenseErrorCount = Number(summarizedData?.actionableExpenseErrorCount || 0);\n\nlet outcomeStatus = \"ORA_EXPENSE_CLEAN\";\nif (actionableExpenseErrorCount > 0 || recommendations.length > 0) {\n  outcomeStatus = \"ORA_EXPENSE_REQUIRED_USER_INPUT\";\n}\n\nreturn {updatedSummary: summary, etag, partnerExpenseId: $context.$triggers.REST.$input.partnerExpenseId, outcomeStatus};"
          },
          "outcomes": {
            "success": "1780505989980"
          },
          "code": "PREPARE_RECORD_SYSTEM_SUMMARY",
