        {
          "metadata": {
            "name": "generatePayloadGetMessages",
            "returnType": "object",
            "sourceCode": "let channel = $context.$triggers.REST.$input.channel;\nlet partnerExpenseId = $context.$triggers.REST.$input.partnerExpenseId;\n\nlet filter;\nlet subTypes;\n\nif (channel === \"B2B_CC\") {\n  filter = `(sourceTypeCode='MESSAGE' and id='${partnerExpenseId}') or (sourceTypeCode='B2B_CC' and id='${partnerExpenseId}')`;\n\n  subTypes = {\n    \"MESSAGE\": {\n      \"fields\": [\n        \"systemInformation\",\n        \"partnerExpenseOutcome\",\n        \"outcomeSubReason\",\n        \"statusCode\",\n        \"stageStatus\"\n      ]\n    },\n    \"B2B_CC\": {\n      \"fields\": [\n        \"creditCardTransactionIdentifier\",\n        \"creditCardNetworkReferenceNumber\",\n        \"cardIdentifier\",\n        \"companyIdentifier\",\n        \"requestIdentifier\",\n        \"systemInformation\"\n      ]\n    }\n  };\n} else {\n  filter = `(sourceTypeCode='MESSAGE' and id='${partnerExpenseId}') or (sourceTypeCode='RECEIPT' and partnerExpenseReferenceId='${partnerExpenseId}')`;\n\n  subTypes = {\n    \"MESSAGE\": {\n      \"fields\": [\n        \"systemInformation\",\n        \"partnerExpenseOutcome\",\n        \"outcomeSubReason\",\n        \"statusCode\",\n        \"stageStatus\"\n      ]\n    },\n    \"RECEIPT\": {\n      \"fields\": [\n        \"receiptAmount\",\n        \"tipAmount\"\n      ],\n      \"accessors\": {\n        \"receiptCurrency\": {\n          \"fields\": [\"currencyCode\"]\n        },\n        \"businessUnit\": {\n          \"fields\": [\"name\"]\n        }\n      }\n    }\n  };\n}\n\nlet payload = {\n  \"fields\": [\n    \"id\",\n    \"partnerExpenseReferenceId\",\n    \"timeCreated\"\n  ],\n  \"accessors\": {\n    \"person\": {\n      \"fields\": [\"id\"]\n    }\n  },\n  \"collection\": {\n    \"filter\": filter,\n    \"sortBy\": [\n      { \"id\": \"desc\" }\n    ]\n  },\n  \"subTypes\": subTypes\n};\n\nreturn payload;\n"
          },
          "outcomes": {
            "success": "1772489887761"
          },
