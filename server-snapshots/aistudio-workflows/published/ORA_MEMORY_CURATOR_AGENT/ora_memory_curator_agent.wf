            "sourceCode": "// Override default agentCode if exists\nconst agentCodeInput = $context.$triggers.REST.$input.agentCode;\nconst isAgentCodeNonEmpty = typeof agentCodeInput === \"string\" && agentCodeInput.trim().length > 0;\nlet agentCodeOutput = isAgentCodeNonEmpty ? agentCodeInput : \"GLOBAL\" ;\n\n// Override default vector score threshold if exists\nconst vectorThresholdInput = $context.$triggers.REST.$input.vectorScoreThreshold;\nconst vectorThresholdExists = typeof vectorThresholdInput === \"number\" && vectorThresholdInput > 0;\nlet vectorThresholdOutput = vectorThresholdExists ? vectorThresholdInput : 0.69 ;\n\n// Override default text score threshold if exists\nconst textThresholdInput = $context.$triggers.REST.$input.textScoreThreshold;\nconst textThresholdExists = typeof textThresholdInput === \"number\" && textThresholdInput > 0;\nlet textThresholdOutput = textThresholdExists ? textThresholdInput : 0;\n\nlet out = {\n      \"agentCode\": agentCodeOutput,\n      \"vectorScoreThreshold\": vectorThresholdOutput,\n      \"textScoreThreshold\": textThresholdOutput\n}\nreturn out;"
          },
