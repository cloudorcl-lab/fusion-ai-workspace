          "code": "FETCH_EXISTING_MEMORIES",
          "id": "1764741592750",
          "inputs": [
            {
              "id": "1764741592751_1",
              "name": "indexName",
              "type": "string",
              "value": "{{$context.$user.$name+\"-\"+$context.$variables.agentCode+\"-memories\"}}"
            },
            {
              "id": "1764741592751_2",
              "name": "query",
              "type": "string",
              "value": "{{$context.$system.$inputMessage}}"
            },
            {
              "id": "1764741592751_3",
              "name": "documentId",
              "type": "string",
              "value": ""
            },
            {
              "id": "1764741592751_4",
              "name": "fields",
              "type": "array",
              "value": ""
            },
            {
              "id": "1764741592752_5",
              "name": "filterCriteria",
              "type": "object",
              "value": "{\n  \"operation\": \"and\",\n  \"criteria\": [\n        {\n        \"field\": \"category\",\n        \"operation\": \"in\",\n        \"value\": [\"Organizational Memory\", \"Self-Described Memory\", \"Time-Based Memory\", \"Usage Memory\"]\n        }\n  ]\n}"
            },
            {
              "id": "1764741592752_6",
              "name": "maximumResults",
              "type": "integer",
              "value": ""
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "Filter Results With Threshold",
            "returnType": "array",
            "sourceCode": "const retrievedDocuments = $context.$nodes.RETRIEVE_MEMORIES.$output;\n\nconst vectorScoreThreshold = (typeof $context.$variables.vectorScoreThreshold === 'number')\n  ? $context.$variables.vectorScoreThreshold\n  : null;\nconst textScoreThreshold = (typeof $context.$variables.textScoreThreshold === 'number')\n  ? $context.$variables.textScoreThreshold\n  : null;\n\nconst vectorResults = [];\nconst textResults = [];\n\nfor (let i = 0; i < retrievedDocuments.length; i++) {\n  const doc = retrievedDocuments[i];\n\n  if (\n    typeof doc.vectorSearchScore === 'number' &&\n    doc.vectorSearchScore !== -1 &&\n    (vectorScoreThreshold === null || doc.vectorSearchScore >= vectorScoreThreshold)\n  ) {\n    vectorResults.push(doc);\n  }\n\n  if (\n    typeof doc.textSearchScore === 'number' &&\n    doc.textSearchScore !== -1 &&\n    (textScoreThreshold === null || doc.textSearchScore >= textScoreThreshold)\n  ) {\n    textResults.push(doc);\n  }\n}\n\nlet output;\nif (vectorResults.length > 0) {\n  output = {\n    vectorResults: vectorResults,\n    textResults: []\n  };\n} else {\n  output = {\n    vectorResults: [],\n    textResults: textResults\n  };\n}\n\nreturn output;"
          },
          "outcomes": {
            "success": "1765789369817"
          },
          "code": "FILTER_RESULTS_WITH_THRESHOLD",
          "id": "1765537657802",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract memory actions"
          },
          "outcomes": {
            "success": "1763646943198"
          },
          "code": "EXTRACT_MEMORY_ACTIONS",
          "convergenceTargetId": "1763635242823",
          "id": "1765788618463",
          "inputs": [
            {
              "id": "1765788618464_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a Memory Action Agent. Given a conversation and a user’s existing memories, decide a minimal set of actions to keep the user’s memory store up to date. Output only JSON describing Create/Update/Delete actions.\n\nConversation: {{$context.$system.$inputMessage}}\n\nExisting Memories: {{$context.$nodes.FETCH_EXISTING_MEMORIES.$output}} \n\nWhat to Extract: Extract small, user-centric facts that are useful beyond the current turn. Focus on:\n\n- profile: role/title, org, department, seniority, location, timezone, language.\n- preferences: tools, languages, formatting, tone, level of detail, notification cadence, meeting times.\n- skills_expertise: domains, frameworks\n- goals_objectives: short/long-term goals, success criteria.\n- constraints: time, budget, policy/compliance, access limits, device constraints.\n- tasks_commitments: explicit reminders, deadlines, due dates, follow-ups.\n- contacts_stakeholders: names and roles relevant to ongoing work (avoid personal contact details).\n- resources_artifacts: files, repos, URLs, data sources the user will reuse.\n- actions_taken: concrete steps performed by the user (e.g., “created branch X”, “enabled flag Y”).\n- instructions_to_agent: standing instructions (e.g., “always provide TL;DR”, “prefer TypeScript”).\n- environment_context: OS, editor, region, cloud, versions, working hours.\n\nSafety and Privacy\n\n- Never store secrets or credentials (passwords, tokens, API keys), full credit card numbers, or highly sensitive PII.\n- Minimize PII; generalize where possible (e.g., “Bay Area” instead of full address).\n- Mask emails/phones unless the user explicitly asks to store the full value.\n- Respect opt-outs (e.g., “don’t remember this”) and remove memories on explicit deletion requests.\n- If sensitive content appears, do not create/update; consider delete only if explicitly requested.\n\nMemory Categories \nEach memory action must include only one of the categories chosen from:\n\n- Usage Memory: How the user typically works—frequent queries, actions taken, tool sequences—so the agent can prefetch, order, and format results accordingly.\n- Time-Based Memory: Time anchors and windows—working hours, timezones, deadlines, due dates, fiscal boundaries—to improve timing and prioritization.\n- Self-Described Memory: User-declared preferences, guardrails, and identity/context—channels, quiet hours, KPIs to highlight, answer constraints, roles, formatting, tone. Self-described memories should be extracted only from the user messages (denoted by [user] in the conversation) and not from the assistant responses. Anything the user explicitly requests to be remembered also comes under self-described memory.\n- Organizational Memory: Organizational goals and priorities\n\nCategory Assignment Guidelines\n\n- preferences, instructions_to_agent, formatting/tone, tool/language preferences → Self-Described Memory\n- working hours, timezone, deadlines, due dates, reminders → Time-Based Memory.\n- profile, skills_expertise, environment_context, goals_objectives, constraints → Self-Described Memory.\n- tasks_commitments → Often Time-Based Memory if time-bound; \n- actions_taken → Usage Memory\n- Organizational goals, priorities, targets → Organizational Memory\n\nCanonical Memory Content String\n\n- Each memory’s content must be a single line highlighting a relevant memory\n- subject is usually the primary user; use named subject if the fact refers to someone/something else (e.g., a stakeholder or resource).\n- If the memory is related to a particular object ID (eg: opportunity ID), always store that info as well in the content \n\nExamples of content strings\n\n- User's role is Solutions Architect at Acme Corp\n- User prefers concise answer_style\n- User's working_hours are 09:00-17:00 timezone=America/Los_Angeles \n- User created a product line \"XYZ\" under product family \"ABC\" \n- User listed all models under \"SJF\" product line\n\nDecision Procedure\n\n1. Extract candidate facts from the conversation across the categories above. Discard ephemeral or low-utility items.\n\n2. Normalize each candidate into the canonical content string format.\n\n3. Compare to existing_memories to prevent duplication\n   - Consider a semantic match if the existing memory clearly expresses the same subject and attribute.\n\n4. Choose actions:\n\n   - Create: No existing memory with the same subject+attribute. Produce a create action with the new content.\n   - Update: An existing memory with the same subject+attribute exists but the value changed. Produce an update action with that memory_id and the new content (full replacement).\n   - Delete: If the user explicitly asks to forget/remove a memory or a fact is contradicted and should be removed without replacement, produce a delete action with that memory_id and a short reason.\n   - No-op: If the existing memory already matches the candidate fact (same subject+attribute+value), do nothing. If there are no relevant memories in the input also, just return an empty list\n\n5. Prefer a single Update over a Delete+Create for the same subject+attribute.\n\n6. If multiple duplicates exist for the same subject+attribute, Update the most recent correct one and Delete the others.\n\nOutput Format (JSON only) Return ONLY JSON with this shape. Include category as a string that can be one of [\"Usage Memory\",\"Time-Based Memory\",\"Self-Described Memory\"] for every action. For delete, use the category of the memory being removed (if known) or the inferred category. { \"actions\": [ { \"action\": \"create\", \"content\": \"memory content\", \"category\": \"Self-Described Memory\" }, { \"action\": \"update\", \"memory_id\": \"string\", \"content\": \"memory content\", \"category\": \"Usage Memory\" }, { \"action\": \"delete\", \"memory_id\": \"string\", \"reason\": \"string\", \"category\": \"Time-Based Memory\" } ], \"summary\": \"brief description of creates/updates/deletes decided\" }\n\nNormalization Guidelines\n\n- Case/whitespace: trim; compare case-insensitively for matching, but preserve meaningful case in value.\n- Time: ISO 8601 for dates/times; timezones as IANA names (e.g., America/Los_Angeles). Can be overridden by the user preference\n- Locations: city/region/country preferred; avoid precise addresses.\n- Emails/phones: mask unless explicit consent to store full value.\n- Tools/versions: canonical names and semantic versions where present.\n\nEdge Cases\n\n- Contradiction: Prefer Update to the latest explicit statement; use Delete only when removing an obsolete memory without replacement or on explicit user request.\n- Uncertain language (“might”, “maybe”): Skip unless clearly valuable and persistent.\n- Standing instructions (“from now on”): Treat as preferences; Create or Update accordingly.\n- Questions from assistant to user: Do not try to extract memories for assistant asking the user for confirmation like presenting options to the user. Only extract memories from user confirmations and completed assistant actions.\n- Clarifications: If the assistant is awaiting clarification/confirmation from the user, skip extracting memories. Only if the assistant took action after user confirmation, proceed with memory extraction\n\nExample 1 Input 1\n\n- conversation: User: I'm a solutions architect at Acme Corp in the Bay Area. Please default to concise answers and TypeScript examples. I usually work 9–5 PT. I switched from Java to TypeScript last month. Also, prefer code blocks with comments. Use UTC timestamps in logs. Assistant: Noted. User: Actually, make answers verbose from now on.\n- existing_memories: [ { \"id\": \"1234\", \"content\": \"User prefers concise answer_style\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" }, { \"id\": \"723684\", \"content\": \"User's role is Solutions Architect at Acme Corp\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" } ] Output 1: {\"actions\": [ { \"action\": \"update\", \"memory_id\": \"m_ans_style\", \"content\": \"User prefers verbose answer_style\", \"category\": \"Self-Described Memory\" }, { \"action\": \"create\", \"content\": \" User is familiar with TypeScript language\", \"category\": \"Self-Described Memory\" }, { \"action\": \"create\", \"content\": \"User's working_hours are 09:00-17:00; in timezone=America/Los_Angeles\", \"category\": \"Time-Based Memory\" }, { \"action\": \"create\", \"content\": \"User prefers code_blocks with_comments\", \"category\": \"Self-Described Memory\" }, { \"action\": \"create\", \"content\": \"User wants UTC timestamps in logs\", \"category\": \"Self-Described Memory\" } ], \"summary\": \"Updated answer_style to verbose; created memories for TypeScript examples, working hours PT, code blocks with comments, and UTC log timestamps.\" }\n\nExample 2 Input 2\n\n- conversation: [user]: Create an item xyz. [assistant]: I can create the item for you. I need some clarification from you before I go ahead. Under which category should the product belong to? Please confirm\n- existing_memories: [ { \"id\": \"1234\", \"content\": \"User prefers concise answer_style\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" }, { \"id\": \"723684\", \"content\": \"User's role is Solutions Architect at Acme Corp\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" } ] Output 2: {\"actions\": [], \"summary\": \"No actions as the assistant is awaiting confirmation or further clarification from the user\" }\n\nExample 3 Input 3\n\n- conversation: [user]: Create an quote for xyz. [assistant]: Created quote for xyz with quote ID: 123\n- existing_memories: [ { \"id\": \"1234\", \"content\": \"User prefers concise answer_style\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" }, { \"id\": \"723684\", \"content\": \"User's role is Solutions Architect at Acme Corp\", \"created_at\": \"2025-09-01T10:00:00Z\", \"updated_at\": \"2025-09-01T10:00:00Z\" } ] Output 3: {\"actions\": [{ \"action\": \"create\", \"content\": \"User created a quote for xyz with ID: 123\", \"category\": \"Usage Memory\" }], \"summary\": \"Added a memory for quote creation as the assistant confirmed the action execution.\" }\n\nReturn Format\n\n- Return only the JSON object described above. No prose, no explanations."
            }
          ],
          "outputSpecification": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"actions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"oneOf\": [\n          {\n            \"properties\": {\n              \"action\": { \"type\": \"string\", \"enum\": [\"create\"] },\n              \"content\": { \"type\": \"string\" },\n              \"category\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"Usage Memory\",\n                  \"Time-Based Memory\",\n                  \"Self-Described Memory\",\n                  \"Organizational Memory\"\n                ]\n              }\n            },\n            \"required\": [\"action\", \"content\", \"category\"],\n            \"additionalProperties\": false\n          },\n          {\n            \"properties\": {\n              \"action\": { \"type\": \"string\", \"enum\": [\"update\"] },\n              \"memory_id\": { \"type\": \"string\" },\n              \"content\": { \"type\": \"string\" },\n              \"category\": {\n                \"type\": \"string\",\n                \"enum\": [\n                  \"Usage Memory\",\n                  \"Time-Based Memory\",\n                  \"Self-Described Memory\",\n                  \"Organizational Memory\"\n                ]\n              }\n            },\n            \"required\": [\"action\", \"memory_id\", \"content\", \"category\"],\n            \"additionalProperties\": false\n          },\n          {\n            \"properties\": {\n              \"action\": { \"type\": \"string\", \"enum\": [\"delete\"] },\n              \"memory_id\": { \"type\": \"string\" },\n              \"reason\": { \"type\": \"string\" }\n            },\n            \"required\": [\"action\", \"memory_id\", \"reason\"],\n            \"additionalProperties\": false\n          }\n        ]\n      }\n    },\n    \"summary\": { \"type\": \"string\" }\n  },\n  \"required\": [\"actions\", \"summary\"],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Bucket into categories",
            "returnType": "object",
            "sourceCode": "const categories = [\n  \"Organizational Memory\",\n  \"Self-Described Memory\",\n  \"Time-Based Memory\",\n  \"Usage Memory\"\n];\n\nconst outputFromPrevNode = $context.$nodes.FILTER_RESULTS_WITH_THRESHOLD.$output.result ;\n\n// Use non-empty results array\nlet docs = [];\nif (Array.isArray(outputFromPrevNode.vectorResults) && outputFromPrevNode.vectorResults.length > 0) {\n  docs = outputFromPrevNode.vectorResults;\n} else if (Array.isArray(outputFromPrevNode.textResults)) {\n  docs = outputFromPrevNode.textResults;\n}\n\n// Initialize result lists for each category\nconst categoryBuckets = {};\nfor (let i = 0; i < categories.length; i++) {\n  categoryBuckets[categories[i]] = [];\n}\n\n// Sort each doc into its category array if it matches a known category\nfor (let i = 0; i < docs.length; i++) {\n  const doc = docs[i];\n  if (categories.indexOf(doc.category) !== -1) {\n    categoryBuckets[doc.category].push(doc.text);\n  }\n}\n\nreturn categoryBuckets;"
          },
          "outcomes": {
            "success": "1765789482802"
          },
          "code": "BUCKET_INTO_CATEGORIES",
          "id": "1765789369817",
          "inputs": [],
