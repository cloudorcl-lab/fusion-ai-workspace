  "workflowCode": "ORA_HCM_PER_DOCUMENT_TYPE_DESCRIPTION_GENERATOR",
  "name": "Document Type Description Generator",
  "description": "Generates clear and structured descriptions for document types.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
