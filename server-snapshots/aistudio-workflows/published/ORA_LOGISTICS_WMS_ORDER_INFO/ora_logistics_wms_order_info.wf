        {
          "metadata": {
            "name": "Consolidate Otm Data",
            "returnType": "array",
            "sourceCode": "const data =  $context.$nodes.GETORDERNUMBERS.$output;\n\nconst resultArray = (data?.items ?? []).map((it) => {\n  // Line-level refnums (flatten across all lines under it.lines.items)\n  const lineRefnums =\n    (it?.lines?.items ?? [])\n      .flatMap((ln) => ln?.refnums?.items ?? [])\n      .filter(Boolean);\n\n  // Header-level refnums (fallback)\n  const headerRefnums = it?.refnums?.items ?? [];\n\n  // Prefer line-level refnums\n  const refnumsItems = (lineRefnums && lineRefnums.length > 0) ? lineRefnums : headerRefnums;\n\n  // FAOrderNbr from line-level ORDER NUMBER using orlRefnumValue\n  const faOrderNbrFromLines =\n    lineRefnums\n      ?.find((r) => (r?.orderReleaseRefnumQualGid ?? \"\").endsWith(\".ORDER NUMBER\"))\n      ?.orlRefnumValue ?? null;\n\n  return {\n    sourceLocation: {\n      locationName: it?.sourceLocation?.locationName ?? null,\n      city: it?.sourceLocation?.city ?? null,\n      countryCode3Gid: it?.sourceLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.sourceLocation?.timeZoneGid ?? null,\n    },\n    destinationLocation: {\n      locationName: it?.destinationLocation?.locationName ?? null,\n      city: it?.destinationLocation?.city ?? null,\n      countryCode3Gid: it?.destinationLocation?.countryCode3Gid ?? null,\n      timeZoneGid: it?.destinationLocation?.timeZoneGid ?? null,\n    },\n    earlyPickupDate: it?.earlyPickupDate?.value ?? it?.earlyPickupDate ?? null,\n    earlyDeliveryDate: it?.earlyDeliveryDate?.value ?? it?.earlyDeliveryDate ?? null,\n\n    // Use orlRefnumValue from line-level ORDER NUMBER\n    FAOrderNbr: faOrderNbrFromLines,\n\n    // Expose refnums used (line-level preferred, otherwise header)\n    refnums: refnumsItems.map((r) => ({\n      orderReleaseRefnumQualGid: r?.orderReleaseRefnumQualGid ?? null,\n      // For line-level entries, value is orlRefnumValue; for header, it's orderReleaseRefnumValue\n      value: (r?.orlRefnumValue ?? r?.orderReleaseRefnumValue ?? null),\n      level: r?.orlRefnumValue != null ? \"LINE\" : \"HEADER\",\n    })),\n\n    totalWeight: {\n      unit: it?.totalWeight?.unit ?? null,\n      value: it?.totalWeight?.value ?? null,\n    },\n    totalVolume: {\n      unit: it?.totalVolume?.unit ?? null,\n      value: it?.totalVolume?.value ?? null,\n    },\n    statuses: (it?.statuses?.items ?? [])\n      .filter((s) => {\n        const t = s?.statusTypeGid ?? \"\";\n        return t.endsWith(\".PLANNING\") || t.endsWith(\".READY_TO_SHIP\");\n      })\n      .map((s) => ({\n        statusTypeGid: s?.statusTypeGid ?? null,\n        statusValueGid: s?.statusValueGid ?? null,\n      })),\n    orderReleaseXid: it?.orderReleaseXid ?? null,\n  };\n});\n\nreturn resultArray;"
          },
          "outcomes": {
            "success": "1768333450072"
          },
          "code": "CONSOLIDATE_OTM_DATA",
          "id": "1771476138048",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1768508827187",
            "name": "Get Order List",
            "returnType": "array",
            "sourceCode": "const raw = JSON.parse($context.$app.$OraAction).order_nbr;\n\n// Support: single value, comma-separated string, or array\nconst orderNbrsToFind = Array.isArray(raw)\n  ? raw.map(v => String(v).trim()).filter(Boolean)\n  : String(raw || \"\")\n      .split(\",\")\n      .map(v => v.trim())\n      .filter(Boolean);\n\nconst rows = $context.$nodes.GETTASKBYTASKTYPES.$output.result\n  || $context.$nodes.GETTASKBYTASKTYPES.$output.results\n  || [];\n\nconst orderSet = new Set(orderNbrsToFind);\n\nconst ids = rows\n  .filter(r => orderSet.has(r.order_nbr) && r.status_id < 30 && r.priority > 0)\n  .map(r => r.id);\n\nreturn ids;"
          },
          "outcomes": {
            "success": "1768511512813"
          },
          "code": "GET_ORDER_LIST",
          "id": "1771592475245",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get SysDate",
            "returnType": "array",
            "sourceCode": "const now = new Date($context.$system.$currentDateTime);\nconst threeDaysMs = 7 * 24 * 60 * 60 * 1000;\n\nconst start = new Date(now.getTime() - threeDaysMs); // 3 days before\nconst end = new Date(now.getTime() + threeDaysMs); // 3 days after\n\nconst dateWindow = [start.toISOString(), end.toISOString()];\nreturn dateWindow;"
          },
          "outcomes": {
            "success": "1768333339531"
          },
          "code": "GET_SYSDATE",
          "id": "1772010929475",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
