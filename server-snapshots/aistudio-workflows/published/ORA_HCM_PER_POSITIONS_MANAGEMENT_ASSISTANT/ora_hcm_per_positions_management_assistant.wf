          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"agentOut\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"PositionId\": {\n          \"type\": [\n            \"integer\",\n            \"string\"\n          ]\n        },\n        \"PositionName\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"PositionCode\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"ParentPositionName\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"BusinessUnitId\": {\n          \"type\": [\n            \"integer\",\n            \"null\"\n          ]\n        },\n        \"BusinessUnitName\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"DepartmentNameId\": {\n          \"type\": [\n            \"integer\",\n            \"null\"\n          ]\n        },\n        \"DepartmentName\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"JobName\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        },\n        \"Status\": {\n          \"type\": [\n            \"string\",\n            \"null\"\n          ]\n        }\n      },\n      \"required\": [\n        \"PositionId\"\n      ]\n    },\n    \"searchResults\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"searchResponse\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"responseStatus\": {\n              \"type\": \"integer\"\n            },\n            \"response\": {\n        