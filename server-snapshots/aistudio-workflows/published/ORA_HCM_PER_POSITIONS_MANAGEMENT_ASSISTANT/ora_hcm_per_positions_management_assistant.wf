me\": {\n                      \"type\": \"string\"\n                    },\n                    \"CreatedBy\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"CreationDate\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\",\n                          \"format\": \"date-time\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"LastUpdatedBy\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"LastUpdateDate\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\",\n                          \"format\": \"date-time\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"PositionHierarchyId\": {\n                      \"type\": \"string\",\n                      \"format\": \"BigInt\"\n                    },\n                    \"EffectiveStartDate\": {\n                      \"type\": \"string\",\n                      \"format\": \"date\"\n                    },\n                    \"EffectiveEndDate\": {\n                      \"type\": \"string\",\n                      \"format\": \"date\"\n                    },\n                    \"ParentPositionId\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\",\n                          \"format\": \"BigInt\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"ParentPositionCode\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    },\n                    \"ParentPositionBusinessUnitName\": {\n                      \"anyOf\": [\n                        {\n                          \"type\": \"string\"\n                        },\n                        {\n                          \"type\": \"null\"\n                        }\n                      ]\n                    }\n                  },\n                  \"additionalProperties\": false\n                }\n              }\n            },\n            \"additionalProperties\": false,\n            \"required\": [\n              \"count\",\n              \"hasMore\",\n              \"limit\",\n              \"offset\",\n              \"links\"\n            ]\n          },\n          \"positionLegislativeEFF\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"totalResults\": {\n                \"type\": \"integer\"\n              },\n              \"count\": {\n                \"type\": \"integer\"\n              },\n              \"hasMore\": {\n                \"type\": \"boolean\"\n              },\n              \"limit\": {\n                \"type\": \"integer\"\n              },\n              \"offset\": {\n                \"type\": \"integer\"\n              },\n              \"links\": {\n                \"type\": \"array\",\n                \"items\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"href\": {\n                      \"type\": \"string\"\n                    },\n                    \"rel\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"self\",\n                        \"lov\",\n                        \"parent\",\n                        \"canonical\",\n                        \"child\",\n                        \"enclosure\",\n                        \"action\",\n                        \"custom\"\n                      ]\n                    },\n                    \"name\": {\n                      \"type\": \"string\"\n                    },\n                    \"kind\": {\n                      \"type\": \"string\",\n                      \"enum\": [\n                        \"collection\",\n                        \"item\",\n                        \"describe\",\n                        \"other\"\n                      ]\n                    }\n                  },\n                  \"additionalProperties\": false\n                }\n              },\n              \"items\": {\n                \"type\": \"array\",\n                \"items\": {}\n              }\n            },\n            \"additionalProperties\": false,\n            \"required\": [\n              \"count\",\n              \"hasMore\",\n              \"limit\",\n              \"offset\",\n              \"links\"\n            ]\n          },\n          \"positionsDFF\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"totalResults\": {\n                \"type\": \"integer\"\n              },\n              \"count\": {\n                \"type\": \"integer\"\n              },\n              \"hasMore\": {\n                \"type\": \"boolean\"\n              },\n              \"limit\": {\n                \"type\": \"integer\"\n   