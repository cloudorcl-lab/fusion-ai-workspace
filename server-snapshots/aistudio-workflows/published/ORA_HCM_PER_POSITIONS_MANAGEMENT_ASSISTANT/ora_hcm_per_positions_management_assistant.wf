,\n                      \"JobName\",\n                      \"Status\"\n                    ]\n                  }\n                },\n                \"count\": {\n                  \"type\": \"integer\"\n                },\n                \"limit\": {\n                  \"type\": \"integer\"\n                },\n                \"offset\": {\n                  \"type\": \"integer\"\n                },\n                \"hasMore\": {\n                  \"type\": \"boolean\"\n                },\n                \"totalResults\": {\n                  \"type\": \"integer\"\n                }\n              },\n              \"required\": [\n                \"items\",\n                \"count\",\n                \"limit\",\n                \"offset\",\n                \"hasMore\",\n                \"totalResults\"\n              ]\n            }\n          }\n        }\n      }\n    }\n  }\n}\n"
