                  "id": "1779084437731",
                  "code": "CHECK_AGENT_OUT",
                  "type": "CODE",
                  "metadata": {
                    "errorNodeId": "1768987999915",
                    "name": "check_agent_out",
                    "returnType": "object",
                    "sourceCode": "const searchResponse = $context.$nodes.ORA_HCM_PER_POSITION_FINDER.$output.searchResponse.response;\nconst positionCode = $context.$nodes.IDENTIFY_FLOWCODE.$output.positionCode;\nvar selectedPosition = {};\nif(searchResponse && searchResponse.count == 1){\nselectedPosition = searchResponse.items[0];\n}else if(searchResponse && searchResponse.count > 1){\nconst matchedCodeIndex = searchResponse.items.findIndex(element => element.PositionCode == positionCode);\nconst matchedNameIndex = searchResponse.items.findIndex(element => element.PositionName == positionCode);\nselectedPosition = matchedCodeIndex >= 0 ? searchResponse.items[matchedCodeIndex] : matchedNameIndex >= 0 ? searchResponse.items[matchedNameIndex] : { \"PositionId\" : \"\" };\n}else{\nselectedPosition[\"PositionId\"]=\"\";\n}\nreturn selectedPosition;"
                  },
                  "diagram": {
                    "x": 10673,
                    "y": 5463
                  },
                  "outcomes": {
                    "success": "1779084703659"
                  },
                  "inputs": [],
