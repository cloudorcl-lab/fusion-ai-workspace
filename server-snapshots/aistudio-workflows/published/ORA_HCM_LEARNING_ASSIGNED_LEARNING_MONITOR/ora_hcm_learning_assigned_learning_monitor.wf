            "businessObjectCode": "ORA_HCM_LEARNING_LEARNERAGGREGATES",
            "functionName": "learningItemAggregations",
            "name": "Get Learning Items at Risk"
          },
          "outcomes": {
            "success": "1772060000000"
          },
          "code": "GET_LEARNING_ITEMS_AT_RISK",
          "convergenceTargetId": "1766441665548",
          "id": "1766449826427",
          "inputs": [
            {
              "id": "1772042143132_1",
              "name": "payload",
              "type": "string",
              "value": "{\"offset\":0,\"securityFilters\":{\"type\":\"MANAGER\"},\"limit\":100,\"filters\":[{\"name\":\"reports\",\"value\":\"DIRECT_REPORTS\"},{\"name\":\"enrollments\",\"value\":\"CURRENT\"},{\"terms\":[\"ORA_ASSN_REC_NOTSTARTED\",\"ORA_ASSN_REC_NO_OFFR\",\"ORA_ASSN_REC_INPROGRESS\"],\"name\":\"assignmentSubStatus\"}],\"sort\":[{\"name\":\"overdueLearning\",\"direction\":\"desc\"}]}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Prepare Learning Items At Risk Display",
            "returnType": "object",
            "sourceCode": "const raw = $context.$nodes.GET_LEARNING_ITEMS_AT_RISK.$output;\nconst nowIso = $context.$system.$currentDateTime || new Date().toISOString();\nconst asOfDate = new Date(nowIso).toISOString().slice(0, 10);\nconst maxInput = Number($context.$variables.maxItemsToRender);\nconst maxItemsToRender = Number.isFinite(maxInput) && maxInput > 0 ? Math.floor(maxInput) : 10;\n\nconst parseMaybe = (value) => {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch {\n    return value;\n  }\n};\n\nconst unwrapArray = (value) => {\n  let current = parseMaybe(value);\n  for (let i = 0; i < 6; i += 1) {\n    if (Array.isArray(current)) return current;\n    if (!current || typeof current !== 'object') return [];\n    const next = [current.items, current.records, current.data, current.result, current.output]\n      .map(parseMaybe)\n      .find((candidate) => candidate != null);\n    if (next == null || next === current) return [];\n    current = next;\n  }\n  return Array.isArray(current) ? current : [];\n};\n\nconst clean = (value) => {\n  if (value == null) return '';\n  return String(value).trim();\n};\n\nconst toInt = (value) => {\n  if (typeof value === 'number' && Number.isFinite(value)) return Math.max(0, Math.floor(value));\n  const text = clean(value);\n  if (!text) return 0;\n  const parsed = Number(text);\n  return Number.isFinite(parsed) ? Math.max(0, Math.floor(parsed)) : 0;\n};\n\nconst records = unwrapArray(raw);\nconst normalizedItems = records.map((record) => {\n  const learningItemId = clean(record.learningItemId || record.itemId || record.id);\n  const learningItemTitle = clean(record.learningItemTitle || record.title || record.DisplayName);\n  const overdueLearningCount = toInt(record.overdueLearningCount || record.overdueLearning || record.overdueCount);\n  const dueNextMonthLearningCount = toInt(record.dueNextMonthLearningCount || record.dueSoonLearningCount || record.dueNextMonthCount);\n  const learnerCount = toInt(record.learnerCount || record.enrollments || record.assignmentCount);\n  const hasOverdue = overdueLearningCount > 0;\n  const hasDueSoon = dueNextMonthLearningCount > 0;\n  const statusKey = hasOverdue ? 'overdue' : hasDueSoon ? 'dueSoon' : 'none';\n  const statusText = hasOverdue ? 'Overdue' : hasDueSoon ? 'Due within 30 days' : '';\n  const assignmentsCount = hasOverdue ? overdueLearningCount : dueNextMonthLearningCount;\n  const actionQuery = learningItemId\n    ? `learningItemId=${encodeURIComponent(learningItemId)}&learningItemTitle=${encodeURIComponent(learningItemTitle)}`\n    : '';\n\n  return {\n    learningItemId,\n    learningItemTitle,\n    learnerCount,\n    overdueLearningCount,\n    dueNextMonthLearningCount,\n    hasOverdue,\n    hasDueSoon,\n    statusKey,\n    statusText,\n    assignmentsCount,\n    assignmentsText: String(assignmentsCount),\n    actionQuery\n  };\n});\n\nconst eligibleItems = normalizedItems.filter((item) => item.hasOverdue || item.hasDueSoon);\n\neligibleItems.sort((left, right) => {\n  if (left.overdueLearningCount !== right.overdueLearningCount) return right.overdueLearningCount - left.overdueLearningCount;\n  if (left.dueNextMonthLearningCount !== right.dueNextMonthLearningCount) return right.dueNextMonthLearningCount - left.dueNextMonthLearningCount;\n  if (left.learnerCount !== right.learnerCount) return right.learnerCount - left.learnerCount;\n  return left.learningItemTitle.localeCompare(right.learningItemTitle);\n});\n\nconst displayed = eligibleItems.slice(0, maxItemsToRender);\nconst itemsWithOverdue = normalizedItems.filter((item) => item.overdueLearningCount > 0).length;\nconst totalOverdue = normalizedItems.reduce((sum, item) => sum + item.overdueLearningCount, 0);\nconst itemsDueNextMonth = normalizedItems.filter((item) => item.overdueLearningCount === 0 && item.dueNextMonthLearningCount > 0).length;\nconst totalDueNextMonth = normalizedItems.reduce((sum, item) => sum + item.dueNextMonthLearningCount, 0);\nconst totalLearners = normalizedItems.reduce((sum, item) => sum + item.learnerCount, 0);\nconst pctItemsOverdue = Math.round((itemsWithOverdue / Math.max(normalizedItems.length, 1)) * 100);\nconst topImpacted = normalizedItems\n  .filter((item) => item.overdueLearningCount > 0)\n  .sort((left, right) => {\n    if (left.overdueLearningCount !== right.overdueLearningCount) return right.overdueLearningCount - left.overdueLearningCount;\n    return left.learningItemTitle.localeCompare(right.learningItemTitle);\n  })\n  .slice(0, 2)\n  .map((item) => ({\n    learningItemTitle: item.learningItemTitle,\n    overdueLearningCount: item.overdueLearningCount\n  }));\n\nconst result = {\n  asOfDate,\n  maxItemsToRender,\n  totalItems: normalizedItems.length,\n  totalEligible: eligibleItems.length,\n  displayedCount: displayed.length,\n  itemsWithOverdue,\n  totalOverdue,\n  itemsDueNextMonth,\n  totalDueNextMonth,\n  totalLearners,\n  pctItemsOverdue,\n  topImpacted,\n  displayed\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767915438400"
          },
          "code": "PREPARE_LEARNING_ITEMS_AT_RISK_DISPLAY",
          "id": "1772060000000",
