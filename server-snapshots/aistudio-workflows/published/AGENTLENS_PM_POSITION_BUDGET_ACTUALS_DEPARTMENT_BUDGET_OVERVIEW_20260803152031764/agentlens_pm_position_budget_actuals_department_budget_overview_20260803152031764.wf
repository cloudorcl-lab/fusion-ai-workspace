            "name": "Wrap fill parameters",
            "language": "JAVASCRIPT",
            "sourceCode": "var ps = ($context.$nodes.FILL_PARAMETERS_LLM && $context.$nodes.FILL_PARAMETERS_LLM.$output && $context.$nodes.FILL_PARAMETERS_LLM.$output.parameters) ? $context.$nodes.FILL_PARAMETERS_LLM.$output.parameters : []; var parts = []; var i; for (i = 0; i < ps.length; i += 1) { var p = ps[i] || {}; var id = String(p.id || \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); var v = String(p.value || \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); if (id) { parts.push(\"<parameter id=\\\"\" + id + \"\\\">\" + v + \"</parameter>\"); } } return parts.join(\"\");",
