            "name": "Normalize invoked action",
            "language": "JAVASCRIPT",
            "sourceCode": "var input = ($context.$triggers && $context.$triggers.REST && $context.$triggers.REST.$input) ? $context.$triggers.REST.$input : {}; var app = $context.$app || {}; var system = $context.$system || {}; var raw = system.$inputMessage || app.$OraAction || input.OraAction || input.Message || \"\"; var payload = {}; var action = \"default\"; var text = \"\"; var invokeIndex = -1; var openIndex = -1; var quoteA = -1; var quoteB = -1; var quoteIndex = -1; var quoteChar = \"\"; var endQuote = -1; var commaIndex = -1; raw = String(raw || \"\"); if (raw.indexOf(\"oraFormSubmit\") >= 0) { return { kind: \"formSubmit\", actionCode: input.action || \"formSubmit\", payload: input.formValues || {} }; } invokeIndex = raw.indexOf(\"ora.Invoke(\"); if (invokeIndex >= 0) { openIndex = raw.indexOf(\"(\", invokeIndex); quoteA = raw.indexOf(\"\\\"\", openIndex); quoteB = raw.indexOf(\"\\'\", openIndex); quoteIndex = quoteA; quoteChar = \"\\\"\"; if (quoteB >= 0 && (quoteA < 0 || quoteB < quoteA)) { quoteIndex = quoteB; quoteChar = \"\\'\"; } endQuote = raw.indexOf(quoteChar, quoteIndex + 1); if (quoteIndex >= 0 && endQuote > quoteIndex) { action = raw.substring(quoteIndex + 1, endQuote); } commaIndex = raw.indexOf(\",\", endQuote + 1); if (commaIndex >= 0) { text = raw.substring(commaIndex + 1).trim(); if (text.charAt(text.length - 1) === \")\") { text = text.substring(0, text.length - 1); } try { payload = JSON.parse(text); } catch (e) { payload = {}; } } } else if (raw.charAt(0) === \"{\") { try { payload = JSON.parse(raw); } catch (e) { payload = {}; } action = payload.actionCode || payload.action || \"default\"; } else if (raw) { action = raw; } if (payload.actionCode) { action = payload.actionCode; } if ((!action || action === \"default\") && app.$OraAction && String(app.$OraAction).charAt(0) !== \"{\" && String(app.$OraAction).indexOf(\"ora.Invoke(\") < 0) { action = String(app.$OraAction); } return { kind: \"action\", actionCode: action, payload: payload };",
