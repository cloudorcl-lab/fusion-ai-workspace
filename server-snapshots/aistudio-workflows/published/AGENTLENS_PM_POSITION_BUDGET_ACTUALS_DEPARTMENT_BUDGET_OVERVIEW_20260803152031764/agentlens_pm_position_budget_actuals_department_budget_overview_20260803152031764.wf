            "sourceCode": "var raw = $context.$app && $context.$app.$OraCommParamsToFill ? $context.$app.$OraCommParamsToFill : \"\"; var ids = []; var parts = []; var text = String(raw || \"\"); var match; var i; var id; var re = /\"id\"\\s*:\\s*\"([^\"]+)\"/g; while ((match = re.exec(text)) !== null) { ids.push(match[1]); } if (!ids.length) { re = /id=\\\\\"([^\"]+)\\\\\"/g; while ((match = re.exec(text)) !== null) { ids.push(match[1]); } } for (i = 0; i < ids.length; i += 1) { id = String(ids[i] || \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\"); if (id) { parts.push(\"<parameter id=\\\"\" + id + \"\\\"></parameter>\"); } } return parts.join(\"\");",
