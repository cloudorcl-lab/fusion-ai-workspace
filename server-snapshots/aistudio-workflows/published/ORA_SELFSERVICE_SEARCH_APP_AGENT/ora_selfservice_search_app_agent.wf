        {
          "metadata": {
            "name": "Normalize Input Query",
            "returnType": "string",
            "sourceCode": "function normalizeQuery(q) {\n  if (!q) return \"\";\n\n  const stopWords = new Set([\n    // pure request fluff\n    \"looking\",\"look\",\"find\",\"search\",\"want\",\"need\",\"please\",\"help\",\"show\",\"get\",\"give\",\"tell\",\"fetch\",\"retrieve\",\"list\",\n\n    // conversational noise\n    \"i\",\"me\",\"my\",\"mine\",\"we\",\"our\",\"you\",\"your\",\"us\",\n\n    // connectors (light filtering)\n    \"for\",\"to\",\"of\",\"in\",\"on\",\"at\",\"by\",\"with\",\"from\"\n  ]);\n\n  const cleaned = q\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, \" \")\n    .split(/\\s+/)\n    .filter(w => w && !stopWords.has(w))\n    .join(\" \")\n    .trim();\n\n  return cleaned.length > 0 ? cleaned : q.toLowerCase();\n}\n\nreturn normalizeQuery($context.$system.$inputMessage);"
          },
          "outcomes": {
            "success": "1775143158602"
          },
          "code": "NORMALIZE_INPUT_QUERY",
          "convergenceTargetId": "1776685199884",
          "id": "1776656303598",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
