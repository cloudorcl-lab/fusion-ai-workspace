        {
          "metadata": {
            "name": "Get Flattened Phrases",
            "returnType": "object",
            "sourceCode": "\nconst payload = JSON.parse($context.$nodes.GET_SELFSERVICE_SEARCH_AGENT_MAP.$output.items[0].payload);\nconst agentsObj = payload.what.facts.agents;\n\n// agentCodes\nconst agentCodes = Object.keys(agentsObj);\n\n// agentCodes as string\nconst agentCodesString = `(${agentCodes.map(a => `'${a}'`).join(\",\")})`;\n\n// flattened in required format\nconst flattened = Object.entries(agentsObj).flatMap(([agentCode, data]) =>\n  data.embeddingPhrases.map(phrase =>\n    `Agent=${agentCode} | ${phrase.trim()}`\n  )\n);\n\nreturn [agentCodes, agentCodesString, flattened];"
          },
          "outcomes": {
            "success": "1776682852711"
          },
          "code": "GET_FLATTENED_PHRASES",
          "convergenceTargetId": "1776656303598",
          "id": "1776682689978",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
