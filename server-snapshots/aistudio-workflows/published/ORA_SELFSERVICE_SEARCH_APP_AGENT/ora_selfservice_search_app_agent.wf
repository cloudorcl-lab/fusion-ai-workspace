              "name": "offset",
              "type": "string"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"WorkflowCode\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "Get Agent Descriptions",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.GET_AGENT_DETAILS.$output;\n\nconst agentCodesSet = new Set($context.$nodes.GET_FLATTENED_PHRASES.$output.result[0]);\n\nconst items = response.items || [];\n\n// filter + map to required fields only\nconst result = items\n  .filter(item =>\n    item.Status === \"PUBLISHED\" && agentCodesSet.has(item.WorkflowCode)\n  )\n  .map(item => ({\n    workflowcode: item.WorkflowCode,\n    description: item.Description\n  }));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776682364589"
          },
          "code": "GET_AGENT_DESCRIPTIONS",
          "convergenceTargetId": "1776656303598",
          "id": "1776683161302",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Determine Based on Intent"
          },
          "outcomes": {
            "success": "1776685299708"
          },
          "code": "DETERMINE_BASED_ON_INTENT",
          "convergenceTargetId": "1776656303598",
          "id": "1776682364589",
          "inputs": [
            {
              "id": "1776682364592_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent router for agent selection.\n\nTask:\nGiven user query {{$context.$system.$inputMessage}} and a list of candidate agents with descriptions {{$context.$nodes.GET_AGENT_DESCRIPTIONS.$output.result}}, decide whether the query clearly matches exactly one agent.\n\nRules:\n1. Select an agent only if the query has explicit wording that directly matches that agent’s description.\n2. If the query is not explicitly supported by the agent description, return \"NA\".\n3. Do not infer intent from generic business actions such as add, update, modify, change, set, remove, quantity, line items, item, details, info, create, or manage.\n4. Do not infer that a query is about orders unless the query explicitly mentions order or orders.\n5. Do not infer that a query is about quotes unless the query explicitly mentions quote or quotes.\n6. Do not use vague semantic similarity as enough reason to select an agent.\n7. If the query is broad, generic, or only loosely related to the description, return \"NA\".\n8. If multiple agents could fit, return \"NA\".\n9. Output valid JSON only. No extra text.\n10. If the query does not contain one of the exact domain anchor words from the descriptions, return \"NA\"."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"agent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "CheckIntentBasedAgentCode"
          },
          "outcomes": {
