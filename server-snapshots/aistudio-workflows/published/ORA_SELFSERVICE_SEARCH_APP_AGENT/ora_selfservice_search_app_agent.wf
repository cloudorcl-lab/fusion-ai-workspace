          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"array\",\n  \"items\": {\n    \"type\": \"object\",\n    \"properties\": {\n      \"index\": {\n        \"type\": \"integer\"\n      },\n      \"text\": {\n        \"type\": \"string\"\n      }\n    },\n    \"required\": [\n      \"index\",\n      \"text\"\n    ]\n  }\n}",
          "type": "VECTOR_DB_READER"
        },
        {
          "metadata": {
            "name": "fetchAgent",
            "returnType": "string",
            "sourceCode": "const descriptionResults = $context.$nodes.SEARCHDESCRIPTION.$output || [];\nconst phraseResults = $context.$nodes.SEARCHPHRASES.$output || [];\n\nconst MIN_VECTOR_SCORE = 0.70;\nconst SOURCE_WEIGHTS = {\n  description: 0.4,\n  phrases: 0.6\n};\n\nlet agentScores = {};\n\nfunction getAgentName(row) {\n  return row.text.split(\"|\")[0].replace(\"Agent=\", \"\").trim();\n}\n\nfunction getMaxPositiveTextScore(results) {\n  let maxTextScore = 0;\n  for (let i = 0; i < results.length; i++) {\n    const ts = results[i].textSearchScore || 0;\n    if (ts > maxTextScore) {\n      maxTextScore = ts;\n    }\n  }\n  return maxTextScore;\n}\n\nfunction normalizeTextScore(ts, maxTs) {\n  if (ts <= 0 || maxTs <= 0) return 0;\n  return ts / maxTs;\n}\n\nfunction processResults(results, sourceWeight) {\n  const maxTextScore = getMaxPositiveTextScore(results);\n\n  for (let i = 0; i < results.length; i++) {\n    const row = results[i];\n    const v = row.vectorSearchScore;\n\n    if (v === -1) continue;\n\n    const agent = getAgentName(row);\n    const t = normalizeTextScore(row.textSearchScore || 0, maxTextScore);\n\n    if (!agentScores[agent]) {\n      agentScores[agent] = {\n        total: 0,\n        count: 0,\n        maxVector: 0\n      };\n    }\n\n    // Vector is the main signal; text is a secondary boost.\n    // Then apply source-level weight: description = 0.4, phrases = 0.6\n    const combined = sourceWeight * ((0.85 * v) + (0.15 * t));\n\n    agentScores[agent].total += combined;\n    agentScores[agent].count += 1;\n    agentScores[agent].maxVector = Math.max(agentScores[agent].maxVector, v);\n  }\n}\n\nprocessResults(descriptionResults, SOURCE_WEIGHTS.description);\nprocessResults(phraseResults, SOURCE_WEIGHTS.phrases);\n\n// choose best agent\nlet bestAgent = \"NA\";\nlet bestScore = -1;\n\nfor (let agent in agentScores) {\n  const data = agentScores[agent];\n  const avgScore = data.total / data.count;\n\n  // small support boost for repeated hits\n  const finalScore = avgScore + (0.02 * (data.count - 1));\n\n  if (finalScore > bestScore) {\n    bestScore = finalScore;\n    bestAgent = agent;\n  }\n}\n\n// gate on vector confidence\nreturn agentScores[bestAgent] && agentScores[bestAgent].maxVector > MIN_VECTOR_SCORE\n  ? bestAgent\n  : \"NA\";"
          },
          "outcomes": {
            "success": "1776158967869"
          },
          "code": "FETCHAGENT",
          "convergenceTargetId": "1776685199884",
