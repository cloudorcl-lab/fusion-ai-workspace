          "code": "DETERMINE_BASED_ON_INTENT_IT1",
          "id": "1776685940042",
          "inputs": [
            {
              "id": "1776685940069_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an intent router for agent selection.\n\nTask:\nGiven user query {{$context.$nodes.DETERMINE_QUERY_TYPE.$output}} and a list of candidate agents with descriptions {{$context.$nodes.GET_AGENT_DESCRIPTIONS.$output.result}}, decide whether the query clearly matches exactly one agent.\n\nRules:\nIf ACTIVE_CONTEXT is present and not UNKNOWN, it overrides all older history.\nRoute based only on ACTIVE_CONTEXT.\n1. Return an agent name only if the query explicitly and unambiguously matches that agent’s domain.\n2. If the query does not contain a clear domain noun or domain-specific intent, return \"NA\".\n3. Do not infer domain from generic action words such as add, update, modify, change, set, remove, quantity, details, or info.\n4. Do not guess.\n5. Do not select the closest agent.\n6. If the query could belong to more than one agent, return \"NA\".\n7. If the query is a generic item-operation request without an explicit domain term like order or quote, return \"NA\".\n8. Use the agent descriptions as the source of truth.\n9. Output valid JSON only. No extra text.\n10. If the query is generic or ambiguous and multiple domain entities appear in the input:\n    - Select the agent based on the most recent explicit domain/entity mentioned.\n    - Ignore older domain mentions unless the latest one is absent or unclear."
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"agent\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
