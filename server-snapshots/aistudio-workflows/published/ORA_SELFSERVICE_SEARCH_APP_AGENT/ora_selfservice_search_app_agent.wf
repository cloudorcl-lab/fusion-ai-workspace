        {
          "metadata": {
            "name": "Normalize Input Query IT1",
            "returnType": "object",
            "sourceCode": "function normalizeQuery(q) {\n  if (!q) return \"\";\n\n  const stopWords = new Set([\n    // pure request fluff\n    \"looking\",\"look\",\"find\",\"search\",\"want\",\"need\",\"please\",\"help\",\"show\",\"get\",\"give\",\"tell\",\"fetch\",\"retrieve\",\"list\",\n\n    // conversational noise\n    \"i\",\"me\",\"my\",\"mine\",\"we\",\"our\",\"you\",\"your\",\"us\",\n\n    // connectors (light filtering)\n    \"for\",\"to\",\"of\",\"in\",\"on\",\"at\",\"by\",\"with\",\"from\"\n  ]);\n\n  const cleaned = q\n    .toLowerCase()\n    .replace(/[^a-z0-9\\s]/g, \" \")\n    .split(/\\s+/)\n    .filter(w => w && !stopWords.has(w))\n    .join(\" \")\n    .trim();\n\n  return cleaned.length > 0 ? cleaned : q.toLowerCase();\n}\n\nreturn normalizeQuery($context.$nodes.DETERMINE_QUERY_TYPE.$output);"
          },
          "outcomes": {
            "success": "1776215784868"
          },
          "code": "NORMALIZE_INPUT_QUERY_IT1",
          "id": "1776686201076",
          "inputs": [],
