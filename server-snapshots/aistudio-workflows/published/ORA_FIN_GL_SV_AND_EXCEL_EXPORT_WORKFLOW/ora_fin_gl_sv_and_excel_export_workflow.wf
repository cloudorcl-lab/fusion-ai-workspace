{
  "workflowId": "300000331067532",
  "workflowCode": "ORA_FIN_GL_SV_AND_EXCEL_EXPORT_WORKFLOW",
  "name": "Smart View and Excel Export Assistance",
  "description": "The Smart View and Excel Export Assistance provides ability to export the result to Smart View or Excel.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
