        {
          "metadata": {
            "errorNodeId": "1777610935101",
            "name": "Select SmartView Row Dimensions"
          },
          "outcomes": {
            "success": "1777941755350"
          },
          "code": "FIN_GL_LLM_RESULTS_EXPORT_SMART_VIEW_ROW_DIMENSION_SELECTOR",
          "id": "1777941755349",
          "inputs": [
            {
              "id": "1777941755349_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are a Smart View row-dimension selector for an Oracle Fusion Financials export workflow.\n\nReturn exactly one minified JSON object and nothing else.\n\nOutput schema:\n{\"rowDimensionKeys\":[\"<metadata segment key>\"]}\n\nGoal:\nSelect the COA segment keys that should be used as Smart View row dimensions for the latest rendered balance result.\n\nInputs:\nCurrent user message:\n{{$context.$system.$inputMessage}}\n\nChat history:\n{{$context.$triggers.REST.$input.chatHistory}}\n\nCOA segment candidates:\n{{$context.$nodes.FIN_GL_CODE_RESULTS_EXPORT_PREPARE_CONTENT.$output.result.smartViewContext.segmentCandidates}}\n\nRules:\n- Chat history is chronological. Use the latest assistant balance response as the source for what the user actually saw. Ignore older balance responses unless the latest user message needs that context.\n- Select only COA segment keys from COA segment candidates. Never return labels, values, descriptions, table text, or keys that are not listed in the candidates.\n- Match displayed segment text to candidates in this order: exact label match, case-insensitive label match, qualifier match, then clear semantic key match.\n- If a displayed label is ambiguous across candidates after those tie-breaks, omit it.\n- Prefer COA segments visible in the latest assistant balance response headline or table. Preserve displayed order: headline dimensions first, then table COA segment columns in displayed order, deduped by key.\n- Do not include non-COA dimensions such as ledger, currency, accounting period, scenario, measures, balance columns, variance columns, action labels, or Smart View/Excel action text.\n- If no displayed COA segment can be inferred from chat history, return an empty rowDimensionKeys array.\n- Do not explain your choice."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"rowDimensionKeys\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    }\n  },\n  \"required\": [\n    \"rowDimensionKeys\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1777610935101",
            "name": "Validate SmartView Row Dimensions",
            "returnType": "object",
            "sourceCode": "const selected = $context.$nodes.FIN_GL_LLM_RESULTS_EXPORT_SMART_VIEW_ROW_DIMENSION_SELECTOR.$output ?? {};\nconst exportContent = $context.$nodes.FIN_GL_CODE_RESULTS_EXPORT_PREPARE_CONTENT.$output.result;\nconst dataPayload = exportContent.dataPayload;\nconst smartViewContext = exportContent.smartViewContext;\nconst metadata = smartViewContext.metadata;\nconst segments = metadata.chartOfAccounts?.segments ?? {};\nconst coreDimensions = metadata.coreDimensions ?? {};\nconst mandatoryCoaSegments = Array.isArray(smartViewContext.mandatoryCoaSegments)\n  ? smartViewContext.mandatoryCoaSegments\n  : [];\n\nconst firstString = (...values) => {\n  for (const value of values) {\n    if (typeof value === \"string\" && value !== \"\") return value;\n  }\n  return \"\";\n};\n\nconst rawKeys = Array.isArray(selected.rowDimensionKeys)\n  ? selected.rowDimensionKeys\n  : [];\nconst canonicalByLower = new Map();\nfor (const key of Object.keys(segments)) {\n  canonicalByLower.set(key.toLowerCase(), key);\n}\n\nconst appendValidKey = (target, rawKey) => {\n  if (typeof rawKey !== \"string\") return;\n  const canonical = canonicalByLower.get(rawKey.trim().toLowerCase());\n  if (canonical && !target.includes(canonical)) {\n    target.push(canonical);\n  }\n};\n\nconst rowDimensionKeys = [];\nfor (const rawKey of rawKeys) {\n  appendValidKey(rowDimensionKeys, rawKey);\n}\n\nlet rowDimensionKeysSource = \"llm\";\nif (rowDimensionKeys.length === 0) {\n  rowDimensionKeysSource = \"mandatoryFallback\";\n  for (const rawKey of mandatoryCoaSegments) {\n    appendValidKey(rowDimensionKeys, rawKey);\n  }\n}\n\nconst rowLabels = rowDimensionKeys\n  .map((key) => firstString(segments[key]?.label, key))\n  .filter((label) => label !== \"\");\nrowLabels.push(firstString(coreDimensions.currency?.label, \"Currency\"));\n\nconst rowAxisDimensionList = Array.from(new Set(rowLabels)).join(\",\");\nconst firstRetrievalQuery = dataPayload.queries[0];\n\nconst smartViewPayload = {\n  chartOfAccountsId: dataPayload.chartOfAccountsId,\n  expandAggregateDataByOneLevel: dataPayload.expandAggregateDataByOneLevel,\n  expandBasedOnAccountType: dataPayload.expandBasedOnAccountType,\n  expandOnMember: dataPayload.expandOnMember,\n  dimensionsInfo: {\n    simplifiedColAxisDimensionList: exportContent.smartView.colAxisDimensionList,\n    simplifiedRowAxisDimensionList: rowAxisDimensionList\n  },\n  queries: [firstRetrievalQuery]\n};\n\nconst res = {\n  rowDimensionKeys,\n  rowDimensionKeysSource,\n  rowAxisDimensionList,\n  smartViewPayload\n};\n\nreturn res;"
          },
          "outcomes": {
            "success": "1777611256769"
          },
          "code": "FIN_GL_CODE_RESULTS_EXPORT_VALIDATE_SMART_VIEW_ROW_DIMENSIONS",
          "id": "1777941755350",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
