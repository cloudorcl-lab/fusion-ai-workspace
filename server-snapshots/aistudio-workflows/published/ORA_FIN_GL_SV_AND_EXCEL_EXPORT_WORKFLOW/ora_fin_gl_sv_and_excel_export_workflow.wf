        {
          "metadata": {
            "errorNodeId": "1777610935101",
            "name": "Classify Export Type"
          },
          "outcomes": {
            "success": "1777610652674"
          },
          "code": "FIN_GL_LLM_RESULTS_EXPORT_TYPE_CLASSIFIER",
          "id": "1777610623836",
          "inputs": [
            {
              "id": "1777610623837_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an export type classifier for a Ledger Agent export workflow.\n\nReturn exactly one minified JSON object and nothing else.\n\nAllowed output:\n{\"exportType\":\"EXCEL\"}\n{\"exportType\":\"SMARTVIEW\"}\n\nDecision rules:\n- Return SMARTVIEW only when the current user message explicitly names Smart View or SmartView as the destination or tool for the export.\n- Return EXCEL when the user asks for Excel, spreadsheet export, xlsx, download, export, open, view, or exporting the prior data without explicitly naming Smart View or SmartView as the destination or tool.\n- Use the current user message first. Use chat history only to resolve pronouns or brief follow-ups.\n- Do not decide whether Smart View is supported. That is checked by later deterministic workflow logic.\n- Do not mention implementation details or eligibility rules.\n- Only output a JSON object in the specified shape.\n\nExamples:\n- export this -> {\"exportType\":\"EXCEL\"}\n- download this -> {\"exportType\":\"EXCEL\"}\n- open this in a spreadsheet -> {\"exportType\":\"EXCEL\"}\n- open this in Smart View -> {\"exportType\":\"SMARTVIEW\"}\n- send the prior result to SmartView -> {\"exportType\":\"SMARTVIEW\"}\n\nCurrent user message:\n{{$context.$system.$inputMessage}}\n\nChat history:\n{{$context.$triggers.REST.$input.chatHistory}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"exportType\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"EXCEL\",\n        \"SMARTVIEW\"\n      ]\n    }\n  },\n  \"required\": [\n    \"exportType\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1777610935101",
            "name": "Prepare Export Content",
            "returnType": "object",
            "sourceCode": "const isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst asObject = (value) => (isObject(value) ? value : {});\n\nconst state = asObject($context.$triggers.REST.$input.state);\nconst privateState = asObject(state.private);\nconst lastUsedData = asObject(privateState.lastUsedData);\nconst dataPayload = asObject(lastUsedData.dataPayload);\nconst dataResponse = asObject(lastUsedData.dataResponse);\nconst firstRetrievalQuery = Array.isArray(dataPayload.queries) ? asObject(dataPayload.queries[0]) : {};\n\nconst defaultCoreDimensions = {\n  currencyType: { label: \"Currency Type\" },\n  ledger: { label: \"Ledger\" },\n  currency: { label: \"Currency\" },\n  accountingPeriod: { label: \"AccountingPeriod\" }\n};\n\nconst hasDataPayload = Object.keys(dataPayload).length > 0;\n\nconst payloadString = typeof dataPayload === \"string\" ? dataPayload : JSON.stringify(dataPayload ?? {});\n\nlet exportType = String($context.$nodes.FIN_GL_LLM_RESULTS_EXPORT_TYPE_CLASSIFIER?.$output?.exportType ?? \"\").toUpperCase();\nif (exportType !== \"EXCEL\" && exportType !== \"SMARTVIEW\") {\n  exportType = \"UNKNOWN\";\n}\n\nconst excelPayloadIsAv = firstRetrievalQuery.analyticViews ? true : false;\n\nconst avExtractResult = dataResponse.avExtractResult ?? {};\nconst responseMetadata = avExtractResult.metadata ?? dataResponse.metaData ?? {};\nconst metadata = {\n  ...responseMetadata,\n  coreDimensions: {\n    ...defaultCoreDimensions,\n    ...(responseMetadata.coreDimensions ?? {})\n  }\n};\n\nconst coreDimensions = metadata.coreDimensions;\nconst labelFor = (key, fallback) => {\n  const label = coreDimensions?.[key]?.label;\n  return typeof label === \"string\" && label !== \"\" ? label : fallback;\n};\n\nconst colAxisDimensionList = [\n  labelFor(\"ledger\", \"Ledger\"),\n  labelFor(\"accountingPeriod\", \"AccountingPeriod\"),\n  labelFor(\"currencyType\", \"Currency Type\")\n].join(\",\");\n\nconst segments = metadata.chartOfAccounts?.segments ?? {};\nconst segmentCandidates = Object.keys(segments).map((key) => {\n  const segment = segments[key] ?? {};\n  return {\n    key,\n    label: typeof segment.label === \"string\" && segment.label !== \"\" ? segment.label : key,\n    qualifiers: Array.isArray(segment.qualifiers) ? segment.qualifiers : []\n  };\n});\n\nconst smartViewContext = {\n  metadata,\n  segmentCandidates,\n  mandatoryCoaSegments: Array.isArray(metadata.mandatoryCoaSegments)\n    ? metadata.mandatoryCoaSegments\n    : []\n};\n\nlet smartView = {};\nif (exportType === \"SMARTVIEW\") {\n  const lastUsedQuery = privateState.lastUsedQuery;\n  const queryPayload = lastUsedQuery?.queryPayload;\n  const firstInputQuery = Array.isArray(queryPayload?.queries) ? queryPayload.queries[0] : undefined;\n\n  if (!isObject(lastUsedQuery) || !isObject(queryPayload) || !isObject(firstInputQuery)) {\n    throw new Error(\"Smart View export requires state.private.lastUsedQuery.queryPayload.queries[0].\");\n  }\n\n  smartView = {\n    avName: firstInputQuery.analyticView,\n    ledgerContext: Array.isArray(firstInputQuery.ledgerContext)\n      ? firstInputQuery.ledgerContext[0]\n      : firstInputQuery.ledgerContext,\n    colAxisDimensionList\n  };\n}\n\nconst response = {\n  exportType,\n  hasDataPayload,\n  dataPayload,\n  excelPayloadIsAv,\n  isSmartViewAllowed: payloadString.includes(\"oraErpCoreAccountBalancesRuntime\"),\n  smartView,\n  smartViewContext\n};\n\nreturn response;"
          },
          "outcomes": {
            "success": "1777610763550"
          },
          "code": "FIN_GL_CODE_RESULTS_EXPORT_PREPARE_CONTENT",
          "id": "1777610652674",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
