          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1777610935101",
            "name": "Build Excel Result Response",
            "returnType": "object",
            "sourceCode": "let boOutput = {};\nif ($context.$nodes.FIN_GL_CODE_RESULTS_EXPORT_PREPARE_CONTENT.$output.result.excelPayloadIsAv) {\n  boOutput = $context.$nodes.FIN_GL_BO_FUNCTION_RESULTS_EXPORT_ANALYTIC_VIEW_TO_EXCEL.$output;\n} else {\n  boOutput = $context.$nodes.FIN_GL_BO_FUNCTION_RESULTS_EXPORT_BUSINESS_VIEW_TO_EXCEL.$output;\n}\n\nconst message = boOutput?.message;\nconst status = boOutput?.status;\nconst accepted = message.toLowerCase().includes(\"job submitted successfully\");\n\nlet response;\nif (accepted) {\n  response = {\n    status: \"success\",\n    successMessage: \"async\",\n  };\n} else {\n  response = {\n    status: \"error\",\n    errorDetails: {\n      message: \"Your export request was unsuccessful.\",\n      cause: \"DATA_EXTRACT\",\n      details: boOutput,\n    },\n  };\n}\n\nreturn response;"
          },
          "outcomes": {
            "success": "1777690778360"
          },
