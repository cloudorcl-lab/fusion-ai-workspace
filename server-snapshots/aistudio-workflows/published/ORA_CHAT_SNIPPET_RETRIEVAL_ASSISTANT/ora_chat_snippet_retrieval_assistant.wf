        {
          "metadata": {
            "name": "Link Format Instructions",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let result = '';\nlet buOrgId = $context.$nodes.BUORGID.$output.result;\nlet output = $context.$nodes.GET_DYNAMIC_LINKS.$output;\nlet linkFormat = '';\n\nif (output && output.items) {\n  if (buOrgId) {\n    for (let i = 0; i < output.items.length; i++) {\n      let item = output.items[i];\n      if (item && item.BUOrgId) {\n        linkFormat = item.CustomerPortalURL;\n        break;\n      }\n    }\n  }\n\n  if (!linkFormat) {\n    for (let i = 0; i < output.items.length; i++) {\n      let item = output.items[i];\n      if (item && !item.BUOrgId) {\n        linkFormat = item.CustomerPortalURL;\n        break;\n      }\n    }\n  }\n}\n\nif (linkFormat) {\n  result = `-- generate html link <a  class=\"oj-omnichannel-knowledge-article-link\" href=\"${linkFormat}\">{title}</a>\n-- replace href format string placeholder '{0}' with reference AnswerId property\n-- replace {title} with reference title\n-- keep entire url string intact replacing only the placeholder portion\n-- do not include \"rel\" or \"target\" attributes, only \"href\"`;\n} else {\n  result = `-- Title\n-- Answer Id\n-- Document Id`;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771373620568"
          },
          "code": "LINK_FORMAT_INSTRUCTIONS",
          "id": "1774368049035",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5245,
            "y": 9068
          }
        },
        {
          "metadata": {
            "name": "References Prompt",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let prompt = '';\nlet items = $context.$nodes.FOR_EACH_SEARCH_RESULT.$input.collection;\nlet results = $context.$nodes.FOR_EACH_SEARCH_RESULT.$output;\nlet resultsMap = {};\n\nfor (let i = 0; i < results.length; i++) {\n  let result = JSON.parse(results[i]);\n  if (result && result.recordId) {\n    resultsMap[result.recordId] = result;\n  }\n}\n\nif (items && items.length > 0) {\n  for (let i = 0; i < items.length; i++) {\n    let item = items[i];\n    let article = resultsMap[item.recordId];\n    let ref = null;\n    let contentBody = '';\n\n    if (article && article.links) {\n      for (let j = 0; j < article.links.length; j++) {\n        let link = article.links[j];\n        if (link && link.rel === 'canonical') {\n          ref = link.href;\n          break;\n        }\n      }\n    }\n\n    if (article && article.contentBody) {\n      if (article.contentBody.ANSWER) {\n        contentBody = article.contentBody.ANSWER.value;\n      } else if (article.contentBody.RESOLUTION) {\n        contentBody = article.contentBody.RESOLUTION.value;\n      } else if (article.contentBody.SUMMARY) {\n        contentBody = article.contentBody.SUMMARY.value;\n      } else {\n        contentBody = 'No Data Available';\n      }\n    }\n\n    prompt += '\\n---\\n' +\n      'answerId: ' + item.answerId + '\\n' +\n      'title: ' + item.title + '\\n' +\n      'ref: ' + ref + '\\n' +\n      'content:\\n' + contentBody + '\\n---\\n\\n';\n  }\n} else {\n  prompt = 'No Data Available';\n}\n\nreturn prompt;"
          },
          "outcomes": {
            "success": "1771373507380"
          },
          "code": "REFERENCES_PROMPT",
          "id": "1771373620568",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
