        {
          "metadata": {
            "name": "Search Parameters",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "let inputRaw = $context.$system.$inputMessage;\nlet input = JSON.parse(inputRaw);\n\nlet validMinScore = '0.7';\nif (input && input.minScore) {\n  let minScore = Number(input.minScore);\n  if (Number.isFinite(minScore) && minScore > 0 && minScore <= 1.0) {\n    validMinScore = String(minScore);\n  }\n}\n\nlet stripeCd = input.stripeCd ? input.stripeCd : 'ORA_SVC_CRM';\nlet productsClause = input.contextualData && input.contextualData.productId ? `and products eq '${input.contextualData.productId}'` : '';\nlet categoriesClause = input.contextualData && input.contextualData.categoryId ? `and categories eq '${input.contextualData.categoryId}'` : '';\nlet buOrgIdClause = input.buOrgId ? `and businessUnits.businessUnitOrgId in ('${input.buOrgId}')` : '';\nlet srtParam = `minScore=${validMinScore}`;\n\nlet result = {\n  stripeCd: stripeCd,\n  productsClause: productsClause,\n  categoriesClause: categoriesClause,\n  buOrgIdClause: buOrgIdClause,\n  srtParam: srtParam\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771537658960"
          },
          "code": "SEARCH_PARAMETERS",
          "id": "1771626693405",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
