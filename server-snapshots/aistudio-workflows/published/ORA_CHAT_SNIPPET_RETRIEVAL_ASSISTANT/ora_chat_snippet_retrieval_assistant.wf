            "sourceCode": "let kmList = [];\nif ($context.$nodes.KM_RESULTS.$output && $context.$nodes.KM_RESULTS.$output.result) {\n  kmList = $context.$nodes.KM_RESULTS.$output.result;\n}\n\nlet stList = [];\nif ($context.$nodes.SMART_TEXT_RESULTS.$output && $context.$nodes.SMART_TEXT_RESULTS.$output.result) {\n  stList = $context.$nodes.SMART_TEXT_RESULTS.$output.result;\n}\n\nlet outputJson = {\n  suggestions: [...kmList, ...stList]\n};\n\nreturn JSON.stringify(outputJson);"
