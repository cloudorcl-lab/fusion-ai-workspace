        {
          "metadata": {
            "name": "KM Basic Snippets",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "let articles = [];\nif ($context.$nodes.KM_SEARCH.$output && $context.$nodes.KM_SEARCH.$output.items) {\n  articles = $context.$nodes.KM_SEARCH.$output.items;\n}\n\nlet snippets = [];\nfor (let i = 0; i < articles.length; i++) {\n  let article = articles[i];\n  let internalLink = null;\n  if (article.links) {\n    for (let j = 0; j < article.links.length; j++) {\n      let link = article.links[j];\n      if (link && link.rel === 'canonical') {\n        internalLink = link.href;\n        break;\n      }\n    }\n  }\n\n  let title = article.title ? article.title : '';\n  snippets.push({\n    id: 'km-basic-' + i + '-' + article.answerId,\n    source: 'KM',\n    sourceLabel: 'Knowledge',\n    score: String(article.score),\n    scoreNumber: article.score,\n    suggestionText: title,\n    configs: {\n      answerId: String(article.answerId),\n      documentId: article.documentId,\n      title: title,\n      internalLink: internalLink,\n      generatedByAI: false,\n      versionId: article.versionId,\n      htmlFlag: false,\n      question: '',\n      agentRequestId: ''\n    }\n  });\n}\n\nreturn snippets;"
          },
          "outcomes": {
            "success": "1763581070270"
          },
