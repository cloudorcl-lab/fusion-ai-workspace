          "metadata": {
            "name": "get message history",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let storedMessagesJson = $context.$variables.messagesHistory;\nlet combinedMessages = storedMessagesJson;\nlet input = $context.$system.$inputMessage;\n\nif (storedMessagesJson) {\n  try {\n    let inputJson = JSON.parse(input);\n    storedMessagesJson.chat.messages = [...storedMessagesJson.chat.messages, ...inputJson.chat.messages];\n    combinedMessages = JSON.stringify(storedMessagesJson);\n  } catch (e) {\n    combinedMessages = input;\n  }\n} else {\n  combinedMessages = input;\n}\n\nreturn combinedMessages;"
          },
          "outcomes": {
            "success": "1767892020051"
          },
          "code": "GET_MESSAGE_HISTORY",
          "id": "1767891904660",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
