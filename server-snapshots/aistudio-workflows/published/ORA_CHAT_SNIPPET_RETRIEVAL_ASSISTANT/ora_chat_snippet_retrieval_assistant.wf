        {
          "metadata": {
            "name": "KM Intelligent Snippet",
            "language": "JAVASCRIPT",
            "returnType": "object",
            "sourceCode": "let items = $context.$nodes.FOR_EACH_SEARCH_RESULT.$input.collection;\nlet loopResults = $context.$nodes.FOR_EACH_SEARCH_RESULT.$output;\nlet resultsMap = {};\n\nfor (let i = 0; i < loopResults.length; i++) {\n  let parsed = JSON.parse(loopResults[i]);\n  if (parsed && parsed.recordId) {\n    resultsMap[parsed.recordId] = parsed;\n  }\n}\n\nlet result = null;\nlet item = items && items.length > 0 ? items[0] : null;\nif (item) {\n  let article = resultsMap[item.recordId];\n  if (article) {\n    let internalLink = null;\n    if (article.links) {\n      for (let i = 0; i < article.links.length; i++) {\n        let link = article.links[i];\n        if (link && link.rel === \"canonical\") {\n          internalLink = link.href;\n          break;\n        }\n      }\n    }\n\n    let title = article.title ? article.title : item.title;\n    let answerId = article.answerId ? article.answerId : item.answerId;\n    result = {\n      id: \"km-intelligent-\" + item.recordId + \"-\" + answerId,\n      source: \"KM\",\n      sourceLabel: \"Knowledge\",\n      score: String(item.score),\n      scoreNumber: item.score,\n      suggestionText: $context.$nodes.GENERATE_ANSWER_TEXT.$output.result,\n      configs: {\n        answerId: String(answerId),\n        documentId: article.documentId,\n        title: title,\n        internalLink: internalLink,\n        generatedByAI: true,\n        versionId: article.versionId,\n        htmlFlag: true,\n        question: $context.$nodes.PROBLEM_STATEMENT_TEXT.$output.result\n      }\n    };\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1763581070270"
          },
          "code": "KM_INTELLIGENT_SNIPPET",
          "id": "1771374329510",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
