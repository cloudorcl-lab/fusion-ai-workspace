        {
          "metadata": {
            "name": "Smart Texts Stripe CD",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let input = JSON.parse( $context.$system.$inputMessage );\nlet stripeCd = input.stripeCd ? input.stripeCd : 'ORA_SVC_CRM';\nif (stripeCd === 'ORA_SVC_HCM') {\n  stripeCd = 'ORA_SVC_HRHD';\n}\n\nreturn stripeCd;"
          },
          "outcomes": {
            "success": "1763513392098"
          },
          "code": "SMART_TEXTS_STRIPE_CD",
          "id": "1771893290570",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5020,
            "y": 7031
          }
