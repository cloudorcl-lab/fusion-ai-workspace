        {
          "metadata": {
            "name": "KM Search Post Process",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "let result = [];\n\nif ( $context.$nodes.FOR_EACH_SEARCH_RESULT.$output && $context.$nodes.FOR_EACH_SEARCH_RESULT.$output.length > 0 && $context.$nodes.KM_INTELLIGENT_SNIPPET.$output && $context.$nodes.KM_INTELLIGENT_SNIPPET.$output.result) {\n  result.push($context.$nodes.KM_INTELLIGENT_SNIPPET.$output.result);\n} else if ($context.$nodes.KM_BASIC_SNIPPETS.$output && $context.$nodes.KM_BASIC_SNIPPETS.$output.result) {\n  result.push(...$context.$nodes.KM_BASIC_SNIPPETS.$output.result);\n}\n\nreturn result;"
          },
