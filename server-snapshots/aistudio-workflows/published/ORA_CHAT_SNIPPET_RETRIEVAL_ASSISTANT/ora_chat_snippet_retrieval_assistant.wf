            "returnType": "array",
            "sourceCode": "let result = [];\n\nif ($context.$nodes.CHANNEL_TYPE.$output.result === 'ORA_SVC_CHAT' && $context.$nodes.SMART_TEXT_POST_PROCESS.$output && $context.$nodes.SMART_TEXT_POST_PROCESS.$output.result) {\n  result.push(...$context.$nodes.SMART_TEXT_POST_PROCESS.$output.result);\n}\n\nreturn result;"
          },
