        {
          "metadata": {
            "name": "Problem Statement"
          },
          "outcomes": {
            "success": "1775146001001"
          },
          "code": "PROBLEM_STATEMENT",
          "id": "1771537658960",
          "inputs": [
            {
              "id": "1771537658961_1",
              "name": "prompt",
              "type": "string",
              "value": "You will be provided with a chat transcript between customer and customer service representative(s).  \n\nA chat consists of an identifier and a list of messages. \n\nEach message has the following properties:\n- identifier\n- sender\n  - name\n  - resource:\n    - name\n    - resourceType: one of: [HUMAN, BOT, END_USER, AGENT, SUPERVISOR]. END_USER is considered the customer, all others are part of the customer service center\n  - role: one of: [UNKNOWN, END_USER, TRANSIENT, LEAD, CONFEREE, MONITOR, COACH]. Again, END_USER is considered the customer, all others are roles within the customer service center\n\n\n## instructions\nCreate a question that describes the problem that the customer wants solved:\n- The question should be no more than 300 characters. \n- The question should be stated in the form of a question as if posed by the customer.\n- The question should be as concise as possible intended to serve well as the input to a semantic document search.\n- The question should be only the most recent question the customer wants solved. If multiple questions are asked within the same chat transcript, focus only on the most recent unsolved question.\n\n\n## chat transcript\n{{$context.$variables.messagesHistory}}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"string\"\n}",
          "type": "LLM",
          "diagram": {
            "x": 5470,
            "y": 7253
          }
        },
        {
          "metadata": {
            "name": "Smart Text Post Process",
            "language": "JAVASCRIPT",
            "returnType": "array",
            "sourceCode": "let smartTexts = [];\nif ($context.$nodes.SMART_TEXT.$output && $context.$nodes.SMART_TEXT.$output.items) {\n  smartTexts = $context.$nodes.SMART_TEXT.$output.items;\n}\n\nlet converted = [];\nfor (let i = 0; i < smartTexts.length; i++) {\n  let smartText = smartTexts[i];\n  converted.push({\n    id: smartText.StdTxtId,\n    source: \"SM\",\n    scoreNumber: 0.8,\n    suggestionText: smartText.StdtxtName,\n    configs: {\n      stdTxtId: smartText.StdTxtId,\n      stdtxtName: smartText.StdtxtName,\n      text: smartText.Text,\n      htmlFlag: smartText.HtmlFlag,\n      subDomain: smartText.SubDomain,\n      scope: smartText.Scope\n    }\n  });\n}\n\nreturn converted;"
          },
          "outcomes": {
            "success": "1771443029535"
          },
          "code": "SMART_TEXT_POST_PROCESS",
          "id": "1763580793299",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5020,
            "y": 7475
          }
        },
        {
          "metadata": {
            "name": "Problem Statement Text",
            "language": "JAVASCRIPT",
            "returnType": "string",
            "sourceCode": "let value = $context.$nodes.PROBLEM_STATEMENT.$output;\nlet result = \"\";\n\nif (typeof value === \"string\") {\n  result = value.trim();\n} else if (value && typeof value.question === \"string\") {\n  result = value.question.trim();\n} else if (value && typeof value.description === \"string\") {\n  result = value.description.trim();\n} else if (value && typeof value.default === \"string\") {\n  result = value.default.trim();\n} else if (value && value.result) {\n  if (typeof value.result === \"string\") {\n    result = value.result.trim();\n  } else if (typeof value.result.question === \"string\") {\n    result = value.result.question.trim();\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1771442371133"
          },
          "code": "PROBLEM_STATEMENT_TEXT",
          "id": "1775146001001",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5470,
            "y": 7475
          }
