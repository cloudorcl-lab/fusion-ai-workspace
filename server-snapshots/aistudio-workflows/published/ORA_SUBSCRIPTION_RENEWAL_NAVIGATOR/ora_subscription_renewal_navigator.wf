                          "code": "BRANCH_GET_SOURCE_PRODUCT_IDS",
                          "id": "1865000000011",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        },
                        {
                          "metadata": {
                            "businessObjectCode": "ORA_CX_OSS_SUBSCRIPTION_AGGREGATES",
                            "functionName": "get_metric_details_aggregation",
                            "processJson": true,
                            "name": "Get Runtime Metric Details"
                          },
                          "outcomes": {
                            "success": "1865000000014"
                          },
                          "code": "BRANCH_GET_RUNTIME_METRIC_DETAILS",
                          "id": "1865000000012",
                          "inputs": [
                            {
                              "id": "1865000000013",
                              "name": "ProductIds",
                              "type": "string",
                              "value": "{{$context.$nodes.BRANCH_GET_SOURCE_PRODUCT_IDS.$output.result.inClause}}"
                            }
                          ],
                          "outputSpecification": "{}",
                          "type": "BO_FUNCTION"
                        },
                        {
                          "metadata": {
                            "name": "Build Product Chunk",
                            "returnType": "object",
                            "sourceCode": "const pick = (obj, ...keys) => {\n  if (!obj || typeof obj !== \"object\") return null;\n  for (const key of keys) {\n    const value = obj[key];\n    if (value !== undefined && value !== null && value !== \"\") return value;\n  }\n  return null;\n};\n\nconst num = (value) => {\n  const n = typeof value === \"number\" ? value : typeof value === \"string\" ? Number(value) : NaN;\n  return Number.isFinite(n) ? n : null;\n};\n\nconst percentNum = (value) => {\n  if (value === null || value === undefined || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(String(value).replace(\"%\", \"\").trim());\n  return Number.isFinite(n) ? n : null;\n};\n\nconst normalizeTcvWeightage = (value) => {\n  const parsed = percentNum(value);\n  if (parsed === null) return null;\n  return parsed > 0 && parsed <= 1 ? parsed * 100 : parsed;\n};\n\nconst normLevel = (level) => {\n  if (level === null || level === undefined) return null;\n  const value = String(level).toLowerCase();\n  if (value.includes(\"high\")) return \"High\";\n  if (value.includes(\"medium\")) return \"Medium\";\n  if (value.includes(\"low\")) return \"Low\";\n  return null;\n};\n\nconst safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst toTime = (value) => {\n  const t = Date.parse(value);\n  return Number.isFinite(t) ? t : null;\n};\n\nconst mappingRows = Array.isArray($context.$nodes.BRANCH_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output)\n  ? $context.$nodes.BRANCH_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output\n  : [];\nconst metricRows = Array.isArray($context.$nodes.BRANCH_GET_RUNTIME_METRIC_DETAILS.$output)\n  ? $context.$nodes.BRANCH_GET_RUNTIME_METRIC_DETAILS.$output\n  : [];\n\nconst findMetricRow = (rows, typeCode, unitRegex) =>\n  rows.filter((row) => row.metricTypeCode === typeCode).find((row) => unitRegex.test(String(row.metricUnit || \"\"))) || null;\n\nconst getMetricNumber = (rows, typeCode, unitRegex) => {\n  const row = findMetricRow(rows, typeCode, unitRegex);\n  return num(row?.metricValue) ?? num(row?.metricAmount) ?? null;\n};\n\nconst getRiskForProduct = (rows, typeCode, levelPrefix, scorePrefix) => {\n  const byType = rows.filter((row) => row.metricTypeCode === typeCode);\n  const levelRow = byType.find((row) => /Risk Level/i.test(String(row.metricUnit || \"\"))) || null;\n  const scoreRow = byType.find((row) => /Risk Score/i.test(String(row.metricUnit || \"\"))) || null;\n\n  const explainLevel = safeJsonParse(levelRow?.metricExplainability) || {};\n  const explainScore = safeJsonParse(scoreRow?.metricExplainability) || {};\n\n  const level =\n    normLevel(levelRow?.metricClassification) ||\n    normLevel(explainLevel[levelPrefix + \"RiskLevel\"]) ||\n    normLevel(explainLevel[levelPrefix[0].toUpperCase() + levelPrefix.slice(1) + \"RiskLevel\"]) ||\n    normLevel(explainScore[levelPrefix + \"RiskLevel\"]) ||\n    null;\n\n  const score =\n    num(scoreRow?.metricScore) ??\n    num(explainScore[scorePrefix + \"RiskScore\"]) ??\n    num(explainScore[scorePrefix[0].toUpperCase() + scorePrefix.slice(1) + \"RiskScore\"]) ??\n    num(explainLevel[scorePrefix + \"RiskScore\"]) ??\n    null;\n\n  return { level, score };\n};\n\nconst mappingBySourceId = new Map();\nfor (const row of mappingRows) {\n  const sourceId = Number(row.sourceSubsProdId);\n  if (Number.isFinite(sourceId) && !mappingBySourceId.has(sourceId)) {\n    mappingBySourceId.set(sourceId, row);\n  }\n}\n\nconst metricsBySourceId = new Map();\nfor (const row of metricRows) {\n  const sourceId = Number(row.subscriptionProductId);\n  if (!Number.isFinite(sourceId)) continue;\n  if (!metricsBySourceId.has(sourceId)) metricsBySourceId.set(sourceId, []);\n  metricsBySourceId.get(sourceId).push(row);\n}\n\nconst sourceIds = Array.from(new Set([\n  ...Array.from(mappingBySourceId.keys()),\n  ...Array.from(metricsBySourceId.keys())\n]));\n\nconst histogram = { unknown: { High: 0, Medium: 0, Low: 0 } };\nconst churnCounts = { High: 0, Medium: 0, Low: 0 };\nconst totals = { revenue: 0, serviceCost: 0, margin: 0 };\nconst riskCounts = { High: 0, Medium: 0, Low: 0 };\nconst topRiskProducts = [];\nconst ensureBin = (key) => {\n  if (!histogram[key]) histogram[key] = { High: 0, Medium: 0, Low: 0 };\n};\nconst severity = (level) => (level === \"High\" ? 3 : level === \"Medium\" ? 2 : 1);\n\nlet subscriptionId = null;\nlet subscriptionNumber = null;\nlet subscriptionStartDate = null;\nlet subscriptionStartTime = null;\nlet subscriptionEndDate = null;\nlet subscriptionEndTime = null;\nlet renewalDateLatest = null;\nlet renewalDateLatestTime = null;\nlet customerName = null;\nconst currencies = new Set();\n\nfor (const sourceId of sourceIds) {\n  const mapping = mappingBySourceId.get(sourceId) || {};\n  const rows = metricsBySourceId.get(sourceId) || [];\n  const financial = getRiskForProduct(rows, \"ORA_FINANCIAL\", \"financial\", \"financial\");\n  const churn = getRiskForProduct(rows, \"ORA_CHURN\", \"churn\", \"churn\");\n  const financialLevel = financial.level || \"Low\";\n  const churnLevel = churn.level || \"Low\";\n\n  const targetSubscriptionId = pick(mapping, \"targetSubscriptionId\");\n  const targetSubscriptionNumber = pick(mapping, \"targetSubscriptionNum\");\n  const productName = pick(mapping, \"targetProductName\", \"sourceProductName\", \"productName\", \"ProductName\") ?? null;\n  const customerNameValue = pick(mapping, \"customerName\", \"partyName\", \"accountName\") ?? null;\n  const currency = pick(mapping, \"currency\", \"Currency\", \"transactionCurrencyCode\") ?? null;\n\n  if (subscriptionId === null && targetSubscriptionId !== null) {\n    const n = Number(targetSubscriptionId);\n    if (Number.isFinite(n)) subscriptionId = n;\n  }\n  if (!subscriptionNumber && targetSubscriptionNumber) subscriptionNumber = targetSubscriptionNumber;\n  if (!customerName && customerNameValue) customerName = customerNameValue;\n  if (currency) currencies.add(currency);\n\n  const startDate = pick(mapping, \"subscriptionStartDate\", \"targetProductStartDate\", \"targetStartDate\", \"startDate\", \"subscriptionProductStartDate\");\n  const endDate = pick(mapping, \"subscriptionEndDate\", \"targetProductEndDate\", \"targetEndDate\", \"endDate\", \"subscriptionProductEndDate\");\n  const renewalDate = pick(mapping, \"targetProductEndDate\", \"targetEndDate\", \"endDate\", \"subscriptionEndDate\", \"subscriptionProductEndDate\");\n\n  const startTime = toTime(startDate);\n  if (startTime !== null && (subscriptionStartTime === null || startTime < subscriptionStartTime)) {\n    subscriptionStartTime = startTime;\n    subscriptionStartDate = startDate;\n  }\n\n  const endTime = toTime(endDate);\n  if (endTime !== null && (subscriptionEndTime === null || endTime > subscriptionEndTime)) {\n    subscriptionEndTime = endTime;\n    subscriptionEndDate = endDate;\n  }\n\n  const renewalTime = toTime(renewalDate);\n  if (renewalTime !== null && (renewalDateLatestTime === null || renewalTime > renewalDateLatestTime)) {\n    renewalDateLatestTime = renewalTime;\n    renewalDateLatest = renewalDate;\n  }\n\n  const tcvWeightage = normalizeTcvWeightage(getMetricNumber(rows, \"ORA_MARGIN\", /Relative TCV weightage/i));\n  const binKey = tcvWeightage === null ? \"unknown\" : String(Math.max(0, Math.min(100, Math.floor(tcvWeightage))));\n\n  ensureBin(binKey);\n  histogram[binKey][financialLevel] += 1;\n  churnCounts[churnLevel] += 1;\n\n  const productRisk =\n    financialLevel === \"High\" || churnLevel === \"High\"\n      ? \"High\"\n      : financialLevel === \"Medium\" || churnLevel === \"Medium\"\n        ? \"Medium\"\n        : \"Low\";\n  riskCounts[productRisk] += 1;\n\n  const netPrice = num(pick(mapping, \"netPrice\", \"targetNetPrice\", \"subscriptionNetPrice\"))\n    ?? getMetricNumber(rows, \"ORA_DISCOUNT\", /TCV Net Price/i)\n    ?? getMetricNumber(rows, \"ORA_MARGIN\", /TCV Net Price/i);\n  const serviceCost = getMetricNumber(rows, \"ORA_MARGIN\", /Service Cost/i);\n  const marginValue = getMetricNumber(rows, \"ORA_MARGIN\", /^Margin$/i);\n\n  totals.revenue += netPrice || 0;\n  totals.serviceCost += serviceCost || 0;\n  totals.margin += marginValue || 0;\n\n  topRiskProducts.push({\n    subscriptionProductId: pick(mapping, \"targetSubsProdId\", \"targetSubscriptionProductId\") ?? null,\n    subscriptionProductPuid: pick(mapping, \"targetSubsProdPuid\", \"targetSubscriptionProductPuid\") ?? null,\n    productName,\n    financialRiskLevel: financialLevel,\n    churnRiskLevel: churnLevel,\n    tcvWeightage,\n    sortScore: Math.max(severity(financialLevel), severity(churnLevel))\n  });\n}\n\ntopRiskProducts.sort((a, b) =>\n  b.sortScore - a.sortScore ||\n  (b.tcvWeightage ?? -1) - (a.tcvWeightage ?? -1)\n);\n\nreturn {\n  batchNumber: $context.$nodes.BRANCH_FETCH_LOOP.$currentItem.batchNumber ?? null,\n  productCount: sourceIds.length,\n  mappingRowCount: mappingRows.length,\n  metricRowCount: metricRows.length,\n  mappingSourceIdCount: mappingBySourceId.size,\n  metricSourceIdCount: metricsBySourceId.size,\n  sourceIdsSample: sourceIds.slice(0, 5),\n  contextBase: {\n    subscriptionId,\n    subscriptionNumber,\n    customerName,\n    subscriptionStartDate,\n    subscriptionEndDate,\n    renewalDateLatest: renewalDateLatest ?? subscriptionEndDate,\n    currencies: Array.from(currencies)\n  },\n  summaryBase: {\n    productCount: sourceIds.length,\n    riskCounts,\n    churnCounts,\n    financialHistogramByTcv: histogram,\n    totals,\n    topRiskProducts: topRiskProducts.slice(0, 10).map(({ sortScore, ...rest }) => rest)\n  }\n};"
                          },
                          "outcomes": {
                            "success": "1865000000007"
                          },
                          "code": "BRANCH_BUILD_PRODUCT_CHUNK",
                          "convergenceTargetId": "1865000000007",
                          "id": "1865000000014",
                          "inputs": [],
                          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                          "type": "CODE"
                        }
                      ],
                      "rootNode": "1865000000006"
                    },
                    "name": "Branch Fetch Loop",
                    "loopType": "SEQUENTIAL"
                  },
                  "outcomes": {
                    "success": "1865000000017"
                  },
                  "code": "BRANCH_FETCH_LOOP",
                  "id": "1865000000015",
                  "inputs": [
                    {
                      "id": "1865000000016",
                      "name": "collection",
                      "type": "string",
                      "value": "{{$context.$nodes.PARTITION_BRANCH_FETCH_BATCHES.$output.result}}"
                    }
                  ],
                  "type": "LOOP"
                },
                {
                  "metadata": {
                    "name": "Branch Merge Fetched Products",
                    "returnType": "object",
                    "sourceCode": "const safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst extractLoopItems = (raw) => {\n  if (Array.isArray(raw)) return raw;\n  if (Array.isArray(raw?.result)) return raw.result;\n  if (Array.isArray(raw?.items)) return raw.items;\n  if (Array.isArray(raw?.output)) return raw.output;\n  return [];\n};\n\nconst toTime = (value) => {\n  const t = Date.parse(value);\n  return Number.isFinite(t) ? t : null;\n};\n\nconst loopItems = extractLoopItems($context.$nodes.BRANCH_FETCH_LOOP.$output);\nconst chunkResults = loopItems\n  .map((item) => {\n    const parsed = safeJsonParse(item) ?? item;\n    return parsed?.result ?? parsed;\n  })\n  .filter((item) => item && typeof item === \"object\");\n\nconst chunkDebug = chunkResults.map((result, index) => ({\n  chunkIndex: index + 1,\n  batchNumber: result.batchNumber ?? null,\n  productCount: result.productCount ?? 0,\n  mappingRowCount: result.mappingRowCount ?? null,\n  metricRowCount: result.metricRowCount ?? null,\n  mappingSourceIdCount: result.mappingSourceIdCount ?? null,\n  metricSourceIdCount: result.metricSourceIdCount ?? null,\n  sourceIdsSample: Array.isArray(result.sourceIdsSample) ? result.sourceIdsSample : []\n}));\n\nlet subscriptionId = null;\nlet subscriptionNumber = null;\nlet subscriptionStartDate = null;\nlet subscriptionStartTime = null;\nlet subscriptionEndDate = null;\nlet subscriptionEndTime = null;\nlet latestRenewalDate = null;\nlet latestRenewalTime = null;\nlet customerName = null;\nconst currencies = new Set();\n\nfor (const chunk of chunkResults) {\n  const context = chunk.contextBase && typeof chunk.contextBase === \"object\" ? chunk.contextBase : {};\n\n  if (subscriptionId === null && context.subscriptionId !== undefined && context.subscriptionId !== null) {\n    const n = Number(context.subscriptionId);\n    if (Number.isFinite(n)) subscriptionId = n;\n  }\n  if (!subscriptionNumber && context.subscriptionNumber) subscriptionNumber = context.subscriptionNumber;\n  if (!customerName && context.customerName) customerName = context.customerName;\n\n  const startTime = toTime(context.subscriptionStartDate);\n  if (startTime !== null && (subscriptionStartTime === null || startTime < subscriptionStartTime)) {\n    subscriptionStartTime = startTime;\n    subscriptionStartDate = context.subscriptionStartDate;\n  }\n\n  const endTime = toTime(context.subscriptionEndDate);\n  if (endTime !== null && (subscriptionEndTime === null || endTime > subscriptionEndTime)) {\n    subscriptionEndTime = endTime;\n    subscriptionEndDate = context.subscriptionEndDate;\n  }\n\n  const renewalTime = toTime(context.renewalDateLatest);\n  if (renewalTime !== null && (latestRenewalTime === null || renewalTime > latestRenewalTime)) {\n    latestRenewalTime = renewalTime;\n    latestRenewalDate = context.renewalDateLatest;\n  }\n\n  const branchCurrencies = Array.isArray(context.currencies) ? context.currencies : [];\n  for (const currency of branchCurrencies) {\n    if (currency) currencies.add(currency);\n  }\n}\n\nreturn {\n  branchNumber: $context.$nodes.SUMMARY_PARALLEL.$currentItem.branchNumber ?? null,\n  SubscriptionId: subscriptionId ?? $context.$variables.SubscriptionId ?? null,\n  SubscriptionNumber: subscriptionNumber ?? $context.$variables.SubscriptionNumber ?? null,\n  CustomerName: customerName,\n  \"Subscription Start Date\": subscriptionStartDate,\n  \"Subscription End Date\": subscriptionEndDate,\n  RenewalDateLatest: latestRenewalDate ?? subscriptionEndDate,\n  Currencies: Array.from(currencies),\n  Debug: {\n    loopItemCount: loopItems.length,\n    parsedChunkCount: chunkResults.length,\n    productRows: chunkDebug.reduce((sum, item) => sum + Number(item.productCount ?? 0), 0),\n    nonZeroChunks: chunkDebug.filter((item) => (item.productCount ?? 0) > 0).length,\n    zeroProductChunks: chunkDebug.filter((item) => (item.productCount ?? 0) === 0).length,\n    firstChunk: chunkDebug[0] ?? null,\n    lastChunk: chunkDebug.length ? chunkDebug[chunkDebug.length - 1] : null\n  }\n};"
                  },
