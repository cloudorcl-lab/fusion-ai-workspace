        {
          "metadata": {
            "name": "Build Existing Alert Route Map",
            "returnType": "object",
            "sourceCode": "const safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst extractItemsFromNodeOutput = (raw) => {\n  const candidates = [\n    raw,\n    raw?.items,\n    raw?.output,\n    raw?.output?.items,\n    raw?.output?.response,\n    raw?.output?.response?.items,\n    raw?.response,\n    raw?.response?.items,\n    raw?.result,\n    raw?.result?.items\n  ];\n\n  for (const candidate of candidates) {\n    const value = safeJsonParse(candidate) ?? candidate;\n    if (Array.isArray(value)) return value;\n    if (Array.isArray(value?.items)) return value.items;\n    if (Array.isArray(value?.response?.items)) return value.response.items;\n    if (Array.isArray(value?.output?.items)) return value.output.items;\n    if (Array.isArray(value?.output?.response?.items)) return value.output.response.items;\n    if (Array.isArray(value?.result?.items)) return value.result.items;\n  }\n\n  return [];\n};\n\nconst asTime = (date) => {\n  const time = Date.parse(date);\n  return Number.isFinite(time) ? time : -1;\n};\n\nconst alerts = extractItemsFromNodeOutput($context.$nodes.GET_EXISTING_AI_ALERTS_DETAILS?.$output);\nconst latestByKey = new Map();\n\nconst keyForExistingAlert = (alert) => {\n  const isSummary =\n    alert?.AlertCode === \"SUMMARY\" ||\n    alert?.AlertType === \"SUBSCRIPTION_SUMMARY\" ||\n    (\n      alert?.Status === \"INITIAL\" &&\n      !alert?.AlertCode &&\n      !alert?.AlertType &&\n      !alert?.SubscriptionProductId &&\n      !alert?.SubscriptionProductPuid &&\n      alert?.SubscriptionNumber\n    );\n\n  if (isSummary) {\n    return `${alert?.SubscriptionNumber ?? null}-summary`;\n  }\n\n  const productKey = alert?.SubscriptionProductPuid ?? alert?.SubscriptionProductId;\n  return `${productKey ?? null}-${alert?.AlertType ?? null}`;\n};\n\nfor (const alert of alerts) {\n  const id = alert?.SubscriptionAlertId ?? null;\n  if (!id) continue;\n\n  const key = keyForExistingAlert(alert);\n  if (!key || key.includes(\"null\") || key.includes(\"undefined\")) continue;\n\n  const timestamp = Math.max(asTime(alert?.LastUpdateDate), asTime(alert?.CreationDate));\n  const previous = latestByKey.get(key);\n\n  if (!previous || timestamp > previous.timestamp) {\n    latestByKey.set(key, { id: String(id), timestamp });\n  }\n}\n\nconst routesByKey = {};\nfor (const [key, value] of latestByKey.entries()) {\n  routesByKey[key] = {\n    operation: \"update\",\n    path: `/subscriptionAIAlerts/${value.id}`,\n    existingId: value.id\n  };\n}\n\nreturn { routesByKey };"
          },
