          "metadata": {
            "name": "Prepare Brief Facts",
            "returnType": "object",
            "sourceCode": "const merged = $context.$nodes.MERGE_SEGMENTATION_SHARDS.$output.result || {};\nconst segmentation = $context.$nodes.VALIDATE_SEGMENTATION_OUTPUT.$output.result || {};\nconst fetched = $context.$nodes.MERGE_FETCHED_PRODUCTS.$output.result || {};\nconst threshold = String(segmentation.lowTcvWeightageThreshold ?? 5);\n\nconst rank = { Low: 1, Medium: 2, High: 3 };\nconst levelRank = (level) => rank[level] || 0;\nconst num = (value) => {\n  const n = typeof value === \"number\" ? value : typeof value === \"string\" ? Number(value) : NaN;\n  return Number.isFinite(n) ? n : null;\n};\nconst strongerLevel = (a, b) => (levelRank(b) > levelRank(a) ? b : a);\n\nconst rawTopRiskProducts = Array.isArray(merged.topRiskProducts) ? merged.topRiskProducts.filter(Boolean) : [];\nconst meaningfulTopRiskProducts = rawTopRiskProducts.filter((product) =>\n  levelRank(product?.financialRiskLevel) >= 2 || levelRank(product?.churnRiskLevel) >= 2\n);\nconst topRiskSource = meaningfulTopRiskProducts.length ? meaningfulTopRiskProducts : rawTopRiskProducts;\n\nconst groupedTopRiskProducts = Array.from(\n  topRiskSource.reduce((map, product, index) => {\n    const baseProductName =\n      product?.productName ??\n      product?.subscriptionProductPuid ??\n      (product?.subscriptionProductId !== undefined && product?.subscriptionProductId !== null\n        ? String(product.subscriptionProductId)\n        : `Product ${index + 1}`);\n    const key = String(baseProductName).trim().toLowerCase() || `row-${index}`;\n    const existing = map.get(key);\n\n    if (existing) {\n      existing.productCount += 1;\n      existing.financialRiskLevel = strongerLevel(existing.financialRiskLevel, product?.financialRiskLevel ?? null);\n      existing.churnRiskLevel = strongerLevel(existing.churnRiskLevel, product?.churnRiskLevel ?? null);\n      existing.tcvWeightage = Math.max(existing.tcvWeightage ?? -1, num(product?.tcvWeightage) ?? -1);\n    } else {\n      map.set(key, {\n        baseProductName,\n        productCount: 1,\n        financialRiskLevel: product?.financialRiskLevel ?? null,\n        churnRiskLevel: product?.churnRiskLevel ?? null,\n        tcvWeightage: num(product?.tcvWeightage) ?? -1\n      });\n    }\n\n    return map;\n  }, new Map()).values()\n)\n  .sort((a, b) =>\n    Math.max(levelRank(b.financialRiskLevel), levelRank(b.churnRiskLevel)) -\n      Math.max(levelRank(a.financialRiskLevel), levelRank(a.churnRiskLevel)) ||\n    (b.tcvWeightage ?? -1) - (a.tcvWeightage ?? -1) ||\n    (b.productCount ?? 0) - (a.productCount ?? 0) ||\n    String(a.baseProductName).localeCompare(String(b.baseProductName))\n  )\n  .map((product) => ({\n    productName:\n      product.productCount > 1\n        ? `${product.baseProductName} (${product.productCount} products)`\n        : product.baseProductName,\n    productCount: product.productCount,\n    financialRiskLevel: product.financialRiskLevel ?? null,\n    churnRiskLevel: product.churnRiskLevel ?? null,\n    tcvWeightage: product.tcvWeightage >= 0 ? product.tcvWeightage : null\n  }));\n\nconst highRiskProductNames = groupedTopRiskProducts.filter((product) =>\n  levelRank(product.financialRiskLevel) === 3 || levelRank(product.churnRiskLevel) === 3\n);\nconst fallbackHighRiskRowCount = highRiskProductNames.reduce(\n  (sum, product) => sum + (Number(product.productCount) || 1),\n  0\n);\nconst highRiskProductRowCount = Number(merged.riskCounts?.High ?? fallbackHighRiskRowCount);\nconst highRiskProductNameCount = highRiskProductNames.length;\nconst highRiskProductDisplaySummary =\n  highRiskProductRowCount > 0\n    ? highRiskProductRowCount > highRiskProductNameCount\n      ? `${highRiskProductRowCount} high-risk product rows across ${highRiskProductNameCount} product name${highRiskProductNameCount === 1 ? \"\" : \"s\"}`\n      : `${highRiskProductRowCount} high-risk product${highRiskProductRowCount === 1 ? \"\" : \"s\"}`\n    : null;\n\nreturn {\n  subscriptionId: fetched.SubscriptionId ?? $context.$variables.SubscriptionId ?? null,\n  subscriptionNumber: fetched.SubscriptionNumber ?? $context.$variables.SubscriptionNumber ?? null,\n  customerName: fetched.CustomerName ?? null,\n  customerAcceptance: $context.$variables.CustomerAcceptance ?? \"No\",\n  productCounts: merged.productCounts || {},\n  churnCounts: merged.churnCounts || {},\n  riskCounts: merged.riskCounts || { High: 0, Medium: 0, Low: 0 },\n  financialEffectiveCountsAtChosenThreshold: merged.financialEffectiveCountsByThreshold?.[threshold] || { high: 0, medium: 0 },\n  totals: merged.totals || {},\n  topRiskProducts: groupedTopRiskProducts,\n  highRiskProductRowCount,\n  highRiskProductNameCount,\n  highRiskProductDisplaySummary,\n  segmentation\n};"
          },
