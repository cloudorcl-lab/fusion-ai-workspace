                        {
                          "metadata": {
                            "name": "Get Source Product Ids",
                            "returnType": "object",
                            "sourceCode": "const rows = $context.$nodes.BRANCH_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output;\nif (!Array.isArray(rows)) {\n  throw new Error(\"Expected an array from 'Get Subscription Product Details1'\");\n}\n\nconst ids = [...new Set(\n  rows\n    .map(r => r.sourceSubsProdId)\n    .filter(v => v !== null && v !== undefined && v !== \"\")\n)];\n\nreturn {\n  ids,\n  inClause: ids.length ? `(${ids.join(\",\")})` : `(NULL)`\n};"
                          },
