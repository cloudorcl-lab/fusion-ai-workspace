            "sourceCode": "const merged = $context.$nodes.MERGE_FETCHED_PRODUCTS.$output.result || {};\nconst normalized = $context.$nodes.NORMALIZE_REQUEST_PAYLOAD.$output.result || {};\nconst candidateIdsRaw = Array.isArray(merged.DetailCandidates) && merged.DetailCandidates.length\n  ? merged.DetailCandidates\n  : (Array.isArray(normalized.ProductIds) ? normalized.ProductIds : []);\n\nconst uniqueIds = Array.from(new Set(candidateIdsRaw));\nconst chunkSize = 25;\nconst out = [];\nfor (let i = 0; i < uniqueIds.length; i += chunkSize) {\n  out.push({\n    batchNumber: out.length + 1,\n    productIds: uniqueIds.slice(i, i + chunkSize)\n  });\n}\n\nreturn out;"
