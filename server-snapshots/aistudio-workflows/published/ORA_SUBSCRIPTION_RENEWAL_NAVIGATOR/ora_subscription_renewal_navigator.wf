            "name": "Merge Segmentation Shards",
            "returnType": "object",
            "sourceCode": "const extractShardArray = (value) => {\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value?.result)) return value.result;\n  if (Array.isArray(value?.items)) return value.items;\n  if (Array.isArray(value?.output)) return value.output;\n  return [];\n};\n\nconst safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst rawLoopOutput = $context.$nodes.SEGMENTATION_SUMMARY_LOOP?.$output;\nconst fetched = $context.$nodes.MERGE_FETCHED_PRODUCTS.$output.result || {};\n\nconst shards = extractShardArray(rawLoopOutput)\n  .map((item) => {\n    const parsed = safeJsonParse(item) ?? item;\n    return parsed?.result ?? parsed;\n  })\n  .filter((item) => item && typeof item === \"object\");\n\nconst merged = {\n  subscriptionNumber: fetched.SubscriptionNumber ?? $context.$variables.SubscriptionNumber ?? null,\n  customerAcceptance: $context.$variables.CustomerAcceptance ?? \"No\",\n  productCounts: {\n    total: Number($context.$nodes.NORMALIZE_REQUEST_PAYLOAD.$output.result.ProductCount ?? 0),\n    deduped: 0\n  },\n  churnCounts: { High: 0, Medium: 0, Low: 0 },\n  riskCounts: { High: 0, Medium: 0, Low: 0 },\n  financialHistogramByTcv: { unknown: { High: 0, Medium: 0, Low: 0 } },\n  totals: { revenue: 0, serviceCost: 0, margin: 0 },\n  topRiskProducts: []\n};\n\nconst ensureBin = (key) => {\n  if (!merged.financialHistogramByTcv[key]) {\n    merged.financialHistogramByTcv[key] = { High: 0, Medium: 0, Low: 0 };\n  }\n};\n\nfor (const shard of shards) {\n  merged.productCounts.deduped += Number(shard.productCount ?? 0);\n  merged.churnCounts.High += Number(shard.churnCounts?.High ?? 0);\n  merged.churnCounts.Medium += Number(shard.churnCounts?.Medium ?? 0);\n  merged.churnCounts.Low += Number(shard.churnCounts?.Low ?? 0);\n\n  merged.riskCounts.High += Number(shard.riskCounts?.High ?? 0);\n  merged.riskCounts.Medium += Number(shard.riskCounts?.Medium ?? 0);\n  merged.riskCounts.Low += Number(shard.riskCounts?.Low ?? 0);\n\n  merged.totals.revenue += Number(shard.totals?.revenue ?? 0);\n  merged.totals.serviceCost += Number(shard.totals?.serviceCost ?? 0);\n  merged.totals.margin += Number(shard.totals?.margin ?? 0);\n\n  const hist = shard.financialHistogramByTcv || {};\n  for (const key of Object.keys(hist)) {\n    ensureBin(key);\n    merged.financialHistogramByTcv[key].High += Number(hist[key]?.High ?? 0);\n    merged.financialHistogramByTcv[key].Medium += Number(hist[key]?.Medium ?? 0);\n    merged.financialHistogramByTcv[key].Low += Number(hist[key]?.Low ?? 0);\n  }\n\n  if (Array.isArray(shard.topRiskProducts)) {\n    merged.topRiskProducts.push(...shard.topRiskProducts);\n  }\n}\n\nconst severity = (product) =>\n  product.churnRiskLevel === \"High\" || product.financialRiskLevel === \"High\"\n    ? 3\n    : product.churnRiskLevel === \"Medium\" || product.financialRiskLevel === \"Medium\"\n      ? 2\n      : 1;\n\nmerged.topRiskProducts.sort((a, b) =>\n  severity(b) - severity(a) ||\n  (b.tcvWeightage ?? -1) - (a.tcvWeightage ?? -1)\n);\nmerged.topRiskProducts = merged.topRiskProducts.slice(0, 10);\n\nconst financialEffectiveCountsByThreshold = {};\nfor (let threshold = 0; threshold <= 100; threshold += 1) {\n  let high = Number(merged.financialHistogramByTcv.unknown?.High ?? 0);\n  let medium = Number(merged.financialHistogramByTcv.unknown?.Medium ?? 0);\n\n  for (let bin = threshold; bin <= 100; bin += 1) {\n    const bucket = merged.financialHistogramByTcv[String(bin)] || {};\n    high += Number(bucket.High ?? 0);\n    medium += Number(bucket.Medium ?? 0);\n  }\n\n  financialEffectiveCountsByThreshold[String(threshold)] = { high, medium };\n}\n\nreturn {\n  ...merged,\n  financialEffectiveCountsByThreshold\n};"
          },
          "outcomes": {
            "success": "1778673254471"
          },
          "code": "MERGE_SEGMENTATION_SHARDS",
          "id": "1779297735209",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
