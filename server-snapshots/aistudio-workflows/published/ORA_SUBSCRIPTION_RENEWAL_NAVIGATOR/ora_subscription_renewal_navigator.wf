        {
          "metadata": {
            "name": "Prepare Engagement Summary Facts",
            "returnType": "object",
            "sourceCode": "const brief = $context.$nodes.PREPARE_BRIEF_FACTS.$output.result || {};\nconst merged = $context.$nodes.MERGE_FETCHED_PRODUCTS.$output.result || {};\n\nconst months = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\nconst toNum = (v) => { const n = typeof v === \"number\" ? v : typeof v === \"string\" ? Number(v) : NaN; return Number.isFinite(n) ? n : null; };\nconst toDate = (v) => { const t = Date.parse(v); return Number.isFinite(t) ? new Date(t) : null; };\nconst fmtDate = (v) => { const d = toDate(v); return d ? `${d.getUTCDate()} ${months[d.getUTCMonth()]} ${d.getUTCFullYear()}` : null; };\nconst formatAmount = (value) => {\n  const n = toNum(value);\n  if (n === null) return null;\n  const negative = n < 0 ? \"-\" : \"\";\n  const abs = Math.abs(n);\n  const fixed = abs.toFixed(2);\n  let [whole, fraction] = fixed.split(\".\");\n  whole = whole.replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n  fraction = fraction.replace(/0+$/, \"\");\n  return negative + whole + (fraction ? \".\" + fraction : \"\");\n};\nconst term = (s, e) => {\n  const sd = toDate(s), ed = toDate(e);\n  if (!sd || !ed || ed < sd) return null;\n  let m = (ed.getUTCFullYear() - sd.getUTCFullYear()) * 12 + (ed.getUTCMonth() - sd.getUTCMonth());\n  if (ed.getUTCDate() < sd.getUTCDate()) m -= 1;\n  if (m < 0) m = 0;\n  const y = Math.floor(m / 12), mo = m % 12;\n  if (y > 0 && mo > 0) return `${y} year${y === 1 ? \"\" : \"s\"} ${mo} month${mo === 1 ? \"\" : \"s\"}`;\n  if (y > 0) return `${y} year${y === 1 ? \"\" : \"s\"}`;\n  return `${mo} month${mo === 1 ? \"\" : \"s\"}`;\n};\n\nconst currencies = Array.isArray(merged.Currencies) ? merged.Currencies.filter(Boolean) : [];\nconst amount = toNum(brief.totals?.revenue);\nconst currency = currencies.length === 1 ? currencies[0] : currencies.length > 1 ? \"mixed currencies\" : null;\nconst display = amount != null && currency ? `${formatAmount(amount)} ${currency}` : amount != null ? formatAmount(amount) : null;\nconst churnHigh = Number(brief.churnCounts?.High ?? 0);\nconst churnMedium = Number(brief.churnCounts?.Medium ?? 0);\nconst finHigh = Number(brief.financialEffectiveCountsAtChosenThreshold?.high ?? 0);\nconst finMedium = Number(brief.financialEffectiveCountsAtChosenThreshold?.medium ?? 0);\nconst deduped = Number(brief.productCounts?.deduped ?? brief.productCounts?.total ?? 0);\nconst actualRiskCounts = brief.riskCounts || {};\n\nconst rank = { Low: 1, Medium: 2, High: 3 };\nconst mapped = Array.isArray(brief.topRiskProducts) ? brief.topRiskProducts.map((p) => {\n  const fr = rank[p.financialRiskLevel] || 0;\n  const cr = rank[p.churnRiskLevel] || 0;\n  const groupedCountRaw = typeof p.productCount === \"number\" ? p.productCount : typeof p.productCount === \"string\" ? Number(p.productCount) : NaN;\n  const productCount = Number.isFinite(groupedCountRaw) && groupedCountRaw > 0 ? groupedCountRaw : 1;\n  const riskType = cr >= fr && cr >= 2 ? \"churn\" : fr >= 2 ? \"financial\" : null;\n  const driver = riskType === \"financial\" ? \"high financial risk flagged in source metrics\" : riskType === \"churn\" ? \"high churn risk flagged in source metrics\" : null;\n  return {\n    productName: p.productName ?? null,\n    productCount,\n    riskType,\n    driver,\n    financialRiskLevel: p.financialRiskLevel ?? null,\n    churnRiskLevel: p.churnRiskLevel ?? null,\n    financialRank: fr,\n    churnRank: cr\n  };\n}) : [];\n\nconst highRiskProducts = mapped.filter((p) => p.financialRank === 3 || p.churnRank === 3);\nconst mediumRiskProducts = mapped.filter((p) => p.financialRank === 2 || p.churnRank === 2);\n\nconst highCount = Number(actualRiskCounts.High ?? (brief.segmentation?.riskProfile === \"High\" ? Math.max(finHigh, churnHigh) : 0));\nconst mediumCount = Number(actualRiskCounts.Medium ?? (brief.segmentation?.riskProfile === \"Medium\" ? Math.max(finMedium, churnMedium) : 0));\nconst lowCountRaw = Number(actualRiskCounts.Low ?? NaN);\nconst lowCount = Number.isFinite(lowCountRaw) ? lowCountRaw : Math.max(0, deduped - highCount - mediumCount);\nconst displayedHighRiskProducts = highRiskProducts.slice(0, 5).map(({ financialRank, churnRank, ...rest }) => rest);\nconst displayedPrimaryMedium = mediumRiskProducts[0] ? (({ financialRank, churnRank, ...rest }) => rest)(mediumRiskProducts[0]) : null;\nconst representedHighRiskCount = displayedHighRiskProducts.reduce((sum, product) => sum + (Number(product.productCount) || 1), 0);\nconst highRiskProductNameCount = highRiskProducts.length;\nconst highRiskGroupingSummary =\n  highCount > 0\n    ? highCount > highRiskProductNameCount\n      ? `${highCount} high-risk product rows across ${highRiskProductNameCount} product name${highRiskProductNameCount === 1 ? \"\" : \"s\"}`\n      : `${highCount} high-risk product${highCount === 1 ? \"\" : \"s\"}`\n    : null;\n\nreturn {\n  CustomerName: brief.customerName ?? merged.CustomerName ?? null,\n  RenewalDateLatest: merged.RenewalDateLatest ?? merged[\"Subscription End Date\"] ?? null,\n  RenewalDateDisplay: fmtDate(merged.RenewalDateLatest ?? merged[\"Subscription End Date\"] ?? null),\n  ContractValue: { amount, currency, display },\n  ContractTerm: { startDate: merged[\"Subscription Start Date\"] ?? null, endDate: merged[\"Subscription End Date\"] ?? null, display: term(merged[\"Subscription Start Date\"] ?? null, merged[\"Subscription End Date\"] ?? null) },\n  RiskCounts: { High: highCount, Medium: mediumCount, Low: lowCount },\n  HighRiskProducts: brief.segmentation?.riskProfile === \"High\" ? displayedHighRiskProducts : [],\n  HighRiskProductRowCount: highCount,\n  HighRiskProductNameCount: highRiskProductNameCount,\n  HighRiskGroupingSummary: highRiskGroupingSummary,\n  AdditionalHighRiskCount: Math.max(0, highCount - representedHighRiskCount),\n  PrimaryMediumRiskProduct: brief.segmentation?.riskProfile === \"Medium\" ? displayedPrimaryMedium : null,\n  ExplicitExpansionSignals: [],\n  ActionContext: { hasChurnRisk: churnHigh > 0 || churnMedium > 0, hasFinancialRisk: finHigh > 0 || finMedium > 0 }\n};"
          },
          "outcomes": {
