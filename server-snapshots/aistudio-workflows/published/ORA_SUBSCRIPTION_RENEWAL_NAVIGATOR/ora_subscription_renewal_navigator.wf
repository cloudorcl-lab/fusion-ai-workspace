                {
                  "metadata": {
                    "name": "Build Branch Summary Base",
                    "returnType": "object",
                    "sourceCode": "const extractLoopItems = (raw) => {\n  if (Array.isArray(raw)) return raw;\n  if (Array.isArray(raw?.result)) return raw.result;\n  if (Array.isArray(raw?.items)) return raw.items;\n  if (Array.isArray(raw?.output)) return raw.output;\n  return [];\n};\n\nconst safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst loopItems = extractLoopItems($context.$nodes.BRANCH_FETCH_LOOP?.$output);\nconst chunkResults = loopItems\n  .map((item) => {\n    const parsed = safeJsonParse(item) ?? item;\n    return parsed?.result ?? parsed;\n  })\n  .filter((item) => item && typeof item === \"object\");\n\nconst merged = {\n  productCount: 0,\n  riskCounts: { High: 0, Medium: 0, Low: 0 },\n  churnCounts: { High: 0, Medium: 0, Low: 0 },\n  financialHistogramByTcv: { unknown: { High: 0, Medium: 0, Low: 0 } },\n  totals: { revenue: 0, serviceCost: 0, margin: 0 },\n  topRiskProducts: []\n};\n\nconst ensureBin = (key) => {\n  if (!merged.financialHistogramByTcv[key]) {\n    merged.financialHistogramByTcv[key] = { High: 0, Medium: 0, Low: 0 };\n  }\n};\n\nfor (const chunk of chunkResults) {\n  const summary = chunk.summaryBase && typeof chunk.summaryBase === \"object\" ? chunk.summaryBase : null;\n  if (!summary) continue;\n\n  merged.productCount += Number(summary.productCount ?? 0);\n  merged.riskCounts.High += Number(summary.riskCounts?.High ?? 0);\n  merged.riskCounts.Medium += Number(summary.riskCounts?.Medium ?? 0);\n  merged.riskCounts.Low += Number(summary.riskCounts?.Low ?? 0);\n\n  merged.churnCounts.High += Number(summary.churnCounts?.High ?? 0);\n  merged.churnCounts.Medium += Number(summary.churnCounts?.Medium ?? 0);\n  merged.churnCounts.Low += Number(summary.churnCounts?.Low ?? 0);\n\n  merged.totals.revenue += Number(summary.totals?.revenue ?? 0);\n  merged.totals.serviceCost += Number(summary.totals?.serviceCost ?? 0);\n  merged.totals.margin += Number(summary.totals?.margin ?? 0);\n\n  const hist = summary.financialHistogramByTcv || {};\n  for (const key of Object.keys(hist)) {\n    ensureBin(key);\n    merged.financialHistogramByTcv[key].High += Number(hist[key]?.High ?? 0);\n    merged.financialHistogramByTcv[key].Medium += Number(hist[key]?.Medium ?? 0);\n    merged.financialHistogramByTcv[key].Low += Number(hist[key]?.Low ?? 0);\n  }\n\n  if (Array.isArray(summary.topRiskProducts)) {\n    merged.topRiskProducts.push(...summary.topRiskProducts.filter(Boolean));\n  }\n}\n\nconst severity = (product) =>\n  product?.churnRiskLevel === \"High\" || product?.financialRiskLevel === \"High\"\n    ? 3\n    : product?.churnRiskLevel === \"Medium\" || product?.financialRiskLevel === \"Medium\"\n      ? 2\n      : 1;\n\nmerged.topRiskProducts.sort((a, b) =>\n  severity(b) - severity(a) ||\n  (Number(b?.tcvWeightage) || -1) - (Number(a?.tcvWeightage) || -1)\n);\nmerged.topRiskProducts = merged.topRiskProducts.slice(0, 10).map(({ sortScore, ...rest }) => rest);\n\nreturn {\n  batchNumber: $context.$nodes.SUMMARY_PARALLEL.$currentItem.branchNumber ?? 1,\n  productCount: merged.productCount,\n  riskCounts: merged.riskCounts,\n  churnCounts: merged.churnCounts,\n  financialHistogramByTcv: merged.financialHistogramByTcv,\n  totals: merged.totals,\n  topRiskProducts: merged.topRiskProducts\n};"
                  },
