                },
                {
                  "metadata": {
                    "name": "Build Detail Alert Batch Parts",
                    "returnType": "object",
                    "sourceCode": "const safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst pick = (obj, ...keys) => {\n  if (!obj || typeof obj !== \"object\") return null;\n  for (const key of keys) {\n    const value = obj[key];\n    if (value !== undefined && value !== null && value !== \"\") return value;\n  }\n  return null;\n};\n\nconst num = (value) => {\n  const n = typeof value === \"number\" ? value : typeof value === \"string\" ? Number(value) : NaN;\n  return Number.isFinite(n) ? n : null;\n};\n\nconst percentNum = (value) => {\n  if (value === null || value === undefined || value === \"\") return null;\n  const n = typeof value === \"number\" ? value : Number(String(value).replace(\"%\", \"\").trim());\n  return Number.isFinite(n) ? n : null;\n};\n\nconst normLevel = (level) => {\n  if (level === null || level === undefined) return null;\n  const value = String(level).toLowerCase();\n  if (value.includes(\"high\")) return \"High\";\n  if (value.includes(\"medium\")) return \"Medium\";\n  if (value.includes(\"low\")) return \"Low\";\n  return null;\n};\n\nconst asObject = (value) =>\n  value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n\nconst cleanLabel = (value) =>\n  typeof value === \"string\"\n    ? (value.replace(/\\\\\"/g, \"\").trim() || null)\n    : value ?? null;\n\nconst omitEmpty = (value) => {\n  if (value === null || value === undefined) return undefined;\n\n  if (Array.isArray(value)) {\n    const arr = value\n      .map(omitEmpty)\n      .filter((item) =>\n        item !== undefined &&\n        item !== null &&\n        !(typeof item === \"string\" && item.trim() === \"\") &&\n        !(Array.isArray(item) && item.length === 0) &&\n        !(typeof item === \"object\" && !Array.isArray(item) && Object.keys(item).length === 0)\n      );\n    return arr.length ? arr : undefined;\n  }\n\n  if (typeof value !== \"object\") return value;\n\n  const out = {};\n  for (const [key, item] of Object.entries(value)) {\n    const cleaned = omitEmpty(item);\n    const emptyObject = cleaned && typeof cleaned === \"object\" && !Array.isArray(cleaned) && Object.keys(cleaned).length === 0;\n    const emptyArray = Array.isArray(cleaned) && cleaned.length === 0;\n    const emptyString = typeof cleaned === \"string\" && cleaned.trim() === \"\";\n    if (cleaned === undefined || cleaned === null || emptyObject || emptyArray || emptyString) continue;\n    out[key] = cleaned;\n  }\n  return Object.keys(out).length ? out : undefined;\n};\n\nconst cleanTierList = (value) =>\n  Array.isArray(value)\n    ? value.map((item) =>\n        item && typeof item === \"object\"\n          ? {\n              ...item,\n              ...(item.label !== undefined ? { label: cleanLabel(item.label) } : {})\n            }\n          : item\n      )\n    : undefined;\n\nconst formatNumber = (value, digits = 3) => {\n  const n = num(value);\n  if (n === null) return null;\n  return Number(n.toFixed(digits)).toString();\n};\n\nconst joinWithAnd = (items) => {\n  const cleanItems = items.filter(Boolean);\n  if (!cleanItems.length) return \"\";\n  if (cleanItems.length === 1) return cleanItems[0];\n  if (cleanItems.length === 2) return cleanItems[0] + \" and \" + cleanItems[1];\n  return cleanItems.slice(0, -1).join(\", \") + \", and \" + cleanItems[cleanItems.length - 1];\n};\n\nconst impactCodeFromLevel = (level) =>\n  level === \"High\" ? \"ORA_HIGH\" :\n  level === \"Medium\" ? \"ORA_MEDIUM\" :\n  level === \"Low\" ? \"ORA_LOW\" :\n  null;\n\nconst defaultFinancialClassification = [\n  { min: 0, max: 0.3, label: \"Low\" },\n  { min: 0.31, max: 0.6, label: \"Medium\" },\n  { min: 0.61, max: 1, label: \"High\" }\n];\n\nconst defaultMarginClassification = [\n  { deltaMaxInclusive: 0, label: \"At or above target\", riskScore: 0.1 },\n  { deltaMinExclusive: 0, deltaMaxInclusive: 5, label: \"Below target by <= 5 percentage points\", riskScore: 0.4 },\n  { deltaMinExclusive: 5, deltaMaxInclusive: 10, label: \"Below target by >5 and <=10 percentage points\", riskScore: 0.7 },\n  { deltaMinExclusive: 10, label: \"Below target by >10 points\", riskScore: 1 }\n];\n\nconst defaultDiscountClassification = [\n  { minExclusive: -100, maxInclusive: 20, label: \"Within standard policy (<=20%)\", riskScore: 0.1 },\n  { minExclusive: 20, maxInclusive: 25, label: \"Minor exception (>20% and <=25%)\", riskScore: 0.4 },\n  { minExclusive: 25, maxInclusive: 30, label: \"Large exception (>25% and <=30%)\", riskScore: 0.7 },\n  { minExclusive: 30, label: \"Deep discount beyond tolerance (>30%)\", riskScore: 1 }\n];\n\nconst defaultChurnClassification = {\n  \"0.00 - 0.30\": \"Low\",\n  \"0.31 - 0.60\": \"Medium\",\n  \"0.61 - 1.00\": \"High\"\n};\n\nconst defaultTrendClassification = [\n  { usageChange: \"Growth >= +10%\", category: \"Growing\", trendRiskScore: 0.0 },\n  { usageChange: \"Between -10% and +10%\", category: \"Stable\", trendRiskScore: 0.1 },\n  { usageChange: \"Decline 10% - 25%\", category: \"Slight Decline\", trendRiskScore: 0.4 },\n  { usageChange: \"Decline 25% - 50%\", category: \"Clear Decline\", trendRiskScore: 0.7 },\n  { usageChange: \"Decline > 50%\", category: \"Sharp Sustained Decline\", trendRiskScore: 1.0 }\n];\n\nconst defaultUtilizationClassification = [\n  { utilization_range: \">= 80%\", category: \"High Utilization\", risk_score: 0.1 },\n  { utilization_range: \"60% - 79%\", category: \"Moderate Utilization\", risk_score: 0.4 },\n  { utilization_range: \"40% - 59%\", category: \"Low Utilization\", risk_score: 0.7 },\n  { utilization_range: \"< 40%\", category: \"Very Low Utilization\", risk_score: 1.0 }\n];\n\nconst defaultSupportClassification = [\n  { condition: \"No tickets in window\", risk_score: 0.1, risk_level: \"Very Low\" },\n  { condition: \">=8 non-critical tickets (bugs or how to)\", risk_score: 0.6, risk_level: \"Medium-High\" },\n  { condition: \">=2 critical tickets (resolved)\", risk_score: 0.7, risk_level: \"High\" },\n  { condition: \"Any open critical escalation\", risk_score: 1.0, risk_level: \"Critical\" }\n];\n\nconst defaultRelationshipClassification = {\n  Positive: 0.0,\n  Neutral: 0.2,\n  Negative: 1.0\n};\n\nconst normalizeClassificationArray = (value, fallback) => {\n  const cleaned = cleanTierList(value);\n  return Array.isArray(cleaned) && cleaned.length ? cleaned : fallback;\n};\n\nconst normalizeRangeObject = (value, fallback) => {\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n  if (Array.isArray(value) && value.length) {\n    const out = {};\n    for (const item of value) {\n      if (!item || typeof item !== \"object\") continue;\n      const label = cleanLabel(item.label ?? item.category ?? item.risk_level);\n      if (!label) continue;\n      const min = item.min ?? item.minInclusive ?? item.minExclusive;\n      const max = item.max ?? item.maxInclusive ?? item.maxExclusive;\n      if (min !== undefined || max !== undefined) {\n        const minText = min !== undefined && min !== null ? formatNumber(min, 2) : \"0.00\";\n        const maxText = max !== undefined && max !== null ? formatNumber(max, 2) : \"1.00\";\n        out[minText + \" - \" + maxText] = label;\n      }\n    }\n    return Object.keys(out).length ? out : fallback;\n  }\n  return fallback;\n};\n\nconst deriveDiscountLevel = (discountPct) => {\n  const pct = num(discountPct);\n  if (pct === null) return null;\n  if (pct <= 20) return \"Within standard policy (<=20%)\";\n  if (pct <= 25) return \"Minor exception (>20% and <=25%)\";\n  if (pct <= 30) return \"Large exception (>25% and <=30%)\";\n  return \"Deep discount beyond tolerance (>30%)\";\n};\n\nconst deriveMarginStatus = (expected, actual) => {\n  const exp = num(expected);\n  const act = num(actual);\n  if (exp === null || act === null) return null;\n  const delta = exp - act;\n  if (delta <= 0) return \"At or above target\";\n  if (delta <= 5) return \"Below target by <= 5 percentage points\";\n  if (delta <= 10) return \"Below target by >5 and <=10 percentage points\";\n  return \"Below target by >10 points\";\n};\n\nconst deriveTrendRiskLevel = (usageChangePct) => {\n  const pct = num(usageChangePct);\n  if (pct === null) return null;\n  if (pct >= 10) return \"Growing\";\n  if (pct >= -10) return \"Stable\";\n  if (pct >= -25) return \"Slight Decline\";\n  if (pct >= -50) return \"Clear Decline\";\n  return \"Sharp Sustained Decline\";\n};\n\nconst deriveUtilizationLevel = (utilizationPct) => {\n  const pct = num(utilizationPct);\n  if (pct === null) return null;\n  if (pct >= 80) return \"High Utilization\";\n  if (pct >= 60) return \"Moderate Utilization\";\n  if (pct >= 40) return \"Low Utilization\";\n  return \"Very Low Utilization\";\n};\n\nconst resolveSelectedBand = (selectedBand, financialClassification, score, level) => {\n  if (selectedBand && typeof selectedBand === \"object\" && !Array.isArray(selectedBand)) {\n    return selectedBand;\n  }\n\n  const normalizedLabel = cleanLabel(selectedBand);\n  if (Array.isArray(financialClassification) && financialClassification.length) {\n    if (normalizedLabel) {\n      const byLabel = financialClassification.find((item) => cleanLabel(item.label) === normalizedLabel);\n      if (byLabel) return byLabel;\n    }\n\n    const numericScore = num(score);\n    if (numericScore !== null) {\n      const byScore = financialClassification.find((item) => {\n        const min = num(item.min);\n        const max = num(item.max);\n        return min !== null && max !== null && numericScore >= min && numericScore <= max;\n      });\n      if (byScore) return byScore;\n    }\n\n    if (level) {\n      const byLevel = financialClassification.find((item) => cleanLabel(item.label) === level);\n      if (byLevel) return byLevel;\n    }\n  }\n\n  return undefined;\n};\n\nconst mappingRows = Array.isArray($context.$nodes.DETAIL_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output)\n  ? $context.$nodes.DETAIL_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output\n  : [];\nconst metricRows = Array.isArray($context.$nodes.DETAIL_GET_RUNTIME_METRIC_DETAILS.$output)\n  ? $context.$nodes.DETAIL_GET_RUNTIME_METRIC_DETAILS.$output\n  : [];\n\nconst fetched = $context.$nodes.MERGE_FETCHED_PRODUCTS.$output.result || {};\nconst routesByKey = $context.$nodes.BUILD_EXISTING_ALERT_ROUTE_MAP.$output.result.routesByKey || {};\nconst segmentation = $context.$nodes.VALIDATE_SEGMENTATION_OUTPUT.$output.result || {};\nconst threshold = Number(segmentation.lowTcvWeightageThreshold ?? 5);\n\nconst subscriptionId = fetched.SubscriptionId ?? $context.$variables.SubscriptionId ?? null;\nconst subscriptionNumber = fetched.SubscriptionNumber ?? $context.$variables.SubscriptionNumber ?? null;\nconst transactionId = $context.$variables.TransactionId ?? null;\n\nconst findMetricRow = (rows, typeCode, unitRegex) =>\n  rows.filter((row) => row.metricTypeCode === typeCode).find((row) => unitRegex.test(String(row.metricUnit || \"\"))) || null;\n\nconst getMetricNumber = (rows, typeCode, unitRegex) => {\n  const row = findMetricRow(rows, typeCode, unitRegex);\n  return num(row?.metricValue) ?? num(row?.metricAmount) ?? null;\n};\n\nconst firstExplainObject = (...values) => {\n  for (const value of values) {\n    const parsed = safeJsonParse(value);\n    if (parsed && typeof parsed === \"object\" && Object.keys(parsed).length) return parsed;\n  }\n  return {};\n};\n\nconst firstExplainSummary = (...values) => {\n  for (const value of values) {\n    const parsed = firstExplainObject(value);\n    if (typeof parsed.summary === \"string\" && parsed.summary.trim()) return parsed.summary.trim();\n  }\n  return null;\n};\n\nconst getRiskForProduct = (rows, typeCode, levelPrefix, scorePrefix) => {\n  const byType = rows.filter((row) => row.metricTypeCode === typeCode);\n  const levelRow = byType.find((row) => /Risk Level/i.test(String(row.metricUnit || \"\"))) || null;\n  const scoreRow = byType.find((row) => /Risk Score/i.test(String(row.metricUnit || \"\"))) || null;\n\n  const explainLevel = safeJsonParse(levelRow?.metricExplainability) || {};\n  const explainScore = safeJsonParse(scoreRow?.metricExplainability) || {};\n\n  const level =\n    normLevel(levelRow?.metricClassification) ||\n    normLevel(explainLevel[levelPrefix + \"RiskLevel\"]) ||\n    normLevel(explainLevel[levelPrefix[0].toUpperCase() + levelPrefix.slice(1) + \"RiskLevel\"]) ||\n    normLevel(explainScore[levelPrefix + \"RiskLevel\"]) ||\n    null;\n\n  const score =\n    num(scoreRow?.metricScore) ??\n    num(explainScore[scorePrefix + \"RiskScore\"]) ??\n    num(explainScore[scorePrefix[0].toUpperCase() + scorePrefix.slice(1) + \"RiskScore\"]) ??\n    num(explainLevel[scorePrefix + \"RiskScore\"]) ??\n    null;\n\n  return { level, score, levelRow, scoreRow };\n};\n\nconst composeFinancialSummary = (input) => {\n  const productLabel =\n    input.productName\n      ? \"The subscription product \" + input.productName + (input.productId ? \" (ID: \" + input.productId + \")\" : \"\")\n      : \"This subscription product\";\n\n  const levelText = input.financialLevel ? input.financialLevel.toLowerCase() : \"unknown\";\n  const scoreText = input.financialScore !== null ? \", with a financial risk score of \" + formatNumber(input.financialScore) : \"\";\n\n  const factualDrivers = [];\n  const driverNames = [];\n\n  if (input.marginActual !== null || input.marginExpected !== null || input.marginStatus) {\n    if (input.marginActual !== null && input.marginExpected !== null) {\n      factualDrivers.push(\n        \"margin of \" + formatNumber(input.marginActual) + \"% is below the expected margin of \" + formatNumber(input.marginExpected) + \"%\" +\n          (input.marginStatus ? \" (\" + input.marginStatus + \")\" : \"\")\n      );\n    } else if (input.marginStatus) {\n      factualDrivers.push(\"margin status is \" + input.marginStatus);\n    }\n    driverNames.push(\"margin erosion\");\n  }\n\n  if (input.discountPercentage !== null || input.discountLevel) {\n    const discountText =\n      input.discountPercentage !== null\n        ? \"discount of \" + formatNumber(input.discountPercentage) + \"%\"\n        : \"discount policy\";\n    factualDrivers.push(\n      discountText + (input.discountLevel ? \" is classified as \" + input.discountLevel : \" is contributing to risk\")\n    );\n    driverNames.push(\"excessive discounting\");\n  }\n\n  if (!factualDrivers.length) {\n    if (input.fallbackSummary && typeof input.fallbackSummary === \"string\" && input.fallbackSummary.trim()) {\n      return input.fallbackSummary.trim();\n    }\n    return productLabel + \" is currently in a \" + levelText + \" financial risk state\" + scoreText + \". Financial explainability details were not provided.\";\n  }\n\n  const driverSentence =\n    driverNames.length === 1\n      ? driverNames[0].charAt(0).toUpperCase() + driverNames[0].slice(1) + \" is the primary driver of this risk.\"\n      : joinWithAnd(driverNames).charAt(0).toUpperCase() + joinWithAnd(driverNames).slice(1) + \" are contributing significantly to this risk.\";\n\n  return productLabel + \" is currently in a \" + levelText + \" financial risk state\" + scoreText + \". \" +\n    factualDrivers.map((item) => item.charAt(0).toUpperCase() + item.slice(1)).join(\". \") + \". \" +\n    driverSentence;\n};\n\nconst composeChurnSummary = (input) => {\n  const productLabel =\n    input.productName\n      ? \"The subscription product \" + input.productName + (input.productId ? \" (ID: \" + input.productId + \")\" : \"\")\n      : \"This subscription product\";\n\n  const levelText = input.churnLevel ? input.churnLevel.toLowerCase() : \"unknown\";\n  const scoreText = input.churnScore !== null ? \" with a churn risk score of \" + formatNumber(input.churnScore) + \" (\" + (input.churnLevel ?? \"Unknown\") + \")\" : \"\";\n\n  const driverPhrases = [];\n\n  if (input.usageChangePct !== null || input.trendRiskLevel) {\n    if (input.usageChangePct !== null) {\n      driverPhrases.push(\"usage trend of \" + formatNumber(input.usageChangePct) + \"%\" + (input.trendRiskLevel ? \" (\" + input.trendRiskLevel + \")\" : \"\"));\n    } else if (input.trendRiskLevel) {\n      driverPhrases.push(\"usage trend classified as \" + input.trendRiskLevel);\n    }\n  }\n\n  if (input.utilizationPct !== null || input.utilizationLevel) {\n    if (input.utilizationPct !== null) {\n      driverPhrases.push(\"utilization of \" + formatNumber(input.utilizationPct) + \"%\" + (input.utilizationLevel ? \" (\" + input.utilizationLevel + \")\" : \"\"));\n    } else if (input.utilizationLevel) {\n      driverPhrases.push(\"utilization classified as \" + input.utilizationLevel);\n    }\n  }\n\n  if (input.sentimentLevel || input.sentimentScore !== null) {\n    if (input.sentimentLevel && input.sentimentScore !== null) {\n      driverPhrases.push(\"sentiment risk at \" + input.sentimentLevel + \" (\" + formatNumber(input.sentimentScore) + \")\");\n    } else if (input.sentimentLevel) {\n      driverPhrases.push(\"sentiment risk at \" + input.sentimentLevel);\n    }\n  }\n\n  if (input.supportRiskLevel || input.supportRiskScore !== null) {\n    if (input.supportRiskLevel && input.supportRiskScore !== null) {\n      driverPhrases.push(\"support health at \" + input.supportRiskLevel + \" (\" + formatNumber(input.supportRiskScore) + \")\");\n    } else if (input.supportRiskLevel) {\n      driverPhrases.push(\"support health at \" + input.supportRiskLevel);\n    }\n  }\n\n  if (input.relationshipLevel || input.relationshipScore !== null) {\n    if (input.relationshipLevel && input.relationshipScore !== null) {\n      driverPhrases.push(\"relationship health at \" + input.relationshipLevel + \" (\" + formatNumber(input.relationshipScore) + \")\");\n    } else if (input.relationshipLevel) {\n      driverPhrases.push(\"relationship health at \" + input.relationshipLevel);\n    }\n  }\n\n  if (!driverPhrases.length) {\n    if (input.fallbackSummary && typeof input.fallbackSummary === \"string\" && input.fallbackSummary.trim()) {\n      return input.fallbackSummary.trim();\n    }\n    return productLabel + \" is currently at \" + levelText + \" risk of churn\" + scoreText + \". Current monitoring signals do not show additional churn drivers.\";\n  }\n\n  const connector = input.churnLevel === \"High\" ? \"This elevated risk is primarily driven by \" : \"This risk is primarily driven by \";\n  return productLabel + \" is currently at \" + levelText + \" risk of churn,\" + scoreText + \". \" + connector + joinWithAnd(driverPhrases) + \".\";\n};\n\nconst mappingBySourceId = new Map();\nfor (const row of mappingRows) {\n  const sourceId = Number(row.sourceSubsProdId);\n  if (Number.isFinite(sourceId) && !mappingBySourceId.has(sourceId)) {\n    mappingBySourceId.set(sourceId, row);\n  }\n}\n\nconst metricsBySourceId = new Map();\nfor (const row of metricRows) {\n  const sourceId = Number(row.subscriptionProductId);\n  if (!Number.isFinite(sourceId)) continue;\n  if (!metricsBySourceId.has(sourceId)) metricsBySourceId.set(sourceId, []);\n  metricsBySourceId.get(sourceId).push(row);\n}\n\nconst sourceIds = Array.from(new Set([\n  ...Array.from(mappingBySourceId.keys()),\n  ...Array.from(metricsBySourceId.keys())\n]));\n\nconst routeForKey = (key) =>\n  routesByKey[key]\n    ? { operation: \"update\", path: routesByKey[key].path }\n    : { operation: \"create\", path: \"/subscriptionAIAlerts/\" };\n\nconst parts = [];\n\nfor (const sourceId of sourceIds) {\n  const mapping = mappingBySourceId.get(sourceId) || {};\n  const rows = metricsBySourceId.get(sourceId) || [];\n\n  const financial = getRiskForProduct(rows, \"ORA_FINANCIAL\", \"financial\", \"financial\");\n  const churn = getRiskForProduct(rows, \"ORA_CHURN\", \"churn\", \"churn\");\n\n  const targetProdId = pick(mapping, \"targetSubsProdId\", \"targetSubscriptionProductId\") ?? null;\n  const targetProdPuid = pick(mapping, \"targetSubsProdPuid\", \"targetSubscriptionProductPuid\") ?? null;\n  const productName = pick(mapping, \"targetProductName\", \"sourceProductName\", \"productName\", \"ProductName\") ?? null;\n\n  const tcvWeightage = getMetricNumber(rows, \"ORA_MARGIN\", /Relative TCV weightage/i);\n  const skipFinancial = typeof tcvWeightage === \"number\" && tcvWeightage < threshold;\n\n  const productCommon = {\n    subscriptionProductId: targetProdId !== null ? Number(targetProdId) : null,\n    subscriptionProductPuid: targetProdPuid ?? null,\n    subscriptionProductName: productName\n  };\n\n  const finLevelExplain = pick(financial.levelRow, \"metricExplainability\");\n  const finScoreExplain = pick(financial.scoreRow, \"metricExplainability\");\n  const finExplain = firstExplainObject(finScoreExplain, finLevelExplain);\n  const marginExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_MARGIN\", /Margin Risk Score/i), \"metricExplainability\"));\n  const discountExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_DISCOUNT\", /Discount Risk Score/i), \"metricExplainability\"));\n\n  const churnLevelExplain = pick(churn.levelRow, \"metricExplainability\");\n  const churnScoreExplain = pick(churn.scoreRow, \"metricExplainability\");\n  const churnExplain = firstExplainObject(churnScoreExplain, churnLevelExplain);\n  const usageScoreExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_USAGE\", /Usage Risk Score/i), \"metricExplainability\"));\n  const usageLevelExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_USAGE\", /Usage Risk Level/i), \"metricExplainability\"));\n  const trendExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_USAGE\", /Trend Risk Score/i), \"metricExplainability\"));\n  const utilRiskExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_USAGE\", /Utilization Risk Score/i), \"metricExplainability\"));\n  const utilExplain = firstExplainObject(pick(findMetricRow(rows, \"ORA_USAGE\", /^Utilization$/i), \"metricExplainability\"));\n  const supportExplain = asObject(pick(churnExplain, \"supportHealth\"));\n  const relationshipExplain = asObject(pick(churnExplain, \"relationship\"));\n\n  const marginObj = Object.keys(asObject(finExplain.margin)).length ? asObject(finExplain.margin) : marginExplain;\n  const discountObj = Object.keys(asObject(finExplain.discount)).length ? asObject(finExplain.discount) : discountExplain;\n  const usageBandsUsed = asObject(pick(usageScoreExplain, \"bandsUsed\"));\n\n  const rawDebriefCharges = getMetricNumber(rows, \"ORA_MARGIN\", /Debrief Charges/i);\n  const rawDiscountPct = getMetricNumber(rows, \"ORA_DISCOUNT\", /Discount Percent/i);\n  const discountPercentage = num(pick(discountObj, \"discountPercent\", \"discountPercentage\")) ?? rawDiscountPct;\n  const discountRiskScore = num(pick(discountObj, \"discountRiskScore\")) ?? getMetricNumber(rows, \"ORA_DISCOUNT\", /Discount Risk Score/i);\n  const discountLevel = cleanLabel(pick(discountObj, \"discountLevel\")) ?? deriveDiscountLevel(discountPercentage);\n\n  const marginExpected = num(pick(marginObj, \"marginExpected\"));\n  const marginActual = num(pick(marginObj, \"marginActual\"));\n  const marginRiskScore = num(pick(marginObj, \"marginRiskScore\"));\n  const marginStatus = cleanLabel(pick(marginObj, \"marginStatus\")) ?? deriveMarginStatus(marginExpected, marginActual);\n\n  const financialClassification = normalizeClassificationArray(\n    pick(finExplain, \"classificationBandsUsed\", \"financialClassification\"),\n    defaultFinancialClassification\n  );\n  const marginClassification = normalizeClassificationArray(\n    pick(marginObj, \"marginPolicyBandsUsed\", \"marginClassification\"),\n    defaultMarginClassification\n  );\n  const discountClassification = normalizeClassificationArray(\n    pick(discountObj, \"discountPolicyTiers\", \"discountClassification\"),\n    defaultDiscountClassification\n  );\n\n  const rawUsageRiskScore = num(pick(usageScoreExplain, \"usageRiskScore\", \"UsageRiskScore\")) ?? getMetricNumber(rows, \"ORA_USAGE\", /Usage Risk Score/i);\n  const rawUsageRiskLevel = cleanLabel(pick(usageLevelExplain, \"UsageRiskLevel\", \"usageRiskLevel\")) ??\n    normLevel(pick(findMetricRow(rows, \"ORA_USAGE\", /Usage Risk Level/i), \"metricClassification\"));\n  const rawTrendRiskScore = num(pick(trendExplain, \"trendRiskScore\")) ?? getMetricNumber(rows, \"ORA_USAGE\", /Trend Risk Score/i);\n  const rawTrendRiskLevel = cleanLabel(pick(trendExplain, \"TrendRiskLevel\", \"trendRiskLevel\")) ??\n    normLevel(pick(findMetricRow(rows, \"ORA_USAGE\", /Trend Risk Level/i), \"metricClassification\")) ??\n    deriveTrendRiskLevel(num(pick(trendExplain, \"usageChangePct\")));\n  const rawUtilizationPct = num(pick(utilExplain, \"UtilizationPct\", \"utilizationPct\")) ??\n    num(pick(usageScoreExplain, \"UtilizationPct\", \"utilizationPct\")) ??\n    getMetricNumber(rows, \"ORA_USAGE\", /^Utilization$/i);\n  const rawUtilizationLevel = cleanLabel(pick(utilExplain, \"Utilization Level\", \"utilizationLevel\")) ??\n    normLevel(pick(findMetricRow(rows, \"ORA_USAGE\", /Utilization Level/i), \"metricClassification\")) ??\n    deriveUtilizationLevel(rawUtilizationPct);\n  const rawUtilizationRiskScore = num(pick(utilRiskExplain, \"utilizationRiskScore\")) ??\n    num(pick(usageScoreExplain, \"utilizationRiskScore\")) ??\n    getMetricNumber(rows, \"ORA_USAGE\", /Utilization Risk Score/i);\n\n  const trendClassification = normalizeClassificationArray(\n    usageBandsUsed.trendRiskClassification || pick(trendExplain, \"classification\"),\n    defaultTrendClassification\n  );\n  const utilizationClassification = normalizeClassificationArray(\n    usageBandsUsed.utilizationClassification || pick(utilRiskExplain, \"classification\") || pick(utilExplain, \"classification\"),\n    defaultUtilizationClassification\n  );\n  const churnClassification = normalizeRangeObject(\n    pick(churnExplain, \"classification\", \"Classification\"),\n    defaultChurnClassification\n  );\n\n  const supportHealth = omitEmpty({\n    serviceRequestCount: num(pick(supportExplain, \"serviceRequestCount\")),\n    supportRiskScore: num(pick(supportExplain, \"supportRiskScore\")),\n    supportRiskLevel: cleanLabel(pick(supportExplain, \"supportRiskLevel\")),\n    classification: Array.isArray(pick(supportExplain, \"classification\"))\n      ? cleanTierList(pick(supportExplain, \"classification\"))\n      : (Object.keys(supportExplain).length ? defaultSupportClassification : undefined)\n  });\n\n  const relationship = omitEmpty({\n    relationshipScore: num(pick(relationshipExplain, \"relationshipScore\")),\n    relationshipLevel: cleanLabel(pick(relationshipExplain, \"relationshipLevel\")),\n    classification:\n      pick(relationshipExplain, \"classification\") && typeof pick(relationshipExplain, \"classification\") === \"object\"\n        ? pick(relationshipExplain, \"classification\")\n        : (Object.keys(relationshipExplain).length ? defaultRelationshipClassification : undefined)\n  });\n\n  const usageTrend = omitEmpty({\n    usageChangePct: num(pick(trendExplain, \"usageChangePct\")),\n    usageTrend: Array.isArray(pick(trendExplain, \"usageTrend\")) ? pick(trendExplain, \"usageTrend\") : undefined,\n    TrendRiskLevel: rawTrendRiskLevel,\n    trendRiskScore: rawTrendRiskScore,\n    classification: trendClassification\n  });\n\n  const utilization = omitEmpty({\n    UtilizationPct: rawUtilizationPct,\n    \"Utilization Level\": rawUtilizationLevel,\n    \"Utilization Risk Score\": rawUtilizationRiskScore,\n    classification: utilizationClassification\n  });\n\n  const selectedBand = resolveSelectedBand(\n    pick(finExplain, \"selectedBand\"),\n    financialClassification,\n    financial.score,\n    financial.level\n  );\n\n  const financialFallbackSummary = firstExplainSummary(finScoreExplain, finLevelExplain);\n  const churnFallbackSummary = firstExplainSummary(churnScoreExplain, churnLevelExplain);\n\n  const financialDetails = omitEmpty({\n    ...productCommon,\n    summary: composeFinancialSummary({\n      productName,\n      productId: targetProdId,\n      financialLevel: financial.level,\n      financialScore: financial.score,\n      marginExpected,\n      marginActual,\n      marginStatus,\n      discountPercentage,\n      discountLevel,\n      fallbackSummary: financialFallbackSummary\n    }),\n    financialRiskScore: financial.score,\n    financialRiskLevel: financial.level,\n    financialClassification,\n    ...(rawDebriefCharges !== null ? { debriefCharges: rawDebriefCharges } : {}),\n    margin: skipFinancial\n      ? undefined\n      : omitEmpty({\n          marginExpected,\n          marginActual,\n          marginRiskScore,\n          marginStatus,\n          marginClassification\n        }),\n    discount: omitEmpty({\n      discountPercentage,\n      discountRiskScore,\n      discountLevel,\n      discountClassification\n    }),\n    explainability: omitEmpty({\n      formula: pick(finExplain, \"formula\"),\n      computedFrom: pick(finExplain, \"computedFrom\"),\n      financialWeightsUsed: pick(finExplain, \"financialWeightsUsed\"),\n      marginRiskScore: num(pick(finExplain, \"marginRiskScore\")) ?? marginRiskScore,\n      discountRiskScore: num(pick(finExplain, \"discountRiskScore\")) ?? discountRiskScore,\n      selectedBand,\n      ...(skipFinancial\n        ? {\n            thresholdContext: {\n              TCVWeightage: tcvWeightage,\n              LowTcvWeightageThreshold: threshold,\n              note: \"Financial risk is retained at product level but excluded from subscription-level segmentation because TCV weightage is below threshold.\"\n            }\n          }\n        : {})\n    })\n  });\n\n  const sentimentRiskScore = num(pick(churnExplain, \"sentimentRiskScore\", \"SentimentRiskScore\"));\n  const sentimentRiskLevel = cleanLabel(pick(churnExplain, \"sentimentRiskLevel\", \"SentimentRiskLevel\"));\n\n  const churnDetails = omitEmpty({\n    ...productCommon,\n    summary: composeChurnSummary({\n      productName,\n      productId: targetProdId,\n      churnLevel: churn.level,\n      churnScore: churn.score,\n      usageChangePct: num(pick(trendExplain, \"usageChangePct\")),\n      trendRiskLevel: rawTrendRiskLevel,\n      utilizationPct: rawUtilizationPct,\n      utilizationLevel: rawUtilizationLevel,\n      sentimentLevel: sentimentRiskLevel,\n      sentimentScore: sentimentRiskScore,\n      supportRiskLevel: supportHealth?.supportRiskLevel ?? null,\n      supportRiskScore: supportHealth?.supportRiskScore ?? null,\n      relationshipLevel: relationship?.relationshipLevel ?? null,\n      relationshipScore: relationship?.relationshipScore ?? null,\n      fallbackSummary: churnFallbackSummary\n    }),\n    ChurnRiskScore: churn.score,\n    ChurnRiskLevel: churn.level,\n    UsageRiskScore: rawUsageRiskScore,\n    UsageRiskLevel: rawUsageRiskLevel,\n    SentimentRiskScore: sentimentRiskScore,\n    SentimentRiskLevel: sentimentRiskLevel,\n    Classification: churnClassification,\n    usageTrend,\n    utilization,\n    supportHealth,\n    relationship\n  });\n\n  const detailProductKey = targetProdPuid ?? targetProdId ?? sourceId ?? productName ?? \"unknown\";\n\n  const churnRouteKey = detailProductKey + \"-ORA_OSS_CHURN_ALERT\";\n  const churnRoute = routeForKey(churnRouteKey);\n  parts.push({\n    id: detailProductKey + \"-churn\",\n    operation: churnRoute.operation,\n    path: churnRoute.path,\n    payload: {\n      SubscriptionId: subscriptionId ? Number(subscriptionId) : null,\n      SubscriptionNumber: subscriptionNumber,\n      SubscriptionProductId: targetProdId ? Number(targetProdId) : null,\n      SubscriptionProductPuid: targetProdPuid ?? null,\n      TransactionId: transactionId,\n      AlertImpactCode: impactCodeFromLevel(churn.level),\n      AlertType: \"ORA_OSS_CHURN_ALERT\",\n      AlertCode: \"DETAIL\",\n      AlertDetails: JSON.stringify(churnDetails || {})\n    }\n  });\n\n  const finRouteKey = detailProductKey + \"-ORA_OSS_FINANCIAL_ALERT\";\n  const finRoute = routeForKey(finRouteKey);\n  parts.push({\n    id: detailProductKey + \"-financial\",\n    operation: finRoute.operation,\n    path: finRoute.path,\n    payload: {\n      SubscriptionId: subscriptionId ? Number(subscriptionId) : null,\n      SubscriptionNumber: subscriptionNumber,\n      SubscriptionProductId: targetProdId ? Number(targetProdId) : null,\n      SubscriptionProductPuid: targetProdPuid ?? null,\n      TransactionId: transactionId,\n      AlertImpactCode: impactCodeFromLevel(financial.level),\n      AlertType: \"ORA_OSS_FINANCIAL_ALERT\",\n      AlertCode: \"DETAIL\",\n      AlertDetails: JSON.stringify(financialDetails || {})\n    }\n  });\n}\n\nreturn {\n  parts,\n  batchSummary: {\n    batchNumber: $context.$nodes.DETAIL_BATCH_LOOP.$currentItem.batchNumber ?? null,\n    productCount: sourceIds.length,\n    partCount: parts.length\n  }\n};"
