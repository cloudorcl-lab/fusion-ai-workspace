          "code": "DERIVE_SEGMENTATION",
          "id": "1778673254471",
          "inputs": [
            {
              "id": "1778673254472_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a renewal segmentation rules engine.\n\nReturn strict JSON only. No markdown. No explanation outside JSON.\n\nInput JSON:\n{{$context.$nodes.MERGE_SEGMENTATION_SHARDS.$output.result}}\n\nRules:\n- Choose and return lowTcvWeightageThreshold as a whole number from 0 to 100.\n- For a chosen threshold T:\n  - effective financial high count = financialEffectiveCountsByThreshold[T].high\n  - effective financial medium count = financialEffectiveCountsByThreshold[T].medium\n- churn high count = churnCounts.High\n- churn medium count = churnCounts.Medium\n\nSubscription riskProfile:\n- High if churnCounts.High > 0 OR effective financial high count > 0\n- Medium if no High and (churnCounts.Medium > 0 OR effective financial medium count > 0)\n- Low otherwise\n\nPathway:\n- If riskProfile = High => High-Touch\n- If riskProfile = Medium and customerAcceptance = Yes => Minimal-Touch\n- If riskProfile = Medium and customerAcceptance = No => Zero-touch\n- If riskProfile = Low and customerAcceptance = Yes => Minimal-Touch\n- If riskProfile = Low and customerAcceptance = No => Zero-touch\n\nSegmentation code:\n- High-Touch => ORA_HIGH_TOUCH\n- Minimal-Touch => ORA_MINIMAL_TOUCH\n- Zero-touch => ORA_ZERO_TOUCH\n\nwhyThisPathway:\n- one sentence only\n- mention the chosen threshold\n- mention the highest risk found\n- mention customer acceptance only if it changed the pathway\n\nReturn exactly:\n{\n  \"subscriptionNumber\": \"\",\n  \"riskProfile\": \"Low|Medium|High\",\n  \"pathway\": \"Zero-touch|Minimal-Touch|High-Touch\",\n  \"segmentation\": \"ORA_ZERO_TOUCH|ORA_MINIMAL_TOUCH|ORA_HIGH_TOUCH\",\n  \"lowTcvWeightageThreshold\": 0,\n  \"whyThisPathway\": \"\"\n}"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"subscriptionNumber\": {\n      \"type\": [\"string\", \"null\"]\n    },\n    \"riskProfile\": {\n      \"type\": \"string\",\n      \"enum\": [\"Low\", \"Medium\", \"High\"]\n    },\n    \"pathway\": {\n      \"type\": \"string\",\n      \"enum\": [\"Zero-touch\", \"Minimal-Touch\", \"High-Touch\"]\n    },\n    \"segmentation\": {\n      \"type\": \"string\",\n      \"enum\": [\"ORA_ZERO_TOUCH\", \"ORA_MINIMAL_TOUCH\", \"ORA_HIGH_TOUCH\"]\n    },\n    \"lowTcvWeightageThreshold\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 100\n    },\n    \"whyThisPathway\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"subscriptionNumber\",\n    \"riskProfile\",\n    \"pathway\",\n    \"segmentation\",\n    \"lowTcvWeightageThreshold\",\n    \"whyThisPathway\"\n  ]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Validate Segmentation Output",
            "returnType": "object",
            "sourceCode": "const safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst raw = $context.$nodes.DERIVE_SEGMENTATION?.$output;\nconst parsed =\n  safeJsonParse(raw?.output) ??\n  safeJsonParse(raw?.result) ??\n  safeJsonParse(raw) ??\n  raw ??\n  {};\n\nconst allowedRisk = [\"Low\", \"Medium\", \"High\"];\nconst allowedPathway = [\"Zero-touch\", \"Minimal-Touch\", \"High-Touch\"];\nconst allowedSeg = [\"ORA_ZERO_TOUCH\", \"ORA_MINIMAL_TOUCH\", \"ORA_HIGH_TOUCH\"];\n\nconst riskProfile = allowedRisk.includes(parsed.riskProfile) ? parsed.riskProfile : \"Low\";\nconst pathway = allowedPathway.includes(parsed.pathway) ? parsed.pathway : \"Zero-touch\";\nconst segmentation = allowedSeg.includes(parsed.segmentation) ? parsed.segmentation : \"ORA_ZERO_TOUCH\";\n\nconst thresholdRaw = Number(parsed.lowTcvWeightageThreshold);\nconst lowTcvWeightageThreshold =\n  Number.isFinite(thresholdRaw) && thresholdRaw >= 0 && thresholdRaw <= 100 ? thresholdRaw : 5;\n\nreturn {\n  subscriptionNumber: parsed.subscriptionNumber ?? $context.$nodes.MERGE_SEGMENTATION_SHARDS.$output.result?.subscriptionNumber ?? null,\n  riskProfile,\n  pathway,\n  segmentation,\n  lowTcvWeightageThreshold,\n  whyThisPathway: String(parsed.whyThisPathway ?? \"\").trim()\n};"
          },
