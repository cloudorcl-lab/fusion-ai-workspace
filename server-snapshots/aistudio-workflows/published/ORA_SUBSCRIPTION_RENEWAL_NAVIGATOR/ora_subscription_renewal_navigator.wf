                    "sourceCode": "const rows = $context.$nodes.DETAIL_GET_SUBSCRIPTION_PRODUCT_DETAILS1.$output;\nif (!Array.isArray(rows)) {\n  throw new Error(\"Expected an array from 'Get Detail Subscription Product Details'\");\n}\n\nconst ids = [...new Set(\n  rows\n    .map(r => r.sourceSubsProdId)\n    .filter(v => v !== null && v !== undefined && v !== \"\")\n)];\n\nreturn {\n  ids,\n  inClause: ids.length ? `(${ids.join(\",\")})` : `(NULL)`\n};"
