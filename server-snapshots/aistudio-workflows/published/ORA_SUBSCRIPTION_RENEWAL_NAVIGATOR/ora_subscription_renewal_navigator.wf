          "metadata": {
            "name": "Partition Product Id Branches",
            "returnType": "array",
            "sourceCode": "const ids = Array.isArray($context.$nodes.NORMALIZE_REQUEST_PAYLOAD.$output.result.ProductIds)\n  ? $context.$nodes.NORMALIZE_REQUEST_PAYLOAD.$output.result.ProductIds\n  : [];\n\nconst uniqueIds = Array.from(new Set(ids));\nconst configuredChunkSize = Number($context.$variables.SummaryMaxChunkSize);\nconst maxSummaryBatchSize = Number.isFinite(configuredChunkSize) && configuredChunkSize > 0 ? Math.floor(configuredChunkSize) : 250;\nconst MAX_BRANCH_COUNT = 40;\nconst branchCount = Math.max(1, Math.min(MAX_BRANCH_COUNT, Math.ceil(uniqueIds.length / maxSummaryBatchSize)));\nconst bucketSize = Math.max(1, Math.ceil(uniqueIds.length / branchCount));\nconst buckets = [];\nfor (let i = 0; i < uniqueIds.length; i += bucketSize) {\n  buckets.push({\n    branchNumber: buckets.length + 1,\n    productIds: uniqueIds.slice(i, i + bucketSize)\n  });\n}\n\nconst out = { buckets };\nfor (const bucket of buckets) {\n  out[`branch${bucket.branchNumber}`] = bucket.productIds.length ? [bucket] : [];\n}\nreturn out;"
          },
