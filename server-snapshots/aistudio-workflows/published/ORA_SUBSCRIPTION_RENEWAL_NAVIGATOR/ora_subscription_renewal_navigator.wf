                  "metadata": {
                    "name": "Partition Branch Fetch Batches",
                    "returnType": "array",
                    "sourceCode": "const ids = Array.isArray($context.$nodes.SUMMARY_PARALLEL.$currentItem.productIds)\n  ? $context.$nodes.SUMMARY_PARALLEL.$currentItem.productIds\n  : [];\n\nconst configuredChunkSize = Number($context.$variables.SummaryMaxChunkSize);\nconst maxChunkSize = Number.isFinite(configuredChunkSize) && configuredChunkSize > 0 ? Math.floor(configuredChunkSize) : 250;\nconst chunkSize = Math.min(maxChunkSize, ids.length || maxChunkSize);\nconst out = [];\nfor (let i = 0; i < ids.length; i += chunkSize) {\n  out.push({\n    batchNumber: out.length + 1,\n    productIds: ids.slice(i, i + chunkSize)\n  });\n}\n\nreturn out;"
