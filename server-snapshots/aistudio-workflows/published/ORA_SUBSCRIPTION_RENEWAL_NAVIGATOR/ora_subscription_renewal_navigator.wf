        {
          "metadata": {
            "name": "Build Summary Alert Part",
            "returnType": "object",
            "sourceCode": "const safeJsonParse = (value) => {\n  try {\n    if (value === null || value === undefined) return null;\n    if (typeof value === \"object\") return value;\n    if (typeof value !== \"string\") return null;\n    return JSON.parse(value);\n  } catch {\n    return null;\n  }\n};\n\nconst merged = $context.$nodes.MERGE_SEGMENTATION_SHARDS.$output.result || {};\nconst segmentation = $context.$nodes.VALIDATE_SEGMENTATION_OUTPUT.$output.result || {};\nconst briefFacts = $context.$nodes.PREPARE_BRIEF_FACTS.$output.result || {};\nconst routesByKey = $context.$nodes.BUILD_EXISTING_ALERT_ROUTE_MAP.$output.result.routesByKey || {};\n\nconst renewalBriefRaw = $context.$nodes.GENERATE_RENEWAL_BRIEF?.$output;\nconst renewalBrief =\n  safeJsonParse(renewalBriefRaw?.output) ??\n  safeJsonParse(renewalBriefRaw?.result) ??\n  safeJsonParse(renewalBriefRaw) ??\n  renewalBriefRaw ??\n  null;\n\nconst engagementSummaryRaw = $context.$nodes.GENERATE_ENGAGEMENT_SUMMARY?.$output;\nconst engagementSummary =\n  typeof engagementSummaryRaw === \"string\"\n    ? engagementSummaryRaw\n    : engagementSummaryRaw?.output ?? engagementSummaryRaw?.result ?? null;\n\nconst subscriptionId = briefFacts.subscriptionId ?? null;\nconst subscriptionNumber = briefFacts.subscriptionNumber ?? null;\nconst summaryKey = `${subscriptionNumber}-summary`;\n\nconst route = routesByKey[summaryKey]\n  ? { operation: \"update\", path: routesByKey[summaryKey].path }\n  : { operation: \"create\", path: \"/subscriptionAIAlerts/\" };\n\nconst alertDetails = {\n  subscriptionId,\n  subscriptionNumber,\n  customerName: briefFacts.customerName ?? null,\n  customerAcceptance: briefFacts.customerAcceptance ?? \"No\",\n  productCounts: {\n    total: Number(merged.productCounts?.total ?? 0)\n  },\n  topRiskProducts: briefFacts.topRiskProducts || [],\n  segmentation,\n  engagementSummary\n};\n\nreturn {\n  parts: [\n    {\n      id: `${subscriptionNumber}-summary`,\n      operation: route.operation,\n      path: route.path,\n      payload: {\n        SubscriptionId: subscriptionId ? Number(subscriptionId) : null,\n        SubscriptionNumber: subscriptionNumber,\n        TransactionId: $context.$variables.TransactionId ?? null,\n        Status: \"OPEN\",\n        Segmentation: segmentation.segmentation ?? null,\n        AlertType: \"SUBSCRIPTION_SUMMARY\",\n        AlertCode: \"SUMMARY\",\n        AdditionalInformation: $context.$variables.AdditionalInfo ?? null,\n        AlertDetails: JSON.stringify(alertDetails),\n        RenewalBrief: renewalBrief ? JSON.stringify(renewalBrief) : null\n      }\n    }\n  ]\n};"
