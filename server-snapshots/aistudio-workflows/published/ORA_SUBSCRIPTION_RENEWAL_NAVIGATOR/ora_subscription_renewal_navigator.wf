                  "id": "1866000000013",
                  "inputs": [
                    {
                      "id": "1866000000015",
                      "name": "ProductIds",
                      "type": "string",
                      "value": "{{$context.$nodes.DETAIL_GET_SOURCE_PRODUCT_IDS.$output.result.inClause}}"
