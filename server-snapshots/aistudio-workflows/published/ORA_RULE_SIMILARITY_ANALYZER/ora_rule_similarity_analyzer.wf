        {
          "metadata": {
            "name": "Extract Rule ID's",
            "returnType": "array",
            "sourceCode": "/*\n * Collect ONE deduplicated array of rule IDs from\n * $context.$nodes.LOOP_OVER_CONDITION_ATTRIBUTES.$output\n *\n * • Works whether each element is an object or a JSON string.\n * • Ignores malformed entries.\n * • Removes duplicates.\n */\n\nconst src = $context.$nodes.LOOP_OVER_CONDITION_ATTRIBUTES.$output ?? [];\n\nconst uniqueRuleIds = [\n  ...new Set(                                                   // ‑-- de-duplicate\n    src.flatMap(entry => {\n      // Parse if needed\n      let obj;\n      try {\n        obj = (typeof entry === 'string') ? JSON.parse(entry) : entry;\n      } catch {\n        return [];                                              // skip bad JSON\n      }\n\n      // Grab ruleIds safely\n      return Array.isArray(obj?.items)\n        ? obj.items.map(({ ruleId }) => ruleId)\n        : [];\n    })\n  )\n];\n\n// (Optional) store for later nodes\n$context.uniqueRuleIds = uniqueRuleIds;\n\n// Return / use as required\nreturn uniqueRuleIds;"
          },
          "outcomes": {
            "success": "1769539518020"
          },
          "code": "EXTRACT_RULE_IDS",
          "id": "1769536347917",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Get Level",
            "returnType": "string",
            "sourceCode": "// Retrieve the values coming from the REST trigger\nvar pf = $context.$triggers.REST.$input.productFamily || '';\nvar pl = $context.$triggers.REST.$input.productLine  || '';\nvar m  = $context.$triggers.REST.$input.model        || '';\n\n// Determine the correct level\nvar level;\nif (m.trim() !== '') {\n  level = 'model';\n} else if (pl.trim() !== '') {\n  level = 'productLine';\n} else if (pf.trim() !== '') {\n  level = 'productFamily';\n} else {\n  level = 'allProductFamily';\n}\n\nreturn level;"
          },
          "outcomes": {
            "success": "1769538458507"
          },
          "code": "GET_LEVEL",
          "id": "1769539518020",
