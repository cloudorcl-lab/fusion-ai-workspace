          "outcomes": {
            "success": "1769625381114"
          },
          "code": "GET_RULE_INSTANCES_LOOP",
          "convergenceTargetId": "end",
          "id": "1769538458507",
          "inputs": [
            {
              "id": "1769538458508_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.EXTRACT_RULE_IDS.$output.result}}"
