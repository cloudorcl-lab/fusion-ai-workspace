        },
        {
          "metadata": {
            "name": "Rank Tiers",
            "returnType": "object",
            "sourceCode": "var inputData = $context.$triggers.REST.$input;\nvar rulesRaw = $context.$nodes.GET_RULE_INSTANCES_LOOP.$output;\n\nvar targetRuleType = null;\nvar enforceRuleType = false;\n\nif (\n  inputData.ruleType &&\n  typeof inputData.ruleType === 'object' &&\n  Object.keys(inputData.ruleType).length > 0 &&\n  inputData.ruleType.lookupCode !== undefined &&\n  inputData.ruleType.lookupCode !== null\n) {\n  targetRuleType = String(inputData.ruleType.lookupCode);\n  enforceRuleType = true;\n}\n\nfunction normalizeConditions(condContainer) {\n  if (!condContainer) return [];\n  if (Array.isArray(condContainer)) return condContainer;\n  if (condContainer.conditions && Array.isArray(condContainer.conditions.items)) {\n    return condContainer.conditions.items;\n  }\n  if (Array.isArray(condContainer.conditions)) return condContainer.conditions;\n  return [];\n}\n\nfunction toLower(v) {\n  return v === undefined || v === null ? '' : String(v).trim().toLowerCase();\n}\n\nfunction normalizeValues(values) {\n  if (!Array.isArray(values)) return [];\n  var out = [];\n  for (var i = 0; i < values.length; i++) {\n    if (values[i] !== undefined && values[i] !== null) {\n      out.push(toLower(values[i]));\n    }\n  }\n  out.sort();\n  return out;\n}\n\nfunction safeItems(container) {\n  if (!container) return [];\n  if (Array.isArray(container)) return container;\n  if (Array.isArray(container.items)) return container.items;\n  return [];\n}\n\nfunction addCount(map, key) {\n  map[key] = (map[key] || 0) + 1;\n}\n\nfunction mapsEqual(a, b) {\n  var k;\n  for (k in a) if ((a[k] || 0) !== (b[k] || 0)) return false;\n  for (k in b) if ((a[k] || 0) !== (b[k] || 0)) return false;\n  return true;\n}\n\nfunction getInputActionTokens(ruleTypeCode, inputActions) {\n  var tokens = [];\n  var list = Array.isArray(inputActions) ? inputActions : [];\n\n  for (var i = 0; i < list.length; i++) {\n    var a = list[i] || {};\n    var attr = toLower(a.attribute);\n    if (!attr) continue;\n\n    if (ruleTypeCode === '11') {\n      // Hiding: attribute only\n      tokens.push(JSON.stringify({ a: attr }));\n    } else if (ruleTypeCode === '1' || ruleTypeCode === '2') {\n      // Recommendation/Constraint: attribute + values\n      tokens.push(\n        JSON.stringify({\n          a: attr,\n          v: normalizeValues(a.values)\n        })\n      );\n    }\n  }\n\n  return tokens;\n}\n\nfunction getRuleActionTokens(rule, ruleTypeCode) {\n  var tokens = [];\n  var action = (rule && rule.action) || {};\n\n  if (ruleTypeCode === '11') {\n    var hidingAttrs = action.hidingAction && Array.isArray(action.hidingAction.attributes)\n      ? action.hidingAction.attributes\n      : [];\n    for (var h = 0; h < hidingAttrs.length; h++) {\n      var hAttr = toLower(hidingAttrs[h]);\n      if (!hAttr) continue;\n      tokens.push(JSON.stringify({ a: hAttr }));\n    }\n    return tokens;\n  }\n\n  if (ruleTypeCode === '2') {\n    var cItems = safeItems(action.constraintAction && action.constraintAction.constraints);\n    for (var c = 0; c < cItems.length; c++) {\n      var cItem = cItems[c] || {};\n      var cAttr = toLower(cItem.attribute);\n      if (!cAttr) continue;\n      tokens.push(\n        JSON.stringify({\n          a: cAttr,\n          v: normalizeValues(cItem.value && cItem.value.values)\n        })\n      );\n    }\n    return tokens;\n  }\n\n  if (ruleTypeCode === '1') {\n    var rItems = safeItems(action.recommendationAction && action.recommendationAction.recommendations);\n    for (var r = 0; r < rItems.length; r++) {\n      var rItem = rItems[r] || {};\n      var rAttr = toLower(rItem.attribute);\n      if (!rAttr) continue;\n      tokens.push(\n        JSON.stringify({\n          a: rAttr,\n          v: normalizeValues(rItem.value && rItem.value.values)\n        })\n      );\n    }\n    return tokens;\n  }\n\n  // MessageOnly (24): no action validation\n  return tokens;\n}\n\nfunction isSameActionForRuleType(ruleTypeCode, inputActions, rule) {\n  if (ruleTypeCode === '24') {\n    // Per requirement: no validation for message action\n    return true;\n  }\n\n  var inputTokens = getInputActionTokens(ruleTypeCode, inputActions);\n  var ruleTokens = getRuleActionTokens(rule, ruleTypeCode);\n\n  var a = {};\n  var b = {};\n  for (var i = 0; i < inputTokens.length; i++) addCount(a, inputTokens[i]);\n  for (var j = 0; j < ruleTokens.length; j++) addCount(b, ruleTokens[j]);\n\n  return mapsEqual(a, b);\n}\n\nvar targetConditions = normalizeConditions(\n  inputData.ruleCondition || inputData.conditions || []\n);\n\nvar targetAttrs = [];\nvar targetOps = [];\n\nfor (var i = 0; i < targetConditions.length; i++) {\n  var cond = targetConditions[i];\n  if (\n    cond &&\n    cond.criteria &&\n    cond.criteria.criteriaType === 'Attribute' &&\n    cond.criteria.attribute &&\n    cond.operator\n  ) {\n    targetAttrs.push(String(cond.criteria.attribute));\n    targetOps.push(String(cond.operator));\n  }\n}\n\nvar rankedRules = { tier1: [], tier1_1: [], tier2: [], tier3: [] };\nvar inputActions = Array.isArray(inputData.actions) ? inputData.actions : [];\n\nfor (var j = 0; j < rulesRaw.length; j++) {\n  var rawItem = rulesRaw[j];\n  if (typeof rawItem !== 'string' || !rawItem.trim().startsWith('{')) {\n    continue;\n  }\n\n  var rule;\n  try {\n    rule = JSON.parse(rawItem);\n  } catch (err) {\n    continue;\n  }\n\n  var candidateRuleType =\n    rule.ruleType && rule.ruleType.lookupCode != null\n      ? String(rule.ruleType.lookupCode)\n      : null;\n\n  if (enforceRuleType) {\n    if (!candidateRuleType || candidateRuleType !== targetRuleType) {\n      continue;\n    }\n  }\n\n  var compareRuleType = enforceRuleType ? targetRuleType : (candidateRuleType || '');\n  var sameAction = isSameActionForRuleType(compareRuleType, inputActions, rule);\n\n  var ruleConditions = normalizeConditions(\n    rule.ruleCondition || rule.conditions || []\n  );\n\n  if (targetAttrs.length === 0) {\n    // No condition basis; action-only tier first\n    if (sameAction) rankedRules.tier1_1.push(rule);\n    else rankedRules.tier3.push(rule);\n    continue;\n  }\n\n  var matchedAttrCount = 0;\n  var matchedOpCount = 0;\n  var usedRuleIndexes = {};\n\n  for (var t = 0; t < targetAttrs.length; t++) {\n    var targetAttr = targetAttrs[t];\n    var targetOp = targetOps[t];\n    var attrMatched = false;\n    var opMatched = false;\n\n    for (var r = 0; r < ruleConditions.length; r++) {\n      if (usedRuleIndexes[r]) continue;\n\n      var rc = ruleConditions[r];\n      if (\n        rc &&\n        rc.criteria &&\n        rc.criteria.criteriaType === 'Attribute' &&\n        rc.criteria.attribute === targetAttr\n      ) {\n        attrMatched = true;\n        usedRuleIndexes[r] = true;\n\n        var ruleOp = rc.operator ? String(rc.operator) : '';\n        if (\n          ruleOp.toLowerCase().indexOf(targetOp.toLowerCase()) !== -1 ||\n          targetOp.toLowerCase().indexOf(ruleOp.toLowerCase()) !== -1\n        ) {\n          opMatched = true;\n        }\n        break;\n      }\n    }\n\n    if (attrMatched) matchedAttrCount++;\n    if (attrMatched && opMatched) matchedOpCount++;\n  }\n\n  // Tier 1: previous condition exact-match + same action\n  if (\n    matchedAttrCount === targetAttrs.length &&\n    matchedOpCount === targetAttrs.length &&\n    ruleConditions.length === targetAttrs.length &&\n    sameAction\n  ) {\n    rankedRules.tier1.push(rule);\n  }\n  // Tier 1.1: same action only (when not Tier 1)\n  else if (sameAction) {\n    rankedRules.tier1_1.push(rule);\n  }\n  // Tier 2/3 unchanged\n  else if (\n    matchedAttrCount >= targetAttrs.length &&\n    matchedOpCount >= targetAttrs.length\n  ) {\n    rankedRules.tier2.push(rule);\n  } else if (matchedAttrCount > 0) {\n    rankedRules.tier3.push(rule);\n  }\n}\n\nreturn rankedRules;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "RANK_TIERS",
          "id": "1769625381114",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Combine Condition and Action Attributes",
            "returnType": "array",
            "sourceCode": "var actions = $context.$triggers.REST.$input.actions || [];\nvar conditions = $context.$triggers.REST.$input.conditions || [];\n\nvar combined = [];\nvar seen = {};\n\n// Build quick lookup: attribute -> level from conditions\nvar conditionLevelByAttr = {};\nfor (var i = 0; i < conditions.length; i++) {\n  var c = conditions[i];\n  if (!c || !c.criteria || c.criteria.attribute == null) continue;\n\n  var cAttr = String(c.criteria.attribute).trim();\n  if (!cAttr) continue;\n\n  var cKey = cAttr.toLowerCase();\n  if (c.level != null && conditionLevelByAttr[cKey] == null) {\n    conditionLevelByAttr[cKey] = c.level;\n  }\n}\n\nfunction addAttribute(attr, level) {\n  if (attr == null) return;\n  var name = String(attr).trim();\n  if (!name) return;\n\n  var key = name.toLowerCase();\n  if (seen[key]) return;\n  seen[key] = true;\n\n  combined.push({\n    attribute: name,\n    level: level != null ? level : null\n  });\n}\n\n// Add from conditions\nfor (var j = 0; j < conditions.length; j++) {\n  var cond = conditions[j];\n  if (!cond || !cond.criteria) continue;\n  addAttribute(cond.criteria.attribute, cond.level);\n}\n\n// Add from actions\nfor (var k = 0; k < actions.length; k++) {\n  var act = actions[k];\n  if (!act) continue;\n\n  var attr = act.attribute;\n  var actionLevel = act.level != null\n    ? act.level\n    : conditionLevelByAttr[String(attr || '').trim().toLowerCase()] || null;\n\n  addAttribute(attr, actionLevel);\n}\n\nreturn combined;"
          },
          "outcomes": {
            "success": "1769447571907"
          },
          "code": "COMBINE_CONDITION_AND_ACTION_ATTRIBUTES",
