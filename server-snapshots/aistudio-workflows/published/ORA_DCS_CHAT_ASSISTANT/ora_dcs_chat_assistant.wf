        {
          "metadata": {
            "name": "Get Create Service Request Response",
            "returnType": "object",
            "sourceCode": "const createServiceRequest = JSON.parse($context.$nodes.CREATE_SERVICE_REQUEST.$output.output).result;\n\nlet result;\nif (createServiceRequest?.SrNumber) {\n  result = { \n    created: true, \n    srNumber: createServiceRequest.SrNumber, \n    message: `Service request ${createServiceRequest.SrNumber} has been created.` \n  };\n} else {\n  result = { \n      created: false, \n      message: `Could not create service request. ${createServiceRequest.Reason ?? 'Unknown error.'}` \n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1768410421623"
          },
          "code": "GET_CREATE_SERVICE_REQUEST_RESPONSE",
          "id": "1768410445763",
