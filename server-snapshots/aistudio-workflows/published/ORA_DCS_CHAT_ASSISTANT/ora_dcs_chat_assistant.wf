              "type": "integer",
              "value": "30"
            },
            {
              "id": "1768387532705",
              "name": "invocationCount",
              "scope": "JOB",
              "type": "integer",
              "value": "{{$context.$variables.invocationCount+1}}"
            },
            {
              "id": "1768387523045",
              "name": "minSearchCount",
              "scope": "JOB",
              "type": "integer",
              "value": "2"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Unify Question",
            "returnType": "string",
            "sourceCode": "return $context.$nodes.REMOVE_INSTRUCTIONS.$output||$context.$system.$inputMessage;"
          },
          "outcomes": {
            "success": "1768387563557"
          },
          "code": "UNIFY_QUESTION",
          "id": "1775717322980",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_completion_tokens": 32000,
                "reasoning_effort": "low"
              },
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "Gpt-5 Mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "User Intent Detection"
          },
          "outcomes": {
            "success": "1768387188349"
          },
          "code": "USER_INTENT_DETECTION",
          "id": "1768387563557",
          "inputs": [
            {
              "id": "1768387563558_1",
              "name": "prompt",
              "type": "string",
              "value": "### Input\n<inputMessage>{{$context.$nodes.UNIFY_QUESTION.$output}}</inputMessage>\n<chatHistory>{{$context.$system.$chatHistory}}</chatHistory>\n<kmSearchCount> {{$context.$variables.kmSearchCount}} </kmSearchCount>\n<minSearchCount> {{$context.$variables.minSearchCount}} </minSearchCount>\n\n### Instructions\nLooking at the user's current inputMessage and the chatHistory decide what the user's intent for their current request is and return one of the below responses.\n- createSR: only if `kmSearchCount` is more than `minSearchCount` and if the user has requested to create a service request in inputMessage either directly or through an affirmative response to the last AI message in chatHistory\n- liveAgent: only if `kmSearchCount` is more than `minSearchCount` and if the user has asked for the chat to be transferred to a live agent, service associate, customer service representative or similar, either directly or through an affirmative response to the last AI message in chatHistory\n- srInquiry: if the user is asking about an existing service request or ticket.\n  This includes:\n  - asking for status or updates\n  - referring to a request made earlier (service request number format: SRXXXXXXXXXX)\n  - mentioning any issue already reported, even without an SR number\n  - asking about service requests associated to a product or category\n\n  Treat \"service request\", \"service ticket\", \"repair request\", and \"complaint\" as the same.\n- default:  in all other cases\n\n### Response\n- Return ONLY one of the following values:\n  createSR\n  liveAgent\n  srInquiry\n  default\n\n- Do NOT add any explanation, reasoning, or extra text.\n- Do NOT repeat the user query.\n- Output must be exactly one word from the list above."
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Switch User Intent"
          },
          "outcomes": {
            "default": "1768387653862",
            "srInquiry": "1774968769217",
            "createSR": "1775725212853",
            "liveAgent": "1768407018958"
          },
          "code": "SWITCH_USER_INTENT",
          "convergenceTargetId": "end",
          "id": "1768387188349",
          "inputs": [
            {
              "id": "1768387188351_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.USER_INTENT_DETECTION.$output}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
