{
  "workflowId": "100002355226873",
  "workflowCode": "ORA_DCS_CHAT_ASSISTANT",
  "name": "DCS Chat Assistant",
  "description": "Chat assistant that uses knowledge articles to help customers resolve issues before offering escalation to either a chat with a live agent or create service request. It also supports SR Inquiry to answer questions and provide status/updates on existing service requests.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
            "success": "1768387515211"
          },
          "code": "START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "name": "Set Variables"
          },
          "outcomes": {
            "success": "1775814424551"
          },
          "code": "SET_VARIABLES",
          "id": "1768387515211",
          "inputs": [
            {
              "id": "1774863611779",
              "name": "isProxyUser",
              "scope": "JOB",
              "type": "boolean",
              "value": "true"
            },
            {
              "id": "1768409979589",
              "name": "acceptableWaitSeconds",
