                {
                  "metadata": {
                    "name": "Get Article for Content Type",
                    "businessObjectCode": "ORA_CX_MARKETING_PROGRAMKNOWLEDGEMANAGEMENTTOOL",
                    "functionName": "getArticles"
                  },
                  "outcomes": {
                    "success": "1778728253976_count_articles"
                  },
                  "code": "GET_ARTICLE_FOR_CONTENT_TYPE",
                  "id": "1778728253976_get_article",
                  "inputs": [
                    {
                      "id": "1778728253976_get_article_contentType",
                      "name": "contentType",
                      "value": "{{$context.$nodes.FOR_EACH_CONTENT_TYPE.$currentItem.referenceKey}}",
                      "required": true,
                      "type": "string"
