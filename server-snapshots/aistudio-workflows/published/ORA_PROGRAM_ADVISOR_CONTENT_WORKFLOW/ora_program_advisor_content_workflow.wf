        {
          "metadata": {
            "name": "Retrieve Product Name",
            "returnType": "object",
            "sourceCode": "let appInput = $context.$triggers.REST.$input.OraAppContext;\n\nif (!appInput) {\n  appInput = $context.$variables.appContext;\n}\n\nlet data = {};\n\nif (typeof appInput === \"string\") {\n  appInput = decodeURIComponent(appInput);\n}\n\nif (appInput.trim().startsWith(\"{\")) {\n  data = JSON.parse(appInput);\n} \nelse {\n  const pairs = appInput.split(',');\n  data = pairs.reduce((acc, pair) => {\n    const [key, value] = pair.split('=');\n    if (key && value) acc[key.trim()] = value.trim();\n    return acc;\n  }, {});\n}\n\nif (data.targetProductName && data.targetProductId) {\n  const response = {\n    targetProductName: decodeURIComponent(\n      data.targetProductName.replace(/\\+/g, \" \").replace(/\\s+adjustment$/i, \"\")\n    ),\n    targetProductId: data.targetProductId.trim()\n  };\n\n  return response;\n}\n\nreturn {};"
          },
          "outcomes": {
            "success": "1769715317233"
          },
          "diagram": {
            "x": 5150,
            "y": 5206
          },
          "code": "RETRIEVE_PRODUCT_NAME",
          "id": "1769715289047",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
