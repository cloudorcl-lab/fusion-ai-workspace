                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION",
                  "diagram": {
                    "x": 5144,
                    "y": 6335
                  }
                },
                {
                  "metadata": {
                    "name": "Count Articles for Content Type",
                    "sourceCode": "const currentContentType = $context.$nodes.FOR_EACH_CONTENT_TYPE.$currentItem || {};\nconst articleOutput = $context.$nodes.FOR_EACH_CONTENT_TYPE.GET_ARTICLE_FOR_CONTENT_TYPE.$output || {};\nlet existingCounts = $context.$variables?.contentTypeCounts || [];\n\nif (typeof existingCounts === \"string\") {\n  try {\n    existingCounts = JSON.parse(existingCounts);\n  } catch (parseError) {\n    existingCounts = [];\n  }\n}\n\nif (!Array.isArray(existingCounts)) {\n  existingCounts = [];\n}\n\nconst asArray = value => {\n  if (Array.isArray(value)) return value;\n  if (Array.isArray(value?.items)) return value.items;\n  if (Array.isArray(value?.result)) return value.result;\n  if (Array.isArray(value?.result?.items)) return value.result.items;\n  if (Array.isArray(value?.data)) return value.data;\n  if (Array.isArray(value?.records)) return value.records;\n  return [];\n};\nconst firstNumber = values => {\n  for (const value of values) {\n    const numberValue = Number(value);\n    if (Number.isFinite(numberValue)) return numberValue;\n  }\n  return null;\n};\n\nconst records = asArray(articleOutput);\nconst explicitCount = firstNumber([\n  articleOutput?.count,\n  articleOutput?.recordCount,\n  articleOutput?.totalCount,\n  articleOutput?.totalResults,\n  articleOutput?.totalSize,\n  articleOutput?.result?.count,\n  articleOutput?.result?.recordCount,\n  articleOutput?.result?.totalCount,\n  articleOutput?.result?.totalResults,\n  articleOutput?.result?.totalSize\n]);\nconst recordCount = explicitCount === null ? records.length : explicitCount;\nconst referenceKey = currentContentType.referenceKey || currentContentType.contentType || currentContentType.contentTypeCode || \"\";\nconst name = currentContentType.name || currentContentType.Name || \"\";\nconst normalize = value => String(value ?? \"\").trim().toLowerCase();\nconst currentKeys = [referenceKey, name].map(normalize).filter(Boolean);\nconst updatedCounts = existingCounts.filter(item => {\n  const itemKeys = [item?.referenceKey, item?.name, item?.contentType, item?.contentTypeCode]\n    .map(normalize)\n    .filter(Boolean);\n  return !itemKeys.some(key => currentKeys.includes(key));\n});\n\nupdatedCounts.push({\n  referenceKey,\n  name,\n  recordCount\n});\n\nreturn updatedCounts;",
                    "returnType": "object"
                  },
                  "outcomes": {
                    "success": "1778728253976_set_counts"
                  },
                  "code": "COUNT_ARTICLES_FOR_CONTENT_TYPE",
                  "id": "1778728253976_count_articles",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE",
