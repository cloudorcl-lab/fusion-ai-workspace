{
  "workflowId": "300000327004107",
  "workflowCode": "ORA_PROGRAM_ADVISOR_CONTENT_WORKFLOW",
  "name": "Program Advisor Content Workflow",
  "description": "This agent analyzes and reviews a wide range of content types—including demo videos, eBooks, success stories, recommendations, and analyst reports—to extract key insights and generate clear, actionable outputs. It summarizes core messages, highlights value and impact, identifies trends and opportunities, and produces concise, business-ready recommendations tailored to the intended audience and use case.",
