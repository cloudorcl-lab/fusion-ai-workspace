            "sourceCode": "function mergeCurrentWithPrior( CurrentPeriod, PriorPeriod) {\n  const originalList = Array.isArray( CurrentPeriod) ? CurrentPeriod : null;\n  if( ! originalList || originalList.length === 0) {\n    return originalList;\n  }\n  const priorList = Array.isArray( PriorPeriod) ? PriorPeriod : [];\n  const priorLookup = new Map();\n  for( const priorItem of priorList) {\n    if( ! priorItem) {\n      continue;\n    }\n    const key = `${priorItem.InventoryOrgId ?? \"null\"}::${priorItem.InventoryItemId ?? \"null\"}`;\n    priorLookup.set( key, priorItem);\n  }\n  return originalList.map(( currentItem) => {\n    if( ! currentItem) {\n      return currentItem;\n    }\n    const key = `${currentItem.InventoryOrgId ?? \"null\"}::${currentItem.InventoryItemId ?? \"null\"}`;\n    const matchedPrior = priorLookup.get( key);\n    const priorRecognizedGrossMargin = matchedPrior?.RecognizedGrossMargin ?? null;\n    const currentRecognizedGrossMargin = currentItem.RecognizedGrossMargin ?? null;\n    const moMGrossMargin = priorRecognizedGrossMargin === null || currentRecognizedGrossMargin === null || priorRecognizedGrossMargin === 0 ? null : (( currentRecognizedGrossMargin - priorRecognizedGrossMargin) / priorRecognizedGrossMargin) * 100;\n    return {\n      ... currentItem,\n      PriorRecognizedRevenue: matchedPrior?.RecognizedRevenue ?? null,\n      PriorRecognizedCOGSAmount: matchedPrior?.RecognizedCOGSAmount ?? null,\n      PriorRecognizedGrossMargin: matchedPrior?.RecognizedGrossMargin ?? null,\n      PriorRecGrossMarginPercent: matchedPrior?.RecGrossMarginPercent ?? null,\n      MoMGrossMarginPercent: moMGrossMargin,\n    };\n  });\n}\n\nconst CurrentPeriod = $context.$variables.grossMarginItemsSummary.items;\nconst PriorPeriod = $context.$variables.grossMarginItemsSummaryPriorPeriod.items;\nconst mergedList = mergeCurrentWithPrior( CurrentPeriod, PriorPeriod);\n\nif (Array.isArray(mergedList)) {\n  mergedList.sort((a, b) => {\n    const aValue = a?.MoMGrossMarginPercent;\n    const bValue = b?.MoMGrossMarginPercent;\n\n    if (aValue == null && bValue == null) {\n      return 0;\n    }\n\n    if (aValue == null) {\n      return 1;\n    }\n\n    if (bValue == null) {\n      return -1;\n    }\n\n    return bValue - aValue;\n  });\n}\n\nreturn mergedList;"
          },
