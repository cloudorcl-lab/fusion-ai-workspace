        {
          "metadata": {
            "name": "Extract Context",
            "returnType": "object",
            "sourceCode": "const rawOutput = $context?.$nodes?.ESTABLISH_CONTEXT?.$output?.output;\nlet parsed = {};\n\ntry {\n  parsed =\n    typeof rawOutput === \"string\"\n      ? JSON.parse(rawOutput)\n      : rawOutput || {};\n} catch (e) {\n  parsed = {};\n}\n\nconst result = parsed?.result || {};\nconst data = result?.data || {};\n\nreturn {\n  ok: result?.ok ?? false,\n  status: result?.status ?? null,\n  mode: result?.mode ?? null,\n\n  CostOrganizationName: data?.CostOrganizationName ?? null,\n  CostOrganizationId: data?.CostOrganizationId ?? null,\n  CostBookCode: data?.CostBookCode ?? null,\n  CostBookId: data?.CostBookId ?? null,\n  PeriodName: data?.PeriodName ?? null,\n  LedgerId: data?.LedgerId ?? null,\n  PeriodStartDate: data?.PeriodStartDate ?? null,\n  PeriodEndDate: data?.PeriodEndDate ?? null,\n  PeriodStatusCode: data?.PeriodStatusCode ?? null,\n  errorCode: result?.errorCode ?? null,\n  errorMessage: result?.errorMessage ?? null\n};"
          },
