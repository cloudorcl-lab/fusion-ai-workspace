        {
          "metadata": {
            "name": "Match DCOGS By Inventory Org",
            "returnType": "array",
            "sourceCode": "function mergeCurrentWithPrior( CurrentPeriod, PriorPeriod) {\n  const originalList = Array.isArray( CurrentPeriod) ? CurrentPeriod : null;\n  if( ! originalList || originalList.length === 0) {\n    return originalList;\n  }\n  const priorList = Array.isArray( PriorPeriod) ? PriorPeriod : [];\n  const priorLookup = new Map();\n  for( const priorItem of priorList) {\n    if( ! priorItem) {\n      continue;\n    }\n    const key = `${priorItem.InventoryOrgId ?? \"null\"}`;\n    priorLookup.set( key, priorItem);\n  }\n  return originalList.map(( currentItem) => {\n    if( ! currentItem) {\n      return currentItem;\n    }\n    const key = `${currentItem.InventoryOrgId ?? \"null\"}`;\n    const matchedPrior = priorLookup.get( key);\n    const priorDCOGSPeriodActivity = matchedPrior?.DCOGSPeriodActivity ?? null;\n    const currentDCOGSPeriodActivity = currentItem.DCOGSPeriodActivity ?? null;\n    const moMPeriodActivity = priorDCOGSPeriodActivity === null || currentDCOGSPeriodActivity === null || priorDCOGSPeriodActivity === 0 ? null : (( currentDCOGSPeriodActivity - priorDCOGSPeriodActivity) / priorDCOGSPeriodActivity) * 100;\n    return {\n      ... currentItem,\n      PriorUnrecognizedRevenueHalfYear: matchedPrior?.UnrecognizedRevenueHalfYear ?? null,\n      PriorUnrecognizedRevenueAmountHalfYear: matchedPrior?.UnrecognizedRevenueAmountHalfYear ?? null,\n      PriorUnrecGrossMarginHalfYear: matchedPrior?.UnrecGrossMarginHalfYear ?? null,\n      PriorUnrecGrossMarginPercentHalfYear: matchedPrior?.UnrecGrossMarginPercentHalfYear ?? null,\n      PriorDCOGSPeriodActivity : matchedPrior?.DCOGSPeriodActivity ?? null,\n      MoMPeriodActivity: moMPeriodActivity,\n    };\n  });\n}\n\nconst CurrentPeriod = $context.$variables.dCOGSInventorySummary.items;\nconst PriorPeriod = $context.$variables.dCOGSInventorySummaryPriorPeriod.items;\nconst mergedList = mergeCurrentWithPrior( CurrentPeriod, PriorPeriod);\n\nif (Array.isArray(mergedList)) {\n  mergedList.sort((a, b) => {\n    const aValue = a?.MoMPeriodActivity;\n    const bValue = b?.MoMPeriodActivity;\n\n    if (aValue == null && bValue == null) {\n      return 0;\n    }\n\n    if (aValue == null) {\n      return 1;\n    }\n\n    if (bValue == null) {\n      return -1;\n    }\n\n    return bValue - aValue;\n  });\n}\n\nreturn mergedList;"
          },
          "outcomes": {
            "success": "1779758984941"
          },
          "code": "MATCH_DCOGS_BY_INVENTORY_ORG",
          "id": "1781582551232",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Prior Period Name",
            "returnType": "string",
            "sourceCode": "// Input period name\nlet periodName = $context.$variables.periodName ; //\"Oct-25\"Change this to your input period\n\nconst formats = [\n    \"MMM-YYYY\",    // \"Jan-2024\"\n    \"MMM YYYY\",    // \"Jan 2024\"\n    \"MMMM YYYY\",   // \"January 2024\"\n    \"MMM-YY\",      // \"Oct-25\" -> \"Sep 2025\"\n    \"YYYYMM\",      // \"202401\"\n    \"YYYY-MM\",     // \"2024-01\"\n    \"YYYY MM\",     // \"2024 01\"\n    \"YYYY/MM\",     // \"2024/01\"\n];\n\n// Mapping for month abbreviations (for formats like \"Oct-2025\")\nconst monthMap = {\n    'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,\n    'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11\n};\n\nconst monthMapReverse = {\n    0:'Jan', 1:'Feb', 2:'Mar', 3:'Apr', 4:'May', 5:'Jun',\n    6:'Jul', 7:'Aug', 8:'Sep', 9:'Oct', 10:'Nov', 11:'Dec'\n};\n\nlet date = null;\nlet matchedFormat = null;\nlet matchedRegex = null;\nlet matchedMatch = null;\n\n// Try each format to parse the date\nfor (let format of formats) {\n    let dateParts = {};\n    let regex = null;\n\n    // Get the appropriate regex for the current format\n    if (format === \"MMM-YYYY\") {\n        regex = /([a-zA-Z]{3})-(\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMM YYYY\") {\n        regex = /([a-zA-Z]{3}) (\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMMM YYYY\") {\n        regex = /([a-zA-Z]+) (\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMM-YY\") {\n        regex = /([a-zA-Z]{3})-(\\d{2})/;  // Two-digit year\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"YYYYMM\") {\n        regex = /(\\d{4})(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY-MM\") {\n        regex = /(\\d{4})-(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY MM\") {\n        regex = /(\\d{4}) (\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY/MM\") {\n        regex = /(\\d{4})\\/(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    }\n\n    // Try matching the period name to the regex for this format\n    let match = periodName.match(regex);\n    matchedMatch = match;\n    if (match) {\n        let year = match[dateParts.yearIndex];\n        let month = match[dateParts.monthIndex];\n        let day = match[dateParts.dayIndex] || 1; // Default to day 1 if not present\n\n        // If the format is MMM-YYYY, map month abbreviation to month index\n        if (format === \"MMM-YYYY\" || format === \"MMM YYYY\" || format === \"MMM-YY\") {\n            month = monthMap[match[dateParts.monthIndex]];\n        } else {\n            month = parseInt(month) - 1; // JavaScript months are 0-indexed\n        }\n\n        // If the format is \"MMM-YY\", handle two-digit year and convert to 4-digit year\n        if (format === \"MMM-YY\") {\n            let twoDigitYear = match[dateParts.yearIndex];\n            year = '20' + twoDigitYear;  // Convert \"25\" to \"2025\", etc.\n        }\n\n        // Create a JavaScript Date object (months are 0-indexed in JS)\n        date = new Date(year, month, day); // month is 0-indexed in JS\n        matchedFormat = format;\n        matchedRegex = regex;\n        break; // Exit loop once matched\n    }\n}\n\n// If no match was found, raise an error\nif (!date) {\n    throw new Error(`Unrecognized period format: ${periodName}`);\n}\n\n// Subtract one month, handling year wraparound (Jan -> Dec of previous year)\nlet priorDate = new Date(date);\npriorDate.setMonth(priorDate.getMonth() - 1);\n\n// Manually format the prior date as MMM-YYYY\nlet priorMonthNumber = priorDate.getMonth(); // Get the month number\nlet priorMonth;\n// If the format is MMM-YYYY, map month abbreviation to month index\nif (matchedFormat === \"MMM-YYYY\" || matchedFormat === \"MMM YYYY\" || matchedFormat === \"MMM-YY\") {\n    priorMonth = monthMapReverse[priorMonthNumber];\n} else {\n    priorMonth = parseInt(priorMonthNumber) - 1; // JavaScript months are 0-indexed\n}\n\nlet priorYear = priorDate.getFullYear();\nlet priorYearShort = priorYear.toString().slice(-2);  // Get last two digits of the year\n\n// Combine the formatted result (e.g., \"Sep-2024\" or \"Sep-24\")\nlet priorPeriodName = matchedFormat === \"MMM-YY\" ? `${priorMonth}-${priorYearShort}` : `${priorMonth}-${priorYear}`;\n\n// Output the prior period in the expected format\nreturn priorPeriodName;"
          },
          "outcomes": {
            "success": "1771269836454"
          },
          "code": "CALCULATE_PRIOR_PERIOD_NAME",
          "id": "1770927737021",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Calculate Prior Year Period Name",
            "returnType": "string",
            "sourceCode": "// Input period name\nlet periodName = $context.$variables.periodName ; //\"Oct-25\"Change this to your input period\n\n\nconst formats = [\n    \"MMM-YYYY\",    // \"Jan-2024\"\n    \"MMM YYYY\",    // \"Jan 2024\"\n    \"MMMM YYYY\",   // \"January 2024\"\n    \"MMM-YY\",      // \"Oct-25\" -> \"Oct 2025\"\n    \"YYYYMM\",      // \"202401\"\n    \"YYYY-MM\",     // \"2024-01\"\n    \"YYYY MM\",     // \"2024 01\"\n    \"YYYY/MM\",     // \"2024/01\"\n];\n\n// Mapping for month abbreviations (for formats like \"Oct-2025\")\nconst monthMap = {\n    'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5,\n    'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11\n};\n\n// Mapping for month abbreviations (for formats like \"Oct-2025\")\nconst monthMapReverse = {\n    0:'Jan', 1:'Feb', 2:'Mar', 3:'Apr', 4:'May', 5:'Jun',\n    6:'Jul', 7:'Aug', 8:'Sep', 9:'Oct', 10:'Nov', 11:'Dec'\n};\n\nlet date = null;\nlet matchedFormat = null;\nlet matchedRegex = null;\nlet matchedMatch = null;\n\n// Try each format to parse the date\nfor (let format of formats) {\n    let dateParts = {};\n    let regex = null;\n\n    // Get the appropriate regex for the current format\n    if (format === \"MMM-YYYY\") {\n        regex = /([a-zA-Z]{3})-(\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMM YYYY\") {\n        regex = /([a-zA-Z]{3}) (\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMMM YYYY\") {\n        regex = /([a-zA-Z]+) (\\d{4})/;\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"MMM-YY\") {\n        regex = /([a-zA-Z]{3})-(\\d{2})/;  // Two-digit year\n        dateParts = { yearIndex: 2, monthIndex: 1, dayIndex: 3 };\n    } else if (format === \"YYYYMM\") {\n        regex = /(\\d{4})(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY-MM\") {\n        regex = /(\\d{4})-(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY MM\") {\n        regex = /(\\d{4}) (\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    } else if (format === \"YYYY/MM\") {\n        regex = /(\\d{4})\\/(\\d{2})/;\n        dateParts = { yearIndex: 1, monthIndex: 2, dayIndex: 3 };\n    }\n\n    // Try matching the period name to the regex for this format\n    let match = periodName.match(regex);\n    matchedMatch = match;\n    if (match) {\n        let year = match[dateParts.yearIndex];\n        let month = match[dateParts.monthIndex];\n        let day = match[dateParts.dayIndex] || 1; // Default to day 1 if not present\n\n        // If the format is MMM-YYYY, map month abbreviation to month index\n        if (format === \"MMM-YYYY\" || format === \"MMM YYYY\" || format === \"MMM-YY\") {\n            month = monthMap[match[dateParts.monthIndex]];\n        } else {\n            month = parseInt(month) - 1; // JavaScript months are 0-indexed\n        }\n\n        // If the format is \"MMM-YY\", handle two-digit year and convert to 4-digit year\n        if (format === \"MMM-YY\") {\n            let twoDigitYear = match[dateParts.yearIndex];\n            year = '20' + twoDigitYear;  // Convert \"25\" to \"2025\", etc.\n        }\n\n        // Create a JavaScript Date object (months are 0-indexed in JS)\n        date = new Date(year, month, day); // month is 0-indexed in JS\n        matchedFormat = format;\n        matchedRegex = regex;\n        break; // Exit loop once matched\n    }\n}\n\n// If no match was found, raise an error\nif (!date) {\n    throw new Error(`Unrecognized period format: ${periodName}`);\n}\n\n// Subtract one year, handling Feb 29 -> Feb 28 for non-leap previous year\nlet priorDate = null;\ntry {\n    priorDate = new Date(date);\n    priorDate.setFullYear(priorDate.getFullYear() - 1);\n} catch (e) {\n    // Handle Feb 29 case (non-leap year)\n    priorDate = new Date(date);\n    priorDate.setFullYear(priorDate.getFullYear() - 1);\n    priorDate.setDate(28); // Set to Feb 28 if prior year isn't a leap year\n}\n\n//Manually format the prior date as MMM-YYYY\n//let priorMonth = priorDate.toLocaleString('en', { month: 'short' }); // Get 3-letter month abbreviation\nlet priorMonthNumber = priorDate.getMonth(); // Get 3-letter month abbreviation\nlet priorMonth;\n// If the format is MMM-YYYY, map month abbreviation to month index\n        if (matchedFormat === \"MMM-YYYY\" || matchedFormat === \"MMM YYYY\" || matchedFormat === \"MMM-YY\") {\n            priorMonth = monthMapReverse[priorMonthNumber];\n        } else {\n            priorMonth = parseInt(priorMonthNumber) - 1; // JavaScript months are 0-indexed\n        }\n\nlet priorYear = priorDate.getFullYear();\nlet priorYearShort = priorYear.toString().slice(-2);  // Get last two digits of the year\n\n// Combine the formatted result (e.g., \"Oct-2024\" or \"Oct-25\")\nlet priorYearPeriodName = matchedFormat === \"MMM-YY\" ? `${priorMonth}-${priorYearShort}` : `${priorMonth}-${priorYear}`;\n\n// Output the prior year period in the expected format\nreturn priorYearPeriodName;"
          },
          "outcomes": {
            "success": "1770927937558"
          },
