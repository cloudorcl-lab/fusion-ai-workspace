        {
          "metadata": {
            "description": "",
            "name": "Match GM By Inventory Org",
            "returnType": "array",
            "sourceCode": "function mergeCurrentWithPrior( CurrentPeriod, PriorPeriod) {\n  const originalList = Array.isArray( CurrentPeriod) ? CurrentPeriod : null;\n  if( ! originalList || originalList.length === 0) {\n    return originalList;\n  }\n  const priorList = Array.isArray( PriorPeriod) ? PriorPeriod : [];\n  const priorLookup = new Map();\n  for( const priorItem of priorList) {\n    if( ! priorItem) {\n      continue;\n    }\n    const key = `${priorItem.InventoryOrgId ?? \"null\"}`;\n    priorLookup.set( key, priorItem);\n  }\n  return originalList.map(( currentItem) => {\n    if( ! currentItem) {\n      return currentItem;\n    }\n    const key = `${currentItem.InventoryOrgId ?? \"null\"}`;\n    const matchedPrior = priorLookup.get( key );\n    const priorRecGrossMargin = matchedPrior?.RecGrossMargin ?? null;\n    const currentRecGrossMargin = currentItem.RecGrossMargin ?? null;\n    const moMGrossMargin = priorRecGrossMargin === null || currentRecGrossMargin === null || priorRecGrossMargin === 0 ? null : (\n        (\n          ((currentRecGrossMargin - priorRecGrossMargin) / priorRecGrossMargin) *\n          100\n        ).toFixed(3)\n      );\n    \n    return {\n      ... currentItem,\n      PriorRecognizedRevenue: matchedPrior?.RecognizedRevenue ?? null,\n      PriorRecognizedCOGSAmount: matchedPrior?.RecognizedCOGSAmount ?? null,\n      PriorRecGrossMargin: matchedPrior?.RecGrossMargin ?? null,\n      PriorRecGrossMarginPercent: matchedPrior?.RecGrossMarginPercent ?? null,\n      MoMGrossMarginPercent: moMGrossMargin,\n    };\n  });\n}\n\nconst CurrentPeriod = $context.$variables.grossMarginInventorySummary.items;\nconst PriorPeriod =   $context.$variables.grossMarginInventorySummaryPriorPeriod.items;\nconst mergedList = mergeCurrentWithPrior( CurrentPeriod, PriorPeriod);\n\nif (Array.isArray(mergedList)) {\n  mergedList.sort((a, b) => {\n    const aValue = a?.MoMGrossMarginPercent;\n    const bValue = b?.MoMGrossMarginPercent;\n\n    if (aValue == null && bValue == null) {\n      return 0;\n    }\n\n    if (aValue == null) {\n      return 1;\n    }\n\n    if (bValue == null) {\n      return -1;\n    }\n\n    return bValue - aValue;\n  });\n}\n\nreturn mergedList;"
          },
          "outcomes": {
            "success": "1777921638424"
          },
          "code": "MATCH_GM_BY_INVENTORY_ORG",
          "id": "1781558642133",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Match GM By Customer",
            "returnType": "array",
            "sourceCode": "function mergeCurrentWithPrior( CurrentPeriod, PriorPeriod) {\n  const originalList = Array.isArray( CurrentPeriod) ? CurrentPeriod : null;\n  if( ! originalList || originalList.length === 0) {\n    return originalList;\n  }\n  const priorList = Array.isArray( PriorPeriod) ? PriorPeriod : [];\n  const priorLookup = new Map();\n  for( const priorItem of priorList) {\n    if( ! priorItem) {\n      continue;\n    }\n    const key = `${priorItem.InventoryOrgId ?? \"null\"}::${priorItem.InventoryItemId ?? \"null\"}`;\n    priorLookup.set( key, priorItem);\n  }\n  return originalList.map(( currentItem) => {\n    if( ! currentItem) {\n      return currentItem;\n    }\n    const key = `${currentItem.InventoryOrgId ?? \"null\"}::${currentItem.InventoryItemId ?? \"null\"}`;\n    const matchedPrior = priorLookup.get( key);\n    const priorRecognizedGrossMargin = matchedPrior?.RecognizedGrossMargin ?? null;\n    const currentRecognizedGrossMargin = currentItem.RecognizedGrossMargin ?? null;\n    const moMGrossMargin = priorRecognizedGrossMargin === null || currentRecognizedGrossMargin === null || priorRecognizedGrossMargin === 0 ? null : (( currentRecognizedGrossMargin - priorRecognizedGrossMargin) / priorRecognizedGrossMargin) * 100;\n    return {\n      ... currentItem,\n      PriorRecognizedRevenue: matchedPrior?.RecognizedRevenue ?? null,\n      PriorRecognizedCOGSAmount: matchedPrior?.RecognizedCOGSAmount ?? null,\n      PriorRecognizedGrossMargin: matchedPrior?.RecognizedGrossMargin ?? null,\n      PriorRecGrossMarginPercent: matchedPrior?.RecGrossMarginPercent ?? null,\n      MoMGrossMarginPercent: moMGrossMargin,\n    };\n  });\n}\n\nconst CurrentPeriod = $context.$variables.grossMarginCustomersSummary.items;\nconst PriorPeriod = $context.$variables.grossMarginCustomersSummaryPriorPeriod.items;\nconst mergedList = mergeCurrentWithPrior( CurrentPeriod, PriorPeriod);\n\nif (Array.isArray(mergedList)) {\n  mergedList.sort((a, b) => {\n    const aValue = a?.MoMGrossMarginPercent;\n    const bValue = b?.MoMGrossMarginPercent;\n\n    if (aValue == null && bValue == null) {\n      return 0;\n    }\n\n    if (aValue == null) {\n      return 1;\n    }\n\n    if (bValue == null) {\n      return -1;\n    }\n\n    return bValue - aValue;\n  });\n}\n\nreturn mergedList;"
          },
          "outcomes": {
            "success": "1779758638061"
          },
          "code": "MATCH_GM_BY_CUSTOMER",
          "id": "1781581250928",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Build a table by showing the item records on exact customer and item identifiers first.\nONLY Use your source of information to build the table from {{$context.$nodes.MATCH_DCOGS_BY_INVENTORY_ORG.$output.result}}\n\nlet CurrentPeriod = {{$context.$variables.periodName}}\nlet PriorPeriod = {{$context.$variables.priorPeriodName}}\n\nReturn exactly one row per matched or unmatched inventory record with these columns:\n- Inventory Org\n- Period Activity (<CurrentPeriod>)\n- Period Activity (<PriorPeriod>)\n- DCOGS > 30 Days (Last 6 Months)\n- MoM\n\nField mappings:\n- Inventory Org = InvOrgName\n- Period Activity (<CurrentPeriod>) = DCOGSPeriodActivity\n- Period Activity (<PriorPeriod>) = PriorDCOGSPeriodActivity\n- DCOGS > 30 Days (Last 6 Months) = UnrecognizedRevenueHalfYear.\n- MoM = MoMPeriodActivity\n    - MoM should always be shown as a percentage badge, signed, up to 2 decimals.\n    - Do not apply any round for the percentage.\n    - If MoM value is null, then display N/A\n    - For MoM -> in a badge with negative % value as red, positive % value as green, no change % value as grey.\n\nRules:\n- Never change the sign of any amount.\n- Never duplicate a matched row.\n- Sort the matched results by UnrecognizedRevenueHalfYear in descending order based on the current period values.\n- For MoM -> in a badge with negative % value as red, positive % value as green, no change % value as grey- Do not round. Do not infer additional decimals.\n- If any value is null, replace it with 'N/A' instead of null or zero, or '0'.\n- If more than 2 decimals exist, truncate to 2 decimals for display only.\n- If 2 or fewer decimals exist, preserve them exactly.\n- Do not round. Do not infer additional decimals."
            }
          },
          "metadata": {
            "name": "DCOGS by Inventory Orgs Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DCOGS_BY_INVENTORY_ORGS_SUMMARY",
          "id": "1779758984941",
          "inputs": [
            {
              "id": "1779758984944_1",
              "name": "prompt",
              "type": "string",
              "value": "Using the following data, please provide an analysis of the changes in gross margin across different periods:\n\n1. Current Period {{$context.$variables.periodName}} Gross Margin Summary: {{$context.$variables.dCOGSInventorySummary.items}} \n2. Prior Period {{$context.$variables.priorPeriodName}} Gross Margin Summary: {{$context.$variables.dCOGSInventorySummaryPriorPeriod.items}} \n\nDisplay the analysis if at least one of the nodes has data. If none of the nodes have data, do not display anything.\n\nDo not make up any financial data. Present only what you have access to.\n\nPlease present your analysis in the following format:\nChange from Prior Month: Compare the current period to the prior period.\n\nFocus on key differences, trends, and any significant changes. Keep your comments limited to 75 words.\n\n**STRICT Rules\n- Do not make up any financial data. Present only what you have access to.\n- Format amount values from the raw numeric value only.\n- Amount format must always use K/M/B units only.\n- Do not infer or rescale units from context. Use the provided numeric value exactly once and convert it only by dividing by 1,000, 1,000,000, or 1,000,000,000 based on magnitude.\n- Do not modify the sign (+/-) for amount values under any condition.\n- For calculated percentages, use raw input values without rounding, compute the result directly, and display it with up to 2 decimal places only.\n- Currency must always be uppercase code only (USD or EUR only, based on input currency).\n- Add the currency at the end of each quantity.\n- Examples: 620M USD, 2.3B EUR, 850K USD.\n- Always round to exactly 2 decimal places.\n- Never use more than 2 decimal places.\n- Use the current period (<CurrentPeriod>) as the base dataset.\n- Match prior period data to the current period data like a left outer join.\n- Always display for the current period *Maximum 10* records.\n- If prior period data is missing, set prior period values to 0.\n- Percent badges (like MoM): signed value, up to 2 decimals.\n- Do not round. Do not infer additional decimals.\n- If more than 2 decimals exist, truncate to 2 decimals for display only.\n- If 2 or fewer decimals exist, preserve them exactly."
            }
          ],
          "type": "LLM"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MULTIRECORD"
              ],
              "enableActions": false,
              "enableCommunications": false,
              "customNotes": "Build a table by showing the item records on exact customer and item identifiers first.\nONLY Use your source of information to build the table from {{$context.$nodes.MATCH_DCOGS_BY_CUSTOMER.$output.result}}\n\nlet CurrentPeriod = {{$context.$variables.periodName}}\nlet PriorPeriod = {{$context.$variables.priorPeriodName}}\n\nReturn exactly one row per matched or unmatched customer and item record with these columns:\n- Customer\n- Item\n- Period Activity (<CurrentPeriod>)\n- Period Activity (<PriorPeriod>)\n- DCOGS > 30 Days (Last 6 Months)\n- MoM\n\nField mappings:\n- Customer = CustomerName\n- Item = ItemNumber\n- Period Activity (<CurrentPeriod>) = DCOGSPeriodActivity\n- Period Activity (<PriorPeriod>) = PriorDCOGSPeriodActivity\n- DCOGS > 30 Days (Last 6 Months) = UnrecognizedRevenueHalfYear.\n- MoM = MoMPeriodActivity\n    - MoM should always be shown as a percentage badge, signed, up to 2 decimals.\n    - Do not apply any round for the percentage.\n    - If MoM value is null, then display N/A\n    - For MoM -> in a badge with negative % value as red, positive % value as green, no change % value as grey.\n\nRules:\n- Never change the sign of any amount.\n- Never duplicate a matched row.\n- Sort the matched results by UnrecognizedRevenueHalfYear in descending order based on the current period values.\n- For MoM -> in a badge with negative % value as red, positive % value as green, no change % value as grey- Do not round. Do not infer additional decimals.\n- If any value is null, replace it with 'N/A' instead of null or zero, or '0'.\n- If more than 2 decimals exist, truncate to 2 decimals for display only.\n- If 2 or fewer decimals exist, preserve them exactly.\n- Do not round. Do not infer additional decimals."
            }
          },
          "metadata": {
            "name": "DCOGS by Customers Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "DCOGS_BY_CUSTOMERS_SUMMARY",
