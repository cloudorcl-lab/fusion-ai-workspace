        {
          "metadata": {
            "name": "prepare location update payload",
            "returnType": "object",
            "sourceCode": "const derivedLocationId = $context.$nodes.FETCH_INTERNAL_LOCATION.$output.items[0]?.LocationId;\nconst requisitionHeaderId = $context.$nodes.PARSE_JSON_INPUT.$output.result.requisitionHeaderId;\n\nlet batchOpArray = [];\nlet updateattributes = {\"DeliverToLocationId\": derivedLocationId};\nlet locationObject = {};\n\n\nlocationObject['id'] = \"part1\";\nlocationObject['operation'] = \"invoke\";\nlocationObject['payload'] = {\"updateAttributes\": updateattributes};\nlocationObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/action/updateAllLines`;\nbatchOpArray.push(locationObject);\n\nlet result = {\"parts\": batchOpArray};\n\nreturn result;"
          },
