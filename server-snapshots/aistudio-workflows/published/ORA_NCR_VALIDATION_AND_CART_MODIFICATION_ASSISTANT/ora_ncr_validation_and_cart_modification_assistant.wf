          "metadata": {
            "name": "prepare UOM starts with and contains query param criteria in stage 1",
            "returnType": "object",
            "sourceCode": "let derivedUOM = $context.$variables.derivedUOM;\nconst currentDate = $context.$system.$currentDate;\nlet response = {};\nresponse['uomStartsWithCriteria'] = null;\nresponse['uomContainsCriteria'] = null;\n\nif(derivedUOM != null){\n  derivedUOM = derivedUOM.toUpperCase();\n\n  let uomStartswithCriteria = `StandardConversion > 0 AND (UOMCode is not null and (DisableDate is null or DisableDate >= '${currentDate}')) AND (StandardConversionEndDate IS NULL OR StandardConversionEndDate > '${currentDate}' ) AND ((UPPER(UOM) like ('${derivedUOM}%')) OR (UPPER(UOMCode) like ('${derivedUOM}%')))`;\n\nlet uomContainsCriteria = `StandardConversion > 0 AND (UOMCode is not null and (DisableDate is null or DisableDate >= '${currentDate}')) AND (StandardConversionEndDate IS NULL OR StandardConversionEndDate > '${currentDate}' ) AND ((UPPER(UOM) like ('%${derivedUOM}%')) OR (UPPER(UOMCode) like ('%${derivedUOM}%')))`;\n\nresponse['uomStartsWithCriteria'] = uomStartswithCriteria;\nresponse['uomContainsCriteria'] = uomContainsCriteria;\n}\n\nreturn response;"
          },
          "outcomes": {
            "success": "1767716687992"
          },
          "diagram": {
