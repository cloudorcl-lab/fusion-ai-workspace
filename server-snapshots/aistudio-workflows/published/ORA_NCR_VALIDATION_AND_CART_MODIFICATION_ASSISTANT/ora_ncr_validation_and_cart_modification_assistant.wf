          "metadata": {
            "name": "prepare Requester Update Payload",
            "returnType": "object",
            "sourceCode": "const derivedRequesterId = $context.$nodes.FETCH_REQUESTER.$output.items[0]?.PersonId;\nconst defaultLocationId = $context.$nodes.FETCH_REQUESTER.$output.items[0]?.LocationId;\nconst requisitionHeaderId = $context.$nodes.PARSE_JSON_INPUT.$output.result.requisitionHeaderId;\n\nlet batchOpArray = [];\nlet updateattributes = {\"RequesterId\": derivedRequesterId};\nif(defaultLocationId){\n  updateattributes['DeliverToLocationId'] = defaultLocationId;\n}\nlet requesterObject = {};\n\n\nrequesterObject['id'] = \"part1\";\nrequesterObject['operation'] = \"invoke\";\nrequesterObject['payload'] = {\"updateAttributes\": updateattributes};\nrequesterObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/action/updateAllLines`;\nbatchOpArray.push(requesterObject);\n\nlet result = {\"parts\": batchOpArray};\n\nreturn result;"
          },
