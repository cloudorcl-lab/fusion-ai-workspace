        {
          "metadata": {
            "name": "Prepare Location finder criteria",
            "returnType": "object",
            "sourceCode": "const DeliverToSiteOptinFlag = $context.$nodes.FETCH_DELIVER_TO_SITE_FEATURE.$output.EnabledFlag;\nconst userSearchLocation = $context.$nodes.EDIT_CART_FEEDBACK_ANALYZER.$output.InternalLocation;\nconst organizationId = $context.$nodes.PARSE_JSON_INPUT.$output.result.destinationOrganizationId; \n\nlet finderCriteria = `findByWord;FetchBlankInvOrgLocations=true,InventoryOrganizationId=${organizationId},SetId=${organizationId},SearchTerms=${userSearchLocation},FilterAttributes=LocationCode LocationName SingleLineAddress`;\n\nlet queryParam = DeliverToSiteOptinFlag === 'Y' ? `ActiveStatus = 'A' AND DeliverToSiteFlag='Y'` : `ActiveStatus = 'A'`;\n\nlet result = {\"finderCriteria\" : finderCriteria, \"queryParam\" : queryParam};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1767719985963"
          },
