        {
          "metadata": {
            "name": "prepare line quantity updates batch payload",
            "returnType": "object",
            "sourceCode": "const requisitionHeaderId = $context.$nodes.PARSE_JSON_INPUT.$output.result.requisitionHeaderId;\nconst userRequestedQuantityUpdates = $context.$nodes.EDIT_CART_FEEDBACK_ANALYZER.$output.QuantityUpdates;\nconst currentCartLines = $context.$nodes.FETCH_LINES_DATA_1.$output.items;\nlet batchUpdateQuantitiesArray = [];\nlet invalidQuantities = []\nlet response = {};\n\nconst formatQuantity = (input) => {\n  if (input == null || isNaN(input)) return input;\n  const num = Number(input);\n  const str = String(input);\n\n  if (Number.isInteger(num)) {\n    return num; \n  }\n   var parts = str.split('.');\n   var decimalLength = parts[1].length;\n   \n  if (decimalLength > 12) {\n    return num.toFixed(12);\n  }\n\n  return num;\n};\n\nfor(let i=0 ; i < userRequestedQuantityUpdates.length ; i++){\n       let LineNumber = Number((Object.keys(userRequestedQuantityUpdates[i]))[0]);\n       let input = (Object.values(userRequestedQuantityUpdates[i]))[0];\n       let isValidQuantity = !isNaN(input) && !isNaN(parseFloat(input)) && (Number(input) > 0);\n       let lineUpdateIndex = LineNumber - 1;\n       let quantityBasedLine = currentCartLines[lineUpdateIndex].Quantity != null;\n       if(isValidQuantity && (lineUpdateIndex >= 0 && lineUpdateIndex < currentCartLines.length) && quantityBasedLine){\n            let quantity = formatQuantity((Object.values(userRequestedQuantityUpdates[i]))[0]);\n             let requisitionLineId = currentCartLines[lineUpdateIndex].RequisitionLineId;\n             let distributionId = currentCartLines[lineUpdateIndex].distributions.items[0].RequisitionDistributionId;\n             let distributionArray = [];\n             distributionArray.push({\"Quantity\":quantity,\"RequisitionDistributionId\":distributionId});\n             let linePayload = {};\n             linePayload['Quantity'] = quantity;\n             linePayload['distributions'] = distributionArray\n             let lineObject = {};\n             lineObject['id'] = \"Line\"+i;\n             lineObject['operation'] = \"update\";\n             lineObject['payload'] = linePayload;\n             lineObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/child/lines/${requisitionLineId}`;\n             batchUpdateQuantitiesArray.push(lineObject);\n       }else{\n          if(quantityBasedLine){\n             invalidQuantities.push(userRequestedQuantityUpdates[i]);\n           }\n       }\n   }\n\nresponse['payload'] = {\"parts\" : batchUpdateQuantitiesArray};\nresponse['errorLines'] = invalidQuantities;\nreturn response;"
          },
          "outcomes": {
            "success": "1767786222092"
          },
          "diagram": {
            "x": 7506.675593159907,
            "y": 10736.52651558215
          },
          "code": "PREPARE_LINE_QUANTITY_UPDATES_BATCH_PAYLOAD",
          "id": "1767785022075",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
