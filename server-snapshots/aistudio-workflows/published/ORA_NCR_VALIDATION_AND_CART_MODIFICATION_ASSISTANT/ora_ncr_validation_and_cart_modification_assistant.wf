        {
          "metadata": {
            "name": "prepare delete lines batch payload",
            "returnType": "object",
            "sourceCode": "const requisitionHeaderId = $context.$nodes.PARSE_JSON_INPUT.$output.result.requisitionHeaderId;\nconst userRequestedDeleteLines = $context.$nodes.EDIT_CART_FEEDBACK_ANALYZER.$output.DeleteLines;\nconst currentCartLines = $context.$nodes.FETCH_LINES_DATA.$output.items;\nlet batchDeleteLinesArray = [];\n\nfor(let i=0 ; i < userRequestedDeleteLines.length ; i++){\n       let lineDeleteIndex = userRequestedDeleteLines[i] - 1;\n       if(lineDeleteIndex >= 0 && lineDeleteIndex < currentCartLines.length){\n             let lineObject = {};\n             let requisitionLineId = currentCartLines[lineDeleteIndex].RequisitionLineId;\n             lineObject['id'] = \"Line\"+i;\n             lineObject['operation'] = \"delete\";\n             lineObject['payload'] = null;\n             lineObject['path'] = `/purchaseRequisitions/${requisitionHeaderId}/child/lines/${requisitionLineId}`;\n             batchDeleteLinesArray.push(lineObject);\n       }\n   }\n\nlet result = {\"parts\" : batchDeleteLinesArray};\n\nreturn result;"
          },
