            "returnType": "string",
            "sourceCode": "const uomStartsWithRecords = $context.$nodes.FETCH_UOM_FROM_STARTS_WITH_SEARCH_IN_STAGE_1.$output;\nconst uomContainsRecords = $context.$nodes.FETCH_UOM_FROM_CONTAINS_SEARCH_IN_STAGE_1.$output;\nlet isValidUOM = false;\nlet derivedUOM = $context.$variables.derivedUOM;\n\nif(derivedUOM != null){\n   if(uomStartsWithRecords.items.length > 0){\n      derivedUOM = uomStartsWithRecords.items[0].UOM;\n      isValidUOM = true;\n   }else if(uomContainsRecords.items.length > 0){\n     derivedUOM = uomStartsWithRecords.items[0].UOM;\n     isValidUOM = true;\n  }\n}\n\nderivedUOM = isValidUOM ? derivedUOM : null;\n\nreturn derivedUOM;"
          },
