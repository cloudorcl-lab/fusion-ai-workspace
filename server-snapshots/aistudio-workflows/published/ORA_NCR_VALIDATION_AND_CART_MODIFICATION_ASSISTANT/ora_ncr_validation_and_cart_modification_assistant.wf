        {
          "metadata": {
            "name": "Process Final Output",
            "returnType": "object",
            "sourceCode": "let response = {};\n\nif($context.$nodes.PARSE_JSON_INPUT.$output.result.Stage == 1){\n  response['derivedUOM'] =  $context.$variables.derivedUOM; \n}\n\nif($context.$nodes.PARSE_JSON_INPUT.$output.result.Stage == 2){\n   response['categoryMatchRecords'] = $context.$nodes.FETCH_CATEGORY_NAME_1.$output?.items;\n   response['CategoryVectorDbRecords'] = $context.$nodes.FETCH_CATEGORY_FROM_VECTOR_DB_1.$output;\n   response['uomMatchRecords'] = $context.$nodes.FETCH_UOM_FROM_STARTS_WITH_SEARCH_1.$output?.items \n   response['uomContainsRecords'] = $context.$nodes.FETCH_UOM_FROM_CONTAINS_SEARCH_1.$output?.items;\n   response['userProvidedData'] = $context.$nodes.NCR_FEEDBACK_ANALYSER_1.$output;\n}\n\nif($context.$nodes.PARSE_JSON_INPUT.$output.result.Stage == 3){\n   response['uomMatchRecords'] = $context.$nodes.FETCH_UOM_FROM_STARTS_WITH_SEARCH_IN_STAGE_3.$output?.items;\n   response['uomContainsRecords'] = $context.$nodes.FETCH_UOM_FROM_CONTAINS_SEARCH_IN_STAGE_3.$output?.items; \n   response['userProvidedData'] = $context.$nodes.PRICE_AND_UOM_EXTRACTOR.$output;\n}\n\nif($context.$nodes.PARSE_JSON_INPUT.$output.result.Topic == 2){\n   response['userProvidedData'] = $context.$nodes.EDIT_CART_FEEDBACK_ANALYZER.$output;\n\n if(response.userProvidedData.Requester != null){\n       response['RequesterChangeStatus'] = {};\n       if( $context.$nodes.FETCH_REQUESTER.$output.items.length > 0){\n            response['RequesterChangeStatus']['foundRequester'] = true;\n            response['RequesterChangeStatus']['updateRequesterStatus'] = $context.$variables.requesterUpdateStatus  == 'SUCCESS' ? $context.$variables.requesterUpdateStatus : 'FAILURE';\n            response['RequesterChangeStatus']['locationDefaulted'] = $context.$variables.locationDefaulted; \n            response['RequesterChangeStatus']['RequesterName'] = $context.$nodes.FETCH_REQUESTER.$output.items[0]?.DisplayName;\n       }else{\n           response['RequesterChangeStatus']['foundRequester'] = false;\n           response['RequesterChangeStatus']['updateRequesterStatus'] = 'FAILURE';\n           response['RequesterChangeStatus']['RequesterName'] = null;\n       }  \n   }\n\n   if(response.userProvidedData.InternalLocation != null){\n       response['LocationChangeStatus'] = {};\n       if( $context.$nodes.FETCH_INTERNAL_LOCATION.$output.items.length > 0){\n            response['LocationChangeStatus']['foundLocation'] = true;\n            response['LocationChangeStatus']['updateLocationStatus'] = $context.$variables.locationUpdateStatus == 'SUCCESS' ? $context.$variables.locationUpdateStatus : 'FAILURE';\n            response['LocationChangeStatus']['LocationCode'] = $context.$variables.locationCode;\n            response['LocationChangeStatus']['LocationName'] = $context.$variables.LocationName;\n       }else{\n           response['LocationChangeStatus']['foundLocation'] = false;\n           response['LocationChangeStatus']['updateLocationStatus'] = 'FAILURE';\n            response['LocationChangeStatus']['LocationCode'] = $context.$variables.locationCode;\n            response['LocationChangeStatus']['LocationName'] = $context.$variables.LocationName;\n       }  \n   }\n\n    if(response.userProvidedData.DeleteLines != null){\n       response['LinesDelete'] = {};\n       if($context.$nodes.PREPARE_DELETE_LINES_BATCH_PAYLOAD.$output.result.parts.length > 0){\n            response['LinesDelete']['DeleteLinesExist'] = true;\n            response['LinesDelete']['DeleteLinesStatus'] = $context.$variables.linesDeleteStatus == 'SUCCESS' ? $context.$variables.linesDeleteStatus : 'FAILURE';\n            response['LinesDelete']['TotalLines'] = $context.$nodes.PREPARE_DELETE_LINES_BATCH_PAYLOAD.$output.result.parts.length;\n       }else{\n           response['LinesDelete']['DeleteLinesExist'] = false;\n           response['LinesDelete']['DeleteLinesStatus'] = 'FAILURE';\n           response['LinesDelete']['TotalLines'] = 0;\n       }  \n   }\n\nif(response.userProvidedData.QuantityUpdates != null){\n       response['QuantityUpdates'] = {};\n       if($context.$variables.quantitiesUpdateStatus == 'SUCCESS'){\n            response['QuantityUpdates']['quantityUpdatesExist'] = true;\n            response['QuantityUpdates']['quantityUpdateStatus'] = 'SUCCESS' ;\n            response['QuantityUpdates']['TotalLines'] = $context.$nodes.PREPARE_LINE_QUANTITY_UPDATES_BATCH_PAYLOAD.$output.result.payload.parts.length;\n       }else{\n           response['QuantityUpdates']['quantityUpdatesExist'] = false;\n           response['QuantityUpdates']['quantityUpdateStatus'] = 'FAILURE';\n           response['QuantityUpdates']['TotalLines'] = $context.$nodes.PREPARE_LINE_QUANTITY_UPDATES_BATCH_PAYLOAD.$output.result.errorLines;\n       }  \n   }\n}\n\nreturn response;"
          },
          "outcomes": {
            "success": "end"
          },
