                  },
                  "id": "end_1769757535654",
                  "code": "END_1769757535654",
                  "type": "END"
                },
                {
                  "metadata": {
                    "name": "Find Deviations",
                    "returnType": "object",
                    "sourceCode": "var answer = {};\n\nvar current = $context.$nodes.LOOP_OVER_ACTIVITIES.$currentItem;\n\nvar activities =\n  current.Activities || [];\n\nvar cardId =\n  current.KanbanCardId;\n\nvar supplierName =\n  current.SupplierName;\n\nvar pullSequenceId =\n  current.PullSequenceId;\n\n// Pull Sequence details node inside loop\n// var pullSeq =\n//   $context.$nodes.GET_PULL_SEQUENCE_DETAILS_BY_ID.$output || {};\n\n// var replenishLeadTime =\n//   Number(pullSeq.ReplenishmentLeadTime) || 0;\n\nvar latestInProcessTime = null;\nvar latestFullTime = null;\n\n// --- Find latest timestamps ---\nlet replenishLeadTime=0;\nfor (var i = 0; i < activities.length; i++) {\n  var a = activities[i];\n  replenishLeadTime = Number(a.REPLENISHMENTLEADTIME)??0;\n  var t = new Date(a.TIMEUPDATED);\n\n  if (a.TOSUPPLYSTATUS == 5) {\n    if (!latestInProcessTime || t > latestInProcessTime) {\n      latestInProcessTime = t;\n    }\n  }\n\n  if (a.TOSUPPLYSTATUS == 2) {\n    if (!latestFullTime || t > latestFullTime) {\n      latestFullTime = t;\n    }\n  }\n}\n\n// Missing lifecycle → skip\nif (!latestInProcessTime || !latestFullTime)\n  return answer;\n\n// Still in process → skip\nif (latestInProcessTime > latestFullTime)\n  return answer;\n\nvar actualTimeInMs =\n  latestFullTime - latestInProcessTime;\n\nvar allowedTimeInMs =\n  1.02 * replenishLeadTime * 24 * 60 * 60 * 1000;\n\n// Within SLA → skip\nif (actualTimeInMs <= allowedTimeInMs)\n  return answer;\n\n// --- SLA Breach ---\nanswer = {\n  KanbanCardId: cardId,\n  SupplierName: supplierName,\n  PullSequenceId: pullSequenceId,\n  InProcessTime: latestInProcessTime,\n  FullTime: latestFullTime,\n  ActualSupplierProcessingTimeInMs: actualTimeInMs,\n  AllowedTimeInMs: allowedTimeInMs,\n  ItemNumber: activities[0]?.ITEMNUMBER || activities[0]?.itemNumber || \"\",\n  BreachPercent:\n    ((actualTimeInMs - allowedTimeInMs) / allowedTimeInMs) * 100,\n  SLA_Breached: true\n};\n\nreturn answer;"
                  },
                  "outcomes": {
                    "success": "end_1769757535654"
                  },
                  "code": "FIND_DEVIATIONS",
                  "id": "1769758732400",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                }
