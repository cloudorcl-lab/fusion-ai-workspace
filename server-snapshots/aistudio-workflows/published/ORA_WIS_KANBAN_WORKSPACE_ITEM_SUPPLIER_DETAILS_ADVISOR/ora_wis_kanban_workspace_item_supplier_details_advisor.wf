        {
          "metadata": {
            "name": "Group by Kanban Card Id",
            "returnType": "array",
            "sourceCode": "const activities =\n  $context.$nodes.GET_FILTERED_KANBAN_CARD_ACTIVITIES.$output || [];\n\n// Temporary map for grouping\nconst tempMap = {};\n\n// Group by KanbanCardId\nfor (const a of activities) {\n  const cardId = a.KANBANCARDID;\n\n  if (!tempMap[cardId]) {\n    tempMap[cardId] = [];\n  }\n\n  tempMap[cardId].push(a);\n}\n\n// Convert map → array of objects\nconst activitiesByKanbanCard = Object.keys(tempMap).map(cardId => ({\n  KanbanCardId: Number(cardId),\n  Activities: tempMap[cardId]\n}));\n\nreturn activitiesByKanbanCard;"
          },
          "outcomes": {
            "success": "1769753505609"
          },
          "code": "GROUP_BY_KANBAN_CARD_ID",
          "id": "1769754699783",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Filter Map",
            "returnType": "array",
            "sourceCode": "var loopOutput = $context.$nodes.LOOP_OVER_PULL_SEQUENCES.$output;\nvar map = $context.$nodes.GROUP_BY_KANBAN_CARD_ID.$output.result;\nvar idData = {};   // store supplier + pull sequence\nvar filtered = [];\n\n// --- Extract data from loop ---\nfor (var i = 0; i < loopOutput.length; i++) {\n  try {\n    var obj = JSON.parse(loopOutput[i]);\n\n    if (obj.items && obj.items.length) {\n      for (var j = 0; j < obj.items.length; j++) {\n        var card = obj.items[j];\n\n        if (card.KanbanCardId) {\n          idData[String(card.KanbanCardId)] = {\n            SupplierName: card.SupplierName || null,\n            PullSequenceId: card.PullSequenceId || null\n          };\n        }\n      }\n    }\n\n  } catch (e) {}\n}\n\n// --- Filter map + inject fields ---\nfor (var k = 0; k < map.length; k++) {\n  var cardId = String(map[k].KanbanCardId);\n\n  if (idData[cardId]) {\n    map[k].SupplierName =\n      idData[cardId].SupplierName;\n\n    map[k].PullSequenceId =\n      idData[cardId].PullSequenceId;\n\n    filtered.push(map[k]);\n  }\n}\n\nreturn filtered;"
          },
          "outcomes": {
            "success": "1769757535654"
          },
          "code": "FILTER_MAP",
          "id": "1769755807900",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "dataPipeline": {
              "pipelineNodes": [
                {
                  "metadata": {
                    "name": "Start",
                    "description": "Start of data pipeline"
                  },
                  "outcomes": {
                    "success": "1769758732400"
                  },
                  "id": "start_1769757535654",
                  "code": "START_1769757535654",
                  "type": "START"
                },
                {
                  "metadata": {
                    "name": "End",
