        },
        {
          "metadata": {
            "name": "Extract Global Settings",
            "returnType": "object",
            "sourceCode": "// 1. Define the specific keys you want to extract\nconst keysToExtract = [\n  \"ORA_IRC_TC_OPTIN_ENABLED\"\n];\n\n// 2. Extract and populate the new object\nconst extractedSettings = $context.$nodes.GET_GLOBAL_SETTINGS.$output.settings.reduce((acc, item) => {\n  if (keysToExtract.includes(item.settingKey)) {\n    acc[item.settingKey] = item.settingValue;\n  }\n  return acc;\n}, {});\n\nreturn extractedSettings;"
          },
          "outcomes": {
            "success": "1769143088206"
          },
          "code": "EXTRACT_GLOBAL_SETTINGS",
          "id": "1769141406931",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
