          "code": "DETERMINE_EXPENSE_TYPE",
          "convergenceTargetId": "1776123750886",
          "id": "1776123894733",
          "inputs": [
            {
              "id": "1776123894734_1",
              "name": "prompt",
              "type": "string",
              "value": "Input:\nuserMessage: {{$context.$triggers.REST.$input.userMessage}}\nexpenseInfo: {{$context.$triggers.REST.$input.partnerExpense}}\nexpenseTypeList: {{$context.$nodes.PREPARE_INPUT_FOR_LLM.$output.result}}\ndefaultTemplateName: {{$context.$nodes.FILTER_VALID_EXPENSE_TYPES.$output.result.defaultExpenseTemplateName}}\n\n\n {{$context.$nodes.DEFAULT_EXPENSE_TYPE_DEFAULTING_PROMPT.$output.result.expensePrompt}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"derivationMethod\": {\n            \"type\": \"string\"\n        },\n        \"predictedExpenseType\": {\n            \"type\": \"object\",\n            \"properties\": {}\n        },\n        \"reason\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Filter Valid Expense Types",
            "returnType": "array",
            "sourceCode": "const partnerExpense =\n  $context?.$triggers?.REST?.$input?.partnerExpense ?? new Object();\n\nconst defaultTemplateId =\n  $context?.$nodes?.GET_DEFAULT_TEMPLATE_ID?.$output?.items?.[0]?.settingValue ??\n  null;\n\nconst expenseDateRaw = partnerExpense?.endDate;\nconst expenseDate = expenseDateRaw ? new Date(expenseDateRaw) : null;\n\nif (!expenseDate || Number.isNaN(expenseDate.getTime())) {\n  const emptyResult = new Object();\n  emptyResult.filteredExpenseTypes = [];\n  emptyResult.defaultExpenseTemplateName = null;\n\n  return emptyResult;\n}\n\nconst oldExpenseTypes =\n  $context?.$nodes?.GETSIMPLIEDEXPENSETYPES?.$output?.items ?? [];\n\nconst oldTypeIds = new Set(\n  oldExpenseTypes\n    .map(item => String(item?.meaning ?? \"\"))\n    .filter(Boolean)\n);\n\nconst expenseTypes =\n  $context?.$nodes?.GET_EXPENSE_TYPES?.$output?.items ?? [];\n\n// The expense template must be active before evaluating its expense type.\nconst expenseTypesWithActiveTemplates = expenseTypes.filter(item => {\n  const expenseTemplate = item?.expenseTemplate;\n\n  const templateStart = expenseTemplate?.startDate\n    ? new Date(expenseTemplate.startDate)\n    : null;\n\n  const templateInactive = expenseTemplate?.inactiveDate\n    ? new Date(expenseTemplate.inactiveDate)\n    : null;\n\n  const validTemplateStart =\n    templateStart && !Number.isNaN(templateStart.getTime());\n\n  const validTemplateInactive =\n    templateInactive && !Number.isNaN(templateInactive.getTime());\n\n  return (\n    validTemplateStart &&\n    expenseDate >= templateStart &&\n    (!validTemplateInactive || expenseDate <= templateInactive)\n  );\n});\n\nconst filteredExpenseTypes = expenseTypesWithActiveTemplates\n  .filter(item => {\n    const id = String(item?.id ?? \"\");\n    return id && !oldTypeIds.has(id);\n  })\n  .filter(item => {\n    const start = item?.startDate ? new Date(item.startDate) : null;\n    const end = item?.endDate ? new Date(item.endDate) : null;\n\n    const validStart = start && !Number.isNaN(start.getTime());\n    const validEnd = end && !Number.isNaN(end.getTime());\n\n    return (\n      validStart &&\n      expenseDate >= start &&\n      (!validEnd || expenseDate <= end)\n    );\n  })\n  .map(item => {\n    const expenseType = new Object();\n\n    expenseType.id = item?.id ?? null;\n    expenseType.name = item?.name ?? null;\n    expenseType.description = item?.description ?? null;\n    expenseType.expenseTypeCategoryCode =\n      item?.expenseTypeCategory?.lookupCode ?? null;\n    expenseType.expenseTemplateId =\n      item?.expenseTemplate?.id ?? null;\n    expenseType.expenseTemplateName =\n      item?.expenseTemplate?.name ?? null;\n\n    return expenseType;\n  });\n\nconst matchingDefaultTemplate = expenseTypesWithActiveTemplates.find(\n  item =>\n    String(item?.expenseTemplate?.id ?? \"\") ===\n    String(defaultTemplateId ?? \"\")\n);\n\nconst defaultExpenseTemplateName =\n  matchingDefaultTemplate?.expenseTemplate?.name ?? null;\n\nconst result = new Object();\nresult.filteredExpenseTypes = filteredExpenseTypes;\nresult.defaultExpenseTemplateName = defaultExpenseTemplateName;\n\nreturn result;"
          },
          "outcomes": {
            "success": "1784451376794"
          },
          "code": "FILTER_VALID_EXPENSE_TYPES",
