{
  "workflowId": "300000330254748",
  "workflowCode": "ORA_FIN_EXM_EXPENSE_DEFAULTING_ASSISTANT",
  "name": "Expense Defaulting Assistant",
  "description": "This agent help expense filers automatically default fields based on known context, such as user input and expense details. It streamlines the filing process by intelligently selecting appropriate values while respecting explicit user instructions.",
