        {
          "metadata": {
            "name": "Prepare Input for LLM",
            "returnType": "object",
            "sourceCode": "const result =\n  $context?.$nodes?.FILTER_VALID_EXPENSE_TYPES?.$output?.result ??\n  new Object();\n\nconst filteredExpenseTypeList =\n  result?.filteredExpenseTypes ?? [];\n\nconst defaultExpenseTemplate =\n  result?.defaultExpenseTemplateName ?? null;\n\nconst fields = [\n  \"id\",\n  \"name\",\n  \"description\",\n  \"expenseTypeCategoryCode\",\n  \"expenseTemplateName\"\n];\n\nconst expenseTypeRows = filteredExpenseTypeList.map(item =>\n  fields\n    .map(field => {\n      const value = item?.[field];\n\n      if (value === null || value === undefined) {\n        return \"null\";\n      }\n\n      const stringValue = String(value);\n\n      if (\n        stringValue.includes(\",\") ||\n        stringValue.includes(\":\") ||\n        stringValue.includes('\"') ||\n        stringValue.includes(\"\\n\")\n      ) {\n        return JSON.stringify(stringValue);\n      }\n\n      return stringValue;\n    })\n    .join(\",\")\n);\n\nlet defaultTemplateValue = \"null\";\n\nif (\n  defaultExpenseTemplate !== null &&\n  defaultExpenseTemplate !== undefined\n) {\n  const stringValue = String(defaultExpenseTemplate);\n\n  if (\n    stringValue.includes(\",\") ||\n    stringValue.includes(\":\") ||\n    stringValue.includes('\"') ||\n    stringValue.includes(\"\\n\")\n  ) {\n    defaultTemplateValue = JSON.stringify(stringValue);\n  } else {\n    defaultTemplateValue = stringValue;\n  }\n}\n\nconst toonData = [\n  `defaultExpenseTemplateName: ${defaultTemplateValue}`,\n  `filteredExpenseTypes[${filteredExpenseTypeList.length}]{${fields.join(\",\")}}:`,\n  ...expenseTypeRows.map(row => `  ${row}`)\n].join(\"\\n\");\n\nconst output = new Object();\noutput.toonData = toonData;\n\nreturn output;\n"
          },
          "outcomes": {
            "success": "1777506168914"
          },
          "code": "PREPARE_INPUT_FOR_LLM",
          "id": "1784451376794",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Sanitize Output",
            "returnType": "object",
            "sourceCode": "let llmPredictedExpenseType =\n  $context?.$nodes?.DETERMINE_EXPENSE_TYPE?.$output;\n\nconst expenseTypeList =\n  $context?.$nodes?.FILTER_VALID_EXPENSE_TYPES?.$output\n    ?.result?.filteredExpenseTypes ?? [];\n\n// Normalize null-like values recursively.\nconst normalizeNullValues = (value) => {\n  if (Array.isArray(value)) {\n    return value.map((item) => normalizeNullValues(item));\n  }\n\n  if (value !== null && typeof value === \"object\") {\n    Object.keys(value).forEach((key) => {\n      value[key] = normalizeNullValues(value[key]);\n    });\n\n    return value;\n  }\n\n  if (\n    typeof value === \"string\" &&\n    (value.trim() === \"\" || value.trim().toLowerCase() === \"null\")\n  ) {\n    return null;\n  }\n\n  return value;\n};\n\nllmPredictedExpenseType = normalizeNullValues(\n  llmPredictedExpenseType\n);\n\nconst predictedExpenseType =\n  llmPredictedExpenseType?.predictedExpenseType;\n\nconst predictedExpenseTypeId =\n  predictedExpenseType?.expenseTypeId;\n\nif (\n  predictedExpenseType &&\n  predictedExpenseTypeId !== null &&\n  predictedExpenseTypeId !== undefined\n) {\n  const matchingExpenseType = expenseTypeList.find(\n    (item) =>\n      String(item?.id ?? \"\") ===\n      String(predictedExpenseTypeId)\n  );\n\n  predictedExpenseType.expenseTemplateId =\n    matchingExpenseType?.expenseTemplateId ?? null;\n} else if (predictedExpenseType) {\n  predictedExpenseType.expenseTemplateId = null;\n}\n\nllmPredictedExpenseType = normalizeNullValues(\n  llmPredictedExpenseType\n);\n\nreturn llmPredictedExpenseType;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "SANITIZE_OUTPUT",
          "id": "1784451430604",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        }
