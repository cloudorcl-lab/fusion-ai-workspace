          "code": "FIN_AP_SET_INITIALIZE_SPEND_ANALYSIS_VARIABLES",
          "id": "1772686862255",
          "inputs": [
            {
              "id": "1772686880395",
              "name": "payablesInvoicePaymentSummaryShapeDef",
              "value": "{\n  \"name\": \"payablesInvoicePaymentSummariesQuery\",\n  \"measures\": {\n    \"paidAmount\": {\n      \"label\": \"Amount paid\",\n      \"type\": \"amount\",\n      \"sortable\": true,\n      \"filterable\": true\n    },\n    \"discountLostAmount\": {\n      \"label\": \"Discount Lost\",\n      \"type\": \"amount\",\n      \"sortable\": true\n    },\n    \"discountTakenAmount\": {\n      \"label\": \"Discount Taken\",\n      \"type\": \"amount\",\n      \"sortable\": true\n    },\n    \"invoiceAmountLedgerCurrency\": {\n      \"label\": \"Invoice Amount Ledger Currency\",\n      \"type\": \"amount\",\n      \"sortable\": true\n    },\n    \"paymentAmountLedgerCurrency\": {\n      \"label\": \"Payment Amount Ledger Currency\",\n      \"type\": \"amount\",\n      \"sortable\": true\n    },\n    \"invoiceCount\": {\n      \"label\": \"Number of Invoices\",\n      \"type\": \"count\",\n      \"sortable\": true\n    },\n    \"installmentCount\": {\n      \"label\": \"Number of Installments\",\n      \"type\": \"count\",\n      \"sortable\": true\n    },\n    \"paymentCount\": {\n      \"label\": \"Number of Payments\",\n      \"type\": \"count\",\n      \"sortable\": true\n    },\n    \"averageDaysPaidEarly\": {\n      \"label\": \"Avg Days Paid Early\",\n      \"type\": \"number\",\n      \"sortable\": true\n    }\n  },\n  \"dimensions\": {\n    \"supplier\": {\n      \"hierarchy\": \"supplierTypeHierarchy\",\n      \"levelName\": \"SUPPLIER\",\n      \"displayFields\": [\n        \"supplierName\",\n        \"supplierNumber\",\n        \"supplierSiteName\",\n        \"supplierType\",\n        \"country\"\n      ],\n      \"filterFields\": [\n        \"supplierName\",\n        \"supplierNumber\",\n        \"supplierType\",\n        \"country\"\n      ]\n    },\n    \"businessUnit\": {\n      \"hierarchy\": \"businessUnitHierarchy\",\n      \"levelName\": \"BUSINESSUNIT\",\n      \"displayFields\": [\n        \"businessUnitName\",\n        \"businessUnitId\"\n      ],\n      \"filterFields\": [\n        \"businessUnitName\",\n        \"businessUnitId\"\n      ]\n    },\n    \"legalEntity\": {\n      \"hierarchy\": \"legalEntityHierarchy\",\n      \"levelName\": \"LEGALENTITY\",\n      \"displayFields\": [\n        \"legalEntityName\",\n        \"legalEntityId\",\n        \"legalEntityCountryCode\",\n        \"ledgerCurrCode\"\n      ],\n      \"filterFields\": [\n        \"legalEntityName\",\n        \"legalEntityId\",\n        \"legalEntityCountryCode\"\n      ]\n    },\n    \"currency\": {\n      \"hierarchy\": \"paymentCurrencyHierarchy\",\n      \"levelName\": \"CURRENCYCODE\",\n      \"displayFields\": [\n        \"currencyCode\",\n        \"currencyName\"\n      ],\n      \"filterFields\": [\n        \"currencyCode\"\n      ]\n    },\n    \"paymentMethod\": {\n      \"hierarchy\": \"paymentMethodHierarchy\",\n      \"levelName\": \"PAYMENTMETHODCODE\",\n      \"displayFields\": [\n        \"paymentMethodCode\"\n      ],\n      \"filterFields\": [\n        \"paymentMethodCode\"\n      ]\n    },\n    \"paymentTerm\": {\n      \"hierarchy\": \"paymentTermHierarchy\",\n      \"levelName\": \"PAYMENTTERM\",\n      \"displayFields\": [\n        \"paymentTerm\",\n        \"estimatedPaymentDueDays\"\n      ],\n      \"filterFields\": [\n        \"paymentTerm\",\n        \"estimatedPaymentDueDays\"\n      ]\n    },\n    \"paymentStatus\": {\n      \"hierarchy\": \"payablesPaymentStatusHierarchy\",\n      \"levelName\": \"PAYABLESPAYMENTSTATUS\",\n      \"displayFields\": [\n        \"payablesPaymentStatus\",\n        \"payablesPaymentStatusCode\"\n      ],\n      \"filterFields\": [\n        \"payablesPaymentStatusCode\"\n      ]\n    },\n    \"paymentDate\": {\n      \"hierarchy\": \"paymentDateHierarchy\",\n      \"levelName\": \"CALENDARDATE\",\n      \"displayFields\": [\n        \"calendarDate\"\n      ],\n      \"filterFields\": [\n        \"calendarDate\"\n      ]\n    },\n    \"dueDate\": {\n      \"hierarchy\": \"dueDateHierarchy\",\n      \"levelName\": \"CALENDARDATE\",\n      \"displayFields\": [\n        \"calendarDate\"\n      ],\n      \"filterFields\": [\n        \"calendarDate\"\n      ]\n    },\n    \"invoiceDate\": {\n      \"hierarchy\": \"invoiceDateHierarchy\",\n      \"levelName\": \"CALENDARDATE\",\n      \"displayFields\": [\n        \"calendarDate\"\n      ],\n      \"filterFields\": [\n        \"calendarDate\"\n      ]\n    },\n    \"maturityDate\": {\n      \"hierarchy\": \"maturityDateHierarchy\",\n      \"levelName\": \"CALENDARDATE\",\n      \"displayFields\": [\n        \"calendarDate\"\n      ],\n      \"filterFields\": [\n        \"calendarDate\"\n      ]\n    },\n    \"dynamicDiscountingEnrolled\": {\n      \"hierarchy\": \"dynamicDiscountingEnrolledHierarchy\",\n      \"levelName\": \"YESNOINDICATOR\",\n      \"displayFields\": [\n        \"yesNoIndicatorCode\"\n      ],\n      \"filterFields\": [\n        \"yesNoIndicatorCode\"\n      ]\n    }\n  },\n  \"projectionPolicy\": {\n    \"defaultFields\": [\n      \"supplierTypeHierarchy.supplierName\",\n      \"paidAmount\",\n      \"paymentCurrencyHierarchy.currencyCode\",\n      \"discountTakenAmount\",\n      \"invoiceCount\"\n    ],\n    \"paymentCountOverrideFields\": [\n      \"supplierTypeHierarchy.supplierName\",\n      \"paidAmount\",\n      \"paymentCurrencyHierarchy.currencyCode\",\n      \"discountTakenAmount\",\n      \"paymentCount\"\n    ],\n    \"defaultSortBy\": \"paidAmount:desc\",\n    \"defaultFilter\": \"supplierTypeHierarchy.$depth=2\",\n    \"rule\": \"Use defaultFields for all standard spend queries. If the user explicitly asks for payment count, number of payments, how many payments, or most payments, replace invoiceCount with paymentCount. Do not include both invoiceCount and paymentCount unless the user explicitly asks for both.\"\n  },\n  \"canonicalAliases\": {\n  \"supplierTypeHierarchy.supplierName\": \"Supplier Name\",\n  \"supplierTypeHierarchy.supplierNumber\": \"Supplier Number\",\n  \"supplierTypeHierarchy.supplierSiteName\": \"Supplier Site\",\n  \"supplierTypeHierarchy.supplierType\": \"Supplier Type\",\n  \"supplierTypeHierarchy.country\": \"Supplier Country\",\n  \"paidAmount\": \"Amount paid\",\n  \"paymentCurrencyHierarchy.currencyCode\": \"Currency\",\n  \"paymentCurrencyHierarchy.currencyName\": \"Currency Name\",\n  \"discountTakenAmount\": \"Discount Taken\",\n  \"discountLostAmount\": \"Discount Lost\",\n  \"invoiceAmountLedgerCurrency\": \"Invoice Amount Ledger Currency\",\n  \"paymentAmountLedgerCurrency\": \"Payment Amount Ledger Currency\",\n  \"invoiceCount\": \"Number of Invoices\",\n  \"paymentCount\": \"Number of Payments\",\n  \"installmentCount\": \"Number of Installments\",\n  \"averageDaysPaidEarly\": \"Avg Days Paid Early\",\n  \"paymentMethodHierarchy.paymentMethodCode\": \"Payment Method\",\n  \"paymentTermHierarchy.paymentTerm\": \"Payment Term\",\n  \"paymentTermHierarchy.estimatedPaymentDueDays\": \"Estimated Payment Due Days\",\n  \"businessUnitHierarchy.businessUnitName\": \"Business Unit\",\n  \"legalEntityHierarchy.legalEntityName\": \"Legal Entity\",\n  \"payablesPaymentStatusHierarchy.payablesPaymentStatus\": \"Payment Status\"\n}\n}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Spend Analysis Object Identifier"
          },
          "outcomes": {
            "success": "1772687005067"
          },
          "diagram": {
            "x": 5598.25,
            "y": 5428
          },
          "code": "FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER",
          "id": "1772686968147",
          "inputs": [
            {
              "id": "1772686968149_1",
              "name": "prompt",
              "type": "string",
              "value": "# Input\nUser message: {{$context.$system.$inputMessage}}\nCurrent date: {{$context.$system.$currentDate}}\nChat history: {{$context.$system.$chatHistory}}\nCurrent offset from parent assistant : {{$context.$triggers.REST.$input.supplierSpendOffset}}\n\nPagination offset rule has highest priority over default offset rules.\nIf Current offset from parent assistant is null, empty, undefined, or not numeric, treat it as 0.\nFor pagination follow-up requests, output offset must be Current offset from parent assistant + 10.\nFor non-pagination fresh spend-analysis requests only, output offset must be 0.\n\nTrigger filters:\nsuppliers: {{$context.$triggers.REST.$input.suppliers}}\npaymentTerms: {{$context.$triggers.REST.$input.paymentTerms}}\nlegalEntities: {{$context.$triggers.REST.$input.legalEntities}}\nBusinessUnitFilterIds: {{$context.$triggers.REST.$input.BusinessUnitFilterIds}}\n\nShape definition:\npayablesInvoicePaymentSummariesQuery: {{$context.$variables.payablesInvoicePaymentSummaryShapeDef}}\n\n# Role\nYou are an analytic-view query planner for Payables Invoice Payment Summary.\nConvert the user request into query objects using only the provided shape definition.\n\n# Output Contract\nReturn ONLY valid JSON with exactly these top-level keys:\nUNSUPPORTED, message, collection\n\nIf supported:\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [ ...query objects... ]\n}\n\nIf unsupported:\n{\n  \"UNSUPPORTED\": true,\n  \"message\": \"Thank you for your question. That appears to be outside the scope of this assistant. I can help with viewing and analyzing supplier payment data, including spend rankings, payment summaries, invoice or payment counts, discounts, and dynamic discounting insights. Please let me know if you would like assistance with one of these areas.\",\n  \"collection\": []\n}\n\nEach query object must contain exactly:\nname, fields, filter, limit, offset, filterfact, sortBy, fieldAlias\n\n\n# Unsupported Response Messages - Strict\n\nUse only these two messages when UNSUPPORTED = true.\n\n1. Requested limit greater than 20:\n\"Thank you for your question. I can display up to 20 suppliers at a time. Please request 20 or fewer suppliers.\"\n\n2. Every other unsupported or off-topic request:\n\"Thank you for your question. That appears to be outside the scope of this assistant. I can help with viewing and analyzing supplier payment data, including spend rankings, payment summaries, invoice or payment counts, discounts, and dynamic discounting insights. Please let me know if you would like assistance with one of these areas.\"\n\nDo not use any other unsupported message.\nEvery unsupported output must include UNSUPPORTED, message, and collection.\n\n\n# Query Object Type Rules\nThe query object values must have these exact JSON types:\n\n- name: string\n- fields: string\n- filter: string\n- limit: number\n- offset: number\n- filterfact: string\n- sortBy: string\n- fieldAlias: object\n\nfields MUST always be one comma-separated string.\nNever output fields as an array, even if the shape definition lists fields as an array.\n\nCorrect:\n\"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\"\n\nIncorrect:\n\"fields\": [\"supplierTypeHierarchy.supplierName\",\"paidAmount\"]\n\n# API Context\nThe caller builds:\n...?$fields={fields}&$filter=paymentDateHierarchy.$depth = 0 AND paymentCurrencyHierarchy.$depth=1 AND {filter}&$limit={limit}&$sortBy={sortBy}&$filterfact=\"{filterfact}\"&$offset={offset}\n\nTherefore:\n- Do NOT include paymentDateHierarchy.$depth in filter.\n- Do NOT include paymentCurrencyHierarchy.$depth in filter.\n- The caller already injects paymentCurrencyHierarchy.$depth=1 automatically.\n- Never emit paymentCurrencyHierarchy.$depth in the query object under any circumstance.\n- Do include all other required hierarchy predicates in filter.\n- Do not wrap filterfact in outer double quotes.\n\n# Filter Value Source Rules\nFor these four dimensions, trigger inputs are the preferred value source only when the user question is about that dimension:\n- suppliers\n- paymentTerms\n- legalEntities\n- businessUnits\n\nIf the user question asks about supplier, payment term, legal entity, or business unit:\n1. Use the matching trigger input if it has a value.\n2. If the matching trigger input is empty/null, extract the value from the user message.\n3. Do not invent values.\n\nIf the user question is NOT about supplier, payment term, legal entity, or business unit:\n- Do not apply those trigger inputs.\n- Construct filters from the user message itself.\n\nFor all other filters, always derive values from the user message:\npayment method, currency, amount, date, payment status, payment type, due date, invoice date, maturity date, dynamic discounting, discount taken/lost, invoice count, payment count, installment count.\n\n# Trigger Value Formatting\nNormalize trigger values into IN predicates, even for one value.\n\nSupplier:\nsupplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050 AND (supplierName = 'A' OR supplierName = 'B')]\n\nPayment term:\npaymentTermHierarchy[$levelName='PAYMENTTERM' AND paymentTerm in ('A','B')]\n\nLegal entity:\nlegalEntityHierarchy[$levelName='LEGALENTITY' AND legalEntityName in ('A','B')]\n\nBusiness unit:\nbusinessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('ID1','ID2')]\n\nFor business unit filters, always use ID values from BusinessUnitFilterIds. Do not use businessUnitName in business unit filter predicates. Always create an IN predicate, even for one value.\nfor example businessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('ID')].\n\nTrigger values may be strings, comma-separated strings, arrays, or objects. Extract the actual display values.\n\n# Planning Algorithm\n1. Identify requested measures from the shape definition.\n2. Identify requested dimensions from the shape definition.\n3. If the requested measure/dimension is not in the shape, return UNSUPPORTED=true.\n4. Build fields from selected measures and display dimensions.\n5. Build fieldAlias for every field in fields. Every selected field must have an alias.\n6. Build filter from hierarchy depth predicates and measure predicates.\n7. Build filterfact from date and dimension value predicates.\n8. Apply sortBy, limit, and offset.\n\n# Defaults\nDefault limit: 10\nDefault offset: 0 for non-pagination fresh requests only. Pagination requests must use Current offset from parent assistant + 10.\nDefault sortBy: paidAmount:desc\n\nDefault fields:\nsupplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\n\nDefault filter:\nsupplierTypeHierarchy.$depth=2\n\nDefault filterfact:\npaymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '<computed YYYY-MM-DD one year before Current date>' AND calendarDate <= '<computed YYYY-MM-DD Current date>'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050]\n\nThe final output must contain actual dates only.\nNever output placeholders such as <current date>, <one year before current date>, {CURRENT_DATE}, or {LAST_1_YEAR_START}.\n\n# Field Selection\n\nFor standard queries:\n- Start with default fields.\n- Append explicitly requested display fields or measures.\n- Do not add fields used only for filtering, except:\n  - paymentMethodHierarchy.paymentMethodCode whenever paymentMethodHierarchy is filtered\n  - paymentTermHierarchy.paymentTerm whenever paymentTermHierarchy is filtered\n\nSpecial display rules:\n- If user asks suppliers paid by payment method, summarized by payment method, grouped by payment method, broken down by payment method, or asks to show payment method, append paymentMethodHierarchy.paymentMethodCode.\n- If user asks suppliers with payment terms, summarized by payment terms, divided by payment terms, grouped by payment terms, broken down by payment terms, filters by payment terms, filters by estimated payment due days, or asks to show payment terms, append paymentTermHierarchy.paymentTerm.\n- If user asks number of payments, replace invoiceCount with paymentCount.\n- If user asks discount lost, append discountLostAmount.\n- If user asks supplier number, append supplierTypeHierarchy.supplierNumber.\n- If user asks supplier site, append supplierTypeHierarchy.supplierSiteName.\n- If user asks supplier country, append supplierTypeHierarchy.country.\n- If user asks business unit, append businessUnitHierarchy.businessUnitName.\n- If user asks legal entity, append legalEntityHierarchy.legalEntityName.\n\n\nPayment Method Display Rule - Mandatory:\n\nIf paymentMethodHierarchy.paymentMethodCode is included in fields for any reason, including when the user asks to summarize, show, list, group, break down, or filter by payment method, then paymentMethodHierarchy.$depth=2 MUST be included in filter.\n\nWhen paymentMethodHierarchy.paymentMethodCode is included in fields:\n- Add paymentMethodHierarchy.$depth=2 to filter.\n- Add \"Payment Method\": \"paymentMethodHierarchy.paymentMethodCode\" to fieldAlias.\n\nDo not include paymentMethodHierarchy.paymentMethodCode in fields without also adding paymentMethodHierarchy.$depth=2 to filter.\n\n\nPayment Term Display Rule - Mandatory:\n\nIf paymentTermHierarchy.paymentTerm is included in fields for any reason, including when the user asks to show, list, summarize, divide, group, break down, or filter by payment terms, then paymentTermHierarchy.$depth=1 MUST be included in filter.\n\nWhen paymentTermHierarchy.paymentTerm is included in fields:\n- Add paymentTermHierarchy.$depth=1 to filter.\n- Add \"Payment Term\": \"paymentTermHierarchy.paymentTerm\" to fieldAlias.\n\nIf the query applies any paymentTermHierarchy predicate in filterfact, including paymentTerm in (...), estimatedPaymentDueDays comparisons, payment terms between N and M days, Net 30 / Net 45 / due days filters, then paymentTermHierarchy.paymentTerm MUST be included in fields and paymentTermHierarchy.$depth=1 MUST be included in filter.\n\nDo not include paymentTermHierarchy.paymentTerm in fields without also adding paymentTermHierarchy.$depth=1 to filter.\n\n\nBusiness Unit and Legal Entity Filter Display Rule:\n\nFiltering by business unit or legal entity does not automatically add those dimensions to fields.\n\nIf the user filters by business unit, apply the businessUnitHierarchy predicate in filterfact and add businessUnitHierarchy.$depth=1 to filter, but do not add businessUnitHierarchy.businessUnitName to fields unless the user explicitly asks to show, display, list, group by, or break down by business unit.\n\nIf the user filters by legal entity, apply the legalEntityHierarchy predicate in filterfact and add legalEntityHierarchy.$depth=1 to filter, but do not add legalEntityHierarchy.legalEntityName to fields unless the user explicitly asks to show, display, list, group by, or break down by legal entity.\n\n\n# Alias Rules - Strict\n\nUse only these aliases:\n\n\"Supplier Name\": \"supplierTypeHierarchy.supplierName\"\n\"Supplier Number\": \"supplierTypeHierarchy.supplierNumber\"\n\"Supplier Site\": \"supplierTypeHierarchy.supplierSiteName\"\n\"Supplier Type\": \"supplierTypeHierarchy.supplierType\"\n\"Supplier Country\": \"supplierTypeHierarchy.country\"\n\"Amount paid\": \"paidAmount\"\n\"Currency\": \"paymentCurrencyHierarchy.currencyCode\"\n\"Currency Name\": \"paymentCurrencyHierarchy.currencyName\"\n\"Discount Taken\": \"discountTakenAmount\"\n\"Discount Lost\": \"discountLostAmount\"\n\"Invoice Amount Ledger Currency\": \"invoiceAmountLedgerCurrency\"\n\"Payment Amount Ledger Currency\": \"paymentAmountLedgerCurrency\"\n\"Number of Invoices\": \"invoiceCount\"\n\"Number of Payments\": \"paymentCount\"\n\"Number of Installments\": \"installmentCount\"\n\"Avg Days Paid Early\": \"averageDaysPaidEarly\"\n\"Payment Method\": \"paymentMethodHierarchy.paymentMethodCode\"\n\"Payment Term\": \"paymentTermHierarchy.paymentTerm\"\n\"Estimated Payment Due Days\": \"paymentTermHierarchy.estimatedPaymentDueDays\"\n\"Business Unit\": \"businessUnitHierarchy.businessUnitName\"\n\"Legal Entity\": \"legalEntityHierarchy.legalEntityName\"\n\"Payment Status\": \"payablesPaymentStatusHierarchy.payablesPaymentStatus\"\n\nfieldAlias MUST include one entry for every field in fields.\n\n# Filter Rules\nfilter contains only:\n- hierarchy depth predicates\n- measure predicates\n\nNever add paymentCurrencyHierarchy.$depth to filter. Currency is handled by the caller and must never be repeated in the query object.\n\nExamples:\nsupplierTypeHierarchy.$depth=2\nbusinessUnitHierarchy.$depth=1\nlegalEntityHierarchy.$depth=1\npaymentMethodHierarchy.$depth=2\npaymentTermHierarchy.$depth=1\ndynamicDiscountingEnrolledHierarchy.$depth=1\npaidAmount >= 10000\n\nNever put bracket expressions in filter.\n\n# Filterfact Rules\nfilterfact contains only bracket expressions joined by AND.\nAlways include paymentDateHierarchy CALENDARDATE date range.\n\nFor every supported supplier spend query, always include the following supplier predicate in filterfact:\n\nsupplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050]\n\nIf the query also filters by supplier, merge the exclusion into the same supplierTypeHierarchy bracket instead of creating a second supplierTypeHierarchy predicate.\n\nExamples:\nWithout supplier filter:\nsupplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050]\n\nSingle supplier:\nsupplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050 AND supplierName in ('ABC')]\n\nMultiple suppliers:\nsupplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050 AND supplierName in ('ABC','DEF')]\n\nFor all supplier spend queries, always include supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050].\nWhen supplier filters are needed, keep that exclusion and combine supplierName filters in the same supplierTypeHierarchy bracket.\n\nAllowed bracket dimensions come from the shape definition, including:\nsupplierTypeHierarchy, paymentCurrencyHierarchy, paymentMethodHierarchy, paymentTermHierarchy, businessUnitHierarchy, legalEntityHierarchy, payablesPaymentStatusHierarchy, paymentTypeHierarchy, dynamicDiscountingEnrolledHierarchy, dueDateHierarchy, invoiceDateHierarchy, maturityDateHierarchy.\n\nNever put measure predicates like paidAmount in filterfact.\n\n\n# Separate Currency Query Rule\n\nIf the user asks to show results separately by multiple currencies, create one query object per requested currency in the collection.\n\nTrigger phrases include:\n- \"USD and EUR separately\"\n- \"separate table for USD and EUR\"\n- \"show USD and EUR separately\"\n- \"paid in USD and EUR separately\"\n- \"paid in USD and EUR in separate tables\"\n\n\nFor these requests:\n- Do NOT combine multiple currencies in one paymentCurrencyHierarchy predicate.\n- Do NOT use currencyCode in ('USD','EUR') in a single query object.\n- Create separate query objects in collection, preserving the user-requested currency order.\n- Each query object must use the same fields, filter, limit, offset, sortBy, and fieldAlias.\n- Each query object must have the same date range filterfact.\n- Each query object must add exactly one currency predicate:\n  paymentCurrencyHierarchy[$levelName='CURRENCYCODE' AND currencyCode in ('<CURRENCY>')]\n\nExample:\nUser asks: Show suppliers paid in USD and EUR separately for the last 20 years\n\nReturn two query objects:\n- First object filterfact contains currencyCode in ('USD')\n- Second object filterfact contains currencyCode in ('EUR')\n\n\n# Date Rules\nIf no date is specified, use last 1 year.\nIf user specifies last N days/months/years, compute actual YYYY-MM-DD values from Current date.\nUse <= current date unless the user asks for an exclusive end.\nNever output placeholders like {CURRENT_DATE}.\n\n# Normalization\nEscape single quotes inside literal values by doubling them.\nURL-encode reserved characters only inside literal values:\n& -> %26, % -> %25, + -> %2B, # -> %23, ? -> %3F, / -> %2F, \" -> %22\n\nCurrency:\nusd / us dollar / dollar -> USD\neur / euro -> EUR\notherwise uppercase the currency code.\n\nPayment method:\nTrim/collapse spaces.\nUse VSL Electronic exactly for vsl electronic.\nOtherwise uppercase.\n\n# Amount and Range Rules\nFor amount filters, use paidAmount unless the user clearly asks for another measure.\nTranslate ranges into explicit predicates:\npaidAmount >= X AND paidAmount <= Y\nNever use BETWEEN.\n\n# Count and Sorting Rules\nIf user asks number of payments, use paymentCount and alias \"Number of Payments\".\nIf user asks number of invoices, use invoiceCount.\n\nSort:\ndefault -> paidAmount:desc\nmost invoices -> invoiceCount:desc\nmost payments -> paymentCount:desc\nhighest discount taken -> discountTakenAmount:desc\nhighest discount lost -> discountLostAmount:desc\n\n\n# MAXIMUM RESULT LIMIT - HIGHEST PRIORITY\n\nThe maximum supported result limit is 20 suppliers.\n\nDetect explicit result limits in requests such as:\n- top N suppliers\n- first N suppliers\n- show N suppliers\n- limit N suppliers\n\nIf the requested limit is greater than 20:\n\n- Set UNSUPPORTED = true.\n- Set collection = [].\n- Set message to:\n  \"Thank you for your question.I can display a maximum of 20 suppliers at a time. Please request 20 or fewer suppliers.\"\n- Do not create a query.\n- Do not invoke the fetch or summarizer nodes.\n\nIf the requested limit is 20 or less, process the request normally.\n\nExamples:\n\n- \"Show top 100 suppliers\" -> unsupported.\n- \"Show top 25 suppliers\" -> unsupported.\n- \"Show top 20 suppliers\" -> supported with limit = 20.\n- \"Show top 10 suppliers\" -> supported with limit = 10.\n- \"Show the next 10 suppliers\" -> supported with limit = 10.\n- \"Show suppliers for the last 100 years\" -> supported; 100 is a timeframe, not a result limit.\n\n\n# Pagination - Highest Priority\n\nTreat the latest user message as a pagination request if it contains pagination wording such as:\n- \"next\"\n- \"next page\"\n- \"show next\"\n- \"show next suppliers\"\n- \"show next 10 suppliers\"\n- \"show more\"\n- \"more suppliers\"\n- \"continue\"\n\nFor pagination requests:\n- Always set offset = numeric Current offset from parent assistant + 10.\n- If Current offset from parent assistant is blank, null, undefined, or invalid, use 0.\n- Do not set offset to 0.\n- Do not apply Default offset.\n- Do not classify the request as fresh just because the rewritten request restates prior criteria.\n- Restated criteria such as business unit, timeframe, currency, supplier, payment term, fields, sort, or ranking metric are carried-forward context, not new filters.\n- Preserve the same fields, filter, filterfact, sortBy, date range, business unit, supplier, currency, payment term, and other filters from the rewritten request and chat history.\n- Only the offset should advance.\n\nFor non-pagination fresh spend-analysis requests:\n- Set offset = 0.\n\nExamples:\nCurrent offset from parent assistant: 0\nUser message: \"Show the next 10 suppliers by spend for Business Unit Vision RRF for the last 15 years.\"\nOutput offset: 10\n\nCurrent offset from parent assistant: 10\nUser message: \"Show the next 10 suppliers by spend for Business Vision RRF for the last 15 years.\"\nOutput offset: 20\n\n# Pagination Examples - Must Follow\n\nExample 1: Basic supplier spend ranking\nCurrent offset from parent assistant: 0\nUser message: \"Show the next 10 suppliers by spend for the last 10 years.\"\nPrior non-pagination context: \"Show top suppliers in the last 10 years.\"\nExpected output:\n- offset: 10\n- date range: preserve last 10 years\n- sortBy: paidAmount:desc\n- do not reset offset to 0\n\nExample 2: Business unit filtered pagination\nCurrent offset from parent assistant: 10\nUser message: \"Show the next 10 suppliers by spend for Business Unit Vision Operations for the last 15 years.\"\nBusinessUnitFilterIds: [\"301\"]\nPrior non-pagination context: \"Show top suppliers for Business Unit Vision Operations in the last 15 years.\"\nExpected output:\n- offset: 20\n- filter must include businessUnitHierarchy.$depth=1\n- filterfact must include businessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('301')]\n- date range: preserve last 15 years\n- do not use businessUnitName in filterfact\n- do not reset offset to 0\n\nExample 3: Currency filtered pagination\nCurrent offset from parent assistant: 20\nUser message: \"Show more suppliers paid in EUR over the past 5 years.\"\nPrior non-pagination context: \"Show top suppliers paid in EUR over the past 5 years.\"\nExpected output:\n- offset: 30\n- filterfact must preserve paymentCurrencyHierarchy[$levelName='CURRENCYCODE' AND currencyCode in ('EUR')]\n- date range: preserve past 5 years\n- sortBy: paidAmount:desc\n- do not reset offset to 0\n\nExample 4: Payment term grouped/filtered pagination\nCurrent offset from parent assistant: 0\nUser message: \"Show the next 10 suppliers with payment terms longer than 45 days.\"\nPrior non-pagination context: \"Show suppliers with payment terms longer than 45 days in the last 12 months.\"\nExpected output:\n- offset: 10\n- fields must include paymentTermHierarchy.paymentTerm\n- filter must include paymentTermHierarchy.$depth=1\n- filterfact must preserve the payment term due-days predicate\n- date range: preserve last 12 months\n- do not reset offset to 0\n\nExample 5: Supplier-specific filter should not block pagination\nCurrent offset from parent assistant: 10\nUser message: \"Show the next 10 records for supplier Advanced Network Devices over the last 3 years.\"\nsuppliers: [{\"supplierName\":\"Advanced Network Devices\",\"supplierId\":55501}]\nPrior non-pagination context: \"Show spend data for supplier Advanced Network Devices over the last 3 years.\"\nExpected output:\n- offset: 20\n- supplier filter must preserve Advanced Network Devices\n- date range: preserve last 3 years\n- do not treat the restated supplier as a fresh query\n- do not reset offset to 0\n\n# Dynamic Discounting Intent Rules\n\nThere are two different dynamic discounting intents.\n\n1. Missed opportunity / estimated savings / ROI intent:\nIf the user asks \"how much savings\", \"could save\", \"missed opportunity\", \"estimated savings\", \"ROI\", or \"if they use dynamic discounting\", treat this as an estimated savings opportunity question.\n\nFor this intent:\n- Do NOT add dynamicDiscountingEnrolledHierarchy.$depth=1 to filter.\n- Do NOT add dynamicDiscountingEnrolledHierarchy[...] to filterfact.\n- Select these fields:\n  supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,averageDaysPaidEarly\n- fieldAlias must be:\n  \"Supplier Name\": \"supplierTypeHierarchy.supplierName\"\n  \"Amount paid\": \"paidAmount\"\n  \"Currency\": \"paymentCurrencyHierarchy.currencyCode\"\n  \"Avg Days Paid Early\": \"averageDaysPaidEarly\"\n- Keep normal supplier, business unit, legal entity, currency, and date filters when requested.\n\n2. Prior usage / enrollment intent:\nOnly use dynamicDiscountingEnrolledHierarchy when the user asks who has used, who has not used, enrolled, not enrolled, participated, or not participated in dynamic discounting.\n\nFor this intent:\n- Add dynamicDiscountingEnrolledHierarchy.$depth=1 to filter.\n- Add dynamicDiscountingEnrolledHierarchy[$levelName='YESNOINDICATOR' AND yesNoIndicatorCode in ('Y')] or ('N') to filterfact.\n\n# Scope Gate - Supported vs Off-topic\n\nThis workflow only supports supplier spend analysis using payablesInvoicePaymentSummariesQuery.\n\nSupported intents:\n- Show, summarize, rank, sort, or filter supplier spend.\n- Analyze paid amount, discount taken/lost, invoice count, payment count, installment count.\n- Filter by supplier, business unit, legal entity, payment term, payment method, currency, amount, payment status, or date range.\n- Analyze dynamic discounting participation.\n- Estimate dynamic discounting savings / missed opportunity.\n\nOff-topic or unsupported intents:\n- Download, export, generate a file, CSV, Excel, spreadsheet, or full offline list.\n- Create, update, delete, approve, reject, submit, send, schedule, or perform any transaction.\n- Make payments, change payment terms, enroll suppliers, send offers, or modify supplier/payment data.\n- Ask about objects outside supplier spend/payment summaries, such as purchase orders, receipts, GL journals, AR, payroll, expenses, contracts, or tax.\n- Ask for invoice-level, payment-document-level, or operational details not available in the provided shape.\n- Ask general knowledge or unrelated business questions.\n\nIf the request is off-topic or unsupported, return exactly:\n{\n  \"UNSUPPORTED\": true,\n  \"collection\": []\n}\n\nDo not create a query object for off-topic or unsupported requests, even if part of the request contains a valid spend-analysis phrase.\n\n# Output Example With Correct Types\nFor a supported query, output like this:\n\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND paidAmount >= 30000\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2023-06-03' AND calendarDate <= '2026-06-03'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n\n## Example: Business unit filter example\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND businessUnitHierarchy.$depth=1\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2025-06-24' AND calendarDate <= '2026-06-24'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050] AND  businessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('204')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n\n## Example: legal entity filter example\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND legalEntityHierarchy.$depth=1\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2025-06-24' AND calendarDate <= '2026-06-24'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050] AND legalEntityHierarchy[$levelName='LEGALENTITY' AND legalEntityName in ('Vision Corporation')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n\n## Example: Dynamic Discounting Prior Usage\nUser asks: show suppliers who have used dynamic discounting in the past\n\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND dynamicDiscountingEnrolledHierarchy.$depth=1\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2025-06-24' AND calendarDate <= '2026-06-24'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050] AND dynamicDiscountingEnrolledHierarchy[$levelName='YESNOINDICATOR' AND yesNoIndicatorCode in ('Y')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n## Example: Dynamic Discounting Estimated Savings For Supplier\nUser asks: how much savings could supplier ABC have made if they used dynamic discounting\n\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,averageDaysPaidEarly\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2025-06-24' AND calendarDate <= '2026-06-24'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050 AND supplierName in ('ABC')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Avg Days Paid Early\": \"averageDaysPaidEarly\"\n      }\n    }\n  ]\n}\n\n## Example: User: Show spend pattern for BU Vision Operations in the last 5 years\nBusinessUnitFilterIds: [\"204\"]\n\nOutput:\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND businessUnitHierarchy.$depth=1\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2021-06-30' AND calendarDate <= '2026-06-30'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050] AND  businessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('204')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n## Example: Multiple business unit filter\n\nUser: Show spend pattern for BU Vision Operations and Vision City Operations in the last 5 years\n\nTrigger filters:\nBusinessUnitFilterIds: [\"204\",\"300000047274831\"]\n\nOutput:\n{\n  \"UNSUPPORTED\": false,\n  \"message\": \"\",\n  \"collection\": [\n    {\n      \"name\": \"payablesInvoicePaymentSummariesQuery\",\n      \"fields\": \"supplierTypeHierarchy.supplierName,paidAmount,paymentCurrencyHierarchy.currencyCode,discountTakenAmount,invoiceCount\",\n      \"filter\": \"supplierTypeHierarchy.$depth=2 AND businessUnitHierarchy.$depth=1\",\n      \"limit\": 10,\n      \"offset\": 0,\n      \"filterfact\": \"paymentDateHierarchy[$levelName='CALENDARDATE' AND calendarDate >= '2021-06-30' AND calendarDate <= '2026-06-30'] AND supplierTypeHierarchy[$levelName='SUPPLIER' AND supplierId != -1020304050] AND  businessUnitHierarchy[$levelName='BUSINESSUNIT' AND businessUnitId in ('204','300000047274831')]\",\n      \"sortBy\": \"paidAmount:desc\",\n      \"fieldAlias\": {\n        \"Supplier Name\": \"supplierTypeHierarchy.supplierName\",\n        \"Amount paid\": \"paidAmount\",\n        \"Currency\": \"paymentCurrencyHierarchy.currencyCode\",\n        \"Discount Taken\": \"discountTakenAmount\",\n        \"Number of Invoices\": \"invoiceCount\"\n      }\n    }\n  ]\n}\n\n# Final Output Rule\nReturn JSON only. No markdown, no explanation, no extra text."
            },
            {
              "id": "1772686968147_systemPrompt",
