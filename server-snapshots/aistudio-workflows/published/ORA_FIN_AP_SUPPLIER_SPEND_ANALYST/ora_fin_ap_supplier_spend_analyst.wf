          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"PayablesInvoicePaymentSummariesQueryOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"UNSUPPORTED\": {\n      \"type\": \"boolean\",\n      \"description\": \"Indicates if the query is unsupported\"\n    },\n    \"message\": {\n      \"type\": \"string\",\n      \"description\": \"Message describing unsupported reason or empty if supported\"\n    },\n    \"collection\": {\n      \"type\": \"array\",\n      \"description\": \"Array of query objects\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\",\n            \"const\": \"payablesInvoicePaymentSummariesQuery\"\n          },\n          \"fields\": {\n            \"type\": \"string\",\n            \"description\": \"Comma-separated list of fields\"\n          },\n          \"filter\": {\n            \"type\": \"string\",\n            \"description\": \"Filter string containing hierarchy depth and measure predicates\"\n          },\n          \"limit\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"description\": \"Limit for number of records\"\n          },\n          \"offset\": {\n            \"type\": \"integer\",\n            \"minimum\": 0,\n            \"description\": \"Offset for pagination\"\n          },\n          \"filterfact\": {\n            \"type\": \"string\",\n            \"description\": \"Bracket expressions for date and dimension filters\"\n          },\n          \"sortBy\": {\n            \"type\": \"string\",\n            \"description\": \"Sort by field and direction\"\n          },\n          \"fieldAlias\": {\n            \"type\": \"object\",\n            \"description\": \"Mapping of alias names to field names\",\n            \"additionalProperties\": {\n              \"type\": \"string\"\n            },\n            \"minProperties\": 1\n          }\n        },\n        \"required\": [\n          \"name\",\n          \"fields\",\n          \"filter\",\n          \"limit\",\n          \"offset\",\n          \"filterfact\",\n          \"sortBy\",\n          \"fieldAlias\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\n    \"UNSUPPORTED\",\n    \"message\",\n    \"collection\"\n  ],\n  \"additionalProperties\": false\n}",
