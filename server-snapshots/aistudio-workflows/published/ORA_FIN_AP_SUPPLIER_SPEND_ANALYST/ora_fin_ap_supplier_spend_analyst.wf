        {
          "metadata": {
            "name": "Spend Analysis Summary Generator",
            "returnType": "string",
            "sourceCode": "let result = \"\";\n\ntry {\n  const rawOutputArray =\n    $context.$nodes?.FIN_AP_SPEND_ANALYSIS_OBJECT_FETCH_LOOP?.$output || [];\n  const rawEntries = Array.isArray(rawOutputArray)\n    ? rawOutputArray\n    : [rawOutputArray];\n  const rows = [];\n\n  function addUnique(target, value) {\n    if (value !== null && value !== undefined && value !== \"\") {\n      const text = String(value);\n      if (target.indexOf(text) === -1) target.push(text);\n    }\n  }\n\n  function canonicalKey(key) {\n    if (key === \"Amount Paid\") return \"Amount paid\";\n    return key;\n  }\n\n  function toNumber(value) {\n    if (value === null || value === undefined || value === \"\" || value === \"-\") {\n      return 0;\n    }\n    const numberValue = Number(String(value).replace(/,/g, \"\").trim());\n    return Number.isFinite(numberValue) ? numberValue : 0;\n  }\n\n  for (const rawEntry of rawEntries) {\n    let parsed = rawEntry;\n    if (typeof rawEntry === \"string\") {\n      try {\n        parsed = JSON.parse(rawEntry);\n      } catch (parseError) {\n        continue;\n      }\n    }\n\n    const table = parsed?.result || parsed;\n    const content = Array.isArray(table?.content) ? table.content : [];\n\n    for (const item of content) {\n      if (!item || typeof item !== \"object\" || Array.isArray(item)) continue;\n      const normalized = {};\n      for (const key of Object.keys(item)) {\n        normalized[canonicalKey(key)] = item[key];\n      }\n      rows.push(normalized);\n    }\n  }\n\n  const monetaryMeasures = [\n    \"Amount paid\",\n    \"Discount Taken\",\n    \"Discount Lost\",\n    \"Dynamic Discount Estimated\"\n  ];\n  const countMeasures = [\n    \"Number of Invoices\",\n    \"Number of Payments\",\n    \"Number of Installments\"\n  ];\n  const ignoredMetrics = [\n    \"Avg Days Paid Early\",\n    \"Estimated Payment Due Days\",\n    \"Invoice Amount Ledger Currency\",\n    \"Payment Amount Ledger Currency\"\n  ];\n\n  const supplierSet = {};\n  const dimensionValues = {};\n  const overallCounts = {};\n  const totalsByCurrencyMap = {};\n  const totalsByCurrencyOrder = [];\n\n  for (const row of rows) {\n    const supplierName = row[\"Supplier Name\"];\n    if (supplierName !== null && supplierName !== undefined && supplierName !== \"\") {\n      supplierSet[String(supplierName)] = true;\n    }\n\n    const currency = row[\"Currency\"];\n    if (currency !== null && currency !== undefined && currency !== \"\") {\n      const currencyKey = String(currency);\n      if (!totalsByCurrencyMap[currencyKey]) {\n        totalsByCurrencyMap[currencyKey] = { currency: currencyKey };\n        totalsByCurrencyOrder.push(currencyKey);\n      }\n\n      for (const measure of monetaryMeasures) {\n        if (!Object.prototype.hasOwnProperty.call(row, measure)) continue;\n        if (!Object.prototype.hasOwnProperty.call(totalsByCurrencyMap[currencyKey], measure)) {\n          totalsByCurrencyMap[currencyKey][measure] = 0;\n        }\n        totalsByCurrencyMap[currencyKey][measure] += toNumber(row[measure]);\n      }\n\n      for (const measure of countMeasures) {\n        if (!Object.prototype.hasOwnProperty.call(row, measure)) continue;\n        if (!Object.prototype.hasOwnProperty.call(totalsByCurrencyMap[currencyKey], measure)) {\n          totalsByCurrencyMap[currencyKey][measure] = 0;\n        }\n        totalsByCurrencyMap[currencyKey][measure] += toNumber(row[measure]);\n      }\n    }\n\n    for (const measure of countMeasures) {\n      if (!Object.prototype.hasOwnProperty.call(row, measure)) continue;\n      if (!Object.prototype.hasOwnProperty.call(overallCounts, measure)) {\n        overallCounts[measure] = 0;\n      }\n      overallCounts[measure] += toNumber(row[measure]);\n    }\n\n    for (const key of Object.keys(row)) {\n      if (key === \"Supplier Name\" || key === \"Currency\") continue;\n      if (key.indexOf(\"Supplier \") === 0) continue;\n      if (monetaryMeasures.indexOf(key) !== -1) continue;\n      if (countMeasures.indexOf(key) !== -1) continue;\n      if (ignoredMetrics.indexOf(key) !== -1) continue;\n      if (!dimensionValues[key]) dimensionValues[key] = [];\n      addUnique(dimensionValues[key], row[key]);\n    }\n  }\n\n  result = JSON.stringify({\n    rowCount: rows.length,\n    distinctSupplierCount: Object.keys(supplierSet).length,\n    dimensionValues: dimensionValues,\n    overallCounts: overallCounts,\n    totalsByCurrency: totalsByCurrencyOrder.map(function (key) {\n      return totalsByCurrencyMap[key];\n    })\n  });\n} catch (error) {\n  result = JSON.stringify({\n    rowCount: 0,\n    distinctSupplierCount: 0,\n    dimensionValues: {},\n    overallCounts: {},\n    totalsByCurrency: []\n  });\n}\n\nreturn result;\n"
          },
