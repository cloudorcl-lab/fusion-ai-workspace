                {
                  "metadata": {
                    "name": "Format Payment Inquiry Data",
                    "returnType": "object",
                    "sourceCode": "let paymentFiles = $context.$nodes.FIN_AP_BO_FUNC_FETCH_PAYMENT_DETAILS?.$output?.items || [];\n\nlet fields = $context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_FETCH_LOOP.$currentItem.fields;\n\nlet fieldAlias = $context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_FETCH_LOOP.$currentItem.fieldAlias;\n\nconst fieldsArr = fields.split(\",\").map(s => s.trim()).filter(Boolean);\n\nconst isDynamicDiscounting =\n  fieldsArr.includes(\"averageDaysPaidEarly\") && !fieldsArr.includes(\"discountTakenAmount\") ;\n\n// Constants (as provided)\nconst MarketShortTermInvestmentRate = 4;\nconst DaysInYear = 360;\n\n// Derive APR from Financing Program BO function output (defaultDiscountRate), fallback to 25\nfunction getAprFromFinancingProgramOrDefault() {\n  try {\n    const finOut = $context.$nodes.FIN_AP_FINANCING_PROGRAM_BUSINESS_OBJECT_FUNCTION?.$output;\n    const items = finOut?.items;\n    if (Array.isArray(items) && items.length > 0) {\n      const rate = items[0]?.defaultDiscountRate; // often string e.g. \"10\"\n      const n = Number(rate);\n      if (Number.isFinite(n) && n > 0) return n;\n    }\n  } catch (e) {\n    // ignore, use default\n  }\n  return 25;\n}\n\nconst APR = isDynamicDiscounting ? getAprFromFinancingProgramOrDefault() : 25;\n\n// Helper: safe number parsing\nfunction toNumber(v) {\n  if (v === null || v === undefined || v === \"\") return 0;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : 0;\n}\n\n// Helper: resolve nested value by \"a.b.c\" path\nfunction getByPath(obj, path) {\n  let pathParts = path.split(\".\");\n  let value = obj;\n  for (let j = 0; j < pathParts.length; j++) {\n    if (value && Object.prototype.hasOwnProperty.call(value, pathParts[j])) {\n      value = value[pathParts[j]];\n    } else {\n      return \"\";\n    }\n  }\n  return (value === null || value === undefined) ? \"\" : value;\n}\n\nlet processedFiles = [];\n\nfor (let i = 0; i < paymentFiles.length; i++) {\n  let file = paymentFiles[i];\n  let newFile = {};\n\n  // Map requested aliases/fields to output row\n  for (let alias in fieldAlias) {\n    const path = fieldAlias[alias];\n    newFile[alias] = getByPath(file, path);\n  }\n\n  // DD ROI use case: compute and RETURN ONLY the 4 required columns\n  if (isDynamicDiscounting) {\n    // paidAmount might be mapped as \"Amount paid\" or \"Amount Paid\" depending on your LLM output\n    const paidAmount =\n      toNumber(newFile[\"Amount Paid\"]) ||\n      toNumber(newFile[\"Amount paid\"]) ||\n      toNumber(getByPath(file, \"paidAmount\"));\n\n    const avgDaysPaidEarlyRaw =\n      toNumber(newFile[\"Avg Days Paid Early\"]) ||\n      toNumber(getByPath(file, \"averageDaysPaidEarly\"));\n\n    // Business rule: treat negative avgDaysPaidEarly as 0 for ROI calculations\n    const avgDaysPaidEarly = Math.max(0, avgDaysPaidEarlyRaw);\n\n    const fraction = avgDaysPaidEarly / DaysInYear;\n\n    // Formulas:\n    // DiscountBenefit = AmountFinanced * (avgDaysPaidEarly/360) * APR\n    const estimatedDiscountBenefit = paidAmount * fraction * (APR / 100);\n    const estimatedOpportunityInterestLoss = paidAmount * fraction * (MarketShortTermInvestmentRate / 100);\n    const estimatedDDSavings = estimatedDiscountBenefit - estimatedOpportunityInterestLoss;\n\n    const supplierName =\n      newFile[\"Supplier Name\"] !== undefined\n        ? newFile[\"Supplier Name\"]\n        : getByPath(file, \"supplierTypeHierarchy.supplierName\");\n\n    const currency =\n  newFile[\"Currency\"] !== undefined\n    ? newFile[\"Currency\"]\n    : getByPath(file, \"paymentCurrencyHierarchy.currencyCode\");\n\nnewFile = {\n  \"Supplier Name\": supplierName === null || supplierName === undefined ? \"\" : String(supplierName),\n  \"Amount Paid\": Number(paidAmount).toFixed(2),\n  \"Currency\": currency === null || currency === undefined ? \"\" : String(currency),\n  \"Avg Days Paid Early\": String(avgDaysPaidEarly),\n  \"Dynamic Discount Estimated\": Number(estimatedDDSavings).toFixed(2)\n};\n  } else {\n    // Non-DD: convert all mapped values to strings\n    for (let k in newFile) {\n      let v = newFile[k];\n\n      // Normalize Discount Taken → default to 0.00\n      if (k === \"Discount Taken\") {\n        if (v === null || v === undefined || v === \"\" || v === \"-\") {\n          newFile[k] = \"0.00\";\n          continue;\n        }\n\n        const num = Number(String(v).replace(/,/g, \"\").trim());\n        newFile[k] = Number.isFinite(num) ? num.toFixed(2) : \"0.00\";\n        continue;\n      }\n\n      // Keep count fields as whole numbers\n      if (\n        k === \"Number of Invoices\" || k === \"invoiceCount\" ||\n        k === \"Number of Payments\" || k === \"paymentCount\"\n      ) {\n        const num = Number(String(v).replace(/,/g, \"\").trim());\n        newFile[k] = Number.isFinite(num) ? String(Math.round(num)) : \"0\";\n        continue;\n      }\n\n      // Handle ALL numeric values → string with max 2 decimals\n      if (typeof v === \"number\" || (!isNaN(v) && v !== \"\" && v !== null)) {\n        const num = Number(String(v).replace(/,/g, \"\").trim());\n        newFile[k] = Number.isFinite(num) ? num.toFixed(2) : \"\";\n      } else {\n        newFile[k] = (v === null || v === undefined) ? \"\" : String(v);\n      }\n    }\n  }\n\n  processedFiles.push(newFile);\n}\n\n// Build column order\nlet columnOrder = [];\n\nif (isDynamicDiscounting) {\n  columnOrder = [\n    \"Supplier Name\",\n    \"Amount Paid\",\n    \"Currency\",\n    \"Avg Days Paid Early\",\n    \"Dynamic Discount Estimated\"\n  ];\n} else {\n  // Non-DD behavior: original logic\n  for (let i = 0; i < fieldsArr.length; i++) {\n    let f = fieldsArr[i];\n    let aliasName = null;\n    for (let alias in fieldAlias) {\n      if (fieldAlias[alias] === f) {\n        aliasName = alias;\n        break;\n      }\n    }\n    columnOrder.push(aliasName ? aliasName : f);\n  }\n}\n\nlet output = {\n  \"type\": \"table\",\n  \"columnOrder\": columnOrder,\n  \"content\": processedFiles\n};\n\nreturn output;"
                  },
                  "outcomes": {
                    "success": "end_1772687091004"
                  },
