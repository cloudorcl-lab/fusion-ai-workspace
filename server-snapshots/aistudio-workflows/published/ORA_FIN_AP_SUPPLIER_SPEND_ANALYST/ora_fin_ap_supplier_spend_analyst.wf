            "sourceCode": "const configuredMessage =\n  $context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER.$output.message;\n\nconst message =\n  configuredMessage && String(configuredMessage).trim() !== \"\"\n    ? configuredMessage\n    : \"Thank you for your question. That appears to be outside the scope of this assistant. I can help with viewing and analyzing supplier payment data, including spend rankings, payment summaries, invoice or payment counts, discounts, and dynamic discounting insights. Please let me know if you would like assistance with one of these areas.\";\n\nreturn [\n  {\n    type: \"text\",\n    content: message,\n    sequence: 1\n  }\n];",
            "returnType": "array"
          },
