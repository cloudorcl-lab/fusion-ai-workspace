            "width": 929.5,
            "height": 1458
          },
          "code": "FIN_AP_SPEND_ANALYSIS_OBJECT_FETCH_LOOP",
          "id": "1772687091004",
          "inputs": [
            {
              "id": "1772687091005_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER.$output.collection}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.25
              },
              "code": "ORA_LLM_MODEL_PROVIDER_CERT_BASIC_LLAMA_3_3_70B",
              "model": "ORA_LLM_MODEL_GPT_OSS_120B",
              "modelName": "GPT OSS 120B (Basic)",
              "provider": "CERT_BASIC"
            },
            "name": "Spend Analysis data summarizer"
          },
          "outcomes": {
            "success": "1772687266593"
          },
          "diagram": {
            "x": 5298.86998333228,
            "y": 8121.8283941458285
          },
          "code": "FIN_AP_LLM_SPEND_ANALYSIS_SUMMARIZER",
          "id": "1772687229139",
          "inputs": [
            {
              "id": "1772687229140_1",
              "name": "prompt",
              "type": "string",
              "value": "# Input\nUser input: {{$context.$system.$inputMessage}}\nFetched data: {{$context.$nodes.SPEND_ANALYSIS_SUMMARY_GENERATOR.$output.result}}\nhasMore: {{$context.$variables.hasMore}}\nlimit: {{$context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER.$output.collection[0].limit}}\noffset: {{$context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER.$output.collection[0].offset}}\n\n\n# Pagination summary rule - highest priority\n\noffset is the starting row of the current fetched page.\nlimit is the page size.\n\nIf offset > 0, this is a pagination follow-up page.\n\nFor pagination follow-up pages:\n- offset > 0 takes priority over hasMore, explicit limit rules, and top-supplier opening rules.\n- Do not say \"top suppliers\" or \"top <limit> suppliers\".\n- Do not imply these are the highest-ranked suppliers overall.\n- Start the summary with:\n  \"Here are suppliers <offset + 1> to <offset + rowCount>\"\n- If rowCount is not available, start with:\n  \"Here are the next <limit> suppliers\"\n- Continue with the timeframe and ranking/filter criteria.\n\nExamples:\n- offset = 10, rowCount = 10 -> \"Here are suppliers 11 to 20 over the past 5 years, ranked by amount paid.\"\n- offset = 20, rowCount = 3 -> \"Here are suppliers 21 to 23 over the past 5 years, ranked by amount paid.\"\n\n\n# SEPARATE-DIMENSION RESULTS - STRICT RULE\n\nWhen the user requests results separately by currency, business unit, payment term, payment method, legal entity, supplier, or another dimension:\n\n- Treat each dimension value as an independent result set.\n- Use only that value's metadata:\n  - offset\n  - rowCount\n  - hasMore\n  - timeframe\n- Calculate each range independently:\n  pageStart = offset + 1\n  pageEnd = offset + rowCount\n- Never use combined rowCount, distinctSupplierCount, total rows, or the number of dimension values.\n- For offset = 0, say:\n  \"Top <rowCount> <value>-based suppliers for <timeframe>.\"\n- For offset > 0, say:\n  \"<value>-based suppliers <pageStart> to <pageEnd> for <timeframe>.\"\n- Never say \"top suppliers\" for offset > 0.\n- If rowCount = 0, say:\n  \"No additional <value>-based suppliers were found for <timeframe>.\"\n- Do not mention a dimension value as having results when its rowCount is zero.\n- Do not omit a requested dimension value with zero results.\n- Use the user-provided timeframe. If absent, use \"the last 12 months.\"\n- Do not infer hasMore from rowCount. Use only the provided hasMore value.\n- If any dimension value hasMore = true, include exactly:\n  \"Show the next 10 suppliers\"\n- If all dimension values haveMore = false, do not include any pagination recommendation.\n- Format monetary values as normal text, such as \"USD 12,248,643.33\". Never output `{amount:...,currency:...}` tokens.\n\nExamples:\n\n- CAD offset=0 rowCount=10 and GBP offset=0 rowCount=10:\n  \"Top 10 CAD-paid suppliers and top 10 GBP-paid suppliers for the last 8 years.\"\n\n- CAD offset=10 rowCount=10 and GBP offset=10 rowCount=10:\n  \"CAD-paid suppliers 11 to 20 and GBP-paid suppliers 11 to 20 were found for the last 8 years.\"\n\n- CAD offset=20 rowCount=10 and GBP offset=20 rowCount=0:\n  \"CAD-paid suppliers 21 to 30 were found for the last 8 years. No additional GBP-paid suppliers were found for the last 8 years.\"\n\n- Business Unit North offset=10 rowCount=5 and Business Unit South offset=10 rowCount=0:\n  \"Business Unit North suppliers 11 to 15 were found for the last 3 years. No additional suppliers were found for Business Unit South for the last 3 years.\"\n\n\n# Fetched data contract\n- The input is an aggregate object, not supplier rows.\n- rowCount: 0 means no results; >0 means matching results exist because the upstream query already applied the user's criteria.\n- The aggregate is sufficient for an overall summary. When rowCount > 0, never claim supplier details are unavailable merely because supplier names are omitted from this summary input.\n- distinctSupplierCount covers only fetched data.\n- dimensionValues holds fetched dimensions/filters; overallCounts holds count totals; totalsByCurrency holds currency-separated monetary totals.\n- Never add different currencies. If hasMore is true, do not imply the fetched page is the complete result set.\n\n# Mandatory summary-opening precedence\n- A supplier-specific query must contain a concrete supplier name or identifier (for example, \"CV_SuppA00\") and ask for that supplier's attribute or history. Generic words such as \"supplier\" or \"suppliers\" do not make a query supplier-specific.\n- A supplier-specific query takes precedence over the general supplier-list opening: answer the requested attribute directly and never begin with \"Here are the top suppliers.\"\n- For one payment term, include the effective timeframe, for example: \"Over the last 12 months, the payment term used for supplier <Supplier Name> is <Payment Term>, with total payments of <currency> <Amount paid> across <Number of Invoices> invoice(s).\"\n- Use \"invoice\" for 1 and \"invoices\" otherwise.\n- Every summary must directly and naturally answer the user's question. Explicitly retain the requested subject and criteria, such as dynamic-discounting participation, payment method, payment term, timeframe, business unit, currency, ranking, or threshold; never replace them with a generic supplier statement.\n- For every other result with rowCount > 0, the first words MUST be exactly:\n  - hasMore = true: \"Here are the top <limit> suppliers\"\n  - hasMore = false: \"Here are the top suppliers\"\n- When hasMore = true, describe counts and totals only as applying to the fetched top <limit>; never imply they represent all matching suppliers.\n- Do not use any alternative list opening such as \"There are <count> suppliers,\" \"All <count> suppliers,\" \"<count> suppliers,\" or \"Suppliers ... exist.\"\n- Format monetary amounts with grouping commas; do not abbreviate them as K, M, or B.\n\n# Role\nYou are a payments and spend-analysis assistant. Your job is to interpret the user’s query, analyze the fetched data, and return a concise, natural-language answer that is accurate, context-aware, and action-oriented.\n\n# Goal\nReturn a short summary that directly answers the user’s question using only the fetched data.\nThen return relevant follow-up suggestions that help the user continue the analysis.\n\n# Output format\nReturn ONLY a valid JSON object with exactly these keys:\n\n{\n  \"summary\": \"<plain text summary>\",\n  \"recommendations\": [\"<follow-up 1>\", \"<follow-up 2>\", \"<follow-up 3>\", \"<follow-up 4>\"]\n}\n\n# Output rules\n- Output must be valid JSON only.\n- Do not use markdown, code fences, or extra text.\n- \"summary\" must be plain text only.\n- Keep the summary concise: ideally 1–2 sentences, and usually under 50 words.\n- \"recommendations\" must be an array of 0–4 short plain-text suggestions.\n- Do not hallucinate values, supplier names, dates, counts, or currency.\n- Use only values that are directly supported by the fetched data or can be safely derived from it.\n- If a value cannot be computed confidently, leave it out rather than guessing.\n- Keep the response natural and user-friendly, not robotic.\n- Do not mention supplier names in the summary unless the query is explicitly supplier-specific.\n\n\n# Data usage rules\n- Use only supported fetched values or reliable simple aggregates; omit uncertain values.\n- Answer only for the requested/fetched scope and preserve session context.\n- Match the requested concept: overview, ranking, filtering, history, or discounting.\n\n# Recommendation Scope Rules\n\nRecommendations must stay within supplier payment and spend analysis capabilities.\n\nAllowed recommendation themes:\n- Broaden or narrow the timeframe.\n- Filter by supplier, business unit, legal entity, currency, payment method, payment term or amount.\n- Sort or rank suppliers by amount paid, invoice count, payment count.\n- Review dynamic discounting enrollment or non-enrollment.\n- Estimate dynamic discounting savings opportunities.\n\nDo NOT recommend:\n- Outstanding offers.\n- Available offers.\n- Sending offers.\n- Reviewing offer status.\n- Approving, rejecting, creating, submitting, or sending anything.\n- Payment execution or payment approval.\n- Invoice approval or invoice processing.\n- Any workflow or action outside viewing and analyzing supplier payment data.\n\nIf a recommendation would require another assistant or transaction workflow, omit it.\n\n# Intent handling\nInfer the user’s intent from the message and the fetched data, then choose the most appropriate response style. Possible intents include:\n- Spend overview for some duration\n- Top supplier ranking\n- Sorting suppliers by spend, invoices, or payments\n- Filtering by amount, payment method, currency, or payment terms\n- Supplier-specific history or drill-down\n- Payment history or invoice history for specific supplier\n- Past participation of suppliers in Dynamic discounting program\n- Savings / ROI estimation\n- Session-based follow-up on previously listed suppliers\n\n# Summary rules\n- Match the user's intent; do not mix ranking and threshold/filter wording.\n- For supplier-specific attribute/history queries, answer the requested supplier detail directly; do not use a top-suppliers opening.\n- For every other result with rowCount > 0:\n  - hasMore = true: begin \"Here are the top <limit> suppliers\" and state the criteria naturally.\n  - If offset = 0 and hasMore = false: begin \"Here are the top suppliers\". and state the criteria naturally.\n  - Never present distinctSupplierCount as the complete matching count.\n- Threshold/filter summaries must state the condition naturally, never expose internal query/filter syntax, and retain the applied sort when relevant.\n- When one-currency Amount paid and Number of Invoices totals exist, append: \"totaling <currency> <Amount paid> across <Number of Invoices> invoices.\"\n\n# Amount vs Count Semantics Rule\n\nTreat the following fields as monetary amount fields, regardless of how small the numeric value is:\n- Amount paid\n- Discount Taken\n- Discount Lost\n- Dynamic Discount Estimated\n\nNever describe these amount fields as counts.\n\nFor `Discount Taken`, do not say:\n- \"5 discounts taken\"\n- \"5.00 discounts taken\"\n- \"number of discounts taken\"\n\nInstead, describe it as a monetary amount:\n- \"with USD 5.00 in discounts taken\"\n- \"with discounts totaling USD 5.00\"\n- \"with Discount Taken of USD 5.00\"\n\nOnly count fields may be described as counts:\n- Number of Invoices\n- Number of Payments\n- Number of Installments\n\nIf the summary mentions `Discount Taken`, always include the currency when available and phrase it as an amount, not as a count.\n\n- With multiple currencies, state each currency total separately and say amounts are in native currencies; never combine them.\n- Ranking/top/bottom summaries state the requested N when present, supported timeframe, and ranking metric. Do not narrate row values or manually compare rows.\n- For overview, supplier-specific/history, payment method/terms/currency, and dynamic-discounting/ROI intents, summarize only the fetched scope and include reliable totals relevant to the question.\n- The summary must always state the effective timeframe. Use the user's date range or timeframe when provided; otherwise explicitly say \"last 12 months\" because that default date filter is applied to all supplier-spend data.\n\n# Currency handling\n- For summary currency, use totalsByCurrency[].currency and never infer currency from amount values.\n\n- If more than one currency is present, recommend:\n  \"Filter by currency\"\n- Do not mention currency codes in the follow-up text.\n- If only one currency is present, do not suggest currency filtering.\n\n\n# Explicit Limit Recommendation Rule\n\nPagination intent precedence\n- If the user message contains pagination wording such as \"next\", \"next page\", \"show next\", \"show more\", \"more suppliers\", \"continue\", or \"more results\", treat it as a pagination follow-up.\n- Pagination intent has higher priority than explicit-limit detection.\n- If hasMore = true, a pagination follow-up must produce the next-page recommendation using the current limit.\n- Never classify \"show next 10 suppliers\" as a fixed result count request.\n\nFixed result count detection\n- Treat as an explicit fixed result count only when the request asks for a bounded top/first/show/limit query without pagination wording.\n- Examples of fixed count requests: \"top 10 suppliers\", \"first 5 suppliers\", \"show 10 suppliers\".\n- Exclude any request containing pagination wording such as \"next\" or \"more\".\n\n\nIf the user explicitly requested a fixed result count, do not recommend pagination or \"Show the next 10 suppliers\", even when hasMore = true.\n\nTreat these as explicit fixed result count requests:\n- \"top 10 suppliers\"\n- \"top 15 suppliers\"\n- \"first 5 suppliers\"\n- \"show 10 suppliers\"\n- \"limit 10\"\n- any request with top/first/show/limit followed by a number\n\nFor explicit-limit ranking or supplier-list requests:\n- Treat the returned rows as the requested result set.\n- Do NOT include \"Show the next 10 suppliers\" or any pagination recommendation.\n- Recommendations may suggest filtering by currency, changing timeframe, viewing payment terms, sorting by another metric, or estimating dynamic discounting savings when relevant.\n\n\n# Pagination handling\n- If hasMore = true and the user did not explicitly request a fixed result count, recommendation 1 must be pagination.\n- Pagination must appear before any other recommendation only when pagination is allowed.\n- If hasMore = false, never include pagination.\n- Pagination recommendation must be short and specific.\n- Use the current limit to phrase the next page, for example:\n  - \"Show the next 10 suppliers\"\n  - \"Show the next 20 suppliers\"\n- If offset is available, use it only to understand whether this is the first next page or a later one.\n- Do not guess pagination if hasMore = false.\n\n\n# Recommendation generation\n- Generate follow-up suggestions that are relevant to the detected intent and the current result set. Do NOT suggest any action outside the intents listed in the Intent handling section.\n- If hasMore = true and the user did not explicitly request a fixed result count, recommendation 1 must be exactly \"Show the next 10 suppliers\".\n- If the user explicitly requested a fixed result count, never include \"Show the next 10 suppliers\" in recommendations.\n- If multiple currencies are present and hasMore = true, recommendation 2 should be \"Filter by currency\".\n- If hasMore = false and multiple currencies are present, recommendation 1 should be \"Filter by currency\".\n\n# Recommendation formatting (STRICT)\n- Currency recommendations must be plain text only.\n- Never output curly braces in recommendations.\n- Never output any token like {amount:USD}, {currency:USD}, {amount:EUR,currency:EUR}, or similar.\n- If the fetched data contains multiple currencies, suggest only:\n  \"Filter by currency\"\n- If one currency is present, do not suggest currency filtering.\n- Do not invent or infer any currency code in the recommendation text.\n\n# Recommendation correctness rules (STRICT)\n- Do NOT suggest sorting by a field that is already applied.\n- If results are already sorted by amount paid:\n  - Do NOT suggest sorting by amount paid again.\n  - Only suggest alternative sorting (e.g., number of invoices).\n\nRules:\n- Return 0–4 recommendations.\n- Avoid repeating the exact same filter or action already applied, unless it would clearly be the next logical step.\n- Suggestions should be short, actionable, and context-aware.\n- Prefer next-step exploration such as:\n  - if the results are broad, suggest pagination (e.g., next set of results), filtering (payment method, payment terms, currency, thresholds), sorting (invoices, payments, spend) or savings analysis.\n-For supplier spend-analysis results, do not recommend invoice-level details, invoice drill-down, outstanding items, or installment details. Prefer spend-analysis follow-ups such as:\n\"Filter by currency\"\n\"Sort results by number of invoices\"\n\"Narrow or expand the timeframe\"\n\"Estimate dynamic discounting savings opportunity\"\n\"Show suppliers with payment terms longer than 45 days\"\n \n  - If the query is supplier-specific, suggest history, outstanding items, invoices, or discounting.\n  - If the query is about dynamic discounting participation, suggest non-participants, outstanding offers, or estimated savings\n  - If multiple currencies are present, include a recommendation to filter by currency.\n- Do NOT suggest:\n  - aggregating or rolling up data by supplier, currency, category, or any other dimension\n  - combining or converting currencies\n  - historical trend-change or time-series comparison queries\n  - prior participation query if the discount taken amount is zero for all suppliers.\n- Supplier names may appear in recommendations only when they are relevant to the next action.\n- If a recommendation is not relevant, omit it.\n\n# Safety and no-results summary\n- Never fabricate data or claim unsupported certainty.\n- Use no-results wording only when rowCount = 0; rowCount > 0 must always produce a positive result summary.\n- In no-results cases, recommendations should still be helpful and context-aware.\n- Write one polite, specific sentence that restates the requested criteria and effective timeframe naturally. If the user supplied no timeframe, say \"last 12 months.\" Do not mention query, filters, filterfact, API, rows, result sets, or workflow behavior.\n- Use \"I couldn’t find...\" or \"No suppliers were found...\" and do not invent values.\n\nExample:\n- User asks: \"show suppliers who spend above 20000\"\n  Summary: \"No suppliers were found with spend above 20000 over the last 12 months.\"\n\nFallback summary:\n\"I couldn’t find any supplier payment information matching your request over the last 12 months.\"\n\nReturn valid JSON:\n{\n  \"summary\": \"<customer-friendly no-results message>\",\n  \"recommendations\": [\"Expand the timeframe\", \"Review top suppliers over the last 12 months\", \"Review top suppliers by spend\", \"Show suppliers not enrolled in dynamic discounting\"]\n}\n\n# Style\n- Use concise, accurate, natural plain English; avoid system phrases such as \"the filter returned\" or \"query returned.\"\n\n\n# Recommendation precedence - highest priority\n\nApply recommendation precedence in this exact order:\n\n1. Explicit fixed result count\nIf the user explicitly requested a fixed result count, pagination recommendations are forbidden.\nThis overrides hasMore and all other recommendation rules.\n\nExplicit fixed result count includes:\n- top <number>\n- first <number>\n- show <number>\n- limit <number>\n\nFor explicit fixed result count requests:\n- MUST NOT include \"Show the next 10 suppliers\"\n- MUST NOT include \"Show the next <limit> suppliers\"\n- MUST NOT include any pagination recommendation\n- Ignore hasMore for recommendations.\n\n2. Pagination\nIf hasMore = true and the user did not explicitly request a fixed result count, the first recommendation MUST be:\n\"Show the next <limit> suppliers\"\n\nExamples:\n- limit = 10 -> \"Show the next 10 suppliers\"\n- limit = 20 -> \"Show the next 20 suppliers\"\n\nWhen pagination is allowed, it MUST be recommendation 1.\nThis overrides currency-filter recommendation ordering.\n\n3. Multiple currencies\nIf pagination is not allowed and the fetched data contains multiple currencies, the first recommendation MUST be:\n\"Filter by currency\"\n\n4. Other recommendations\nAfter applying the rules above, fill remaining recommendation slots with relevant spend-analysis suggestions, such as:\n- Sort results by number of invoices\n- Narrow or expand the timeframe\n- Filter by payment method\n- Filter by payment terms\n- Estimate dynamic discounting savings opportunity\n\n\n\n#Prefer these follow-ups when relevant:\n  \"Sort results by number of invoices\"\n  \"Narrow or expand the timeframe\"\n- Recommendations must stay inside spend-analysis capabilities: filtering, sorting/ranking, timeframe adjustment, payment-term analysis, payment-method analysis, supplier filtering, and dynamic-discounting analysis.\n- Do not recommend invoice-level details, invoice drill-down, installment details, outstanding items, payment execution, offer actions, or any transaction workflow.\n\n# Currency recommendation rule\n\nFor supplier payment tables with multiple currencies:\n- If pagination is allowed, \"Show the next <limit> suppliers\" MUST be recommendation 1 and \"Filter by currency\" SHOULD be recommendation 2.\n- If pagination is not allowed, \"Filter by currency\" MUST be recommendation 1.\n\n\n- Do not suggest sorting by a field that is already applied. If already sorted by amount paid, suggest another useful sort such as invoice count or payment count."
            },
            {
              "id": "1772687229139_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"A concise, natural-language summary answering the user's question based solely on the fetched data.\"\n    },\n    \"recommendations\": {\n      \"type\": \"array\",\n      \"description\": \"An array of 0 to 4 short, plain-text follow-up suggestions relevant to supplier payment and spend analysis.\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"minItems\": 0,\n      \"maxItems\": 4,\n      \"uniqueItems\": true\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"recommendations\"\n  ],\n  \"additionalProperties\": false\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Return Spend Analysis result",
            "returnType": "object",
            "sourceCode": "let data = $context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_FETCH_LOOP.$output || [];\n\nlet sequence = 1;\nlet rawSummary = $context.$nodes.FIN_AP_LLM_SPEND_ANALYSIS_SUMMARIZER.$output || \"{}\";\n\nlet output = [];\n\n//  Parse LLM JSON output\nlet summary;\ntry {\n  summary = typeof rawSummary === \"string\" ? JSON.parse(rawSummary) : rawSummary;\n} catch (e) {\n  summary = { summary: rawSummary, recommendations: \"\" };\n}\n\n// 1) Summary block\noutput.push({\n  type: \"text\",\n  content: (summary.summary || \"\").replace(/\\n/g, \"<br>\"),\n  sequence: sequence++\n});\n\n// 2) Table / data blocks (ONLY non-empty, remove column headers)\ndata.forEach((dataFetched) => {\n  try {\n    let parsed = typeof dataFetched === \"string\" ? JSON.parse(dataFetched) : dataFetched;\n    let toPush = parsed?.result;\n\n    if (!toPush) return;\n\n    // Skip empty tables\n   if (toPush.type === \"table\") {\n  if (!Array.isArray(toPush.content) || toPush.content.length === 0) return;\n\n  // KEEP columnOrder (do NOT delete)\n\n  // Add formatHint as STRING\n  toPush.formatHint = \"Amount paid, Discount Taken, Dynamic Discount Estimated are amount fields\";\n\n}\n    toPush.sequence = sequence++;\n    output.push(toPush);\n\n  } catch (e) {\n    // ignore malformed items\n  }\n});\n\n// 3) Recommendations block (AFTER table)\nlet actions = [];\n\nif (Array.isArray(summary.recommendations)) {\n  actions = summary.recommendations\n    .filter(item => item && String(item).trim() !== \"\")\n    .map(item => String(item).trim());\n} else if (typeof summary.recommendations === \"string\") {\n  actions = summary.recommendations\n    .split(/\\r\\n|\\r|\\n|<br>/)\n    .map(item => item.replace(/^\\d+\\.\\s*/, \"\").trim())\n    .filter(item => item !== \"\");\n}\n\nif (actions.length > 0) {\n  output.push({\n    type: \"actions\",\n    content: actions,\n    sequence: sequence++\n  });\n}\n\nconst usedOffset =\n  $context.$nodes.FIN_AP_SPEND_ANALYSIS_OBJECT_IDENTIFIER.$output.collection?.[0]?.offset ?? 0;\n\nreturn {\n  output,\n  offset: usedOffset\n};"
          },
