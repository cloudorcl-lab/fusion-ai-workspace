        {
          "metadata": {
            "name": "Extract Assignable Work Orders",
            "returnType": "array",
            "sourceCode": "const workOrders = $context.$nodes.BUILD_WORK_ORDER_OBJECT.$output.result.workOrders;\nconst expeditedOperations = [];\nconst allUnassignedOperations = [];\nconst downedWorkstationOperations = [];\nworkOrders.forEach((e) => {\n  e.operations.forEach((o) => {\n    if (!o.assignedWorkstations || o.assignedWorkstations.length === 0) {\n      const operation = {\n        WorkOrderNumber: e.workOrderNumber,\n        OperationSequenceNumber: o.operationSequenceNumber,\n        AssignedQuantity: Number.parseFloat(e.plannedStartQuantity),\n        Expedited: e.expedited === \"Y\",\n        CurrentAssignments: []\n      };\n      allUnassignedOperations.push(operation);\n      if (e.expedited === \"Y\") {\n        expeditedOperations.push(operation);\n      }\n    } else {\n      const currentAssignments = [];\n      let shouldAddToDownedWorkstationOperations = false;\n      o.assignedOperations.forEach((ao) => {\n        currentAssignments.push({\n          WorkstationId: ao.WorkstationId,\n          WorkstationCode: ao.WorkstationCode,\n          AssignedQuantity: ao.AssignedQuantity\n        });\n        if (ao.WorkstationStatusCode === \"DOWN\") {\n          shouldAddToDownedWorkstationOperations = true;\n        }\n      });\n      const operation = {\n        WorkOrderNumber: e.workOrderNumber,\n        OperationSequenceNumber: o.operationSequenceNumber,\n        AssignedQuantity: Number.parseFloat(e.plannedStartQuantity),\n        Expedited: e.expedited === \"Y\",\n        CurrentAssignments: currentAssignments\n      };\n      if (shouldAddToDownedWorkstationOperations) {\n        downedWorkstationOperations.push(operation);\n      }\n    }\n  });\n});\nconst recommendationPanelOperations = allUnassignedOperations.concat(downedWorkstationOperations); \nconst result = {\n  expeditedOperations,\n  recommendationPanelOperations\n};\nreturn result;"
          },
          "outcomes": {
            "success": "1763753720612"
          },
          "diagram": {
            "x": 6099.5,
            "y": 9699
          },
          "code": "EXTRACT_ASSIGNABLE_WORK_ORDERS",
          "id": "1776216170150",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Extract Rescheduling Work Orders",
            "returnType": "object",
            "sourceCode": "const workOrders = $context.$nodes.BUILD_WORK_ORDER_OBJECT.$output.result.workOrders;\n\nfunction getOffsetMinutes(offsetDateInput) {\n  if (!offsetDateInput) return null;\n\n  const offsetMatch = String(offsetDateInput).match(/(Z|[+-]\\d{2}(?::?\\d{2})?)$/);\n  if (!offsetMatch) return null;\n\n  const offset = offsetMatch[1];\n  if (offset === \"Z\") return 0;\n\n  const match = offset.match(/^([+-])(\\d{2})(?::?(\\d{2}))?$/);\n  if (!match) return null;\n\n  const sign = match[1] === \"+\" ? 1 : -1;\n  const hours = Number(match[2]);\n  const minutes = Number(match[3] || \"0\");\n\n  return sign * (hours * 60 + minutes);\n}\n\nfunction isSameUtcDate(a, b) {\n  return (\n    a.getUTCFullYear() === b.getUTCFullYear() &&\n    a.getUTCMonth() === b.getUTCMonth() &&\n    a.getUTCDate() === b.getUTCDate()\n  );\n}\n\nfunction formatUtcUsingOffsetDate(offsetDateInput, utcInput) {\n  const offsetMinutes = getOffsetMinutes(offsetDateInput);\n  if (offsetMinutes === null) return null;\n\n  const utcDate = new Date(utcInput);\n  if (!Number.isFinite(utcDate.getTime())) return null;\n\n  const localDate = new Date(utcDate.getTime() + offsetMinutes * 60 * 1000);\n  const localNow = new Date(Date.now() + offsetMinutes * 60 * 1000);\n\n  const hour = String(localDate.getUTCHours()).padStart(2, \"0\");\n  const minute = String(localDate.getUTCMinutes()).padStart(2, \"0\");\n\n  if (isSameUtcDate(localDate, localNow)) {\n    return `Today, ${hour}:${minute}`;\n  }\n\n  const months = [\n    \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\",\n  ];\n\n  const month = months[localDate.getUTCMonth()];\n  const day = String(localDate.getUTCDate()).padStart(2, \"0\");\n\n  return `${month} ${day}, ${hour}:${minute}`;\n}\n\nconst atRiskOperations = [];\nworkOrders.forEach((e) => {\n  e.operations.forEach((o) => {\n    if (o.riskString !== \"No Risk\" && o.assignedOperations.length > 0) {\n      o.workOrderNumber = e.workOrderNumber;\n      o.workOrderId = e.workOrderId;\n      o.workOrderOperationId = o.workOrderOperationId;\n      o.workOrderPlannedCompletion = e.plannedCompletion;\n      o.executionTime = e.executionTime;\n      o.currentShiftStartTimeWithOffset = e.currentShiftStartTimeWithOffset;\n      atRiskOperations.push(o);\n    }\n  });\n});\n\n// 1) Group + sort by plannedStartDate\nconst operationsGroupedByWorkstation = atRiskOperations.reduce((acc, item) => {\n  const workstations = item.assignedWorkstations?.length\n    ? item.assignedWorkstations\n    : [];\n\n  for (const ws of workstations) {\n    if (!acc[ws]) acc[ws] = [];\n    acc[ws].push({ ...item }); // clone\n  }\n  return acc;\n}, {});\n\nfor (const ws of Object.keys(operationsGroupedByWorkstation)) {\n  operationsGroupedByWorkstation[ws].sort(\n    (a, b) => new Date(a.plannedStartDate) - new Date(b.plannedStartDate)\n  );\n}\n\n// 2) Recalculate newPlannedStartDate / newPlannedCompletionDate\nfor (const ws of Object.keys(operationsGroupedByWorkstation)) {\n  let prevNewPlannedCompletionMs = null;\n\n  operationsGroupedByWorkstation[ws].forEach((op, idx) => {\n    const newStartMs =\n      idx === 0\n        ? new Date(op.desiredPlannedCompletionDate).getTime()\n        : prevNewPlannedCompletionMs;\n\n    const durationMs =\n      new Date(op.plannedCompletionDate).getTime() -\n      new Date(op.plannedStartDate).getTime();\n\n    const newPlannedCompletionMs = newStartMs + durationMs;\n\n    op.newPlannedStartDate = new Date(newStartMs).toISOString();\n    op.newPlannedStartLocal = formatUtcUsingOffsetDate(op.currentShiftStartTimeWithOffset, op.newPlannedStartDate);\n    op.newPlannedCompletionDate = new Date(newPlannedCompletionMs).toISOString();\n    op.newPlannedCompletionLocal = formatUtcUsingOffsetDate(op.currentShiftStartTimeWithOffset, op.newPlannedCompletionDate);\n\n    prevNewPlannedCompletionMs = newPlannedCompletionMs;\n  });\n}\n\nconst result = Object.values(operationsGroupedByWorkstation).flat();\n\nreturn result;"
          },
          "outcomes": {
            "success": "1763753720612"
          },
