            "returnType": "object",
            "sourceCode": "const shifts = $context.$nodes.GET_SHIFT_DETAILS.$output.result;\nconst currentShift = shifts.find(shift => shift.ShiftType === \"CURRENT_SHIFT\");\nconst previousShift = shifts.find(shift => shift.ShiftType === \"PREVIOUS_SHIFT\");\nconst shiftTimes = {\n    currentShiftStartTime: currentShift.StartDateTimeUTC,\n    currentShiftEndTime: currentShift.EndDateTimeUTC,\n    previousShiftStartTime: previousShift.StartDateTimeUTC,\n    previousShiftEndTime: previousShift.EndDateTimeUTC,\n    plantTimeZoneCode: currentShift.PlantTimezoneCode,\n    currentShiftStartTimeWithOffset: currentShift.StartDateTime \n};\n\nreturn shiftTimes;"
          },
