          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OrganizationId\": {\n            \"type\": \"integer\"\n          },\n          \"OrganizationCode\": {\n            \"type\": \"string\"\n          },\n          \"OrganizationName\": {\n            \"type\": \"string\"\n          },\n          \"ManagementBusinessUnitId\": {\n            \"type\": \"integer\"\n          },\n          \"ManagementBusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"LegalEntityId\": {\n            \"type\": \"integer\"\n          },\n          \"LegalEntityName\": {\n            \"type\": \"string\"\n          },\n          \"ProfitCenterBusinessUnitId\": {\n            \"type\": \"integer\"\n          },\n          \"ProfitCenterBusinessUnitName\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"LocationId\": {\n            \"type\": \"integer\"\n          },\n          \"LocationCode\": {\n            \"type\": \"string\"\n          },\n          \"InventoryFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ManufacturingPlantFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"ContractManufacturingFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"MaintenanceEnabledFlag\": {\n            \"type\": \"boolean\"\n          },\n          \"MasterOrganizationId\": {\n            \"type\": \"integer\"\n          },\n          \"MasterOrganizationCode\": {\n            \"type\": \"string\"\n          },\n          \"MasterOrganizationName\": {\n            \"type\": \"string\"\n          },\n          \"IntegratedSystemType\": {\n            \"type\": \"string\"\n          },\n          