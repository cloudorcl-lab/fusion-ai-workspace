            "sourceCode": "let appContext = $context.$app.$OraAppContext;\ntry {\n  if (typeof $context.$app.$OraAppContext === \"string\") {\n    appContext = JSON.parse($context.$app.$OraAppContext);\n  }\n} catch (e) {\n  throw new Error(\"Failed to parse appContext\");\n}\nconst constantValues = {\n    workCenterCode: appContext?.workCenterCode,\n    organizationId: appContext?.organizationId,\n    organizationCode: appContext?.organizationCode,\n    orgSearchParams: `OrganizationCode='${appContext?.organizationCode}'`\n};\nreturn constantValues;"
          },
          "outcomes": {
