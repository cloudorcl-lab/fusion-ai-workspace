                {
                  "metadata": {
                    "name": "Fetch Work Order Operations",
                    "businessObjectCode": "ORA_SCM_MANUFACTUR_WORKORDEROPERATIONSLOV",
                    "functionName": "getWorkOrderOperationsLOV"
                  },
                  "diagram": {
                    "x": 5723.054624,
                    "y": 8206.084096
                  },
                  "outcomes": {
                    "success": "1776064833949"
                  },
                  "id": "1776063533119",
                  "code": "FETCH_WORK_ORDER_OPERATIONS",
                  "type": "BO_FUNCTION",
                  "inputs": [
                    {
                      "id": "1776063533119_WorkOrderNumber",
                      "name": "WorkOrderNumber",
                      "value": "{{$context.$nodes.GET_WORK_ORDER_OPERATIONS.$currentItem.number}}",
                      "required": false,
                      "type": "string"
                    }
                  ],
                  "outputSpecification": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://example.com/work-order-operations-lov.schema.json\",\n  \"title\": \"WorkOrderOperationsLOVResponse\",\n  \"type\": \"object\",\n  \"required\": [\"items\", \"count\", \"hasMore\", \"limit\", \"offset\", \"links\"],\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/workOrderOperation\" }\n    },\n    \"count\": { \"type\": \"integer\" },\n    \"hasMore\": { \"type\": \"boolean\" },\n    \"limit\": { \"type\": \"integer\" },\n    \"offset\": { \"type\": \"integer\" },\n    \"links\": {\n      \"type\": \"array\",\n      \"items\": { \"$ref\": \"#/$defs/link\" }\n    }\n  },\n  \"$defs\": {\n    \"workOrderOperation\": {\n      \"type\": \"object\",\n      \"required\": [\n        \"WoOperationId\",\n        \"OrganizationId\",\n        \"WorkOrderId\",\n        \"OperationType\",\n        \"OperationSequenceNumber\",\n        \"OperationName\",\n        \"PlannedStartDate\",\n        \"PlannedCompletionDate\",\n        \"WorkOrderNumber\",\n        \"DispatchStatus\",\n        \"links\"\n      ],\n      \"properties\": {\n        \"WoOperationId\": { \"type\": \"integer\" },\n        \"OrganizationId\": { \"type\": \"integer\" },\n        \"WorkOrderId\": { \"type\": \"integer\" },\n        \"OperationType\": { \"type\": \"string\" },\n        \"OperationSequenceNumber\": { \"type\": \"integer\" },\n        \"OperationName\": { \"type\": \"string\" },\n        \"OperationDescription\": { \"type\": [\"string\", \"null\"] },\n        \"StandardOperationId\": { \"type\": [\"integer\", \"null\"] },\n        \"WorkCenterId\": { \"type\": [\"integer\", \"null\"] },\n        \"CountPointOperationFlag\": { \"type\": \"boolean\" },\n        \"AutoTransactFlag\": { \"type\": \"boolean\" },\n        \"ReadyQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"CompletedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"ScrappedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"RejectedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"PlannedStartDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n        \"PlannedCompletionDate\": { \"type\": \"string\", \"format\": \"date-time\" },\n\n        \"newPlannedCompletionDate\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\",\n          \"description\": \"Optional computed value.\"\n        },\n\n        \"OSPItemId\": { \"type\": [\"integer\", \"null\"] },\n        \"SupplierId\": { \"type\": [\"integer\", \"null\"] },\n        \"SupplierSiteId\": { \"type\": [\"integer\", \"null\"] },\n        \"PORequestedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"POApprovedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"ShippedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"ReceivedQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"OverReceiptQuantity\": { \"type\": [\"number\", \"null\"] },\n        \"OperationYieldFactor\": { \"type\": [\"number\", \"null\"] },\n        \"BackToBackFlag\": { \"type\": \"boolean\" },\n        \"CanceledDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"CanceledReason\": { \"type\": [\"string\", \"null\"] },\n        \"ClosedDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"InventoryItemId\": { \"type\": [\"integer\", \"null\"] },\n        \"ItemRevision\": { \"type\": [\"string\", \"null\"] },\n        \"ProjectId\": { \"type\": [\"integer\", \"null\"] },\n        \"ProjectNumber\": { \"type\": [\"string\", \"null\"] },\n        \"TaskId\": { \"type\": [\"integer\", \"null\"] },\n        \"TaskNumber\": { \"type\": [\"string\", \"null\"] },\n        \"ReleasedDate\": { \"type\": [\"string\", \"null\"], \"format\": \"date-time\" },\n        \"UOMCode\": { \"type\": [\"string\", \"null\"] },\n        \"WorkMethodId\": { \"type\": [\"integer\", \"null\"] },\n        \"WorkOrderDescription\": { \"type\": [\"string\", \"null\"] },\n        \"WorkOrderNumber\": { \"type\": \"string\" },\n        \"WorkOrderPriority\": { \"type\": [\"integer\", \"string\", \"null\"] },\n        \"WorkOrderStatusId\": { \"type\": [\"integer\", \"null\"] },\n        \"WorkOrderSubType\": { \"type\": [\"string\", \"null\"] },\n        \"WorkOrderType\": { \"type\": [\"string\", \"null\"] },\n        \"WorkAreaId\": { \"type\": [\"integer\", \"null\"] },\n        \"WorkCenterCode\": { \"type\": [\"string\", \"null\"] },\n        \"WorkCenterName\": { \"type\": [\"string\", \"null\"] },\n        \"WorkCenterDescription\": { \"type\": [\"string\", \"null\"] },\n        \"WoStatusCode\": { \"type\": [\"string\", \"null\"] },\n        \"WoStatusId\": { \"type\": [\"integer\", \"null\"] },\n        \"WoStatusName\": { \"type\": [\"string\", \"null\"] },\n        \"WoSystemStatusCode\": { \"type\": [\"string\", \"null\"] },\n        \"ItemNumber\": { \"type\": [\"string\", \"null\"] },\n        \"ItemType\": { \"type\": [\"string\", \"null\"] },\n        \"DispatchStatus\": { \"type\": \"string\" },\n        \"OrderLessFlag\": { \"type\": \"boolean\" },\n        \"links\": {\n          \"type\": \"array\",\n          \"items\": { \"$ref\": \"#/$defs/link\" }\n        }\n      },\n      \"additionalProperties\": true\n    },\n    \"link\": {\n      \"type\": \"object\",\n      \"required\": [\"rel\", \"href\", \"name\", \"kind\"],\n      \"properties\": {\n        \"rel\": { \"type\": \"string\" },\n        \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n        \"name\": { \"type\": \"string\" },\n        \"kind\": { \"type\": \"string\" }\n      },\n      \"additionalProperties\": true\n    }\n  },\n  \"additionalProperties\": true\n}"
                },
                {
                  "metadata": {
                    "name": "Combine result",
                    "returnType": "object",
                    "sourceCode": "const workOrderOperations = $context.$nodes.GET_WORK_ORDER_OPERATIONS.FETCH_WORK_ORDER_OPERATIONS.$output.items;\n\nconst exceptions = $context.$nodes.GET_WORK_ORDER_OPERATIONS.GET_EXCEPTIONS.$output.flatMap((entry) => {\n  const obj = typeof entry === \"string\" ? JSON.parse(entry) : entry;\n  return obj;\n});\n\n\n// WoOperationId -> summed totalResults from matching exception group(s)\nconst totalsByOpId = new Map();\nconst seenExceptionIds = new Set(); // optional: avoids counting duplicate exception payloads\n\nfor (const exGroup of exceptions ?? []) {\n  const groupTotal = Number(exGroup.totalResults ?? 0);\n\n  for (const ex of exGroup.items ?? []) {\n    const exceptionId = ex.ExceptionId;\n    if (seenExceptionIds.has(exceptionId)) continue;\n    seenExceptionIds.add(exceptionId);\n\n    const opId = Number(ex.WoOperationId);\n    totalsByOpId.set(opId, (totalsByOpId.get(opId) ?? 0) + groupTotal);\n  }\n}\n\n// assign into existing workOrderOperations\nfor (const wo of workOrderOperations) {\n  wo.exceptionCount = totalsByOpId.get(Number(wo.WoOperationId)) ?? 0;\n}\n\nreturn workOrderOperations;"
                  },
