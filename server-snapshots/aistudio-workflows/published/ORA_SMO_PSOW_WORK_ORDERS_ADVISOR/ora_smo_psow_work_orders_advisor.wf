            "sourceCode": "let oraAction = $context.$app.$OraAction;\n\nlet result = { action: \"unknownAction\" };\n// Parse the action if its passed as a string\nif (typeof oraAction === \"string\") {\n  try {\n    const actionParams = JSON.parse(oraAction);\n    if (actionParams.action !== undefined) {\n      result = actionParams;\n    }\n  } catch (error) {}\n} else {\n    result = oraAction;\n}\n\nreturn result;"
