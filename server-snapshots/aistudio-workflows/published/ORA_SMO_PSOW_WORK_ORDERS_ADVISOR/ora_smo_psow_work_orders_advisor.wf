        {
          "metadata": {
            "description": "",
            "name": "Build Work Order Object",
            "returnType": "object",
            "sourceCode": "const inputData = $context.$nodes.GET_SHIFT_WORK_ORDERS.$output;\nconst inputWorkOrders = Array.isArray(inputData.items) ? inputData.items : [];\nconst wsActivityOutput = $context.$nodes.GET_WORKSTATION_ACTIVITY_DATA.$output;\nconst workStations = $context.$nodes.GET_WORKSTATIONS_IN_WC.$output;\nconst workstationOperationAssignmentsOutput = $context.$nodes.GET_WORKSTATION_OPERATION_ASSIGNMENTS.$output;\nconst shiftData = $context.$nodes.EXTRACT_SHIFTS.$output.result;\nconst workOrderOperationsOutput = $context.$nodes.GET_WORK_ORDER_OPERATIONS.$output;\nconst nowMs = (new Date()).getTime();\nconst plantTimeZoneCode = $context.$nodes.EXTRACT_SHIFTS.$output.result.plantTimeZoneCode;\nconst currentShiftStartTimeWithOffset = shiftData.currentShiftStartTimeWithOffset;\n\n// First filter out work orders that are not of interest to us\nconst filteredWorkOrders = inputWorkOrders.filter((item) => {\n  return (\n    item[\"status.code\"] === \"ORA_RELEASED\" ||\n    item[\"status.code\"] === \"ORA_COMPLETED\"\n  );\n});\n\nfunction getOffsetMinutes(offsetDateInput) {\n  if (!offsetDateInput) return null;\n\n  const offsetMatch = String(offsetDateInput).match(/(Z|[+-]\\d{2}(?::?\\d{2})?)$/);\n  if (!offsetMatch) return null;\n\n  const offset = offsetMatch[1];\n  if (offset === \"Z\") return 0;\n\n  const match = offset.match(/^([+-])(\\d{2})(?::?(\\d{2}))?$/);\n  if (!match) return null;\n\n  const sign = match[1] === \"+\" ? 1 : -1;\n  const hours = Number(match[2]);\n  const minutes = Number(match[3] || \"0\");\n\n  return sign * (hours * 60 + minutes);\n}\n\nfunction isSameUtcDate(a, b) {\n  return (\n    a.getUTCFullYear() === b.getUTCFullYear() &&\n    a.getUTCMonth() === b.getUTCMonth() &&\n    a.getUTCDate() === b.getUTCDate()\n  );\n}\n\nfunction formatUtcUsingOffsetDate(offsetDateInput, utcInput) {\n  const offsetMinutes = getOffsetMinutes(offsetDateInput);\n  if (offsetMinutes === null) return null;\n\n  const utcDate = new Date(utcInput);\n  if (!Number.isFinite(utcDate.getTime())) return null;\n\n  const localDate = new Date(utcDate.getTime() + offsetMinutes * 60 * 1000);\n  const localNow = new Date(Date.now() + offsetMinutes * 60 * 1000);\n\n  const hour = String(localDate.getUTCHours()).padStart(2, \"0\");\n  const minute = String(localDate.getUTCMinutes()).padStart(2, \"0\");\n\n  if (isSameUtcDate(localDate, localNow)) {\n    return `Today, ${hour}:${minute}`;\n  }\n\n  const months = [\n    \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n    \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\",\n  ];\n\n  const month = months[localDate.getUTCMonth()];\n  const day = String(localDate.getUTCDate()).padStart(2, \"0\");\n\n  return `${month} ${day}, ${hour}:${minute}`;\n}\n\n// Collect wsActivity which is an array of arrays into a single array\nconst wsActivites = [];\nwsActivityOutput.forEach((e) => {\n  let item = e.items;\n  if (typeof e === \"string\") {\n    item = JSON.parse(e);\n  }\n  if (item.items.length > 0) {\n    wsActivites.push(...item.items);\n  }\n});\n\nconst workOrderOperations = workOrderOperationsOutput.flatMap((entry) => {\n  const obj = typeof entry === \"string\" ? JSON.parse(entry) : entry;\n  return Array.isArray(obj.result) ? obj.result : [];\n});\n\n// Collect workstationOperationAssignments in a single array\nconst workstationOperationAssignments = workstationOperationAssignmentsOutput.flatMap((entry) => {\n  const obj = typeof entry === \"string\" ? JSON.parse(entry) : entry;\n  return Array.isArray(obj.items) ? obj.items : [];\n});\n\n// WorkOrders\nconst workOrders = [];\n\nfunction hasCompletedProgress(operation) {\n  const progressText = String(operation?.completionProgress || \"\").trim().toLowerCase();\n  if (progressText === \"complete\" || progressText === \"completed\") return true;\n\n  const completionMatch = progressText.match(/^\\s*([0-9]*\\.?[0-9]+)\\s*of\\s*([0-9]*\\.?[0-9]+)\\s*$/i);\n  return completionMatch\n    ? Number(completionMatch[2]) > 0 && Number(completionMatch[1]) >= Number(completionMatch[2])\n    : false;\n}\n\nfor (const item of filteredWorkOrders) {\n  const workOrder = {};\n\n  workOrder.workOrderId = item.id;\n  workOrder.workOrderNumber = item.number;\n  workOrder.item = item[\"item.number\"];\n  workOrder.priority = item[\"priority\"];\n  workOrder.expedited = item[\"expedited\"];\n  workOrder.plantTimeZoneCode = plantTimeZoneCode;\n  workOrder.plannedStartUTC = item.plannedStartDate;\n  workOrder.plannedStart = item.plannedStartDate;\n  workOrder.plannedStartLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, item.plannedStartDate);\n  workOrder.plannedStartQuantity = item.plannedStartQuantity\n    ? item.plannedStartQuantity\n    : 0.0;\n  workOrder.completedQuantity = item.completedQuantity\n    ? item.completedQuantity\n    : 0;\n  workOrder.rejectedQuantity =\n    item.rejectedQuantity === null || item.rejectedQuantity === undefined\n      ? 0\n      : item.rejectedQuantity;\n  workOrder.plannedCompletionUTC = item.plannedCompletionDate;\n  workOrder.plannedCompletion = item.plannedCompletionDate;\n  workOrder.plannedCompletionLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, item.plannedCompletionDate);\n  workOrder.executionTime = nowMs;\n  workOrder.currentShiftStartTimeWithOffset = currentShiftStartTimeWithOffset;\n\n  // Execution ID. For now, use the first occurance\n  const execActivites = item[\"operations.executionActivities\"];\n  workOrder.executionId =\n    (execActivites !== undefined && execActivites.length) > 0\n      ? execActivites[0][\"operations.executionActivities.id\"]\n      : null;\n\n  // operations\n  workOrder.operations = [];\n  const ops = Array.isArray(item.operations) ? item.operations : [];\n  for (const op of ops) {\n    const operation = {};\n    operation.operationSequenceNumber = op[\"operations.sequenceNumber\"];\n    operation.readyQuantity = op[\"operations.readyQuantity\"];\n    operation.expedited = workOrder.expedited;\n    operation.priority = workOrder.priority;\n    operation.item = workOrder.item;\n    \n    // Execution workstations\n    const execWorkstations = item[\"operations.executionActivities\"].map((e) => e[\"operations.executionActivities.workstation.name\"]);\n    operation.executionWorkstations = [...new Set(execWorkstations)];\n\n    // Workstation assignments\n    const wsAssignment = workstationOperationAssignments.filter(\n      (e) =>\n        e.WorkOrderNumber === workOrder.workOrderNumber &&\n        e.OperationSequenceNumber.toString() === operation.operationSequenceNumber.toString()\n    );\n    operation.assignedWorkstations = wsAssignment.filter(e => e.WorkstationId !== null).map(e => {\n      const ws = workStations.items.find(f => f.WorkstationId.toString() === e.WorkstationId.toString());\n      return ws ? ws.WorkstationCode : null\n    }).filter(e => e !== null);\n    const findWorkOrderOp = workOrderOperations.find(\n      e =>\n        e.WorkOrderNumber === workOrder.workOrderNumber &&\n        e.OperationSequenceNumber.toString() === operation.operationSequenceNumber.toString()\n    );\n    operation.plannedStartDate = findWorkOrderOp?.PlannedStartDate || null;\n    operation.plannedStartLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, operation.plannedStartDate);\n    \n    operation.plannedCompletionDate = findWorkOrderOp?.PlannedCompletionDate || null;\n    operation.plannedCompletionLocal = formatUtcUsingOffsetDate(currentShiftStartTimeWithOffset, operation.plannedCompletionDate);\n\n    operation.workCenterCode = op[\"operations.workCenterCode\"];\n\n    operation.assignedOperations = wsAssignment.map((aop) => {\n      const workstationId = aop.WorkstationId;\n      const matchedWorkstation =\n        workstationId === null || workstationId === undefined\n          ? null\n          : workStations.items.find(\n              (ws) => ws.WorkstationId.toString() === workstationId.toString()\n            );\n      return {\n        CompletedQuantity: aop.CompletedQuantity,\n        AssignedQuantity: aop.AssignedQuantity,\n        WorkstationId: aop.WorkstationId,\n        WorkstationCode: matchedWorkstation ? matchedWorkstation.WorkstationCode : null,\n        PlannedStartDate: aop.PlannedStartDate,\n        PlannedDuration: aop.PlannedDuration,\n        PlannedCompletionDate: aop.PlannedCompletionDate,\n      };\n    });\n    \n    operation.exceptionCount = findWorkOrderOp?.exceptionCount || 0;\n    operation.workOrderOperationId = findWorkOrderOp?.WoOperationId || null;\n    operation.workOrderNumber = workOrder.workOrderNumber;\n    operation.executionTime = nowMs;\n    operation.plantTimeZoneCode = plantTimeZoneCode;\n\n    workOrder.operations.push(operation);\n\n    if (!Array.isArray(operation.assignedOperations) || operation.assignedOperations.length === 0) {\n      operation.completionProgress = `${workOrder.completedQuantity} of ${workOrder.plannedStartQuantity}`;\n    } else {\n      const assignedTotals = operation.assignedOperations.reduce(\n        (acc, aop) => {\n          acc.completed += Number(aop.CompletedQuantity ?? 0) || 0;\n          acc.assigned += Number(aop.AssignedQuantity ?? 0) || 0;\n          return acc;\n        },\n        { completed: 0, assigned: 0 }\n      );\n      operation.completionProgress = `${assignedTotals.completed} of ${assignedTotals.assigned}`;\n    }\n  }\n\n  workOrder.operations.forEach((op) => {\n    const assignedOps = Array.isArray(op.assignedOperations) ? op.assignedOperations : [];\n    const wooStartMs = new Date(op.plannedStartDate).getTime();\n    const wooEndMs = new Date(op.plannedCompletionDate).getTime();\n    const opFallbackDurationSec = Math.max(0, (wooEndMs - wooStartMs) / 1000);\n\n    if (assignedOps.length === 0) {\n      op.desiredPlannedCompletionDate = new Date(nowMs + opFallbackDurationSec * 1000).toISOString();\n    } else {\n      let opLevelLatestMs = null;\n\n      assignedOps.forEach((aop) => {\n        const plannedStartMs = new Date(aop.PlannedStartDate).getTime();\n\n        // Not started yet: skip (do not set field)\n        // if (nowMs < plannedStartMs) return;\n\n        const assignedQty = Number(aop.AssignedQuantity) || 0;\n        const completedQty = Number(aop.CompletedQuantity ?? 0) || 0;\n        const plannedDurationSec = Number(aop.PlannedDuration) || 0;\n\n        const completedRatio = assignedQty > 0 ? completedQty / assignedQty : 0;\n        const remainingFraction = Math.min(1, Math.max(0, 1 - completedRatio));\n        const remainingSec = remainingFraction * plannedDurationSec;\n\n        const newMs = nowMs + remainingSec * 1000;\n        aop.desiredPlannedCompletionDate = new Date(newMs).toISOString();\n\n        if (opLevelLatestMs === null || newMs > opLevelLatestMs) opLevelLatestMs = newMs;\n      });\n\n      // Set operation-level only if at least one assignedOp was considered\n      if (opLevelLatestMs !== null) {\n        op.desiredPlannedCompletionDate = new Date(opLevelLatestMs).toISOString();\n      }\n    }\n\n    const plannedCompletionMs = new Date(op.plannedCompletionDate).getTime();\n    const newPlannedCompletionMs = new Date(op.desiredPlannedCompletionDate).getTime();\n    const hasAssignedWorkstations = Array.isArray(op.assignedWorkstations) && op.assignedWorkstations.length > 0;\n    const noAssignedWorkstations = !hasAssignedWorkstations;\n    const isExpedited = workOrder.expedited === true || String(workOrder.expedited).toUpperCase() === \"Y\";\n    const rawDelayMs =\n      Number.isFinite(newPlannedCompletionMs) && Number.isFinite(plannedCompletionMs)\n        ? (newPlannedCompletionMs - plannedCompletionMs)\n        : 0;\n    const delayMs = Math.max(0, rawDelayMs);\n    const alreadyDelayed = delayMs > 0;\n    const hasOpenExceptions = (Number(op.exceptionCount) || 0) > 0;\n    const hasIssues = noAssignedWorkstations || hasOpenExceptions;\n    const behindMs = noAssignedWorkstations ? Math.abs(rawDelayMs) : delayMs;\n    let delayText = \"0 mins\";\n    if (behindMs < 60 * 60 * 1000) {\n      const mins = Math.ceil(behindMs / (60 * 1000));\n      delayText = `${mins} mins`;\n    } else if (behindMs < 24 * 60 * 60 * 1000) {\n      const hrs = Math.ceil(behindMs / (60 * 60 * 1000));\n      delayText = `${hrs} hrs`;\n    } else {\n      const totalHrs = Math.ceil(behindMs / (60 * 60 * 1000));\n      const days = Math.floor(totalHrs / 24);\n      const hrs = totalHrs % 24;\n      delayText = `${days} day ${hrs} hrs`;\n    }\n    const commentParts = [];\n    if (isExpedited) commentParts.push(\"Expedited work order operation\");\n    if (noAssignedWorkstations) commentParts.push(\"No assigned workstations\");\n    if (hasOpenExceptions) commentParts.push(\"Open exceptions\");\n\n    const isCompletedProgress = hasCompletedProgress(op);\n\n    if (isCompletedProgress) {\n      op.riskString = \"No Risk\";\n    } else if (alreadyDelayed && isExpedited) {\n      op.riskString = \"Critical\";\n      commentParts.push(`Behind by ${delayText}`);\n    } else if (alreadyDelayed || (isExpedited && hasIssues)) {\n      op.riskString = \"High\";\n      if (alreadyDelayed) commentParts.push(`Behind by ${delayText}`);\n    } else if (hasIssues) {\n      op.riskString = \"Medium\";\n    } else {\n      op.riskString = \"No Risk\";\n      commentParts.push(\"On track\");\n    }\n    op.comment = isCompletedProgress\n      ? \"Completed\"\n      : commentParts.length > 0\n        ? commentParts.join(\". \")\n        : \"\";\n  });\n\n  // Workstation activity data\n  if (workOrder.executionId !== undefined && workOrder.executionId !== null) {\n    const wsActivity = wsActivites.find(\n      (e) => e.WsExecActivityId.toString() === workOrder.executionId.toString()\n    );\n    if (wsActivity !== undefined) {\n      workOrder.unitCycleTimeSeconds = wsActivity.OperationVariableTime;\n      const completionTime =\n        wsActivity.CompletionTime === undefined ||\n          wsActivity.CompletionTime === null\n          ? new Date().getTime()\n          : new Date(wsActivity.CompletionTime).getTime();\n      workOrder.operationDurationSeconds =\n        (completionTime - new Date(wsActivity.StartTime).getTime()) / 1000;\n    }\n  }\n\n\n  // Calculate pending\n  const pendingQty =\n    item.plannedStartQuantity -\n    (item.completedQuantity ? item.completedQuantity : 0);\n  const woStart = new Date(workOrder.plannedStartUTC);\n  const currentShiftStart = new Date(shiftData.currentShiftStartTime);\n  if (pendingQty > 0) {\n    if (woStart.getTime() < currentShiftStart.getTime()) {\n      workOrder.status = \"CARRY_OVER\";\n    } else {\n      workOrder.status =\n        workOrder.executionId === null ? \"NOT_STARTED\" : \"IN_PROGRESS\";\n    }\n  } else {\n    workOrder.status = \"COMPLETED\";\n  }\n\n  workOrders.push(workOrder);\n}\n\nconst getOperationSortRank = (operation) => {\n  if (hasCompletedProgress(operation)) return 6;\n\n  let ret = 5;\n  // const isExpedited =\n  //   operation.expedited === true || String(operation.expedited).toUpperCase() === \"Y\";\n  // if (isExpedited) ret = 0;\n\n  if ((Number(operation.exceptionCount) || 0) > 0) ret = 1;\n\n  const riskString = operation.riskString;\n  const normalizedRisk = String(riskString || \"\").toLowerCase();\n  if (normalizedRisk.startsWith(\"critical\")) ret = 2;\n  if (normalizedRisk === \"high\") ret = 3;\n  if (normalizedRisk === \"medium\") ret = 4;\n  if (normalizedRisk === \"no risk\") ret = 5;\n  return ret;\n};\n\nconst processedWorkOrderOperations = workOrders\n  .flatMap(wo => wo.operations)\n  .sort((a, b) => getOperationSortRank(a) - getOperationSortRank(b));\n\n// Output\nconst output = { workOrders, processedWorkOrderOperations };\n\nreturn output;"
          },
          "outcomes": {
            "success": "1776216153950"
          },
