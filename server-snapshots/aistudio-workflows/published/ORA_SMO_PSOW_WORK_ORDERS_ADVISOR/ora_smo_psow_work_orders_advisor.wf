          "metadata": {
            "name": "Build Operation Assignment Params",
            "returnType": "array",
            "sourceCode": "const recommendationsOutput =\n  $context.$nodes.GET_ASSIGNMENT_RECOMMENDATIONS.$output.output;\n\nlet recommendations = [];\nif (typeof recommendationsOutput === \"string\") {\n  try {\n    recommendations = JSON.parse(recommendationsOutput).Recommendations;\n  } catch (error) {}\n} else {\n  recommendations = recommendationsOutput.Recommendations\n    ? recommendationsOutput.Recommendations\n    : [];\n}\nconst result = recommendations.map((e) => {\n  const assignedQuantity = e.RecommendedAssignments.reduce(\n    (accum, currValue) => {\n      return accum + currValue.AssignedQuantity;\n    },\n    0\n  );\n  return {\n    WorkOrderNumber: e.WorkOrderNumber,\n    OperationSequenceNumber: e.OperationSequenceNumber,\n    AssignedQuantity: assignedQuantity,\n  };\n});\n\nreturn result;"
          },
          "outcomes": {
            "success": "1766876403900"
