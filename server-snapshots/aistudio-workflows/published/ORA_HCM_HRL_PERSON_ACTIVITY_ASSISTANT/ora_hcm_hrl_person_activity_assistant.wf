        {
          "metadata": {
            "name": "MapFocusPersons",
            "returnType": "array",
            "sourceCode": "const personName = $context.$nodes.IDENTIFYFOCUSPERSON.$output.personNames;\n\nlet output;\n\nif (Array.isArray(personName) && personName.length > 0) {\n  output = personName.map(item => ({\n    PersonName : item.name || \"\",\n    PersonId: \"\",\n    AssignmentId: \"\"\n  }));\n} else {\n  output = [\n    {\n      PersonName : \"\",\n      PersonId: String($context.$nodes.LOGINPERSONASSIGNMENT.$output.items[0].PersonId),\n      AssignmentId: String($context.$nodes.LOGINPERSONASSIGNMENT.$output.items[0].AssignmentId)\n    }\n  ];\n}\n\nreturn output;"
          },
