          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"personNames\": {\n            \"type\": \"array\"\n        }\n    }\n}",
          "type": "LLM"
