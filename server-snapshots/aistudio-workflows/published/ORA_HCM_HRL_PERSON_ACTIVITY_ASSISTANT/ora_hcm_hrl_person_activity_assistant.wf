                            "returnType": "string",
                            "sourceCode": "const employmentInfo  =  $context.$nodes.LOOPWORKERDETAILS.GETWORKERDATA.EMPLOYMENTINFO.$output;\n\nreturn  {employment_info: employmentInfo};"
                          },
                          "outcomes": {
                            "success": "end_1766151242816"
                          },
