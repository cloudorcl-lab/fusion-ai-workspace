            "y": 6094
          },
          "outcomes": {
            "success": "1784124238536"
          },
          "id": "1784124153243",
          "code": "FIN_AP_CODE_EARLY_PAYMENT_PAYLOAD_CONSTRUCTOR",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Draft Offer Unreviewed Payload Constructor",
            "returnType": "object",
            "sourceCode": "const seededPromptIntent =$context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.SeededPromptType;\n\nconst noOfDays = Number(\n  $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.parameters?.numberOfDays ?? 0\n);\n\n// Equivalent to sysdate in yyyy-mm-dd format\nconst today = new Date();\n\nconst pad = (value) => String(value).padStart(2, '0');\n\nconst todayDate =\n  today.getFullYear() +\n  '-' +\n  pad(today.getMonth() + 1) +\n  '-' +\n  pad(today.getDate());\n\nreturn {\n  viewQueries: {\n    financingProgramOfferDetails: {\n      module: 'oraErpCoreFinancingProgramSetup',\n      businessObject: 'FinancingProgramOffer',\n      fieldAliases: {\n        financingProgramOfferId: 'financingProgramOfferId',\n        discountRate: 'apr',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name':\n          'supplierName',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.name': 'supplierSiteName',\n        'thirdPartyCandidate.billToBusinessUnit.name': 'businessUnitName',\n        'currency.currencyCode': 'currencyCode',\n        'thirdPartyCandidate.financingOptionTypeCode': 'financingOptionType',\n        'offerStatus.meaning': 'offerStatus',\n        'offerStatus.lookupCode': 'offerStatusCode',\n        timeCreated: 'offerCreationDate'\n      },\n      filter:\n        \"offerStatus.meaning = 'Shortlisted' and thirdPartyCandidate.financingOptionTypeCode = 'DYNAMIC_DISCOUNTING'\"\n    },\n    payablesInvoiceInstallments: {\n      module: 'oraErpCorePayablesInvoices',\n      businessObject: 'PayablesInvoiceInstallment',\n      view: 'payablesPaymentScheduleDetail',\n      fieldAliases: {\n        invoiceId: 'invoiceId',\n        installmentNumber: 'installmentNumber',\n        unpaidAmount: 'unpaidAmount',\n        dueDate: 'dueDate',\n        'financeProgramOffer.financingProgramOfferId':\n          'financingProgramOfferId',\n        'invoiceTransaction<Invoice>.supplierSite.name': 'supplierSiteName',\n        'invoiceTransaction<Invoice>.supplier.name': 'supplierName',\n        'invoiceTransaction.businessUnit.name': 'businessUnitName'\n      },\n      filter:\n        \"financeProgramOffer.financingProgramOfferId != null and unpaidAmount > 0 and code.lookupCode in ('N','P') and dueDate >= '\" +\n        todayDate +\n        \"'\"\n    }\n  },\n  select:\n    'select fp.supplierName, fp.supplierSiteName, fp.businessUnitName, fp.currencyCode, trunc(sysdate) - trunc(fp.offerCreationDate) as daysUnreviewed, count(pi.invoiceId) as numberOfInstallments, round(nvl(sum(pi.unpaidAmount), 0), 2) as outstandingAmount, round(nvl(sum(pi.unpaidAmount * (nvl(fp.apr, 0) / 100) * ((trunc(pi.dueDate) - trunc(sysdate)) / 360)), 0), 2) as discountLost from financingProgramOfferDetails fp join payablesInvoiceInstallments pi on fp.financingProgramOfferId = pi.financingProgramOfferId and fp.supplierName = pi.supplierName and fp.supplierSiteName = pi.supplierSiteName and fp.businessUnitName = pi.businessUnitName where trunc(sysdate) - trunc(fp.offerCreationDate) > ' +\n    noOfDays +\n    ' group by fp.financingProgramOfferId, fp.supplierName, fp.supplierSiteName, fp.businessUnitName, fp.currencyCode, fp.apr, fp.offerCreationDate order by discountLost desc FETCH FIRST 20 ROWS ONLY',\n  return: [\n    { name: 'supplierName', type: 'string' },\n    { name: 'supplierSiteName', type: 'string' },\n    { name: 'businessUnitName', type: 'string' },\n    { name: 'currencyCode', type: 'string' },\n    { name: 'daysUnreviewed', type: 'string' },\n    { name: 'numberOfInstallments', type: 'string' },\n    { name: 'outstandingAmount', type: 'string' },\n    { name: 'discountLost', type: 'string' }\n  ]\n};"
          },
          "diagram": {
            "x": 7994.772141123555,
            "y": 6078.838532307373
          },
          "outcomes": {
            "success": "1784124238536"
          },
          "id": "1784124195370",
          "code": "FIN_AP_DRAFT_OFFER_UNREVIEWED_PAYLOAD_CONSTRUCTOR",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Set Extraction Payload Body",
            "returnType": "object",
            "sourceCode": "const isNotEmptyObject = (value) =>\n  value &&\n  typeof value === 'object' &&\n  !Array.isArray(value) &&\n  Object.keys(value).length > 0;\n\nconst acceptanceRatePayload =\n  $context.$nodes.FIN_AP_CODE_ACCEPTANCE_RATE_PAYLOAD_CONSTRUCTOR?.$output?.result ?? {};\n\nconst communicatedOfferPayload =\n  $context.$nodes.FIN_AP_CODE_COMMUNICATED_OFFER_PAYLOAD_CONSTRUCTOR?.$output?.result ?? {};\n\nconst earlyPaymentPayload =\n  $context.$nodes.FIN_AP_CODE_EARLY_PAYMENT_PAYLOAD_CONSTRUCTOR?.$output?.result ?? {};\n\nconst draftOfferUnreviewedPayload =\n  $context.$nodes.FIN_AP_DRAFT_OFFER_UNREVIEWED_PAYLOAD_CONSTRUCTOR?.$output?.result ??{};\n\nreturn isNotEmptyObject(acceptanceRatePayload)\n  ? acceptanceRatePayload\n  : isNotEmptyObject(communicatedOfferPayload)\n    ? communicatedOfferPayload\n    : isNotEmptyObject(earlyPaymentPayload)\n      ? earlyPaymentPayload\n      : isNotEmptyObject(draftOfferUnreviewedPayload)\n        ? draftOfferUnreviewedPayload\n        : {};"
          },
          "diagram": {
            "x": 7278.491636214719,
            "y": 6360.1176346916645
          },
          "outcomes": {
            "success": "1784124625933"
          },
          "id": "1784124238536",
          "code": "FIN_AP_CODE_SET_EXTRACTION_PAYLOAD_BODY",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Call Extract End Point",
            "businessObjectCode": "ORA_FIN_PAYABLES_BUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract"
          },
          "diagram": {
            "x": 7244.2165667869995,
            "y": 6583.329628199145
          },
          "outcomes": {
            "success": "1784124799983"
          },
          "id": "1784124625933",
          "code": "FIN_AP_BO_CALL_EXTRACT_END_POINT",
          "type": "BO_FUNCTION",
          "inputs": [
            {
              "id": "1784124625933_extraction_query_json_object",
              "name": "extraction_query_json_object",
              "value": "{{$context.$nodes.FIN_AP_CODE_SET_EXTRACTION_PAYLOAD_BODY.$output.result}}",
              "required": true,
              "type": "string"
            }
          ]
        },
        {
          "metadata": {
            "name": "Format Seeded Prompt Output",
            "returnType": "object",
            "sourceCode": "let extractionOutput = $context.$nodes.FIN_AP_BO_CALL_EXTRACT_END_POINT.$output;\nconst seededPromptIntent = $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.SeededPromptType;\nconst summary = [];\nlet rows = extractionOutput && extractionOutput !== undefined ? extractionOutput : [];\n\nif (seededPromptIntent === \"acceptanceRate\") {\n  const tableRows = rows.map((row) => ({\n    \"Supplier Name\": String(row?.supplierName ?? ''),\n    \"Offers Sent\": String(row?.offersSent ?? '0'),\n    \"Offers Accepted\": String(row?.offersAccepted ?? '0'),\n    \"Acceptance Rate\": String(row?.acceptanceRate ?? '0%')\n  }));\n\n\n\n  if (tableRows.length > 0) {\n    summary.push({\n      type: 'text',\n      content: [\n        'Here are the communicated offers for the requested period, along with the acceptance rate by supplier.'\n      ],\n      sequence: 1,\n    });\n\n    summary.push({\n      type: 'table',\n      content: tableRows,\n      sequence: 2,\n      heading: 'Acceptance Rate by Supplier',\n      columnOrder: [\n        'Supplier Name',\n        'Offers Sent',\n        'Offers Accepted',\n        'Acceptance Rate'\n      ]\n    });\n  } else {\n    summary.push({\n      type: 'text',\n      content: [\n        'No offers were sent out during the requested period.'\n      ],\n      sequence: 1,\n    });\n  }\n} else if (seededPromptIntent === \"communicatedOffer\") {\nconst tableRows = rows.map((row) => ({\n  'Supplier': String(row?.supplierName ?? ''),\n  'Supplier Site': String(row?.supplierSiteName ?? ''),\n  'Business Unit': String(row?.businessUnitName ?? ''),\n  'Offer Sent Date': String(row?.offerSendDate ?? ''),\n  'Days Until Expiry': String(row?.daysUntilExpiry ?? ''),\n  'Number of Installments': String(row?.numberOfInstallments ?? ''),\n  'Outstanding Amount':\n    `${String(row?.outstandingAmount ?? '')} ${String(row?.currencyCode ?? '')}`.trim(),\n  'Discount Lost':\n    `${String(row?.estimatedLossOfBenefit ?? '')} ${String(row?.currencyCode ?? '')}`.trim()\n}));\n\n\n  if (tableRows.length > 0) {\n    summary.push({\n      type: 'text',\n      content: [\n        'Here are the communicated offers that are expiring in the requested time period'\n      ],\n      sequence: 1,\n    });\n\n    summary.push({\n      type: 'table',\n      content: tableRows,\n      sequence: 2,\n      heading: 'Communicated Offers',\n      columnOrder: [\n        'Supplier',\n        'Supplier Site',\n        'Business Unit',\n        'Offer Sent Date',\n        'Days Until Expiry',\n        'Number of Installments',\n        'Outstanding Amount',\n        'Discount Lost'\n      ]\n    });\n  } else {\n    summary.push({\n      type: 'text',\n      content: [\n        'No offers are nearing expiry in the requested period.'\n      ],\n      sequence: 1,\n    });\n  }\n} else if (seededPromptIntent === \"earlyPayment\") {\n  const tableRows = rows.map((row) => ({\n    \"Supplier Name\": String(row?.supplierName ?? ''),\n    \"Supplier Site Name\": String(row?.supplierSiteName ?? ''),\n    \"Business Unit\": String(row?.businessUnitName ?? ''),\n    \"Currency\": String(row?.currencyCode ?? ''),\n    \"Number of Installments\": String(row?.numberOfInstallments ?? '0'),\n    \"Discount Rate\": String(row?.discountRate ?? '0'),\n    \"Recipient\": String(row?.recipient ?? '')\n  }));\n\n\n\n  if (tableRows.length > 0) {\n    summary.push({\n      type: 'text',\n      content: [\n        'Here are the draft offers with no eligible installments'\n      ],\n      sequence: 1,\n    });\n\n    summary.push({\n      type: 'table',\n      content: tableRows,\n      sequence: 2,\n      heading: 'Draft Offers No Longer Eligible for Early Paynent',\n      columnOrder: [\n        'Supplier Name',\n        'Supplier Site Name',\n        'Business Unit',\n        'Currency',\n        'Number of Installments',\n        'Discount Rate',\n        'Recipient'\n      ]\n    });\n    summary.push({\n  type: \"actions\",\n  content: [\n    \"Discard these offers\"\n  ],\n  sequence: 3\n});\n  } else {\n    summary.push({\n      type: 'text',\n      content: [\n        'No draft offers were found with no eligible installments.'\n      ],\n      sequence: 1,\n    });\n  }\n} else if (seededPromptIntent === \"draftOfferUnreviewed\") {\nconst tableRows = rows.map((row) => ({\n  'Supplier': String(row?.supplierName ?? ''),\n  'Supplier Site': String(row?.supplierSiteName ?? ''),\n  'Business Unit': String(row?.businessUnitName ?? ''),\n  'Days Unreviewed': String(row?.daysUnreviewed ?? ''),\n  'Number of Installments': String(row?.numberOfInstallments ?? ''),\n  'Outstanding Amount':\n    `${String(row?.outstandingAmount ?? '')} ${String(row?.currencyCode ?? '')}`.trim(),\n  'Discount Lost':\n    `${String(row?.discountLost ?? '')} ${String(row?.currencyCode ?? '')}`.trim()\n}));\n\n\n\n  if (tableRows.length > 0) {\n    summary.push({\n      type: 'text',\n      content: [\n        'Here are the draft offers that have not been reviewed during the requested time period, along with the estimated loss of benefit.'\n      ],\n      sequence: 1,\n    });\n\n    summary.push({\n      type: 'table',\n      content: tableRows,\n      sequence: 2,\n      heading: 'Draft Offers Unreviewed',\n      columnOrder: [\n        'Supplier',\n        'Supplier Site',\n        'Business Unit',\n        'Days Unreviewed',\n        'Number of Installments',\n        'Outstanding Amount',\n        'Discount Lost'\n      ]\n    });\n        summary.push({\n  type: \"actions\",\n  content: [\n        'Send all offers',\n        'Send offer to specific supplier',\n        'Show installments in the offer for specific supplier',\n        'Discard offers'\n      ],\n  sequence: 3\n});\n  } else {\n    summary.push({\n      type: 'text',\n      content: [\n        'No draft offers were unreviewed during the requested timeframe'\n      ],\n      sequence: 1,\n    });\n  }\n} else {\n  summary.push({\n    type: 'text',\n    content: [\n      'Your query could not be processed .Please try again later.'\n    ],\n    sequence: 1,\n  });\n}\n\n\n\nreturn {\n  summary: summary\n};"
          },
