            "sourceCode": "let currentResponse = JSON.parse( $context.$nodes.FIN_AP_WORKFLOW_FORMAT_RESPONSE.$output.output ); \nlet conversationHistory = Array.isArray($context.$variables.conversationHistory) ? [...$context.$variables.conversationHistory] : [];\nconversationHistory.push(\"Agent: \" + JSON.stringify(currentResponse));  \nreturn conversationHistory;"
          },
          "outcomes": {
