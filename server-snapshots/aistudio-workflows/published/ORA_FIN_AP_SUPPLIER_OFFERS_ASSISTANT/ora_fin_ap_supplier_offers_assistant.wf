            "communicatedOffer": "1784124108981",
            "earlyPayment": "1784124153243",
            "draftOfferUnreviewed": "1784124195370"
          },
          "id": "1784123970043",
          "code": "IDENTIFY_SEEDED_PROMPTFIN_AP_SWITCH_IDENTIFY_SEEDED_PROMPT",
          "type": "SWITCH",
          "convergenceTargetId": "1784124238536",
          "inputs": [
            {
              "id": "1784123970043_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.SeededPromptType}}"
            }
          ]
        },
        {
          "metadata": {
            "name": "Acceptance Rate Payload Constructor",
            "returnType": "object",
            "sourceCode": "const seededPromptIntent =\n  $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.SeededPromptType;\n\nconst numberOfDays = Number(\n   $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.parameters?.numberOfDays ?? 0\n);\n\n\n// Equivalent to sysdate - numberOfDays\nconst sysdateMinusDays = new Date();\nsysdateMinusDays.setDate(sysdateMinusDays.getDate() - numberOfDays);\n\nconst pad = (value) => String(value).padStart(2, '0');\n\nconst dateLimit =\n  sysdateMinusDays.getFullYear() +\n  '-' +\n  pad(sysdateMinusDays.getMonth() + 1) +\n  '-' +\n  pad(sysdateMinusDays.getDate());\n\nreturn {\n  viewQueries: {\n    offersSentBySupplier: {\n      module: 'oraErpCoreFinancingProgramSetup',\n      businessObject: 'FinancingProgramOffer',\n      fieldAliases: {\n        financingProgramOfferId: 'financingProgramOfferId',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name':\n          'supplierName',\n        'offerStatus.meaning': 'offerStatus',\n        'offerStatus.lookupCode': 'offerStatusCode',\n        sendDate: 'offerSendDate'\n      },\n      filter:\n        \"offerStatus.meaning in ('Offer communicated', 'Expired', 'Declined', 'Accepted one-time') and sendDate>='\" +\n        dateLimit +\n        \"'\"\n    },\n    offersAcceptedBySupplier: {\n      module: 'oraErpCoreFinancingProgramSetup',\n      businessObject: 'FinancingProgramOffer',\n      fieldAliases: {\n        financingProgramOfferId: 'financingProgramOfferId',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name':\n          'supplierName',\n        'offerStatus.meaning': 'offerStatus',\n        'offerStatus.lookupCode': 'offerStatusCode',\n        sendDate: 'offerSendDate'\n      },\n      filter:\n        \"offerStatus.meaning = 'Accepted one-time' and sendDate>='\" +\n        dateLimit +\n        \"'\"\n    }\n  },\n  select:\n    \"select sent.supplierName, count(distinct sent.financingProgramOfferId) as offersSent, count(distinct accepted.financingProgramOfferId) as offersAccepted, round((count(distinct accepted.financingProgramOfferId) / nullif(count(distinct sent.financingProgramOfferId), 0)) * 100, 0) || '%' as acceptanceRate from offersSentBySupplier sent left join offersAcceptedBySupplier accepted on sent.supplierName = accepted.supplierName group by sent.supplierName order by acceptanceRate desc FETCH FIRST 20 ROWS ONLY\",\n  return: [\n    {\n      name: 'supplierName',\n      type: 'string'\n    },\n    {\n      name: 'offersSent',\n      type: 'string'\n    },\n    {\n      name: 'offersAccepted',\n      type: 'string'\n    },\n    {\n      name: 'acceptanceRate',\n      type: 'string'\n    }\n  ]\n};"
          },
          "diagram": {
            "x": 6432.5,
            "y": 6094
          },
          "outcomes": {
            "success": "1784124238536"
          },
          "id": "1784124053159",
          "code": "FIN_AP_CODE_ACCEPTANCE_RATE_PAYLOAD_CONSTRUCTOR",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Communicated Offer Payload Constructor",
            "returnType": "object",
            "sourceCode": "const seededPromptIntent =\n  $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.SeededPromptType;\n\nconst noOfDays = Number(\n  $context.$nodes.FIN_AP_LLM_SEEDED_PROMPT_INTENT_IDENTIFIER.$output.result.parameters?.numberOfDays ?? 0\n);\n\n// Equivalent to sysdate in yyyy-mm-dd format\nconst today = new Date();\n\nconst pad = (value) => String(value).padStart(2, '0');\n\nconst todayDate =\n  today.getFullYear() +\n  '-' +\n  pad(today.getMonth() + 1) +\n  '-' +\n  pad(today.getDate());\n\nreturn {\n  viewQueries: {\n    financingProgramOfferDetails: {\n      module: 'oraErpCoreFinancingProgramSetup',\n      businessObject: 'FinancingProgramOffer',\n      fieldAliases: {\n        financingProgramOfferId: 'financingProgramOfferId',\n        discountRate: 'apr',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name':\n          'supplierName',\n        'thirdPartyCandidate.thirdPartyAccountOrSite.name': 'supplierSiteName',\n        'thirdPartyCandidate.billToBusinessUnit.name': 'businessUnitName',\n        'currency.currencyCode': 'currencyCode',\n        'thirdPartyCandidate.financingOptionTypeCode': 'financingOptionType',\n        'offerStatus.meaning': 'offerStatus',\n        'offerStatus.lookupCode': 'offerStatusCode',\n        sendDate: 'offerSendDate',\n        offerExpirationDate: 'offerExpirationDate'\n      },\n      filter:\n        \"offerStatus.meaning = 'Offer communicated' and thirdPartyCandidate.financingOptionTypeCode = 'DYNAMIC_DISCOUNTING'\"\n    },\n    payablesInvoiceInstallments: {\n      module: 'oraErpCorePayablesInvoices',\n      businessObject: 'PayablesInvoiceInstallment',\n      view: 'payablesPaymentScheduleDetail',\n      fieldAliases: {\n        invoiceId: 'invoiceId',\n        installmentNumber: 'installmentNumber',\n        unpaidAmount: 'unpaidAmount',\n        'financeProgramOffer.financingProgramOfferId':\n          'financingProgramOfferId',\n        'invoiceTransaction<Invoice>.supplierSite.name': 'supplierSiteName',\n        'invoiceTransaction<Invoice>.supplier.name': 'supplierName',\n        'invoiceTransaction.businessUnit.name': 'businessUnitName'\n      },\n      filter:\n        \"financeProgramOffer.financingProgramOfferId != null and unpaidAmount > 0 and code.lookupCode in ('N','P') and dueDate >= '\" +\n        todayDate +\n        \"'\"\n    }\n  },\n  select:\n    'select fp.businessUnitName, fp.supplierName, fp.supplierSiteName, fp.currencyCode, to_char(fp.offerSendDate, \\'YYYY-MM-DD\\') as offerSendDate, to_char(fp.offerExpirationDate, \\'YYYY-MM-DD\\') as offerExpirationDate, trunc(fp.offerExpirationDate) - trunc(sysdate) as daysUntilExpiry, count(pi.invoiceId) as numberOfInstallments, round(nvl(sum(pi.unpaidAmount), 0), 2) as outstandingAmount, round(nvl(sum(pi.unpaidAmount), 0) * (nvl(fp.apr, 0) / 100) * ((trunc(sysdate) - trunc(fp.offerSendDate)) / 360), 2) as estimatedLossOfBenefit, fp.offerStatus from financingProgramOfferDetails fp join payablesInvoiceInstallments pi on fp.financingProgramOfferId = pi.financingProgramOfferId and fp.supplierName = pi.supplierName and fp.supplierSiteName = pi.supplierSiteName and fp.businessUnitName = pi.businessUnitName where trunc(fp.offerExpirationDate) between trunc(sysdate) and trunc(sysdate) + ' +\n    noOfDays +\n    ' group by fp.financingProgramOfferId, fp.businessUnitName, fp.supplierName, fp.supplierSiteName, fp.currencyCode, fp.offerSendDate, fp.offerExpirationDate, fp.apr, fp.offerStatus order by estimatedLossOfBenefit desc FETCH FIRST 20 ROWS ONLY',\n  return: [\n    { name: 'businessUnitName', type: 'string' },\n    { name: 'supplierName', type: 'string' },\n    { name: 'supplierSiteName', type: 'string' },\n    { name: 'currencyCode', type: 'string' },\n    { name: 'offerSendDate', type: 'string' },\n    { name: 'offerExpirationDate', type: 'string' },\n    { name: 'daysUntilExpiry', type: 'string' },\n    { name: 'numberOfInstallments', type: 'string' },\n    { name: 'outstandingAmount', type: 'string' },\n    { name: 'estimatedLossOfBenefit', type: 'string' },\n    { name: 'offerStatus', type: 'string' }\n  ]\n};"
          },
          "diagram": {
            "x": 6957.5,
            "y": 6094
          },
          "outcomes": {
            "success": "1784124238536"
          },
          "id": "1784124108981",
          "code": "FIN_AP_CODE_COMMUNICATED_OFFER_PAYLOAD_CONSTRUCTOR",
          "type": "CODE",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "metadata": {
            "name": "Early Payment Payload Constructor",
            "sourceCode": "let extractObject = {\n  \"viewQueries\": {\n    \"financingProgramOfferDetails\": {\n      \"module\": \"oraErpCoreFinancingProgramSetup\",\n      \"businessObject\": \"FinancingProgramOffer\",\n      \"fieldAliases\": {\n        \"financingProgramOfferId\": \"financingProgramOfferId\",\n        \"discountRate\": \"discountRate\",\n        \"thirdPartyCandidate.thirdPartyAccountOrSite.supplier.name\": \"supplierName\",\n        \"thirdPartyCandidate.thirdPartyAccountOrSite.supplier.supplierId\": \"supplierId\",\n        \"thirdPartyCandidate.thirdPartyAccountOrSite.name\": \"supplierSiteName\",\n        \"thirdPartyCandidate.financingOptionTypeCode\": \"financingOptionType\",\n        \"thirdPartyCandidate.financingProgram.programType.lookupCode\": \"programType\",\n        \"offerStatus.meaning\": \"offerStatus\",\n        \"offerStatus.lookupCode\": \"offerStatusCode\",\n        \"emailAddress\": \"emailAddress\",\n        \"currency.currencyCode\": \"currencyCode\",\n        \"thirdPartyCandidate.billToBusinessUnit.name\": \"businessUnitName\"\n      },\n      \"filter\": \"offerStatus.meaning = 'Shortlisted' and thirdPartyCandidate.financingOptionTypeCode = 'DYNAMIC_DISCOUNTING'\"\n    },\n    \"payablesInvoiceInstallments\": {\n      \"module\": \"oraErpCorePayablesInvoices\",\n      \"businessObject\": \"PayablesInvoiceInstallment\",\n      \"view\": \"payablesPaymentScheduleDetail\",\n      \"fieldAliases\": {\n        \"invoiceId\": \"invoiceId\",\n        \"installmentNumber\": \"installmentNumber\",\n        \"dueDate\": \"dueDate\",\n        \"unpaidAmount\": \"unpaidAmount\",\n        \"code.lookupCode\": \"paymentStatusCode\",\n        \"financeProgramOffer.financingProgramOfferId\": \"financingProgramOfferId\",\n        \"invoiceTransaction.invoiceNumber\": \"invoiceNumber\",\n         \"invoiceTransaction<Invoice>.supplierSite.name\": \"supplierSiteName\",\n        \"invoiceTransaction<Invoice>.supplier.name\": \"supplierName\",\n        \"invoiceTransaction.businessUnit.name\": \"businessUnitName\"\n      },\n      \"filter\": \"financeProgramOffer.financingProgramOfferId != null and unpaidAmount > 0 and code.lookupCode in ('N','P')\"\n    }\n  },\n\"select\": \"select fp.supplierName, fp.supplierSiteName, fp.businessUnitName, fp.currencyCode, count(pi.invoiceId) as numberOfInstallments, fp.discountRate, fp.emailAddress as recipient from financingProgramOfferDetails fp left join payablesInvoiceInstallments pi on fp.financingProgramOfferId = pi.financingProgramOfferId and fp.supplierName = pi.supplierName and fp.supplierSiteName = pi.supplierSiteName and fp.businessUnitName = pi.businessUnitName group by fp.financingProgramOfferId, fp.supplierName, fp.supplierSiteName, fp.businessUnitName, fp.currencyCode, fp.discountRate, fp.emailAddress having count(pi.invoiceId) = 0 order by fp.supplierName, fp.supplierSiteName, fp.businessUnitName, fp.currencyCode fetch first 20 rows only\"  ,\n\"return\": [\n    {\n      \"name\": \"supplierName\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"supplierSiteName\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"businessUnitName\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"currencyCode\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"numberOfInstallments\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"discountRate\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"recipient\",\n      \"type\": \"string\"\n    }\n  ]\n};\n\nreturn extractObject;",
            "returnType": "object"
          },
