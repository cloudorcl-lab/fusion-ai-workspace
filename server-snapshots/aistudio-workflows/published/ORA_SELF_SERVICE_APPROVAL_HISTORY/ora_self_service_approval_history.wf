        {
          "metadata": {
            "name": "parse past approver",
            "returnType": "string",
            "sourceCode": "var appHistResponse = $context.$nodes.GET_APPROVAL_HISTORY_RELATED_DATA.$output;\nvar approverList = \"\";\nvar counter = 0;\nfor(var i=0;i<appHistResponse['result'].length;i++){\n    if(appHistResponse['result'][i]['Action']  == \"Approved\" ){\n       approverList += appHistResponse['result'][i]['ActionDescription'] + \" \"+ \"\\n\";\n       counter++;\n       }\n}\nif(counter == 0){\napproverList = \"No information available for Past Approver\";\n}\nreturn approverList;"
          },
          "outcomes": {
            "success": "1764174672135"
          },
