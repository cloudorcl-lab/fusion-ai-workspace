          },
          "code": "EXTRACT_TRANSACTION_ID_FROM_INPUT",
          "id": "1764082450580",
          "inputs": [
            {
              "id": "1764082450582_1",
              "name": "prompt",
              "type": "string",
              "value": "From the provided input message extract the transaction id ``` {{$context.$system.$inputMessage}} ```\nExample\nuserInput: who is the current approver of 300103651358143\noutput: 300103651358143\n\nIf no transaction id is found then \noutput: TRANSACTION_ID_NOT_FOUND"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Set Transaction Variable"
          },
          "outcomes": {
            "success": "1766382797030"
          },
