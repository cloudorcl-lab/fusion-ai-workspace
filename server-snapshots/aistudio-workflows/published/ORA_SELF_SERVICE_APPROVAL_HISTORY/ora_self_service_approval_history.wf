        },
        {
          "metadata": {
            "name": "Categorize user query"
          },
          "outcomes": {
            "success": "1764144232085"
          },
          "code": "CATEGORIZE_USER_QUERY",
          "id": "1764144049353",
          "inputs": [
            {
              "id": "1764144049354_1",
              "name": "prompt",
              "type": "string",
              "value": "Read the user query ``` {{$context.$system.$inputMessage}} ``` and classify it into one of the below categories\nGET_CURRENT_APPROVER\nGET_FUTURE_APPROVER\nGET_FULL_APPROVAL_HISTORY\nGET_PAST_APPROVER\nINVALID_REQUEST"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "route approval history category"
          },
          "outcomes": {
            "GET_CURRENT_APPROVER": "1764144310180",
            "GET_FUTURE_APPROVER": "1764173347204",
            "GET_FULL_APPROVAL_HISTORY": "1766382916828",
            "GET_PAST_APPROVER": "1764174284355",
            "INVALID_REQUEST": "1766386018584"
          },
          "code": "ROUTE_APPROVAL_HISTORY_CATEGORY",
          "convergenceTargetId": "end",
          "id": "1764144232085",
          "inputs": [
            {
              "id": "1764144232086_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.CATEGORIZE_USER_QUERY.$output}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "metadata": {
            "name": "parse current approver",
            "returnType": "string",
            "sourceCode": "var appHistResponse = $context.$variables.approverHistoryResponseObject;\nvar counter = 0;\nvar approverList = \"\";\nfor (var i = 0; i < appHistResponse.length; i++) {\n      if (appHistResponse[i].IsCurrentParticipantFlag === \"true\" || appHistResponse[i].IsCurrentParticipantFlag === true) {\n\n            if (appHistResponse[i].Action === \"Reassigned\") {\n                  var text = appHistResponse[i].ActionDescription;\n                  var match = text.match(/<strong>(.*?)<\\/strong>/);\n                  if (match) {\n                        approverList += match[1] + \" \" + \"\\n\";\n\n                  } else {\n                        approverList += appHistResponse[i].ActionDescription + \" \" + \"\\n\";\n                  }\n            } else {\n                  approverList += appHistResponse[i].ActionDescription + \" \" + \"\\n\";\n            }\n\n            counter++;\n      }\n}\nif (counter == 0) {\n      approverList = \"No information available for Current Approver  \";\n}\nreturn approverList;"
          },
          "outcomes": {
            "success": "1764173249361"
          },
          "code": "PARSE_CURRENT_APPROVER",
          "id": "1764144310180",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "print response of current approver"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PRINT_RESPONSE_OF_CURRENT_APPROVER",
          "id": "1764173249361",
          "inputs": [
            {
              "id": "1764173249362_1",
              "name": "prompt",
              "type": "string",
              "value": "print  {{$context.$nodes.PARSE_CURRENT_APPROVER.$output.result}}\nDo not provide any additional details.\nJust print it as it is."
            }
