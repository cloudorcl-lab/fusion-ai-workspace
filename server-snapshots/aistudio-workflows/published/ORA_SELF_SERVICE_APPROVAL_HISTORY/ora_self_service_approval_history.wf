          "type": "LLM"
        },
        {
          "metadata": {
            "name": "parse future approver",
            "returnType": "string",
            "sourceCode": "var appHistResponse = $context.$nodes.GET_APPROVAL_HISTORY_RELATED_DATA.$output;\nvar approverList = \"\";\nvar counter = 0;\nfor(var i=0;i<appHistResponse['result'].length;i++){\nif(appHistResponse['result'][i]['IsFutureParticipantFlag']  == \"true\" || appHistResponse['result'][i]['IsFutureParticipantFlag']){\napproverList += appHistResponse['result'][i]['ActionDescription'] + \" \"+ \"\\n\";\ncounter++;\n}\n}\nif(counter == 0){\napproverList = \"No information available for Future Approver\";\n}\nreturn approverList;"
          },
          "outcomes": {
            "success": "1764173490541"
          },
          "code": "PARSE_FUTURE_APPROVER",
          "id": "1764173347204",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
