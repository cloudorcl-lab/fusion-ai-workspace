            "sourceCode": "var cache = $context.$variables.fetchCache ? $context.$variables.fetchCache : new Object();\nvar fetchedComponents = [];\nvar fetchedMeasures = [];\nvar fetchedRateTables = [];\nvar fetchedExpressions = [];\nvar i = 0;\n\nvar componentOrder = cache.componentOrder ? cache.componentOrder : [];\nfor (i = 0; i < componentOrder.length; i += 1) {\n  var component = cache.componentsById && cache.componentsById[String(componentOrder[i])] ? cache.componentsById[String(componentOrder[i])] : null;\n  if (component) fetchedComponents.push(component);\n}\n\nvar measureOrder = cache.measureOrder ? cache.measureOrder : [];\nfor (i = 0; i < measureOrder.length; i += 1) {\n  var measure = cache.measuresById && cache.measuresById[String(measureOrder[i])] ? cache.measuresById[String(measureOrder[i])] : null;\n  if (measure) fetchedMeasures.push(measure);\n}\n\nvar rateTableOrder = cache.rateTableOrder ? cache.rateTableOrder : [];\nfor (i = 0; i < rateTableOrder.length; i += 1) {\n  var rateTable = cache.rateTablesById && cache.rateTablesById[String(rateTableOrder[i])] ? cache.rateTablesById[String(rateTableOrder[i])] : null;\n  if (rateTable) fetchedRateTables.push(rateTable);\n}\n\nvar expressionOrder = cache.expressionOrder ? cache.expressionOrder : [];\nfor (i = 0; i < expressionOrder.length; i += 1) {\n  var expression = cache.expressionsByKey && cache.expressionsByKey[String(expressionOrder[i])] ? cache.expressionsByKey[String(expressionOrder[i])] : null;\n  if (expression) fetchedExpressions.push(expression);\n}\n\nvar result = new Object();\nresult.success = cache.plan !== null && cache.plan !== undefined;\nresult.compensationPlanId = $context.$variables.compensationPlanId;\nresult.orgId = $context.$variables.orgId;\nresult.plan = cache.plan ? cache.plan : null;\nresult.planComponents = cache.planComponents ? cache.planComponents : [];\nresult.fetchedComponents = fetchedComponents;\nresult.fetchedMeasures = fetchedMeasures;\nresult.fetchedRateTables = fetchedRateTables;\nresult.fetchedExpressions = fetchedExpressions;\nresult.summary = {\n  fetchedComponentCount: fetchedComponents.length,\n  fetchedMeasureCount: fetchedMeasures.length,\n  fetchedRateTableCount: fetchedRateTables.length,\n  fetchedExpressionCount: fetchedExpressions.length,\n  processedActionCount: Number($context.$variables.currentFetchIndex || 0),\n  totalActionCount: $context.$variables.fetchActions && $context.$variables.fetchActions.length ? Number($context.$variables.fetchActions.length) : 0\n};\nreturn result;"
