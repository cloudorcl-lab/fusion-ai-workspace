        {
          "id": "4",
          "code": "INIT_FETCH_STATE",
          "type": "CODE",
          "metadata": {
            "name": "Init Fetch State",
            "returnType": "object",
            "sourceCode": "var parseMaybeJson = function(value) {\n  if (value === null || value === undefined) return null;\n  if (typeof value !== 'string') return value;\n  try { return JSON.parse(value); } catch (_err) { return null; }\n};\n\nvar extractBoObject = function(raw) {\n  var obj = parseMaybeJson(raw);\n  if (!obj || typeof obj !== 'object') return null;\n  if (obj.output && obj.output.response) return parseMaybeJson(obj.output.response);\n  return obj;\n};\n\nvar extractBoItems = function(raw) {\n  var obj = parseMaybeJson(raw);\n  if (!obj || typeof obj !== 'object') return [];\n  if (obj.items && obj.items.length !== undefined) return obj.items;\n  if (obj.result && obj.result.items && obj.result.items.length !== undefined) return obj.result.items;\n  return [];\n};\n\nvar makeActionKey = function(action) {\n  if (!action || !action.type) return null;\n  if (action.type === 'component') return 'component:' + String(action.componentId);\n  return null;\n};\n\nvar enqueue = function(actions, seen, action) {\n  var key = makeActionKey(action);\n  if (!key || seen[key]) return;\n  seen[key] = true;\n  actions.push(action);\n};\n\nvar plan = extractBoObject($context.$nodes.GET_PLAN ? $context.$nodes.GET_PLAN.$output : null);\nvar planComponents = extractBoItems($context.$nodes.GET_PLAN_COMPONENTS ? $context.$nodes.GET_PLAN_COMPONENTS.$output : null);\nvar actions = [];\nvar seen = new Object();\nvar componentsById = new Object();\nvar componentOrder = [];\nvar i = 0;\n\nfor (i = 0; i < planComponents.length; i += 1) {\n  var association = planComponents[i] ? planComponents[i] : new Object();\n  var componentId = association.PlanComponentId !== undefined && association.PlanComponentId !== null\n    ? Number(association.PlanComponentId)\n    : null;\n  if (componentId === null || isNaN(componentId)) continue;\n  if (!componentsById[String(componentId)]) {\n    componentsById[String(componentId)] = {\n      componentId: componentId,\n      planComponentAssociation: association,\n      component: null,\n      measures: [],\n      formulas: [],\n      formulaRateTables: [],\n      formulaRateDimInputs: [],\n      canonicalUrl: null\n    };\n    componentOrder.push(componentId);\n  }\n  enqueue(actions, seen, { type: 'component', componentId: componentId });\n}\n\nvar result = new Object();\nresult.fetchActions = actions;\nresult.fetchCache = {\n  plan: plan,\n  planComponents: planComponents,\n  componentsById: componentsById,\n  componentOrder: componentOrder,\n  measuresById: new Object(),\n  measureOrder: [],\n  rateTablesById: new Object(),\n  rateTableOrder: [],\n  expressionsByKey: new Object(),\n  expressionOrder: [],\n  seenActionKeys: seen\n};\nreturn result;"
          },
          "outcomes": {
            "success": "5"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6100
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
