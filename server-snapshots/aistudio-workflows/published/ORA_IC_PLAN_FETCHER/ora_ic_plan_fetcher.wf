 : null;\n    var canonicalUrl = entry && entry.canonicalUrl ? String(entry.canonicalUrl) : '';\n    var incentiveFormulaUrl = formulaId !== null && canonicalUrl ? (canonicalUrl + '/child/planComponentIncentiveFormulas/' + String(formulaId)) : null;\n    if (formulaId !== null && !isNaN(formulaId) && incentiveFormulaUrl) {\n      enqueue(actions, seen, { type: 'formulaRateTables', componentId: Number(action.componentId), formulaId: formulaId, incentiveFormulaUrl: incentiveFormulaUrl });\n      enqueue(actions, seen, { type: 'formulaRateDimInputs', componentId: Number(action.componentId), formulaId: formulaId, incentiveFormulaUrl: incentiveFormulaUrl });\n      enqueueExpressionRef(actions, seen, $context.$variables.orgId, items[i].IncentiveFormulaExpressionId, items[i].IncentiveFormulaExpressionName);\n    }\n  }\n}\n\nif (action.type === 'formulaRateTables') {\n  entry = cache.componentsById[String(action.componentId)] ? cache.componentsById[String(action.componentId)] : null;\n  if (entry) upsertFormulaChildren(entry.formulaRateTables, action.formulaId, 'rateTables', items);\n  for (i = 0; i < items.length; i += 1) {\n    var formulaRateTableId = items[i] && items[i].RateTableId !== undefined ? Number(items[i].RateTableId) : null;\n    if (formulaRateTableId !== null && !isNaN(formulaRateTableId)) {\n      enqueue(actions, seen, { type: 'rateTable', rateTableId: formulaRateTableId });\n    }\n  }\n}\n\nif (action.type === 'formulaRateDimInputs') {\n  entry = cache.componentsById[String(action.componentId)] ? cache.componentsById[String(action.componentId)] : null;\n  if (entry) upsertFormulaChildren(entry.formulaRateDimInputs, action.formulaId, 'inputs', items);\n  for (i = 0; i < items.length; i += 1) {\n    enqueueExpressionRef(actions, seen, action.orgId || $context.$variables.orgId, items[i] ? items[i].InputExpressionId : null, items[i] ? items[i].InputExpressionName : null);\n  }\n}\n\nif (action.type === 'measure') {\n  key = String(action.measureId);\n  ent