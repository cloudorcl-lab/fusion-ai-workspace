                    "componentFormulas": "GET_COMPONENT_FORMULAS_ACTION",
                    "formulaRateTables": "GET_FORMULA_RATE_TABLES_ACTION",
                    "formulaRateDimInputs": "GET_FORMULA_RATE_DIM_INPUTS_ACTION",
                    "measure": "GET_MEASURE_ACTION",
