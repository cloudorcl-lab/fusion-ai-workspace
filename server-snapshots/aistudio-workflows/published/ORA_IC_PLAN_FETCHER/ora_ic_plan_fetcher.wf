        {
          "id": "6",
          "code": "WHILE_HAS_FETCH_ACTIONS",
          "type": "WHILE",
          "metadata": {
            "name": "While Has Fetch Actions",
            "dataPipeline": {
              "rootNode": "start_WHILE_FETCH_ACTIONS",
              "pipelineNodes": [
                {
                  "type": "START",
                  "code": "START_WHILE_FETCH_ACTIONS",
                  "id": "start_WHILE_FETCH_ACTIONS",
                  "metadata": {
                    "name": "Start"
                  },
                  "outcomes": {
                    "success": "PREPARE_FETCH_ACTION"
                  },
                  "inputs": []
                },
                {
                  "type": "END",
                  "code": "END_WHILE_FETCH_ACTIONS",
                  "id": "end_WHILE_FETCH_ACTIONS",
                  "metadata": {
                    "name": "End"
                  },
                  "outcomes": {},
                  "inputs": []
                },
                {
                  "type": "CODE",
                  "code": "PREPARE_FETCH_ACTION",
                  "id": "PREPARE_FETCH_ACTION",
                  "metadata": {
                    "name": "Prepare Fetch Action",
                    "returnType": "object",
                    "position": {
                      "x": 100,
                      "y": 200
                    },
                    "sourceCode": "var actions = $context.$variables.fetchActions ? $context.$variables.fetchActions : [];\nvar idx = Number($context.$variables.currentFetchIndex || 0);\nvar action = idx >= 0 && idx < actions.length ? actions[idx] : null;\nvar result = new Object();\nvar cloneAction = function(value) {\n  var out = new Object();\n  var source = value ? value : new Object();\n  var key;\n  for (key in source) {\n    if (Object.prototype.hasOwnProperty.call(source, key)) {\n      out[key] = source[key];\n    }\n  }\n  return out;\n};\n\nvar pathTailAfterResource = function(value, resourceName) {\n  if (value === null || value === undefined) {\n    return null;\n  }\n  var text = String(value).trim();\n  if (!text) {\n    return null;\n  }\n  var resource = String(resourceName || '').replace(/^\\/|\\/$/g, '');\n  var escapedResource = resource.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  var match = text.match(new RegExp('/fscmRestApi/resources/[^/]+/' + escapedResource + '/([^?]+)'));\n  if (match && match[1]) {\n    return match[1];\n  }\n\n  var marker = '/' + resource + '/';\n  var idx = text.indexOf(marker);\n  if (idx === 0) {\n    var tail = text.substring(marker.length);\n    var queryIdx = tail.indexOf('?');\n    if (queryIdx >= 0) {\n      tail = tail.substring(0, queryIdx);\n    }\n    return tail ? tail : null;\n  }\n  if (text.indexOf('/fscmRestApi/') >= 0 || /^https?:\\/\\//i.test(text) || text.charAt(0) === '/') {\n    return null;\n  }\n  return text;\n};\n\nvar componentPathTail = function(value) {\n  return pathTailAfterResource(value, 'planComponents');\n};\n\nresult.action = action ? cloneAction(action) : action;\nresult.actionType = action && action.type ? String(action.type) : 'default';\nresult.componentQuery = null;\nresult.expressionQuery = null;\nif (result.action && result.action.canonicalUrl) {\n  result.action.canonicalUrl = componentPathTail(result.action.canonicalUrl);\n}\nif (result.action && result.action.incentiveFormulaUrl) {\n  result.action.incentiveFormulaUrl = componentPathTail(result.action.incentiveFormulaUrl);\n}\nif (result.actionType === 'component' && action && action.componentId !== undefined && action.componentId !== null) {\n  result.componentQuery = 'PlanComponentId=' + String(Number(action.componentId)) + ' and OrgId=' + String($context.$variables.orgId);\n}\nif (result.actionType === 'expressionById' && action && action.expressionId !== undefined && action.expressionId !== null && action.orgId !== undefined && action.orgId !== null) {\n  result.expressionQuery = 'ExpressionId=' + String(Number(action.expressionId)) + ' and OrgId=' + String(action.orgId);\n}\nif (result.actionType === 'expressionByName' && action && action.expressionName && action.orgId !== undefined && action.orgId !== null) {\n  result.expressionQuery = \"Name='\" + String(action.expressionName).replace(/'/g, \"''\") + \"' and OrgId=\" + String(action.orgId);\n}\nreturn result;"
                  },
                  "outcomes": {
                    "success": "FETCH_ACTION_SWITCH"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
