                    "sourceCode": "var parseMaybeJson = function(value) {\n  if (value === null || value === undefined) return null;\n  if (typeof value !== 'string') return value;\n  try { return JSON.parse(value); } catch (_err) { return null; }\n};\n\nvar clone = function(value) {\n  var parsed = parseMaybeJson(JSON.stringify(value));\n  return parsed === null ? new Object() : parsed;\n};\n\nvar extractBoObject = function(raw) {\n  var obj = parseMaybeJson(raw);\n  if (!obj || typeof obj !== 'object') return null;\n  if (obj.output && obj.output.response) return parseMaybeJson(obj.output.response);\n  return obj;\n};\n\nvar extractBoItems = function(raw) {\n  var obj = parseMaybeJson(raw);\n  if (!obj || typeof obj !== 'object') return [];\n  if (obj.items && obj.items.length !== undefined) return obj.items;\n  if (obj.result && obj.result.items && obj.result.items.length !== undefined) return obj.result.items;\n  return [];\n};\n\nvar normalizeRestPath = function(url) {\n  if (url === null || url === undefined) return null;\n  var text = String(url);\n  var marker = '/fscmRestApi/';\n  var idx = text.indexOf(marker);\n  if (idx >= 0) return text.substring(idx);\n  return text;\n};\n\nvar getCanonicalUrl = function(obj) {\n  if (!obj || !obj['@context'] || !obj['@context'].links) return null;\n  var i = 0;\n  for (i = 0; i < obj['@context'].links.length; i += 1) {\n    var link = obj['@context'].links[i] ? obj['@context'].links[i] : new Object();\n    if (link.rel === 'canonical' && link.href) return normalizeRestPath(link.href);\n  }\n  return null;\n};\n\nvar getContextKey = function(obj) {\n  if (!obj || !obj['@context'] || obj['@context'].key === undefined || obj['@context'].key === null) return null;\n  return String(obj['@context'].key);\n};\n\nvar makeActionKey = function(action) {\n  if (!action || !action.type) return null;\n  if (action.type === 'component') return 'component:' + String(action.componentId);\n  if (action.type === 'componentMeasures') return 'componentMeasures:' + String(action.componentId);\n  if (action.type === 'componentFormulas') return 'componentFormulas:' + String(action.componentId);\n  if (action.type === 'formulaRateTables') return 'formulaRateTables:' + String(action.componentId) + ':' + String(action.formulaId);\n  if (action.type === 'formulaRateDimInputs') return 'formulaRateDimInputs:' + String(action.componentId) + ':' + String(action.formulaId);\n  if (action.type === 'measure') return 'measure:' + String(action.measureId);\n  if (action.type === 'measureGoals') return 'measureGoals:' + String(action.measureId);\n  if (action.type === 'measureRateDimInputs') return 'measureRateDimInputs:' + String(action.measureId);\n  if (action.type === 'rateTable') return 'rateTable:' + String(action.rateTableId);\n  if (action.type === 'rateTableDimensions') return 'rateTableDimensions:' + String(action.rateTableId);\n  if (action.type === 'rateTableRates') return 'rateTableRates:' + String(action.rateTableId);\n  if (action.type === 'dimensionTiers') return 'dimensionTiers:' + String(action.rateTableId) + ':' + String(action.rateTableDimId || action.rateDimensionId);\n  if (action.type === 'expressionById') return 'expressionById:' + String(action.expressionKey || action.expressionId);\n  if (action.type === 'expressionByName') return 'expressionByName:' + String(action.orgId) + ':' + String(action.expressionName || '');\n  if (action.type === 'expressionDetails') return 'expressionDetails:' + String(action.expressionId);\n  return null;\n};\n\nvar enqueue = function(actions, seen, action) {\n  var key = makeActionKey(action);\n  if (!key || seen[key]) return;\n  seen[key] = true;\n  actions.push(action);\n};\n\nvar enqueueExpressionRef = function(actions, seen, orgId, expressionId, expressionName) {\n  if (expressionName !== null && expressionName !== undefined && String(expressionName).trim().length > 0 && orgId !== null && orgId !== undefined) {\n    enqueue(actions, seen, {\n      type: 'e