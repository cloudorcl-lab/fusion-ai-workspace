            "InvokeAction": "1765490151230",
            "initDisplay": "1765229900132"
          },
          "code": "SWITCH_FOR_ORAMESSAGEHINT",
          "convergenceTargetId": "end",
          "id": "1765224461108",
          "inputs": [
            {
              "id": "1765224461111_1",
