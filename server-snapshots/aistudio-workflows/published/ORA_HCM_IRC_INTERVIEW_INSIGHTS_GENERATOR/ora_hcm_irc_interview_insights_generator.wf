                    "name": "Parse_Question_Answers",
                    "returnType": "object",
                    "sourceCode": "let questionAnswers = $context.$nodes.PROCESS_TRANSCRIPTS_LOOP.RETRIEVE_FEEDBACK_QUESTIONS_OF_AN_INTERVIEW.$output;\nlet dummyResponse = { \"result\" : []};\nif (questionAnswers != null || questionAnswers != undefined) {\n   questionAnswers  = JSON.parse(JSON.stringify(questionAnswers ));\n}\nreturn questionAnswers != null ? questionAnswers : dummyResponse;"
                  },
                  "outcomes": {
