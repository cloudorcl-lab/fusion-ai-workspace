                  "inputs": [
                    {
                      "id": "1772013464447_1",
                      "name": "prompt",
                      "type": "string",
                      "value": "You are an interview assistant. Write an objective, concise summary (no more than 150 words) for other interviewers, using only the information in the transcript provided under context.\n\nContext:\nUse the following transcript: {{$context.$nodes.INTERVIEW_INSIGHTS_LOOP.INTERVIEW_TRANSCRIPT_DATA.$output}}\n\nInstructions:\n\nUse only factual information explicitly present in the transcript; do not guess, interpret, or add details.\nDo not offer opinions, judgments, or evaluations.\nKeep the summary strictly neutral and job-relevant.\nReference specific examples or brief quotes as appropriate but do not infer strengths, concerns, or gaps.\nIf important information is missing or not discussed, state ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œNot enough evidence in transcript.ÃƒÂ¢Ã¢â€šÂ¬Ã¯Â¿Â½\nSummarize the topics covered, relevant skills and experiences discussed, and any factual examples provided."
                    }
                  ],
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Parse Interview Summary",
                    "returnType": "string",
                    "sourceCode": "let llmOutput = $context.$nodes.INTERVIEW_INSIGHTS_LOOP.GENERATE_INTERVIEW_INSIGHTS.$output;\nlet parsedResponse = llmOutput.replace(/\\\\n/g,\"\");\nparsedResponse = parsedResponse.replace(/\\\\/g,\"\");\n\nreturn parsedResponse;"
                  },
                  "outcomes": {
                    "success": "1772014198548"
                  },
                  "code": "PARSE_INTERVIEW_SUMMARY",
                  "id": "1772013562446",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
