        {
          "metadata": {
            "name": "Transform Output",
            "returnType": "object",
            "sourceCode": "const targetKeys = [\n    \"companyBackground\",\n    \"executiveSummary\",\n    \"implementationPlan\",\n    \"resourcePlan\"\n  ];\n\n  const output = {};\n\n  $context.$nodes.PRJ_PJF_LOOP_AI_SECTION_LLM_RES_GENERATOR.$output.forEach(item => {\n    let parsedObj;\n    if (typeof item === \"string\") {\n      try {\n        parsedObj = JSON.parse(item);\n      } catch (e) {\n        // skip invalid JSON strings\n        return;\n      }\n    } else {\n      parsedObj = item;\n    }\n    const result = parsedObj.result;\n    if (result && typeof result === \"object\") {\n      targetKeys.forEach(key => {\n        if (result.hasOwnProperty(key) && result[key] !== undefined) {\n          output[key] = result[key];\n        }\n      });\n    }\n  });\n\n  return output;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "PRJ_PJF_CODE_TRANSFORM_OUTPUT",
          "id": "1770216259557",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
