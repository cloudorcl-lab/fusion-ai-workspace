  "name": "Worker Concierge Workflow DSHRZ",
  "description": "Acts as the single point of entry for workers seeking assistance with various aspects of their employment, including compensation, benefits, leave and absences, and payroll.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
