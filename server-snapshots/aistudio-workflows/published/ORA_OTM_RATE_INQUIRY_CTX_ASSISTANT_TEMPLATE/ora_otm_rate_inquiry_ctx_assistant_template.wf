          "outcomes": {
            "success": "1768497627343"
          },
          "code": "OUTPUT_ITEMGID_FROM_BO",
          "id": "1768494938299",
          "inputs": [
            {
              "id": "1768494938300_1",
              "name": "prompt",
              "type": "string",
              "value": "You are given a JSON object as input. Extract count and itemGid.\n\nReturn ONLY this JSON object:\n{\n  \"count\": <number>,\n  \"itemGid\": \"<string>\" | \"MISSING\",\n  \"needsReview\": <true|false>\n}\n\nRules:\n- Copy count from the input.\n- Build itemGid from the \"items\" array.\n- For each item in \"items\":\n  - If domainName is \"PUBLIC\", use only itemXid\n  - Otherwise use <domainName>.<itemXid>\n- If there is exactly one item, itemGid is that single value.\n- If there are multiple items, join the values with commas in the same order as items.\n- If count is 0, set itemGid to \"MISSING\".\n- Set needsReview to true if count is not exactly 1. Otherwise set needsReview to false.\n\nOutput only valid JSON. Do not include markdown, explanations, or extra text.\n\nJSON object input:\n{{$context.$nodes.GET_ITEM_BY_ITEM_NAME.$output}}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"count\": {\n            \"type\": \"number\"\n        },\n        \"needsReview\": {\n            \"type\": \"boolean\"\n        },\n        \"itemGid\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
