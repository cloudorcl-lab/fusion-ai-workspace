        {
          "metadata": {
            "name": "Handle Error for Item",
            "returnType": "string",
            "sourceCode": "function formatResponse(response) {\n  // Safely parse the response if it's a JSON string\n  try {\n    response = typeof response === 'string' ? JSON.parse(response) : response;\n  } catch (e) {\n    return response;\n  }\n\n  // Initialize an empty result string\n  let result = \"\";\n\n  // Check if 'o:errorDetails' exists and is an array\n  if (response[\"o:errorDetails\"] && Array.isArray(response[\"o:errorDetails\"])) {\n    // Look for o:errorPath in the details, if present\n    let errorPathFound = false;\n    response[\"o:errorDetails\"].forEach(detail => {\n      // Check if o:errorPath exists directly in the detail object\n      if (detail[\"o:errorPath\"]) {\n        result += `${detail[\"o:errorPath\"]}\\n`;  // Show o:errorPath if it exists\n        errorPathFound = true;  // Mark that we found an errorPath\n      }\n    });\n\n    // If no o:errorPath was found, fallback to showing the 'detail'\n    if (!errorPathFound) {\n      result += `${response.detail}\\n`;\n    }\n  } else {\n    // If no o:errorDetails exists, just show the 'detail'\n    result += `${response.detail}\\n`;\n  }\n\n  return result;\n}\n\nif ($context.$nodes.GET_ITEM_BY_ITEM_NAME.$error){\n  return formatResponse($context.$nodes.GET_ITEM_BY_ITEM_NAME.$error.$info)\n}\nelse \n  return \"No item found.\""
          },
          "outcomes": {
            "success": "1776462663566"
          },
          "code": "HANDLE_ERROR_FOR_ITEM",
          "id": "1776462731120",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
