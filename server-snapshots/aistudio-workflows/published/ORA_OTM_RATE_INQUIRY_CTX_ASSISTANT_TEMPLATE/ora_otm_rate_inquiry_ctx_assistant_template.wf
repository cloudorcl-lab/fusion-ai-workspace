            "sourceCode": "const itemName = $context.$variables.itemName \nconst queryString = \n  `(itemName co \"${itemName}\") or (itemXid co \"${itemName}\") or (itemGid co \"${itemName}\")&fields=itemXid,domainName&onlyData=true`;\nreturn queryString"
