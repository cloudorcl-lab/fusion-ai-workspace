        {
          "metadata": {
            "name": "OTM RIQ Extraction"
          },
          "outcomes": {
            "success": "1770065664919"
          },
          "code": "OTM_RIQ_EXTRACTION",
          "convergenceTargetId": "1777037781641",
          "id": "1769718078484",
          "inputs": [
            {
              "id": "1769718078486_1",
              "name": "prompt",
              "type": "string",
              "value": "Extract the following information from the following user query: {{$context.$system.$inputMessage}}, and return ONLY a JSON object with these fields: \nshipUnitCount: the number of ship units.\nitemName: the item name (convert to uppercase).\nsourceLocationName: the origin location name (convert to uppercase).\ndestLocationName: the destination location name (convert to uppercase).\nrequestType: the type of rate inquiry\n  - Use \"AllOptions\" if the user does not mention a preference or requests to see all options.\n  - Use \"LowestCost\" if the user wants the lowest cost or cheapest option.\n  - Use \"FastestTransit\" if the user wants the fastest or quickest way.\nperspective: the buy or sell perspective of the rate\n  - Use \"B\" if the user does not mention a preference or requests to see buy rate.\n  - Use \"S\" if the user wants to see sell rate.\nweight: the weight per ship unit. If not provided, use 0.\nweightUnit: the unit of weight (convert to uppercase). Try to identify the unit from the user's wording; if unspecified, use \"LB\". Possible units: LB, KG, KIP, TON, MTON, CAR, HK, KG P.\nvolume: the volume per ship unit. If not provided, use 0.\nvolumeUnit: the unit of volume (convert to uppercase). Try to identify the unit from the user's wording; if unspecified, use \"CUFT\". Possible units: CUFT, CUIN, CUYD, CUMTR, GALCAN, GALUS, L, DMQ, BBL, BBLLARGE, PROOF GA, PERCENT ALCOHOL, PROOF L, L PURE ALCOHOL, CMQ, ML.\n\n**Guidelines:\n- Use context to identify possible synonyms for units (e.g., “cubic meters” means CUMTR, “kilos” means KG).\n- If any value other than weight or volume is missing or unclear, return it as null.\n- Format your response as a valid JSON object\n\n**Example input:\n{\"message\" : \"I want to ship 50 laptop from Toronto to Miami. The ship unit weight is 2 kilos and 1 cubic meters. Please give me the cheapest & sell rate.\"}\n\n**Example output:\n{\n  \"shipUnitCount\": 50,\n  \"itemName\": \"LAPTOP\",\n  \"sourceLocationName\": \"TORONTO\",\n  \"destLocationName\": \"MIAMI\",\n  \"requestType\": \"LowestCost\",\n  \"perspective\": \"S\",\n  \"weight\": 2,\n  \"weightUnit\": \"KG\",\n  \"volume\": 1,\n  \"volumeUnit\": \"CUMTR\"\n}"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"volumeUnit\": {\n            \"type\": \"string\"\n        },\n        \"volume\": {\n            \"type\": \"number\"\n        },\n        \"weightUnit\": {\n            \"type\": \"string\"\n        },\n        \"weight\": {\n            \"type\": \"number\"\n        },\n        \"itemName\": {\n            \"type\": \"string\"\n        },\n        \"shipUnitCount\": {\n            \"type\": \"number\"\n        },\n        \"destLocationName\": {\n            \"type\": \"string\"\n        },\n        \"sourceLocationName\": {\n            \"type\": \"string\"\n        },\n        \"perspective\": {\n            \"type\": \"string\"\n        },\n        \"requestType\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
