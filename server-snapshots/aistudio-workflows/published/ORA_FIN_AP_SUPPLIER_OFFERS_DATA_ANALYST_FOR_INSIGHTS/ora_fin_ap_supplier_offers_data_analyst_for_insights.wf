{
  "workflowId": "100002355226954",
  "workflowCode": "ORA_FIN_AP_SUPPLIER_OFFERS_DATA_ANALYST_FOR_INSIGHTS",
  "name": "Supplier Offers Data Analyst for Insights",
  "description": "Extracts the latest supplier offers related data associated with insights. The analyst supports payment specialists by analyzing current status and execution details based on defined monitoring prompts. Used to supply accurate, up to date data for insight review and follow on actions.",
  "specification": {
    "dataPipeline": {
