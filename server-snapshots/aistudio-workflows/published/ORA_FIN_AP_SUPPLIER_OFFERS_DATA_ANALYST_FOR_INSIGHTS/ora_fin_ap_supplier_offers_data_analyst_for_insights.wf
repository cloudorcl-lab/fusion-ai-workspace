        {
          "metadata": {
            "name": "Pre Process Extraction Data for Offers",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_OFFERS.$output;\n\nconst output = Array.isArray(input)\n  ? input.map(item => {\n      // Create a shallow copy of the item\n      const newItem = {};\n      Object.keys(item).forEach(key => {\n        newItem[key] = item[key] === null ? \"\" : item[key];\n      });\n      return newItem;\n    })\n  : [];\n\nreturn output;"
          },
          "outcomes": {
            "success": "1780031333593"
          },
          "code": "FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_OFFERS",
          "convergenceTargetId": "1776969603942",
          "id": "1765978489189",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check for valid insight"
          },
          "outcomes": {
            "true": "1776970196995",
            "false": "add_false_1780031333593"
          },
          "code": "FIN_AP_CONDITION_CHECK_FOR_VALID_INSIGHT",
          "convergenceTargetId": "end",
          "id": "1780031333593",
          "inputs": [
            {
              "id": "1780031333595_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.insightContext.insightsName == \"Supplier offers requiring action\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Process Summary Data for Offers Requiring Action",
            "returnType": "object",
            "sourceCode": "const grouped = {};\nlet data  = $context.$nodes.EXTRACT_SUMMARY_BQL_RESPONSE.$output || [];\nfor (const item of data) {\n  const condition = item[\"Business Condition\"];\n  const programType = item[\"Program Type\"];\n  const currency = item[\"Invoice Currency\"];\n\n  const conditionKey = `${condition}__${programType}`;\n\n  if (!grouped[conditionKey]) {\n    grouped[conditionKey] = {\n      businessCondition: condition,\n      programType: programType,\n      totalSupplierCount: 0,\n      totalOfferCount: 0,\n      totalInvoiceCount: 0,\n      currencies: {}\n    };\n  }\n\n  grouped[conditionKey].totalSupplierCount += item[\"Supplier Count\"];\n  grouped[conditionKey].totalOfferCount += item[\"Offer Count\"];\n  grouped[conditionKey].totalInvoiceCount += item[\"Invoice Count\"];\n\n  if (!grouped[conditionKey].currencies[currency]) {\n    grouped[conditionKey].currencies[currency] = {\n      currency,\n      supplierCount: 0,\n      offerCount: 0,\n      invoiceCount: 0,\n      totalOutstandingBalance: 0\n    };\n  }\n\n  grouped[conditionKey].currencies[currency].supplierCount += item[\"Supplier Count\"];\n  grouped[conditionKey].currencies[currency].offerCount += item[\"Offer Count\"];\n  grouped[conditionKey].currencies[currency].invoiceCount += item[\"Invoice Count\"];\n  grouped[conditionKey].currencies[currency].totalOutstandingBalance += item[\"Total Outstanding Balance\"];\n}\n\nconst result = Object.values(grouped).map(obs => ({\n  ...obs,\n  currencies: Object.values(obs.currencies).sort(\n    (a, b) => b.totalOutstandingBalance - a.totalOutstandingBalance\n  )\n}));\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776970384848"
          },
          "code": "FIN_AP_CODE_PROCESS_SUMMARY_DATA_FOR_OFFERS_REQUIRING_ACTION",
          "convergenceTargetId": "1780031424393",
          "id": "1776970196995",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check token size",
            "returnType": "number",
            "sourceCode": "let data = $context.$nodes.FIN_AP_CODE_PROCESS_SUMMARY_DATA_FOR_OFFERS_REQUIRING_ACTION.$output.result \nconst str = typeof data === \"string\" ? data : JSON.stringify(data);\n\n// optional: normalize whitespace (slightly better estimate)\nconst cleaned = str.replace(/\\s+/g, \" \");\n\n// rough estimate: 1 token ≈ 4 characters\nconst tokenCount = Math.ceil(cleaned.length / 4);\nreturn tokenCount;"
          },
          "outcomes": {
            "success": "1776970471473"
          },
          "code": "FIN_AP_CODE_CHECK_TOKEN_SIZE",
          "convergenceTargetId": "1780031424393",
          "id": "1776970384848",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check if token limit exceeded"
          },
          "outcomes": {
            "true": "1776971013573",
            "false": "1776970610699"
          },
          "code": "FIN_AP_CONDITION_CHECK_IF_TOKEN_LIMIT_EXCEEDED",
          "convergenceTargetId": "1780031489849",
          "id": "1776970471473",
          "inputs": [
            {
              "id": "1776970471474_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_AP_CODE_CHECK_TOKEN_SIZE.$output.result > 25000}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "name": "Set Default Summary Requiring Action"
          },
          "outcomes": {
            "success": "1766035908676"
          },
          "code": "FIN_AP_VARIABLES_SET_DEFAULT_SUMMARY_REQUIRING_ACTION",
          "id": "1776971013573",
          "inputs": [
            {
              "id": "1776971040605",
              "name": "summaryRequiringAction",
              "scope": "JOB",
              "type": "string",
              "value": "Here are the supplier offers that are requiring action"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Process Offers Requiring Action",
            "returnType": "array",
            "sourceCode": "const data = $context.$nodes.FIN_AP_CODE_PRE_PROCESS_EXTRACTION_DATA_OFFERS.$output.result || [];\nconst summaryText =($context.$variables.summaryRequiringAction ?? \"\").toString().trim() || \"Here are the details:\";\nconst allObservations = [\n  \"New shortlisted offers ready for supplier communication\",\n  \"Supplier offers pending communication for more than 7 days\",\n  \"Supplier offers that will expire in next 5 days\",\n  \"Invoices in supplier offers not ready for payment\"\n].filter(obs => data.some(row => row.Observations === obs));\n\nconst observationColumnMap = {\n  \"New shortlisted offers ready for supplier communication\": [\n    \"Supplier\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"Program Type\",\n    \"Email Address\",\n    \"Offer Status\"\n  ],\n  \"Supplier offers pending communication for more than 7 days\": [\n    \"Supplier\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"Program Type\",\n    \"Email Address\",\n    \"Offer Status\"\n  ],\n  \"Supplier offers that will expire in next 5 days\": [\n    \"Supplier\",\n    \"Installment Count\",\n    \"Outstanding Balance\",\n    \"Program Type\",\n    \"Email Address\",\n    \"Offer Status\"\n  ],\n  \"Invoices in supplier offers not ready for payment\": [\n    \"Invoice Number\",\n    \"Installment Number\",\n    \"Outstanding Balance\",\n    \"Supplier\",\n    \"Supplier Site\",\n    \"Invoice Validation Status\",\n    \"Invoice Approval Status\",\n    \"Program Type\"\n  ]\n};\n\nconst formatValue = (val) => {\n  if (val === null || val === undefined || val === \"\") return \"\";\n  return val;\n};\n\nconst shouldShowLimitMessage = allObservations.some(\n  obs => data.filter(row => row.Observations === obs).length >= 5\n);\n\nlet sequence = 1;\nconst summarizeData = [];\n\nsummarizeData.push({\n  type: 'text',\n  content: [summaryText],\n  sequence: sequence++\n});\n\nif (shouldShowLimitMessage) {\n  summarizeData.push({\n    type: 'text',\n    content: [\"Showing up to 5 items below to keep this view focused.\"],\n    sequence: sequence++\n  });\n}\n\n// Tables\nallObservations.forEach((obs) => {\n  const columns = observationColumnMap[obs];\n  if (!columns) return;\n\n  const rowsForObs = data.filter(row => row.Observations === obs);\n\n  const formattedRows = rowsForObs.map(row => {\n    const entry = {};\n    columns.forEach(col => {\n      entry[col] = formatValue(row[col]);\n    });\n    return entry;\n  });\n\n  summarizeData.push({\n    type: \"table\",\n    heading: obs,\n    content: formattedRows,\n    sequence: sequence++,\n    columnOrder: columns\n  });\n});\n\nsummarizeData.push({\n  type: \"actions\",\n  content: [\n    \"Accept and send pending offers to suppliers.\" ,\n    \"Discard uncommunicated offers that are no longer relevant.\" ,\n    \"Follow up offline with suppliers on already communicated offers.\"\n  ],\n  sequence: sequence++\n});\n\nlet finalResult;\n\nif ( $context.$nodes.FIN_AP_BO_FUNCTION_EXTRACT_BQL_FOR_OFFERS.$status == 'failure')\nreturn null;\nelse if (!Array.isArray(data) || data.length === 0) {\n  finalResult = {\n    useSummarizationPrompt: true,\n    summarizeData: [\n      {\n        type: \"text\",\n        content: [\n          \"This insight has been resolved. There’s nothing to review at the moment.\",\n        ],\n        sequence: 1,\n      },\n    ],\n  };\n} else {\n  finalResult = {\n    useSummarizationPrompt: true,\n    summarizeData: summarizeData,\n  };\n}\n\nreturn finalResult.summarizeData;"
          },
          "outcomes": {
            "success": "1780031489849"
          },
          "code": "FIN_AP_CODE_PROCESS_OFFERS_REQUIRING_ACTION",
          "convergenceTargetId": "1780031424393",
          "id": "1766035908676",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
