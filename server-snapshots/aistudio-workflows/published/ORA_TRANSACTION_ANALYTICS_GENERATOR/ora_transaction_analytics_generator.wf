            "sourceCode": "var result =  $context.$nodes.GENERATE_AGGREGATE_SQL.$output;\nresult = result.trim();\n\nif (result.startsWith(\"```sql\"))\n    result = result.substring(6).trim();\n\nif (result.endsWith(\"```\"))\n    result = result.substring(0, result.length - 3).trim();\n\nif (result.endsWith(\";\"))\n    result = result.substring(0, result.length - 1).trim();\n\nresult = result.replace(/[\\t\\n\\r\\\\]+/g, \" \").trim();\nvar response = {}\nresponse.data = result;\nresponse.status= \"SUCCESS\";\nresponse.routing = $context.$variables.routingOutcome ;\nreturn JSON.stringify(response);"
          },
          "outcomes": {
            "success": "end"
