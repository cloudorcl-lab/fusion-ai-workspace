                    "sourceCode": "let payload = {};\n\nif ($context.$nodes.LOOPWORKERS.GETWORKERIDS.$output.items?.length > 0) {\n  payload.PersonId = $context.$nodes.LOOPWORKERS.GETWORKERIDS.$output.items[0].PersonId;\n  payload.AssignmentId = $context.$nodes.LOOPWORKERS.GETWORKERIDS.$output.items[0].AssignmentId;\n  payload.DisplayName = $context.$nodes.LOOPWORKERS.GETWORKERIDS.$output.items[0].DisplayName;\n}\n\nreturn payload;"
