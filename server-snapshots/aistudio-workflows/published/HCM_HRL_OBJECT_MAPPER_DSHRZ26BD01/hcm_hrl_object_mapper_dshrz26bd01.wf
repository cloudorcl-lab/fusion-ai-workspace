            "name": "WorkersAttributeIDs",
            "returnType": "object",
            "sourceCode": "let input = $context.$nodes.LOOPWORKERS.$output;\n\n\nconst output = input.map(str => {\n  const parsed = JSON.parse(str);\n  return {\n    PersonId: (parsed.result.PersonId),\n    AssignmentId:(parsed.result.AssignmentId),\n   DisplayName: (parsed.result.DisplayName),\n    PersonNumber: (parsed.result.PersonNumber)\n  };\n});\n\nreturn output;"
          },
