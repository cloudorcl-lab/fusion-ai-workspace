        {
          "metadata": {
            "name": "DocumentTypeAttribute",
            "returnType": "object",
            "sourceCode": "let input = $context.$nodes.LOOPDOCUMENTTYPE.$output ;\n\n\nconst output = input.map(str => {\n  const parsed = JSON.parse(str);\n  return {\n    DocumentTypeId: (parsed.result.DocumentTypeId),\n    DocumentType:(parsed.result.DocumentType)\n  };\n});\n\nreturn output;"
          },
          "outcomes": {
            "success": "end"
