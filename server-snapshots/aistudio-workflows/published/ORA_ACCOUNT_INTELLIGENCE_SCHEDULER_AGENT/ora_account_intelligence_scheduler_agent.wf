        {
          "id": "1778797886915",
          "code": "COMPUTE_ACCOUNT_FILTER",
          "type": "CODE",
          "metadata": {
            "name": "Compute Account Filter",
            "sourceCode": "const mode = String($context.$variables.schedulerMode == null ? '' : $context.$variables.schedulerMode).trim().toUpperCase();\nconst isFullMode = mode === 'FULL';\n\nconst accountFilter = asText($context.$nodes.GET_ACCOUNTS_FILTER_POLICY.$output);\nconst contactFilter = asText($context.$nodes.GET_CONTACTS_FILTER_POLICY.$output);\nconst accountRecencyFilter = normalizeRelativeNowFilters(asText($context.$nodes.GET_ACCOUNT_RECENCY_POLICY.$output));\nconst contactRecencyFilter = normalizeRelativeNowFilters(asText($context.$nodes.GET_CONTACT_RECENCY_POLICY.$output));\n\nconst requiredPolicies = [\n  { name: 'Get Accounts Filter Policy', value: accountFilter, required: true },\n  { name: 'Get Contacts Filter Policy', value: contactFilter, required: true },\n  { name: 'Get Account Recency Policy', value: accountRecencyFilter, required: !isFullMode },\n  { name: 'Get Contact Recency Policy', value: contactRecencyFilter, required: !isFullMode }\n];\n\nfor (const policy of requiredPolicies) {\n  if (policy.required && policy.value === '') {\n    return {\n      valid: false,\n      message: 'The policy ' + policy.name + ' returned blank.',\n      accountFilter: '',\n      contactFilter: ''\n    };\n  }\n}\n\nreturn {\n  valid: true,\n  message: '',\n  accountFilter: isFullMode ? accountFilter : combineFilters(accountFilter, accountRecencyFilter),\n  contactFilter: isFullMode ? contactFilter : combineFilters(contactFilter, contactRecencyFilter)\n};\n\nfunction asText(value) {\n  let current = value;\n\n  for (let index = 0; index < 6; index += 1) {\n    if (current == null) {\n      return '';\n    }\n\n    if (typeof current === 'object') {\n      if (Object.prototype.hasOwnProperty.call(current, 'result')) {\n        current = current.result;\n        continue;\n      }\n      if (Object.prototype.hasOwnProperty.call(current, 'output')) {\n        current = current.output;\n        continue;\n      }\n      if (Object.prototype.hasOwnProperty.call(current, 'value')) {\n        current = current.value;\n        continue;\n      }\n      return String(current).trim();\n    }\n\n    if (typeof current !== 'string') {\n      return String(current).trim();\n    }\n\n    const trimmed = current.trim();\n    if (trimmed === '') {\n      return '';\n    }\n\n    try {\n      const parsed = JSON.parse(trimmed);\n      if (parsed !== trimmed) {\n        current = parsed;\n        continue;\n      }\n    } catch (error) {\n      if (hasMatchingOuterQuotes(trimmed)) {\n        return trimmed.slice(1, -1).trim();\n      }\n    }\n\n    return trimmed;\n  }\n\n  return current == null ? '' : String(current).trim();\n}\n\nfunction hasMatchingOuterQuotes(value) {\n  return (\n    (value[0] === '\"' && value[value.length - 1] === '\"') ||\n    (value[0] === \"'\" && value[value.length - 1] === \"'\")\n  );\n}\n\nfunction combineFilters(baseFilter, recencyFilter) {\n  return parenthesize(baseFilter) + ' AND ' + parenthesize(recencyFilter);\n}\n\nfunction parenthesize(filter) {\n  return '(' + filter + ')';\n}\n\nfunction normalizeRelativeNowFilters(filter) {\n  if (filter === '') {\n    return '';\n  }\n\n  return filter\n    .replace(/(['\"])now-(\\d+)d\\1/gi, function(match, quote, daysText) {\n      return quoteIso(daysAgoIso(daysText));\n    })\n    .replace(/:NOW-(\\d+)D\\b/gi, function(match, daysText) {\n      return quoteIso(daysAgoIso(daysText));\n    });\n}\n\nfunction daysAgoIso(daysText) {\n  const days = Number(daysText);\n  return new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString();\n}\n\nfunction quoteIso(value) {\n  return '\\'' + value + '\\'';\n}\n",
            "returnType": "object"
          },
          "outcomes": {
            "success": "1778797886917"
          },
          "inputs": [],
          "diagram": {
            "x": 5695,
            "y": 6148
          },
