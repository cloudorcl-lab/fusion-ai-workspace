                {
                  "id": "1778732200001",
                  "code": "PREPARE_REGISTRYID_BATCHES",
                  "type": "CODE",
                  "metadata": {
                    "name": "Prepare Registry ID Batches",
                    "returnType": "array",
                    "sourceCode": "let accounts = $context.$nodes.FETCH_ACCOUNTS_WITH_ACTIVITY.$output || [];\n\nconst maxAccountLimit = $context.$variables.maxAccountLimit;\nconst processedAccountCount = $context.$variables.processedAccountCount;\n\nconst accountLimitRemaining = maxAccountLimit - processedAccountCount;\nif (accounts.length > accountLimitRemaining) {\n  accounts = accounts.slice(0, accountLimitRemaining);\n}\n\nconst batchSize = $context.$variables.accountBatchSize;\nconst registryIds = accounts\n  .map((account) => account?.REGISTRYID)\n  .filter((registryId) => registryId !== undefined && registryId !== null && String(registryId) !== \"\")\n  .map((registryId) => String(registryId));\n\nconst batches = [];\nfor (let index = 0; index < registryIds.length; index += batchSize) {\n  batches.push(registryIds.slice(index, index + batchSize));\n}\n\nreturn batches;"
                  },
                  "outcomes": {
                    "success": "1778732300001"
                  },
                  "inputs": [],
                  "diagram": {
