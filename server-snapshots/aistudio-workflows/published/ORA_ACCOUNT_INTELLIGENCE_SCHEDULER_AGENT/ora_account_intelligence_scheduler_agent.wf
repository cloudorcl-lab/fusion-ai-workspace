                  "code": "COMPUTE_NEXT_ACCOUNT_FETCH_STATE",
                  "type": "CODE",
                  "metadata": {
                    "name": "Compute Next Account Fetch State",
                    "returnType": "object",
                    "sourceCode": "const accounts = $context.$nodes.FETCH_ACCOUNTS_WITH_ACTIVITY.$output || [];\n\nconst currentOffset = $context.$variables.currentOffset;\nconst queryLimit = $context.$variables.queryLimit;\nconst processedAccountCount = $context.$variables.processedAccountCount;\nconst maxAccountLimit = $context.$variables.maxAccountLimit;\n\nconst hasMoreAccounts = accounts.length > 0 && processedAccountCount < maxAccountLimit;\n\nconst result = {\n  nextOffset: currentOffset + queryLimit,\n  hasMoreAccounts\n};\n\nreturn result;"
                  },
                  "outcomes": {
                    "success": "1778730502536"
                  },
                  "inputs": [],
                  "diagram": {
