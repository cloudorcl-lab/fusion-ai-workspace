          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}"
        },
        {
          "id": "1778797886910",
          "code": "PARSE_PRODUCT_RUNTIME_SETTINGS",
          "type": "CODE",
          "metadata": {
            "name": "Parse Product Runtime Settings",
            "returnType": "object",
            "sourceCode": "let resolved = $context.$nodes.GET_ACCOUNT_PRODUCT_RUNTIME_SETTINGS?.$output;\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const trimmed = value.trim();\n  if (trimmed === \"\") {\n    return {};\n  }\n\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return {};\n  }\n}\n\nfor (let index = 0; index < 8; index += 1) {\n  resolved = parseMaybeJson(resolved);\n  if (resolved == null || typeof resolved !== \"object\") {\n    break;\n  }\n  if (resolved.commonConfiguration || resolved.filterConfiguration) {\n    break;\n  }\n  if (Object.prototype.hasOwnProperty.call(resolved, \"output\")) {\n    resolved = resolved.output;\n  } else if (Object.prototype.hasOwnProperty.call(resolved, \"returnValue\")) {\n    resolved = resolved.returnValue;\n  } else if (Object.prototype.hasOwnProperty.call(resolved, \"value\")) {\n    resolved = resolved.value;\n  } else if (Object.prototype.hasOwnProperty.call(resolved, \"result\")) {\n    resolved = resolved.result;\n  } else {\n    break;\n  }\n}\n\nresolved = parseMaybeJson(resolved);\nconst commonConfiguration = resolved && typeof resolved === \"object\" && resolved.commonConfiguration && typeof resolved.commonConfiguration === \"object\"\n  ? resolved.commonConfiguration\n  : {};\nconst filterConfiguration = resolved && typeof resolved === \"object\" && resolved.filterConfiguration && typeof resolved.filterConfiguration === \"object\"\n  ? resolved.filterConfiguration\n  : {};\nconst result = {\n  commonConfiguration,\n  filterConfiguration\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778730502534"
          },
          "inputs": [],
          "diagram": {
            "x": 5695,
            "y": 7258
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
