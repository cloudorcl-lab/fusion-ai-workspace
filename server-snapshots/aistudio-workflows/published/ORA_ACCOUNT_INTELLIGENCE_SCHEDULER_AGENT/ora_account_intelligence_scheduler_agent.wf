        {
          "id": "1778797886909",
          "code": "NORMALIZE_SCHEDULER_CONFIG",
          "type": "CODE",
          "metadata": {
            "name": "Normalize Scheduler Config",
            "returnType": "object",
            "sourceCode": "const action = $context.$triggers.REST.$input.action || {};\nconst config = action.config || {};\n\nfunction toPositiveInteger(value, defaultValue) {\n  const numericValue = Number(value);\n  if (!Number.isFinite(numericValue) || numericValue < 1) {\n    return defaultValue;\n  }\n  return Math.floor(numericValue);\n}\n\nfunction normalizeMode(value) {\n  const normalizedValue = value == null ? '' : String(value).trim().toUpperCase();\n  return normalizedValue === 'FULL' ? 'FULL' : 'INCREMENTAL';\n}\n\nconst externalSourcesEnabled = config.externalSourcesEnabled;\nconst maxAccountLimit = toPositiveInteger(config.maxAccountLimit, 10000);\nconst accountBatchSize = toPositiveInteger(config.accountBatchSize, 50);\nlet queryLimit = toPositiveInteger(config.queryLimit, 1000);\nconst mode = normalizeMode(action.mode);\n\nif (queryLimit > maxAccountLimit) {\n  queryLimit = maxAccountLimit;\n}\n\nconst result = {\n  externalSourcesEnabled,\n  maxAccountLimit,\n  accountBatchSize,\n  queryLimit,\n  mode\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "1776191098560"
          },
          "inputs": [],
          "diagram": {
            "x": 5695,
            "y": 5206
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
