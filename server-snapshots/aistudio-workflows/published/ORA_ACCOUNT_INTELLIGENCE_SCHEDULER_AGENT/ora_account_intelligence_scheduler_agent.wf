  "workflowCode": "ORA_ACCOUNT_INTELLIGENCE_SCHEDULER_AGENT",
  "name": "Account Intelligence Scheduler Agent",
  "description": "Runs the Account Intelligence Agent on a defined schedule in the background to refresh and persist account summaries and insights. It automates periodic data collection and analysis so sales teams have up-to-date intelligence available when they review accounts, plan outreach, or prepare for meetings.",
  "specification": {
