        {
          "metadata": {
            "name": "Merge Negotiations Lists",
            "returnType": "object",
            "sourceCode": "// 1. Define the outputs from your previous nodes here\nconst sources = [\n    $context.$nodes.SIMPLIFY_DRAFT_NEGOTIATIONS.$output.result ,   // <--- Replace with actual Node Names\n   $context.$nodes.SIMPLIFY_APPROVAL_IN_PROCESS_DATA.$output.result,\n   $context.$nodes.SIMPLIFY_NOT_APPROVED_DATA.$output.result\n];\n\n// 2. Combine and Deduplicate\nconst result = sources.reduce((acc, sourceObj) => {\n    \n    // Safety check: ensure the node actually returned the list\n    const currentList = sourceObj.NegotiationsList || [];\n\n    currentList.forEach(item => {\n        // Check for duplicates across ALL lists using AuctionHeaderId\n        if (item.AuctionHeaderId && !acc.seenIds.has(item.AuctionHeaderId)) {\n            acc.seenIds.add(item.AuctionHeaderId);\n            acc.mergedList.push(item);\n        }\n    });\n\n    return acc;\n\n}, { seenIds: new Set(), mergedList: [] });\n\nlet obj = {\n    NegotiationsList: result.mergedList,\n    NegotiationsCount: result.mergedList.length\n};\nreturn obj ;"
          },
          "outcomes": {
            "success": "end"
          },
