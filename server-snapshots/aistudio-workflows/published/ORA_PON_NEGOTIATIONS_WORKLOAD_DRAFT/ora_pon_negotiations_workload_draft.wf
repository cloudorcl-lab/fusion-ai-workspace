          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Simplify Not Approved Data",
            "returnType": "object",
            "sourceCode": "const rawList =  $context.$nodes.GET_NOT_APPROVED_NEGOTIATIONS.$output.items &&  $context.$nodes.GET_NOT_APPROVED_NEGOTIATIONS.$output.items ?  $context.$nodes.GET_NOT_APPROVED_NEGOTIATIONS.$output.items : ( $context.$nodes.GET_NOT_APPROVED_NEGOTIATIONS.$output.items || []);\n\nconst result = rawList.reduce((acc, item) => {\n    \n    if (!acc.seenIds.has(item.AuctionHeaderId)) { \n        acc.seenIds.add(item.AuctionHeaderId);\n\n        const created = new Date(item.NegApprovalSubmitDate);\n        const now = new Date(item.CurrentDateTime);\n        const diffInMs = now - created;\n        const diffInDays = (diffInMs / (1000 * 60 * 60 * 24)).toFixed(3);\n\n        acc.uniqueList.push({\n             AuctionHeaderId: item.AuctionHeaderId,\n             NegotiationStatus: item.NegotiationStatusCode,\n             BadgeText: item.NegotiationStatus,\n             DifferenceInDays: diffInDays,\n             ProcurementBU: item.ProcurementBU,\n             NegotiationTitle: item.NegotiationType + ' '+ item.Negotiation+ ' - '+ (item.NegotiationTitle || \" \"),\n             BuyerName: item.Buyer || \" \"\n        });\n    }\n\n    return acc;\n\n}, { seenIds: new Set(), uniqueList: [] }); \n\nlet obj= {\n    NegotiationsList: result.uniqueList,\n    NegotiationsCount: result.uniqueList.length\n  };\n\n \n  return obj;"
          },
          "outcomes": {
            "success": "1771253270841"
          },
          "code": "SIMPLIFY_NOT_APPROVED_DATA",
          "id": "1770931652141",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
