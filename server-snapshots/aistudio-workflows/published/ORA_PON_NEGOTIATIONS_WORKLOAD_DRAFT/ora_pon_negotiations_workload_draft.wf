ode\",\n          \"OpenDate\",\n          \"TimeRemaining\",\n          \"SuppliersCount\",\n          \"SupplierResponses\",\n          \"CreationDate\",\n          \"NegApprovalSubmitDate\",\n          \"AuctionStatusCode\",\n          \"LastUpdateDate\",\n          \"CurrentDateTime\",\n          \"ProcurementBUId\",\n          \"ProcurementBU\",\n          \"BuyerId\",\n          \"Buyer\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"items\"\n  ]\n}",
