        },
        {
          "metadata": {
            "name": "Process insights data",
            "returnType": "object",
            "sourceCode": "let input = $context.$nodes.FETCH_DATA_FOR_INSIGHTS.$output;\nlet rulePriorityCodeLookup = $context.$variables.OraFUNRulePriority;\nlet categoryCodeLookup = $context.$variables.OraGLRuleCategory;\nconst map = new Map( rulePriorityCodeLookup.map( item => [ item.value, item]));\nconst categoryCodeLookupMap = new Map( categoryCodeLookup.map( item => [ item.value, item]));\nlet formatLastOccurrence = ( creationDate) => {\n  if( ! creationDate)\n  return \"\";\n  const date = new Date( creationDate);\n  if( Number.isNaN( date.getTime()))\n  return \"\";\n  const month = date.getMonth() + 1;\n  const day = date.getDate();\n  const year = String( date.getFullYear()).slice( - 2);\n  const rawHours = date.getHours();\n  const hours = rawHours % 12 || 12;\n  const minutes = String( date.getMinutes()).padStart( 2, \"0\");\n  const meridiem = rawHours >= 12 ? \"pm\" : \"am\";\n  return `${month}/${day}/${year} ${hours}:${minutes} ${meridiem}`;\n};\nlet timeDifference = ( creationDate) => {\n  const now = new Date();\n  const past = new Date( creationDate);\n  const diffInSeconds = Math.floor(( now - past) / 1000);\n  const intervals = [\n    {\n      label: \"day\",\n      seconds: 86400\n    },\n    {\n      label: \"hour\",\n      seconds: 3600\n    },\n    {\n      label: \"minute\",\n      seconds: 60\n    }\n  ];\n  for( let i = 0; i < intervals.length; i++) {\n    const count = Math.floor( diffInSeconds / intervals[ i].seconds);\n    if( count > 0) {\n      return count + \" \" + intervals[ i].label + ( count > 1 ? \"s ago\" : \" ago\");\n    }\n  }\n  return \"just now\";\n};\n\n\n\nlet items = ( input?.items ?? []).map(( row) => {\n  const lastOccurrence = formatLastOccurrence( row?.timeCreated);\n  const ledgerId = row?.sensorSignal?.sensorInsightDetails?.items?.[0]?.insightContextValueId || \"\";\n\n  return {\n    insightRecipientId: row?.insightRecipientId,\n    ledgerId,\n    ruleName: row?.sensorSignal?.policy?.ruleName,\n    insightSummary: row?.insightSummary,\n    insightStatus: row?.status?.meaning,\n    insightStatusCode: row?.status?.lookupCode,\n    timeCreated: row?.timeCreated,\n    timeCreatedMeaning: timeDifference( row?.timeCreated),\n    lastOccurrenceLabel: lastOccurrence ? ( \"Last Occurrence \" + lastOccurrence) : \"\",\n    rulePriorityCode: row?.sensorSignal?.policy?.rulePriority?.lookupCode,\n    //    bossFilter: row?.sensorSignal?.policy?.bossFilter,\n    rulePriorityCodeMeaning: row?.sensorSignal?.policy?.rulePriority?.meaning,\n    categoryCode: row?.sensorSignal?.policy?.categoryCode,\n    categoryCodeMeaning: categoryCodeLookupMap?.get( row?.sensorSignal?.policy?.categoryCode)?.label\n  };\n});\nreturn {\n  items\n};"
          },
          "outcomes": {
            "success": "1780955020525"
          },
          "code": "PROCESS_INSIGHTS_DATA",
          "id": "1777999030321",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
