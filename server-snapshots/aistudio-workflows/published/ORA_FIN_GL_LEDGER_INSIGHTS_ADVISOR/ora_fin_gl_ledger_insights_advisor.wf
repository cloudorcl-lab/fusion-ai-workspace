          "code": "FETCH_DATA_FOR_INSIGHTS",
          "id": "1777998988020",
          "inputs": [
            {
              "id": "1777999007641_1",
              "name": "qParam",
              "value": "{{$context.$nodes.PREPARE_PAYLOAD_FOR_INSIGHTS.$output.result}}",
              "required": true
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION",
