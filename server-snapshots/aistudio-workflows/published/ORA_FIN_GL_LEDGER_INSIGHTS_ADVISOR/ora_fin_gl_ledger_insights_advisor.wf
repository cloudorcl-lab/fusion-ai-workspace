            "sourceCode": "let msgHint = $context.$app.$OraMessageHint;\nlet insights = [];\nif(msgHint == 'Query'){\n  insights = $context.$nodes.PROCESS_INSIGHTS_DATA.$output.result;\n}\nelse{\n  insights = $context.$nodes.ANALYSE_INSIGHTS_INFORMATION.$output;\n}\n\nreturn insights;"
          },
