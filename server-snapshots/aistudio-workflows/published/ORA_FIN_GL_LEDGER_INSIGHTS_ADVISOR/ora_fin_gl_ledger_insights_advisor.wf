        {
          "metadata": {
            "name": "Prepare Payload for Initial Display",
            "returnType": "string",
            "sourceCode": "const CASE_CONFIG = {\n  ORA_DEFAULT : {\n    categories: []\n  },\n  ORA_CLR_ACC_BAL: {\n    categories: [\"ORA_RECONCILIATION\"]\n  },\n\n  ORA_VAR_ANALYSIS: {\n    categories: [\"ORA_VARIANCE\"]\n  },\n\n  ORA_CTRL_CMP: {\n    categories: [\"ORA_ACCOUNTING_CONTROLS\", \"ORA_PERIOD_END_CONTROLS\"]\n  }\n};\n\nconst buildOrLikeFilter = (field, values = []) => {\n  if (!Array.isArray(values) || !values.length) return \"\";\n\n  return `(${values\n    .map(value => `${field} ~like '%${value}%'`)\n    .join(\" OR \")})`;\n};\n\nconst buildLedgerInsightsQuery = ({\n  caseCode,\n  categories = [],\n  ruleNames = []\n} = {}) => {\n  const config = CASE_CONFIG[caseCode];\n\n  if (!config) {\n    throw new Error(`Unsupported caseCode: ${caseCode}`);\n  }\n\n  const finalCategories = categories.length\n    ? categories\n    : config.categories;\n\n  const categoryFilter = buildOrLikeFilter(\n    \"sensorSignal.policy.categoryCode\",\n    finalCategories\n  );\n\n  const ruleNameFilter = buildOrLikeFilter(\n    \"sensorSignal.policy.ruleName\",\n    ruleNames\n  );\n\n  const statusFilter = \"status.lookupCode='ORA_OPEN'\";\n  const activeFilter = \"sensorSignal.policy.activeFlag=true\";\n\n  const ledgerId =\n    $context.$nodes.PROCESS_APPLICATION_CONTEXT.$output.result.ledgerId;\n\n  /*const ledgerFilter =\n    `sensorSignal.sensorInsightDetails[dataAccessSetAssignment.ledgerId=${ledgerId}]`;*/\n\n  const openStatusFilter = ruleNameFilter\n    ? `(${statusFilter} AND (${ruleNameFilter}))`\n    : `(${statusFilter})`;\n\n  const filters = [\n    categoryFilter,\n  //  ledgerFilter,\n    activeFilter,\n    openStatusFilter\n  ].filter(Boolean);\n\n  return [\n    `$filter=${filters.join(\" AND \")}`,\n    `$sortBy=sensorSignal.policy.rulePriority.lookupCode:asc,timeCreated:desc`,\n    `sensorCode=LedgerInsights`\n  ].join(\"&\");\n};\n\n/**\n * Pick one caseCode:\n *\n * ORA_CLR_ACC_BAL\n * ORA_VAR_ANALYSIS\n * ORA_CTRL_CMP\n */\nconst discriminator = $context.$app.$OraAppDisplayDiscriminator || \"ORA_DEFAULT\";\n\nconst query = buildLedgerInsightsQuery({\n  caseCode: discriminator\n});\n\nreturn query;"
          },
