          "code": "FETCH_LEDGERS_FOR_LOGGED_IN_USER",
          "id": "1781866248799",
          "inputs": [
            {
              "id": "1781866248799_partialLedgerName",
              "name": "partialLedgerName",
              "value": "{{$context.$nodes.PROCESS_USER_INPUT.$output.result}}",
