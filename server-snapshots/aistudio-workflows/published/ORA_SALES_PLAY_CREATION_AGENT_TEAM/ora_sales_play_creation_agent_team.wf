                {
                  "metadata": {
                    "name": "Create Product Query",
                    "sourceCode": "const date = new Date($context.$system.$currentDateTime);\nconst pad = (n, len = 2) => String(n).padStart(len, \"0\");\nconst currentTs = date.getUTCFullYear() + \"-\" +\n    pad(date.getUTCMonth() + 1) + \"-\" +\n    pad(date.getUTCDate()) + \"T\" +\n    pad(date.getUTCHours()) + \":\" +\n    pad(date.getUTCMinutes()) + \":\" +\n    pad(date.getUTCSeconds()) + \".\" +\n    pad(date.getUTCMilliseconds(), 3) +\n    \"+0000\"\n\nconst prodGroupQParam = {\n  op: \"$and\",\n  criteria: [\n    {\n      attribute: \"ListOfProductGroupRoots.StartDate\",\n      op: \"$lt\",\n      value: currentTs\n    },\n    {\n      attribute: \"ListOfProductGroupRoots.EndDate\",\n      op: \"$gt\",\n      value: currentTs\n    },\n    {\n      attribute: \"ListOfProductGroupRoots.ActiveFlag\",\n      op: \"$eq\",\n      value: true\n    },\n    {\n      op: \"$eq\",\n      attribute: \"AllowSelectionFlag\",\n      value: true\n    }\n  ]\n};\n\nconst fetchProductsElasticEntitiesObj = {\n  CRMProduct: {\n    fields: [\n      \"InventoryItemId\",\n      \"ItemNumber\",\n      \"Name\",\n      \"Description\"\n    ],\n    keywordsFields: [\n      \"ItemNumber\",\n      \"Name\",\n      \"Description\"\n    ],\n    q: {\n      attribute: \"EligibleToSellFlag\",\n      op: \"$eq\",\n      value: true\n    }\n  },\n  CRMProductGroup: {\n    fields: [\n      \"ProdGroupId\",\n      \"ProductGroupReferenceNumber\",\n      \"Name\",\n      \"Description\"\n    ],\n    keywordsFields: [\n      \"ProductGroupReferenceNumber\",\n      \"Name\",\n      \"Description\"\n    ],\n    q: prodGroupQParam\n  }\n};\n\nconst fetchProductsElasticEntities = JSON.stringify(fetchProductsElasticEntitiesObj);\n\nreturn fetchProductsElasticEntities;",
                    "returnType": "string",
                    "description": "Create Product Elastic Entities Query"
                  },
