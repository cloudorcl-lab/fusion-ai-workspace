        {
          "metadata": {
            "name": "Prepare Response 01",
            "returnType": "object",
            "sourceCode": "// PREPARE CHAT HISTORY TO PERSIST\n\nconst chatHistory = $context.$variables.chatHistory === null || $context.$variables.chatHistory === \"\" ? [] :  $context.$variables.chatHistory;\n\nconst historyItem =  {\nuserPrompt: $context.$system.$inputMessage,\nagentResponse: $context.$nodes.CONTEXT_AGENT.$output.agentResponse,\nuserRequest: $context.$nodes.CONTEXT_AGENT.$output.userRequest\n}\n\nchatHistory.push(historyItem);\n\n\n// Prepare responseText\n\nlet responseText = $context.$nodes.CONTEXT_AGENT.$output.agentResponse \nif($context.$nodes.CONTEXT_AGENT.$output.userRequest) {\n    responseText = $context.$nodes.CONTEXT_AGENT.$output.agentResponse + \"\\n\\n\" + $context.$nodes.CONTEXT_AGENT.$output.userRequest;\n}\n\nconst workflowResponse = {\n  \"type\": \"text\",\n  \"text\": responseText \n}\n\nconst response = {workflowResponse, chatHistory};\nreturn response;"
          },
          "outcomes": {
            "success": "1774256638996"
          },
