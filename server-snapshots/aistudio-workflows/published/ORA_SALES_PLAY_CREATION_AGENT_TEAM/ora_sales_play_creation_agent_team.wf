          "agenticAppMode": "query",
          "restConfigJson": "{\n  \"salesPlayType\": \"CONTENT_BUNDLE\",\n  \"salesPlayJSON\": {\n            \"name\": \"Manufacturing Industry Content Bundle for North America\",\n            \"description\": \"This Content Bundle helps sellers engage manufacturing customers across the US, Canada, and Mexico by providing focused materials centered on product 0NL4. It supports targeted outreach to drive adoption and sales within the manufacturing sector in North America.\",\n            \"playTag\": \"Manufacturing North America Content\",\n            \"artifacts\": [\n                {\n                    \"id\": 1001,\n                    \"type\": \"CUSTOMER\",\n                    \"status\": \"WARN\",\n                    \"title\": \"Manufacturing Industry Customers in North America\",\n                    \"description\": \"Targeting manufacturing industry accounts located in the United States, Canada, and Mexico. The geographic scope includes North American markets relevant to industrial manufacturing. Due to overlapping country data, geographic targeting clarity may be affected, which could influence precise applicability.\",\n                    \"runtimeCriteria\": [\n                        {\n                            \"displayOrder\": \"1\",\n                            \"rule\": {\n                                \"conditions\": {\n                                    \"allOf\": [\n                                        {\n                                            \"attribute\": \"IndustryCode\",\n                                            \"operator\": \"EQUALS\",\n                                            \"value\": 2000\n                                        },\n                                        {\n                                            \"attribute\": \"Country\",\n                                            \"operator\": \"IN\",\n                                            \"value\": [\n                                                \"US\",\n                                                \"CA\",\n                                                \"MX\"\n                                            ]\n                                        }\n                                    ]\n                                }\n                            },\n                            \"objectName\": \"accounts\"\n                        }\n                    ],\n                    \"designTimeArtifacts\": {\n                        \"accounts.IndustryCode\": [\n                            {\n                                \"name\": \"Industrial Manufacturing\",\n                                \"value\": 2000\n                            }\n                        ],\n                        \"accounts.Country\": [\n                            {\n                                \"name\": \"United States\",\n                                \"value\": \"US\"\n                            },\n                            {\n                                \"name\": \"Canada\",\n                                \"value\": \"CA\"\n                            },\n                            {\n                                \"name\": \"Mexico\",\n                                \"value\": \"MX\"\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"PRODUCT\",\n                    \"status\": \"WARN\",\n                    \"title\": \"SaaS - Financial Management Services Fusion Cloud Service - 0NL4\",\n                    \"description\": \"This Content Bundle focuses on the SaaS offering 'Financial Management Services Fusion Cloud Service - 0NL4'. There is some ambiguity due to the presence of multiple related product records in the resolved data, which may affect clarity on the exact product scope. Sellers should be aware that the primary product targeted is the Financial Management Services Fusion Cloud Service identified by 0NL4.\",\n                    \"runtimeCriteria\": [\n                        {\n                            \"displayOrder\": \"2\",\n                            \"rule\": {\n                                \"conditions\": {\n                                    \"anyOf\": [\n                                        {\n                                            \"attribute\": \"ProductGroupId\",\n                                            \"operator\": \"EQUALS\",\n                                            \"value\": 300100640601925\n                                        }\n                                    ]\n                                }\n                            },\n                            \"objectName\": \"productGroups\"\n                        }\n                    ],\n                    \"designTimeArtifacts\": {\n                        \"products\": [\n                            {\n                                \"id\": 300100640601925,\n                                \"type\": \"ProductGroup\",\n                                \"name\": \"SaaS - Financial Management Services Fusion Cloud Service - 0NL4\"\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"PERSONA\",\n                    \"status\": \"WARN\",\n                    \"title\": \"Manufacturing Industry Financial and Operational Decision Makers\",\n                    \"description\": \"This Content Bundle targets key buyer and stakeholder roles within manufacturing organizations who influence or make decisions related to financial management and operational efficiency. These roles typically include senior finance leaders responsible for budgeting, forecasting, and financial controls, as well as operations leaders focused on procurement, supply chain management, and process optimization. Due to the broad nature of manufacturing organizations and the lack of specific role definitions, this persona description remains high-level and may require further refinement to tailor engagement strategies effectively.\",\n                    \"designTimeArtifacts\": {\n                        \"personas\": [\n                            {\n                                \"name\": \"Chief Financial Officer (CFO)\",\n                                \"summary\": \"Leads financial strategy, oversees budgeting and forecasting, ensures regulatory compliance, and drives profitability.\",\n                                \"isPrimary\": true\n                            },\n                            {\n                                \"name\": \"Vice President of Finance\",\n                                \"summary\": \"Manages financial planning and analysis, supports strategic financial initiatives, and monitors financial performance.\",\n                                \"isPrimary\": false\n                            },\n                            {\n                                \"name\": \"Head of Procurement\",\n                                \"summary\": \"Oversees sourcing strategies, supplier relationships, and cost management to optimize procurement processes.\",\n                                \"isPrimary\": false\n                            },\n                            {\n                                \"name\": \"Operations Manager\",\n                                \"summary\": \"Focuses on production efficiency, supply chain coordination, and operational cost control to improve manufacturing outcomes.\",\n                                \"isPrimary\": false\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"DOCUMENT\",\n                    \"status\": \"WARN\",\n                    \"title\": \"Content Bundle for Selling Product 0NL4 to Manufacturing Industries\",\n                    \"description\": \"This Content Bundle outlines the sales enablement materials recommended to support sellers in engaging manufacturing industry customers with product 0NL4 across the US, Canada, and Mexico. Currently, specific material sets aligned to seller goals or moments are not defined, indicating broad or partial coverage of sales content. Further refinement is needed to specify targeted content for discovery, value articulation, and proof points.\",\n                    \"designTimeArtifacts\": {\n                        \"materialSets\": []\n                    }\n                }\n            ]\n        }\n}",
