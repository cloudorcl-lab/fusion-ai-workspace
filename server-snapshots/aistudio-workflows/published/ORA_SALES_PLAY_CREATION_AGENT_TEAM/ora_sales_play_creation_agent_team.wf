        },
        {
          "metadata": {
            "name": "Prepare BO Context",
            "returnType": "object",
            "sourceCode": "const operations = $context.$nodes.CONTEXT_AGENT.$output.toolPlan.operations;\nconst operation_results = $context.$nodes.FETCH_BO_DATA.$output;\n\nconst cursors = {\n  products: 0,\n  industries: 0,\n  salesMotions: 0,\n  campaigns: 0\n};\n\nconst typeToBucket = {\n  \"FETCH_PRODUCT_IDS\": \"products\",\n  \"FETCH_INDUSTRIES\": \"industries\",\n  \"FETCH_SALESMOTIONS\": \"salesMotions\",\n  \"FETCH_CAMPAIGNS\": \"campaigns\"\n};\n\nconst isArrayResults = Array.isArray(operation_results);\n\nfor (let i = 0; i < operations.length; i++) {\n  const op = operations[i];\n\n  // pick raw result depending on operation_results shape\n  let raw;\n  if (isArrayResults) {\n    raw = operation_results[i];\n  } else if (operation_results && typeof operation_results === \"object\") {\n    const bucket = typeToBucket[op.type];\n    if (bucket && Array.isArray(operation_results[bucket])) {\n      const idx = cursors[bucket] || 0;\n      raw = operation_results[bucket][idx];\n      cursors[bucket] = idx + 1;\n    } else {\n      raw = operation_results[i];\n    }\n  } else {\n    raw = operation_results[i];\n  }\n\n  // Attempt to parse JSON if needed\n  let parsed = raw;\n  if (typeof parsed === \"string\") {\n    try {\n      parsed = JSON.parse(parsed);\n    } catch (e) {\n      parsed = null;\n    }\n  }\n\n  // If not an object/array, assign directly\n  if (parsed === null || typeof parsed !== \"object\") {\n    op.result = parsed === undefined ? null : parsed;\n    continue;\n  }\n\n  // In-place deep clean WITHOUT helper functions\n  // Removes \"@context\", \"$context\", and \"links\"\n  const stack = [parsed];\n  while (stack.length) {\n    const node = stack.pop();\n\n    if (node && typeof node === \"object\") {\n      if (Array.isArray(node)) {\n        for (let ai = 0; ai < node.length; ai++) {\n          const child = node[ai];\n          if (child && typeof child === \"object\") stack.push(child);\n        }\n      } else {\n        const keys = Object.keys(node);\n        for (let ki = 0; ki < keys.length; ki++) {\n          const key = keys[ki];\n\n          // REMOVE unwanted keys\n          if (key === \"@context\" || key === \"$context\" || key === \"links\") {\n            try { delete node[key]; } catch (e) { node[key] = undefined; }\n            continue;\n          }\n\n          const child = node[key];\n          if (child && typeof child === \"object\") {\n            stack.push(child);\n          }\n        }\n      }\n    }\n  }\n\n  // Attach cleaned result to the operation\n  op.result = parsed === undefined ? null : parsed;\n}\n\nreturn operations;",
            "description": "Prepare Resolved BO Context"
          },
          "outcomes": {
            "success": "1774258402045"
          },
