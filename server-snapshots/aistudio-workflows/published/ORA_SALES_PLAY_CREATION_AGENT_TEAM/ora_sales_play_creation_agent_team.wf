          "code": "DOCUMENT_TOOL",
          "id": "1774257261606",
          "inputs": [
            {
              "id": "1774257261606_conversationId",
              "name": "conversationId",
              "type": "string",
              "value": "{{$context.$workflow.$conversationId}}"
            }
          ],
          "type": "TOOL"
        },
        {
          "metadata": {
            "name": "Parse Context",
            "returnType": "object",
            "sourceCode": "const documentData = $context.$variables.documentData\nconst documentDataFileCount = (documentData?.files ?? []).length;\n\nconst documentToolOutput = $context.$nodes.DOCUMENT_TOOL.$output;\ndelete documentToolOutput.ORA_CHAT_ATTACHMENTS_RAW_FILECONTENT;\nconst attachedFileCount = Object.keys(documentToolOutput ?? {}).length;\n\nlet docPendingParse = false;\nif(attachedFileCount !== documentDataFileCount) {\n  docPendingParse = true;\n}\n\n\n// Use salesPlayJSON from memory if not passed as parameter\nlet salesPlayJSON = $context.$variables.salesPlayJSON ?? {}; \nconst userSalesPlayJSON = $context.$triggers.REST.$input.salesPlayJSON;\nif(userSalesPlayJSON !== null && userSalesPlayJSON !== \"\" && Object.keys(userSalesPlayJSON).length !== 0) {\n  salesPlayJSON = userSalesPlayJSON;\n}\n\nconst response =  {docPendingParse, salesPlayJSON};\nreturn response;\n"
          },
          "outcomes": {
            "success": "1774257430634"
          },
          "diagram": {
            "x": 7219,
            "y": 5300
          },
          "code": "PARSE_CONTEXT",
          "id": "1774257290603",
          "inputs": [],
          "type": "CODE",
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
