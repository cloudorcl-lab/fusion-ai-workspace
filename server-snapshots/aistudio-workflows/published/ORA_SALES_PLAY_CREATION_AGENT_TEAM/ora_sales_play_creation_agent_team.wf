            "sourceCode": "// PREPARE CHAT HISTORY TO PERSIST\n\nconst chatHistory = $context.$variables.chatHistory === null || $context.$variables.chatHistory === \"\" ? [] :  $context.$variables.chatHistory;\n\nconst historyItem =  {\nuserPrompt: $context.$system.$inputMessage,\nagentResponse: $context.$nodes.VALIDATE_BO_RESOLUTION.$output.agentResponse,\nuserRequest: $context.$nodes.VALIDATE_BO_RESOLUTION.$output.userRequest,\n}\n\nchatHistory.push(historyItem);\n\n\n// Prepare responseText\n\nlet responseText = $context.$nodes.VALIDATE_BO_RESOLUTION.$output.agentResponse \nif($context.$nodes.VALIDATE_BO_RESOLUTION.$output.userRequest) {\n    responseText = $context.$nodes.VALIDATE_BO_RESOLUTION.$output.agentResponse + \"\\n\\n\" + $context.$nodes.VALIDATE_BO_RESOLUTION.$output.userRequest;\n}\n\nconst workflowResponse = {\n  \"type\": \"text\",\n  \"text\": responseText \n}\n\nconst response = {workflowResponse, chatHistory};\nreturn response;"
