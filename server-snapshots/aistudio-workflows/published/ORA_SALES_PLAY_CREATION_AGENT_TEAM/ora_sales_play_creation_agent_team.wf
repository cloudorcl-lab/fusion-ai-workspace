        {
          "metadata": {
            "name": "Split Artifacts",
            "returnType": "array",
            "sourceCode": "const intent = $context.$nodes.CONTEXT_AGENT.$output.intent;\nconst artifactsToGenerate = $context.$nodes.CONTEXT_AGENT.$output.editPlan.artifactsToGenerate;\n\nconst currentArtifacts =\n  $context.$variables.salesPlayJSON?.artifacts === null ||\n  $context.$variables.salesPlayJSON?.artifacts === \"\"\n    ? []\n    : $context.$variables.salesPlayJSON?.artifacts;\n\nconst currentArtifactsToUpdate = [];\n\nif (intent === \"EDIT\") {\n  // Build lookup by type\n  const artifactByType = {};\n\n  for (let i = 0; i < currentArtifacts.length; i++) {\n    artifactByType[currentArtifacts[i].type] = currentArtifacts[i];\n  }\n\n  // Build result in requested order\n  for (let i = 0; i < artifactsToGenerate.length; i++) {\n    const type = artifactsToGenerate[i];\n\n    if (artifactByType[type]) {\n      currentArtifactsToUpdate.push(artifactByType[type]);\n    } else {\n      currentArtifactsToUpdate.push({ type });\n    }\n  }\n\n} else if (intent === \"CREATE\") {\n  for (let i = 0; i < artifactsToGenerate.length; i++) {\n    currentArtifactsToUpdate.push({\n      type: artifactsToGenerate[i]\n    });\n  }\n}\n\nreturn currentArtifactsToUpdate;"
          },
