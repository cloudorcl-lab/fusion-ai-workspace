                  "metadata": {
                    "name": "Create Industry Q Param",
                    "returnType": "string",
                    "sourceCode": "const keywords = $context.$nodes.FETCH_BO_DATA.$currentItem.keywords\n\nconst values = keywords.split(\",\");\n\nlet result = \"\";\nfor (let i = 0; i < values.length; i++) {\n    if (i > 0) {\n      result += \" OR \";\n    }\n    result += \"ClassCodeMeaning LIKE '%25\" + values[i] + \"%25'\";\n  }\n\nreturn result;"
                  },
