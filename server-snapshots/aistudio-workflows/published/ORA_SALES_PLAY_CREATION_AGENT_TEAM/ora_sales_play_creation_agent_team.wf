          "id": "ee7a9099-bd86-40b4-bcfb-8246466fd5e1",
          "name": "Validate Documents",
          "type": "rest",
          "agenticAppMode": "query",
          "restConfigJson": "{\n    \"salesPlayJSON\": {\n        \"name\": \"North America Manufacturing Sales Play for 0NL4\",\n        \"description\": \"This Sales Play enables sellers to target manufacturing companies in the US, Canada, and Mexico with product 0NL4, focusing on driving adoption and addressing industry-specific needs across North America.\",\n        \"playTag\": \"North America Manufacturing Sales\",\n        \"artifacts\": [\n            {\n                \"designTimeArtifacts\": {\n                    \"accounts.IndustryCode\": [\n                        {\n                            \"name\": \"Industrial Manufacturing\",\n                            \"value\": 2000\n                        }\n                    ],\n                    \"accounts.Country\": [\n                        {\n                            \"name\": \"United States\",\n                            \"value\": \"US\"\n                        },\n                        {\n                            \"name\": \"Canada\",\n                            \"value\": \"CA\"\n                        },\n                        {\n                            \"name\": \"Mexico\",\n                            \"value\": \"MX\"\n                        }\n                    ]\n                },\n                \"id\": 1001,\n                \"type\": \"CUSTOMER\",\n                \"status\": \"WARN\",\n                \"title\": \"Manufacturing Industry Customers in North America\",\n                \"description\": \"This Sales Play targets manufacturing industry accounts located in the United States, Canada, and Mexico. Due to the broad geographic scope and the general industry classification, further segmentation may be required to refine applicability and maximize sales effectiveness.\",\n                \"runtimeCriteria\": [\n                    {\n                        \"rule\": {\n                            \"conditions\": {\n                                \"allOf\": [\n                                    {\n                                        \"attribute\": \"IndustryCode\",\n                                        \"operator\": \"EQUALS\",\n                                        \"value\": 2000\n                                    },\n                                    {\n                                        \"attribute\": \"Country\",\n                                        \"operator\": \"IN\",\n                                        \"value\": [\n                                            \"US\",\n                                            \"CA\",\n                                            \"MX\"\n                                        ]\n                                    }\n                                ]\n                            }\n                        },\n                        \"displayOrder\": \"1\",\n                        \"objectName\": \"accounts\"\n                    }\n                ]\n            },\n            {\n                \"designTimeArtifacts\": {\n                    \"products\": [\n                        {\n                            \"id\": 300100640601925,\n                            \"type\": \"ProductGroup\",\n                            \"name\": \"SaaS - Financial Management Services Fusion Cloud Service - 0NL4\"\n                        }\n                    ]\n                },\n                \"id\": 1001,\n                \"type\": \"PRODUCT\",\n                \"status\": \"WARN\",\n                \"title\": \"SaaS - Financial Management Services Fusion Cloud Service (0NL4)\",\n                \"description\": \"This Sales Play focuses on the SaaS offering 'Financial Management Services Fusion Cloud Service' identified by product group 0NL4. The scope includes this product group, but there is ambiguity due to the presence of an additional related product group (0NL7) in the resolved data, which is not part of the requested focus. Sellers should be aware that the product definition may overlap with other Fusion Cloud services, affecting clarity on exact product boundaries.\",\n                \"runtimeCriteria\": [\n                    {\n                        \"rule\": {\n                            \"conditions\": {\n                                \"anyOf\": [\n                                    {\n                                        \"attribute\": \"ProductGroupId\",\n                                        \"operator\": \"EQUALS\",\n                                        \"value\": 300100640601925\n                                    }\n                                ]\n                            }\n                        },\n                        \"displayOrder\": \"2\",\n                        \"objectName\": \"productGroups\"\n                    }\n                ]\n            },\n            {\n                \"designTimeArtifacts\": {\n                    \"personas\": [\n                        {\n                            \"name\": \"Chief Financial Officer (CFO)\",\n                            \"summary\": \"Leads financial strategy, budgeting, and compliance to ensure organizational financial health and profitability.\",\n                            \"isPrimary\": true\n                        },\n                        {\n                            \"name\": \"Procurement Director\",\n                            \"summary\": \"Oversees sourcing strategies, supplier relationships, and cost optimization to support manufacturing supply chains.\",\n                            \"isPrimary\": false\n                        },\n                        {\n                            \"name\": \"Head of Operations\",\n                            \"summary\": \"Manages manufacturing processes and operational efficiency to meet production goals and reduce costs.\",\n                            \"isPrimary\": false\n                        }\n                    ]\n                },\n                \"id\": 1001,\n                \"type\": \"PERSONA\",\n                \"status\": \"WARN\",\n                \"title\": \"Manufacturing Industry Buyer and Stakeholder Roles\",\n                \"description\": \"This Sales Play targets key decision makers and influencers within manufacturing organizations. Typical personas include senior finance leaders responsible for financial planning and control, procurement leaders focused on sourcing and supplier management, and operations executives overseeing manufacturing efficiency and cost management. Due to limited explicit persona data, role definitions are broad and based on common business functions relevant to financial and procurement services in manufacturing environments.\"\n            },\n            {\n                \"designTimeArtifacts\": {\n                    \"salesMotions\": [\n                        {\n                            \"id\": \"300100652023716\",\n                            \"name\": \"Simple Sales Motion — Net New — Opportunity Creation to Close\",\n                            \"description\": \"A basic sales motion designed to guide sellers through the key stages of identifying, qualifying, and closing new business opportunities with clear objectives and impactful activities.\",\n                            \"statusCode\": \"ACTIVE\",\n                            \"timeUpdated\": \"2026-04-29T18:13:42.300368Z\"\n                        }\n                    ]\n                },\n                \"id\": 1000001,\n                \"type\": \"SALES_MOTION\",\n                \"status\": \"WARN\",\n                \"title\": \"Sales Motion Alignment for Product 0NL4 in Manufacturing Industries across US, Canada, and Mexico\",\n                \"description\": \"No predefined sales motions currently exist that specifically address the execution of selling product 0NL4 within manufacturing industries in the US, Canada, and Mexico. This lack of defined sales motions introduces ambiguity in how sellers should approach and manage the sales process for this play, potentially impacting clarity and consistency in execution.\",\n                \"runtimeCriteria\": [\n                    \"300100652023716\"\n                ]\n            },\n            {\n                \"designTimeArtifacts\": {\n                    \"materialSets\": [\n                        {\n                            \"id\": 201,\n                            \"name\": \"Discovery and Qualification Materials\",\n                            \"description\": \"Equip sellers with tools to identify customer needs, qualify manufacturing prospects, and initiate meaningful conversations about financial management challenges and opportunities.\",\n                            \"status\": \"NOT_AVAILABLE\"\n                        },\n                        {\n                            \"id\": 202,\n                            \"name\": \"Value Proposition and Differentiation Content\",\n                            \"description\": \"Provide sellers with messaging frameworks and content that clearly articulate the business value and competitive advantages of product 0NL4 tailored for manufacturing industry decision makers.\",\n                            \"status\": \"NOT_AVAILABLE\"\n                        },\n                        {\n                            \"id\": 203,\n                            \"name\": \"Customer Success Stories and Proof Points\",\n                            \"description\": \"Enable sellers to build credibility and trust by sharing relevant case studies, testimonials, and quantifiable outcomes from manufacturing customers using product 0NL4.\",\n                            \"status\": \"NOT_AVAILABLE\"\n                        },\n                        {\n                            \"id\": 204,\n                            \"name\": \"Objection Handling and Competitive Battlecards\",\n                            \"description\": \"Support sellers in addressing common objections and differentiating product 0NL4 against competitors within the manufacturing sector.\",\n                            \"status\": \"NOT_AVAILABLE\"\n                        }\n                    ]\n                },\n                \"id\": 1001,\n                \"type\": \"DOCUMENT\",\n                \"status\": \"WARN\",\n                \"title\": \"Sales Enablement Materials for Selling Product 0NL4 to Manufacturing Industries in North America\",\n                \"description\": \"This Sales Play proposes key sales enablement material sets to support sellers in engaging manufacturing industry customers with product 0NL4 across the US, Canada, and Mexico. The materials focus on discovery, value articulation, and proof points relevant to the product and industry context. Due to limited resolved sales motion and persona data, material coverage is broad and requires further refinement and validation.\"\n            }\n        ],\n        \"id\": \"300100652839636\"\n    },\n    \"salesPlayId\": \"300100652839636\",\n    \"triggerType\": \"REST\"\n}",
