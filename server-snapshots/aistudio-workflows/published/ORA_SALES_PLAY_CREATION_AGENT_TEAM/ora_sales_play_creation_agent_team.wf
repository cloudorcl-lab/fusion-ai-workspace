          "agenticAppMode": "query",
          "restConfigJson": "{\n  \"salesPlayType\": \"SALES_PLAY\",\n  \"salesPlayId\": 0,\n  \"salesPlayJSON\": {\n            \"name\": \"Financial Management SaaS for Indian Manufacturing\",\n            \"description\": \"This Sales Play helps sellers engage manufacturing industry customers in India with a financial management SaaS solution, focusing on addressing their operational and financial challenges through a targeted campaign approach.\",\n            \"playTag\": \"Financial Management Manufacturing India\",\n            \"artifacts\": [\n                {\n                    \"id\": 1001,\n                    \"type\": \"CUSTOMER\",\n                    \"status\": \"WARN\",\n                    \"title\": \"Manufacturing Industry Customers in India\",\n                    \"description\": \"This Sales Play targets organizations within the manufacturing sector operating in India. It is designed to engage manufacturing enterprises that align with the campaign CX_SA_DK_ELQ_CAMPAIGN1. Due to unresolved campaign details, the targeting related to the campaign is not fully defined, which may affect precise opportunity alignment.\",\n                    \"runtimeCriteria\": [\n                        {\n                            \"displayOrder\": \"1\",\n                            \"rule\": {\n                                \"conditions\": {\n                                    \"allOf\": [\n                                        {\n                                            \"attribute\": \"IndustryCode\",\n                                            \"operator\": \"IN\",\n                                            \"value\": [\n                                                39,\n                                                399\n                                            ]\n                                        },\n                                        {\n                                            \"attribute\": \"Country\",\n                                            \"operator\": \"EQUALS\",\n                                            \"value\": \"IN\"\n                                        }\n                                    ]\n                                }\n                            },\n                            \"objectName\": \"accounts\"\n                        },\n                        {\n                            \"displayOrder\": \"2\",\n                            \"rule\": {\n                                \"conditions\": {\n                                    \"allOf\": [\n                                        {\n                                            \"attribute\": \"PrimaryCampaignId\",\n                                            \"operator\": \"EQUALS\",\n                                            \"value\": 0\n                                        }\n                                    ]\n                                }\n                            },\n                            \"objectName\": \"opportunities\"\n                        }\n                    ],\n                    \"designTimeArtifacts\": {\n                        \"interests\": [],\n                        \"industries\": [\n                            {\n                                \"IndustryCode\": \"39\",\n                                \"IndustryName\": \"Miscellaneous manufacturing industries\"\n                            },\n                            {\n                                \"IndustryCode\": \"399\",\n                                \"IndustryName\": \"Miscellaneous manufacturing industries[1]\"\n                            }\n                        ],\n                        \"regions\": [],\n                        \"countries\": [\n                            {\n                                \"CountryCode\": \"IN\",\n                                \"CountryName\": \"India\"\n                            }\n                        ],\n                        \"campaigns\": [],\n                        \"expectedDealSize\": {\n                            \"band\": null,\n                            \"min\": null,\n                            \"max\": null\n                        }\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"PRODUCT\",\n                    \"status\": \"WARN\",\n                    \"title\": \"SaaS Financial Management Services Fusion Cloud Service - 0NL4\",\n                    \"description\": \"This Sales Play focuses on the SaaS Financial Management Services Fusion Cloud Service (0NL4), designed to support financial management needs. Due to product reference ambiguity, the scope may overlap with related Fusion Cloud services, requiring sellers to clarify the exact offering during engagement.\",\n                    \"runtimeCriteria\": [\n                        {\n                            \"displayOrder\": \"2\",\n                            \"rule\": {\n                                \"conditions\": {\n                                    \"anyOf\": [\n                                        {\n                                            \"attribute\": \"ProductGroupId\",\n                                            \"operator\": \"IN\",\n                                            \"value\": [\n                                                300100640601925,\n                                                300100640601773\n                                            ]\n                                        }\n                                    ]\n                                }\n                            },\n                            \"objectName\": \"productGroups\"\n                        }\n                    ],\n                    \"designTimeArtifacts\": {\n                        \"products\": [\n                            {\n                                \"id\": 300100640601925,\n                                \"type\": \"ProductGroup\",\n                                \"name\": \"SaaS - Financial Management Services Fusion Cloud Service - 0NL4\"\n                            },\n                            {\n                                \"id\": 300100640601773,\n                                \"type\": \"ProductGroup\",\n                                \"name\": \"SaaS - Fusion Procurement Cloud Service - 0NL7\"\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"PERSONA\",\n                    \"status\": \"OK\",\n                    \"title\": \"Key Buyer and Stakeholder Roles in Manufacturing Organizations\",\n                    \"description\": \"This Sales Play targets decision-makers and influencers responsible for financial management, IT strategy, and procurement within manufacturing organizations. Primary buyers include Chief Financial Officers (CFOs) who focus on financial planning, budgeting, and compliance. Influential stakeholders include Chief Information Officers (CIOs) and Chief Technology Officers (CTOs) who prioritize technology integration, risk management, and alignment with business objectives. Procurement leaders are also critical, concentrating on vendor selection, contract negotiation, and ensuring procurement processes align with organizational goals.\",\n                    \"designTimeArtifacts\": {\n                        \"personas\": [\n                            {\n                                \"name\": \"Chief Financial Officer (CFO)\",\n                                \"summary\": \"Responsible for overseeing financial planning, budgeting, compliance, and ensuring financial operations support overall business objectives.\",\n                                \"isPrimary\": true\n                            },\n                            {\n                                \"name\": \"Chief Information Officer (CIO)\",\n                                \"summary\": \"Leads IT strategy and governance, focusing on technology alignment with business goals, risk mitigation, and digital transformation initiatives.\",\n                                \"isPrimary\": false\n                            },\n                            {\n                                \"name\": \"Chief Technology Officer (CTO)\",\n                                \"summary\": \"Drives technology innovation and integration, ensuring technical solutions meet organizational requirements and support scalability and security.\",\n                                \"isPrimary\": false\n                            },\n                            {\n                                \"name\": \"Head of Procurement\",\n                                \"summary\": \"Manages vendor relationships, contract negotiations, and procurement processes to optimize cost, compliance, and supplier performance.\",\n                                \"isPrimary\": false\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 300100673465700,\n                    \"type\": \"SALES_MOTION\",\n                    \"status\": \"WARN\",\n                    \"title\": \"Sales Motion linkage for Sales Play targeting manufacturing in India with product 0NL4\",\n                    \"description\": \"This Sales Play is linked to a comprehensive sales motion designed for acquiring large enterprise customers with a focus on rapid qualification, risk and compliance alignment, executive sponsorship, technical validation, and procurement path clarity. However, there is ambiguity in product selection and no matching campaign was found, which may affect the precision and applicability of this sales motion for the intended Sales Play.\",\n                    \"runtimeCriteria\": [\n                        300100673465604\n                    ],\n                    \"designTimeArtifacts\": {\n                        \"salesMotions\": [\n                            {\n                                \"id\": 300100673465604,\n                                \"name\": \"SalesMotion783032306420656\",\n                                \"description\": \"A repeatable sales motion designed to acquire large financial-services enterprise customers in EMEA, targeting CIO and CTO buyers. This motion prioritizes rapid qualification, risk and compliance alignment, executive sponsorship, technical validation, and a clear path to procurement and handoff to delivery teams.\",\n                                \"timeUpdated\": \"2026-04-20T07:28:30.324477Z\",\n                                \"statusCode\": \"ACTIVE\"\n                            }\n                        ]\n                    }\n                },\n                {\n                    \"id\": 1001,\n                    \"type\": \"DOCUMENT\",\n                    \"status\": \"OK\",\n                    \"title\": \"Sales Enablement Materials for SaaS Financial Management Services Fusion Cloud Service Play\",\n                    \"description\": \"This document defines the key sales enablement material sets sellers should use to effectively engage prospects and customers when executing the Sales Play for the SaaS Financial Management Services Fusion Cloud Service. The materials support seller activities aligned to qualification, risk and compliance alignment, executive engagement, technical validation, procurement, and deal handoff.\",\n                    \"designTimeArtifacts\": {\n                        \"materialSets\": [\n                            {\n                                \"id\": 201,\n                                \"name\": \"Qualification and Stakeholder Engagement Materials\",\n                                \"description\": \"Materials to help sellers quickly assess customer fit, identify key stakeholders, and establish initial interest during early qualification conversations.\",\n                                \"status\": \"PENDING\"\n                            },\n                            {\n                                \"id\": 202,\n                                \"name\": \"Risk and Compliance Alignment Resources\",\n                                \"description\": \"Content sets that enable sellers to address regulatory and compliance concerns, demonstrate adherence to financial services standards, and share risk mitigation strategies.\",\n                                \"status\": \"PENDING\"\n                            },\n                            {\n                                \"id\": 203,\n                                \"name\": \"Executive Sponsorship and Strategic Alignment Tools\",\n                                \"description\": \"Briefing decks and value articulation aids designed to secure executive sponsorship and align on strategic business outcomes with CIOs, CTOs, and other executives.\",\n                                \"status\": \"PENDING\"\n                            },\n                            {\n                                \"id\": 204,\n                                \"name\": \"Technical Validation and Proof of Concept Support\",\n                                \"description\": \"Technical workshops, integration guides, and POC enablement materials to validate solution fit and address IT team requirements.\",\n                                \"status\": \"PENDING\"\n                            },\n                            {\n                                \"id\": 205,\n                                \"name\": \"Procurement and Commercial Proposal Kits\",\n                                \"description\": \"Materials to assist sellers in engaging procurement and legal teams, developing tailored commercial proposals, and confirming procurement timelines.\",\n                                \"status\": \"PENDING\"\n                            },\n                            {\n                                \"id\": 206,\n                                \"name\": \"Deal Handoff and Delivery Transition Packages\",\n                                \"description\": \"Comprehensive handoff documents and kickoff meeting guides to ensure smooth transition from sales to delivery and implementation teams.\",\n                                \"status\": \"PENDING\"\n                            }\n                        ]\n                    }\n                }\n            ]\n        }\n}",
