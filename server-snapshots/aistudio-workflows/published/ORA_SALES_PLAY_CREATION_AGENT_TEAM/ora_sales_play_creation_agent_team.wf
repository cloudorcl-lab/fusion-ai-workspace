        },
        {
          "metadata": {
            "name": "Prepare Response 03",
            "returnType": "object",
            "sourceCode": "const authoringResponse = $context.$nodes.PARSE_ARTIFACTS.$output.result.authoringResponse;\nconst artifacts = $context.$nodes.PARSE_ARTIFACTS.$output.result.artifacts;\n\n// PREPARE CHAT HISTORY TO PERSIST\n\nconst chatHistory = $context.$variables.chatHistory === null || $context.$variables.chatHistory === \"\" ? [] :  $context.$variables.chatHistory;\n\nconst historyItem =  {\n  userPrompt: $context.$system.$inputMessage,\n  agentResponse: authoringResponse.agentResponse,\n  userRequest: authoringResponse.userRequest\n}\n\nchatHistory.push(historyItem);\n\n\n// PREPARE salesPlayJSON\n\nconst salesPlayJSON = authoringResponse.salesPlayJSON;\nsalesPlayJSON.artifacts = artifacts;\n\n// PREPARE workflowResponse\n\nconst postback = {salesPlayJSON};\n\nlet responseText = authoringResponse.agentResponse \nif(authoringResponse.userRequest) {\n    responseText = authoringResponse.agentResponse + \"\\n\\n\" + authoringResponse.userRequest;\n}\n\nconst date = new Date($context.$system.$currentDateTime);\nconst readable = date.toLocaleString(\"en-IN\");\n\nconst workflowResponse = {\n  \"type\": \"chip\",\n  \"headerText\": responseText,\n  \"primaryText\": authoringResponse.playTag,\n  \"secondaryText\": readable,\n  \"icon\": \"oj-ux-ico-activity-list\",\n  \"postback\": postback\n}\n\nconst response = {workflowResponse, chatHistory, salesPlayJSON};\nreturn response;"
          },
