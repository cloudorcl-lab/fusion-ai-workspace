        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Append Hierarchy Override",
            "returnType": "object",
            "sourceCode": "const additionalContext = { ...($context.$variables.additionalContext || {}) };\n\nconst getHierarchyWorkflowOutput = () => {\n  const raw = $context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_HIERARCHY_MANAGER?.$output;\n  if (!raw) return {};\n  if (raw.output) {\n    try {\n      return JSON.parse(raw.output);\n    } catch (error) {\n      return {};\n    }\n  }\n  return raw.result || raw;\n};\n\nconst flowOutput = getHierarchyWorkflowOutput();\nconst validTargetAgents = new Set([\n  \"ora_fin_gl_journals_assistant\",\n  \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n  \"ora_fin_gl_subledger_supporting_details_assistant\",\n]);\nconst isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\n\nconst state = {\n  ...($context.$variables.state || {})\n};\n\nif (isRecordObject(flowOutput.hierarchyState)) {\n  state.shared = isRecordObject(state.shared) ? { ...state.shared } : {};\n  state.shared.hierarchy = {\n    ...(isRecordObject(state.shared.hierarchy) ? state.shared.hierarchy : {}),\n    ...flowOutput.hierarchyState\n  };\n}\n\ndelete additionalContext.selectedHierarchies;\n\nif (typeof flowOutput.footerText === \"string\" && flowOutput.footerText !== \"\") {\n  additionalContext.footerText = flowOutput.footerText;\n}\nif (typeof flowOutput.scopeChange === \"string\" && flowOutput.scopeChange !== \"\") {\n  additionalContext.scopeChange = flowOutput.scopeChange;\n}\n\nconst targetAgentOverride =\n  typeof flowOutput.targetAgentOverride === \"string\"\n    ? flowOutput.targetAgentOverride.trim()\n    : \"\";\nconst effectiveRoutingDecision = validTargetAgents.has(targetAgentOverride)\n  ? targetAgentOverride\n  : $context.$variables.routingDecision;\n\nconst parseAiPayload = (item) => {\n  if (!item || typeof item !== \"object\" || Array.isArray(item)) {\n    return {};\n  }\n\n  const text = item.text ?? item.message ?? item.content ?? item.data;\n  if (text && typeof text === \"object\" && !Array.isArray(text)) {\n    return text;\n  }\n\n  if (typeof text === \"string\") {\n    try {\n      const parsedText = JSON.parse(text);\n      return parsedText && typeof parsedText === \"object\" && !Array.isArray(parsedText) ? parsedText : {};\n    } catch (error) {\n      return {};\n    }\n  }\n\n  return {};\n};\n\nconst itemRole = (item) => String(item?.role ?? item?.type ?? item?.author ?? \"\").toLowerCase();\n\nconst itemText = (item) => {\n  const text = item?.text ?? item?.message ?? item?.content ?? item?.data;\n  return typeof text === \"string\" ? text.trim() : \"\";\n};\n\nconst latestUserMessageForAgent = (chatHistory, targetAgent) => {\n  if (!Array.isArray(chatHistory) || !validTargetAgents.has(targetAgent)) {\n    return \"\";\n  }\n\n  for (let index = chatHistory.length - 1; index >= 0; index -= 1) {\n    const item = chatHistory[index];\n    const role = itemRole(item);\n    if (role && role !== \"ai\" && role !== \"assistant\") {\n      continue;\n    }\n\n    if (parseAiPayload(item).agent !== targetAgent) {\n      continue;\n    }\n\n    for (let userIndex = index - 1; userIndex >= 0; userIndex -= 1) {\n      const userItem = chatHistory[userIndex];\n      const userRole = itemRole(userItem);\n      if (userRole && userRole !== \"user\" && userRole !== \"human\") {\n        continue;\n      }\n\n      const userText = itemText(userItem);\n      if (userText) {\n        return userText;\n      }\n    }\n  }\n\n  return \"\";\n};\n\nlet effectiveMessage =\n  typeof $context.$variables.effectiveMessage === \"string\"\n    ? $context.$variables.effectiveMessage\n    : $context.$system.$inputMessage || \"\";\n\nif (flowOutput.shouldRouteToAgents === true && targetAgentOverride) {\n  const lastBusinessAgentTurn = $context.$variables.state?.shared?.lastBusinessAgentTurn;\n  const storedEffectiveMessage =\n    lastBusinessAgentTurn?.agent === effectiveRoutingDecision &&\n    typeof lastBusinessAgentTurn?.effectiveMessage === \"string\"\n      ? lastBusinessAgentTurn.effectiveMessage.trim()\n      : \"\";\n\n  const routedMessage = storedEffectiveMessage || latestUserMessageForAgent(\n      $context.$variables.compactedChatHistory,\n      effectiveRoutingDecision\n    );\n\n  if (routedMessage) {\n    effectiveMessage = routedMessage;\n  }\n}\n\nconst res = {};\nres.additionalContext = additionalContext;\nres.routingDecision = effectiveRoutingDecision;\nres.domainSwitchPath = effectiveRoutingDecision;\nres.effectiveMessage = effectiveMessage;\nres.state = state;\n\nreturn res;\n"
          },
          "outcomes": {
            "success": "1778654758005"
          },
