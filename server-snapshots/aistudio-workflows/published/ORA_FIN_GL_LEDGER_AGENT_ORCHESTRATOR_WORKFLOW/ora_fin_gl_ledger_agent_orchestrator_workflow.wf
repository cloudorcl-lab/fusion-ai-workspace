              "value": "{{$context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_HIERARCHY_MANAGER.$output.output ? JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_HIERARCHY_MANAGER.$output.output).shouldRouteToAgents !== false : true}}"
