        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Construct Context Object 2",
            "returnType": "string",
            "sourceCode": "const input = $context.$variables.effectiveMessage;\nlet additionalContext = {\n  ...($context.$variables.additionalContext ||\n    $context.$triggers.REST.$input.additional_context ||\n    $context.$triggers.REST.$input.additionalContext ||\n    {})\n};\n\nconst ledgerOverride = $context.$variables.ledgerOverride;\n\nif (\n  ledgerOverride &&\n  typeof ledgerOverride === \"object\" &&\n  !Array.isArray(ledgerOverride) &&\n  Object.keys(ledgerOverride).length > 0\n) {\n  additionalContext.ledgerId = ledgerOverride.ledgerId;\n  additionalContext.ledgerContext = ledgerOverride.ledgerName || ledgerOverride.ledgerContext;\n  additionalContext.ledgerCategory = ledgerOverride.ledgerCategory;\n  additionalContext.chartOfAccountsId = ledgerOverride.chartOfAccountsId;\n  additionalContext.analyticView = ledgerOverride.avName || ledgerOverride.analyticView;\n}\n\ndelete additionalContext.selectedHierarchies;\n\nif ( $context.$variables.routingDecision === \"ora_fin_gl_subledger_supporting_details_assistant\" ) {\n  const { analyticView, ...rest } = additionalContext;\n  additionalContext = rest;\n}\n\nif ($context.$variables.routingDecision === \"ora_fin_gl_help_topic_assistant\") {\n  const internalContextKeys = new Set([\n    \"ledgerid\",\n    \"chartofaccountsid\",\n    \"analyticview\",\n    \"processexecutionid\",\n    \"conversationid\"\n  ]);\n\n  additionalContext = Object.fromEntries(\n    Object.entries(additionalContext).filter(\n      ([key]) => !internalContextKeys.has(String(key).toLowerCase())\n    )\n  );\n}\n\nconst context = JSON.stringify(additionalContext);\nconst history = JSON.stringify($context.$variables.compactedChatHistory || []);\n\nreturn \"<USER_MESSAGE>\" + input + \"</USER_MESSAGE>\\n<CONTEXT>\" + context + \"</CONTEXT>\\n<CHAT_HISTORY>\" + history + \"</CHAT_HISTORY>\";"
          },
          "outcomes": {
            "success": "1777419999469"
          },
          "code": "CONSTRUCT_CONTEXT_OBJECT_2",
          "id": "1775738321232",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Get Domain State Code Node",
            "returnType": "object",
            "sourceCode": "const state = $context.$variables.state || {\n    \"lastUsedAgent\": [],\n    \"domains\": {\n        \"ora_fin_gl_journals_assistant\": {},\n        \"ora_fin_gl_balance_inquiry_and_analysis_assistant\": {},\n        \"ora_fin_gl_financial_reporting_assistant\": {},\n        \"ora_fin_gl_subledger_supporting_details_assistant\": {},\n        \"ora_fin_gl_general_ledger_functions_assistant\": {},\n        \"ora_fin_fun_insights_assistant\": {},\n        \"ora_fin_gl_process_exceptions_assistant\": {},\n        \"ora_fin_gl_export_to_excel_assistant\": {},\n        \"ora_fin_gl_hierarchy_manager_assistant\": {},\n        \"ora_fin_gl_help_topic_assistant\": {}\n    },\n    \"shared\": {}\n};\n\nconst agentHistoryArr = state?.lastUsedAgent;\n\nconst findLatestExportAgent = (lastUsedAgentArr) => {\n    const exportEnabledAgents = new Set(['ora_fin_gl_journals_assistant', 'ora_fin_gl_balance_inquiry_and_analysis_assistant', 'ora_fin_gl_subledger_supporting_details_assistant','ora_fin_gl_process_exceptions_assistant'])\n\n    if(lastUsedAgentArr){\n        for (const agent of lastUsedAgentArr.toReversed()){\n            if(exportEnabledAgents.has(agent)){\n                return agent;\n            }\n        }\n    }\n    return undefined;\n};\n\nlet domainSlice;\nif($context.$variables.routingDecision === 'ora_fin_gl_export_to_excel_assistant'){\n    const agent = findLatestExportAgent(agentHistoryArr);\n\n    domainSlice = agent === undefined? {} : {\n        shared: state?.shared || {},\n        private: state?.domains?.[agent] || {}\n    };\n}\nelse{\n    domainSlice = {\n        shared: state.shared,\n        private: state.domains[ $context.$variables.routingDecision ],\n        // displayedColumns: state?.domains?.[`${$context.$variables.routingDecision}_displayColumns`]?.displayed\n    };\n}\n\nconst result = {\n    domainSlice: domainSlice,\n    routingDecision: $context.$variables.routingDecision\n};\n\nconst llmFlagsOutput =  $context.$nodes?.LLM_FLAGS?.$output;\nif(llmFlagsOutput && llmFlagsOutput?.potentialPresentationChangeOnly){\n    result.potentialPresentationChangeOnly = llmFlagsOutput.potentialPresentationChangeOnly;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1778359962105"
          },
