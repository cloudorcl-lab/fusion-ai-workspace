              "value": "You are a strict subledger selector for a Subledger Supporting Assistant in the Oracle Fusion Financials General Ledger and Subledger Accounting context.\n\nYour job is to select the single best-matching subledger from $CANDIDATES.\n\nReturn exactly one minified JSON object and nothing else.\n\n## Inputs\n\n$CHAT_HISTORY:\n{{$context.$variables.compactedChatHistory}}\n\n$USER_INPUT:\n{{$context.$variables.effectiveMessage}}\n\n$PRIOR_SUBLEDGER:\n{{$context.$nodes.GET_DOMAIN_STATE_CODE_NODE.$output.result.domainSlice?.private?.lastUsedQuery?.selectedSubledgerKey || \"\"}}\n\n$CANDIDATES:\n\n0. Payables\n\n1. Receivables\n\n## Goal\n\nChoose the single best subledger for the current request.\n\n## Selection Rules\n\n1. Use only the listed candidates.\n2. Use $CHAT_HISTORY only to resolve underspecified follow-up context. $CHAT_HISTORY is ordered in chronological order.\n3. Explicit user input has priority over prior context.\n4. Prefer $PRIOR_SUBLEDGER when the latest message is a follow-up and it still matches one of the listed candidates, unless the latest message contains strong cues that another listed subledger is intended.\n5. For a sort/order-only follow-up with no explicit Payables or Receivables cue, select $PRIOR_SUBLEDGER: `payables` means index 0 and `receivables` means index 1.\n6. Do not switch subledgers based on weak or generic wording. Switch only when the current request clearly names or strongly implies another candidate.\n7. If the request is ambiguous or cannot be mapped to a listed subledger, set selectedIndex to -1 and write a short user-facing followupMessage asking for the missing clarification.\n8. The followupMessage should be non-technical.\n\n## Output Schema\n\nReturn exactly:\n{\"selectedIndex\":<zero-based integer index or -1>,\"followupMessage\":\"<empty string unless clarification is needed>\"}\n\n## Hard Rules\n\n- Output valid JSON only\n- Output exactly one object\n- Include exactly the keys selectedIndex and followupMessage\n- selectedIndex must be an integer\n- followupMessage must be a string\n- No markdown\n- No explanation\n- No trailing text\n- No nulls"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Process Multi Table LLM Output",
            "returnType": "object",
            "sourceCode": "const renderData = $context.$nodes.SUBLEDGER_RAW_DATA_PRE_PROCESSOR.$output.result.renderData || new Object();\nconst groups = Array.isArray(renderData.groups) ? renderData.groups : [];\nconst viewType = renderData.viewType;\nconst llmOutput = $context.$nodes.SUBLEDGER_MULTI_TABLE_LLM.$output;\nconst llmTables = Array.isArray(llmOutput?.tables) ? llmOutput.tables : [];\nconst lastUsedData = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData || new Object();\nconst sourceKeyOrder = lastUsedData.keyOrder;\nconst queryResponse = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state?.private?.lastUsedQuery?.queryResponse;\nconst chartOfAccountsSegments =\n    lastUsedData.dataResponse?.avExtractResult?.metadata?.chartOfAccounts?.segments ||\n    queryResponse?.metadata?.chartOfAccounts?.segments ||\n    new Object();\n\nconst escapeHtml = (value) => String(value ?? \"\")\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#39;\");\n\nconst titleCase = (value) => String(value ?? \"\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_\\s]+/g, \" \")\n    .trim()\n    .split(\" \")\n    .filter(Boolean)\n    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n    .join(\" \");\n\nconst isBlank = (value) => value === null || value === undefined || String(value).trim() === \"\";\nconst isCurrencyColumn = (column) => String(column ?? \"\").toLowerCase().includes(\"currency\");\n\nconst toIsoDate = (value) => {\n    const text = String(value ?? \"\").trim();\n\n    if (text === \"\") {\n        return \"\";\n    }\n\n    if (/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)-\\d{2,4}$/i.test(text) || /^Qtr[1-4]-\\d{2,4}$/i.test(text) || /^\\d{4}(-\\d{1,2})?$/.test(text)) {\n        return \"\";\n    }\n\n    const date = new Date(text);\n\n    if (Number.isNaN(date.getTime())) {\n        return \"\";\n    }\n\n    return date.toISOString().slice(0, 10);\n};\n\nconst normalizeColumnName = (column, group) => {\n    if (group?.segmentLabels?.[column]) {\n        return group.segmentLabels[column];\n    }\n\n    if (group?.columnLabels?.[column]) {\n        return group.columnLabels[column];\n    }\n\n    let name = String(column ?? \"\")\n        .replace(/^periodNetBalance/, \"Period Activity\")\n        .replace(/^periodActivity/, \"Period Activity\")\n        .replace(/^quarterActivity/, \"Quarter Activity\")\n        .replace(/^yearActivity/, \"Year Activity\")\n        .replace(/^beginBalance/, \"Beginning Balance\")\n        .replace(/^variancePercent$/, \"Variance %\")\n        .replace(/^netUnroundedEnteredAmount$/, \"Net Entered Amount\")\n        .replace(/^netUnroundedAccountedAmount$/, \"Net Accounted Amount\");\n\n    const abbreviations = [];\n    const abbreviationRules = [\n        [/QtdQr|Qtd/gi, \"QTD\"],\n        [/YtdYr|Ytd/gi, \"YTD\"],\n        [/PtdPr|Ptd/gi, \"PTD\"]\n    ];\n\n    for (const [pattern, label] of abbreviationRules) {\n        if (pattern.test(name)) {\n            abbreviations.push(label);\n            name = name.replace(pattern, \"\");\n        }\n    }\n\n    const periodMatch = name.match(/(Jan-\\d{2,4}|Feb-\\d{2,4}|Mar-\\d{2,4}|Apr-\\d{2,4}|May-\\d{2,4}|Jun-\\d{2,4}|Jul-\\d{2,4}|Aug-\\d{2,4}|Sep-\\d{2,4}|Oct-\\d{2,4}|Nov-\\d{2,4}|Dec-\\d{2,4}|Qtr[1-4]-\\d{2,4}|\\d{4})$/i);\n    const period = periodMatch ? periodMatch[0] : \"\";\n\n    if (period) {\n        name = name.slice(0, -period.length);\n    }\n\n    return [titleCase(name), ...abbreviations, period]\n        .filter(Boolean)\n        .join(\" \");\n};\n\nconst formatDateColumnValue = (column, value) => {\n    if (!String(column ?? \"\").toLowerCase().includes(\"date\")) {\n        return value;\n    }\n\n    const isoDate = toIsoDate(value);\n\n    return isoDate ? `{date:${isoDate}}` : value;\n};\n\nconst getDescriptionColumn = (row, column) => {\n    const exactDescriptionColumn = `${column}Description`;\n\n    if (Object.prototype.hasOwnProperty.call(row || new Object(), exactDescriptionColumn)) {\n        return exactDescriptionColumn;\n    }\n\n    return \"\";\n};\n\nconst hasDescriptionColumn = (row, column) => getDescriptionColumn(row, column) !== \"\";\n\nconst getDescriptionValue = (row, column) => {\n    const descriptionColumn = getDescriptionColumn(row, column);\n\n    return descriptionColumn ? row?.[descriptionColumn] : undefined;\n};\n\nconst formatMemberValue = (row, column) => {\n    const columnValue = row?.[column];\n    const columnDescription = getDescriptionValue(row, column);\n\n    if (isBlank(columnValue)) {\n        return isBlank(columnDescription) ? \"\" : columnDescription;\n    }\n\n    if (isBlank(columnDescription) || String(columnDescription) === String(columnValue)) {\n        return columnValue;\n    }\n\n    return `${columnValue}-${columnDescription}`;\n};\n\nconst getMappedCurrencyColumn = (column, measureCurrencies) => {\n    const candidateKeys = [\n        column,\n        String(column ?? \"\").toUpperCase()\n    ];\n\n    for (const candidateKey of candidateKeys) {\n        if (Object.prototype.hasOwnProperty.call(measureCurrencies, candidateKey)) {\n            return measureCurrencies[candidateKey];\n        }\n    }\n\n    return \"\";\n};\n\nconst getFallbackCurrencyColumn = (column, group) => {\n    const lowerColumn = String(column ?? \"\").toLowerCase();\n    const hiddenCurrencyColumns = Array.isArray(group.hiddenCurrencyColumns) ? group.hiddenCurrencyColumns : [];\n\n    if (lowerColumn.includes(\"entered\")) {\n        const enteredCurrencyColumn = hiddenCurrencyColumns.find((currencyColumn) => String(currencyColumn ?? \"\").toLowerCase().includes(\"entered\"));\n\n        return enteredCurrencyColumn || \"\";\n    }\n\n    if (lowerColumn.includes(\"accounted\") || lowerColumn.includes(\"ledger\")) {\n        const ledgerCurrencyColumn = hiddenCurrencyColumns.find((currencyColumn) => {\n            const lowerCurrencyColumn = String(currencyColumn ?? \"\").toLowerCase();\n\n            return lowerCurrencyColumn.includes(\"ledger\") || lowerCurrencyColumn.includes(\"accounted\");\n        });\n\n        return ledgerCurrencyColumn || \"\";\n    }\n\n    return \"\";\n};\n\nconst getCurrencyColumn = (column, group, measureCurrencies) => {\n    const mappedCurrencyColumn = getMappedCurrencyColumn(column, measureCurrencies);\n\n    if (!isBlank(mappedCurrencyColumn)) {\n        return mappedCurrencyColumn;\n    }\n\n    return getFallbackCurrencyColumn(column, group);\n};\n\nconst isNumericAmount = (value) => {\n    const amount = String(value ?? \"\").replaceAll(\",\", \"\").trim();\n\n    return amount !== \"\" && !Number.isNaN(Number(amount));\n};\n\nconst requiresVisibleCurrencyColumn = (rows, measureColumn, currencyColumn) => {\n    const currencies = new Set();\n\n    for (const row of rows) {\n        if (!isNumericAmount(row?.[measureColumn])) {\n          continue;\n        }\n\n        const currency = String(row?.[currencyColumn] ?? \"\").trim();\n\n        if (currency === \"\") {\n            return true;\n        }\n\n        currencies.add(currency);\n\n        if (currencies.size > 1) {\n            return true;\n        }\n    }\n\n    return false;\n};\n\nconst injectMixedCurrencyColumns = (columns, rows, group, measureCurrencies) => {\n    const currencyColumnsToInject = new Set();\n\n    for (const column of columns) {\n        if (!isMeasureColumn(column, group)) {\n            continue;\n        }\n\n        const currencyColumn = getCurrencyColumn(column, group, measureCurrencies);\n\n        if (!isBlank(currencyColumn) && requiresVisibleCurrencyColumn(rows, column, currencyColumn)) {\n            currencyColumnsToInject.add(currencyColumn);\n        }\n    }\n\n    if (currencyColumnsToInject.size === 0) {\n        return columns;\n    }\n\n    const columnsWithoutInjectedCurrencies = columns.filter((column) => !currencyColumnsToInject.has(column));\n    const injectedCurrencyColumns = new Set();\n    const columnsWithCurrencies = [];\n\n    for (const column of columnsWithoutInjectedCurrencies) {\n        const currencyColumn = isMeasureColumn(column, group)\n            ? getCurrencyColumn(column, group, measureCurrencies)\n            : \"\";\n\n        if (currencyColumnsToInject.has(currencyColumn) && !injectedCurrencyColumns.has(currencyColumn)) {\n            columnsWithCurrencies.push(currencyColumn);\n            injectedCurrencyColumns.add(currencyColumn);\n        }\n\n        columnsWithCurrencies.push(column);\n    }\n\n    return columnsWithCurrencies;\n};\n\nconst formatAmount = (row, column, group, measureCurrencies) => {\n    const rawAmount = String(row?.[column] ?? \"\").replaceAll(\",\", \"\").trim();\n\n    if (rawAmount === \"\" || Number.isNaN(Number(rawAmount))) {\n        return \"-\";\n    }\n\n    const currencyColumn = getCurrencyColumn(column, group, measureCurrencies);\n    const currency = isBlank(currencyColumn) ? \"\" : row?.[currencyColumn];\n\n    if (isBlank(currency)) {\n        return rawAmount;\n    }\n\n    return `{amount:${Number(rawAmount).toFixed(2)},currency:${currency}}`;\n};\n\nconst isMeasureColumn = (column, group) => Array.isArray(group.availableMeasureColumns) && group.availableMeasureColumns.includes(column);\n\nconst formatColumnValue = (row, column, group) => {\n    if (isCurrencyColumn(column)) {\n        return row?.[column] ?? \"\";\n    }\n\n    if (group?.segmentLabels?.[column] || hasDescriptionColumn(row, column)) {\n        return formatDateColumnValue(column, formatMemberValue(row, column));\n    }\n\n    return formatDateColumnValue(column, row?.[column]);\n};\n\nconst formatCellValue = (row, column, group, measureCurrencies) => {\n    if (isMeasureColumn(column, group)) {\n        return formatAmount(row, column, group, measureCurrencies);\n    }\n\n    return formatColumnValue(row, column, group);\n};\n\nconst getRowsForGroup = (group) => {\n    if (viewType === \"analyticView\") {\n        const childRows = Array.isArray(group.childRows) ? group.childRows : [];\n\n        if (childRows.length > 0) {\n            return childRows;\n        }\n\n        return Array.isArray(group.currentRows) ? group.currentRows : [];\n    }\n\n    return Array.isArray(group.rows) ? group.rows : [];\n};\n\nconst isSourceKeyOrderObject = () =>\n    sourceKeyOrder && typeof sourceKeyOrder === \"object\" && !Array.isArray(sourceKeyOrder);\n\nconst getBusinessViewSourceOrder = (groupId) => {\n    if (!isSourceKeyOrderObject()) {\n        return [];\n    }\n\n    const rawGroupId = String(groupId || \"\");\n    const withoutData = rawGroupId.endsWith(\"Data\") ? rawGroupId.slice(0, -\"Data\".length) : rawGroupId;\n    const withData = rawGroupId.endsWith(\"Data\") ? rawGroupId : `${rawGroupId}Data`;\n\n    if (Array.isArray(sourceKeyOrder[withoutData])) {\n        return sourceKeyOrder[withoutData];\n    }\n\n    if (Array.isArray(sourceKeyOrder[withData])) {\n        return sourceKeyOrder[withData];\n    }\n\n    return [];\n};\n\nconst getAnalyticViewSourceOrder = (groupId) => {\n    if (!isSourceKeyOrderObject()) {\n        return [];\n    }\n\n    const normalizedGroupId = String(groupId || \"\").toLowerCase();\n\n    if (normalizedGroupId.startsWith(\"primary\")) {\n        return Array.isArray(sourceKeyOrder.primary) ? sourceKeyOrder.primary : [];\n    }\n\n    if (normalizedGroupId.startsWith(\"secondary\")) {\n        return Array.isArray(sourceKeyOrder.secondary) ? sourceKeyOrder.secondary : [];\n    }\n\n    return [];\n};\n\nconst getSourceOrderForGroup = (group) =>\n    viewType === \"businessView\"\n        ? getBusinessViewSourceOrder(group?.groupId)\n        : getAnalyticViewSourceOrder(group?.groupId);\n\nconst getCoaSegmentsForColumn = (column) => {\n    const directSegment = chartOfAccountsSegments?.[column];\n\n    if (directSegment) {\n        return [directSegment];\n    }\n\n    return Object.values(chartOfAccountsSegments || new Object())\n        .filter((segment) => segment?.dimensionName === column);\n};\n\nconst isCoaSegmentColumn = (column) => getCoaSegmentsForColumn(column).length > 0;\n\nconst isGlBalancingSegmentColumn = (column) => getCoaSegmentsForColumn(column)\n    .some((segment) => {\n        const qualifiers = Array.isArray(segment?.qualifiers) ? segment.qualifiers : [];\n\n        return qualifiers.includes('GL_BALANCING');\n    });\n\nconst applyPriorityColumnOrdering = (columns) => {\n    if (!Array.isArray(columns) || columns.length === 0) {\n        return columns;\n    }\n\n    const ledgerColumns = columns.filter((column) => column === 'ledger');\n    const glBalancingColumns = columns.filter((column) => column !== 'ledger' && isGlBalancingSegmentColumn(column));\n    const otherCoaSegmentColumns = columns.filter((column) =>\n        column !== 'ledger' &&\n        !isGlBalancingSegmentColumn(column) &&\n        isCoaSegmentColumn(column)\n    );\n    const priorityColumnSet = new Set([...ledgerColumns, ...glBalancingColumns, ...otherCoaSegmentColumns]);\n    const otherColumns = columns.filter((column) => !priorityColumnSet.has(column));\n\n    return [...ledgerColumns, ...glBalancingColumns, ...otherCoaSegmentColumns, ...otherColumns];\n};\n\nconst orderColumnsBySource = (columns, group) => {\n    const groupSourceOrder = getSourceOrderForGroup(group);\n\n    if (!Array.isArray(groupSourceOrder) || groupSourceOrder.length === 0) {\n        return applyPriorityColumnOrdering(columns);\n    }\n\n    const selectedColumnSet = new Set(columns);\n    const orderedColumns = [];\n    const usedColumns = new Set();\n\n    for (const column of groupSourceOrder) {\n        if (selectedColumnSet.has(column) && !usedColumns.has(column)) {\n            orderedColumns.push(column);\n            usedColumns.add(column);\n        }\n    }\n\n    for (const column of columns) {\n        if (!usedColumns.has(column)) {\n            orderedColumns.push(column);\n            usedColumns.add(column);\n        }\n    }\n\n    return applyPriorityColumnOrdering(orderedColumns);\n};\n\nconst applyUserColumnOrdering = (columns, orderedUserColumns, group) => {\n    const baselineColumns = Array.isArray(columns) ? columns : [];\n\n    if (!Array.isArray(orderedUserColumns) || orderedUserColumns.length === 0) {\n        return baselineColumns;\n    }\n\n    const availableColumns = new Set(baselineColumns);\n    const orderedColumns = [];\n    const usedColumns = new Set();\n\n    for (const column of orderedUserColumns) {\n        const normalizedColumn = String(column ?? \"\");\n        const lowerColumn = normalizedColumn.toLowerCase();\n        const isEligible =\n            availableColumns.has(column) &&\n            !isMeasureColumn(column, group) &&\n            normalizedColumn !== \"rowIndex\" &&\n            !lowerColumn.includes(\"currency\") &&\n            !lowerColumn.endsWith(\"sign\") &&\n            !lowerColumn.includes(\"treefilter\") &&\n            !lowerColumn.includes(\"levelname\");\n\n        if (isEligible && !usedColumns.has(column)) {\n            orderedColumns.push(column);\n            usedColumns.add(column);\n        }\n    }\n\n    for (const column of baselineColumns) {\n        if (!usedColumns.has(column)) {\n            orderedColumns.push(column);\n        }\n    }\n\n    return orderedColumns;\n};\n\nconst getColumnsToDisplay = (plan, group) => {\n    if (!Array.isArray(plan?.columns)) {\n        return [];\n    }\n\n    const availableColumns = new Set(Array.isArray(group.availableColumns) ? group.availableColumns : []);\n    const columnsToDisplay = [];\n    const seenColumns = new Set();\n\n    for (const column of plan.columns) {\n        if (!availableColumns.has(column) || seenColumns.has(column)) {\n            continue;\n        }\n\n        columnsToDisplay.push(column);\n        seenColumns.add(column);\n    }\n\n    const baselineColumns = orderColumnsBySource(columnsToDisplay, group);\n\n    return applyUserColumnOrdering(baselineColumns, plan?.orderedUserColumns, group);\n};\n\nconst buildTableHtml = (group, plan) => {\n    const plannedColumnsToDisplay = getColumnsToDisplay(plan, group);\n    const rowsToExclude = Array.isArray(plan?.rowsToExclude) ? plan.rowsToExclude : [];\n    const excludedRows = new Set(rowsToExclude.map(String));\n    const rows = getRowsForGroup(group).filter((row) => !excludedRows.has(String(row.rowIndex)));\n    const measureCurrencies = plan?.measureCurrencies && typeof plan.measureCurrencies === \"object\" && !Array.isArray(plan.measureCurrencies) ? plan.measureCurrencies : new Object();\n    const columnsToDisplay = injectMixedCurrencyColumns(plannedColumnsToDisplay, rows, group, measureCurrencies);\n\n    if (rows.length === 0 || columnsToDisplay.length === 0) {\n        return \"\";\n    }\n\n    const headers = columnsToDisplay\n        .map((column) => `<th>${escapeHtml(normalizeColumnName(column, group))}</th>`)\n        .join(\"\");\n    const body = rows\n        .map((row) => {\n            const cells = columnsToDisplay\n                .map((column) => `<td>${escapeHtml(formatCellValue(row, column, group, measureCurrencies))}</td>`)\n                .join(\"\");\n\n            return `<tr>${cells}</tr>`;\n        })\n        .join(\"\");\n\n    return `<table><thead><tr>${headers}</tr></thead><tbody>${body}</tbody></table>`;\n};\n\nconst getPlansByGroupId = () => {\n    const plansByGroupId = new Object();\n\n    for (const tablePlan of llmTables) {\n        if (!tablePlan?.groupId || Object.prototype.hasOwnProperty.call(plansByGroupId, tablePlan.groupId)) {\n            continue;\n        }\n\n        plansByGroupId[tablePlan.groupId] = tablePlan;\n    }\n\n    return plansByGroupId;\n};\n\nconst getGroupsByGroupId = () => {\n    const groupsByGroupId = new Object();\n\n    for (const group of groups) {\n        if (!group?.groupId || Object.prototype.hasOwnProperty.call(groupsByGroupId, group.groupId)) {\n            continue;\n        }\n\n        groupsByGroupId[group.groupId] = group;\n    }\n\n    return groupsByGroupId;\n};\n\nconst appendDisplayObjects = (displayObjects, group, plan) => {\n    const summary = String(plan.summary ?? \"\").trim();\n\n    if (summary !== \"\" && summary !== \"<p></p>\") {\n        const summaryObject = {\n            display_type: \"text\",\n            data: summary\n        };\n        displayObjects.push(summaryObject);\n    }\n\n    const tableHtml = buildTableHtml(group, plan);\n\n    if (tableHtml !== \"\") {\n        const tableObject = {\n            display_type: \"table\",\n            data: tableHtml\n        };\n        displayObjects.push(tableObject);\n    }\n};\n\nconst getIntentDetailLabel = (key, segments = new Object()) => {\n    const trimmedKey = String(key ?? \"\").trim();\n    const label = segments?.[trimmedKey]?.label;\n\n    if (typeof label === \"string\" && label.trim()) {\n        return label;\n    }\n\n    if (trimmedKey === \"ledger\") {\n        return \"Ledger\";\n    }\n\n    if (trimmedKey === \"currency\") {\n        return \"Currency\";\n    }\n\n    if (trimmedKey === \"accountingPeriod\") {\n        return \"Accounting Period\";\n    }\n\n    return trimmedKey;\n};\n\nconst isDataSourceKey = (key) => key === \"Data Source\" || key === \"Source\";\n\nconst formatIntentDetails = (intentDetails, segments = new Object()) => {\n    if (typeof intentDetails === \"string\") {\n        return intentDetails;\n    }\n\n    const items = [];\n    let dataSourceItem = \"\";\n\n    if (intentDetails && typeof intentDetails === \"object\" && !Array.isArray(intentDetails)) {\n        for (const [key, value] of Object.entries(intentDetails)) {\n            const label = getIntentDetailLabel(key, segments);\n            const displayValue = value && typeof value === \"object\" ? JSON.stringify(value) : value;\n\n            if (isDataSourceKey(key)) {\n                dataSourceItem = `<li>Data Source: ${escapeHtml(displayValue)}</li>`;\n                continue;\n            }\n\n            items.push(`<li>${escapeHtml(label)}: ${escapeHtml(displayValue)}</li>`);\n        }\n    }\n\n    if (dataSourceItem) {\n        items.unshift(dataSourceItem);\n    }\n\n    return items.length > 0 ? `<ul>${items.join(\"\")}</ul>` : \"\";\n};\n\nconst insertHierarchyResolverMessageAfterContext = (displayObjects, hierarchyResolverMessage) => {\n    const message = String(hierarchyResolverMessage ?? \"\").trim();\n    if (!message) {\n        return;\n    }\n\n    const messageObject = {\n        display_type: \"text\",\n        data: `<p>${escapeHtml(message)}</p>`\n    };\n    const contextIndex = displayObjects.findIndex((item) => item?.display_type === \"collapsible\" && item?.headerText === \"Context\");\n    if (contextIndex >= 0) {\n        const contextObject = displayObjects[contextIndex];\n        contextObject.content = Array.isArray(contextObject.content) ? contextObject.content : [];\n        contextObject.content.push(messageObject);\n        return;\n    }\n    displayObjects.unshift(messageObject);\n};\n\nconst getFooterMessages = () => {\n    const messages = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.messages;\n    return (Array.isArray(messages) ? messages : [])\n        .filter((message) =>\n            message &&\n            typeof message === \"object\" &&\n            String(message.placement ?? \"\").toLowerCase() === \"footer\" &&\n            typeof message.text === \"string\" &&\n            message.text.trim() !== \"\"\n        );\n};\n\nconst appendFooterMessages = (displayObjects) => {\n    for (const message of getFooterMessages()) {\n        displayObjects.push({\n            display_type: \"text\",\n            data: `<p>${escapeHtml(message.text)}</p>`\n        });\n    }\n};\nconst hasMoreSubledgerData = (dataResponse) =>\n    Object.values(dataResponse || new Object()).some((tableData) =>\n        tableData?.hasMore === true\n    ) ||\n    dataResponse?.avExtractResult?.hasMore === true ||\n    dataResponse?.avExtractResult?.ledgerLevelAvData?.some((ledgerLevel) =>\n        Object.values(ledgerLevel || new Object()).some((levelData) =>\n            levelData?.hasMore === true\n        )\n    ) === true;\n\nconst plansByGroupId = getPlansByGroupId();\nconst groupsByGroupId = getGroupsByGroupId();\nconst renderedGroupIds = new Set();\nconst displayObjects = [];\n\nfor (const tablePlan of llmTables) {\n    const group = groupsByGroupId[tablePlan?.groupId];\n\n    if (!group || renderedGroupIds.has(group.groupId)) {\n        continue;\n    }\n\n    appendDisplayObjects(displayObjects, group, tablePlan);\n    renderedGroupIds.add(group.groupId);\n}\n\nfor (const group of groups) {\n    const plan = plansByGroupId[group.groupId];\n\n    if (!plan || renderedGroupIds.has(group.groupId)) {\n        continue;\n    }\n\n    appendDisplayObjects(displayObjects, group, plan);\n    renderedGroupIds.add(group.groupId);\n}\n\nif (displayObjects.length === 0) {\n    const fallbackObject = {\n        display_type: \"text\",\n        data: \"There was an error processing your request. Please try again.\"\n    };\n    displayObjects.push(fallbackObject);\n}\nelse if (hasMoreSubledgerData($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state?.private?.lastUsedData?.dataResponse)) {\n    const actionObject = {\n        display_type: \"action\",\n        data: [\"Export to Excel\"]\n    };\n    displayObjects.push(actionObject);\n}\n\nconst hierarchyResolverMessage =\n    String($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.hierarchyResolverMessage ?? \"\").trim() ||\n    String(queryResponse?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\nconst intentDetails = queryResponse?.queries?.[0]?.intentDetails;\nconst segments = queryResponse?.metadata?.chartOfAccounts?.segments || new Object();\nconst intentDetailsContent = formatIntentDetails(intentDetails, segments);\n\nif (intentDetailsContent) {\n    const collapsibleIntent = {\n        display_type: \"collapsible\",\n        headerText: \"Context\",\n        content: [{ display_type: \"text\", data: intentDetailsContent }],\n        expanded: \"false\"\n    };\n    displayObjects.unshift(collapsibleIntent);\n}\n\ninsertHierarchyResolverMessageAfterContext(displayObjects, hierarchyResolverMessage);\nappendFooterMessages(displayObjects);\n\nreturn displayObjects;"
          },
          "outcomes": {
            "success": "1778713901611"
          },
          "code": "PROCESS_MULTI_TABLE_LLM_OUTPUT",
