        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Merge Balance Rows",
            "returnType": "object",
            "sourceCode": "const res = {};\n\n// const shouldMergeRows = !($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName !== 'ora_fin_gl_balance_inquiry_and_analysis_assistant' || ($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName === 'ora_fin_gl_balance_inquiry_and_analysis_assistant' && $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state?.private?.lastUsedData?.dataPayload?.varianceColumn === 'accountingPeriod.$memberName'));\n// 14/07/2026 Commenting the above line as per new ux requirement\nconst shouldMergeRows = false;\n\nif (shouldMergeRows) {\n  let measureAliases = Object.keys($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private?.lastUsedData?.dataPayload?.queries?.[0]?.analyticViews?.avUsage1?.measureAliases || {});\n  if (measureAliases && measureAliases.length > 0) {\n    const rawData = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse;\n    const viewType = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery.analyticViewNameUsed ? \"analyticView\" : \"businessView\";\n    const viewName = viewType === \"analyticView\" ? $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery.analyticViewNameUsed : $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery.businessViewNameUsed;\n    let isVarianceData = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataPayload?.varianceColumn === 'accountingPeriod.$memberName';\n    // let measureAliases = [\"endingBalance\", \"beginBalance\"];\n\n\n    const isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\n    const hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(object, key);\n\n    const measureColumnPrefixes = [\"entered\", \"accounted\"];\n\n    const stripMeasureColumnPrefix = (key) => {\n      const keyText = String(key ?? \"\");\n\n      for (const prefix of measureColumnPrefixes) {\n        const nextCharacter = keyText.charAt(prefix.length);\n\n        if (keyText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n          return nextCharacter.toLowerCase() + keyText.slice(prefix.length + 1);\n        }\n      }\n\n      return keyText;\n    };\n\n    const hasMeasureAlias = (key, aliases = measureAliases) => {\n      const keyWithoutMeasurePrefix = stripMeasureColumnPrefix(key);\n\n      return aliases.some((alias) => {\n        if (!keyWithoutMeasurePrefix.startsWith(alias)) {\n          return false;\n        }\n\n        const suffix = keyWithoutMeasurePrefix.slice(alias.length);\n        return suffix === \"\" || !suffix.startsWith(\"Sign\");\n      });\n    };\n\n    const isKnownBalanceMeasureKey = (key) => {\n      const lowerMeasureKey = stripMeasureColumnPrefix(key).toLowerCase();\n\n      return lowerMeasureKey.startsWith(\"endingbalance\")\n        || lowerMeasureKey.startsWith(\"beginbalance\")\n        || lowerMeasureKey.startsWith(\"periodnetbalance\")\n        || lowerMeasureKey.startsWith(\"periodactivity\");\n    };\n\n    const isMeasureSignKey = (key, aliases = measureAliases) => key.endsWith(\"Sign\")\n      && (hasMeasureAlias(key.slice(0, -4), aliases) || isKnownBalanceMeasureKey(key.slice(0, -4)));\n\n    const isMeasureKey = (key, aliases = measureAliases) => (hasMeasureAlias(key, aliases) || isKnownBalanceMeasureKey(key)) && !isMeasureSignKey(key, aliases);\n\n    const accountingPeriodKeys = [\"period\", \"accountingPeriod\", \"quarter\", \"year\"];\n\n    const getAccountingPeriodValue = (row) => {\n      const accountingPeriodKey = accountingPeriodKeys.find((key) => hasOwn(row, key));\n      const accountingPeriod = accountingPeriodKey ? row[accountingPeriodKey] : undefined;\n      return isObject(accountingPeriod) ? accountingPeriod.value : accountingPeriod;\n    };\n\n    const isAccountingPeriodKey = (key) => accountingPeriodKeys.includes(key) || key.startsWith(\"accountingPeriod\");\n\n    const formatPeriodSuffix = (period) => String(period ?? \"\").replace(/[^A-Za-z0-9]/g, \"\");\n\n    const titleCase = (value) => String(value)\n      .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n      .replace(/[_\\s]+/g, \" \")\n      .trim()\n      .split(\" \")\n      .filter(Boolean)\n      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n      .join(\" \");\n\n    const getMeasurePrefixLabel = (measureKey) => {\n      const measureKeyText = String(measureKey ?? \"\");\n\n      for (const prefix of measureColumnPrefixes) {\n        const nextCharacter = measureKeyText.charAt(prefix.length);\n\n        if (measureKeyText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n          return titleCase(prefix);\n        }\n      }\n\n      return \"\";\n    };\n\n    const getBalanceMeasureBaseLabel = (measureKey) => {\n      const measureKeyWithoutPrefix = stripMeasureColumnPrefix(measureKey);\n      const lowerMeasureKey = measureKeyWithoutPrefix.toLowerCase();\n      let baseLabel = \"\";\n\n      if (lowerMeasureKey.startsWith(\"endingbalance\")) {\n        baseLabel = \"Ending Balance\";\n      } else if (lowerMeasureKey.startsWith(\"beginbalance\")) {\n        baseLabel = \"Beginning Balance\";\n      } else if (lowerMeasureKey.startsWith(\"periodnetbalance\") || lowerMeasureKey.startsWith(\"periodactivity\")) {\n        baseLabel = \"Period Activity\";\n      } else if (lowerMeasureKey.startsWith(\"quarteractivity\")) {\n        baseLabel = \"Quarter Activity\";\n      } else if (lowerMeasureKey.startsWith(\"yearactivity\")) {\n        baseLabel = \"Year Activity\";\n      }\n\n      if (baseLabel === \"\") {\n        return \"\";\n      }\n\n      if (lowerMeasureKey.includes(\"debit\")) {\n        return `${baseLabel} Debit`;\n      }\n\n      if (lowerMeasureKey.includes(\"credit\")) {\n        return `${baseLabel} Credit`;\n      }\n\n      return baseLabel;\n    };\n\n    const normalizeMeasureName = (measureKey) => getBalanceMeasureBaseLabel(measureKey) || stripMeasureColumnPrefix(measureKey)\n      .replace(/^variancePercent$/, \"Variance %\")\n      .replace(/^netUnroundedEnteredAmount$/, \"Net Entered Amount\")\n      .replace(/^netUnroundedAccountedAmount$/, \"Net Accounted Amount\");\n\n    const getMeasureLabel = (measureKey, accountingPeriod) => [\n      getMeasurePrefixLabel(measureKey),\n      titleCase(normalizeMeasureName(measureKey)),\n      accountingPeriod\n    ].filter(Boolean).join(\" \");\n\n    const stableStringify = (value) => {\n      if (Array.isArray(value)) {\n        return `[${value.map((item) => stableStringify(item)).join(\",\")}]`;\n      }\n\n      if (isObject(value)) {\n        const keys = Object.keys(value).sort();\n        let serialized = \"{\";\n\n        for (let index = 0; index < keys.length; index += 1) {\n          const key = keys[index];\n          serialized += `${index === 0 ? \"\" : \",\"}${JSON.stringify(key)}:${stableStringify(value[key])}`;\n        }\n\n        return `${serialized}}`;\n      }\n\n      return JSON.stringify(value);\n    };\n\n    const getRowKeyAndIdentity = (row, aliases = measureAliases) => {\n      const identity = {};\n      let key = \"\";\n      let identityIndex = 0;\n\n      for (const [fieldName, fieldValue] of Object.entries(row)) {\n        if (isAccountingPeriodKey(fieldName) || isMeasureKey(fieldName, aliases) || isMeasureSignKey(fieldName, aliases)) {\n          continue;\n        }\n\n        identity[fieldName] = fieldValue;\n        key += `${identityIndex === 0 ? \"\" : \"|\"}${fieldName}:${stableStringify(fieldValue)}`;\n        identityIndex += 1;\n      }\n\n      return { key, identity };\n    };\n\n    const getMeasureKeys = (row, aliases = measureAliases) => {\n      const keys = [];\n\n      for (const key of Object.keys(row)) {\n        if (isMeasureKey(key, aliases)) {\n          keys.push(key);\n        }\n      }\n\n      return keys;\n    };\n\n    const setMeasureCells = (mergedRow, row, measureLabels, aliases = measureAliases) => {\n      const accountingPeriod = getAccountingPeriodValue(row);\n      const periodSuffix = formatPeriodSuffix(accountingPeriod);\n\n      for (const measureKey of getMeasureKeys(row, aliases)) {\n        const periodMeasureKey = `${measureKey}${periodSuffix}`;\n        mergedRow[periodMeasureKey] = row[measureKey];\n        mergedRow[`${measureKey}Sign${periodSuffix}`] = row[`${measureKey}Sign`];\n        measureLabels[periodMeasureKey] = getMeasureLabel(measureKey, accountingPeriod);\n      }\n    };\n\n    const mergeRecordRows = (rows = [], measureLabels, aliases = measureAliases) => {\n      const mergedRowsByKey = new Map();\n\n      for (const row of rows) {\n        if (!isObject(row)) {\n          continue;\n        }\n\n        const { key, identity } = getRowKeyAndIdentity(row, aliases);\n        let mergedRow = mergedRowsByKey.get(key);\n\n        if (!mergedRow) {\n          mergedRow = { ...identity };\n          mergedRowsByKey.set(key, mergedRow);\n        }\n\n        setMeasureCells(mergedRow, row, measureLabels, aliases);\n      }\n\n      return Array.from(mergedRowsByKey.values());\n    };\n\n    const mergeDataset = (dataset, measureLabels, aliases = measureAliases) => {\n      if (Array.isArray(dataset)) {\n        return mergeRecordRows(dataset, measureLabels, aliases);\n      }\n\n      if (!isObject(dataset) || !Array.isArray(dataset.records)) {\n        return dataset;\n      }\n\n      const records = mergeRecordRows(dataset.records, measureLabels, aliases);\n\n      return {\n        ...dataset,\n        records,\n        count: records.length\n      };\n    };\n\n    const mergeRowsNonVariance = (dataResponse = rawData, options = {}) => {\n      const activeViewType = options.viewType ?? viewType;\n      const activeIsVarianceData = options.isVarianceData ?? isVarianceData;\n      const activeMeasureAliases = options.measureAliases ?? measureAliases;\n\n      if (activeViewType !== \"analyticView\" || activeIsVarianceData !== false || !isObject(dataResponse)) {\n        return dataResponse;\n      }\n\n      const avExtractResult = dataResponse.avExtractResult;\n\n      if (!isObject(avExtractResult)) {\n        return dataResponse;\n      }\n\n      const measureLabels = {\n        ...(isObject(avExtractResult.metadata?.measureLabels) ? avExtractResult.metadata.measureLabels : {})\n      };\n\n      return {\n        ...dataResponse,\n        avExtractResult: {\n          ...avExtractResult,\n          metadata: {\n            ...(isObject(avExtractResult.metadata) ? avExtractResult.metadata : {}),\n            measureLabels\n          },\n          ...(hasOwn(avExtractResult, \"homogenousLedgerSetAvData\") ? { homogenousLedgerSetAvData: mergeDataset(avExtractResult.homogenousLedgerSetAvData, measureLabels, activeMeasureAliases) } : {}),\n          ...(Array.isArray(avExtractResult.ledgerLevelAvData)\n            ? {\n              ledgerLevelAvData: avExtractResult.ledgerLevelAvData.map((ledgerLevel) => {\n                if (!isObject(ledgerLevel)) {\n                  return ledgerLevel;\n                }\n\n                return {\n                  ...ledgerLevel,\n                  ...(hasOwn(ledgerLevel, \"currentLevelAvData\") ? { currentLevelAvData: mergeDataset(ledgerLevel.currentLevelAvData, measureLabels, activeMeasureAliases) } : {}),\n                  ...(hasOwn(ledgerLevel, \"childLevelAvData\") ? { childLevelAvData: mergeDataset(ledgerLevel.childLevelAvData, measureLabels, activeMeasureAliases) } : {})\n                };\n              })\n            }\n            : {})\n        }\n      };\n    };\n\n    res.mergedRowsData = mergeRowsNonVariance();\n  }\n}\n\nreturn res;"
