            "sourceCode": "const viewType = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery.analyticViewNameUsed? \"analyticView\": \"businessView\";\nconst data = $context.$nodes.RAW_DATA_PREPROCESS.$output.result.tableData;\nconst llmOutput = $context.$nodes.DISPLAY_PLANNING_LLM.$output;\n// TODO: Legacy single-table display-plan fallback. Remove after table-plan schema migration is complete.\nconst defaultColumnsToDisplay = Array.isArray(llmOutput.columns) ? llmOutput.columns : [];\nconst defaultRowsToExclude = llmOutput.rowsToExclude;\nconst defaultSummary = llmOutput.summary;\nconst defaultMeasureCurrencies = llmOutput.measureCurrencies && typeof llmOutput.measureCurrencies === \"object\" && !Array.isArray(llmOutput.measureCurrencies)\n  ? llmOutput.measureCurrencies\n  : new Object();\n// End legacy single-table display-plan fallback defaults.\nconst isPresentationPath = $context.$nodes.PRESENTATION_INTENT_CLASSIFIER?.$output?.shouldUsePresentationWorkflow === true;\nconst previousDisplayTables = $context.$variables.state?.domains?.[`${$context.$variables.routingDecision}_displayColumns`]?.tables;\nconst segmentLabels = $context.$nodes.RAW_DATA_PREPROCESS.$output.result.segmentLabels;\nconst measureLabels = $context.$nodes.RAW_DATA_PREPROCESS.$output.result.measureLabels || new Object();\nconst varianceContext = $context.$nodes.RAW_DATA_PREPROCESS.$output.result.varianceContext || new Object();\nconst varianceMeasurePrefix = String($context.$nodes.RAW_DATA_PREPROCESS.$output.result.varianceMeasurePrefix ?? \"\").toLowerCase();\nconst segmentColumns = new Set(Object.keys(segmentLabels || new Object()));\nconst availableMeasureColumns = $context.$nodes.RAW_DATA_PREPROCESS.$output.result.availableMeasureColumns;\nconst lastUsedData = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData || new Object();\nconst agentName = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName;\nconst isBalanceAssistant = agentName === \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\nconst balanceDisplayOnlyOmitColumns = new Set([\"ledgerCurrency\", \"enteredCurrency\"]);\nconst sourceKeyOrder = lastUsedData.keyOrder;\nconst dataPayload = lastUsedData.dataPayload || new Object();\nconst queryResponse = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery?.queryResponse;\nconst chartOfAccountsSegments =\n  lastUsedData.dataResponse?.avExtractResult?.metadata?.chartOfAccounts?.segments ||\n  queryResponse?.metadata?.chartOfAccounts?.segments ||\n  new Object();\nconst measureAliases = Object.keys(dataPayload?.queries?.[0]?.analyticViews?.avUsage1?.measureAliases || new Object());\nconst measureColumnPrefixes = [\"entered\", \"accounted\"];\n\n\nconst escapeHtml = (value) => String(value ?? \"\")\n  .replaceAll(\"&\", \"&amp;\")\n  .replaceAll(\"<\", \"&lt;\")\n  .replaceAll(\">\", \"&gt;\")\n  .replaceAll('\"', \"&quot;\")\n  .replaceAll(\"'\", \"&#39;\");\n\nconst titleCase = (value) => String(value)\n  .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n  .replace(/[_\\s]+/g, \" \")\n  .trim()\n  .split(\" \")\n  .filter(Boolean)\n  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))\n  .join(\" \");\n\nconst getMeasurePrefixLabel = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const prefix of measureColumnPrefixes) {\n    const nextCharacter = columnText.charAt(prefix.length);\n\n    if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n      return titleCase(prefix);\n    }\n  }\n\n  return \"\";\n};\n\nconst getColumnWithoutMeasurePrefix = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const prefix of measureColumnPrefixes) {\n    const nextCharacter = columnText.charAt(prefix.length);\n\n    if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n      return nextCharacter.toLowerCase() + columnText.slice(prefix.length + 1);\n    }\n  }\n\n  return columnText;\n};\n\nconst getBalanceMeasureBaseLabel = (column) => {\n  const columnWithoutPrefix = getColumnWithoutMeasurePrefix(column);\n  const lowerColumn = columnWithoutPrefix.toLowerCase();\n  let baseLabel = \"\";\n\n  if (lowerColumn.startsWith(\"endingbalance\")) {\n    baseLabel = \"Ending Balance\";\n  } else if (lowerColumn.startsWith(\"beginbalance\")) {\n    baseLabel = \"Beginning Balance\";\n  } else if (lowerColumn.startsWith(\"periodnetbalance\") || lowerColumn.startsWith(\"periodactivity\")) {\n    baseLabel = \"Period Activity\";\n  } else if (lowerColumn.startsWith(\"quarteractivity\")) {\n    baseLabel = \"Quarter Activity\";\n  } else if (lowerColumn.startsWith(\"yearactivity\")) {\n    baseLabel = \"Year Activity\";\n  }\n\n  if (baseLabel === \"\") {\n    return \"\";\n  }\n\n  if (lowerColumn.includes(\"debit\")) {\n    return `${baseLabel} Debit`;\n  }\n\n  if (lowerColumn.includes(\"credit\")) {\n    return `${baseLabel} Credit`;\n  }\n\n  return baseLabel;\n};\n\nconst getBalanceMeasureLabel = (column) => {\n  if (!isBalanceAssistant) {\n    return \"\";\n  }\n\n  const baseLabel = getBalanceMeasureBaseLabel(column);\n\n  if (baseLabel === \"\") {\n    return \"\";\n  }\n\n  const prefixLabel = getMeasurePrefixLabel(column);\n  const periodMatch = String(column ?? \"\").match(/(Jan-\\d{2,4}|Feb-\\d{2,4}|Mar-\\d{2,4}|Apr-\\d{2,4}|May-\\d{2,4}|Jun-\\d{2,4}|Jul-\\d{2,4}|Aug-\\d{2,4}|Sep-\\d{2,4}|Oct-\\d{2,4}|Nov-\\d{2,4}|Dec-\\d{2,4}|Qtr[1-4]-\\d{2,4}|\\d{4})$/i);\n  const period = periodMatch ? periodMatch[0] : \"\";\n\n  return [prefixLabel, baseLabel, period]\n    .filter(Boolean)\n    .join(\" \");\n};\n\nconst normalizePeriodSuffix = (period) => String(period ?? \"\").replace(/[^A-Za-z0-9]/g, \"\");\n\nconst getVarianceContextPeriods = () => Array.isArray(varianceContext?.accountingPeriods)\n  ? varianceContext.accountingPeriods.map((period) => String(period ?? \"\").trim()).filter(Boolean)\n  : [];\n\nconst getVariancePeriodMeasureLabel = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const period of getVarianceContextPeriods()) {\n    const periodSuffix = normalizePeriodSuffix(period);\n\n    if (periodSuffix === \"\" || !columnText.endsWith(periodSuffix) || columnText.length === periodSuffix.length) {\n      continue;\n    }\n\n    const measureKey = columnText.slice(0, -periodSuffix.length);\n    const baseLabel = getBalanceMeasureLabel(measureKey);\n\n    if (baseLabel !== \"\") {\n      return `${baseLabel} ${period}`;\n    }\n  }\n\n  return \"\";\n};\n\nconst getVarianceMeasureLabel = (column) => {\n  if (column !== \"varianceAmount\" && column !== \"variancePercent\" && column !== \"variancePercentage\") {\n    return \"\";\n  }\n\n  const baseLabel = getBalanceMeasureBaseLabel(varianceContext?.measure) ||\n    titleCase(String(varianceContext?.measure ?? \"\"));\n\n  if (column === \"variancePercent\" || column === \"variancePercentage\") {\n    return \"Variance %\";\n  }\n\n  const prefixLabel = varianceMeasurePrefix === \"\" ? \"\" : titleCase(varianceMeasurePrefix);\n\n  return baseLabel === \"\" ? \"\" : `${[prefixLabel, baseLabel].filter(Boolean).join(\" \")} Variance`;\n};\n\nconst getSegmentLabel = (column) => {\n  const directSegmentLabel = segmentLabels?.[column];\n  if (typeof directSegmentLabel === \"string\" && directSegmentLabel.trim()) {\n    return directSegmentLabel;\n  }\n\n  const directMetadataLabel = chartOfAccountsSegments?.[column]?.label;\n  if (typeof directMetadataLabel === \"string\" && directMetadataLabel.trim()) {\n    return directMetadataLabel;\n  }\n\n  const matchedSegment = Object.values(chartOfAccountsSegments || new Object())\n    .find((segment) => segment?.dimensionName === column);\n  const matchedLabel = matchedSegment?.label;\n\n  return typeof matchedLabel === \"string\" && matchedLabel.trim() ? matchedLabel : \"\";\n};\n\nconst normalizeColumnName = (column) => {\n  if (measureLabels?.[column]) {\n    return measureLabels[column];\n  }\n\n  const segmentLabel = getSegmentLabel(column);\n  if (segmentLabel) {\n    return segmentLabel;\n  }\n\n  if (String(column).endsWith(\"Description\")) {\n    const baseColumn = String(column).slice(0, -\"Description\".length);\n    const baseLabel = getSegmentLabel(baseColumn);\n\n    if (baseLabel) {\n      return `${baseLabel} Description`;\n    }\n  }\n\n  if (String(column).endsWith(\"TreeFilter\")) {\n    const baseColumn = String(column).slice(0, -\"TreeFilter\".length);\n    const baseLabel = getSegmentLabel(baseColumn);\n\n    if (baseLabel) {\n      return `${baseLabel} Tree Filter`;\n    }\n  }\n\n  const varianceMeasureLabel = getVarianceMeasureLabel(column);\n\n  if (varianceMeasureLabel) {\n    return varianceMeasureLabel;\n  }\n\n  const variancePeriodMeasureLabel = getVariancePeriodMeasureLabel(column);\n\n  if (variancePeriodMeasureLabel) {\n    return variancePeriodMeasureLabel;\n  }\n\n  const balanceMeasureLabel = getBalanceMeasureLabel(column);\n\n  if (balanceMeasureLabel) {\n    return balanceMeasureLabel;\n  }\n\n  let name = column\n    .replace(/^varianceAmount$/, \"Variance\")\n    .replace(/^variancePercent$/, \"Variance %\")\n    .replace(/^netUnroundedEnteredAmount$/, \"Net Entered Amount\")\n    .replace(/^netUnroundedAccountedAmount$/, \"Net Accounted Amount\");\n\n  const abbreviations = [];\n  const abbreviationRules = [\n    [/QtdQr|Qtd/gi, \"QTD\"],\n    [/YtdYr|Ytd/gi, \"YTD\"],\n    [/PtdPr|Ptd/gi, \"PTD\"]\n  ];\n\n  for (const [pattern, label] of abbreviationRules) {\n    if (pattern.test(name)) {\n      abbreviations.push(label);\n      name = name.replace(pattern, \"\");\n    }\n  }\n\n  const periodMatch = name.match(/(Jan-\\d{2,4}|Feb-\\d{2,4}|Mar-\\d{2,4}|Apr-\\d{2,4}|May-\\d{2,4}|Jun-\\d{2,4}|Jul-\\d{2,4}|Aug-\\d{2,4}|Sep-\\d{2,4}|Oct-\\d{2,4}|Nov-\\d{2,4}|Dec-\\d{2,4}|Qtr[1-4]-\\d{2,4}|\\d{4})$/i);\n  const period = periodMatch ? periodMatch[0] : \"\";\n\n  if (period) {\n    name = name.slice(0, -period.length);\n  }\n\n  return [titleCase(name), ...abbreviations, period]\n    .filter(Boolean)\n    .join(\" \");\n};\n\nconst isBlank = (value) => value === null || value === undefined || String(value).trim() === \"\";\n\nconst toIsoDate = (value) => {\n  const text = String(value ?? \"\").trim();\n\n  if (text === \"\") {\n    return \"\";\n  }\n\n  if (/^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)-\\d{2,4}$/i.test(text) || /^Qtr[1-4]-\\d{2,4}$/i.test(text) || /^\\d{4}(-\\d{1,2})?$/.test(text)) {\n    return \"\";\n  }\n\n  const date = new Date(text);\n\n  if (Number.isNaN(date.getTime())) {\n    return \"\";\n  }\n\n  return date.toISOString().slice(0, 10);\n};\n\nconst formatDateColumnValue = (column, value) => {\n  if (!column.toLowerCase().includes(\"date\")) {\n    return value;\n  }\n\n  const isoDate = toIsoDate(value);\n\n  return isoDate ? `{date:${isoDate}}` : value;\n};\n\nconst stripMeasureColumnPrefix = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const prefix of measureColumnPrefixes) {\n    const nextCharacter = columnText.charAt(prefix.length);\n\n    if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n      return nextCharacter.toLowerCase() + columnText.slice(prefix.length + 1);\n    }\n  }\n\n  return columnText;\n};\n\nconst getMeasureAliasMatch = (column, aliases) => {\n  const columnText = String(column ?? \"\");\n\n  for (const measureAlias of aliases) {\n    if (!columnText.startsWith(measureAlias)) {\n      continue;\n    }\n\n    const suffix = columnText.slice(measureAlias.length);\n\n    if (suffix === \"\" || !suffix.startsWith(\"Sign\")) {\n      return measureAlias;\n    }\n  }\n\n  return \"\";\n};\n\nconst getMeasureInfo = (column) => {\n  if (viewType === \"analyticView\" && measureAliases.length > 0) {\n    const sortedAliases = [...measureAliases].sort((left, right) => right.length - left.length);\n    const measureAlias = getMeasureAliasMatch(column, sortedAliases);\n\n    if (measureAlias) {\n      return {\n        measureAlias\n      };\n    }\n\n    const columnText = String(column ?? \"\");\n    const columnWithoutMeasurePrefix = stripMeasureColumnPrefix(columnText);\n    const strippedMeasureAlias = columnWithoutMeasurePrefix === columnText\n      ? \"\"\n      : getMeasureAliasMatch(columnWithoutMeasurePrefix, sortedAliases);\n\n    if (strippedMeasureAlias) {\n      return {\n        measureAlias: strippedMeasureAlias\n      };\n    }\n  }\n\n  return availableMeasureColumns?.includes(column)\n    ? {\n      measureAlias: column\n    }\n    : undefined;\n};\n\nconst getMappedCurrencyColumn = (column, measureInfo, planMeasureCurrencies = defaultMeasureCurrencies) => {\n  if (column === \"varianceAmount\") {\n    if (varianceMeasurePrefix === \"entered\") {\n      return \"enteredCurrency\";\n    }\n    if (varianceMeasurePrefix === \"accounted\") {\n      return \"ledgerCurrency\";\n    }\n  }\n\n  const candidateKeys = [\n    column,\n    measureInfo?.measureAlias,\n    column.toUpperCase(),\n    measureInfo?.measureAlias?.toUpperCase()\n  ].filter(Boolean);\n\n  for (const candidateKey of candidateKeys) {\n    if (Object.prototype.hasOwnProperty.call(planMeasureCurrencies, candidateKey)) {\n      return planMeasureCurrencies[candidateKey];\n    }\n  }\n\n  return \"\";\n};\n\nconst getCurrency = (row, column, measureInfo, planMeasureCurrencies) => {\n  const currencyColumn = getMappedCurrencyColumn(column, measureInfo, planMeasureCurrencies);\n\n  return isBlank(currencyColumn) ? \"\" : row[currencyColumn];\n};\n\nconst isCurrencyColumn = (column) => String(column ?? \"\").toLowerCase().includes(\"currency\");\n\nconst isNumericAmount = (value) => {\n  const amount = String(value ?? \"\").replaceAll(\",\", \"\").trim();\n\n  return amount !== \"\" && !Number.isNaN(Number(amount));\n};\n\nconst requiresVisibleCurrencyColumn = (rows, measureColumn, currencyColumn) => {\n  const currencies = new Set();\n\n  for (const row of rows) {\n    if (!isNumericAmount(row?.[measureColumn])) {\n      continue;\n    }\n\n    const currency = String(row?.[currencyColumn] ?? \"\").trim();\n\n    if (currency === \"\") {\n      return true;\n    }\n\n    currencies.add(currency);\n\n    if (currencies.size > 1) {\n      return true;\n    }\n  }\n\n  return false;\n};\n\nconst injectMixedCurrencyColumns = (columns, rows, planMeasureCurrencies) => {\n  const currencyColumnsToInject = new Set();\n\n  for (const column of columns) {\n    const measureInfo = getMeasureInfo(column);\n\n    if (!measureInfo) {\n      continue;\n    }\n\n    const currencyColumn = getMappedCurrencyColumn(column, measureInfo, planMeasureCurrencies);\n\n    if (!isBlank(currencyColumn) && requiresVisibleCurrencyColumn(rows, column, currencyColumn)) {\n      currencyColumnsToInject.add(currencyColumn);\n    }\n  }\n\n  if (currencyColumnsToInject.size === 0) {\n    return columns;\n  }\n\n  const columnsWithoutInjectedCurrencies = columns.filter((column) => !currencyColumnsToInject.has(column));\n  const injectedCurrencyColumns = new Set();\n  const columnsWithCurrencies = [];\n\n  for (const column of columnsWithoutInjectedCurrencies) {\n    const measureInfo = getMeasureInfo(column);\n    const currencyColumn = measureInfo\n      ? getMappedCurrencyColumn(column, measureInfo, planMeasureCurrencies)\n      : \"\";\n\n    if (currencyColumnsToInject.has(currencyColumn) && !injectedCurrencyColumns.has(currencyColumn)) {\n      columnsWithCurrencies.push(currencyColumn);\n      injectedCurrencyColumns.add(currencyColumn);\n    }\n\n    columnsWithCurrencies.push(column);\n  }\n\n  return columnsWithCurrencies;\n};\n\nconst formatLegacyColumnValue = (row, column) => {\n  const columnValue = row[column];\n  const columnDescription = row[`${column}Description`];\n\n  if (isBlank(columnValue)) {\n    return isBlank(columnDescription) ? \"\" : columnDescription;\n  }\n\n  if (isBlank(columnDescription) || String(columnDescription) === String(columnValue)) {\n    return columnValue;\n  }\n\n  return `${columnValue}-${columnDescription}`;\n};\n\nconst formatSegmentColumnValue = (row, column) => formatLegacyColumnValue(row, column);\n\nconst formatColumnValue = (row, column) => {\n  if (viewType === \"analyticView\" && segmentColumns.has(column)) {\n    return formatDateColumnValue(column, formatSegmentColumnValue(row, column));\n  }\n\n  if (viewType !== \"analyticView\") {\n    return formatDateColumnValue(column, formatLegacyColumnValue(row, column));\n  }\n\n  return formatDateColumnValue(column, row[column]);\n};\n\nconst formatCellValue = (row, column, planMeasureCurrencies = defaultMeasureCurrencies) => {\n  const value = row[column];\n\n  if (isCurrencyColumn(column)) {\n    return value ?? \"\";\n  }\n\n  const measureInfo = getMeasureInfo(column);\n\n  if (!measureInfo) {\n    return formatColumnValue(row, column);\n  }\n\n  const amount = String(value ?? \"\").replaceAll(\",\", \"\").trim();\n\n  if (amount === \"\" || Number.isNaN(Number(amount))) {\n    return \"-\";\n  }\n\n  const currency = getCurrency(row, column, measureInfo, planMeasureCurrencies);\n\n  if (isBlank(currency)) {\n    return value;\n  }\n\n  return `{amount:${amount},currency:${currency}}`;\n};\n\nconst varianceIconByDirectionAndImpact = {\n  \"Increase|Favorable\": '<span class=\"oj-icon-color-success oj-ux-ico-arrow-up oj-ux-icon-size-6x oj-sm-margin-1x-bottom\"></span>',\n  \"Increase|Unfavorable\": '<span class=\"oj-icon-color-danger oj-ux-ico-arrow-up oj-ux-icon-size-6x oj-sm-margin-1x-bottom\"></span>',\n  \"Decrease|Favorable\": '<span class=\"oj-icon-color-success oj-ux-ico-arrow-down oj-ux-icon-size-6x oj-sm-margin-1x-bottom\"></span>',\n  \"Decrease|Unfavorable\": '<span class=\"oj-icon-color-danger oj-ux-ico-arrow-down oj-ux-icon-size-6x oj-sm-margin-1x-bottom\"></span>'\n};\n\nconst hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(Object(object), key);\n\nconst hasVarianceIconColumns = (rows) => Array.isArray(rows) && rows.some((row) =>\n  row && typeof row === \"object\" &&\n  hasOwn(row, \"variancePercent\") &&\n  hasOwn(row, \"varianceDirection\") &&\n  hasOwn(row, \"varianceImpact\")\n);\n\nconst getVarianceIconHtml = (row) => {\n  const direction = String(row?.varianceDirection ?? \"\").trim();\n  const impact = String(row?.varianceImpact ?? \"\").trim();\n\n  return varianceIconByDirectionAndImpact[`${direction}|${impact}`] || \"\";\n};\n\nconst formatCellHtml = (row, column, planMeasureCurrencies, canApplyVarianceIcons) => {\n  const formattedValue = formatCellValue(row, column, planMeasureCurrencies);\n\n  if (column !== \"variancePercent\" || canApplyVarianceIcons !== true) {\n    return escapeHtml(formattedValue);\n  }\n\n  const varianceIconHtml = getVarianceIconHtml(row);\n\n  return varianceIconHtml ? `${varianceIconHtml}${escapeHtml(formattedValue)}` : escapeHtml(formattedValue);\n};\n\nconst getLevelRows = (level, rowLevel) => {\n  const rows = [];\n\n  if (!level || typeof level !== \"object\") {\n    return rows;\n  }\n\n  const prefix = rowLevel === \"child\" ? \"childLevelAvData\" : \"currentLevelAvData\";\n\n  for (const key of Object.keys(level)) {\n    if (key.startsWith(prefix) && Array.isArray(level[key]?.records)) {\n      rows.push(...level[key].records);\n    }\n  }\n\n  return rows;\n};\n\nconst getRows = (rowLevel) => {\n  if (viewType === \"businessView\") {\n    return Array.isArray(data) ? data : [];\n  }\n\n  const rows = [];\n  const normalizedRowLevel = String(rowLevel ?? \"\").toLowerCase();\n\n  if ((normalizedRowLevel === \"\" || normalizedRowLevel === \"summary\") && data.homogenousLedgerSetAvData?.records) {\n    rows.push(...data.homogenousLedgerSetAvData.records);\n  }\n\n  for (const level of data.ledgerLevelAvData || []) {\n    if (normalizedRowLevel === \"summary\") {\n      rows.push(...getLevelRows(level, \"summary\"));\n    }\n    else if (normalizedRowLevel === \"child\") {\n      rows.push(...getLevelRows(level, \"child\"));\n    }\n    else {\n      rows.push(...getLevelRows(level, \"summary\"));\n      rows.push(...getLevelRows(level, \"child\"));\n    }\n  }\n\n  return rows;\n};\n\nconst getPlanMeasureCurrencies = (plan) =>\n  plan?.measureCurrencies && typeof plan.measureCurrencies === \"object\" && !Array.isArray(plan.measureCurrencies)\n    ? plan.measureCurrencies\n    : new Object();\n\nconst getPreviousTablesByRowLevel = () => {\n  const previousTablesByRowLevel = new Object();\n\n  for (const table of Array.isArray(previousDisplayTables) ? previousDisplayTables : []) {\n    previousTablesByRowLevel[String(table?.rowLevel ?? \"\").toLowerCase()] = table;\n  }\n\n  return previousTablesByRowLevel;\n};\n\nlet previousTablesByRowLevel;\n\nconst getCoaSegmentsForColumn = (column) => {\n  const directSegment = chartOfAccountsSegments?.[column];\n\n  if (directSegment) {\n    return [directSegment];\n  }\n\n  const matchedSegments = Object.values(chartOfAccountsSegments || new Object())\n    .filter((segment) => segment?.dimensionName === column);\n\n  if (matchedSegments.length > 0) {\n    return matchedSegments;\n  }\n\n  return segmentColumns.has(column) ? [new Object()] : [];\n};\n\nconst isCoaSegmentColumn = (column) => getCoaSegmentsForColumn(column).length > 0;\n\nconst isGlBalancingSegmentColumn = (column) => getCoaSegmentsForColumn(column)\n  .some((segment) => {\n    const qualifiers = Array.isArray(segment?.qualifiers) ? segment.qualifiers : [];\n\n    return qualifiers.includes('GL_BALANCING');\n  });\n\nconst applyPriorityColumnOrdering = (columns) => {\n  if (!Array.isArray(columns) || columns.length === 0) {\n    return columns;\n  }\n\n  const ledgerColumns = columns.filter((column) => column === 'ledger');\n  const glBalancingColumns = columns.filter((column) => column !== 'ledger' && isGlBalancingSegmentColumn(column));\n  const otherCoaSegmentColumns = columns.filter((column) =>\n    column !== 'ledger' &&\n    !isGlBalancingSegmentColumn(column) &&\n    isCoaSegmentColumn(column)\n  );\n  const priorityColumnSet = new Set([...ledgerColumns, ...glBalancingColumns, ...otherCoaSegmentColumns]);\n  const otherColumns = columns.filter((column) => !priorityColumnSet.has(column));\n\n  return [...ledgerColumns, ...glBalancingColumns, ...otherCoaSegmentColumns, ...otherColumns];\n};\n\nconst isVarianceAmountColumn = (column) => column === 'varianceAmount';\nconst isVariancePercentColumn = (column) => column === 'variancePercent' || column === 'variancePercentage';\nconst isVarianceMovementColumn = (column) => column === 'movement';\nconst isBalanceMeasureColumn = (column) =>\n  !isVarianceAmountColumn(column) &&\n  !isVariancePercentColumn(column) &&\n  !isVarianceMovementColumn(column) &&\n  getMeasureInfo(column) !== undefined;\n\nconst applyBalanceColumnOrdering = (columns) => {\n  const priorityOrderedColumns = applyPriorityColumnOrdering(columns);\n  const measureColumns = priorityOrderedColumns.filter(isBalanceMeasureColumn);\n  const varianceAmountColumns = priorityOrderedColumns.filter(isVarianceAmountColumn);\n  const variancePercentColumns = priorityOrderedColumns.filter(isVariancePercentColumn);\n  const varianceMovementColumns = priorityOrderedColumns.filter(isVarianceMovementColumn);\n  const trailingColumnSet = new Set([...measureColumns, ...varianceAmountColumns, ...variancePercentColumns, ...varianceMovementColumns]);\n  const leadingColumns = priorityOrderedColumns.filter((column) => !trailingColumnSet.has(column));\n\n  return [...leadingColumns, ...measureColumns, ...varianceAmountColumns, ...variancePercentColumns, ...varianceMovementColumns];\n};\n\nconst orderSelectedColumnsBySource = (selectedColumns) => {\n  if (!Array.isArray(selectedColumns)) {\n    return [];\n  }\n\n  const columnsAllowedForDisplay = isBalanceAssistant\n    ? selectedColumns.filter((column) => !balanceDisplayOnlyOmitColumns.has(column))\n    : selectedColumns;\n\n  if (isBalanceAssistant) {\n    return applyBalanceColumnOrdering(columnsAllowedForDisplay);\n  }\n\n  if (!Array.isArray(sourceKeyOrder) || sourceKeyOrder.length === 0) {\n    return applyPriorityColumnOrdering(columnsAllowedForDisplay);\n  }\n\n  const selectedColumnSet = new Set(columnsAllowedForDisplay);\n  const orderedColumns = [];\n  const usedColumns = new Set();\n\n  for (const column of sourceKeyOrder) {\n    if (selectedColumnSet.has(column) && !usedColumns.has(column)) {\n      orderedColumns.push(column);\n      usedColumns.add(column);\n    }\n  }\n\n  for (const column of columnsAllowedForDisplay) {\n    if (!usedColumns.has(column)) {\n      orderedColumns.push(column);\n      usedColumns.add(column);\n    }\n  }\n\n  return applyPriorityColumnOrdering(orderedColumns);\n};\n\nconst applyUserColumnOrdering = (columns, orderedUserColumns) => {\n  const baselineColumns = Array.isArray(columns) ? columns : [];\n\n  if (!Array.isArray(orderedUserColumns) || orderedUserColumns.length === 0) {\n    return baselineColumns;\n  }\n\n  const availableColumns = new Set(baselineColumns);\n  const orderedColumns = [];\n  const usedColumns = new Set();\n\n  for (const column of orderedUserColumns) {\n    const normalizedColumn = String(column ?? \"\");\n    const lowerColumn = normalizedColumn.toLowerCase();\n    const isEligible =\n      availableColumns.has(column) &&\n      getMeasureInfo(column) === undefined &&\n      !isVarianceAmountColumn(column) &&\n      !isVariancePercentColumn(column) &&\n      normalizedColumn !== \"rowIndex\" &&\n      !lowerColumn.includes(\"currency\") &&\n      !lowerColumn.endsWith(\"sign\");\n\n    if (isEligible && !usedColumns.has(column)) {\n      orderedColumns.push(column);\n      usedColumns.add(column);\n    }\n  }\n\n  for (const column of baselineColumns) {\n    if (!usedColumns.has(column)) {\n      orderedColumns.push(column);\n    }\n  }\n\n  return orderedColumns;\n};\n\nconst restorePreviousSummary = (plan) => {\n  if (!isPresentationPath) {\n    return plan;\n  }\n\n  previousTablesByRowLevel = previousTablesByRowLevel || getPreviousTablesByRowLevel();\n  const rowLevel = String(plan?.rowLevel ?? \"\").toLowerCase();\n  const previousSummary = previousTablesByRowLevel[rowLevel]?.summary;\n\n  if (typeof previousSummary !== \"string\") {\n    return plan;\n  }\n\n  return {\n    ...plan,\n    summary: previousSummary\n  };\n};\n\nconst buildDisplayBlocksForPlan = (plan) => {\n  const plannedColumnsToDisplay = applyUserColumnOrdering(\n    orderSelectedColumnsBySource(plan?.columns),\n    plan?.orderedUserColumns\n  );\n  const rowsToExclude = Array.isArray(plan?.rowsToExclude) ? plan.rowsToExclude : [];\n  const summary = plan?.summary;\n  const planMeasureCurrencies = getPlanMeasureCurrencies(plan);\n  const excludedRows = new Set(rowsToExclude.map(String));\n  const rows = getRows(plan?.rowLevel).filter((row) => !excludedRows.has(String(row.rowIndex)));\n  const columnsToDisplay = injectMixedCurrencyColumns(plannedColumnsToDisplay, rows, planMeasureCurrencies);\n  const canApplyVarianceIcons = hasVarianceIconColumns(rows);\n  const headers = columnsToDisplay\n    .map((column) => `<th>${escapeHtml(normalizeColumnName(column))}</th>`)\n    .join(\"\");\n  const body = rows\n    .map((row) => {\n      const cells = columnsToDisplay\n        .map((column) => `<td>${formatCellHtml(row, column, planMeasureCurrencies, canApplyVarianceIcons)}</td>`)\n        .join(\"\");\n\n      return `<tr>${cells}</tr>`;\n    })\n    .join(\"\");\n  const displayBlocks = [];\n\n  const trimmedSummary = String(summary ?? \"\").trim();\n\n  if (trimmedSummary !== \"\" && trimmedSummary !== \"<p></p>\") {\n    displayBlocks.push({\n      display_type: \"text\",\n      data: summary\n    });\n  }\n\n  if (rows.length > 0 && columnsToDisplay.length > 0 && headers !== \"\" && body !== \"\") {\n    displayBlocks.push({\n      display_type: \"table\",\n      data: `<table><thead><tr>${headers}</tr></thead><tbody>${body}</tbody></table>`\n    });\n  }\n\n  return displayBlocks;\n};\n\nconst getDisplayPlans = () => {\n  if (Array.isArray(llmOutput.tables) && llmOutput.tables.length > 0) {\n    return llmOutput.tables.map(restorePreviousSummary);\n  }\n\n  // TODO: Legacy single-table display-plan fallback. Remove after table-plan schema migration is complete.\n  const legacyDisplayPlans = [\n    restorePreviousSummary({\n      columns: defaultColumnsToDisplay,\n      rowsToExclude: defaultRowsToExclude,\n      summary: defaultSummary,\n      measureCurrencies: defaultMeasureCurrencies\n    })\n  ];\n  // End legacy single-table display-plan fallback.\n  return legacyDisplayPlans;\n};\n\nconst jsonToHtml = () => getDisplayPlans().flatMap(buildDisplayBlocksForPlan);\n\nconst hasMoreData = (dataResponse) =>\n  dataResponse?.hasMore === true ||\n  dataResponse?.avExtractResult?.homogenousLedgerSetAvData?.hasMore === true ||\n  dataResponse?.avExtractResult?.ledgerLevelAvData?.some(\n    ({ currentLevelAvData, childLevelAvData }) =>\n      currentLevelAvData?.hasMore === true ||\n      childLevelAvData?.hasMore === true\n  ) === true;\n\nconst adsPayload = jsonToHtml();\n\nconst getIntentDetailLabel = (key, segments = new Object()) => {\n  const trimmedKey = String(key ?? \"\").trim();\n  const label = segments?.[trimmedKey]?.label;\n\n  if (typeof label === \"string\" && label.trim()) {\n    return label;\n  }\n\n  if (trimmedKey === \"ledger\") {\n    return \"Ledger\";\n  }\n\n  if (trimmedKey === \"currency\") {\n    return \"Currency\";\n  }\n\n  if (trimmedKey === \"accountingPeriod\") {\n    return \"Accounting Period\";\n  }\n\n  return trimmedKey;\n};\n\nconst isDataSourceKey = (key) => {\n  return key === \"Data Source\" || key === \"Source\";\n};\n\nconst formatIntentDetails = (intentDetails, segments = new Object()) => {\n  if (typeof intentDetails === \"string\") {\n    return intentDetails;\n  }\n\n  const items = [];\n  let dataSourceItem = \"\";\n\n  if (intentDetails && typeof intentDetails === \"object\" && !Array.isArray(intentDetails)) {\n    for (const [key, value] of Object.entries(intentDetails)) {\n      const label = getIntentDetailLabel(key, segments);\n      const displayValue = value && typeof value === \"object\" ? JSON.stringify(value) : value;\n\n      if (isDataSourceKey(key)) {\n        dataSourceItem = `<li>Data Source: ${escapeHtml(displayValue)}</li>`;\n        continue;\n      }\n\n      items.push(`<li>${escapeHtml(label)}: ${escapeHtml(displayValue)}</li>`);\n    }\n  }\n\n  if (dataSourceItem) {\n    items.unshift(dataSourceItem);\n  }\n\n  return items.length > 0 ? `<ul>${items.join(\"\")}</ul>` : \"\";\n};\n\nconst insertHierarchyResolverMessageIntoContext = (displayObjects, hierarchyResolverMessage) => {\n  const message = String(hierarchyResolverMessage ?? \"\").trim();\n  if (!message) {\n    return;\n  }\n\n  const contextIndex = displayObjects.findIndex((item) => item?.display_type === \"collapsible\" && item?.headerText === \"Context\");\n  if (contextIndex < 0) {\n    return;\n  }\n\n  const contextObject = displayObjects[contextIndex];\n  contextObject.content = Array.isArray(contextObject.content) ? contextObject.content : [];\n  contextObject.content.push({\n    display_type: \"text\",\n    data: `<p>${escapeHtml(message)}</p>`\n  });\n};\n\nconst getFooterMessages = () => {\n  const messages = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.messages;\n  return (Array.isArray(messages) ? messages : [])\n    .filter((message) =>\n      message &&\n      typeof message === \"object\" &&\n      String(message.placement ?? \"\").toLowerCase() === \"footer\" &&\n      typeof message.text === \"string\" &&\n      message.text.trim() !== \"\"\n    );\n};\n\nconst appendFooterMessages = (displayObjects) => {\n  for (const message of getFooterMessages()) {\n    displayObjects.push({\n      display_type: \"text\",\n      data: `<p>${escapeHtml(message.text)}</p>`\n    });\n  }\n};\nconst hierarchyResolverMessage =\n  String($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.hierarchyResolverMessage ?? \"\").trim() ||\n  String(queryResponse?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\nconst intentDetails = queryResponse?.queries?.[0]?.intentDetails;\nconst segments = queryResponse?.metadata?.chartOfAccounts?.segments || new Object();\nconst intentDetailsContent = formatIntentDetails(intentDetails, segments);\n\nif (hasMoreData($context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse)) {\n  const exportToExcelBlock = {\n    display_type: \"action\",\n    data: [\"Export to Excel\"]\n  };\n  adsPayload.push(exportToExcelBlock);\n}\n\nif (intentDetailsContent) {\n  const collapsibleIntent = {\n    display_type: \"collapsible\",\n    headerText:\"Context\",\n    content:[{\"display_type\":\"text\",\"data\":intentDetailsContent}],\n    expanded:\"false\"\n  };\n  adsPayload.unshift(collapsibleIntent);\n}\n\ninsertHierarchyResolverMessageIntoContext(adsPayload, hierarchyResolverMessage);\nappendFooterMessages(adsPayload);\n\nreturn adsPayload;"
