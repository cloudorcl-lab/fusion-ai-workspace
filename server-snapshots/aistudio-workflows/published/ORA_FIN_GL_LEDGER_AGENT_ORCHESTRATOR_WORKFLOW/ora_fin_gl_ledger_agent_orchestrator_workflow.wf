        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Raw Data Pre-Process",
            "returnType": "object",
            "sourceCode": "const dataResponse = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse;\nconst rawData = $context.$nodes?.MERGE_BALANCE_ROWS?.$output?.result?.mergedRowsData || dataResponse;\nconst dataPayload = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataPayload || new Object();\nconst sourceKeyOrder = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.keyOrder;\nconst lastUsedQuery = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery;\nconst queryResponse = lastUsedQuery?.queryResponse;\nconst rawIntentDetails = queryResponse?.queries?.[0]?.intentDetails;\nconst queryGenerationQuestion = typeof lastUsedQuery?.queryPayload?.userQuestion === \"string\"\n  ? lastUsedQuery.queryPayload.userQuestion.trim()\n  : \"\";\nconst viewType = lastUsedQuery.analyticViewNameUsed? \"analyticView\": \"businessView\";\nconst viewName = viewType === 'analyticView'? lastUsedQuery.analyticViewNameUsed : lastUsedQuery.businessViewNameUsed;\nconst agentName = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName;\nconst isBalanceAssistant = agentName === \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\n\nconst avMetaData = rawData?.avExtractResult?.metadata || dataResponse?.avExtractResult?.metadata || new Object();\nconst queryResponseSegments = queryResponse?.metadata?.chartOfAccounts?.segments || new Object();\nconst avSegments = avMetaData?.chartOfAccounts?.segments || new Object();\nconst segmentKeys = Object.keys(Object.keys(avSegments).length > 0 ? avSegments : queryResponseSegments);\nconst coaSegmentColumnSet = new Set(segmentKeys);\nconst measureAliases = Object.keys(dataPayload?.queries?.[0]?.analyticViews?.avUsage1?.measureAliases || new Object());\nconst varianceHelperColumns = new Set([\"varianceDirection\", \"varianceImpact\"]);\n\nlet columnsNotNeeded;\nif(viewType === 'analyticView'){\n  let columnsNotNeededArr = [\n    'currencyType',\n    'currencyTypeLevelName',\n    'currencyLevelName',\n    'currencyTypeDescription',\n    'scenario',\n    'scenarioLevelName',\n    'scenarioDescription',\n    'ledgerLevel',\n    'ledgerDescription',\n    'ledgerSetName',\n    'accountingPeriodDepth',\n    'accountingPeriodDescription'\n  ];\n  // if (isBalanceAssistant) {\n  //   columnsNotNeededArr.push('period');\n  //   columnsNotNeededArr.push('accountingPeriod');\n  //   columnsNotNeededArr.push('quarter');\n  //   columnsNotNeededArr.push('year');\n  // }\n  segmentKeys.forEach(segment => {\n    columnsNotNeededArr.push(`${segment}LevelName`);\n    columnsNotNeededArr.push(`${segment}TreeVersionName`);\n  });\n  columnsNotNeeded = new Set(columnsNotNeededArr);\n}\n//will added other domains later\n\nconst isCurrencyDescriptionColumn = (column) => String(column ?? \"\")\n    .toLowerCase()\n    .includes(\"currencydescription\");\n\nconst isCurrencyColumn = (column) => String(column ?? \"\")\n    .toLowerCase()\n    .includes(\"currency\");\n\nconst shouldRemoveColumn = (column) => varianceHelperColumns.has(column) || isCurrencyDescriptionColumn(column) || columnsNotNeeded?.has(column) === true;\nconst isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\nconst toCellText = (value) => String(value ?? \"\").trim();\nconst measureColumnPrefixes = [\"entered\", \"accounted\"];\n\nconst getMeasureColumnPrefix = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const prefix of measureColumnPrefixes) {\n    const nextCharacter = columnText.charAt(prefix.length);\n\n    if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n      return prefix;\n    }\n  }\n\n  return \"\";\n};\n\nconst formatMeasurePrefixLabel = (prefix) => {\n  const prefixText = String(prefix ?? \"\");\n\n  return prefixText === \"\"\n      ? \"\"\n      : prefixText.charAt(0).toUpperCase() + prefixText.slice(1);\n};\n\nconst getMeasureColumnPrefixLabel = (column) => formatMeasurePrefixLabel(getMeasureColumnPrefix(column));\n\nconst stripMeasureColumnPrefix = (column) => {\n  const columnText = String(column ?? \"\");\n\n  for (const prefix of measureColumnPrefixes) {\n    const nextCharacter = columnText.charAt(prefix.length);\n\n    if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n      return nextCharacter.toLowerCase() + columnText.slice(prefix.length + 1);\n    }\n  }\n\n  return columnText;\n};\n\nconst hasMeasureAliasMatch = (column) => {\n  const columnText = String(column ?? \"\");\n\n  return measureAliases.some((alias) => {\n    if (!columnText.startsWith(alias)) {\n      return false;\n    }\n\n    const suffix = columnText.slice(alias.length);\n    return suffix === \"\" || !suffix.startsWith(\"Sign\");\n  });\n};\n\nconst isMeasureColumnFromAlias = (column) => {\n  if (measureAliases.length === 0) {\n    return undefined;\n  }\n\n  const columnText = String(column ?? \"\");\n\n  if (hasMeasureAliasMatch(columnText)) {\n    return true;\n  }\n\n  const columnWithoutMeasurePrefix = stripMeasureColumnPrefix(columnText);\n  return columnWithoutMeasurePrefix !== columnText && hasMeasureAliasMatch(columnWithoutMeasurePrefix);\n};\n\nconst getBalanceMeasureBaseLabel = (column) => {\n  if (!isBalanceAssistant) {\n    return \"\";\n  }\n\n  const lowerColumn = stripMeasureColumnPrefix(column).toLowerCase();\n  let baseLabel = \"\";\n\n  if (lowerColumn.startsWith(\"endingbalance\")) {\n    baseLabel = \"Ending Balance\";\n  } else if (lowerColumn.startsWith(\"beginbalance\")) {\n    baseLabel = \"Beginning Balance\";\n  } else if (lowerColumn.startsWith(\"periodnetbalance\") || lowerColumn.startsWith(\"periodactivity\")) {\n    baseLabel = \"Period Activity\";\n  } else if (lowerColumn.startsWith(\"quarteractivity\")) {\n    baseLabel = \"Quarter Activity\";\n  } else if (lowerColumn.startsWith(\"yearactivity\")) {\n    baseLabel = \"Year Activity\";\n  }\n\n  if (baseLabel === \"\") {\n    return \"\";\n  }\n\n  if (lowerColumn.includes(\"debit\")) {\n    return `${baseLabel} Debit`;\n  }\n\n  if (lowerColumn.includes(\"credit\")) {\n    return `${baseLabel} Credit`;\n  }\n\n  return baseLabel;\n};\n\nconst isBalanceMeasureColumn = (column) => getBalanceMeasureBaseLabel(column) !== \"\";\n\nconst normalizePeriodSuffix = (period) => String(period ?? \"\").replace(/[^A-Za-z0-9]/g, \"\");\n\nconst getVarianceContextPeriods = (varianceContext) => Array.isArray(varianceContext?.accountingPeriods)\n    ? varianceContext.accountingPeriods.map((period) => String(period ?? \"\").trim()).filter(Boolean)\n    : [];\n\nconst getVarianceMeasurePrefix = (varianceContext, measureColumns = []) => {\n  const varianceMeasureKey = stripMeasureColumnPrefix(String(varianceContext?.measure ?? \"\")).toLowerCase();\n\n  if (varianceMeasureKey === \"\") {\n    return \"\";\n  }\n\n  const matchingPrefixes = new Set();\n  let hasMatchingColumn = false;\n\n  for (const period of getVarianceContextPeriods(varianceContext)) {\n    const periodSuffix = normalizePeriodSuffix(period);\n\n    for (const column of measureColumns) {\n      const columnText = String(column ?? \"\");\n\n      if (periodSuffix === \"\" || !columnText.endsWith(periodSuffix) || columnText.length === periodSuffix.length) {\n        continue;\n      }\n\n      const columnMeasureKey = columnText.slice(0, -periodSuffix.length);\n\n      if (stripMeasureColumnPrefix(columnMeasureKey).toLowerCase() !== varianceMeasureKey) {\n        continue;\n      }\n\n      hasMatchingColumn = true;\n      matchingPrefixes.add(getMeasureColumnPrefix(columnMeasureKey));\n    }\n  }\n\n  return hasMatchingColumn && matchingPrefixes.size === 1 ? Array.from(matchingPrefixes)[0] : \"\";\n};\n\nconst getVarianceMeasureLabels = (varianceContext, measureColumns = []) => {\n  if (!isBalanceAssistant) {\n    return new Object();\n  }\n\n  const measureKey = String(varianceContext?.measure ?? \"\").trim();\n  const baseLabel = getBalanceMeasureBaseLabel(measureKey);\n  const variancePeriods = getVarianceContextPeriods(varianceContext);\n\n  if (baseLabel === \"\" && variancePeriods.length === 0) {\n    return new Object();\n  }\n\n  const labels = {\n    variancePercent: \"Variance %\",\n    variancePercentage: \"Variance %\"\n  };\n\n  if (baseLabel !== \"\") {\n    const variancePrefixLabel = formatMeasurePrefixLabel(getVarianceMeasurePrefix(varianceContext, measureColumns));\n    const varianceMeasureLabel = [variancePrefixLabel, baseLabel].filter(Boolean).join(\" \");\n    labels.varianceAmount = `${varianceMeasureLabel} Variance`;\n  }\n\n  for (const period of variancePeriods) {\n    const periodSuffix = normalizePeriodSuffix(period);\n\n    if (periodSuffix === \"\") {\n      continue;\n    }\n\n    for (const column of measureColumns) {\n      const columnText = String(column ?? \"\");\n\n      if (!columnText.endsWith(periodSuffix) || columnText.length === periodSuffix.length) {\n        continue;\n      }\n\n      const columnMeasureKey = columnText.slice(0, -periodSuffix.length);\n      const columnBaseLabel = getBalanceMeasureBaseLabel(columnMeasureKey);\n\n      if (columnBaseLabel !== \"\") {\n        labels[columnText] = [getMeasureColumnPrefixLabel(columnMeasureKey), columnBaseLabel, period]\n            .filter(Boolean)\n            .join(\" \");\n      }\n    }\n  }\n\n  return labels;\n};\n\nconst processExtractJson = (inputObject, viewType = \"analyticView\") => {\n  const measureColumnTerms = [\n    \"amount\",\n    \"activity\",\n    \"balance\",\n    \"debit\",\n    \"credit\",\n    \"net\",\n    \"accounted\",\n    \"entered\"\n  ];\n\n  const buildColumnLists = (columns) => {\n    const availableMeasureColumns = [];\n    const availableNonMeasureColumns = [];\n\n    for (const column of columns) {\n      const lowerColumn = column.toLowerCase();\n      const isMeasureColumnByAlias = viewType === \"analyticView\" ? isMeasureColumnFromAlias(column) : undefined;\n      const isMeasureColumn = !isCurrencyColumn(column) && (\n          column === \"varianceAmount\" ||\n          isBalanceMeasureColumn(column) ||\n          (isMeasureColumnByAlias ?? measureColumnTerms.some((term) => lowerColumn.includes(term)))\n      );\n\n      if (isMeasureColumn) {\n        availableMeasureColumns.push(column);\n      } else {\n        availableNonMeasureColumns.push(column);\n      }\n    }\n\n    return {\n      availableMeasureColumns,\n      availableNonMeasureColumns\n    };\n  };\n\n  const addColumnsFromRows = (columns, records) => {\n    for (const record of records) {\n      if (isRecordObject(record)) {\n        for (const column of Object.keys(record)) {\n          if (!shouldRemoveColumn(column)) {\n            columns.add(column);\n          }\n        }\n      }\n    }\n  };\n\n  const addColumnsFromDataRecords = (columns, dataRecords) => {\n    const records = Array.isArray(dataRecords?.records) ? dataRecords.records : [];\n    addColumnsFromRows(columns, records);\n  };\n\n  const processAnalyticView = (avExtractJson) => {\n    const avExtractResult = avExtractJson?.avExtractResult ?? new Object();\n    const metaData = avExtractResult?.metadata || avMetaData || new Object();\n    const columns = new Set();\n\n    addColumnsFromDataRecords(columns, avExtractResult.homogenousLedgerSetAvData);\n\n    if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n      for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n        addColumnsFromDataRecords(columns, ledgerLevelData?.currentLevelAvData);\n        addColumnsFromDataRecords(columns, ledgerLevelData?.childLevelAvData);\n      }\n    }\n\n    const segmentLabels = new Object();\n    const segments = metaData?.chartOfAccounts?.segments ?? new Object();\n\n    if (isRecordObject(segments)) {\n      for (const segment of Object.keys(segments)) {\n        segmentLabels[segment] = segments[segment]?.label ?? \"\";\n      }\n    }\n\n    const columnLists = buildColumnLists(columns);\n\n    return {\n      mandatoryCoaSegments: Array.isArray(metaData?.mandatoryCoaSegments) ? metaData.mandatoryCoaSegments : [],\n      headLineMeasures: Array.isArray(avExtractResult?.headLineMeasures) ? avExtractResult.headLineMeasures : [],\n      availableMeasureColumns: columnLists.availableMeasureColumns,\n      availableNonMeasureColumns: columnLists.availableNonMeasureColumns,\n      segmentLabels\n    };\n  };\n\n  const processBusinessView = (businessViewJson) => {\n    const rootKeys = businessViewJson && typeof businessViewJson === \"object\" && !Array.isArray(businessViewJson)\n        ? Object.keys(businessViewJson)\n        : [];\n    const dataKey = rootKeys.find((key) => {\n      const lowerKey = key.toLowerCase();\n\n      return lowerKey.includes(\"data\") && lowerKey !== \"metadata\" && Array.isArray(businessViewJson[key]);\n    });\n    const records = dataKey ? businessViewJson[dataKey] : [];\n    const columns = new Set();\n\n    addColumnsFromRows(columns, records);\n\n    const segmentLabels = new Object();\n    const attributeDetails = Array.isArray(businessViewJson?.attributeDetails)\n        ? businessViewJson.attributeDetails\n        : [];\n\n    for (const attribute of attributeDetails) {\n      const attributeName = attribute?.attributeName;\n\n      if (attributeName) {\n        segmentLabels[attributeName] = attribute?.attributeLabel ?? \"\";\n      }\n    }\n\n    const columnLists = buildColumnLists(columns);\n\n    return {\n      mandatoryCoaSegments: [],\n      headLineMeasures: [],\n      availableMeasureColumns: columnLists.availableMeasureColumns,\n      availableNonMeasureColumns: columnLists.availableNonMeasureColumns,\n      segmentLabels,\n      dataKey: dataKey\n    };\n  };\n\n  return viewType === \"businessView\"\n      ? processBusinessView(inputObject)\n      : processAnalyticView(inputObject);\n};\n\n\nconst dataMetadata = processExtractJson(rawData,viewType);\n\nconst addRowIndexToRecords = (records, nextIndex) => {\n  if (!Array.isArray(records)) {\n    return nextIndex;\n  }\n\n  for (const record of records) {\n    if (record && typeof record === \"object\" && !Array.isArray(record)) {\n      record.rowIndex = nextIndex;\n      nextIndex += 1;\n    }\n  }\n\n  return nextIndex;\n};\n\nconst addRowIndexes = () => {\n  let nextIndex = 1;\n\n  if (viewType === \"businessView\") {\n    addRowIndexToRecords(rawData?.[dataMetadata.dataKey], nextIndex);\n    return;\n  }\n\n  const avExtractResult = rawData?.avExtractResult ?? new Object();\n\n  nextIndex = addRowIndexToRecords(avExtractResult.homogenousLedgerSetAvData?.records, nextIndex);\n\n  if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      nextIndex = addRowIndexToRecords(ledgerLevelData?.currentLevelAvData?.records, nextIndex);\n      nextIndex = addRowIndexToRecords(ledgerLevelData?.childLevelAvData?.records, nextIndex);\n    }\n  }\n};\n\naddRowIndexes();\n\nconst escapeMarkdownCell = (value) => String(value ?? \"\")\n    .replace(/\\r?\\n/g, \" \")\n    .replace(/\\|/g, \"\\\\|\")\n    .trim();\n\nconst getAnalyticViewRecordArrays = (avExtractResult, rowLevel = \"\") => {\n  const recordArrays = [];\n  const normalizedRowLevel = String(rowLevel ?? \"\").toLowerCase();\n  const addRecordArray = (dataRecords) => {\n    if (Array.isArray(dataRecords?.records)) {\n      recordArrays.push(dataRecords.records);\n    }\n  };\n\n  if (normalizedRowLevel === \"\" || normalizedRowLevel === \"summary\") {\n    addRecordArray(avExtractResult?.homogenousLedgerSetAvData);\n  }\n\n  if (Array.isArray(avExtractResult?.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      if (normalizedRowLevel === \"\" || normalizedRowLevel === \"summary\") {\n        addRecordArray(ledgerLevelData?.currentLevelAvData);\n      }\n\n      if (normalizedRowLevel === \"\" || normalizedRowLevel === \"child\") {\n        addRecordArray(ledgerLevelData?.childLevelAvData);\n      }\n    }\n  }\n\n  return recordArrays;\n};\n\nconst getSegmentDescriptionColumn = (column) => `${column}Description`;\n\nconst normalizeAllValueText = (value) => toCellText(value)\n    .replace(/[_\\s]+/g, \" \")\n    .toLowerCase();\n\nconst isAllSegmentValue = (value, label) => {\n  const normalizedValue = normalizeAllValueText(value);\n\n  return normalizedValue === \"all values\" || normalizedValue === normalizeAllValueText(`All ${label} Values`);\n};\n\nconst getAllSegmentValueColumns = (recordArrays, segmentLabels) => {\n  const allSegmentValueColumns = new Set();\n\n  for (const column of Object.keys(segmentLabels)) {\n    const label = toCellText(segmentLabels[column]);\n\n    if (!label || shouldRemoveColumn(column)) {\n      continue;\n    }\n\n    const descriptionColumn = getSegmentDescriptionColumn(column);\n    let hasValue = false;\n    let allValuesMatch = true;\n\n    for (const records of recordArrays) {\n      for (const record of records) {\n        if (!isRecordObject(record) || !Object.prototype.hasOwnProperty.call(record, column)) {\n          continue;\n        }\n\n        hasValue = true;\n\n        const value = toCellText(record[column]);\n        const description = toCellText(record[descriptionColumn]);\n\n        if (!isAllSegmentValue(value, label) && !isAllSegmentValue(description, label)) {\n          allValuesMatch = false;\n          break;\n        }\n      }\n\n      if (!allValuesMatch) {\n        break;\n      }\n    }\n\n    if (hasValue && allValuesMatch) {\n      allSegmentValueColumns.add(column);\n    }\n  }\n\n  return allSegmentValueColumns;\n};\n\nconst getSegmentDescriptionColumns = (segmentLabels) => new Set(\n    Object.keys(segmentLabels).map(getSegmentDescriptionColumn)\n);\n\nconst getSegmentCompanionColumns = (recordArrays, segmentColumns) => {\n  const companionColumns = new Set();\n  const segments = Array.from(segmentColumns);\n\n  for (const records of recordArrays) {\n    for (const record of records) {\n      if (!isRecordObject(record)) {\n        continue;\n      }\n\n      for (const column of Object.keys(record)) {\n        if (segments.some((segment) => column !== segment && column.startsWith(segment))) {\n          companionColumns.add(column);\n        }\n      }\n    }\n  }\n\n  return companionColumns;\n};\n\nconst isFlatSourceKeyOrder = Array.isArray(sourceKeyOrder) && sourceKeyOrder.every((key) => typeof key === \"string\");\n\nconst formatSegmentCellValue = (record, column, { includeDescription = false } = new Object()) => {\n  const value = toCellText(record?.[column]);\n\n  if (!includeDescription) {\n    return value;\n  }\n\n  const description = toCellText(record?.[getSegmentDescriptionColumn(column)]);\n\n  if (!value) {\n    return description;\n  }\n\n  if (!description || description === value) {\n    return value;\n  }\n\n  return `${value}-${description}`;\n};\n\nconst orderColumnsBySourceKeyOrder = (columns) => {\n  if (!isFlatSourceKeyOrder || columns.length === 0) {\n    return columns;\n  }\n\n  const columnSet = new Set(columns);\n  const orderedColumns = [];\n  const usedColumns = new Set();\n\n  for (const column of sourceKeyOrder) {\n    if (columnSet.has(column) && !usedColumns.has(column)) {\n      orderedColumns.push(column);\n      usedColumns.add(column);\n    }\n  }\n\n  for (const column of columns) {\n    if (!usedColumns.has(column)) {\n      orderedColumns.push(column);\n      usedColumns.add(column);\n    }\n  }\n\n  return orderedColumns;\n};\n\nconst getColumns = (records, columnsToOmit = new Set()) => {\n  const columns = [];\n  const seenColumns = new Set();\n  let hasRowIndex = false;\n\n  for (const record of records) {\n    if (!isRecordObject(record)) {\n      continue;\n    }\n\n    for (const column of Object.keys(record)) {\n      if (column === \"rowIndex\") {\n        hasRowIndex = true;\n        continue;\n      }\n\n      if (shouldRemoveColumn(column) || columnsToOmit.has(column) || seenColumns.has(column)) {\n        continue;\n      }\n\n      columns.push(column);\n      seenColumns.add(column);\n    }\n  }\n\n  const orderedColumns = orderColumnsBySourceKeyOrder(columns);\n\n  if (hasRowIndex && !columnsToOmit.has(\"rowIndex\")) {\n    orderedColumns.push(\"rowIndex\");\n  }\n\n  return orderedColumns;\n};\n\nconst recordsToMarkdownTable = (records, columnsToOmit = new Set(), segmentColumns = new Set(), options = new Object()) => {\n  if (!Array.isArray(records) || records.length === 0) {\n    return \"\";\n  }\n\n  const columns = getColumns(records, columnsToOmit);\n\n  if (columns.length === 0) {\n    return \"\";\n  }\n\n  const header = `| ${columns.map(escapeMarkdownCell).join(\" | \")} |`;\n  const separator = `| ${columns.map(() => \"---\").join(\" | \")} |`;\n  const rows = records.map((record) => {\n    const cells = columns.map((column) => {\n      const cellValue = segmentColumns.has(column)\n          ? formatSegmentCellValue(record, column, options)\n          : record?.[column];\n\n      return escapeMarkdownCell(cellValue);\n    });\n\n    return `| ${cells.join(\" | \")} |`;\n  });\n\n  return [header, separator, ...rows].join(\"\\n\");\n};\n\nconst getRowIndexes = (records) => (Array.isArray(records) ? records : [])\n    .map((record) => record?.rowIndex)\n    .filter((rowIndex) => rowIndex !== undefined && rowIndex !== null && String(rowIndex).trim() !== \"\");\n\nconst getSummaryBlockMode = (records) => {\n  if (!Array.isArray(records) || records.length === 0) {\n    return \"none\";\n  }\n\n  return records.length === 1 ? \"fullAmountEligible\" : \"contextHeadlineEligible\";\n};\n\nconst getChildBlockMode = (summaryRecords, detailRecords) => {\n  if (!Array.isArray(detailRecords) || detailRecords.length === 0) {\n    return \"none\";\n  }\n\n  if (Array.isArray(summaryRecords) && summaryRecords.length > 0) {\n    return \"none\";\n  }\n\n  return detailRecords.length === 1 ? \"fullAmountEligible\" : \"contextHeadlineEligible\";\n};\n\nconst getBusinessViewSummaryMode = (records) => {\n  if (!Array.isArray(records) || records.length === 0) {\n    return \"none\";\n  }\n\n  return records.length > 1 ? \"contextHeadlineEligible\" : \"none\";\n};\n\nconst buildPlannerDataBlock = ({ viewName, rowLevel, records, columnsToOmit = new Set(), segmentColumns = new Set(), summaryMode = \"none\", omitColumns = [] }) => {\n  const safeRecords = Array.isArray(records) ? records : [];\n  const includeSegmentDescriptions = summaryMode === \"fullAmountEligible\";\n  const lines = [];\n\n  if (viewName) {\n    lines.push(`viewName: ${viewName}`);\n  }\n\n  lines.push(`rowLevel: ${rowLevel}`);\n  lines.push(`rowCount: ${safeRecords.length}`);\n  lines.push(`hasRows: ${safeRecords.length > 0}`);\n  lines.push(`rowIndexes: ${JSON.stringify(getRowIndexes(safeRecords))}`);\n  lines.push(`summaryMode: ${summaryMode}`);\n  lines.push(`omitColumns: ${JSON.stringify(Array.isArray(omitColumns) ? omitColumns : [])}`);\n\n  const markdownTable = recordsToMarkdownTable(safeRecords, columnsToOmit, segmentColumns, {\n    includeDescription: includeSegmentDescriptions\n  });\n\n  return markdownTable\n      ? [...lines, \"\", markdownTable].join(\"\\n\")\n      : lines.join(\"\\n\");\n};\n\nconst getColumnsToOmit = (recordArrays, segmentLabels, baseColumnsToOmit = new Set()) => {\n  const allSegmentValueColumns = getAllSegmentValueColumns(recordArrays, segmentLabels);\n\n  return new Set([\n    ...baseColumnsToOmit,\n    ...allSegmentValueColumns,\n    ...Array.from(allSegmentValueColumns).map(getSegmentDescriptionColumn)\n  ]);\n};\n\nconst flattenRecordArrays = (recordArrays) => recordArrays.flatMap((records) =>\n    Array.isArray(records) ? records.filter(isRecordObject) : []\n);\n\nconst normalizeIntentText = (value) => toCellText(value)\n    .replace(/\\s+/g, \" \");\n\nconst normalizeIntentKey = (value) => normalizeIntentText(value).toLowerCase();\n\nconst toLowerCamelIntentKey = (value) => {\n  const words = normalizeIntentText(value)\n      .replace(/[^A-Za-z0-9]+/g, \" \")\n      .split(\" \")\n      .filter(Boolean);\n\n  if (words.length === 0) {\n    return \"\";\n  }\n\n  return words\n      .map((word, index) => {\n        const lowerWord = word.toLowerCase();\n\n        return index === 0\n            ? lowerWord\n            : lowerWord.charAt(0).toUpperCase() + lowerWord.slice(1);\n      })\n      .join(\"\");\n};\n\nconst isCoaSegmentColumn = (column) => coaSegmentColumnSet.has(column);\n\nconst splitIntentValues = (value) => {\n  if (Array.isArray(value)) {\n    return value.flatMap(splitIntentValues);\n  }\n\n  const text = value && typeof value === \"object\"\n      ? JSON.stringify(value)\n      : String(value ?? \"\");\n\n  return text\n      .split(\",\")\n      .map(normalizeIntentText)\n      .filter(Boolean);\n};\n\nconst isParenthesizedIntentValue = (value) => {\n  const valueText = normalizeIntentText(value);\n\n  return valueText.startsWith(\"(\") && valueText.endsWith(\")\");\n};\n\nconst normalizeIntentValueForColumn = (value, isSegmentColumn) => {\n  const valueText = normalizeIntentText(value);\n\n  if (!isSegmentColumn || isParenthesizedIntentValue(valueText)) {\n    return valueText;\n  }\n\n  const separatorIndex = valueText.indexOf(\"-\");\n  return separatorIndex > 0 ? valueText.slice(0, separatorIndex).trim() : valueText;\n};\n\nconst getAvailableRecordColumns = (records) => {\n  const columns = new Set();\n\n  for (const record of Array.isArray(records) ? records : []) {\n    if (!isRecordObject(record)) {\n      continue;\n    }\n\n    for (const column of Object.keys(record)) {\n      if (column !== \"rowIndex\" && !shouldRemoveColumn(column)) {\n        columns.add(column);\n      }\n    }\n  }\n\n  return columns;\n};\n\nconst getIntentColumnsForKey = (key, segmentLabels = new Object(), availableColumns = new Set()) => {\n  const normalizedKey = normalizeIntentKey(key);\n  const columns = [];\n  const addColumn = (column) => {\n    if (!column || columns.includes(column)) {\n      return;\n    }\n\n    if (availableColumns.size === 0 || availableColumns.has(column)) {\n      columns.push(column);\n    }\n  };\n\n  for (const [column, label] of Object.entries(segmentLabels)) {\n    if (normalizeIntentKey(label) === normalizedKey || normalizeIntentKey(column) === normalizedKey) {\n      addColumn(column);\n    }\n  }\n\n  for (const column of availableColumns) {\n    if (normalizeIntentKey(column) === normalizedKey) {\n      addColumn(column);\n    }\n  }\n\n  addColumn(toLowerCamelIntentKey(key));\n\n  const knownIntentColumnsByKey = {\n    ledger: [\"ledger\"]\n  };\n\n  for (const column of knownIntentColumnsByKey[normalizedKey] || []) {\n    addColumn(column);\n  }\n\n  return columns;\n};\n\nconst getIntentDetailsObject = (intentDetails) => {\n  if (!isRecordObject(intentDetails)) {\n    return new Object();\n  }\n\n  return isRecordObject(intentDetails.intentDetails) ? intentDetails.intentDetails : intentDetails;\n};\n\nconst addUniqueValue = (values, value) => {\n  const normalizedValue = normalizeIntentKey(value);\n\n  if (!normalizedValue || values.some((existingValue) => normalizeIntentKey(existingValue) === normalizedValue)) {\n    return;\n  }\n\n  values.push(value);\n};\n\nconst escapeRegex = (value) => String(value ?? \"\").replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n\nconst addHierarchyFilterValue = (hierarchyFilters, value) => {\n  const filterText = toCellText(value);\n\n  if (filterText) {\n    hierarchyFilters.add(filterText);\n  }\n};\n\nconst extractBusinessViewTreeFilters = (queryResponseSource) => {\n  const treeFilters = new Set();\n  const treeFilterRegex = /\\btreeFilter\\s*=\\s*'([^']+)'/g;\n  const collectTreeFilters = (hierarchies) => {\n    if (!isRecordObject(hierarchies)) {\n      return;\n    }\n\n    for (const hierarchy of Object.values(hierarchies)) {\n      const filterText = String(hierarchy?.filter ?? \"\");\n      let match;\n\n      while ((match = treeFilterRegex.exec(filterText)) !== null) {\n        const treeFilter = toCellText(match[1]);\n\n        if (treeFilter) {\n          treeFilters.add(treeFilter);\n        }\n      }\n    }\n  };\n\n  const query = Array.isArray(queryResponseSource?.queries) ? queryResponseSource.queries[0] : undefined;\n  collectTreeFilters(query?.hierarchies);\n\n  return treeFilters;\n};\n\nconst extractAnalyticViewHierarchyFilters = (hierarchiesUsed) => {\n  const hierarchyFilters = new Set();\n  const visit = (value) => {\n    if (Array.isArray(value)) {\n      value.forEach(visit);\n      return;\n    }\n\n    if (isRecordObject(value)) {\n      Object.values(value).forEach(visit);\n      return;\n    }\n\n    if (typeof value !== \"string\") {\n      return;\n    }\n\n    addHierarchyFilterValue(hierarchyFilters, value);\n\n    for (const part of value.split(/[;,]/)) {\n      const colonIndex = part.indexOf(\":\");\n\n      if (colonIndex >= 0) {\n        addHierarchyFilterValue(hierarchyFilters, part.slice(colonIndex + 1));\n      }\n    }\n  };\n\n  visit(hierarchiesUsed);\n  return hierarchyFilters;\n};\n\nconst removeTreeFilterParentheticals = (value, treeFilters = new Set()) => {\n  let cleanedValue = toCellText(value);\n\n  if (!cleanedValue || !(treeFilters instanceof Set) || treeFilters.size === 0) {\n    return cleanedValue;\n  }\n\n  for (const treeFilter of treeFilters) {\n    const filterText = toCellText(treeFilter);\n\n    if (!filterText) {\n      continue;\n    }\n\n    const parentheticalPattern = new RegExp(`\\\\(\\\\s*${escapeRegex(filterText)}\\\\s*\\\\)`, \"g\");\n    cleanedValue = cleanedValue.replace(parentheticalPattern, \" \");\n  }\n\n  return normalizeIntentText(cleanedValue);\n};\n\nconst buildIntentScopeData = (intentDetails, segmentLabels = new Object(), records = [], { hierarchyFilters = new Set() } = new Object()) => {\n  const intentDetailsObject = getIntentDetailsObject(intentDetails);\n  const availableColumns = getAvailableRecordColumns(records);\n  const scopeByColumn = new Map();\n  const intentScopeDisplay = new Object();\n\n  for (const [key, value] of Object.entries(intentDetailsObject)) {\n    const normalizedKey = normalizeIntentKey(key);\n    const shouldAddDisplayValue = normalizedKey !== \"data source\" && normalizedKey !== \"source\";\n\n    const columns = getIntentColumnsForKey(key, segmentLabels, availableColumns);\n\n    if (columns.length === 0) {\n      continue;\n    }\n\n    for (const column of columns) {\n      const isSegmentColumn = isCoaSegmentColumn(column);\n\n      if (!scopeByColumn.has(column)) {\n        scopeByColumn.set(column, {\n          column,\n          values: [],\n          usableValues: []\n        });\n      }\n\n      const scope = scopeByColumn.get(column);\n\n      for (const rawValue of splitIntentValues(value)) {\n        const cleanedDisplayValue = removeTreeFilterParentheticals(rawValue, hierarchyFilters);\n        const intentValue = normalizeIntentValueForColumn(rawValue, isSegmentColumn);\n\n        addUniqueValue(scope.values, intentValue);\n\n        if (!isParenthesizedIntentValue(intentValue)) {\n          addUniqueValue(scope.usableValues, intentValue);\n        }\n\n        if (!shouldAddDisplayValue || !cleanedDisplayValue || isParenthesizedIntentValue(cleanedDisplayValue)) {\n          continue;\n        }\n\n        if (!intentScopeDisplay[column]) {\n          intentScopeDisplay[column] = [];\n        }\n\n        addUniqueValue(intentScopeDisplay[column], cleanedDisplayValue);\n      }\n    }\n  }\n\n  const intentScopeEntries = Array.from(scopeByColumn.values());\n  const intentScope = new Object();\n\n  for (const entry of intentScopeEntries) {\n    intentScope[entry.column] = entry.values;\n  }\n\n  return {\n    intentScope,\n    intentScopeEntries,\n    intentScopeDisplay\n  };\n};\n\nconst shouldEmitIntentScopeDisplay = (...summaryModes) =>\n    summaryModes.some((summaryMode) => summaryMode === \"contextHeadlineEligible\");\n\nconst buildIntentScopeDisplayPrompt = (intentScopeDisplay, shouldEmit) => {\n  if (!shouldEmit || !intentScopeDisplay || Object.keys(intentScopeDisplay).length === 0) {\n    return \"\";\n  }\n\n  return [\n    `\\n<intent_scope_display>`,\n    JSON.stringify(intentScopeDisplay),\n    `</intent_scope_display>\\n`\n  ].join(\"\\n\");\n};\n\nconst normalizeComparableValue = (value, isSegmentColumn) =>\n    normalizeIntentValueForColumn(value, isSegmentColumn).toLowerCase();\n\nconst getIntentOmitColumns = (records, intentScopeEntries = [], columnsToOmit = new Set()) => {\n  const safeRecords = Array.isArray(records) ? records : [];\n\n  if (safeRecords.length === 0) {\n    return [];\n  }\n\n  const omitColumns = [];\n\n  for (const entry of intentScopeEntries) {\n    const column = entry?.column;\n    const usableValues = Array.isArray(entry?.usableValues) ? entry.usableValues : [];\n\n    if (!column || shouldRemoveColumn(column) || columnsToOmit.has(column) || usableValues.length !== 1) {\n      continue;\n    }\n\n    const isSegmentColumn = isCoaSegmentColumn(column);\n    const expectedValue = normalizeComparableValue(usableValues[0], isSegmentColumn);\n\n    if (!expectedValue) {\n      continue;\n    }\n\n    const allRowsMatch = safeRecords.every((record) => {\n      if (!isRecordObject(record) || !Object.prototype.hasOwnProperty.call(record, column)) {\n        return false;\n      }\n\n      const displayedValue = isSegmentColumn\n          ? formatSegmentCellValue(record, column)\n          : record[column];\n\n      return normalizeComparableValue(displayedValue, isSegmentColumn) === expectedValue;\n    });\n\n    if (allRowsMatch) {\n      omitColumns.push(column);\n    }\n  }\n\n  return omitColumns;\n};\n\nconst buildAnalyticViewMarkdownData = (avExtractResult, segmentLabels, hierarchyFilters = new Set()) => {\n  const recordArrays = getAnalyticViewRecordArrays(avExtractResult);\n  const summaryRecordArrays = getAnalyticViewRecordArrays(avExtractResult, \"summary\");\n  const detailRecordArrays = getAnalyticViewRecordArrays(avExtractResult, \"child\");\n  const summaryRecords = flattenRecordArrays(summaryRecordArrays);\n  const detailRecords = flattenRecordArrays(detailRecordArrays);\n  const segmentColumns = new Set(Object.keys(segmentLabels));\n  const segmentCompanionColumns = getSegmentCompanionColumns(recordArrays, segmentColumns);\n  const baseColumnsToOmit = new Set([\n    ...segmentCompanionColumns,\n    ...getSegmentDescriptionColumns(segmentLabels)\n  ]);\n  const summaryColumnsToOmit = getColumnsToOmit(summaryRecordArrays, segmentLabels, baseColumnsToOmit);\n  const detailColumnsToOmit = getColumnsToOmit(detailRecordArrays, segmentLabels, baseColumnsToOmit);\n  const intentScopeData = buildIntentScopeData(rawIntentDetails, segmentLabels, [...summaryRecords, ...detailRecords], {\n    hierarchyFilters\n  });\n  const summaryIntentOmitColumns = getIntentOmitColumns(summaryRecords, intentScopeData.intentScopeEntries, summaryColumnsToOmit);\n  const detailIntentOmitColumns = getIntentOmitColumns(detailRecords, intentScopeData.intentScopeEntries, detailColumnsToOmit);\n  const summaryMode = getSummaryBlockMode(summaryRecords);\n  const detailMode = getChildBlockMode(summaryRecords, detailRecords);\n\n  return {\n    markdownDataSummary: buildPlannerDataBlock({\n      rowLevel: \"summary\",\n      records: summaryRecords,\n      columnsToOmit: summaryColumnsToOmit,\n      segmentColumns,\n      summaryMode,\n      omitColumns: summaryIntentOmitColumns\n    }),\n    markdownDataDetail: buildPlannerDataBlock({\n      rowLevel: \"child\",\n      records: detailRecords,\n      columnsToOmit: detailColumnsToOmit,\n      segmentColumns,\n      summaryMode: detailMode,\n      omitColumns: detailIntentOmitColumns\n    }),\n    intentScope: intentScopeData.intentScope,\n    intentScopeDisplay: buildIntentScopeDisplayPrompt(\n        intentScopeData.intentScopeDisplay,\n        shouldEmitIntentScopeDisplay(summaryMode, detailMode)\n    )\n  };\n};\n\nlet tableData = new Object();\nlet markdownDataSummary = \"\";\nlet markdownDataDetail = \"\";\nlet intentScope = new Object();\nlet intentScopeDisplay = \"\";\n\nif(viewType === 'analyticView'){\n  const avExtractResult = rawData?.avExtractResult ?? new Object();\n\n  if(avExtractResult.homogenousLedgerSetAvData){\n    tableData.homogenousLedgerSetAvData = avExtractResult.homogenousLedgerSetAvData;\n  }\n  if(avExtractResult.ledgerLevelAvData){\n    tableData.ledgerLevelAvData = avExtractResult.ledgerLevelAvData;\n  }\n\n  const analyticViewHierarchyFilters = extractAnalyticViewHierarchyFilters(\n      avExtractResult?.hierarchiesUsed ?? dataResponse?.avExtractResult?.hierarchiesUsed\n  );\n  const analyticViewMarkdownData = buildAnalyticViewMarkdownData(\n      avExtractResult,\n      dataMetadata.segmentLabels,\n      analyticViewHierarchyFilters\n  );\n  markdownDataSummary = analyticViewMarkdownData.markdownDataSummary;\n  markdownDataDetail = analyticViewMarkdownData.markdownDataDetail;\n  intentScope = analyticViewMarkdownData.intentScope;\n  intentScopeDisplay = analyticViewMarkdownData.intentScopeDisplay;\n}\nelse{\n  tableData = rawData[dataMetadata.dataKey];\n\n  const businessViewRecords = Array.isArray(tableData) ? tableData : [];\n  const businessViewSegmentColumns = new Set(Object.keys(dataMetadata.segmentLabels));\n  const businessViewTreeFilters = extractBusinessViewTreeFilters(queryResponse);\n  const intentScopeData = buildIntentScopeData(rawIntentDetails, dataMetadata.segmentLabels, businessViewRecords, {\n    hierarchyFilters: businessViewTreeFilters\n  });\n  const businessViewIntentOmitColumns = getIntentOmitColumns(\n      businessViewRecords,\n      intentScopeData.intentScopeEntries\n  );\n  const businessViewSummaryMode = getBusinessViewSummaryMode(businessViewRecords);\n\n  markdownDataDetail = buildPlannerDataBlock({\n    viewName: dataMetadata.dataKey,\n    rowLevel: \"detail\",\n    records: businessViewRecords,\n    segmentColumns: businessViewSegmentColumns,\n    summaryMode: businessViewSummaryMode,\n    omitColumns: businessViewIntentOmitColumns\n  });\n  intentScope = intentScopeData.intentScope;\n  intentScopeDisplay = buildIntentScopeDisplayPrompt(\n      intentScopeData.intentScopeDisplay,\n      shouldEmitIntentScopeDisplay(businessViewSummaryMode)\n  );\n}\n\ndataMetadata.tableData = tableData;\ndataMetadata.markdownDataSummary = markdownDataSummary;\ndataMetadata.markdownDataDetail = markdownDataDetail;\ndataMetadata.intentScope = intentScope;\ndataMetadata.intentScopeDisplay = intentScopeDisplay;\ndataMetadata.queryGenerationQuestion = queryGenerationQuestion;\nconst varianceContext = avMetaData?.varianceContext || new Object();\nconst varianceMeasureLabelColumns = [\n  ...Object.keys(avMetaData?.measureLabels || new Object()),\n  ...(Array.isArray(dataMetadata.availableMeasureColumns) ? dataMetadata.availableMeasureColumns : [])\n];\ndataMetadata.varianceContext = varianceContext;\ndataMetadata.varianceMeasurePrefix = getVarianceMeasurePrefix(varianceContext, varianceMeasureLabelColumns);\ndataMetadata.measureLabels = {\n  ...(avMetaData?.measureLabels || new Object()),\n  ...getVarianceMeasureLabels(varianceContext, varianceMeasureLabelColumns)\n};\ndataMetadata.viewName = viewName;\ndataMetadata.viewType = viewType;\n\nreturn dataMetadata;"
