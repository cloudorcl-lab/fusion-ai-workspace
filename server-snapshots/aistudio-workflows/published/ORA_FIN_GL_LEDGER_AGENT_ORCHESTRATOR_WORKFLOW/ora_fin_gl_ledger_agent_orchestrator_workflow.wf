        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Set Summarization Path",
            "returnType": "object",
            "sourceCode": "const res = {\n    path: \"default\",\n};\n\nconst currentDomain = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName;\n\nif (currentDomain === 'ora_fin_gl_process_exceptions_assistant') {\n    res.path = 'process_exceptions_insight';\n}\nelse {\n    let nonExpandResponseFound = true;\n    const viewType = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery.analyticViewNameUsed ? \"analyticView\" : \"businessView\";\n    const dataPayload = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state?.private?.lastUsedData?.dataPayload || {};\n    const dataResponse = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state?.private?.lastUsedData?.dataResponse || {};\n\n    const hasNonExpandAvData = (ledgerLevelAvData) => {\n\n        return ledgerLevelAvData.some((avData) => avData && (\n            Object.prototype.hasOwnProperty.call(avData, \"currentLevelAvData\") ||\n            Object.prototype.hasOwnProperty.call(avData, \"childLevelAvData\")\n        ));\n    }\n\n    if (currentDomain === 'ora_fin_gl_subledger_supporting_details_assistant') {\n        if (viewType === 'analyticView') {\n            const ledgerLevelAvData = dataResponse?.avExtractResult?.ledgerLevelAvData || dataResponse?.ledgerLevelAvData;\n            if (dataPayload?.expandSubledgerData && !hasNonExpandAvData(ledgerLevelAvData)) {\n                res.path = \"subledger\";\n            }\n        }\n        else {\n            if (dataPayload?.expandSubledgerBvData && !Object.prototype.hasOwnProperty.call(dataResponse, \"hasMore\")) {\n                res.path = \"subledger\";\n            }\n        }\n    }\n\n}\n\nreturn res;"
