            "name": "Process ProcessExceptions Response",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.FIN_GL_BO_FUNCTION_PROCESS_EXCEPTIONS_DATA.$output;\nconst returnObj = {\n    path: 'workflow'\n};\n\nif(response && response.errorMessage){\n    returnObj.path = 'error';\n    returnObj.errorMessage = response.errorMessage;\n}\nelse{\n    returnObj.state = {\n        shared: {},\n        private: {\n            lastUsedData:{\n                dataPayload: $context.$nodes.PREPARE_PE_BV_PAYLOAD.$output.result,\n                dataResponse: response\n            }\n        }\n    };\n}\n\nreturn returnObj;"
          },
          "outcomes": {
