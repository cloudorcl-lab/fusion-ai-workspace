            "name": "Process Select Subledger",
            "returnType": "object",
            "sourceCode": "const llmOutput = $context.$nodes.FIN_GL_LLM_LEDGER_ORCH_SUBLEDGER_SELECTOR.$output;\nconst defaultFollowupMessage = \"Please state which subledger to use: payables or receivables.\";\n\nlet selectedIndex = -1;\nlet followupMessage = defaultFollowupMessage;\n\nif (\n    llmOutput &&\n    typeof llmOutput === \"object\" &&\n    Number.isInteger(llmOutput.selectedIndex) &&\n    [0, 1, -1].includes(llmOutput.selectedIndex)\n) {\n    selectedIndex = llmOutput.selectedIndex;\n\n    if (selectedIndex === -1 && typeof llmOutput.followupMessage === \"string\" && llmOutput.followupMessage.trim()) {\n        followupMessage = llmOutput.followupMessage.trim();\n    }\n}\n\nconst returnObj = {\n    selectedIndex\n};\n\nif (selectedIndex === -1) {\n    returnObj.followupMessage = followupMessage;\n}\n\nreturn returnObj;"
          },
