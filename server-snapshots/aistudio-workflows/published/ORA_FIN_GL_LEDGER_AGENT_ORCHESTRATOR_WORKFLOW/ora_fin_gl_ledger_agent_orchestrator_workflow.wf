            "sourceCode": "let schema = {\n    \"agent\": \"test\",\n    \"intent\": \"Response\",\n    \"schema_version\": 1,\n    \"title\": \"Response\",\n    \"description\": \"Response\",\n    \"timestamp\": $context.$system.$currentDateTime,\n    \"topicName\": \"Response\",\n    \"category\": \"Response\",\n    \"agent_response\": []\n};\n\nconst sumPreRes = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result;\nconst metadata = sumPreRes.metadata || {};\n\nschema.agent_response = sumPreRes.agentResponse;\nschema.agent = metadata.agentName || schema.agent;\nschema.category = metadata.category || schema.category;\n\nif (metadata.intent) {\n    schema.intent = metadata.intent;\n}\n\nif (metadata.timeStamp) {\n    schema.timestamp = metadata.timeStamp;\n}\n\nif (metadata.user_chosen_ledgers) {\n    schema.user_chosen_ledgers = metadata.user_chosen_ledgers;\n}\n\nif (metadata.selectedHierarchies) {\n    schema.selectedHierarchies = metadata.selectedHierarchies;\n}\n\nreturn schema;"
