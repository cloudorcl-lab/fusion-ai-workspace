        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_GL_FINAL_RESPONSE_JSON_HELPER",
            "errorNodeId": "1777160083692",
            "functionName": "getFinalJson",
            "processJson": true,
            "name": "Transform to Final Json"
          },
          "outcomes": {
            "success": "1778713903611"
          },
          "code": "TRANSFORM_TO_FINAL_JSON",
          "id": "1778713902611",
          "inputs": [
            {
              "id": "1779428727807_1",
              "name": "agentOutput",
              "type": "string",
              "value": "{{$context.$variables.adsPayload}}"
            },
            {
              "id": "1779428727809_2",
              "name": "agentName",
              "type": "string",
              "value": "{{$context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Prepare Return Obj",
            "returnType": "object",
            "sourceCode": "const returnObj = {\n    chatJson: $context.$nodes.TRANSFORM_TO_FINAL_JSON.$output,\n    displayedColumns: [],\n    availableColumns: [],\n    displayTables: []\n};\n\nconst isBalanceAssistant = $context.$variables.routingDecision === \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\nconst balanceDisplayOnlyOmitColumns = new Set([\"ledgerCurrency\", \"enteredCurrency\"]);\nconst filterDisplayedColumns = (columns) => {\n    const result = [];\n    const seen = new Set();\n\n    for (const column of Array.isArray(columns) ? columns : []) {\n        if (seen.has(column)) {\n            continue;\n        }\n\n        seen.add(column);\n\n        if (isBalanceAssistant && balanceDisplayOnlyOmitColumns.has(column)) {\n            continue;\n        }\n\n        result.push(column);\n    }\n\n    return result;\n};\n\nif($context.$nodes.SET_SUMMARIZATION_PATH.$output.result.path === 'default'){\n    const displayPlan = $context.$nodes.DISPLAY_PLANNING_LLM.$output;\n    const rawDataPreprocess = $context.$nodes.RAW_DATA_PREPROCESS.$output.result;\n    const viewType = rawDataPreprocess.viewType;\n    const tableData = rawDataPreprocess.tableData;\n    const allAvailableColumns = [ ...rawDataPreprocess.availableMeasureColumns, ...rawDataPreprocess.availableNonMeasureColumns];\n\n    const isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\n\n    const dedupe = (values) => {\n        const result = [];\n        const seen = new Set();\n\n        for (const value of Array.isArray(values) ? values : []) {\n            if (seen.has(value)) {\n                continue;\n            }\n\n            result.push(value);\n            seen.add(value);\n        }\n\n        return result;\n    };\n\n    const addRecordColumns = (columns, records) => {\n        for (const record of Array.isArray(records) ? records : []) {\n            if (!isRecordObject(record)) {\n                continue;\n            }\n\n            for (const column of Object.keys(record)) {\n                columns.add(column);\n            }\n        }\n    };\n\n    const addLevelRows = (columns, level, rowLevel) => {\n        if (rowLevel === \"summary\" || rowLevel === \"\") {\n            addRecordColumns(columns, level?.currentLevelAvData?.records);\n        }\n\n        if (rowLevel === \"child\" || rowLevel === \"\") {\n            addRecordColumns(columns, level?.childLevelAvData?.records);\n        }\n    };\n\n    const getAvailableColumnsForRowLevel = (rowLevel) => {\n        if (viewType === \"businessView\") {\n            return allAvailableColumns;\n        }\n\n        const rowColumns = new Set();\n        const normalizedRowLevel = String(rowLevel ?? \"\").toLowerCase();\n\n        if (normalizedRowLevel === \"summary\" || normalizedRowLevel === \"\") {\n            addRecordColumns(rowColumns, tableData?.homogenousLedgerSetAvData?.records);\n        }\n\n        for (const level of Array.isArray(tableData?.ledgerLevelAvData) ? tableData.ledgerLevelAvData : []) {\n            addLevelRows(rowColumns, level, normalizedRowLevel);\n        }\n\n        return allAvailableColumns.filter((column) => rowColumns.has(column));\n    };\n\n    const isPresentationPath = $context.$nodes.PRESENTATION_INTENT_CLASSIFIER?.$output?.shouldUsePresentationWorkflow === true;\n    const previousDisplayTables = $context.$variables.state?.domains?.[`${$context.$variables.routingDecision}_displayColumns`]?.tables;\n    const previousTablesByRowLevel = {};\n\n    for (const table of Array.isArray(previousDisplayTables) ? previousDisplayTables : []) {\n        previousTablesByRowLevel[String(table?.rowLevel ?? \"\").toLowerCase()] = table;\n    }\n\n    const getSummaryForTable = (table, rowLevel) => {\n        const previousSummary = previousTablesByRowLevel[rowLevel]?.summary;\n\n        if (isPresentationPath && typeof previousSummary === \"string\") {\n            return previousSummary;\n        }\n\n        return table?.summary;\n    };\n\n    const getDefaultRowLevel = () => viewType === \"businessView\" ? \"detail\" : \"\";\n\n    const getDisplayPlanTables = () => {\n        if (Array.isArray(displayPlan?.tables) && displayPlan.tables.length > 0) {\n            return displayPlan.tables;\n        }\n\n        return [{\n            rowLevel: getDefaultRowLevel(),\n            columns: Array.isArray(displayPlan?.columns) ? displayPlan.columns : [],\n            rowsToExclude: Array.isArray(displayPlan?.rowsToExclude) ? displayPlan.rowsToExclude : [],\n            summary: displayPlan?.summary\n        }];\n    };\n\n    const displayPlanTables = getDisplayPlanTables();\n\n    returnObj.displayedColumns = filterDisplayedColumns(displayPlanTables.flatMap((table) => Array.isArray(table?.columns) ? table.columns : []));\n    returnObj.availableColumns = allAvailableColumns;\n    returnObj.displayTables = displayPlanTables.map((table) => {\n        const rowLevel = String(table?.rowLevel ?? \"\").toLowerCase();\n\n        return {\n            rowLevel,\n            displayed: filterDisplayedColumns(table?.columns),\n            available: getAvailableColumnsForRowLevel(rowLevel),\n            rowsToExclude: Array.isArray(table?.rowsToExclude) ? table.rowsToExclude : [],\n            summary: getSummaryForTable(table, rowLevel)\n        };\n    });\n}\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1777872310740"
          },
