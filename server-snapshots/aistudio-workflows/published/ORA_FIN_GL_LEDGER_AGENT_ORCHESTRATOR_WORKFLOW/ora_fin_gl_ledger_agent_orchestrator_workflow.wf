        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Format Fallback",
            "returnType": "object",
            "sourceCode": "let formatFallBackLlmResponseInput = $context.$nodes.SUMMARIZATION_FALLBACK.$output;\nlet obj =\n  typeof formatFallBackLlmResponseInput === \"string\"\n    ? JSON.parse(formatFallBackLlmResponseInput)\n    : formatFallBackLlmResponseInput;\n\nconst NON_LEAF_NODE_STYLE_TAG_PREFIX = \"<span style='font-weight: 600;'>\";\nconst NON_LEAF_NODE_STYLE_TAG_SUFFIX = \"</span>\";\n\nif (obj && Array.isArray(obj.agent_response)) {\n  for (let i = 0; i < obj.agent_response.length; i++) {\n    const ar = obj.agent_response[i];\n\n    if (ar && ar.display_type === \"table\" && ar.rows && Array.isArray(ar.rows.items)) {\n      const items = ar.rows.items;\n\n      for (let r = 0; r < items.length; r++) {\n        const row = items[r];\n        if (!row || typeof row !== \"object\") continue;\n\n        const keys = Object.keys(row);\n        for (let k = 0; k < keys.length; k++) {\n          const field = keys[k];\n          const val = row[field];\n\n          if (val == null) continue;\n          if (typeof val !== \"string\") continue;\n          if (val.trim().length === 0) continue;\n\n          const firstIdx = val.indexOf(\"||\");\n          if (firstIdx === -1) continue;\n\n          const secondIdx = val.indexOf(\"||\", firstIdx + 2);\n          if (secondIdx !== -1) continue;\n\n          const left = val.slice(0, firstIdx).trim();\n          const right = val.slice(firstIdx + 2).trim();\n\n          if (right !== \"0\" && right !== \"1\") continue;\n\n          if (right === \"0\") {\n            row[field] = NON_LEAF_NODE_STYLE_TAG_PREFIX + left + NON_LEAF_NODE_STYLE_TAG_SUFFIX;\n          } else {\n            row[field] = left;\n          }\n        }\n      }\n    }\n  }\n}\n\n\nreturn obj;"
          },
          "outcomes": {
            "success": "1777163011528"
          },
          "code": "FORMAT_FALLBACK",
          "id": "1777162655343",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
