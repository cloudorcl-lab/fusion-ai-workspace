        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Try Deterministic Routing",
            "returnType": "boolean",
            "sourceCode": "const parseObject = (value) => {\n  if (value !== null && typeof value === \"object\" && !Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === \"string\") {\n    try {\n      const parsedValue = JSON.parse(value);\n      return parsedValue !== null && typeof parsedValue === \"object\" && !Array.isArray(parsedValue) ? parsedValue : {};\n    } catch (error) {}\n  }\n  return {};\n};\n\nconst additionalContext = parseObject(\n  $context.$triggers.REST.$input.additional_context ||\n  $context.$triggers.REST.$input.additionalContext\n);\n\nconst hasBossExtract =\n  Object.prototype.hasOwnProperty.call(additionalContext, \"bossExtract\") &&\n  additionalContext.bossExtract !== null &&\n  additionalContext.bossExtract !== undefined;\nconst hasInquiryTarget =\n  Object.prototype.hasOwnProperty.call(additionalContext, \"inquiryTargetObjectType\") &&\n  additionalContext.inquiryTargetObjectType !== null &&\n  additionalContext.inquiryTargetObjectType !== undefined;\nconst shouldRouteDeterministically = hasBossExtract || hasInquiryTarget;\nreturn shouldRouteDeterministically;"
          },
          "outcomes": {
            "success": "1778654417391"
          },
          "code": "TRY_DETERMINISTIC_ROUTING",
          "id": "1770416709364",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
