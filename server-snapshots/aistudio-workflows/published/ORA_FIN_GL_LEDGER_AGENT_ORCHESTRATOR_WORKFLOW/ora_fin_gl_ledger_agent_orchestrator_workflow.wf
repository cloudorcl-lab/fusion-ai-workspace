        {
          "metadata": {
            "name": "Compact History String",
            "returnType": "object",
            "sourceCode": "let agentJson = $context.$nodes.RETRIEVE_RESPONSE.$output.result;\n\n// This script works on a single AI response object only.\n// It does not parse chat history strings.\n//\n// Expected input shape:\n// {\n//   schema_version: 1,\n//   agent: \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n//   agent_response: [...],\n//   intent: \"balancesData\",\n//   timestamp: \"21-04-2026 20:05:26\"\n// }\n//\n// Main outputs:\n// 1. compactAiResponseObject(aiResponse) -> compacted AI JSON object\n// 2. buildAiHistoryLine(aiResponse) -> \"AI: {...}\"\n\n// Read the ordered column list from the table object.\n// The original column order matters because it defines the Markdown layout.\nconst getColumnDefinitions = (tableEntry) => {\n  const columns = tableEntry?.columns?.items;\n\n  if (!Array.isArray(columns) || !columns.length) {\n    return null;\n  }\n\n  return columns.map((column) => ({\n    header: column?.headerText || column?.field || '',\n    field: column?.field || column?.id || '',\n  }));\n};\n\n// Read the table rows.\n// An empty array is valid because some tables may only have headers.\nconst getRows = (tableEntry) => {\n  const rows = tableEntry?.rows?.items;\n  return Array.isArray(rows) ? rows : [];\n};\n\n// Normalize any cell into a printable string.\n// Keeping this isolated makes formatting changes easy to find later.\nconst normalizeCellValue = (value) => {\n  if (value === null || value === undefined) {\n    return '';\n  }\n\n  if (typeof value === 'string') {\n    return value.trim();\n  }\n\n  if (typeof value === 'number' || typeof value === 'boolean') {\n    return String(value);\n  }\n\n  try {\n    return JSON.stringify(value);\n  } catch (error) {\n    return '';\n  }\n};\n\n// Escape characters that would break a Markdown table cell.\nconst escapeMarkdownCell = (value) =>\n  normalizeCellValue(value)\n    .replace(/\\|/g, '\\\\|')\n    .replace(/\\r?\\n/g, ' ');\n\n// Build one Markdown row from a flat list of values.\nconst buildMarkdownRow = (values) =>\n  `| ${values.map((value) => escapeMarkdownCell(value)).join(' | ')} |`;\n\n// Build the required Markdown divider row under the header.\nconst buildMarkdownDivider = (columnCount) =>\n  `| ${Array(columnCount).fill('---').join(' | ')} |`;\n\n// Convert one table display object into a Markdown table string.\n// If the table structure is malformed, preserve the original entry instead.\nconst compactTableEntry = (entry) => {\n  const columns = getColumnDefinitions(entry);\n\n  if (!columns) {\n    return entry;\n  }\n\n  const rows = getRows(entry);\n  const headerRow = buildMarkdownRow(columns.map((column) => column.header));\n  const dividerRow = buildMarkdownDivider(columns.length);\n  const dataRows = rows.map((row) =>\n    buildMarkdownRow(columns.map((column) => row?.[column.field] ?? '')),\n  );\n\n  return {\n    display_type: 'table',\n    data: [headerRow, dividerRow, ...dataRows].join('\\n'),\n  };\n};\n\n// Keep text entries lean by preserving only the fields needed later.\nconst compactTextEntry = (entry) => ({\n  display_type: 'text',\n  text: entry?.text ?? '',\n});\n\n// Compact nested collapsible content recursively.\n// If the content is malformed, preserve the original collapsible entry.\nconst compactCollapsibleEntry = (entry) => {\n  const content = compactDisplayEntries(entry?.content);\n\n  if (!Array.isArray(content)) {\n    return entry;\n  }\n\n  return {\n    display_type: 'collapsible',\n    headerText: entry?.headerText ?? '',\n    content,\n    expanded: entry?.expanded ?? 'false',\n  };\n};\n\n// Compact one display entry into its minimal supported shape.\n// Unsupported or malformed entries are preserved as-is.\nconst compactDisplayEntry = (entry) => {\n  if (!entry || typeof entry !== 'object') {\n    return entry;\n  }\n\n  if (entry.display_type === 'text') {\n    return compactTextEntry(entry);\n  }\n\n  if (entry.display_type === 'table') {\n    return compactTableEntry(entry);\n  }\n\n  if (entry.display_type === 'collapsible') {\n    return compactCollapsibleEntry(entry);\n  }\n\n  return entry;\n};\n\n// Compact every display entry in a display array.\n// If the display array itself is malformed, preserve it as-is.\nconst compactDisplayEntries = (entries) => {\n  if (!Array.isArray(entries)) {\n    return entries;\n  }\n\n  return entries.map((entry) => compactDisplayEntry(entry));\n};\n\n// Keep only the allowed outer AI payload fields.\n// If the payload is malformed, preserve it as-is.\nconst compactAiResponseObject = (aiResponse) => {\n  if (!aiResponse || typeof aiResponse !== 'object' || Array.isArray(aiResponse)) {\n    return aiResponse;\n  }\n\n  const compactedResponse = {\n    agent: aiResponse?.agent,\n    agent_response: Array.isArray(aiResponse?.agent_response)\n      ? compactDisplayEntries(aiResponse.agent_response)\n      : aiResponse?.agent_response,\n    intent: aiResponse?.intent,\n    timestamp: aiResponse?.timestamp,\n  };\n\n  if (aiResponse?.user_chosen_ledgers) {\n    compactedResponse.user_chosen_ledgers = aiResponse.user_chosen_ledgers;\n  }\n\n  return compactedResponse;\n};\n\n// Convert any AI payload into a printable JSON string.\n// If stringification fails, fall back to an empty object string.\nconst stringifyAiResponse = (aiResponse) => {\n  try {\n    return JSON.stringify(aiResponse);\n  } catch (error) {\n    return '{}';\n  }\n};\n\nconst chatHistoryArr = $context.$variables.compactedChatHistory || [];\nchatHistoryArr.push({\n    role: 'USER',\n    text: `${$context.$system.$inputMessage }`\n});\nchatHistoryArr.push({\n    role: 'AI',\n    text: stringifyAiResponse(compactAiResponseObject(agentJson))\n});\n// Build the history line in the same format used in chat history.\n// This compacts first so the caller does not need two separate steps.\n// const buildAiHistoryLine = (aiResponse) =>\n//   `AI: ${stringifyAiResponse(compactAiResponseObject(aiResponse))}`;\n\n// const historyLine = buildAiHistoryLine(agentJson);\nreturn chatHistoryArr;"
