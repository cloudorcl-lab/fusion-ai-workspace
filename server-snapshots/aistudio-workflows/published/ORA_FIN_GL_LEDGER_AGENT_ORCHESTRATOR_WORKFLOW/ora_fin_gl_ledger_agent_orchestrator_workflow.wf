          "code": "SET_RESPONSE_PATH_FALLBACK",
          "id": "1777163011528",
          "inputs": [
            {
              "id": "1777163020393",
              "name": "responsePath",
              "scope": "JOB",
              "type": "string",
              "value": "fallback"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "Retrieve Response",
            "returnType": "object",
            "sourceCode": "let responseJson = {};\n\nswitch($context.$variables.responsePath){\n    case \"ads\":\n        responseJson = $context.$nodes.PREPARE_JSON_ADS.$output;\n        break;\n    case \"simple\":\n        responseJson = $context.$nodes.FIN_GL_CODE_LEDGER_ORCH_PREPARE_SIMPLE_RESPONSE.$output.result;\n        break;\n    case \"error\":\n        responseJson = $context.$nodes.PREPARE_ERROR_RESPONSE.$output.result;\n        break;\n    case \"fallback\":\n        responseJson = $context.$nodes.FORMAT_FALLBACK.$output.result;\n        break;\n    case \"workflow\":\n        responseJson = $context.$nodes.PREPARE_RETURN_OBJ.$output.result.chatJson;\n        break;\n    default:\n        // Code to run if no cases match\n}\n\nreturn responseJson;"
          },
          "outcomes": {
            "success": "1777418768096"
          },
          "code": "RETRIEVE_RESPONSE",
          "id": "1777163723854",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare State Code Node",
            "returnType": "object",
            "sourceCode": "const currentState = $context.$variables.state ||  {\n    \"lastUsedAgent\": [],\n    \"domains\": {\n        \"ora_fin_gl_journals_assistant\": {},\n        \"ora_fin_gl_balance_inquiry_and_analysis_assistant\": {},\n        \"ora_fin_gl_financial_reporting_assistant\": {},\n        \"ora_fin_gl_subledger_supporting_details_assistant\": {},\n        \"ora_fin_gl_general_ledger_functions_assistant\": {},\n        \"ora_fin_fun_insights_assistant\": {},\n        \"ora_fin_gl_process_exceptions_assistant\": {},\n        \"ora_fin_gl_export_to_excel_assistant\": {},\n        \"ora_fin_gl_hierarchy_manager_assistant\": {},\n        \"ora_fin_gl_help_topic_assistant\": {}\n    },\n    \"shared\": {}\n};\n\ncurrentState.lastUsedAgent.push($context.$variables.routingDecision);\n\nconst isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\n\nconst getHierarchyWorkflowOutput = () => {\n    const raw = $context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_HIERARCHY_MANAGER?.$output;\n    if (!raw) return {};\n    if (raw.output) {\n        try {\n            return JSON.parse(raw.output);\n        } catch (error) {\n            return {};\n        }\n    }\n    return raw.result || raw;\n};\n\nconst applyHierarchyStateToState = () => {\n    const flowOutput = getHierarchyWorkflowOutput();\n    const hierarchyState = flowOutput.hierarchyState;\n\n    if (!isRecordObject(hierarchyState)) {\n        return;\n    }\n\n    currentState.shared = isRecordObject(currentState.shared) ? currentState.shared : {};\n    currentState.shared.hierarchy = hierarchyState;\n};\n\nconst normalizeHierarchySelectionContext = (selectionContext) => {\n    if (!isRecordObject(selectionContext)) {\n        return null;\n    }\n\n    const rawOptions = Array.isArray(selectionContext.options) ? selectionContext.options : [];\n    const selectedHierarchy = isRecordObject(selectionContext.selectedHierarchy)\n        ? selectionContext.selectedHierarchy\n        : null;\n    const dimensionName = typeof selectionContext.dimensionName === \"string\" ? selectionContext.dimensionName.trim() : \"\";\n    const label = typeof selectionContext.label === \"string\" ? selectionContext.label.trim() : \"\";\n    const segmentKey =\n        (typeof selectionContext.segmentCode === \"string\" && selectionContext.segmentCode.trim()) ||\n        dimensionName ||\n        label;\n\n    if (!segmentKey) {\n        return null;\n    }\n\n    const normalizeOption = (option, index) => {\n        if (!isRecordObject(option)) {\n            return null;\n        }\n\n        const treeVersionName =\n            (typeof option.treeVersionName === \"string\" && option.treeVersionName.trim()) ||\n            (typeof option.treeVersion === \"string\" && option.treeVersion.trim()) ||\n            \"\";\n\n        if (!treeVersionName) {\n            return null;\n        }\n\n        return {\n            sr: option.sr || index + 1,\n            treeVersionName\n        };\n    };\n\n    const options = rawOptions\n        .map(normalizeOption)\n        .filter(Boolean);\n\n    const selectedTreeVersionName =\n        selectedHierarchy &&\n        (\n            (typeof selectedHierarchy.treeVersionName === \"string\" && selectedHierarchy.treeVersionName.trim()) ||\n            (typeof selectedHierarchy.treeVersion === \"string\" && selectedHierarchy.treeVersion.trim()) ||\n            \"\"\n        );\n\n    return {\n        segmentKey,\n        dimensionName: dimensionName || segmentKey,\n        label: label || segmentKey,\n        options,\n        selectedTreeVersionName\n    };\n};\n\nconst getHierarchySelectionContextFromSummary = () => {\n    const summaryOutput = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR?.$output?.result || {};\n    const agentOutput = Array.isArray(summaryOutput.agentOutput) ? summaryOutput.agentOutput : [];\n    const metadataObj = agentOutput.find((item) => item?.type === \"metadata\" && item?.intent === \"hierarchySelection\");\n    return metadataObj?.selectionContext;\n};\n\nconst applyHierarchySelectionContextToState = () => {\n    const normalized = normalizeHierarchySelectionContext(getHierarchySelectionContextFromSummary());\n    if (!normalized) {\n        return;\n    }\n\n    currentState.shared = isRecordObject(currentState.shared) ? currentState.shared : {};\n    const existingHierarchyState = isRecordObject(currentState.shared.hierarchy) ? currentState.shared.hierarchy : {};\n    const pendingOptionsBySegment = isRecordObject(existingHierarchyState.pendingOptionsBySegment)\n        ? { ...existingHierarchyState.pendingOptionsBySegment }\n        : {};\n    const pendingSelections = isRecordObject(existingHierarchyState.pendingSelections)\n        ? { ...existingHierarchyState.pendingSelections }\n        : {};\n\n    if (normalized.options.length > 0) {\n        pendingOptionsBySegment[normalized.segmentKey] = normalized.options;\n    }\n\n    if (normalized.selectedTreeVersionName) {\n        pendingSelections[normalized.segmentKey] = {\n            segmentCode: normalized.segmentKey,\n            dimensionName: normalized.dimensionName,\n            label: normalized.label,\n            treeVersionName: normalized.selectedTreeVersionName\n        };\n    }\n\n    currentState.shared.hierarchy = {\n        ...existingHierarchyState,\n        pendingOptionsBySegment,\n        pendingSelections\n    };\n};\n\nconst applyMergedMeasureLabelsToState = () => {\n    const measureLabels = $context.$nodes.MERGE_BALANCE_ROWS?.$output?.result?.mergedRowsData?.avExtractResult?.metadata?.measureLabels;\n\n    if (!isRecordObject(measureLabels) || Object.keys(measureLabels).length === 0) {\n        return;\n    }\n\n    const domainState = currentState.domains?.[$context.$variables.routingDecision];\n    const avExtractResult = domainState?.lastUsedData?.dataResponse?.avExtractResult;\n\n    if (!isRecordObject(avExtractResult)) {\n        return;\n    }\n\n    avExtractResult.metadata = {\n        ...(isRecordObject(avExtractResult.metadata) ? avExtractResult.metadata : {}),\n        measureLabels: {\n            ...(isRecordObject(avExtractResult.metadata?.measureLabels) ? avExtractResult.metadata.measureLabels : {}),\n            ...measureLabels\n        }\n    };\n};\n\nconst getExecutedBusinessWorkflowNodeName = () => {\n    const candidates = [\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_BALANCE_INQUIRY\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_JOURNALS_INQUIRY\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_RESULTS_EXPORT\"\n    ];\n\n    for (const candidate of candidates) {\n        if ($context.$nodes[candidate]?.$output) {\n            return candidate;\n        }\n    }\n\n    return \"\";\n};\n\nconst persistLastBusinessAgentTurn = () => {\n    const businessAgents = new Set([\n        \"ora_fin_gl_journals_assistant\",\n        \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n        \"ora_fin_gl_subledger_supporting_details_assistant\"\n    ]);\n\n    const agent = $context.$variables.routingDecision;\n    if (!businessAgents.has(agent) || !executedBusinessWorkflowNodeName) {\n        return;\n    }\n\n    const effectiveMessage =\n        typeof $context.$variables.effectiveMessage === \"string\"\n            ? $context.$variables.effectiveMessage.trim()\n            : \"\";\n\n    if (!effectiveMessage) {\n        return;\n    }\n\n    currentState.shared = isRecordObject(currentState.shared) ? currentState.shared : {};\n    currentState.shared.lastBusinessAgentTurn = {\n        agent,\n        effectiveMessage\n    };\n};\n\nconst hierarchyFlowOutput = getHierarchyWorkflowOutput();\nconst hasHierarchyWorkflowOutput = isRecordObject(hierarchyFlowOutput) && (\n    Array.isArray(hierarchyFlowOutput.agentOutput) ||\n    isRecordObject(hierarchyFlowOutput.hierarchyState)\n);\nconst executedBusinessWorkflowNodeName = getExecutedBusinessWorkflowNodeName();\nconst shouldSkipBusinessStateForHierarchyOnlyTurn = hasHierarchyWorkflowOutput && !executedBusinessWorkflowNodeName;\nconst presentationObj = $context.$nodes.PROCESS_PRESENTATION_LLM?.$output?.result?.orchestratorObj;\nconst isRemainingColumnsRequest = presentationObj?.listRemainingColumns === true;\nconst isDisplayWorkflowStateUpdate =\n    $context.$variables.domainSwitchPath === 'ora_fin_gl_ledger_agent_orchestrator' &&\n    !isRemainingColumnsRequest;\n\n// display request only path\nif(isDisplayWorkflowStateUpdate){\n    \n    const displayWorkflowOutput = $context.$nodes.PREPARE_RETURN_OBJ.$output.result; \n    currentState.domains[`${$context.$variables.routingDecision}_displayColumns`] = {\n        displayed: displayWorkflowOutput.displayedColumns,\n        available: displayWorkflowOutput.availableColumns,\n        tables: displayWorkflowOutput.displayTables\n    };\n\n}\n// regular path\nelse if (!shouldSkipBusinessStateForHierarchyOnlyTurn){\n    const nodeMap = {\n        \"ora_fin_gl_help_topic_assistant\": \"HELP_TOPIC_ASSISTANCE\",\n        \"ora_fin_gl_journals_assistant\": \"FIN_GL_WORKFLOW_LEDGER_ORCH_JOURNALS_INQUIRY\",\n        \"ora_fin_gl_balance_inquiry_and_analysis_assistant\": \"FIN_GL_WORKFLOW_LEDGER_ORCH_BALANCE_INQUIRY\",\n        \"ora_fin_gl_financial_reporting_assistant\":\"FINANCIAL_REPORTING_ASSISTANCE\",\n        \"ora_fin_gl_general_ledger_functions_assistant\":\"GENERAL_LEDGER_FUNCTIONS_ASSISTANCE\",\n        \"ora_fin_gl_process_exceptions_assistant\": \"PROCESS_EXCEPTIONS_ASSISTANCE\",\n        \"ora_fin_gl_export_to_excel_assistant\": \"FIN_GL_WORKFLOW_LEDGER_ORCH_RESULTS_EXPORT\"\n    };\n\n    let nodeName;\n    if($context.$variables.routingDecision === 'ora_fin_gl_subledger_supporting_details_assistant'){\n        if (executedBusinessWorkflowNodeName === \"FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER\" ||\n            executedBusinessWorkflowNodeName === \"FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER\") {\n            nodeName = executedBusinessWorkflowNodeName;\n        } else {\n            const selectedIndex = $context.$nodes.PROCESS_SELECT_SUBLEDGER?.$output?.result?.selectedIndex;\n            if (selectedIndex === 0) {\n                nodeName = \"FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER\";\n            } else if (selectedIndex === 1) {\n                nodeName = \"FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER\";\n            } else {\n                nodeName = \"\";\n            }\n        }\n    }else{\n        nodeName  = nodeMap[$context.$variables.routingDecision];\n    }\n\n    let agentOutput = nodeName ? $context?.$nodes[nodeName]?.$output : undefined;\n\n    const workflowOutputNodeNames = new Set([\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_JOURNALS_INQUIRY\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_BALANCE_INQUIRY\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER\",\n        \"FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER\"\n    ]);\n\n    if(agentOutput && workflowOutputNodeNames.has(nodeName)){\n        agentOutput = JSON.parse(agentOutput.output);\n    }\n    \n    if($context.$variables.routingDecision === 'ora_fin_gl_process_exceptions_assistant' && $context.$nodes.PROCESS_PROCESSEXCEPTIONS_RESPONSE?.$output?.result?.state){\n        agentOutput = {\n            status: 'success',\n            state: $context.$nodes.PROCESS_PROCESSEXCEPTIONS_RESPONSE.$output.result.state\n        }\n    }\n\n    if(agentOutput && agentOutput?.status === 'success'){\n        const newDomainState = agentOutput?.state?.private || {};\n        const newSharedState = agentOutput?.state?.shared || {};\n        Object.keys(newSharedState).forEach(k => {\n            currentState.shared[k] = newSharedState[k];\n        });\n        currentState.domains[$context.$variables.routingDecision] = newDomainState;\n        if( agentOutput?.successMessage === 'data'){\n            const displayWorkflowOutput = $context.$nodes.PREPARE_RETURN_OBJ.$output.result; \n            currentState.domains[`${$context.$variables.routingDecision}_displayColumns`] = {\n                displayed: displayWorkflowOutput.displayedColumns,\n                available: displayWorkflowOutput.availableColumns,\n                tables: displayWorkflowOutput.displayTables\n            };\n        }\n    }\n}\n\n\napplyMergedMeasureLabelsToState();\napplyHierarchySelectionContextToState();\napplyHierarchyStateToState();\npersistLastBusinessAgentTurn();\n\nreturn currentState;"
