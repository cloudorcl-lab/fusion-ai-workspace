{
  "workflowId": "300000331067529",
  "workflowCode": "ORA_FIN_GL_LEDGER_AGENT_ORCHESTRATOR_WORKFLOW",
  "name": "Ledger Agent",
  "description": "The Ledger Agent transforms day-to-day accounting operations by proactively monitoring general ledger balances, journals, and transactions to detect and surface exceptions before they impact the business. Using agentic AI, it provides AI-driven insights and explanations across ledger and correlated subledger data, including supporting detail for accountant review when human intervention is needed. Accountants can ask natural language questions about balances, variances, journal activity, suspense account activity, and process exceptions and receive timely, context-aware responses. This agentic automation improves efficiency, modernizes daily workflows, and helps surface business insights within General Ledger processes.",
  "specification": {
    "dataPipeline": {
      "pipelineNodes": [
