          },
          "code": "IF_DETERMINISTIC_ROUTING",
          "convergenceTargetId": "1775738321232",
          "id": "1770417550481",
          "inputs": [
            {
              "id": "1770417550482_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.TRY_DETERMINISTIC_ROUTING.$output.result}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Deterministic Routing Decision",
            "returnType": "string",
            "sourceCode": "const ROUTES = {\n    balances: \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n    journals: \"ora_fin_gl_journals_assistant\",\n    subledgers: \"ora_fin_gl_subledger_supporting_details_assistant\",\n    reports: \"ora_fin_gl_financial_reporting_assistant\",\n    exceptions: \"ora_fin_gl_process_exceptions_assistant\",\n    unknown: \"unknown\"\n};\n\nconst BALANCE_MODULES = [\"oraErpCoreAccountBalancesRuntime\"];\nconst SHARED_JOURNAL_SUBLEDGER_AV_MODULES = [\"oraErpCoreAccountedTransactionsRuntime\"];\nconst JOURNAL_SUMMARY_ANALYTIC_VIEW = \"ora_erp_core_accountedTransactions_runtime_x__JournalSummary\";\nconst JOURNAL_BV_MODULES = [\"oraErpCoreAccountingEntries\"];\nconst SUBLEDGER_BV_MODULES = [\n    \"oraErpCorePayablesInvoices\",\n    \"oraErpCorePayablesPayments\",\n    \"oraErpCoreReceivablesPayments\"\n];\nconst PROCESS_EXCEPTION_BV_MODULE = \"oraErpCoreAccountingSetup\";\nconst PROCESS_EXCEPTION_BV_VIEW = \"accountingAutomationErrorList\";\n\nconst parseObject = (value) => {\n    if (value !== null && typeof value === \"object\" && !Array.isArray(value)) {\n        return value;\n    }\n\n    if (typeof value === \"string\") {\n        try {\n            const parsedValue = JSON.parse(value);\n            return parsedValue !== null && typeof parsedValue === \"object\" && !Array.isArray(parsedValue) ? parsedValue : {};\n        } catch (error) {}\n    }\n\n    return {};\n};\n\nconst getQueryObjects = (bossExtract) => {\n    const queries = parseObject(bossExtract).queries;\n\n    if (Array.isArray(queries)) {\n        return queries.filter((query) => query !== null && typeof query === \"object\" && !Array.isArray(query));\n    }\n\n    const queryObject = parseObject(queries);\n    return Object.keys(queryObject).length > 0 ? [queryObject] : [];\n};\n\nconst collectViewDetails = (queryObjects, key) => {\n    const views = [];\n\n    for (const queryObject of queryObjects) {\n        const viewObject = parseObject(queryObject[key]);\n\n        for (const viewDetails of Object.values(viewObject)) {\n            if (viewDetails !== null && typeof viewDetails === \"object\" && !Array.isArray(viewDetails)) {\n                views.push(viewDetails);\n            }\n        }\n    }\n\n    return views;\n};\n\nconst collectModules = (views) => views\n    .map((viewDetails) => viewDetails.module)\n    .filter((moduleName) => typeof moduleName === \"string\");\n\nconst hasAnyModule = (modules, expectedModules) => modules.some((moduleName) => expectedModules.includes(moduleName));\n\nconst isSharedAccountedTransactionsAnalyticView = (viewDetails) =>\n    SHARED_JOURNAL_SUBLEDGER_AV_MODULES.includes(viewDetails.module);\n\nconst isProcessExceptionBusinessView = (viewDetails) =>\n    viewDetails.module === PROCESS_EXCEPTION_BV_MODULE && viewDetails.view === PROCESS_EXCEPTION_BV_VIEW;\n\nconst routeFromInquiryTarget = (inquiryTargetObjectType) => ROUTES[inquiryTargetObjectType] || ROUTES.unknown;\n\nconst classifyBossExtract = (bossExtract) => {\n    const queryObjects = getQueryObjects(bossExtract);\n    const analyticViews = collectViewDetails(queryObjects, \"analyticViews\");\n    const businessViews = collectViewDetails(queryObjects, \"viewQueries\");\n    const analyticViewModules = collectModules(analyticViews);\n    const businessViewModules = collectModules(businessViews);\n\n    if (hasAnyModule(analyticViewModules, BALANCE_MODULES)) {\n        return ROUTES.balances;\n    }\n\n    const sharedAccountedTransactionsAnalyticViews = analyticViews.filter(isSharedAccountedTransactionsAnalyticView);\n    if (sharedAccountedTransactionsAnalyticViews.length > 0) {\n        return sharedAccountedTransactionsAnalyticViews.some((viewDetails) => viewDetails.name === JOURNAL_SUMMARY_ANALYTIC_VIEW)\n            ? ROUTES.journals\n            : ROUTES.subledgers;\n    }\n\n    if (hasAnyModule(businessViewModules, JOURNAL_BV_MODULES)) {\n        return ROUTES.journals;\n    }\n\n    if (hasAnyModule(businessViewModules, SUBLEDGER_BV_MODULES)) {\n        return ROUTES.subledgers;\n    }\n\n    if (businessViews.some(isProcessExceptionBusinessView)) {\n        return ROUTES.exceptions;\n    }\n\n    if (businessViewModules.length > 0) {\n        return ROUTES.exceptions;\n    }\n\n    return ROUTES.unknown;\n};\n\nconst additionalContext = parseObject($context.$variables.additionalContext);\nconst inquiryTargetObjectType = additionalContext.inquiryTargetObjectType;\nconst hasBossExtract = additionalContext.bossExtract !== null && additionalContext.bossExtract !== undefined;\nlet route = ROUTES.unknown;\n\nif (hasBossExtract) {\n    route = classifyBossExtract(additionalContext.bossExtract);\n} else {\n    route = routeFromInquiryTarget(inquiryTargetObjectType);\n}\n\nreturn route;"
          },
          "outcomes": {
            "success": "1770417697508"
          },
          "code": "DETERMINISTIC_ROUTING_DECISION",
