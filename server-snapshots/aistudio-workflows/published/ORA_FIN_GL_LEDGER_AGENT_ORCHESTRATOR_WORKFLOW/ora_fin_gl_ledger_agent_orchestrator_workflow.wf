        {
          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Summarization Pre Processor",
            "returnType": "object",
            "sourceCode": "let agentOutput;\nlet agentName;\nlet category;\nlet response;\nlet responseReady = false;\n\nconst balances_no_data_response = \"Your request did not return any balances for the specified criteria.\";\nconst journals_no_data_response = \"Your request did not return any journal details for the specified criteria.\";\nconst subledger_no_data_response = \"Your request did not return any subledger transactions for the specified criteria.\";\nlet no_data_response = \"Your request did not return any results for the specified criteria\";\n\nconst asyncMessage = \"Your request is being processed. No action is required. Results will appear in Recent Activity when complete.\";\nconst defaultErrorMessage = \"We couldn't complete your request right now. Please try again later\";\n\nconst getPreviousDisplayState = (agent) => {\n    const displayColumnState = $context.$variables.state?.domains?.[`${agent}_displayColumns`];\n\n    if (Array.isArray(displayColumnState?.tables) && displayColumnState.tables.length > 0) {\n        return {\n            tables: displayColumnState.tables.map((table) => ({\n                rowLevel: table?.rowLevel,\n                displayed: table?.displayed,\n                available: table?.available,\n                rowsToExclude: table?.rowsToExclude\n            }))\n        };\n    }\n\n    if (Array.isArray(displayColumnState?.available)) {\n        return {\n            displayed: displayColumnState?.displayed,\n            available: displayColumnState.available\n        };\n    }\n\n    return displayColumnState?.displayed;\n};\n\nconst constructHierarchyMessage = (details) => {\n    const filterResponse = details;\n\n    const esc = (value) =>\n        String(value ?? \"\")\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#39;\");\n\n    const isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\n\n    const trimValue = (value) => String(value ?? \"\").trim();\n\n    const toArrayString = (value) => {\n        if (Array.isArray(value)) {\n            return JSON.stringify(value);\n        }\n\n        if (isRecordObject(value)) {\n            const looksLikeSingleEntry =\n                value.segmentName ||\n                value.segment ||\n                Object.prototype.hasOwnProperty.call(value, \"value\") ||\n                Object.prototype.hasOwnProperty.call(value, \"values\");\n\n            if (looksLikeSingleEntry) {\n                return JSON.stringify([value]);\n            }\n\n            return JSON.stringify(\n                Object.keys(value).map((key) => {\n                    const entry = value[key];\n\n                    return isRecordObject(entry)\n                        ? { dimensionName: entry.dimensionName || key, hierarchyName: entry.hierarchyName || key, ...entry }\n                        : entry;\n                })\n            );\n        }\n\n        return \"[]\";\n    };\n\n    const parseDetail = (value) => {\n        try {\n            return typeof value === \"string\" ? JSON.parse(value) : value;\n        } catch (error) {\n            return null;\n        }\n    };\n\n    const toDetailArray = (value) => {\n        try {\n            const parsedValue = JSON.parse(toArrayString(value));\n\n            return Array.isArray(parsedValue) ? parsedValue : [];\n        } catch (error) {\n            return [];\n        }\n    };\n\n    const getUnresolvedValues = (entry) => {\n        if (Array.isArray(entry.values)) {\n            return entry.values.map(trimValue).filter((value) => value !== \"\");\n        }\n\n        const value = trimValue(entry.value);\n        if (value) {\n            return [value];\n        }\n\n        return [];\n    };\n\n    const getRawTreeVersions = (entry) => {\n        if (Array.isArray(entry.treeVersionNames)) {\n            return entry.treeVersionNames;\n        }\n\n        if (Array.isArray(entry.otherAvailableHierarchyVersions)) {\n            return entry.otherAvailableHierarchyVersions;\n        }\n\n        if (Array.isArray(entry.availableHierarchyVersions)) {\n            return entry.availableHierarchyVersions;\n        }\n\n        return [];\n    };\n\n    const getCandidateTreeVersions = (entry) => {\n        const seen = new Object();\n\n        return getRawTreeVersions(entry)\n            .filter(\n                (version) =>\n                    version &&\n                    version.treeVersionName &&\n                    !seen[version.treeVersionName] &&\n                    (seen[version.treeVersionName] = true)\n            )\n            .map((version) => ({\n                treeVersionName: trimValue(version.treeVersionName),\n                treeName: trimValue(version.treeName),\n                versionName: trimValue(version.versionName),\n                status: trimValue(version.status),\n                effectiveStartDate: trimValue(version.effectiveStartDate),\n                effectiveEndDate: trimValue(version.effectiveEndDate)\n            }));\n    };\n\n    const normalizeSegment = (entry) => ({\n        dimensionName: trimValue(entry.dimensionName || entry.hierarchyName),\n        segmentLabel: trimValue(entry.segmentName || entry.segment),\n        verifiedTreeVersionName: trimValue(\n            entry.verifiedTreeVersionName ||\n            entry.selectedHierarchyVersion ||\n            entry.selectedHierarchyVersionName ||\n            \"\"\n        ),\n        unresolvedValues: getUnresolvedValues(entry),\n        candidateTreeVersions: getCandidateTreeVersions(entry)\n    });\n\n    const hasDisplayableSegmentData = (entry) =>\n        entry.segmentLabel ||\n        entry.unresolvedValues.length > 0 ||\n        entry.candidateTreeVersions.length > 0;\n\n    const getNormalizedSegments = (detailArray) =>\n        detailArray\n            .filter(isRecordObject)\n            .map(normalizeSegment)\n            .filter(hasDisplayableSegmentData);\n\n    const buildMetadata = (intent, toolTimeStamp, selectionContext) => ({\n        type: \"metadata\",\n        intent,\n        ...(toolTimeStamp ? { toolTimeStamp } : new Object()),\n        ...(selectionContext && Object.keys(selectionContext).length > 0 ? { selectionContext } : new Object())\n    });\n\n    const buildTextResponse = (intent, data, toolTimeStamp, selectionContext) => [\n        buildMetadata(intent, toolTimeStamp, selectionContext),\n        {\n            display_type: \"text\",\n            data\n        }\n    ];\n\n    const buildDisplayResponse = (intent, display, toolTimeStamp, selectionContext) => [\n        buildMetadata(intent, toolTimeStamp, selectionContext),\n        ...display\n    ];\n\n    const htmlParagraph = (text) => `<p>${esc(text)}</p>`;\n\n    const htmlParagraphs = (lines) => lines.map(htmlParagraph).join(\"\");\n\n    const formatValues = (values) => {\n        if (values.length === 0) {\n            return \"\";\n        }\n\n        if (values.length === 1) {\n            return values[0];\n        }\n\n        if (values.length === 2) {\n            return `${values[0]} and ${values[1]}`;\n        }\n\n        return `${values.slice(0, -1).join(\", \")}, and ${values[values.length - 1]}`;\n    };\n\n    const notFoundVerb = (hasSingleValue) => hasSingleValue ? \"was\" : \"were\";\n\n    const parentValueMessage = (hasSingleValue) =>\n        hasSingleValue ? \"is a parent value\" : \"are parent values\";\n\n    const treeNameFromTreeVersionName = (treeVersionName) => {\n        const lastDash = treeVersionName.lastIndexOf(\"-\");\n\n        return lastDash > 0 ? treeVersionName.slice(0, lastDash) : treeVersionName;\n    };\n\n    const versionFromTreeVersionName = (treeVersionName) => {\n        const lastDash = treeVersionName.lastIndexOf(\"-\");\n\n        return lastDash >= 0 && lastDash < treeVersionName.length - 1\n            ? treeVersionName.slice(lastDash + 1)\n            : \"\";\n    };\n\n    const formatAgentSelectionDate = (rawDate) => {\n        let normalizedDate = trimValue(rawDate);\n\n        if (!normalizedDate) {\n            return \"\";\n        }\n\n        if (normalizedDate.startsWith(\"{date:\") && normalizedDate.endsWith(\"}\")) {\n            return normalizedDate;\n        }\n\n        if (normalizedDate.length >= 10) {\n            normalizedDate = normalizedDate.slice(0, 10);\n        }\n\n        return `{date:${normalizedDate}}`;\n    };\n\n    const formatEffectiveDates = (treeVersion) =>\n        `${formatAgentSelectionDate(treeVersion.effectiveStartDate)} - ${formatAgentSelectionDate(treeVersion.effectiveEndDate)}`;\n\n    const formatActiveStatus = (status) => {\n        const normalizedStatus = trimValue(status);\n\n        if (!normalizedStatus) {\n            return \"\";\n        }\n\n        return normalizedStatus.toUpperCase() === \"ACTIVE\" ? \"Yes\" : \"No\";\n    };\n\n    const sortTreeVersionsByTreeVersionName = (treeVersions) =>\n        [...(Array.isArray(treeVersions) ? treeVersions : [])].sort((left, right) => {\n            const leftName = trimValue(left.treeVersionName).toLowerCase();\n            const rightName = trimValue(right.treeVersionName).toLowerCase();\n\n            if (leftName < rightName) {\n                return -1;\n            }\n\n            if (leftName > rightName) {\n                return 1;\n            }\n\n            return 0;\n        });\n\n    const buildTreeVersionOptionRows = (treeVersions) =>\n        sortTreeVersionsByTreeVersionName(treeVersions)\n            .filter((treeVersion) => trimValue(treeVersion.treeVersionName) !== \"\")\n            .map((treeVersion, index) => ({\n                sr: index + 1,\n                treeVersionName: trimValue(treeVersion.treeVersionName),\n                treeName: trimValue(treeVersion.treeName),\n                versionName: trimValue(treeVersion.versionName),\n                status: trimValue(treeVersion.status),\n                effectiveStartDate: trimValue(treeVersion.effectiveStartDate),\n                effectiveEndDate: trimValue(treeVersion.effectiveEndDate)\n            }));\n\n    const buildHierarchySelectionContext = (segment) => ({\n        dimensionName: segment.dimensionName || null,\n        label: segment.segmentLabel || null,\n        verifiedTreeVersionName: segment.verifiedTreeVersionName || null,\n        options: buildTreeVersionOptionRows(segment.candidateTreeVersions)\n    });\n\n    const buildHierarchyTable = (treeVersions) => {\n        const headers = [\"Option\", \"Tree\", \"Version\", \"Effective Dates\", \"Active\"]\n            .map((header) => `<th>${esc(header)}</th>`)\n            .join(\"\");\n        const body = treeVersions\n            .map((treeVersion, index) => {\n                const treeVersionName = trimValue(treeVersion.treeVersionName);\n                const row = [\n                    String(index + 1),\n                    treeVersion.treeName || treeNameFromTreeVersionName(treeVersionName),\n                    treeVersion.versionName || versionFromTreeVersionName(treeVersionName),\n                    formatEffectiveDates(treeVersion),\n                    formatActiveStatus(treeVersion.status)\n                ];\n\n                return `<tr>${row.map((cell) => `<td>${esc(cell)}</td>`).join(\"\")}</tr>`;\n            })\n            .join(\"\");\n\n        return `<table><thead><tr>${headers}</tr></thead><tbody>${body}</tbody></table>`;\n    };\n\n    const buildHierarchyNotFoundDisplay = (segment) => {\n        const sortedTreeVersions = sortTreeVersionsByTreeVersionName(segment.candidateTreeVersions);\n        const label = segment.segmentLabel;\n        const verifiedTreeVersionName = segment.verifiedTreeVersionName;\n        const hasSingleValue = segment.unresolvedValues.length === 1;\n        const hasVerifiedTree = verifiedTreeVersionName !== \"\";\n        const hasAlternatives = sortedTreeVersions.length > 0;\n        const formattedValues = formatValues(segment.unresolvedValues);\n        const display = [];\n        let introLines;\n        let prompt = null;\n\n        if (hasVerifiedTree && hasAlternatives) {\n            introLines = [\n                `${formattedValues} ${notFoundVerb(hasSingleValue)} not found in ${verifiedTreeVersionName}.`,\n                `Other available hierarchies for ${label}:`\n            ];\n            prompt = \"Provide option for hierarchy.\";\n        } else if (hasVerifiedTree) {\n            introLines = [\n                `${formattedValues} ${notFoundVerb(hasSingleValue)} not found in ${verifiedTreeVersionName}, and no other hierarchies are available for ${label}.`,\n                `Review the hierarchy configuration for ${label}.`\n            ];\n        } else if (hasAlternatives) {\n            introLines = [\n                `${formattedValues} ${parentValueMessage(hasSingleValue)}, and no default hierarchy is configured for ${label}.`,\n                `Select a hierarchy to use for ${label}:`\n            ];\n            prompt = \"Provide option for hierarchy.\";\n        } else {\n            introLines = [\n                `${formattedValues} ${parentValueMessage(hasSingleValue)}, and no hierarchies are configured for ${label}.`,\n                \"Configure a hierarchy for this segment.\"\n            ];\n        }\n\n        display.push({\n            display_type: \"text\",\n            data: htmlParagraphs(introLines)\n        });\n\n        if (hasAlternatives) {\n            display.push({\n                display_type: \"table\",\n                data: buildHierarchyTable(sortedTreeVersions)\n            });\n        }\n\n        if (prompt) {\n            display.push({\n                display_type: \"text\",\n                data: htmlParagraph(prompt)\n            });\n        }\n\n        return display;\n    };\n\n    const hierarchyErrorCodes = [\"HIERARCHY_NOT_FOUND\", \"VALUE_NOT_IN_HIERARCHY\"];\n    const isHierarchyErrorCode = (value) => hierarchyErrorCodes.includes(String(value ?? \"\"));\n\n    const getHierarchyNotFoundMessage = (normalizedSegments) => {\n        if (typeof filterResponse.userMessage === \"string\" && filterResponse.userMessage.trim()) {\n            return filterResponse.userMessage.trim();\n        }\n\n        if (\n            typeof filterResponse.message === \"string\" &&\n            filterResponse.message.trim() &&\n            !isHierarchyErrorCode(filterResponse.message)\n        ) {\n            return filterResponse.message.trim();\n        }\n\n        if (normalizedSegments.length === 1 && normalizedSegments[0].segmentLabel) {\n            return `No active hierarchy was found for ${normalizedSegments[0].segmentLabel} segment.`;\n        }\n\n        if (normalizedSegments.length > 1) {\n            return `No active hierarchies were found for ${normalizedSegments\n                .map((segment) => segment.segmentLabel)\n                .filter(Boolean)\n                .join(\", \")} segments.`;\n        }\n\n        return defaultErrorMessage;\n    };\n\n    const parsedDetail = parseDetail(filterResponse?.detail);\n    const detailArray = toDetailArray(parsedDetail);\n    const normalizedSegments = getNormalizedSegments(detailArray);\n    const title = String(filterResponse?.title || filterResponse?.message || \"\");\n    const toolTimeStamp = filterResponse?.timestamp ? String(filterResponse.timestamp) : \"\";\n\n    let hierarchyMsg;\n\n    if (isHierarchyErrorCode(title) && normalizedSegments.length > 0) {\n        hierarchyMsg = buildDisplayResponse(\n            \"hierarchySelection\",\n            buildHierarchyNotFoundDisplay(normalizedSegments[0]),\n            toolTimeStamp,\n            buildHierarchySelectionContext(normalizedSegments[0])\n        );\n    } else if (isHierarchyErrorCode(title)) {\n        hierarchyMsg = buildTextResponse(\n            \"error\",\n            `<p>${esc(getHierarchyNotFoundMessage(normalizedSegments))}</p>`,\n            toolTimeStamp\n        );\n    } else {\n        hierarchyMsg = buildTextResponse(\n            \"error\",\n            \"<p>\"+ defaultErrorMessage + \"</p>\",\n            toolTimeStamp\n        );\n    }\n\n    return hierarchyMsg;\n\n};\n\nconst getHierarchyWorkflowOutput = () => {\n    const raw = $context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_HIERARCHY_MANAGER?.$output;\n    if (!raw) return new Object();\n    if (raw.output) {\n        try {\n            return JSON.parse(raw.output);\n        } catch (error) {\n            return new Object();\n        }\n    }\n    return raw.result || raw;\n};\n\nconst escapeHtml = (value) => String(value ?? \"\")\n    .replaceAll(\"&\", \"&amp;\")\n    .replaceAll(\"<\", \"&lt;\")\n    .replaceAll(\">\", \"&gt;\")\n    .replaceAll('\"', \"&quot;\")\n    .replaceAll(\"'\", \"&#39;\");\n\nconst getIntentDetailLabel = (key, segments = new Object()) => {\n    const trimmedKey = String(key ?? \"\").trim();\n    let label = segments?.[trimmedKey]?.label;\n    if (!label && trimmedKey === 'ledger') {\n        return \"Ledger\";\n    }\n    else if (!label && trimmedKey === 'accountingPeriod') {\n        return \"Accounting Period\";\n    }\n    else if (!label && trimmedKey === 'currency') {\n        return \"Currency\";\n    }\n    return typeof label === \"string\" && label.trim() ? label : trimmedKey;\n};\n\nconst isDataSourceKey = (key) => {\n    return key === `Da${'ta'} Source` || key === \"Source\";\n};\n\nconst formatIntentDetails = (intentDetails, segments = new Object()) => {\n    if (typeof intentDetails === \"string\") {\n        return intentDetails;\n    }\n\n    const itemsArr = [];\n    let dataSourceItem = \"\";\n\n    if (intentDetails && typeof intentDetails === \"object\" && !Array.isArray(intentDetails)) {\n        for (const [key, value] of Object.entries(intentDetails)) {\n            const label = getIntentDetailLabel(key, segments);\n            const displayValue = value && typeof value === \"object\" ? JSON.stringify(value) : value;\n\n            if (isDataSourceKey(key)) {\n                dataSourceItem = `<li>Da${'ta'} Source: ${escapeHtml(displayValue)}</li>`;\n                continue;\n            }\n\n            itemsArr.push(`<li>${escapeHtml(label)}: ${escapeHtml(displayValue)}</li>`);\n        }\n    }\n\n    if (dataSourceItem) {\n        itemsArr.unshift(dataSourceItem);\n    }\n\n    return itemsArr.length > 0 ? `<ul>${itemsArr.join(\"\")}</ul>` : \"\";\n};\n\nconst insertHierarchyResolverMessageAfterContext = (displayObjects, queryResponse) => {\n    const message = String(queryResponse?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\n    if (!message) {\n        return;\n    }\n\n    const messageObject = {\n        display_type: \"text\",\n        data: `<p>${escapeHtml(message)}</p>`\n    };\n    const contextIndex = displayObjects.findIndex((item) => item?.display_type === \"collapsible\" && item?.headerText === \"Context\");\n    if (contextIndex >= 0) {\n        const contextObject = displayObjects[contextIndex];\n        contextObject.content = Array.isArray(contextObject.content) ? contextObject.content : [];\n        contextObject.content.push(messageObject);\n        return;\n    }\n    displayObjects.unshift(messageObject);\n};\n\nconst getHierarchyResolverMessage = (queryResponse) =>\n    String(queryResponse?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\n\nconst getFooterMessages = (messages) =>\n    (Array.isArray(messages) ? messages : [])\n        .filter((message) =>\n            message &&\n            typeof message === \"object\" &&\n            String(message.placement ?? \"\").toLowerCase() === \"footer\" &&\n            typeof message.text === \"string\" &&\n            message.text.trim() !== \"\"\n        );\n\nconst appendFooterMessages = (displayObjects, messages) => {\n    for (const message of getFooterMessages(messages)) {\n        displayObjects.push({\n            display_type: \"text\",\n            data: `<p>${escapeHtml(message.text)}</p>`\n        });\n    }\n};\n\nconst getHierarchyErrorDisplay = (details) => {\n    const candidates = [\n        details?.display,\n        details?.data?.display,\n        details?.response?.display,\n        details?.detail?.display,\n        details?.data?.response?.display,\n        details?.response?.data?.display\n    ];\n\n    return candidates.find(Array.isArray) || [];\n};\n\nconst getHierarchyErrorSelectionContext = (details) => {\n    const candidates = [\n        details?.selectionContext,\n        details?.data?.selectionContext,\n        details?.response?.selectionContext,\n        details?.detail?.selectionContext,\n        details?.data?.response?.selectionContext,\n        details?.response?.data?.selectionContext\n    ];\n\n    return candidates.find((candidate) => candidate && typeof candidate === \"object\" && !Array.isArray(candidate)) || new Object();\n};\n\nconst setErrorResponse = (errorMessage) => {\n    const errorResponse = {\n        path: \"error\",\n        agentName,\n        category\n    };\n\n    if (typeof errorMessage === \"string\" && errorMessage.trim() !== \"\") {\n        errorResponse.errorMessage = errorMessage;\n    }\n\n    response = errorResponse;\n    responseReady = true;\n};\n\nconst presentationObj = $context.$nodes.PROCESS_PRESENTATION_LLM?.$output?.result?.orchestratorObj;\n\nif (presentationObj?.listRemainingColumns === true) {\n    agentOutput = Array.isArray(presentationObj.agentResponse) ? presentationObj.agentResponse : [];\n    agentName = $context.$variables.routingDecision;\n    category = \"Response\";\n}\nelse if ($context.$nodes?.PRESENTATION_INTENT_CLASSIFIER?.$output && $context.$nodes?.PRESENTATION_INTENT_CLASSIFIER?.$output?.shouldUsePresentationWorkflow) {\n    const workflowResponse = new Object();\n    workflowResponse.path = 'workflow';\n    workflowResponse.agentName = $context.$variables.routingDecision;\n    workflowResponse.state = {\n        private: $context.$variables.state?.domains?.[$context.$variables.routingDecision]\n    };\n    workflowResponse.previouslyShownColumns = getPreviousDisplayState($context.$variables.routingDecision);\n    response = workflowResponse;\n    responseReady = true;\n}\nelse if ($context.$variables.routingDecision === 'ora_fin_gl_process_exceptions_assistant' && $context.$variables.additionalContext.bossExtract) {\n    agentName = $context.$variables.routingDecision;\n    category = \"exceptions\"\n    const processExceptionsInsightsResponse = $context.$nodes.PROCESS_PROCESSEXCEPTIONS_RESPONSE.$output.result;\n    if (processExceptionsInsightsResponse.path === 'workflow') {\n        const workflowResponse = new Object();\n        workflowResponse.path = 'workflow';\n        workflowResponse.agentName = agentName;\n        workflowResponse.state = {\n            private: $context.$variables.state?.domains?.[agentName]\n        };\n        workflowResponse.previouslyShownColumns = getPreviousDisplayState(agentName);\n        response = workflowResponse;\n        responseReady = true;\n    }\n    else {\n        setErrorResponse(processExceptionsInsightsResponse?.errorMessage);\n    }\n\n}\nelse if ($context.$nodes.PROCESS_SELECT_SUBLEDGER?.$output?.result?.selectedIndex === -1) {\n    agentOutput = {\n        status: \"followup\",\n        followupMessage: $context.$nodes.PROCESS_SELECT_SUBLEDGER.$output.result.followupMessage || \"Please state which subledger to use: payables or receivables.\"\n    };\n    agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n    category = \"subledger\";\n}\nelse if ($context.$nodes.HELP_TOPIC_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.HELP_TOPIC_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_help_topic_assistant\";\n    category = \"help\";\n}\nelse if ($context.$nodes.GENERAL_LEDGER_FUNCTIONS_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.GENERAL_LEDGER_FUNCTIONS_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_general_ledger_functions_assistant\";\n    category = \"glf\";\n}\nelse if ($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_JOURNALS_INQUIRY.$output) {\n    agentOutput = JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_JOURNALS_INQUIRY.$output.output);\n    agentName = \"ora_fin_gl_journals_assistant\";\n    category = \"journal\";\n    no_data_response = journals_no_data_response;\n}\nelse if ($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_BALANCE_INQUIRY.$output) {\n    agentOutput = JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_BALANCE_INQUIRY.$output.output);\n    agentName = \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\n    category = \"balances\";\n    no_data_response = balances_no_data_response;\n}\nelse if ($context.$nodes.FINANCIAL_REPORTING_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.FINANCIAL_REPORTING_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_financial_reporting_assistant\";\n    category = \"report\";\n}\nelse if ($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER?.$output?.output) {\n    agentOutput = JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_PAYABLES_SUBLEDGER?.$output?.output);\n    agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n    category = \"subledger\";\n    no_data_response = subledger_no_data_response;\n}\nelse if ($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER?.$output?.output) {\n    agentOutput = JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_RECEIVABLES_SUBLEDGER?.$output?.output);\n    agentName = \"ora_fin_gl_subledger_supporting_details_assistant\";\n    category = \"subledger\";\n    no_data_response = subledger_no_data_response;\n}\nelse if ($context.$nodes.PROCESS_EXCEPTIONS_ASSISTANCE.$output) {\n    agentOutput = $context.$nodes.PROCESS_EXCEPTIONS_ASSISTANCE.$output;\n    agentName = \"ora_fin_gl_process_exceptions_assistant\";\n    category = \"exceptions\";\n}\nelse if ($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_RESULTS_EXPORT.$output) {\n    agentOutput = JSON.parse($context.$nodes.FIN_GL_WORKFLOW_LEDGER_ORCH_RESULTS_EXPORT.$output.output);\n    agentName = \"ora_fin_gl_export_to_excel_assistant\";\n    category = \"export\";\n}\nelse if (getHierarchyWorkflowOutput().agentOutput) {\n    agentOutput = getHierarchyWorkflowOutput().agentOutput;\n    agentName = \"ora_fin_gl_hierarchy_manager_assistant\";\n    category = \"hierarchy\";\n}\n\nif (!responseReady && (category === 'subledger' || category === 'journal' || category === 'balances')) {\n    let agentHTMLFormat = [];\n    if (agentOutput?.status === 'success') {\n        const shouldShowIntentDetails = agentOutput?.successMessage === 'no_data' || agentOutput?.successMessage === 'async';\n        let collapsibleIntent = null;\n\n        if (shouldShowIntentDetails) {\n            const queryResponse = agentOutput?.state?.private?.lastUsedQuery?.queryResponse;\n            const intentDetails = queryResponse?.queries?.[0]?.intentDetails;\n            const segments = queryResponse?.metadata?.chartOfAccounts?.segments || new Object();\n            const intentDetailsContent = formatIntentDetails(intentDetails, segments);\n\n            if (intentDetailsContent) {\n                collapsibleIntent = {\n                    display_type: \"collapsible\",\n                    headerText: \"Context\",\n                    content: [{ \"display_type\": \"text\", \"data\": intentDetailsContent }],\n                    expanded: \"false\"\n                };\n            }\n        }\n\n        if (agentOutput?.successMessage === 'data') {\n            const queryResponse = agentOutput?.state?.private?.lastUsedQuery?.queryResponse;\n            const hierarchyResolverMessage =\n                String(agentOutput?.hierarchyResolverMessage ?? \"\").trim() ||\n                getHierarchyResolverMessage(queryResponse);\n            const workflowResponse = new Object();\n            workflowResponse.path = 'workflow';\n            workflowResponse.agentName = agentName;\n            workflowResponse.state = agentOutput.state;\n            workflowResponse.previouslyShownColumns = getPreviousDisplayState(agentName);\n            if (Array.isArray(agentOutput?.messages)) {\n                workflowResponse.messages = agentOutput.messages;\n            }\n            if (hierarchyResolverMessage) {\n                workflowResponse.hierarchyResolverMessage = hierarchyResolverMessage;\n            }\n            response = workflowResponse;\n            responseReady = true;\n        }\n\n        else if (agentOutput?.successMessage === 'no_data') {\n            const queryResponse = agentOutput?.state?.private?.lastUsedQuery?.queryResponse;\n\n            if (collapsibleIntent) {\n                agentHTMLFormat.push(collapsibleIntent);\n            }\n\n            insertHierarchyResolverMessageAfterContext(agentHTMLFormat, queryResponse);\n\n            agentHTMLFormat.push({\n                \"display_type\": \"text\",\n                \"data\": no_data_response\n            });\n            appendFooterMessages(agentHTMLFormat, agentOutput?.messages);\n        }\n        else if (agentOutput?.successMessage === 'async') {\n            const queryResponse = agentOutput?.state?.private?.lastUsedQuery?.queryResponse;\n\n            if (collapsibleIntent) {\n                agentHTMLFormat.push(collapsibleIntent);\n            }\n\n            insertHierarchyResolverMessageAfterContext(agentHTMLFormat, queryResponse);\n\n            agentHTMLFormat.push({\n                \"display_type\": \"text\",\n                \"data\": asyncMessage\n            });\n            appendFooterMessages(agentHTMLFormat, agentOutput?.messages);\n        }\n        agentOutput = agentHTMLFormat;\n    }\n    else if (agentOutput?.status === 'error') {\n        const errorObj = agentOutput?.errorDetails || new Object();\n        if (errorObj?.cause === 'VALUE_NOT_IN_HIERARCHY' || errorObj?.cause === 'HIERARCHY_NOT_FOUND') {\n            const toolDisplay = getHierarchyErrorDisplay(errorObj?.details);\n            const selectionContext = getHierarchyErrorSelectionContext(errorObj?.details);\n            const hierarchyMetadata = { type: \"metadata\", intent: \"hierarchySelection\" };\n            if (selectionContext && typeof selectionContext === \"object\" && Object.keys(selectionContext).length > 0) {\n                hierarchyMetadata.selectionContext = selectionContext;\n            }\n\n            if (toolDisplay.length > 0) {\n                agentHTMLFormat = [\n                    hierarchyMetadata,\n                    ...toolDisplay\n                ];\n            }\n            else {\n                agentHTMLFormat = constructHierarchyMessage({\n                    title: errorObj.cause,\n                    detail: errorObj?.details?.detail || errorObj?.details || new Object()\n                });\n                if (hierarchyMetadata.selectionContext) {\n                    const metadataObj = agentHTMLFormat.find((item) => item?.type === \"metadata\");\n                    if (metadataObj) {\n                        metadataObj.selectionContext = hierarchyMetadata.selectionContext;\n                    }\n                }\n            }\n        }\n        else {\n            setErrorResponse(errorObj?.message);\n        }\n    }\n    else if (agentOutput?.status === 'followup') {\n        agentHTMLFormat.push({\n            \"display_type\": \"text\",\n            \"data\": `${agentOutput?.followupMessage}`\n        });\n    }\n\n    agentOutput = agentHTMLFormat;\n}\nelse if (!responseReady && category === 'export') {\n    let agentHTMLFormat = [];\n    if (agentOutput?.status === 'success') {\n        if (agentOutput?.successMessage == 'async') {\n            agentHTMLFormat.push({\n                \"display_type\": \"text\",\n                \"data\": asyncMessage\n            });\n        }\n        else {\n            agentHTMLFormat.push({\n                \"display_type\": \"text\",\n                \"data\": `${agentOutput.link}`\n            });\n        }\n    }\n    else if (agentOutput?.status === 'error') {\n        const errorObj = agentOutput?.errorDetails;\n        setErrorResponse(errorObj?.message);\n    }\n    agentOutput = agentHTMLFormat;\n}\n\n\n\n\nif (!responseReady) {\n    let textOnly = true;\n    let agentResponseArr = [];\n    let itemCount = 1;\n    let toolTimeStamp;\n    let intent;\n    let metadataObj = null;\n    let selectedHierarchies;\n    let usePrepareJsonAds = false;\n    const routingDecision = $context.$variables.routingDecision;\n\n    for (const obj of agentOutput) {\n        if (obj[\"type\"]) {\n            metadataObj = obj;\n            toolTimeStamp = obj[\"toolTimeStamp\"];\n            intent = obj[\"intent\"];\n            if (obj[\"usePrepareJsonAds\"] === true) {\n                usePrepareJsonAds = true;\n            }\n        } else {\n            if (obj[\"display_type\"] !== \"text\" && obj[\"display_type\"] !== \"action\") {\n                textOnly = false;\n            } else {\n                if (obj[\"display_type\"] === \"text\") {\n                    let currItem = {\n                        display_type: \"text\",\n                        display_sequence: itemCount,\n                        text: obj.data\n                    };\n\n                    agentResponseArr.push(currItem);\n                } else {\n                    const actionItems =\n                        routingDecision === \"ora_fin_gl_hierarchy_manager_assistant\"\n                            ? obj.data\n                            : [\"Proceed with these values\"];\n                    let currItem = {\n                        display_type: \"action\",\n                        display_sequence: itemCount,\n                        actions: {\n                            items: actionItems\n                        }\n                    };\n\n                    agentResponseArr.push(currItem);\n                }\n\n                itemCount += 1;\n            }\n        }\n    }\n\n\n    const hierarchyManagerOutput = getHierarchyWorkflowOutput().agentOutput ?? [];\n\n    for (const obj of hierarchyManagerOutput) {\n        if (\n            obj?.type === \"metadata\" &&\n            typeof obj?.selectedHierarchies === \"string\"\n        ) {\n            selectedHierarchies = obj.selectedHierarchies;\n            break;\n        }\n    }\n\n    if (metadataObj) {\n        if (typeof selectedHierarchies === \"string\") {\n            metadataObj[\"selectedHierarchies\"] = selectedHierarchies;\n        } else if (Object.prototype.hasOwnProperty.call(metadataObj, \"selectedHierarchies\")) {\n            delete metadataObj[\"selectedHierarchies\"];\n        }\n    }\n\n    response = new Object();\n    response.previouslyShownColumns = getPreviousDisplayState($context.$variables.routingDecision);\n    if (textOnly && !usePrepareJsonAds) {\n        response[\"requiresllm\"] = false;\n        response[\"path\"] = \"simple\";\n        response[\"agentResponse\"] = agentResponseArr;\n        response[\"metadata\"] = {\n            agentName: agentName,\n            category: category\n        };\n\n        if (toolTimeStamp) {\n            response[\"metadata\"][\"timeStamp\"] = toolTimeStamp;\n            response[\"metadata\"][\"intent\"] = intent;\n        }\n\n        if (typeof selectedHierarchies === \"string\") {\n            response[\"metadata\"][\"selectedHierarchies\"] = selectedHierarchies;\n        }\n\n    } else {\n        response[\"path\"] = \"api\";\n        response[\"requiresllm\"] = true;\n        response[\"agentOutput\"] = agentOutput;\n        response[\"agentName\"] = agentName;\n    }\n}\n\nreturn response;"
