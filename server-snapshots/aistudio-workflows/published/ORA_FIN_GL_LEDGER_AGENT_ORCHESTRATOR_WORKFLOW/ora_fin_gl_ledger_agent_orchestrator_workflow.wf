            "returnType": "object",
            "sourceCode": "const displayState = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state;\nconst lastUsedQuery = displayState.private.lastUsedQuery;\nconst viewType = lastUsedQuery.analyticViewNameUsed ? \"analyticView\" : \"businessView\";\nconst viewName = viewType === \"analyticView\" ? lastUsedQuery.analyticViewNameUsed : lastUsedQuery.businessViewNameUsed;\nconst rawData = viewType === \"analyticView\" ? displayState.private.lastUsedData.dataResponse.avExtractResult : displayState.private.lastUsedData.dataResponse;\nconst dataPayload = displayState.private.lastUsedData.dataPayload || {};\nconst measureAliases = Object.keys(dataPayload?.queries?.[0]?.analyticViews?.avUsage1?.measureAliases || {});\nconst ledgerCategory = lastUsedQuery.queryPayload?.queries?.[0]?.ledgerCategory;\nconst queryResponse = lastUsedQuery?.queryResponse;\nconst rawIntentDetails = queryResponse?.queries?.[0]?.intentDetails;\n\nconst isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\nconst isBlank = (value) => value === null || value === undefined || String(value).trim() === \"\";\nconst isCurrencyColumn = (column) => String(column ?? \"\").toLowerCase().includes(\"currency\");\nconst isInternalColumn = (column) => column === \"rowIndex\";\nconst isOmittedPlannerColumn = (column) => {\n    const lowerColumn = String(column ?? \"\").toLowerCase();\n\n    return lowerColumn.endsWith(\"sign\") ||\n        lowerColumn.includes(\"treefilter\") ||\n        lowerColumn.includes(\"levelname\");\n};\nconst queryResponseSegments = queryResponse?.metadata?.chartOfAccounts?.segments;\nconst coaSegmentColumns = isRecordObject(queryResponseSegments) ? Object.keys(queryResponseSegments) : [];\nconst coaSegmentColumnSet = new Set(coaSegmentColumns);\nconst measureColumnPrefixes = [\"entered\", \"accounted\"];\n\nconst escapeMarkdownCell = (value) => String(value ?? \"\")\n    .replace(/\\r?\\n/g, \" \")\n    .replace(/\\|/g, \"\\\\|\")\n    .trim();\n\nconst getDescriptionColumn = (record, column) => {\n    const exactDescriptionColumn = `${column}Description`;\n\n    if (Object.prototype.hasOwnProperty.call(record || {}, exactDescriptionColumn)) {\n        return exactDescriptionColumn;\n    }\n\n    return \"\";\n};\n\nconst getDescriptionValue = (record, column) => {\n    const descriptionColumn = getDescriptionColumn(record, column);\n\n    return descriptionColumn ? record?.[descriptionColumn] : undefined;\n};\n\nconst formatMemberValue = (record, column) => {\n    const columnValue = record?.[column];\n    const columnDescription = getDescriptionValue(record, column);\n\n    if (isBlank(columnValue)) {\n        return isBlank(columnDescription) ? \"\" : columnDescription;\n    }\n\n    if (isBlank(columnDescription) || String(columnDescription) === String(columnValue)) {\n        return columnValue;\n    }\n\n    return `${columnValue}-${columnDescription}`;\n};\n\nconst normalizeGenericValue = (value) => String(value ?? \"\")\n    .trim()\n    .replace(/\\s+/g, \" \")\n    .toLowerCase();\n\nconst isGenericAllValues = (value, column) => {\n    const normalizedValue = normalizeGenericValue(value);\n\n    if (normalizedValue === \"\" || normalizedValue === \"all values\") {\n        return normalizedValue !== \"\";\n    }\n\n    const segmentLabel = normalizeGenericValue(queryResponseSegments?.[column]?.label);\n\n    return segmentLabel !== \"\" && normalizedValue === `all ${segmentLabel} values`;\n};\n\nconst isGenericAllValuesColumn = (records, column) => {\n    let hasValue = false;\n\n    for (const record of records || []) {\n        if (!isRecordObject(record)) {\n            continue;\n        }\n\n        const value = coaSegmentColumns.includes(column) ? formatMemberValue(record, column) : record?.[column];\n\n        if (isBlank(value)) {\n            continue;\n        }\n\n        hasValue = true;\n\n        if (!isGenericAllValues(value, column)) {\n            return false;\n        }\n    }\n\n    return hasValue;\n};\n\nconst getSegmentLabels = (metaData) => {\n    const segmentLabels = {};\n    const segments = metaData?.chartOfAccounts?.segments ?? {};\n\n    if (!isRecordObject(segments)) {\n        return segmentLabels;\n    }\n\n    for (const segment of Object.keys(segments)) {\n        segmentLabels[segment] = segments[segment]?.label ?? \"\";\n    }\n\n    return segmentLabels;\n};\n\nconst getColumnLabels = (attributeDetails) => {\n    const columnLabels = {};\n\n    if (!Array.isArray(attributeDetails)) {\n        return columnLabels;\n    }\n\n    for (const attribute of attributeDetails) {\n        if (attribute?.attributeName && !isCurrencyColumn(attribute.attributeName) && !isOmittedPlannerColumn(attribute.attributeName)) {\n            columnLabels[attribute.attributeName] = attribute.attributeLabel ?? \"\";\n        }\n    }\n\n    return columnLabels;\n};\n\nconst getColumns = (records, options = {}) => {\n    const columns = [];\n    const seenColumns = new Set();\n    const includeInternal = options.includeInternal === true;\n\n    for (const record of records || []) {\n        if (!isRecordObject(record)) {\n            continue;\n        }\n\n        for (const column of Object.keys(record)) {\n            if ((!includeInternal && isInternalColumn(column)) || seenColumns.has(column)) {\n                continue;\n            }\n\n            columns.push(column);\n            seenColumns.add(column);\n        }\n    }\n\n    return columns;\n};\n\nconst addRowIndexes = (records) => {\n    const indexedRows = [];\n    let nextIndex = 1;\n\n    for (const record of records || []) {\n        if (!isRecordObject(record)) {\n            continue;\n        }\n\n        const indexedRow = {\n            ...record,\n            rowIndex: nextIndex\n        };\n        indexedRows.push(indexedRow);\n        nextIndex += 1;\n    }\n\n    return indexedRows;\n};\n\nconst recordsToMarkdownTable = (records) => {\n    if (!Array.isArray(records) || records.length === 0) {\n        return \"\";\n    }\n\n    const coaDescriptionColumns = new Set();\n\n    for (const record of records) {\n        for (const column of coaSegmentColumns) {\n            const descriptionColumn = getDescriptionColumn(record, column);\n\n            if (descriptionColumn) {\n                coaDescriptionColumns.add(descriptionColumn);\n            }\n        }\n    }\n\n    const columns = getColumns(records, { includeInternal: true })\n        .filter((column) => !coaDescriptionColumns.has(column) && !isOmittedPlannerColumn(column) && !isGenericAllValuesColumn(records, column));\n\n    if (columns.length === 0) {\n        return \"\";\n    }\n\n    const header = `| ${columns.map(escapeMarkdownCell).join(\" | \")} |`;\n    const separator = `| ${columns.map(() => \"---\").join(\" | \")} |`;\n    const rows = records.map((record) => {\n        const cells = columns.map((column) => {\n            const cellValue = record?.[column];\n\n            return escapeMarkdownCell(cellValue);\n        });\n\n        return `| ${cells.join(\" | \")} |`;\n    });\n\n    return [header, separator, ...rows].join(\"\\n\");\n};\n\nconst joinList = (values) => {\n    if (!Array.isArray(values) || values.length === 0) {\n        return \"(none)\";\n    }\n\n    return values.join(\", \");\n};\n\nconst formatLabelMap = (labels) => {\n    if (!isRecordObject(labels)) {\n        return \"(none)\";\n    }\n\n    const entries = Object.keys(labels)\n        .filter((key) => !isBlank(labels[key]))\n        .map((key) => `${key}: ${labels[key]}`);\n\n    if (entries.length === 0) {\n        return \"(none)\";\n    }\n\n    return entries.join(\", \");\n};\n\nconst appendCommonGroupPrompt = (lines, group) => {\n    lines.push(`Group: ${group.groupId}`);\n    lines.push(`Label: ${group.groupLabel}`);\n    lines.push(`Available measure columns: ${joinList(group.availableMeasureColumns)}`);\n    lines.push(`Currency columns: ${joinList(group.hiddenCurrencyColumns)}`);\n    lines.push(`Intent scope: ${JSON.stringify(group.intentScope || {})}`);\n    lines.push(`omitColumns: ${JSON.stringify(group.omitColumns || [])}`);\n\n    if (isRecordObject(group.segmentLabels)) {\n        lines.push(`Segment labels: ${formatLabelMap(group.segmentLabels)}`);\n    }\n\n    if (isRecordObject(group.columnLabels)) {\n        lines.push(`Column labels: ${formatLabelMap(group.columnLabels)}`);\n    }\n};\n\nconst getPromptHeaderLines = () => {\n    const lines = [\n        `View type: ${viewType}`,\n        `Source view name: ${viewName}`,\n        `Ledger category: ${ledgerCategory ?? \"\"}`\n    ];\n\n    if (coaSegmentColumns.length > 0) {\n        lines.push(`COA segments: ${joinList(coaSegmentColumns)}`);\n    }\n\n    lines.push(\"\");\n\n    return lines;\n};\n\nconst buildAvPlannerPrompt = (groups) => {\n    const lines = getPromptHeaderLines();\n\n    for (const group of groups) {\n        appendCommonGroupPrompt(lines, group);\n        lines.push(\"Current records:\");\n        lines.push(group.current?.records || \"(none)\");\n        lines.push(\"Child records:\");\n        lines.push(group.child?.records || \"(none)\");\n        lines.push(\"\");\n    }\n\n    return lines.join(\"\\n\").trim();\n};\n\nconst buildBusinessViewPlannerPrompt = (groups) => {\n    const lines = getPromptHeaderLines();\n\n    for (const group of groups) {\n        appendCommonGroupPrompt(lines, group);\n        lines.push(\"Records:\");\n        lines.push(group.records || \"(none)\");\n        lines.push(\"\");\n    }\n\n    return lines.join(\"\\n\").trim();\n};\n\nconst stripMeasureColumnPrefix = (column) => {\n    const columnText = String(column ?? \"\");\n\n    for (const prefix of measureColumnPrefixes) {\n        const nextCharacter = columnText.charAt(prefix.length);\n\n        if (columnText.startsWith(prefix) && /^[A-Z]$/.test(nextCharacter)) {\n            return nextCharacter.toLowerCase() + columnText.slice(prefix.length + 1);\n        }\n    }\n\n    return columnText;\n};\n\nconst hasMeasureAliasMatch = (column) => {\n    const columnText = String(column ?? \"\");\n\n    return measureAliases.some((alias) => {\n        if (!columnText.startsWith(alias)) {\n            return false;\n        }\n\n        const suffix = columnText.slice(alias.length);\n        return suffix === \"\" || !suffix.startsWith(\"Sign\");\n    });\n};\n\nconst isMeasureColumnFromAlias = (column) => {\n    if (measureAliases.length === 0) {\n        return undefined;\n    }\n\n    const columnText = String(column ?? \"\");\n\n    if (hasMeasureAliasMatch(columnText)) {\n        return true;\n    }\n\n    const columnWithoutMeasurePrefix = stripMeasureColumnPrefix(columnText);\n    return columnWithoutMeasurePrefix !== columnText && hasMeasureAliasMatch(columnWithoutMeasurePrefix);\n};\n\nconst isMeasureColumn = (column) => {\n    const lowerColumn = String(column ?? \"\").toLowerCase();\n    const isMeasureByAlias = viewType === \"analyticView\" ? isMeasureColumnFromAlias(column) : undefined;\n    const measureTerms = [\n        \"amount\",\n        \"activity\",\n        \"balance\",\n        \"debit\",\n        \"credit\",\n        \"net\"\n    ];\n\n    return isMeasureByAlias ?? measureTerms.some((term) => lowerColumn.includes(term));\n};\n\nconst getAvailableColumns = (records) => getColumns(records).filter((column) => !isCurrencyColumn(column) && !isOmittedPlannerColumn(column) && !isGenericAllValuesColumn(records, column));\nconst getAvailableMeasureColumns = (records) => getAvailableColumns(records).filter(isMeasureColumn);\nconst getHiddenCurrencyColumns = (records) => getColumns(records).filter((column) => isCurrencyColumn(column) && !isOmittedPlannerColumn(column));\n\nconst normalizeIntentText = (value) => String(value ?? \"\")\n    .trim()\n    .replace(/\\s+/g, \" \");\n\nconst normalizeIntentKey = (value) => normalizeIntentText(value).toLowerCase();\n\nconst toLowerCamelIntentKey = (value) => {\n    const words = normalizeIntentText(value)\n        .replace(/[^A-Za-z0-9]+/g, \" \")\n        .split(\" \")\n        .filter(Boolean);\n\n    if (words.length === 0) {\n        return \"\";\n    }\n\n    return words\n        .map((word, index) => {\n            const lowerWord = word.toLowerCase();\n\n            return index === 0\n                ? lowerWord\n                : lowerWord.charAt(0).toUpperCase() + lowerWord.slice(1);\n        })\n        .join(\"\");\n};\n\nconst splitIntentValues = (value) => {\n    if (Array.isArray(value)) {\n        return value.flatMap(splitIntentValues);\n    }\n\n    const text = isRecordObject(value) ? JSON.stringify(value) : String(value ?? \"\");\n\n    return text\n        .split(\",\")\n        .map(normalizeIntentText)\n        .filter(Boolean);\n};\n\nconst isParenthesizedIntentValue = (value) => {\n    const valueText = normalizeIntentText(value);\n\n    return valueText.startsWith(\"(\") && valueText.endsWith(\")\");\n};\n\nconst normalizeIntentValueForColumn = (value, isCoaSegmentColumn) => {\n    const valueText = normalizeIntentText(value);\n\n    if (!isCoaSegmentColumn || isParenthesizedIntentValue(valueText)) {\n        return valueText;\n    }\n\n    const separatorIndex = valueText.indexOf(\"-\");\n    return separatorIndex > 0 ? valueText.slice(0, separatorIndex).trim() : valueText;\n};\n\nconst getIntentDetailsObject = (intentDetails) => {\n    if (!isRecordObject(intentDetails)) {\n        return {};\n    }\n\n    return isRecordObject(intentDetails.intentDetails) ? intentDetails.intentDetails : intentDetails;\n};\n\nconst addUniqueValue = (values, value) => {\n    const normalizedValue = normalizeIntentKey(value);\n\n    if (!normalizedValue || values.some((existingValue) => normalizeIntentKey(existingValue) === normalizedValue)) {\n        return;\n    }\n\n    values.push(value);\n};\n\nconst getIntentColumnsForKey = (key, labels = {}, availableColumns = new Set()) => {\n    const normalizedKey = normalizeIntentKey(key);\n    const columns = [];\n    const addColumn = (column) => {\n        if (!column || columns.includes(column)) {\n            return;\n        }\n\n        if (availableColumns.size === 0 || availableColumns.has(column)) {\n            columns.push(column);\n        }\n    };\n\n    for (const [column, label] of Object.entries(labels || {})) {\n        if (normalizeIntentKey(label) === normalizedKey || normalizeIntentKey(column) === normalizedKey) {\n            addColumn(column);\n        }\n    }\n\n    for (const column of availableColumns) {\n        if (normalizeIntentKey(column) === normalizedKey) {\n            addColumn(column);\n        }\n    }\n\n    addColumn(toLowerCamelIntentKey(key));\n\n    const knownIntentColumnsByKey = {\n        supplier: [\"supplier\", \"supplierName\"],\n        customer: [\"customer\", \"customerName\", \"billToCustomerName\"],\n        \"business unit\": [\"businessUnit\", \"businessUnitName\", \"businessName\", \"buName\"],\n        \"legal entity\": [\"legalEntity\", \"legalEntityName\"],\n        ledger: [\"ledger\"],\n        currency: [\"currency\", \"currencyCode\", \"enteredCurrency\", \"ledgerCurrency\"],\n        \"accounting period\": [\"accountingPeriod\", \"accountingPeriodName\", \"periodName\"],\n        \"accounting date\": [\"accountingDate\", \"fiscalDate\"]\n    };\n\n    for (const column of knownIntentColumnsByKey[normalizedKey] || []) {\n        addColumn(column);\n    }\n\n    return columns;\n};\n\nconst buildIntentScopeData = (intentDetails, labels = {}, records = []) => {\n    const intentDetailsObject = getIntentDetailsObject(intentDetails);\n    const availableColumns = new Set(getAvailableColumns(records));\n    const scopeByColumn = new Map();\n\n    for (const [key, value] of Object.entries(intentDetailsObject)) {\n        const columns = getIntentColumnsForKey(key, labels, availableColumns);\n\n        for (const column of columns) {\n            const isCoaSegmentColumn = coaSegmentColumnSet.has(column);\n\n            if (!scopeByColumn.has(column)) {\n                scopeByColumn.set(column, {\n                    column,\n                    values: [],\n                    usableValues: []\n                });\n            }\n\n            const scope = scopeByColumn.get(column);\n\n            for (const rawValue of splitIntentValues(value)) {\n                const intentValue = normalizeIntentValueForColumn(rawValue, isCoaSegmentColumn);\n\n                addUniqueValue(scope.values, intentValue);\n\n                if (!isParenthesizedIntentValue(intentValue)) {\n                    addUniqueValue(scope.usableValues, intentValue);\n                }\n            }\n        }\n    }\n\n    const intentScopeEntries = Array.from(scopeByColumn.values());\n    const intentScope = {};\n\n    for (const entry of intentScopeEntries) {\n        intentScope[entry.column] = entry.values;\n    }\n\n    return {\n        intentScope,\n        intentScopeEntries\n    };\n};\n\nconst normalizeComparableValue = (value, isCoaSegmentColumn) =>\n    normalizeIntentValueForColumn(value, isCoaSegmentColumn).toLowerCase();\n\nconst getIntentOmitColumns = (records, intentScopeEntries = []) => {\n    const safeRecords = Array.isArray(records) ? records : [];\n\n    if (safeRecords.length === 0) {\n        return [];\n    }\n\n    const omitColumns = [];\n\n    for (const entry of intentScopeEntries) {\n        const column = entry?.column;\n        const usableValues = Array.isArray(entry?.usableValues) ? entry.usableValues : [];\n\n        if (!column || usableValues.length !== 1 || !getAvailableColumns(safeRecords).includes(column)) {\n            continue;\n        }\n\n        const isCoaSegmentColumn = coaSegmentColumnSet.has(column);\n        const expectedValue = normalizeComparableValue(usableValues[0], isCoaSegmentColumn);\n\n        if (!expectedValue) {\n            continue;\n        }\n\n        const allRowsMatch = safeRecords.every((record) => {\n            if (!isRecordObject(record) || !Object.prototype.hasOwnProperty.call(record, column)) {\n                return false;\n            }\n\n            const displayedValue = isCoaSegmentColumn ? formatMemberValue(record, column) : record[column];\n\n            return normalizeComparableValue(displayedValue, isCoaSegmentColumn) === expectedValue;\n        });\n\n        if (allRowsMatch) {\n            omitColumns.push(column);\n        }\n    }\n\n    return omitColumns;\n};\n\nconst getPrimaryGroupLabel = () => {\n    const lowerViewName = String(viewName ?? \"\").toLowerCase();\n\n    if (lowerViewName.includes(\"payablesaccountedtransactionsummary\")) {\n        return \"Payables Invoices\";\n    }\n\n    if (lowerViewName.includes(\"payablesaccountedpaymentsummary\")) {\n        return \"Payables Payments\";\n    }\n\n    if (lowerViewName.includes(\"receivablesaccountedtransactionsummary\")) {\n        return \"Receivables Invoices\";\n    }\n\n    if (lowerViewName.includes(\"receivablesaccountedreceiptsummary\")) {\n        return \"Receivables Receipts\";\n    }\n\n    return \"Primary\";\n};\n\nconst getSecondaryGroupLabel = (primaryLabel) => {\n    const secondaryLabels = {\n        \"Payables Invoices\": \"Payables Payments\",\n        \"Receivables Invoices\": \"Receivables Receipts\"\n    };\n\n    return secondaryLabels[primaryLabel] || \"Secondary\";\n};\n\nconst getAvGroupLabel = (suffix) => {\n    if (suffix === \"Primary\") {\n        return getPrimaryGroupLabel();\n    }\n\n    if (suffix === \"Secondary\") {\n        return getSecondaryGroupLabel(getPrimaryGroupLabel());\n    }\n\n    return suffix;\n};\n\nconst getBusinessViewGroupLabel = (groupId) => {\n    const labelsByName = {\n        payablesAccountedInvoiceDetail: \"Payables Invoices\",\n        payablesAccountedPaymentDetail: \"Payables Payments\",\n        receivablesAccountedCoreTransactionDetail: \"Receivables Invoices\",\n        receivablesAccountedAdjustmentDetail: \"Receivables Adjustments\",\n        receivablesAccountedStandardReceiptDetail: \"Applied Receipts\",\n        receivablesAccountedCashReceiptHistoryDetail: \"UnApplied/Unidentified Receipts\",\n        receivablesAccountedMiscellaneousReceiptDetail: \"Miscellaneous Receipts\"\n    };\n\n    return labelsByName[groupId] || groupId;\n};\n\nconst getAvSuffixes = (ledgerLevelData) => {\n    const suffixes = [];\n    const seenSuffixes = new Set();\n\n    for (const key of Object.keys(ledgerLevelData || {})) {\n        const match = key.match(/^(current|child)LevelAvData(.+)$/);\n\n        if (!match) {\n            continue;\n        }\n\n        const suffix = match[2];\n\n        if (!seenSuffixes.has(suffix)) {\n            suffixes.push(suffix);\n            seenSuffixes.add(suffix);\n        }\n    }\n\n    const suffixOrder = {\n        Primary: 0,\n        Secondary: 1\n    };\n\n    return suffixes\n        .map((suffix, index) => ({ suffix, index }))\n        .sort((left, right) => {\n            const leftOrder = suffixOrder[left.suffix] ?? 2;\n            const rightOrder = suffixOrder[right.suffix] ?? 2;\n\n            return leftOrder - rightOrder || left.index - right.index;\n        })\n        .map(({ suffix }) => suffix);\n};\n\nconst buildAvGroups = () => {\n    const plannerGroups = [];\n    const renderGroups = [];\n    const segmentLabels = getSegmentLabels(rawData?.metadata);\n    const ledgerLevelAvData = Array.isArray(rawData?.ledgerLevelAvData) ? rawData.ledgerLevelAvData : [];\n    const addAvGroup = (groupId, groupLabel, currentRows, childRows) => {\n        if (currentRows.length === 0 && childRows.length === 0) {\n            return;\n        }\n\n        const tableRows = childRows.length > 0 ? childRows : currentRows;\n        const availableColumns = getAvailableColumns(tableRows);\n        const availableMeasureColumns = getAvailableMeasureColumns(tableRows);\n        const hiddenCurrencyColumns = getHiddenCurrencyColumns(tableRows);\n        const intentScopeData = buildIntentScopeData(rawIntentDetails, segmentLabels, tableRows);\n        const omitColumns = getIntentOmitColumns(tableRows, intentScopeData.intentScopeEntries);\n        const plannerGroup = {\n            groupId,\n            groupLabel,\n            current: {\n                records: recordsToMarkdownTable(currentRows)\n            },\n            child: {\n                records: recordsToMarkdownTable(childRows)\n            },\n            availableColumns,\n            availableMeasureColumns,\n            hiddenCurrencyColumns,\n            intentScope: intentScopeData.intentScope,\n            omitColumns,\n            segmentLabels\n        };\n        const renderGroup = {\n            groupId,\n            groupLabel,\n            currentRows,\n            childRows,\n            availableColumns,\n            availableMeasureColumns,\n            hiddenCurrencyColumns,\n            intentScope: intentScopeData.intentScope,\n            omitColumns,\n            segmentLabels\n        };\n\n        plannerGroups.push(plannerGroup);\n        renderGroups.push(renderGroup);\n    };\n\n    const homogenousLedgerRows = addRowIndexes(rawData?.homogenousLedgerSetAvData?.records || []);\n\n    addAvGroup(\"homogenousLedgerSetAvData\", \"Ledger Set\", homogenousLedgerRows, []);\n\n    for (let ledgerIndex = 0; ledgerIndex < ledgerLevelAvData.length; ledgerIndex += 1) {\n        const ledgerLevelData = ledgerLevelAvData[ledgerIndex];\n\n        if (!isRecordObject(ledgerLevelData)) {\n            continue;\n        }\n\n        const suffixes = getAvSuffixes(ledgerLevelData);\n\n        for (const suffix of suffixes) {\n            const currentRows = addRowIndexes(ledgerLevelData?.[`currentLevelAvData${suffix}`]?.records || []);\n            const childRows = addRowIndexes(ledgerLevelData?.[`childLevelAvData${suffix}`]?.records || []);\n            const groupId = ledgerLevelAvData.length > 1 ? `${suffix}_${ledgerIndex + 1}` : suffix;\n            const groupLabel = getAvGroupLabel(suffix);\n\n            addAvGroup(groupId, groupLabel, currentRows, childRows);\n        }\n    }\n\n    const groupData = {\n        plannerGroups,\n        renderGroups\n    };\n\n    return groupData;\n};\n\nconst buildBusinessViewGroups = () => {\n    const plannerGroups = [];\n    const renderGroups = [];\n\n    for (const groupId of Object.keys(rawData || {})) {\n        const tableData = rawData[groupId];\n        const records = Array.isArray(tableData?.records) ? tableData.records : [];\n\n        if (records.length === 0) {\n            continue;\n        }\n\n        const rows = addRowIndexes(records);\n        const availableColumns = getAvailableColumns(rows);\n        const availableMeasureColumns = getAvailableMeasureColumns(rows);\n        const hiddenCurrencyColumns = getHiddenCurrencyColumns(rows);\n        const columnLabels = getColumnLabels(tableData?.attributeDetails);\n        const intentScopeData = buildIntentScopeData(rawIntentDetails, columnLabels, rows);\n        const omitColumns = getIntentOmitColumns(rows, intentScopeData.intentScopeEntries);\n        const groupLabel = getBusinessViewGroupLabel(groupId);\n        const plannerGroup = {\n            groupId,\n            groupLabel,\n            records: recordsToMarkdownTable(rows),\n            availableColumns,\n            availableMeasureColumns,\n            hiddenCurrencyColumns,\n            intentScope: intentScopeData.intentScope,\n            omitColumns,\n            columnLabels\n        };\n        const renderGroup = {\n            groupId,\n            groupLabel,\n            rows,\n            availableColumns,\n            availableMeasureColumns,\n            hiddenCurrencyColumns,\n            intentScope: intentScopeData.intentScope,\n            omitColumns,\n            columnLabels\n        };\n\n        plannerGroups.push(plannerGroup);\n        renderGroups.push(renderGroup);\n    }\n\n    const groupData = {\n        plannerGroups,\n        renderGroups\n    };\n\n    return groupData;\n};\n\nconst groupedData = viewType === \"analyticView\" ? buildAvGroups() : buildBusinessViewGroups();\nconst plannerPrompt = viewType === \"analyticView\"\n    ? buildAvPlannerPrompt(groupedData.plannerGroups)\n    : buildBusinessViewPlannerPrompt(groupedData.plannerGroups);\nconst outputObject = {\n    viewType,\n    viewName,\n    ledgerCategory,\n    plannerPrompt,\n    renderData: {\n        viewType,\n        viewName,\n        groups: groupedData.renderGroups\n    }\n};\n\nreturn outputObject;"
