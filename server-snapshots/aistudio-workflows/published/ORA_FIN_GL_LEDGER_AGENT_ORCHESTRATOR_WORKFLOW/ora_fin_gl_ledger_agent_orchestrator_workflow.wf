            "name": "Domain Metadata Storage",
            "returnType": "object",
            "sourceCode": "const currentDomain = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.agentName;\nconst lastUsedQuery = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedQuery;\nconst orchestratorObj =  $context.$nodes?.PROCESS_PRESENTATION_LLM?.$output?.result?.orchestratorObj;\nconst isPresentationPath = orchestratorObj?.path === \"presentation\";\nconst viewType = lastUsedQuery.analyticViewNameUsed ? \"analyticView\" : \"businessView\";\nconst viewName = viewType === \"analyticView\"\n  ? lastUsedQuery.analyticViewNameUsed\n  : lastUsedQuery.businessViewNameUsed;\nconst dataResponse = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse;\nconst balanceAssistantName = \"ora_fin_gl_balance_inquiry_and_analysis_assistant\";\nconst accountingPeriodKeys = [\"period\", \"accountingPeriod\", \"quarter\", \"year\"];\n\nconst isRecordObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\n\nconst normalizeAccountingPeriod = (value) => {\n  const periodValue = isRecordObject(value) ? value.value : value;\n  return String(periodValue ?? \"\").trim();\n};\n\nconst addDistinctAccountingPeriod = (periods, seenPeriods, value) => {\n  const period = normalizeAccountingPeriod(value);\n  const periodKey = period.toLowerCase();\n\n  if (period === \"\" || seenPeriods.has(periodKey)) {\n    return;\n  }\n\n  seenPeriods.add(periodKey);\n  periods.push(period);\n};\n\nconst getBalanceResultRecords = () => {\n  const records = [];\n  const addDatasetRecords = (dataset) => {\n    if (Array.isArray(dataset)) {\n      records.push(...dataset.filter(isRecordObject));\n      return;\n    }\n\n    if (Array.isArray(dataset?.records)) {\n      records.push(...dataset.records.filter(isRecordObject));\n    }\n  };\n\n  if (viewType === \"analyticView\") {\n    const avExtractResult = dataResponse?.avExtractResult;\n    addDatasetRecords(avExtractResult?.homogenousLedgerSetAvData);\n\n    if (Array.isArray(avExtractResult?.ledgerLevelAvData)) {\n      for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n        addDatasetRecords(ledgerLevelData?.currentLevelAvData);\n        addDatasetRecords(ledgerLevelData?.childLevelAvData);\n      }\n    }\n\n    return records;\n  }\n\n  if (!isRecordObject(dataResponse)) {\n    return records;\n  }\n\n  const dataKey = Object.keys(dataResponse).find((key) => {\n    const lowerKey = key.toLowerCase();\n    return lowerKey.includes(\"data\") && lowerKey !== \"metadata\" && Array.isArray(dataResponse[key]);\n  });\n\n  addDatasetRecords(dataKey ? dataResponse[dataKey] : undefined);\n  return records;\n};\n\nconst deriveAccountingPeriods = () => {\n  const accountingPeriods = [];\n  const seenPeriods = new Set();\n\n  if (currentDomain !== balanceAssistantName) {\n    return accountingPeriods;\n  }\n\n  const variancePeriods = dataResponse?.avExtractResult?.metadata?.varianceContext?.accountingPeriods;\n\n  if (Array.isArray(variancePeriods)) {\n    for (const period of variancePeriods) {\n      addDistinctAccountingPeriod(accountingPeriods, seenPeriods, period);\n    }\n\n    if (accountingPeriods.length > 0) {\n      return accountingPeriods;\n    }\n  }\n\n  for (const record of getBalanceResultRecords()) {\n    const periodKey = accountingPeriodKeys.find((key) =>\n      Object.prototype.hasOwnProperty.call(record, key)\n    );\n\n    if (periodKey) {\n      addDistinctAccountingPeriod(accountingPeriods, seenPeriods, record[periodKey]);\n    }\n  }\n\n  return accountingPeriods;\n};\n\nconst accountingPeriods = deriveAccountingPeriods();\n\nconst emptyMetadata = {\n  accountingPeriods,\n  summaryInstructions: \"\",\n  columnInstructions: \"\",\n  columnSourceAuthorityInstructions: \"\",\n  displayPlanningMode: isPresentationPath ? \"presentationOnly\" : \"resultPlanning\"\n};\n\nconst headLineMeasures = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse?.avExtractResult?.headLineMeasures;\nconst mandatoryCoaSegments = $context.$nodes.SUMMARIZATION_PRE_PROCESSOR.$output.result.state.private.lastUsedData.dataResponse?.avExtractResult?.metadata?.mandatoryCoaSegments;\n\nconst findBusinessViewInstructions = (instructionsByViewName, defaultInstructions) => {\n  const lowerViewName = String(viewName ?? \"\").toLowerCase();\n  const matchedKey = Object.keys(instructionsByViewName).find((key) => lowerViewName.includes(key));\n\n  return matchedKey ? instructionsByViewName[matchedKey] : defaultInstructions;\n};\n\nconst commonAnalyticViewSummaryInstructions = `- In these instructions, \"summary-level rows\" means rows from homogenousLedgerSetAvData and currentLevelAvData; childLevelAvData rows are child/detail rows.\n- Treat all homogenousLedgerSetAvData rows followed by all currentLevelAvData rows as one combined parent dataset for summary-level display planning. Do not create a separate summary for homogenousLedgerSetAvData before planning currentLevelAvData.\n- Render each non-empty parent or child/detail dataset at most once.\n- Generate analytic-view amount summary content only when the block has \\`summaryMode: fullAmountEligible\\`.\n- Generate analytic-view context-only headline content only when the block has \\`summaryMode: contextHeadlineEligible\\`.\n- If a block has \\`summaryMode: none\\`, return an empty summary for that block.\n- Only the headline measures: \\`${headLineMeasures}\\` (and variance fields \\`varianceAmount\\`, \\`variancePercent\\`, when present) should be reflected in the summary. Do not use other measures for summary.\n- Use the row represented by \\`summaryMode: fullAmountEligible\\` as the only source for headline measures, currency, ledger, and other summary facts. For balance summaries, use time period names from <accounting_periods>.\n- For \\`summaryMode: contextHeadlineEligible\\`, use resolved display values from <intent_scope_display> as the only source for scoped headline context.\n- For \\`summaryMode: contextHeadlineEligible\\`, write one concise headline that answers what result the table contains. Preserve the requested result type, measure, threshold, comparison, or entity from the user request, but replace user-provided aliases/codes with resolved display values from <intent_scope_display>. Do not include every value from <intent_scope_display> by default; include only resolved context that the user referenced, that is necessary to answer the requested result, or that disambiguates the result.\n- For \\`summaryMode: contextHeadlineEligible\\`, do not mention amounts, do not aggregate rows, and return \\`rowsToExclude: []\\`.\n- Do not aggregate, total, or summarize amounts from multiple rendered rows.\n- When multiple independent parent or child/detail datasets are present, emit at most one summary for each dataset. Do not emit multiple summary blocks for the same parent dataset.\n- If summary rows differ only by accounting period, combine them into one logical summary sentence when the data shape supports measure-by-period wording; preserve chronological period order and service measure order.\n- In full summaries, include relevant COA segment and business-facing context values from the summarized row when they are mandatory, user-referenced, or needed for clarity.\n- Do not include COA segment values that are generic all-values members, such as All Values or All <segment> Values.\n- Do not append Dr/Cr to any amount.\n- Keep accounting period values as returned.\n`;\n\nconst commonAnalyticViewColumnInstructions = `- In these instructions, \"summary-level rows\" means analytic-view rows from homogenousLedgerSetAvData and currentLevelAvData; childLevelAvData rows are child/detail rows.\n- Treat all homogenousLedgerSetAvData rows followed by all currentLevelAvData rows as one combined parent dataset for summary-level display planning. Select parent table columns from that combined parent dataset.\n- Use \\`rowsToExclude\\` only for rows represented by a \\`summaryMode: fullAmountEligible\\` summary or explicit row-visibility requests.\n- Select table columns from the rows that will render for the current dataset: summary-level rows when multiple summary-level rows are rendered, otherwise child/detail rows when child/detail rows are rendered.\n- Use only the current block's metadata and markdown headers for column decisions.\n- Do not select rowIndex, technical/helper keys, internal IDs, query keys, metadata keys, currency context fields, or sign fields as standalone columns.\n- Treat currency fields as formatting context for amount/measure columns.\n- Treat sign fields as hidden/internal metadata only.\n- Omit standalone currency columns. Currency should be represented through the amount/measure value.\n- Omit standalone sign columns. Do not represent Dr/Cr signs with matching amount/measure values.\n- Select COA segment member value columns, not matching description columns.\n- Do not include COA segment columns whose values are only generic all-values members, such as All Values or All <segment> Values.\n- Exclude columns listed in the current block's \\`omitColumns\\` by default. A user mention, filter/scope reference, or breakdown/grouping request does not override \\`omitColumns\\`. Exception: include an omitted column only when the user explicitly asks to show, display, or include that exact column.\n- Do not infer additional omissions from repeated values.\n- Include columns explicitly requested by the user only when the key exists in the rendered rows and is business-facing.\n- Include the current breakdown/grouping attribute when the user asks to break down, group, or display by that attribute, it exists in the detail data, and it is useful for distinguishing rendered rows.\n- Do not infer the current breakdown/grouping attribute from a segment value used only to filter or scope the result. A scoped/filter value is not explicitly requested as a display column.\n- Do not include optional columns merely because they are present in the data.\n- Do not remove amount/measure columns only because their values repeat.\n- Do not return an empty columns array when rendered rows exist; include at least one valid business-facing measure/amount or row-distinguishing column.\n\n`;\n\nconst balanceAnalyticViewInstructions = {\n  summaryInstructions: commonAnalyticViewSummaryInstructions+`\nDomain Specific Instructions:\n\nAmount rendering:\n- Currency source: Use ledgerCurrency for accounted amounts and enteredCurrency for entered and non-accounted balance amounts.\n- Balance Statement entered/accounted pairing: when both entered and accounted variants are available for the same base measure and accounting period, render entered as the primary amount and accounted in parentheses as \\`(Accounted: <ledgerCurrency> <accounted amount>)\\`.\n- Variance summary: when \\`varianceAmount\\` is present in a \\`summaryMode: fullAmountEligible\\` balance source row, include it in the summary. When \\`variancePercent\\` is also present and is not \"N/A\", include it with the variance amount.\n  - Use variance fields only from the same summarized source row; do not compute variance from displayed period amounts.\n\nMeasure naming:\n- Convert camelCase to Title Case with spaces.\n- In the headline only, if a measure name contains \\`periodNetBalance\\`, replace that substring with \\`Net Period Activity\\`.\n- In the headline only, if a measure name contains \\`quarterActivity\\`, replace that substring with \\`Quarter Activity\\`.\n- In the headline only, if a measure name contains \\`yearActivity\\`, replace that substring with \\`Year Activity\\`.\n- If a measure name contains \\`beginBalance\\`, replace that substring with \\`Beginning Balance\\`.\n- For entered/accounted pairs, preserve \\`Entered\\` prefix for the \\`entered*\\` measure. Only keep \\`Accounted\\` as the measure name inside the parenthetical accounted amount.\n\nAccounting period:\n- Use time period names from <accounting_periods> exactly as-is. Do not rename, abbreviate, expand, or infer them.\n- If <accounting_periods> is empty, do not invent a time period name.\n\n- If the headline uses a single summary-level row and the detail table shows child values for the same COA segment, include the summary-level segment value in the summary when it differs from the child/detail values and is not a generic all-values member. Child/detail rows do not preserve the parent/summary-level segment scope for the headline.\n- If no row-level block has \\`summaryMode: fullAmountEligible\\`, do not include amounts in the summary.\n\nExamples:\n- 1 measure and 1 accounting period:\n    - \\`<p>Net Period Activity in Mar-26 is USD 725.40 for Company: 7120, Account: 64350</p>\\`\n- entered + accounted balances:\n    - \\`<p>Entered Net Period Activity in Mar-26 is EUR 35,200.00 (Accounted: USD 38,700.00) for Company: 7120, Cost Center: 045, Account: 64350</p>\\`\n- variance with numeric variancePercent:\n    - \\`<p>Ending Balance in Feb-26 is USD 9,600.00 and in Mar-26 is USD 27,100.00, with variance USD 17,500.00 (181.20%) for Company: 2985, Cost Center: 120, Account: 21570</p>\\`\n- variance with \"N/A\" variancePercent:\n    - \\`<p>Ending Balance in Feb-26 is USD 0.00 and in Mar-26 is USD 27,100.00, with variance USD 27,100.00 for Company: 2985, Cost Center: 120, Account: 21570</p>\\`\n- 2 measures and 2 accounting periods:\n    - \\`<p>Beginning Balance in Feb-26 is USD 8,100.00 and in Mar-26 is USD 9,400.00; Ending Balance in Feb-26 is USD 9,600.00 and in Mar-26 is USD 27,100.00, with variance USD 17,500.00 (181.20%) for Company: 2985, Cost Center: 120, Account: 21570</p>\\`\n  `,\n  columnInstructions: commonAnalyticViewColumnInstructions+`\nDomain Specific Instructions:\n\n- Fallback column order for selected columns not present in \\`orderedUserColumns\\`:\n  1.\\`ledger\\`, only when applicable.\n  2. Selected COA segment columns.\n  3. Measure columns.\n  4. Variance columns, only when present in the data.\n\n  - \\`ledger\\` column:\n    - Only include \\`ledger\\` as a column if there is more than one distinct value for \\`ledger\\` in the data.\n    - Otherwise, omit the \\`ledger\\` column.\n\n  - COA segment columns:\n    - Include all COA segment columns that are present in the current row-level markdown headers and not listed in that block's \\`omitColumns\\`.\n\n  - Measure columns:\n    - Include every returned balance measure column from the rendered rows or \\`available_measures_columns\\`. Do not limit table measure columns to \\`headLineMeasures\\`, user-requested measures, or measures shown in a full summary.\n    - Create distinct table columns per returned measure-by-period. For example, if \\`beginBalanceMar26\\`, \\`periodNetBalanceMar26\\`, and \\`endingBalanceMar26\\` are returned, include all three table columns when rendering a table.\n    - If both entered and accounted versions of a measure are returned, include both, even if the user asked only for entered balances.\n    - Sort measure-by-period columns using this order:\n      1. Accounting period in chronological order, earliest on the left.\n      2. Within each period, balance families in this order: Beginning Balance, Period Activity, Quarter Activity, Year Activity, Ending Balance.\n      3. Within the same balance family and period, entered before accounted.\n      4. Within debit/credit variants, Debit before Credit.\n\n  - Variance columns:\n    - Always include \\`varianceAmount\\` when found in data.\n    - Always include the returned variance percentage column, \\`variancePercent\\` or \\`variancePercentage\\`, when either key is found in detail data.\n      - Do not include variance percentage in \\`measureCurrencies\\`.\n      - Place variance percentage immediately after \\`varianceAmount\\`.\n    - Always include \\`movement\\` when found in data.\n      - Place \\`movement\\` immediately after the returned variance percentage column when present; otherwise place it after \\`varianceAmount\\`.\n\n- Note:\n  - Do not select standalone entered currency or ledger currency columns.\n  - Use \\`enteredCurrency\\` and \\`ledgerCurrency\\` only in \\`measureCurrencies\\` for amount formatting.\n\n`\n};\n\nconst journalAnalyticViewInstructions = {\n  summaryInstructions: commonAnalyticViewSummaryInstructions + `\nDomain Specific Instructions:\n- Skip amount/headline summaries when there is no-data or when overall Net Accounted Amount is 0. If no table rows render for that plan, return an empty summary.\n- When multiple ledger-level groups are returned, produce one p block per group when each group has its own summary-level summary.\n- For Journal AV summaries, each rendered row level may produce its own summary group.\n- Produce a full headline only for a row-level block with \\`summaryMode: fullAmountEligible\\`.\n- If homogenousLedgerSetAvData or currentLevelAvData has more than one row for a ledger/logical group, render those summary-level rows in a table. Do not aggregate Net Accounted Amount across those rows for the summary.\n- Use ledgerCurrency for Net Accounted Amount when a single row is summarized.\n- Prefer Net Accounted Amount by default. Use Net Entered Amount in the headline only when the user explicitly asks for entered amount.\n- If the user explicitly asks for Net Entered Amount, use the entered amount and entered currency from the single summary row.\n- Use ledger currency for accounted amounts and entered currency for entered amounts.\n- add extra segments only when the user mentions that segment, member value, or member description.\n- Include journal source or journal category in the headline only when it has exactly one distinct displayed value across the rows used for that headline.\n- For journal variance summaries, when \\`varianceAmount\\` is present in a \\`summaryMode: fullAmountEligible\\` source row, include it in the summary. When \\`variancePercent\\` is also present and is not \"N/A\", include it with the variance amount. Do not compute variance from period amounts.\n- Headline format:\n  - Strictly follow below rules to display headline format depending on datasets available in the tool response.\n  - For Single group:\n    - If homogenousLedgerSetAvData and currentLevelAvData exist:\n      - Display one headline for homogenousLedgerSetAvData only when it has exactly one row\n        - \"For <Ledger set>, <journal source/journal category (display only if single-valued for the headline rows)>, the <Net Accounted Amount/Net Entered Amount> in <Accounting Period> is <ISO Currency> <Amount> for <COA Segments ...>\"\n      - Display one headline for currentLevelAvData only when it has exactly one row\n        - \"For <journal source/journal category (display only if single-valued for the headline rows)>, the <Net Accounted Amount/Net Entered Amount> in <Accounting Period> is <ISO Currency> <Amount> for <COA Segments ...>\"\n    - If either homogenousLedgerSetAvData or currentLevelAvData has exactly one row:\n      - Display one headline for that single summary-level row\n        - \"For <journal source/journal category (display only if single-valued for the headline rows)>, the <Net Accounted Amount/Net Entered Amount> in <Accounting Period> is <ISO Currency> <Amount> for <COA Segments ...>\"\n        - Sample Headlines (Example ONLY):\n          - User question: \"Show net journal activity for travel expenses account and R&D costcenter for journal source Expenses in Jan-26\"\n            - Headline: <p>For Expenses journal source, the Net Accounted Amount in Jan-26 is USD 4,190,000.00 for Company: 9999, Account: 53610, Cost Center: 100</p>\n          - User question: \"Show unposted Journals summary for cheese revenue account in Vision Foods - USA company broken down by journal source in Mar-26\"\n            - Headline: <p>Net Accounted Amount for Unposted journals in Mar-26 is USD 31,300.00 for Company: 3100, Account: 41100</p>\n  - For Multiple groups:\n    - Display one headline per each group.\n      - \"For <Ledger>, <journal source/journal category (display only if single-valued for the headline rows)>, the <Net Accounted Amount/Net Entered Amount> in <Accounting Period> is <ISO Currency> <Amount> for <COA Segments ...>\"\n      - Sample Headlines (Example ONLY):\n        - User question: \"Show net journal activity for trade revenue account for Manual source Expenses in Jan-26\"\n        - Headline:\n          - <p>For Bingo Foods US Ledger, Manual journal source, the Net Accounted Amount in Jan-26 is USD 4,190,000.00 for Company: 9999, Account: 41000</p>\n          - <p>For Bingo Foods AUD Sec Ledger, Manual journal source, the Net Accounted Amount in Jan-26 is AUD 2,910,000.00 for Company: 9999, Account: 41000</p>\n- If only childLevelAvData exists and that block has \\`summaryMode: none\\`, do not include amounts in the summary.\n  `,\n  columnInstructions: commonAnalyticViewColumnInstructions+`\nDomain Specific Instructions:\n- Include Ledger only when the current plan's rendered rows have more than one distinct ledger value, or when the user explicitly asks to display Ledger as a column. Do not include Ledger merely because \\`ledgerSetName\\` exists or the data contains \\`All Ledgers\\`.\n- Journal AV mandatory candidate columns are Journal Source, COA segments, Net Entered Amount, and Net Accounted Amount.\n  - Include Journal Source, Journal Category, Journal Status, or COA segment columns when they are not listed in the current block's \\`omitColumns\\` and they vary across displayed rows.\n  - Exception: if the user explicitly asks to show, display, or include one of these columns and it is listed in \\`omitColumns\\`, include it when that column exists in the current block.\n- Include Net Entered Amount and Net Accounted Amount when returned only when the Journal amount column rule does not require debit/credit replacement for that table plan.\n- For journal variance results, apply the Net Entered Amount, Net Accounted Amount, and debit/credit column rules to returned journal measure columns even when the comparison period is embedded in the returned column key or measure label. Use only returned columns; do not infer missing period columns.\n- For journal variance results, always include \\`varianceAmount\\` when present.\n- Always include the returned variance percentage column, \\`variancePercent\\` or \\`variancePercentage\\`, when present, immediately after \\`varianceAmount\\`.\n- Do not include variance percentage columns in \\`measureCurrencies\\`.\n- Journal amount column rule (STRICT):\n  - Evaluate this rule independently for each table plan using only that plan's row-level markdown data.\n  - If Net Accounted Amount is 0 for at least one rendered row in the plan's row-level data, replace net amount columns with debit/credit columns.\n  - This rule overrides mandatory candidate/default net amount selection.\n  - In that case, do not select netEnteredAmount or netAccountedAmount for that table plan.\n  - Select all returned debit/credit measure columns from this ordered list: \\`enteredDebit\\`, \\`enteredCredit\\`, \\`accountedDebit\\`, \\`accountedCredit\\`.\n  - In the final \\`columns\\` array, place selected debit/credit measure columns after selected context/grouping columns and in exactly this order: \\`enteredDebit\\`, \\`enteredCredit\\`, \\`accountedDebit\\`, \\`accountedCredit\\`.\n  - This debit/credit measure order overrides markdown table header order, \\`available_measures_columns\\` order, and prior displayed measure order.\n  - If this condition is not met, select netEnteredAmount and netAccountedAmount when returned.\n- Do not select \\`enteredDebit\\`, \\`enteredCredit\\`, \\`accountedDebit\\`, or \\`accountedCredit\\` unless the strict debit/credit replacement condition is met or the user explicitly requests those debit/credit columns.\n- Do not select standalone currency or helper fields as columns, including \\`enteredCurrency\\`, \\`currencyCode\\`, \\`ledgerCurrency\\`, \\`ledgerSetName\\`, and \\`accountingDateLevel\\`, unless the user explicitly asks to display that exact attribute as table data.\n- For \\`measureCurrencies\\`, map only selected amount columns to currency fields that exist in the same plan's row-level markdown table headers. Do not invent currency keys. Omit a mapping when the matching currency field is absent or uncertain. Currency fields used for \\`measureCurrencies\\` must not be added to \\`columns\\` unless explicitly requested.\n- Additional columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute.\n`\n};\n\nconst journalBusinessViewDefaultInstructions = {\n  summaryInstructions: `Journal businessView summary instructions:\n  - Return an empty summary for \\`summaryMode: none\\`.\n  - For \\`summaryMode: contextHeadlineEligible\\`, return one context-only headline from <intent_scope_display>.\n  - Do not create amount summaries or aggregate businessView rows.\n  `,\n  columnInstructions: `Journal businessView column selection instructions:\n  - Plan displayed table columns from all rows in the businessView data array.\n  - A journal detail table with rendered rows must include at least one relevant returned measure column when any measure columns are present.\n  - Choose the relevant returned measure set for the request and data shape; do not include every returned measure by default.\n  - Do not select standalone entered currency or ledger currency columns unless the user explicitly asks to display currency as data.\n  - Include every COA segment explicitly mentioned by the user when the corresponding key exists and is not redundant.\n  - If the user asks for account combination, include all returned COA segment member columns when those keys exist.\n  - Include Ledger only when the returned rows contain more than one distinct ledger value.\n  - Additional business view columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute.\n  `\n};\n\nconst journalBusinessViewInstructions = {\n  journalheaderdetail: {\n    summaryInstructions: journalBusinessViewDefaultInstructions.summaryInstructions,\n    columnInstructions:`Journal header detail column selection instructions:\n    - Plan displayed table columns from all returned journal header rows.\n    - After \\`orderedUserColumns\\`, select remaining preferred columns when their keys exist in this order: \\`Journal\\`, \\`Accounting Date\\`, \\`Journal Source\\`, \\`Journal Category\\`, \\`Entered Debit\\`, \\`Entered Credit\\`, \\`Accounted Debit\\`, \\`Accounted Credit\\`, \\`Batch\\`.\n    - Do not select standalone entered currency or ledger currency columns unless the user explicitly asks to display currency as data.\n    - Additional columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute. Place unmentioned additional columns after the preferred columns.\n    `\n  },\n  generalledgerjournaldetail: {\n    summaryInstructions: journalBusinessViewDefaultInstructions.summaryInstructions,\n    columnInstructions:`General ledger journal detail column selection instructions:\n    - Plan displayed table columns from all returned journal detail rows.\n    - After \\`orderedUserColumns\\`, select remaining preferred columns when their keys exist in this order: \\`Journal\\`, \\`Line Description\\`, \\`Accounting Date\\`, \\`Journal Source\\`, \\`Journal Category\\`, returned COA segment columns, \\`Entered Debit\\`, \\`Entered Credit\\`, \\`Accounted Debit\\`, \\`Accounted Credit\\`, \\`Batch\\`.\n    - Include every COA segment explicitly mentioned by the user when the corresponding key exists and is not redundant.\n    - Select segment member value columns, not description columns; the renderer will merge value and description.\n    - Do not select standalone entered currency or ledger currency columns unless the user explicitly asks to display currency as data.\n    - Additional columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute. Place unmentioned additional columns after the preferred columns.\n    `\n  },\n  journalactionlogdetails: {\n    summaryInstructions: journalBusinessViewDefaultInstructions.summaryInstructions,\n    columnInstructions:`Journal action log detail column selection instructions:\n    - Plan displayed table columns from all returned journal action log rows.\n    - After \\`orderedUserColumns\\`, select remaining preferred columns when their keys exist in this order: \\`Batch\\`, \\`Journal Source\\`, \\`Accounting Date\\`, \\`Action Date\\`, \\`Action Code\\`, \\`Entered Debit\\`, \\`Entered Credit\\`, \\`Accounted Debit\\`, \\`Accounted Credit\\`.\n    - Journal transfer/action log results are still financial results. If any debit/credit measure columns are returned, select the returned debit/credit columns from this ordered list: \\`Entered Debit\\`, \\`Entered Credit\\`, \\`Accounted Debit\\`, \\`Accounted Credit\\`.\n    - Do not return a journal action log detail table with rendered rows and only context/action columns when returned measure columns are available.\n    - Additional columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute. Place unmentioned additional columns after the preferred columns.\n    `\n  }\n};\n\nconst subledgerAnalyticViewInstructions = {\n  summaryInstructions: commonAnalyticViewSummaryInstructions + `\nDomain specific instructions:\n- Use Net Accounted Amount by default for the headline.\n- Use Net Entered Amount in the headline only when the user explicitly asks for entered amount.\n- Accounted amounts use ledger currency. Entered amounts use entered currency.\n- Treat the returned Subledger AV data as already scoped to the subledger transaction type/domain in the user request.\n- Subledger source/domain terms in the user request, such as Payables, Receivables, invoices, payments, receipts, transactions, or journals, are not row-level grouping dimension values for display planning.\n- Do not use source/domain terms to filter currentLevelAvData by accountingClass or any other returned dimension.\n- For Subledger AV summaries, use homogenousLedgerSetAvData or currentLevelAvData measures only when that summary-level block has \\`summaryMode: fullAmountEligible\\`.\n- If homogenousLedgerSetAvData or currentLevelAvData has more than one row for a ledger/logical group, render those summary-level rows in a table. Do not aggregate Net Accounted Amount across those rows for the summary.\n- Do not decide which currentLevelAvData rows are relevant based on values in row-level grouping dimensions.\n- Only restrict the headline to a grouping dimension value when the user explicitly names a returned column and value, for example \"Accounting Class Receivable\" or \"by accounting class\".\n- When summarizing a single currentLevelAvData row, use the signed values exactly as returned. Do not use absolute values, debit-side values, or credit-side values unless the user explicitly asks for gross activity.\n- Do not create gross/absolute totals from multiple summary-level rows.\n- If only childLevelAvData exists, summarize it only when that block has \\`summaryMode: fullAmountEligible\\`.\n- If only childLevelAvData exists and that block has \\`summaryMode: none\\`, do not include amounts in the summary.\n- Example: \\`\"<Net Accounted Amount/Net Entered Amount> in <Accounting Period> is <Currency> <Amount> for <Segment Label>: <value>, <Segment Label>: <value>.\"\\`\n  `,\n  columnInstructions: commonAnalyticViewColumnInstructions+ `\nDomain specific instructions:\n- Subledger AV table rows come from each rendered row level: homogenousLedgerSetAvData or currentLevelAvData when there is more than one summary-level row, and childLevelAvData when child/detail rows are rendered. Keep row levels separate when the planner supports multiple tables.\n- Mandatory content candidates are Supplier or Customer, Net Entered Amount, Net Accounted Amount, non-repeating qualified COA segments, and user-requested non-COA dimensions.\n- Include Supplier, Customer, Business Unit, Legal Entity, or similar scoped attributes when they are not listed in the current block's \\`omitColumns\\` and they vary across displayed rows.\n- Exception: if the user explicitly asks to show, display, or include one of these scoped attributes and it is listed in \\`omitColumns\\`, include it when that column exists in the current block.\n- For Subledger AV tables, always select both netUnroundedEnteredAmount and netUnroundedAccountedAmount when both are returned, in that order, unless debit/credit columns are required by the debit/credit rules.\n- Map netUnroundedEnteredAmount to enteredCurrency when present, otherwise currencyCode. Map netUnroundedAccountedAmount to ledgerCurrency.\n  - Use enteredCurrency, currencyCode, and ledgerCurrency only for measureCurrencies and amount formatting. Never include currencyCode, ledgerCurrency, enteredCurrency, or ledgerCurrencyCode as standalone columns unless the user explicitly asks to display currency as data.\n- Never include entered amount without the matching accounted amount when both are available.\n- Include Entered Debit, Entered Credit, Accounted Debit, and Accounted Credit only when explicitly requested, entered currency context must be preserved, multiple entered currencies exist, or entered currency differs from ledger currency.\n- Include fiscalDate only when it has multiple values across displayed rows.\n- Include Ledger only when multiple ledger values are present or when the rendered summary-level rows require ledger context.\n- If top N or first N is explicitly requested, keep only the first N rows from the already sorted tool result; do not re-sort.\n  `\n};\n\nconst subledgerBusinessViewInstructions = {\n  summaryInstructions: `Subledger businessView summary instructions:\n  - Return an empty summary for \\`summaryMode: none\\`.\n  - For \\`summaryMode: contextHeadlineEligible\\`, return one context-only headline from <intent_scope_display>.\n  - Do not create amount summaries or aggregate businessView rows.\n  - Do not add analysis, explanations, rankings, or contribution language.\n  `,\n  columnInstructions:`Subledger businessView column selection instructions:\n  - Plan displayed table columns from all rows in the businessView data array.\n  - Include user-scoped attributes such as supplier, customer, legal entity, and business unit only when they vary across displayed rows or are explicitly requested.\n  - Include Net Entered Amount and Net Accounted Amount, or Entered/Accounted Debit/Credit pairs, when returned and relevant to the user request.\n  - Never include EnteredCurrency, LedgerCurrency, ledgerCurrencyCode, or similar currency context fields as standalone columns unless explicitly requested.\n  - Do not select Accounting Entry Status unless the user explicitly asks for accounting status or entry status.\n  - Do not select Accounting Class Code unless explicitly requested.\n  - Preserve relevant COA segment columns from the prior display unless the user asks to remove them; add segment columns when used for the current breakdown or explicitly mentioned by value/description.\n  - Additional columns should be selected only when explicitly requested or when they are the current breakdown/grouping attribute.\n  `\n};\n\n\nconst presentationDisplayInstructions = {\n    summaryInstructions: `Do not produce summary. Return empty string. no \\`<p></p>\\`.`,\n    columnInstructions: `- This is a presentation-only display change over the current result. Do not change data scope, grouping, filtering, sorting, aggregation, periods, ledgers, accounts, or member selections.\n- Preserve existing displayed columns unless the user explicitly asks to add, show, include, hide, remove, exclude, or stop showing columns.\n- For presentation-only display changes, the current display state is authoritative for column availability. \\`previous_display_state.available\\` and each matching \\`previous_display_state.tables[*].available\\` array may be used as selectable column sources even when a requested column is not present in the current markdown table headers.\n- Always return the table plan schema with a top-level \\`tables\\` array. A single-table result must be represented as exactly one table plan.\n- When \\`previous_display_state.tables\\` is available, preserve and modify columns independently per row level:\n  - The \\`summary\\` table plan starts from the previous \\`summary\\` table's displayed columns.\n  - The \\`child\\` table plan starts from the previous \\`child\\` table's displayed columns.\n  - The \\`detail\\` table plan starts from the previous \\`detail\\` table's displayed columns.\n  - Each row-level table plan preserves that previous table's \\`rowsToExclude\\` for column-only requests.\n  - Do not merge summary and child displayed columns into one plan.\n  - Do not use a column from one row level as evidence that it is available in the other row level.\n  - Return table plans only for row levels present in \\`previous_display_state.tables\\` unless the user explicitly asks to add another row level.\n- When only legacy \\`previous_display_state.displayed\\` and \\`previous_display_state.available\\` are available, use them as the current columns and availability for the single current display-contributing row-level block. Do not create another row-level plan from legacy previous state.\n- For presentation-only display changes, \\`previous_display_state.available\\` and each \\`previous_display_state.tables[*].available\\` array are valid selectable column sources for the matching row level.\n- Do not select a column from one row level's \\`available\\` array for a different row-level plan.\n- If a requested column exists in both summary and child table availability and the user does not specify a row level, apply the add/remove request to both table plans.\n- Column add/remove/show/hide requests must not change row visibility. Preserve \\`rowsToExclude\\` exactly for every affected row-level table unless the user explicitly asks to change visible rows.\n- Preserve non-targeted row-level table plans exactly, including their displayed columns and \\`rowsToExclude\\`.\n- If the user refers to headline, summary, rollup, total, subtotal, or current-level rows, apply the request only to the summary table plan.\n- If the result is a businessView detail table, use the \\`detail\\` table plan.\n- If the result is an analyticView and the user refers to child, detail, or detail rows, apply the request only to the child table plan.\n- Row-visibility requests may change \\`rowsToExclude\\` and columns only for the explicitly targeted row level. Do not modify columns or \\`rowsToExclude\\` for other row-level table plans.\n- If a new COA segment column is requested, append the segment key, not the label, to the affected row level's current columns list when it is valid for that row level.\n- If hiding/removing a non-required column is requested, omit it only from affected row level plans where it is displayed.\n- If the user asks to show all columns, show all available business-facing columns for each affected row level.\n- If the user asks to show all rows, display all rows, show the full table, expand the table, or show the complete current table, return an empty \\`rowsToExclude\\` array for each affected row level.\n- If the user asks to show the current result as a table, show the table, render it as a table, use table view, or switch back to table view, preserve the currently displayed columns unless the user also asks for a column change, and return an empty \\`rowsToExclude\\` array for each affected row level.\n- If the user asks to show the headline, summary, total, subtotal, rollup, or current-level row as part of the table, in the table, or along with table rows, return an empty \\`rowsToExclude\\` array for the summary row-level plan. You may adjust only the summary plan's columns if needed to render a useful summary table. Preserve all child/detail plans exactly unless the user explicitly asks to change them.\n- An empty summary does not represent any row. Do not exclude rows as rolled up or represented by summary text in presentation-only mode.\n- Do not select \\`rowIndex\\`, technical/helper keys, internal IDs, query keys, metadata keys, hidden level fields, or tree filter fields as display columns.\n- Keep required measure and currency formatting behavior intact. Do not select standalone currency or sign fields unless explicitly requested as table data.\n- Return a second table plan only when a second row-level block contributes display content or table-aware previous display state requires preserving that row-level plan.`\n}\n\nconst businessViewColumnRule = viewType === \"businessView\"\n  ? `22. For businessView results, return \\`rowsToExclude\\` as an empty array.`\n  : \"\";\n\nconst summarySourceRule = viewType === \"businessView\"\n  ? \"6. For businessView results, use <intent_scope_display> only when the block has `summaryMode: contextHeadlineEligible`; otherwise return an empty summary string.\"\n  : \"6. Use concise business language based only on values present in the block with `summaryMode: fullAmountEligible` or resolved display values from <intent_scope_display> when the block has `summaryMode: contextHeadlineEligible`.\";\n\nconst regularColumnSourceAuthorityInstructions = `1. For each plan, select table columns only from the markdown table headers in that plan's row-level data.\n2. \\`segment_labels\\` maps raw column keys to display labels. Use it only to understand user-facing names. Do not return mapped label values in \\`columns\\`; return only exact raw column keys from the markdown table headers.\n3. Do not infer or add COA segment columns that are absent from the markdown table headers.\n4. Exception: if the user explicitly asks to display, show, or include a specific COA segment as a column, you may select that segment key when it is listed in \\`segment_labels\\` and present in the markdown table headers for that plan's row-level data.\n5. Before returning, remove duplicate column keys.`;\n\nconst presentationColumnSourceAuthorityInstructions = `1. For each presentation-only table plan, select table columns from either the markdown table headers in that plan's row-level data or the matching current display-state availability source.\n2. \\`previous_display_state.available\\` is the matching availability source for a single-table plan. Each \\`previous_display_state.tables[*].available\\` array is the matching availability source only for that table entry's row level.\n3. For explicit add/show/include requests in presentation-only mode, a requested column is selectable when it appears in that plan's markdown table headers or in the matching current display-state availability source, even when it is absent from the markdown table headers.\n4. \\`segment_labels\\` maps raw COA segment keys to display labels. Use it to understand user-facing segment names, including natural-language variants such as spaces versus underscores. Return only raw segment keys in \\`columns\\`, not mapped labels.\n5. If the user explicitly asks to display, show, or include a COA segment as a column, select the raw segment key when it is listed in \\`segment_labels\\` and is selectable under the presentation-only source rules.\n6. Do not infer or add COA segment columns that are absent from both the markdown table headers and the matching current display-state availability source.\n7. Before returning, remove duplicate column keys.`;\n\nconst buildSummarySectionPrompt = (viewSummaryInstructions) => `\n1. Return summary as a single-line HTML string.\n2. When the summary is non-empty, use only one or more \\`<p>...</p>\\` blocks.\n3. Do not use attributes, CSS, markdown, lists, bold, or extra tags.\n4. Do not add analysis, commentary, trends, explanations, rankings, contribution language, or recommendations.\n5. Do not mention implementation concepts such as table, rows, dataset, payload, filters, selected columns, current level, child level, or rollup.\n${summarySourceRule}\n7. If a block has \\`summaryMode: fullAmountEligible\\`, create a full amount/headline summary from that block's single source row and exclude that row's \\`rowIndex\\`.\n8. If a block has \\`summaryMode: contextHeadlineEligible\\`, create one context-only headline that answers what result the table contains, do not mention amounts, and return \\`rowsToExclude: []\\`.\n9. If a block has \\`summaryMode: none\\`, return an empty summary and do not exclude rows for summary reasons.\n10. Do not create summaries from \\`intent_scope\\`, \\`omitColumns\\`, repeated values, raw user text, or rendered multi-row block values.\n11. Use \\`intent_scope\\` only as context explaining user-scoped values and why columns may appear in \\`omitColumns\\`. Use <intent_scope_display> only for \\`summaryMode: contextHeadlineEligible\\`.\n12. For context-only headlines, preserve the requested result type, measure, threshold, comparison, or entity from the direct User request, but replace user-provided aliases/codes with resolved display values from <intent_scope_display>. When the direct User request is incomplete, modifier-only, or solely requests a grouping or breakdown, use the Query-generation re-phrased question for this result only to recover the requested result type, measure, threshold, comparison, or relevant timeframe. It is query input, not a response or result data; do not use it to supply display values, fields, filters, columns, or grouping language. Do not include every value from <intent_scope_display> by default; include only resolved context that the user referenced, that is necessary to answer the requested result, or that disambiguates the result. Omit default/background scope such as Ledger when the user did not ask for it and the result is not cross-ledger or ledger-specific. Include relevant timeframe. Use segment labels from \\`segment_labels\\` for COA dimensions, omit generic all-values hierarchy/tree scopes unless they are the only meaningful scope, and keep the headline short.\n13. Do not repeat or paraphrase a requested grouping or breakdown in a context-only headline. Grouping and breakdown requests determine how results are displayed, not the result the headline describes. Include a dimension only when its resolved member/value is necessary query scope or entity context, not merely the attribute used to organize rows.\n14. Do not aggregate, total, or summarize amounts across multiple rendered rows.\n15. Use segment labels from \\`segment_labels\\` instead of segment code names when labels are needed.\n16. In summaries, render COA/member context as \\`<Segment Label>: <value>\\`.\n17. Treat currency fields as formatting context, not business context to mention by themselves.\n18. Treat sign fields as hidden/internal metadata only. Do not mention sign fields and do not append Dr or Cr to any amount.\n19. When currency is available, render every monetary amount in a headline or summary sentence as \\`<ISO code> <amount with thousands separators and exactly two decimal places>\\`, with exactly one space between the ISO code and amount. Never render the ISO code after the amount. If currency is unavailable, render the amount without a currency code. Preserve negative signs after the ISO code, for example \\`USD -20,000.00\\`, and never compact amounts with K/M/B/T. Apply this rule independently to every primary, comparison, variance, and parenthetical amount.\n20. Render percentages as \\`\"<decimal>%\"\\`.\n\nView specific instructions:\n${viewSummaryInstructions}`;\n\nconst buildColumnSectionPrompt = (viewColumnInstructions) => `\n1. Do not select \\`rowIndex\\`.\n2. Select columns only from the markdown table headers in the same data block.\n3. Exclude columns listed in that block's \\`omitColumns\\` by default. A user mention, filter/scope reference, or breakdown/grouping request does not override \\`omitColumns\\`.\n4. Do not use \\`intent_scope\\` to omit additional columns. \\`intent_scope\\` only explains why columns may appear in \\`omitColumns\\`.\n5. Do not omit a column merely because its values repeat.\n6. Exception: if the user explicitly asks to show, display, or include an exact column listed in \\`omitColumns\\`, include it only when it exists in a valid column source for that plan and is otherwise valid. Include it in \\`orderedUserColumns\\` only when it is selected and qualifies under the user-column ordering contract.\n7. Start from currently displayed columns when they are still valid, not listed in \\`omitColumns\\`, and the user did not ask to remove them.\n8. Apply view-specific required-column rules.\n9. If the user asks to remove a view-specific required measure or required displayed column, keep it unless it is listed in \\`omitColumns\\` and was not explicitly requested.\n10. If the user asks to remove a non-required displayed column, remove it.\n11. Add columns explicitly requested by the user only when the key exists in the data.\n12. Do not include optional columns unless the user requested them or the column instructions require them.\n13. Do not remove amount/measure columns only because values repeat.\n14. Treat currency fields as hidden formatting context, not display columns, unless the user explicitly asks to show currency as data.\n15. Do not select sign fields such as fields ending in \\`Sign\\` as standalone display columns. They are hidden/internal metadata only.\n16. For COA/member columns that have a matching description field, select the member value column, not the description column.\n17. Do not include technical/helper keys unless they are explicitly business-facing and requested.\n18. For result planning, place \\`orderedUserColumns\\` first, then apply the view-specific default/preferred ordering to the remaining selected columns. When no view-specific order applies, use current row-level markdown-header/tool order. Keep measures and variance fields in the view-specific required order.\n19. View-specific default/preferred column order applies only to selected columns not already present in \\`orderedUserColumns\\`. User ordering does not change measure-family, period, entered/accounted, debit/credit, or variance ordering.\n20. For presentation-only planning, preserve the existing displayed-column order unless the user explicitly requests a positional change.\n21. Do not return an empty \\`columns\\` array when detail rows exist; include at least one valid measure or business-facing column.\n${businessViewColumnRule}\n\nView specific column instructions:\n${viewColumnInstructions}`;\n\n\nlet domainMetadata = new Object();\nif(isPresentationPath){\n    domainMetadata = {\n        ora_fin_gl_balance_inquiry_and_analysis_assistant: {\n            analyticView: presentationDisplayInstructions,\n            businessView: presentationDisplayInstructions\n        },\n        ora_fin_gl_journals_assistant: {\n            analyticView: presentationDisplayInstructions,\n            businessView: presentationDisplayInstructions\n        },\n        ora_fin_gl_subledger_supporting_details_assistant: {\n            analyticView: presentationDisplayInstructions,\n            businessView: presentationDisplayInstructions\n        }\n    };\n}\nelse{\n    domainMetadata = {\n      ora_fin_gl_balance_inquiry_and_analysis_assistant: {\n          analyticView: balanceAnalyticViewInstructions,\n          businessView: balanceAnalyticViewInstructions\n      },\n      ora_fin_gl_journals_assistant: {\n          analyticView: journalAnalyticViewInstructions,\n          businessView: findBusinessViewInstructions(journalBusinessViewInstructions, journalBusinessViewDefaultInstructions)\n      },\n      ora_fin_gl_subledger_supporting_details_assistant: {\n          analyticView: subledgerAnalyticViewInstructions,\n          businessView: subledgerBusinessViewInstructions\n      }\n    };\n}\n\nconst selectedViewInstructions = domainMetadata[currentDomain]?.[viewType];\nlet result = emptyMetadata;\n\nif (selectedViewInstructions) {\n  if (isPresentationPath) {\n    result = {\n      accountingPeriods,\n      ...selectedViewInstructions,\n      columnSourceAuthorityInstructions: presentationColumnSourceAuthorityInstructions,\n      displayPlanningMode: \"presentationOnly\"\n    };\n  }\n  else {\n    result = {\n      accountingPeriods,\n      summaryInstructions: buildSummarySectionPrompt(selectedViewInstructions.summaryInstructions),\n      columnInstructions: buildColumnSectionPrompt(selectedViewInstructions.columnInstructions),\n      columnSourceAuthorityInstructions: regularColumnSourceAuthorityInstructions,\n      displayPlanningMode: \"resultPlanning\"\n    };\n  }\n}\n\nreturn result;"
          },
          "outcomes": {
