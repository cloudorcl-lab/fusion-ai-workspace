          "metadata": {
            "errorNodeId": "1777160083692",
            "name": "Init Additional Context",
            "returnType": "object",
            "sourceCode": "// Helpers\n\nconst isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\nconst hasOwn = (object, key) => object && typeof object === \"object\" && Object.prototype.hasOwnProperty.call(object, key);\n\n\nconst parseMaybeJsonObject = (value) => {\n  if (isRecordObject(value)) {\n    return value;\n  }\n\n  if (typeof value === \"string\") {\n    const trimmed = value.trim();\n    if (!trimmed) {\n      return {};\n    }\n\n    try {\n      const parsed = JSON.parse(trimmed);\n      return isRecordObject(parsed) ? parsed : {};\n    } catch (error) {\n      return {};\n    }\n  }\n\n  return {};\n};\n\n\nconst normalizeState = (state) => {\n\n  const defaultState = {\n    lastUsedAgent: [],\n    domains: {\n      ora_fin_gl_journals_assistant: {},\n      ora_fin_gl_balance_inquiry_and_analysis_assistant: {},\n      ora_fin_gl_financial_reporting_assistant: {},\n      ora_fin_gl_subledger_supporting_details_assistant: {},\n      ora_fin_gl_general_ledger_functions_assistant: {},\n      ora_fin_fun_insights_assistant: {},\n      ora_fin_gl_process_exceptions_assistant: {},\n      ora_fin_gl_export_to_excel_assistant: {},\n      ora_fin_gl_hierarchy_manager_assistant: {},\n      ora_fin_gl_help_topic_assistant: {}\n    },\n    shared: {}\n  };\n\n  const sourceState = isRecordObject(state) ? state : {};\n\n  return {\n    lastUsedAgent: Array.isArray(sourceState.lastUsedAgent) ? sourceState.lastUsedAgent : [],\n    domains: {\n      ...defaultState.domains,\n      ...(isRecordObject(sourceState.domains) ? sourceState.domains : {})\n    },\n    shared: isRecordObject(sourceState.shared) ? sourceState.shared : {}\n  };\n};\n\n// Initialization\n\nconst triggerInput = $context.$triggers.REST.$input || {};\n\nconst triggerParameters =\n  triggerInput.parameters && typeof triggerInput.parameters === \"object\" && !Array.isArray(triggerInput.parameters)\n    ? triggerInput.parameters\n    : {};\n\nconst rawInputContext =\n  triggerInput.additional_context ||\n  triggerInput.additionalContext ||\n  triggerParameters.additional_context ||\n  triggerParameters.additionalContext ||\n  {};\n\nconst inputContext = parseMaybeJsonObject(rawInputContext);\n\nconst isFromAgenticCall = Boolean(\n  hasOwn(triggerInput, \"_parentWorkflowCode\") ||\n  hasOwn(triggerParameters, \"_parentWorkflowCode\") ||\n  hasOwn(inputContext, \"_parentWorkflowCode\") ||\n  hasOwn(inputContext, \"handoffChatHistory\") ||\n  hasOwn(inputContext, \"state\") ||\n  hasOwn(inputContext, \"compactedChatHistory\") ||\n  hasOwn(inputContext, \"ledgerAgentState\") ||\n  hasOwn(inputContext, \"previousLedgerState\")\n);\n\nconst additionalContext = inputContext && typeof inputContext === \"object\" && !Array.isArray(inputContext)? { ...inputContext } : {};\n\nconst existingCompactHistory= Array.isArray($context.$variables.compactedChatHistory)? $context.$variables.compactedChatHistory : [];\n\nlet compactHistory = existingCompactHistory;\n\nif (existingCompactHistory.length === 0 && Array.isArray(inputContext.handoffChatHistory)) {\n  compactHistory = [];\n\n  for (const entry of inputContext.handoffChatHistory) {\n    if (entry && typeof entry === \"object\" && !Array.isArray(entry)) {\n      const role = String(entry.role || \"\").trim().toUpperCase();\n      let normalizedRole = \"\";\n\n      if (role === \"USER\" || role === \"HUMAN\") {\n        normalizedRole = \"USER\";\n      }\n\n      if (role === \"AI\" || role === \"ASSISTANT\") {\n        normalizedRole = \"AI\";\n      }\n\n      let text = \"\";\n\n      if (normalizedRole === \"AI\" && typeof entry.text !== \"string\") {\n        try {\n          text = JSON.stringify(entry.text);\n        } catch (error) {\n          text = \"{}\";\n        }\n      } else {\n        text = String(entry.text || \"\").trim();\n      }\n\n      if (normalizedRole && text) {\n        compactHistory.push({\n          role: normalizedRole,\n          text\n        });\n      }\n    }\n  }\n} else if (existingCompactHistory.length === 0 && typeof inputContext.handoffChatHistory === \"string\") {\n  const handoffText = inputContext.handoffChatHistory.trim();\n\n  if (handoffText) {\n    compactHistory = [\n      {\n        role: \"USER\",\n        text: handoffText\n      }\n    ];\n  }\n}\n\nconst incomingState = parseMaybeJsonObject(inputContext?.state);\nconst effectiveState = normalizeState(\n  Object.keys(incomingState).length > 0 ? incomingState : $context.$variables?.state\n);\n\nconst stateHierarchy = effectiveState?.shared?.hierarchy || {};\nif (Array.isArray(stateHierarchy.hierarchyOverrides) && stateHierarchy.hierarchyOverrides.length > 0) {\n  additionalContext.hierarchyOverrides = stateHierarchy.hierarchyOverrides;\n}\n\nconst ledgerOverride = $context.$variables.ledgerOverride;\n\nif (\n  ledgerOverride &&\n  typeof ledgerOverride === \"object\" &&\n  !Array.isArray(ledgerOverride) &&\n  Object.keys(ledgerOverride).length > 0\n) {\n  additionalContext.ledgerId = ledgerOverride.ledgerId;\n  additionalContext.ledgerContext = ledgerOverride.ledgerName || ledgerOverride.ledgerContext;\n  additionalContext.ledgerCategory = ledgerOverride.ledgerCategory;\n  additionalContext.chartOfAccountsId = ledgerOverride.chartOfAccountsId;\n  additionalContext.analyticView = ledgerOverride.avName || ledgerOverride.analyticView;\n}\n\nadditionalContext.groupColumnsData = false;\n\ndelete additionalContext.selectedHierarchies;\ndelete additionalContext.handoffChatHistory;\ndelete additionalContext.state;\ndelete additionalContext._parentWorkflowCode;\ndelete additionalContext.compactedChatHistory;\ndelete additionalContext.ledgerAgentState;\ndelete additionalContext.previousLedgerState;\n\nconst returnObj = {\n  additionalContext,\n  compactHistory,\n  effectiveMessage: $context.$system.$inputMessage || \"\",\n  state: effectiveState,\n  isFromAgenticCall\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "1778654604493"
          },
          "code": "INIT_ADDITIONAL_CONTEXT",
          "id": "1778654417391",
