            "name": "Prepare Parent Handoff State",
            "returnType": "object",
            "sourceCode": "const isRecordObject = (value) => value && typeof value === \"object\" && !Array.isArray(value);\n\nconst cloneValue = (value) => {\n    if (value === undefined) {\n        return undefined;\n    }\n\n    try {\n        return JSON.parse(JSON.stringify(value));\n    } catch (error) {\n        return value;\n    }\n};\n\nconst state = isRecordObject($context.$variables.state) ? $context.$variables.state : {};\nconst lastUsedAgent = Array.isArray(state.lastUsedAgent) ? [...state.lastUsedAgent] : [];\nconst domains = isRecordObject(state.domains) ? state.domains : {};\nconst exportEnabledAgents = new Set([\n    \"ora_fin_gl_journals_assistant\",\n    \"ora_fin_gl_balance_inquiry_and_analysis_assistant\",\n    \"ora_fin_gl_subledger_supporting_details_assistant\",\n    \"ora_fin_gl_process_exceptions_assistant\"\n]);\n\nconst findLatestExportAgent = (agentHistory) => {\n    for (let index = agentHistory.length - 1; index >= 0; index -= 1) {\n        const agent = agentHistory[index];\n        if (exportEnabledAgents.has(agent)) {\n            return agent;\n        }\n    }\n\n    return \"\";\n};\n\nconst compactDataResponse = (dataResponse) => {\n    if (!isRecordObject(dataResponse)) {\n        return undefined;\n    }\n\n    const compactResponse = {};\n    const avExtractResult = isRecordObject(dataResponse.avExtractResult) ? dataResponse.avExtractResult : {};\n    const avMetadata = isRecordObject(avExtractResult.metadata) ? avExtractResult.metadata : undefined;\n\n    if (avMetadata) {\n        compactResponse.avExtractResult = {\n            metadata: cloneValue(avMetadata)\n        };\n    }\n\n    if (isRecordObject(dataResponse.metaData)) {\n        compactResponse.metaData = cloneValue(dataResponse.metaData);\n    }\n\n    return Object.keys(compactResponse).length > 0 ? compactResponse : undefined;\n};\n\nconst compactDomainState = (domainState) => {\n    if (!isRecordObject(domainState)) {\n        return {};\n    }\n\n    const result = {};\n\n    if (isRecordObject(domainState.lastUsedQuery)) {\n        result.lastUsedQuery = cloneValue(domainState.lastUsedQuery);\n    }\n\n    const lastUsedData = isRecordObject(domainState.lastUsedData) ? domainState.lastUsedData : {};\n    const compactLastUsedData = {};\n\n    if (lastUsedData.dataPayload !== undefined) {\n        compactLastUsedData.dataPayload = cloneValue(lastUsedData.dataPayload);\n    }\n\n    const compactResponse = compactDataResponse(lastUsedData.dataResponse);\n    if (compactResponse !== undefined) {\n        compactLastUsedData.dataResponse = compactResponse;\n    }\n\n    if (Object.keys(compactLastUsedData).length > 0) {\n        result.lastUsedData = compactLastUsedData;\n    }\n\n    return result;\n};\n\nconst latestExportAgent = findLatestExportAgent(lastUsedAgent);\nconst compactDomains = {};\n\nif (latestExportAgent) {\n    compactDomains[latestExportAgent] = compactDomainState(domains[latestExportAgent]);\n}\n\nconst result = {\n    lastUsedAgent,\n    domains: compactDomains,\n    shared: isRecordObject(state.shared) ? cloneValue(state.shared) : {}\n};\n\nreturn result;\n"
