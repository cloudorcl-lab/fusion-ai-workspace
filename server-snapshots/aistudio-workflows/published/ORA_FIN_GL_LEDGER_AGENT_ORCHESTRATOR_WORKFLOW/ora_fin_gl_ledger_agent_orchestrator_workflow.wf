            "sourceCode": "const defaultErrorMessage = \"We couldn't complete your request right now. Please try again later.\";\nconst summarizationResult = $context?.$nodes?.SUMMARIZATION_PRE_PROCESSOR?.$output?.result || {};\nconst errorMessage = summarizationResult?.errorMessage || defaultErrorMessage;\n\nconst schema = {\n          \"agent\": summarizationResult?.agentName || $context?.$variables?.routingDecision,\n          \"intent\": \"Error\",\n          \"schema_version\": 1,\n          \"title\": \"Error\",\n          \"description\": \"Error\",\n          \"timestamp\": \"\",\n          \"topicName\": \"Error\",\n          \"category\": summarizationResult?.category || \"Error\",\n          \"agent_response\": [{\"display_type\": \"text\",\"display_sequence\": 1,\"text\": errorMessage}]\n};\n\nreturn schema;"
