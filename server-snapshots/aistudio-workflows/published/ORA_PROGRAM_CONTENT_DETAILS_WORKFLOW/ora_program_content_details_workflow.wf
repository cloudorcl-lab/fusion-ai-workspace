        {
          "metadata": {
            "name": "Retrieve Product Name and Content Type",
            "returnType": "object",
            "sourceCode": "let appInput = $context.$triggers.REST.$input.OraAppContext;\n\nif (!appInput) {\n  appInput = $context.$variables.appContext;\n}\n\nlet data = {};\n\n// Decode URL-encoded input FIRST\nif (typeof appInput === \"string\") {\n  appInput = decodeURIComponent(appInput);\n}\n\n// If input is JSON, parse it\nif (appInput.trim().startsWith(\"{\")) {\n  data = JSON.parse(appInput);\n} \n// Else parse key=value format\nelse {\n  const pairs = appInput.split(',');\n  data = pairs.reduce((acc, pair) => {\n    const [key, value] = pair.split('=');\n    if (key && value) acc[key.trim()] = value.trim();\n    return acc;\n  }, {});\n}\n\n// Validate and build response\nif (data.targetProductName || data.contentContext) {\n  const response = {\n    targetProductName: decodeURIComponent(\n      data.targetProductName.replace(/\\+/g, \" \")\n    ),\n    contentContext: data.contentContext.trim()\n  };\n\n  return JSON.stringify(response);\n}\n\nreturn {};"
          },
          "outcomes": {
            "success": "1769723561603"
          },
          "code": "RETRIEVE_PRODUCT_NAME_AND_CONTENT_TYPE",
          "id": "1769723397290",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
