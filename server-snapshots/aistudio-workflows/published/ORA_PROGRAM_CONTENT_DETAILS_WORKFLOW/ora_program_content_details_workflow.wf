        {
          "metadata": {
            "name": "Generate Summary"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GENERATE_SUMMARY",
          "id": "1769730230216",
          "inputs": [
            {
              "id": "1769730230217_1",
              "name": "prompt",
              "type": "string",
              "value": "<summary_instructions>\n  <purpose>\n    Generate a professional summary highlighting positive customer feedback for {{$context.$variables.targetProductName}}.\n  </purpose>\n\n  <input>\n    Use {{$context.$nodes.RETURN_CONTENTS.$output.result}} \n  </input>\n\n  <output_format>\n    <title>\n      - One line summarizing encouraging customer feedback\n      - Include the specific industry and region (e.g., \"Healthcare Leaders in North America\")\n      - Format as a markdown heading: # Title Here\n    </title>\n    \n    <body>\n      - 2-3 sentences as a single paragraph\n      - Include specific examples of customer benefits\n      - Focus on measurable outcomes: improvements, efficiencies, ROI, time savings\n      - Reference the industry and region context\n    </body>\n  </output_format>\n\n  <formatting_rules>\n    - Use standard markdown (# for title)\n    - Output raw markdown only—no code block wrappers\n    - No additional commentary or preamble\n    - Title and body separated by a single blank line\n  </formatting_rules>\n\n  <example>\n    Output:\n    # European Financial Services Firms Report Strong Results with ProductName\n\n    Major banks across Europe have seen significant improvements after adopting ProductName, with Deutsche Financial reducing processing time by 40% and Nordic Trust cutting operational costs by €2.1M annually. Customers consistently cite the platform's automation capabilities and compliance features as key drivers of their efficiency gains.\n  </example>\n</summary_instructions>"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Return Contents",
            "returnType": "array",
            "sourceCode": "const items =  $context.$nodes.GET_ARTICLES.$output.items || [];\n\nconst contentBodies = items\n  .filter(row => row && row.contentBody)\n  .map(row => row.contentBody);\n\nreturn JSON.stringify(contentBodies);\n"
          },
          "outcomes": {
            "success": "1769726583092"
          },
          "code": "RETURN_CONTENTS",
          "id": "1769732338045",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
