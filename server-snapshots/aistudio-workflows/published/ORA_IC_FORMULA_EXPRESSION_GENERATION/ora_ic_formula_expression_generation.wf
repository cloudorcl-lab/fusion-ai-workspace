{
  "workflowId": "300000331067434",
  "workflowCode": "ORA_IC_FORMULA_EXPRESSION_GENERATION",
  "name": "Incentive Formula Expression Generation",
  "description": "Generates expressions to be used in Incentive Compensation formula.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Start of data pipeline",
            "name": "Start"
          },
          "outcomes": {
