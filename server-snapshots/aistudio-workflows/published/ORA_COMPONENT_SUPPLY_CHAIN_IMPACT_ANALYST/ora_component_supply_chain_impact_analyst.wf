        {
          "metadata": {
            "name": "Component Supply Chain Impact Analysis Report"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "Component_Supply_Chain_Impact_Analysis_Report",
          "id": "1766627082504",
          "inputs": [
            {
              "id": "1766627082506_1",
              "name": "prompt",
              "type": "string",
              "value": "Printing Rules\n      Add blank line at the end of the report\n      Print Table header, column header and summary header in bold\n      Use Times font\n     DONOT print Report in the heading\n     DONOT wrap table header and make it left aligned\n     Print border for table column header and data rows\n     DONOT print border for table header\n     Print the Quantity, Price, and Amount values right-aligned in their respective columns.\n     If no records found, print No Records found in the table\n\nPrint \"Component Replacement Summary for \" not in bold + \"Trading Partner Number: \" in bold +  {{$context.$triggers.REST.$input.MPNItemNumber}}  in bold RED + \"from Change Request: \" in bold  + {{$context.$triggers.REST.$input.ChangeNotice}} in bold RED\n \nPrint \"Supply Chain Impact Analysis for Component: \" + {{$context.$triggers.REST.$input.ItemNumber}} in bold \n\nPrint \"Below are the impacted supply chain transactions for the component being replaced\"\n \nExtract OrganizationCode as Organization, OnhandQuantity as Onhand Qty, PrimaryUOMCode as UOM Code from {{$context.$nodes.GET_ITEM_ON_HAND.$output}} and print it in html table format with table border and header \"On-hand Quantity :\"\n\nExtract AgreementNumber as \"Agreement #\", ProcurementBU as \"Business Unit\", Supplier, SupplierSite as \" Site\", Status, OrderedQuantity as \"Ordered Qty\", POUnitPrice as \"Unit Price\", Currency from {{$context.$nodes.BLANKET_PURCHASE_AGREEMENT.$output}} and print it in html table format and print it in html table format with table border and header \"Blanket Purchase Agreement Lines :\"\n\nExtract ToOrganizationCode as \"Organization\",  DocumentNumber as\" Doc #\", SoldtoLegalEntity as \"Legal Entity\", VendorName as \"Supplier\", VendorSiteCode as \"Site\", OrderedQuantity as \"Ordered Qty\", OrderedUnitOfMeasure as \"UOM\", POUnitPrice as \"Unit Price\",CurrencyCode as \"Currency\" from {{$context.$nodes.PURCHASE_ORDER_DETAILS.$output.PurchaseOrderDetailsOutput and print it in html table format with table border and header \"Purchase Orders (by Item) :\"\n\nSummarize the data extracted from {{$context.$nodes.GET_ITEM_ON_HAND.$output}}, {{$context.$nodes.BLANKET_PURCHASE_AGREEMENT.$output}} and {{$context.$nodes.PURCHASE_ORDER_DETAILS.$output}} under heading \"Component Impact Analysis Summary:\" and print it in a bulleted list\n\nPrint \"Below are the impacted supply chain transactions for the assembly items for the component being replaced: \"\n\nExtract ItemNumber as \"Item Number\", OrganizationName as \"Organization\", WorkOrderNumber as \"WorkOrder #\", WorkOrderType as \"Type\", Description, PlannedStartQuantity as \"Planned Start Qty\",CompletedQuantity as \"Completed Qty\",UOMCode as \"UOM\",WorkOrderSystemStatusCode as \"Status\" from {{$context.$nodes.GET_PARENT_WORK_ORDERS.$output}} and print it in html table format with table border and header \"Work Orders for Affected Items (by Item) :\" in bold\n\nExtract OrderNumber as \"Order #\",SourceTransactionLineNumber as \"Line #\",ProductNumber as \"Product\",StatusCode as \"Status\",OrderedQuantity as \"Ordered Qty\" from {{$context.$nodes.GET_SALES_ORDER_DETAILS_FOR_ITEM.$output}} and print it in html table format with table border and header \"Sales Order Details :\" in bold\n\nExtract PlanName as \"Plan Name\",ItemName as \"Item Name\",OrganizationCode as \"Organization\", UseUpDate as \"Use-Up Date\" from {{$context.$nodes.GET_ITEM_USE_UP_DATE.$output}} and print it in html table format with table border and header \"Item Use-Up Date : \"  in bold\n\nSummarize the data extracted from {{$context.$nodes.GET_PARENT_WORK_ORDERS.$output.GetParentWorkOrdersOutput}},{{$context.$nodes.GET_SALES_ORDER_DETAILS_FOR_ITEM.$output}} and {{$context.$nodes.GET_ITEM_USE_UP_DATE.$output}} under heading  \"Assembly Impact Analysis Summary:\" in bold and print it in a bulleted list"
            }
          ],
          "outputSpecification": "{\n    \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n    \"type\": \"object\",\n    \"properties\": {\n        \"SetSupplyChainImpactAnalysisEmailData\": {\n            \"type\": \"string\"\n        }\n    }\n}",
          "type": "LLM"
        },
