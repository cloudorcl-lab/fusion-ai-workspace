          "metadata": {
            "errorNodeId": "1769251642608",
            "name": "Transform question responses",
            "returnType": "string",
            "sourceCode": "return $context.$nodes.FETCH_QUESTION_RESPONSES.$output?.result?.items?.map(i => i?.AnswerText) || [];"
          },
          "outcomes": {
            "success": "1769250494773"
          },
          "code": "TRANSFORM_QUESTION_RESPONSES",
          "convergenceTargetId": "1768892755387",
          "id": "1768893034462",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "modelConfiguration": {
              "modelProperties": {},
              "code": "ORA_MODEL_CONFIG_PREMIUM_OPEN_AI_GPT_4_1_MINI",
              "model": "OCI_GPT_5_MINI",
              "modelName": "GPT-5 mini",
              "provider": "CERT_PREMIUM"
            },
            "errorNodeId": "1769251642608",
            "name": "Response Summarizer"
          },
          "outcomes": {
            "success": "1769251559030"
          },
          "code": "RESPONSE_SUMMARIZER",
          "id": "1769250494773",
          "inputs": [
            {
              "id": "1769250494775_1",
              "name": "prompt",
              "type": "string",
              "value": "You are an AI agent specialized in summarizing questionnaire responses.\n\nYou will be provided with:\n- A question from a questionnaire  \n- An array of text responses collected for that question  \n\nYour task is to:\n- Understand the context and intent of the question  \n- Analyze all responses collectively in relation to the question  \n- Identify common themes, key points, and notable differences  \n- Generate a concise and neutral summary that directly reflects the question context  \n\nRules:\n- The summary must not exceed 250 words  \n- Do not list or quote individual responses  \n- Do not add assumptions or external information  \n- Use clear, professional language  \n\n- If the response array is empty, return exactly:\n  { \"status\": \"NO_RESPONSES_FOUND\" }\n\n- If the response array is not empty but contains no meaningful responses (for example: all values are null, empty strings, whitespace-only, or meaningless placeholders), return exactly:\n  { \"status\": \"INVALID_RESPONSES\" }\n\n- Otherwise, return:\n  { \"status\": \"SUCCESS\", \"summary\": \"<generated summary>\" }\n\n- Do not include any text outside the JSON output.\n\n\nInput:\n\nQuestion:\n{{$context.$triggers.REST.$input.questionText}}\n\nResponses:\n{{$context.$nodes.TRANSFORM_QUESTION_RESPONSES.$output?.result}}"
            }
          ],
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Response router"
          },
          "outcomes": {
            "SUCCESS": "1769251628030",
            "ERROR": "1769251642608",
            "DEFAULT": "add_DEFAULT_1769251559030"
          },
          "code": "RESPONSE_ROUTER",
          "convergenceTargetId": "end",
          "id": "1769251559030",
          "inputs": [
            {
              "id": "1769251559031_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{Object.values($context?.$nodes ?? {}).some(node => node.$error) ?  \"ERROR\" :  $context.$nodes.RESPONSE_SUMMARIZER.$output ? \"SUCCESS\" : \"DEFAULT\"}}"
            }
          ],
          "type": "SWITCH"
        },
