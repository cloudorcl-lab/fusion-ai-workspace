{
  "workflowId": "300000331067430",
  "workflowCode": "ORA_IC_DESCRIPTION_GENERATOR",
  "name": "IC Plan Description Generator",
  "description": "Generates business-friendly descriptions for compensation plans and components. Supports selective regeneration in EDIT mode based on what changed.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5000
          }
        },
        {
          "id": "1",
          "code": "STORE_INPUTS",
          "type": "SET_FIELDS",
          "metadata": {
            "name": "Store Inputs"
          },
          "outcomes": {
            "success": "2"
          },
          "inputs": [
            {
              "id": "1_plan",
              "name": "plan",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.plan}}"
            },
            {
              "id": "1_changes",
              "name": "changes",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.changes}}"
            },
            {
              "id": "1_mode",
              "name": "mode",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.mode}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5440
          }
        },
        {
          "id": "2",
          "code": "ANALYZE_STALENESS",
          "type": "CODE",
          "metadata": {
            "name": "Analyze Staleness",
            "returnType": "object",
            "sourceCode": "// ANALYZE_STALENESS - Shared Description Generator CODE node\n// Determines which descriptions need regeneration based on changes\n//\n// Input:  $context.$variables.plan (JSON string - either plan directly or assembledResponse with updatedPlan)\n// Input:  $context.$variables.changes (JSON - either array of changes or object with changes property)\n// Input:  $context.$variables.mode (\"NEW\" | \"EDIT\")\n// Output: { skip, regeneratePlanDescription, componentsToRegenerate, reason }\n\nvar planRaw = $context.$variables.plan;\nvar changesRaw = $context.$variables.changes;\nvar mode = $context.$variables.mode || 'NEW';\n\n// Parse plan input - handle both direct plan and assembledResponse formats\nvar plan = null;\nif (planRaw && planRaw !== 'null' && planRaw !== '') {\n    var parsedPlan = typeof planRaw === 'string' ? JSON.parse(planRaw) : planRaw;\n    // Check if this is an assembledResponse (has updatedPlan) or direct plan (has planComponents)\n    if (parsedPlan.updatedPlan) {\n        plan = typeof parsedPlan.updatedPlan === 'string' ? JSON.parse(parsedPlan.updatedPlan) : parsedPlan.updatedPlan;\n    } else if (parsedPlan.planComponents) {\n        plan = parsedPlan;\n    }\n}\n\n// Parse changes input - handle both direct array and object with changes property\nvar changes = null;\nif (changesRaw && changesRaw !== 'null' && changesRaw !== '') {\n    var parsedChanges = typeof changesRaw === 'string' ? JSON.parse(changesRaw) : changesRaw;\n    // Check if this is an object with changes property or direct array\n    if (Array.isArray(parsedChanges)) {\n        changes = parsedChanges;\n    } else if (parsedChanges.changes) {\n        changes = parsedChanges.changes;\n    }\n}\n\n// Result structure\nvar result = {\n    skip: false,\n    regeneratePlanDescription: false,\n    componentsToRegenerate: [],\n    reason: ''\n};\n\n// If no plan or no components, skip entirely\nif (!plan || !plan.planComponents || plan.planComponents.length === 0) {\n    result.skip = true;\n    result.reason = 'No plan or components found';\n    return JSON.stringify(result);\n}\n\n// NEW mode: generate all descriptions\nif (mode === 'NEW') {\n    result.regeneratePlanDescription = true;\n    for (var i = 0; i < plan.planComponents.length; i++) {\n        result.componentsToRegenerate.push(plan.planComponents[i].componentName);\n    }\n    result.reason = 'NEW mode - generate all descriptions';\n    return JSON.stringify(result);\n}\n\n// EDIT mode: analyze changes to determine what's stale\nif (!changes || changes.length === 0) {\n    result.skip = true;\n    result.reason = 'EDIT mode with no changes - skip regeneration';\n    return JSON.stringify(result);\n}\n\n// Track which components are affected by changes\nvar affectedComponents = {};\nvar planLevelChange = false;\n\nfor (var j = 0; j < changes.length; j++) {\n    var change = changes[j];\n    var entity = change.entity || '';\n    var field = change.field || '';\n    var componentName = change.componentName || '';\n    var entityName = change.entityName || '';\n\n    // Plan-level changes that affect plan description\n    if (entity === 'plan' || entity === 'compensationPlan') {\n        // Check for significant plan-level changes\n        if (field === 'planName' || field === 'name' ||\n            field === 'targetIncentive' || field === 'paymentFrequency' ||\n            field === 'calculationInterval') {\n            planLevelChange = true;\n        }\n    }\n\n    // Component added or removed affects plan description\n    if (entity === 'component' || entity === 'planComponent') {\n        if (change.action === 'add' || change.action === 'remove') {\n            planLevelChange = true;\n        }\n        // Component modifications affect that component's description\n        if (componentName) {\n            affectedComponents[componentName] = true;\n        }\n    }\n\n    // Formula changes affect the component\n    if (entity === 'formula') {\n        if (componentName) {\n            affectedComponents[componentName] = true;\n        }\n    }\n\n    // Measure changes affect the component\n    if (entity === 'measure' || entity === 'performanceMeasure') {\n        if (componentName) {\n            affectedComponents[componentName] = true;\n        }\n    }\n\n    // Rate table changes affect the component\n    if (entity === 'rateTable' || entity === 'rateDimension' || entity === 'tier') {\n        if (componentName) {\n            affectedComponents[componentName] = true;\n        }\n    }\n\n    // Ignore changes that don't affect descriptions:\n    // - _resolution metadata changes\n    // - validation status changes\n    // - internal ID changes\n    if (field === '_resolution' || field === 'status' ||\n        field.indexOf('Id') === field.length - 2 ||\n        field === 'confidence' || field === 'validationStatus') {\n        // These don't make descriptions stale\n        if (componentName && affectedComponents[componentName]) {\n            delete affectedComponents[componentName];\n        }\n    }\n}\n\n// Check if plan description already exists\nvar planHasDescription = plan.compensationPlan &&\n    plan.compensationPlan.description &&\n    plan.compensationPlan.description.trim().length > 0;\n\n// Regenerate plan description if:\n// 1. Plan-level change occurred, OR\n// 2. No description exists\nif (planLevelChange || !planHasDescription) {\n    result.regeneratePlanDescription = true;\n}\n\n// Check each component for missing or stale descriptions\nfor (var k = 0; k < plan.planComponents.length; k++) {\n    var component = plan.planComponents[k];\n    var compName = component.componentName;\n\n    var componentHasDescription = component.description &&\n        component.description.trim().length > 0;\n\n    // Regenerate component description if:\n    // 1. Component was affected by changes, OR\n    // 2. No description exists\n    if (affectedComponents[compName] || !componentHasDescription) {\n        result.componentsToRegenerate.push(compName);\n    }\n}\n\n// If nothing needs regeneration, skip\nif (!result.regeneratePlanDescription && result.componentsToRegenerate.length === 0) {\n    result.skip = true;\n    result.reason = 'No descriptions need regeneration';\n} else {\n    var parts = [];\n    if (result.regeneratePlanDescription) {\n        parts.push('plan description');\n    }\n    if (result.componentsToRegenerate.length > 0) {\n        parts.push(result.componentsToRegenerate.length + ' component(s)');\n    }\n    result.reason = 'Regenerating: ' + parts.join(', ');\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "3"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5660
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "3",
          "code": "CONDITION_SKIP",
          "type": "CONDITION",
          "metadata": {
            "name": "Skip Regeneration?"
          },
          "outcomes": {
            "true": "4",
            "false": "5"
          },
          "inputs": [
            {
              "id": "3_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.ANALYZE_STALENESS.$output.result.skip}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 5880
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "4",
          "code": "RETURN_UNCHANGED",
          "type": "CODE",
          "metadata": {
            "name": "Return Unchanged",
            "returnType": "object",
            "sourceCode": "// RETURN_UNCHANGED - Shared Description Generator CODE node\n// Returns the plan unchanged when no descriptions need regeneration\n//\n// Input:  $context.$variables.plan (JSON string of plan)\n// Input:  $context.$nodes.ANALYZE_STALENESS.$output.result (staleness analysis)\n// Output: { planWithDescriptions, metadata }\n\nvar planRaw = $context.$variables.plan;\nvar stalenessRaw = $context.$nodes.ANALYZE_STALENESS.$output.result;\n\n// Parse plan input - handle both direct plan and assembledResponse formats\nvar plan = null;\nif (planRaw && planRaw !== 'null' && planRaw !== '') {\n    var parsedPlan = typeof planRaw === 'string' ? JSON.parse(planRaw) : planRaw;\n    if (parsedPlan.updatedPlan) {\n        plan = typeof parsedPlan.updatedPlan === 'string' ? JSON.parse(parsedPlan.updatedPlan) : parsedPlan.updatedPlan;\n    } else if (parsedPlan.planComponents) {\n        plan = parsedPlan;\n    } else {\n        plan = parsedPlan;\n    }\n}\nvar staleness = typeof stalenessRaw === 'string' ? JSON.parse(stalenessRaw) : stalenessRaw;\n\n// Build result with skip metadata\nvar result = {\n    planWithDescriptions: plan,\n    metadata: {\n        descriptionsGenerated: false,\n        planDescriptionUpdated: false,\n        componentsUpdated: [],\n        skipped: true,\n        skipReason: staleness.reason || 'No descriptions need regeneration',\n        descriptionGeneratorVersion: 'DESCRIPTION_GENERATOR'\n    }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6100
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "5",
          "code": "PREPARE_LLM_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Prepare LLM Context",
            "returnType": "object",
            "sourceCode": "// PREPARE_LLM_CONTEXT - Shared Description Generator CODE node\n// Builds focused context for LLM description generation\n//\n// Input:  $context.$variables.plan (JSON string - either plan directly or assembledResponse with updatedPlan)\n// Input:  $context.$nodes.ANALYZE_STALENESS.$output.result (staleness analysis)\n// Output: { planContext, existingDescriptions, componentsToDescribe }\n\nvar planRaw = $context.$variables.plan;\nvar stalenessRaw = $context.$nodes.ANALYZE_STALENESS.$output.result;\n\n// Parse plan input - handle both direct plan and assembledResponse formats\nvar plan = null;\nif (planRaw && planRaw !== 'null' && planRaw !== '') {\n    var parsedPlan = typeof planRaw === 'string' ? JSON.parse(planRaw) : planRaw;\n    // Check if this is an assembledResponse (has updatedPlan) or direct plan (has planComponents)\n    if (parsedPlan.updatedPlan) {\n        plan = typeof parsedPlan.updatedPlan === 'string' ? JSON.parse(parsedPlan.updatedPlan) : parsedPlan.updatedPlan;\n    } else if (parsedPlan.planComponents) {\n        plan = parsedPlan;\n    } else {\n        plan = parsedPlan;\n    }\n}\nvar staleness = typeof stalenessRaw === 'string' ? JSON.parse(stalenessRaw) : stalenessRaw;\n\n// Build component lookup for which ones need descriptions\nvar componentsToRegenerate = {};\nfor (var i = 0; i < staleness.componentsToRegenerate.length; i++) {\n    componentsToRegenerate[staleness.componentsToRegenerate[i]] = true;\n}\n\n// Extract existing descriptions for style reference\nvar existingDescriptions = {\n    planDescription: null,\n    componentDescriptions: []\n};\n\n// Get existing plan description if it exists and we're NOT regenerating it\nif (plan.compensationPlan && plan.compensationPlan.description && !staleness.regeneratePlanDescription) {\n    existingDescriptions.planDescription = plan.compensationPlan.description;\n}\n\n// Get existing component descriptions for style reference\nfor (var j = 0; j < plan.planComponents.length; j++) {\n    var component = plan.planComponents[j];\n    if (component.description && !componentsToRegenerate[component.componentName]) {\n        existingDescriptions.componentDescriptions.push({\n            componentName: component.componentName,\n            description: component.description\n        });\n    }\n}\n\n// Build focused plan context (only what LLM needs to generate descriptions)\nvar planContext = {\n    compensationPlan: {\n        planName: plan.compensationPlan ? plan.compensationPlan.planName : 'Unknown Plan',\n        planType: plan.compensationPlan ? plan.compensationPlan.planType : null,\n        targetIncentive: plan.compensationPlan ? plan.compensationPlan.targetIncentive : null,\n        paymentFrequency: plan.compensationPlan ? plan.compensationPlan.paymentFrequency : null\n    },\n    planComponents: []\n};\n\n// Include component details for those that need descriptions\nfor (var k = 0; k < plan.planComponents.length; k++) {\n    var comp = plan.planComponents[k];\n    var includeDetails = componentsToRegenerate[comp.componentName] ||\n                         staleness.regeneratePlanDescription;\n\n    var compContext = {\n        componentName: comp.componentName,\n        componentType: comp.componentType || null,\n        paymentType: comp.paymentType || null,\n        weight: comp.weight || null\n    };\n\n    if (includeDetails) {\n        // Include formula details\n        if (comp.formulas && comp.formulas.length > 0) {\n            compContext.formulas = [];\n            for (var f = 0; f < comp.formulas.length; f++) {\n                var formula = comp.formulas[f];\n                compContext.formulas.push({\n                    formulaName: formula.formulaName,\n                    formulaType: formula.formulaType,\n                    expression: formula.expression ? formula.expression.simpleExpression : null\n                });\n            }\n        }\n\n        // Include measure details\n        if (comp.performanceMeasures && comp.performanceMeasures.length > 0) {\n            compContext.performanceMeasures = [];\n            for (var m = 0; m < comp.performanceMeasures.length; m++) {\n                var measure = comp.performanceMeasures[m];\n                compContext.performanceMeasures.push({\n                    measureName: measure.measureName,\n                    measureType: measure.measureType,\n                    goalType: measure.goal ? measure.goal.goalType : null\n                });\n            }\n        }\n\n        // Include rate table details\n        if (comp.rateTables && comp.rateTables.length > 0) {\n            compContext.rateTables = [];\n            for (var r = 0; r < comp.rateTables.length; r++) {\n                var rt = comp.rateTables[r];\n                compContext.rateTables.push({\n                    rateTableName: rt.rateTableName,\n                    rateTableType: rt.rateTableType,\n                    tierCount: rt.rateValues ? rt.rateValues.length : 0\n                });\n            }\n        }\n    }\n\n    planContext.planComponents.push(compContext);\n}\n\n// Build list of what the LLM should describe\nvar componentsToDescribe = [];\nif (staleness.regeneratePlanDescription) {\n    componentsToDescribe.push('__PLAN__');\n}\nfor (var n = 0; n < staleness.componentsToRegenerate.length; n++) {\n    componentsToDescribe.push(staleness.componentsToRegenerate[n]);\n}\n\nvar result = {\n    planContext: planContext,\n    existingDescriptions: existingDescriptions,\n    componentsToDescribe: componentsToDescribe\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "6"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6320
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "6",
          "code": "GENERATE_DESCRIPTIONS",
          "type": "LLM",
          "metadata": {
            "name": "Generate Descriptions",
            "temperature": 0.3,
            "maxTokens": 4000,
            "reasoningEffort": "low"
          },
          "outcomes": {
            "success": "7"
          },
          "inputs": [
            {
              "id": "6_prompt",
              "name": "prompt",
              "type": "string",
              "value": "You are an expert at creating clear, business-friendly summaries of compensation plans.\n\nGiven the following compensation plan context and a list of what needs descriptions, generate concise descriptions for the specified items.\n\nPLAN CONTEXT:\n{{$context.$nodes.PREPARE_LLM_CONTEXT.$output.result.planContext}}\n\nITEMS TO DESCRIBE:\n{{$context.$nodes.PREPARE_LLM_CONTEXT.$output.result.componentsToDescribe}}\n(Note: \"__PLAN__\" means generate the plan description; component names mean generate that component's description)\n\nEXISTING DESCRIPTIONS (for style reference - match this tone and length):\n{{$context.$nodes.PREPARE_LLM_CONTEXT.$output.result.existingDescriptions}}\n\nINSTRUCTIONS:\n\n1. PLAN DESCRIPTION (only if \"__PLAN__\" is in the list):\n   - Write 2-3 sentences that explain what this compensation plan is about\n   - Include: who it's for, what behaviors it rewards, key mechanics (if notable)\n   - Use plain business language, avoid technical jargon\n   - Focus on the \"why\" and \"what\" not the \"how\"\n\n2. COMPONENT DESCRIPTIONS (only for components in the list):\n   - For each component, write 2-3 sentences explaining:\n     * What the component pays for (the goal/behavior)\n     * How earnings are determined (high-level: commission rate, bonus tiers, etc.)\n     * When/how often it pays out (if relevant)\n   - Use the component name exactly as it appears in the plan\n   - Be specific to each component's actual mechanics from the context\n\nSTYLE GUIDELINES:\n- If existing descriptions are provided, match their tone and length\n- Be concise but complete\n- Write for business users (sales managers, HR, finance), not developers\n- Avoid mentioning technical field names or JSON structure\n- Use active voice and clear language\n- Do NOT include specific percentages or rates unless they are key to understanding\n- If the plan context lacks detail, write a reasonable generic description\n\nOUTPUT FORMAT:\nRespond ONLY with valid JSON matching this schema:\n\n{\n  \"planDescription\": \"string or null - plan description if __PLAN__ was in the list, otherwise null\",\n  \"componentDescriptions\": [\n    {\n      \"componentName\": \"string - exact component name\",\n      \"description\": \"string - 2-3 sentence description\"\n    }\n  ]\n}\n\nIMPORTANT:\n- Return ONLY the JSON, no markdown code fences or extra text\n- componentName must match exactly (case-sensitive)\n- Only include components that were in the ITEMS TO DESCRIBE list\n- If __PLAN__ was not in the list, set planDescription to null\n- If no components were in the list, return an empty componentDescriptions array"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6540
          },
          "outputSpecification": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"type\": \"object\", \"properties\": {\"planDescription\": {\"type\": [\"string\", \"null\"], \"description\": \"Plan description if __PLAN__ was in the list, otherwise null\"}, \"componentDescriptions\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"properties\": {\"componentName\": {\"type\": \"string\", \"description\": \"Exact component name from the plan\"}, \"description\": {\"type\": \"string\", \"description\": \"2-3 sentence description\"}}, \"required\": [\"componentName\", \"description\"]}}}, \"required\": [\"componentDescriptions\"]}"
        },
        {
          "id": "7",
          "code": "MERGE_DESCRIPTIONS",
          "type": "CODE",
          "metadata": {
            "name": "Merge Descriptions",
            "returnType": "object",
            "sourceCode": "// MERGE_DESCRIPTIONS - Shared Description Generator CODE node\n// Merges AI-generated descriptions into the plan\n//\n// Input:  $context.$variables.plan (JSON string of plan)\n// Input:  $context.$nodes.ANALYZE_STALENESS.$output.result (staleness analysis)\n// Input:  $context.$nodes.GENERATE_DESCRIPTIONS.$output (LLM output)\n// Output: { planWithDescriptions, metadata }\n// Error handling: If LLM output is empty/invalid, return plan as-is without descriptions\n\nvar planRaw = $context.$variables.plan;\nvar stalenessRaw = $context.$nodes.ANALYZE_STALENESS.$output.result;\nvar descriptionsRaw = $context.$nodes.GENERATE_DESCRIPTIONS.$output;\n\n// Parse plan input - handle both direct plan and assembledResponse formats\nvar plan = null;\nif (planRaw && planRaw !== 'null' && planRaw !== '') {\n    var parsedPlan = typeof planRaw === 'string' ? JSON.parse(planRaw) : planRaw;\n    // Check if this is an assembledResponse (has updatedPlan) or direct plan (has planComponents)\n    if (parsedPlan.updatedPlan) {\n        plan = typeof parsedPlan.updatedPlan === 'string' ? JSON.parse(parsedPlan.updatedPlan) : parsedPlan.updatedPlan;\n    } else if (parsedPlan.planComponents) {\n        plan = parsedPlan;\n    } else {\n        plan = parsedPlan;\n    }\n}\nvar staleness = typeof stalenessRaw === 'string' ? JSON.parse(stalenessRaw) : stalenessRaw;\n\n// Helper to return plan without descriptions (fallback)\nvar returnPlanWithoutDescriptions = (reason) => {\n    return {\n        planWithDescriptions: plan,\n        metadata: {\n            descriptionsGenerated: false,\n            planDescriptionUpdated: false,\n            componentsUpdated: [],\n            skipped: true,\n            skipReason: reason || 'LLM description generation failed',\n            descriptionGeneratorVersion: 'DESCRIPTION_GENERATOR'\n        }\n    };\n};\n\n// Check if descriptions output exists and is valid\nif (!descriptionsRaw || descriptionsRaw === '' || descriptionsRaw === 'null') {\n    return returnPlanWithoutDescriptions('Empty LLM descriptions output');\n}\n\n// Parse descriptions output with error handling\nvar descriptions = null;\ntry {\n    descriptions = typeof descriptionsRaw === 'string' ? JSON.parse(descriptionsRaw) : descriptionsRaw;\n} catch (e) {\n    return returnPlanWithoutDescriptions('Failed to parse LLM descriptions output');\n}\n\n// Validate descriptions structure\nif (!descriptions || typeof descriptions !== 'object') {\n    return returnPlanWithoutDescriptions('Invalid LLM descriptions output structure');\n}\n\n// Track what was updated\nvar planDescriptionUpdated = false;\nvar componentsUpdated = [];\n\n// Merge plan description if it was generated\nif (staleness.regeneratePlanDescription && descriptions.planDescription) {\n    if (!plan.compensationPlan) {\n        plan.compensationPlan = {};\n    }\n    plan.compensationPlan.description = descriptions.planDescription;\n    planDescriptionUpdated = true;\n}\n\n// Build component description lookup from LLM output\nvar componentDescMap = {};\nif (descriptions.componentDescriptions) {\n    for (var i = 0; i < descriptions.componentDescriptions.length; i++) {\n        var cd = descriptions.componentDescriptions[i];\n        componentDescMap[cd.componentName] = cd.description;\n    }\n}\n\n// Merge component descriptions\nif (plan.planComponents) {\n    for (var j = 0; j < plan.planComponents.length; j++) {\n        var component = plan.planComponents[j];\n        var desc = componentDescMap[component.componentName];\n        if (desc) {\n            component.description = desc;\n            componentsUpdated.push(component.componentName);\n        }\n        // If component wasn't in the regeneration list, preserve existing description\n        // (no action needed - it's already there)\n    }\n}\n\n// Update plan metadata\nif (!plan.metadata) {\n    plan.metadata = {};\n}\nplan.metadata.descriptionsGenerated = true;\n    plan.metadata.descriptionGeneratorVersion = 'DESCRIPTION_GENERATOR';\n\n// Build result with metadata\nvar result = {\n    planWithDescriptions: plan,\n    metadata: {\n        descriptionsGenerated: true,\n        planDescriptionUpdated: planDescriptionUpdated,\n        componentsUpdated: componentsUpdated,\n        skipped: false,\n        descriptionGeneratorVersion: 'DESCRIPTION_GENERATOR'\n    }\n};\n\nreturn result;"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 6760
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
