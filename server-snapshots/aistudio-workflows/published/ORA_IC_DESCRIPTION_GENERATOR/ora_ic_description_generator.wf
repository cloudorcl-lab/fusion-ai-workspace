    "modelConfiguration": null,
    "humanApprovalFlag": false,
    "waitFlag": false,
    "triggers": [
      {
        "type": "REST",
        "inputs": [
          {
            "id": "trig_001",
            "name": "plan",
            "type": "string"
          },
          {
            "id": "trig_002",
            "name": "changes",
