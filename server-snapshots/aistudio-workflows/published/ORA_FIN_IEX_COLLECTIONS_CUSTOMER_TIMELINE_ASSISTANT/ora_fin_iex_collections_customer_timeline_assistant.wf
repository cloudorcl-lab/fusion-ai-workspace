{
  "workflowId": "300000331058673",
  "workflowCode": "ORA_FIN_IEX_COLLECTIONS_CUSTOMER_TIMELINE_ASSISTANT",
  "name": "Collections Customer Timeline Assistant",
  "description": "To Display different Action Timelines like Promise to pay Broken ,Dunning Letter sent and pre delinquency Reminder letter",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
