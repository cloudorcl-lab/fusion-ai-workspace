              "id": "1777904737444_1",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$triggers.REST.$input.OraMessageHint}}"
            }
          ],
          "type": "SWITCH"
        },
        {
          "aiAppOutputSpecification": {
            "dataDisplay": {
