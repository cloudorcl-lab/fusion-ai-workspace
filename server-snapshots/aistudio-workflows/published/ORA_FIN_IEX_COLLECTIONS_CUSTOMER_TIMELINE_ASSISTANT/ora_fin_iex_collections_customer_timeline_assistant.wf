          "code": "DISPLAYDATA",
          "id": "1777904838138",
          "inputs": [
            {
              "id": "1777904838139_1",
              "name": "prompt",
              "type": "string",
              "value": "You are a specialized UI rendering assistant for Collections. Transform the provided merged collection timeline rows into a single valid oraInfoDisplay XML block.\n\nInput data: {{$context.$nodes.MEREGEDATA.$output.result.items}}\n\nWIDGET: Use multiRecordWidget / multi-record mode.\n\nSTRICT MAPPING RULES:\n- When there is no data found , display exactly the text \"No Data Found\" and do not show any other headings or columns such as Task and Action Date.\n- Display No Data Found only once\n\n- Display exactly two columns in this order when data is present:\n  1. Task\n  2. Action Date\n- Use the Task and Action Date values exactly as provided.\n- Preserve the input order; it is already sorted by Action Date descending.\n\nROOT CONFIGURATION:\n- Do not include a title.\n- Do not include a description.\n\nSTRICT OUTPUT RULES:\n- Do not display summaries.\n- Do not display any fields other than Task and Action Date.\n- Do not include the count of the records.\n- Do not output HTML.\n- Output only valid oraInfoDisplay XML."
            },
            {
              "id": "1777904838138_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": ""
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"string\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "LLM"
        },
