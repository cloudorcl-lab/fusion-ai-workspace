          "code": "GETCONTEXT",
          "id": "1777992572586",
          "inputs": [
            {
              "id": "1777992677378",
              "name": "Customer",
              "value": "{{$context.$triggers.REST.$input.OraAppContext}}"
            }
          ],
          "type": "SET_FIELDS"
        },
        {
          "metadata": {
            "name": "ExtractCust",
            "returnType": "string",
            "sourceCode": "const raw = $context.$variables.Customer;\nif (raw == null || raw === \"\") return null;\nif (typeof raw === \"object\") return raw;\nlet text = String(raw).trim();\nif (!text) return null;\nif (text.startsWith(\"appContext=\")) text = text.slice(\"appContext=\".length);\ntext = text.replace(/\\+/g, \" \");\nreturn JSON.parse(decodeURIComponent(text));"
          },
          "outcomes": {
            "success": "1777483826108"
          },
          "code": "EXTRACTCUST",
          "id": "1777995777458",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "ExecutionTasks",
            "returnType": "object",
            "sourceCode": "let custid = $context.$variables.Customer.customerAccountId;\n\nif (custid === null || custid === undefined || custid === \"\") throw new Error(\"customerAccountId is missing from EXTRACTCUST output\");\nreturn {\n  parameters: { bindCustId: custid, bindStrategyTemplateId: 124 },\n  viewQueries: {\n    collectionsStrategy: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CustomerCollectionsTaskDetail\",\n      view: \"collectionsStrategy\",\n      fieldAliases: {\n        executeEnd: \"executeEnd\",\n        \"strategyWorkItem.workItemTemplateId\": \"workItemTemplateId\",\n        \"strategyWorkItem.name\": \"name\",\n        \"strategy.customerAccount.accountNumber\": \"accountNumber\",\n        \"strategy.statusCodeLookup.lookupCode\": \"strategyStatusCode\",\n        \"strategy.customerAccount.customerAccountId\": \"customerAccountId\",\n        \"strategy.customer.id\": \"partyId\",\n        \"strategy.strategyTemplate.strategyTemplateId\": \"strategyTemplateId\",\n        \"statusCodeLookup.lookupCode\": \"statusLookupCode\"\n      }\n    },\n    customerAccountProfileDetail: {\n      module: \"oraErpCoreCustomerAccountSetup\",\n      businessObject: \"CustomerProfile\",\n      view: \"customerAccountProfileDetail\",\n      fieldAliases: {\n        \"customerAccount.customerAccountId\": \"customerAccountId\"\n      }\n    }\n  },\n  select: \"SELECT collectionsStrategy.accountNumber, collectionsStrategy.name taskName,collectionsStrategy.workItemTemplateId taskCode, 'Completed' taskStatus, collectionsStrategy.customerAccountId, collectionsStrategy.partyId, TO_CHAR(collectionsStrategy.executeEnd, 'YYYY-MM-DD') taskDate FROM collectionsStrategy collectionsStrategy JOIN customerAccountProfileDetail customerAccountProfileDetail ON customerAccountProfileDetail.customerAccountId = collectionsStrategy.customerAccountId WHERE collectionsStrategy.customerAccountId = :bindCustId AND collectionsStrategy.statusLookupCode = 'COMPLETE' AND (collectionsStrategy.strategyStatusCode = 'OPEN' OR collectionsStrategy.strategyTemplateId = :bindStrategyTemplateId) ORDER BY collectionsStrategy.executeEnd DESC\"\n};"
          },
          "outcomes": {
            "success": "1777484251228"
          },
          "code": "EXECUTIONTASKS",
          "id": "1777483826108",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "GetTasks"
          },
          "outcomes": {
            "success": "1777981244086",
            "failure": "end"
          },
          "code": "GETTASKS",
          "id": "1777484251228",
          "inputs": [
            {
              "id": "1777484274185_1",
              "name": "extraction_query_json_object",
              "type": "string",
              "value": "{{$context.$nodes.EXECUTIONTASKS.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "FetchPTP",
            "returnType": "object",
            "sourceCode": "let custid = $context.$variables.Customer.customerAccountId;;\n \nif (custid === null || custid === undefined || custid === \"\") throw new Error(\"customerAccountId is missing from EXTRACTCUST output\");\nreturn {\n  parameters: { bindCustId: custid },\n  viewQueries: {\n    collectionsPromise: {\n      module: \"oraErpCoreAdvancedCollections\",\n      businessObject: \"CustomerPromiseDetail\",\n      view: \"collectionsPaymentPromise\",\n      fieldAliases: {\n        \"delinquency.paymentSchedule.customerAccount.customerAccountId\": \"customerAccountId\",\n        promiseBrokenDate: \"promiseBrokenDate\",\n        \"statusLookup.lookupCode\": \"status\",\n        state: \"state\"\n      }\n    }\n  },\n  select: \"SELECT 'Promise to Pay Broken' Task, TO_CHAR(collectionsPromise.promiseBrokenDate, 'YYYY-MM-DD') ActionDate FROM collectionsPromise collectionsPromise WHERE collectionsPromise.customerAccountId = :bindCustId AND collectionsPromise.status = 'COLLECTABLE' AND collectionsPromise.state = 'BROKEN_PROMISE' AND collectionsPromise.promiseBrokenDate >= TRUNC(SYSDATE) - 30 AND collectionsPromise.promiseBrokenDate < TRUNC(SYSDATE) + 1  ORDER BY collectionsPromise.promiseBrokenDate DESC\"\n};"
          },
          "outcomes": {
            "success": "1777985366459"
          },
          "code": "FETCHPTP",
          "id": "1777981244086",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "businessObjectCode": "ORA_FIN_COLLECTION_COLLECTIONSBUSINESSOBJECTDATAEXTRACT",
            "functionName": "Extract",
            "name": "Getptp"
          },
          "outcomes": {
            "success": "1778057930129",
            "failure": "end"
          },
          "code": "GETPTP",
          "id": "1777985366459",
          "inputs": [
            {
              "id": "1777985366459_extraction_query_json_object",
              "name": "extraction_query_json_object",
              "value": "{{$context.$nodes.FETCHPTP.$output.result}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "name": "MeregeData",
            "returnType": "string",
            "sourceCode": "let outputs = [\n  $context.$nodes.GETTASKS.$output || {},\n  $context.$nodes.GETPTP.$output || {}\n];\n\nlet mergedData = [];\n\nfor (let i = 0; i < outputs.length; i++) {\n  let output = outputs[i];\n\n  if (typeof output.result === \"string\") {\n    let resultText = output.result.trim();\n\n    try {\n      output = JSON.parse(resultText);\n    } catch (e) {\n      resultText = resultText.replace(/([{,]\\s*)([A-Za-z_][A-Za-z0-9_]*)(\\s*:)/g, '$1\"$2\"$3');\n\n      try {\n        output = JSON.parse(resultText);\n      } catch (ignore) {\n        output = {};\n      }\n    }\n  }\n\n  let records = [];\n\n  if (Array.isArray(output)) {\n    records = output;\n  } else if (Array.isArray(output.items)) {\n    records = output.items;\n  } else if (output.result && Array.isArray(output.result.items)) {\n    records = output.result.items;\n  } else if (Array.isArray(output.rows)) {\n    records = output.rows;\n  } else if (Array.isArray(output.data)) {\n    records = output.data;\n  }\n\n  for (let j = 0; j < records.length; j++) {\n    let record = records[j] || {};\n    let task = null;\n    let actionDate = null;\n\n    let keys = Object.keys(record);\n\n    for (let k = 0; k < keys.length; k++) {\n      let key = keys[k];\n      let lowerKey = key.toLowerCase();\n\n      if (lowerKey === \"task\" || lowerKey === \"taskname\" || lowerKey === \"data\") {\n        task = record[key];\n      }\n\n      if (lowerKey === \"actiondate\" || lowerKey === \"taskdate\" || lowerKey === \"promisebrokendate\") {\n        actionDate = record[key];\n      }\n    }\n\n    if (i === 1) {\n      task = \"Promise to Pay Broken\";\n    }\n\n    mergedData.push({\n      Task: task,\n      ActionDate: actionDate ? String(actionDate).substring(0, 10) : null\n    });\n  }\n}\n\nfor (let i = 0; i < mergedData.length - 1; i++) {\n  for (let j = i + 1; j < mergedData.length; j++) {\n    let leftDate = new Date(mergedData[i].ActionDate || 0).getTime();\n    let rightDate = new Date(mergedData[j].ActionDate || 0).getTime();\n\n    if (rightDate > leftDate) {\n      let tempRecord = mergedData[i];\n      mergedData[i] = mergedData[j];\n      mergedData[j] = tempRecord;\n    }\n  }\n}\n\nreturn JSON.stringify({\n  items: mergedData,\n  count: mergedData.length\n});\n"
          },
          "outcomes": {
            "success": "1777904737443"
          },
          "code": "MEREGEDATA",
          "id": "1778057930129",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "RouteRequest"
          },
          "outcomes": {
            "InitDisplay": "1777904838138",
            "default": "add_default_1777904737443"
          },
          "code": "ROUTEREQUEST",
          "convergenceTargetId": "end",
