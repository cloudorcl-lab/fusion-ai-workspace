            "errorNodeId": "1771801721163",
            "name": "Find Event Operation",
            "returnType": "string",
            "sourceCode": "return $context.$triggers.REST.$input.calendarAction === \"CREATE\"\n  ? \"CREATE\"\n  : [\"UPDATE\", \"DELETE\", \"CANCEL\"].includes($context.$triggers.REST.$input.calendarAction)\n    ? \"UPDATE_CANCEL_DELETE\"\n    : $context.$triggers.REST.$input.calendarAction === \"FIND\"\n      ? \"FIND\"\n      : $context.$triggers.REST.$input.calendarAction === \"FIND_BATCH\"\n      ? \"FIND_BATCH\"\n      : [\"BATCH_CREATE\", \"BATCH_UPDATE\", \"BATCH_DELETE\", \"BATCH_CREATE_DELETE\"].includes($context.$triggers.REST.$input.calendarAction)\n        ? \"BATCH\"\n        : \"ERROR\""
          },
          "outcomes": {
            "success": "1764957456295"
          },
          "code": "FIND_EVENT_OPERATION",
          "id": "1771738886552",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
