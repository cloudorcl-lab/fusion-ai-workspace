          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
        },
        {
          "metadata": {
            "name": "Update Core Job Referral Payload",
            "returnType": "object",
            "sourceCode": "const payload = $context.$variables.coreJobReferralPayload;\n\n// Parse attachment agent output safely\nlet attachmentParsingAgentOutput = {};\ntry {\n  attachmentParsingAgentOutput = JSON.parse($context.$nodes.CALL_ATTACHMENT_PARSING_AGENT.$output.output);\n} catch (e) {\n  attachmentParsingAgentOutput = {};\n}\n\n// Safe reference\nconst resultData = attachmentParsingAgentOutput.result || {};\nconst candidateBasicInfo = resultData.candidateBasicInfo || {};\n\n// Base result object\nconst result = {\n  resumeText: payload.resumeText || \"\",\n  extractedSkills: resultData.profileSkillItemArray || [],\n  fromEmailAddress: payload.fromEmailAddress || \"\",\n  emailSubject: payload.emailSubject || \"\",\n  emailContent: payload.emailContent || \"\"\n};\n\n// Conditionally add candidateEmailAddress\nif (candidateBasicInfo.EmailAddress) {\n  result.candidateEmailAddress = candidateBasicInfo.EmailAddress;\n}\n\n// Build candidate location safely\nlet candidateLocation = \"\";\n\nif (candidateBasicInfo.StateOrProvince) {\n  candidateLocation = candidateBasicInfo.StateOrProvince;\n}\n\nif (candidateBasicInfo.City) {\n  candidateLocation = candidateLocation\n    ? candidateLocation + \", \" + candidateBasicInfo.City\n    : candidateBasicInfo.City;\n}\n\nif (candidateBasicInfo.Country) {\n  candidateLocation = candidateLocation\n    ? candidateLocation + \", \" + candidateBasicInfo.Country\n    : candidateBasicInfo.Country;\n}\n\n// Add location only if present\nif (candidateLocation) {\n  result.candidateLocation = candidateLocation;\n}\n\nconst firstName = candidateBasicInfo.FirstName;\nconst lastName = candidateBasicInfo.LastName;\n\nif (firstName && lastName) {\n  result.CandidateName = firstName + ' ' + lastName;\n} else if (firstName) {\n  result.CandidateName = firstName;\n} else if (lastName) {\n  result.CandidateName = lastName;\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1769152503476"
          },
          "code": "UPDATE_CORE_JOB_REFERRAL_PAYLOAD",
