        {
          "metadata": {
            "name": "Create Payload for Invoking OM Job Search",
            "returnType": "object",
            "sourceCode": "const externalCandidatePersonId = $context.$variables.externalCandidatePersonId;\n\n// NEW FIELD CHECK\nconst fromEmailAddress = $context.$triggers.REST.$input.fromEmailAddress;\n\n// FORCE STRING CONVERSION\nlet jobSearchQuery = $context.$variables.jobSearchQuery;\n\n// Convert safely to string\njobSearchQuery =\n  jobSearchQuery !== null && jobSearchQuery !== undefined\n    ? String(jobSearchQuery).trim()\n    : \"\";\n\n// Base payload\nconst payload = {\n  filters: [{ name: \"internalJob\", value: \"2\" }],\n  context: \"JOBS\",\n  sort: [{ name: \"score\", direction: \"desc\" }],\n  searchFields: [\n    \"jobCode\",\n    \"internalQualifications\",\n    \"internalResponsibilities\",\n    \"internalShortDescription\",\n    \"job\",\n    \"location\",\n    \"skills\",\n    \"title\",\n    \"requisitionNumber\",\n    \"externalDesc\",\n    \"externalQualifications\",\n    \"externalResponsibilities\",\n    \"internalDesc\"\n  ],\n  offset: 0,\n  limit: 50\n};\n\nlet queryParts = [];\n\n/* =========================\n   GENERAL QUERY\n========================= */\nif (jobSearchQuery.length > 0) {\n  queryParts = jobSearchQuery\n    .split(\",\")\n    .map(v => v.trim())\n    .filter(Boolean);\n}\n\n/* =========================\n   REMOVE DUPLICATES\n========================= */\nqueryParts = [...new Set(queryParts)];\n\n/* =========================\n   FINAL QUERY\n========================= */\npayload.query = queryParts.join(\", \");\n\n/* =========================\n   SOURCE ATTRIBUTE\n========================= */\nif (\n  fromEmailAddress !== null &&\n  fromEmailAddress !== undefined &&\n  String(fromEmailAddress).trim() !== \"\"\n) {\n  payload.source = \"EMAIL_REFERRAL_AGENT\";\n}\n\n/* =========================\n   EXCLUSION FILTER\n========================= */\nif (\n  externalCandidatePersonId !== null &&\n  externalCandidatePersonId !== undefined &&\n  externalCandidatePersonId !== \"\"\n) {\n  payload.filters.push({\n    name: \"excludeAlreadyAppliedJobsAndProspects\",\n    value: Number(externalCandidatePersonId)\n  });\n}\n\nreturn payload;"
          },
          "outcomes": {
            "success": "1769154548013"
          },
