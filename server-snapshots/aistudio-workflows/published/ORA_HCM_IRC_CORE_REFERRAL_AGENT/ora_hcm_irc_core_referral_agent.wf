            "returnType": "string",
            "sourceCode": "// Get candidate email\nvar email = $context.$variables.coreJobReferralPayload.candidateEmailAddress;\n\n// Default safe value\nvar encodedEmail = \"\";\n\n// Encode only if value exists\nif (email !== null && email !== undefined && email !== \"\") {\n  encodedEmail = encodeURIComponent(String(email));\n}\n\n// Return encoded value\nreturn encodedEmail;"
          },
          "outcomes": {
            "success": "1769154008065"
          },
