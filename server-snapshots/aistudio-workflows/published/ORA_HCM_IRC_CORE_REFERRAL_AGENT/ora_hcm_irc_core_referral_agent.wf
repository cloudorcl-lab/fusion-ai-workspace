        {
          "metadata": {
            "name": "Validate Internal Candidate Check Candidate Status",
            "returnType": "boolean",
            "sourceCode": "const response = $context.$nodes.CHECK_CANDIDATE_IS_INTERNAL_CANDIDATE_OR_NOT_USING_FROM_ADDRESS.$output;\n\n// Default result\nlet isInternalCandidate = false;\n\n// Validate response structure\nif (\n  response &&\n  Array.isArray(response.items) &&\n  response.items.length > 0\n) {\n  const candidate = response.items[0];\n\n  if (\n    candidate &&\n    candidate.IsInternalCandidateFlag &&\n    candidate.IsInternalCandidateFlag.toLowerCase() === \"true\"\n  ) {\n    isInternalCandidate = true;\n  }\n}\n\nreturn isInternalCandidate;"
          },
          "outcomes": {
            "success": "1769151814846"
          },
          "code": "VALIDATE_INTERNAL_CANDIDATE_CHECK_CANDIDATE_STATUS",
          "id": "1769151785825",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
