          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"text\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"text\"\n  ]\n}",
          "type": "DOCUMENT_PROCESSOR"
        },
        {
          "metadata": {
            "name": "Set Candidate Resume Retrieved from Document Id"
          },
          "outcomes": {
            "success": "1769693351545"
          },
          "code": "SET_CANDIDATE_RESUME_RETRIEVED_FROM_DOCUMENT_ID",
          "id": "1769152136507",
          "inputs": [
            {
              "id": "1769152151456",
              "name": "candidateResumeAsString",
              "scope": "JOB",
              "type": "string",
              "value": "{{$context.$nodes.GET_CANDIDATE_ATTACHMENT_CONTENT_USING_TRACKER_ID.$output.text}}"
            }
          ],
