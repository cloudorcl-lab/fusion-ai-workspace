        {
          "metadata": {
            "name": "Frame Return Response Due to From Email Address is not valid",
            "returnType": "object",
            "sourceCode": "let referralResponse = $context.$variables.referralResponse;\n\n// Ensure referralResponse is always an array\nif (!Array.isArray(referralResponse)) {\n  referralResponse = [];\n}\n\nconst resultPayload = {\n  Status: \"FAILED\",\n  Subject: \"Candidate referral could not be processed.\",\n  OverAllMessage: \"Your candidate referral could not be completed. Only internal employees are eligible to refer candidates.\"\n};\n\n// Add payload to response array\nreferralResponse.push(resultPayload);\n\n// Return updated array so it persists in workflow\nreturn referralResponse[0];"
          },
          "outcomes": {
            "success": "1769151932378"
          },
          "code": "FRAME_RETURN_RESPONSE_DUE_TO_FROM_EMAIL_ADDRESS_IS_NOT_VALID",
          "id": "1769151890730",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
