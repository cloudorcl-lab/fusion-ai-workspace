            "sourceCode": "// Get response (could be string or object)\nvar rawResponse = $context.$nodes.INVOKE_OM_JOB_SEARCH.$output;\n\n// Parse safely\nvar parsed = null;\ntry {\n  parsed = typeof rawResponse === \"string\" ? JSON.parse(rawResponse) : rawResponse;\n} catch (e) {\n  parsed = null;\n}\n\n// Default result\nvar hasResults = false;\n\n// Check totalResults\nif (\n  parsed &&\n  parsed.totalResults !== undefined &&\n  parsed.totalResults !== null &&\n  Number(parsed.totalResults) > 0\n) {\n  hasResults = true;\n}\n\n// Return boolean\nreturn hasResults;"
