            "sourceCode": "let referralResponse = $context.$variables.referralResponse;\nlet deeplinkURL = $context.$nodes.CALL_JOB_SEARCH_DEEPLINK_TOOL.$output;\n\n// Ensure referralResponse is always an array\nif (!Array.isArray(referralResponse)) {\nreferralResponse = [];\n}\n\n// Default values\nlet subject = \"Preferred Location Needed for Your Referral\";\nlet status = \"LOCATION_NOT_FOUND\";\nlet overAllMessage = \"We could not find matching jobs for the referred candidate because their preferred job location was missing from the resume or referral email. Please include the candidate’s preferred work location and resend the referral. This will help us identify the most relevant job opportunities.\";\n\n\nconst resultPayload = {\nStatus: status,\nSubject: subject,\nOverAllMessage: overAllMessage,\nDeepLinkURL: deeplinkURL\n};\n\n// Add payload to response array\nreferralResponse.push(resultPayload);\n\n// Return updated array so it persists in workflow\nreturn referralResponse[0];"
