          "metadata": {
            "name": "Validate External Candidate Check Candidate Status",
            "returnType": "string",
            "sourceCode": "const response = $context.$nodes.CHECK_CANDIDATE_STATUS_FOR_CANDIDATE_EMAIL_PRESENT_IN_CANDIDATE_ATTACHMENT.$output;\nconst isCreateReferralAllowedFlag = $context.$variables.isCreateReferralAllowedFlag;\n\nlet status = \"DEFAULT\";\n\nif (response && Array.isArray(response.items)) {\n\n  // Case 1: No items → NEW_CANDIDATE (apply flag here ONLY)\n  if (response.items.length === 0) {\n    status = isCreateReferralAllowedFlag ? \"NEW_CANDIDATE\" : \"DEFAULT\";\n  }\n\n  // Case 2: Items exist\n  else {\n    const candidate = response.items[0];\n\n    const isInternal =\n      candidate.IsInternalCandidateFlag &&\n      candidate.IsInternalCandidateFlag.toLowerCase() === \"true\";\n\n    const hasPersonId =\n      candidate.PersonId !== null &&\n      candidate.PersonId !== undefined &&\n      String(candidate.PersonId).trim() !== \"\";\n\n    if (isInternal) {\n      status = \"INTERNAL_CANDIDATE\";\n    } else if (hasPersonId) {\n      status = \"NOT_REFERRED\";\n    } else {\n      status = \"DEFAULT\";\n    }\n  }\n}\n\nreturn status;"
          },
          "outcomes": {
            "success": "1769154113135"
          },
