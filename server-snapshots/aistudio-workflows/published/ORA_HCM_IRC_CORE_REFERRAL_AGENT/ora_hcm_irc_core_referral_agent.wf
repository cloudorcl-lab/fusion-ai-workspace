                {
                  "metadata": {
                    "name": "Unable to Create Referral For These Jobs",
                    "returnType": "object",
                    "sourceCode": "let referralResponse = $context.$variables.referralResponse;\nconst validateCandidateStatus = $context.$nodes.LOOP_CREATE_JOB_REFERRAL.VALIDATE_CANDIDATE.$output?.result?.status;\nconst currentItem = $context.$nodes.LOOP_CREATE_JOB_REFERRAL.$currentItem;\nlet overAllMessage = \"Something went wrong\";\n\n// Ensure referralResponse is an array\nif (!Array.isArray(referralResponse)) {\n  referralResponse = [];\n}\n\n// Determine message based on status\nif (validateCandidateStatus === \"REFERRED_BUT_NOT_ENDORSED\") {\n  overAllMessage = \"Candidate was already referred to this Job\";\n} else if (validateCandidateStatus === \"REFERRED_AND_ENDORSED\") {\n  overAllMessage = \"Candidate was already referred and endorsed to this Job\";\n} else if (validateCandidateStatus === \"EMAIL_INVALID\") {\n  overAllMessage = \"Invalid Email Address present for referring the candidate\";\n} else if (validateCandidateStatus === \"INTERNAL_CANDIDATE\") {\n  overAllMessage = \"The candidate you are trying to refer is an internal candidate.\";\n}\n\n// Build failure payload\nconst resultPayload = {\n  Status: \"FAILED\",\n  RequisitionId: currentItem.opportunityId,\n  Title: currentItem.title,\n  OverAllMessage: overAllMessage\n};\n\n// Add to response array\n// referralResponse.push(resultPayload);\n\n// Return updated array so it persists\nreturn referralResponse;"
                  },
                  "outcomes": {
                    "success": "end_1769154700905"
                  },
                  "code": "UNABLE_TO_CREATE_REFERRAL_FOR_THESE_JOBS",
                  "id": "1769155655610",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
                {
                  "metadata": {
                    "name": "Create Payload for Attachment and DFF If Present",
                    "returnType": "object",
                    "sourceCode": "const payload = $context.$variables.coreJobReferralPayload; \nconst referrePersonId = $context.$variables.referrerPersonId;\n\n// Initialize attachments only if condition passes\nconst hasValidAttachment = $context.$triggers.REST.$input.documentId || $context.$triggers.REST.$input.candidateAttachment; \n\nif (hasValidAttachment) {\nconst attachmentData = $context.$variables.attachmentData;\n\n  payload.attachments = [\n    {\n      DatatypeCode: \"FILE\",\n      Title: attachmentData.Title,\n       FileName: attachmentData.FileName,\n       FileContents: attachmentData.FileContents\n    }\n  ];\n}\n\n// Initialize referral DFF only if data is present\nconst referralDFF= $context.$triggers.REST.$input.referralDFF;\n\nif (referralDFF) {\n  try {\n    const referralDFFJson =  typeof referralDFF== \"string\" ? JSON.parse(referralDFF) : referralDFF;\n\n    if (referralDFFJson && Object.keys(referralDFFJson).length > 0) {\n      payload.referralDff = referralDFFJson;\n    }\n  } catch (e) {\n    // Optional: log or ignore invalid DFF JSON\n    payload.referralDFFError = \"Invalid referralDFF JSON\";\n  }\n}\n\nif(referrePersonId) {\n   payload.ReferrerPersonId = referrePersonId;\n}\n\nreturn payload;"
                  },
                  "outcomes": {
                    "success": "1769155716370"
                  },
                  "code": "CREATE_PAYLOAD_FOR_ATTACHMENT_AND_DFF_IF_PRESENT",
                  "id": "1769155682072",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
                  "type": "CODE"
                },
