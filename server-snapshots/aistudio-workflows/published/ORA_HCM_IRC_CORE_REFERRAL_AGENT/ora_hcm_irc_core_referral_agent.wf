          "metadata": {
            "name": "Code block for Invalid candidate Email Address retrieved from attachment",
            "returnType": "object",
            "sourceCode": "let referralResponse = $context.$variables.referralResponse;\n\n// Ensure referralResponse is always an array\nif (!Array.isArray(referralResponse)) {\n  referralResponse = [];\n}\n\nconst resultPayload = {\n  Status: \"FAILED\",\n  Subject: \"Invalid email address in referred candidate resume\",\n  OverAllMessage: \"The email address in the referred candidate’s resume is invalid. Please resend the referral with the correct email address.\"\n};\n\n// Add payload to response array\nreferralResponse.push(resultPayload);\n\n// Return updated array so it persists in workflow\nreturn referralResponse[0];"
          },
          "outcomes": {
            "success": "1777909353969"
          },
