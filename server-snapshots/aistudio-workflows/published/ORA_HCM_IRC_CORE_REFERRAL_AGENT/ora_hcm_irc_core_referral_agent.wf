        {
          "metadata": {
            "name": "Create Actual Payload From Input Paramenters",
            "returnType": "object",
            "sourceCode": "const resumeText = $context.$variables.candidateResumeAsString || \"\";\nconst documentId = $context.$triggers.REST.$input.documentId;\nconst fromEmailAddress = $context.$triggers.REST.$input.fromEmailAddress || \"\";\nvar input = $context.$triggers.REST.$input.candidateAttachment || {};\n\n// Extract subject & email content (fallback safe)\nvar subject = input.subject || \"\";\nvar emailContent = input.emailContent || \"\";\n\nconst result = {\n  resumeText: resumeText,\n  fromEmailAddress: fromEmailAddress\n};\n\n// Add documentId ONLY when it is present\nif (documentId !== null && documentId !== undefined && documentId !== \"\") {\n  result.documentId = documentId;\n}\n\nif(subject != null && subject !== undefined && subject !== \"\") {\n  result.emailSubject = subject;\n}\n\nif(emailContent  != null && emailContent  !== undefined && emailContent  !== \"\") {\n  result.emailContent = emailContent;\n}\n\n// Return proper JSON text\nreturn result;"
          },
          "outcomes": {
            "success": "1769152358592"
          },
