          "metadata": {
            "name": "Check If Candidate Attachment has valid Data",
            "returnType": "boolean",
            "sourceCode": "const input = $context.$triggers.REST.$input.candidateAttachment;\n\n// Case 1: Not passed / null / undefined\nif (!input) {\n  return false;\n}\n\n// Case 2: If input is a string, try to parse JSON\nif (typeof input === \"string\") {\n  try {\n    input = JSON.parse(input);\n  } catch (e) {\n    // Invalid JSON string\n    return false;\n  }\n}\n\n// Case 3: Must be a non-empty object\nif (typeof input === \"object\" && !Array.isArray(input)) {\n  // Check if object has at least one key\n  return Object.keys(input).length > 0;\n}\n\nreturn false;"
          },
          "outcomes": {
            "success": "1769152174975"
          },
