        {
          "metadata": {
            "name": "Attachment Code Block",
            "returnType": "object",
            "sourceCode": "var input = $context.$triggers.REST.$input.candidateAttachment || {};\n\n// Extract subject & email content (fallback safe)\nvar subject = input.subject || \"\";\nvar emailContent = input.emailContent || \"\";\n\n// Process attachment array\nvar attachments = [];\nif (Array.isArray(input.attachment)) {\n  for (var i = 0; i < input.attachment.length; i++) {\n    var att = input.attachment[i] || {};\n\n    attachments.push({\n      fileName: att.fileName || \"\",\n      mimeType: att.mimeType || \"\",\n      context: att.context || \"\"\n    });\n  }\n}\n\n// Final output\nreturn {\n  subject: subject,\n  emailContent: emailContent,\n  attachment: attachments\n};"
          },
          "outcomes": {
            "success": "1769152208207"
          },
          "code": "ATTACHMENT_CODE_BLOCK",
          "id": "1777976535797",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare response from rank jobs",
            "returnType": "object",
            "sourceCode": "var response = $context.$nodes.RANK_JOBS.$output || {};\n\nvar result = {};\n\ntry {\n  result =\n    typeof response === \"string\"\n      ? JSON.parse(response)\n      : response;\n} catch (e) {\n  result = {};\n}\n\n// Normalize rankedJobs\nvar rankedJobs = Array.isArray(result.rankedJobs)\n  ? result.rankedJobs\n  : [];\n\n// Normalize summary\nvar summary = result.summary || \"\";\n\n// Normalize status\nvar status = \"\";\n\nif (\n  result.status !== undefined &&\n  result.status !== null\n) {\n  status = String(result.status);\n}\n\n// Return normalized structure\nreturn {\n  rankedJobs: rankedJobs,\n  summary: summary,\n  status: status\n};"
          },
          "outcomes": {
            "success": "1779708062940"
          },
          "code": "PREPARE_RESPONSE_FROM_RANK_JOBS",
          "id": "1779707813780",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Check Matching jobs found",
            "returnType": "boolean",
            "sourceCode": "// Get normalized Rank Jobs output\nvar response = $context.$nodes.PREPARE_RESPONSE_FROM_RANK_JOBS.$output.result || {};\n\n// Return true if rankedJobs exists and has records\nreturn (\n  Array.isArray(response.rankedJobs) &&\n  response.rankedJobs.length > 0\n);"
          },
          "outcomes": {
            "success": "1779708210711"
          },
