                  "metadata": {
                    "name": "Success Output For Referred Jobs",
                    "returnType": "object",
                    "sourceCode": "let referralResponse = $context.$variables.referralResponse;\nconst currentItem = $context.$nodes.LOOP_CREATE_JOB_REFERRAL.$currentItem;\nlet overAllMessage = \"Referral created successfully\";\nlet deeplinkURL = $context.$nodes.LOOP_CREATE_JOB_REFERRAL.CALL_OM_JOB_DETAILS_DEEP_LINK_URL.$output ;\n\n// Ensure referralResponse is an array\nif (!Array.isArray(referralResponse)) {\n  referralResponse = [];\n}\n\n// Build success payload\nconst resultPayload = {\n  Status: \"SUCCESS\",\n  RequisitionId: currentItem.opportunityId,\n  RequisitionNumber: currentItem.opportunityNumber,\n  Title: currentItem.title,\n  OverAllMessage: overAllMessage,\n  DeepLinkURL: deeplinkURL \n};\n\n// Push current payload into array\nreferralResponse.push(resultPayload);\n\n// IMPORTANT: return the updated array so it gets stored back\nreturn referralResponse;"
                  },
