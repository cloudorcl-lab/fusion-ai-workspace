            "sourceCode": "var attachmentData = $context.$nodes.PREPARE_PAYLOAD_FOR_ATTACHMENT_DATA.$output.result || {};\n\nvar candidateTitle= attachmentData.CandidateTitle;\n\nvar seniorityLevel = attachmentData.SeniorityLevel;\n\n// Null / undefined check\nif (candidateTitle === null || candidateTitle === undefined) {\n  return false;\n}\n\n// Convert to string and trim spaces\ncandidateTitle = String(candidateTitle).trim();\n\n// Empty string check\nif (candidateTitle === \"\") {\n  return false;\n}\n\n// Optional safety checks\nif (\n  candidateTitle.toLowerCase() === \"null\" ||\n  candidateTitle.toLowerCase() === \"undefined\"\n) {\n  return false;\n}\n\nif(seniorityLevel  === null || seniorityLevel === undefined) {\n  return false;\n}\n\n// Convert to string and trim spaces\nseniorityLevel = String(seniorityLevel).trim();\n\n// Empty string check\nif (seniorityLevel === \"\") {\n  return false;\n}\n\n// Optional safety checks\nif (\n  seniorityLevel.toLowerCase() === \"null\" ||\n  seniorityLevel.toLowerCase() === \"undefined\"\n) {\n  return false;\n}\n\nreturn true;"
