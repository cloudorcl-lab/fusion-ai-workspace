          "metadata": {
            "name": "Parse Attachment Parsing Agent Response",
            "returnType": "object",
            "sourceCode": "const response = $context.$nodes.CALL_ATTACHMENT_PARSING_AGENT.$output.output;\n\n// Safely parse response\nvar parsed = null;\ntry {\n  parsed = typeof response === \"string\" ? JSON.parse(response) : response;\n} catch (e) {\n  parsed = null;\n}\n\n// Extract candidateBasicInfo\nvar candidateBasicInfo = null;\n\nif (\n  parsed &&\n  parsed.result &&\n  parsed.result.candidateBasicInfo\n) {\n  candidateBasicInfo = parsed.result.candidateBasicInfo;\n} else {\n  candidateBasicInfo = {\n    AddressLine1: \"\",\n    AddressLine2: \"\",\n    AddressLine3: \"\",\n    AreaCode: \"\",\n    City: \"\",\n    Country: \"\",\n    EmailAddress: \"\",\n    FirstName: \"\",\n    LastName: \"\",\n    MiddleNames: \"\",\n    PhoneNumber: \"\",\n    PostalCode: \"\",\n    StateOrProvince: \"\"\n  };\n}\n\nvar result = {\n  candidateBasicInfo: candidateBasicInfo\n};\n\nreturn result;"
          },
