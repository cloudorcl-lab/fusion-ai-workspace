          "code": "LOOP_CREATE_JOB_REFERRAL",
          "id": "1769154700905",
          "inputs": [
            {
              "id": "1769154700908_1",
              "name": "collection",
              "type": "string",
              "value": "{{$context.$nodes.PREPARE_RESPONSE_FROM_RANK_JOBS.$output.result.rankedJobs}}"
            }
          ],
          "type": "LOOP"
        },
        {
          "metadata": {
            "name": "Final Response After Calling Creating Referral Flow",
            "returnType": "object",
            "sourceCode": "// Input: array of responses produced by loop\nvar rawResponses = $context.$nodes.LOOP_CREATE_JOB_REFERRAL.$output;\nvar candidateName = $context.$variables.candidateName;\nlet deeplinkURL = $context.$nodes.CALL_JOB_SEARCH_DEEPLINK_TOOL.$output;\n\n// Final accumulated result\nvar finalResult = {\n  CandidateName: \"\",\n  Subject: \"\",\n  OverAllMessage: \"\",\n  jobs: []\n};\n\n// Track statuses\nvar hasSuccess = false;\nvar hasFailure = false;\nvar hasSystemError = false;\n\n// Safety check\nif (Array.isArray(rawResponses)) {\n\n  for (var i = 0; i < rawResponses.length; i++) {\n\n    try {\n\n      var item = rawResponses[i];\n\n      // Handle null/undefined\n      if (!item) {\n        continue;\n      }\n\n      /* =========================\n         SYSTEM ERROR STRING CASE\n      ========================= */\n      if (\n        typeof item === \"string\" &&\n        item.toLowerCase().indexOf(\"failed with error\") !== -1\n      ) {\n        hasSystemError = true;\n        continue;\n      }\n\n      // Parse safely\n      var parsed =\n        typeof item === \"string\"\n          ? JSON.parse(item)\n          : item;\n\n      var resultsArray = [];\n\n      /* =========================\n         ARRAY RESPONSE\n      ========================= */\n      if (parsed && Array.isArray(parsed.result)) {\n        resultsArray = parsed.result;\n      }\n\n      /* =========================\n         SINGLE OBJECT RESPONSE\n      ========================= */\n      else if (parsed && parsed.Status) {\n        resultsArray = [parsed];\n      }\n\n      /* =========================\n         PROCESS RESULTS\n      ========================= */\n      for (var j = 0; j < resultsArray.length; j++) {\n\n        var r = resultsArray[j];\n\n        if (!r) {\n          continue;\n        }\n\n        finalResult.jobs.push(r);\n\n        if (r.Status === \"SUCCESS\") {\n          hasSuccess = true;\n        }\n        else if (\n          r.Status === \"FAILED\" ||\n          r.Status === \"ERROR\"\n        ) {\n          hasFailure = true;\n        }\n      }\n\n    }\n    catch (e) {\n\n      // Any parse exception treated as failure\n      hasSystemError = true;\n\n    }\n\n  }\n}\n\n/* =========================\n   SUBJECT + MESSAGE\n========================= */\n\nif (hasSystemError) {\n\n  finalResult.Subject =\n    \"Problem processing referral\";\n\n  finalResult.OverAllMessage =\n    \"An unexpected error occurred while processing the referral, so it could not be completed.\";\n\n  finalResult.DeepLinkURL  = deeplinkURL;\n\n  finalResult.Status = \"FAILED\";\n\n}\nelse if (hasSuccess && hasFailure) {\n\n  finalResult.Subject =\n    \"Candidate Referral Partially Completed\";\n\n  finalResult.OverAllMessage =\n    \"Some referrals were successful while others failed.\";\n\n}\nelse if (hasSuccess) {\n\n  finalResult.Subject =\n    \"Thanks for your referral\";\n\n  finalResult.OverAllMessage =\n    \"Thank you for your referral. The candidate has been successfully referred for the following job(s):\";\n\n}\nelse if (hasFailure) {\n\n  finalResult.Subject =\n    \"Problem processing referral\";\n\n  finalResult.OverAllMessage =\n    \"An unexpected error occurred while processing the referral, so it could not be completed.\";\n\n  finalResult.DeepLinkURL  = deeplinkURL;\n\n  finalResult.Status = \"FAILED\";\n\n}\nelse {\n\n  finalResult.Subject =\n    \"No matching jobs available for the referred candidate\";\n\n  finalResult.OverAllMessage =\n    \"Thanks for the referral. However, based on the details in the attached resume, there are no matching jobs currently available for this candidate.\";\n\n}\n\n/* =========================\n   Candidate name assignment\n========================= */\n\nif (\n  candidateName &&\n  typeof candidateName === \"string\" &&\n  candidateName.trim() !== \"\"\n) {\n  finalResult.CandidateName =\n    candidateName.trim();\n}\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "FINAL_RESPONSE_AFTER_CALLING_CREATING_REFERRAL_FLOW",
          "id": "1769154732806",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "List of jobs that need to be referred",
            "returnType": "object",
            "sourceCode": "// Direct response from RANK_JOBS node (already clean JSON)\nvar llmResponse = $context.$nodes.RANK_JOBS.$output;\nvar candidateName = $context.$variables.candidateName;\n\n// Extract jobs\nvar jobs = llmResponse.rankedJobs || [];\n\n// Map result\nvar result = [];\nfor (var i = 0; i < jobs.length; i++) {\n  var job = jobs[i];\n  result.push({\n    RequisitionId: job.opportunityId,\n    Title: job.title,\n    RequisitionNumber: job.opportunityNumber,\n    Status: \"READY_FOR_REFERRAL\"\n  });\n}\n\n// Build Subject & OverAllMessage\nvar subject = \"\";\nvar overAllMessage = \"\";\n\nif (result.length > 0) {\n  subject = \"Matching Jobs Found – Ready for Referral\";\n  overAllMessage = \"Top matching jobs have been identified for the candidate.\";\n} else {\n  subject = \"No Matching Jobs Found\";\n  overAllMessage = \"No suitable jobs were found based on the candidate profile.\";\n}\n\n// Final response\nreturn {\n  CandidateName: candidateName ,\n  Subject: subject,\n  OverAllMessage: overAllMessage,\n  jobs: result\n};"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "LIST_OF_JOBS_THAT_NEED_TO_BE_REFERRED",
          "id": "1769154671279",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"output\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "No Suitable Jobs found after ranked jobs evaluation",
            "returnType": "object",
            "sourceCode": "let referralResponse = $context.$variables.referralResponse;\nlet deeplinkURL = $context.$nodes.CALL_JOB_SEARCH_DEEPLINK_TOOL.$output;\n\n// Get RankJobs normalized response\nlet rankJobsResponse =\n$context.$nodes.PREPARE_RESPONSE_FROM_RANK_JOBS.$output.result || {};\n\n// Ensure referralResponse is always an array\nif (!Array.isArray(referralResponse)) {\nreferralResponse = [];\n}\n\n// Default values\nlet subject = \"No matching jobs available for the referred candidate\";\nlet status = \"FAILED\";\n\nlet overAllMessage = \"Thanks for the referral. However, based on the details in the attached resume, there are no matching jobs currently available for this candidate.\";\n\n// Check status from RankJobs response\nif (\nrankJobsResponse.status &&\nString(rankJobsResponse.status).trim() === \"LOCATION_NOT_FOUND\"\n) {\nstatus = \"LOCATION_NOT_FOUND\",\n\nsubject = \"Preferred Location Needed for Your Referral\";\n\noverAllMessage = rankJobsResponse.summary || overAllMessage;\n}\n\nconst resultPayload = {\nStatus: status,\nSubject: subject,\nOverAllMessage: overAllMessage,\nDeepLinkURL: deeplinkURL\n};\n\n// Add payload to response array\nreferralResponse.push(resultPayload);\n\n// Return updated array so it persists in workflow\nreturn referralResponse[0];"
          },
          "outcomes": {
            "success": "1779708642349"
          },
