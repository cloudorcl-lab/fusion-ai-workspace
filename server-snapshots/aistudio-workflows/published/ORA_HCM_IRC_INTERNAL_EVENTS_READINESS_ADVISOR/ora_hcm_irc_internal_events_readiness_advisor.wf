              "code": "ORA_LLM_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelName": "GPT-4.1 mini",
              "provider": "CERT_PREMIUM"
            },
            "name": "Gather Event Fit And Prep Plan"
          },
          "outcomes": {
            "success": "end"
          },
          "code": "GATHER_EVENT_FIT_AND_PREP_PLAN",
          "id": "1764904822388",
          "inputs": [
            {
              "id": "1764904822389_1",
              "name": "prompt",
              "type": "string",
              "value": "Your task is to determine the fit between an Employee and an Event. Use *Event Details* and *Employee Profile* as context for the analysis.\n\n#Event Details \n {{$context.$triggers.REST.$input.EventDetailsObject}}\n\n#Employee Profile\n{{$context.$variables.EmployeeProfile}}\n\nBased on your fit analysis, generate the following output- readiness score, recommended pre-requisities and skill recommendations.\nKeep the explanations concise with a one line summary"
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"title\": \"EventEmployeeFitAnalysisResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"EventEmployeeFitAnalysis\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"ReadinessScore\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"score\": {\n              \"type\": \"number\",\n              \"minimum\": 0,\n              \"maximum\": 100,\n              \"description\": \"Numeric readiness score from 0–100\"\n            },\n            \"justification\": {\n              \"type\": \"string\",\n              \"description\": \"Explanation for the calculated readiness score\"\n            }\n          },\n          \"required\": [\"score\", \"justification\"]\n        },\n        \"RecommendedPrerequisites\": {\n          \"type\": \"array\",\n          \"description\": \"List of prerequisites the employee should complete\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"name\": {\n                \"type\": \"string\",\n                \"description\": \"Name of the prerequisite\"\n              },\n              \"reason\": {\n                \"type\": \"string\",\n                \"description\": \"Why this prerequisite is needed\"\n              }\n            },\n            \"required\": [\"name\", \"reason\"]\n          }\n        },\n        \"SkillRecommendations\": {\n          \"type\": \"array\",\n          \"description\": \"List of skills the employee should develop and associated actions\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"skill\": {\n                \"type\": \"string\",\n                \"description\": \"Identified skill needing improvement\"\n              },\n              \"gapAssessment\": {\n                \"type\": \"string\",\n                \"description\": \"Explanation of the gap between event requirements and employee skill\"\n              },\n              \"action\": {\n                \"type\": \"string\",\n                \"description\": \"Recommended action to address the skill gap\"\n              }\n            },\n            \"required\": [\"skill\", \"gapAssessment\", \"action\"]\n          }\n        }\n      },\n      \"required\": [\n        \"ReadinessScore\",\n        \"RecommendedPrerequisites\",\n        \"SkillRecommendations\"\n      ]\n    }\n  },\n  \"required\": [\"EventEmployeeFitAnalysis\"]\n}",
          "type": "LLM"
        },
        {
          "metadata": {
            "name": "Get Employee Profile Details",
            "workflowCode": "ORA_HCM_IRC_SKILLS_EXTRACTOR"
          },
          "outcomes": {
            "success": "1764974858738"
          },
          "code": "GET_EMPLOYEE_SKILLS",
          "convergenceTargetId": "1764903885571",
          "id": "1764875466697",
          "inputs": [
            {
              "id": "1765377783284_1",
              "name": "message",
              "type": "string",
              "value": "Retrieve employee profile skills for the event readiness assessment."
            }
          ],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"input\": {\n      \"type\": \"string\"\n    },\n    \"output\": {\n      \"type\": \"string\"\n    },\n    \"error\": {\n      \"type\": \"null\"\n    },\n    \"followUpQuestions\": {\n      \"type\": \"array\",\n      \"items\": [\n        {\n          \"type\": \"string\"\n        },\n        {\n          \"type\": \"string\"\n        }\n      ]\n    },\n    \"jobId\": {\n      \"type\": \"string\"\n    },\n    \"conversationId\": {\n      \"type\": \"string\"\n    },\n    \"traceId\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"supportingChunks\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"nodes\": {\n      \"type\": \"array\",\n      \"items\": {}\n    },\n    \"waitingToolCode\": {\n      \"type\": \"null\"\n    },\n    \"workflowCode\": {\n      \"type\": \"string\"\n    },\n    \"workflowVersion\": {\n      \"type\": \"integer\"\n    },\n    \"workflowStatus\": {\n      \"type\": \"string\"\n    },\n    \"startDate\": {\n      \"type\": \"integer\"\n    },\n    \"endTime\": {\n      \"type\": \"integer\"\n    },\n    \"createDate\": {\n      \"type\": \"string\"\n    },\n    \"endDate\": {\n      \"type\": \"string\"\n    },\n    \"timeTaken\": {\n      \"type\": \"integer\"\n    },\n    \"inputTokenCount\": {\n      \"type\": \"integer\"\n    },\n    \"outputTokenCount\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": []\n}",
          "type": "WORKFLOW"
