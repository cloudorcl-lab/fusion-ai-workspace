          "code": "FIN_GL_CONDITION_IF_AV_FILTERS_ERROR",
          "convergenceTargetId": "end",
          "id": "linear_1037_if_av_filters_error",
          "inputs": [
            {
              "id": "1776127833600_1",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_GL_CODE_DETERMINE_AV_FILTERS_ERROR.$output.result}}"
