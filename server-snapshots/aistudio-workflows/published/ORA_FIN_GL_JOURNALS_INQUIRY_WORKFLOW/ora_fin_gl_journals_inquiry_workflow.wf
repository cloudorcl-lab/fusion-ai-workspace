{
  "workflowId": "300000331067528",
  "workflowCode": "ORA_FIN_GL_JOURNALS_INQUIRY_WORKFLOW",
  "name": "Journal Activity Explanation Assistance",
  "description": "The Journal Activity Explanation Assistance agent is dedicated to addressing all journal-related queries within the Oracle Fusion environment. This agent specializes in handling user requests related to journal entry inquiries and searches, journal posting status and validation, journal source and category, and journal approval workflows. It also manages follow-up queries concerning journal summaries, journal details.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"success\",\n        \"error\",\n        \"followup\"\n      ]\n    },\n    \"successMessage\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"data\",\n        \"no_data\",\n        \"async\"\n      ]\n    },\n    \"errorDetails\": {\n      \"type\": \"object\"\n    },\n    \"followupMessage\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"shared\": {\n          \"type\": \"object\"\n        },\n        \"private\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"lastUsedQuery\": {\n              \"type\": \"object\"\n            },\n            \"lastUsedData\": {\n              \"type\": \"object\"\n            }\n          }\n        }\n      },\n      \"required\": [\n        \"shared\",\n        \"private\"\n      ],\n      \"additionalProperties\": true\n    },\n    \"hierarchyResolverMessage\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"status\",\n    \"state\"\n  ],\n  \"additionalProperties\": false,\n  \"allOf\": [\n    {\n      \"if\": {\n        \"properties\": {\n          \"status\": {\n            \"const\": \"success\"\n          }\n        }\n      },\n      \"then\": {\n        \"required\": [\n          \"successMessage\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"status\": {\n            \"const\": \"error\"\n          }\n        }\n      },\n      \"then\": {\n        \"required\": [\n          \"errorDetails\"\n        ]\n      }\n    },\n    {\n      \"if\": {\n        \"properties\": {\n          \"status\": {\n            \"const\": \"followup\"\n          }\n        }\n      },\n      \"then\": {\n        \"required\": [\n          \"followupMessage\"\n        ]\n      }\n    }\n  ]\n}",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "metadata": {
            "description": "Starts the journal inquiry workflow.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Start"
          },
          "outcomes": {
            "success": "linear_1002_input_parser"
          },
          "code": "FIN_GL_START",
          "id": "start",
          "inputs": [],
          "type": "START"
        },
        {
          "metadata": {
            "description": "Maps the request and saved state to journal context.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Parse Input",
            "returnType": "object",
            "sourceCode": "const input = $context.$triggers.REST.$input ?? {};\n\nconst parseMaybeJson = (value, fallback) => {\n  if (value === null || value === undefined || value === \"\") {\n    return fallback;\n  }\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return fallback;\n    }\n  }\n  return value;\n};\n\nconst asObject = (value) =>\n  value !== null && typeof value === \"object\" && !Array.isArray(value) ? value : {};\nconst asHierarchyOverrides = (value) => {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  return asObject(value);\n};\n\nconst normalizeChatHistory = (value) => {\n  const parsedValue = parseMaybeJson(value, value);\n  if (Array.isArray(parsedValue)) {\n    return parsedValue;\n  }\n  if (parsedValue === null || parsedValue === undefined || parsedValue === \"\") {\n    return [];\n  }\n  return [parsedValue];\n};\n\nconst getLatestUserInput = (chatHistory) => {\n  const systemInputMessage = $context.$system?.$inputMessage;\n  if (typeof systemInputMessage === \"string\" && systemInputMessage.trim() !== \"\") {\n    return systemInputMessage;\n  }\n  if (systemInputMessage && typeof systemInputMessage === \"object\") {\n    const content =\n      systemInputMessage.content ??\n      systemInputMessage.message ??\n      systemInputMessage.text ??\n      systemInputMessage.data;\n    if (typeof content === \"string\" && content.trim() !== \"\") {\n      return content;\n    }\n  }\n  if (typeof input.userInput === \"string\" && input.userInput.trim() !== \"\") {\n    return input.userInput;\n  }\n  const chatMessages = Array.isArray(chatHistory) ? chatHistory : [];\n  for (let index = chatMessages.length - 1; index >= 0; index -= 1) {\n    const item = chatMessages[index];\n    const role = String(item?.role ?? item?.type ?? item?.author ?? \"\").toLowerCase();\n    if (role && role !== \"user\" && role !== \"human\") {\n      continue;\n    }\n    const content = item?.content ?? item?.message ?? item?.text ?? item?.data;\n    if (typeof content === \"string\" && content.trim() !== \"\") {\n      return content;\n    }\n  }\n  return \"\";\n};\n\nconst normalizeAlias = (value) =>\n  String(value ?? \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/[\\s_-]+/g, \"\");\n\nconst addAlias = (aliases, alias, dimensionName) => {\n  const normalizedAlias = normalizeAlias(alias);\n  const normalizedDimension = String(dimensionName ?? \"\").trim();\n  if (normalizedAlias && normalizedDimension && !aliases[normalizedAlias]) {\n    aliases[normalizedAlias] = normalizedDimension;\n  }\n};\n\nconst addAliasesFromSegment = (aliases, segmentKey, segmentDefinition = {}) => {\n  const dimensionName = String(segmentKey ?? \"\").trim();\n  if (!dimensionName) {\n    return;\n  }\n\n  addAlias(aliases, dimensionName, dimensionName);\n  addAlias(aliases, segmentDefinition.key, dimensionName);\n  addAlias(aliases, segmentDefinition.name, dimensionName);\n  addAlias(aliases, segmentDefinition.label, dimensionName);\n  addAlias(aliases, segmentDefinition.displayName, dimensionName);\n  addAlias(aliases, segmentDefinition.dimensionName, dimensionName);\n  addAlias(aliases, segmentDefinition.columnName, dimensionName);\n  addAlias(aliases, segmentDefinition.attributeName, dimensionName);\n\n  const qualifiers = Array.isArray(segmentDefinition.qualifiers) ? segmentDefinition.qualifiers : [];\n  for (const qualifier of qualifiers) {\n    addAlias(aliases, qualifier, dimensionName);\n  }\n};\n\nconst addAliasesFromDimensions = (aliases, dimensions = {}) => {\n  if (!dimensions || typeof dimensions !== \"object\" || Array.isArray(dimensions)) {\n    return;\n  }\n\n  for (const [dimensionKey, dimensionDefinition] of Object.entries(dimensions)) {\n    const definition = asObject(dimensionDefinition);\n    const dimensionName = String(\n      definition.segmentKey ??\n        definition.segmentName ??\n        definition.key ??\n        definition.name ??\n        definition.dimensionName ??\n        dimensionKey\n    ).trim();\n\n    if (!dimensionName) {\n      continue;\n    }\n\n    addAlias(aliases, dimensionKey, dimensionName);\n    addAlias(aliases, definition.key, dimensionName);\n    addAlias(aliases, definition.name, dimensionName);\n    addAlias(aliases, definition.label, dimensionName);\n    addAlias(aliases, definition.displayName, dimensionName);\n    addAlias(aliases, definition.dimensionName, dimensionName);\n    addAlias(aliases, definition.columnName, dimensionName);\n    addAlias(aliases, definition.attributeName, dimensionName);\n\n    const qualifiers = Array.isArray(definition.qualifiers) ? definition.qualifiers : [];\n    for (const qualifier of qualifiers) {\n      addAlias(aliases, qualifier, dimensionName);\n    }\n  }\n};\n\nconst collectMetadataAliases = (source, aliases, seen = []) => {\n  if (!source || typeof source !== \"object\" || seen.includes(source)) {\n    return;\n  }\n  seen.push(source);\n\n  const coaSegments = asObject(source.chartOfAccounts).segments;\n  if (coaSegments && typeof coaSegments === \"object\" && !Array.isArray(coaSegments)) {\n    for (const [segmentKey, segmentDefinition] of Object.entries(coaSegments)) {\n      addAliasesFromSegment(aliases, segmentKey, asObject(segmentDefinition));\n    }\n  }\n\n  const dimensions = source.dimensions;\n  if (dimensions && typeof dimensions === \"object\" && !Array.isArray(dimensions)) {\n    addAliasesFromDimensions(aliases, dimensions);\n  }\n\n  for (const child of Object.values(source)) {\n    collectMetadataAliases(child, aliases, seen);\n  }\n};\n\nconst buildDimensionAliases = () => {\n  const aliases = {};\n  const stateLastUsedQuery =\n    typeof incomingLastUsedQuery !== \"undefined\"\n      ? incomingLastUsedQuery\n      : typeof lastUsedQuery !== \"undefined\"\n        ? lastUsedQuery\n        : {};\n  const stateLastUsedData =\n    typeof incomingLastUsedData !== \"undefined\"\n      ? incomingLastUsedData\n      : typeof lastUsedData !== \"undefined\"\n        ? lastUsedData\n        : {};\n  const variables = $context.$variables ?? {};\n  const sources = [\n    stateLastUsedQuery.queryResponse,\n    stateLastUsedQuery.queryPayload,\n    stateLastUsedData.dataResponse,\n    stateLastUsedData.dataPayload,\n    variables.queryResponse,\n    variables.queryPayload,\n    variables.dataResponse,\n    variables.dataPayload,\n    variables.state?.private?.lastUsedQuery?.queryResponse,\n    variables.state?.private?.lastUsedQuery?.queryPayload,\n    variables.state?.private?.lastUsedData?.dataResponse,\n    variables.state?.private?.lastUsedData?.dataPayload\n  ];\n\n  for (const source of sources) {\n    collectMetadataAliases(source, aliases);\n  }\n\n  return aliases;\n};\n\nconst resolveDimensionName = (value) => {\n  const rawDimensionName = String(value ?? \"\").trim();\n  if (!rawDimensionName) {\n    return \"\";\n  }\n\n  const aliases = buildDimensionAliases();\n  return aliases[normalizeAlias(rawDimensionName)] || rawDimensionName;\n};\n\nconst normalizeCoaBreakdown = (value) => {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (typeof value === \"string\") {\n    const matches = String(value || \"\").match(/\\([^()]*\\)/g) || [];\n    const parsedBreakdowns = [];\n    for (const match of matches) {\n      const parts = match.slice(1, -1).split(\"||\").map((part) => part.trim());\n      const dimensionName = resolveDimensionName(parts[0]);\n      if (dimensionName) {\n        parsedBreakdowns.push({\n          dimensionName,\n          expandLevel: Number(parts[1]) === -1 ? -1 : 1,\n          memberNames: parts[2] ? parts[2].split(\",\").map((memberName) => String(memberName).trim()).filter(Boolean) : []\n        });\n      }\n    }\n    return parsedBreakdowns;\n  }\n  if (value && typeof value === \"object\") {\n    if (Array.isArray(value.value)) {\n      return value.value;\n    }\n    if (Array.isArray(value.coaBreakdown)) {\n      return value.coaBreakdown;\n    }\n    if (Array.isArray(value.breakdownBy)) {\n      return value.breakdownBy;\n    }\n    if (Array.isArray(value.breakdowns)) {\n      return value.breakdowns;\n    }\n  }\n  return [];\n};\n\nconst normalizeSortBy = (value) => {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n\n  const result = [];\n  const seen = new Set();\n\n  for (const item of value) {\n    if (!item || typeof item !== \"object\" || Array.isArray(item)) {\n      continue;\n    }\n\n    const field = String(item.field ?? \"\").trim();\n    if (!field) {\n      continue;\n    }\n\n    const orderText = String(item.order ?? \"asc\").trim().toLowerCase();\n    const order = orderText === \"desc\" || orderText === \"descending\" ? \"desc\" : \"asc\";\n    const key = field.toLowerCase();\n\n    if (!seen.has(key)) {\n      seen.add(key);\n      result.push({ field, order });\n    }\n  }\n\n  return result;\n};\n\nconst chatHistory = normalizeChatHistory(input.chatHistory);\nconst additionalContext = asObject(parseMaybeJson(input.additionalContext, input.additionalContext ?? {}));\nconst shouldSkipToExecution =\n  additionalContext &&\n  additionalContext.bossExtract !== null &&\n  typeof additionalContext.bossExtract === \"object\" &&\n  !Array.isArray(additionalContext.bossExtract);\nconst performObjectDetermination = !shouldSkipToExecution;\nconst performQueryGeneration = !shouldSkipToExecution;\nconst performDataRetrieval = true;\nconst incomingState = asObject(parseMaybeJson(input.state, input.state ?? {}));\nconst sharedState = asObject(incomingState.shared);\nconst privateState = asObject(incomingState.private);\nconst lastUsedQuery = asObject(privateState.lastUsedQuery);\nconst lastUsedData = asObject(privateState.lastUsedData);\n\nconst legacyDomainSlice = asObject(incomingState.domainSlice);\nconst legacyLastUsedQuery = asObject(legacyDomainSlice.lastUsedQuery);\nconst legacyNlInputs = asObject(legacyLastUsedQuery.nlInputs);\nconst legacyLastUsedData = asObject(legacyDomainSlice.lastUsedData);\nconst legacyDataOutput = asObject(legacyLastUsedData.dataOutput);\n\nconst stateHierarchyOverrides = asHierarchyOverrides(sharedState?.hierarchy?.hierarchyOverrides);\nconst hierarchyOverrides = Array.isArray(stateHierarchyOverrides) && stateHierarchyOverrides.length > 0\n  ? stateHierarchyOverrides\n  : Object.keys(asObject(stateHierarchyOverrides)).length > 0\n    ? stateHierarchyOverrides\n    : [];\nconst analyticViewNameUsed = String(\n  lastUsedQuery.analyticViewNameUsed ||\n    (legacyNlInputs.viewType === \"AV\" ? legacyNlInputs.viewName : \"\") ||\n    \"\"\n);\nconst businessViewNameUsed = analyticViewNameUsed\n  ? \"\"\n  : String(\n      lastUsedQuery.businessViewNameUsed ||\n        (legacyNlInputs.viewType === \"BV\" ? legacyNlInputs.viewName : \"\") ||\n        \"\"\n    );\n\nconst queryResponse =\n  Object.keys(asObject(lastUsedQuery.queryResponse)).length > 0\n    ? asObject(lastUsedQuery.queryResponse)\n    : asObject(legacyLastUsedQuery.nlResponse);\nconst queryPayload =\n  Object.keys(asObject(lastUsedQuery.queryPayload)).length > 0\n    ? asObject(lastUsedQuery.queryPayload)\n    : asObject(legacyLastUsedQuery.queryPayload);\nconst dataResponse =\n  lastUsedData.dataResponse !== undefined && lastUsedData.dataResponse !== null\n    ? lastUsedData.dataResponse\n    : legacyDataOutput.data ?? {};\nconst dataPayload =\n  Object.keys(asObject(lastUsedData.dataPayload)).length > 0\n    ? asObject(lastUsedData.dataPayload)\n    : asObject(legacyLastUsedData.dataPayload);\nconst queryTitle =\n  typeof lastUsedQuery.queryTitle === \"string\" && lastUsedQuery.queryTitle.trim() !== \"\"\n    ? lastUsedQuery.queryTitle\n    : getLatestUserInput(chatHistory);\n\nconst sortBy = normalizeSortBy(\n  sharedState.sortBy !== undefined && sharedState.sortBy !== null\n    ? sharedState.sortBy\n    : incomingState.sortBy !== undefined && incomingState.sortBy !== null\n      ? incomingState.sortBy\n      : dataPayload.sortBy\n);\n\nconst turnContext = {\n  ...additionalContext,\n  ledgerContext: additionalContext.ledgerContext ?? legacyNlInputs.ledger ?? \"\",\n  ledgerCategory: additionalContext.ledgerCategory ?? \"\",\n  chartOfAccountsId: additionalContext.chartOfAccountsId ?? legacyNlInputs.coaId ?? 0,\n  selectedHierarchies: hierarchyOverrides,\n  hierarchyOverrides,\n  filter: additionalContext?.queries?.[0]?.query?.filter ?? additionalContext.filter ?? \"\",\n  conversationId: additionalContext.conversationId ?? \"\",\n  processExecutionId: additionalContext.processExecutionId ?? \"\",\n  intentConfirmationMessage: additionalContext.intentConfirmationMessage ?? \"\"\n};\n\nconst returnObj = {\n  userInput: getLatestUserInput(chatHistory),\n  chatHistory,\n  additionalContext,\n  turnContext,\n  inputState: incomingState,\n  queryResponse,\n  queryPayload,\n  dataResponse,\n  dataPayload,\n  coaBreakdown: normalizeCoaBreakdown(\n    sharedState.coaBreakdown !== undefined && sharedState.coaBreakdown !== null\n      ? sharedState.coaBreakdown\n      : incomingState.coaBreakdown\n  ),\n  sortBy,\n  analyticViewNameUsed,\n  businessViewNameUsed,\n  queryTitle,\n  shouldSkipToExecution,\n  performObjectDetermination,\n  performQueryGeneration,\n  performDataRetrieval\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "linear_1003_set_internal_conversation_variables"
          },
          "code": "FIN_GL_CODE_PARSE_INPUT",
          "id": "linear_1002_input_parser",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
