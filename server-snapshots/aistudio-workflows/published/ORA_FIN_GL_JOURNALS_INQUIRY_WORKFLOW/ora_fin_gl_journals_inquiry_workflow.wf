          "code": "FIN_GL_BO_FUNCTION_GET_DETAIL_FILTERS",
          "id": "linear_1023_get_bv_filters",
          "inputs": [
            {
              "id": "1779322778068_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.FIN_GL_CODE_PREPARE_DETAIL_QUERY_PAYLOAD.$output.result.queryPayload}}"
