            "name": "Prepare Detail Data Payload",
            "returnType": "object",
            "sourceCode": "const turnContext = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.turnContext ?? new Object();\nconst queryResponse = $context.$variables.queryResponse ?? new Object();\nconst queryPayload = $context.$variables.queryPayload ?? new Object();\nconst parserResult = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result ?? new Object();\nconst detailRequirements = $context.$nodes.FIN_GL_CODE_RESOLVE_DETAIL_ANALYSIS?.$output?.result ?? new Object();\nconst detailViewName = detailRequirements.businessView || $context.$variables.businessViewNameUsed || \"\";\n// Keep this collector aligned with the response processor so retry uses the same failing status.\nconst NO_DATA_RESULT_CODE = \"GL_LA_INQ_DATA_NO_DATA\";\nconst isResultStatus = (value) =>\n  value && typeof value === \"object\" && !Array.isArray(value) &&\n  typeof value.category === \"string\";\nconst addResultStatus = (statuses, value) => {\n  if (isResultStatus(value)) {\n    statuses.push(value);\n  }\n};\nconst collectResultStatuses = (value, viewName) => {\n  const container = value?.result ?? value;\n  const statuses = [];\n\n  if (!container || typeof container !== \"object\" || Array.isArray(container)) {\n    return statuses;\n  }\n\n  addResultStatus(statuses, container);\n  addResultStatus(statuses, container.resultStatus);\n\n  const dataKey = viewName ? `${viewName}Data` : \"\";\n  const bvData = dataKey ? container[dataKey] : undefined;\n  addResultStatus(statuses, bvData?.resultStatus);\n  return statuses;\n};\nconst isNoDataResultStatus = (value) =>\n  isResultStatus(value) && value.code === NO_DATA_RESULT_CODE;\nconst isRetryableResultStatus = (value) =>\n  isResultStatus(value) &&\n  String(value.category).toLowerCase() === \"systemerror\" &&\n  value.recovery?.recoverable === true &&\n  Number(value.recovery?.retryAttemptCount) === 1;\nconst isBlockingResultStatus = (value) =>\n  isResultStatus(value) &&\n  !isNoDataResultStatus(value) &&\n  [\"usererror\", \"systemerror\", \"information\"].includes(String(value.category).toLowerCase());\nconst previousDataStatuses = collectResultStatuses($context.$nodes.FIN_GL_BO_FUNCTION_GET_DETAIL_DATA?.$output, detailViewName);\nconst previousRetryableStatus = previousDataStatuses.find(isRetryableResultStatus);\n// Retry count comes from the same enhanced resultStatus that triggered retry; legacy responses stay at 0.\nconst parsedRetryAttemptCount = Number(previousRetryableStatus?.recovery?.retryAttemptCount ?? 0);\nconst retryAttemptCount = Number.isFinite(parsedRetryAttemptCount)\n  ? parsedRetryAttemptCount\n  : 0;\nconst normalizeQueryValue = (value) => {\n  if (typeof value === \"string\") {\n    try {\n      const parsedValue = JSON.parse(value);\n      return parsedValue !== null && typeof parsedValue === \"object\" && !Array.isArray(parsedValue) ? parsedValue : new Object();\n    } catch (error) {\n      return new Object();\n    }\n  }\n  return value !== null && typeof value === \"object\" && !Array.isArray(value) ? value : new Object();\n};\nconst cloneObject = (value) => JSON.parse(JSON.stringify(normalizeQueryValue(value)));\nconst buildDetailQuery = (value) => {\n  const query = cloneObject(value);\n  delete query.intentDetails;\n  delete query.hierarchyResolverMessage;\n  delete query.reasoning;\n  return query;\n};\nconst firstQuery = Array.isArray(queryResponse.queries) ? queryResponse.queries[0] : undefined;\nconst title = String($context.$variables.queryTitle || \"journals data\").slice(0, 100);\nconst queries = [buildDetailQuery(firstQuery)];\nconst normalizeAlias = (value) =>\n  String(value ?? \"\")\n    .trim()\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .toLowerCase()\n    .replace(/[_-]+/g, \" \")\n    .replace(/[^a-z0-9]+/gi, \"\");\nconst normalizeSortBy = (value) => {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n\n  const result = [];\n  const seen = new Set();\n\n  for (const item of value) {\n    if (!item || typeof item !== \"object\" || Array.isArray(item)) {\n      continue;\n    }\n\n    const field = String(item.field ?? \"\").trim();\n    if (!field) {\n      continue;\n    }\n\n    const orderText = String(item.order ?? \"asc\").trim().toLowerCase();\n    const order = orderText === \"desc\" || orderText === \"descending\" ? \"desc\" : \"asc\";\n    const key = normalizeAlias(field);\n\n    if (!seen.has(key)) {\n      seen.add(key);\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = order;\n      result.push(sortItem);\n    }\n  }\n\n  return result;\n};\nconst addFieldAlias = (aliases, alias, fieldKey) => {\n  const normalizedAlias = normalizeAlias(alias);\n  const resolvedFieldKey = String(fieldKey ?? \"\").trim();\n  if (normalizedAlias && resolvedFieldKey && !aliases[normalizedAlias]) {\n    aliases[normalizedAlias] = resolvedFieldKey;\n  }\n};\nconst addFieldKeyAliases = (aliases, fieldKey) => {\n  const key = String(fieldKey ?? \"\").trim();\n  if (key) {\n    addFieldAlias(aliases, key, key);\n  }\n};\nconst splitFieldKey = (fieldKey) =>\n  String(fieldKey ?? \"\")\n    .trim()\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .split(/\\s+/)\n    .filter(Boolean);\nconst addUniqueSuffixAliases = (aliases, fieldKeys) => {\n  const owners = new Object();\n\n  for (const fieldKey of fieldKeys) {\n    const key = String(fieldKey ?? \"\").trim();\n    const tokens = splitFieldKey(key);\n\n    for (let index = 1; index < tokens.length; index += 1) {\n      const alias = normalizeAlias(tokens.slice(index).join(\" \"));\n      if (!alias) {\n        continue;\n      }\n\n      if (owners[alias] && owners[alias] !== key) {\n        owners[alias] = \"\";\n      } else if (!owners[alias]) {\n        owners[alias] = key;\n      }\n    }\n  }\n\n  for (const [alias, fieldKey] of Object.entries(owners)) {\n    if (fieldKey) {\n      addFieldAlias(aliases, alias, fieldKey);\n    }\n  }\n};\nconst resolveAvailableFieldKey = (aliases, fieldKey, availableFieldKeys) => {\n  const key = String(fieldKey ?? \"\").trim();\n  if (!key) {\n    return \"\";\n  }\n\n  if (!availableFieldKeys || availableFieldKeys.size === 0 || availableFieldKeys.has(key)) {\n    return key;\n  }\n\n  return aliases[normalizeAlias(key)] || \"\";\n};\nconst addAvailableFieldAlias = (aliases, alias, fieldKey, availableFieldKeys) => {\n  const resolvedFieldKey = resolveAvailableFieldKey(aliases, fieldKey, availableFieldKeys);\n  if (resolvedFieldKey) {\n    addFieldAlias(aliases, alias, resolvedFieldKey);\n  }\n};\nconst getObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : new Object());\nconst addCoaSegmentAliases = (aliases, segmentKey, segmentDefinition, availableFieldKeys) => {\n  const definition = getObject(segmentDefinition);\n  const fieldKey = String(segmentKey ?? definition.key ?? definition.name ?? \"\").trim();\n\n  if (!fieldKey) {\n    return;\n  }\n\n  addAvailableFieldAlias(aliases, fieldKey, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.key, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.name, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.label, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.displayName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.dimensionName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.segmentName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.segmentCode, fieldKey, availableFieldKeys);\n};\nconst collectCoaSegmentAliases = (source, aliases, availableFieldKeys) => {\n  const container = source?.result ?? source ?? new Object();\n  const metadata = container.avExtractResult?.metadata ?? container.metadata ?? new Object();\n  const segments = metadata.chartOfAccounts?.segments;\n\n  if (!segments || typeof segments !== \"object\" || Array.isArray(segments)) {\n    return;\n  }\n\n  for (const [segmentKey, segmentDefinition] of Object.entries(segments)) {\n    addCoaSegmentAliases(aliases, segmentKey, segmentDefinition, availableFieldKeys);\n  }\n};\nconst addAttributeDetailAliases = (aliases, attribute, availableFieldKeys) => {\n  const definition = getObject(attribute);\n  const fieldKey = String(\n    definition.attributeName ??\n      definition.columnName ??\n      definition.fieldName ??\n      definition.field ??\n      \"\"\n  ).trim();\n\n  if (!fieldKey) {\n    return;\n  }\n\n  addAvailableFieldAlias(aliases, fieldKey, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.attributeLabel, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.columnLabel, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.fieldLabel, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.displayLabel, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.label, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.displayName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.name, fieldKey, availableFieldKeys);\n};\nconst collectAttributeDetailAliases = (source, aliases, availableFieldKeys, seen = []) => {\n  if (!source || typeof source !== \"object\" || seen.includes(source)) {\n    return;\n  }\n  seen.push(source);\n\n  if (Array.isArray(source.attributeDetails)) {\n    for (const attribute of source.attributeDetails) {\n      addAttributeDetailAliases(aliases, attribute, availableFieldKeys);\n    }\n  }\n\n  for (const child of Object.values(source)) {\n    if (child && typeof child === \"object\") {\n      collectAttributeDetailAliases(child, aliases, availableFieldKeys, seen);\n    }\n  }\n};\nconst addRecordKeys = (aliases, records, fieldKeys) => {\n  if (!Array.isArray(records)) {\n    return;\n  }\n\n  const firstRecord = records.find((record) => record && typeof record === \"object\" && !Array.isArray(record));\n  if (!firstRecord) {\n    return;\n  }\n\n  for (const key of Object.keys(firstRecord)) {\n    fieldKeys.push(key);\n    addFieldKeyAliases(aliases, key);\n  }\n};\nconst collectBusinessViewFieldAliases = (source, aliases, fieldKeys, viewName) => {\n  const container = source?.result ?? source ?? new Object();\n  const dataKey = viewName ? `${viewName}Data` : \"\";\n\n  if (dataKey && Array.isArray(container[dataKey])) {\n    addRecordKeys(aliases, container[dataKey], fieldKeys);\n  }\n\n  for (const [key, value] of Object.entries(container)) {\n    if (key === \"attributeDetails\" || key === \"metadata\") {\n      continue;\n    }\n    if (Array.isArray(value)) {\n      addRecordKeys(aliases, value, fieldKeys);\n    }\n  }\n};\nconst buildFieldAliases = (input = new Object()) => {\n  const parserResult = input.parserResult;\n  const queryResponse = input.queryResponse;\n  const queryPayload = input.queryPayload;\n  const previousDataPayload = input.previousDataPayload;\n  const viewName = input.viewName;\n  const aliases = new Object();\n  const fieldKeys = [];\n  const inputState = parserResult.inputState ?? new Object();\n  const keyOrder = inputState.private?.lastUsedData?.keyOrder;\n\n  if (Array.isArray(keyOrder)) {\n    for (const key of keyOrder) {\n      fieldKeys.push(key);\n      addFieldKeyAliases(aliases, key);\n    }\n  }\n\n  collectBusinessViewFieldAliases(parserResult.dataResponse, aliases, fieldKeys, viewName);\n  addUniqueSuffixAliases(aliases, fieldKeys);\n  const availableFieldKeys = new Set(fieldKeys.map((key) => String(key ?? \"\").trim()).filter(Boolean));\n  collectAttributeDetailAliases(parserResult.dataResponse, aliases, availableFieldKeys);\n  collectAttributeDetailAliases(previousDataPayload, aliases, availableFieldKeys);\n  collectCoaSegmentAliases(parserResult.dataResponse, aliases, availableFieldKeys);\n  collectCoaSegmentAliases(queryResponse, aliases, availableFieldKeys);\n  collectCoaSegmentAliases(queryPayload, aliases, availableFieldKeys);\n\n  return aliases;\n};\nconst resolveSortByFields = (sortBy, fieldAliases) => {\n  const result = [];\n  const seen = new Set();\n\n  for (const item of normalizeSortBy(sortBy)) {\n    const field = fieldAliases[normalizeAlias(item.field)] || item.field;\n    const key = normalizeAlias(field);\n    if (!seen.has(key)) {\n      seen.add(key);\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = item.order;\n      result.push(sortItem);\n    }\n  }\n\n  return result;\n};\nconst buildExplicitSortBy = (input = new Object()) => {\n  const previousSortBy = input.previousSortBy;\n  const currentSortBy = input.currentSortBy;\n  const sortAction = input.sortAction;\n  const normalizedPrevious = normalizeSortBy(previousSortBy);\n  const normalizedCurrent = normalizeSortBy(currentSortBy);\n\n  if (normalizedCurrent.length === 0) {\n    return normalizedPrevious;\n  }\n\n  return sortAction === \"append\" ? normalizeSortBy([...normalizedPrevious, ...normalizedCurrent]) : normalizedCurrent;\n};\nconst sortAction = String(detailRequirements.sortAction || \"none\").trim().toLowerCase();\nconst currentSortBy = sortAction === \"none\" ? [] : normalizeSortBy(detailRequirements.sortBy);\nconst fieldAliasInput = new Object();\nfieldAliasInput.parserResult = parserResult;\nfieldAliasInput.queryResponse = queryResponse;\nfieldAliasInput.queryPayload = queryPayload;\nfieldAliasInput.previousDataPayload = parserResult.dataPayload;\nfieldAliasInput.viewName = detailViewName;\nconst fieldAliases = buildFieldAliases(fieldAliasInput);\nconst explicitSortInput = new Object();\nexplicitSortInput.previousSortBy = $context.$variables.sortBy;\nexplicitSortInput.currentSortBy = currentSortBy;\nexplicitSortInput.sortAction = sortAction;\nconst explicitSortBy = resolveSortByFields(\n  buildExplicitSortBy(explicitSortInput),\n  fieldAliases\n);\nconst payloadSortBy = detailRequirements.scopeChange === true ? [] : explicitSortBy;\n\nconst payload = new Object();\npayload.chartOfAccountsId = turnContext.chartOfAccountsId ?? queryPayload.chartOfAccountsId ?? 0;\npayload.targetObject = \"journals_bv\";\npayload.includeData = true;\n// Ask the BO service for the new resultStatus envelope while preserving the legacy payload shape.\npayload.retryAttemptCount = retryAttemptCount;\npayload.useEnhancedErrorResponse = true;\npayload.rowLimit = 25;\npayload.queries = queries;\npayload.additionalInfo = new Object();\npayload.additionalInfo.conversationId = turnContext.conversationId ?? \"\";\npayload.additionalInfo.title = title;\npayload.additionalInfo.jobType = \"EXPORT_TO_EXCEL\";\npayload.additionalInfo.processExecutionId = turnContext.processExecutionId ?? \"\";\n\nif (payloadSortBy.length > 0 || currentSortBy.length > 0) {\n  payload.sortBy = payloadSortBy;\n}\n\nconst returnObj = new Object();\nreturnObj.dataPayload = payload;\nreturnObj.dataPayloadString = JSON.stringify(payload);\nreturnObj.sortBy = explicitSortBy;\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "linear_1513_get_journal_detail_data"
          },
