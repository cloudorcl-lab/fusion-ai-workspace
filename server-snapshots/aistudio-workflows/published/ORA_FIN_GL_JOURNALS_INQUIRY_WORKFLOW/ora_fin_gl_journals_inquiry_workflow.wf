        {
          "metadata": {
            "description": "Builds the payload for summary filter generation.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Prepare Summary Query Payload",
            "returnType": "object",
            "sourceCode": "const additionalContext = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.additionalContext ?? $context.$triggers.REST.$input.additionalContext ?? new Object();\nconst resolveHierarchyOverrides = () => {\n  const inputState = $context.$triggers.REST.$input.state || new Object();\n  const stateOverrides = inputState?.shared?.hierarchy?.hierarchyOverrides ||\n    inputState?.domainSlice?.shared?.hierarchy?.hierarchyOverrides;\n  if (Array.isArray(stateOverrides) && stateOverrides.length > 0) {\n    return stateOverrides;\n  }\n  return [];\n};\nconst turnContext = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.turnContext ?? new Object();\nconst summaryRequest = $context.$nodes.FIN_GL_CODE_PREPARE_SUMMARY_REPHRASED_REQUEST?.$output?.result ?? new Object();\nconst analyticView = \"ora_erp_core_accountedTransactions_runtime_x__JournalSummary\";\nconst module = \"oraErpCoreAccountedTransactionsRuntime\";\n\nconst previousFilterResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GET_SUMMARY_FILTERS?.$output ?? new Object();\nconst rawRetryAttemptCount = previousFilterResponse?.recovery?.retryAttemptCount ?? additionalContext.retryAttemptCount ?? 0;\nconst parsedRetryAttemptCount = Number(rawRetryAttemptCount);\nconst retryAttemptCount = Number.isFinite(parsedRetryAttemptCount)\n  ? parsedRetryAttemptCount\n  : 0;\n\nconst contextQueries = Array.isArray(additionalContext.queries)\n  ? additionalContext.queries\n  : [];\nconst firstContextQuery = contextQueries[0];\nconst contextQueryCandidate = firstContextQuery && typeof firstContextQuery === \"object\"\n    ? firstContextQuery.query\n    : undefined;\nconst contextQuery = contextQueryCandidate &&\n  typeof contextQueryCandidate === \"object\" &&\n  !Array.isArray(contextQueryCandidate)\n    ? contextQueryCandidate\n    : new Object();\n\nconst contextFilter = contextQuery.filter ?? turnContext.filter ?? \"\";\nconst contextTimePeriod = Array.isArray(contextQuery.time_period)\n  ? contextQuery.time_period\n  : [];\nconst normalizeCurrency = (value) => {\n  if (Array.isArray(value)) {\n    return value.find((item) => typeof item === \"string\" && item.trim() !== \"\")?.trim() ?? \"\";\n  }\n  return typeof value === \"string\" ? value.trim() : \"\";\n};\n// Fetch query payload expects a string; upstream may send currency as null, a string, or an array.\nconst contextCurrency = normalizeCurrency(contextQuery.currency);\n\nconst query = new Object();\nif (typeof contextFilter === \"string\" && contextFilter.trim() !== \"\") {\n  query.filter = contextFilter;\n}\n\nconst hasUsableLedgerValue = (value) =>\n  value !== null &&\n  typeof value !== \"undefined\" &&\n  !(typeof value === \"string\" && value.trim() === \"\");\nconst normalizeLedgerContext = (value) => {\n  if (Array.isArray(value)) {\n    return value.filter(hasUsableLedgerValue);\n  }\n  return hasUsableLedgerValue(value) ? [value] : [];\n};\nconst ledgerContext = normalizeLedgerContext(additionalContext.ledgerContext ?? turnContext.ledgerContext);\nconst hierarchyOverrides = resolveHierarchyOverrides();\nconst segmentTreeVersionMappings = Array.isArray(hierarchyOverrides)\n  ? hierarchyOverrides\n  : [];\nconst queryEntry = new Object();\nqueryEntry.analyticView = analyticView;\nqueryEntry.module = module;\nqueryEntry.ledgerContext = ledgerContext;\nqueryEntry.query = query;\nqueryEntry.segmentTreeVersionMappings = segmentTreeVersionMappings;\nqueryEntry.time_period = contextTimePeriod;\nqueryEntry.currency = contextCurrency;\nif (hasUsableLedgerValue(additionalContext.ledgerCategory ?? turnContext.ledgerCategory)) {\n  queryEntry.ledgerCategory = additionalContext.ledgerCategory ?? turnContext.ledgerCategory;\n}\nif (typeof additionalContext.templateDetails !== \"undefined\") {\n  queryEntry.simplifiedTemplateDetails = additionalContext.templateDetails;\n}\n\nconst payload = new Object();\nconst additionalInfo = new Object();\nadditionalInfo.processExecutionId = String(additionalContext.processExecutionId ?? turnContext.processExecutionId ?? \"\");\npayload.targetObject = \"journals_av\";\npayload.userQuestion = String(summaryRequest.userQuestion ?? \"\");\npayload.directLLM = false;\npayload.retryAttemptCount = retryAttemptCount;\npayload.useEnhancedErrorResponse = true;\npayload.chartOfAccountsId = String(additionalContext.chartOfAccountsId ?? turnContext.chartOfAccountsId ?? \"\");\npayload.queries = [queryEntry];\npayload.additionalInfo = additionalInfo;\nif (typeof additionalContext.templateId !== \"undefined\") {\n  payload.templateId = additionalContext.templateId;\n}\nif (typeof additionalContext.allPlaceholdersSelected !== \"undefined\") {\n  payload.allPlaceholdersSelected = additionalContext.allPlaceholdersSelected;\n}\n\nconst res = new Object();\nres.queryPayload = payload;\n\nreturn res;"
          },
          "outcomes": {
            "success": "linear_1035_get_av_filters"
          },
          "code": "FIN_GL_CODE_PREPARE_SUMMARY_QUERY_PAYLOAD",
