          "code": "FIN_GL_BO_FUNCTION_GET_SUMMARY_FILTERS",
          "id": "linear_1035_get_av_filters",
          "inputs": [
            {
              "id": "1779322886321_1",
              "name": "payload",
              "type": "string",
              "value": "{{$context.$nodes.FIN_GL_CODE_PREPARE_SUMMARY_QUERY_PAYLOAD.$output.result.queryPayload}}"
            },
            {
              "id": "1779322886321_2",
