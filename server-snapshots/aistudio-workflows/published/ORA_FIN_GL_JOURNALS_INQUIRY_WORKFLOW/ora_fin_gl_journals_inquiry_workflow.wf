        },
        {
          "metadata": {
            "description": "Builds a schema-compatible error when Insights query spoof state is invalid.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Build Reused Query Error",
            "returnType": "object",
            "sourceCode": "const inputState = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.inputState ?? $context.$triggers.REST.$input.state ?? {};\nconst spoofState = $context.$nodes.FIN_GL_CODE_PREPARE_REUSED_QUERY_STATE?.$output?.result ?? {};\n\nconst returnObj = {\n  status: \"error\",\n  errorDetails: {\n    message: \"There was an error preparing your query context.\",\n    cause: \"QUERY_SPOOF\",\n    details: {\n      errors: spoofState.errors || []\n    }\n  },\n  state: inputState\n};\n\nreturn returnObj;"
          },
          "outcomes": {
            "success": "linear_1807_return_journal_query_spoof_error"
          },
          "code": "FIN_GL_CODE_BUILD_REUSED_QUERY_ERROR",
          "id": "linear_1806_construct_journal_query_spoof_error",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Returns the out-of-scope error response.",
            "name": "Return Out-of-Scope Error"
          },
          "outcomes": {},
          "code": "FIN_GL_RETURN_OUT_OF_SCOPE",
          "id": "linear_1008_return_out_of_scope",
          "inputs": [
            {
              "id": "1776126196543_1",
              "name": "returnValue",
              "type": "string",
              "value": "{{$context.$nodes.FIN_GL_CODE_CONSTRUCT_OUT_OF_SCOPE_RESPONSE.$output.result}}"
