Array.isArray(avExtractResult.ledgerLevelAvData) ? avExtractResult.ledgerLevelAvData : [];\n  for (const ledgerLevelData of ledgerLevelAvData) {\n    addRecordKeys(aliases, ledgerLevelData?.currentLevelAvData?.records, fieldKeys);\n    addRecordKeys(aliases, ledgerLevelData?.childLevelAvData?.records, fieldKeys);\n  }\n};\nconst buildFieldAliases = (input = new Object()) => {\n  const parserResult = input.parserResult;\n  const queryResponse = input.queryResponse;\n  const previousDataPayload = input.previousDataPayload;\n  const aliases = new Object();\n  const fieldKeys = [];\n  const inputState = parserResult.inputState ?? new Object();\n  const keyOrder = inputState.private?.lastUsedData?.keyOrder;\n\n  if (Array.isArray(keyOrder)) {\n    for (const key of keyOrder) {\n      fieldKeys.push(key);\n      addFieldKeyAliases(aliases, key);\n    }\n  }\n\n  collectDataFieldAliases(parserResult.dataResponse, aliases, fieldKeys);\n  addUniqueSuffixAliases(aliases, fieldKeys);\n  const availableFieldKeys = new Set(fieldKeys.map((key) => String(key ?? \"\").trim()).filter(Boolean));\n  collectCoaSegmentAliases(parserResult.dataResponse, aliases, availableFieldKeys);\n  collectCoaSegmentAliases(queryResponse, aliases, availableFieldKeys);\n  collectAttributeDetailAliases(parserResult.dataResponse, aliases, availableFieldKeys);\n  collectAttributeDetailAliases(previousDataPayload, aliases, availableFieldKeys);\n\n  return aliases;\n};\nconst resolveSortByFields = (sortBy, fieldAliases) => {\n  const result = [];\n  const seen = new Set();\n\n  for (const item of normalizeSortBy(sortBy)) {\n    const field = fieldAliases[normalizeAlias(item.field)] || item.field;\n    const key = normalizeAlias(field);\n    if (!seen.has(key)) {\n      seen.add(key);\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = item.order;\n      result.push(sortItem);\n    }\n  }\n\n  return result;\n};\nconst buildExplicitSortBy = (input = new Object()) => {\n  const previousSortBy = input.previousSortBy;\n  const currentSortBy = input.currentSortBy;\n  const sortAction = input.sortAction;\n  const normalizedPrevious = normalizeSortBy(previousSortBy);\n  const normalizedCurrent = normalizeSortBy(currentSortBy);\n\n  if (normalizedCurrent.length === 0) {\n    return normalizedPrevious;\n  }\n\n  return sortAction === \"append\" ? normalizeSortBy([...normalizedPrevious, ...normalizedCurrent]) : normalizedCurrent;\n};\nconst buildBreakdownSortBy = (breakdownValue) => {\n  const result = [];\n  for (const item of normalizeBreakdowns(breakdownValue)) {\n    const field = String(item?.dimensionName ?? item?.segmentCode ?? item?.normalizedSegmentName ?? item?.segmentName ?? \"\").trim();\n    if (field) {\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = \"asc\";\n      result.push(sortItem);\n    }\n  }\n  return result;\n};\nconst normalizeQueryValue = (value) => {\n  if (typeof value === \"string\") {\n    try {\n      const parsedValue = JSON.parse(value);\n      return parsedValue !== null && typeof parsedValue === \"object\" && !Array.isArray(parsedValue) ? parsedValue : new Object();\n    } catch (error) {\n      return new Object();\n    }\n  }\n  return value !== null && typeof value === \"object\" && !Array.isArray(value) ? value : new Object();\n};\nconst cloneObject = (value) => JSON.parse(JSON.stringify(normalizeQueryValue(value)));\nconst buildSummaryQuery = (value) => {\n  const query = cloneObject(value);\n  delete query.intentDetails;\n  delete query.hierarchyResolverMessage;\n  delete query.reasoning;\n  return query;\n};\nconst firstQuery = Array.isArray(queryResponse.queries) ? queryResponse.queries[0] : undefined;\nconst title = String($context.$variables.queryTitle || \"journalsData\").slice(0, 100);\nconst flowRequirements = $context.$nodes.FIN_GL_CODE_PARSE_ANALYTIC_VIEW_FLOW_REQUIREMENTS?.$output?.result ?? new Object();\nconst parsedBreakdown = $context.$nodes.FIN_GL_CODE_PARSE_BREAKDOWN_DIMENSIONS?.$output?.result ?? new Object();\nconst previousDataPayload = parserResult.dataPayload ?? new Object();\nconst breakdownBy = $context.$variables.coaBreakdown;\nconst hierarchyOverrides = parserResult.turnContext?.hierarchyOverrides ?? [];\nconst queries = [buildSummaryQuery(firstQuery)];\nconst isPureBreakdownRequest =\n  flowRequirements.scopeChanged === false &&\n  flowRequirements.breakdownRequired === true;\nconst fieldAliasInput = new Object();\nfieldAliasInput.parserResult = parserResult;\nfieldAliasInput.queryResponse = queryResponse;\nfieldAliasInput.previousDataPayload = previousDataPayload;\nconst fieldAliases = buildFieldAliases(fieldAliasInput);\nconst sortAction = String(flowRequirements.sortAction || \"none\").trim().toLowerCase();\nconst currentSortBy = flowRequirements.sortRequired === true ? normalizeSortBy(flowRequirements.sortBy) : [];\nconst explicitSortInput = new Object();\nexplicitSortInput.previousSortBy = $context.$variables.sortBy;\nexplicitSortInput.currentSortBy = currentSortBy;\nexplicitSortInput.sortAction = sortAction;\nconst explicitSortBy = resolveSortByFields(\n  buildExplicitSortBy(explicitSortInput),\n  fieldAliases\n);\nconst breakdownSortBy = resolveSortByFields(buildBreakdownSortBy(breakdownBy), fieldAliases);\nconst payloadSortBy = flowRequirements.scopeChanged === true\n    ? []\n    : currentSortBy.length > 0\n      ? explicitSortBy\n      : breakdownSortBy.length > 0\n        ? breakdownSortBy\n        : explicitSortBy;\n\nconst payload = new Object();\npayload.chartOfAccountsId = turnContext.chartOfAccountsId ?? queryPayload.chartOfAccountsId ?? 0;\npayload.targetObject = \"journals_av\";\npayload.includeData = true;\n// Ask the BO service for the new resultStatus envelope while preserving the legacy payload shape.\npayload.retryAttemptCount = retryAttemptCount;\npayload.useEnhancedErrorResponse = true;\npayload.groupColumnsData = false;\npayload.expandOnMember = applyHierarchyOverridesToExpandOnMember(breakdownBy, hierarchyOverrides);\npayload.expandBasedOnAccountType = true;\npayload.expandAggregateDataByOneLevel = true;\npayload.queries = queries;\n\nif (isPureBreakdownRequest &&\n    firstQuery?.intentDetails &&\n    typeof firstQuery.intentDetails === \"object\" &&\n    !Array.isArray(firstQuery.intentDetails)) {\n  payload.intentDetails = cloneObject(firstQuery.intentDetails);\n}\nelse {\n  delete payload.intentDetails;\n}\n\npayload.additionalInfo = new Object();\npayload.additionalInfo.conversationId = turnContext.conversationId ?? \"\";\npayload.additionalInfo.title = title;\npayload.additionalInfo.jobType = \"EXPORT_TO_EXCEL\";\npayload.additionalInfo.processExecutionId = turnContext.processExecutionId ?? \"\";\n\nconst varianceAction = flowRequirements.varianceAction;\nconst previousVarianceEnabled = previousDataPayload?.varianceColumn === \"fiscalDate.$memberName\";\nconst varianceEnabled = varianceAction === \"enable\"\n  ? true\n  : varianceAction === \"disable\"\n    ? false\n    : previousVarianceEnabled;\n\nif (varianceEnabled) {\n  payload.varianceColumn = \"fiscalDate.$memberName\";\n}\n\nif (payloadSortBy.length > 0 || flowRequirements.sortRequired === true) {\n  payload.sortBy = payloadSortBy;\n}\n\nconst res = new Object();\nres.dataPayload = payload;\nres.dataPayloadString = JSON.stringify(payload);\nres.coaBreakdown = breakdownBy;\nres.breakdownBy = breakdownBy;\nres.sortBy = explicitSortBy;\nres.varianceEnabled = varianceEnabled;\n\nreturn res;"
