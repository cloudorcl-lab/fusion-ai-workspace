            "sourceCode": "const filterResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GET_SUMMARY_FILTERS.$output;\nlet response = false;\n\nif (\n  Object.hasOwn(filterResponse, \"statusCode\") &&\n  filterResponse.statusCode >= 300 &&\n  Object.hasOwn(filterResponse, \"title\") &&\n  (\n    filterResponse.title === \"VALUE_NOT_IN_HIERARCHY\" ||\n    filterResponse.title === \"HIERARCHY_NOT_FOUND\"\n  )\n) {\n  response = true;\n}\n\nreturn response;"
