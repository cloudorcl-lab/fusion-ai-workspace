        {
          "metadata": {
            "name": "Prepare Out-of-Scope Guidance Input",
            "returnType": "object",
            "sourceCode": "const parserResult = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result ?? new Object();\nconst scopeOutput = $context.$nodes.FIN_GL_LLM_SCOPE_CLASSIFIER?.$output ?? new Object();\n\nconst asString = (value) => {\n  if (value === null || value === undefined) {\n    return \"\";\n  }\n  return String(value);\n};\n\nconst stringifyChatHistory = (value) => {\n  if (value === null || value === undefined) {\n    return \"[]\";\n  }\n  if (typeof value === \"string\") {\n    return value;\n  }\n  try {\n    return JSON.stringify(value);\n  } catch (error) {\n    return \"[]\";\n  }\n};\n\nconst asyncRequest = {\n  userNlQuestion: asString(parserResult.userInput || $context.$system.$inputMessage),\n  chatHistory: stringifyChatHistory(parserResult.chatHistory),\n  justification: asString(scopeOutput.justification) || \"Request is outside journal inquiry scope.\"\n};\n\nreturn { asyncRequest };"
