            "name": "Prepare Summary Rephrased Request",
            "returnType": "object",
            "sourceCode": "const rawRephrase = $context.$nodes.FIN_GL_LLM_REPHRASE_SUMMARY_QUESTION?.$output;\nlet userQuestion = \"\";\n\nif (typeof rawRephrase === \"string\") {\n  userQuestion = rawRephrase.trim();\n} else if (rawRephrase !== null && typeof rawRephrase === \"object\" && !Array.isArray(rawRephrase)) {\n  userQuestion = typeof rawRephrase.userQuestion === \"string\" ? rawRephrase.userQuestion.trim() : \"\";\n}\n\nif (!userQuestion) {\n  userQuestion = String($context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.userInput || $context.$system.$inputMessage || \"\").trim();\n}\n\nconst queryTitle = userQuestion;\nconst res = { userQuestion, queryTitle };\n\nreturn res;"
