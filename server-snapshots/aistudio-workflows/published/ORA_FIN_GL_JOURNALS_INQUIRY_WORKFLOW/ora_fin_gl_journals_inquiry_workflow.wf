        {
          "metadata": {
            "description": "Builds the single journal summary response for reused and new queries.",
            "errorNodeId": "linear_1505_prepare_journal_summary_data_payload",
            "name": "Build Summary Response",
            "returnType": "object",
            "sourceCode": "const isObject = (value) => value !== null && typeof value === \"object\" && !Array.isArray(value);\nconst hasOwn = (value, key) => isObject(value) && Object.prototype.hasOwnProperty.call(value, key);\nconst asObject = (value) => (isObject(value) ? value : new Object());\nconst cloneObject = (value) => (value === undefined ? undefined : JSON.parse(JSON.stringify(value)));\nconst getHierarchyResolverMessage = (value) => String(value?.queries?.[0]?.hierarchyResolverMessage ?? \"\").trim();\nconst toErrorDetails = (value) => {\n  if (isObject(value) || Array.isArray(value)) {\n    return cloneObject(value);\n  }\n  const details = new Object();\n  details.value = value;\n  return details;\n};\n\nconst normalizeSummaryAvColumnName = (value) =>\n  String(value ?? \"\")\n    .trim()\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, \"\");\nconst OMITTED_SUMMARY_AV_COLUMNS = new Set(\n  [\n    \"ledger.$levelName\",\n    \"ledgerLevel\",\n    \"Ledger Level\",\n    \"ledger.$memberUniqueName\",\n    \"ledgerUniqueName\",\n    \"Ledger Unique Name\",\n    \"ledger.ledgerId\",\n    \"ledgerId\",\n    \"Ledger Id\",\n    \"legalEntity.$levelName\",\n    \"legalEntityLevel\",\n    \"Legal Entity Level\",\n    \"journalSource.$levelName\",\n    \"journalSourceLevel\",\n    \"Journal Source Level\",\n    \"journalCategory.$levelName\",\n    \"journalCategoryLevel\",\n    \"Journal Category Level\",\n    \"fiscalDate.$levelName\",\n    \"accountingDateLevel\",\n    \"Accounting Date Level\",\n    \"postingStatus.$levelName\",\n    \"postingStatusLevel\",\n    \"Journal Posting Status Level\",\n    \"approvalStatus.$levelName\",\n    \"approvalStatusLevel\",\n    \"Journal Approval Status Level\",\n    \"currency.$levelName\",\n    \"enteredCurrencyLevelName\",\n    \"Entered Currency Level\",\n    \"currency.$memberDescription\",\n    \"enteredCurrencyDescription\",\n    \"Entered Currency Description\",\n    \"currency.$memberUniqueName\",\n    \"enteredCurrencyUniqueName\",\n    \"Entered Currency Unique Name\"\n  ].map(normalizeSummaryAvColumnName)\n);\nconst COLUMN_DESCRIPTOR_ARRAY_KEYS = new Set([\n  \"attributeDetails\",\n  \"attributeDefinitions\",\n  \"attributes\",\n  \"availableColumns\",\n  \"columnDefinitions\",\n  \"columnDetails\",\n  \"columnMetadata\",\n  \"columns\",\n  \"displayedColumns\",\n  \"fieldDetails\",\n  \"fields\"\n]);\nconst COLUMN_DESCRIPTOR_KEYS = [\n  \"alias\",\n  \"aliasName\",\n  \"attributeLabel\",\n  \"attributeName\",\n  \"columnLabel\",\n  \"columnName\",\n  \"displayLabel\",\n  \"displayName\",\n  \"field\",\n  \"fieldLabel\",\n  \"fieldName\",\n  \"label\",\n  \"name\"\n];\nconst isOmittedSummaryAvColumn = (value) =>\n  OMITTED_SUMMARY_AV_COLUMNS.has(normalizeSummaryAvColumnName(value));\nconst isOmittedSummaryAvColumnDescriptor = (value) =>\n  isObject(value) &&\n  COLUMN_DESCRIPTOR_KEYS.some((key) => isOmittedSummaryAvColumn(value[key]));\nconst pruneSummaryAvColumns = (value, parentKey = \"\", seen = []) => {\n  if (!value || typeof value !== \"object\") {\n    return;\n  }\n\n  if (seen.includes(value)) {\n    return;\n  }\n  seen.push(value);\n\n  if (Array.isArray(value)) {\n    const isDescriptorArray = COLUMN_DESCRIPTOR_ARRAY_KEYS.has(parentKey);\n    for (let index = value.length - 1; index >= 0; index -= 1) {\n      const item = value[index];\n      if (\n        isOmittedSummaryAvColumn(item) ||\n        (isDescriptorArray && isOmittedSummaryAvColumnDescriptor(item))\n      ) {\n        value.splice(index, 1);\n        continue;\n      }\n      pruneSummaryAvColumns(item, \"\", seen);\n    }\n    return;\n  }\n\n  for (const key of Object.keys(value)) {\n    if (isOmittedSummaryAvColumn(key)) {\n      delete value[key];\n      continue;\n    }\n    pruneSummaryAvColumns(value[key], key, seen);\n  }\n};\nconst buildNerFooterMessages = (value) => {\n  const ner = value?.queries?.[0]?.reasoning?.ner || new Object();\n  const text = String(ner.clarificationResponse ?? \"\").trim();\n  const status = String(ner.status ?? \"\").trim().toLowerCase();\n\n  if (status !== \"multi_step\" || text === \"\") {\n    return [];\n  }\n\n  const message = new Object();\n  message.code = \"NER_CLARIFICATION\";\n  message.type = \"clarification\";\n  message.severity = \"info\";\n  message.placement = \"footer\";\n  message.text = text;\n  return [message];\n};\nconst hasProcessingMessage = (value) =>\n  typeof value === \"string\"\n    ? value.includes(\"Recent\")\n    : Array.isArray(value)\n    ? value.some((entry) => hasProcessingMessage(entry))\n    : isObject(value)\n    ? (typeof value.message === \"string\" && value.message.includes(\"Recent\")) ||\n      Object.keys(value).some((key) => hasProcessingMessage(value[key]))\n    : false;\nconst getNumber = (value) =>\n  typeof value === \"number\" && Number.isFinite(value)\n    ? value\n    : typeof value === \"string\" && value.trim() !== \"\" && Number.isFinite(Number(value))\n    ? Number(value)\n    : null;\n// Keep this collector aligned with the payload builder so retry uses the same failing status.\nconst NO_DATA_RESULT_CODE = \"GL_LA_INQ_DATA_NO_DATA\";\nconst isResultStatus = (value) =>\n  value && typeof value === \"object\" && !Array.isArray(value) &&\n  typeof value.category === \"string\";\nconst addResultStatus = (statuses, value) => {\n  if (isResultStatus(value)) {\n    statuses.push(value);\n  }\n};\nconst collectResultStatuses = (value) => {\n  const container = value?.result ?? value;\n  const statuses = [];\n\n  if (!container || typeof container !== \"object\" || Array.isArray(container)) {\n    return statuses;\n  }\n\n  addResultStatus(statuses, container);\n  addResultStatus(statuses, container.resultStatus);\n\n  const avExtractResult = container.avExtractResult || new Object();\n  addResultStatus(statuses, avExtractResult.homogenousLedgerSetAvData?.resultStatus);\n  if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      addResultStatus(statuses, ledgerLevelData?.currentLevelAvData?.resultStatus);\n      addResultStatus(statuses, ledgerLevelData?.childLevelAvData?.resultStatus);\n    }\n  }\n\n  return statuses;\n};\nconst isNoDataResultStatus = (value) =>\n  isResultStatus(value) && value.code === NO_DATA_RESULT_CODE;\nconst isRetryableResultStatus = (value) =>\n  isResultStatus(value) &&\n  String(value.category).toLowerCase() === \"systemerror\" &&\n  value.recovery?.recoverable === true &&\n  Number(value.recovery?.retryAttemptCount) === 1;\nconst isBlockingResultStatus = (value) =>\n  isResultStatus(value) &&\n  !isNoDataResultStatus(value) &&\n  [\"usererror\", \"systemerror\", \"information\"].includes(String(value.category).toLowerCase());\nconst RETRY_SIGNAL = \"LEDGER_AGENT_RETRY_SIGNAL\";\nconst GENERIC_RESPONSE_PROCESSING_MESSAGE = \"We couldn't complete your request right now. Please try again later.\";\n\nconst getRetryAttemptCount = (value) => {\n  const count = Number(value);\n  return Number.isFinite(count) ? count : 0;\n};\n\nconst isRetrySignal = (error) => error?.isRetrySignal === true || error?.name === RETRY_SIGNAL;\n\nconst throwRetryError = (status) => {\n  const err = new Error(status.message || \"Retry requested.\");\n  err.name = RETRY_SIGNAL;\n  err.isRetrySignal = true;\n  err.category = status?.category;\n  err.payload = status;\n  throw err;\n};\nconst getColumnOrderFromFirstRow = (records) => {\n  if (!Array.isArray(records)) {\n    return [];\n  }\n\n  for (const record of records) {\n    if (!isObject(record)) {\n      continue;\n    }\n\n    const columnOrder = Object.keys(record).filter((key) => !isOmittedSummaryAvColumn(key));\n\n    if (columnOrder.length > 0) {\n      return columnOrder;\n    }\n  }\n\n  return [];\n};\nconst getFirstLedgerLevelColumnOrder = (ledgerLevelAvData, sectionKeys) => {\n  if (!Array.isArray(ledgerLevelAvData)) {\n    return [];\n  }\n\n  for (const ledgerLevelData of ledgerLevelAvData) {\n    for (const sectionKey of sectionKeys) {\n      const columnOrder = getColumnOrderFromFirstRow(ledgerLevelData?.[sectionKey]?.records);\n\n      if (columnOrder.length > 0) {\n        return columnOrder;\n      }\n    }\n  }\n\n  return [];\n};\nconst buildAvKeyOrder = (data) => {\n  const avExtractResult = data?.avExtractResult || new Object();\n  const homogenousColumnOrder = getColumnOrderFromFirstRow(avExtractResult.homogenousLedgerSetAvData?.records);\n\n  return homogenousColumnOrder.length > 0\n    ? homogenousColumnOrder\n    : getFirstLedgerLevelColumnOrder(avExtractResult.ledgerLevelAvData, [\"currentLevelAvData\", \"childLevelAvData\"]);\n};\n\n// Retry only when BO asks for a newer attempt than the one this request already sent.\nconst shouldRetryResultStatus = (status, sentRetryAttemptCount) => {\n  const backendRetryAttemptCount = getRetryAttemptCount(status?.recovery?.retryAttemptCount);\n  return isRetryableResultStatus(status) && backendRetryAttemptCount > sentRetryAttemptCount;\n};\nlet capturedInputState = new Object();\nconst buildGenericProcessingResponse = (error) => {\n  const response = new Object();\n  const errorDetails = new Object();\n  const details = new Object();\n  details.message = error?.message;\n  errorDetails.message = GENERIC_RESPONSE_PROCESSING_MESSAGE;\n  errorDetails.cause = \"DATA_RESPONSE_PROCESSING\";\n  errorDetails.details = details;\n  response.status = \"error\";\n  response.errorDetails = errorDetails;\n  response.state = capturedInputState;\n  return response;\n};\nconst normalizeCoaBreakdown = (value) =>\n  Array.isArray(value)\n    ? value\n    : typeof value === \"string\"\n    ? []\n    : isObject(value) && Array.isArray(value.value)\n    ? value.value\n    : isObject(value) && Array.isArray(value.coaBreakdown)\n    ? value.coaBreakdown\n    : isObject(value) && Array.isArray(value.breakdownBy)\n    ? value.breakdownBy\n    : isObject(value) && Array.isArray(value.breakdowns)\n    ? value.breakdowns\n    : [];\nconst normalizeSortBy = (value) => {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n\n  const result = [];\n  const seen = new Set();\n\n  for (const item of value) {\n    if (!isObject(item)) {\n      continue;\n    }\n\n    const field = String(item.field ?? \"\").trim();\n    if (!field) {\n      continue;\n    }\n\n    const orderText = String(item.order ?? \"asc\").trim().toLowerCase();\n    const order = orderText === \"desc\" || orderText === \"descending\" ? \"desc\" : \"asc\";\n    const key = field.toLowerCase();\n\n    if (!seen.has(key)) {\n      seen.add(key);\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = order;\n      result.push(sortItem);\n    }\n  }\n\n  return result;\n};\n\nconst isPureBreakdownRequest = () => {\n  const flowRequirements = $context.$nodes.FIN_GL_CODE_PARSE_ANALYTIC_VIEW_FLOW_REQUIREMENTS?.$output?.result ?? new Object();\n\n  return flowRequirements.scopeChanged === false && flowRequirements.breakdownRequired === true;\n};\n\nconst getUpdatedIntentDetails = (dataResponse) => {\n  const intentDetails = dataResponse?.avExtractResult?.intentDetails;\n\n  return isObject(intentDetails) ? cloneObject(intentDetails) : null;\n};\n\nconst applyUpdatedIntentDetails = (queryResponse, dataResponse) => {\n  const updatedIntentDetails = getUpdatedIntentDetails(dataResponse);\n\n  if (!updatedIntentDetails || !isObject(queryResponse)) {\n    return queryResponse;\n  }\n\n  const updatedQueryResponse = cloneObject(queryResponse);\n  updatedQueryResponse.queries = Array.isArray(updatedQueryResponse.queries)\n    ? updatedQueryResponse.queries\n    : [];\n  updatedQueryResponse.queries[0] = isObject(updatedQueryResponse.queries[0])\n    ? updatedQueryResponse.queries[0]\n    : new Object();\n  updatedQueryResponse.queries[0].intentDetails = updatedIntentDetails;\n  return updatedQueryResponse;\n};\n\nconst buildResponse = () => {\n  const parserResult = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result ?? new Object();\n  const inputState = asObject(parserResult.inputState ?? $context.$triggers.REST.$input.state);\n  capturedInputState = inputState;\n  const incomingShared = asObject(inputState.shared);\n  const incomingPrivate = asObject(inputState.private);\n  const incomingLastUsedQuery = asObject(incomingPrivate.lastUsedQuery);\n  const incomingLastUsedData = asObject(incomingPrivate.lastUsedData);\n  const sentRetryAttemptCount = getRetryAttemptCount($context.$nodes.FIN_GL_CODE_BUILD_SUMMARY_DATA_PAYLOAD?.$output?.result?.dataPayload?.retryAttemptCount);\n  const rawData = $context.$nodes.FIN_GL_CODE_FORMAT_SUMMARY_DATA?.$output?.result ?? $context.$variables.dataResponse ?? new Object();\n  let data;\n  try {\n    data = cloneObject(rawData);\n  } catch (error) {\n    data = rawData ?? new Object();\n  }\n  pruneSummaryAvColumns(data);\n  const query = $context.$variables.queryResponse ?? new Object();\n  const viewName = \"ora_erp_core_accountedTransactions_runtime_x__JournalSummary\";\n  const container = !hasOwn(data, \"avExtractResult\") && hasOwn(data?.result, \"avExtractResult\") ? data.result : data;\n  const resultStatuses = collectResultStatuses(container);\n  const retryableResultStatus = resultStatuses.find(isRetryableResultStatus);\n  if (shouldRetryResultStatus(retryableResultStatus, sentRetryAttemptCount)) {\n    // Throw so this code node's error path loops back and sends the incremented retryAttemptCount.\n    throwRetryError(retryableResultStatus);\n  }\n  const blockingResultStatus = resultStatuses.find(isBlockingResultStatus);\n  const rawDataForKeyOrder = $context.$nodes.FIN_GL_BO_FUNCTION_GET_SUMMARY_DATA?.$output;\n  const dataForKeyOrder = rawDataForKeyOrder ?? container;\n  const keyOrderContainer = !hasOwn(dataForKeyOrder, \"avExtractResult\") && hasOwn(dataForKeyOrder?.result, \"avExtractResult\")\n      ? dataForKeyOrder.result\n      : dataForKeyOrder;\n  let extractResult = \"error\";\n  const topLevelErrorCode = getNumber(container?.errorCode ?? container?.error?.errorCode);\n  const topLevelStatusCode = getNumber(container?.statusCode);\n  const topLevelNoData = isNoDataResultStatus(container) ||\n    isNoDataResultStatus(container?.resultStatus);\n  if (blockingResultStatus) {\n    extractResult = \"error\";\n  } else if (topLevelErrorCode === 204 || topLevelStatusCode === 204) {\n    extractResult = \"no_data\";\n  } else if ((topLevelErrorCode !== null && topLevelErrorCode >= 300) || (topLevelStatusCode !== null && topLevelStatusCode >= 300)) {\n    extractResult = \"error\";\n  } else if (typeof container?.errorMessage === \"string\" && container.errorMessage.trim() !== \"\") {\n    extractResult = \"error\";\n  } else if (hasOwn(container, \"avExtractResult\")) {\n    const avExtractResult = isObject(container.avExtractResult) ? container.avExtractResult : new Object();\n    const dataRecords = [];\n    if (avExtractResult.homogenousLedgerSetAvData && isObject(avExtractResult.homogenousLedgerSetAvData)) {\n      dataRecords.push(avExtractResult.homogenousLedgerSetAvData);\n    } else if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n      for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n        if (isObject(ledgerLevelData?.currentLevelAvData)) {\n          dataRecords.push(ledgerLevelData.currentLevelAvData);\n        }\n        if (isObject(ledgerLevelData?.childLevelAvData)) {\n          dataRecords.push(ledgerLevelData.childLevelAvData);\n        }\n      }\n    }\n    let hasData = false;\n    let hasError = false;\n    let countObjectCount = 0;\n    let noDataCountObjectCount = 0;\n    for (const dataRecord of dataRecords) {\n      const errorCode = getNumber(dataRecord.error?.errorCode ?? dataRecord.errorCode ?? dataRecord.statusCode);\n      const resultStatus = dataRecord.resultStatus;\n      if (Array.isArray(dataRecord.records) && dataRecord.records.length > 0) {\n        hasData = true;\n      }\n      if (errorCode !== null && errorCode >= 300) {\n        hasError = true;\n      }\n      if (hasOwn(dataRecord, \"count\")) {\n        countObjectCount += 1;\n        if (Number(dataRecord.count) === 0 && (errorCode === 204 || isNoDataResultStatus(resultStatus))) {\n          noDataCountObjectCount += 1;\n        }\n      }\n    }\n    if (hasData) {\n      extractResult = \"data\";\n    } else if (hasError) {\n      extractResult = \"error\";\n    } else if (countObjectCount > 0 && countObjectCount === noDataCountObjectCount) {\n      extractResult = \"no_data\";\n    } else if (topLevelNoData) {\n      extractResult = \"no_data\";\n    }\n  } else if (topLevelNoData) {\n    extractResult = \"no_data\";\n  }\n\n  let status = \"success\";\n  let successMessage = \"data\";\n  if (hasProcessingMessage(data)) {\n    successMessage = \"async\";\n  } else if (extractResult === \"data\" || extractResult === \"no_data\") {\n    successMessage = extractResult;\n  } else {\n    status = \"error\";\n  }\n\n  const resolvedQueryPayload = $context.$variables.queryPayload ?? incomingLastUsedQuery.queryPayload ?? new Object();\n  const resolvedDataPayload = $context.$variables.dataPayload ?? incomingLastUsedData.dataPayload ?? new Object();\n  const resolvedQueryResponse = isPureBreakdownRequest()\n    ? applyUpdatedIntentDetails(query, container)\n    : query;\n  const lastUsedQuery = new Object();\n  lastUsedQuery.queryResponse = resolvedQueryResponse;\n  lastUsedQuery.queryPayload = resolvedQueryPayload;\n  lastUsedQuery.queryTitle = String($context.$variables.queryTitle ?? incomingLastUsedQuery.queryTitle ?? \"\");\n  lastUsedQuery.analyticViewNameUsed = viewName;\n  const successState = new Object();\n  successState.shared = new Object();\n  successState.shared.coaBreakdown = normalizeCoaBreakdown($context.$variables.coaBreakdown ?? incomingShared.coaBreakdown);\n  successState.shared.sortBy = normalizeSortBy($context.$variables.sortBy ?? incomingShared.sortBy);\n  successState.private = new Object();\n  successState.private.lastUsedQuery = lastUsedQuery;\n  successState.private.lastUsedData = new Object();\n  successState.private.lastUsedData.dataResponse = data;\n  successState.private.lastUsedData.dataPayload = resolvedDataPayload;\n  successState.private.lastUsedData.keyOrder = buildAvKeyOrder(keyOrderContainer);\n  let response;\n  if (status === \"error\") {\n    const errorDetails = new Object();\n    errorDetails.message = blockingResultStatus?.message || \"We couldn't complete your request right now. Please try again later.\";\n    errorDetails.cause = blockingResultStatus?.code || \"DATA_EXTRACT\";\n    errorDetails.code = blockingResultStatus?.code;\n    errorDetails.details = toErrorDetails(data);\n    response = new Object();\n    response.status = \"error\";\n    response.errorDetails = errorDetails;\n    response.state = inputState;\n  } else {\n    response = new Object();\n    response.status = \"success\";\n    response.successMessage = successMessage;\n    response.state = successState;\n    const hierarchyResolverMessage = getHierarchyResolverMessage(query);\n    if (hierarchyResolverMessage) {\n      response.hierarchyResolverMessage = hierarchyResolverMessage;\n    }\n    const messages = buildNerFooterMessages(query);\n    if (messages.length > 0) {\n      response.messages = messages;\n    }\n  }\n\n  return response;\n};\n\nlet finalResponse;\ntry {\n  finalResponse = buildResponse();\n} catch (error) {\n  if (isRetrySignal(error)) {\n    throw error;\n  }\n\n  finalResponse = buildGenericProcessingResponse(error);\n}\n\nreturn finalResponse;"
