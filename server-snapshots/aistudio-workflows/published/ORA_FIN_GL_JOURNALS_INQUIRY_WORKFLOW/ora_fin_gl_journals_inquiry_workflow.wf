        {
          "metadata": {
            "description": "Determines whether spoofed query state should run summary AV or detail BV data retrieval.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Determine Data Retrieval Type",
            "returnType": "string",
            "sourceCode": "const queryPayload = $context.$variables.queryPayload ?? {};\nconst queryResponse = $context.$variables.queryResponse ?? {};\nconst firstPayloadQuery = Array.isArray(queryPayload.queries) ? queryPayload.queries[0] ?? {} : {};\nconst firstResponseQuery = Array.isArray(queryResponse.queries) ? queryResponse.queries[0] ?? {} : {};\nconst analyticViewName = $context.$variables.analyticViewNameUsed || firstPayloadQuery.analyticView || firstPayloadQuery.analyticViews || firstResponseQuery.analyticViews || \"\";\nconst returnObj = analyticViewName ? \"AV\" : \"BV\";\n\nreturn returnObj;"
          },
          "outcomes": {
