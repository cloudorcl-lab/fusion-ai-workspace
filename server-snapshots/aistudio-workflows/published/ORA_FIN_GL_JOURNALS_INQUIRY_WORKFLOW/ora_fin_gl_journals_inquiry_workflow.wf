          "code": "FIN_GL_CONDITION_DATA_RETRIEVAL_TYPE_CHECK",
          "convergenceTargetId": "end",
          "id": "linear_1805_check_journal_data_retrieval_type",
          "inputs": [
            {
              "id": "linear_1805_condition",
              "name": "condition",
              "type": "string",
              "value": "{{$context.$nodes.FIN_GL_CODE_DETERMINE_DATA_RETRIEVAL_TYPE.$output.result === \"AV\"}}"
            }
          ],
          "type": "CONDITION"
        },
        {
          "metadata": {
            "description": "Builds the single journal summary data payload from the active query state for normal, reuse, and spoofed Insights paths.",
            "errorNodeId": "linear_1305_route_runtime_error_response",
            "name": "Build Summary Data Payload",
            "returnType": "object",
            "sourceCode": "const buildHierarchyOverrideMap = (hierarchyOverrides) => {\n  const map = new Object();\n  const normalizeKey = (value) => String(value || \"\")\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .replace(/[^a-zA-Z0-9]+/g, \" \")\n    .toLowerCase()\n    .trim()\n    .replace(/\\s+/g, \"\");\n  const add = (key, treeVersionName) => {\n    if (!key || !treeVersionName) return;\n    map[String(key)] = String(treeVersionName);\n    map[normalizeKey(key)] = String(treeVersionName);\n  };\n  if (Array.isArray(hierarchyOverrides)) {\n    for (const item of hierarchyOverrides) {\n      const treeVersionName = item?.treeVersionName || item?.treeVersion || item?.treeNameHyphenVersion || \"\";\n      add(item?.segmentCode, treeVersionName);\n      add(item?.dimensionName, treeVersionName);\n      add(item?.normalizedSegmentName, treeVersionName);\n      add(item?.segmentName, treeVersionName);\n    }\n  } else if (hierarchyOverrides && typeof hierarchyOverrides === \"object\") {\n    for (const [segmentCode, treeVersionName] of Object.entries(hierarchyOverrides)) {\n      add(segmentCode, treeVersionName);\n    }\n  }\n  const hierarchyOverrideMap = new Object();\n  hierarchyOverrideMap.map = map;\n  hierarchyOverrideMap.normalizeKey = normalizeKey;\n  return hierarchyOverrideMap;\n};\n\nconst applyHierarchyOverridesToExpandOnMember = (expandOnMember, hierarchyOverrides) => {\n  const hierarchyOverrideMap = buildHierarchyOverrideMap(hierarchyOverrides);\n  const map = hierarchyOverrideMap.map;\n  const normalizeKey = hierarchyOverrideMap.normalizeKey;\n  if (!Object.keys(map).length || expandOnMember === undefined || expandOnMember === null || expandOnMember === \"\") {\n    return expandOnMember;\n  }\n  const resolveTreeVersion = (dimensionName) => map[String(dimensionName || \"\")] || map[normalizeKey(dimensionName)] || \"\";\n\n  if (typeof expandOnMember === \"string\") {\n    const text = expandOnMember.trim();\n    if (!text) return expandOnMember;\n    const wrapped = text.startsWith(\"(\") ? text : \"(\" + text;\n    const normalized = wrapped.endsWith(\")\") ? wrapped : wrapped + \")\";\n    const tuples = normalized.split(/\\)\\s*,\\s*\\(/).map((tuple) => tuple.replace(/^\\(/, \"\").replace(/\\)$/, \"\"));\n    const updatedTuples = tuples.map((tuple) => {\n      const parts = tuple.split(\"||\");\n      const treeVersionName = resolveTreeVersion((parts[0] || \"\").trim());\n      if (!treeVersionName) return tuple;\n      while (parts.length < 4) parts.push(\"\");\n      parts[3] = treeVersionName;\n      return parts.join(\"||\");\n    });\n    return updatedTuples.map((tuple) => \"(\" + tuple + \")\").join(\",\");\n  }\n\n  if (Array.isArray(expandOnMember)) {\n    return expandOnMember.map((item) => {\n      if (!item || typeof item !== \"object\") return item;\n      const dimensionName = item.dimensionName || item.segmentCode || item.normalizedSegmentName || item.segmentName || \"\";\n      const treeVersionName = resolveTreeVersion(dimensionName);\n      if (!treeVersionName) return item;\n      const updatedItem = Object.assign(new Object(), item);\n      updatedItem.treeVersionInfo = treeVersionName;\n      return updatedItem;\n    });\n  }\n\n  if (typeof expandOnMember === \"object\") {\n    const dimensionName = expandOnMember.dimensionName || expandOnMember.segmentCode || expandOnMember.normalizedSegmentName || expandOnMember.segmentName || \"\";\n    const treeVersionName = resolveTreeVersion(dimensionName);\n    if (!treeVersionName) return expandOnMember;\n    const updatedExpandOnMember = Object.assign(new Object(), expandOnMember);\n    updatedExpandOnMember.treeVersionInfo = treeVersionName;\n    return updatedExpandOnMember;\n  }\n\n  return expandOnMember;\n};\n\nconst turnContext = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result?.turnContext ?? new Object();\nconst parserResult = $context.$nodes.FIN_GL_CODE_PARSE_INPUT?.$output?.result ?? new Object();\nconst queryResponse = $context.$variables.queryResponse ?? new Object();\nconst queryPayload = $context.$variables.queryPayload ?? new Object();\n// Keep this collector aligned with the response processor so retry uses the same failing status.\nconst NO_DATA_RESULT_CODE = \"GL_LA_INQ_DATA_NO_DATA\";\nconst isResultStatus = (value) =>\n  value && typeof value === \"object\" && !Array.isArray(value) &&\n  typeof value.category === \"string\";\nconst addResultStatus = (statuses, value) => {\n  if (isResultStatus(value)) {\n    statuses.push(value);\n  }\n};\nconst collectResultStatuses = (value) => {\n  const container = value?.result ?? value;\n  const statuses = [];\n\n  if (!container || typeof container !== \"object\" || Array.isArray(container)) {\n    return statuses;\n  }\n\n  addResultStatus(statuses, container);\n  addResultStatus(statuses, container.resultStatus);\n\n  const avExtractResult = container.avExtractResult || new Object();\n  addResultStatus(statuses, avExtractResult.homogenousLedgerSetAvData?.resultStatus);\n  if (Array.isArray(avExtractResult.ledgerLevelAvData)) {\n    for (const ledgerLevelData of avExtractResult.ledgerLevelAvData) {\n      addResultStatus(statuses, ledgerLevelData?.currentLevelAvData?.resultStatus);\n      addResultStatus(statuses, ledgerLevelData?.childLevelAvData?.resultStatus);\n    }\n  }\n\n  return statuses;\n};\nconst isNoDataResultStatus = (value) =>\n  isResultStatus(value) && value.code === NO_DATA_RESULT_CODE;\nconst isRetryableResultStatus = (value) =>\n  isResultStatus(value) &&\n  String(value.category).toLowerCase() === \"systemerror\" &&\n  value.recovery?.recoverable === true &&\n  Number(value.recovery?.retryAttemptCount) === 1;\nconst isBlockingResultStatus = (value) =>\n  isResultStatus(value) &&\n  !isNoDataResultStatus(value) &&\n  [\"usererror\", \"systemerror\", \"information\"].includes(String(value.category).toLowerCase());\nconst previousDataStatuses = collectResultStatuses($context.$nodes.FIN_GL_BO_FUNCTION_GET_SUMMARY_DATA?.$output);\nconst previousRetryableStatus = previousDataStatuses.find(isRetryableResultStatus);\n// Retry count comes from the same enhanced resultStatus that triggered retry; legacy responses stay at 0.\nconst parsedRetryAttemptCount = Number(previousRetryableStatus?.recovery?.retryAttemptCount ?? 0);\nconst retryAttemptCount = Number.isFinite(parsedRetryAttemptCount)\n  ? parsedRetryAttemptCount\n  : 0;\nconst normalizeBreakdowns = (value) => {\n  if (Array.isArray(value)) {\n    return value;\n  }\n  if (value && typeof value === \"object\") {\n    if (Array.isArray(value.breakdowns)) {\n      return value.breakdowns;\n    }\n    if (Array.isArray(value.coaBreakdown)) {\n      return value.coaBreakdown;\n    }\n    if (Array.isArray(value.breakdownBy)) {\n      return value.breakdownBy;\n    }\n  }\n  return [];\n};\nconst normalizeAlias = (value) =>\n  String(value ?? \"\")\n    .trim()\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .toLowerCase()\n    .replace(/[_-]+/g, \" \")\n    .replace(/[^a-z0-9]+/gi, \"\");\nconst normalizeSortBy = (value) => {\n  if (!Array.isArray(value)) {\n    return [];\n  }\n\n  const result = [];\n  const seen = new Set();\n\n  for (const item of value) {\n    if (!item || typeof item !== \"object\" || Array.isArray(item)) {\n      continue;\n    }\n\n    const field = String(item.field ?? \"\").trim();\n    if (!field) {\n      continue;\n    }\n\n    const orderText = String(item.order ?? \"asc\").trim().toLowerCase();\n    const order = orderText === \"desc\" || orderText === \"descending\" ? \"desc\" : \"asc\";\n    const key = normalizeAlias(field);\n\n    if (!seen.has(key)) {\n      seen.add(key);\n      const sortItem = new Object();\n      sortItem.field = field;\n      sortItem.order = order;\n      result.push(sortItem);\n    }\n  }\n\n  return result;\n};\nconst addFieldAlias = (aliases, alias, fieldKey) => {\n  const normalizedAlias = normalizeAlias(alias);\n  const resolvedFieldKey = String(fieldKey ?? \"\").trim();\n  if (normalizedAlias && resolvedFieldKey && !aliases[normalizedAlias]) {\n    aliases[normalizedAlias] = resolvedFieldKey;\n  }\n};\nconst addFieldKeyAliases = (aliases, fieldKey) => {\n  const key = String(fieldKey ?? \"\").trim();\n  if (!key) {\n    return;\n  }\n\n  addFieldAlias(aliases, key, key);\n};\nconst splitFieldKey = (fieldKey) =>\n  String(fieldKey ?? \"\")\n    .trim()\n    .replace(/([A-Z]+)([A-Z][a-z])/g, \"$1 $2\")\n    .replace(/([a-z0-9])([A-Z])/g, \"$1 $2\")\n    .replace(/[_-]+/g, \" \")\n    .split(/\\s+/)\n    .filter(Boolean);\nconst addUniqueSuffixAliases = (aliases, fieldKeys) => {\n  const owners = new Object();\n\n  for (const fieldKey of fieldKeys) {\n    const key = String(fieldKey ?? \"\").trim();\n    const tokens = splitFieldKey(key);\n\n    for (let index = 1; index < tokens.length; index += 1) {\n      const alias = normalizeAlias(tokens.slice(index).join(\" \"));\n      if (!alias) {\n        continue;\n      }\n\n      if (owners[alias] && owners[alias] !== key) {\n        owners[alias] = \"\";\n      } else if (!owners[alias]) {\n        owners[alias] = key;\n      }\n    }\n  }\n\n  for (const [alias, fieldKey] of Object.entries(owners)) {\n    if (fieldKey) {\n      addFieldAlias(aliases, alias, fieldKey);\n    }\n  }\n};\nconst resolveAvailableFieldKey = (aliases, fieldKey, availableFieldKeys) => {\n  const key = String(fieldKey ?? \"\").trim();\n  if (!key) {\n    return \"\";\n  }\n\n  if (!availableFieldKeys || availableFieldKeys.size === 0 || availableFieldKeys.has(key)) {\n    return key;\n  }\n\n  return aliases[normalizeAlias(key)] || \"\";\n};\nconst addAvailableFieldAlias = (aliases, alias, fieldKey, availableFieldKeys) => {\n  const resolvedFieldKey = resolveAvailableFieldKey(aliases, fieldKey, availableFieldKeys);\n  if (resolvedFieldKey) {\n    addFieldAlias(aliases, alias, resolvedFieldKey);\n  }\n};\nconst getObject = (value) => (value && typeof value === \"object\" && !Array.isArray(value) ? value : new Object());\nconst addCoaSegmentAliases = (aliases, segmentKey, segmentDefinition, availableFieldKeys) => {\n  const definition = getObject(segmentDefinition);\n  const fieldKey = String(segmentKey ?? definition.key ?? definition.name ?? \"\").trim();\n\n  if (!fieldKey) {\n    return;\n  }\n\n  addAvailableFieldAlias(aliases, fieldKey, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.key, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.name, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.label, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.displayName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.dimensionName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.segmentName, fieldKey, availableFieldKeys);\n  addAvailableFieldAlias(aliases, definition.segmentCode, fieldKey, availableFieldKeys);\n};\nconst collectCoaSegmentAliases = (source, aliases, availableFieldKeys) => {\n  const container = source?.result ?? source ?? new Object();\n  const metadata = container.avExtractResult?.metadata ?? container.metadata ?? new Object();\n  const segments = metadata.chartOfAccounts?.segments;\n\n  if (!segments || typeof segments !== \"object\" || Array.isArray(segments)) {\n    return;\n  }\n\n  for (const [segmentKey, segmentDefinition] of Object.entries(segments)) {\n    addCoaSegmentAliases(aliases, segmentKey, segmentDefinition, availableFieldKeys);\n  }\n};\nconst addAttributeDetailAliases = (aliases, attribute, availableFieldKeys) => {\n  const definition = getObject(attribute);\n  const fieldKey = String(\n    definition.attributeName ??\n      definition.columnName ??\n      definition.fieldName ??\n      definition.field ??\n      \"\"\n  ).trim();\n\n  if (!fieldKey) {\n    return;\n  }\n\n  addAvaila