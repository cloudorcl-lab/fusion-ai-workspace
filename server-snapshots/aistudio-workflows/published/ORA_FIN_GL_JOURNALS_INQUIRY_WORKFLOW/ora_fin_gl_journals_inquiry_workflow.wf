        },
        {
          "metadata": {
            "description": "Checks whether detail filter generation failed.",
            "errorNodeId": "linear_1210_prepare_journal_detail_query_payload",
            "name": "Check Detail Filter Error",
            "returnType": "boolean",
            "sourceCode": "const RETRY_SIGNAL = \"LEDGER_AGENT_RETRY_SIGNAL\";\n\nconst getRetryAttemptCount = (value) => {\n  const count = Number(value);\n  return Number.isFinite(count) ? count : 0;\n};\n\nconst isRetrySignal = (error) =>\n  error?.isRetrySignal === true || error?.name === RETRY_SIGNAL;\n\n// Retry only when BO asks for a newer attempt than the one this request already sent.\nconst shouldRetryEnhancedResponse = (value, sentRetryAttemptCount) => {\n  const backendRetryAttemptCount = getRetryAttemptCount(value?.recovery?.retryAttemptCount);\n  return (\n    String(value?.category ?? \"\").toLowerCase() === \"systemerror\" &&\n    value?.recovery?.recoverable === true &&\n    backendRetryAttemptCount === 1 &&\n    backendRetryAttemptCount > sentRetryAttemptCount\n  );\n};\n\nconst throwRetryError = (value) => {\n  const err = new Error(value?.message || \"Retry requested.\");\n  err.name = RETRY_SIGNAL;\n  err.isRetrySignal = true;\n  err.category = value?.category;\n  err.processExecutionId = value?.processExecutionId;\n  err.payload = value;\n  throw err;\n};\n\nconst hasFilterError = () => {\n  const filterResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GET_DETAIL_FILTERS.$output;\n  const sentRetryAttemptCount = getRetryAttemptCount($context.$nodes.FIN_GL_CODE_PREPARE_DETAIL_QUERY_PAYLOAD?.$output?.result?.queryPayload?.retryAttemptCount);\n  let response = false;\n  const category = String(filterResponse?.category ?? \"\").toLowerCase();\n\n  if (shouldRetryEnhancedResponse(filterResponse, sentRetryAttemptCount)) {\n    // Only this marked error should use the workflow retry edge.\n    throwRetryError(filterResponse);\n  }\n\n  if (category === \"usererror\" || category === \"systemerror\" || category === \"information\") {\n    response = true;\n  }\n  else if (Object.hasOwn(filterResponse, \"errorCode\")) {\n    response = true;\n  }\n  else if (Object.hasOwn(filterResponse, \"statusCode\")) {\n    if (filterResponse.statusCode >= 300) {\n      if (\n        Object.hasOwn(filterResponse, \"title\") &&\n        (filterResponse.title === \"VALUE_NOT_IN_HIERARCHY\" ||\n         filterResponse.title === \"HIERARCHY_NOT_FOUND\")\n      ) {\n        response = true;\n      }\n      else {\n        response = true;\n      }\n    }\n  }\n\n  return response;\n};\n\nlet finalResult;\ntry {\n  finalResult = hasFilterError();\n} catch (error) {\n  if (isRetrySignal(error)) {\n    throw error;\n  }\n\n  finalResult = true;\n}\n\nreturn finalResult;"
          },
          "outcomes": {
            "success": "linear_1025_if_bv_filters_error"
          },
          "code": "FIN_GL_CODE_DETERMINE_BV_FILTERS_ERROR",
          "id": "linear_1024_determine_bv_filters_error",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "description": "Checks whether summary filter generation failed.",
            "errorNodeId": "linear_1211_prepare_journal_summary_query_payload",
            "name": "Check Summary Filter Error",
            "returnType": "boolean",
            "sourceCode": "const RETRY_SIGNAL = \"LEDGER_AGENT_RETRY_SIGNAL\";\n\nconst getRetryAttemptCount = (value) => {\n  const count = Number(value);\n  return Number.isFinite(count) ? count : 0;\n};\n\nconst isRetrySignal = (error) =>\n  error?.isRetrySignal === true || error?.name === RETRY_SIGNAL;\n\n// Retry only when BO asks for a newer attempt than the one this request already sent.\nconst shouldRetryEnhancedResponse = (value, sentRetryAttemptCount) => {\n  const backendRetryAttemptCount = getRetryAttemptCount(value?.recovery?.retryAttemptCount);\n  return (\n    String(value?.category ?? \"\").toLowerCase() === \"systemerror\" &&\n    value?.recovery?.recoverable === true &&\n    backendRetryAttemptCount === 1 &&\n    backendRetryAttemptCount > sentRetryAttemptCount\n  );\n};\n\nconst throwRetryError = (value) => {\n  const err = new Error(value?.message || \"Retry requested.\");\n  err.name = RETRY_SIGNAL;\n  err.isRetrySignal = true;\n  err.category = value?.category;\n  err.processExecutionId = value?.processExecutionId;\n  err.payload = value;\n  throw err;\n};\n\nconst hasFilterError = () => {\n  const filterResponse = $context.$nodes.FIN_GL_BO_FUNCTION_GET_SUMMARY_FILTERS.$output;\n  const sentRetryAttemptCount = getRetryAttemptCount($context.$nodes.FIN_GL_CODE_PREPARE_SUMMARY_QUERY_PAYLOAD?.$output?.result?.queryPayload?.retryAttemptCount);\n  let response = false;\n  const category = String(filterResponse?.category ?? \"\").toLowerCase();\n\n  if (shouldRetryEnhancedResponse(filterResponse, sentRetryAttemptCount)) {\n    // Only this marked error should use the workflow retry edge.\n    throwRetryError(filterResponse);\n  }\n\n  if (category === \"usererror\" || category === \"systemerror\" || category === \"information\") {\n    response = true;\n  }\n  else if (Object.hasOwn(filterResponse, \"errorCode\")) {\n    response = true;\n  }\n  else if (Object.hasOwn(filterResponse, \"statusCode\")) {\n    if (filterResponse.statusCode >= 300) {\n      response = true;\n    }\n  }\n\n  return response;\n};\n\nlet finalResult;\ntry {\n  finalResult = hasFilterError();\n} catch (error) {\n  if (isRetrySignal(error)) {\n    throw error;\n  }\n\n  finalResult = true;\n}\n\nreturn finalResult;"
          },
