          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"title\": \"BusinessProcessConsoleTransactionDetailsResponse\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"response\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"items\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"TransactionId\": {\n                \"type\": \"integer\"\n              },\n              \"Name\": {\n                \"type\": \"string\"\n              },\n              \"Status\": {\n                \"type\": \"string\"\n              },\n              \"ProcessName\": {\n                \"type\": \"string\"\n              },\n              \"SubmittedOn\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\"\n              },\n              \"Assignees\": {\n                \"type\": [\"array\", \"null\"],\n                \"items\": {}\n              },\n              \"SubmittedBy\": {\n                \"type\": \"string\"\n              },\n              \"Approvers\": {\n                \"type\": [\"array\", \"null\"],\n                \"items\": {}\n              },\n              \"ArchiveDate\": {\n                \"type\": \"string\"\n              },\n              \"CompletedDate\": {\n                \"type\": \"string\",\n                \"format\": \"date-time\"\n              },\n              \"isCommunicationData\": {\n                \"type\": [\"boolean\", \"null\"]\n              },\n              \"@context\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"key\": {\n                    \"type\": \"integer\"\n                  },\n                  \"links\": {\n                    \"type\": \"array\",\n                    \"items\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"rel\": { \"type\": \"string\" },\n                        \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n                        \"name\": { \"type\": \"string\" },\n                        \"kind\": { \"type\": \"string\" }\n                      },\n                      \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n                    }\n                  }\n                },\n                \"required\": [\"key\", \"links\"]\n              }\n            },\n            \"required\": [\n              \"TransactionId\",\n              \"Name\",\n              \"Status\",\n              \"ProcessName\",\n              \"SubmittedOn\",\n              \"Assignees\",\n              \"SubmittedBy\",\n              \"Approvers\",\n              \"ArchiveDate\",\n              \"CompletedDate\",\n              \"isCommunicationData\",\n              \"@context\"\n            ]\n          }\n        },\n        \"count\": {\n          \"type\": \"integer\"\n        },\n        \"hasMore\": {\n          \"type\": \"boolean\"\n        },\n        \"limit\": {\n          \"type\": \"integer\"\n        },\n        \"offset\": {\n          \"type\": \"integer\"\n        },\n        \"links\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"rel\": { \"type\": \"string\" },\n              \"href\": { \"type\": \"string\", \"format\": \"uri\" },\n              \"name\": { \"type\": \"string\" },\n              \"kind\": { \"type\": \"string\" }\n            },\n            \"required\": [\"rel\", \"href\", \"name\", \"kind\"]\n          }\n        }\n      },\n      \"required\": [\n        \"items\",\n        \"count\",\n        \"hasMore\",\n        \"limit\",\n        \"offset\",\n        \"links\"\n      ]\n    },\n    \"responseStatus\": {\n      \"type\": \"integer\"\n    }\n  },\n  \"required\": [\n    \"response\",\n    \"responseStatus\"\n  ]\n}",
