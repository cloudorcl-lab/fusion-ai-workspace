          "id": "1763969854880",
          "inputs": [
            {
              "id": "1763969854881_1",
              "name": "prompt",
              "type": "string",
              "value": "From the provided input message extract the transaction id ``` {{$context.$system.$inputMessage}} ```\nif transaction id is not present then return \"TRANSACTION_ID_MISSING\"\nExample\nuserInput: reassign 300103651358143 to lloyd.alexander@oracle.com\noutput: 300103651358143\n\nuserInput: reassign to TM-MFITZIMMONS\noutput: TRANSACTION_ID_MISSING\n"
            }
          ],
