            "sourceCode": "const base64 = $context.$nodes.EXTRACT_LATEST_COST_PROCESS_LOG_SUMMARY.$output.items[0].DocumentContent;\nconst text = decodeURIComponent(\n  Array.from(atob(base64))\n    .map(c => '%' + c.charCodeAt(0).toString(16).padStart(2, '0'))\n    .join('')\n);\nreturn text;"
