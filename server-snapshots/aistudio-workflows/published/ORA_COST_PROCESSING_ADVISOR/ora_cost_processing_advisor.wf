                  "id": "start_analyze_each_error_code",
                  "code": "START_ANALYZE_EACH_ERROR_CODE",
                  "type": "START",
                  "inputs": []
                },
                {
                  "metadata": {
                    "description": "Fetches cost accounting transaction errors for the current grouped process error code.",
                    "processJson": true,
                    "name": "Fetch Transaction Errors For Error Code",
                    "businessObjectCode": "ORA_SCM_COSTMANAGE_COSTACCOUNTINGTRANSACTIONERRORS",
                    "functionName": "FindCostAccountingTransactionErrorsByProcessAndErrorCode"
                  },
                  "outcomes": {
                    "success": "analyze_transaction_errors_for_error_code"
                  },
                  "diagram": {
                    "x": 9012.5,
                    "y": 7889
                  },
                  "code": "FETCH_TRANSACTION_ERRORS_FOR_ERROR_CODE",
                  "id": "fetch_transaction_errors_for_error_code",
                  "inputs": [
                    {
                      "id": "fetch_transaction_errors_for_error_code_processId",
                      "name": "processId",
                      "value": "{{$context.$variables.latestCostProcessRequestId}}",
                      "required": false,
                      "type": "integer"
                    },
                    {
                      "id": "fetch_transaction_errors_for_error_code_errorCode",
                      "name": "errorCode",
                      "value": "{{$context.$nodes.ANALYZE_EACH_ERROR_CODE.$currentItem.errorCode}}",
                      "required": false,
