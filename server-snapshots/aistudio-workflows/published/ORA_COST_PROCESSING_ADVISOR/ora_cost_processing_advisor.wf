        {
          "metadata": {
            "name": "Determine Run Cost Process Display Or Not",
            "returnType": "boolean",
            "sourceCode": "const period_status = $context.$variables.periodStatusCode;\nconst period_name = $context.$variables.periodName ;\nconst exception_count = $context.$variables.validationExceptionCount;\nconst latest_cost_process_status = $context.$variables.latestCostProcessStatus;\nlet showRunCostProcessButton = true;\n\nif (\n  (period_status === 'O' || period_status === 'P') &&\n  Number(exception_count) > 0 &&\n  latest_cost_process_status !== 'RUNNING'\n) {\n  showRunCostProcessButton = true;\n}else{\nshowRunCostProcessButton = false;\n}\n\n// Define Cost Procressing Action\nconst priorityActionForCostProcessing = {\n  title: `Run Cost Processing for ${period_name}`,\n  description: `Run processing to process pending and errored transactions for period ${period_name}`,\n  buttonText: \"Run Cost Processing\",\n  command: `ora.Agent(\"RUN_PROCESSING\")`,\n  priority: false,\n};\n\nlet actions = [];\n\n  if (showRunCostProcessButton) {\n    actions.push(priorityActionForCostProcessing);\n  }\n\nreturn actions;"
          },
          "outcomes": {
            "success": "1778409957026"
          },
          "code": "DETERMINE_RUN_COST_PROCESS_DISPLAY_OR_NOT",
          "convergenceTargetId": "1778409957026",
          "id": "1778234840034",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
