        {
          "metadata": {
            "name": "Extract Business Unit From User Input",
            "returnType": "string",
            "sourceCode": "const input = $context.$triggers.REST.$input.OraAction;\n\n// Extract JSON payload inside the tag\nconst jsonMatch = input.match(/<oraFormSubmit[^>]*>(.*)<\\/oraFormSubmit>/);\n\nlet businessUnit = null;\n\nif (jsonMatch) {\n  try {\n    const data = JSON.parse(jsonMatch[1]);\n\n    // Find entry specifically for BU\n    const businessUnitEntry = data.find(item => item.id === \"billToBusinessUnit\");\n\n    if (businessUnitEntry) {\n      businessUnit = businessUnitEntry.value;\n    }\n  } catch (e) {\n    console.error(\"Invalid JSON\");\n  }\n}\n\nreturn businessUnit;"
          },
          "outcomes": {
            "success": "1778477912091"
          },
          "code": "EXTRACT_BUSINESS_UNIT_FROM_USER_INPUT",
          "id": "1778476435209",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
