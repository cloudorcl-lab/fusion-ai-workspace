        {
          "metadata": {
            "description": "Bundles per-error-code transaction analysis into the errorsByCode structure consumed by the multicard renderer.",
            "name": "Bundle Error Analysis Results",
            "returnType": "object",
            "sourceCode": "const grouped = $context?.$nodes?.GROUP_COST_PROCESSING_ERRORS?.$output?.result || {};\nconst loopNode = $context?.$nodes?.ANALYZE_EACH_ERROR_CODE || {};\nconst nestedOutput = loopNode?.BUILD_ERROR_ANALYSIS_ITEM?.$output;\nconst loopOutput = loopNode?.$output;\n\nfunction collectAnalysisItems(value, results, seen) {\n  if (value == null) return;\n  if (!seen) seen = [];\n\n  if (typeof value === \"string\") {\n    const trimmed = value.trim();\n    if (!trimmed) return;\n    try {\n      collectAnalysisItems(JSON.parse(trimmed), results, seen);\n    } catch (e) {}\n    return;\n  }\n\n  if (typeof value === \"object\") {\n    if (seen.indexOf(value) >= 0) return;\n    seen.push(value);\n  }\n\n  if (Array.isArray(value)) {\n    for (const entry of value) collectAnalysisItems(entry, results, seen);\n    return;\n  }\n\n  if (typeof value !== \"object\") return;\n\n  if (value.ErrorCode || value.errorCode) {\n    const normalized = value.result && (value.result.ErrorCode || value.result.errorCode)\n      ? value.result\n      : value;\n    results.push(normalized);\n    return;\n  }\n\n  const commonContainers = [value.result, value.items, value.outputs, value.results, value.iterations, value.values];\n  for (const container of commonContainers) collectAnalysisItems(container, results, seen);\n\n  for (const key in value) {\n    if (Object.prototype.hasOwnProperty.call(value, key)) {\n      collectAnalysisItems(value[key], results, seen);\n    }\n  }\n}\n\nfunction normalizeSummary(text) {\n  let summary = String(text || \"\").trim();\n  if (!summary) return \"\";\n\n  summary = summary\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .replace(/\\n*-{3,}\\n*/g, \"\\n\\n---\\n\\n\")\n    .replace(/\\n*\\*\\*Likely Root Cause\\*\\*/g, \"\\n\\n---\\n\\n**Likely Root Cause**\")\n    .replace(/\\n*\\*\\*Recommended Actions\\*\\*/g, \"\\n\\n---\\n\\n**Recommended Actions**\")\n    .replace(/\\n*Likely Root Cause\\n/g, \"\\n\\n---\\n\\nLikely Root Cause\\n\")\n    .replace(/\\n*Recommended Actions\\n/g, \"\\n\\n---\\n\\nRecommended Actions\\n\")\n    .replace(/(---\\n\\n){2,}/g, \"---\\n\\n\");\n\n  return summary.trim();\n}\n\nconst analysisItems = [];\ncollectAnalysisItems(nestedOutput, analysisItems);\ncollectAnalysisItems(loopOutput, analysisItems);\n\nconst analysisByCode = {};\nfor (const item of analysisItems) {\n  const errorCode = item.ErrorCode || item.errorCode;\n  if (!errorCode || analysisByCode[errorCode]) continue;\n  analysisByCode[errorCode] = item;\n}\n\nconst sourceGroups = Array.isArray(grouped.errorGroups) ? grouped.errorGroups : [];\nconst errorsByCode = {};\nconst errorCodes = [];\n\nfor (const source of sourceGroups) {\n  const errorCode = source.errorCode || source.ErrorCode || \"UNKNOWN_ERROR_CODE\";\n  const original = grouped.errorsByCode?.[errorCode] || {};\n  const analysis = analysisByCode[errorCode] || {};\n  const summary = normalizeSummary(analysis.summary || original.summary || \"**Hotspots**\\nNo transaction-error details were available for this error code.\\n\\n---\\n\\n**Likely Root Cause**\\nReview the process error message and related costing setup for this error code.\\n\\n---\\n\\n**Recommended Actions**\\nReview the source transactions, correct the underlying setup or data issue, and rerun the cost processor.\");\n\n  errorsByCode[errorCode] = {\n    ErrorCode: errorCode,\n    ErrorCount: Number(analysis.ErrorCount ?? source.errorCount ?? original.ErrorCount ?? 0),\n    TransactionErrorCount: Number(analysis.TransactionErrorCount ?? source.transactionErrorCount ?? original.TransactionErrorCount ?? 0),\n    Message: analysis.Message || source.message || original.Message || errorCode,\n    ProcessorName: analysis.ProcessorName || source.processorName || original.ProcessorName || null,\n    CostOrganization: analysis.CostOrganization || source.costOrganization || original.CostOrganization || null,\n    CostBook: analysis.CostBook || source.costBook || original.CostBook || null,\n    MessageDetails: analysis.MessageDetails || source.messageDetails || original.MessageDetails || null,\n    summary\n  };\n  errorCodes.push(errorCode);\n}\n\nreturn {\n  errorsByCode,\n  errorCodes,\n  count: errorCodes.length\n};"
          },
          "outcomes": {
            "success": "1778756367210"
          },
          "code": "BUNDLE_ERROR_ANALYSIS_RESULTS",
          "id": "1778756367209",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "If Business Unit Id Is Null"
