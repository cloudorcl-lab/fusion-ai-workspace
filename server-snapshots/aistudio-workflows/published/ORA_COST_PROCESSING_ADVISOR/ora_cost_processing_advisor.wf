                    }
                  ],
                  "outputSpecification": "{}",
                  "type": "BO_FUNCTION"
                },
                {
                  "metadata": {
                    "name": "Analyze Transaction Errors For Error Code"
                  },
                  "outcomes": {
                    "success": "build_error_analysis_item"
                  },
                  "diagram": {
                    "x": 9012.5,
                    "y": 8111
                  },
                  "code": "ANALYZE_TRANSACTION_ERRORS_FOR_ERROR_CODE",
                  "id": "analyze_transaction_errors_for_error_code",
                  "inputs": [
                    {
                      "id": "analyze_transaction_errors_for_error_code_prompt",
                      "name": "prompt",
                      "type": "string",
                      "value": "DATA:\nCurrent grouped process error:\n{{$context.$nodes.ANALYZE_EACH_ERROR_CODE.$currentItem}}\n\nTransaction errors for this error code:\n{{$context.$nodes.ANALYZE_EACH_ERROR_CODE.FETCH_TRANSACTION_ERRORS_FOR_ERROR_CODE.$output}}\n\nTASK:\nAct as an Oracle Fusion Cost Management expert. Analyze only this one error code independently. Use the transaction error records and the grouped process-error context to identify operational hotspots, likely root cause, and recommended actions. You may use Oracle Fusion Cost Management domain knowledge to interpret the error code and transaction fields, but do not invent transaction-specific facts that are not supported by the data.\n\nOUTPUT:\nReturn exactly these three markdown sections and no extra narration. Put a markdown divider line between sections so the final card is easy to scan:\n\n**Hotspots**\n1-2 concise sentences or bullet-style lines about where this error is concentrated in the transaction data.\n\n---\n\n**Likely Root Cause**\n1-2 concise sentences explaining the most likely setup, data, or processing issue.\n\n---\n\n**Recommended Actions**\n2-4 concise, practical actions a cost accountant or costing administrator should take.\n\nIMPORTANT NOTE:\n- When writing Hotspots, Likely Root Cause, and Recommended Actions, refer to the issue using the process-error Message field, not the technical ErrorCode. Do not display the ErrorCode in the summary unless Message is missing or ambiguous."
                    }
                  ],
                  "type": "LLM"
                },
                {
                  "metadata": {
                    "name": "Build Error Analysis Item",
                    "description": "Normalizes the current error-code analysis into the card data contract.",
                    "returnType": "object",
                    "sourceCode": "const item = $context?.$nodes?.ANALYZE_EACH_ERROR_CODE?.$currentItem || {};\nconst analysisOutput =\n  $context?.$nodes?.ANALYZE_TRANSACTION_ERRORS_FOR_ERROR_CODE?.$output ||\n  $context?.$nodes?.ANALYZE_EACH_ERROR_CODE?.ANALYZE_TRANSACTION_ERRORS_FOR_ERROR_CODE?.$output ||\n  {};\n\nfunction extractText(value) {\n  if (value == null) return \"\";\n  if (typeof value === \"string\") return value;\n  if (typeof value?.result === \"string\") return value.result;\n  if (typeof value?.text === \"string\") return value.text;\n  if (typeof value?.message === \"string\") return value.message;\n  if (typeof value?.output === \"string\") return value.output;\n  if (typeof value?.response === \"string\") return value.response;\n  if (typeof value?.result?.text === \"string\") return value.result.text;\n  if (typeof value?.result?.message === \"string\") return value.result.message;\n  if (typeof value?.result?.output === \"string\") return value.result.output;\n  if (typeof value?.result?.response === \"string\") return value.result.response;\n  try {\n    return JSON.stringify(value);\n  } catch (e) {\n    return \"\";\n  }\n}\n\nfunction normalizeSummary(text) {\n  let summary = String(text || \"\").trim();\n  if (!summary) return \"\";\n\n  summary = summary\n    .replace(/\\r\\n/g, \"\\n\")\n    .replace(/\\n{3,}/g, \"\\n\\n\")\n    .replace(/\\n*-{3,}\\n*/g, \"\\n\\n---\\n\\n\")\n    .replace(/\\n*\\*\\*Likely Root Cause\\*\\*/g, \"\\n\\n---\\n\\n**Likely Root Cause**\")\n    .replace(/\\n*\\*\\*Recommended Actions\\*\\*/g, \"\\n\\n---\\n\\n**Recommended Actions**\")\n    .replace(/\\n*Likely Root Cause\\n/g, \"\\n\\n---\\n\\nLikely Root Cause\\n\")\n    .replace(/\\n*Recommended Actions\\n/g, \"\\n\\n---\\n\\nRecommended Actions\\n\")\n    .replace(/(---\\n\\n){2,}/g, \"---\\n\\n\");\n\n  return summary.trim();\n}\n\nreturn {\n  ErrorCode: item.errorCode || \"UNKNOWN_ERROR_CODE\",\n  ErrorCount: Number(item.errorCount || 0),\n  TransactionErrorCount: Number(item.transactionErrorCount || 0),\n  Message: item.message || item.errorCode || \"Unknown cost processing error\",\n  ProcessorName: item.processorName || null,\n  CostOrganization: item.costOrganization || null,\n  CostBook: item.costBook || null,\n  MessageDetails: item.messageDetails || null,\n  summary: normalizeSummary(extractText(analysisOutput))\n};"
                  },
                  "outcomes": {
                    "success": "end_1778756367208"
                  },
                  "diagram": {
                    "x": 9012.5,
                    "y": 8333
                  },
                  "id": "build_error_analysis_item",
                  "code": "BUILD_ERROR_ANALYSIS_ITEM",
                  "type": "CODE",
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
                {
                  "metadata": {
                    "name": "End"
                  },
                  "outcomes": {},
                  "id": "end_1778756367208",
                  "code": "END_ANALYZE_EACH_ERROR_CODE",
                  "type": "END",
                  "inputs": []
                }
              ]
            },
            "loopType": "PARALLEL",
            "name": "Analyze Each Error Code"
