        {
          "metadata": {
            "businessObjectCode": "ORA_SCM_COSTMANAGE_COSTPROCESSINGERRORS",
            "description": "Fetches cost processing error records for the request id stored in workflow context.",
            "functionName": "FindCostProcessingErrorsByProcessId",
            "processJson": true,
            "name": "Fetch Cost Processing Errors"
          },
          "outcomes": {
            "success": "1778756367207"
          },
          "code": "FETCH_COST_PROCESSING_ERRORS",
          "convergenceTargetId": "1778147937237",
          "id": "1778756367206",
          "inputs": [
            {
              "id": "1780979169388_1",
              "name": "ProcessId",
              "type": "integer",
              "value": "{{$context.$variables.latestCostProcessRequestId}}"
            }
          ],
          "outputSpecification": "{}",
          "type": "BO_FUNCTION"
        },
        {
          "metadata": {
            "description": "Groups fetched cost processing errors by valid error code, sums count fields for duplicate error codes, and emits an ordered array for per-error-code enrichment.",
            "name": "Group Cost Processing Errors",
            "returnType": "object",
            "sourceCode": "const fetchOutput = $context?.$nodes?.FETCH_COST_PROCESSING_ERRORS?.$output || {};\nconst rows = Array.isArray(fetchOutput.items)\n  ? fetchOutput.items\n  : Array.isArray(fetchOutput.result?.items)\n    ? fetchOutput.result.items\n    : Array.isArray(fetchOutput.output?.items)\n      ? fetchOutput.output.items\n      : [];\n\nconst VALID_ERROR_CODES = new Set([\n  \"CST_CPROC_NO_LAYER_CST_FOR_ISS\",\n  \"CST_UNOPEN_TXN_PERIOD\",\n  \"CST_DPROC_GL_PERIOD_CLOSED\",\n  \"CST_CPROC_WO_FIXED_COST_MIS_E\",\n  \"CST_CPROC_SCRAP_TXN_PENDING\",\n  \"CST_NO_PRIOR_PAC\",\n  \"CST_PREP_NO_COMPONENT_MAPPING\",\n  \"CST_PREP_NO_ELEMENT_MAPPING\",\n  \"CST_PREP_PIN_CE_ERROR\",\n  \"CST_CPROC_ACC_WIP_VAL_FAIL_E\",\n  \"CST_DPROC_PERIOD_NOT_OPEN\",\n  \"CST_DPROC_NEXT_GL_PERD_CLOSED\",\n  \"CST_INTF_ITEM_COST_NULL\",\n  \"CST_PREP_ITEM_UOM_CONV_FAILED\",\n  \"CST_PREP_CURR_CONV_ERROR\",\n  \"CST_WO_QTYFL_ISS_PENDING\",\n  \"CST_QTYFL_CUTOFF_DT\",\n  \"CST_PREP_NO_MAP_FOR_COMPONENT\",\n  \"CST_PREP_REF_RMA_SO_NOT_COSTED\",\n  \"CST_CPROC_WO_PC_NOT_APPL_E\",\n  \"CST_CPROC_NO_REC_COST\",\n  \"CST_SFO_RETURNED_NO_COST\",\n  \"CST_CPROC_WO_CLOSE_NOT_PROC_E\",\n  \"CST_CPROC_WO_CLOSE_UOM_CONV_E\",\n  \"CST_COST_NO_COST_E\",\n  \"CST_CPROC_WO_COMPL_NOT_PROC_E\",\n  \"CST_CPROC_OP_QTY_NEGATIVE\",\n\n  // Preprocessor Errors\n  \"CST_PREP_NO_RCV_DATA\",\n  \"CST_SFO_AGREEMENT_NOT_FOUND_E\",\n  \"CMR_NO_CURRENCY_CONVERSION_RATE\",\n  \"CST_PREP_NO_TAX_DATA\",\n  \"CST_PREP_FDC_INVOICE_MISSING\",\n  \"CST_SETUP_INVALID_ITEM_VAL_ORG\",\n  \"CST_PREP_MISSING_SO_TXN_E\",\n  \"CST_PREP_PERCENT_PRICE_FAIL\",\n  \"CST_INTF_COMPONENT_INVALID\",\n  \"CST_PREP_DUPLICATE_TXN\",\n  \"CST_NO_XFER_ORDER_LINE_ID\",\n  \"CST_PREP_INV_COST_ORG_SETUP_MI\",\n  \"CST_PRIMARY_BOOK_MISSING_E\",\n  \"CST_PREP_TE_TXN_FLOW_NULL_E\",\n  \"CST_PREP_MISSING_WIP_OPTIONS\",\n  \"CST_WO_MIS_TXN\",\n  \"CST_PREP_ADDL_TAXES_MISSING\",\n  \"CST_PREP_RES_ADJ_COST_DATE_E\",\n  \"CMR_POINT_UOM_CONV_ERROR\",\n  \"CMR_RA_NO_SLA_EVENT\",\n\n  // COGS Errors\n  \"CST_DPROC_UNCOSTED_COGS_TXN\",\n  \"CST_DPROC_UNCOSTED_RCL_TXN\",\n  \"CST_DPROC_NO_COST_PERIOD\",\n  \"CST_DPROC_NEXT_PERD_CLOSED\",\n  \"CST_DPROC_NO_NEXT_OPEN_PERIOD\",\n  \"CST_CPROC_STD_COST_MISSING\",\n  \"CST_PREP_NULL_TXN_FLOW_TYPE\",\n  \"CST_XFER_ORDER_MISSING_IN_INTF\",\n  \"CST_PREP_PO_EVENT_IGNORED\",\n  \"CST_PREP_MISSING_SO_INFO_E\",\n  \"CST_DPROF_NOT_FOUND_E\",\n  \"CST_CPROC_STD_RES_RATE_MISSING\",\n  \"CST_TE_PRIOR_EVENT_MISSING\",\n  \"CST_CPROC_NO_LAYER_CST_FOR_REC\",\n  \"CST_PERP_NO_PERP_COST_FOUND\"\n]);\n\nfunction isValidErrorCode(code) {\n  return VALID_ERROR_CODES.has(code);\n}\n\nfunction toNumber(value) {\n  const parsed = Number(value ?? 0);\n  return Number.isFinite(parsed) ? parsed : 0;\n}\n\nconst aggregated = {};\n\nfor (const row of rows) {\n  const errorCode = row?.ErrorCode || \"UNKNOWN_ERROR_CODE\";\n\n  if (!isValidErrorCode(errorCode)) {\n    continue;\n  }\n\n  if (!aggregated[errorCode]) {\n    aggregated[errorCode] = {\n      ErrorCode: errorCode,\n      Message: row?.Message ?? null,\n      TransactionErrorCount: 0,\n      ErrorCount: 0,\n      ProcessorName: row?.ProcessorName ?? null,\n      CostOrganization: row?.CostOrganization ?? null,\n      CostBook: row?.CostBook ?? null,\n      MessageDetails: row?.MessageDetails ?? null\n    };\n  }\n\n  aggregated[errorCode].TransactionErrorCount += toNumber(row?.TransactionErrorCount);\n  aggregated[errorCode].ErrorCount += toNumber(row?.ErrorCount);\n\n  if (!aggregated[errorCode].Message && row?.Message) {\n    aggregated[errorCode].Message = row.Message;\n  }\n  if (!aggregated[errorCode].ProcessorName && row?.ProcessorName) {\n    aggregated[errorCode].ProcessorName = row.ProcessorName;\n  }\n  if (!aggregated[errorCode].CostOrganization && row?.CostOrganization) {\n    aggregated[errorCode].CostOrganization = row.CostOrganization;\n  }\n  if (!aggregated[errorCode].CostBook && row?.CostBook) {\n    aggregated[errorCode].CostBook = row.CostBook;\n  }\n  if (!aggregated[errorCode].MessageDetails && row?.MessageDetails) {\n    aggregated[errorCode].MessageDetails = row.MessageDetails;\n  }\n}\n\nconst sortedEntries = Object.entries(aggregated).sort((a, b) => {\n  const errorCountDifference = b[1].ErrorCount - a[1].ErrorCount;\n  if (errorCountDifference !== 0) return errorCountDifference;\n\n  const transactionCountDifference = b[1].TransactionErrorCount - a[1].TransactionErrorCount;\n  if (transactionCountDifference !== 0) return transactionCountDifference;\n\n  return a[0].localeCompare(b[0]);\n});\n\nconst errorsByCode = {};\nconst errorGroups = [];\n\nfor (const [errorCode, payload] of sortedEntries) {\n  const item = {\n    errorCode,\n    errorCount: payload.ErrorCount,\n    transactionErrorCount: payload.TransactionErrorCount,\n    message: payload.Message,\n    processorName: payload.ProcessorName,\n    costOrganization: payload.CostOrganization,\n    costBook: payload.CostBook,\n    messageDetails: payload.MessageDetails\n  };\n\n  errorsByCode[errorCode] = payload;\n  errorGroups.push(item);\n}\n\nreturn {\n  errorsByCode,\n  errorGroups,\n  errorCodes: errorGroups.map(item => item.errorCode),\n  count: errorGroups.length\n};"
          },
